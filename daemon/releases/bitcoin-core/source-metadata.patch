From fd84768c4d639735ea80fcc6828c70cc5059cacc Mon Sep 17 00:00:00 2001
From: Lotus Release Tool <build@givelotus.org>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] Scope bitcoin-core source build labels to native version tags

Keep distributor release identity in the component manifest.
Unrelated monorepo component tags must not override native build labels.

diff --git a/cmake/script/GenerateBuildInfo.cmake b/cmake/script/GenerateBuildInfo.cmake
index 62773a3a5439ef44cf61b66cafa87b1c0f43c632..97fb800456c1afc7d504579ba314ae258ddf3bb7 100644
--- a/cmake/script/GenerateBuildInfo.cmake
+++ b/cmake/script/GenerateBuildInfo.cmake
@@ -48,7 +48,7 @@ if(GIT_EXECUTABLE)
     )
 
     execute_process(
-      COMMAND ${GIT_EXECUTABLE} describe --abbrev=0
+      COMMAND ${GIT_EXECUTABLE} describe --match "v32.99.0*" --abbrev=0
       WORKING_DIRECTORY ${WORKING_DIR}
       OUTPUT_VARIABLE MOST_RECENT_TAG
       OUTPUT_STRIP_TRAILING_WHITESPACE
diff --git a/contrib/guix/libexec/codesign.sh b/contrib/guix/libexec/codesign.sh
index 737fa07e8312bd9b2f9e57e10e8e6353501d8797..6fcad6800bf0252ab317c99a74cbea9e81556950 100755
--- a/contrib/guix/libexec/codesign.sh
+++ b/contrib/guix/libexec/codesign.sh
@@ -45,7 +45,7 @@ OUTDIR="${DISTSRC}/output"
 
 git_head_version() {
     local recent_tag
-    if recent_tag="$(git -C "$1" describe --exact-match HEAD 2> /dev/null)"; then
+    if recent_tag="$(git -C "$1" describe --match "v32.99.0*" --exact-match HEAD 2> /dev/null)"; then
         echo "${recent_tag#v}"
     else
         git -C "$1" rev-parse --short=12 HEAD
diff --git a/contrib/shell/git-utils.bash b/contrib/shell/git-utils.bash
index 37bac1f38d8f087b4b0e073141bdd29a6a33f8ac..591ce1a22d954bd9f307527cb87e4b11b779cd6a 100644
--- a/contrib/shell/git-utils.bash
+++ b/contrib/shell/git-utils.bash
@@ -6,7 +6,7 @@ git_root() {
 
 git_head_version() {
     local recent_tag
-    if recent_tag="$(git describe --exact-match HEAD 2> /dev/null)"; then
+    if recent_tag="$(git describe --match "v32.99.0*" --exact-match HEAD 2> /dev/null)"; then
         echo "${recent_tag#v}"
     else
         git rev-parse --short=12 HEAD
