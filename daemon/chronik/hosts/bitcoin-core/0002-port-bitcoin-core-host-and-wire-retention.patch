 /// Bitcoin transaction. Mutable version of [`Tx`], like CMutableTransaction.
@@ -148,7 +149,30 @@ impl Tx {
     /// It is the responsibility of the caller to ensure the `txid` matches
     /// `tx`.
     pub fn with_txid(txid: TxId, tx: TxMut) -> Self {
-        Tx { txid, tx }
+        Tx {
+            txid,
+            tx,
+            raw: None,
+        }
+    }
+
+    /// Retain native full serialization independently of the stripped body.
+    /// Caller must supply bytes matching this immutable body and identifier.
+    pub fn with_raw(mut self, raw: bytes::Bytes) -> Self {
+        self.raw = (!raw.is_empty()).then_some(raw);
+        self
+    }
+
+    /// Full wire serialization if supplied by a witness-aware host.
+    pub fn wire_bytes(&self) -> bytes::Bytes {
+        self.raw.clone().unwrap_or_else(|| self.ser())
+    }
+
+    /// Full serialized byte size, distinct from policy virtual size.
+    pub fn wire_size(&self) -> usize {
+        self.raw
+            .as_ref()
+            .map_or_else(|| self.ser_len(), bytes::Bytes::len)
     }
 
