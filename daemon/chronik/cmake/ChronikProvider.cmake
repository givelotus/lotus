# Build the pinned shared source in-process. This is not a runtime plugin loader.
include_guard(GLOBAL)

function(lotus_add_chronik_from_source)
    cmake_parse_arguments(PROVIDER "" "SOURCE_DIR;HOST_PROFILE;HOST_UPSTREAM_COMMIT" "" ${ARGN})
    if(PROVIDER_UNPARSED_ARGUMENTS OR NOT PROVIDER_SOURCE_DIR OR NOT PROVIDER_HOST_PROFILE)
        message(FATAL_ERROR "Chronik provider requires SOURCE_DIR and HOST_PROFILE")
    endif()
    if(NOT PROVIDER_HOST_PROFILE MATCHES "^[a-z][a-z0-9-]*$")
        message(FATAL_ERROR "Invalid Chronik host profile")
    endif()
    set(PROFILE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../hosts/${PROVIDER_HOST_PROFILE}/profile.json")
    if(NOT PROVIDER_HOST_PROFILE STREQUAL "abc" AND
       (NOT EXISTS "${PROFILE_PATH}" OR NOT PROVIDER_HOST_UPSTREAM_COMMIT))
        message(FATAL_ERROR "Chronik host profile ${PROVIDER_HOST_PROFILE} requires a reviewed adapter and exact host upstream pin")
    endif()
    get_filename_component(PROVIDER_SOURCE_DIR "${PROVIDER_SOURCE_DIR}" REALPATH)
    set(MANIFEST_PATH "${PROVIDER_SOURCE_DIR}/chronik-source.json")
    if(NOT EXISTS "${MANIFEST_PATH}")
        message(FATAL_ERROR "Chronik source must be produced by export-chronik.py")
    endif()
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../source.json" PROVIDER_PIN)
    string(JSON PINNED_EXPORT_HASH GET "${PROVIDER_PIN}" export_manifest_sha256)
    file(SHA256 "${MANIFEST_PATH}" EXPORT_HASH)
    if(NOT EXPORT_HASH STREQUAL PINNED_EXPORT_HASH)
        message(FATAL_ERROR "Chronik export manifest differs from the reviewed provider pin")
    endif()
    file(READ "${MANIFEST_PATH}" MANIFEST)
    string(JSON FORMAT GET "${MANIFEST}" format)
    string(JSON REVISION GET "${MANIFEST}" upstream_commit)
    string(LENGTH "${REVISION}" REVISION_LENGTH)
    if(NOT FORMAT EQUAL 1 OR NOT REVISION_LENGTH EQUAL 40 OR NOT REVISION MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Unsupported Chronik source manifest")
    endif()
    # Every compiled upstream source must still match the recorded extraction.
    string(JSON SOURCE_COUNT LENGTH "${MANIFEST}" source_files_sha256)
    if(SOURCE_COUNT LESS 1)
        message(FATAL_ERROR "Empty Chronik source manifest")
    endif()
    file(GLOB_RECURSE ACTUAL_SOURCE_FILES LIST_DIRECTORIES FALSE
        RELATIVE "${PROVIDER_SOURCE_DIR}"
        "${PROVIDER_SOURCE_DIR}/chronik/*"
        "${PROVIDER_SOURCE_DIR}/test/functional/test_framework/*")
    list(LENGTH ACTUAL_SOURCE_FILES ACTUAL_SOURCE_COUNT)
    if(NOT ACTUAL_SOURCE_COUNT EQUAL SOURCE_COUNT)
        message(FATAL_ERROR "Chronik export file set differs from reviewed manifest")
    endif()
    math(EXPR LAST_SOURCE "${SOURCE_COUNT} - 1")
    foreach(INDEX RANGE ${LAST_SOURCE})
        string(JSON NAME MEMBER "${MANIFEST}" source_files_sha256 ${INDEX})
        if(NOT NAME MATCHES "^(chronik/|test/functional/test_framework/)" OR NAME MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Invalid Chronik source path")
        endif()
        string(JSON EXPECTED GET "${MANIFEST}" source_files_sha256 "${NAME}")
        file(SHA256 "${PROVIDER_SOURCE_DIR}/${NAME}" ACTUAL)
        if(NOT ACTUAL STREQUAL EXPECTED)
            message(FATAL_ERROR "Chronik source differs from export: ${NAME}")
        endif()
    endforeach()
    foreach(NAME IN ITEMS Cargo.toml Cargo.lock)
        if(NAME STREQUAL "Cargo.toml")
            set(HASH_KEY workspace_sha256)
        else()
            set(HASH_KEY lockfile_sha256)
        endif()
        string(JSON EXPECTED GET "${MANIFEST}" ${HASH_KEY})
        file(SHA256 "${PROVIDER_SOURCE_DIR}/${NAME}" ACTUAL)
        if(NOT ACTUAL STREQUAL EXPECTED)
            message(FATAL_ERROR "Chronik derived workspace differs from export: ${NAME}")
        endif()
    endforeach()
    # The helper is executable CMake and must be verified before inclusion.
    foreach(NAME IN ITEMS COPYING cmake/modules/RustHelper.cmake)
        string(JSON EXPECTED GET "${MANIFEST}" upstream_root_hashes "${NAME}")
        file(SHA256 "${PROVIDER_SOURCE_DIR}/${NAME}" ACTUAL)
        if(NOT ACTUAL STREQUAL EXPECTED)
            message(FATAL_ERROR "Chronik upstream input differs from export: ${NAME}")
        endif()
    endforeach()
    string(JSON PINNED_TOOLCHAIN GET "${MANIFEST}" rust_toolchain)
    if(NOT Rust_TOOLCHAIN STREQUAL PINNED_TOOLCHAIN)
        message(FATAL_ERROR "Shared Chronik requires reviewed Rust_TOOLCHAIN=${PINNED_TOOLCHAIN}")
    endif()
    # Stage only inside the host build directory. Never patch the exported source
    # or original node workspace in place. The single CMake adaptation makes the
    # crate-test working directory explicit rather than assuming the host root.
    set(STAGED_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/chronik-provider/${REVISION}")
    if(NOT PROVIDER_HOST_PROFILE STREQUAL "abc")
        string(APPEND STAGED_SOURCE "-${PROVIDER_HOST_PROFILE}")
        # This directory is provider-owned below the host binary directory.
        # Clear stale overlay additions before reconstructing the verified copy.
        file(REMOVE_RECURSE "${STAGED_SOURCE}")
    endif()
    file(MAKE_DIRECTORY "${STAGED_SOURCE}")
    file(COPY "${PROVIDER_SOURCE_DIR}/chronik" "${PROVIDER_SOURCE_DIR}/test"
        DESTINATION "${STAGED_SOURCE}")
    file(MAKE_DIRECTORY "${STAGED_SOURCE}/cmake/modules")
    configure_file("${PROVIDER_SOURCE_DIR}/cmake/modules/RustHelper.cmake" "${STAGED_SOURCE}/cmake/modules/RustHelper.cmake" COPYONLY)
    configure_file("${PROVIDER_SOURCE_DIR}/Cargo.toml" "${STAGED_SOURCE}/Cargo.toml" COPYONLY)
    configure_file("${PROVIDER_SOURCE_DIR}/Cargo.lock" "${STAGED_SOURCE}/Cargo.lock" COPYONLY)
    if(PROVIDER_HOST_PROFILE STREQUAL "abc")
        file(READ "${STAGED_SOURCE}/chronik/CMakeLists.txt" CHRONIK_CMAKE)
        set(OLD_WORKING_DIRECTORY "WORKING_DIRECTORY\n        \"\${CMAKE_SOURCE_DIR}\"")
        string(FIND "${CHRONIK_CMAKE}" "${OLD_WORKING_DIRECTORY}" WORKING_DIRECTORY_POSITION)
        if(WORKING_DIRECTORY_POSITION EQUAL -1)
            message(FATAL_ERROR "Upstream Chronik CMake working-directory assumption changed; review the adapter")
        endif()
        string(REPLACE "${OLD_WORKING_DIRECTORY}" "WORKING_DIRECTORY\n        \"${STAGED_SOURCE}\"" CHRONIK_CMAKE "${CHRONIK_CMAKE}")
        # configure_file avoids touching CMakeLists.txt on every reconfiguration.
        set(CHRONIK_CMAKE_INPUT "${CMAKE_CURRENT_BINARY_DIR}/chronik-provider/Chronik.CMakeLists.in")
        file(WRITE "${CHRONIK_CMAKE_INPUT}" "${CHRONIK_CMAKE}")
        configure_file("${CHRONIK_CMAKE_INPUT}" "${STAGED_SOURCE}/chronik/CMakeLists.txt" COPYONLY)
    else()
        find_package(Python3 3 COMPONENTS Interpreter REQUIRED)
        execute_process(
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/apply-host-profile.py"
                --profile "${PROFILE_PATH}" --source "${STAGED_SOURCE}"
                --host-source "${CMAKE_SOURCE_DIR}" --host-profile "${PROVIDER_HOST_PROFILE}"
                --host-upstream-commit "${PROVIDER_HOST_UPSTREAM_COMMIT}"
                --provider-upstream-commit "${REVISION}"
            RESULT_VARIABLE PROFILE_RESULT OUTPUT_VARIABLE PROFILE_OUTPUT ERROR_VARIABLE PROFILE_ERROR)
        if(NOT PROFILE_RESULT EQUAL 0)
            message(FATAL_ERROR "Chronik host overlay validation failed: ${PROFILE_ERROR}")
        endif()
        message(STATUS "Chronik host overlay: ${PROFILE_OUTPUT}")
    endif()
    list(PREPEND CMAKE_MODULE_PATH "${STAGED_SOURCE}/cmake/modules")
    message(STATUS "In-process shared Chronik: source ${REVISION}, host ${PROVIDER_HOST_PROFILE}")
    add_subdirectory("${STAGED_SOURCE}/chronik" "${CMAKE_CURRENT_BINARY_DIR}/shared-chronik")
endfunction()
