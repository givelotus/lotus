{
  "schema": 1,
  "components": {
    "lotusd": {
      "release_enabled": true,
      "series": "v1",
      "pin_file": "bitcoin-abc-v1-version",
      "remote": "https://github.com/Bitcoin-ABC/bitcoin-abc.git",
      "channel": "mainnet-maintained",
      "default_profile": "maintained",
      "binaries": [
        "lotusd",
        "lotus-cli"
      ],
      "test_target": "test_lotus",
      "cmake_args": [
        "-DBUILD_QT=OFF",
        "-DBUILD_ZMQ=OFF",
        "-DBUILD_CHRONIK=ON",
        "-DBUILD_BITCOIN_NNG=ON"
      ],
      "rust": "1.93.0",
      "python": "3.13"
    },
    "bitcoin-abc": {
      "release_enabled": false,
      "series": "ecash",
      "pin_file": "bitcoin-abc-version",
      "remote": "https://github.com/Bitcoin-ABC/bitcoin-abc.git",
      "channel": "development-snapshot",
      "default_profile": "stock",
      "binaries": [
        "bitcoind",
        "bitcoin-cli"
      ],
      "test_target": "test_bitcoin",
      "cmake_args": [
        "-DBUILD_QT=OFF",
        "-DBUILD_ZMQ=OFF",
        "-DBUILD_CHRONIK=OFF"
      ],
      "rust": "1.87.0",
      "python": "3.13"
    },
    "bchn": {
      "release_enabled": true,
      "series": "bchn",
      "pin_file": "bchn-version",
      "remote": "https://gitlab.com/bitcoin-cash-node/bitcoin-cash-node.git",
      "channel": "development-snapshot",
      "default_profile": "stock",
      "binaries": [
        "bitcoind",
        "bitcoin-cli"
      ],
      "test_target": "test_bitcoin",
      "cmake_args": [
        "-DBUILD_BITCOIN_QT=OFF",
        "-DBUILD_BITCOIN_ZMQ=OFF",
        "-DENABLE_UPNP=OFF",
        "-DENABLE_NATPMP=OFF",
        "-DENABLE_MAN=OFF"
      ],
      "rust": "1.87.0",
      "python": "3.13"
    },
    "doged": {
      "release_enabled": true,
      "series": "doged",
      "pin_file": "bitcoin-abc-version",
      "remote": "https://github.com/Bitcoin-ABC/bitcoin-abc.git",
      "channel": "development-snapshot",
      "default_profile": "maintained",
      "binaries": [
        "doged",
        "doge-cli"
      ],
      "test_target": "test_bitcoin",
      "cmake_args": [
        "-DBUILD_QT=OFF",
        "-DBUILD_ZMQ=OFF",
        "-DBUILD_CHRONIK=ON"
      ],
      "rust": "1.87.0",
      "python": "3.13"
    },
    "bitcoin-core": {
      "release_enabled": true,
      "series": "bitcoin",
      "pin_file": "bitcoin-core-version",
      "remote": "https://github.com/bitcoin/bitcoin.git",
      "channel": "development-snapshot",
      "default_profile": "stock",
      "binaries": [
        "bitcoind",
        "bitcoin-cli"
      ],
      "test_target": "test_bitcoin",
      "cmake_args": [
        "-DBUILD_GUI=OFF",
        "-DENABLE_IPC=OFF",
        "-DWITH_ZMQ=OFF",
        "-DBUILD_BENCH=OFF"
      ],
      "rust": "1.87.0",
      "python": "3.13"
    }
  }
}
