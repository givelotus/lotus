+
+int main(int argc, char **argv) {
+    try {
+        if (argc == 2 && std::string(argv[1]) == "--vectors") {
+            Vectors();
+            return EXIT_SUCCESS;
+        }
+        HandCalculated();
+        NativeTransactionAdapter();
+        std::cout << "monetary arithmetic checks passed\n";
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return EXIT_FAILURE;
+    }
