+cases = [
+    ("03616263b8", (), 0, 0, False),
+    ("b8", (), 0, 0, False),
+    ("006101616308" + "62"*8 + "64b8", (), 0, 0, False),
+    ("006179634e64", (), 0, 0, False),
+    ("0061b8634e64", (), 0, 0, False),
+    ("007d", (b"a"*3, b"b"*100), 0, 0, False),
