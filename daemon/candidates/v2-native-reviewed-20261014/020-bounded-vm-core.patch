diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
new file mode 100644
index 000000000..b79e66828
--- /dev/null
+++ b/src/lotus_v2/test_vm.cpp
@@ -0,0 +1,101 @@
+#include "vm.h"
+
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+#define CHECK(condition)                                                       \
+    do {                                                                       \
+        if (!(condition))                                                      \
+            throw std::runtime_error("check failed: " #condition);             \
+    } while (false)
+
+namespace {
+const VmProfile PROFILE{512, 8, 128, 16, 8, 256, 8, 100000};
+VmBytes Hex(const std::string &hex) {
+    CHECK(hex.size() % 2 == 0);
+    auto digit = [](char c) -> uint8_t {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        throw std::runtime_error("hex");
+    };
+    VmBytes out;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        out.push_back((digit(hex[i]) << 4) | digit(hex[i + 1]));
+    return out;
+}
+VmBytes Number(uint8_t n) {
+    VmBytes out(16);
+    out[0] = n;
+    return out;
+}
+void Expect(const std::string &hex, VmStatus status,
+            const std::vector<VmBytes> &args = {},
+            const VmProfile &profile = PROFILE, uint16_t inputs = 0,
+            uint16_t outputs = 0) {
+    auto result = EvaluateVm(Hex(hex), args, profile, inputs, outputs);
+    if (result.status != status)
+        throw std::runtime_error(hex + ": " + result.error);
+    if (status == VmStatus::Success)
+        CHECK(result.final_stack == std::vector<VmBytes>{Number(1)});
+}
+void FramingAndSuccess() {
+    Expect("66615e4c", VmStatus::AutomaticSuccess);
+    Expect("614e635e64", VmStatus::AutomaticSuccess);
+    Expect("5e4cfd", VmStatus::AutomaticSuccess);
+    Expect("015e4e91", VmStatus::Invalid); // success byte is push payload
+    for (const auto &bad : {"0244", "4cfd01005e", "4c015e5e", "4cfd", "4c4b",
+                            "0064", "616a64", "676167646a", "6767676a6a6a"})
+        Expect(bad, VmStatus::Invalid);
+    Expect("bd", VmStatus::Unsupported); // assigned CHECKDATASIG, not success
+}
+void ControlAndArithmetic() {
+    for (const auto &valid :
+         {"4d4e9e00a6", "00696a4e", "4e69614e6b646a4e", "677967794f6b6a666a4e",
+          "4e7a91", "4c004c00914e91"})
+        Expect(valid, VmStatus::Success, {}, PROFILE, 1);
+    Expect("006179634e64", VmStatus::Success);
+    Expect("61", VmStatus::Invalid, {Number(2)});
+    Expect("4e6b", VmStatus::Invalid);
+    VmBytes max(16, 255);
+    max[15] = 127;
+    Expect("98", VmStatus::Invalid, {max});
+    Expect("4e4e", VmStatus::Invalid);
+    VmProfile one_stack = PROFILE;
+    one_stack.max_stack_items = 1;
+    Expect("4e7a91", VmStatus::Invalid, {}, one_stack);
+    VmProfile one_step = PROFILE;
+    one_step.max_steps = 1;
+    Expect("4e", VmStatus::Success, {}, one_step);
+    Expect("4e4e91", VmStatus::Invalid, {}, one_step);
+}
+void HashAndBounds() {
+    Expect("03616263b820ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff6"
+           "1f20015ad91",
+           VmStatus::Success); // SHA256('abc'), independently fixed
+    Expect("03616263ba20"      // raw BLAKE3('abc')
+           "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d8591",
+           VmStatus::Success);
+    Expect("0141be20", VmStatus::Invalid); // incomplete comparison push
+    VmProfile tiny = PROFILE;
+    tiny.max_script_bytes = 1;
+    Expect("4e4e91", VmStatus::Invalid, {}, tiny);
+    VmProfile small_element = PROFILE;
+    small_element.max_element_bytes = 1;
+    Expect("1000000000000000000000000000000000", VmStatus::Invalid, {},
+           small_element);
+    VmProfile tiny_bytes = PROFILE;
+    tiny_bytes.max_vm_bytes = 16;
+    Expect("4e4e91", VmStatus::Invalid, {}, tiny_bytes);
+    Expect("5e", VmStatus::AutomaticSuccess, {}, tiny_bytes);
+}
+} // namespace
+int main() {
+    FramingAndSuccess();
+    ControlAndArithmetic();
+    HashAndBounds();
+    std::cout << "Lotus V2 VM core vectors pass\n";
+}
diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
new file mode 100644
index 000000000..e7973a6b5
--- /dev/null
+++ b/src/lotus_v2/vm.cpp
@@ -0,0 +1,476 @@
+#include "vm.h"
+
+#include "commitment.h"
+#include "vendor/blake3/blake3.h"
+
+#include <openssl/evp.h>
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+    using Int = __int128_t;
+    using UInt = __uint128_t;
+    struct VmFailure : std::runtime_error {
+        bool unsupported;
+        VmFailure(const char *message, bool unsupported = false)
+            : std::runtime_error(message), unsupported(unsupported) {}
+    };
+    struct Instruction {
+        uint8_t op;
+        VmBytes data;
+        size_t peer = 0; // IF: ELSE or ENDIF; ELSE/loop: closing marker
+        size_t end = 0;  // IF: ENDIF
+    };
+
+    bool Assigned(uint8_t op) {
+        return op <= 0x5d || (op >= 0x60 && op <= 0x6b) ||
+               (op >= 0x70 && op <= 0x81) || (op >= 0x88 && op <= 0x94) ||
+               (op >= 0x98 && op <= 0xb4) || (op >= 0xb8 && op <= 0xc2) ||
+               (op >= 0xc8 && op <= 0xdd) || (op >= 0xe0 && op <= 0xea) ||
+               (op >= 0xf0 && op <= 0xf4);
+    }
+
+    size_t PushLength(std::span<const uint8_t> script, size_t &pos,
+                      const VmProfile &profile) {
+        if (pos >= script.size()) throw VmFailure("truncated PUSHDATA length");
+        const uint8_t first = script[pos++];
+        uint64_t length = first;
+        if (first >= 253) {
+            const unsigned width = first == 253 ? 2 : first == 254 ? 4 : 8;
+            if (script.size() - pos < width)
+                throw VmFailure("truncated CompactSize");
+            length = 0;
+            for (unsigned i = 0; i < width; ++i)
+                length |= uint64_t(script[pos++]) << (8 * i);
+            if ((first == 253 && length < 253) ||
+                (first == 254 && length <= 65535) ||
+                (first == 255 && length <= UINT32_MAX))
+                throw VmFailure("nonminimal CompactSize");
+        }
+        if (length > profile.max_element_bytes ||
+            length > std::numeric_limits<size_t>::max() ||
+            (length > 0 && length <= 75))
+            throw VmFailure("invalid PUSHDATA length");
+        return size_t(length);
+    }
+
+    // Scan never interprets control flow and stops before inspecting the suffix
+    // of a success byte. When no success is present, it also gives full
+    // instruction boundaries to the structural decoder.
+    bool Scan(std::span<const uint8_t> script, const VmProfile &profile,
+              std::vector<Instruction> &instructions) {
+        size_t pos = 0;
+        while (pos < script.size()) {
+            uint8_t op = script[pos++];
+            if (!Assigned(op)) return true;
+            size_t len = 0;
+            if (op >= 1 && op <= 75) {
+                len = op;
+                if (len > profile.max_element_bytes)
+                    throw VmFailure("fixed push exceeds element cap");
+            } else if (op == 0x4c) {
+                len = PushLength(script, pos, profile);
+            }
+            if (len > script.size() - pos) throw VmFailure("truncated push");
+            Instruction ins{op, {}, 0, 0};
+            if (len || op == 0x4c)
+                ins.data.assign(script.begin() + pos,
+                                script.begin() + pos + len);
+            pos += len;
+            instructions.push_back(std::move(ins));
+        }
+        return false;
+    }
+
+    void Structure(std::vector<Instruction> &code, const VmProfile &profile) {
+        struct Frame {
+            uint8_t op;
+            size_t start;
+            bool has_else;
+        };
+        std::vector<Frame> frames;
+        size_t loop_depth = 0;
+        for (size_t i = 0; i < code.size(); ++i) {
+            uint8_t op = code[i].op;
+            if (op == 0x61 || op == 0x62 || op == 0x67 || op == 0x68 ||
+                op == 0x69) {
+                if (op >= 0x67 && ++loop_depth > 2)
+                    throw VmFailure("loop nesting exceeds two");
+                if (frames.size() >= profile.max_ast_depth)
+                    throw VmFailure("AST depth exceeded");
+                frames.push_back({op, i, false});
+            } else if (op == 0x63) {
+                if (frames.empty() || frames.back().op > 0x62 ||
+                    frames.back().has_else)
+                    throw VmFailure("unmatched ELSE");
+                code[frames.back().start].peer = i;
+                frames.back().has_else = true;
+            } else if (op == 0x64) {
+                if (frames.empty() || frames.back().op > 0x62)
+                    throw VmFailure("unmatched ENDIF");
+                Frame frame = frames.back();
+                frames.pop_back();
+                code[frame.start].end = i;
+                if (frame.has_else)
+                    code[code[frame.start].peer].peer = i;
+                else
+                    code[frame.start].peer = i;
+            } else if (op == 0x6a) {
+                if (frames.empty() || frames.back().op < 0x67 ||
+                    frames.back().op > 0x69)
+                    throw VmFailure("unmatched ENDENUMERATE");
+                code[frames.back().start].peer = i;
+                frames.pop_back();
+                --loop_depth;
+            }
+        }
+        if (!frames.empty()) throw VmFailure("unclosed structure");
+    }
+
+    Int Numeric(const VmBytes &bytes) {
+        if (bytes.size() != 16) throw VmFailure("operand is not N");
+        UInt value = 0;
+        for (size_t i = 0; i < 16; ++i)
+            value |= UInt(bytes[i]) << (8 * i);
+        const UInt sign = UInt(1) << 127;
+        const Int minimum = -Int(sign - 1) - 1;
+        return value & sign ? minimum + Int(value - sign) : Int(value);
+    }
+    VmBytes Number(Int number) {
+        UInt value = UInt(number);
+        VmBytes bytes(16);
+        for (size_t i = 0; i < 16; ++i) {
+            bytes[i] = uint8_t(value & 255);
+            value >>= 8;
+        }
+        return bytes;
+    }
+    bool Boolean(const VmBytes &value) {
+        const Int n = Numeric(value);
+        if (n != 0 && n != 1) throw VmFailure("noncanonical Boolean");
+        return n == 1;
+    }
+    VmBytes Sha256(std::span<const uint8_t> value) {
+        VmBytes out(32);
+        unsigned int len = 0;
+        if (!EVP_Digest(value.data(), value.size(), out.data(), &len,
+                        EVP_sha256(), nullptr) ||
+            len != 32)
+            throw VmFailure("SHA256 failure");
+        return out;
+    }
+    VmBytes Blake3(std::span<const uint8_t> value) {
+        VmBytes out(32);
+        blake3_hasher hasher;
+        blake3_hasher_init(&hasher);
+        blake3_hasher_update(&hasher, value.data(), value.size());
+        blake3_hasher_finalize(&hasher, out.data(), out.size());
+        return out;
+    }
+
+    class Machine {
+        const std::vector<Instruction> &code;
+        const VmProfile &profile;
+        uint16_t input_count;
+        uint16_t output_count;
+        std::vector<VmBytes> stack;
+        std::vector<VmBytes> alternate;
+        size_t bytes = 0;
+        size_t steps = 0;
+
+        VmBytes Pop() {
+            if (stack.empty()) throw VmFailure("stack underflow");
+            VmBytes value = std::move(stack.back());
+            bytes -= value.size();
+            stack.pop_back();
+            return value;
+        }
+        void Push(VmBytes value, bool to_alt = false) {
+            auto &target = to_alt ? alternate : stack;
+            const size_t cap =
+                to_alt ? profile.max_altstack_items : profile.max_stack_items;
+            if (value.size() > profile.max_element_bytes ||
+                target.size() >= cap ||
+                value.size() > profile.max_vm_bytes - bytes)
+                throw VmFailure("stack bound exceeded");
+            bytes += value.size();
+            target.push_back(std::move(value));
+        }
+        void Require(size_t n) const {
+            if (stack.size() < n) throw VmFailure("stack underflow");
+        }
+        void Tick() {
+            if (++steps > profile.max_steps)
+                throw VmFailure("step bound exceeded");
+        }
+        // 0=continue; positive value exits that many active loops.
+        unsigned Execute(size_t begin, size_t end, unsigned active_loops) {
+            for (size_t i = begin; i < end; ++i) {
+                Tick();
+                const auto &ins = code[i];
+                const uint8_t op = ins.op;
+                if (op == 0x61 || op == 0x62) {
+                    bool condition = Boolean(Pop());
+                    if (op == 0x62) condition = !condition;
+                    size_t branch_begin = condition ? i + 1 : ins.peer + 1;
+                    size_t branch_end = condition ? ins.peer : ins.end;
+                    unsigned signal =
+                        Execute(branch_begin, branch_end, active_loops);
+                    if (signal) return signal;
+                    i = ins.end;
+                    continue;
+                }
+                if (op >= 0x67 && op <= 0x69) {
+                    Int bound = op == 0x67   ? Int(input_count)
+                                : op == 0x68 ? Int(output_count)
+                                             : Numeric(Pop());
+                    if (bound < 0 || (op == 0x69 && bound > 256))
+                        throw VmFailure("loop bound");
+                    for (size_t index = 0; index < size_t(bound); ++index) {
+                        Tick();
+                        Push(Number(index));
+                        unsigned signal =
+                            Execute(i + 1, ins.peer, active_loops + 1);
+                        if (signal) {
+                            if (signal > 1) return signal - 1;
+                            break;
+                        }
+                    }
+                    i = ins.peer;
+                    continue;
+                }
+                if (op >= 1 && op <= 0x4c) {
+                    Push(ins.data);
+                    continue;
+                }
+                if (op == 0) {
+                    Push(Number(0));
+                    continue;
+                }
+                if (op >= 0x4d && op <= 0x5d) {
+                    Push(Number(op == 0x4d ? -1 : op - 0x4d));
+                    continue;
+                }
+                switch (op) {
+                    case 0x60:
+                        break;
+                    case 0x65:
+                        if (!Boolean(Pop())) throw VmFailure("VERIFY false");
+                        break;
+                    case 0x66:
+                        throw VmFailure("RETURN");
+                    case 0x6b: {
+                        Int depth = Numeric(Pop());
+                        if (depth < 1 || depth > active_loops)
+                            throw VmFailure("BREAK depth");
+                        return unsigned(depth);
+                    }
+                    case 0x70:
+                        Push(Pop(), true);
+                        break;
+                    case 0x71: {
+                        if (alternate.empty())
+                            throw VmFailure("alternate underflow");
+                        VmBytes value = std::move(alternate.back());
+                        bytes -= value.size();
+                        alternate.pop_back();
+                        Push(std::move(value));
+                        break;
+                    }
+                    case 0x78:
+                        Push(Number(stack.size()));
+                        break;
+                    case 0x79:
+                        Pop();
+                        break;
+                    case 0x7a:
+                        Require(1);
+                        Push(stack.back());
+                        break;
+                    case 0x7c:
+                        Require(2);
+                        Push(stack[stack.size() - 2]);
+                        break;
+                    case 0x80:
+                        Require(2);
+                        std::swap(stack[stack.size() - 1],
+                                  stack[stack.size() - 2]);
+                        break;
+                    case 0x88: {
+                        auto b = Pop(), a = Pop();
+                        if (a.size() > profile.max_element_bytes - b.size())
+                            throw VmFailure("CAT element bound");
+                        a.insert(a.end(), b.begin(), b.end());
+                        Push(std::move(a));
+                        break;
+                    }
+                    case 0x8c:
+                        Require(1);
+                        Push(Number(stack.back().size()));
+                        break;
+                    case 0x91:
+                    case 0x92: {
+                        auto b = Pop(), a = Pop();
+                        Push(Number(a == b));
+                        if (op == 0x92 && !Boolean(Pop()))
+                            throw VmFailure("EQUALVERIFY false");
+                        break;
+                    }
+                    case 0x98:
+                    case 0x99:
+                    case 0x9a:
+                    case 0x9b:
+                    case 0x9c:
+                    case 0x9d: {
+                        Int a = Numeric(Pop()), out = 0;
+                        if (op == 0x98 &&
+                            __builtin_add_overflow(a, Int(1), &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0x99 &&
+                            __builtin_sub_overflow(a, Int(1), &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0x9a &&
+                            __builtin_sub_overflow(Int(0), a, &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0x9b && a < 0 &&
+                            __builtin_sub_overflow(Int(0), a, &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0x9b && a >= 0) out = a;
+                        if (op == 0x9c) {
+                            if (a != 0 && a != 1)
+                                throw VmFailure("noncanonical Boolean");
+                            out = 1 - a;
+                        }
+                        if (op == 0x9d) out = a != 0;
+                        Push(Number(out));
+                        break;
+                    }
+                    case 0x9e:
+                    case 0x9f:
+                    case 0xa0:
+                    case 0xa6:
+                    case 0xa7:
+                    case 0xa8:
+                    case 0xa9:
+                    case 0xaa:
+                    case 0xab:
+                    case 0xac: {
+                        Int b = Numeric(Pop()), a = Numeric(Pop()), out = 0;
+                        if (op == 0x9e && __builtin_add_overflow(a, b, &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0x9f && __builtin_sub_overflow(a, b, &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0xa0 && __builtin_mul_overflow(a, b, &out))
+                            throw VmFailure("int128 overflow");
+                        if (op == 0xa6 || op == 0xa7) out = a == b;
+                        if (op == 0xa8) out = a != b;
+                        if (op == 0xa9) out = a < b;
+                        if (op == 0xaa) out = a > b;
+                        if (op == 0xab) out = a <= b;
+                        if (op == 0xac) out = a >= b;
+                        Push(Number(out));
+                        if (op == 0xa7 && !Boolean(Pop()))
+                            throw VmFailure("NUMEQUALVERIFY false");
+                        break;
+                    }
+                    case 0xb8:
+                    case 0xb9: {
+                        VmBytes digest = Sha256(Pop());
+                        if (op == 0xb9) digest = Sha256(digest);
+                        Push(std::move(digest));
+                        break;
+                    }
+                    case 0xba:
+                        Push(Blake3(Pop()));
+                        break;
+                    case 0xbe: {
+                        VmBytes script = Pop();
+                        Hash leaf = BranchLeaf(script);
+                        Push(VmBytes(leaf.begin(), leaf.end()));
+                        break;
+                    }
+                    case 0xbf: {
+                        auto b = Pop(), a = Pop();
+                        if (a.size() != 32 || b.size() != 32)
+                            throw VmFailure("NODEHASH width");
+                        Hash ah{}, bh{};
+                        std::copy(a.begin(), a.end(), ah.begin());
+                        std::copy(b.begin(), b.end(), bh.begin());
+                        Hash node = BranchNode(ah, bh);
+                        Push(VmBytes(node.begin(), node.end()));
+                        break;
+                    }
+                    case 0xc9:
+                        Push(Number(input_count));
+                        break;
+                    case 0xca:
+                        Push(Number(output_count));
+                        break;
+                    default:
+                        throw VmFailure("assigned opcode not implemented",
+                                        true);
+                }
+            }
+            return 0;
+        }
+
+    public:
+        Machine(const std::vector<Instruction> &code, const VmProfile &profile,
+                uint16_t input_count, uint16_t output_count,
+                const std::vector<VmBytes> &arguments)
+            : code(code), profile(profile), input_count(input_count),
+              output_count(output_count) {
+            for (const auto &arg : arguments)
+                Push(arg);
+        }
+        std::vector<VmBytes> Run() {
+            if (Execute(0, code.size(), 0))
+                throw VmFailure("BREAK escaped top level");
+            if (!alternate.empty() || stack.size() != 1 ||
+                !Boolean(stack.front()))
+                throw VmFailure("unclean final stack");
+            return stack;
+        }
+    };
+} // namespace
+
+VmResult EvaluateVm(std::span<const uint8_t> script,
+                    const std::vector<VmBytes> &arguments,
+                    const VmProfile &profile, uint16_t input_count,
+                    uint16_t output_count) {
+    try {
+        if (!profile.max_script_bytes || !profile.max_element_bytes ||
+            !profile.max_stack_items || !profile.max_altstack_items ||
+            !profile.max_vm_bytes || !profile.max_ast_depth ||
+            !profile.max_steps)
+            throw VmFailure("invalid explicit VM profile");
+        if (script.size() > profile.max_script_bytes ||
+            arguments.size() > profile.max_arguments)
+            throw VmFailure("invocation framing limit");
+        size_t bytes = 0;
+        for (const auto &arg : arguments) {
+            if (arg.size() > profile.max_element_bytes ||
+                arg.size() > profile.max_vm_bytes - bytes)
+                throw VmFailure("argument byte limit");
+            bytes += arg.size();
+        }
+        if (arguments.size() > profile.max_stack_items)
+            throw VmFailure("argument count exceeds stack cap");
+        std::vector<Instruction> code;
+        if (Scan(script, profile, code))
+            return {VmStatus::AutomaticSuccess, {}, {}};
+        Structure(code, profile);
+        Machine machine(code, profile, input_count, output_count, arguments);
+        return {VmStatus::Success, {}, machine.Run()};
+    } catch (const VmFailure &failure) {
+        return {failure.unsupported ? VmStatus::Unsupported : VmStatus::Invalid,
+                failure.what(),
+                {}};
+    }
+}
+} // namespace lotus::v2
