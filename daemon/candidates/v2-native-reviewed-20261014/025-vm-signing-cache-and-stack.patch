 src/lotus_v2/vm.cpp                  | 131 ++++++++++++++++++++++-----
 src/lotus_v2/vm.h                    |   5 +-
 src/lotus_v2/vm_test/differential.py |  23 +++++
 4 files changed, 194 insertions(+), 28 deletions(-)

