diff --git a/src/lotus_v2/generate_vectors.py b/src/lotus_v2/generate_vectors.py
new file mode 100644
index 000000000..864b847d4
--- /dev/null
+++ b/src/lotus_v2/generate_vectors.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Reproduce test_header.cpp's P04 vectors with independent Python BLAKE3.
+
+Install the pinned dependency into an isolated environment:
+    python3 -m venv /tmp/lotus-v2-vector-venv
+    /tmp/lotus-v2-vector-venv/bin/pip install blake3==1.0.11
+    /tmp/lotus-v2-vector-venv/bin/python src/lotus_v2/generate_vectors.py
+"""
+
+import json
+
+import blake3
+
+
+def le(value: int, width: int) -> bytes:
+    return value.to_bytes(width, "little")
+
+
+def tagged(name: str, payload: bytes) -> bytes:
+    return blake3.blake3(name.encode("ascii") + b"\0" + payload).digest()
+
+
+def main() -> None:
+    assert blake3.__version__ == "1.0.11", blake3.__version__
+    chain_id = bytes(range(32))
+    prev_id = bytes(range(32, 64))
+    tx_root = bytes(range(64, 96))
+    state_root = bytes(range(96, 128))
+    bits = le(0x1D00FFFF, 4)
+    time = le(0x010203040506, 6)
+    body = (
+        le(2, 4)
+        + le(0x1122334455667788, 8)
+        + le(0x99AABBCCDDEEFF00, 8)
+        + tx_root
+        + state_root
+    )
+    body_hash = tagged("Lotus/v2/header/body", chain_id + body)
+    output = {
+        "dependency": f"python-blake3 {blake3.__version__}",
+        "chain_id": chain_id.hex(),
+        "body_hash": body_hash.hex(),
+        "cases": [],
+    }
+    for nonce in (0x08090A0B0C0D0E0F, 0x08090A0B0C0D0E10, 0xFFFFFFFFFFFFFFFF):
+        work = bits + time + le(nonce, 8) + body_hash
+        work_hash = tagged("Lotus/v2/header/work", work)
+        block_id = tagged("Lotus/v2/blockid", prev_id + work_hash)
+        header = prev_id + bits + time + le(nonce, 8) + body
+        assert len(header) == 134
+        output["cases"].append(
+            {
+                "nonce": nonce,
+                "header": header.hex(),
+                "work_hash": work_hash.hex(),
+                "block_id": block_id.hex(),
+            }
+        )
+    print(json.dumps(output, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/lotus_v2/header.cpp b/src/lotus_v2/header.cpp
new file mode 100644
index 000000000..e889ea2ec
--- /dev/null
+++ b/src/lotus_v2/header.cpp
@@ -0,0 +1,152 @@
+#include "header.h"
+
+#include "vendor/blake3/blake3.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+
+namespace lotus::v2 {
+namespace {
+
+template <size_t N> void PutLE(std::array<uint8_t, N> &out, size_t pos,
+                              uint64_t value, size_t bytes) {
+    for (size_t i = 0; i < bytes; ++i) {
+        out[pos + i] = static_cast<uint8_t>(value >> (8 * i));
+    }
+}
+
+uint64_t ReadLE(const uint8_t *data, size_t bytes) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < bytes; ++i) {
+        value |= uint64_t{data[i]} << (8 * i);
+    }
+    return value;
+}
+
+Hash TaggedHash(const char *tag, const uint8_t *payload, size_t size) {
+    blake3_hasher hasher;
+    blake3_hasher_init(&hasher);
+    blake3_hasher_update(&hasher, tag, std::strlen(tag));
+    constexpr uint8_t separator = 0;
+    blake3_hasher_update(&hasher, &separator, 1);
+    blake3_hasher_update(&hasher, payload, size);
+    Hash result;
+    blake3_hasher_finalize(&hasher, result.data(), result.size());
+    return result;
+}
+
+uint32_t EncodeTarget(const Hash &target) {
+    int top = 31;
+    while (top >= 0 && target[top] == 0) {
+        --top;
+    }
+    if (top < 0) return 0;
+    uint32_t exponent = static_cast<uint32_t>(top + 1);
+    uint32_t mantissa = 0;
+    if (exponent <= 3) {
+        for (int i = top; i >= 0; --i) mantissa = (mantissa << 8) | target[i];
+        mantissa <<= 8 * (3 - exponent);
+    } else {
+        mantissa = (uint32_t{target[top]} << 16) |
+                   (uint32_t{target[top - 1]} << 8) | target[top - 2];
+    }
+    if (mantissa & 0x00800000U) {
+        mantissa >>= 8;
+        ++exponent;
+    }
+    return (exponent << 24) | mantissa;
+}
+
+} // namespace
+
+bool SerializeHeader(const Header &h, std::array<uint8_t, HEADER_SIZE> &out) {
+    if (h.time > MAX_TIME) return false;
+    std::copy(h.prev_id.begin(), h.prev_id.end(), out.begin());
+    PutLE(out, 32, h.bits, 4);
+    PutLE(out, 36, h.time, 6);
+    PutLE(out, 42, h.nonce, 8);
+    PutLE(out, 50, h.version, 4);
+    PutLE(out, 54, h.size, 8);
+    PutLE(out, 62, h.height, 8);
+    std::copy(h.tx_root.begin(), h.tx_root.end(), out.begin() + 70);
+    std::copy(h.state_root.begin(), h.state_root.end(), out.begin() + 102);
+    return true;
+}
+
+bool ParseHeader(const uint8_t *data, size_t size, Header &out) {
+    if (data == nullptr || size != HEADER_SIZE) return false;
+    Header parsed;
+    std::copy_n(data, 32, parsed.prev_id.begin());
+    parsed.bits = static_cast<uint32_t>(ReadLE(data + 32, 4));
+    parsed.time = ReadLE(data + 36, 6);
+    parsed.nonce = ReadLE(data + 42, 8);
+    parsed.version = static_cast<uint32_t>(ReadLE(data + 50, 4));
+    parsed.size = ReadLE(data + 54, 8);
+    parsed.height = ReadLE(data + 62, 8);
+    std::copy_n(data + 70, 32, parsed.tx_root.begin());
+    std::copy_n(data + 102, 32, parsed.state_root.begin());
+    out = parsed;
+    return true;
+}
+
+Hash BodyHash(const ChainId &chain_id, const Header &header) {
+    std::array<uint8_t, 116> body{};
+    std::copy(chain_id.begin(), chain_id.end(), body.begin());
+    PutLE(body, 32, header.version, 4);
+    PutLE(body, 36, header.size, 8);
+    PutLE(body, 44, header.height, 8);
+    std::copy(header.tx_root.begin(), header.tx_root.end(), body.begin() + 52);
+    std::copy(header.state_root.begin(), header.state_root.end(), body.begin() + 84);
+    return TaggedHash("Lotus/v2/header/body", body.data(), body.size());
+}
+
+bool WorkHash(const ChainId &chain_id, const Header &header, Hash &out) {
+    if (header.time > MAX_TIME) return false;
+    std::array<uint8_t, 50> work{};
+    PutLE(work, 0, header.bits, 4);
+    PutLE(work, 4, header.time, 6);
+    PutLE(work, 10, header.nonce, 8);
+    const Hash body_hash = BodyHash(chain_id, header);
+    std::copy(body_hash.begin(), body_hash.end(), work.begin() + 18);
+    out = TaggedHash("Lotus/v2/header/work", work.data(), work.size());
+    return true;
+}
+
+bool BlockId(const ChainId &chain_id, const Header &header, Hash &out) {
+    if (header.time > MAX_TIME) return false;
+    std::array<uint8_t, 64> input{};
+    std::copy(header.prev_id.begin(), header.prev_id.end(), input.begin());
+    Hash work_hash;
+    WorkHash(chain_id, header, work_hash);
+    std::copy(work_hash.begin(), work_hash.end(), input.begin() + 32);
+    out = TaggedHash("Lotus/v2/blockid", input.data(), input.size());
+    return true;
+}
+
+bool MeetsTarget(const Hash &block_id, const Hash &target) {
+    for (int i = 31; i >= 0; --i) {
+        if (block_id[i] < target[i]) return true;
+        if (block_id[i] > target[i]) return false;
+    }
+    return true;
+}
+
+bool DecodeTarget(uint32_t bits, const Hash &pow_limit, Hash &target) {
+    const uint32_t exponent = bits >> 24;
+    const uint32_t mantissa = bits & 0x007fffffU;
+    if ((bits & 0x00800000U) || mantissa == 0) return false;
+    Hash decoded{};
+    for (unsigned i = 0; i < 3; ++i) {
+        const int position = static_cast<int>(exponent) - 3 + static_cast<int>(i);
+        const uint8_t byte = static_cast<uint8_t>(mantissa >> (8 * i));
+        if (position >= 32 && byte != 0) return false;
+        if (position >= 0 && position < 32) decoded[position] = byte;
+    }
+    if (std::all_of(decoded.begin(), decoded.end(), [](uint8_t b) { return b == 0; })) return false;
+    if (EncodeTarget(decoded) != bits || !MeetsTarget(decoded, pow_limit)) return false;
+    target = decoded;
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/header.h b/src/lotus_v2/header.h
new file mode 100644
index 000000000..5ec27e8d3
--- /dev/null
+++ b/src/lotus_v2/header.h
@@ -0,0 +1,47 @@
+// Copyright (c) 2026 The Lotus developers
+// Candidate V2 header primitives. No legacy block type depends on this file.
+#ifndef LOTUS_V2_HEADER_H
+#define LOTUS_V2_HEADER_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace lotus::v2 {
+
+using Hash = std::array<uint8_t, 32>;
+using ChainId = Hash;
+constexpr size_t HEADER_SIZE = 134;
+constexpr uint64_t MAX_TIME = (uint64_t{1} << 48) - 1;
+
+struct Header {
+    Hash prev_id{};
+    uint32_t bits{};
+    uint64_t time{};
+    uint64_t nonce{};
+    uint32_t version{};
+    uint64_t size{};
+    uint64_t height{};
+    Hash tx_root{};
+    Hash state_root{};
+};
+
+// Hash byte arrays retain digest order. Interpret them as little-endian
+// unsigned integers only for PoW target comparison.
+bool SerializeHeader(const Header &header, std::array<uint8_t, HEADER_SIZE> &out);
+// Structural parse only. Caller validates version, height, target, size,
+// roots, time eligibility and parent against its chain manifest and context.
+bool ParseHeader(const uint8_t *data, size_t size, Header &out);
+Hash BodyHash(const ChainId &chain_id, const Header &header);
+bool WorkHash(const ChainId &chain_id, const Header &header, Hash &out);
+bool BlockId(const ChainId &chain_id, const Header &header, Hash &out);
+
+// Decode only canonical positive compact targets at or below pow_limit.
+// pow_limit is a 32-byte little-endian unsigned integer. Failure leaves
+// target unchanged. The parser and work/block hash functions likewise leave
+// their outputs unchanged on failure.
+bool DecodeTarget(uint32_t bits, const Hash &pow_limit, Hash &target);
+bool MeetsTarget(const Hash &block_id, const Hash &target);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/test_header.cpp b/src/lotus_v2/test_header.cpp
new file mode 100644
index 000000000..07a7ee799
--- /dev/null
+++ b/src/lotus_v2/test_header.cpp
@@ -0,0 +1,166 @@
+#include "header.h"
+#include "arith_uint256.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool condition, const char *message) {
+    if (!condition) {
+        std::cerr << "V2 header: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+std::string Hex(const uint8_t *data, size_t size) {
+    constexpr char chars[] = "0123456789abcdef";
+    std::string result;
+    for (size_t i = 0; i < size; ++i) {
+        result.push_back(chars[data[i] >> 4]);
+        result.push_back(chars[data[i] & 15]);
+    }
+    return result;
+}
+
+std::string Hex(const Hash &hash) { return Hex(hash.data(), hash.size()); }
+} // namespace
+
+int main() {
+    // These constants were computed independently with Python blake3 1.0.11,
+    // not by the vendored C implementation under test.
+    ChainId chain_id;
+    Header header;
+    for (unsigned i = 0; i < 32; ++i) {
+        chain_id[i] = i;
+        header.prev_id[i] = i + 32;
+        header.tx_root[i] = i + 64;
+        header.state_root[i] = i + 96;
+    }
+    header.bits = 0x1d00ffff;
+    header.time = 0x010203040506;
+    header.nonce = 0x08090a0b0c0d0e0f;
+    header.version = 2;
+    header.size = 0x1122334455667788;
+    header.height = 0x99aabbccddeeff00;
+    std::array<uint8_t, HEADER_SIZE> bytes;
+    Check(SerializeHeader(header, bytes), "serialize normal header");
+    Check(Hex(bytes.data(), bytes.size()) ==
+              "202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"
+              "ffff001d0605040302010f0e0d0c0b0a0908020000008877665544332211"
+              "00ffeeddccbbaa99404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f"
+              "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f",
+          "exact 134-byte encoding and offsets");
+    Header parsed;
+    parsed.version = 0xdeadbeef;
+    Check(!ParseHeader(bytes.data(), bytes.size() - 1, parsed), "reject short header");
+    Check(parsed.version == 0xdeadbeef, "short parse leaves output unchanged");
+    Check(!ParseHeader(bytes.data(), bytes.size() + 1, parsed), "reject trailing bytes");
+    Check(!ParseHeader(nullptr, bytes.size(), parsed), "reject null data");
+    Check(ParseHeader(bytes.data(), bytes.size(), parsed), "parse header");
+    std::array<uint8_t, HEADER_SIZE> repeated;
+    Check(SerializeHeader(parsed, repeated) && bytes == repeated, "round trip");
+    Check(Hex(BodyHash(chain_id, header)) ==
+              "1704e11edcbc47eb829d210ac1affb606dd4021c82305e07a028962456efec3d",
+          "independent BodyHash vector");
+    Hash work;
+    Hash id;
+    Check(WorkHash(chain_id, header, work) && Hex(work) ==
+              "56c49269bcb4709b42d48312a382badc0906162e5bd6e49aac48a7096288ffd1",
+          "independent WorkHash vector");
+    Check(BlockId(chain_id, header, id) && Hex(id) ==
+              "fbe9243579627fc3a41043c80395d33a8a01b91a9b86b6c6e629530595c83370",
+          "independent BlockID vector");
+    header.nonce++;
+    Check(WorkHash(chain_id, header, work) && Hex(work) ==
+              "3df1f29ca207e25132c7b3fdddfae0163b16d0c6bf7488e2810858e84f0673e5",
+          "nonce mutation WorkHash");
+    Check(BlockId(chain_id, header, id) && Hex(id) ==
+              "8a967f4522d06f683830cf003b9f456001e045f617bf4d4336754a91c75f5824",
+          "nonce mutation BlockID");
+    header.nonce = UINT64_MAX;
+    Check(BlockId(chain_id, header, id) && Hex(id) ==
+              "ce606e015b769cf60502917d0bac3597048e25668c7df323f817b53969aab371",
+          "maximum nonce BlockID");
+    const Hash old_body = BodyHash(chain_id, header);
+    chain_id[0]++;
+    Check(BodyHash(chain_id, header) != old_body, "ChainID enters BodyHash");
+    chain_id[0]--;
+    header.time = MAX_TIME;
+    Check(SerializeHeader(header, bytes) && bytes[41] == 0xff, "maximum u48 time");
+    header.time++;
+    bytes[0] = 0xa5;
+    Check(!SerializeHeader(header, bytes), "reject u48 overflow in encoding");
+    Check(bytes[0] == 0xa5, "failed encoding leaves output unchanged");
+    work.fill(0xa5);
+    Check(!WorkHash(chain_id, header, work), "reject u48 overflow in work hash");
+    Check(work[0] == 0xa5 && work[31] == 0xa5, "failed work hash leaves output unchanged");
+    id.fill(0xa5);
+    Check(!BlockId(chain_id, header, id), "reject u48 overflow in block ID");
+    Check(id[0] == 0xa5 && id[31] == 0xa5, "failed block hash leaves output unchanged");
+
+    Hash pow_limit{};
+    pow_limit[31] = 0xff;
+    Hash target{};
+    Check(DecodeTarget(0x1d00ffff, pow_limit, target), "Bitcoin-style canonical target");
+    Check(target[26] == 0xff && target[27] == 0xff && target[28] == 0,
+          "compact target byte placement");
+    Check(!DecodeTarget(0x1d80ffff, pow_limit, target), "reject sign bit");
+    Check(!DecodeTarget(0x1d000000, pow_limit, target), "reject zero");
+    Check(!DecodeTarget(0x22010000, pow_limit, target), "reject 257-bit overflow");
+    Check(!DecodeTarget(0x03000001, pow_limit, target), "reject noncanonical compact");
+    Hash low_limit{};
+    low_limit[0] = 1;
+    Check(!DecodeTarget(0x1d00ffff, low_limit, target), "enforce supplied POW_LIMIT");
+    Hash equal = target;
+    Check(MeetsTarget(equal, target), "target equality accepted");
+    equal[0]++;
+    Check(!MeetsTarget(equal, target), "target plus one rejected");
+    equal = target;
+    for (size_t i = 0; i < equal.size(); ++i) {
+        if (equal[i]-- != 0) break;
+    }
+    Check(MeetsTarget(equal, target), "target minus one accepted");
+
+    // Differential compact parsing against ABC's arithmetic representation.
+    // Cover every exponent and representative mantissa/sign/rounding classes.
+    const uint32_t mantissas[] = {0, 1, 0x7f, 0x80, 0xff, 0x100,
+                                  0xffff, 0x10000, 0x7fffff,
+                                  0x800001, 0xffffff};
+    const Hash limits[] = {pow_limit, low_limit};
+    for (const Hash &limit : limits) {
+        for (uint32_t exponent = 0; exponent < 256; ++exponent) {
+            for (uint32_t mantissa : mantissas) {
+                const uint32_t compact = (exponent << 24) | mantissa;
+                arith_uint256 reference;
+                bool negative = false;
+                bool overflow = false;
+                reference.SetCompact(compact, &negative, &overflow);
+                Hash reference_bytes{};
+                for (unsigned i = 0; i < 32; ++i) {
+                    reference_bytes[i] = static_cast<uint8_t>((reference >> (8 * i)).GetLow64());
+                }
+                const bool expected = (compact & 0x00800000U) == 0 &&
+                                      !negative && !overflow && reference != 0 &&
+                                      reference.GetCompact() == compact &&
+                                      MeetsTarget(reference_bytes, limit);
+                Hash actual;
+                actual.fill(0xa5);
+                const bool accepted = DecodeTarget(compact, limit, actual);
+                Check(accepted == expected, "ABC compact differential acceptance");
+                if (accepted) {
+                    Check(actual == reference_bytes, "ABC compact differential value");
+                } else {
+                    Check(std::all_of(actual.begin(), actual.end(),
+                                      [](uint8_t byte) { return byte == 0xa5; }),
+                          "failed target decoding leaves output unchanged");
+                }
+            }
+        }
+    }
+    std::cout << "V2 header primitive vectors and boundaries passed\n";
+}
