From 960d665b86e6a8c36b58e47415c92d1f1fa283df Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:42:49 -0700
Subject: [PATCH] Bound optional-policy activation fixtures and retain Doged
 user-agent expectations

Test miner-fund policy with an explicit local activation height rather than overflowing the disabled mainnet sentinel. This keeps the policy assertions meaningful without enabling a BCH consensus upgrade on Dogecoin. Match the retained Doged user-agent string.

diff --git a/src/test/net_tests.cpp b/src/test/net_tests.cpp
index cf73da031cbab43f00f771ed04987ae461609a78..d4c5bf99b32069890fbe03aeed37750e28e09deb 100644
--- a/src/test/net_tests.cpp
+++ b/src/test/net_tests.cpp
@@ -358,7 +358,7 @@ BOOST_AUTO_TEST_CASE(test_userAgent) {
     gArgs.ForceSetMultiArg("-uacomment", {uacomment});
 
     const std::string versionMessage =
-        "/Bitcoin ABC:" + ToString(CLIENT_VERSION_MAJOR) + "." +
+        "/doged:" + ToString(CLIENT_VERSION_MAJOR) + "." +
         ToString(CLIENT_VERSION_MINOR) + "." +
         ToString(CLIENT_VERSION_REVISION) + "(EB8.0; " + uacomment + ")/";
 
diff --git a/src/test/policy_block_tests.cpp b/src/test/policy_block_tests.cpp
index eb31f9c20dc5c5a3f871ba577fab2179a86dad38..00ecd644d2df8b2c7ec76597976417932652527a 100644
--- a/src/test/policy_block_tests.cpp
+++ b/src/test/policy_block_tests.cpp
@@ -44,7 +44,10 @@ static CBlock BlockWithMinerFund(const CChainParams &chainparams,
 
 BOOST_AUTO_TEST_CASE(policy_minerfund) {
     const CChainParams &chainparams = Params();
-    const Consensus::Params &consensusParams = chainparams.GetConsensus();
+    auto consensusParams = chainparams.GetConsensus();
+    // Exercise optional policy at bounded synthetic heights; Dogecoin mainnet
+    // deliberately disables the BCH hard-consensus activation.
+    consensusParams.wellingtonHeight = 800000;
     Assert(m_node.args)->ForceSetArg("-enableminerfund", "1");
 
     std::array<BlockHash, 12> blockhashes;
