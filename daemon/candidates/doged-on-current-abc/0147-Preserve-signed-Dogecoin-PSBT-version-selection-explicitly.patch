From 47bca574d68da0277737692df42bd2945b90de4f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:46:32 -0700
Subject: [PATCH] Preserve signed Dogecoin PSBT version selection explicitly

Match pinned Doged9690833b joinpsbts: compare version bit patterns as uint32 and write the selected version as int32. Explicit casts avoid signedness warnings without changing ordering for negative legacy versions. The isolated RPC regression joins negative/positive and negative/negative pairs in both orders without wallet or chain dependencies.

diff --git a/src/rpc/rawtransaction.cpp b/src/rpc/rawtransaction.cpp
index 12772e1352d90d00db69ea570fee87a3bdd9634a..a31f0991b20d29a860331bab51cb4d9d220c8cfe 100644
--- a/src/rpc/rawtransaction.cpp
+++ b/src/rpc/rawtransaction.cpp
@@ -1440,8 +1440,8 @@ RPCHelpMan joinpsbts() {
                 }
                 psbtxs.push_back(psbtx);
                 // Choose the highest version number
-                if (psbtx.tx->nVersion > best_version) {
-                    best_version = psbtx.tx->nVersion;
+                if (static_cast<uint32_t>(psbtx.tx->nVersion) > best_version) {
+                    best_version = static_cast<uint32_t>(psbtx.tx->nVersion);
                 }
                 // Choose the lowest lock time
                 if (psbtx.tx->nLockTime < best_locktime) {
@@ -1452,7 +1452,7 @@ RPCHelpMan joinpsbts() {
             // Create a blank psbt where everything will be added
             PartiallySignedTransaction merged_psbt;
             merged_psbt.tx = CMutableTransaction();
-            merged_psbt.tx->nVersion = best_version;
+            merged_psbt.tx->nVersion = static_cast<int32_t>(best_version);
             merged_psbt.tx->nLockTime = best_locktime;
 
             // Merge
diff --git a/test/functional/dogecoin_rpc_psbt_versions.py b/test/functional/dogecoin_rpc_psbt_versions.py
new file mode 100644
index 0000000000000000000000000000000000000000..a4d99e9fe1e321e7a58a057333d1c95ab5195b07
--- /dev/null
+++ b/test/functional/dogecoin_rpc_psbt_versions.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Preserve Doged joinpsbts unsigned wire-version selection and signed RPC output."""
+from test_framework.messages import COutPoint, CTransaction, CTxIn, CTxOut
+from test_framework.script import CScript, OP_TRUE
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+
+class DogecoinPSBTVersionsTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+
+    def run_test(self):
+        node = self.nodes[0]
+
+        def psbt(version, prevhash):
+            tx = CTransaction()
+            tx.nVersion = version
+            tx.vin = [CTxIn(COutPoint(prevhash, 0))]
+            tx.vout = [CTxOut(1000, CScript([OP_TRUE]))]
+            return node.converttopsbt(tx.serialize().hex())
+
+        # Pinned Doged chooses the greatest uint32 wire representation,
+        # even though decoded versions use int32. Test both input orders.
+        for versions, expected in [((1, -1), -1), ((-2147483648, 2), -2147483648), ((-2, -1), -1)]:
+            parts = [psbt(version, index + 1) for index, version in enumerate(versions)]
+            for ordered in (parts, parts[::-1]):
+                joined = node.decodepsbt(node.joinpsbts(ordered))
+                assert_equal(joined["tx"]["version"], expected)
+                assert_equal(len(joined["tx"]["vin"]), 2)
+
+
+if __name__ == "__main__":
+    DogecoinPSBTVersionsTest().main()
