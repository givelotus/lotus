From aa95fa8ec9d60f28b365ea846435d73fa750aa30 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:42:54 -0700
Subject: [PATCH] test: set explicit satoshi-scale mining fee for mempool
 fixtures

Dogecoin production blockmintxfee rejects the synthetic 1000-satoshi entries before Avalanche finalization, unlike the inherited ABC default. Reproduced remove_for_finalized_block failure and verified it passes with -blockmintxfee=0.00001000. Set that test-only policy before mempool construction; keep all finalization/removal assertions. Require the vector length before indexing so a future regression reports the failed assertion rather than aborting the remaining suite.

diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index 8c7f094d90dab4054394eb6ecde3cee4167c06f9..56e3342787615f72d8c6e791719c27ebd9c366d0 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -20,7 +20,14 @@
 #include <algorithm>
 #include <vector>
 
-BOOST_FIXTURE_TEST_SUITE(mempool_tests, TestingSetup)
+struct MempoolTestingSetup : TestingSetup {
+    MempoolTestingSetup()
+        : TestingSetup(ChainType::MAIN, {"-blockmintxfee=0.00001000"}) {}
+};
+
+// Synthetic entries below use satoshi-scale fees. Exercise finalization with
+// that explicit policy rather than Dogecoin's higher production mining fee.
+BOOST_FIXTURE_TEST_SUITE(mempool_tests, MempoolTestingSetup)
 
 static constexpr auto REMOVAL_REASON_DUMMY = MemPoolRemovalReason::CONFLICT;
 
@@ -607,7 +614,7 @@ BOOST_AUTO_TEST_CASE(remove_for_finalized_block) {
                                                chainman.ActiveChainstate(),
                                                finalizedTxIds));
         BOOST_CHECK(pool.isAvalancheFinalizedPreConsensus(txid));
-        BOOST_CHECK_EQUAL(finalizedTxIds.size(), 1);
+        BOOST_REQUIRE_EQUAL(finalizedTxIds.size(), 1);
         BOOST_CHECK_EQUAL(finalizedTxIds[0], txid);
 
         txs.push_back(std::move(tx));
