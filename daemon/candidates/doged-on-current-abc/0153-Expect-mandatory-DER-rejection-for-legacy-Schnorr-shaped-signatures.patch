From 9a151ff730ae6ff4ca1b4d11083f29721ef433cb Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:48:40 -0700
Subject: [PATCH] Expect mandatory DER rejection for legacy Schnorr-shaped
 signatures

The corrected legacy encoding rules reject these non-DER signatures before cryptographic verification under active BIP66. Update both mempool and block-level functional assertions without changing the rejection requirement.

diff --git a/test/functional/feature_legacy_script_rules.py b/test/functional/feature_legacy_script_rules.py
index 784b5f5871a38748979940d329efe0bce3a5e61e..f0f17ae05d6d561dbaa278646ff3cdd23af3755e 100644
--- a/test/functional/feature_legacy_script_rules.py
+++ b/test/functional/feature_legacy_script_rules.py
@@ -239,10 +239,10 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
         txsig = private_key.sign_schnorr(sighash) + b"\x01"
         spend_tx.vin[0].scriptSig = CScript([txsig, public_key, script])
 
-        # We don't get a "Signature must be zero" error as it's not mandatory
+        # Legacy signatures must pass mandatory DER encoding before verification.
         assert_raises_rpc_error(
             -26,
-            "mandatory-script-verify-flag-failed (Script evaluated without error but finished with a false/empty top stack element)",
+            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
             node.sendrawtransaction,
             spend_tx.serialize().hex(),
         )
@@ -250,7 +250,7 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
             node,
             peer,
             spend_tx,
-            "mandatory-script-verify-flag-failed (Script evaluated without error but finished with a false/empty top stack element)",
+            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
         )
         # Schnorr sigs allowed on XEC with FORKID
         sighash = SignatureHashForkId(script, spend_tx, 0, 0x41, 2000)
@@ -270,7 +270,7 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
 
         assert_raises_rpc_error(
             -26,
-            "mandatory-script-verify-flag-failed (Script failed an OP_CHECKSIGVERIFY operation)",
+            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
             node.sendrawtransaction,
             spend_tx.serialize().hex(),
         )
@@ -278,7 +278,7 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
             node,
             peer,
             spend_tx,
-            "mandatory-script-verify-flag-failed (Script failed an OP_CHECKSIGVERIFY operation)",
+            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
         )
         sighash = SignatureHashForkId(script, spend_tx, 0, 0x41, 2000)
         txsig = private_key.sign_schnorr(sighash) + b"\x41"
