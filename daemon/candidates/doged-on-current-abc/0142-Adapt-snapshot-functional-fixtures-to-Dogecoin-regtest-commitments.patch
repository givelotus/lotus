From 054e410598bdef5da477fff5424df72e8ca80d8d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:45:06 -0700
Subject: [PATCH] Adapt snapshot functional fixtures to Dogecoin regtest
 commitments

Reuse the exact network magic, snapshot hashes, block hashes and oversized monetary-value encoding from final Doged reference9690833. Keep current ABC malformed coin-count regression (the reference predates it). Deterministic chain setup and dumptxoutset already pass on the integrated candidate; full snapshot activation/loading is validated next.

diff --git a/test/functional/feature_assumeutxo.py b/test/functional/feature_assumeutxo.py
index ef0694aeca792450477aef440991c3be1cbb05be..49dcde45a9fe66f0ddeff24f527ea89bc4118cef 100644
--- a/test/functional/feature_assumeutxo.py
+++ b/test/functional/feature_assumeutxo.py
@@ -120,8 +120,8 @@ class AssumeutxoTest(BitcoinTestFramework):
         self.log.info("  - snapshot file with mismatching chain disk magic")
         invalid_magics = [
             # magic, name, real
-            [0xF9BEB4D9, "main", True],
-            [0x0B110907, "test", True],
+            [0xCB98A6B0, "main", True],
+            [0xFB87B5BF, "test", True],
             [0x00000000, "", False],
             [0xFFFFFFFF, "", False],
         ]
@@ -195,7 +195,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             [
                 b"\xff" * 32,
                 0,
-                "74fab8900700c8a0a4c6b50330252d92d651088939a41b307a8fcdddfed65f77",
+                "edb08eb048d08dfea525998e5a17807cfbb9b75785c57dfa4fd716f74d622f77",
                 None,
             ],
             # wrong txid coins count
@@ -220,7 +220,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             [
                 b"\x01",
                 33,
-                "3872c8e52554070ca410faff98e42f63c99d08f536be343af7c04143e0e8f2b2",
+                "8e7330e122932f44d93f6614ffcb27d3f6aa5f8ba2dc50d68667aea52feb1a45",
                 None,
             ],
             # wrong coin code VARINT((coinbase ? 1 : 0) | (height << 1))
@@ -228,14 +228,14 @@ class AssumeutxoTest(BitcoinTestFramework):
             [
                 b"\x80",
                 34,
-                "b14c9595737179fe57e6d7a9f8e879a440833fa95ba52d210f1f7e3c02be64b2",
+                "87a4456a0cb7105b27d4d5f08a58694d4dd1e7af27cf9ad4abaa9dec8026ba88",
                 None,
             ],
             # another wrong coin code
             [
                 b"\x83",
                 34,
-                "296b4acd0d41dd4c0e845a7ed0cbdc602e5a7d092d5b4948a72835d2158f1e8e",
+                "5b03c9123a31964c635572acdc81a7cceddb71fce8ac259ffab392eb10c2e0fa",
                 None,
             ],
             # wrong coin case with height 364 and coinbase 0
@@ -247,7 +247,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             ],
             # Amount exceeds MAX_MONEY
             [
-                b"\xca\xd2\x8f\x5a",
+                b"\x81\xce\xa2\xab\x87\x09\x00",
                 36,
                 None,
                 "[snapshot] bad snapshot data after deserializing 0 coins - bad tx out value",
@@ -268,7 +268,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             log_msg = (
                 custom_message
                 if custom_message is not None
-                else f"[snapshot] bad snapshot content hash: expected a966794ed5a2f9debaefc7ca48dbc5d5e12a89ff9fe45bd00ec5732d074580a9, got {wrong_hash}"
+                else f"[snapshot] bad snapshot content hash: expected f4217e2debd5677de2a12a7db17e5f1bbc2663bea3a28a639300601e135b3cc9, got {wrong_hash}"
             )
             expected_error(log_msg=log_msg)
 
@@ -276,7 +276,7 @@ class AssumeutxoTest(BitcoinTestFramework):
         for node in self.nodes[1:4]:
             msg = (
                 "Unable to load UTXO snapshot: The base block header "
-                "(118a7d5473bccce9b314789e14ce426fc65fb09dfeda0131032bb6d86ed2fd0b) "
+                "(147029b0cd6d9b3847db3660938c8220b24d7db3069a039f12a07f4322c8d888) "
                 "must appear in the headers chain. Make sure all headers are syncing, "
                 "and call loadtxoutset again."
             )
@@ -531,7 +531,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             assert_equal(node.getblockcount(), height - 1)
             msg = (
                 "Unable to load UTXO snapshot: The base block header "
-                "(118a7d5473bccce9b314789e14ce426fc65fb09dfeda0131032bb6d86ed2fd0b) "
+                "(147029b0cd6d9b3847db3660938c8220b24d7db3069a039f12a07f4322c8d888) "
                 "is part of an invalid chain."
             )
             assert_raises_rpc_error(-32603, msg, node.loadtxoutset, dump_output_path)
@@ -611,7 +611,7 @@ class AssumeutxoTest(BitcoinTestFramework):
         def check_dump_output(output):
             assert_equal(
                 output["txoutset_hash"],
-                "a966794ed5a2f9debaefc7ca48dbc5d5e12a89ff9fe45bd00ec5732d074580a9",
+                "f4217e2debd5677de2a12a7db17e5f1bbc2663bea3a28a639300601e135b3cc9",
             )
             assert_equal(output["nchaintx"], blocks[SNAPSHOT_BASE_HEIGHT].chain_tx)
 
@@ -646,7 +646,7 @@ class AssumeutxoTest(BitcoinTestFramework):
         dump_output4 = n0.dumptxoutset(path="utxos4.dat", rollback=prev_snap_height)
         assert_equal(
             dump_output4["txoutset_hash"],
-            "9f399ed4096b53d236b7f8473fddaa76eb11b7b5d92849a21e1cd8ac475d1dc4",
+            "f4ba84cad343a43d84108a91252787a93ec8fcafed17d2b503231ecbbe4d9783",
         )
         assert sha256sum_file(dump_output["path"]) != sha256sum_file(
             dump_output4["path"]
