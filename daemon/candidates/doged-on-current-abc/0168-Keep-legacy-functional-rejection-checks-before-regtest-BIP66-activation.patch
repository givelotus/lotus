From 0a1832894eb461c2c6cd826f0b542e28fb6bf00e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:59:51 -0700
Subject: [PATCH] Keep legacy functional rejection checks before regtest BIP66
 activation

The finalized Dogecoin regtest parameters activate BIP66 at height1251. This fixture spends near height100, so mandatory validation still rejects Schnorr-shaped signatures through failed ECDSA evaluation rather than DER encoding. Restore the original CHECKSIG/CHECKSIGVERIFY rejection expectations and assert the intended preactivation range. Strict-DER native vectors continue to require SIG_DER; interpreter behavior is unchanged.

diff --git a/test/functional/feature_legacy_script_rules.py b/test/functional/feature_legacy_script_rules.py
index f0f17ae05d6d561dbaa278646ff3cdd23af3755e..34d3c6e91b63b66e214e0685230d6b2471850685 100644
--- a/test/functional/feature_legacy_script_rules.py
+++ b/test/functional/feature_legacy_script_rules.py
@@ -239,10 +239,13 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
         txsig = private_key.sign_schnorr(sighash) + b"\x01"
         spend_tx.vin[0].scriptSig = CScript([txsig, public_key, script])
 
-        # Legacy signatures must pass mandatory DER encoding before verification.
+        # This fixture runs before regtest BIP66 activation at height 1251.
+        # Standard DER policy rejects the encoding, but the mandatory fallback
+        # still reaches legacy ECDSA verification and rejects the false result.
+        assert node.getblockcount() < 1251
         assert_raises_rpc_error(
             -26,
-            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
+            "mandatory-script-verify-flag-failed (Script evaluated without error but finished with a false/empty top stack element)",
             node.sendrawtransaction,
             spend_tx.serialize().hex(),
         )
@@ -250,7 +253,7 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
             node,
             peer,
             spend_tx,
-            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
+            "mandatory-script-verify-flag-failed (Script evaluated without error but finished with a false/empty top stack element)",
         )
         # Schnorr sigs allowed on XEC with FORKID
         sighash = SignatureHashForkId(script, spend_tx, 0, 0x41, 2000)
@@ -270,7 +273,7 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
 
         assert_raises_rpc_error(
             -26,
-            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
+            "mandatory-script-verify-flag-failed (Script failed an OP_CHECKSIGVERIFY operation)",
             node.sendrawtransaction,
             spend_tx.serialize().hex(),
         )
@@ -278,7 +281,7 @@ class LegacyScriptRulesTest(BitcoinTestFramework):
             node,
             peer,
             spend_tx,
-            "mandatory-script-verify-flag-failed (Non-canonical DER signature)",
+            "mandatory-script-verify-flag-failed (Script failed an OP_CHECKSIGVERIFY operation)",
         )
         sighash = SignatureHashForkId(script, spend_tx, 0, 0x41, 2000)
         txsig = private_key.sign_schnorr(sighash) + b"\x41"
