From 499476cbdf06fabf9f7fad84f174fdcd009b5dd9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:08 -0700
Subject: [PATCH] Use current hash helper import in legacy signing test

Match the final Doged fixture by importing hash160 solely from test_framework.hash, preserving the current framework module split.

diff --git a/test/functional/feature_legacy_signrawtransaction.py b/test/functional/feature_legacy_signrawtransaction.py
index 8b085276ebd8f5e27b6b087120b3d8d520c402c3..454a2ca38a068749fb57e8b7da138bed5038a8b8 100644
--- a/test/functional/feature_legacy_signrawtransaction.py
+++ b/test/functional/feature_legacy_signrawtransaction.py
@@ -13,7 +13,6 @@ from test_framework.script import (
     OP_EQUALVERIFY,
     OP_HASH160,
     CScript,
-    hash160,
 )
 from test_framework.test_framework import BitcoinTestFramework
 from test_framework.util import assert_equal, assert_raises_rpc_error
@@ -36,8 +35,12 @@ class LegacyScriptSignrawtransactionTest(BitcoinTestFramework):
         # Preserve the pinned Doged optional address-type RPC contract.
         assert node.validateaddress(node.getnewaddress("", "legacy"))["isvalid"]
         assert node.validateaddress(node.getrawchangeaddress("legacy"))["isvalid"]
-        assert_raises_rpc_error(-5, "Unknown address type", node.getnewaddress, "", "invalid")
-        assert_raises_rpc_error(-5, "Unknown address type", node.getrawchangeaddress, "invalid")
+        assert_raises_rpc_error(
+            -5, "Unknown address type", node.getnewaddress, "", "invalid"
+        )
+        assert_raises_rpc_error(
+            -5, "Unknown address type", node.getrawchangeaddress, "invalid"
+        )
 
         def check_signed_result(node, result):
             assert result["complete"], f"Signing failed: {result}"
