+        CBlockHeader header;
+        header.nVersion = MakeVersionWithChainId(AUXPOW_CHAIN_ID, 4);
+        header.hashPrevBlock = previous.GetHash();
+        header.hashMerkleRoot = uint256(salt);
+        header.nTime = previous.nTime + 1;
+        header.nBits = previous.nBits;
+        while (!CheckAuxProofOfWork(header, params)) {
+            ++header.nNonce;
+        }
+        return header;
+    };
+    const auto headerA = mine(headerG, 1);
+    const auto headerAA = mine(headerA, 2);
+    const auto headerB = mine(headerG, 3);
+    const auto headerAB = mine(headerA, 4);
