diff --git a/src/test/validation_tests.cpp b/src/test/validation_tests.cpp
index f5bb2b2b87ba0a0b246e9f593eb2be212590a719..fc00924d9331c0f5aa4c6368a048de913c486a31 100644
--- a/src/test/validation_tests.cpp
+++ b/src/test/validation_tests.cpp
@@ -32,6 +32,37 @@
 
 BOOST_FIXTURE_TEST_SUITE(validation_tests, TestingSetup)
 
+BOOST_AUTO_TEST_CASE(parallel_header_pow) {
+    const auto chainparams = CreateChainParams(ArgsManager{}, ChainType::MAIN);
+    const auto &params = chainparams->GetConsensus();
+    const auto valid = chainparams->GenesisBlock().GetBlockHeader();
+    auto invalid = valid;
+    invalid.nBits = 0;
+
+    // Exercise the real queue with no worker and multiple workers, including
+    // empty batches and error reset after a failed batch.
+    for (const int workers : {0, 2}) {
+        CCheckQueue<CPowCheck> queue(128, workers);
+        for (const auto &headers :
+             {std::vector<CBlockHeader>{},
+              std::vector<CBlockHeader>(257, valid),
+              std::vector<CBlockHeader>{valid, invalid, valid},
+              std::vector<CBlockHeader>{valid}}) {
+            CCheckQueueControl<CPowCheck> control(queue);
+            std::vector<CPowCheck> checks;
+            for (const auto &header : headers) {
+                checks.emplace_back(header, params);
+            }
+            control.Add(std::move(checks));
+            BOOST_CHECK_EQUAL(!control.Complete().has_value(),
+                              HasValidProofOfWork(headers, params));
+        }
+    }
+    BOOST_CHECK(m_node.chainman->HasValidProofOfWork({valid}, params));
+    BOOST_CHECK(!m_node.chainman->HasValidProofOfWork({invalid}, params));
+    BOOST_CHECK(m_node.chainman->HasValidProofOfWork({}, params));
+}
