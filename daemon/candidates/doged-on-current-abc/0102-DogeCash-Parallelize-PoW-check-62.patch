+/** A single Scrypt/AuxPoW verification for the node-owned worker queue.
+ * The consensus parameters must remain alive until the queue completes.
+ */
+class CPowCheck {
+    CBlockHeader m_header;
+    const Consensus::Params *m_params;
+
+public:
+    CPowCheck(const CBlockHeader &header, const Consensus::Params &params)
+        : m_header(header), m_params(&params) {}
+    std::optional<bool> operator()();
+};
+
 /**
