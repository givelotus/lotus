diff --git a/src/validation.cpp b/src/validation.cpp
index c009e72aebe1f245b2599b20643d55f729389342..c992c6de7814af07b47189cc2f526007fd76d490 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4509,6 +4509,27 @@ bool HasValidProofOfWork(const std::vector<CBlockHeader> &headers,
                        });
 }
 
+std::optional<bool> CPowCheck::operator()() {
+    if (CheckAuxProofOfWork(m_header, *m_params)) {
+        return std::nullopt;
+    }
+    return false;
+}
+
+bool ChainstateManager::HasValidProofOfWork(
+    const std::vector<CBlockHeader> &headers, const Consensus::Params &params) {
+    // Scrypt is expensive. The controlling thread also performs work, so this
+    // works unchanged with -par=1 (zero additional worker threads).
+    CCheckQueueControl<CPowCheck> control(m_pow_check_queue);
+    std::vector<CPowCheck> checks;
+    checks.reserve(headers.size());
+    for (const auto &header : headers) {
+        checks.emplace_back(header, params);
+    }
+    control.Add(std::move(checks));
+    return !control.Complete().has_value();
+}
