From 6e3627781eb94d70b467525a936993ca7bed8409 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:53:31 -0700
Subject: [PATCH] Limit generated Dogecoin blocks to the fixed consensus size

Clamp configured mining capacity to the smaller of the policy limit and the one-megabyte Dogecoin consensus limit, reserving coinbase space within that bound. An oversized -blockmaxsize must not make CreateNewBlock construct an invalid template under normal mempool load.

diff --git a/src/node/blockfitter.cpp b/src/node/blockfitter.cpp
index 8673c85652c18b84801bf6f003b6107449f5b58e..5f23f0625124d90ebd83840af93107a56bdb420a 100644
--- a/src/node/blockfitter.cpp
+++ b/src/node/blockfitter.cpp
@@ -21,11 +21,13 @@ BlockFitter::Options::Options()
 
 BlockFitter::BlockFitter(const Options &options) {
     blockMinFeeRate = options.blockMinFeeRate;
-    // Limit size to between COINBASE_RESERVED_SIZE and
-    // options.nExcessiveBlockSize - COINBASE_RESERVED_SIZE for sanity:
+    // Respect Dogecoin consensus even when configured policy limits are larger.
+    // Reserve coinbase space inside the smaller consensus/policy limit.
+    const uint64_t maxBlockSize =
+        std::min(options.nExcessiveBlockSize, uint64_t{LEGACY_MAX_BLOCK_SIZE});
     nMaxGeneratedBlockSize =
         std::clamp(options.nMaxGeneratedBlockSize, COINBASE_RESERVED_SIZE,
-                   options.nExcessiveBlockSize - COINBASE_RESERVED_SIZE);
+                   maxBlockSize - COINBASE_RESERVED_SIZE);
     // Calculate the max consensus sigchecks for this block.
     // Allow the full amount of signature check operations in lieu of a separate
     // config option. (We are mining relayed transactions with validity cached
