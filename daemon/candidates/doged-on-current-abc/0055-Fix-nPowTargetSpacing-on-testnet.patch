From 056c1fb7b1e5484e96f6c84a7e55172aae0a8d69 Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Wed, 3 Sep 2025 17:56:07 +0000
Subject: [PATCH] Fix nPowTargetSpacing on testnet

(cherry picked from commit 5b75fe7a62b9d03ec510230d7dc514ecf3ec2519)

Maintenance rationale (2026-10-14):
Use the historical Dogecoin target spacing on testnet so difficulty adjustment and minimum-difficulty exceptions use the correct interval.

diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index f104115923b37af0582a5e1c97ea05e379525676..729eed4ea82c2c429e96edad96255eec2fb552cd 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -251,7 +251,7 @@ public:
         consensus.powLimit = uint256S("0x00000fffffffffffffffffffffffffffffffff"
                                       "ffffffffffffffffffffffffff");
         // two weeks
-        consensus.nPowTargetSpacing = 10 * 60;
+        consensus.nPowTargetSpacing = 60; // one minute
         consensus.fPowNoRetargeting = false;
 
         // two days
