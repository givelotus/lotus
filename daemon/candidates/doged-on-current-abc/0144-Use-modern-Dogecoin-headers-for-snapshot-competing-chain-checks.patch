From 96e434871658f3a541b9a8d9b148dbc2c0c8b7d8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:46:10 -0700
Subject: [PATCH] Use modern Dogecoin headers for snapshot competing-chain
 checks

The new canonical AuxPoW activation rule rejects legacy version1 headers past regtestheight20. Keep the original snapshot most-work fork scenario by solving ordinary Scrypt headers with Dogecoin chain ID and modern low version4, rather than disabling activation checks.

diff --git a/test/functional/feature_assumeutxo.py b/test/functional/feature_assumeutxo.py
index 49dcde45a9fe66f0ddeff24f527ea89bc4118cef..810ba31ba2f3db2d13cd6f282dccd07d6e380392 100644
--- a/test/functional/feature_assumeutxo.py
+++ b/test/functional/feature_assumeutxo.py
@@ -28,7 +28,7 @@ import time
 from dataclasses import dataclass
 from shutil import rmtree
 
-from test_framework.blocktools import create_block, create_coinbase
+from test_framework.blocktools import VERSION_CHAIN_ID_BITS, create_block, create_coinbase
 from test_framework.messages import CBlockHeader, CTransaction, FromHex, msg_headers
 from test_framework.p2p import P2PInterface
 from test_framework.test_framework import BitcoinTestFramework
@@ -348,12 +348,14 @@ class AssumeutxoTest(BitcoinTestFramework):
             create_coinbase(SNAPSHOT_BASE_HEIGHT),
             block_time,
         )
+        fork_block1.nVersion = VERSION_CHAIN_ID_BITS | 4
         fork_block1.solve()
         fork_block2 = create_block(
             fork_block1.hash_int,
             create_coinbase(SNAPSHOT_BASE_HEIGHT + 1),
             block_time + 1,
         )
+        fork_block2.nVersion = VERSION_CHAIN_ID_BITS | 4
         fork_block2.solve()
         node1.submitheader(fork_block1.serialize().hex())
         node1.submitheader(fork_block2.serialize().hex())
