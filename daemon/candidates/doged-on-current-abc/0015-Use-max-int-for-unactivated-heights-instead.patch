From 35cbdaa2e4f6a2e35a47f84740cc66da10492213 Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Thu, 13 Jun 2024 19:10:59 +0000
Subject: [PATCH] Use max int for unactivated heights instead

Maintenance explanation (added 2026-10-14; not original author text):
Represent not-yet-activated rules with maximum integer heights. A zero
height would enforce the inherited rule immediately and misdescribe the port.

The original subject, author and author date are preserved. Only message
metadata changes; exact source diff bytes and intermediate trees are retained.

diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 7050c9167bec71f807c6e36f32656fc34326f2ca..a60894eb20619c283af895780c6c55c38d542dd7 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -98,7 +98,7 @@ public:
         // block
         consensus.BIP66Height = 1034383;
         // TODO: CSV not activated yet
-        consensus.CSVHeight = 9000000;
+        consensus.CSVHeight = 0x7fffffff;
         consensus.powLimit = uint256S(
             "00000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffff");
         // two weeks
@@ -265,7 +265,7 @@ public:
         // 21b8b97dcdb94caa67c7f8f6dbf22e61e0cfe0e46e1fff3528b22864659e9b38
         consensus.BIP66Height = 708658;
         // TODO: CSV not activated yet
-        consensus.CSVHeight = 9000000;
+        consensus.CSVHeight = 0x7fffffff;
         consensus.powLimit = uint256S(
             "00000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffff");
         // two weeks
