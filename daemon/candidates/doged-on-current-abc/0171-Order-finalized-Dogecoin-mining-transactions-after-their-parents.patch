index b2264a26171f281fd982e0e0e4bf20a583d517cc..030e77c7b5b4efada80d02125bee8ed9fe61981e 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -31,11 +31,59 @@
 #include <versionbits.h>
 
 #include <algorithm>
+#include <functional>
 #include <queue>
 #include <unordered_map>
 #include <utility>
 
 namespace node {
+/** Keep the finalized selection while respecting Dogecoin dependency order. */
+static void OrderFinalizedTransactions(std::vector<CBlockTemplateEntry> &entries) {
+    std::unordered_map<TxId, size_t, SaltedTxIdHasher> positions;
+    positions.reserve(entries.size());
+    for (size_t i = 1; i < entries.size(); ++i) {
+        positions.emplace(entries[i].tx->GetId(), i);
+    }
+
+    std::vector<size_t> remainingParents(entries.size());
+    std::vector<std::vector<size_t>> children(entries.size());
+    for (size_t i = 1; i < entries.size(); ++i) {
+        for (const auto &input : entries[i].tx->vin) {
+            const auto parent = positions.find(input.prevout.GetTxId());
+            if (parent != positions.end()) {
+                ++remainingParents[i];
+                children[parent->second].push_back(i);
+            }
+        }
+    }
+
+    // The original radix order is TxId order. Use its indices to break ties
+    // deterministically, without allowing a child before any selected parent.
+    std::priority_queue<size_t, std::vector<size_t>, std::greater<size_t>> ready;
+    for (size_t i = 1; i < entries.size(); ++i) {
+        if (remainingParents[i] == 0) {
+            ready.push(i);
+        }
+    }
+    std::vector<CBlockTemplateEntry> ordered;
+    ordered.reserve(entries.size());
+    ordered.push_back(std::move(entries[0]));
+    while (!ready.empty()) {
+        const size_t index = ready.top();
+        ready.pop();
+        ordered.push_back(std::move(entries[index]));
+        for (const size_t child : children[index]) {
+            if (--remainingParents[child] == 0) {
+                ready.push(child);
+            }
+        }
+    }
+    if (ordered.size() != entries.size()) {
+        throw std::runtime_error("Cyclic finalized transaction dependencies");
+    }
+    entries = std::move(ordered);
+}
