From 55b3b068749738c018ee1427eaddb1527726861d Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Thu, 2 Oct 2025 18:06:34 +0000
Subject: [PATCH] Remove btc-specific wallet version check

Maintenance rationale (2026-10-14):
Remove the Bitcoin wallet-version assumption that rejects the Dogecoin lineage wallet; retain the current wallet loading and upgrade implementation.

diff --git a/src/wallet/walletdb.cpp b/src/wallet/walletdb.cpp
index db65e5daf9def373d5d79c84258f12bcff9271e9..431d04b57fe50bcabb5c609b641fe221db23993b 100644
--- a/src/wallet/walletdb.cpp
+++ b/src/wallet/walletdb.cpp
@@ -907,11 +907,6 @@ DBErrors WalletBatch::LoadWallet(CWallet *pwallet) {
         WriteTx(pwallet->mapWallet.at(txid));
     }
 
-    // Rewrite encrypted wallets of versions 0.4.0 and 0.5.0rc:
-    if (wss.fIsEncrypted && (last_client == 40000 || last_client == 50000)) {
-        return DBErrors::NEED_REWRITE;
-    }
-
     if (!has_last_client || last_client != CLIENT_VERSION) {
         // Update
         m_batch->Write(DBKeys::VERSION, CLIENT_VERSION);
