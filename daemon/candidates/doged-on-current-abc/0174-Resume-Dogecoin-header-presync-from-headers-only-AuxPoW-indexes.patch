From 59b343a4dcce4259fa8eec8562ec5f0cb2cb3da2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:27:24 -0700
Subject: [PATCH] Resume Dogecoin header presync from headers-only AuxPoW
 indexes

On a restarted node the block index can contain AuxPoW headers whose block bodies have not yet been downloaded. Reconstructing the full header from a blk file in TryLowWorkHeadersSync throws for FlatFilePos(-1,0), so a node with header-only state cannot resume ordinary minimum-work presync.

HeadersSyncState needs only the 80-byte base hash, bits and timestamp at its start point. Reconstruct that base header from the index without reading AuxPoW proof bytes, while leaving full-header RPC, relay, disk, Chronik and PoW validation unchanged. A native regression creates an AuxPoW-marked headers-only index and starts presync without block data. Isolated real-peer restart now advances from 918000 through the 935999 presync log height under default minimum chain work; earlier binary repeatedly logged the missing blk-file failure and did not advance.

diff --git a/src/blockindex.cpp b/src/blockindex.cpp
index 59d2298ae9f722332a2fb9f23a482ac6572eb43c..863432eeb276530029dcbc0f128920de470c03a6 100644
--- a/src/blockindex.cpp
+++ b/src/blockindex.cpp
@@ -34,6 +34,19 @@ std::string CBlockIndex::ToString() const {
         nHeight, hashMerkleRoot.ToString(), GetBlockHash().ToString());
 }
 
+CBaseBlockHeader CBlockIndex::GetBaseBlockHeader() const {
+    CBaseBlockHeader block;
+    block.nVersion = nVersion;
+    if (pprev) {
+        block.hashPrevBlock = pprev->GetBlockHash();
+    }
+    block.hashMerkleRoot = hashMerkleRoot;
+    block.nTime = nTime;
+    block.nBits = nBits;
+    block.nNonce = nNonce;
+    return block;
+}
+
 CBlockHeader
 CBlockIndex::GetBlockHeader(const node::BlockManager &blockman) const {
     CBlockHeader block;
@@ -44,14 +57,7 @@ CBlockIndex::GetBlockHeader(const node::BlockManager &blockman) const {
         }
         return block;
     }
-    block.nVersion = nVersion;
-    if (pprev) {
-        block.hashPrevBlock = pprev->GetBlockHash();
-    }
-    block.hashMerkleRoot = hashMerkleRoot;
-    block.nTime = nTime;
-    block.nBits = nBits;
-    block.nNonce = nNonce;
+    static_cast<CBaseBlockHeader &>(block) = GetBaseBlockHeader();
     return block;
 }
 
diff --git a/src/blockindex.h b/src/blockindex.h
