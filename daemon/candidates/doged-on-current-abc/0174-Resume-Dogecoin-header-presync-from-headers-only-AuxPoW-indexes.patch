diff --git a/src/test/headers_sync_chainwork_tests.cpp b/src/test/headers_sync_chainwork_tests.cpp
index 25179113c4360ef39a0d5746b69e29d273eabc2b..add53202791ba53d9a3cffd3926f4ba5dfd50e98 100644
--- a/src/test/headers_sync_chainwork_tests.cpp
+++ b/src/test/headers_sync_chainwork_tests.cpp
@@ -160,4 +160,44 @@ BOOST_AUTO_TEST_CASE(headers_sync_state) {
     BOOST_CHECK(result.success);
 }
 
+// After a restart, an AuxPoW header can be in the block index before its block
+// body has been downloaded. Presync needs only its base hash and target; trying
+// to reconstruct the full header would read a nonexistent blk file.
+BOOST_AUTO_TEST_CASE(auxpow_headers_only_chain_start) {
+    const CBlockIndex *genesis = WITH_LOCK(
+        ::cs_main, return m_node.chainman->m_blockman.LookupBlockIndex(
+                       Params().GenesisBlock().GetHash()));
+    BOOST_REQUIRE(genesis != nullptr);
+
+    CBlockHeader start;
+    start.nVersion =
+        MakeVersionWithChainId(AUXPOW_CHAIN_ID, 4) | VERSION_AUXPOW_BIT;
+    start.hashPrevBlock = genesis->GetBlockHash();
+    start.hashMerkleRoot = Params().GenesisBlock().hashMerkleRoot;
+    start.nTime = Params().GenesisBlock().nTime + 60;
+    start.nBits = Params().GenesisBlock().nBits;
+    const BlockHash start_hash = start.GetHash();
+
+    CBlockIndex header_only(start);
+    header_only.phashBlock = &start_hash;
+    header_only.pprev = const_cast<CBlockIndex *>(genesis);
+    header_only.nHeight = 21;
+    header_only.nChainWork = genesis->nChainWork + GetBlockProof(header_only);
+    BOOST_CHECK(!header_only.nStatus.hasData());
+
+    const CBaseBlockHeader base = header_only.GetBaseBlockHeader();
+    BOOST_CHECK(base.GetHash() == start_hash);
+    BOOST_CHECK_EQUAL(base.nBits, start.nBits);
+
+    std::vector<CBlockHeader> next;
+    GenerateHeaders(next, 1, start_hash,
+                    MakeVersionWithChainId(AUXPOW_CHAIN_ID, 4), start.nTime,
+                    start.hashMerkleRoot, start.nBits);
+    HeadersSyncState sync(0, Params().GetConsensus(), &header_only, base,
+                          header_only.nChainWork + 1000);
+    const auto result = sync.ProcessNextHeaders(next, true);
+    BOOST_CHECK(result.success);
+    BOOST_CHECK(sync.GetState() == HeadersSyncState::State::PRESYNC);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
