From d5c8fb67c1132109369b8602c097938a21280ca7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:02 -0700
Subject: [PATCH] Preserve Doged custom dust relay fee semantics

The pinned Doged source multiplies the fee rounded for a 182-byte P2PKH spend by three and defaults to 1000 sat/kB. ABC 22023df31e44270e2c077f3ba1a986fec97962b2 instead multiplies the rate by three, changing explicit dustrelayfee inputs and odd-rate rounding. Preserve the Doged consumer policy while keeping the standard 546-satoshi default threshold. Restore the existing 1234 sat/kB regression: 671 satoshis is dust and 672 is accepted.

diff --git a/src/init.cpp b/src/init.cpp
index 69d3240bc755f0b0ecc79d72833b49e7933388a2..2d6f01607212140bf30e022d5c6e4d2395942b99 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -1343,7 +1343,7 @@ void SetupServerArgs(NodeContext &node) {
     argsman.AddArg(
         "-dustrelayfee=<amt>",
         strprintf("Fee rate (in %s/kB) used to define dust, the value of an "
-                  "output such that it will cost more than its value in "
+                  "output such that it will cost about 1/3 of its value in "
                   "fees at this fee rate to spend it. (default: %s)",
                   ticker, FormatMoney(DUST_RELAY_TX_FEE)),
         ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY,
diff --git a/src/policy/policy.cpp b/src/policy/policy.cpp
index 7753ebc3d95a1c6c69c7bda9f96021f08d143615..147576b1285e932986507efe66e399743e4f364d 100644
--- a/src/policy/policy.cpp
+++ b/src/policy/policy.cpp
@@ -14,12 +14,10 @@
 Amount GetDustThreshold(const CTxOut &txout, const CFeeRate &dustRelayFeeIn) {
     /**
      * "Dust" is defined in terms of dustRelayFee, which has units
-     * satoshis-per-kilobyte. If you'd pay more in fees than the value of
-     * the output to spend something, then we consider it dust.  A typical
-     * spendable txout is 34 bytes big, and will need a CTxIn of at least
-     * 148 bytes to spend: so dust is a spendable txout less than
-     * 182*dustRelayFee/1000 (in satoshis).
-     * 546 satoshis at the default rate of 3000 sat/kB.
+     * satoshis-per-kilobyte. If you'd pay more than 1/3 in fees to spend
+     * something, then we consider it dust.  A typical spendable txout is 34
+     * bytes big, and will need a CTxIn of at least 148 bytes to spend: so dust
+     * is a spendable txout less than 546*dustRelayFee/1000 (in satoshis).
      */
     if (txout.scriptPubKey.IsUnspendable()) {
         return Amount::zero();
@@ -30,7 +28,7 @@ Amount GetDustThreshold(const CTxOut &txout, const CFeeRate &dustRelayFeeIn) {
     // the 148 mentioned above
     nSize += (32 + 4 + 1 + 107 + 4);
 
-    return dustRelayFeeIn.GetFee(nSize);
+    return 3 * dustRelayFeeIn.GetFee(nSize);
 }
 
 bool IsDust(const CTxOut &txout, const CFeeRate &dustRelayFeeIn) {
diff --git a/src/policy/policy.h b/src/policy/policy.h
index 87bda73a407aa3f792d8ea3f60dfa51c27fdca2e..19545c86023e14a929d6bb8279af44156df2844e 100644
--- a/src/policy/policy.h
+++ b/src/policy/policy.h
@@ -61,7 +61,7 @@ static constexpr bool DEFAULT_PERMIT_BAREMULTISIG{true};
  * only increase the dust limit after prior releases were already not creating
  * outputs below the new threshold.
  */
-static constexpr Amount DUST_RELAY_TX_FEE(3000 * SATOSHI);
+static constexpr Amount DUST_RELAY_TX_FEE(1000 * SATOSHI);
 
 /** Default for -minrelaytxfee, minimum relay fee for transactions */
 static constexpr Amount DEFAULT_MIN_RELAY_TX_FEE_PER_KB(COIN / 1000);
diff --git a/src/test/transaction_tests.cpp b/src/test/transaction_tests.cpp
index 82fa8b853493133f6d1f9ccf1c8a22e068bdfc1d..dfea5bd9803b3a75cf7200c483b2b2afd647b476 100644
--- a/src/test/transaction_tests.cpp
+++ b/src/test/transaction_tests.cpp
@@ -606,7 +606,7 @@ BOOST_AUTO_TEST_CASE(test_IsStandard) {
                              g_dust, reason));
 
     // Check dust with default relay fee:
-    Amount nDustThreshold = 182 * g_dust.GetFeePerK() / 1000;
+    Amount nDustThreshold = 3 * 182 * g_dust.GetFeePerK() / 1000;
     BOOST_CHECK_EQUAL(nDustThreshold, 546 * SATOSHI);
     // dust:
     t.vout[0].nValue = nDustThreshold - SATOSHI;
@@ -648,16 +648,16 @@ BOOST_AUTO_TEST_CASE(test_IsStandard) {
                              g_dust, reason));
 
     // Check dust with odd relay fee to verify rounding:
-    // nDustThreshold = 182 * 3702 / 1000
-    g_dust = CFeeRate(3702 * SATOSHI);
+    // nDustThreshold = 182 * 1234 / 1000 * 3
+    g_dust = CFeeRate(1234 * SATOSHI);
     // dust:
-    t.vout[0].nValue = (673 - 1) * SATOSHI;
+    t.vout[0].nValue = (672 - 1) * SATOSHI;
     reason.clear();
     BOOST_CHECK(!IsStandardTx(CTransaction{t}, MAX_OP_RETURN_RELAY,
                               g_bare_multi, g_dust, reason));
     BOOST_CHECK_EQUAL(reason, "dust");
     // not dust:
-    t.vout[0].nValue = 673 * SATOSHI;
+    t.vout[0].nValue = 672 * SATOSHI;
     BOOST_CHECK(IsStandardTx(CTransaction{t}, MAX_OP_RETURN_RELAY, g_bare_multi,
                              g_dust, reason));
     g_dust = CFeeRate{DUST_RELAY_TX_FEE};
