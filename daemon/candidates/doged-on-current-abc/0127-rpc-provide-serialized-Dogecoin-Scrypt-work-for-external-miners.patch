From 96529f7d3a56403533bb9fdd65b36963a55350f5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:35:33 -0700
Subject: [PATCH] rpc: provide serialized Dogecoin Scrypt work for external
 miners

Adapt the Lotus getrawunsolvedblock payout-address interface without changing its blockhex and target result fields. Construct work with the Dogecoin assembler, modern chain ID and ordinary Scrypt proof of work; submitblock remains the existing full-block submission API. AuxPoW merged-mining work is a separate capability.

Allow disconnected regtest work, retaining connection and initial-download guards on public networks. Add a CPU Scrypt functional round trip covering payout, target, duplicate and invalid submissions and accepted stale side-chain work.

Provenance: interface adapted from Lotus patch 115; new Dogecoin integration and tests authored during the current-ABC port. Functional execution pending the integrated native build.

diff --git a/test/functional/dogecoin_raw_mining.py b/test/functional/dogecoin_raw_mining.py
index 3928e785431eced05ef9b6e225bed8bf53eeb04a..1c206352a2a2def5a2e16918c4538dfeab46544b 100644
--- a/test/functional/dogecoin_raw_mining.py
+++ b/test/functional/dogecoin_raw_mining.py
@@ -58,19 +58,27 @@ class DogecoinRawMiningTest(BitcoinTestFramework):
         stale.solve()
         block.solve()
         assert_equal(node.submitblock(block.serialize().hex()), None)
-        block.rehash()
-        assert_equal(node.getbestblockhash(), block.hash)
+        assert_equal(node.getbestblockhash(), block.hash_hex)
         assert_equal(node.getblockcount(), 1)
         assert_equal(node.submitblock(block.serialize().hex()), "duplicate")
         next_block = work()
-        assert_equal(next_block.hashPrevBlock, int(block.hash, 16))
+        assert_equal(next_block.hashPrevBlock, block.hash_int)
         next_block.solve()
         assert_equal(node.submitblock(next_block.serialize().hex()), None)
         tip = node.getbestblockhash()
         assert_equal(node.submitblock(stale.serialize().hex()), None)
         assert_equal(node.getbestblockhash(), tip)
         assert_equal(node.getblockcount(), 2)
-        decoded = node.getblock(block.hash, 2)
+        # Cross regtest AuxPoW activation at height 20 with ordinary Scrypt
+        # work. Modern chain-ID blocks remain valid without merged mining.
+        while node.getblockcount() < 22:
+            candidate = work()
+            height = node.getblockcount() + 1
+            candidate.solve()
+            assert_equal(node.submitblock(candidate.serialize().hex()), None)
+            assert_equal(node.getbestblockhash(), candidate.hash_hex)
+            assert_equal(node.getblockcount(), height)
+        decoded = node.getblock(block.hash_hex, 2)
         assert_equal(decoded["height"], 1)
         assert_equal(decoded["tx"][0]["vout"][0]["scriptPubKey"]["hex"], payout.hex())
 
