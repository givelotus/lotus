From 236b9b125797f9f870ef7e632a11df36c281dca3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:50:56 -0700
Subject: [PATCH] tests: align finalized mining fee boundary with assembler
 fixture

The mempool finalized transaction fitter reads blockmintxfee independently from the explicit assembler options. Set the same 1000-satoshi threshold before constructing the fixture so finalized parent transactions are retained. Require template length before checking individual transaction ordering, preserving all ordering assertions without a crash on future regressions.

diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 10698d3a13f3a341420170c5b4f6ebf46f34f0e0..d2f79283f484a031c855da07496f938f4e5882e7 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -129,10 +129,10 @@ public:
 
 struct MinerTestingSetupNoCheckpoints : public MinerTestingSetup {
     explicit MinerTestingSetupNoCheckpoints(bool preconsensus = false)
-        : MinerTestingSetup(
-              {"-checkpoints=0", preconsensus ? "-avalanchepreconsensus=1"
-                                              : "-avalanchepreconsensus=0"},
-              ChainType::REGTEST) {
+        : MinerTestingSetup({"-checkpoints=0", "-blockmintxfee=0.00001000",
+                             preconsensus ? "-avalanchepreconsensus=1"
+                                          : "-avalanchepreconsensus=0"},
+                            ChainType::REGTEST) {
         m_preconsensus = preconsensus;
         auto &config =
             static_cast<GlobalConfig &>(const_cast<Config &>(GetConfig()));
@@ -222,6 +222,7 @@ void MinerTestingSetup::TestPackageSelection(
     if (m_preconsensus) {
         std::sort(txids.begin(), txids.end());
     }
+    BOOST_REQUIRE_EQUAL(pblocktemplate->block.vtx.size(), txids.size() + 1);
     BOOST_CHECK(pblocktemplate->block.vtx[1]->GetId() == txids[0]);
     BOOST_CHECK(pblocktemplate->block.vtx[2]->GetId() == txids[1]);
     BOOST_CHECK(pblocktemplate->block.vtx[3]->GetId() == txids[2]);
@@ -770,6 +771,7 @@ void MinerTestingSetup::TestPrioritisedMining(
     if (m_preconsensus) {
         std::sort(txids.begin(), txids.end());
     }
+    BOOST_REQUIRE_EQUAL(pblocktemplate->block.vtx.size(), txids.size() + 1);
     BOOST_CHECK(pblocktemplate->block.vtx[1]->GetId() == txids[0]);
     BOOST_CHECK(pblocktemplate->block.vtx[2]->GetId() == txids[1]);
     BOOST_CHECK(pblocktemplate->block.vtx[3]->GetId() == txids[2]);
