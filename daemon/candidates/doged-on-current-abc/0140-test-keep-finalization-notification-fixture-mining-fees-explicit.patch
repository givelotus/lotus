From 13a5188a55ed67a07bd226a31923f3c1c3d7904a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:44:33 -0700
Subject: [PATCH] test: keep finalization notification fixture mining fees
 explicit

The notification test uses synthetic 1000-satoshi mempool entries. Set the intended mining fee in its isolated fixture before constructing the mempool so Dogecoin production blockmintxfee does not prevent finalization. Keep repeated-notification and transaction identity assertions, requiring vector length before indexing.

diff --git a/src/test/validationinterface_tests.cpp b/src/test/validationinterface_tests.cpp
index 206841cab392faeda5c3382d68943ec322233159..140fe0c18aab571ab7fdf4a5d4b1aace7ed0ef72 100644
--- a/src/test/validationinterface_tests.cpp
+++ b/src/test/validationinterface_tests.cpp
@@ -439,7 +439,13 @@ BOOST_FIXTURE_TEST_CASE(transaction_added_to_mempool, TestChain100Setup) {
     }
 }
 
-BOOST_FIXTURE_TEST_CASE(transaction_finalized, TestChain100Setup) {
+struct FinalizationInterfaceTestingSetup : TestChain100Setup {
+    FinalizationInterfaceTestingSetup()
+        : TestChain100Setup(ChainType::REGTEST,
+                            {"-blockmintxfee=0.00001000"}) {}
+};
+
+BOOST_FIXTURE_TEST_CASE(transaction_finalized, FinalizationInterfaceTestingSetup) {
     uint32_t callCount = 0;
     std::vector<TxId> calledTxIds;
     auto shared{std::make_shared<TestInterface>(
@@ -509,7 +515,7 @@ BOOST_FIXTURE_TEST_CASE(transaction_finalized, TestChain100Setup) {
                 *m_node.chainman->ActiveChain().Tip(),
                 m_node.chainman->ActiveChainstate(), finalizedTxIds));
         }
-        BOOST_CHECK_EQUAL(finalizedTxIds.size(), 1);
+        BOOST_REQUIRE_EQUAL(finalizedTxIds.size(), 1);
         BOOST_CHECK_EQUAL(finalizedTxIds[0], tx->GetId());
 
         m_node.validation_signals->SyncWithValidationInterfaceQueue();
