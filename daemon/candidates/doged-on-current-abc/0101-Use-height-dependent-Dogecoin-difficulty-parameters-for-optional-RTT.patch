From 00e6c5f44924a490dde40f36e67457a4393d297f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:32:23 -0700
Subject: [PATCH] Use height-dependent Dogecoin difficulty parameters for
 optional RTT

Preserve final Doged per-height testnet minimum-difficulty behavior in current RPC mining and validation policy paths; mining target and consensus DAA remain separate from optional RTT.

diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 1277a991a0d975cd58943f63b433dc8f5240c0a0..c23cfbb3fc9e0914e6b0db9e8dc6cd9b0d68ea62 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -1234,7 +1234,7 @@ static RPCHelpMan getblocktemplate() {
             if (isRTTEnabled(consensusParams, pindexPrev)) {
                 // Compute the target for RTT
                 uint32_t nextTarget = pblock->nBits;
-                if (!consensusParams.fPowAllowMinDifficultyBlocks ||
+                if (!consensusParams.DaaParamsAtHeight(pindexPrev->nHeight + 1).fPowAllowMinDifficultyBlocks ||
                     (pblock->GetBlockTime() <=
                      pindexPrev->GetBlockTime() +
                          2 * consensusParams.nPowTargetSpacing)) {
diff --git a/src/validation.cpp b/src/validation.cpp
index 04483ded69bf5d6b27cf399518e5627dfcf0906a..c009e72aebe1f245b2599b20643d55f729389342 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -3075,7 +3075,7 @@ bool Chainstate::ConnectTip(BlockValidationState &state,
                 if (avalanche->hasFinalizedTip()) {
                     // Special case for testnet, don't reject blocks mined with
                     // the min difficulty
-                    if (!consensusParams.fPowAllowMinDifficultyBlocks ||
+                    if (!consensusParams.DaaParamsAtHeight(pindexNew->nHeight).fPowAllowMinDifficultyBlocks ||
                         (blockConnecting.GetBlockTime() <=
                          pindexNew->pprev->GetBlockTime() +
                              2 * consensusParams.nPowTargetSpacing)) {
