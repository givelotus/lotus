From 94e176f431270d076784ea489da2d3803eddd388 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 14:22:19 -0700
Subject: [PATCH 4/4] Expand V2 GPU parity across header fields and nonce
 batches

---
 miner/V2-MINING.md                  |  7 +++
 miner/lotus-miner-lib/src/v2_gpu.rs | 73 +++++++++++++++++++++++++++++
 2 files changed, 80 insertions(+)

diff --git a/miner/V2-MINING.md b/miner/V2-MINING.md
index ab0c3775..df81d081 100644
--- a/miner/V2-MINING.md
+++ b/miner/V2-MINING.md
@@ -59,8 +59,15 @@ execution evidence, not network mining or a measured hash rate. No V2 job API
 or accepted V2 block exists in this miner slice. No live network mining was
 performed.
 
+The V2-branch integration review adds a deterministic GPU corpus that changes
+ChainID, parent ID, bits, time, version, size, height, transaction root and state
+root independently. Batches of 1, 2, 7 and 16 nonces span u32 carry and the u64
+end. Every GPU digest matches the CPU implementation, and exact/lower targets
+are checked for each field variant on Apple M5 Max.
+
 ```sh
 cargo test --locked -p lotus-miner-lib gpu_cpu_parity_and_target_boundaries -- --ignored --nocapture
+cargo test --locked -p lotus-miner-lib gpu_diverse_header_and_batch_corpus -- --ignored --nocapture
 cargo test --locked --workspace
 cargo clippy --locked --workspace --all-targets -- -D warnings
 ```
diff --git a/miner/lotus-miner-lib/src/v2_gpu.rs b/miner/lotus-miner-lib/src/v2_gpu.rs
index ba148801..8ed9c99b 100644
--- a/miner/lotus-miner-lib/src/v2_gpu.rs
+++ b/miner/lotus-miner-lib/src/v2_gpu.rs
@@ -225,5 +225,78 @@ mod tests {
             hex::encode(vector[1].block_id),
             "8a967f4522d06f683830cf003b9f456001e045f617bf4d4336754a91c75f5824"
         );
+        let last = gpu
+            .hash_nonces(&vector_header, &chain_id, &[0xff; 32], u64::MAX, 1)
+            .unwrap();
+        assert_eq!(
+            hex::encode(last[0].block_id),
+            "ce606e015b769cf60502917d0bac3597048e25668c7df323f817b53969aab371"
+        );
+    }
+
+    #[test]
+    #[ignore = "requires an installed OpenCL runtime and device"]
+    fn gpu_diverse_header_and_batch_corpus() {
+        let gpu = V2GpuHasher::setup(0).unwrap();
+        let base_header: [u8; HEADER_LEN] = std::array::from_fn(|i| (i as u8).wrapping_mul(17));
+        let base_chain: [u8; 32] = std::array::from_fn(|i| (i as u8).wrapping_mul(13));
+        let mut cases = Vec::new();
+        cases.push((base_header, base_chain));
+        let mut chain = base_chain;
+        chain[31] ^= 0x80;
+        cases.push((base_header, chain));
+        for &offset in &[0, 32, 36, 50, 54, 62, 70, 102] {
+            let mut header = base_header;
+            header[offset] ^= 0x80;
+            cases.push((header, base_chain));
+        }
+
+        let mut baseline = None;
+        for (case_index, (header, chain_id)) in cases.into_iter().enumerate() {
+            let count = [1, 2, 7, 16][case_index % 4];
+            let start = if case_index % 2 == 0 {
+                0xffff_ffffu64 - 3
+            } else {
+                u64::MAX - (count as u64 - 1)
+            };
+            let results = gpu
+                .hash_nonces(&header, &chain_id, &[0xff; 32], start, count)
+                .unwrap();
+            for item in &results {
+                let mut cpu_header = header;
+                cpu_header[NONCE_OFFSET..NONCE_OFFSET + 8]
+                    .copy_from_slice(&item.nonce.to_le_bytes());
+                assert_eq!(item.block_id, hashes(&cpu_header, &chain_id).unwrap().2);
+                assert!(item.meets_target);
+            }
+            let fixed_nonce_id = gpu
+                .hash_nonces(&header, &chain_id, &[0xff; 32], 0, 1)
+                .unwrap()[0]
+                .block_id;
+            if case_index == 0 {
+                baseline = Some(fixed_nonce_id);
+            } else {
+                // Each case changes one independent header field or ChainID.
+                assert_ne!(fixed_nonce_id, baseline.unwrap());
+            }
+            let selected = results[0].block_id;
+            let equal = gpu
+                .hash_nonces(&header, &chain_id, &selected, start, 1)
+                .unwrap();
+            assert!(equal[0].meets_target);
+            let mut lower = selected;
+            for byte in &mut lower {
+                if *byte != 0 {
+                    *byte -= 1;
+                    break;
+                }
+                *byte = 0xff;
+            }
+            assert!(
+                !gpu.hash_nonces(&header, &chain_id, &lower, start, 1)
+                    .unwrap()[0]
+                    .meets_target
+            );
+        }
     }
 }
