diff --git a/contrib/docker/bitcoin-abc/Dockerfile b/contrib/docker/bitcoin-abc/Dockerfile
index 09ac545fc0a6ac658c18176ab0cbb13a0ca9ec41..00f9fcdb3f586ccb57be6c10d6cd06cee1f1a698 100644
--- a/contrib/docker/bitcoin-abc/Dockerfile
+++ b/contrib/docker/bitcoin-abc/Dockerfile
@@ -21,7 +21,7 @@ RUN chown -h bitcoin:bitcoin /home/bitcoin/.bitcoin
 # are set, otherwise the changes won't be persistent
 VOLUME "${BITCOIN_DATA}"
 
-EXPOSE 8332 8333 18332 18333
+EXPOSE 22555 22556 44555 44556
 
 USER bitcoin
 CMD ["bitcoind"]
