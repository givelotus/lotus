diff --git a/doc/man/CMakeLists.txt b/doc/man/CMakeLists.txt
index 4a7c0341d..f02b22828 100644
--- a/doc/man/CMakeLists.txt
+++ b/doc/man/CMakeLists.txt
@@ -1,4 +1,10 @@
 function(generate_manpages)
+	# Guard: in CMake 4.x variable_watch hooks fire in a scope where targets
+	# are not visible. Skip man page generation if bitcoind isn't a target.
+	if(NOT TARGET bitcoind)
+		return()
+	endif()
+
 	get_property(TARGETS
 		GLOBAL
 		PROPERTY TARGETS_TO_GENERATE_MAN_PAGES
