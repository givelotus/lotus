-        2147483648,
-        // 2^31 * 2^(1/4) = 2553802833.55
-        2553802834,
-        // 2^31 * 2^(2/4) = 3037000499.98
-        3037000500,
-        // 2^31 * 2^(3/4) = 3611622602.84
-        3611622603,
