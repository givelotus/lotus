+
+    // Test conditional cases
+    CheckCodesepPos(CScript() << 0 << OP_IF << OP_NOP << OP_CODESEPARATOR
+                              << OP_NOP << OP_ENDIF,
+                    0xffff'ffff);
+    CheckCodesepPos(CScript() << 1 << OP_IF << OP_NOP << OP_CODESEPARATOR
+                              << OP_NOP << OP_ENDIF,
+                    3);
+    CheckCodesepPos(CScript() << 0 << OP_NOTIF << OP_NOP << OP_CODESEPARATOR
