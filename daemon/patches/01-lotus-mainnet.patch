+class NngRpcWorker {
+    NngRpcWorkerState m_state;
+    nng_aio *m_aio;
+    nng_ctx m_ctx;
+    NngRpcServer *m_server;
+
+    void HandleCallback();
+
+public:
+    NngRpcWorker();
+
+    void Init(nng_socket sock, NngRpcServer *server);
+    void Shutdown();
+    static void Callback(void *arg);
+};
