From 0c40209fe91286db0448ca33886b682bfe96e9f6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Fri, 16 Oct 2026 16:54:51 -0700
Subject: [PATCH] 030-enable-causal-epoch-pipeline-and-preconsensus-policy:
 enforce finalized mempool batch compliance in PreConsensusPolicy

---
 src/policy/block/preconsensus.cpp             | 56 ++++++++++++++++++-
 src/policy/block/preconsensus.h               | 12 +++-
 .../abc_p2p_avalanche_transaction_voting.py   | 56 +++++++++++++------
 3 files changed, 105 insertions(+), 19 deletions(-)

diff --git a/src/policy/block/preconsensus.cpp b/src/policy/block/preconsensus.cpp
index fb9318a282b65e0827fd29f79f7b579312f06a29..89365b0ba6bf8068dcdd64e2980e45eb71c5324d 100644
--- a/src/policy/block/preconsensus.cpp
+++ b/src/policy/block/preconsensus.cpp
@@ -4,18 +4,70 @@
 
 #include <policy/block/preconsensus.h>
 
+#include <avalanche/preconsensus.h>
 #include <avalanche/processor.h>
 #include <blockindex.h>
+#include <consensus/merkle.h>
 #include <kernel/disconnected_transactions.h>
 #include <util/hasher.h>
 
 #include <unordered_map>
 
 bool PreConsensusPolicy::operator()(BlockPolicyValidationState &state) {
-    if (!m_mempool || !m_blockIndex.pprev) {
+    if (!m_blockIndex.pprev) {
         return true;
     }
-    if (!m_avalanche.isPreconsensusActivated(m_blockIndex.pprev)) {
+    if (!m_avalanche.isQuorumEstablished() ||
+        !m_avalanche.isPreconsensusActivated(m_blockIndex.pprev)) {
+        return true;
+    }
+
+    // Verify block compliance against any finalized pre-consensus mempool
+    // batches for m_blockIndex.pprev->GetBlockHash().
+    const auto finalizedBatches = m_avalanche.getFinalizedMempoolBatches(
+        m_blockIndex.pprev->GetBlockHash());
+    if (!finalizedBatches.empty()) {
+        if (m_block.vtx.empty() || !m_block.vtx[0]) {
+            return state.Invalid(BlockPolicyValidationResult::POLICY_VIOLATION,
+                                 "finalized-batch-missing-coinbase",
+                                 "Block is missing coinbase transaction");
+        }
+        const auto &latestBatch = finalizedBatches.back();
+        const size_t nonCoinbaseCount = m_block.vtx.size() - 1;
+        if (nonCoinbaseCount < latestBatch.tx_count) {
+            return state.Invalid(
+                BlockPolicyValidationResult::POLICY_VIOLATION,
+                "finalized-batch-missing-tx",
+                strprintf("Block %s contains %u non-coinbase txs, fewer than "
+                          "finalized batch tx_count %u",
+                          m_block.GetHash().ToString(),
+                          static_cast<unsigned>(nonCoinbaseCount),
+                          latestBatch.tx_count));
+        }
+
+        const uint256 blockMerkleRoot = m_block.hashMerkleRoot.IsNull()
+                                            ? BlockMerkleRoot(m_block)
+                                            : m_block.hashMerkleRoot;
+        bool matchedFinalizedBatch = false;
+        for (const auto &batch : finalizedBatches) {
+            const uint256 expectedRoot = avalanche::ComputeV2TxRootFromSubtreeA(
+                *m_block.vtx[0], batch.subtree_a_root);
+            if (expectedRoot == blockMerkleRoot) {
+                matchedFinalizedBatch = true;
+                break;
+            }
+        }
+        if (!matchedFinalizedBatch) {
+            return state.Invalid(
+                BlockPolicyValidationResult::POLICY_VIOLATION,
+                "finalized-batch-root-mismatch",
+                strprintf("Block %s merkle root does not match finalized "
+                          "mempool batch subtree_a_root",
+                          m_block.GetHash().ToString()));
+        }
+    }
+
+    if (!m_mempool) {
         return true;
     }
 
