From 3567b93158e7e52c089a0066899cba67f3dbbc82 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:51:13 -0700
Subject: [PATCH] Classify mismatched output lookup records as storage
 corruption

The persistent lookup adapter must not turn a mis-keyed database record into an occupied-output consensus rejection. Preserve the operational result for both spend and output probes; native ordinary validation tests pass.
---
 src/lotus_v2/ordinary_validation.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/lotus_v2/ordinary_validation.cpp b/src/lotus_v2/ordinary_validation.cpp
index d5ac820295d5a8a8d94652ab897a5f571638c981..e36c8e14819567517ef808b4f7d4f25d62fb4597 100644
--- a/src/lotus_v2/ordinary_validation.cpp
+++ b/src/lotus_v2/ordinary_validation.cpp
@@ -236,6 +236,10 @@ CandidateCheckResult CheckOrdinaryWithLookup(const Transaction &tx,
         if (read == CoinReadResult::Error)
             return CandidateCheckResult::StorageError;
         if (read == CoinReadResult::Found) {
+            if (occupied.outpoint != outpoint) {
+                error = "coin lookup returned a different outpoint";
+                return CandidateCheckResult::StorageError;
+            }
             error = "created outpoint already occupied";
             return CandidateCheckResult::Invalid;
         }
