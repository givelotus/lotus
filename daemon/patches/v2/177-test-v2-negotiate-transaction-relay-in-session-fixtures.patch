From 5aa296b7c744600e07fae9f3a8ba03e50d3ff129 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:10:19 -0700
Subject: [PATCH] test(v2): negotiate transaction relay in session fixtures

Maintenance explanation added during mailbox export:
Update peer session fixtures to negotiate transaction relay explicitly and cover the resulting application message rules. This keeps session tests aligned with the new feature gate rather than allowing transaction messages implicitly.

---
 src/lotus_v2/test_peer_session.cpp | 78 +++++++++++++++++++++++++++---
 1 file changed, 71 insertions(+), 7 deletions(-)

diff --git a/src/lotus_v2/test_peer_session.cpp b/src/lotus_v2/test_peer_session.cpp
index e3ded964bebbd831db459b6602ad9a86adb0116a..81280b51f4f7e62e5451cb3f77be41e8cd5d3a5f 100644
--- a/src/lotus_v2/test_peer_session.cpp
+++ b/src/lotus_v2/test_peer_session.cpp
@@ -59,12 +59,16 @@ Bytes VersionBytes() {
     CHECK(EncodeVersion(Modern(), b, e));
     return b;
 }
-Bytes HelloBytes(const NetworkProfile &p) {
+Bytes HelloBytes(const NetworkProfile &p,
+                 uint64_t supported = MANDATORY_FEATURES,
+                 uint64_t required = MANDATORY_FEATURES) {
     Hello h;
     h.chain_id = p.chain_id;
     h.genesis_id = p.genesis_id;
     h.profile_digest = p.profile_digest;
     h.receive_limit = p.receive_limit;
+    h.supported = supported;
+    h.required = required;
     Bytes b;
     std::string e;
     CHECK(EncodeHello(h, b, e));
@@ -97,11 +101,12 @@ SessionEvent Send(Session &s, const Message &m, uint64_t time = 101) {
     CHECK(n <= b.size());
     return event;
 }
-void Activate(Session &s, uint32_t peer_limit = PRE_HELLO_LIMIT) {
+void Activate(Session &s, uint32_t peer_limit = PRE_HELLO_LIMIT,
+              uint64_t supported = MANDATORY_FEATURES) {
     CHECK(s.OnOpen(100).result == SessionResult::Send);
     auto v = Send(s, {"version", VersionBytes()});
     CHECK(v.result == SessionResult::Send);
-    auto h = Send(s, {"v2hello", HelloBytes(Profile(peer_limit))});
+    auto h = Send(s, {"v2hello", HelloBytes(Profile(peer_limit), supported)});
     CHECK(h.result == SessionResult::Send);
     CHECK(Send(s, {"verack", {}}).result == SessionResult::Activated);
     CHECK(s.State() == SessionState::Active);
@@ -217,6 +222,7 @@ void VersionVectors() {
 }
 void HandshakeAndDispatch() {
     auto c = Config();
+    c.supported_features |= TRANSACTION_RELAY_FEATURE;
     c.send_address_v2 = true;
     Session s(c);
     auto open = s.OnOpen(100);
@@ -238,12 +244,13 @@ void HandshakeAndDispatch() {
     CHECK(s.PeerVersion()->Nonce() == Modern().Nonce());
     CHECK(Send(s, {"sendaddrv2", {}}).result == SessionResult::Ignored &&
           s.PeerWantsAddressV2());
-    event = Send(s, {"v2hello", HelloBytes(c.network)});
+    event = Send(s, {"v2hello", HelloBytes(c.network, c.supported_features)});
     CHECK(event.result == SessionResult::Send && event.outbound.size() == 1 &&
           Unframe(event.outbound[0]).command == "verack");
     CHECK(s.State() == SessionState::Handshaking && s.ActiveLimit() == 0);
     CHECK(Send(s, {"verack", {}}).result == SessionResult::Activated &&
           s.State() == SessionState::Active);
+    CHECK(s.ActiveFeatures() == c.supported_features);
     CHECK(Send(s, {"verack", {}}).result == SessionResult::Ignored);
     CHECK(Send(s, {"version", {}}).result == SessionResult::Ignored);
     for (const auto *command :
@@ -263,6 +270,60 @@ void HandshakeAndDispatch() {
           s.State() == SessionState::Closed);
     CHECK(s.OnClosed().result == SessionResult::Closed);
 }
+void TransactionRelayNegotiation() {
+    for (bool local_relay : {false, true}) {
+        for (bool peer_relay : {false, true}) {
+            auto c = Config();
+            if (local_relay) c.supported_features |= TRANSACTION_RELAY_FEATURE;
+            Session s(c);
+            const uint64_t peer_features =
+                MANDATORY_FEATURES |
+                (peer_relay ? TRANSACTION_RELAY_FEATURE : 0);
+            Activate(s, PRE_HELLO_LIMIT, peer_features);
+            CHECK(s.ActiveFeatures() == (c.supported_features & peer_features));
+            // Block envelopes remain available without transaction relay.
+            CHECK(Send(s, {"block", {1}}).result == SessionResult::Application);
+            auto tx = Send(s, {"tx", {1}});
+            if (local_relay && peer_relay) {
+                CHECK(tx.result == SessionResult::Application &&
+                      tx.application->command == "tx");
+            } else {
+                CHECK(tx.result == SessionResult::PeerRejected &&
+                      !tx.application && s.State() == SessionState::Closed);
+            }
+        }
+    }
+    const uint64_t relay_features =
+        MANDATORY_FEATURES | TRANSACTION_RELAY_FEATURE;
+    for (bool local_requires : {false, true}) {
+        auto c = Config();
+        if (local_requires) {
+            c.supported_features = relay_features;
+            c.required_features = relay_features;
+        }
+        Session s(c);
+        CHECK(s.OnOpen(100).result == SessionResult::Send);
+        CHECK(Send(s, {"version", VersionBytes()}).result ==
+              SessionResult::Send);
+        const uint64_t peer_features =
+            local_requires ? MANDATORY_FEATURES : relay_features;
+        CHECK(Send(s, {"v2hello",
+                       HelloBytes(c.network, peer_features, peer_features)})
+                  .result == SessionResult::PeerRejected);
+        CHECK(s.State() == SessionState::Closed && s.ActiveFeatures() == 0);
+    }
+    auto c = Config();
+    c.supported_features = c.required_features = relay_features;
+    Session required(c);
+    CHECK(required.OnOpen(100).result == SessionResult::Send);
+    CHECK(Send(required, {"version", VersionBytes()}).result ==
+          SessionResult::Send);
+    CHECK(Send(required, {"v2hello", HelloBytes(c.network, relay_features,
+                                                relay_features)})
+              .result == SessionResult::Send);
+    CHECK(Send(required, {"verack", {}}).result == SessionResult::Activated);
+    CHECK(required.ActiveFeatures() == relay_features);
+}
 void RejectOrderingAndIdentity() {
     for (const auto *first :
          {"v2hello", "verack", "sendaddrv2", "tx", "unknown"}) {
@@ -498,12 +559,14 @@ void SplitAndCoalescedLimits() {
     }
     for (uint32_t limit : {1U, 117U, 118U}) {
         auto c = Config(limit);
+        c.supported_features |= TRANSACTION_RELAY_FEATURE;
         Session s(c);
         CHECK(s.OnOpen(100).result == SessionResult::Send);
         CHECK(Send(s, {"version", VersionBytes()}).result ==
               SessionResult::Send);
-        CHECK(Send(s, {"v2hello", HelloBytes(Profile(limit))}).result ==
-              SessionResult::Send);
+        CHECK(Send(s, {"v2hello",
+                       HelloBytes(Profile(limit), c.supported_features)})
+                  .result == SessionResult::Send);
         auto verack = Frame({"verack", {}});
         auto app = Frame({"tx", Bytes(limit + 1, 0)});
         Bytes coalesced = verack;
@@ -514,7 +577,7 @@ void SplitAndCoalescedLimits() {
         auto result = s.Feed(std::span(coalesced).subspan(used), 101, used);
         CHECK(result.result == SessionResult::PeerRejected && used == 24);
         Session exact(c);
-        Activate(exact, limit);
+        Activate(exact, limit, c.supported_features);
         auto event = Send(exact, {"tx", Bytes(limit, 0)});
         CHECK(event.result == SessionResult::Application &&
               event.application->payload.size() == limit);
@@ -533,6 +596,7 @@ void SplitAndCoalescedLimits() {
 int main() {
     VersionVectors();
     HandshakeAndDispatch();
+    TransactionRelayNegotiation();
     RejectOrderingAndIdentity();
     NonceTimeAndLocalErrors();
     SplitAndCoalescedLimits();
-- 
