+            for (auto &item : selected) {
+                tmpl.non_cb_serialized_size += item.tx->GetTotalSize();
+                if (can_reuse_prev_hex) {
+                    const auto &prev_txs =
+                        prev->mining_template.non_coinbase_txs;
