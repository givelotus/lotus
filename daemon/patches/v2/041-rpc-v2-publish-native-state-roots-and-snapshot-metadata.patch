+
+    // Add 1 valid transaction to the mempool and refresh snapshot.
+    CMutableTransaction mempool_mtx = CreateNativeMempoolTransaction(
+        m_coinbase_txns[0], 0,
+        m_coinbase_txns[0]->vout[0].nValue - 1000 * SATOSHI);
