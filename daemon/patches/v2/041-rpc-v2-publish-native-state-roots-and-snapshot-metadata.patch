+    tmpl.max_generated_block_size = blockFitter.getMaxGeneratedBlockSize();
+
+    if (!id_idx.empty()) {
+        struct SelectedEntry {
+            CTransactionRef tx;
+            Amount fee;
+            int64_t sigchecks;
+        };
+
