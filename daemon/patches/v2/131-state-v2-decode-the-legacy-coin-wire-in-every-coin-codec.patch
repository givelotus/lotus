diff --git a/src/lotus_v2/disk_state.cpp b/src/lotus_v2/disk_state.cpp
index 66d87d89d0fe2e8b00e94266e27711200810e3ab..eebc7c71b3c6eb661210725cdb4c397f3802e3cf 100644
