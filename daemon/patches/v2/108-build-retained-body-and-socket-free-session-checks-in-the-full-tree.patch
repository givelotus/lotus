From 7432a0aa1b830bfd6de4cf3769a7a92cdd8e6f89 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 10:18:59 -0700
Subject: [PATCH] Build retained body and socket-free session checks in the
 full tree

Link retained body authentication into the existing validation library and expose a separate peer session library and check target. This does not open sockets, adopt network parameters or advertise history services.
---
 src/lotus_v2/CMakeLists.txt | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 9f262821711c55282d89b3169841fcf8a30585ff..c22785a4d2f61a072f1e37b4ea4ac8ed45f5160b 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -134,7 +134,7 @@ find_package(OpenSSL REQUIRED COMPONENTS Crypto)
 add_library(lotus_v2_validation STATIC
     transaction.cpp signing.cpp vm.cpp field_size.cpp ordinary_validation.cpp
     monetary.cpp block_wire.cpp block_cost.cpp header_context.cpp
-    asert_candidate.cpp block_transition.cpp disk_state.cpp disk_block.cpp development_chain.cpp)
+    asert_candidate.cpp block_transition.cpp disk_state.cpp disk_block.cpp development_chain.cpp disk_body.cpp)
 target_link_libraries(lotus_v2_validation PUBLIC
     lotus_v2_sparse_state lotus_v2_incremental_utxo Boost::headers secp256k1 leveldb OpenSSL::Crypto)
 
@@ -170,3 +170,12 @@ target_link_libraries(test_lotus_v2_development_chain PRIVATE lotus_v2_validatio
 add_custom_target(check-lotus-v2-development-chain
     COMMAND $<TARGET_FILE:test_lotus_v2_development_chain>
     DEPENDS test_lotus_v2_development_chain)
+
+# Socket-free version/hello session; profile and clocks remain caller supplied.
+add_library(lotus_v2_peer_session STATIC peer_session.cpp)
+target_link_libraries(lotus_v2_peer_session PUBLIC lotus_v2_peer_codec)
+add_executable(test_lotus_v2_peer_session test_peer_session.cpp)
+target_link_libraries(test_lotus_v2_peer_session PRIVATE lotus_v2_peer_session)
+add_custom_target(check-lotus-v2-peer-session
+    COMMAND $<TARGET_FILE:test_lotus_v2_peer_session>
+    DEPENDS test_lotus_v2_peer_session)
-- 
