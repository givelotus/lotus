+    const std::optional<LockPoints> lock_points{
+        CalculateLockPointsFromResolvedCoins(tip, tx, ws.m_resolved_inputs)};
+    if (!lock_points.has_value() ||
+        !CheckSequenceLocksAtTip(tip, *lock_points)) {
