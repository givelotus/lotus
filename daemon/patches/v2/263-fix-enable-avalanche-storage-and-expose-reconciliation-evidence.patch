From 8029a2e5faa1b07e361039d7bcad24fca03088ea Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:57:57 -0700
Subject: [PATCH] fix: enable Avalanche storage and expose reconciliation
 evidence

---
 src/lotus_v2/development_node_command.cpp     | 24 ++++++++++++++-----
 .../node_avalanche_test/check_node.py         |  2 ++
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index 6012ec5acf8e329a23bf067360a3222ef54bb636..2e5ebf7525083d72248a0165e7e4583c320f44ec 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -408,12 +408,13 @@ namespace {
         return l;
     }
     DevelopmentRuntimeConfig RuntimeConfig(const DevelopmentManifest &m,
-                                           const std::string &directory) {
+                                           const std::string &directory, bool avalanche_enabled) {
         DevelopmentRuntimeConfig c{};
         c.directory = directory;
         c.genesis_wire = m.genesis;
         c.profiles = {m.hp, m.op, m.mp, m.cp};
         c.initial_money = m.initial;
+        c.storage.avalanche = avalanche_enabled;
         c.storage.recovery = DiskRecoveryOptions{128 * MiB, 16 * MiB};
         c.storage.candidates = CandidateStoreOptions{4096, 4096, 128};
         c.storage.max_metadata_bytes = 16 * MiB;
@@ -636,7 +637,9 @@ namespace {
         std::unique_ptr<ava::AvalancheDriver> avalanche;
         std::set<ConnectionId> avalanche_peers, avalanche_activations, pending_headers;
         std::optional<DispatcherNotice> pending_avalanche_notice;
-        std::string avalanche_error;
+        std::string avalanche_error, avalanche_reconcile_error;
+        uint64_t avalanche_reconciled{};
+        std::optional<Hash> avalanche_last_reconciled;
         uint64_t avalanche_save_due{};
         bool InitialDownload(uint64_t);
         void TickAvalanche(uint64_t, uint64_t);
@@ -1032,6 +1035,9 @@ namespace {
             status.pushKV("active_stake_score", a.active_stake_score);
             status.pushKV("connected_stake_score", a.connected_stake_score);
             status.pushKV("error", avalanche_error.substr(0, 1024));
+            status.pushKV("reconcile_error", avalanche_reconcile_error.substr(0, 1024));
+            status.pushKV("reconcile_successes", avalanche_reconciled);
+            if (avalanche_last_reconciled) status.pushKV("last_reconciled_block", Hex(*avalanche_last_reconciled));
             RuntimeBlockObservation observation;
             std::string error;
             const bool observed = snap.chain && runtime->ObserveAvalancheBlock(snap.chain->stable_tip, observation, error);
@@ -1888,9 +1894,15 @@ namespace {
             std::string error;
             if (runtime->ObserveAvalancheBlock(snapshot.chain->stable_tip, observation, error) &&
                 observation.known && observation.valid && observation.has_data && !observation.finalized) {
-                if (!avalanche->Reconcile({ava::ItemKind::Block, snapshot.chain->stable_tip}, observation.active, error) &&
-                    error != "already-finalized-item" && error != "vote-record-capacity")
-                    throw std::runtime_error("Avalanche reconciliation: " + error);
+                if (avalanche->Reconcile({ava::ItemKind::Block, snapshot.chain->stable_tip}, !observation.parked, error)) {
+                    Count(avalanche_reconciled);
+                    avalanche_last_reconciled = snapshot.chain->stable_tip;
+                    avalanche_reconcile_error.clear();
+                } else {
+                    avalanche_reconcile_error = error;
+                    if (error != "already-finalized-item" && error != "vote-record-capacity")
+                        throw std::runtime_error("Avalanche reconciliation: " + error);
+                }
             }
         }
         const auto result = avalanche->Tick(InitialDownload(wall), int64_t(ms), int64_t(wall));
@@ -2250,7 +2262,7 @@ int RunDevelopmentNodeCommand(int argc, char *argv[]) {
                                                 error),
                 error);
         std::unique_ptr<DevelopmentRuntime> runtime;
-        Require(DevelopmentRuntime::Open(RuntimeConfig(manifest, directory),
+        Require(DevelopmentRuntime::Open(RuntimeConfig(manifest, directory, bool(network.avalanche)),
                                          runtime, error),
                 error);
         struct ECCLifetime {
diff --git a/src/lotus_v2/node_avalanche_test/check_node.py b/src/lotus_v2/node_avalanche_test/check_node.py
index bffd28c6f788a0554f78f32bf89c94f768e4249a..2d2c0a0b0718e108500763dd3c50b65f0fce9da0 100644
--- a/src/lotus_v2/node_avalanche_test/check_node.py
+++ b/src/lotus_v2/node_avalanche_test/check_node.py
@@ -107,6 +107,8 @@ def main():
             assert second["avalanche"]["initial_download"], second
             for status in (first, second):
                 a = status["avalanche"]
+                assert a["tip_observation_available"], status
+                assert a["reconcile_successes"] > 0 and a["last_reconciled_block"] == status["tip"], status
                 assert a["proof_count"] == a["authenticated_peer_count"] == a["eligible_peer_count"] == 0
                 assert not a["quorum_ready"] and not a["quorum_established"] and not a["tip_finalized"]
             peer.close()
-- 
