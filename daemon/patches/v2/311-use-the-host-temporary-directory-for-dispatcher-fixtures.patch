From 2b1dfbefb3eb98fdeeedf7cb2ba496da22f9ed95 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 18:49:53 -0700
Subject: [PATCH] Use the host temporary directory for dispatcher fixtures

Create unique mkdtemp homes beneath std::filesystem::temp_directory_path instead of the Darwin-specific /private/tmp. The existing RAII cleanup and failed-home retention behavior remain intact. The focused dispatcher suite passes using the host-selected temporary root.
---
 src/lotus_v2/test_peer_dispatcher.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/lotus_v2/test_peer_dispatcher.cpp b/src/lotus_v2/test_peer_dispatcher.cpp
index 6c6a4947b828df20b5e2db634cfc8589ecc55243..10bded9395a5eaf45610b11504aa41dfc254bc31 100644
--- a/src/lotus_v2/test_peer_dispatcher.cpp
+++ b/src/lotus_v2/test_peer_dispatcher.cpp
@@ -20,9 +20,12 @@ struct Home {
     std::string path;
     leveldb::Env *env;
     explicit Home(leveldb::Env *environment = nullptr) : env(environment) {
-        char name[] = "/private/tmp/lotus-v2-peer-dispatcher-XXXXXX";
-        Check(mkdtemp(name) != nullptr, "fresh temporary V4 home");
-        path = name;
+        const auto pattern = (std::filesystem::temp_directory_path() /
+                              "lotus-v2-peer-dispatcher-XXXXXX").string();
+        std::vector<char> name(pattern.begin(), pattern.end());
+        name.push_back('\0');
+        Check(mkdtemp(name.data()) != nullptr, "fresh temporary V4 home");
+        path = name.data();
     }
     ~Home() {
         if (std::uncaught_exceptions())
