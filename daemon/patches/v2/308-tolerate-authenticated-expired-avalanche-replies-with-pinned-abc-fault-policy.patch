             auto s = Stream(b); SignedResponse response; s >> response.response >> response.signature;
-            if (!AuthenticateResponse(state.authenticated->session_key, response, e) || !callbacks_.receive(state.node, response, e)) return PeerResult::Rejected;
-            return PeerResult::Accepted;
+            if (!AuthenticateResponse(state.authenticated->session_key, response, e)) return PeerResult::Rejected;
+            switch(callbacks_.receive(state.node,response,e)) {
+                case PollReceiveResult::Applied:
+                    if(now>state.last_response_fault && now-state.last_response_fault>3600000)
+                        state.response_fault_count=0;
+                    return PeerResult::Accepted;
+                case PollReceiveResult::Ignored:
+                    // Match pinned ABC's bounded tolerance for poor networking.
+                    // Score persists across the one-hour quiet count reset.
+                    state.response_fault_count=std::min(uint32_t{63},state.response_fault_count+1);
+                    state.last_response_fault=now;
+                    if(state.response_fault_count>12)
+                        state.response_fault_score=std::min(uint32_t{102},state.response_fault_score+2);
+                    if(state.response_fault_score>100) {e="unexpected-ava-response-abuse";return PeerResult::Rejected;}
+                    return PeerResult::Ignored;
+                case PollReceiveResult::Rejected:return PeerResult::Rejected;
+                case PollReceiveResult::LocalFailure:return PeerResult::LocalFailure;
+            }
+            e="invalid-local-receive-outcome";return PeerResult::LocalFailure;
         }
         if (m.command == "getavaproofs") {
             if (!b.empty()) { e = "getavaproofs-framing"; return PeerResult::Rejected; }
