From a68e5184ce012d5b7aa7a0b2f26ffc53eaf38172 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:51:52 -0700
Subject: [PATCH] test(chronik): stop real V2 HTTP server while database owner
 is held

---
 chronik/chronik-lib/src/v2_server.rs     |  3 +++
 chronik/chronik-lib/src/v2tests/tests.rs | 30 ++++++++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/chronik/chronik-lib/src/v2_server.rs b/chronik/chronik-lib/src/v2_server.rs
index 7d9fa33df2905de98a66654c431f81ee22888d64..a3c8c7d50458d0263f8836005dc9cef6f7864502 100644
--- a/chronik/chronik-lib/src/v2_server.rs
+++ b/chronik/chronik-lib/src/v2_server.rs
@@ -106,6 +106,9 @@ impl V2Server {
         self.address.clone()
     }
     /// Gracefully stop and join the server. Repeated stops are harmless.
+    /// The five-second grace deadline is cooperative: it bounds asynchronous
+    /// connection draining, not arbitrary blocking work. V2 HTTP handlers use
+    /// nonblocking DB acquisition and return 503 while the owner is busy.
     pub fn stop(&self) -> Result<(), String> {
         let mut running =
             self.running.lock().map_err(|_| "server lock poisoned")?;
diff --git a/chronik/chronik-lib/src/v2tests/tests.rs b/chronik/chronik-lib/src/v2tests/tests.rs
index d1e570322491a02aa4f7cca2687fa3cb725e08ad..9ca8970c4753f413b874b494e9fe5671a0947294 100644
--- a/chronik/chronik-lib/src/v2tests/tests.rs
+++ b/chronik/chronik-lib/src/v2tests/tests.rs
@@ -189,3 +189,33 @@ fn explicit_loopback_server_lifecycle_authority_and_reorg() {
     let address=server.actual_address();drop(server);
     assert!(std::net::TcpStream::connect(&address).is_err());
 }
+
+#[test]
+fn real_server_busy_database_returns_503_and_stops_with_owner_held() {
+    let path=Temp::new();
+    let service=open_service(path.path(),binding(),true,limits()).unwrap();
+    service.initialize_genesis(block(2,0,2,10,vec![])).unwrap();
+    service.publish_authority(tip(2,0)).unwrap();
+    let server=start_v2_server(&service,"127.0.0.1:0").unwrap();
+    let address=server.actual_address();
+    let body=format!("{{\"any_branch\":[\"{}\"]}}","09".repeat(32));
+    let shared=service.shared_database();
+    let owner=shared.lock().unwrap();
+    let outpoint_path=format!("/v2/utxos/{}/0","0a".repeat(32));
+    for (method,path,body) in [
+        ("GET","/v2/status",""),
+        ("POST","/v2/branches/utxos",body.as_str()),
+        ("POST","/v2/branches/outputs",body.as_str()),
+        ("GET",outpoint_path.as_str(),""),
+    ] {
+        assert!(http(&address,method,path,body).starts_with("HTTP/1.1 503"));
+    }
+    let start=std::time::Instant::now();
+    server.stop().unwrap();
+    assert!(start.elapsed()<std::time::Duration::from_secs(2));
+    assert!(std::net::TcpStream::connect(&address).is_err());
+    // The owner remains held until stop has completed: shutdown must never
+    // depend on the database owner's release.
+    assert_eq!(owner.checkpoint().unwrap(),Some(anchor(&tip(2,0))));
+    drop(owner);
+}
