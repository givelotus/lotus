From 606631e43a6db1c42c03701ffd3b14c006629919 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:50:47 -0700
Subject: [PATCH] Pass explicit wall time for Avalanche proof vote cooldowns

---
 src/lotus_v2/avalanche_poll.cpp    |  4 ++--
 src/lotus_v2/avalanche_poll.h      |  4 +++-
 src/lotus_v2/test_avalanche_v2.cpp | 20 ++++++++++++--------
 3 files changed, 17 insertions(+), 11 deletions(-)

diff --git a/src/lotus_v2/avalanche_poll.cpp b/src/lotus_v2/avalanche_poll.cpp
index 8b8a873ca4d8daecf6f39e6ed4e7a2dd4ac4c885..d6f2ff620d79cdd77822fc8084816cf327393d40 100644
--- a/src/lotus_v2/avalanche_poll.cpp
+++ b/src/lotus_v2/avalanche_poll.cpp
@@ -63,7 +63,7 @@ bool PollEngine::Next(Quorum &quorum,const ChainSnapshot &snapshot,int64_t now,O
     quorum.Cooldown(next.node,timeout); out=std::move(next); return true;
 }
 bool PollEngine::Receive(Quorum &quorum,NodeId node,const SignedResponse &signed_response,
-    const ChainSnapshot &snapshot,int64_t now,const ApplyBlockUpdates &apply,std::string &error) {
+    const ChainSnapshot &snapshot,int64_t now,int64_t wall_seconds,const ApplyBlockUpdates &apply,std::string &error) {
     auto auth=quorum.Node(node); if(!auth) return Fail(error,"unknown-response-node");
     if(!AuthenticateResponse(auth->session_key,signed_response,error)) return false;
     const auto &response=signed_response.response;
@@ -94,7 +94,7 @@ bool PollEngine::Receive(Quorum &quorum,NodeId node,const SignedResponse &signed
     std::vector<std::pair<::avalanche::ProofId,Status>> proof_updates;
     for(const auto &[item,status]:updates) if(item.kind==ItemKind::Proof) proof_updates.emplace_back(::avalanche::ProofId(Native(item.id)),status);
     auto commit_blocks=[&](std::string &failure) { return blocks.empty() || (apply && apply(blocks,failure)); };
-    if(!quorum.ApplyProofVotes(proof_updates,now/1000,commit_blocks,error)) return false;
+    if(!quorum.ApplyProofVotes(proof_updates,wall_seconds,commit_blocks,error)) return false;
     for(const auto &[item,status]:updates) {
         if(item.kind==ItemKind::Block && status==Status::Invalid) impl_->invalidated.insert(item.id);
         if(status==Status::Finalized) impl_->finalized.insert(item.id);
diff --git a/src/lotus_v2/avalanche_poll.h b/src/lotus_v2/avalanche_poll.h
index cb35b42f0d2de8f6d4051ace1392d89ea206f223..76fcc94a4bcccd1e9e91c67d2933c6abdfde447b 100644
--- a/src/lotus_v2/avalanche_poll.h
+++ b/src/lotus_v2/avalanche_poll.h
@@ -15,11 +15,13 @@ public:
     bool Reconcile(const PollItem &, bool accepted, std::string &);
     bool Next(Quorum &, const ChainSnapshot &, int64_t now_milliseconds,
               OutgoingPoll &, std::string &);
+    // Query deadlines use monotonic milliseconds; proof replacement times use
+    // the independently supplied wall-clock seconds.
     // Single-owner operation: apply must atomically accept/reject the whole
     // block batch and must not reenter this engine or mutate quorum. Proof
     // transitions and staged vote confidence commit only after it accepts.
     bool Receive(Quorum &, NodeId, const SignedResponse &, const ChainSnapshot &,
-                 int64_t now_milliseconds, const ApplyBlockUpdates &, std::string &);
+                 int64_t now_milliseconds, int64_t wall_seconds, const ApplyBlockUpdates &, std::string &);
     // Signatures for incoming polls are not required by ABC; only authenticated
     // connection admission and signed outgoing responses. Observe is fenced.
     bool Respond(const OutgoingPoll &, const ObserveBlock &, const Quorum &,
diff --git a/src/lotus_v2/test_avalanche_v2.cpp b/src/lotus_v2/test_avalanche_v2.cpp
index b79260ff4425d5d37683c90b7cc2b0993a1825a0..f858f05d02cf21b738c33e308f8a89f53d2700d3 100644
--- a/src/lotus_v2/test_avalanche_v2.cpp
+++ b/src/lotus_v2/test_avalanche_v2.cpp
@@ -17,6 +17,7 @@ int main() {
   Profile profile; profile.chain_id[0]=1; profile.genesis_id[0]=2; profile.validation_digest[0]=3;
   ChainSnapshot snapshot; snapshot.tip[0]=4; snapshot.height=3000;
   Quorum quorum(profile); PollEngine engine(profile); std::string error;
+  constexpr int64_t wall_seconds=1900000000;
   CKey key; key.MakeNewKey(true); auto pub=key.GetPubKey();
   std::vector<uint8_t> lock{0x20}; lock.insert(lock.end(),pub.begin()+1,pub.end()); lock.push_back(0xbc); lock.push_back(0x4e);
   Coin coin; coin.outpoint.tx_id[0]=9; coin.creation_height=1; coin.output.value=1000000000000ULL; coin.output.branches={BranchLeaf(lock)}; coin.output.paths={{0}};
@@ -95,14 +96,14 @@ int main() {
   CHECK(engine.Respond(poll,observe,quorum,key,response,error));
   auto bad=response; bad.signature[0]^=1;
   ApplyBlockUpdates apply=[&](const std::vector<BlockUpdate> &updates,std::string &){ for(const auto &update:updates) if(update.expected_tip!=snapshot.tip || update.expected_generation!=snapshot.generation) return false; return true; };
-  CHECK(!engine.Receive(quorum,poll.node,bad,snapshot,1,apply,error));
-  CHECK(engine.Receive(quorum,poll.node,response,snapshot,1,apply,error));
-  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,2,apply,error));
+  CHECK(!engine.Receive(quorum,poll.node,bad,snapshot,1,wall_seconds,apply,error));
+  CHECK(engine.Receive(quorum,poll.node,response,snapshot,1,wall_seconds,apply,error));
+  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,2,wall_seconds,apply,error));
   // A signed malformed response consumes the query and releases every slot.
   CHECK(engine.Next(quorum,snapshot,102,poll,error));
   response.response=::avalanche::Response(poll.round,100,{}); CHECK(key.SignSchnorr(ResponseDigest(response.response),response.signature));
-  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,103,apply,error)); CHECK(error=="invalid-ava-response-size");
-  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,104,apply,error)); CHECK(error=="unexpected-ava-response");
+  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,103,wall_seconds,apply,error)); CHECK(error=="invalid-ava-response-size");
+  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,104,wall_seconds,apply,error)); CHECK(error=="unexpected-ava-response");
   // Real upstream VoteRecord must finalize only after sustained diverse votes.
   size_t finalized=0;
   ApplyBlockUpdates finalize=[&](const std::vector<BlockUpdate> &updates,std::string &){
@@ -110,12 +111,15 @@ int main() {
    CHECK(update.expected_tip==snapshot.tip); CHECK(update.expected_generation==snapshot.generation);
    if(update.status==Status::Finalized) ++finalized; } return true;
   };
-  for(int64_t now=1000;now<1000000 && finalized==0;now+=101) {
+  for(int64_t now=1000;now<1000000 && (finalized==0 || !quorum.ExportPeers().front().finalized);now+=101) {
    if(!engine.Next(quorum,snapshot,now,poll,error)) continue;
    CHECK(engine.Respond(poll,observe,quorum,key,response,error));
-   CHECK(engine.Receive(quorum,poll.node,response,snapshot,now+1,finalize,error));
+   CHECK(engine.Receive(quorum,poll.node,response,snapshot,now+1,wall_seconds,finalize,error));
   }
   CHECK(finalized==1); CHECK(!engine.Reconcile(block,true,error));
+  auto finalized_peers=quorum.ExportPeers(); CHECK(finalized_peers.size()==1); CHECK(finalized_peers.front().finalized);
+  // Query clocks near zero must never become proof replacement wall times.
+  CHECK(finalized_peers.front().next_conflict_time==wall_seconds+int64_t(profile.peer_replacement_cooldown_seconds));
   PollEngine transactional(profile); PollItem second=block; second.id[0]++;
   CHECK(transactional.Reconcile(block,true,error)); CHECK(transactional.Reconcile(second,true,error));
   bool rejected_final=false; size_t batch_finalized=0;
@@ -127,7 +131,7 @@ int main() {
   for(int64_t now=1000000;now<2000000 && batch_finalized<2;now+=101) {
    if(!transactional.Next(quorum,snapshot,now,poll,error)) continue;
    CHECK(transactional.Respond(poll,observe,quorum,key,response,error));
-   auto accepted=transactional.Receive(quorum,poll.node,response,snapshot,now+1,atomic,error);
+   auto accepted=transactional.Receive(quorum,poll.node,response,snapshot,now+1,wall_seconds,atomic,error);
    CHECK(accepted || rejected_final);
   }
   CHECK(rejected_final); CHECK(batch_finalized==2);
-- 
