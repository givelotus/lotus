From 11dd297c3b6cb9761b0e2c3d459a36fb833d3ece Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 11:20:18 -0700
Subject: [PATCH] Build recovery storage and real-fork checks in the full tree

Expose the resumable coordinator and focused storage/recovery checks using the existing validation libraries. The independent Debug and Release fixtures validate actual divergent complete blocks and exact source restoration, with restart and quota boundaries. Full-tree exact build follows this integration commit.
---
 src/lotus_v2/CMakeLists.txt | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 27c578a91..eb5f632c0 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -197,3 +197,17 @@ target_link_libraries(test_lotus_v2_peer_download PRIVATE lotus_v2_peer_download
 add_custom_target(check-lotus-v2-peer-download
     COMMAND $<TARGET_FILE:test_lotus_v2_peer_download>
     DEPENDS test_lotus_v2_peer_download)
+
+# Explicit recovery-capable homes; one durable transition per coordinator step.
+add_library(lotus_v2_reorg_recovery STATIC reorg_recovery.cpp)
+target_link_libraries(lotus_v2_reorg_recovery PUBLIC lotus_v2_validation)
+add_executable(test_lotus_v2_reorg_storage test_reorg_storage.cpp)
+target_link_libraries(test_lotus_v2_reorg_storage PRIVATE lotus_v2_validation)
+add_executable(test_lotus_v2_reorg_recovery
+    test_reorg_recovery.cpp block.cpp persistent_monetary.cpp)
+target_link_libraries(test_lotus_v2_reorg_recovery PRIVATE
+    lotus_v2_reorg_recovery lotus_v2_persistent_utxo)
+add_custom_target(check-lotus-v2-reorg
+    COMMAND $<TARGET_FILE:test_lotus_v2_reorg_storage>
+    COMMAND $<TARGET_FILE:test_lotus_v2_reorg_recovery>
+    DEPENDS test_lotus_v2_reorg_storage test_lotus_v2_reorg_recovery)
