From 03a9d5d0d73bc1df22d97a817f0043b74e11caf7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:21:14 -0700
Subject: [PATCH] test(v2): bind runtime fixture to its absolute genesis
 anchors

Maintenance explanation added during mailbox export:
Bind the runtime fixture monetary profile to its actual genesis tail and work anchors. This keeps runtime tests valid under the absolute tail formula instead of relying on incomplete legacy fixture initialization.

---
 src/lotus_v2/development_runtime_test/fixtures.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/development_runtime_test/fixtures.h b/src/lotus_v2/development_runtime_test/fixtures.h
index f6600a3a2c55da9f7ab2050d90651ff859010dc7..86becde0278b92d041faddd5d15da11f1de10575 100644
--- a/src/lotus_v2/development_runtime_test/fixtures.h
+++ b/src/lotus_v2/development_runtime_test/fixtures.h
@@ -486,7 +486,9 @@ ReorgProfiles Profiles() {
     p.ordinary.coinbase_maturity = 2;
     p.ordinary.dust_limit = 546;
     p.ordinary.max_total_invocation_cost = ~VmCostUnits(0);
-    p.monetary = {20, 17, 10, 65536, 64, 32, 1000000, 1000000000, 546, 1000};
+    // Immutable anchors of this fixture's genesis, not a subsequent parent.
+    p.monetary = {20, 17, 10, 65536, 64, 32, 1000000, 1000000000, 546, 1000,
+                  1000000, Hash{2}};
     p.cost = {1, 1, 1, 1};
     return p;
 }
