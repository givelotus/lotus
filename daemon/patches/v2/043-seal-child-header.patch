diff --git a/src/lotus_v2/block_seal.cpp b/src/lotus_v2/block_seal.cpp
new file mode 100644
index 000000000..441ce6177
--- /dev/null
+++ b/src/lotus_v2/block_seal.cpp
@@ -0,0 +1,83 @@
+// Copyright (c) 2026 The Lotus developers
+#include "block_seal.h"
+
+#include <limits>
+
+namespace lotus::v2 {
+namespace {
+
+bool SameHeader(const Header &a, const Header &b) {
+    return a.prev_id == b.prev_id && a.bits == b.bits && a.time == b.time &&
+           a.nonce == b.nonce && a.version == b.version && a.size == b.size &&
+           a.height == b.height && a.tx_root == b.tx_root &&
+           a.state_root == b.state_root;
+}
+
+} // namespace
+
+bool SealChildHeader(const OrdinaryParentContext &parent,
+                     const OrdinaryBlockConnected &connected,
+                     const Hash &tx_root, uint32_t version, uint64_t time,
+                     uint64_t size, uint32_t bits, const Hash &pow_limit,
+                     Header &out, std::string &error) {
+    static_assert(HEADER_SIZE == 134);
+    if (time > MAX_TIME) {
+        error = "timestamp above MAX_TIME";
+        return false;
+    }
+    Hash decoded_target;
+    if (!DecodeTarget(bits, pow_limit, decoded_target)) {
+        error = "compact target rejected";
+        return false;
+    }
+    (void)decoded_target;
+    if (parent.header.height == std::numeric_limits<uint64_t>::max()) {
+        error = "parent header height";
+        return false;
+    }
+    Hash parent_id;
+    if (!BlockId(parent.chain_id, parent.header, parent_id)) {
+        error = "parent block id";
+        return false;
+    }
+    const uint64_t height = parent.header.height + 1;
+    if (EncodeMonetaryState(connected.monetary.state) !=
+        connected.monetary_bytes) {
+        error = "connect result monetary bytes";
+        return false;
+    }
+    // StateRoot binds the height. A connect result committed at another
+    // height, chain, UTXO root, or monetary record does not match.
+    if (StateRoot(parent.chain_id, height, connected.utxo_root,
+                  connected.monetary.state) != connected.state_root) {
+        error = "connect result height";
+        return false;
+    }
+
+    Header sealed;
+    sealed.prev_id = parent_id;
+    sealed.bits = bits;
+    sealed.time = time;
+    sealed.nonce = 0;
+    sealed.version = version;
+    sealed.size = size;
+    sealed.height = height;
+    sealed.tx_root = tx_root;
+    sealed.state_root = connected.state_root;
+
+    std::array<uint8_t, HEADER_SIZE> bytes{};
+    Header parsed;
+    std::array<uint8_t, HEADER_SIZE> again{};
+    if (!SerializeHeader(sealed, bytes) ||
+        !ParseHeader(bytes.data(), bytes.size(), parsed) ||
+        !SameHeader(sealed, parsed) || !SerializeHeader(parsed, again) ||
+        again != bytes) {
+        error = "header round trip";
+        return false;
+    }
+    out = sealed;
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/block_seal.h b/src/lotus_v2/block_seal.h
new file mode 100644
index 000000000..fd570aa01
--- /dev/null
+++ b/src/lotus_v2/block_seal.h
@@ -0,0 +1,31 @@
+// Copyright (c) 2026 The Lotus developers
+// Seal one child header from an ordinary connect result. Not lotusd
+// ConnectTip, not a nonce search, and not daemon acceptance of the header.
+#ifndef LOTUS_V2_BLOCK_SEAL_H
+#define LOTUS_V2_BLOCK_SEAL_H
+
+#include "block.h"
+
+#include <string>
+
+namespace lotus::v2 {
+
+// Fills `out` on success and leaves it unchanged on failure.
+//
+// header.state_root is OrdinaryBlockConnected::state_root. ConnectOrdinaryBlock
+// sets that field with StateRoot (sparse_state.h): chain id, child height,
+// UTXO root, and the canonical 56-byte monetary record. This checks the same
+// StateRoot at parent.header.height+1 and does not hash the roots another way.
+// utxo_root is not the header state commitment.
+//
+// ConnectOrdinaryBlock does not return a transaction root. `tx_root` is the
+// caller's ordered transaction-root commitment and is copied as supplied.
+// Nonce is zero. `pow_limit` is only the DecodeTarget ceiling.
+bool SealChildHeader(const OrdinaryParentContext &parent,
+                     const OrdinaryBlockConnected &connected,
+                     const Hash &tx_root, uint32_t version, uint64_t time,
+                     uint64_t size, uint32_t bits, const Hash &pow_limit,
+                     Header &out, std::string &error);
+
+} // namespace lotus::v2
+#endif
