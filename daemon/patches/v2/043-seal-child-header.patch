diff --git a/src/lotus_v2/test_block_seal.cpp b/src/lotus_v2/test_block_seal.cpp
new file mode 100644
index 000000000..b5da852ee
--- /dev/null
+++ b/src/lotus_v2/test_block_seal.cpp
@@ -0,0 +1,269 @@
+// Copyright (c) 2026 The Lotus developers
+// Structural child-header seal. No nonce search and no lotusd ConnectTip.
+#include "block_seal.h"
+
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+std::string Hex(const uint8_t *data, size_t size) {
+    static const char *digits = "0123456789abcdef";
+    std::string out(size * 2, '0');
+    for (size_t i = 0; i < size; ++i) {
+        out[2 * i] = digits[data[i] >> 4];
+        out[2 * i + 1] = digits[data[i] & 0xf];
+    }
+    return out;
+}
+
+Hash Pattern(uint8_t start) {
+    Hash hash{};
+    for (size_t i = 0; i < hash.size(); ++i) {
+        hash[i] = static_cast<uint8_t>(start + i);
+    }
+    return hash;
+}
+
+MonetaryState Money() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Hash PowLimit() {
+    Hash limit{};
+    limit[31] = 0xff;
+    return limit;
+}
+
+struct Sample {
+    OrdinaryParentContext parent;
+    OrdinaryBlockConnected connected;
+    Hash tx_root;
+    Hash pow_limit;
+};
+
+Sample MakeSample() {
+    Sample sample;
+    sample.pow_limit = PowLimit();
+    sample.tx_root = Pattern(128);
+    sample.parent.chain_id = Pattern(0);
+    sample.parent.monetary = Money();
+    sample.parent.header.prev_id = Pattern(32);
+    sample.parent.header.bits = 0x1d00ffff;
+    sample.parent.header.time = 50000;
+    sample.parent.header.nonce = 7;
+    sample.parent.header.version = 1;
+    sample.parent.header.size = HEADER_SIZE;
+    sample.parent.header.height = 99;
+    sample.parent.header.tx_root = Pattern(64);
+    sample.parent.header.state_root = Pattern(96);
+    const MonetaryState child_money = Money();
+    sample.connected.utxo_root = Pattern(192);
+    sample.connected.monetary.state = child_money;
+    sample.connected.monetary_bytes = EncodeMonetaryState(child_money);
+    sample.connected.state_root =
+        StateRoot(sample.parent.chain_id, 100, sample.connected.utxo_root,
+                  child_money);
+    return sample;
+}
+
+Header Sentinel() {
+    Header header;
+    header.prev_id.fill(0xa5);
+    header.bits = 0xa5a5a5a5;
+    header.time = 3;
+    header.nonce = 9;
+    header.version = 0xa5a5a5a5;
+    header.size = 11;
+    header.height = 13;
+    header.tx_root.fill(0xa5);
+    header.state_root.fill(0xa5);
+    return header;
+}
+
+bool Unchanged(const Header &header) {
+    const Header saved = Sentinel();
+    return header.prev_id == saved.prev_id && header.bits == saved.bits &&
+           header.time == saved.time && header.nonce == saved.nonce &&
+           header.version == saved.version && header.size == saved.size &&
+           header.height == saved.height && header.tx_root == saved.tx_root &&
+           header.state_root == saved.state_root;
+}
+
+void ExpectReject(const Sample &sample, uint64_t time, uint32_t bits,
+                  const Hash &pow_limit, const std::string &reason) {
+    Header out = Sentinel();
+    std::string error = "sentinel";
+    Check(!SealChildHeader(sample.parent, sample.connected, sample.tx_root, 2,
+                           time, 400, bits, pow_limit, out, error),
+          "expected reject: " + reason);
+    Check(error == reason, "reject reason " + reason + " got " + error);
+    Check(Unchanged(out), "failed seal modified the header");
+}
+} // namespace
+
+int main() {
+    try {
+        const Sample sample = MakeSample();
+        Check(sample.connected.state_root != sample.connected.utxo_root,
+              "state root is not the utxo root");
+        Check(sample.connected.state_root ==
+                  StateRoot(sample.parent.chain_id, 100,
+                            sample.connected.utxo_root,
+                            sample.connected.monetary.state),
+              "fixture uses StateRoot");
+
+        Header sealed = Sentinel();
+        std::string error = "sentinel";
+        Check(SealChildHeader(sample.parent, sample.connected, sample.tx_root,
+                              2, 50120, 400, 0x1d00ffff, sample.pow_limit,
+                              sealed, error),
+              "seal: " + error);
+        Check(error.empty(), "success clears the error");
+        Hash parent_id{};
+        Check(BlockId(sample.parent.chain_id, sample.parent.header, parent_id),
+              "parent block id");
+        Check(sealed.prev_id == parent_id, "prev_id is the parent block id");
+        Check(sealed.prev_id != sample.parent.header.prev_id,
+              "prev_id is not the parent's prev_id");
+        Check(sealed.height == 100, "child height");
+        Check(sealed.tx_root == sample.tx_root, "caller tx root");
+        Check(sealed.tx_root != sample.connected.utxo_root,
+              "tx root is not the utxo root");
+        Check(sealed.state_root == sample.connected.state_root,
+              "header state root is the connected StateRoot");
+        Check(sealed.nonce == 0, "nonce stays zero");
+        Check(sealed.time == 50120 && sealed.bits == 0x1d00ffff &&
+                  sealed.version == 2 && sealed.size == 400,
+              "supplied header fields");
+
+        std::array<uint8_t, HEADER_SIZE> bytes{};
+        Check(SerializeHeader(sealed, bytes), "serialize sealed header");
+        Check(bytes.size() == 134, "serialization is 134 bytes");
+        Header parsed;
+        Check(ParseHeader(bytes.data(), bytes.size(), parsed), "parse sealed");
+        Check(parsed.prev_id == sealed.prev_id && parsed.bits == sealed.bits &&
+                  parsed.time == sealed.time && parsed.nonce == sealed.nonce &&
+                  parsed.version == sealed.version &&
+                  parsed.size == sealed.size &&
+                  parsed.height == sealed.height &&
+                  parsed.tx_root == sealed.tx_root &&
+                  parsed.state_root == sealed.state_root,
+              "parsed fields match");
+        Check(bytes[36] == 0xc8 && bytes[37] == 0xc3 && bytes[38] == 0 &&
+                  bytes[39] == 0 && bytes[40] == 0 && bytes[41] == 0,
+              "u48 timestamp offset");
+        Check(bytes[42] == 0 && bytes[49] == 0, "zero nonce offset");
+        Check(bytes[50] == 2 && bytes[51] == 0, "version offset");
+        Check(bytes[54] == 0x90 && bytes[55] == 0x01, "size offset");
+        Check(bytes[62] == 100 && bytes[63] == 0, "height offset");
+        Check(std::equal(sample.tx_root.begin(), sample.tx_root.end(),
+                         bytes.begin() + 70),
+              "tx root offset");
+        Check(std::equal(sealed.state_root.begin(), sealed.state_root.end(),
+                         bytes.begin() + 102),
+              "state root offset");
+
+        Hash block_id{};
+        Check(BlockId(sample.parent.chain_id, sealed, block_id), "child block id");
+        Hash hard{};
+        Check(DecodeTarget(0x01010000, sample.pow_limit, hard) && hard[0] == 1,
+              "hard target of one");
+        Check(!MeetsTarget(block_id, hard), "hard target does not meet");
+        Hash easy{};
+        easy.fill(0xff);
+        Check(MeetsTarget(block_id, easy), "easy target meets without a search");
+        Check(MeetsTarget(block_id, block_id), "equal target meets");
+        Hash below = block_id;
+        bool decreased = false;
+        for (int i = 31; i >= 0 && !decreased; --i) {
+            if (below[i] != 0) {
+                below[i]--;
+                decreased = true;
+            }
+        }
+        Check(decreased && !MeetsTarget(block_id, below),
+              "target below the block id does not meet");
+        Check(sealed.nonce == 0, "target checks did not search a nonce");
+
+        ExpectReject(sample, MAX_TIME + 1, 0x1d00ffff, sample.pow_limit,
+                     "timestamp above MAX_TIME");
+        ExpectReject(sample, 50120, 0x1d80ffff, sample.pow_limit,
+                     "compact target rejected");
+        ExpectReject(sample, 50120, 0x1d000000, sample.pow_limit,
+                     "compact target rejected");
+        ExpectReject(sample, 50120, 0x03000001, sample.pow_limit,
+                     "compact target rejected");
+        Hash low_limit{};
+        low_limit[0] = 1;
+        ExpectReject(sample, 50120, 0x1d00ffff, low_limit,
+                     "compact target rejected");
+
+        Sample wrong_height = sample;
+        wrong_height.connected.state_root =
+            StateRoot(sample.parent.chain_id, 101, sample.connected.utxo_root,
+                      sample.connected.monetary.state);
+        Header out = Sentinel();
+        error.clear();
+        Check(!SealChildHeader(wrong_height.parent, wrong_height.connected,
+                               wrong_height.tx_root, 2, 50120, 400, 0x1d00ffff,
+                               wrong_height.pow_limit, out, error),
+              "wrong height must reject");
+        Check(error == "connect result height", "height reason");
+        Check(Unchanged(out), "height failure preserves header");
+
+        Sample bad_bytes = sample;
+        bad_bytes.connected.monetary_bytes[0] ^= 0xff;
+        out = Sentinel();
+        Check(!SealChildHeader(bad_bytes.parent, bad_bytes.connected,
+                               bad_bytes.tx_root, 2, 50120, 400, 0x1d00ffff,
+                               bad_bytes.pow_limit, out, error),
+              "monetary byte mismatch must reject");
+        Check(error == "connect result monetary bytes", "monetary reason");
+        Check(Unchanged(out), "monetary failure preserves header");
+
+        Sample tall = sample;
+        tall.parent.header.height = UINT64_MAX;
+        out = Sentinel();
+        Check(!SealChildHeader(tall.parent, tall.connected, tall.tx_root, 2,
+                               50120, 400, 0x1d00ffff, tall.pow_limit, out,
+                               error),
+              "height overflow must reject");
+        Check(error == "parent header height", "overflow reason");
+        Check(Unchanged(out), "overflow preserves header");
+
+        Sample bad_parent = sample;
+        bad_parent.parent.header.time = MAX_TIME + 1;
+        out = Sentinel();
+        Check(!SealChildHeader(bad_parent.parent, bad_parent.connected,
+                               bad_parent.tx_root, 2, 50120, 400, 0x1d00ffff,
+                               bad_parent.pow_limit, out, error),
+              "parent time must reject");
+        Check(error == "parent block id", "parent id reason");
+        Check(Unchanged(out), "parent id failure preserves header");
+
+        Check(Hex(bytes.data(), bytes.size()) ==
+                  "097e8dc58f4a3e803318cb94ba94b61e9aeeb1ccf25dd480e70c9c260d201729"
+                  "ffff001dc8c30000000000000000000000000200000090010000000000006400000000000000"
+                  "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
+                  "446219abb2c014b44d72ed377c0e3453e7d8099e2b039c2075a4958248f78b7f",
+              "134-byte header vector");
+        std::cout << "sealed " << Hex(bytes.data(), bytes.size()) << "\n";
+        std::cout << "V2 child header seal passed\n";
+    } catch (const std::exception &ex) {
+        std::cerr << "V2 child header seal: " << ex.what() << '\n';
+        return 1;
+    }
+}
