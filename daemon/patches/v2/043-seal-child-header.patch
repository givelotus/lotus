+add_executable(lotus_v2_block_seal_test
+    ../header.cpp ../output.cpp ../commitment.cpp ../tagged_hash.cpp
+    ../sparse_state.cpp ../block_seal.cpp ../test_block_seal.cpp)
+target_include_directories(lotus_v2_block_seal_test PRIVATE
+    "${LOTUS_BOOST_INCLUDE}" ../vendor/blake3)
+target_link_libraries(lotus_v2_block_seal_test PRIVATE
