From f22712c29e35ed4174561c0251c07f3ffc5030e7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:38:51 -0700
Subject: [PATCH] Run development chain initialization checks in the full ABC
 build

Link the independent genesis/reopen/profile regression executable to the same validation library used by the integration build. Debug full-tree check-lotus-v2-development-chain and standalone initializer/disk suites pass after explicit valid fixture profiles were supplied. This is initializer evidence, not daemon block acceptance or network activation.
---
 src/lotus_v2/CMakeLists.txt | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index e007cac86be0b3982ec92f5b6a5cdc51a7d96dab..9f262821711c55282d89b3169841fcf8a30585ff 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -164,3 +164,9 @@ target_link_libraries(test_lotus_v2_peer_codec PRIVATE lotus_v2_peer_codec)
 add_custom_target(check-lotus-v2-peer-codec
     COMMAND $<TARGET_FILE:test_lotus_v2_peer_codec>
     DEPENDS test_lotus_v2_peer_codec)
+
+add_executable(test_lotus_v2_development_chain test_development_chain.cpp)
+target_link_libraries(test_lotus_v2_development_chain PRIVATE lotus_v2_validation)
+add_custom_target(check-lotus-v2-development-chain
+    COMMAND $<TARGET_FILE:test_lotus_v2_development_chain>
+    DEPENDS test_lotus_v2_development_chain)
