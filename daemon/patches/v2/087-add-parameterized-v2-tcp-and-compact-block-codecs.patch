+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_PEER_CODEC_H
+#define LOTUS_V2_PEER_CODEC_H
+#include "block_wire.h"
+#include <map>
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+namespace lotus::v2::peer {
+using Bytes = std::vector<uint8_t>;
+constexpr uint64_t MANDATORY_FEATURES = 7;
+constexpr uint32_t MAX_RECEIVE_LIMIT = 16 * 1024 * 1024;
+constexpr uint32_t PRE_HELLO_LIMIT = 2 * 1024 * 1024;
+struct NetworkProfile {
+    std::array<uint8_t, 4> magic;
+    ChainId chain_id;
+    Hash genesis_id;
+    Hash profile_digest;
+    uint32_t receive_limit;
+    TxProfile transaction;
+    // Local resource quota, independent of consensus and peer header.size.
+    uint32_t max_reconstruction_transactions;
+    uint64_t max_reconstruction_bytes;
+};
+Hash ConsensusProfileDigest(std::span<const uint8_t> canonical_parameters);
+struct Hello {
+    uint16_t revision = 1;
+    ChainId chain_id{};
+    Hash genesis_id{}, profile_digest{};
+    uint64_t supported = MANDATORY_FEATURES, required = MANDATORY_FEATURES;
+    uint32_t receive_limit = 0;
+};
+bool EncodeHello(const Hello &, Bytes &, std::string &);
+bool DecodeHello(std::span<const uint8_t>, Hello &, std::string &);
+bool NegotiateHello(const NetworkProfile &, const Hello &,
+                    uint32_t &active_limit, std::string &);
+struct Message {
+    std::string command;
+    Bytes payload;
+};
+bool EncodeEnvelope(const NetworkProfile &, uint32_t active_limit,
+                    const Message &, Bytes &, std::string &);
+enum class FeedStatus { Incomplete, MessageReady, InvalidPeerMessage };
+// One message per call. Caller retains input.subspan(consumed). Header checks
+// precede payload allocation. Errors are terminal until Reset().
+class EnvelopeDecoder {
+public:
+    explicit EnvelopeDecoder(const NetworkProfile &);
+    bool SetActiveLimit(uint32_t, std::string &); // only between messages
+    FeedStatus Feed(std::span<const uint8_t>, size_t &consumed, Message &,
+                    std::string &);
+    void Reset();
+
+private:
+    NetworkProfile profile_;
+    uint32_t limit_;
+    std::array<uint8_t, 24> header_{};
+    size_t header_bytes_ = 0;
+    uint32_t expected_ = 0;
+    Message pending_;
+    bool failed_ = false;
+};
+struct Inventory {
+    uint32_t type;
+    Hash hash;
+}; // 1=TxHash, 2/4=BlockID
+bool EncodeInventory(std::span<const Inventory>, uint32_t limit, Bytes &,
+                     std::string &);
+bool DecodeInventory(std::span<const uint8_t>, uint32_t limit,
+                     std::vector<Inventory> &, std::string &);
+bool KnownInventoryType(uint32_t);
+bool EncodeHeaders(std::span<const Header>, uint32_t limit, Bytes &,
+                   std::string &);
+bool DecodeHeaders(std::span<const uint8_t>, uint32_t limit,
+                   std::vector<Header> &, std::string &);
+struct Locator {
+    int32_t version;
+    std::vector<Hash> ids;
+    Hash stop{};
+};
+bool EncodeLocator(const Locator &, uint32_t limit, Bytes &, std::string &);
+bool DecodeLocator(std::span<const uint8_t>, uint32_t limit, Locator &,
+                   std::string &);
+struct SendCompact {
+    bool announce;
+    uint64_t version;
+};
+bool EncodeSendCompact(const SendCompact &, Bytes &, std::string &);
+bool DecodeSendCompact(std::span<const uint8_t>, SendCompact &, std::string &);
+struct Prefilled {
+    uint32_t index;
+    Transaction transaction;
+};
+struct CompactBlock {
+    Header header;
+    uint64_t nonce;
+    std::vector<uint64_t> short_ids;
+    std::vector<Prefilled> prefilled;
+};
+struct CompactKeys {
+    uint64_t k0, k1;
+};
+bool DeriveCompactKeys(const Header &, uint64_t nonce, CompactKeys &);
+uint64_t ShortId(const CompactKeys &, const Hash &tx_hash);
+bool MakeCompact(const FramedBlock &, const NetworkProfile &, uint64_t nonce,
+                 std::span<const uint32_t> prefilled_indices, CompactBlock &,
+                 std::string &);
+bool EncodeCompact(const CompactBlock &, const NetworkProfile &, uint32_t limit,
+                   Bytes &, std::string &);
+bool DecodeCompact(std::span<const uint8_t>, const NetworkProfile &,
+                   uint32_t limit, CompactBlock &, std::string &);
+struct MissingRequest {
+    Hash block_id;
+    std::vector<uint32_t> indices;
+};
+struct MissingResponse {
+    Hash block_id;
+    std::vector<Transaction> transactions;
+};
+bool EncodeMissingRequest(const MissingRequest &, uint32_t total_transactions,
+                          uint32_t limit, Bytes &, std::string &);
+bool DecodeMissingRequest(std::span<const uint8_t>, uint32_t total_transactions,
+                          uint32_t max_count, uint32_t limit, MissingRequest &,
+                          std::string &);
+bool EncodeMissingResponse(const MissingResponse &, const NetworkProfile &,
+                           uint32_t limit, Bytes &, std::string &);
+bool DecodeMissingResponse(std::span<const uint8_t>, const NetworkProfile &,
+                           uint32_t max_count, uint32_t limit,
+                           MissingResponse &, std::string &);
+// Pure ambiguity policy: repeat sightings of one full hash are not ambiguity;
+// distinct full hashes sharing a short ID are. Never resolves by TxID.
+std::optional<Hash> UniqueCandidate(std::span<const Hash> full_hashes);
+enum class ReconstructionStatus {
+    InvalidPeerMessage,
+    NeedTransactions,
+    NeedFullBlock,
+    CompleteUnvalidated
+};
+// Caller supplies validated, complete cached transactions, reserves quotas and
+// checks contextual header/PoW eligibility before Start(). No consensus-invalid
+// verdict is returned. A failed root/size always requests a full body.
+class CompactReconstruction {
+public:
+    explicit CompactReconstruction(const NetworkProfile &);
+    ReconstructionStatus Start(const CompactBlock &,
+                               std::span<const Transaction>, std::string &);
+    const MissingRequest &Request() const { return request_; }
+    ReconstructionStatus Apply(const MissingResponse &, std::string &);
+    bool TakeComplete(FramedBlock &); // one-shot, still unvalidated
+    void Cancel();
+
+private:
+    ReconstructionStatus Finish(std::string &);
+    bool Store(uint32_t, const Transaction &, std::string &);
+    uint64_t retained_wire_bytes_ = HEADER_SIZE + 4;
+    NetworkProfile profile_;
+    CompactBlock compact_;
+    CompactKeys keys_{};
+    MissingRequest request_{};
+    std::vector<std::optional<Transaction>> slots_;
+    std::vector<std::optional<uint64_t>> expected_short_ids_;
+    std::optional<FramedBlock> complete_;
+    bool outstanding_ = false;
+};
+} // namespace lotus::v2::peer
+#endif
