+// Copyright (c) 2026 The Lotus developers
+#include "peer_codec.h"
+#include "signing.h"
+#include "vendor/blake3/blake3.h"
+#include <algorithm>
+#include <crypto/sha256.h>
+#include <crypto/siphash.h>
+#include <limits>
+#include <set>
+#include <utility>
+namespace lotus::v2::peer {
+namespace {
+    bool Fail(std::string &e, const char *s) {
+        e = s;
+        return false;
+    }
+    bool Success(std::string &e) {
+        e.clear();
+        return true;
+    }
+    void Put(Bytes &b, uint64_t n, unsigned w) {
+        for (unsigned i = 0; i < w; ++i)
+            b.push_back(uint8_t(n >> (8 * i)));
+    }
+    uint64_t Get(const uint8_t *p, unsigned w) {
+        uint64_t n = 0;
+        for (unsigned i = 0; i < w; ++i)
+            n |= uint64_t(p[i]) << (8 * i);
+        return n;
+    }
+    void CS(Bytes &b, uint64_t n) {
+        if (n < 253)
+            Put(b, n, 1);
+        else {
+            unsigned w = n <= 65535 ? 2 : n <= UINT32_MAX ? 4 : 8;
+            Put(b, w == 2 ? 253 : w == 4 ? 254 : 255, 1);
+            Put(b, n, w);
+        }
+    }
+    void HashBytes(Bytes &b, const Hash &h) {
+        b.insert(b.end(), h.begin(), h.end());
+    }
+    class Reader {
+    public:
+        explicit Reader(std::span<const uint8_t> b) : b_(b) {}
+        size_t Left() const { return b_.size() - pos_; }
+        bool Take(size_t n, std::span<const uint8_t> &b) {
+            if (n > Left()) return false;
+            b = b_.subspan(pos_, n);
+            pos_ += n;
+            return true;
+        }
+        bool Int(unsigned w, uint64_t &n) {
+            std::span<const uint8_t> b;
+            if (!Take(w, b)) return false;
+            n = Get(b.data(), w);
+            return true;
+        }
+        bool HashValue(Hash &h) {
+            std::span<const uint8_t> b;
+            if (!Take(32, b)) return false;
+            std::copy(b.begin(), b.end(), h.begin());
+            return true;
+        }
+        bool Compact(uint64_t cap, uint64_t &n) {
+            uint64_t lead;
+            if (!Int(1, lead)) return false;
+            if (lead < 253)
+                n = lead;
+            else {
+                unsigned w = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+                if (!Int(w, n) || n < (w == 2   ? 253ULL
+                                       : w == 4 ? 65536ULL
+                                                : 4294967296ULL))
+                    return false;
+            }
+            return n <= cap;
+        }
+        bool HeaderValue(Header &h) {
+            std::span<const uint8_t> b;
+            return Take(HEADER_SIZE, b) && ParseHeader(b.data(), b.size(), h) &&
+                   h.version == 2;
+        }
+        bool Tx(const TxProfile &p, Transaction &tx) {
+            uint64_t n;
+            std::span<const uint8_t> b;
+            std::string error;
+            return Compact(Left(), n) && n >= 16 && Take(size_t(n), b) &&
+                   DecodeTransaction(Bytes(b.begin(), b.end()), p, tx, error);
+        }
+
+    private:
+        std::span<const uint8_t> b_;
+        size_t pos_ = 0;
+    };
+    bool Limit(uint32_t n) {
+        return n >= 1 && n <= MAX_RECEIVE_LIMIT;
+    }
+    bool Bound(size_t n, uint32_t cap, std::string &e) {
+        return Limit(cap) && n <= cap ? true : Fail(e, "message capacity");
+    }
+    bool Command(std::span<const uint8_t> b, std::string &out) {
+        bool zero = false;
+        std::string s;
+        for (auto c : b) {
+            if (!c)
+                zero = true;
+            else if (zero || c < 0x20 || c > 0x7e)
+                return false;
+            else
+                s.push_back(char(c));
+        }
+        if (s.empty()) return false;
+        out = std::move(s);
+        return true;
+    }
+    uint32_t CommandCap(const std::string &c, uint32_t limit) {
+        uint32_t n = limit;
+        if (c == "v2hello")
+            n = 118;
+        else if (c == "verack" || c == "sendheaders" || c == "sendaddrv2" ||
+                 c == "getaddr")
+            n = 0;
+        else if (c == "ping" || c == "pong")
+            n = 8;
+        else if (c == "sendcmpct")
+            n = 9;
+        else if (c == "headers")
+            n = 3 + 2000 * 135;
+        else if (c == "getheaders" || c == "getblocks")
+            n = 4 + 1 + 101 * 32 + 32;
+        else if (c == "inv" || c == "getdata" || c == "notfound")
+            n = 3 + 50000 * 36;
+        return std::min(limit, n);
+    }
+    Hash Checksum(std::span<const uint8_t> b) {
+        Hash h;
+        CSHA256().Write(b.data(), b.size()).Finalize(h.data());
+        CSHA256().Write(h.data(), h.size()).Finalize(h.data());
+        return h;
+    }
+    bool PutHeader(Bytes &b, const Header &h) {
+        std::array<uint8_t, HEADER_SIZE> raw;
+        if (h.version != 2 || !SerializeHeader(h, raw)) return false;
+        b.insert(b.end(), raw.begin(), raw.end());
+        return true;
+    }
+    bool PutTx(Bytes &b, const Transaction &tx, const TxProfile &p,
+               uint32_t cap, std::string &e) {
+        Bytes raw;
+        if (!EncodeTransaction(tx, p, raw, e)) return false;
+        if (raw.size() > cap || b.size() > cap ||
+            CompactSizeWidth(raw.size()) + raw.size() > cap - b.size())
+            return Fail(e, "transaction capacity");
+        CS(b, raw.size());
+        b.insert(b.end(), raw.begin(), raw.end());
+        return true;
+    }
+    bool CompactShape(const CompactBlock &c, const NetworkProfile &p,
+                      uint32_t &n, std::string &e) {
+        uint64_t count = uint64_t(c.short_ids.size()) + c.prefilled.size();
+        if (!count || count > UINT32_MAX ||
+            count > p.max_reconstruction_transactions ||
+            c.header.version != 2 || c.header.size < HEADER_SIZE + 4 ||
+            count > (c.header.size - HEADER_SIZE - 4) / 17)
+            return Fail(e, "compact transaction quota/size");
+        n = uint32_t(count);
+        if (c.prefilled.empty() || c.prefilled[0].index != 0 ||
+            c.prefilled[0].transaction.inputs.size() != 1 ||
+            c.prefilled[0].transaction.inputs[0].flags != 2)
+            return Fail(e, "coinbase must be prefilled");
+        uint32_t prev = 0;
+        for (size_t i = 0; i < c.prefilled.size(); ++i) {
+            auto idx = c.prefilled[i].index;
+            if (idx >= n || (i && idx <= prev))
+                return Fail(e, "prefilled indices");
+            prev = idx;
+        }
+        for (auto s : c.short_ids)
+            if (s >> 48) return Fail(e, "short ID width");
+        return true;
+    }
+    bool Indices(std::span<const uint32_t> indices, uint32_t total,
+                 std::string &e) {
+        if (indices.empty() || indices.size() > total)
+            return Fail(e, "missing-index count");
+        for (size_t i = 0; i < indices.size(); ++i)
+            if (indices[i] >= total || (i && indices[i] <= indices[i - 1]))
+                return Fail(e, "missing indices");
+        return true;
+    }
+    bool Delta(Reader &r, uint64_t &next, uint32_t total, uint32_t &index) {
+        uint64_t delta;
+        if (!r.Compact(UINT32_MAX, delta) || next > UINT32_MAX ||
+            delta > UINT32_MAX - next)
+            return false;
+        uint64_t absolute = next + delta;
+        if (absolute >= total) return false;
+        index = uint32_t(absolute);
+        next = absolute + 1;
+        return true;
+    }
+} // namespace
+Hash ConsensusProfileDigest(std::span<const uint8_t> parameters) {
+    static constexpr char domain[] = "Lotus/v2/p2p/profile";
+    blake3_hasher h;
+    blake3_hasher_init(&h);
+    blake3_hasher_update(&h, domain, sizeof(domain));
+    blake3_hasher_update(&h, parameters.data(), parameters.size());
+    Hash out;
+    blake3_hasher_finalize(&h, out.data(), out.size());
+    return out;
+}
+bool EncodeHello(const Hello &h, Bytes &out, std::string &e) {
+    if (!Limit(h.receive_limit)) return Fail(e, "hello receive limit");
+    Bytes b;
+    Put(b, h.revision, 2);
+    HashBytes(b, h.chain_id);
+    HashBytes(b, h.genesis_id);
+    HashBytes(b, h.profile_digest);
+    Put(b, h.supported, 8);
+    Put(b, h.required, 8);
+    Put(b, h.receive_limit, 4);
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeHello(std::span<const uint8_t> b, Hello &out, std::string &e) {
+    if (b.size() != 118) return Fail(e, "hello size");
+    Reader r(b);
+    Hello h;
+    uint64_t n;
+    if (!r.Int(2, n)) return Fail(e, "hello revision");
+    h.revision = uint16_t(n);
+    if (!r.HashValue(h.chain_id) || !r.HashValue(h.genesis_id) ||
+        !r.HashValue(h.profile_digest) || !r.Int(8, h.supported) ||
+        !r.Int(8, h.required) || !r.Int(4, n) || !Limit(uint32_t(n)))
+        return Fail(e, "hello fields");
+    h.receive_limit = uint32_t(n);
+    out = h;
+    return Success(e);
+}
+bool NegotiateHello(const NetworkProfile &p, const Hello &h, uint32_t &active,
+                    std::string &e) {
+    if (h.revision != 1 || h.chain_id != p.chain_id ||
+        h.genesis_id != p.genesis_id || h.profile_digest != p.profile_digest)
+        return Fail(e, "hello network identity/revision");
+    if ((h.supported & MANDATORY_FEATURES) != MANDATORY_FEATURES ||
+        (h.required & MANDATORY_FEATURES) != MANDATORY_FEATURES ||
+        (h.required & ~MANDATORY_FEATURES) || (h.required & ~h.supported))
+        return Fail(e, "hello required features");
+    if (!Limit(h.receive_limit) || !Limit(p.receive_limit))
+        return Fail(e, "hello receive limit");
+    active = std::min(p.receive_limit, h.receive_limit);
+    return Success(e);
+}
+bool EncodeEnvelope(const NetworkProfile &p, uint32_t limit, const Message &m,
+                    Bytes &out, std::string &e) {
+    if (limit > p.receive_limit || !Bound(m.payload.size(), limit, e) ||
+        m.payload.size() > CommandCap(m.command, limit) || m.command.empty() ||
+        m.command.size() > 12)
+        return Fail(e, "envelope bounds");
+    std::array<uint8_t, 12> cmd{};
+    std::copy(m.command.begin(), m.command.end(), cmd.begin());
+    std::string check;
+    if (!Command(cmd, check) || check != m.command)
+        return Fail(e, "envelope command");
+    Bytes b(p.magic.begin(), p.magic.end());
+    b.insert(b.end(), cmd.begin(), cmd.end());
+    Put(b, m.payload.size(), 4);
+    Hash sum = Checksum(m.payload);
+    b.insert(b.end(), sum.begin(), sum.begin() + 4);
+    b.insert(b.end(), m.payload.begin(), m.payload.end());
+    out = std::move(b);
+    return Success(e);
+}
+EnvelopeDecoder::EnvelopeDecoder(const NetworkProfile &p)
+    : profile_(p), limit_(std::min(p.receive_limit, PRE_HELLO_LIMIT)) {}
+void EnvelopeDecoder::Reset() {
+    header_bytes_ = 0;
+    expected_ = 0;
+    pending_ = {};
+    failed_ = false;
+}
+bool EnvelopeDecoder::SetActiveLimit(uint32_t n, std::string &e) {
+    if (header_bytes_ || failed_ || !Limit(n) || n > profile_.receive_limit)
+        return Fail(e, "active limit transition");
+    limit_ = n;
+    return Success(e);
+}
+FeedStatus EnvelopeDecoder::Feed(std::span<const uint8_t> b, size_t &used,
+                                 Message &out, std::string &e) {
+    used = 0;
+    auto invalid = [&](const char *s) {
+        failed_ = true;
+        e = s;
+        pending_ = {};
+        return FeedStatus::InvalidPeerMessage;
+    };
+    if (failed_ || !Limit(limit_)) return invalid("decoder state/profile");
+    if (header_bytes_ < 24) {
+        size_t take = std::min(b.size(), 24 - header_bytes_);
+        std::copy_n(b.begin(), take, header_.begin() + header_bytes_);
+        used += take;
+        header_bytes_ += take;
+        b = b.subspan(take);
+        if (header_bytes_ < 24) {
+            e.clear();
+            return FeedStatus::Incomplete;
+        }
+        if (!std::equal(profile_.magic.begin(), profile_.magic.end(),
+                        header_.begin()))
+            return invalid("network magic");
+        if (!Command(std::span<const uint8_t>(header_).subspan(4, 12),
+                     pending_.command))
+            return invalid("command padding/ASCII");
+        expected_ = uint32_t(Get(header_.data() + 16, 4));
+        if (expected_ > CommandCap(pending_.command, limit_))
+            return invalid("payload limit");
+    }
+    size_t take =
+        std::min(b.size(), size_t(expected_) - pending_.payload.size());
+    pending_.payload.insert(pending_.payload.end(), b.begin(),
+                            b.begin() + take);
+    used += take;
+    if (pending_.payload.size() != expected_) {
+        e.clear();
+        return FeedStatus::Incomplete;
+    }
+    Hash sum = Checksum(pending_.payload);
+    if (!std::equal(sum.begin(), sum.begin() + 4, header_.begin() + 20))
+        return invalid("checksum");
+    out = std::move(pending_);
+    Reset();
+    e.clear();
+    return FeedStatus::MessageReady;
+}
+bool KnownInventoryType(uint32_t t) {
+    return t == 1 || t == 2 || t == 4;
+}
+bool EncodeInventory(std::span<const Inventory> v, uint32_t limit, Bytes &out,
+                     std::string &e) {
+    if (v.size() > 50000 ||
+        !Bound(CompactSizeWidth(v.size()) + 36 * v.size(), limit, e))
+        return Fail(e, "inventory count/capacity");
+    Bytes b;
+    CS(b, v.size());
+    for (const auto &i : v) {
+        Put(b, i.type, 4);
+        HashBytes(b, i.hash);
+    }
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeInventory(std::span<const uint8_t> b, uint32_t limit,
+                     std::vector<Inventory> &out, std::string &e) {
+    if (!Bound(b.size(), limit, e)) return false;
+    Reader r(b);
+    uint64_t count;
+    if (!r.Compact(50000, count) || count > r.Left() / 36 ||
+        count * 36 != r.Left())
+        return Fail(e, "inventory count/bytes");
+    std::vector<Inventory> v;
+    for (uint64_t i = 0; i < count; ++i) {
+        uint64_t type;
+        Inventory item{};
+        if (!r.Int(4, type) || !r.HashValue(item.hash))
+            return Fail(e, "inventory item");
+        item.type = uint32_t(type);
+        v.push_back(item);
+    }
+    out = std::move(v);
+    return Success(e);
+}
+bool EncodeHeaders(std::span<const Header> v, uint32_t limit, Bytes &out,
+                   std::string &e) {
+    if (v.size() > 2000 ||
+        !Bound(CompactSizeWidth(v.size()) + 135 * v.size(), limit, e))
+        return Fail(e, "headers count/capacity");
+    Bytes b;
+    CS(b, v.size());
+    for (const auto &h : v) {
+        if (!PutHeader(b, h)) return Fail(e, "header structure");
+        b.push_back(0);
+    }
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeHeaders(std::span<const uint8_t> b, uint32_t limit,
+                   std::vector<Header> &out, std::string &e) {
+    if (!Bound(b.size(), limit, e)) return false;
+    Reader r(b);
+    uint64_t count;
+    if (!r.Compact(2000, count) || count > r.Left() / 135 ||
+        count * 135 != r.Left())
+        return Fail(e, "headers count/bytes");
+    std::vector<Header> v;
+    for (uint64_t i = 0; i < count; ++i) {
+        Header h;
+        uint64_t zero;
+        if (!r.HeaderValue(h) || !r.Int(1, zero) || zero)
+            return Fail(e, "header/sentinel");
+        v.push_back(h);
+    }
+    out = std::move(v);
+    return Success(e);
+}
+bool EncodeLocator(const Locator &v, uint32_t limit, Bytes &out,
+                   std::string &e) {
+    if (v.ids.size() > 101 ||
+        !Bound(4 + CompactSizeWidth(v.ids.size()) + 32 * v.ids.size() + 32,
+               limit, e))
+        return Fail(e, "locator count/capacity");
+    Bytes b;
+    Put(b, uint32_t(v.version), 4);
+    CS(b, v.ids.size());
+    for (const auto &id : v.ids)
+        HashBytes(b, id);
+    HashBytes(b, v.stop);
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeLocator(std::span<const uint8_t> b, uint32_t limit, Locator &out,
+                   std::string &e) {
+    if (!Bound(b.size(), limit, e)) return false;
+    Reader r(b);
+    uint64_t version, count;
+    if (!r.Int(4, version) || !r.Compact(101, count) || r.Left() < 32 ||
+        count != (r.Left() - 32) / 32 || r.Left() != 32 * (count + 1))
+        return Fail(e, "locator count/bytes");
+    Locator v{};
+    v.version = int32_t(version);
+    for (uint64_t i = 0; i < count; ++i) {
+        Hash h;
+        if (!r.HashValue(h)) return Fail(e, "locator hash");
+        v.ids.push_back(h);
+    }
+    if (!r.HashValue(v.stop)) return Fail(e, "locator stop");
+    out = std::move(v);
+    return Success(e);
+}
+bool EncodeSendCompact(const SendCompact &s, Bytes &out, std::string &e) {
+    Bytes b;
+    Put(b, s.announce, 1);
+    Put(b, s.version, 8);
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeSendCompact(std::span<const uint8_t> b, SendCompact &out,
+                       std::string &e) {
+    if (b.size() != 9 || b[0] > 1) return Fail(e, "sendcmpct shape");
+    out = {b[0] != 0, Get(b.data() + 1, 8)};
+    return Success(e);
+}
+bool DeriveCompactKeys(const Header &h, uint64_t nonce, CompactKeys &out) {
+    std::array<uint8_t, HEADER_SIZE> raw;
+    if (!SerializeHeader(h, raw)) return false;
+    Bytes n;
+    Put(n, nonce, 8);
+    Hash sum;
+    CSHA256()
+        .Write(raw.data(), raw.size())
+        .Write(n.data(), n.size())
+        .Finalize(sum.data());
+    out = {Get(sum.data(), 8), Get(sum.data() + 8, 8)};
+    return true;
+}
+uint64_t ShortId(const CompactKeys &keys, const Hash &h) {
+    return CSipHasher(keys.k0, keys.k1)
+               .Write(Span<const uint8_t>(h.data(), h.size()))
+               .Finalize() &
+           0xffffffffffffULL;
+}
+bool MakeCompact(const FramedBlock &b, const NetworkProfile &p, uint64_t nonce,
+                 std::span<const uint32_t> indices, CompactBlock &out,
+                 std::string &e) {
+    if (b.transactions.size() > UINT32_MAX ||
+        !Indices(indices, uint32_t(b.transactions.size()), e) ||
+        indices[0] != 0)
+        return Fail(e, "compact prefilled selection");
+    CompactBlock c{b.header, nonce, {}, {}};
+    CompactKeys keys;
+    if (!DeriveCompactKeys(c.header, nonce, keys))
+        return Fail(e, "compact header");
+    size_t j = 0;
+    for (size_t i = 0; i < b.transactions.size(); ++i) {
+        if (j < indices.size() && indices[j] == i) {
+            c.prefilled.push_back({uint32_t(i), b.transactions[i]});
+            ++j;
+        } else {
+            IdentityDigests d;
+            if (!ComputeIdentities(b.transactions[i], p.transaction, p.chain_id,
+                                   d, e))
+                return false;
+            c.short_ids.push_back(ShortId(keys, d.txhash));
+        }
+    }
+    uint32_t n;
+    if (!CompactShape(c, p, n, e)) return false;
+    out = std::move(c);
+    return Success(e);
+}
+bool EncodeCompact(const CompactBlock &c, const NetworkProfile &p,
+                   uint32_t limit, Bytes &out, std::string &e) {
+    uint32_t n;
+    if (!Limit(limit) || !CompactShape(c, p, n, e)) return false;
+    if (c.short_ids.size() > (limit / 6)) return Fail(e, "compact capacity");
+    Bytes b;
+    if (!PutHeader(b, c.header)) return Fail(e, "compact header");
+    Put(b, c.nonce, 8);
+    CS(b, c.short_ids.size());
+    for (auto id : c.short_ids)
+        Put(b, id, 6);
+    CS(b, c.prefilled.size());
+    uint64_t next = 0;
+    for (const auto &v : c.prefilled) {
+        CS(b, v.index - next);
+        next = uint64_t(v.index) + 1;
+        if (!PutTx(b, v.transaction, p.transaction, limit, e)) return false;
+    }
+    if (!Bound(b.size(), limit, e)) return false;
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeCompact(std::span<const uint8_t> b, const NetworkProfile &p,
+                   uint32_t limit, CompactBlock &out, std::string &e) {
+    if (!Bound(b.size(), limit, e)) return false;
+    Reader r(b);
+    CompactBlock c{};
+    uint64_t count;
+    if (!r.HeaderValue(c.header) || !r.Int(8, c.nonce) ||
+        !r.Compact(p.max_reconstruction_transactions, count) ||
+        count > r.Left() / 6 || c.header.size < HEADER_SIZE + 4 ||
+        count > (c.header.size - HEADER_SIZE - 4) / 17)
+        return Fail(e, "compact header/short count");
+    for (uint64_t i = 0; i < count; ++i) {
+        uint64_t id;
+        if (!r.Int(6, id)) return Fail(e, "short ID");
+        c.short_ids.push_back(id);
+    }
+    uint64_t prefilled;
+    if (!r.Compact(p.max_reconstruction_transactions, prefilled) ||
+        !prefilled || prefilled > r.Left() / 18 ||
+        count + prefilled > UINT32_MAX ||
+        count + prefilled > p.max_reconstruction_transactions ||
+        c.header.size < HEADER_SIZE + 4 ||
+        (count + prefilled) > (c.header.size - HEADER_SIZE - 4) / 17)
+        return Fail(e, "prefilled count/size");
+    uint64_t next = 0;
+    for (uint64_t i = 0; i < prefilled; ++i) {
+        Prefilled v{};
+        if (!Delta(r, next, uint32_t(count + prefilled), v.index) ||
+            !r.Tx(p.transaction, v.transaction))
+            return Fail(e, "prefilled index/transaction");
+        c.prefilled.push_back(std::move(v));
+    }
+    uint32_t n;
+    if (r.Left() || !CompactShape(c, p, n, e))
+        return Fail(e, "compact shape/trailing");
+    out = std::move(c);
+    return Success(e);
+}
+bool EncodeMissingRequest(const MissingRequest &q, uint32_t total,
+                          uint32_t limit, Bytes &out, std::string &e) {
+    if (!Indices(q.indices, total, e)) return false;
+    Bytes b;
+    HashBytes(b, q.block_id);
+    CS(b, q.indices.size());
+    uint64_t next = 0;
+    for (auto idx : q.indices) {
+        CS(b, idx - next);
+        next = uint64_t(idx) + 1;
+    }
+    if (!Bound(b.size(), limit, e)) return false;
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeMissingRequest(std::span<const uint8_t> b, uint32_t total,
+                          uint32_t max_count, uint32_t limit,
+                          MissingRequest &out, std::string &e) {
+    if (!Bound(b.size(), limit, e)) return false;
+    Reader r(b);
+    MissingRequest q;
+    uint64_t count;
+    if (!r.HashValue(q.block_id) ||
+        !r.Compact(std::min(total, max_count), count) || !count ||
+        count > r.Left())
+        return Fail(e, "missing request count");
+    uint64_t next = 0;
+    for (uint64_t i = 0; i < count; ++i) {
+        uint32_t idx;
+        if (!Delta(r, next, total, idx))
+            return Fail(e, "missing request delta");
+        q.indices.push_back(idx);
+    }
+    if (r.Left()) return Fail(e, "missing request trailing");
+    out = std::move(q);
+    return Success(e);
+}
+bool EncodeMissingResponse(const MissingResponse &q, const NetworkProfile &p,
+                           uint32_t limit, Bytes &out, std::string &e) {
+    if (q.transactions.empty() ||
+        q.transactions.size() > p.max_reconstruction_transactions)
+        return Fail(e, "missing response count");
+    Bytes b;
+    HashBytes(b, q.block_id);
+    CS(b, q.transactions.size());
+    for (const auto &tx : q.transactions)
+        if (!PutTx(b, tx, p.transaction, limit, e)) return false;
+    if (!Bound(b.size(), limit, e)) return false;
+    out = std::move(b);
+    return Success(e);
+}
+bool DecodeMissingResponse(std::span<const uint8_t> b, const NetworkProfile &p,
+                           uint32_t max_count, uint32_t limit,
+                           MissingResponse &out, std::string &e) {
+    if (!Bound(b.size(), limit, e)) return false;
+    Reader r(b);
+    MissingResponse q;
+    uint64_t count;
+    if (!r.HashValue(q.block_id) ||
+        !r.Compact(std::min(max_count, p.max_reconstruction_transactions),
+                   count) ||
+        !count || count > r.Left() / 17)
+        return Fail(e, "missing response count");
+    for (uint64_t i = 0; i < count; ++i) {
+        Transaction tx;
+        if (!r.Tx(p.transaction, tx))
+            return Fail(e, "missing response transaction");
+        q.transactions.push_back(std::move(tx));
+    }
+    if (r.Left()) return Fail(e, "missing response trailing");
+    out = std::move(q);
+    return Success(e);
+}
+std::optional<Hash> UniqueCandidate(std::span<const Hash> v) {
+    if (v.empty()) return std::nullopt;
+    for (const auto &h : v)
+        if (h != v[0]) return std::nullopt;
+    return v[0];
+}
+CompactReconstruction::CompactReconstruction(const NetworkProfile &p)
+    : profile_(p) {}
+void CompactReconstruction::Cancel() {
+    outstanding_ = false;
+    request_ = {};
+    slots_.clear();
+    expected_short_ids_.clear();
+    complete_.reset();
+    compact_ = {};
+    retained_wire_bytes_ = HEADER_SIZE + 4;
+}
+ReconstructionStatus CompactReconstruction::Start(
+    const CompactBlock &c, std::span<const Transaction> cache, std::string &e) {
+    Cancel();
+    uint32_t n;
+    if (c.header.size > profile_.max_reconstruction_bytes ||
+        uint64_t(c.short_ids.size()) + c.prefilled.size() >
+            profile_.max_reconstruction_transactions) {
+        e = "reconstruction byte quota";
+        return ReconstructionStatus::NeedFullBlock;
+    }
+    if (!CompactShape(c, profile_, n, e) ||
+        !DeriveCompactKeys(c.header, c.nonce, keys_))
+        return ReconstructionStatus::InvalidPeerMessage;
+    std::set<uint64_t> seen;
+    for (auto id : c.short_ids)
+        if (!seen.insert(id).second) {
+            e = "duplicate compact short ID";
+            return ReconstructionStatus::NeedFullBlock;
+        }
+    compact_ = c;
+    if (!BlockId(profile_.chain_id, c.header, request_.block_id)) {
+        e = "compact block identity";
+        return ReconstructionStatus::InvalidPeerMessage;
+    }
+    // Local quota bounds slots independent of a peer's claimed block size.
+    slots_.resize(n);
+    expected_short_ids_.resize(n);
+    for (const auto &v : c.prefilled) {
+        Bytes raw;
+        if (!EncodeTransaction(v.transaction, profile_.transaction, raw, e)) {
+            Cancel();
+            return ReconstructionStatus::InvalidPeerMessage;
+        }
+        if (!Store(v.index, v.transaction, e)) {
+            Cancel();
+            return ReconstructionStatus::NeedFullBlock;
+        }
+    }
+    std::map<uint64_t, std::map<Hash, const Transaction *>> matches;
+    // Cache is trusted local input. Store only candidates needed by this block.
+    for (const auto &tx : cache) {
+        IdentityDigests d;
+        if (!ComputeIdentities(tx, profile_.transaction, profile_.chain_id, d,
+                               e)) {
+            Cancel();
+            return ReconstructionStatus::NeedFullBlock;
+        }
+        uint64_t id = ShortId(keys_, d.txhash);
+        if (seen.count(id)) {
+            auto &bucket = matches[id];
+            // Two distinct full hashes suffice to prove ambiguity; never retain
+            // an unbounded number of variants for a colliding short ID.
+            if (bucket.size() < 2) bucket.emplace(d.txhash, &tx);
+        }
+    }
+    size_t j = 0;
+    for (uint32_t i = 0; i < n; ++i)
+        if (!slots_[i]) {
+            uint64_t id = c.short_ids[j++];
+            expected_short_ids_[i] = id;
+            auto found = matches.find(id);
+            std::vector<Hash> hashes;
+            if (found != matches.end())
+                for (const auto &entry : found->second)
+                    hashes.push_back(entry.first);
+            auto unique = UniqueCandidate(hashes);
+            if (unique) {
+                if (!Store(i, *found->second.at(*unique), e)) {
+                    Cancel();
+                    return ReconstructionStatus::NeedFullBlock;
+                }
+            } else
+                request_.indices.push_back(i);
+        }
+    if (!request_.indices.empty()) {
+        outstanding_ = true;
+        e.clear();
+        return ReconstructionStatus::NeedTransactions;
+    }
+    return Finish(e);
+}
+ReconstructionStatus CompactReconstruction::Apply(const MissingResponse &q,
+                                                  std::string &e) {
+    if (!outstanding_ || q.block_id != request_.block_id) {
+        // A late response must not mutate a different active reconstruction.
+        e = "unsolicited/mismatched missing response";
+        return ReconstructionStatus::InvalidPeerMessage;
+    }
+    if (q.transactions.size() != request_.indices.size()) {
+        e = "missing response count";
+        Cancel();
+        return ReconstructionStatus::InvalidPeerMessage;
+    }
+    // Clear the outstanding request on every response, including failures.
+    outstanding_ = false;
+    for (size_t i = 0; i < q.transactions.size(); ++i) {
+        IdentityDigests d;
+        uint32_t idx = request_.indices[i];
+        if (!ComputeIdentities(q.transactions[i], profile_.transaction,
+                               profile_.chain_id, d, e) ||
+            !expected_short_ids_[idx] ||
+            ShortId(keys_, d.txhash) != *expected_short_ids_[idx]) {
+            e = "missing response short ID/transaction";
+            Cancel();
+            return ReconstructionStatus::InvalidPeerMessage;
+        }
+        if (!Store(idx, q.transactions[i], e)) {
+            Cancel();
+            return ReconstructionStatus::NeedFullBlock;
+        }
+    }
+    request_.indices.clear();
+    return Finish(e);
+}
+bool CompactReconstruction::Store(uint32_t index, const Transaction &tx,
+                                  std::string &e) {
+    Bytes raw;
+    if (!EncodeTransaction(tx, profile_.transaction, raw, e)) return false;
+    if (retained_wire_bytes_ > profile_.max_reconstruction_bytes ||
+        raw.size() > profile_.max_reconstruction_bytes - retained_wire_bytes_ ||
+        CompactSizeWidth(raw.size()) > profile_.max_reconstruction_bytes -
+                                           retained_wire_bytes_ - raw.size())
+        return Fail(e, "reconstruction byte quota");
+    retained_wire_bytes_ += raw.size() + CompactSizeWidth(raw.size());
+    slots_[index] = tx;
+    return true;
+}
+ReconstructionStatus CompactReconstruction::Finish(std::string &e) {
+    std::vector<Transaction> txs;
+    txs.reserve(slots_.size());
+    for (auto &v : slots_) {
+        if (!v) {
+            e = "incomplete reconstruction";
+            Cancel();
+            return ReconstructionStatus::NeedFullBlock;
+        }
+        txs.push_back(std::move(*v));
+    }
+    uint64_t total = HEADER_SIZE + 4;
+    for (const auto &tx : txs) {
+        Bytes raw;
+        if (!EncodeTransaction(tx, profile_.transaction, raw, e) ||
+            total > profile_.max_reconstruction_bytes ||
+            raw.size() > profile_.max_reconstruction_bytes - total ||
+            CompactSizeWidth(raw.size()) >
+                profile_.max_reconstruction_bytes - total - raw.size()) {
+            e = "reconstruction byte quota";
+            Cancel();
+            return ReconstructionStatus::NeedFullBlock;
+        }
+        total += raw.size() + CompactSizeWidth(raw.size());
+    }
+    Hash root;
+    Bytes wire;
+    FramedBlock complete;
+    // Root, duplicate core identities and exact complete size are checked
+    // before handing bytes to the common contextual consensus validator.
+    if (!CompleteTransactionRoot(txs, profile_.transaction, profile_.chain_id,
+                                 root, e) ||
+        root != compact_.header.tx_root ||
+        !EncodeBlockWire(compact_.header, txs, profile_.transaction, wire, e) ||
+        !DecodeBlockWire(wire, profile_.transaction, profile_.chain_id,
+                         complete, e)) {
+        if (e.empty()) e = "compact transaction root/size mismatch";
+        Cancel();
+        return ReconstructionStatus::NeedFullBlock;
+    }
+    complete_ = std::move(complete);
+    slots_.clear();
+    expected_short_ids_.clear();
+    request_.indices.clear();
+    e.clear();
+    return ReconstructionStatus::CompleteUnvalidated;
+}
+bool CompactReconstruction::TakeComplete(FramedBlock &out) {
+    if (!complete_) return false;
+    out = std::move(*complete_);
+    complete_.reset();
+    return true;
+}
+} // namespace lotus::v2::peer
