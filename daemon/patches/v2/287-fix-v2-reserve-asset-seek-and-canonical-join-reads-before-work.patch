From 94f73c2e22618c7c50f2f8980e29037c45d1a123 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:14:08 -0700
Subject: [PATCH] fix(v2): reserve asset seek and canonical join reads before
 work

---
 chronik/chronik-http/src/v2_explorer.rs | 44 ++++++++++++++++++-------
 1 file changed, 32 insertions(+), 12 deletions(-)

diff --git a/chronik/chronik-http/src/v2_explorer.rs b/chronik/chronik-http/src/v2_explorer.rs
index ac9fa38d7caa943065cf74f99fe19fc845a969a5..c21445e1c2adddb27af85fc8245e339097e2cd44 100644
--- a/chronik/chronik-http/src/v2_explorer.rs
+++ b/chronik/chronik-http/src/v2_explorer.rs
@@ -608,6 +608,7 @@ fn dispatch(
     if !body.is_empty() {
         return Err(invalid());
     }
+    let mut asset_budget = chronik_db::v2_asset::AssetReadBudget::new(4096);
     let p = path
         .split('/')
         .filter(|p| !p.is_empty())
@@ -811,10 +812,12 @@ fn dispatch(
             let mut page = Page::new();
             let mut after = r.last.clone();
             validate_asset_key(after.as_deref(), b"eA", None, 34)?;
-            while page.items.len() < r.page {
+            while page.items.len() < r.page && asset_budget.remaining() >= 3 {
                 page.read()?;
-                let Some((key, a)) =
-                    db(v.next_asset_summary(after.as_deref()))?
+                let Some((key, a)) = db(v.next_asset_summary_counted(
+                    after.as_deref(),
+                    &mut asset_budget,
+                ))?
                 else {
                     page.exhausted = true;
                     break;
@@ -827,18 +830,23 @@ fn dispatch(
             page.finish(&r, c)
         }
         ["assets", id] => Ok(asset_summary(
-            &db(v.asset_summary(hash(id)?))?.ok_or_else(missing)?,
+            &db(v.asset_summary_counted(hash(id)?, &mut asset_budget))?
+                .ok_or_else(missing)?,
         )),
         ["assets", id, "events"] => {
             let id = hash(id)?;
-            db(v.asset_summary(id))?.ok_or_else(missing)?;
+            db(v.asset_summary_counted(id, &mut asset_budget))?
+                .ok_or_else(missing)?;
             let mut page = Page::new();
             let mut after = r.last.clone();
             validate_asset_key(after.as_deref(), b"eE", Some(id), 46)?;
-            while page.items.len() < r.page {
+            while page.items.len() < r.page && asset_budget.remaining() >= 3 {
                 page.read()?;
-                let Some((key, a)) =
-                    db(v.next_asset_event(id, after.as_deref()))?
+                let Some((key, a)) = db(v.next_asset_event_counted(
+                    id,
+                    after.as_deref(),
+                    &mut asset_budget,
+                ))?
                 else {
                     page.exhausted = true;
                     break;
@@ -852,7 +860,8 @@ fn dispatch(
         }
         ["assets", id, "outputs"] => {
             let id = hash(id)?;
-            db(v.asset_summary(id))?.ok_or_else(missing)?;
+            db(v.asset_summary_counted(id, &mut asset_budget))?
+                .ok_or_else(missing)?;
             let view = r
                 .params
                 .get("view")
@@ -864,15 +873,26 @@ fn dispatch(
             let mut page = Page::new();
             let mut after = r.last.clone();
             validate_asset_key(after.as_deref(), b"eP", Some(id), 50)?;
-            while page.items.len() < r.page && page.examined < 1024 {
+            while page.items.len() < r.page
+                && page.examined < 1024
+                && asset_budget.remaining() >= 5
+            {
                 page.read()?;
-                let Some((key, op)) =
-                    db(v.next_asset_output(id, after.as_deref()))?
+                let Some((key, op)) = db(v.next_asset_output_counted(
+                    id,
+                    after.as_deref(),
+                    &mut asset_budget,
+                ))?
                 else {
                     page.exhausted = true;
                     break;
                 };
                 page.read()?;
+                // Reserve the output plus both possible canonical location
+                // joins before ReadSnapshot::output performs any of them.
+                for _ in 0..3 {
+                    db(asset_budget.charge())?;
+                }
                 let out = db(v.output(op))?.ok_or_else(unavailable)?;
                 if out.outpoint != op
                     || out.creation.txid != op.txid
-- 
