From 273c60d6d60c01a9431522c5c0cd0aac5c4a845e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:00:22 -0700
Subject: [PATCH] Expose bounded obsolete proof pruning before replacement
 reconciliation

---
 src/lotus_v2/avalanche_poll.cpp    |  5 ++++-
 src/lotus_v2/avalanche_poll.h      |  3 +++
 src/lotus_v2/test_avalanche_v2.cpp | 10 ++++++++++
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/avalanche_poll.cpp b/src/lotus_v2/avalanche_poll.cpp
index d6f2ff620d79cdd77822fc8084816cf327393d40..b0a3c521565a97b5209861a22791322b24819799 100644
--- a/src/lotus_v2/avalanche_poll.cpp
+++ b/src/lotus_v2/avalanche_poll.cpp
@@ -36,11 +36,14 @@ bool PollEngine::Reconcile(const PollItem &item,bool accepted,std::string &error
     if(impl_->records.size()>=impl_->profile.max_queries) return Fail(error,"vote-record-capacity");
     impl_->records.try_emplace(item,accepted); return true;
 }
-bool PollEngine::Next(Quorum &quorum,const ChainSnapshot &snapshot,int64_t now,OutgoingPoll &out,std::string &error) {
+void PollEngine::PruneProofs(const Quorum &quorum) {
     for(auto it=impl_->records.begin();it!=impl_->records.end();) {
         if(it->first.kind==ItemKind::Proof && !quorum.Pollable(::avalanche::ProofId(Native(it->first.id))) && !quorum.Immature(::avalanche::ProofId(Native(it->first.id)))) it=impl_->records.erase(it);
         else ++it;
     }
+}
+bool PollEngine::Next(Quorum &quorum,const ChainSnapshot &snapshot,int64_t now,OutgoingPoll &out,std::string &error) {
+    PruneProofs(quorum);
     if(!quorum.Established(snapshot)) return Fail(error,"quorum-not-established");
     for(auto it=impl_->queries.begin();it!=impl_->queries.end();) {
         if(it->second.timeout<now) { impl_->Release(it->second); it=impl_->queries.erase(it); } else ++it;
diff --git a/src/lotus_v2/avalanche_poll.h b/src/lotus_v2/avalanche_poll.h
index 76fcc94a4bcccd1e9e91c67d2933c6abdfde447b..1f417e8c6d7920ef9ba5ee6eede3ab1064afd611 100644
--- a/src/lotus_v2/avalanche_poll.h
+++ b/src/lotus_v2/avalanche_poll.h
@@ -13,6 +13,9 @@ public:
     explicit PollEngine(Profile);
     ~PollEngine();
     bool Reconcile(const PollItem &, bool accepted, std::string &);
+    // Remove obsolete proof records before admitting replacement inventory.
+    // Work is bounded by max_queries; other vote histories remain intact.
+    void PruneProofs(const Quorum &);
     bool Next(Quorum &, const ChainSnapshot &, int64_t now_milliseconds,
               OutgoingPoll &, std::string &);
     // Query deadlines use monotonic milliseconds; proof replacement times use
diff --git a/src/lotus_v2/test_avalanche_v2.cpp b/src/lotus_v2/test_avalanche_v2.cpp
index f858f05d02cf21b738c33e308f8a89f53d2700d3..f9191d93cfaaa4acdb77ceafeeb26a8887f17382 100644
--- a/src/lotus_v2/test_avalanche_v2.cpp
+++ b/src/lotus_v2/test_avalanche_v2.cpp
@@ -75,10 +75,19 @@ int main() {
   // unrelated block work in the same atomic callback must still commit.
   std::vector<std::pair<::avalanche::ProofId,Status>> conflicting_batch{
    {replacement.proof->getId(),Status::Rejected},{envelope.proof->getId(),Status::Accepted}};
+  auto one_record_profile=profile; one_record_profile.max_queries=1;
+  PollEngine replacement_records(one_record_profile);
+  PollItem old_record{ItemKind::Proof,{}}; std::copy(envelope.proof->getId().begin(),envelope.proof->getId().end(),old_record.id.begin());
+  PollItem new_record{ItemKind::Proof,{}}; std::copy(replacement.proof->getId().begin(),replacement.proof->getId().end(),new_record.id.begin());
+  CHECK(replacement_records.Reconcile(old_record,false,error));
   size_t block_batch_commits=0;
   CHECK(cooldown.ApplyProofVotes(conflicting_batch,100000,[&](std::string &){++block_batch_commits;return true;},error));
   CHECK(block_batch_commits==1); CHECK(cooldown.Vote(replacement.proof->getId())==3);
   CHECK(cooldown.Vote(envelope.proof->getId())==uint32_t(-1));
+  CHECK(cooldown.ApplyProofVote(replacement.proof->getId(),Status::Accepted,100001,error));
+  CHECK(!replacement_records.Reconcile(new_record,true,error)); CHECK(error=="vote-record-capacity");
+  replacement_records.PruneProofs(cooldown);
+  CHECK(replacement_records.Reconcile(new_record,true,error));
   snapshot.height=3000;
   auto bad_profile=profile; bad_profile.min_quorum_stake=MAX_MONEY+SATOSHI;
   bool invalid_constructor=false; try { Quorum invalid(bad_profile); } catch(const std::invalid_argument &) { invalid_constructor=true; } CHECK(invalid_constructor);
@@ -112,6 +121,7 @@ int main() {
    if(update.status==Status::Finalized) ++finalized; } return true;
   };
   for(int64_t now=1000;now<1000000 && (finalized==0 || !quorum.ExportPeers().front().finalized);now+=101) {
+   engine.PruneProofs(quorum); // Repeated proof cleanup preserves the block confidence.
    if(!engine.Next(quorum,snapshot,now,poll,error)) continue;
    CHECK(engine.Respond(poll,observe,quorum,key,response,error));
    CHECK(engine.Receive(quorum,poll.node,response,snapshot,now+1,wall_seconds,finalize,error));
-- 
