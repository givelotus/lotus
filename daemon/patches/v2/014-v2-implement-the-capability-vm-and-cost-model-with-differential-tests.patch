+        if (key.size() != 33 || (key[0] != 0x02 && key[0] != 0x03) ||
+            !secp256k1_ec_pubkey_parse(secp256k1_context_static, &parsed,
+                                       key.data(), key.size()))
+            throw VmFailure("CHECKDATASIG secp256k1 key encoding");
+        if (signature.empty()) return false;
+        if (signature.size() != 64)
