+            VM_TEST_CRYPTO_FAIL(P256Verify)
+                ? -1
+                : EVP_PKEY_verify(verify.get(), der.data(), der.size(),
+                                  message.data(), message.size());
+        if (verified < 0)
+            throw VmFailure("CHECKDATASIG P-256 verification failed",
+                            VmStatus::OperationalError);
+        return verified == 1;
+    }
