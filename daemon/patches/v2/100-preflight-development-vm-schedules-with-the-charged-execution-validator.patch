From 57aab913f9b744545b79f817048685fd3357088d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:50:57 -0700
Subject: [PATCH] Preflight development VM schedules with the charged execution
 validator

Expose the existing cost-profile checker for initialization so zero structural/assigned costs and invalid field hints fail before opening LevelDB. Reuse exactly the execution checks rather than maintaining a second opcode registry. No cost values or consensus acceptance rules change.
---
 src/lotus_v2/development_chain.cpp | 1 +
 src/lotus_v2/vm.cpp                | 5 +++++
 src/lotus_v2/vm.h                  | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/src/lotus_v2/development_chain.cpp b/src/lotus_v2/development_chain.cpp
index 88a620971f84671d265ebb438194692a5050477d..9d523d2ae85c8a9b6ef2309d666d4d2990e1cd0b 100644
--- a/src/lotus_v2/development_chain.cpp
+++ b/src/lotus_v2/development_chain.cpp
@@ -49,6 +49,7 @@ bool OpenDevelopmentChain(
                 vm.max_element_bytes <= VM_HARD_ELEMENT_BYTES && vm.max_stack_items &&
                 vm.max_altstack_items && vm.max_vm_bytes && vm.max_ast_depth && vm.max_steps,
                 "VM profile limits");
+        if (!ValidateVmCostProfile(vm, op.vm_cost, error)) return false;
         // Validate the schedule without charging genesis or advancing issuance.
         (void)AuthenticatedEnvelopeCost(0, 1, cp);
         FramedBlock genesis;
diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
index 2477251bc5cb89d0b571e0607603557988681bc1..bb6873a169f18f9c4d76e72de12f8995e7a8bc32 100644
--- a/src/lotus_v2/vm.cpp
+++ b/src/lotus_v2/vm.cpp
@@ -1542,6 +1542,11 @@ namespace {
     };
 #include "vm_cost.inc"
 } // namespace
+bool ValidateVmCostProfile(const VmProfile &vm, const VmCostProfile &cost, std::string &error) {
+    try { CheckCostProfile(cost, vm); error.clear(); return true; }
+    catch (const std::exception &e) { error = e.what(); return false; }
+}
+
 
 #ifdef LOTUS_V2_VM_TEST_INSTRUMENTATION
 namespace { VmPreparationCounts preparation_counts; }
diff --git a/src/lotus_v2/vm.h b/src/lotus_v2/vm.h
index fd4ccd937a6514472463ae842075f6aae32c4e21..d2b68a5e17d0459b7222bd5dcf508144d8464918 100644
--- a/src/lotus_v2/vm.h
+++ b/src/lotus_v2/vm.h
@@ -69,6 +69,9 @@ struct VmCostProfile {
     // MAX_ELEMENT_BYTES.
     std::map<uint8_t, std::vector<size_t>> field_sizes;
 };
+// Same schedule checks used by charged execution; useful for rejecting a local
+// configuration before opening chainstate. Does not execute a program.
+bool ValidateVmCostProfile(const VmProfile &, const VmCostProfile &, std::string &);
 // Owns an immutable transaction/coin/cost snapshot, prepared once before all
 // invocations. Contexts must refer to this snapshot's exact objects; a cache
 // from another transaction or mutable caller objects is never trusted.
-- 
