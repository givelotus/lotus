From 5e4558817a04f2c42a3ea9dbff8e7b933957a268 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:01:08 -0700
Subject: [PATCH] Prune displaced proof records and defer live poll capacity
 pressure

---
 src/lotus_v2/avalanche_driver.cpp            | 16 +++++++++++++---
 src/lotus_v2/avalanche_driver.h              |  2 +-
 src/lotus_v2/avalanche_driver_test/README.md |  6 +++++-
 3 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/src/lotus_v2/avalanche_driver.cpp b/src/lotus_v2/avalanche_driver.cpp
index 9704d5e5c9f0493a9befdf73453ff23441a904d1..a72d8d36e84eaf7f4f4d0b12a001e6154b734f5d 100644
--- a/src/lotus_v2/avalanche_driver.cpp
+++ b/src/lotus_v2/avalanche_driver.cpp
@@ -80,10 +80,19 @@ bool AvalancheDriver::Register(const ProofEnvelope &p, std::string &e) {
     e.clear(); return true;
 }
 bool AvalancheDriver::ReconcileProofs(std::string &e) {
+    // Evicted/revalidated proofs must release their vote-record capacity before
+    // enrolling replacements. Pruning preserves retained records' confidence.
+    polls_.PruneProofs(quorum_);
+    proof_reconcile_pending_=false;
     for(const auto &id:quorum_.Proofs()) {
         if(!quorum_.Pollable(id))continue;
         Hash hash{};std::copy(id.begin(),id.end(),hash.begin());
-        if(!polls_.Reconcile({ItemKind::Proof,hash},quorum_.Vote(id)==0,e))return false;
+        if(!polls_.Reconcile({ItemKind::Proof,hash},quorum_.Vote(id)==0,e)) {
+            if(e!="vote-record-capacity")return false;
+            // Admission remains valid. Existing votes must continue to drain,
+            // and the bounded quorum itself retains the pending proof ids.
+            proof_reconcile_pending_=true;e.clear();return true;
+        }
     }
     return true;
 }
@@ -149,6 +158,7 @@ DriverResult AvalancheDriver::Tick(bool ibd,int64_t ms,int64_t wall) {
     now_ms_=ms;wall_seconds_=wall;initial_download_=ibd;
     ChainSnapshot s;std::string e;if(!Snapshot(s,e))return Error(DriverCode::NotReady,e);
     if(!Refresh(s,e))return Error(DriverCode::NotReady,e);
+    if(!ReconcileProofs(e))return Error(DriverCode::ProtocolFailure,e);
     for(auto &[id,due]:discovery_due_) {
         const auto now=static_cast<uint64_t>(ms);
         if(now<due)continue;
@@ -160,7 +170,7 @@ DriverResult AvalancheDriver::Tick(bool ibd,int64_t ms,int64_t wall) {
         if(r==PeerResult::LocalFailure || r==PeerResult::Rejected)return Error(DriverCode::ProtocolFailure,e);
     }
     peer_.Tick(static_cast<uint64_t>(ms));peer_.Pump(static_cast<uint64_t>(ms));
-    if(s.initial_download)return {};
+    if(s.initial_download)return proof_reconcile_pending_?Error(DriverCode::Backpressure,"proof-vote-record-capacity"):DriverResult{};
     if(!pending_poll_) {OutgoingPoll p;if(polls_.Next(quorum_,s,ms,p,e))pending_poll_=std::move(p);}
     if(pending_poll_) {
         auto r=peer_.Poll(*pending_poll_,e);
@@ -168,7 +178,7 @@ DriverResult AvalancheDriver::Tick(bool ibd,int64_t ms,int64_t wall) {
         if(r!=PeerResult::Accepted)return Error(DriverCode::ProtocolFailure,e);
         pending_poll_.reset();
     }
-    peer_.Pump(static_cast<uint64_t>(ms));return {};
+    peer_.Pump(static_cast<uint64_t>(ms));return proof_reconcile_pending_?Error(DriverCode::Backpressure,"proof-vote-record-capacity"):DriverResult{};
 }
 PeerResult AvalancheDriver::Activate(peer::ConnectionId id,std::string &e) {
     if(!Ready()){e="driver-not-started";return PeerResult::LocalFailure;}
diff --git a/src/lotus_v2/avalanche_driver.h b/src/lotus_v2/avalanche_driver.h
index 58a83c451607f5e8916e73cfb4ad233e0d1f05c3..e7c3e4f798852ae7ee42c68c68d2d5b0f5d07c9b 100644
--- a/src/lotus_v2/avalanche_driver.h
+++ b/src/lotus_v2/avalanche_driver.h
@@ -50,7 +50,7 @@ private:
     PollEngine polls_;
     PeerStore store_;
     AvalanchePeer peer_;
-    bool initial_download_{true}, started_{}, failed_{};
+    bool initial_download_{true}, started_{}, failed_{}, proof_reconcile_pending_{};
     int64_t now_ms_{}, wall_seconds_{};
     std::optional<ChainSnapshot> validated_;
     std::optional<OutgoingPoll> pending_poll_;
diff --git a/src/lotus_v2/avalanche_driver_test/README.md b/src/lotus_v2/avalanche_driver_test/README.md
index f59fa068de2907e84fac660140441c6747f786d6..5745f3457bddf262ba037a322158797b9efe9b49 100644
--- a/src/lotus_v2/avalanche_driver_test/README.md
+++ b/src/lotus_v2/avalanche_driver_test/README.md
@@ -26,7 +26,11 @@ indexed ancestors for median time, and fence tip/context generation/revision.
 Real tip/context changes revalidate all quorum proofs before application input,
 polling, or persistence. Pollable proofs automatically enter polling at admission, restoration, and
 revalidation; initial acceptance comes from the current quorum vote. Existing
-records retain their accumulated vote confidence. Each block status maps by name to the runtime enum.
+records retain their accumulated vote confidence. Obsolete proof records are
+pruned before enrollment, including after replacement. If live block/proof records
+fill the configured capacity, admission remains valid, existing polls continue,
+and Tick reports Backpressure while retrying pending proof enrollment. Each block
+status maps by name to the runtime enum.
 The runtime still atomically checks every update tip/generation. Restore screens
 records against actual native coins, skips stale records individually, then uses
 Quorum's validated atomic restore to retain registered metadata. Store framing,
-- 
