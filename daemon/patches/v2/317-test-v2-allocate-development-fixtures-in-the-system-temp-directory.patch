From cd8d5140ec7fce7da9a4e2a5a8b5d803ed4dc3f5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 18:56:24 -0700
Subject: [PATCH] test(v2): allocate development fixtures in the system temp
 directory

Replace macOS-only /private/tmp templates in initializer, reorganization and shared runtime fixtures with canonical filesystem temporary-directory paths. Keep mkdtemp exclusive directory creation and existing cleanup behavior.

Focused initializer, recovery and runtime suites pass on macOS arm64, including runtime with an explicit TMPDIR override. Linux execution remains untested; the hardcoded missing-directory failure is removed.
---
 src/lotus_v2/development_runtime_test/fixtures.h | 5 +++--
 src/lotus_v2/test_development_chain.cpp          | 5 +++--
 src/lotus_v2/test_reorg_recovery.cpp             | 5 +++--
 3 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/src/lotus_v2/development_runtime_test/fixtures.h b/src/lotus_v2/development_runtime_test/fixtures.h
index 86becde0278b92d041faddd5d15da11f1de10575..076220d7276f8e72b9737bd4575e840d2aa4d5a0 100644
--- a/src/lotus_v2/development_runtime_test/fixtures.h
+++ b/src/lotus_v2/development_runtime_test/fixtures.h
@@ -524,8 +524,9 @@ struct Home {
                   leveldb::Env *storage_env = nullptr)
         : p(std::move(profiles)), journal_cap(cap), candidates(candidate_mode),
           env(storage_env) {
-        char name[] = "/private/tmp/lotus-v2-real-reorg-XXXXXX";
-        Check(mkdtemp(name) != nullptr, "temporary home");
+        auto name = (std::filesystem::canonical(std::filesystem::temp_directory_path()) /
+                     "lotus-v2-real-reorg-XXXXXX").string();
+        Check(mkdtemp(name.data()) != nullptr, "temporary home");
         path = name;
         Open();
     }
diff --git a/src/lotus_v2/test_development_chain.cpp b/src/lotus_v2/test_development_chain.cpp
index b8ca17852e09321f490a42c16c5ec60b8a1eebf6..639be5238dd202cad70529b5a13020b54a441521 100644
--- a/src/lotus_v2/test_development_chain.cpp
+++ b/src/lotus_v2/test_development_chain.cpp
@@ -16,8 +16,9 @@ void Check(bool value, const std::string &why) {
     if (!value) throw std::runtime_error(why);
 }
 std::string FreshPath() {
-    char pattern[] = "/private/tmp/lotus-v2-initializer-XXXXXX";
-    Check(mkdtemp(pattern) != nullptr, "temporary path");
+    auto pattern = (std::filesystem::canonical(std::filesystem::temp_directory_path()) /
+                    "lotus-v2-initializer-XXXXXX").string();
+    Check(mkdtemp(pattern.data()) != nullptr, "temporary path");
     std::filesystem::remove_all(pattern);
     return pattern;
 }
diff --git a/src/lotus_v2/test_reorg_recovery.cpp b/src/lotus_v2/test_reorg_recovery.cpp
index 98cee2dd16f25092cbdba490af1671cd9df7c72c..8997c037c7301c6a7510db997d58fb9d2546e341 100644
--- a/src/lotus_v2/test_reorg_recovery.cpp
+++ b/src/lotus_v2/test_reorg_recovery.cpp
@@ -575,8 +575,9 @@ struct Home {
     explicit Home(uint64_t cap = 32 << 20, ReorgProfiles profiles = Profiles(),
                   bool candidate_mode = false)
         : p(std::move(profiles)), journal_cap(cap), candidates(candidate_mode) {
-        char name[] = "/private/tmp/lotus-v2-real-reorg-XXXXXX";
-        Check(mkdtemp(name) != nullptr, "temporary home");
+        auto name = (std::filesystem::canonical(std::filesystem::temp_directory_path()) /
+                     "lotus-v2-real-reorg-XXXXXX").string();
+        Check(mkdtemp(name.data()) != nullptr, "temporary home");
         path = name;
         Open();
     }
-- 
