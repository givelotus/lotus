From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 23:18:49 -0700
Subject: Link field-size derivation into the ordinary block harness.

The script-rollback merge built both block tests without field_size.cpp, which vm.cpp now requires.
---
 src/lotus_v2/block_test/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/block_test/CMakeLists.txt b/src/lotus_v2/block_test/CMakeLists.txt
index df0e5daed..c69889e67 100644
--- a/src/lotus_v2/block_test/CMakeLists.txt
+++ b/src/lotus_v2/block_test/CMakeLists.txt
@@ -20,7 +20,7 @@ target_compile_definitions(lotus_v2_block_blake3 PRIVATE
     BLAKE3_NO_SSE2 BLAKE3_NO_SSE41 BLAKE3_NO_AVX2 BLAKE3_NO_AVX512 BLAKE3_USE_NEON=0)
 add_executable(lotus_v2_block_test
     ../output.cpp ../transaction.cpp ../commitment.cpp ../tagged_hash.cpp
-    ../signing.cpp ../vm.cpp ../sparse_state.cpp ../incremental_utxo.cpp
+    ../signing.cpp ../vm.cpp ../field_size.cpp ../sparse_state.cpp ../incremental_utxo.cpp
     ../ordinary_validation.cpp ../monetary.cpp ../block.cpp ../test_block.cpp)
 target_include_directories(lotus_v2_block_test PRIVATE
     "${LOTUS_SRC}/secp256k1/include" "${LOTUS_BOOST_INCLUDE}" ../vendor/blake3)
@@ -30,7 +30,7 @@ target_compile_options(lotus_v2_block_test PRIVATE
     $<$<COMPILE_LANGUAGE:CXX>:-Wall;-Wextra;-Wpedantic;-Werror>)
 add_executable(lotus_v2_block_script_rollback_test
     ../output.cpp ../transaction.cpp ../commitment.cpp ../tagged_hash.cpp
-    ../signing.cpp ../vm.cpp ../sparse_state.cpp ../incremental_utxo.cpp
+    ../signing.cpp ../vm.cpp ../field_size.cpp ../sparse_state.cpp ../incremental_utxo.cpp
     ../ordinary_validation.cpp ../monetary.cpp ../block.cpp
     ../test_block_script_rollback.cpp)
 target_include_directories(lotus_v2_block_script_rollback_test PRIVATE
