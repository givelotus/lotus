From d43e32eb05bdfba1f44c1252f43dfb1fa1b2e480 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:21:23 -0700
Subject: [PATCH] fix(v2): reserve snapshot checkpoint read within page work
 cap

---
 chronik/chronik-http/src/v2_explorer.rs | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/chronik/chronik-http/src/v2_explorer.rs b/chronik/chronik-http/src/v2_explorer.rs
index dc380809fc8d28503096fc78db7bb97ab3ee5ab5..31d88602a36598b9d31af81ebdc0aee1ec442748 100644
--- a/chronik/chronik-http/src/v2_explorer.rs
+++ b/chronik/chronik-http/src/v2_explorer.rs
@@ -576,6 +576,12 @@ async fn handle(
     {
         return failure(unavailable(), None);
     }
+    let mut read_budget = chronik_db::v2_asset::AssetReadBudget::new(4096);
+    // Snapshot construction reads the checkpoint key. Reserve it before I/O;
+    // asset iteration and all secondary joins share the remaining budget.
+    if read_budget.charge().is_err() {
+        return failure(unavailable(), None);
+    }
     let view = match db.snapshot() {
         Ok(v) => v,
         Err(_) => return failure(unavailable(), None),
@@ -590,7 +596,7 @@ async fn handle(
         binding: view.binding,
         anchor: view.anchor,
     };
-    let result = dispatch(path, params, &bytes, &view, &context)
+    let result = dispatch(path, params, &bytes, &view, &context, read_budget)
         .and_then(|data| {
             let value = context.envelope(data);
             // The capped encoder runs before the final stamp observation.
@@ -615,6 +621,7 @@ fn dispatch(
     body: &[u8],
     v: &ReadSnapshot<'_>,
     c: &Context,
+    mut asset_budget: chronik_db::v2_asset::AssetReadBudget,
 ) -> Result<Value> {
     if path.starts_with("/branches/") {
         return branches(path, params, body, v, c);
@@ -622,7 +629,6 @@ fn dispatch(
     if !body.is_empty() {
         return Err(invalid());
     }
-    let mut asset_budget = chronik_db::v2_asset::AssetReadBudget::new(4096);
     let p = path
         .split('/')
         .filter(|p| !p.is_empty())
-- 
