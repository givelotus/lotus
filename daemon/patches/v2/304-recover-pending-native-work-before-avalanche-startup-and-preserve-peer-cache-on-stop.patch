+// Copyright (c) 2026 The Lotus developers
+#include "../avalanche_driver.h"
+#include "../avalanche_peer_test/fixtures.h"
+#include <util/translation.h>
+using namespace lotus::v2::ava;
+const std::function<std::string(const char *)> G_TRANSLATION_FUN=nullptr;
+namespace {
+#include "startup_recovery.inc"
+void Prepare(DevelopmentRuntime &runtime) {
+ std::string e; HeaderAdmission h; CandidateBodyStatus b;
+ Check(runtime.AdmitHeader(HeaderOf(V(0)),h,e)==DevelopmentRuntimeResult::Progress,"admit actual fixture header");
+ Check(runtime.RetainBody(H(V(0).id),runtime_fixture::Bytes(V(0).wire),b,e)==DevelopmentRuntimeResult::Progress,"retain actual fixture body");
+ for(size_t n=0;n<300;++n) {runtime.Tick(UINT64_MAX,0,TickLimits());auto s=runtime.Snapshot();if(s.chain&&s.chain->pending_journal)return;}
+ throw std::runtime_error("fixture did not create actual durable journal");
+}
+DriverConfig Configuration(Node &node) {
+ DriverConfig c;c.profile.chain_id=node.network.chain_id;c.profile.genesis_id=node.network.genesis_id;
+ c.profile.validation_digest=node.runtime->Snapshot().chain->profile_digest;
+ c.session_key.MakeNewKey(true);c.peer_file=node.home.path+"/avapeers.dat";return c;
+}
+}
+int main() {
+ ECC_Start();
+ try {
+  Pair pair;std::string e;auto config=Configuration(pair.a);
+  AvalancheDriver driver(*pair.a.runtime,*pair.a.dispatcher,config);
+  Check(bool(driver.Start(true,1700000000)),"start actual observer before pending work");
+  const auto before=pair.a.runtime->Snapshot(); size_t clock_calls=0;
+  Check(RecoverAvalancheStartup(*pair.a.runtime,0,TickLimits(),[]{return UINT64_MAX;},[&]{++clock_calls;return 0;},e),"idle startup accepted");
+  Check(clock_calls==2 && pair.a.runtime->Snapshot().chain->revision==before.chain->revision,"idle startup performs no runtime tick or fresh selection");
+  Prepare(*pair.a.runtime);
+  Check(driver.Tick(true,100,1700000000).code==DriverCode::NotReady,"pending journal gates live driver activity");
+  Check(bool(driver.Save()),"pending-stop saves admitted public cache without requiring chain authority");
+  PeerStore store(config.peer_file,config.profile);std::vector<PersistedPeer> saved;
+  Check(bool(store.Load(saved)) && saved.empty(),"saved cache valid and invents no proofs");
+  AvalancheDriver starting(*pair.a.runtime,*pair.a.dispatcher,config);
+  Check(starting.Start(true,1700000000).code==DriverCode::NotReady,"before repair driver cannot start from pending home");
+  size_t calls=0;
+  Check(!RecoverAvalancheStartup(*pair.a.runtime,0,TickLimits(),[]{return UINT64_MAX;},[&]{return calls++?120000:0;},e) && e=="runtime-recovery-deadline","bounded startup deadline refuses before touching pending work");
+  Check(pair.a.runtime->Snapshot().chain->pending_journal,"deadline preserves durable journal");
+  auto finish_deadline=[&]{const auto s=pair.a.runtime->Snapshot();return s.chain && !s.chain->pending_journal && !s.chain->pending_receipt && !s.chain->pending_propagation?uint64_t{120000}:uint64_t{0};};
+  Check(!RecoverAvalancheStartup(*pair.a.runtime,0,TickLimits(),[]{return UINT64_MAX;},finish_deadline,e) && e=="runtime-recovery-deadline","deadline crossing on final recovery tick refuses ready");
+  Check(RecoverAvalancheStartup(*pair.a.runtime,0,TickLimits(),[]{return UINT64_MAX;},[]{return 0;},e),"explicit startup finishes actual durable journal");
+  auto recovered=pair.a.runtime->Snapshot();
+  Check(recovered.chain && !recovered.chain->pending_journal && !recovered.chain->pending_receipt && !recovered.chain->pending_propagation && !recovered.reopen_required && !recovered.execution_paused,"recovery establishes idle authority");
+  Check(bool(starting.Start(true,1700000000)),"driver starts after explicit recovery");
+  Check(bool(starting.Save()),"orderly stop remains durable after recovery");
+  Home home;auto runtime=Open(home);Prepare(*runtime);runtime.reset();runtime=Open(home);
+  Check(runtime->Snapshot().chain->pending_journal,"actual reopened home retains pending journal");
+  Check(RecoverAvalancheStartup(*runtime,0,TickLimits(),[]{return UINT64_MAX;},[]{return 0;},e),"actual reopened pending home recovers before startup");
+  Check(!runtime->Snapshot().chain->pending_journal && runtime->Snapshot().chain->stable_tip==H(V(0).id),"reopened recovery reaches expected native tip");
+  auto bad_config=Configuration(pair.b);bad_config.peer_file=pair.b.home.path+"/save-failure";
+  AvalancheDriver bad_save(*pair.b.runtime,*pair.b.dispatcher,bad_config);
+  Check(bool(bad_save.Start(true,1700000000)),"durability-failure test starts from absent cache");
+  Check(std::filesystem::create_directory(bad_config.peer_file),"install deterministic refused cache target");
+  Prepare(*pair.b.runtime);
+  Check(bad_save.Save().code==DriverCode::StoreFailure && !bad_save.Ready() && bad_save.Status().failed,"real peer durability failure remains fatal");
+  std::cout<<"native Avalanche lifecycle checks passed\n";
+ } catch(const std::exception &e) {std::cerr<<e.what()<<'\n';ECC_Stop();return 1;}
+ ECC_Stop();return 0;
+}
