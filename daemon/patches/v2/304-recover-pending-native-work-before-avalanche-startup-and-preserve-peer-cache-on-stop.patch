diff --git a/src/lotus_v2/avalanche_driver.cpp b/src/lotus_v2/avalanche_driver.cpp
index 1b433828ffeaaf7a4f334c6a6e3223bf5d2d35bc..5ed50e9146af2858d447fe50cd4e27255764f51d 100644
--- a/src/lotus_v2/avalanche_driver.cpp
+++ b/src/lotus_v2/avalanche_driver.cpp
@@ -219,7 +219,11 @@ bool AvalancheDriver::Reconcile(const PollItem &p,bool accepted,std::string &e)
 DriverResult AvalancheDriver::Save() {
     if(!Ready())return Error(DriverCode::NotReady,"driver-not-started");
     if(!config_.profile.persist_peers)return {};
-    ChainSnapshot s;std::string e;if(!Refresh(s,e))return Error(DriverCode::NotReady,e);
+    // Persistence is a public cache of previously admitted records, not a
+    // statement about current eligibility. A durable block journal can make
+    // chain authority temporarily unavailable during an orderly stop. Preserve
+    // the last active admitted public records now; Start individually validates them against the
+    // recovered authoritative chain before restoring quorum state.
     auto r=store_.Save(quorum_.ExportPeers());if(!r){failed_=true;return {DriverCode::StoreFailure,r.code,r.message};}return {};
 }
 }
