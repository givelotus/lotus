@@ -551,12 +551,51 @@ namespace {
         bool requested_compact{}, requested_fallback{};
         uint32_t issued_requests{};
     };
+    // BEGIN AVALANCHE STARTUP RECOVERY
+    bool RecoverAvalancheStartup(DevelopmentRuntime &runtime, uint64_t future_window,
+        const DevelopmentTickLimits &limits, const std::function<uint64_t()> &utc,
+        const std::function<uint64_t()> &monotonic, std::string &error) {
+        const auto begin=monotonic();
+        for(size_t ticks=0;ticks<10000;++ticks) {
+            const auto now=monotonic();
+            if(now<begin || now-begin>=120000) {error="runtime-recovery-deadline";return false;}
+            const auto snapshot=runtime.Snapshot();
+            if(snapshot.execution_paused) {error="runtime-execution-paused";return false;}
+            if(!snapshot.reopen_required) {
+                if(!snapshot.chain) {error="runtime-authority-unavailable";return false;}
+                if(!snapshot.chain->pending_journal && !snapshot.chain->pending_receipt &&
+                   !snapshot.chain->pending_propagation) {error.clear();return true;}
+            }
+            // Only resume existing durable work. Never perform selection after
+            // an idle authoritative snapshot, and never expose peers/ready yet.
+            const auto tick=runtime.Tick(utc(),future_window,limits);
+            switch(tick.result) {
+                case DevelopmentRuntimeResult::Progress:
+                case DevelopmentRuntimeResult::Prepared:
+                case DevelopmentRuntimeResult::Recovering:
+                case DevelopmentRuntimeResult::CompleteTarget:
+                case DevelopmentRuntimeResult::RestoredSource:
+                case DevelopmentRuntimeResult::Acknowledged:
+                case DevelopmentRuntimeResult::Invalidated:
+                case DevelopmentRuntimeResult::Reopened: break;
+                default: error="runtime-recovery-incomplete";return false;
+            }
+        }
+        error="runtime-recovery-tick-limit";return false;
+    }
+    // END AVALANCHE STARTUP RECOVERY
     class Node {
     public:
         Node(DevelopmentManifest m, NetworkConfig n,
              std::unique_ptr<DevelopmentRuntime> r, const std::string &directory)
             : manifest(std::move(m)), network(std::move(n)),
               runtime(std::move(r)) {
+            std::string error;
+            if(network.avalanche) {
+                const bool recovered=RecoverAvalancheStartup(*runtime,manifest.future_window,
+                    TickLimits(manifest.block_read_limit),Utc,Monotonic,error);
+                Require(recovered,"Avalanche startup recovery: " + error);
+            }
             manager = std::make_unique<DownloadManager>(
                 DownloadSettings(network.profile), Callbacks());
             dispatcher = std::make_unique<PeerDispatcher>(
@@ -577,7 +616,6 @@ namespace {
             pc.ordinary = manifest.op;
             pc.cost = manifest.cp;
             pc.max_block_bytes = manifest.block_read_limit;
-            std::string error;
             Require(PoolCoordinator::Open(*runtime, pc, pool, error), error);
             RelayLimits rl{};
             rl.peers = MaxPeers;
