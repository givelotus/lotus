diff --git a/src/test/intmath_tests.cpp b/src/test/intmath_tests.cpp
index 4d3f20241..810fc080a 100644
--- a/src/test/intmath_tests.cpp
+++ b/src/test/intmath_tests.cpp
@@ -218,4 +218,188 @@ BOOST_AUTO_TEST_CASE(log2fixedpoint_tests) {
     }
 }
 
+// ---------------------------------------------------------------------------
+// ScriptLog2: pure integer log2 for script opcodes.
+// ---------------------------------------------------------------------------
+
+BOOST_AUTO_TEST_CASE(scriptlog2_powers_of_two) {
+    // For x = 2^k, log2(x) = k exactly; result = k * 2^prec with no error.
+    for (uint32_t prec = 1; prec <= 31; prec++) {
+        for (int k = 0; k <= 62; k++) {
+            const uint64_t x = uint64_t(1) << k;
+            const int64_t expected = int64_t(k) << prec;
+            const int64_t result = ScriptLog2(x, prec);
+            BOOST_CHECK_EQUAL(result, expected);
+        }
+    }
+}
+
+BOOST_AUTO_TEST_CASE(scriptlog2_x_one) {
+    // log2(1) = 0 for all precisions.
+    for (uint32_t prec = 1; prec <= 31; prec++) {
+        BOOST_CHECK_EQUAL(ScriptLog2(1, prec), 0);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(scriptlog2_known_values) {
+    // Spot-check specific values against floor(log2(x) * 2^prec).
+    // Long double (80-bit on x86, 128-bit on arm64) is used as the reference
+    // since it represents all integers < 2^64 exactly and has enough mantissa
+    // bits for accurate log2.
+    //
+    // Power-of-2 inputs are exact (zero rounding error guaranteed by the
+    // algorithm's normalization step).  Non-power-of-2 inputs can be up to 3
+    // below the true floor due to bit-truncation in the Turner squaring steps.
+    struct TestCase { uint64_t x; uint32_t prec; };
+    const std::vector<TestCase> cases = {
+        // Non-powers-of-2: result in [floor-3, floor].
+        {3, 8},  {3, 16},  {3, 31},
+        {100, 8}, {100, 16},
+        {1000, 8}, {1000, 16},
+        {1000000, 8}, {1000000, 16},
+        // Powers of 2: exact (also verified exhaustively in scriptlog2_powers_of_two).
+        {0x100000000ULL, 16},
+        {uint64_t(1) << 62, 16},
+        {uint64_t(1) << 62, 1},
+    };
+    for (auto &tc : cases) {
+        const int64_t result = ScriptLog2(tc.x, tc.prec);
+        const long double scale = (long double)(uint64_t(1) << tc.prec);
+        const long double exact = log2l((long double)tc.x) * scale;
+        const int64_t floor_exact = (int64_t)floorl(exact);
+        BOOST_CHECK_MESSAGE(
+            result >= floor_exact - 3 && result <= floor_exact,
+            "ScriptLog2(" << tc.x << ", " << tc.prec << ") = " << result
+            << " expected in [" << (floor_exact - 3) << ", " << floor_exact << "]");
+    }
+    // Exact power-of-2 assertions for human readability.
+    BOOST_CHECK_EQUAL(ScriptLog2(0x100000000ULL, 16), 32LL * 65536);
+    BOOST_CHECK_EQUAL(ScriptLog2(uint64_t(1) << 62, 16), 62LL * 65536);
+    BOOST_CHECK_EQUAL(ScriptLog2(uint64_t(1) << 62, 1), 124LL);
+}
+
+BOOST_AUTO_TEST_CASE(scriptlog2_monotone) {
+    // For fixed precision, ScriptLog2 must be non-decreasing.
+    for (uint32_t prec : {8u, 16u, 24u}) {
+        int64_t prev = ScriptLog2(1, prec);
+        for (uint64_t x = 2; x <= 10000; x++) {
+            int64_t cur = ScriptLog2(x, prec);
+            BOOST_CHECK_GE(cur, prev);
+            prev = cur;
+        }
+    }
+}
+
+BOOST_AUTO_TEST_CASE(scriptlog2_vs_float) {
+    // Result must be close to floor(log2(x) * 2^prec).
+    //
+    // We use long double (64-bit mantissa on x86/arm64) as the reference,
+    // which represents all x < 2^64 exactly and gives accurate log2.
+    //
+    // The ScriptLog2 algorithm truncates xn = n >> (k - prec) before squaring
+    // (losing up to k-prec low bits) and each squaring step truncates, so the
+    // result can be up to 3 below the true floor.  The algorithm never produces
+    // a result above the true floor (truncation only rounds down).
+    MMIXLinearCongruentialGenerator lcg;
+    for (uint32_t prec : {8u, 16u, 31u}) {
+        for (int trial = 0; trial < 1000; trial++) {
+            // Random x in [1, 2^52) (float-accurate range).
+            uint64_t x = (uint64_t(lcg.next()) << 20) | (lcg.next() >> 12);
+            if (x == 0) x = 1;
+
+            const int64_t result = ScriptLog2(x, prec);
+            const long double scale_ld = (long double)(uint64_t(1) << prec);
+            const long double exact = log2l((long double)x) * scale_ld;
+            const int64_t floor_exact = (int64_t)floorl(exact);
+
+            // result is in [floor_exact - 3, floor_exact].
+            BOOST_CHECK_MESSAGE(
+                result >= floor_exact - 3 && result <= floor_exact,
+                "ScriptLog2(" << x << ", " << prec << ") = " << result
+                << " long double floor = " << floor_exact);
+        }
+    }
+}
+
+BOOST_AUTO_TEST_CASE(scriptlog2_large_inputs) {
+    // Near-maximum int63 inputs must not crash or overflow.
+    const std::vector<uint64_t> large_vals = {
+        0x7fffffffffffffffULL,
+        0x7fffffffffffffffULL - 1,
+        0x4000000000000000ULL,
+        0x3fffffffffffffffULL,
+        0xffffffffffffffffULL,  // max uint64 (beyond int63)
+    };
+    for (uint64_t x : large_vals) {
+        for (uint32_t prec : {1u, 8u, 16u, 31u}) {
+            // Just verify it doesn't assert/crash and is monotone-ish.
+            const int64_t result = ScriptLog2(x, prec);
+            // log2(2^63) * 2^31 = 63 * 2^31 which fits in int64.
+            BOOST_CHECK_GE(result, 0);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// IntegerSqrt: floor(sqrt(n)).
+// ---------------------------------------------------------------------------
+
+BOOST_AUTO_TEST_CASE(integersqrt_zero) {
+    BOOST_CHECK_EQUAL(IntegerSqrt(0), 0ULL);
+}
+
+BOOST_AUTO_TEST_CASE(integersqrt_one) {
+    BOOST_CHECK_EQUAL(IntegerSqrt(1), 1ULL);
+}
+
+BOOST_AUTO_TEST_CASE(integersqrt_perfect_squares) {
+    for (uint64_t k = 0; k <= 100000; k++) {
+        BOOST_CHECK_EQUAL(IntegerSqrt(k * k), k);
+    }
+    // Large perfect squares.
+    for (uint64_t k : {1000000ULL, 100000000ULL, 3037000499ULL}) {
+        BOOST_CHECK_EQUAL(IntegerSqrt(k * k), k);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(integersqrt_floor_property) {
+    // Exhaustive floor check: result^2 <= x < (result+1)^2.
+    for (uint64_t x = 0; x <= 1000000; x++) {
+        const uint64_t r = IntegerSqrt(x);
+        BOOST_CHECK_LE(r * r, x);
+        BOOST_CHECK_GT((r + 1) * (r + 1), x);
+    }
+    // Large values.
+    MMIXLinearCongruentialGenerator lcg;
+    for (int trial = 0; trial < 1000; trial++) {
+        uint64_t x = (uint64_t(lcg.next()) << 32) | lcg.next();
+        x &= 0x7fffffffffffffffULL;
+        const uint64_t r = IntegerSqrt(x);
+        const __uint128_t r128 = r;
+        const __uint128_t r1128 = r + 1;
+        BOOST_CHECK((uint64_t)(r128 * r128) <= x);
+        BOOST_CHECK(r1128 * r1128 > (__uint128_t)x);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(integersqrt_max_input) {
+    // floor(sqrt(2^63-1)) = 3037000499
+    const uint64_t max_val = 0x7fffffffffffffffULL;
+    const uint64_t expected = 3037000499ULL;
+    BOOST_CHECK_EQUAL(IntegerSqrt(max_val), expected);
+    // Verify.
+    BOOST_CHECK(expected * expected <= max_val);
+    const __uint128_t r1 = expected + 1;
+    BOOST_CHECK(r1 * r1 > (__uint128_t)max_val);
+}
+
+BOOST_AUTO_TEST_CASE(integersqrt_near_perfect_squares) {
+    for (uint64_t k = 2; k <= 100000; k++) {
+        // Just below perfect square: sqrt(k^2 - 1) = k - 1
+        BOOST_CHECK_EQUAL(IntegerSqrt(k * k - 1), k - 1);
+        // Just above perfect square: sqrt(k^2 + 1) = k
+        BOOST_CHECK_EQUAL(IntegerSqrt(k * k + 1), k);
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
