new file mode 100644
index 000000000..f1c0ab079
--- /dev/null
+++ b/src/script/intmath.cpp
@@ -0,0 +1,91 @@
+// Copyright (c) 2021 Logos Foundation
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <script/intmath.h>
+
+#include <cassert>
+#include <cmath>
+
+/**
+ * Computes floor(log2(n) * 2^precision) for a positive plain integer n.
+ *
+ * Algorithm: C. S. Turner, "A Fast Binary Logarithm Algorithm",
+ * IEEE Signal Processing Mag., pp. 124,140, Sep. 2010.
+ *
+ * We extend the original uint32_t Turner algorithm to uint64_t inputs by:
+ *   1. Finding k = floor(log2(n)) using __builtin_clzll.
+ *   2. Scaling n to [2^precision, 2^(precision+1)) by shifting, which
+ *      isolates the fractional part of log2(n) in fixed-point form.
+ *   3. Running the Turner squaring loop for `precision` iterations.
+ *   4. The integer part k * 2^precision is added separately.
+ *
+ * Using __uint128_t in the squaring step prevents overflow: after
+ * normalization, z < 2^(precision+1), so z^2 < 2^(2*precision+2) which
+ * can reach 2^64 for precision=31 — requiring 128-bit arithmetic.
+ */
+int64_t ScriptLog2(uint64_t n, uint32_t precision) {
+    assert(n > 0);
+    assert(precision >= 1 && precision <= 31);
+
+    // k = floor(log2(n)): position of the highest set bit (0-indexed).
+    const uint32_t k = 63 - (uint32_t)__builtin_clzll(n);
+
+    // Integer part of the result in fixed-point: k * 2^precision.
+    int64_t y = int64_t(k) << precision;
+
+    // Scale n into [2^precision, 2^(precision+1)) to isolate the
+    // fractional part of log2(n).  This is equivalent to computing
+    // log2(n / 2^k) = log2(mantissa) where mantissa is in [1, 2).
+    uint64_t xn;
+    if (k >= precision) {
+        xn = n >> (k - precision);
+    } else {
+        xn = n << (precision - k);
+    }
+    // Invariant: xn is in [2^precision, 2^(precision+1)).
+
+    // Turner squaring iterations: each step refines one bit of the
+    // fractional part of log2.
+    int64_t b = int64_t(1) << (precision - 1);
+    __uint128_t z = xn;
+    const __uint128_t threshold = __uint128_t(2) << precision;
+    for (uint32_t i = 0; i < precision; i++) {
+        z = (z * z) >> precision;
+        if (z >= threshold) {
+            z >>= 1;
+            y += b;
+        }
+        b >>= 1;
+    }
+
+    return y;
+}
+
+/**
+ * Computes floor(sqrt(n)) for a non-negative integer n.
+ *
+ * Uses sqrtl() for an O(1) initial estimate, then corrects any
+ * floating-point rounding error with at most a few integer steps.
+ * __uint128_t prevents overflow: for n up to 2^63-1, r < 2^32, so
+ * r^2 < 2^64 which overflows uint64_t but fits in __uint128_t.
+ */
+uint64_t IntegerSqrt(uint64_t n) {
+    if (n == 0) {
+        return 0;
+    }
+
+    // sqrtl gives an accurate initial estimate for all uint64_t values.
+    uint64_t r = (uint64_t)sqrtl((long double)n);
+
+    // Correct downward: r might be 1 too high due to rounding.
+    while ((__uint128_t)r * r > (__uint128_t)n) {
+        r--;
+    }
+    // Correct upward: r might be 1 too low due to rounding.
+    while ((__uint128_t)(r + 1) * (r + 1) <= (__uint128_t)n) {
+        r++;
+    }
+
+    return r;
+}
