+
+typedef std::vector<uint8_t> valtype;
+typedef std::vector<valtype> stacktype;
+std::array<uint32_t, 2> flagset{{0, STANDARD_SCRIPT_VERIFY_FLAGS}};
+
+static void CheckSuccess(const CScript &script) {
+    BaseSignatureChecker sigchecker;
+    for (uint32_t flags : flagset) {
+        ScriptError err = ScriptError::OK;
+        stacktype stack{};
+        bool r = EvalScript(stack, script, flags, sigchecker, &err);
+        BOOST_CHECK_MESSAGE(r, "Expected OK but got "
+                                   << ScriptErrorString(err) << " for '"
+                                   << ScriptToAsmStr(script) << "'");
+    }
+}
+
+static void CheckError(const CScript &script,
+                       const ScriptError expected_error) {
+    BaseSignatureChecker sigchecker;
+    for (uint32_t flags : flagset) {
+        ScriptError err = ScriptError::OK;
+        stacktype stack{};
+        bool r = EvalScript(stack, script, flags, sigchecker, &err);
+        BOOST_CHECK_MESSAGE(
+            !r, "Expected " << ScriptErrorString(expected_error)
+                            << " but got " << ScriptErrorString(err)
+                            << " for '" << ScriptToAsmStr(script) << "'");
+        BOOST_CHECK_EQUAL(err, expected_error);
+    }
+}
+
+// Verify OP_LOG produces the expected result.
+static void CheckLog(int64_t x, int64_t prec, int64_t expected) {
+    // Check that: x prec OP_LOG == expected
+    CheckSuccess(CScript() << x << prec << OP_LOG
+                           << expected << OP_EQUAL);
+}
+
+// Verify OP_LOG produces the same result as ScriptLog2 directly.
+static void CheckLogMatchesDirect(uint64_t x, uint32_t prec) {
+    int64_t expected = ScriptLog2(x, prec);
+    CheckLog((int64_t)x, (int64_t)prec, expected);
+}
+
+// -------------------------------------------------------------------------
+// Powers of 2: log2(2^k) = k exactly, so result = k * 2^precision.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_powers_of_two) {
+    // For all precision values and all representable powers of 2,
+    // the result must be exactly k * 2^prec with zero rounding error.
+    for (uint32_t prec = 1; prec <= 31; prec++) {
+        for (int k = 0; k <= 62; k++) {
+            const uint64_t x = uint64_t(1) << k;
+            const int64_t expected = int64_t(k) << prec;
+            CheckLog((int64_t)x, (int64_t)prec, expected);
+        }
+    }
+}
+
+// -------------------------------------------------------------------------
+// x = 1: log2(1) = 0 exactly for all precisions.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_one) {
+    for (uint32_t prec = 1; prec <= 31; prec++) {
+        CheckLog(1, (int64_t)prec, 0);
+    }
+}
+
+// -------------------------------------------------------------------------
+// Boundary precision values (1 and 31).
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_precision_boundaries) {
+    // prec=1: result is 0 or 1 for x in [1,3], step by 1.
+    // log2(1)=0, log2(2)=1, log2(3)=1.58..->floor*2=3? No: floor(1.58*2)=3.
+    // Actually for prec=1: floor(log2(3)*2) = floor(3.17) = 3.
+    // Wait: log2(3) ≈ 1.585, * 2^1 = 3.17, floor = 3.
+    // But result must fit in int64_t and be a valid script number.
+    CheckLog(1, 1, 0);
+    CheckLog(2, 1, 2);   // log2(2)*2 = 2
+    CheckLog(3, 1, 3);   // floor(1.585*2) = floor(3.17) = 3
+    CheckLog(4, 1, 4);   // log2(4)*2 = 4
+    CheckLog(8, 1, 6);   // log2(8)*2 = 6
+    CheckLog(16, 1, 8);  // log2(16)*2 = 8
+
+    // prec=31: maximum precision, matches ScriptLog2 directly.
+    for (uint64_t x : {1ULL, 2ULL, 3ULL, 4ULL, 7ULL, 8ULL, 100ULL,
+                        1000ULL, 65536ULL, 0x7fffffffULL, 0xffffffffULL,
+                        0x1000000000ULL, 0x7fffffffffffffffULL}) {
+        CheckLogMatchesDirect(x, 31);
+    }
+}
+
+// -------------------------------------------------------------------------
+// Monotonicity: for fixed precision, log2(x) < log2(x+1) or equal (floor).
+// We verify: if x < y then OP_LOG(x, p) <= OP_LOG(y, p).
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_monotone) {
+    const uint32_t prec = 16;
+    // Check monotonicity across a range of consecutive integers.
+    for (int64_t x = 1; x < 4096; x++) {
+        int64_t lx = ScriptLog2((uint64_t)x, prec);
+        int64_t ly = ScriptLog2((uint64_t)(x + 1), prec);
+        BOOST_CHECK_MESSAGE(lx <= ly,
+            "Monotonicity violated: ScriptLog2(" << x << ", " << prec
+            << ") = " << lx << " > ScriptLog2(" << x + 1 << ") = " << ly);
+        // Also check large values.
+        int64_t lbig = ScriptLog2((uint64_t)(1ULL << 40) + x, prec);
+        int64_t lbig1 = ScriptLog2((uint64_t)(1ULL << 40) + x + 1, prec);
+        BOOST_CHECK(lbig <= lbig1);
+    }
+}
+
+// -------------------------------------------------------------------------
+// Precision coverage: for each (x, prec), ScriptLog2 returns a value within
+// the allowed tolerance of floor(log2(x) * 2^prec).
+//
+// Note: the mathematical identity
+//   floor(log2(x) * 2^P) == floor(floor(log2(x) * 2^31) / 2^(31-P))
+// holds for the *exact* floor values but NOT for the algorithm's independent
+// approximations — each precision runs its own squaring loop with bounded
+// truncation error in [-3, 0], so results at different precisions are not
+// required to be consistent with each other via simple right-shifting.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_precision_consistency) {
+    const std::vector<uint64_t> test_vals = {
+        1, 2, 3, 4, 5, 7, 10, 100, 1000, 65536, 1000000,
+        0x7fffffff, 0xffffffff, 0x100000000ULL, 0x7fffffffffffULL,
+    };
+    for (uint64_t x : test_vals) {
+        for (uint32_t prec = 1; prec <= 31; prec++) {
+            const int64_t rp = ScriptLog2(x, prec);
+            // Compute the true floor via long double reference.
+            const long double scale = (long double)(uint64_t(1) << prec);
+            const long double exact = log2l((long double)x) * scale;
+            const int64_t floor_exact = (int64_t)floorl(exact);
+            BOOST_CHECK_MESSAGE(
+                rp >= floor_exact - 3 && rp <= floor_exact,
+                "ScriptLog2(" << x << ", " << prec << ") = " << rp
+                << " expected in [" << (floor_exact - 3) << ", " << floor_exact << "]");
+            // Verify via script execution.
+            CheckLog((int64_t)x, (int64_t)prec, rp);
+        }
+    }
+}
+
+// -------------------------------------------------------------------------
+// Comparison against std::log2: result must differ by at most 1 ulp at the
+// given precision (i.e., floor rounding error <= 1).
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_vs_float) {
+    MMIXLinearCongruentialGenerator lcg;
+    // Test a variety of random inputs at several precisions.
+    for (uint32_t prec : {8u, 16u, 24u, 31u}) {
+        for (int trial = 0; trial < 500; trial++) {
+            // Generate random positive integer in [1, 2^52) for float accuracy.
+            uint64_t x = (uint64_t(lcg.next()) << 20) | (lcg.next() >> 12);
+            if (x == 0) x = 1;
+
+            const int64_t result = ScriptLog2(x, prec);
+            // Use long double: 64-bit mantissa represents all x < 2^64 exactly.
+            const long double scale_ld = (long double)(uint64_t(1) << prec);
+            const long double exact = log2l((long double)x) * scale_ld;
+            const int64_t floor_exact = (int64_t)floorl(exact);
+
+            // Algorithm truncates xn during normalization and in each squaring
+            // step, so result can be up to 3 below the true floor but never
+            // above it.
+            BOOST_CHECK_MESSAGE(
+                result >= floor_exact - 3 && result <= floor_exact,
+                "ScriptLog2(" << x << ", " << prec << ") = " << result
+                << " but long double floor = " << floor_exact);
+
+            // Verify via script.
+            CheckLog((int64_t)x, (int64_t)prec, result);
+        }
+    }
+}
+
+// -------------------------------------------------------------------------
+// Large inputs: near the maximum int63 value.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_large_inputs) {
+    const std::vector<uint64_t> large_vals = {
+        0x7fffffffffffffffULL,      // max int63
+        0x7fffffffffffffffULL - 1,
+        0x7fffffffffffffffULL - 7,
+        0x4000000000000000ULL,      // 2^62
+        0x3fffffffffffffffULL,      // 2^62 - 1
+        0x100000000000000ULL,       // 2^56
+        0x7fffffffff,               // 2^39 - 1
+    };
+    for (uint64_t x : large_vals) {
+        for (uint32_t prec : {1u, 8u, 16u, 31u}) {
+            CheckLogMatchesDirect(x, prec);
+        }
+    }
+}
+
+// -------------------------------------------------------------------------
+// Selected exact values that humans can verify by hand.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_known_values) {
+    // log2(8) = 3.  prec=8: 3 * 256 = 768.
+    CheckLog(8, 8, 768);
+    // log2(16) = 4.  prec=8: 4 * 256 = 1024.
+    CheckLog(16, 8, 1024);
+    // log2(32) = 5.  prec=16: 5 * 65536 = 327680.
+    CheckLog(32, 16, 327680);
+    // log2(1024) = 10.  prec=16: 10 * 65536 = 655360.
+    CheckLog(1024, 16, 655360);
+    // log2(2) = 1.  prec=31: 1 * 2^31 = 2147483648.
+    CheckLog(2, 31, 2147483648LL);
+    // log2(4) = 2.  prec=31: 2 * 2^31 = 4294967296.
+    CheckLog(4, 31, 4294967296LL);
+    // log2(2^62) = 62.  prec=16: 62 * 65536 = 4063232.
+    CheckLog((int64_t)(uint64_t(1) << 62), 16, 62LL * 65536);
+    // log2(2^62) = 62.  prec=1: 62 * 2 = 124.
+    CheckLog((int64_t)(uint64_t(1) << 62), 1, 124);
+}
+
+// -------------------------------------------------------------------------
+// Error cases.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_error_x_zero) {
+    // x=0: logarithm of zero is undefined.
+    for (uint32_t prec : {1u, 8u, 16u, 31u}) {
+        CheckError(CScript() << 0 << (int64_t)prec << OP_LOG << OP_1,
+                   ScriptError::OP_LOG_INVALID_OPERAND);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_x_negative) {
+    // x < 0: logarithm of negative is undefined.
+    for (int64_t x : {-1LL, -2LL, -100LL, -0x7fffffffffffffffLL}) {
+        for (uint32_t prec : {1u, 16u, 31u}) {
+            CheckError(CScript() << x << (int64_t)prec << OP_LOG << OP_1,
+                       ScriptError::OP_LOG_INVALID_OPERAND);
+        }
+    }
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_precision_zero) {
+    // precision=0: not in [1, 31].
+    CheckError(CScript() << 10 << 0 << OP_LOG << OP_1,
+               ScriptError::OP_LOG_INVALID_PRECISION);
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_precision_32) {
+    // precision=32: exceeds maximum.
+    CheckError(CScript() << 10 << 32 << OP_LOG << OP_1,
+               ScriptError::OP_LOG_INVALID_PRECISION);
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_precision_negative) {
+    // precision < 0: invalid.
+    for (int64_t p : {-1LL, -8LL, -31LL, -100LL}) {
+        CheckError(CScript() << 10 << p << OP_LOG << OP_1,
+                   ScriptError::OP_LOG_INVALID_PRECISION);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_precision_too_large) {
+    // precision > 31: too many fractional bits (would overflow result encoding).
+    for (int64_t p : {33LL, 62LL, 100LL, 1000LL}) {
+        CheckError(CScript() << 10 << p << OP_LOG << OP_1,
+                   ScriptError::OP_LOG_INVALID_PRECISION);
+    }
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_stack_underflow_empty) {
+    // Empty stack.
+    CheckError(CScript() << OP_LOG << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+}
+
+BOOST_AUTO_TEST_CASE(op_log_error_stack_underflow_one) {
+    // Only one element on stack.
+    CheckError(CScript() << 16 << OP_LOG << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+}
+
+// -------------------------------------------------------------------------
+// Exhaustive test for small x (1..512) and all precisions (1..31).
+// Verifies every value against ScriptLog2 directly.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_exhaustive_small) {
+    for (uint64_t x = 1; x <= 512; x++) {
+        for (uint32_t prec = 1; prec <= 31; prec++) {
+            CheckLogMatchesDirect(x, prec);
+        }
+    }
+}
+
+// -------------------------------------------------------------------------
+// Random large inputs: verify script execution matches ScriptLog2.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_log_random_large) {
+    MMIXLinearCongruentialGenerator lcg;
+    for (int trial = 0; trial < 200; trial++) {
+        uint64_t hi = lcg.next();
+        uint64_t lo = lcg.next();
+        uint64_t x = (hi << 32) | lo;
+        // Clamp to positive int63 range.
+        x &= 0x7fffffffffffffffULL;
+        if (x == 0) x = 1;
+        for (uint32_t prec : {1u, 8u, 16u, 24u, 31u}) {
+            CheckLogMatchesDirect(x, prec);
+        }
+    }
+}
+
+BOOST_AUTO_TEST_SUITE_END()
