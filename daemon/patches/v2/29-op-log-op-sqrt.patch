+
+// Comprehensive tests for OP_LOG (0xbd): (x precision -- floor(log2(x) * 2^precision))
+//
+// Consensus-level guarantees tested:
+//   1. Correct values for all powers of 2 (exact, no rounding error)
+//   2. Correct values for selected non-power-of-2 inputs
+//   3. Monotonicity: log2 is strictly increasing
+//   4. Precision coverage: result for each prec is within [-3, 0] of floor(log2(x)*2^prec)
+//   5. Error on x <= 0 (non-positive operand)
+//   6. Error on precision < 1 or precision > 31
+//   7. Stack underflow with 0 or 1 elements
+//   8. Random inputs verified against std::log2 with appropriate tolerance
+
+#include <policy/policy.h>
+#include <script/interpreter.h>
+#include <script/intmath.h>
+#include <script/script.h>
+#include <script/script_error.h>
+
+#include <test/lcg.h>
+#include <test/util/setup_common.h>
+
+#include <boost/test/unit_test.hpp>
+#include <boost/multiprecision/cpp_int.hpp>
+
+#include <core_io.h>
+#include <cmath>
+
