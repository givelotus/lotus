+BOOST_AUTO_TEST_CASE(package_eviction_order) {
+    // Verify that TrimToSize evicts based on package fee rate (ancestor-based),
+    // not individual fee rate. A parent P with low fee + child C with high fee
+    // form a CPFP package; their combined package rate should be compared against
+    // an unrelated tx U when deciding what to evict.
+    CTxMemPool pool;
+    LOCK2(cs_main, pool.cs);
+    TestMemPoolEntryHelper entry;
+    entry.SigOpCount(0);
+
+    // Parent P: low individual fee (1 sat/byte approx)
+    CMutableTransaction txP;
+    txP.vin.resize(1);
+    txP.vin[0].scriptSig = CScript() << OP_1;
+    txP.vout.resize(1);
+    txP.vout[0].scriptPubKey = CScript() << OP_1 << OP_EQUAL;
+    txP.vout[0].nValue = 10 * COIN;
+    pool.addUnchecked(entry.Fee(100 * SATOSHI).FromTx(txP));
+
+    // Child C: high individual fee, spends P
+    CMutableTransaction txC;
+    txC.vin.resize(1);
+    txC.vin[0].prevout = COutPoint(txP.GetId(), 0);
+    txC.vin[0].scriptSig = CScript() << OP_1;
+    txC.vout.resize(1);
+    txC.vout[0].scriptPubKey = CScript() << OP_2 << OP_EQUAL;
+    txC.vout[0].nValue = 9 * COIN;
+    pool.addUnchecked(entry.Fee(100000 * SATOSHI).FromTx(txC));
+
+    // Unrelated U: medium fee (higher than P alone, lower than C)
+    CMutableTransaction txU;
+    txU.vin.resize(1);
+    txU.vin[0].scriptSig = CScript() << OP_3;
+    txU.vout.resize(1);
+    txU.vout[0].scriptPubKey = CScript() << OP_3 << OP_EQUAL;
+    txU.vout[0].nValue = 10 * COIN;
+    pool.addUnchecked(entry.Fee(500 * SATOSHI).FromTx(txU));
+
+    // All three are in the pool
+    BOOST_CHECK_EQUAL(pool.size(), 3UL);
+
+    // Trim so only ~1 tx worth of space remains.
+    // P has a very low individual fee but C pays for it (CPFP).
+    // Package rate of {P,C} = (100+100000)/(sP+sC) >> individual rate of U.
+    // So {P,C} should NOT be evicted — U should be evicted first.
+    // With ancestor-based eviction: P's package rate = 100/sP (very low!).
+    // So P (and its descendant C) should be evicted, leaving only U.
+    size_t sizeU = pool.DynamicMemoryUsage() / 3 + 1;
+    pool.TrimToSize(sizeU);
+
+    // P and C are evicted (P had the lowest package rate, C is its descendant)
+    BOOST_CHECK(!pool.exists(txP.GetId()));
+    BOOST_CHECK(!pool.exists(txC.GetId()));
+    // U survives
+    BOOST_CHECK(pool.exists(txU.GetId()));
+}
