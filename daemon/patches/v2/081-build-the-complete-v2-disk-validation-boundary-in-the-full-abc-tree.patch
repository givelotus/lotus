From 8a5800280d2a8e138a4e40c59af63e6b9eb9e962 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:13:08 -0700
Subject: [PATCH] Build the complete V2 disk validation boundary in the full
 ABC tree

Expose a reusable validation library using the full build secp256k1, LevelDB, Boost and OpenSSL dependencies. Add disk-block oracle and disk-state checks to this build. Fresh Debug clone check-lotus-v2-disk passes with Chronik disabled. No chain profile or daemon acceptance path is enabled by this build target.
---
 src/lotus_v2/CMakeLists.txt | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 0526f761a27d17cc4610e94bbf94628a54539f6e..2fbebceaa4303c6bab8a718900c16d4ed5d283bb 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -127,3 +127,28 @@ add_custom_target(check-lotus-v2-persistent-header
     COMMAND $<TARGET_FILE:test_lotus_v2_persistent_header>
     DEPENDS test_lotus_v2_persistent_header
 )
+
+# Complete development validation boundary, available to the daemon integration.
+# Linking/building this target alone does not enable a chain or network profile.
+find_package(OpenSSL REQUIRED COMPONENTS Crypto)
+add_library(lotus_v2_validation STATIC
+    transaction.cpp signing.cpp vm.cpp field_size.cpp ordinary_validation.cpp
+    monetary.cpp block_wire.cpp block_cost.cpp header_context.cpp
+    asert_candidate.cpp block_transition.cpp disk_state.cpp disk_block.cpp)
+target_link_libraries(lotus_v2_validation PUBLIC
+    lotus_v2_sparse_state Boost::headers secp256k1 leveldb OpenSSL::Crypto)
+
+# Compare the disk path against the retained in-memory connector oracle using
+# the same dependencies selected by the full daemon build.
+add_executable(test_lotus_v2_disk_block
+    test_block_complete.cpp block.cpp persistent_monetary.cpp)
+target_compile_definitions(test_lotus_v2_disk_block PRIVATE LOTUS_V2_TEST_DISK=1)
+target_link_libraries(test_lotus_v2_disk_block PRIVATE
+    lotus_v2_validation lotus_v2_persistent_utxo)
+add_executable(test_lotus_v2_disk_state test_disk_state.cpp)
+target_link_libraries(test_lotus_v2_disk_state PRIVATE
+    lotus_v2_validation lotus_v2_incremental_utxo)
+add_custom_target(check-lotus-v2-disk
+    COMMAND $<TARGET_FILE:test_lotus_v2_disk_block>
+    COMMAND $<TARGET_FILE:test_lotus_v2_disk_state>
+    DEPENDS test_lotus_v2_disk_block test_lotus_v2_disk_state)
-- 
