From c1fd5f195dfd2aae16762364014a24c5f242a6da Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:54:48 -0700
Subject: [PATCH] fix(v2): distinguish last Chronik sync result from live HTTP
 authority

---
 src/lotus_v2/development_node_command.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index 40f50508a5516166cdad6cd30728361e04ffb0da..d6634494a323ae54de262bf13129a24afbc09e79 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -612,7 +612,8 @@ namespace {
 #endif
     }
     void Node::InvalidateChronik() {
-        chronik_ready = false;
+        // HTTP authority is invalidated here; retain the last completed sync
+        // result for command diagnostics, which run before the next sync step.
 #ifdef LOTUS_V2_CHRONIK_CXX
         // Failure to invalidate is fatal: native state must not change while
         // HTTP could still advertise the old observation as authoritative.
@@ -620,6 +621,7 @@ namespace {
 #endif
     }
     void Node::SyncChronik() {
+        chronik_ready = false;
 #ifdef LOTUS_V2_CHRONIK_CXX
         if (!chronik_sync) return;
         try {
@@ -906,7 +908,7 @@ namespace {
         }
         if (network.chronik_bind) {
             v.pushKV("chronik_address", chronik_address);
-            v.pushKV("chronik_ready", chronik_ready);
+            v.pushKV("chronik_last_sync_ready", chronik_ready);
             v.pushKV("chronik_error", chronik_error);
         }
         v.pushKV("mempool_ready", pool->Snapshot(0, 0).status == PoolStatus::Accepted);
-- 
