+    DevelopmentRuntimeResult ReadBody(const Hash &, uint64_t max_bytes,
+                                      std::vector<uint8_t> &out,
+                                      std::string &error);
+    ChainIndexResult BuildLocator(const Hash &expected_tip, size_t max_ids,
