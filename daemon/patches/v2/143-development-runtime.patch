+    Progress,
+    Prepared,
+    Recovering,
+    CompleteTarget,
+    RestoredSource,
+    Acknowledged,
+    Invalidated,
+    NeedBodies,
+    Deferred,
+    RetainActive,
+    Reopened,
+    Inconclusive,
+    CapacityRefused,
+    ReopenRequired,
+    StorageError,
+    InvalidConfiguration,
+    Busy,
