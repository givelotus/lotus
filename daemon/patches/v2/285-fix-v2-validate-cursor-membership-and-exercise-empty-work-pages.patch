@@ -1429,6 +1454,19 @@ fn validate_request(
     {
         return Err(invalid());
     }
+    if matches!(parts.as_slice(), ["transactions", "by-id", _, "wire"]) {
+        let offset = params
+            .get("offset")
+            .map(|s| number(s))
+            .transpose()?
+            .unwrap_or(0);
+        let length = params
+            .get("length")
+            .map(|s| number(s))
+            .transpose()?
