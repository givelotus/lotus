From 057a54b8caec3b5bdb3a18291dfdf3bb563193d6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:37:17 -0700
Subject: [PATCH] Reject invalid initializer resource profiles before opening
 storage

Integration review note (2026-10-15; original source commit had no body):
Reject unusable resource profiles before opening LevelDB; add profile boundary regressions without introducing network defaults.

---
 src/lotus_v2/test_development_chain.cpp | 65 +++++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/src/lotus_v2/test_development_chain.cpp b/src/lotus_v2/test_development_chain.cpp
index 45187c608025f8becfbca27e7494175a2ea175dd..efaf1b925b60b0d7e11fd0c4e0bb986bfaf59ebe 100644
--- a/src/lotus_v2/test_development_chain.cpp
+++ b/src/lotus_v2/test_development_chain.cpp
@@ -35,6 +35,11 @@ struct Fixture {
         hp.half_life_seconds = 172800;
         hp.spacing_seconds = 120;
         op.transaction = {32, 32, 8, 512, 8, 8192, 64};
+        op.vm = {512, 8, 8192, 32, 32, 65536, 16, 1000000};
+        op.coinbase_maturity = 2;
+        op.dust_limit = DevelopmentGenesis.dust_limit;
+        op.max_total_invocation_cost = 1000000;
+        op.vm_cost.max_invocation_cost = 1000000;
         money.bootstrap_reserve = 9;
         money.tail_subsidy = 200;
         money.prev_work[0] = 2;
@@ -205,6 +210,65 @@ void InvalidBeforeOpen() {
               "invalid genesis created database path");
     }
 }
+void InvalidProfilesBeforeOpen() {
+    for (unsigned mutation = 0; mutation < 13; ++mutation) {
+        Fixture f(true);
+        switch (mutation) {
+            case 0:
+                f.op.coinbase_maturity = 0;
+                break;
+            case 1:
+                f.op.max_total_invocation_cost = 0;
+                break;
+            case 2:
+                f.op.vm_cost.max_invocation_cost = 0;
+                break;
+            case 3:
+                ++f.op.dust_limit;
+                break;
+            case 4:
+                f.op.vm.max_script_bytes = 0;
+                break;
+            case 5:
+                f.op.vm.max_element_bytes = 0;
+                break;
+            case 6:
+                f.op.vm.max_element_bytes = VM_HARD_ELEMENT_BYTES + 1;
+                break;
+            case 7:
+                f.op.vm.max_stack_items = 0;
+                break;
+            case 8:
+                f.op.vm.max_altstack_items = 0;
+                break;
+            case 9:
+                f.op.vm.max_vm_bytes = 0;
+                break;
+            case 10:
+                f.op.vm.max_ast_depth = 0;
+                break;
+            case 11:
+                f.op.vm.max_steps = 0;
+                break;
+            case 12:
+                f.op.dust_limit = 0;
+                break;
+        }
+        const auto path = FreshPath();
+        DiskStateStore out;
+        std::string error;
+        Check(!f.Open(path, out, error),
+              "invalid development profile accepted");
+        const auto reason = mutation <= 2 || mutation == 12
+                                ? "ordinary profile resource limits"
+                            : mutation == 3 ? "dust mismatch"
+                                            : "VM profile limits";
+        Check(error.find(reason) != std::string::npos,
+              "unexpected profile rejection: " + error);
+        Check(!out.IsOpen() && !std::filesystem::exists(path),
+              "invalid profile created database path");
+    }
+}
 void BlankRetry() {
     Fixture f(false);
     const auto path = FreshPath();
@@ -236,6 +300,7 @@ int main() {
         CheckValid(true);
         CheckValid(false);
         InvalidBeforeOpen();
+        InvalidProfilesBeforeOpen();
         BlankRetry();
         std::cout << "development chain initialization checks passed\n";
         return 0;
-- 
