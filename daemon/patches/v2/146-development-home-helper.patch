From 58a6d4fad3f38e75468b676cfec0f56ba7326804 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:48:51 -0700
Subject: [PATCH] Reuse isolated development home checks for explicit runtime
 callers

Expose the existing development namespace marker and directory checks independently of opening the offline V2 store. Runtime callers can supply explicit V4 creation options after the same unrelated-file, symlink and identity guards. Preserve the legacy command marker and checks; no migration or network selection is introduced.
---
 src/lotus_v2/development_command.cpp | 12 ++++++++++--
 src/lotus_v2/development_command.h   |  5 +++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/development_command.cpp b/src/lotus_v2/development_command.cpp
index 5c165d6d2ae4e861783a49a7bc4017b8ba7c0521..4371bf41c811168aa6157b1733df62c591367945 100644
--- a/src/lotus_v2/development_command.cpp
+++ b/src/lotus_v2/development_command.cpp
@@ -153,13 +153,21 @@ bool LoadDevelopmentManifest(const std::string &manifest_path,
         out = std::move(candidate); error.clear(); return true;
     } catch (const std::exception &e) { error = e.what(); return false; }
 }
+bool PrepareDevelopmentHomeDirectory(const DevelopmentManifest &m,
+    const std::string &home, std::string &directory, std::string &error) {
+    try {
+        auto candidate = Namespace(home, "Lotus V2 development command 1\n" + Hex(m.hp.chain_id) + "\n" +
+            Hex(m.hp.genesis_id) + "\n" + Hex(BlockValidationProfileDigest(m.hp,m.op,m.mp,m.cp)) + "\n");
+        directory = std::move(candidate); error.clear(); return true;
+    } catch (const std::exception &e) { error = e.what(); return false; }
+}
 bool OpenDevelopmentHome(const std::string &manifest_path, const std::string &home,
     DevelopmentManifest &out, DiskStateStore &store, std::string &error) {
     try {
         DevelopmentManifest m;
         if (!LoadDevelopmentManifest(manifest_path, m, error)) return false;
-        const auto directory = Namespace(home, "Lotus V2 development command 1\n" + Hex(m.hp.chain_id) + "\n" +
-            Hex(m.hp.genesis_id) + "\n" + Hex(BlockValidationProfileDigest(m.hp,m.op,m.mp,m.cp)) + "\n");
+        std::string directory;
+        if (!PrepareDevelopmentHomeDirectory(m, home, directory, error)) return false;
         DiskStateStore candidate;
         if (!OpenDevelopmentChain(directory,m.genesis,m.hp,m.op,m.mp,m.cp,m.initial,{},candidate,error))
             return false;
diff --git a/src/lotus_v2/development_command.h b/src/lotus_v2/development_command.h
index 016a1dcf461f8bf42624d5fa86041f0cebef2e0f..15874d6e0de7db2032399af95b24080a13da2e46 100644
--- a/src/lotus_v2/development_command.h
+++ b/src/lotus_v2/development_command.h
@@ -14,6 +14,11 @@ struct DevelopmentManifest {
 // changes only on success. No network parameters or defaults are supplied.
 bool LoadDevelopmentManifest(const std::string &manifest_path,
     DevelopmentManifest &out, std::string &error);
+// Prepare/check the isolated development home marker and return its chainstate
+// subdirectory. Reject unrelated files, symlinks and mismatched identities using
+// the same rules as the offline command. Does not open or migrate storage.
+bool PrepareDevelopmentHomeDirectory(const DevelopmentManifest &manifest,
+    const std::string &home, std::string &directory, std::string &error);
 // Reuses the offline command's strict manifest and isolated namespace checks.
 // Caller supplies the home explicitly and serializes its access. A fresh home
 // is initialized; existing homes must match. Outputs change only on success.
-- 
