From 49fdc884860b08e9036c66a02a38f5bcd4c729be Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 11:51:51 -0700
Subject: [PATCH] Distinguish retained candidate bodies from accepted blocks in
 downloads

Add an explicit RetainedAuthenticated body disposition and download event for bounded candidate-byte storage. Finishing a download releases its staging lease without claiming contextual block validation or active-chain mutation. Full and compact mocked download regressions preserve exact bytes, release the lease, and ignore duplicate replies without emitting Accepted. Root strict standalone Debug download suite passes.
---
 src/lotus_v2/peer_download.cpp      |  3 +++
 src/lotus_v2/peer_download.h        | 10 ++++++++--
 src/lotus_v2/test_peer_download.cpp | 24 ++++++++++++++++++++++++
 3 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/peer_download.cpp b/src/lotus_v2/peer_download.cpp
index 39ab92e2c..95744fc75 100644
--- a/src/lotus_v2/peer_download.cpp
+++ b/src/lotus_v2/peer_download.cpp
@@ -509,6 +509,9 @@ struct DownloadManager::Impl {
             case BodyDisposition::Accepted:
                 kind = DownloadResult::Accepted;
                 break;
+            case BodyDisposition::RetainedAuthenticated:
+                kind = DownloadResult::RetainedAuthenticated;
+                break;
             case BodyDisposition::MalformedBody:
                 kind = DownloadResult::PeerMessageInvalid;
                 break;
diff --git a/src/lotus_v2/peer_download.h b/src/lotus_v2/peer_download.h
index 288ddb543..91ed0cd49 100644
--- a/src/lotus_v2/peer_download.h
+++ b/src/lotus_v2/peer_download.h
@@ -33,7 +33,10 @@ enum class BodyDisposition {
     CapacityRefused,
     Unsupported,
     StorageError,
-    ContextChanged
+    ContextChanged,
+    // Complete authenticated bytes retained for later contextual validation.
+    // No active-chain/state change or consensus acceptance is implied.
+    RetainedAuthenticated
 };
 struct BodyDecision {
     BodyDisposition disposition;
@@ -87,6 +90,8 @@ struct DownloadCallbacks {
     // Synchronous, borrowed full bytes under a live lease. Accepted must mean
     // the enclosing validator's intended atomic admission completed. No pointer
     // survives this callback unless the enclosing runtime separately owns it.
+    // A candidate pool must return RetainedAuthenticated, never Accepted. It
+    // must reserve its own resident allowance while this staging lease is live.
     std::function<BodyDecision(std::span<const uint8_t>, uint64_t)> admit_body;
 };
 enum class DownloadResult {
@@ -105,7 +110,8 @@ enum class DownloadResult {
     RetryElsewhere,
     Cancelled,
     Ignored,
-    Busy
+    Busy,
+    RetainedAuthenticated
 };
 enum class FallbackReason {
     Reconstruction,
diff --git a/src/lotus_v2/test_peer_download.cpp b/src/lotus_v2/test_peer_download.cpp
index d000d205e..56affbcf6 100644
--- a/src/lotus_v2/test_peer_download.cpp
+++ b/src/lotus_v2/test_peer_download.cpp
@@ -477,6 +477,29 @@ void DeferredRecovery() {
           expire.reserves == 0);
     CHECK(deferred.Stats().jobs == 0);
 }
+void RetainedCandidateIsNotAccepted() {
+    for (auto mode : {DownloadMode::Full, DownloadMode::Compact}) {
+        Harness h;
+        h.body = BodyDisposition::RetainedAuthenticated;
+        auto b = Block(h.config);
+        h.cache = {b.transactions[1], b.transactions[2]};
+        DownloadManager m(h.config, h.Callbacks());
+        const auto peer = h.Peer(m);
+        CHECK(m.RequestBlock(peer, b.header, mode, 0).result ==
+              DownloadResult::Requested);
+        const auto message = mode == DownloadMode::Full ? Full(h.config, b)
+                                                       : Compact(h.config, b);
+        const auto event = m.OnMessage(peer, message, 1);
+        CHECK(event.result == DownloadResult::RetainedAuthenticated);
+        CHECK(event.result != DownloadResult::Accepted);
+        CHECK(event.admission == BodyDisposition::RetainedAuthenticated);
+        CHECK(h.admitted.size() == 1 && h.admitted[0] == Full(h.config, b).payload);
+        CHECK(m.Stats().jobs == 0 && h.live == 0 && h.releases == 1);
+        CHECK(m.OnMessage(peer, message, 2).result == DownloadResult::Ignored);
+        CHECK(h.admissions == 1);
+        h.Clean(m);
+    }
+}
 void OutcomesAndExceptions() {
     for (auto disposition :
          {BodyDisposition::Accepted, BodyDisposition::MalformedBody,
@@ -870,6 +893,7 @@ int main() {
     TimeCancelReorg();
     DeferredRecovery();
     OutcomesAndExceptions();
+    RetainedCandidateIsNotAccepted();
     QuotasAndControl();
     Configuration();
     CapacityFallbackAndInvalidResponses();
