diff --git a/src/lotus_v2/deferred_checks.cpp b/src/lotus_v2/deferred_checks.cpp
index e9a15ea6197f1ae35ba1a80f3e8fe865b0d3dd2c..932fc7930d0e12144803502466713cb04ad93ad1 100644
--- a/src/lotus_v2/deferred_checks.cpp
