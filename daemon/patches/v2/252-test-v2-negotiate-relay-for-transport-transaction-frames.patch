From 01b29a7b127028b7cc77be374c65c86aa257325d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:46:50 -0700
Subject: [PATCH] test(v2): negotiate relay for transport transaction frames

Explicitly advertise transaction relay in both local session config and mock peer hello because transport budget tests receive tx application frames. The former mandatory-only handshake correctly caused session rejection before the timer assertion.

Before: both native LLVM 23 and standalone AppleClang 21 fail the zero-I/O timer assertion after unnegotiated tx rejection. After: the full AppleClang 21 Debug transport suite passes.
---
 src/lotus_v2/test_peer_transport.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/lotus_v2/test_peer_transport.cpp b/src/lotus_v2/test_peer_transport.cpp
index 3449e8cf9b14f8c5d5264524f7a933689403e4e5..60a9f1736d1d43ef0be381fe60102d23a1af7e16 100644
--- a/src/lotus_v2/test_peer_transport.cpp
+++ b/src/lotus_v2/test_peer_transport.cpp
@@ -30,6 +30,8 @@ SessionConfig Config() {
     c.local_version.relay = true;
     c.local_version.extra_entropy = 43;
     c.handshake_timeout_ms = 1000;
+    // These transport tests carry tx application frames after the handshake.
+    c.supported_features |= TRANSACTION_RELAY_FEATURE;
     return c;
 }
 TransportLimits Limits() {
@@ -60,6 +62,7 @@ Bytes Handshake() {
     h.genesis_id = c.network.genesis_id;
     h.profile_digest = c.network.profile_digest;
     h.receive_limit = c.network.receive_limit;
+    h.supported = c.supported_features;
     CHECK(EncodeHello(h, hello, error));
     Bytes result;
     for (const auto &m : std::vector<Message>{
