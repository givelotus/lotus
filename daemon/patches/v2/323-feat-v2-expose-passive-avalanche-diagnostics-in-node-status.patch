@@ -1945,8 +2023,15 @@ namespace {
         return false;
     }
     // END INITIAL DOWNLOAD POLICY
-    void Node::ClosePeer(ConnectionId id) {
-        if (avalanche) avalanche->Disconnect(id);
+    ava::DisconnectCause Node::ConnectionDisconnectCause(ConnectionId id) const {
+        for (const auto &c : connections)
+            if (c->id == id && c->transport)
