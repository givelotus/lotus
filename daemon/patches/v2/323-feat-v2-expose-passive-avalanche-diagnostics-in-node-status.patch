+        return ava::DisconnectCause::Unknown;
+    }
+    void Node::ClosePeer(ConnectionId id, ava::DisconnectCause cause) {
+        if (cause == ava::DisconnectCause::Unknown) cause = ConnectionDisconnectCause(id);
+        if (avalanche) avalanche->Disconnect(id, cause);
         avalanche_peers.erase(id);
         avalanche_activations.erase(id);
         pending_headers.erase(id);
@@ -2025,7 +2110,7 @@ namespace {
         for (auto it = avalanche_peers.begin(); it != avalanche_peers.end();) {
             const auto f = dispatcher->ActiveFeatures(*it);
             if (!f || !(*f & AVALANCHE_FEATURE)) {
-                avalanche->Disconnect(*it);
+                avalanche->Disconnect(*it, ConnectionDisconnectCause(*it));
                 it = avalanche_peers.erase(it);
             } else ++it;
         }
@@ -2035,8 +2120,13 @@ namespace {
             std::string error;
             const auto r = avalanche->Activate(*it, error);
             if (r == ava::PeerResult::Backpressure) { ++it; continue; }
-            if(r==ava::PeerResult::UnknownPeer || r==ava::PeerResult::Rejected) {
-                const auto id=*it;++it;ClosePeer(id);continue;
+            if (r == ava::PeerResult::Rejected) {
+                const auto id = *it; ++it;
+                ClosePeer(id, ava::DisconnectCause::NegotiatedCapacity);
+                continue;
+            }
+            if (r == ava::PeerResult::UnknownPeer) {
+                const auto id = *it; ++it; ClosePeer(id); continue;
             }
             Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
             avalanche_peers.insert(*it);
@@ -2082,11 +2172,11 @@ namespace {
             if (!limit) return true;
             std::vector<Inventory> items, tx, proof;
             std::string error;
-            if (!DecodeInventory(message.payload, *limit, items, error)) { ClosePeer(notice.connection); return true; }
+            if (!DecodeInventory(message.payload, *limit, items, error)) { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
             for (const auto &i : items) {
                 if (i.type == 1) tx.push_back(i);
                 else if (i.type == PROOF_INVENTORY_TYPE) proof.push_back(i);
-                else { ClosePeer(notice.connection); return true; }
+                else { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
             }
             if (!tx.empty()) {
                 Bytes bytes;
@@ -2106,7 +2196,7 @@ namespace {
         // exactly once even if Avalanche's outgoing action queue is saturated.
         if (transaction) {
             auto result = relay->Handle(notice.connection.value, *transaction, now);
-            if (result.invalid_peer) { ClosePeer(notice.connection); return true; }
+            if (result.invalid_peer) { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
             RelayActions(std::move(result), now);
         }
         if (!notice.application) return true;
@@ -2115,14 +2205,21 @@ namespace {
         if (avalanche_activations.contains(notice.connection)) {
             const auto r = avalanche->Activate(notice.connection, error);
             if (r == ava::PeerResult::Backpressure) { pending_avalanche_notice = std::move(notice); return false; }
-            if(r==ava::PeerResult::UnknownPeer || r==ava::PeerResult::Rejected) {ClosePeer(notice.connection);return true;}
+            if (r == ava::PeerResult::Rejected) {
+                // Activation rejection comes from the hello's negotiated byte cap.
+                ClosePeer(notice.connection, ava::DisconnectCause::NegotiatedCapacity);
+                return true;
+            }
+            if (r == ava::PeerResult::UnknownPeer) { ClosePeer(notice.connection); return true; }
             Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
             avalanche_peers.insert(notice.connection);
             avalanche_activations.erase(notice.connection);
         }
         const auto result = avalanche->Handle(notice, now, error);
         if (result == ava::PeerResult::Backpressure) { pending_avalanche_notice = std::move(notice); return false; }
-        if (result == ava::PeerResult::Rejected || result == ava::PeerResult::UnknownPeer) ClosePeer(notice.connection);
+        if (result == ava::PeerResult::Rejected)
+            ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected);
+        else if (result == ava::PeerResult::UnknownPeer) ClosePeer(notice.connection);
         else if (result == ava::PeerResult::LocalFailure) {
             // Runtime may be temporarily nonauthoritative during bounded
             // recovery. Keep the exact notice until a later loop retries it.
@@ -2161,7 +2258,7 @@ namespace {
             }
             if (notice->kind == DispatcherNoticeKind::HeadersComplete) pending_headers.erase(notice->connection);
             if (notice->kind == DispatcherNoticeKind::Closed) {
-                if (avalanche) avalanche->Disconnect(notice->connection);
+                if (avalanche) avalanche->Disconnect(notice->connection, ConnectionDisconnectCause(notice->connection));
                 avalanche_peers.erase(notice->connection);
                 avalanche_activations.erase(notice->connection);
                 pending_headers.erase(notice->connection);
