+            responses(UniValue::VOBJ), actions(UniValue::VOBJ);
+        poll.pushKV("queries_created", polls.queries_created);
+        poll.pushKV("queries_expired", polls.queries_expired);
+        poll.pushKV("queries_cancelled", polls.queries_cancelled);
+        poll.pushKV("responses_matched", polls.responses_matched);
+        poll.pushKV("responses_applied", polls.responses_applied);
+        poll.pushKV("responses_ignored", polls.responses_ignored);
+        poll.pushKV("responses_rejected", polls.responses_rejected);
+        poll.pushKV("responses_local_failure", polls.responses_local_failure);
+        poll.pushKV("live_queries", polls.live_queries);
+        poll.pushKV("live_records", polls.live_records);
+        responses.pushKV("responses_applied", peer.responses_applied);
+        responses.pushKV("responses_ignored", peer.responses_ignored);
+        responses.pushKV("responses_rejected", peer.responses_rejected);
+        responses.pushKV("responses_local_failure", peer.responses_local_failure);
+        responses.pushKV("dead_applications", peer.dead_applications);
+        constexpr std::array rejection_names{
+            "signature", "framing", "content",
+            "late_response_abuse", "discovery_cooldown", "proof_cooldown",
+            "negotiated_capacity", "payload_capacity", "other"};
+        static_assert(rejection_names.size() == static_cast<size_t>(ava::PeerRejection::Count));
+        UniValue rejected(UniValue::VOBJ);
+        for (size_t i = 0; i < rejection_names.size(); ++i)
+            rejected.pushKV(rejection_names[i], peer.application_rejections[i]);
+        responses.pushKV("application_rejections", rejected);
+        actions.pushKV("poll_actions_queued", driver.poll_actions_queued);
+        actions.pushKV("poll_backpressure", driver.poll_backpressure);
+        actions.pushKV("poll_dead_targets", driver.poll_dead_targets);
+        actions.pushKV("poll_capacity_rejected", driver.poll_capacity_rejected);
+        actions.pushKV("discovery_dead_targets", driver.discovery_dead_targets);
+        actions.pushKV("discovery_capacity_rejected", driver.discovery_capacity_rejected);
+        actions.pushKV("dispatch_dead_targets", driver.dispatch_dead_targets);
+        actions.pushKV("dispatch_local_failures", driver.dispatch_local_failures);
+        actions.pushKV("dead_applications", driver.dead_applications);
+        actions.pushKV("applications_local_failure", driver.applications_local_failure);
+        actions.pushKV("disconnects", driver.disconnects);
+        constexpr std::array cause_names{
+            "unknown", "application_rejected", "dead_target",
+            "negotiated_capacity", "transport_requested", "transport_end_of_stream",
+            "transport_stream_error", "transport_stream_contract", "transport_peer_rejected",
+            "transport_local_failure", "transport_capacity", "transport_timed_out"};
+        static_assert(cause_names.size() == static_cast<size_t>(ava::DisconnectCause::Count));
+        UniValue closed(UniValue::VOBJ);
+        for (size_t i = 0; i < cause_names.size(); ++i)
+            closed.pushKV(cause_names[i], driver.disconnect_causes[i]);
+        actions.pushKV("disconnect_causes", closed);
+        out.pushKV("polls", poll);
+        out.pushKV("peer", responses);
+        out.pushKV("diagnostics", actions);
+        if (confidence) out.pushKV("tip_confidence", uint64_t(*confidence));
+        else out.pushKV("tip_confidence", UniValue());
+        return out;
+    }
+    ava::DisconnectCause TransportDisconnectCause(TransportClose reason) {
+        switch (reason) {
+            case TransportClose::None: return ava::DisconnectCause::Unknown;
+            case TransportClose::Requested: return ava::DisconnectCause::TransportRequested;
+            case TransportClose::EndOfStream: return ava::DisconnectCause::TransportEndOfStream;
+            case TransportClose::StreamError: return ava::DisconnectCause::TransportStreamError;
+            case TransportClose::StreamContract: return ava::DisconnectCause::TransportStreamContract;
+            case TransportClose::PeerRejected: return ava::DisconnectCause::TransportPeerRejected;
+            case TransportClose::LocalFailure: return ava::DisconnectCause::TransportLocalFailure;
+            case TransportClose::Capacity: return ava::DisconnectCause::TransportCapacity;
+            case TransportClose::TimedOut: return ava::DisconnectCause::TransportTimedOut;
+        }
+        return ava::DisconnectCause::Unknown;
+    }
     UniValue ReadJson(const std::string &path) {
         std::ifstream f(path, std::ios::binary | std::ios::ate);
         Require(bool(f), "cannot open network file");
@@ -689,7 +763,8 @@ namespace {
         bool InitialDownload(uint64_t);
         void TickAvalanche(uint64_t, uint64_t);
         bool HandleApplication(DispatcherNotice, uint64_t);
-        void ClosePeer(ConnectionId);
+        ava::DisconnectCause ConnectionDisconnectCause(ConnectionId) const;
+        void ClosePeer(ConnectionId, ava::DisconnectCause = ava::DisconnectCause::Unknown);
         std::unique_ptr<PoolCoordinator> pool;
         std::unique_ptr<TransactionRelay> relay;
         std::set<ConnectionId> relay_peers;
@@ -1093,6 +1168,8 @@ namespace {
             status.pushKV("eligible_peer_count", a.eligible_peer_count);
             status.pushKV("active_stake_score", a.active_stake_score);
             status.pushKV("connected_stake_score", a.connected_stake_score);
+            status.pushKVs(AvalancheDiagnosticsJson(a.polls, a.peer, a.diagnostics,
