+#!/usr/bin/env python3
+"""Generate a narrow test of actual passive Node JSON/cause functions.
+
+This checks the serialized schema and Node::Status source wiring. It does not
+instantiate a node or execute the full Node::Status method.
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+from check_block_chunk_command import extract
+
+
+def emit(node_source, output):
+    source = node_source.read_text()
+    status = extract(source, "UniValue Node::Status()")
+    wiring = "status.pushKVs(AvalancheDiagnosticsJson(a.polls, a.peer, a.diagnostics,"
+    assert status.count(wiring) == 1 and "a.tip_confidence));" in status, (
+        "Node::Status must insert the actual diagnostics serializer result")
+    application = extract(source, "bool Node::HandleApplication(")
+    tick = extract(source, "void Node::TickAvalanche(")
+    assert "if (result == ava::PeerResult::Rejected)\n            ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected);" in application, (
+        "Definitive application rejection must retain its explicit close cause")
+    assert "ClosePeer(notice.connection, ava::DisconnectCause::NegotiatedCapacity);" in application and (
+        "ClosePeer(id, ava::DisconnectCause::NegotiatedCapacity);" in tick), (
+        "Both activation rejection paths must retain their negotiated-capacity cause")
+    helper = extract(source, "UniValue AvalancheDiagnosticsJson(")
+    mapping = extract(source, "ava::DisconnectCause TransportDisconnectCause(")
+    polls = ["queries_created", "queries_expired", "queries_cancelled", "responses_matched",
+             "responses_applied", "responses_ignored", "responses_rejected",
+             "responses_local_failure", "live_queries", "live_records"]
+    peer = ["responses_applied", "responses_ignored", "responses_rejected",
+            "responses_local_failure", "dead_applications"]
+    driver = ["poll_actions_queued", "poll_backpressure", "poll_dead_targets",
+              "poll_capacity_rejected", "discovery_dead_targets", "discovery_capacity_rejected",
+              "dispatch_dead_targets", "dispatch_local_failures", "dead_applications",
+              "applications_local_failure", "disconnects"]
+    rejections = [("Signature", "signature"), ("Framing", "framing"), ("Content", "content"),
+                  ("LateResponseAbuse", "late_response_abuse"),
+                  ("DiscoveryCooldown", "discovery_cooldown"), ("ProofCooldown", "proof_cooldown"),
+                  ("NegotiatedCapacity", "negotiated_capacity"),
+                  ("PayloadCapacity", "payload_capacity"), ("Other", "other")]
+    causes = [("Unknown", "unknown"), ("ApplicationRejected", "application_rejected"),
+              ("DeadTarget", "dead_target"), ("NegotiatedCapacity", "negotiated_capacity"),
+              ("TransportRequested", "transport_requested"),
+              ("TransportEndOfStream", "transport_end_of_stream"),
+              ("TransportStreamError", "transport_stream_error"),
+              ("TransportStreamContract", "transport_stream_contract"),
+              ("TransportPeerRejected", "transport_peer_rejected"),
+              ("TransportLocalFailure", "transport_local_failure"),
+              ("TransportCapacity", "transport_capacity"), ("TransportTimedOut", "transport_timed_out")]
+    code = '''#include <lotus_v2/avalanche_diagnostics.h>
+#include <lotus_v2/peer_transport.h>
+#include <univalue.h>
+#include <iostream>
+#include <optional>
+#include <stdexcept>
+namespace ava = lotus::v2::ava;
+using lotus::v2::peer::TransportClose;
+void Check(bool value, const char *error) {
+    if (!value) throw std::runtime_error(error);
+}
+'''+helper+'\n'+mapping+'''
+int main() {
+    try {
+        ava::PollDiagnostics polls;
+        ava::PeerDiagnostics peer;
+        ava::DriverDiagnostics driver;
+'''
+    expected = []
+    value = 1
+    for layer, fields, path in (("polls", polls, ["polls"]),
+                                ("peer", peer, ["peer"]),
+                                ("driver", driver, ["diagnostics"])):
+        for field in fields:
+            code += f"        {layer}.{field} = {value};\n"
+            expected.append((path+[field], value))
+            value += 1
+    for enum, key in rejections:
+        code += f"        peer.application_rejections[static_cast<size_t>(ava::PeerRejection::{enum})] = {value};\n"
+        expected.append((["peer", "application_rejections", key], value))
+        value += 1
+    for enum, key in causes:
+        code += f"        driver.disconnect_causes[static_cast<size_t>(ava::DisconnectCause::{enum})] = {value};\n"
+        expected.append((["diagnostics", "disconnect_causes", key], value))
+        value += 1
+    code += '''        const auto original_polls = polls;
+        const auto original_peer = peer;
+        const auto original_driver = driver;
+        std::optional<uint16_t> confidence;
+        const auto emitted = AvalancheDiagnosticsJson(polls, peer, driver, confidence);
+        UniValue result;
+        Check(result.read(emitted.write()), "serialized JSON round trip");
+        Check(result.size() == 4 && result["polls"].size() == 10 &&
+                  result["peer"].size() == 6 && result["diagnostics"].size() == 12 &&
+                  result["peer"]["application_rejections"].size() == 9 &&
+                  result["diagnostics"]["disconnect_causes"].size() == 12,
+              "exact bounded JSON schema");
+'''
+    for path, value in expected:
+        access = "result"+"".join("["+json.dumps(part)+"]" for part in path)
+        code += f'        Check({access}.isNum() && {access}.getValStr() == "{value}", "distinct counter mapping");\n'
+    code += '''        Check(result["tip_confidence"].isNull(), "unavailable confidence is null");
+        confidence = 0;
+        const auto zero = AvalancheDiagnosticsJson(polls, peer, driver, confidence);
+        Check(zero["tip_confidence"].isNum() && zero["tip_confidence"].getValStr() == "0",
+              "zero confidence is distinct from unavailable");
+        confidence = UINT16_MAX;
+        const auto confidence_maximum = AvalancheDiagnosticsJson(polls, peer, driver, confidence);
+        Check(confidence_maximum["tip_confidence"].isNum() &&
+                  confidence_maximum["tip_confidence"].getValStr() == "65535",
+              "confidence width preserved");
+        Check(polls == original_polls && peer == original_peer && driver == original_driver,
+              "serialization cannot mutate counters or gauges");
+        polls.queries_created = UINT64_MAX;
+        peer.application_rejections[static_cast<size_t>(ava::PeerRejection::Signature)] = UINT64_MAX;
+        driver.disconnect_causes[static_cast<size_t>(ava::DisconnectCause::Unknown)] = UINT64_MAX;
+        const auto maximum_emitted = AvalancheDiagnosticsJson(polls, peer, driver, confidence);
+        UniValue maximum;
+        Check(maximum.read(maximum_emitted.write()), "saturated JSON round trip");
+        Check(maximum["polls"]["queries_created"].getValStr() == "18446744073709551615" &&
+                  maximum["peer"]["application_rejections"]["signature"].getValStr() == "18446744073709551615" &&
+                  maximum["diagnostics"]["disconnect_causes"]["unknown"].getValStr() == "18446744073709551615",
+              "saturated counters remain exact JSON integers");
+'''
+    for transport, cause in [("None", "Unknown"), ("Requested", "TransportRequested"),
+                              ("EndOfStream", "TransportEndOfStream"), ("StreamError", "TransportStreamError"),
+                              ("StreamContract", "TransportStreamContract"), ("PeerRejected", "TransportPeerRejected"),
+                              ("LocalFailure", "TransportLocalFailure"), ("Capacity", "TransportCapacity"),
+                              ("TimedOut", "TransportTimedOut")]:
+        code += f'        Check(TransportDisconnectCause(TransportClose::{transport}) == ava::DisconnectCause::{cause}, "actual transport close cause mapping");\n'
+    code += '''        std::cout << "passive Avalanche JSON schema and close mapping passed\\n";
+        return 0;
+    } catch (const std::exception &error) {
+        std::cerr << error.what() << '\\n';
+        return 1;
+    }
+}
+'''
+    output.write_text(code)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("node_source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    emit(args.node_source, args.output)
+
+
+if __name__ == "__main__":
+    main()
-- 
