From 263731b0c54efdaceb47507d59395506fd4203d9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:30:02 -0700
Subject: [PATCH] Reuse authenticated mint input count across transaction
 invocations

Review correction: Reuse authenticated mint input count across transaction invocations.

This isolated V2 candidate change preserves the existing Bitcoin parser and
mainnet parameters. Module tests do not establish lotusd block acceptance.
---
 src/lotus_v2/vm.cpp | 5 ++++-
 src/lotus_v2/vm.h   | 2 ++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
index ca27eba3ce7455477a780a45eb7ee725fe359593..2477251bc5cb89d0b571e0607603557988681bc1 100644
--- a/src/lotus_v2/vm.cpp
+++ b/src/lotus_v2/vm.cpp
@@ -1511,7 +1511,8 @@ namespace {
             : code(code), profile(profile), input_count(input_count),
               output_count(output_count), context(context),
               prepared_signing(prepared_signing), active_script(script),
-              mint_count(context ? std::count_if(
+              mint_count(context && context->prepared ? context->prepared->MintCount() :
+                         context ? std::count_if(
                                        context->tx.inputs.begin(),
                                        context->tx.inputs.end(),
                                        [](const Input &input) {
@@ -1559,6 +1560,8 @@ bool PreparedVmTransaction::Prepare(const Transaction &tx, const TxProfile &prof
     chain_ = chain;
     coins_ = coins;
     cost_ = cost;
+    mint_count_ = std::count_if(tx_.inputs.begin(), tx_.inputs.end(),
+        [](const Input &input) { return input.flags == 3; });
     VM_COUNT_PREPARATION(signing);
     if (!PrepareSigningContext(tx_, profile_, chain_, coins_, signing_, error)) return false;
     const auto context = Invocation(0, 0);
diff --git a/src/lotus_v2/vm.h b/src/lotus_v2/vm.h
index da7892585dc25023c3c721214240f4f38e44daae..fd4ccd937a6514472463ae842075f6aae32c4e21 100644
--- a/src/lotus_v2/vm.h
+++ b/src/lotus_v2/vm.h
@@ -91,6 +91,7 @@ public:
         return found == field_maxima_.end() ? 0 : found->second;
     }
     size_t MaxFieldBound() const { return max_field_bound_; }
+    size_t MintCount() const { return mint_count_; }
     const PreparedSigningContext &Signing() const { return signing_; }
     bool Owns(const VmExecutionContext &context) const {
         return ready_ && &context.tx == &tx_ && &context.tx_profile == &profile_ &&
@@ -105,6 +106,7 @@ private:
     PreparedSigningContext signing_;
     std::map<uint8_t, size_t> field_maxima_;
     size_t max_field_bound_ = 0;
+    size_t mint_count_ = 0;
     bool ready_ = false;
 };
 
