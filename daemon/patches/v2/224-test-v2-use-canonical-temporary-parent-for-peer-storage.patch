From f454734ff9618665aa56aea5df14df3d5faba21e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:39:40 -0700
Subject: [PATCH] test(v2): use canonical temporary parent for peer storage

---
 src/lotus_v2/avalanche_peer_store.h        | 2 ++
 src/lotus_v2/test_avalanche_peer_store.cpp | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/avalanche_peer_store.h b/src/lotus_v2/avalanche_peer_store.h
index 25397c75f4a52f093e1fc5a3644cf4fdc543a026..8e440650b27e9c88d124ab23c78da9b379ff8557 100644
--- a/src/lotus_v2/avalanche_peer_store.h
+++ b/src/lotus_v2/avalanche_peer_store.h
@@ -9,6 +9,8 @@ struct PeerStoreResult { PeerStoreCode code{PeerStoreCode::Ok}; std::string mess
 struct PeerStoreLimits {
     uint64_t payload_bytes{16 << 20}, records{10000}, proof_bytes{256 << 10}, locks_per_proof{1000}, payout_bytes{10000};
 };
+// Paths must have real directory ancestors (including /private/tmp on macOS);
+// symlink ancestors and parent traversal are rejected. Use one serialized owner.
 // Public proofs and peer metadata only. Load validates storage framing, never
 // chain validity: callers re-admit records individually and may skip stale proofs
 // just as pinned ABC loadPeersFromFile does. No session/finality tip is stored.
diff --git a/src/lotus_v2/test_avalanche_peer_store.cpp b/src/lotus_v2/test_avalanche_peer_store.cpp
index c880b6524e7567c8e846c05191a642c86e8c1c6e..24ff17952e3fb0572175b6501b0fb49de76caa72 100644
--- a/src/lotus_v2/test_avalanche_peer_store.cpp
+++ b/src/lotus_v2/test_avalanche_peer_store.cpp
@@ -17,7 +17,7 @@ using namespace lotus::v2::ava;
 int main() {
     ECC_Start();
     struct ECCCleanup { ~ECCCleanup(){ECC_Stop();} } ecc_cleanup;
-    char pattern[]="/tmp/lotus-ava-store-XXXXXX"; auto dir=mkdtemp(pattern); BOOST_REQUIRE(dir);
+    auto pattern=(std::filesystem::canonical(std::filesystem::temp_directory_path())/"lotus-ava-store-XXXXXX").string(); auto dir=mkdtemp(pattern.data()); BOOST_REQUIRE(dir);
     struct Cleanup { std::filesystem::path p; ~Cleanup(){std::filesystem::remove_all(p);} } cleanup{dir};
     auto path=cleanup.p/"peers";
     Profile profile; profile.chain_id[0]=1;profile.genesis_id[0]=2;profile.validation_digest[0]=3;
-- 
