From e05d011bb8aad40f2bff1396f9da4f1c607a658b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:27:31 -0700
Subject: [PATCH] Build V2 peer codecs with the full daemon dependencies

Expose the parameterized codec library without enabling sockets or selecting network constants. Full-tree Debug check-lotus-v2-peer-codec and disk suites pass. Synthetic collision injection remains confined to the standalone test target; production library and full-tree check use real short IDs.
---
 src/lotus_v2/CMakeLists.txt | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 2fbebceaa4303c6bab8a718900c16d4ed5d283bb..42a2065966493f5240622c54420a650759082c5b 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -152,3 +152,15 @@ add_custom_target(check-lotus-v2-disk
     COMMAND $<TARGET_FILE:test_lotus_v2_disk_block>
     COMMAND $<TARGET_FILE:test_lotus_v2_disk_state>
     DEPENDS test_lotus_v2_disk_block test_lotus_v2_disk_state)
+
+# Parameterized TCP/compact codecs. No socket, handshake or chain activation.
+# The synthetic collision override is confined to the standalone test project.
+add_library(lotus_v2_peer_codec STATIC peer_codec.cpp)
+target_include_directories(lotus_v2_peer_codec PRIVATE ..)
+target_link_libraries(lotus_v2_peer_codec PUBLIC lotus_v2_validation crypto)
+add_executable(test_lotus_v2_peer_codec test_peer_codec.cpp)
+target_include_directories(test_lotus_v2_peer_codec PRIVATE ..)
+target_link_libraries(test_lotus_v2_peer_codec PRIVATE lotus_v2_peer_codec)
+add_custom_target(check-lotus-v2-peer-codec
+    COMMAND $<TARGET_FILE:test_lotus_v2_peer_codec>
+    DEPENDS test_lotus_v2_peer_codec)
-- 
