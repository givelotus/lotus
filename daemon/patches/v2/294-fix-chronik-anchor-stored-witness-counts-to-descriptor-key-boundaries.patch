From 8d92f413982b2ed3e44b2646b0b6952dba4005d4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:17:51 -0700
Subject: [PATCH] fix(chronik): anchor stored witness counts to descriptor key
 boundaries

---
 chronik/chronik-db/src/v2_explorer.rs           | 17 +++++++++++++++++
 .../chronik-indexer/src/query/v2_explorer.rs    |  4 ++--
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/chronik/chronik-db/src/v2_explorer.rs b/chronik/chronik-db/src/v2_explorer.rs
index b6ab823d605ada681d0adca853144891ccb7d85b..30cf43b3fd67af7b32a9594d0c90a637b8b858aa 100644
--- a/chronik/chronik-db/src/v2_explorer.rs
+++ b/chronik/chronik-db/src/v2_explorer.rs
@@ -624,6 +624,23 @@ impl ReadSnapshot<'_> {
         }
         let input: InputMeta = decode_record(&bytes)?;
         validate_input_meta(&input, tx.wire_size)?;
+        // A descriptor count must reach an existing final ordinal and stop at
+        // the next key. Missing interior ordinals fail when that page is read.
+        if input.witness_count > 0 {
+            let last = self
+                .inner
+                .get(witness_key(id, index, input.witness_count - 1))?
+                .ok_or(Error::Corrupt)?;
+            let last: WitnessFact = decode_record(&last)?;
+            validate_witness_fact(&last, tx.wire_size)?;
+        }
+        if self
+            .inner
+            .get(witness_key(id, index, input.witness_count))?
+            .is_some()
+        {
+            return Err(Error::Corrupt);
+        }
         if let Some(coin) = &input.resolved_creation {
             let historical = self.output(coin.outpoint)?.ok_or(Error::Corrupt)?;
             if historical.output != coin.output
diff --git a/chronik/chronik-indexer/src/query/v2_explorer.rs b/chronik/chronik-indexer/src/query/v2_explorer.rs
index a7fee0f05cdd384a7683688c3ab9a2fd2dd08e61..4186c6ac5ce87acfb06e869f2885917b5bb0bc35 100644
--- a/chronik/chronik-indexer/src/query/v2_explorer.rs
+++ b/chronik/chronik-indexer/src/query/v2_explorer.rs
@@ -231,7 +231,7 @@ pub fn inputs_page(
     let Some(tx) = source.transaction(id)? else {
         return Ok(None);
     };
-    ordinal_page(tx.input_count, after, size, 6, 14, |index| {
+    ordinal_page(tx.input_count, after, size, 6, 16, |index| {
         let input = required(source.input(id, index)?)?;
         chronik_db::v2_explorer::validate_input_meta(&input, tx.wire_size)?;
         let bytes = 256
@@ -287,7 +287,7 @@ pub fn witnesses_page(
         return Ok(None);
     }
     let input = required(source.input(id, input_index)?)?;
-    ordinal_page(input.witness_count, after, size, 20, 25, |index| {
+    ordinal_page(input.witness_count, after, size, 22, 27, |index| {
         let witness = required(source.witness(id, input_index, index)?)?;
         chronik_db::v2_explorer::validate_witness_fact(&witness, tx.wire_size)?;
         Ok((witness, 128))
-- 
