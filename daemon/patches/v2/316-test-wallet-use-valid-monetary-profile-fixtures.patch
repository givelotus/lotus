From c5923aa6cc30a59a4ab751523c1243516ac4f963 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 18:54:05 -0700
Subject: [PATCH] test(wallet): use valid monetary profile fixtures

Replace positional monetary aggregates with named fields. Order positive tail bounds, use the required 1000 byte-fee rate and bind genesis_tail to the fixture monetary state. Preserve the other fixture policy values.

Exercise public AbsoluteTail validation at the genesis work anchor so future fixture drift cannot pass without checking monetary invariants. Both focused wallet and provider suites pass.
---
 src/wallet/test/v2_wallet_tests.cpp    | 11 +++++++++--
 src/wallet/v2_provider_test/fixtures.h | 11 +++++++++--
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/src/wallet/test/v2_wallet_tests.cpp b/src/wallet/test/v2_wallet_tests.cpp
index edd52baff4c5bf8918e37395c4a1ffaaad8cee4f..6fb5c96ac63bd6d80842a9af3329f36c1098a0d6 100644
--- a/src/wallet/test/v2_wallet_tests.cpp
+++ b/src/wallet/test/v2_wallet_tests.cpp
@@ -66,11 +66,18 @@ struct Chain {
         op.vm_cost.structural_byte_cost = 1;
         for (auto &cost : op.vm_cost.opcode)
             cost.base = 1;
-        profile.monetary = {1, 1,        1000, 1,        1,
-                            1, 10000000, 1,    10000000, 10000000, 9, {}};
+        profile.monetary = {.boot_shift = 1, .tx_knee_shift = 1,
+                            .ema_shift = 1000, .ema_min = 1,
+                            .linear_shift = 1, .quad_shift = 1,
+                            .tail_min = 1, .tail_max = 10000000,
+                            .dust_limit = 10000000, .min_fee_per_kb = 1000,
+                            .genesis_tail = money.tail_subsidy,
+                            .genesis_work = {}};
         profile.costs = {1, 1, 1, 1};
         money.prev_work[0] = 2;
         profile.monetary.genesis_work = money.prev_work;
+        Check(AbsoluteTail(profile.monetary, 2) == money.tail_subsidy,
+              "valid monetary genesis anchors");
         Header genesis;
         genesis.version = hp.version;
         genesis.time = hp.genesis_time;
diff --git a/src/wallet/v2_provider_test/fixtures.h b/src/wallet/v2_provider_test/fixtures.h
index 2885db3cc7a2cf87222de46c9de5f1ccd933241e..837654db64940850d1bf7a78436df0984a54b6bc 100644
--- a/src/wallet/v2_provider_test/fixtures.h
+++ b/src/wallet/v2_provider_test/fixtures.h
@@ -63,11 +63,18 @@ struct Chain {
         op.vm_cost.structural_byte_cost = 1;
         for (auto &cost : op.vm_cost.opcode)
             cost.base = 1;
-        profile.monetary = {1, 1,        1000, 1,        1,
-                            1, 10000000, 1,    10000000, 10000000, 9, {}};
+        profile.monetary = {.boot_shift = 1, .tx_knee_shift = 1,
+                            .ema_shift = 1000, .ema_min = 1,
+                            .linear_shift = 1, .quad_shift = 1,
+                            .tail_min = 1, .tail_max = 10000000,
+                            .dust_limit = 10000000, .min_fee_per_kb = 1000,
+                            .genesis_tail = money.tail_subsidy,
+                            .genesis_work = {}};
         profile.costs = {1, 1, 1, 1};
         money.prev_work[0] = 2;
         profile.monetary.genesis_work = money.prev_work;
+        Check(AbsoluteTail(profile.monetary, 2) == money.tail_subsidy,
+              "valid monetary genesis anchors");
         Header genesis;
         genesis.version = hp.version;
         genesis.time = hp.genesis_time;
