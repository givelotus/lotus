From 8878b8686e46d57eac96e6b78b04a44dee3e4564 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:32:44 -0700
Subject: [PATCH] Exclude token amounts from native monetary accounting

Review correction: Exclude token amounts from native monetary accounting.

This isolated V2 candidate change preserves the existing Bitcoin parser and
mainnet parameters. Module tests do not establish lotusd block acceptance.
---
 src/lotus_v2/monetary.cpp      |  6 ++++--
 src/lotus_v2/test_monetary.cpp | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/monetary.cpp b/src/lotus_v2/monetary.cpp
index fcf1f7bc7895fc1d3219376a5d7c3c07987d5b49..a9ec18b9beea2a234bb583f55d206487b1b17c08 100644
--- a/src/lotus_v2/monetary.cpp
+++ b/src/lotus_v2/monetary.cpp
@@ -151,8 +151,10 @@ MonetaryOrdinaryTx AccountValidatedOrdinary(
     Int total_outputs = 0;
     for (const Output &output : tx.outputs) {
         tokens += output.HasToken() ? 1 : 0;
-        total_outputs += output.value;
-        if (output.IsBurn()) explicit_burn += output.value;
+        if (!output.HasToken()) {
+            total_outputs += output.value;
+            if (output.IsBurn()) explicit_burn += output.value;
+        }
     }
     Range(total_outputs, U128, "native output sum width");
     Range(explicit_burn, U128, "explicit native burn width");
diff --git a/src/lotus_v2/test_monetary.cpp b/src/lotus_v2/test_monetary.cpp
index 266fb95c26f2714ae4ac8209558ba98881d92bcd..24549b9e349cb615135e4f338c5648a9fc7810c9 100644
--- a/src/lotus_v2/test_monetary.cpp
+++ b/src/lotus_v2/test_monetary.cpp
@@ -160,6 +160,37 @@ void NativeTransactionAdapter() {
     Reject([&] { AccountValidatedOrdinary(tx, effects, tx_profile, P); },
            "adapter rejects coinbase");
 }
+void MixedTokenBurnAdapter() {
+    const TxProfile tx_profile{32, 32, 8, 8192, 16, 8192, 64};
+    Transaction tx;
+    Input spend;
+    spend.prev_txid[0] = 1;
+    spend.sequence = UINT32_MAX;
+    spend.flags = 1;
+    spend.witnesses = {BranchWitness{{0x4e}, {}, {}}};
+    tx.inputs = {spend};
+    Output native;
+    native.flags = 2;
+    native.value = 17;
+    native.branches = {Hash32{}};
+    Output token = native;
+    token.flags = 3;
+    token.value = 999999;
+    token.token_id[0] = 3;
+    tx.outputs = {native, token};
+    OrdinaryCandidateEffects effects;
+    effects.native_fee = 1000;
+    effects.token_output_burn_floor = 2 * P.dust_limit;
+    const auto record = AccountValidatedOrdinary(tx, effects, tx_profile, P);
+    Check(record.native_inputs == 1017 && record.native_outputs == 17 &&
+              record.explicit_native_burn == 17 && record.token_outputs == 1,
+          "token amounts never enter native accounting");
+    const auto state = State(9, 200, 9, 4);
+    const auto result =
+        AdvanceMonetary(P, state, 9, {record}, 0, 0, 0, 0, 0, 0);
+    Check(result.spendable_supply_delta == -1017,
+          "token burn does not destroy native token units");
+}
 void Vectors() {
     uint64_t r, t, w, e, work, fee, bytes, tokens, burn, payout, cb_burn;
     uint64_t cb_bytes, prefix, account, enforce;
@@ -195,6 +226,7 @@ int main(int argc, char **argv) {
         }
         HandCalculated();
         NativeTransactionAdapter();
+        MixedTokenBurnAdapter();
         std::cout << "monetary arithmetic checks passed\n";
     } catch (const std::exception &e) {
         std::cerr << e.what() << '\n';
-- 
