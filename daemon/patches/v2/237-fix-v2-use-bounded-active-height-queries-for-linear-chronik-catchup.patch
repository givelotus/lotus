From 1cbfb9a36af8319e2512d848c3b6b2b391f55389 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:51:23 -0700
Subject: [PATCH] fix(v2): use bounded active height queries for linear Chronik
 catchup

---
 src/lotus_v2/chronik_sync.cpp            | 108 ++++++++++++-----------
 src/lotus_v2/chronik_sync.h              |  18 ++--
 src/lotus_v2/chronik_sync_test/README.md |  12 +--
 src/lotus_v2/test_chronik_sync.cpp       |  18 +++-
 4 files changed, 85 insertions(+), 71 deletions(-)

diff --git a/src/lotus_v2/chronik_sync.cpp b/src/lotus_v2/chronik_sync.cpp
index 6aac713379c87ef059d11820d914df1211275548..78d4ff3301a123b23f056d927732dafd2e6fed5c 100644
--- a/src/lotus_v2/chronik_sync.cpp
+++ b/src/lotus_v2/chronik_sync.cpp
@@ -58,67 +58,73 @@ ChronikSyncResult ChronikSync::Step(std::string &error) {
             snapshot.execution_paused || snapshot.chain->pending_journal ||
             snapshot.chain->pending_receipt ||
             snapshot.chain->pending_propagation) {
-            have_fence_ = false;
-            cursor_.reset();
-            child_.reset();
             return ChronikSyncResult::Unavailable;
         }
         const auto indexed = sink_.Checkpoint();
         const auto tip = snapshot.chain->stable_tip;
-        if (!have_fence_ || tip != tip_ ||
-            snapshot.context_generation != generation_ ||
-            indexed != checkpoint_) {
-            tip_ = tip;
-            generation_ = snapshot.context_generation;
-            checkpoint_ = indexed;
-            have_fence_ = true;
-            cursor_.reset();
-            child_.reset();
-        }
-        auto read = [&](const Hash &id, std::optional<IndexedHeader> &header) {
-            return runtime_.ReadHeader(id, header, error) ==
-                       DevelopmentRuntimeResult::Progress &&
-                   header && header->stage == HeaderStage::Connected;
+        std::optional<Header> next;
+        DiskStateError failure;
+        auto headers = [&](std::span<const Hash> locator, const Hash &stop,
+                           std::vector<Header> &out) {
+            const auto result =
+                runtime_.ReadHeaders(tip, locator, stop, 1, 1, out, failure);
+            if (result != ChainIndexResult::Complete) {
+                error = failure.message.empty()
+                            ? "Chronik active header lookup unavailable"
+                            : failure.message;
+                return false;
+            }
+            return true;
         };
-        if (!cursor_ && !read(tip, cursor_)) {
-            error = "Chronik authoritative tip unavailable";
-            return ChronikSyncResult::Error;
-        }
-        const uint64_t target = indexed ? indexed->height : 0;
-        if (cursor_->header.height > target) {
-            child_ = cursor_;
-            const auto parent = cursor_->header.prev_id;
-            if (!read(parent, cursor_)) {
-                error = "Chronik active ancestry unavailable";
+        std::vector<Header> found;
+        if (indexed) {
+            // The explicit-stop query checks membership via the active height
+            // index. A missing checkpoint is divergent, never a catchup
+            // locator.
+            if (!headers({}, indexed->block_id, found))
                 return ChronikSyncResult::Error;
+            if (found.empty()) {
+                if (!indexed->height) {
+                    error = "Chronik genesis checkpoint mismatch";
+                    return ChronikSyncResult::Error;
+                }
+                sink_.Disconnect(*indexed);
+                return ChronikSyncResult::Progress;
             }
-            return ChronikSyncResult::Progress;
-        }
-        Hash cursor_id{};
-        if (!BlockId(chain_, cursor_->header, cursor_id)) {
-            error = "Chronik ancestry identity";
-            return ChronikSyncResult::Error;
-        }
-        if (indexed && (cursor_->header.height != indexed->height ||
-                        cursor_id != indexed->block_id)) {
-            if (!indexed->height) {
-                error = "Chronik genesis checkpoint mismatch";
+            if (found.front().height != indexed->height) {
+                error = "Chronik checkpoint height mismatch";
                 return ChronikSyncResult::Error;
             }
-            sink_.Disconnect(*indexed);
-            cursor_.reset();
-            child_.reset();
-            return ChronikSyncResult::Progress;
-        }
-        if (indexed && cursor_id == tip) return ChronikSyncResult::Ready;
-        const auto &next = indexed ? child_ : cursor_;
-        if (!next) {
-            error = "Chronik active child unavailable";
-            return ChronikSyncResult::Error;
+            if (indexed->block_id == tip) return ChronikSyncResult::Ready;
+            const std::array<Hash, 1> locator{indexed->block_id};
+            if (!headers(locator, {}, found)) return ChronikSyncResult::Error;
+            if (found.size() != 1 ||
+                found.front().prev_id != indexed->block_id ||
+                indexed->height == UINT64_MAX ||
+                found.front().height != indexed->height + 1) {
+                error = "Chronik active child unavailable";
+                return ChronikSyncResult::Error;
+            }
+            next = found.front();
+        } else {
+            // Unknown locator falls back to anchored genesis and returns its
+            // first child, avoiding a tip-to-genesis walk even on fresh sync.
+            const std::array<Hash, 1> locator{Hash{}};
+            if (!headers(locator, {}, found)) return ChronikSyncResult::Error;
+            const auto genesis = found.empty() ? tip : found.front().prev_id;
+            std::optional<IndexedHeader> header;
+            if (runtime_.ReadHeader(genesis, header, error) !=
+                    DevelopmentRuntimeResult::Progress ||
+                !header || header->stage != HeaderStage::Connected ||
+                header->header.height != 0) {
+                error = "Chronik authoritative genesis unavailable";
+                return ChronikSyncResult::Error;
+            }
+            next = header->header;
         }
         ChronikAnchor anchor;
-        anchor.height = next->header.height;
-        if (!BlockId(chain_, next->header, anchor.block_id))
+        anchor.height = next->height;
+        if (!BlockId(chain_, *next, anchor.block_id))
             return ChronikSyncResult::Error;
         std::vector<uint8_t> wire;
         ChronikBlock block;
@@ -131,8 +137,6 @@ ChronikSyncResult ChronikSync::Step(std::string &error) {
             sink_.Connect(block);
         else
             sink_.Initialize(block);
-        cursor_.reset();
-        child_.reset();
         return ChronikSyncResult::Progress;
     } catch (const std::exception &e) {
         error = e.what();
diff --git a/src/lotus_v2/chronik_sync.h b/src/lotus_v2/chronik_sync.h
index 75170441980d370e66e1fbac696c1177e3b68337..46fe01afd28aa8e2fcd34c112b67fd4c98c02e34 100644
--- a/src/lotus_v2/chronik_sync.h
+++ b/src/lotus_v2/chronik_sync.h
@@ -37,11 +37,14 @@ enum class ChronikSyncResult { Progress, Ready, Unavailable, Error };
 // BEFORE any runtime transition, and publish AFTER Step returns Ready, tied to
 // the runtime context generation and stable tip. Never retain readiness across
 // a runtime mutation. Index errors only affect query availability. Each Step
-// reads <=2 headers, one creation-capped runtime snapshot, at most one
-// max_body_bytes body, and performs <=1 durable index operation. Ancestry
-// traversal retains two headers, never a full path. Deep catchup may take many
-// steps. Runtime/sink lifetimes exceed this object. Genesis bytes are served
-// through ReadConnectedBody, never from an unauthenticated caller buffer.
+// performs <=2 active header queries (each returns <=1 header), or one
+// active query plus one genesis header read; one creation-capped runtime
+// snapshot, at most one
+// max_body_bytes body, and performs <=1 durable index operation. Active-height
+// lookups retain at most one returned header per query, never a full path.
+// Catchup and divergent-suffix removal use linear step counts. Runtime/sink
+// lifetimes exceed this object. Genesis bytes are served through
+// ReadConnectedBody, never from an unauthenticated caller buffer.
 class ChronikSync {
 public:
     ChronikSync(DevelopmentRuntime &, ChronikSink &, ChainId, TxProfile,
@@ -54,11 +57,6 @@ private:
     ChainId chain_;
     TxProfile profile_;
     uint64_t max_bytes_;
-    std::optional<IndexedHeader> cursor_, child_;
-    std::optional<ChronikAnchor> checkpoint_;
-    Hash tip_{};
-    uint64_t generation_{};
-    bool have_fence_{};
 };
 // Structural conversion additionally authenticates the exact native block id
 // and ordered transaction root. Includes every output, including burns; only
diff --git a/src/lotus_v2/chronik_sync_test/README.md b/src/lotus_v2/chronik_sync_test/README.md
index 6e04225eb0a2f9b9bcb495a19de0bcd2c6040a8b..abc827b6e44c3caa3f82e1d706650a65eb633611 100644
--- a/src/lotus_v2/chronik_sync_test/README.md
+++ b/src/lotus_v2/chronik_sync_test/README.md
@@ -8,8 +8,7 @@ step. `Unavailable` means native authority is recovering, paused, or unknown;
 The caller serializes all runtime/index operations. Before **every runtime
 mutation**, call `V2Service::invalidate_authority`. Publish the stable native
 anchor with `publish_authority` only after `Step` returns `Ready`, with no runtime
-mutation between observation and publication. Native tip/context changes restart
-ancestry traversal. Recovery journal, receipt, and propagation fences suppress
+mutation between observation and publication. Every step queries the current stable tip and active height mapping. Recovery journal, receipt, and propagation fences suppress
 indexing. The sink's durable indexed checkpoint is mandatory, including restart.
 
 Define `LOTUS_V2_CHRONIK_CXX` and provide generated CXX include directories and
@@ -21,11 +20,14 @@ ancestry-based two-block divergent suffix removal, replacement child connection,
 index-error consensus isolation, authenticated transaction/output conversion,
 nonzero spend ordinals with a preceding mint input, and tamper rejection.
 
-Each step retains only two headers, reads at most two headers and one body,
+Each step makes at most two active header queries returning at most one header
+each (or one active query and one genesis header read), reads one body at most,
 and changes at most one indexed block. Runtime snapshots/store internals have
 their existing creation limits; this is not a bound on LevelDB internal work.
-Traversal may revisit ancestors between indexed blocks, trading catchup speed
-for fixed memory. No candidate or invalid body is indexed: only stable active
+Catchup uses the active-height index directly. Divergent checkpoints are removed
+one at a time until they match active ancestry. Both paths use linear step
+counts and constant path memory; tests assert exact counts for initial catchup,
+restart, replacement, a five-block rollback to genesis, and renewed catchup. No candidate or invalid body is indexed: only stable active
 ancestry and `ReadConnectedBody` bytes enter conversion.
 
 Build:
diff --git a/src/lotus_v2/test_chronik_sync.cpp b/src/lotus_v2/test_chronik_sync.cpp
index fdba2326fbf21222aed79b3821936a2c05456f00..3c3fa29cadea0b68eb3b779806fb438734d57fc8 100644
--- a/src/lotus_v2/test_chronik_sync.cpp
+++ b/src/lotus_v2/test_chronik_sync.cpp
@@ -45,7 +45,7 @@ struct Sink : ChronikSink {
         ++disconnects;
     }
 };
-void Run(Home &home, Sink &sink) {
+size_t Run(Home &home, Sink &sink) {
     home.store = {};
     std::unique_ptr<DevelopmentRuntime> runtime;
     std::string error;
@@ -68,6 +68,7 @@ void Run(Home &home, Sink &sink) {
     Check(runtime->Snapshot().chain->stable_tip == original.chain->stable_tip,
           "consensus untouched");
     sink.fail = false;
+    return count;
 }
 int main() {
     try {
@@ -77,7 +78,8 @@ int main() {
             source.Connect(n);
             source.Open();
         }
-        Run(source, sink);
+        Check(Run(source, sink) == 6,
+              "linear initial catchup: 5 indexed blocks plus readiness");
         Check(sink.chain.size() == 5, "full genesis catchup");
         bool burn{};
         for (const auto &tx : sink.chain.front().transactions)
@@ -88,19 +90,27 @@ int main() {
                 burn |= output.IsBurn();
             }
         Check(burn, "genesis burn indexed");
-        Run(source, sink); // persisted checkpoint, new synchronizer and runtime
+        Check(Run(source, sink) == 1,
+              "restart checkpoint requires one readiness step");
         Home target;
         for (size_t n : {0, 1, 4, 5, 6}) {
             target.Connect(n);
             target.Open();
         }
-        Run(target, sink);
+        Check(Run(target, sink) == 6,
+              "linear reorg: 2 disconnects plus 3 connects plus readiness");
         Check(sink.disconnects == 2 && sink.chain.size() == 6 &&
                   sink.chain.back().anchor.block_id == H(V(6).id),
               "actual ancestry reorg");
         const auto &spend = sink.chain[3].transactions.back();
         Check(!spend.inputs.empty() && spend.inputs.front().input_index == 0,
               "actual spend ordinal");
+        Home genesis_only;
+        Check(Run(genesis_only, sink) == 6,
+              "deep reorg: 5 disconnects plus readiness");
+        Check(sink.chain.size() == 1 && sink.disconnects == 7,
+              "deep reorg retains genesis");
+        Check(Run(target, sink) == 6, "linear catchup after deep reorg");
         // A codec-authenticated mixed mint/spend frame preserves input slot 1.
         FramedBlock framed;
         std::string error;
