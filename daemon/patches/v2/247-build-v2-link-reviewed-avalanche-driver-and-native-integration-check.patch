From f1c8c92d87023c620819dfc4a6bd88a28c446d46 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:09:14 -0700
Subject: [PATCH] build(v2): link reviewed Avalanche driver and native
 integration check

---
 src/lotus_v2/CMakeLists.txt | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index e9252842efd14169464918b834cfd6e310abc915..92a452b63ad504d568bea43080b3e6f0fb6042ce 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -325,7 +325,7 @@ add_custom_target(check-lotus-v2-transactions
 # adapters do not enable polling or select a development quorum by themselves.
 add_library(lotus_v2_avalanche STATIC
     avalanche_proof.cpp avalanche_protocol.cpp avalanche_quorum.cpp
-    avalanche_poll.cpp avalanche_chain.cpp avalanche_peer_store.cpp avalanche_peer.cpp)
+    avalanche_poll.cpp avalanche_chain.cpp avalanche_peer_store.cpp avalanche_peer.cpp avalanche_driver.cpp)
 target_include_directories(lotus_v2_avalanche PUBLIC
     .. "${CMAKE_CURRENT_BINARY_DIR}/..")
 target_link_libraries(lotus_v2_avalanche PUBLIC lotus_v2_validation lotus_v2_peer_dispatcher)
@@ -351,3 +351,10 @@ target_link_libraries(test_lotus_v2_avalanche_peer PRIVATE lotus_v2_avalanche
 add_custom_target(check-lotus-v2-avalanche-peer
     COMMAND $<TARGET_FILE:test_lotus_v2_avalanche_peer>
     DEPENDS test_lotus_v2_avalanche_peer)
+
+add_executable(test_lotus_v2_avalanche_driver test_avalanche_driver.cpp)
+target_link_libraries(test_lotus_v2_avalanche_driver PRIVATE lotus_v2_avalanche
+    server common bitcoinconsensus script util crypto univalue secp256k1)
+add_custom_target(check-lotus-v2-avalanche-driver
+    COMMAND $<TARGET_FILE:test_lotus_v2_avalanche_driver>
+    DEPENDS test_lotus_v2_avalanche_driver)
-- 
