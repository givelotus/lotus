-    void Node::RelayActions(RelayResult result, uint64_t now) {
-        // SendApplication accepts a whole Message or none. A failed enqueue
-        // invalidates that peer's relay state and closes its physical session.
-        for (auto &action : result.actions) {
-            const ConnectionId connection{action.peer};
-            if (!relay_peers.contains(connection)) continue;
-            if (dispatcher->SendApplication(connection, std::move(action.message), now) != DispatcherResult::Queued) {
-                relay->RemovePeer(action.peer);
-                relay_peers.erase(connection);
-                dispatcher->Remove(connection);
-                for (auto &c : connections) if(c->id == connection) c->stream.Close();
-            }
-        }
+    void Node::RemoveRelayPeer(uint64_t peer) {
+        const ConnectionId connection{peer};
+        relay_output.Remove(peer);
+        relay->RemovePeer(peer);
+        relay_peers.erase(connection);
+        dispatcher->Remove(connection);
+        for (auto &c : connections) if (c->id == connection) c->stream.Close();
+    }
+    void Node::FlushRelay(uint64_t now) {
+        const auto failed = relay_output.Flush([&](uint64_t peer, const Message &message) {
+            if (!relay_peers.contains(ConnectionId{peer})) return DispatcherResult::Closed;
+            return dispatcher->SendApplication(ConnectionId{peer}, message, now);
+        });
+        for (const auto peer : failed) RemoveRelayPeer(peer);
+    }
+    void Node::RelayActions(RelayResult result, uint64_t) {
+        for (const auto peer : relay_output.Stage(std::move(result.actions)))
+            RemoveRelayPeer(peer);
     }
     UniValue Node::SubmitTransaction(const UniValue &request) {
         Keys(request, {"id", "command", "wire", "expected_tip"});
