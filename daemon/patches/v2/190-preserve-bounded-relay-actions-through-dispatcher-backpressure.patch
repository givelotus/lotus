-            if (inventory_cursor < relay_inventory.size()) {
-                const auto count = std::min<size_t>(128, relay_inventory.size() - inventory_cursor);
-                RelayActions(relay->AnnounceMany(std::span<const Hash>(relay_inventory).subspan(inventory_cursor, count), now), now);
+            if (relay_output.Empty() && inventory_cursor < relay_inventory.size()) {
+                const auto count = std::min<size_t>(4, relay_inventory.size() - inventory_cursor);
