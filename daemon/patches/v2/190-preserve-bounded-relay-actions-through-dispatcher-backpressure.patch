--- /dev/null
+++ b/src/lotus_v2/development_pool_command_test/test_relay_output.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Compile and execute the node's actual bounded relay output queue in isolation."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+source = (Path(__file__).resolve().parent.parent / 'development_node_command.cpp').read_text()
+queue = source.split('// BEGIN RELAY OUTPUT QUEUE\n', 1)[1].split('// END RELAY OUTPUT QUEUE', 1)[0]
+preamble = r'''
+#include <cassert>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+struct Message { std::string command; std::vector<uint8_t> payload; };
+struct RelayAction { uint64_t peer; Message message; };
+enum class DispatcherResult { Queued, Busy, Closed, CapacityRefused };
+'''
+test = r'''
+int main() {
+    RelayOutputQueue queue;
+    assert(queue.Stage({{1,{"inv",{1}}},{1,{"inv",{2}}}}).empty());
+    unsigned calls = 0;
+    assert(queue.Flush([&](uint64_t peer, const Message &message) {
+        assert(peer == 1 && message.payload == std::vector<uint8_t>{1});
+        ++calls; return DispatcherResult::Busy;
+    }).empty());
+    assert(calls == 1 && !queue.Empty());
+    std::vector<uint8_t> delivered;
+    for(unsigned turn = 0; turn < 2; ++turn)
+        assert(queue.Flush([&](uint64_t peer, const Message &message) {
+            assert(peer == 1); delivered.push_back(message.payload[0]);
+            return DispatcherResult::Queued;
+        }).empty());
+    assert((delivered == std::vector<uint8_t>{1,2}) && queue.Empty());
+    // Batched requests and responses stay ordered across Busy and append.
+    assert(queue.Stage({{2,{"getdata",{3}}},{2,{"tx",{4}}}}).empty());
+    queue.Flush([](uint64_t, const Message &) {return DispatcherResult::Busy;});
+    assert(queue.Stage({{2,{"notfound",{5}}}}).empty());
+    for(unsigned turn = 0; turn < 3; ++turn)
+        queue.Flush([&](uint64_t, const Message &message) {
+            delivered.push_back(message.payload[0]); return DispatcherResult::Queued;
+        });
+    assert((delivered == std::vector<uint8_t>{1,2,3,4,5}) && queue.Empty());
+    // Full batch refusal purges all queued state for only that peer.
+    std::vector<RelayAction> full;
+    for(unsigned n = 0; n < RelayOutputQueue::MaxMessages; ++n)
+        full.push_back({3,{"inv",{6}}});
+    assert(queue.Stage(std::move(full)).empty());
+    assert(queue.Stage({{3,{"inv",{7}}},{4,{"inv",{8}}}}) == std::set<uint64_t>{3});
+    queue.Flush([&](uint64_t peer, const Message &message) {
+        assert(peer == 4 && message.payload[0] == 8); return DispatcherResult::Queued;
+    });
+    assert(queue.Empty());
+    assert(queue.Stage({{5,{"tx",std::vector<uint8_t>(RelayOutputQueue::MaxBytes - 23)}}}) == std::set<uint64_t>{5});
+    assert(queue.Empty());
+    queue.Stage({{6,{"inv",{9}}}});
+    assert(queue.Flush([](uint64_t, const Message &) {return DispatcherResult::Closed;}) == std::set<uint64_t>{6});
+    assert(queue.Empty());
+    queue.Stage({{7,{"inv",{10}}}});
+    queue.Remove(7);
+    assert(queue.Empty());
+}
+'''
+with tempfile.TemporaryDirectory(prefix='lotus-node-relay-output-') as directory:
+    path = Path(directory)
+    (path / 'test.cpp').write_text(preamble + queue + test)
+    subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++20', '-Wall', '-Wextra', '-Werror', str(path / 'test.cpp'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
+print('relay output queue: FIFO, Busy retry, multi-message, capacity and lifecycle checks passed')
