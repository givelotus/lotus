diff --git a/chronik/chronik-lib/src/v2.rs b/chronik/chronik-lib/src/v2.rs
new file mode 100644
index 0000000000000000000000000000000000000000..09d59066fef27d572768fb205e6ff4cc15b29bf1
--- /dev/null
+++ b/chronik/chronik-lib/src/v2.rs
@@ -0,0 +1,120 @@
+//! Bounded native V2 service sharing a serialized DB owner with Rust readers.
+//!
+//! The typed response byte budget uses canonical field order: arrays are raw
+//! bytes, integers are fixed-width little-endian, booleans are one byte, and
+//! vectors carry a u32 count followed by elements. All optional slots are always
+//! present. A page has a 307-byte envelope and each match has 265 fixed bytes,
+//! followed by its output wire and matching-position bytes. This is a transport
+//! payload cap; CXX allocator metadata is not serialized. HTTP adapters must
+//! enforce their own encoding cap if expanding these records to JSON.
+//!
+//! Native callers authenticate consensus, canonical IDs and committed ordering.
+//! This service checks bindings and model shape, and never advances node state.
+//! Readiness is only the equality of separately supplied node/index checkpoints.
+use std::{path::Path, sync::{Arc, Mutex, MutexGuard}};
+use bitcoinsuite_core::lotus_v2::{Hash32, OutPoint, Output, OutputRecord, TxId, TxHash, TxLocation, MAX_OUTPUT_BYTES};
+use chronik_db::v2_branch::{self as db, ReadSnapshot, V2Db};
+use chronik_indexer::query::v2_branches as q;
+use crate::v2_ffi as f;
+type Result<T> = std::result::Result<T, String>;
+/// Thread-safe confirmed index owner. Clones share storage and immutable caps.
+#[derive(Clone, Debug)]
+pub struct V2Service { db: Arc<Mutex<V2Db>>, limits:f::ServiceLimits, genesis:[u8;32] }
+/// Open a dedicated directory; fresh requires absence, existing requires CURRENT.
+/// No deletion occurs. Reads stay unavailable until explicit genesis commits.
+pub fn open_service(path:&str, binding:f::Binding, fresh:bool, limits:f::ServiceLimits)->Result<Box<V2Service>> {
+    if path.is_empty() || path.len()>4096 {return Err("path bound".into());}
+    if limits.transactions==0 || limits.transactions as usize>db::MAX_TRANSACTIONS || limits.changes==0 || limits.changes as usize>db::MAX_CHANGES || limits.block_bytes==0 || limits.block_bytes as usize>db::MAX_BATCH_BYTES || limits.roots==0 || limits.roots>256 || limits.clauses==0 || limits.clauses>16 || limits.page_size==0 || limits.page_size>1000 || limits.posting_reads==0 || limits.posting_reads>65536 || limits.work==0 || limits.work>131072 || limits.response_bytes<512 || limits.response_bytes>1024*1024 {return Err("service limits".into());}
+    let path=Path::new(path);
+    if fresh {std::fs::create_dir(path).map_err(|e|e.to_string())?;} else if !path.join("CURRENT").is_file() {return Err("existing V2 DB required".into());}
+    let database=V2Db::open(path,db::Binding {chain_id:binding.chain_id,genesis:binding.genesis,profile:binding.profile}).map_err(|e|e.to_string())?;
+    Ok(Box::new(V2Service {db:Arc::new(Mutex::new(database)),limits,genesis:binding.genesis}))
+}
+fn anchor(a:&f::Anchor)->db::Anchor {db::Anchor {block_id:a.block_id,height:a.height}}
+fn ffi_anchor(a:db::Anchor)->f::Anchor {f::Anchor {block_id:a.block_id,height:a.height}}
+impl V2Service {
+    /// Clone the shared handle for another Rust service, including future HTTP.
+    pub fn clone_shared(&self)->Self {self.clone()}
+    /// Share the exact DB owner with a Rust HTTP adapter. Readers must hold the
+    /// mutex through snapshot use; native committed transitions remain the only
+    /// authorized mutation source. Node readiness requires a separate provider.
+    pub fn shared_database(&self) -> Arc<Mutex<V2Db>> {
+        Arc::clone(&self.db)
+    }
+    fn lock(&self)->Result<MutexGuard<'_,V2Db>> {self.db.lock().map_err(|_|"V2 DB lock poisoned".into())}
+    fn block(&self,block:f::NativeBlock)->Result<db::CommittedBlock> {
+        if block.transactions.len()>self.limits.transactions as usize {return Err("transaction bound".into());}
+        let mut bytes=80usize; let mut changes=0usize;
+        for tx in &block.transactions {
+            changes=changes.checked_add(tx.inputs.len()).and_then(|n|n.checked_add(tx.outputs.len())).ok_or("change overflow")?;
+            bytes=bytes.checked_add(76).and_then(|n|tx.inputs.len().checked_mul(40).and_then(|k|n.checked_add(k))).ok_or("block overflow")?;
+            if changes>self.limits.changes as usize || bytes>self.limits.block_bytes as usize {return Err("block input bound".into());}
+            for output in &tx.outputs {
+                if output.wire.len()>MAX_OUTPUT_BYTES {return Err("output bound".into());}
+                bytes=bytes.checked_add(4+output.wire.len()).ok_or("block overflow")?;
+                if bytes>self.limits.block_bytes as usize {return Err("block bytes bound".into());}
+            }
+        }
+        let transactions=block.transactions.into_iter().map(|tx| {
+            let outputs=tx.outputs.into_iter().map(|o|Output::decode(&o.wire).map_err(|e|e.to_string())).collect::<Result<Vec<_>>>()?;
+            Ok(db::ConfirmedTx {location:TxLocation {block_id:Hash32(block.anchor.block_id),height:block.anchor.height,tx_index:tx.index,txid:TxId(Hash32(tx.txid)),txhash:TxHash(Hash32(tx.txhash))},outputs,spends:tx.inputs.into_iter().map(|i|db::SpentInput {outpoint:OutPoint {txid:TxId(Hash32(i.txid)),out_idx:i.out_idx},input_index:i.input_index}).collect()})
+        }).collect::<Result<Vec<_>>>()?;
+        Ok(db::CommittedBlock {anchor:anchor(&block.anchor),parent:anchor(&block.parent),transactions})
+    }
+    /// Initialize complete caller-authenticated genesis, checking even empty blocks.
+    pub fn initialize_genesis(&self,block:f::NativeBlock)->Result<()> {
+        if block.anchor.height!=0 || block.parent.height!=0 || block.anchor.block_id!=block.parent.block_id || block.anchor.block_id!=self.genesis {return Err("genesis binding/shape".into());}
+        let block=self.block(block)?;
+        self.lock()?.initialize_genesis(block.transactions).map_err(|e|e.to_string())
+    }
+    /// Index one authoritative committed block without changing node state.
+    pub fn connect_block(&self,block:f::NativeBlock)->Result<()> {let block=self.block(block)?;self.lock()?.connect(&block).map_err(|e|e.to_string())}
+    /// Undo exactly the expected indexed anchor.
+    pub fn disconnect_block(&self,expected:f::Anchor)->Result<()> {self.lock()?.disconnect(anchor(&expected)).map_err(|e|e.to_string())}
+    /// Compare separate indexed and authoritative node checkpoints.
+    pub fn status(&self,node:f::Anchor)->Result<f::Status> {
+        let checkpoint=self.lock()?.checkpoint().map_err(|e|e.to_string())?;
+        Ok(f::Status {initialized:checkpoint.is_some(),ready:checkpoint==Some(anchor(&node)),indexed:ffi_anchor(checkpoint.unwrap_or(db::Anchor {block_id:[0;32],height:0})),node})
+    }
+    /// Query confirmed branch records or UTXOs on one stable bounded snapshot.
+    pub fn query_branches(&self,request:f::BranchRequest)->Result<f::BranchPage> {
+        let total=request.positions.iter().try_fold(request.any_branch.len(),|n,p|n.checked_add(p.roots.len())).ok_or("root overflow")?;
+        if total>self.limits.roots as usize || request.positions.len()>self.limits.clauses as usize {return Err("query input bound".into());}
+        let filter=q::BranchFilter {any_branch:request.any_branch.into_iter().map(|r|Hash32(r.bytes)).collect(),positions:request.positions.into_iter().map(|p|q::PositionClause {position:p.position,roots:p.roots.into_iter().map(|r|Hash32(r.bytes)).collect()}).collect()};
+        let c=request.cursor;
+        let cursor=c.present.then(||q::Cursor {version:c.version,snapshot:q::Snapshot {chain_id:Hash32(c.chain_id),profile_id:Hash32(c.profile),tip:Hash32(c.anchor.block_id),height:c.anchor.height},filter_digest:Hash32(c.filter_digest),last_key:c.has_last.then_some(OutPoint {txid:TxId(Hash32(c.last_txid)),out_idx:c.last_out_idx})});
+        let database=self.lock()?;
+        let source=Source(database.snapshot().map_err(|e|e.to_string())?);
+        // Fixed-width transport includes absent spend slots. This conservative
+        // budget covers vector framing and all optional cursor/record fields.
+        let envelope=240usize;
+        let room=self.limits.response_bytes as usize-envelope;
+        let page_cap=(self.limits.page_size as usize).min(room/240).max(1);
+        let limits=q::Limits {roots:self.limits.roots as usize,clauses:self.limits.clauses as usize,page_size:page_cap,posting_reads:self.limits.posting_reads as usize,work:self.limits.work as usize,result_bytes:room.saturating_sub(page_cap*111)};
+        let page=q::query(&source,&filter,if request.utxos {q::QueryKind::Utxos} else {q::QueryKind::History {include_burn:request.include_burn}},limits,cursor).map_err(|e|format!("V2 query: {e:?}"))?;
+        let matches=page.matches.into_iter().map(|m| {
+            let spend=m.record.spend;
+            Ok(f::OutputMatch {txid:m.record.outpoint.txid.0.0,out_idx:m.record.outpoint.out_idx,wire:m.record.output.encode().map_err(|e|e.to_string())?,creation:location(m.record.creation),spent:spend.is_some(),spend:spend.map(|s|location(s.transaction)).unwrap_or_else(empty_location),input_index:spend.map_or(0,|s|s.input_index),matching_positions:m.matching_positions})
+        }).collect::<Result<Vec<_>>>()?;
+        let encoded_bytes=page.result_bytes+envelope+matches.len()*111;
+        if encoded_bytes>self.limits.response_bytes as usize {return Err("response bytes bound".into());}
+        Ok(f::BranchPage {anchor:f::Anchor {block_id:page.snapshot.tip.0,height:page.snapshot.height},chain_id:page.snapshot.chain_id.0,profile:page.snapshot.profile_id.0,matches,cursor:continuation(page.continuation),posting_reads:page.posting_reads as u64,work:page.work as u64,encoded_bytes:encoded_bytes as u64})
+    }
+}
+struct Source<'a>(ReadSnapshot<'a>);
+impl q::PostingSource for Source<'_> {
+    fn snapshot(&self)->q::Snapshot {q::Snapshot {chain_id:Hash32(self.0.binding.chain_id),profile_id:Hash32(self.0.binding.profile),tip:Hash32(self.0.anchor.block_id),height:self.0.anchor.height}}
+    fn next_posting(&self,root:Hash32,position:Option<u8>,after:Option<OutPoint>)->std::result::Result<Option<OutPoint>,q::QueryError> {self.0.next_posting(root,position,after).map_err(|_|q::QueryError::Source("DB posting"))}
+    fn output(&self,key:OutPoint)->std::result::Result<Option<OutputRecord>,q::QueryError> {self.0.output(key).map_err(|_|q::QueryError::Source("DB record"))}
+}
+fn location(l:TxLocation)->f::Location {f::Location {anchor:f::Anchor {block_id:l.block_id.0,height:l.height},tx_index:l.tx_index,txid:l.txid.0.0,txhash:l.txhash.0.0}}
+fn empty_location()->f::Location {f::Location {anchor:f::Anchor {block_id:[0;32],height:0},tx_index:0,txid:[0;32],txhash:[0;32]}}
+fn continuation(c:Option<q::Cursor>)->f::Continuation {
+    let present=c.is_some();
+    let c=c.unwrap_or(q::Cursor {version:1,snapshot:q::Snapshot {chain_id:Hash32([0;32]),profile_id:Hash32([0;32]),tip:Hash32([0;32]),height:0},filter_digest:Hash32([0;32]),last_key:None});
+    f::Continuation {present,version:c.version,chain_id:c.snapshot.chain_id.0,profile:c.snapshot.profile_id.0,anchor:f::Anchor {block_id:c.snapshot.tip.0,height:c.snapshot.height},filter_digest:c.filter_digest.0,has_last:c.last_key.is_some(),last_txid:c.last_key.map_or([0;32],|k|k.txid.0.0),last_out_idx:c.last_key.map_or(0,|k|k.out_idx)}
+}
+
+#[cfg(test)]
+#[path = "v2tests/tests.rs"]
+mod tests;
diff --git a/chronik/chronik-lib/src/v2_ffi.rs b/chronik/chronik-lib/src/v2_ffi.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7a04662d9ee2d4c04fee975e4f9b388d09c9f631
--- /dev/null
+++ b/chronik/chronik-lib/src/v2_ffi.rs
@@ -0,0 +1,212 @@
+//! Independent bounded native V2 service bridge. Identities use native wire order.
+
+use crate::v2::{open_service, V2Service};
+pub use self::ffi_inner::*;
+
+#[allow(unsafe_code)]
+#[cxx::bridge(namespace = "chronik_v2")]
+mod ffi_inner {
+    /// Native V2 Binding transport.
+    #[derive(Clone, Debug)]
+    struct Binding {
+        /// Native chain id.
+        chain_id: [u8; 32],
+        /// Native genesis.
+        genesis: [u8; 32],
+        /// Native profile.
+        profile: [u8; 32],
+    }
+    /// Native V2 Anchor transport.
+    #[derive(Clone, Debug)]
+    struct Anchor {
+        /// Native block id.
+        block_id: [u8; 32],
+        /// Native height.
+        height: u64,
+    }
+    /// Native V2 ServiceLimits transport.
+    #[derive(Clone, Debug)]
+    struct ServiceLimits {
+        /// Native block bytes.
+        block_bytes: u32,
+        /// Native transactions.
+        transactions: u32,
+        /// Native changes.
+        changes: u32,
+        /// Native roots.
+        roots: u32,
+        /// Native clauses.
+        clauses: u32,
+        /// Native page size.
+        page_size: u32,
+        /// Native posting reads.
+        posting_reads: u32,
+        /// Native work.
+        work: u32,
+        /// Native response bytes.
+        response_bytes: u32,
+    }
+    /// Native V2 Input transport.
+    #[derive(Clone, Debug)]
+    struct Input {
+        /// Native txid.
+        txid: [u8; 32],
+        /// Native out idx.
+        out_idx: u32,
+        /// Native input index.
+        input_index: u32,
+    }
+    /// Native V2 NativeOutput transport.
+    #[derive(Clone, Debug)]
+    struct NativeOutput {
+        /// Native wire.
+        wire: Vec<u8>,
+    }
+    /// Native V2 NativeTx transport.
+    #[derive(Clone, Debug)]
+    struct NativeTx {
+        /// Native txid.
+        txid: [u8; 32],
+        /// Native txhash.
+        txhash: [u8; 32],
+        /// Native index.
+        index: u32,
+        /// Native inputs.
+        inputs: Vec<Input>,
+        /// Native outputs.
+        outputs: Vec<NativeOutput>,
+    }
+    /// Native V2 NativeBlock transport.
+    #[derive(Clone, Debug)]
+    struct NativeBlock {
+        /// Native anchor.
+        anchor: Anchor,
+        /// Native parent.
+        parent: Anchor,
+        /// Native transactions.
+        transactions: Vec<NativeTx>,
+    }
+    /// Native V2 Status transport.
+    #[derive(Clone, Debug)]
+    struct Status {
+        /// Native initialized.
+        initialized: bool,
+        /// Native indexed.
+        indexed: Anchor,
+        /// Native node.
+        node: Anchor,
+        /// Native ready.
+        ready: bool,
+    }
+    /// Native V2 Root transport.
+    #[derive(Clone, Debug)]
+    struct Root {
+        /// Native bytes.
+        bytes: [u8; 32],
+    }
+    /// Native V2 Position transport.
+    #[derive(Clone, Debug)]
+    struct Position {
+        /// Native position.
+        position: u8,
+        /// Native roots.
+        roots: Vec<Root>,
+    }
+    /// Native V2 Continuation transport.
+    #[derive(Clone, Debug)]
+    struct Continuation {
+        /// Native present.
+        present: bool,
+        /// Native version.
+        version: u8,
+        /// Native chain id.
+        chain_id: [u8; 32],
+        /// Native profile.
+        profile: [u8; 32],
+        /// Native anchor.
+        anchor: Anchor,
+        /// Native filter digest.
+        filter_digest: [u8; 32],
+        /// Native has last.
+        has_last: bool,
+        /// Native last txid.
+        last_txid: [u8; 32],
+        /// Native last out idx.
+        last_out_idx: u32,
+    }
+    /// Native V2 BranchRequest transport.
+    #[derive(Clone, Debug)]
+    struct BranchRequest {
+        /// Native any branch.
+        any_branch: Vec<Root>,
+        /// Native positions.
+        positions: Vec<Position>,
+        /// Native utxos.
+        utxos: bool,
+        /// Native include burn.
+        include_burn: bool,
+        /// Native cursor.
+        cursor: Continuation,
+    }
+    /// Native V2 Location transport.
+    #[derive(Clone, Debug)]
+    struct Location {
+        /// Native anchor.
+        anchor: Anchor,
+        /// Native tx index.
+        tx_index: u32,
+        /// Native txid.
+        txid: [u8; 32],
+        /// Native txhash.
+        txhash: [u8; 32],
+    }
+    /// Native V2 OutputMatch transport.
+    #[derive(Clone, Debug)]
+    struct OutputMatch {
+        /// Native txid.
+        txid: [u8; 32],
+        /// Native out idx.
+        out_idx: u32,
+        /// Native wire.
+        wire: Vec<u8>,
+        /// Native creation.
+        creation: Location,
+        /// Native spent.
+        spent: bool,
+        /// Native spend.
+        spend: Location,
+        /// Native input index.
+        input_index: u32,
+        /// Native matching positions.
+        matching_positions: Vec<u8>,
+    }
+    /// Native V2 BranchPage transport.
+    #[derive(Clone, Debug)]
+    struct BranchPage {
+        /// Native anchor.
+        anchor: Anchor,
+        /// Native chain id.
+        chain_id: [u8; 32],
+        /// Native profile.
+        profile: [u8; 32],
+        /// Native matches.
+        matches: Vec<OutputMatch>,
+        /// Native cursor.
+        cursor: Continuation,
+        /// Native posting reads.
+        posting_reads: u64,
+        /// Native work.
+        work: u64,
+        /// Native encoded bytes.
+        encoded_bytes: u64,
+    }
+    extern "Rust" {
+        type V2Service;
+        fn open_service(path: &str, binding: Binding, fresh: bool, limits: ServiceLimits) -> Result<Box<V2Service>>;
+        fn initialize_genesis(self: &V2Service, block: NativeBlock) -> Result<()>;
+        fn connect_block(self: &V2Service, block: NativeBlock) -> Result<()>;
+        fn disconnect_block(self: &V2Service, anchor: Anchor) -> Result<()>;
+        fn status(self: &V2Service, node: Anchor) -> Result<Status>;
+        fn query_branches(self: &V2Service, request: BranchRequest) -> Result<BranchPage>;
+    }
+}
diff --git a/chronik/chronik-lib/src/v2tests/tests.rs b/chronik/chronik-lib/src/v2tests/tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fb6f18ce8e411fb63daade8d5efe1757c3342df1
--- /dev/null
+++ b/chronik/chronik-lib/src/v2tests/tests.rs
@@ -0,0 +1,80 @@
+use super::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+static NEXT: AtomicU64 = AtomicU64::new(0);
+fn limits() -> f::ServiceLimits {
+    f::ServiceLimits {block_bytes:1024*1024,transactions:4096,changes:65536,roots:256,clauses:16,page_size:1,posting_reads:4096,work:8192,response_bytes:4096}
+}
+fn binding() -> f::Binding {f::Binding {chain_id:[1;32],genesis:[2;32],profile:[3;32]}}
+fn tip(id:u8,height:u64) -> f::Anchor {f::Anchor {block_id:[id;32],height}}
+fn block(id:u8,height:u64,parent:u8,tx:u8,inputs:Vec<f::Input>) -> f::NativeBlock {
+    let output=Output {flags:0,value:u64::MAX,token_id:Hash32([0;32]),branches:vec![Hash32([9;32])],paths:vec![vec![0]]};
+    f::NativeBlock {anchor:tip(id,height),parent:tip(parent,height.saturating_sub(1)),transactions:vec![f::NativeTx {txid:[tx;32],txhash:[tx+1;32],index:0,inputs,outputs:vec![f::NativeOutput {wire:output.encode().unwrap()}]}]}
+}
+fn no_cursor()->f::Continuation {continuation(None)}
+fn request(utxos:bool)->f::BranchRequest {f::BranchRequest {any_branch:vec![f::Root {bytes:[9;32]}],positions:vec![],utxos,include_burn:false,cursor:no_cursor()}}
+struct Temp(std::path::PathBuf);
+impl Temp {
+    fn new()->Self {Self(std::env::temp_dir().join(format!("lotus-v2-service-{}-{}",std::process::id(),NEXT.fetch_add(1,Ordering::Relaxed))))}
+    fn path(&self)->&str {self.0.to_str().unwrap()}
+}
+impl Drop for Temp {fn drop(&mut self) {let _=std::fs::remove_dir_all(&self.0);}}
+#[test]
+fn explicit_genesis_complete_spend_disconnect_reopen() {
+    let path=Temp::new();
+    assert!(open_service(path.path(),binding(),false,limits()).is_err());
+    let service=open_service(path.path(),binding(),true,limits()).unwrap();
+    assert!(!service.status(tip(2,0)).unwrap().initialized);
+    assert!(service.query_branches(request(true)).is_err());
+    assert!(service.initialize_genesis(block(99,0,99,10,vec![])).is_err());
+    service.initialize_genesis(block(2,0,2,10,vec![])).unwrap();
+    let page=service.query_branches(request(true)).unwrap();
+    assert_eq!(page.matches.len(),1);
+    assert_eq!(Output::decode(&page.matches[0].wire).unwrap().value,u64::MAX);
+    assert!(page.encoded_bytes<=4096);
+    let cursor=page.cursor;
+    assert!(service.status(tip(2,0)).unwrap().ready);
+    assert!(!service.status(tip(4,1)).unwrap().ready);
+    let input=f::Input {txid:[10;32],out_idx:0,input_index:3};
+    service.connect_block(block(4,1,2,12,vec![input])).unwrap();
+    let mut stale=request(true);stale.cursor=cursor;
+    assert!(service.query_branches(stale).is_err());
+    let history=service.query_branches(request(false)).unwrap();
+    assert!(history.matches[0].spent);
+    assert_eq!(history.matches[0].input_index,3);
+    assert_eq!(service.query_branches(request(true)).unwrap().matches[0].txid,[12;32]);
+    let shared=service.clone_shared();
+    std::thread::spawn(move||assert!(shared.status(tip(4,1)).unwrap().ready)).join().unwrap();
+    service.disconnect_block(tip(4,1)).unwrap();
+    assert_eq!(service.query_branches(request(true)).unwrap().matches[0].txid,[10;32]);
+    drop(service);
+    let service=open_service(path.path(),binding(),false,limits()).unwrap();
+    assert!(service.status(tip(2,0)).unwrap().ready);
+    drop(service);
+    let mut foreign=binding();foreign.profile=[42;32];
+    assert!(open_service(path.path(),foreign,false,limits()).is_err());
+    assert!(open_service(path.path(),binding(),true,limits()).is_err());
+}
