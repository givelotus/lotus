From b2cdb328c145d3a177a8ba3177ebaff743b1c597 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:21:12 -0700
Subject: [PATCH] fix(v2): include canonical height joins in asset read budgets

---
 chronik/chronik-db/src/v2_asset.rs            |  9 +++----
 chronik/chronik-db/src/v2_asset_test.rs       |  9 ++++---
 .../chronik-indexer/src/query/v2_assets.rs    |  9 ++++---
 .../src/query/v2_assets_test.rs               | 25 +++++++++++--------
 4 files changed, 28 insertions(+), 24 deletions(-)

diff --git a/chronik/chronik-db/src/v2_asset.rs b/chronik/chronik-db/src/v2_asset.rs
index ebbda5ef22ffe1ac6839b47b20871ab8bb8935fd..b2f8e6562c58140b2b58629427a9f1859c32c3b8 100644
--- a/chronik/chronik-db/src/v2_asset.rs
+++ b/chronik/chronik-db/src/v2_asset.rs
@@ -310,8 +310,7 @@ impl ReadSnapshot<'_> {
         location: TxLocation,
         budget: &mut AssetReadBudget,
     ) -> Result<()> {
-        budget.charge()?;
-        if self.transaction(location.txid)? != Some(location) {
+        if self.transaction_counted(location.txid, budget)? != Some(location) {
             return Err(Error::Corrupt);
         }
         Ok(())
@@ -320,7 +319,7 @@ impl ReadSnapshot<'_> {
     pub fn asset_summary(&self, token: Hash32) -> Result<Option<AssetSummary>> {
         self.asset_summary_counted(token, &mut AssetReadBudget::new(usize::MAX))
     }
-    /// Point read plus exact canonical-location join (at most two reads).
+    /// Point read plus exact canonical-location join (at most three reads).
     pub fn asset_summary_counted(
         &self,
         token: Hash32,
@@ -384,7 +383,7 @@ impl ReadSnapshot<'_> {
     ) -> Result<Option<(Vec<u8>, AssetSummary)>> {
         self.next_asset_summary_counted(after, &mut AssetReadBudget::new(usize::MAX))
     }
-    /// At most two iterator advancements plus one canonical-location read.
+    /// At most two iterator advancements plus two canonical-location reads.
     pub fn next_asset_summary_counted(
         &self,
         after: Option<&[u8]>,
@@ -413,7 +412,7 @@ impl ReadSnapshot<'_> {
     ) -> Result<Option<(Vec<u8>, AssetEvent)>> {
         self.next_asset_event_counted(token, after, &mut AssetReadBudget::new(usize::MAX))
     }
-    /// At most two iterator advancements plus one canonical-location read.
+    /// At most two iterator advancements plus two canonical-location reads.
     pub fn next_asset_event_counted(
         &self,
         token: Hash32,
