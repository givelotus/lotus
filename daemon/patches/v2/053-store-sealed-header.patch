+// Copyright (c) 2026 The Lotus developers
+// Seal one ordinary child header and store that exact 134-byte encoding.
+// Nonce stays 0. This does not mine, search a nonce, or check proof of work
+// beyond SealChildHeader's pow_limit ceiling. lotusd has not accepted the
+// header. This is not ConnectTip.
+#include "persistent_header.h"
+#include "persistent_monetary.h"
+#include "persistent_utxo.h"
+#include "signing.h"
+#include "tx_root_seal.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits.h>
+#include <stdexcept>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+const std::vector<uint8_t> PUSH_ZERO{0x00};
+const MonetaryProfile kMonetary{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000};
+
+OrdinaryCandidateProfile MakeProfile(VmCostUnits block_cap) {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, 100, 50000, 2, 3, block_cap};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+Hash Chain() {
+    Hash chain{};
+    for (size_t i = 0; i < chain.size(); ++i)
+        chain[i] = static_cast<uint8_t>(i);
+    return chain;
+}
+
+Hash PowLimit() {
+    Hash limit{};
+    limit[31] = 0xff;
+    return limit;
+}
+
+MonetaryState InitialMoney() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Coin MakeFunding(uint8_t tag, uint32_t index, uint64_t value, const Hash &branch) {
+    Coin coin;
+    coin.outpoint.tx_id[0] = tag;
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = value;
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = 90;
+    coin.creation_parent_mtp = 49000;
+    coin.coinbase = false;
+    return coin;
+}
+
+Transaction Payment(const Outpoint &spent, uint64_t value,
+                    const std::vector<uint8_t> &witness = TRUE_SCRIPT) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{witness, {}, {}}};
+    tx.inputs.push_back(input);
+    Output output;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    tx.outputs.push_back(output);
+    return tx;
+}
+
+struct World {
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary = InitialMoney();
+    OrdinaryParentContext parent;
+    Hash branch = BranchLeaf(TRUE_SCRIPT);
+    Coin funding;
+    Coin other;
+    World()
+        : funding(MakeFunding(0x71, 3, 20000, branch)),
+          other(MakeFunding(0x72, 1, 8000, branch)) {
+        Check(view.emplace(funding.outpoint, funding).second &&
+                  view.emplace(other.outpoint, other).second &&
+                  utxo.Insert(funding) && utxo.Insert(other),
+              "parent coins");
+        parent.chain_id = Chain();
+        parent.monetary = monetary;
+        parent.header.height = 99;
+        parent.header.time = 50000;
+        parent.header.version = 1;
+        parent.header.size = HEADER_SIZE;
+        parent.header.state_root = StateRoot(
+            parent.chain_id, parent.header.height, utxo.Root(), monetary);
+    }
+};
+
+std::filesystem::path TempDir() {
+    char templ[] = "/tmp/lotus-v2-seal-header-XXXXXX";
+    Check(::mkdtemp(templ) != nullptr, "mkdtemp");
+    const std::string path(templ);
+    Check(path.rfind("/tmp/", 0) == 0, "temporary directory is under /tmp");
+    Check(path.find("..") == std::string::npos, "temporary path has no parent segment");
+    Check(path.find(".lotus") == std::string::npos &&
+              path.find("datadir") == std::string::npos,
+          "temporary path is not a datadir");
+    char resolved[PATH_MAX];
+    Check(::realpath(path.c_str(), resolved) != nullptr, "realpath");
+    const std::string absolute(resolved);
+    Check(absolute.rfind("/tmp/", 0) == 0 ||
+              absolute.rfind("/private/tmp/", 0) == 0,
+          "resolved temporary directory stays under /tmp");
+    return std::filesystem::path(absolute);
+}
+
+std::vector<uint8_t> ReadRaw(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    Check(static_cast<bool>(in), "read " + path.string());
+    return std::vector<uint8_t>(std::istreambuf_iterator<char>(in),
+                                std::istreambuf_iterator<char>());
+}
+
+size_t DatFiles(const std::filesystem::path &directory) {
+    size_t count = 0;
+    if (!std::filesystem::exists(directory)) return 0;
+    for (const auto &entry : std::filesystem::directory_iterator(directory)) {
+        if (entry.is_regular_file() && entry.path().extension() == ".dat")
+            ++count;
+    }
+    return count;
+}
+
+Hash StoreRoot(const PersistentUtxoStore &store) {
+    Hash root{};
+    Check(store.Root(root), "utxo store root");
+    return root;
+}
+
+std::array<uint8_t, 56> StoreMoney(const PersistentMonetaryStore &store) {
+    std::array<uint8_t, 56> money{};
+    Check(store.Monetary(money), "monetary store bytes");
+    return money;
+}
+
+Hash StoreState(const PersistentMonetaryStore &store) {
+    Hash root{};
+    Check(store.Root(root), "monetary store state root");
+    return root;
+}
+
+void SeedUtxo(PersistentUtxoStore &store, const World &world) {
+    std::vector<Coin> coins;
+    coins.reserve(world.view.size());
+    for (const auto &entry : world.view) coins.push_back(entry.second);
+    std::string error;
+    Check(store.Commit({}, coins, error), "seed parent coins: " + error);
+    Check(StoreRoot(store) == world.utxo.Root(), "seeded utxo root");
+}
+
+void SeedMonetary(PersistentMonetaryStore &store, const World &world) {
+    std::string error;
+    Check(store.Commit(world.parent.chain_id, world.parent.header.height,
+                       world.parent.monetary, world.parent.header.state_root,
+                       error),
+          "seed parent monetary: " + error);
+    Check(StoreMoney(store) == EncodeMonetaryState(world.monetary),
+          "seeded monetary bytes");
+    Check(StoreState(store) == world.parent.header.state_root,
+          "seeded state root");
+}
+
+bool SameHeader(const Header &a, const Header &b) {
+    return a.prev_id == b.prev_id && a.bits == b.bits && a.time == b.time &&
+           a.nonce == b.nonce && a.version == b.version && a.size == b.size &&
+           a.height == b.height && a.tx_root == b.tx_root &&
+           a.state_root == b.state_root;
+}
+
+// Same 16-byte core ComputeIdentities already passes to TransactionId and
+// TransactionHash. Byte 0 is 7, as in the sealer fixture. The remaining
+// bytes are this transaction's lock and counts, not a new id layout.
+TxRootInput RootInput(const Transaction &tx, const IdentityDigests &ids,
+                      const ChainId &chain) {
+    TxRootInput input{};
+    input.header_core[0] = 7;
+    for (size_t i = 0; i < 8; ++i)
+        input.header_core[4 + i] = static_cast<uint8_t>(tx.lock >> (8 * i));
+    input.header_core[12] = static_cast<uint8_t>(tx.inputs.size());
+    input.header_core[13] = static_cast<uint8_t>(tx.inputs.size() >> 8);
+    input.header_core[14] = static_cast<uint8_t>(tx.outputs.size());
+    input.header_core[15] = static_cast<uint8_t>(tx.outputs.size() >> 8);
+    input.inputs_root = ids.inputs_root;
+    input.full_inputs_root = ids.full_inputs_root;
+    input.outputs_root = ids.outputs_root;
+    Check(TransactionId(chain, input.header_core, input.inputs_root,
+                        input.outputs_root) == ids.txid,
+          "tx root input is not the existing transaction id");
+    Check(TransactionHash(chain, input.header_core, input.full_inputs_root,
+                          input.outputs_root) == ids.txhash,
+          "tx root input is not the existing transaction hash");
+    return input;
+}
+
+Hash ExpectTxRoot(const ChainId &chain, const TxRootInput &tx) {
+    TxIdentityPair pair{};
+    pair.tx_hash = TransactionHash(chain, tx.header_core, tx.full_inputs_root,
+                                   tx.outputs_root);
+    pair.tx_id =
+        TransactionId(chain, tx.header_core, tx.inputs_root, tx.outputs_root);
+    Hash root{};
+    Check(TransactionRoot(std::span<const TxIdentityPair>(&pair, 1), root),
+          "TransactionRoot");
+    return root;
+}
+
+void ExpectEmptyHeader(PersistentHeaderStore &store,
+                       const std::filesystem::path &directory,
+                       const std::string &where) {
+    Header header;
+    header.nonce = 9;
+    header.size = 11;
+    header.height = 13;
+    uint64_t height = 17;
+    ChainId chain{};
+    chain.fill(0x5a);
+    Hash id{};
+    id.fill(0xa5);
+    Check(store.IsOpen(), where + " header store is closed");
+    Check(!store.GetHeader(header), where + " empty store returned a header");
+    Check(header.nonce == 9 && header.size == 11 && header.height == 13,
+          where + " empty GetHeader modified the header");
+    Check(!store.Height(height) && height == 17, where + " empty Height");
+    Check(!store.Chain(chain) && chain[0] == 0x5a, where + " empty Chain");
+    Check(!store.HeaderId(id) && id[0] == 0xa5, where + " empty HeaderId");
+    Check(!std::filesystem::exists(directory / "header.dat"),
+          where + " header.dat exists");
+    Check(DatFiles(directory) == 0, where + " header directory has a record");
+    Check(DatFiles(directory / "undo") == 0, where + " header undo has a record");
+}
+
+void ExpectParentStores(PersistentUtxoStore &utxo, PersistentMonetaryStore &money,
+                        const Hash &parent_utxo,
+                        const std::array<uint8_t, 56> &parent_money,
+                        const Hash &parent_state, const std::string &where) {
+    Check(StoreRoot(utxo) == parent_utxo, where + " utxo root");
+    Check(StoreMoney(money) == parent_money, where + " monetary bytes");
+    Check(StoreState(money) == parent_state, where + " state root");
+}
+
+// Documented snapshot: 24-byte record prefix, chain id, height, then the
+// 134-byte SerializeHeader encoding, then the existing BlockId.
+void ExpectHeaderFile(const std::filesystem::path &file, const ChainId &chain,
+                      uint64_t height, const std::array<uint8_t, HEADER_SIZE> &header,
+                      const Hash &header_id) {
+    const std::vector<uint8_t> bytes = ReadRaw(file);
+    Check(bytes.size() == 24 + PERSISTENT_HEADER_SNAPSHOT_BYTES + 32,
+          "header record size");
+    Check(std::string(bytes.begin(), bytes.begin() + 8) == "LTSV2HDR",
+          "header magic");
+    Check(std::equal(chain.begin(), chain.end(), bytes.begin() + 24),
+          "file chain id");
+    uint64_t file_height = 0;
+    for (unsigned i = 0; i < 8; ++i)
+        file_height |= uint64_t(bytes[56 + i]) << (8 * i);
+    Check(file_height == height, "file height");
+    Check(std::equal(header.begin(), header.end(), bytes.begin() + 64),
+          "header file does not store the sealed header");
+    Check(std::equal(header_id.begin(), header_id.end(), bytes.begin() + 198),
+          "file header id is not BlockId");
+}
+
+void OrdinarySealedHeaderRoundTrip() {
+    World world;
+    const Hash parent_utxo = world.utxo.Root();
+    const std::array<uint8_t, 56> parent_money =
+        EncodeMonetaryState(world.monetary);
+    const Hash parent_state = world.parent.header.state_root;
+    const Transaction payment = Payment(world.funding.outpoint, 15000);
+    Check(payment.inputs.size() == 1 &&
+              payment.inputs[0].witnesses.size() == 1 &&
+              payment.inputs[0].witnesses[0].script == TRUE_SCRIPT &&
+              TRUE_SCRIPT.size() == 1 && TRUE_SCRIPT[0] == 0x4e,
+          "ordinary payment is not OP_TRUE");
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    Check(profile.candidate_height == world.parent.header.height + 1 &&
+              profile.parent_mtp == world.parent.header.time,
+          "profile is not the child of this parent");
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(payment, profile, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure true payment: " + error);
+    Check(effects.invocation_cost == 18, "true payment invocation cost");
+    IdentityDigests ids;
+    Check(ComputeIdentities(payment, profile.transaction, world.parent.chain_id,
+                            ids, error),
+          "payment identity: " + error);
+    Check(effects.txid == ids.txid && effects.txhash == ids.txhash,
+          "candidate identity is not ComputeIdentities");
+    const TxRootInput tx_input = RootInput(payment, ids, world.parent.chain_id);
+    const Hash tx_root = ExpectTxRoot(world.parent.chain_id, tx_input);
+    Check(tx_root != ids.txid && tx_root != ids.txhash,
+          "transaction root collapsed to one id");
+
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    const std::filesystem::path header_dir = directory / "header";
+    std::vector<uint8_t> parent_utxo_file;
+    std::vector<uint8_t> parent_money_file;
+    std::vector<uint8_t> sealed_file;
+    Header sealed;
+    std::array<uint8_t, HEADER_SIZE> sealed_bytes{};
+    Hash sealed_id{};
+    Hash connected_utxo{};
+    std::array<uint8_t, 56> connected_money{};
+    Hash connected_state{};
+    size_t utxo_commits = 0;
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "open utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "open monetary: " + error);
+        SeedUtxo(utxo_store, world);
+        SeedMonetary(monetary_store, world);
+        parent_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        parent_money_file = ReadRaw(money_dir / "monetary.dat");
+        const size_t seeded_utxo = DatFiles(utxo_dir / "undo");
+        const size_t seeded_money = DatFiles(money_dir / "monetary-undo");
+        Check(seeded_utxo == 1 && seeded_money == 1,
+              "parent seed is one commit in each store");
+        OrdinaryBlockConnected connected;
+        Check(ConnectOrdinaryBlock({payment}, world.parent, profile, kMonetary,
+                                   world.view, world.utxo, world.monetary,
+                                   connected, error, &utxo_store,
+                                   &monetary_store),
+              "connect true payment: " + error);
+        Check(connected.invocation_cost == 18, "connected invocation cost");
+        Check(connected.state_root ==
+                      StateRoot(world.parent.chain_id, profile.candidate_height,
+                                world.utxo.Root(), world.monetary) &&
+                  connected.state_root != parent_state,
+              "connected state root");
+        utxo_commits = DatFiles(utxo_dir / "undo") - seeded_utxo;
+        Check(utxo_commits == 1, "the payment was not its own utxo commit");
+        Check(DatFiles(money_dir / "monetary-undo") == seeded_money + 1,
+              "the block was not one monetary snapshot");
+        const std::vector<TxRootInput> txs{tx_input};
+        const Hash pow_limit = PowLimit();
+        // The header file rejects a size field other than 134. Nonce stays 0.
+        // pow_limit is only SealChildHeader's DecodeTarget ceiling.
+        Check(SealChildHeaderWithTxRoot(world.parent, connected, txs, 2, 50120,
+                                        HEADER_SIZE, 0x1d00ffff, pow_limit,
+                                        sealed, error),
+              "seal child header: " + error);
+        Check(error.empty(), "seal left an error");
+        Check(sealed.nonce == 0, "nonce was searched");
+        Check(sealed.height == world.parent.header.height + 1,
+              "child height is not parent+1");
+        Check(sealed.state_root == connected.state_root,
+              "sealed state root is not the connect result");
+        Check(sealed.tx_root == tx_root, "sealed tx root is not TransactionRoot");
+        Check(sealed.size == HEADER_SIZE && sealed.version == 2 &&
+                  sealed.time == 50120 && sealed.bits == 0x1d00ffff,
+              "sealed header fields");
+        Hash parent_id{};
+        Check(BlockId(world.parent.chain_id, world.parent.header, parent_id) &&
+                  sealed.prev_id == parent_id,
+              "prev_id is not the existing parent block id");
+        Check(SerializeHeader(sealed, sealed_bytes), "serialize sealed header");
+        Check(sealed_bytes.size() == 134, "serialization is not 134 bytes");
+        Check(std::all_of(sealed_bytes.begin() + 42, sealed_bytes.begin() + 50,
+                          [](uint8_t byte) { return byte == 0; }),
+              "encoded nonce is not 0");
+        Check(sealed_bytes[54] == static_cast<uint8_t>(HEADER_SIZE) &&
+                  std::all_of(sealed_bytes.begin() + 55, sealed_bytes.begin() + 62,
+                              [](uint8_t byte) { return byte == 0; }),
+              "encoded size is not 134");
+        Check(BlockId(world.parent.chain_id, sealed, sealed_id),
+              "existing block id");
+        PersistentHeaderStore header_store;
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "open header: " + error);
+        ExpectEmptyHeader(header_store, header_dir, "before commit");
+        Check(header_store.Commit(world.parent.chain_id, sealed.height, sealed,
+                                  error),
+              "commit sealed header: " + error);
+        Header live;
+        uint64_t live_height = 0;
+        ChainId live_chain{};
+        Hash live_id{};
+        Check(header_store.GetHeader(live) && SameHeader(live, sealed),
+              "live header store does not match the sealed header");
+        Check(header_store.Height(live_height) && live_height == sealed.height,
+              "live header height");
+        Check(header_store.Chain(live_chain) &&
+                  live_chain == world.parent.chain_id,
+              "live header chain");
+        Check(header_store.HeaderId(live_id) && live_id == sealed_id,
+              "live header id is not BlockId");
+        Check(DatFiles(header_dir) == 1 && DatFiles(header_dir / "undo") == 1,
+              "commit did not write one header file and one undo");
+        ExpectHeaderFile(header_dir / "header.dat", world.parent.chain_id,
+                         sealed.height, sealed_bytes, sealed_id);
+        sealed_file = ReadRaw(header_dir / "header.dat");
+        connected_utxo = connected.utxo_root;
+        connected_money = connected.monetary_bytes;
+        connected_state = connected.state_root;
+        Check(StoreRoot(utxo_store) == connected_utxo &&
+                  StoreMoney(monetary_store) == connected_money &&
+                  StoreState(monetary_store) == connected_state,
+              "live coin stores do not match the connect result");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "reopen header: " + error);
+        Check(ReadRaw(header_dir / "header.dat") == sealed_file,
+              "reopen changed the header file");
+        Header reopened;
+        uint64_t height = 0;
+        ChainId chain{};
+        Hash header_id{};
+        Check(header_store.GetHeader(reopened) && SameHeader(reopened, sealed),
+              "reopened header bytes do not match");
+        std::array<uint8_t, HEADER_SIZE> again{};
+        Check(SerializeHeader(reopened, again) && again == sealed_bytes,
+              "reopened serialization is not the sealed header");
+        Check(header_store.Height(height) && height == sealed.height &&
+                  height == world.parent.header.height + 1,
+              "reopened height");
+        Check(header_store.Chain(chain) && chain == world.parent.chain_id,
+              "reopened chain id");
+        Check(header_store.HeaderId(header_id) && header_id == sealed_id,
+              "reopened header id");
+        Hash recomputed{};
+        Check(BlockId(chain, reopened, recomputed) && recomputed == header_id,
+              "reopened header id is not the existing BlockId");
+        ExpectHeaderFile(header_dir / "header.dat", chain, height, again,
+                         header_id);
+        Check(StoreRoot(utxo_store) == connected_utxo &&
+                  StoreMoney(monetary_store) == connected_money &&
+                  StoreState(monetary_store) == connected_state,
+              "reopened coin stores do not match the connect result");
+        Check(header_store.Undo(error), "undo header: " + error);
+        Check(monetary_store.Undo(error), "undo monetary: " + error);
+        for (size_t i = 0; i < utxo_commits; ++i)
+            Check(utxo_store.Undo(error), "undo utxo: " + error);
+        ExpectEmptyHeader(header_store, header_dir, "after undo");
+        ExpectParentStores(utxo_store, monetary_store, parent_utxo, parent_money,
+                           parent_state, "after undo");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "undo did not restore the parent seed files");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen undone utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen undone monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "reopen undone header: " + error);
+        ExpectEmptyHeader(header_store, header_dir, "reopened undone");
+        ExpectParentStores(utxo_store, monetary_store, parent_utxo, parent_money,
+                           parent_state, "reopened undone");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "second reopen changed a parent seed file");
+    }
+    std::filesystem::remove_all(directory);
+}
+
+Outpoint OutputOf(const Transaction &tx, const TxProfile &profile,
+                  const ChainId &chain) {
+    IdentityDigests ids;
+    std::string error;
+    Check(ComputeIdentities(tx, profile, chain, ids, error),
+          "output identity: " + error);
+    return Outpoint{ids.txid, 0};
+}
+
+void FailedWitnessWritesNoHeader() {
+    World world;
+    const Hash parent_utxo = world.utxo.Root();
+    const std::array<uint8_t, 56> parent_money =
+        EncodeMonetaryState(world.monetary);
+    const Hash parent_state = world.parent.header.state_root;
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    Transaction first = Payment(world.funding.outpoint, 15000);
+    first.outputs[0].branches = {BranchLeaf(PUSH_ZERO)};
+    const Outpoint created =
+        OutputOf(first, profile.transaction, world.parent.chain_id);
+    const Transaction second = Payment(created, 10000, PUSH_ZERO);
+    Check(second.inputs.size() == 1 && second.inputs[0].witnesses.size() == 1 &&
+              second.inputs[0].witnesses[0].script == PUSH_ZERO &&
+              PUSH_ZERO.size() == 1 && PUSH_ZERO[0] == 0x00 &&
+              first.outputs[0].branches[0] == BranchLeaf(PUSH_ZERO),
+          "failing witness is not 0x00");
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    const std::filesystem::path header_dir = directory / "header";
+    std::string error;
+    std::vector<uint8_t> parent_utxo_file;
+    std::vector<uint8_t> parent_money_file;
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "open failed utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "open failed monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "open failed header: " + error);
+        SeedUtxo(utxo_store, world);
+        SeedMonetary(monetary_store, world);
+        parent_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        parent_money_file = ReadRaw(money_dir / "monetary.dat");
+        ExpectEmptyHeader(header_store, header_dir, "before failed connect");
+        OrdinaryBlockConnected discarded;
+        Check(!ConnectOrdinaryBlock({first, second}, world.parent, profile,
+                                    kMonetary, world.view, world.utxo,
+                                    world.monetary, discarded, error,
+                                    &utxo_store, &monetary_store),
+              "0x00 witness was accepted");
+        Check(error == "witness VM invalid/unsupported: unclean final stack",
+              "0x00 witness rejection: " + error);
+        // A failed connect is not sealed and is not written to the header file.
+        ExpectEmptyHeader(header_store, header_dir, "failed connect");
+        ExpectParentStores(utxo_store, monetary_store, parent_utxo, parent_money,
+                           parent_state, "failed connect");
+        Check(world.utxo.Root() == parent_utxo &&
+                  EncodeMonetaryState(world.monetary) == parent_money,
+              "failed connect moved the in-memory parent");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "failed connect changed a seed file");
+        Check(DatFiles(utxo_dir / "undo") == 1 &&
+                  DatFiles(money_dir / "monetary-undo") == 1,
+              "failed connect left a block commit");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen failed utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen failed monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "reopen failed header: " + error);
+        ExpectEmptyHeader(header_store, header_dir, "reopened failed connect");
+        ExpectParentStores(utxo_store, monetary_store, parent_utxo, parent_money,
+                           parent_state, "reopened failed connect");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "reopen after 0x00 witness changed a seed file");
+    }
+    std::filesystem::remove_all(directory);
+}
