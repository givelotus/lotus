+        OrdinarySealedHeaderRoundTrip();
+        FailedWitnessWritesNoHeader();
+        std::cout << "ordinary sealed header store checks passed\n";
+        return 0;
+    } catch (const std::exception &failure) {
+        std::cerr << failure.what() << '\n';
+        return 1;
+    }
