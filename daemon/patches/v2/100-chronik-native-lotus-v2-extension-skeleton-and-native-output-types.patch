--- /dev/null
+++ b/chronik/native/ext/lotus_v2/lotus_v2.cmake
@@ -0,0 +1,43 @@
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+# Lotus V2 tier extension of the native Chronik (design C1 §5, §7.2):
+# the V2 branch/asset groups of the legacy index and the native V2 service
+# (v2_index env, /v2 and /v2/explorer/v1 routes). Plain C++ on the native
+# core; it never includes node headers (the host adapter converts node
+# blocks into the extension's input).
+#
+# Each area keeps its own list in ext/lotus_v2/<area>/sources.cmake,
+# appending to CHRONIK_NATIVE_LOTUS_V2_SOURCES / _TEST_SOURCES and, for
+# libraries it needs (e.g. the MDBX store), CHRONIK_NATIVE_LOTUS_V2_LIBRARIES.
+
+set(CHRONIK_NATIVE_LOTUS_V2_ROOT "${CHRONIK_NATIVE_ROOT}/ext/lotus_v2")
+set(CHRONIK_NATIVE_LOTUS_V2_SOURCES
+    "${CHRONIK_NATIVE_LOTUS_V2_ROOT}/types.cpp"
+)
+set(CHRONIK_NATIVE_LOTUS_V2_TEST_SOURCES
+    "${CHRONIK_NATIVE_LOTUS_V2_ROOT}/test/types_tests.cpp"
+)
+set(CHRONIK_NATIVE_LOTUS_V2_LIBRARIES)
+file(GLOB _lotus_v2_source_lists CONFIGURE_DEPENDS
+    "${CHRONIK_NATIVE_LOTUS_V2_ROOT}/*/sources.cmake")
+list(SORT _lotus_v2_source_lists)
+foreach(_list ${_lotus_v2_source_lists})
+    include("${_list}")
+endforeach()
+
+add_library(chronik_native_lotus_v2 STATIC ${CHRONIK_NATIVE_LOTUS_V2_SOURCES})
+target_include_directories(chronik_native_lotus_v2
+    PUBLIC "${CHRONIK_NATIVE_ROOT}")
+target_link_libraries(chronik_native_lotus_v2
+    PUBLIC chronik_native_core ${CHRONIK_NATIVE_LOTUS_V2_LIBRARIES})
+set_target_properties(chronik_native_lotus_v2 PROPERTIES
+    POSITION_INDEPENDENT_CODE ON)
+
+target_sources(test_chronik_native PRIVATE ${CHRONIK_NATIVE_LOTUS_V2_TEST_SOURCES})
+target_link_libraries(test_chronik_native chronik_native_lotus_v2)
+target_compile_definitions(test_chronik_native PRIVATE
+    # The Rust V2 test vectors, shared with bitcoinsuite-core.
+    CHRONIK_NATIVE_LOTUS_V2_FIXTURES_DIR="${CHRONIK_NATIVE_REPO_ROOT}/chronik/bitcoinsuite-core/src/lotus_v2/fixtures"
+)
diff --git a/chronik/native/ext/lotus_v2/test/types_tests.cpp b/chronik/native/ext/lotus_v2/test/types_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d00e93b943a6833f9ca347e51f4f2ab46262831a
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/test/types_tests.cpp
@@ -0,0 +1,194 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Port of the bitcoinsuite-core/src/lotus_v2.rs tests, against the same
+// fixtures (lotus_v2/fixtures/native_outputs.json).
+
+#include <chronik/native/codec/hex.h>
+#include <ext/lotus_v2/types.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+
+using namespace chronik::native;
+using namespace chronik::native::lotus_v2;
+
+namespace {
+
+/** The flat {"name": "hex"} JSON object of native output vectors. */
+std::map<std::string, Bytes> Fixtures() {
+    std::ifstream in(std::string(CHRONIK_NATIVE_LOTUS_V2_FIXTURES_DIR) +
+                     "/native_outputs.json");
+    BOOST_REQUIRE_MESSAGE(in, "missing lotus_v2/fixtures/native_outputs.json");
+    std::stringstream ss;
+    ss << in.rdbuf();
+    const std::string s = ss.str();
+    std::map<std::string, Bytes> out;
+    size_t pos = 0;
+    while (true) {
+        const size_t k0 = s.find('"', pos);
+        if (k0 == std::string::npos) {
+            break;
+        }
+        const size_t k1 = s.find('"', k0 + 1);
+        const size_t v0 = s.find('"', k1 + 1);
+        const size_t v1 = s.find('"', v0 + 1);
+        BOOST_REQUIRE(k1 != std::string::npos && v1 != std::string::npos);
+        auto bytes = HexDecode(s.substr(v0 + 1, v1 - v0 - 1));
+        BOOST_REQUIRE(bytes);
+        out[s.substr(k0 + 1, k1 - k0 - 1)] = *bytes;
+        pos = v1 + 1;
+    }
+    BOOST_REQUIRE_EQUAL(out.size(), 4u);
+    return out;
+}
+
+Hash32 Fill(uint8_t b) {
+    Hash32 h;
+    h.b.fill(b);
+    return h;
+}
+
+std::optional<std::string_view> DecodeError(ByteView bytes) {
+    OutputError err;
+    if (Output::Decode(bytes, &err)) {
+        return std::nullopt;
+    }
+    return err.category;
+}
+
+std::optional<std::string_view> ValidateError(const Output &output) {
+    auto err = output.Validate();
+    return err ? std::optional<std::string_view>(err->category) : std::nullopt;
+}
+
+} // namespace
+
+BOOST_AUTO_TEST_SUITE(lotus_v2_types_tests)
+
+BOOST_AUTO_TEST_CASE(native_reference_roundtrips) {
+    for (const auto &[name, bytes] : Fixtures()) {
+        BOOST_TEST_CONTEXT(name) {
+            auto output = Output::Decode(bytes);
+            BOOST_REQUIRE(output);
+            BOOST_CHECK(*output->Encode() == bytes);
+            BOOST_CHECK_EQUAL(output->IsBurn(),
+                              name.find("burn") != std::string::npos);
+            BOOST_CHECK_EQUAL(output->HasToken(),
+                              name.find("token") != std::string::npos);
+            if (name == "token") {
+                BOOST_CHECK_EQUAL(output->value, UINT64_MAX);
+            }
+            for (size_t end = 0; end < bytes.size(); ++end) {
+                BOOST_CHECK(!Output::Decode(ByteView(bytes).first(end)));
+            }
+            Bytes extra = bytes;
+            extra.push_back(0);
+            BOOST_CHECK(DecodeError(extra) == "trailing bytes");
+        }
+    }
+}
+
+BOOST_AUTO_TEST_CASE(structural_bounds_and_order) {
+    Output output;
+    output.flags = 1;
+    output.value = UINT64_MAX;
+    output.token_id = Fill(1);
+    for (uint8_t i = 0; i < 16; ++i) {
+        output.branches.push_back(Fill(i));
+        output.paths.push_back({i});
+    }
+    BOOST_CHECK(Output::Decode(*output.Encode()) == output);
+    std::vector<uint8_t> all;
+    for (uint8_t i = 0; i < 16; ++i) {
+        all.push_back(i);
+    }
+    output.paths = {all};
+    BOOST_CHECK(output.Encode());
+    output.paths = {{1, 0}};
+    BOOST_CHECK(ValidateError(output) == "path index");
+    output.paths = {{1}, {0}};
+    BOOST_CHECK(ValidateError(output) == "path order");
+    output.paths = {{16}};
+    BOOST_CHECK(ValidateError(output) == "path index");
+    output.paths = {{0}};
+    output.branches[1] = output.branches[0];
+    BOOST_CHECK(ValidateError(output) == "duplicate branch");
+    BOOST_CHECK(DecodeError(Bytes(813, 0)) == "output bytes");
+}
+
+BOOST_AUTO_TEST_CASE(validation_rejects_non_native_models) {
+    const auto base = *Output::Decode(Fixtures().at("native"));
+    const struct {
+        uint8_t flags;
+        Hash32 token_id;
+        std::string_view expected;
+    } cases[] = {
+        {4, Hash32{}, "flags"},
+        {1, Hash32{}, "zero token"},
+        {0, Fill(1), "native token field"},
+        {2, Hash32{}, "burn paths"},
+    };
+    for (const auto &c : cases) {
+        Output bad = base;
+        bad.flags = c.flags;
+        bad.token_id = c.token_id;
+        BOOST_CHECK(ValidateError(bad) == c.expected);
+    }
+    {
+        Output bad = base;
+        bad.branches.clear();
+        BOOST_CHECK(ValidateError(bad) == "branch count");
+        for (uint8_t i = 0; i < 17; ++i) {
+            bad.branches.push_back(Fill(i));
+        }
+        BOOST_CHECK(ValidateError(bad) == "branch count");
+    }
+    {
+        Output bad = base;
+        bad.paths.clear();
+        BOOST_CHECK(ValidateError(bad) == "path count");
+        bad.paths.assign(17, {0});
+        BOOST_CHECK(ValidateError(bad) == "path count");
+    }
+    Transaction tx;
+    tx.lock = UINT64_MAX;
+    BOOST_CHECK_EQUAL(tx.lock, UINT64_MAX);
+    BOOST_CHECK_EQUAL(OutputError{"flags"}.Message(),
+                      "invalid Lotus V2 output: flags");
+}
+
+BOOST_AUTO_TEST_CASE(malformed_native_frames) {
+    const Bytes bytes = Fixtures().at("native");
+    const struct {
+        size_t offset;
+        uint8_t value;
+        std::string_view error;
+    } cases[] = {
+        {0, 4, "flags"},
+        {9, 17, "branch count"},
+        {9, 0, "path count"},
+        {44, 1, "path index"},
+        {43, 0, "trailing bytes"},
+    };
+    for (const auto &c : cases) {
+        Bytes bad = bytes;
+        bad[c.offset] = c.value;
+        BOOST_CHECK(DecodeError(bad) == c.error);
+    }
+    Bytes bad = bytes;
+    bad.erase(bad.begin() + 9);
+    const uint8_t compact[] = {253, 1, 0};
+    bad.insert(bad.begin() + 9, std::begin(compact), std::end(compact));
+    BOOST_CHECK(DecodeError(bad) == "branch count");
+    Bytes burn = bytes;
+    burn[0] = 2;
+    BOOST_CHECK(DecodeError(burn) == "burn paths");
+}
+
+BOOST_AUTO_TEST_SUITE_END()
diff --git a/chronik/native/ext/lotus_v2/types.cpp b/chronik/native/ext/lotus_v2/types.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..11a8dc71cceffdcbeabd01c63de0a2351d2e951c
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/types.cpp
@@ -0,0 +1,223 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <ext/lotus_v2/types.h>
+
+#include <algorithm>
+
+namespace chronik::native::lotus_v2 {
+
+namespace {
+
+/** Rust `Reader`: consumes a byte slice from the front. */
+class Reader {
+public:
+    explicit Reader(ByteView bytes) : m_rest(bytes) {}
+
+    bool Take(size_t n, ByteView &out) {
+        if (n > m_rest.size()) {
+            return false;
+        }
+        out = m_rest.first(n);
+        m_rest = m_rest.subspan(n);
+        return true;
+    }
+    bool Byte(uint8_t &out) {
+        ByteView b;
+        if (!Take(1, b)) {
+            return false;
+        }
+        out = b[0];
+        return true;
+    }
+    bool Hash(Hash32 &out) {
+        ByteView b;
+        if (!Take(32, b)) {
+            return false;
+        }
+        std::copy(b.begin(), b.end(), out.b.begin());
+        return true;
+    }
+    /** Multi-byte CompactSize cannot encode any permitted count minimally. */
+    bool Count(uint8_t cap, size_t &out) {
+        uint8_t n;
+        if (!Byte(n) || n > cap) {
+            return false;
+        }
+        out = n;
+        return true;
+    }
+    size_t Remaining() const { return m_rest.size(); }
+
+private:
+    ByteView m_rest;
+};
+
+std::optional<Output> Fail(OutputError *error, std::string_view category) {
+    if (error) {
+        *error = OutputError{category};
+    }
+    return std::nullopt;
+}
+
+} // namespace
+
+std::string OutputError::Message() const {
+    return "invalid Lotus V2 output: " + std::string(category);
+}
+
+std::optional<OutputError> Output::Validate() const {
+    auto fail = [](std::string_view category) {
+        return std::optional<OutputError>(OutputError{category});
+    };
+    if (flags & 0xfc) {
+        return fail("flags");
+    }
+    if (HasToken()) {
+        if (token_id == Hash32{}) {
+            return fail("zero token");
+        }
+    } else if (token_id != Hash32{}) {
+        return fail("native token field");
+    }
+    if (branches.empty() || branches.size() > 16) {
+        return fail("branch count");
+    }
+    for (size_t i = 0; i < branches.size(); ++i) {
+        if (std::find(branches.begin(), branches.begin() + i, branches[i]) !=
+            branches.begin() + i) {
+            return fail("duplicate branch");
+        }
+    }
+    if (IsBurn()) {
+        if (!paths.empty()) {
+            return fail("burn paths");
+        }
+    } else if (paths.empty() || paths.size() > 16) {
+        return fail("path count");
+    }
+    for (size_t p = 0; p < paths.size(); ++p) {
+        const std::vector<uint8_t> &path = paths[p];
+        if (path.empty() || path.size() > branches.size()) {
+            return fail("path length");
+        }
+        for (size_t i = 0; i < path.size(); ++i) {
+            if (path[i] >= branches.size() ||
+                (i > 0 && path[i - 1] >= path[i])) {
+                return fail("path index");
+            }
+        }
+        if (p > 0 && paths[p - 1] >= path) {
+            return fail("path order");
+        }
+    }
+    return std::nullopt;
+}
+
+std::optional<Bytes> Output::Encode(OutputError *error) const {
+    if (auto err = Validate()) {
+        if (error) {
+            *error = *err;
+        }
+        return std::nullopt;
+    }
+    Bytes bytes;
+    bytes.reserve(MAX_OUTPUT_BYTES);
+    bytes.push_back(flags);
+    for (int i = 0; i < 8; ++i) {
+        bytes.push_back(uint8_t(value >> (8 * i)));
+    }
+    if (HasToken()) {
+        bytes.insert(bytes.end(), token_id.b.begin(), token_id.b.end());
+    }
+    // All CompactSize fields are bounded below 253, hence one byte.
+    bytes.push_back(uint8_t(branches.size()));
+    for (const Hash32 &root : branches) {
+        bytes.insert(bytes.end(), root.b.begin(), root.b.end());
+    }
+    bytes.push_back(uint8_t(paths.size()));
+    for (const std::vector<uint8_t> &path : paths) {
+        bytes.push_back(uint8_t(path.size()));
+        bytes.insert(bytes.end(), path.begin(), path.end());
+    }
+    if (bytes.size() > MAX_OUTPUT_BYTES) {
+        if (error) {
+            *error = OutputError{"output bytes"};
+        }
+        return std::nullopt;
+    }
+    return bytes;
+}
+
+std::optional<Output> Output::Decode(ByteView bytes, OutputError *error) {
+    if (bytes.size() > MAX_OUTPUT_BYTES) {
+        return Fail(error, "output bytes");
+    }
+    Reader r(bytes);
+    Output output;
+    if (!r.Byte(output.flags)) {
+        return Fail(error, "truncated flags");
+    }
+    if (output.flags & 0xfc) {
+        return Fail(error, "flags");
+    }
+    ByteView value;
+    if (!r.Take(8, value)) {
+        return Fail(error, "truncated value");
+    }
+    for (int i = 0; i < 8; ++i) {
+        output.value |= uint64_t(value[i]) << (8 * i);
+    }
+    if ((output.flags & 1) && !r.Hash(output.token_id)) {
+        return Fail(error, "truncated token");
+    }
+    size_t n;
+    if (!r.Count(16, n)) {
+        return Fail(error, "branch count");
+    }
+    if (n > r.Remaining() / 32) {
+        return Fail(error, "truncated branches");
+    }
+    output.branches.resize(n);
+    for (Hash32 &branch : output.branches) {
+        if (!r.Hash(branch)) {
+            return Fail(error, "truncated branches");
+        }
+    }
+    if (!r.Count(16, n)) {
+        return Fail(error, "path count");
+    }
+    if (n > r.Remaining()) {
+        return Fail(error, "truncated paths");
+    }
+    output.paths.reserve(n);
+    for (size_t p = 0; p < n; ++p) {
+        size_t length;
+        if (!r.Count(16, length)) {
+            return Fail(error, "path length");
+        }
+        if (length > r.Remaining()) {
+            return Fail(error, "truncated path");
+        }
+        std::vector<uint8_t> path;
+        path.reserve(length);
+        for (size_t i = 0; i < length; ++i) {
+            size_t idx;
+            if (!r.Count(15, idx)) {
+                return Fail(error, "path index");
+            }
+            path.push_back(uint8_t(idx));
+        }
+        output.paths.push_back(std::move(path));
+    }
+    if (r.Remaining() != 0) {
+        return Fail(error, "trailing bytes");
+    }
+    if (auto err = output.Validate()) {
+        return Fail(error, err->category);
+    }
+    return output;
+}
+
+} // namespace chronik::native::lotus_v2
diff --git a/chronik/native/ext/lotus_v2/types.h b/chronik/native/ext/lotus_v2/types.h
new file mode 100644
index 0000000000000000000000000000000000000000..dd33754fc49a0cb1a954c0db50582c6ad875872e
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/types.h
@@ -0,0 +1,164 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_EXT_LOTUS_V2_TYPES_H
+#define CHRONIK_NATIVE_EXT_LOTUS_V2_TYPES_H
+
+#include <chronik/native/types.h>
+
+#include <compare>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/**
+ * Lossless public Lotus V2 indexing records, separate from legacy
+ * transactions: port of bitcoinsuite-core/src/lotus_v2.rs (V2 tier).
+ *
+ * Wire order is the native byte order: hashes are never reversed. The output
+ * codec follows src/lotus_v2/output.{h,cpp}. No transaction codec, identity
+ * computation, contextual validation or ownership inference is implied.
+ */
+namespace chronik::native::lotus_v2 {
+
+/** A 32-byte commitment in V2 wire order (no display-endian conversion). */
+using Hash32 = native::Hash32;
+
+/** V2 transaction identifier; distinct from the full-serialization hash. */
+struct TxId {
+    Hash32 hash;
+    auto operator<=>(const TxId &) const = default;
+};
+
+/** V2 full transaction hash (accepted witness variant identity). */
+struct TxHash {
+    Hash32 hash;
+    auto operator<=>(const TxHash &) const = default;
+};
+
+/** An output reference uses TxID, never TxHash. */
+struct OutPoint {
+    TxId txid;
+    uint32_t out_idx = 0;
+    auto operator<=>(const OutPoint &) const = default;
+};
+
+/** Hard native framing bound, independent of stricter deployment profiles. */
+inline constexpr size_t MAX_OUTPUT_BYTES = 812;
+/** Maximum branches and paths in the native output grammar. */
+inline constexpr size_t MAX_OUTPUT_BRANCHES = 16;
+
+/** A stable native output framing/structural error category (OutputError). */
+struct OutputError {
+    std::string_view category;
+    bool operator==(const OutputError &) const = default;
+    /** "invalid Lotus V2 output: <category>" (Rust Display). */
+    std::string Message() const;
+};
+
+/**
+ * Native public output fields. Branch positions are vector indices (0..16),
+ * not hidden leaf positions. Root matches establish neither ownership nor
+ * spendability; burns also carry public roots.
+ */
+struct Output {
+    /** Bit 0: token; bit 1: burn. All other bits must be zero. */
+    uint8_t flags = 0;
+    /** Unsigned native/token quantity, including the full u64 range. */
+    uint64_t value = 0;
+    /** Nonzero exactly when the token flag is set; otherwise all zero. */
+    Hash32 token_id;
+    /** Complete ordered, distinct public authorization roots. */
+    std::vector<Hash32> branches;
+    /** Lexicographically ordered paths of strictly increasing indices. */
+    std::vector<std::vector<uint8_t>> paths;
+
+    bool operator==(const Output &) const = default;
+
+    bool HasToken() const { return (flags & 1) != 0; }
+    /** Whether this is a burn commitment (excluded from UTXOs). */
+    bool IsBurn() const { return (flags & 2) != 0; }
+
+    /** Check native output structure only (no coin or script validation). */
+    std::optional<OutputError> Validate() const;
+    /** Encode a canonical native output frame after structural checks. */
+    std::optional<Bytes> Encode(OutputError *error = nullptr) const;
+    /**
+     * Decode exactly one native frame, rejecting trailing bytes and
+     * allocating only after count bounds and available bytes are checked.
+     */
+    static std::optional<Output> Decode(ByteView bytes,
+                                        OutputError *error = nullptr);
+};
+
+/**
+ * A revealed branch witness. Siblings prove unordered membership, not a
+ * hidden leaf position, tree size or uniqueness.
+ */
+struct BranchWitness {
+    Bytes script;
+    std::vector<Hash32> siblings;
+    std::vector<Bytes> arguments;
+    bool operator==(const BranchWitness &) const = default;
+};
+
+/** Native transaction input, retaining framing distinctions losslessly. */
+struct Input {
+    OutPoint prev_out;
+    uint32_t sequence = 0;
+    /** Native discriminator: 1 spend, 2 coinbase, 3 mint. */
+    uint8_t flags = 0;
+    /** Selected public output path (meaningful only for spends). */
+    uint8_t path_index = 0;
+    std::vector<BranchWitness> witnesses;
+    /** Presence is distinct from a present empty coinbase payload. */
+    std::optional<Bytes> coinbase_data;
+    bool operator==(const Input &) const = default;
+};
+
+/** Native transaction fields; callers must perform profile/context checks. */
+struct Transaction {
+    uint64_t lock = 0;
+    std::vector<Input> inputs;
+    std::vector<Output> outputs;
+    bool operator==(const Transaction &) const = default;
+};
+
+/** Authoritative confirmed transaction location, bound to a block. */
+struct TxLocation {
+    /** Native block ID in wire order. */
+    Hash32 block_id;
+    uint64_t height = 0;
+    uint32_t tx_index = 0;
+    /** Merkleized transaction ID. */
+    TxId txid;
+    /** Full transaction hash of the accepted variant. */
+    TxHash txhash;
+    bool operator==(const TxLocation &) const = default;
+};
+
+/** A recorded consumption of an indexed output. */
+struct SpendLocation {
+    TxLocation transaction;
+    uint32_t input_index = 0;
+    bool operator==(const SpendLocation &) const = default;
+};
+
+/**
+ * Complete confirmed output record; no pending state is inferred. Burns
+ * belong in creation history, never the UTXO set.
+ */
+struct OutputRecord {
+    OutPoint outpoint;
+    Output output;
+    TxLocation creation;
+    std::optional<SpendLocation> spend;
+    bool operator==(const OutputRecord &) const = default;
+};
+
+} // namespace chronik::native::lotus_v2
+
+#endif // CHRONIK_NATIVE_EXT_LOTUS_V2_TYPES_H
