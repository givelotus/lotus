+/**
+ * Compact template block message (tmplblock): carries only the 160-byte V2
+ * CBlockHeader and the coinbase transaction for O(1) full CBlock reconstruction
+ * against a reconciled local candidate overlay / CTOR mempool.
+ */
+class CompactTemplateBlock {
+public:
+    CBlockHeader header;
+    CTransactionRef coinbase_tx;
+
+    CompactTemplateBlock() = default;
+    explicit CompactTemplateBlock(const CBlock &block);
+    CompactTemplateBlock(const CBlockHeader &headerIn,
+                         CTransactionRef coinbaseIn)
+        : header(headerIn), coinbase_tx(std::move(coinbaseIn)) {}
+
+    bool IsValid() const {
+        return !header.IsNull() && coinbase_tx != nullptr &&
+               !coinbase_tx->IsNull() && coinbase_tx->IsCoinBase();
+    }
+
+    SERIALIZE_METHODS(CompactTemplateBlock, obj) {
+        READWRITE(obj.header, Using<TransactionCompression>(obj.coinbase_tx));
+    }
+};
+
+using TemplateBlockAnnounce = CompactTemplateBlock;
+
