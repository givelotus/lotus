From 09c2278501efc8f766bc2f2aa661a7f62d418462 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:22:21 -0700
Subject: [PATCH] Stage proof transitions before committing Avalanche block
 batches

Maintenance explanation added during mailbox export:
Stage proof transitions before committing an Avalanche block decision batch. This lets proof validation refuse the batch before durable block effects are applied, preserving the intended atomic boundary.

---
 src/lotus_v2/avalanche_poll.cpp   | 9 +++++----
 src/lotus_v2/avalanche_quorum.cpp | 8 ++++++++
 src/lotus_v2/avalanche_quorum.h   | 4 ++++
 3 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/avalanche_poll.cpp b/src/lotus_v2/avalanche_poll.cpp
index 6bd28ee433ce29a32037dcd445af1ca60645ac2c..8b8a873ca4d8daecf6f39e6ed4e7a2dd4ac4c885 100644
--- a/src/lotus_v2/avalanche_poll.cpp
+++ b/src/lotus_v2/avalanche_poll.cpp
@@ -91,11 +91,12 @@ bool PollEngine::Receive(Quorum &quorum,NodeId node,const SignedResponse &signed
         if(item.kind==ItemKind::Block) blocks.push_back(BlockUpdate{item.id,status,snapshot.tip,snapshot.generation});
         if(status==Status::Finalized || status==Status::Invalid || status==Status::Stale) staged.erase(record);
     }
-    if(!blocks.empty() && (!apply || !apply(blocks,error))) return false;
+    std::vector<std::pair<::avalanche::ProofId,Status>> proof_updates;
+    for(const auto &[item,status]:updates) if(item.kind==ItemKind::Proof) proof_updates.emplace_back(::avalanche::ProofId(Native(item.id)),status);
+    auto commit_blocks=[&](std::string &failure) { return blocks.empty() || (apply && apply(blocks,failure)); };
+    if(!quorum.ApplyProofVotes(proof_updates,now/1000,commit_blocks,error)) return false;
     for(const auto &[item,status]:updates) {
-        if(item.kind==ItemKind::Proof) {
-            if(!quorum.ApplyProofVote(::avalanche::ProofId(Native(item.id)),status,now/1000,error)) return false;
-        } else if(status==Status::Invalid) impl_->invalidated.insert(item.id);
+        if(item.kind==ItemKind::Block && status==Status::Invalid) impl_->invalidated.insert(item.id);
         if(status==Status::Finalized) impl_->finalized.insert(item.id);
     }
     impl_->records.swap(staged);
diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index 815aaa84026f7f89857965301be325047a0f0420..28426c0c40c015107ac0d050a81fe570ade226f2 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -208,6 +208,14 @@ bool Quorum::ApplyProofVote(const ::avalanche::ProofId &id,Status status,int64_t
     if(status==Status::Finalized) { it->second.finalized=true; impl_->finalized.insert(id); }
     return true;
 }
+bool Quorum::ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,Status>> &votes,
+    int64_t now,const std::function<bool(std::string &)> &commit_blocks,std::string &error) {
+    if(votes.empty()) return commit_blocks && commit_blocks(error);
+    Quorum staged(impl_->profile); staged.impl_=std::make_unique<Impl>(*impl_);
+    for(const auto &[id,status]:votes) if(!staged.ApplyProofVote(id,status,now,error)) return false;
+    if(!commit_blocks || !commit_blocks(error)) return false;
+    impl_.swap(staged.impl_); return true;
+}
 uint32_t Quorum::Vote(const ::avalanche::ProofId &id) const {
     if(impl_->invalid.contains(id)) return 1;
     if(impl_->active.getProof(id)) return 0;
diff --git a/src/lotus_v2/avalanche_quorum.h b/src/lotus_v2/avalanche_quorum.h
index 8fa9a851b3a9996f373fa0e8045579ca126fb889..0c9dec9bd34a513421c5dd649ebd150a5b45d753 100644
--- a/src/lotus_v2/avalanche_quorum.h
+++ b/src/lotus_v2/avalanche_quorum.h
@@ -28,6 +28,10 @@ public:
     bool Revalidate(const ChainSnapshot &, const CoinLookup &, int64_t now_seconds, const SnapshotReader &, std::string &);
     bool ApplyProofVote(const ::avalanche::ProofId &, Status, int64_t now_seconds,
                         std::string &);
+    bool ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,Status>> &,
+                         int64_t now_seconds,
+                         const std::function<bool(std::string &)> &commit_blocks,
+                         std::string &);
     uint32_t Vote(const ::avalanche::ProofId &) const;
     bool Immature(const ::avalanche::ProofId &) const;
     bool Known(const ::avalanche::ProofId &) const;
