From 63e0eaac4151a1670647e92b1169c1a46dcab506 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 11:12:31 -0700
Subject: [PATCH] Connect recovery steps through existing complete validation

Share deterministic connect and predecessor-checked disconnect implementations between ordinary and recovery callers. Recovery only changes the transaction publication API so journal progress joins the same state batch. Caller controls ancestor eligibility. Syntax checks and independently linked full-block recovery fixtures exercise these bridges.
---
 src/lotus_v2/development_chain.cpp | 23 +++++++++++++++---
 src/lotus_v2/development_chain.h   |  6 +++++
 src/lotus_v2/disk_block.cpp        | 39 +++++++++++++++++++++++++-----
 src/lotus_v2/disk_block.h          |  8 ++++++
 4 files changed, 67 insertions(+), 9 deletions(-)

diff --git a/src/lotus_v2/development_chain.cpp b/src/lotus_v2/development_chain.cpp
index 44bf09c5b..32d9cc7e4 100644
--- a/src/lotus_v2/development_chain.cpp
+++ b/src/lotus_v2/development_chain.cpp
@@ -116,10 +116,11 @@ bool OpenDevelopmentChain(
         error.clear(); return true;
     } catch (const std::exception &e) { error = e.what(); return false; }
 }
-bool DisconnectDevelopmentTip(
+static bool DisconnectDevelopmentTipImpl(
     const Hash &expected_tip, const HeaderChainProfile &hp,
     const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
-    const BlockCostProfile &cp, DiskStateStore &store, std::string &error) {
+    const BlockCostProfile &cp, const DiskRecoveryUpdate *recovery,
+    DiskStateStore &store, std::string &error) {
     try {
         Require(hp.genesis_id != Hash{}, "explicit genesis identity required");
         Require(store.MatchesProfile(hp.chain_id, BlockValidationProfileDigest(hp, op, mp, cp)),
@@ -144,8 +145,24 @@ bool DisconnectDevelopmentTip(
             }
         };
         DiskStateError failure;
-        if (!store.Disconnect(expected_tip, validate, failure)) { error = failure.message; return false; }
+        const bool disconnected = recovery
+            ? store.DisconnectRecovery(expected_tip, validate, *recovery, failure)
+            : store.Disconnect(expected_tip, validate, failure);
+        if (!disconnected) { error = failure.message; return false; }
         error.clear(); return true;
     } catch (const std::exception &e) { error = e.what(); return false; }
 }
+bool DisconnectDevelopmentTip(
+    const Hash &expected_tip, const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp, DiskStateStore &store, std::string &error) {
+    return DisconnectDevelopmentTipImpl(expected_tip, hp, op, mp, cp, nullptr, store, error);
+}
+bool DisconnectRecoveryDevelopmentTip(
+    const Hash &expected_tip, const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp, const DiskRecoveryUpdate &recovery,
+    DiskStateStore &store, std::string &error) {
+    return DisconnectDevelopmentTipImpl(expected_tip, hp, op, mp, cp, &recovery, store, error);
+}
 } // namespace lotus::v2
diff --git a/src/lotus_v2/development_chain.h b/src/lotus_v2/development_chain.h
index 06b81a750..8d7821b86 100644
--- a/src/lotus_v2/development_chain.h
+++ b/src/lotus_v2/development_chain.h
@@ -24,5 +24,11 @@ bool DisconnectDevelopmentTip(
     const Hash &expected_tip, const HeaderChainProfile &hp,
     const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
     const BlockCostProfile &cp, DiskStateStore &store, std::string &error);
+// Same predecessor/genesis checks, with progress published atomically by storage.
+bool DisconnectRecoveryDevelopmentTip(
+    const Hash &expected_tip, const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp, const DiskRecoveryUpdate &recovery,
+    DiskStateStore &store, std::string &error);
 } // namespace lotus::v2
 #endif
diff --git a/src/lotus_v2/disk_block.cpp b/src/lotus_v2/disk_block.cpp
index b5e52e856..abc7b9f27 100644
--- a/src/lotus_v2/disk_block.cpp
+++ b/src/lotus_v2/disk_block.cpp
@@ -75,10 +75,16 @@ bool ReadDiskChainContext(const DiskStateMetadata &meta, const HeaderChainProfil
     std::vector<uint8_t> body(bytes.begin() + end, bytes.end());
     history = std::move(decoded); block = std::move(body); error.clear(); return true;
 }
-CandidateCheckResult ConnectStoredDiskBlock(
+static CandidateCheckResult ConnectDiskBlockImpl(
+    const std::vector<uint8_t> &, const std::vector<Header> &,
+    const HeaderChainProfile &, const OrdinaryCandidateProfile &,
+    const MonetaryProfile &, const BlockCostProfile &, const DiskRecoveryUpdate *,
+    DiskStateStore &, StagedBlockTransition &, std::string &);
+static CandidateCheckResult ConnectStoredDiskBlockImpl(
     const std::vector<uint8_t> &wire, const HeaderChainProfile &hp,
     OrdinaryCandidateProfile op, const MonetaryProfile &mp, const BlockCostProfile &cp,
-    DiskStateStore &store, StagedBlockTransition &out, std::string &error) {
+    const DiskRecoveryUpdate *recovery, DiskStateStore &store,
+    StagedBlockTransition &out, std::string &error) {
     try {
         std::vector<Header> history;
         std::vector<uint8_t> block;
@@ -89,11 +95,24 @@ CandidateCheckResult ConnectStoredDiskBlock(
         }
         op.candidate_height = history.front().height + 1;
         op.parent_mtp = *ParentMedianTime(hp, history.front(), history);
-        return ConnectDiskBlock(wire, history, hp, op, mp, cp, store, out, error);
+        return ConnectDiskBlockImpl(wire, history, hp, op, mp, cp, recovery, store, out, error);
     } catch (const std::exception &e) {
         error = e.what(); return CandidateCheckResult::StorageError;
     }
 }
+CandidateCheckResult ConnectStoredDiskBlock(
+    const std::vector<uint8_t> &wire, const HeaderChainProfile &hp,
+    OrdinaryCandidateProfile op, const MonetaryProfile &mp, const BlockCostProfile &cp,
+    DiskStateStore &store, StagedBlockTransition &out, std::string &error) {
+    return ConnectStoredDiskBlockImpl(wire, hp, std::move(op), mp, cp, nullptr, store, out, error);
+}
+CandidateCheckResult ConnectStoredRecoveryBlock(
+    const std::vector<uint8_t> &wire, const HeaderChainProfile &hp,
+    OrdinaryCandidateProfile op, const MonetaryProfile &mp, const BlockCostProfile &cp,
+    const DiskRecoveryUpdate &recovery, DiskStateStore &store,
+    StagedBlockTransition &out, std::string &error) {
+    return ConnectStoredDiskBlockImpl(wire, hp, std::move(op), mp, cp, &recovery, store, out, error);
+}
 DiskBlockAdmission ConnectEligibleDiskBlock(
     const std::vector<uint8_t> &wire, uint64_t now, uint64_t future_window,
     const HeaderChainProfile &hp, OrdinaryCandidateProfile op,
@@ -154,10 +173,10 @@ Hash BlockValidationProfileDigest(const HeaderChainProfile &hp,
     Hash digest; blake3_hasher_finalize(&hasher, digest.data(), digest.size());
     return digest;
 }
-CandidateCheckResult ConnectDiskBlock(
+static CandidateCheckResult ConnectDiskBlockImpl(
     const std::vector<uint8_t> &wire, const std::vector<Header> &history,
     const HeaderChainProfile &hp, const OrdinaryCandidateProfile &op,
-    const MonetaryProfile &mp, const BlockCostProfile &cp,
+    const MonetaryProfile &mp, const BlockCostProfile &cp, const DiskRecoveryUpdate *recovery,
     DiskStateStore &store, StagedBlockTransition &out, std::string &error) {
     using Result = CandidateCheckResult;
     try {
@@ -180,7 +199,8 @@ CandidateCheckResult ConnectDiskBlock(
         }
         DiskStateTransaction tx;
         DiskStateError failure;
-        if (!store.Begin(tx, failure)) { error = failure.message; return Result::StorageError; }
+        const bool begun = recovery ? store.BeginRecovery(*recovery, tx, failure) : store.Begin(tx, failure);
+        if (!begun) { error = failure.message; return Result::StorageError; }
         Adapter adapter(tx);
         StagedBlockTransition staged;
         const auto result = StageCompleteBlock(wire, parent, history, hp, op, mp, cp,
@@ -215,4 +235,11 @@ CandidateCheckResult ConnectDiskBlock(
         return Result::StorageError;
     }
 }
+CandidateCheckResult ConnectDiskBlock(
+    const std::vector<uint8_t> &wire, const std::vector<Header> &history,
+    const HeaderChainProfile &hp, const OrdinaryCandidateProfile &op,
+    const MonetaryProfile &mp, const BlockCostProfile &cp,
+    DiskStateStore &store, StagedBlockTransition &out, std::string &error) {
+    return ConnectDiskBlockImpl(wire, history, hp, op, mp, cp, nullptr, store, out, error);
+}
 } // namespace lotus::v2
diff --git a/src/lotus_v2/disk_block.h b/src/lotus_v2/disk_block.h
index 3e35c3115..f2ff35acf 100644
--- a/src/lotus_v2/disk_block.h
+++ b/src/lotus_v2/disk_block.h
@@ -25,6 +25,14 @@ CandidateCheckResult ConnectStoredDiskBlock(
     const std::vector<uint8_t> &wire, const HeaderChainProfile &hp,
     OrdinaryCandidateProfile op, const MonetaryProfile &mp, const BlockCostProfile &cp,
     DiskStateStore &store, StagedBlockTransition &out, std::string &error);
+// Executes identical deterministic validation while the storage transaction
+// publishes the supplied recovery progress in the same accepted-block batch.
+// The coordinator owns all-ancestor clock eligibility and plan validation.
+CandidateCheckResult ConnectStoredRecoveryBlock(
+    const std::vector<uint8_t> &wire, const HeaderChainProfile &hp,
+    OrdinaryCandidateProfile op, const MonetaryProfile &mp, const BlockCostProfile &cp,
+    const DiskRecoveryUpdate &recovery, DiskStateStore &store,
+    StagedBlockTransition &out, std::string &error);
 // Node admission adds external-clock eligibility without changing deterministic
 // consensus. Deferred bodies must be reconsidered as time advances; callers own
 // bounded retry queues and best-chain selection. No time-window default exists.
-- 
