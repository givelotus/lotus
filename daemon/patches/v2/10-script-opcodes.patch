+    test_expected.reserve(num.size());
+    for (int i = num.size() - 1; i >= 0; --i) {
+        test_num.insert(test_num.begin(), num[i]);
+        test_expected.insert(test_expected.begin(), expected[i]);
+        CheckTestResultForAllFlags({test_num},
