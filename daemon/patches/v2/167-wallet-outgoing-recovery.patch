Subject: [PATCH] Expose bounded recovery of persisted V2 outgoing transactions

---
 src/wallet/test/v2_wallet_tests.cpp | 50 +++++++++++++++++++++++++++++
 src/wallet/v2_wallet.cpp            | 38 ++++++++++++++++++++++
 src/wallet/v2_wallet.h              |  7 ++++
 3 files changed, 95 insertions(+)

diff --git a/src/wallet/test/v2_wallet_tests.cpp b/src/wallet/test/v2_wallet_tests.cpp
index e2870c3daea4642bf1b6742c23a10d2034525406..c8bc6c7dd5dafffe4d16950a082c77d68cb289c1 100644
--- a/src/wallet/test/v2_wallet_tests.cpp
+++ b/src/wallet/test/v2_wallet_tests.cpp
@@ -304,6 +304,29 @@ void RunV2WalletTests(const std::string &directory) {
                                           plan, exported, error),
             error);
     Check(exported.wire != std::vector<uint8_t>{0xaa}, "signed bytes exported");
+    const auto persisted_wire = exported.wire;
+    const auto persisted_txid = exported.txid;
+    std::vector<V2Hash> outgoing_ids{V2Hash{}};
+    Check(wallet->ListOutgoing(outgoing_ids, error) &&
+              outgoing_ids == std::vector<V2Hash>{persisted_txid},
+          "persisted signed transaction listed without signing again");
+    std::vector<uint8_t> recovered{0x77};
+    Check(wallet->ExportOutgoing(persisted_txid, persisted_wire.size(),
+                                 recovered, error) &&
+              recovered == persisted_wire,
+          "exact byte cap exports original persisted signed bytes");
+    recovered = {0x77};
+    Check(!wallet->ExportOutgoing(persisted_txid, persisted_wire.size() - 1,
+                                  recovered, error) &&
+              recovered == std::vector<uint8_t>{0x77},
+          "below byte cap preserves export output");
+    auto unknown_txid = persisted_txid;
+    unknown_txid[0] ^= 1;
+    Check(!wallet->ExportOutgoing(unknown_txid, persisted_wire.size(),
+                                  recovered, error) &&
+              recovered == std::vector<uint8_t>{0x77},
+          "unknown outgoing ID preserves export output");
+
     Transaction signed_tx;
     Check(DecodeTransaction(exported.wire, chain.profile.ordinary.transaction,
                             signed_tx, error),
@@ -344,6 +367,15 @@ void RunV2WalletTests(const std::string &directory) {
     Check(Wallet::Open(home, binding, wallet, error), error);
     Check(wallet->IsLocked() && wallet->PublicKey() == owner,
           "restart preserves locked key owner");
+    Check(wallet->ListOutgoing(outgoing_ids, error) &&
+              outgoing_ids == std::vector<V2Hash>{persisted_txid},
+          "outgoing IDs survive close/reopen while locked");
+    Check(
+        wallet->ExportOutgoing(persisted_txid, persisted_wire.size(), recovered,
+                               error) &&
+            recovered == persisted_wire && wallet->IsLocked(),
+        "locked recovery returns exact original signed wire without unlocking");
+
     Check(wallet->Unlock(passphrase, error), error);
     Check(PaymentEngine::Prepare(*wallet, chain.profile, chain.store, recipient,
                                  1000, low_fee,
@@ -368,6 +400,14 @@ void RunV2WalletTests(const std::string &directory) {
                         }) == 1,
           "disconnect restores funding and retains outgoing reservation");
     Check(wallet->Abandon(exported.txid, error), error);
+    Check(wallet->ListOutgoing(outgoing_ids, error) && outgoing_ids.empty(),
+          "Abandon removes outgoing recovery entry");
+    recovered = {0x77};
+    Check(!wallet->ExportOutgoing(persisted_txid, persisted_wire.size(),
+                                  recovered, error) &&
+              recovered == std::vector<uint8_t>{0x77},
+          "abandoned transaction cannot be retrieved and preserves output");
+
     Success(PaymentEngine::Prepare(*wallet, chain.profile, chain.store,
                                    recipient, 1000, plan, error),
             error);
@@ -396,6 +436,16 @@ void RunV2WalletTests(const std::string &directory) {
     Check(PaymentEngine::Prepare(*fault, chain.profile, chain.store, recipient,
                                  1000, low_fee, error) == Result::StorageError,
           "failed write requires reopen");
+    outgoing_ids = {persisted_txid};
+    recovered = {0x77};
+    Check(!fault->ListOutgoing(outgoing_ids, error) &&
+              outgoing_ids == std::vector<V2Hash>{persisted_txid},
+          "reopen-required listing preserves output");
+    Check(!fault->ExportOutgoing(persisted_txid, persisted_wire.size(),
+                                 recovered, error) &&
+              recovered == std::vector<uint8_t>{0x77},
+          "reopen-required export preserves output");
+
     fault.reset();
     RejectOutgoing(backup, false);
     Check(Wallet::Open(backup, binding, fault, error), error);
diff --git a/src/wallet/v2_wallet.cpp b/src/wallet/v2_wallet.cpp
index 5cbe85e927bdf2dfc82b16e145b7a27a88bd3dba..79a91899a9982d37a1755eeb1a7ab0d57c17cf9e 100644
--- a/src/wallet/v2_wallet.cpp
+++ b/src/wallet/v2_wallet.cpp
@@ -285,6 +285,44 @@ bool Wallet::Backup(const std::string &destination, std::string &error) const {
         return false;
     }
 }
+bool Wallet::ListOutgoing(std::vector<Hash> &out, std::string &error) const {
+    try {
+        if (reopen_required_) return Fail(error, "wallet reopen required");
+        if (outgoing_.size() > MAX_OUTGOING)
+            return Fail(error, "V2 outgoing record capacity exceeded");
+        std::vector<Hash> ids;
+        ids.reserve(outgoing_.size());
+        for (const auto &row : outgoing_)
+            ids.push_back(row.txid);
+        out.swap(ids);
+        error.clear();
+        return true;
+    } catch (const std::exception &e) {
+        error = e.what();
+        return false;
+    }
+}
+bool Wallet::ExportOutgoing(const Hash &txid, size_t max_bytes,
+                            std::vector<uint8_t> &out,
+                            std::string &error) const {
+    try {
+        if (reopen_required_) return Fail(error, "wallet reopen required");
+        const auto item =
+            std::find_if(outgoing_.begin(), outgoing_.end(),
+                         [&](const auto &row) { return row.txid == txid; });
+        if (item == outgoing_.end())
+            return Fail(error, "unknown exported V2 transaction");
+        if (item->wire.size() > max_bytes)
+            return Fail(error, "V2 outgoing transaction exceeds byte capacity");
+        auto bytes = item->wire;
+        out.swap(bytes);
+        error.clear();
+        return true;
+    } catch (const std::exception &e) {
+        error = e.what();
+        return false;
+    }
+}
 bool Wallet::Abandon(const Hash &txid, std::string &error) {
     try {
         if (reopen_required_) return Fail(error, "wallet reopen required");
diff --git a/src/wallet/v2_wallet.h b/src/wallet/v2_wallet.h
index 9a778a0db420122ff5ad99b54f8b45b5f992c7cd..0729582d0e0232b6b0723805d66dd52e69234ab1 100644
--- a/src/wallet/v2_wallet.h
+++ b/src/wallet/v2_wallet.h
@@ -61,6 +61,13 @@ public:
     // not revoke bytes previously exported or remove a transaction from a
     // chain.
     bool Abandon(const Hash &txid, std::string &error);
+    // Read-only recovery of already persisted outgoing transactions. Available
+    // while locked; no signing, reservation release or chain acceptance.
+    // IDs are bounded by the wallet's existing outgoing record limit. Outputs
+    // are unchanged on failure, including reopen-required and byte-cap refusal.
+    bool ListOutgoing(std::vector<Hash> &out, std::string &error) const;
+    bool ExportOutgoing(const Hash &txid, size_t max_bytes,
+                        std::vector<uint8_t> &out, std::string &error) const;
 
 private:
     Wallet(std::unique_ptr<WalletDatabase>, Profile);
