From 63f0ab0220d64a973b67dace11126d6333bf02e0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:20:14 -0700
Subject: [PATCH] build(v2): link transaction pool history and relay components

Maintenance explanation added during mailbox export:
Register the transaction pool, history, coordinator and relay components in the native build. This makes their reviewed implementations and test targets available to the integrated development candidate.

---
 src/CMakeLists.txt          |  3 ++-
 src/lotus_v2/CMakeLists.txt | 25 +++++++++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 3e8f47f0a92bf7816aeea5c3d0ec4ea0e537ac51..ca7b6a71617d146e3f06f0cfa82e8ef67c6c5b6c 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -993,7 +993,8 @@ target_link_libraries(lotusd server lotus_v2_validation)
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
     target_sources(lotusd PRIVATE lotus_v2/development_node_command.cpp)
     target_compile_definitions(lotusd PRIVATE LOTUS_V2_POSIX_NODE=1)
-    target_link_libraries(lotusd lotus_v2_peer_dispatcher lotus_v2_peer_tcp)
+    target_link_libraries(lotusd lotus_v2_peer_dispatcher lotus_v2_peer_tcp
+        lotus_v2_pool_coordinator lotus_v2_transaction_relay)
 endif()
 generate_windows_version_info(lotusd
 	DESCRIPTION "Lotus node with a JSON-RPC server"
diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 94b1dd43bd634c29a55a24eff185239bed9eacbe..09ef227a517ee51dbe31e417c51383745437d148 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -295,3 +295,28 @@ target_link_libraries(test_lotus_v2_block_assembler PRIVATE lotus_v2_development
 add_custom_target(check-lotus-v2-block-assembler
     COMMAND $<TARGET_FILE:test_lotus_v2_block_assembler>
     DEPENDS test_lotus_v2_block_assembler)
+
+# Transaction policy and its separately checkpointed active-chain history.
+add_library(lotus_v2_transaction_pool STATIC transaction_pool.cpp)
+target_link_libraries(lotus_v2_transaction_pool PUBLIC lotus_v2_validation)
+add_library(lotus_v2_pool_coordinator STATIC
+    pool_coordinator.cpp transaction_history.cpp)
+target_link_libraries(lotus_v2_pool_coordinator PUBLIC
+    lotus_v2_transaction_pool lotus_v2_development_runtime)
+add_library(lotus_v2_transaction_relay STATIC transaction_relay.cpp)
+target_link_libraries(lotus_v2_transaction_relay PUBLIC lotus_v2_peer_session)
+
+add_executable(test_lotus_v2_transaction_pool test_transaction_pool.cpp)
+target_link_libraries(test_lotus_v2_transaction_pool PRIVATE lotus_v2_transaction_pool)
+add_executable(test_lotus_v2_pool_coordinator test_pool_coordinator.cpp)
+target_link_libraries(test_lotus_v2_pool_coordinator PRIVATE lotus_v2_pool_coordinator)
+add_executable(test_lotus_v2_transaction_relay test_transaction_relay.cpp)
+target_compile_definitions(test_lotus_v2_transaction_relay PRIVATE LOTUS_RELAY_POOL_TEST=1)
+target_link_libraries(test_lotus_v2_transaction_relay PRIVATE
+    lotus_v2_transaction_relay lotus_v2_transaction_pool)
+add_custom_target(check-lotus-v2-transactions
+    COMMAND $<TARGET_FILE:test_lotus_v2_transaction_pool>
+    COMMAND $<TARGET_FILE:test_lotus_v2_pool_coordinator>
+    COMMAND $<TARGET_FILE:test_lotus_v2_transaction_relay>
+    DEPENDS test_lotus_v2_transaction_pool test_lotus_v2_pool_coordinator
+        test_lotus_v2_transaction_relay)
-- 
2.50.1 (Apple Git-155)

