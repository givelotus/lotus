+V2DeferredTxChecks::V2DeferredTxChecks(const CTransaction &tx)
+    : m_outputs([&] {
+          std::vector<lotus::v2::Output> outputs;
+          outputs.reserve(tx.vout.size());
+          for (const CTxOut &out : tx.vout) outputs.push_back(out.ToV2Output());
+          return outputs;
+      }()),
+      m_run(lotus::v2::DeferredCheckRegistry::Consensus(),
+            lotus::v2::DeferredTxView{m_outputs, tx.vin.size()}) {}
+
+std::optional<std::string>
+V2DeferredTxChecks::CompleteInput(uint32_t input, bool succeeded,
+                                  lotus::v2::DeferredRecords &&records) {
+    std::string error;
+    const auto outcome =
+        m_run.CompleteInput(input, succeeded, std::move(records), error);
+    if (outcome != lotus::v2::DeferredOutcome::Failed || !succeeded) {
+        return std::nullopt;
+    }
+    LOCK(m_mutex);
+    if (!m_rule_failure) m_rule_failure = error;
+    return error;
+}
+
+std::optional<std::string> V2DeferredTxChecks::RuleFailure() const {
+    LOCK(m_mutex);
+    return m_rule_failure;
+}
