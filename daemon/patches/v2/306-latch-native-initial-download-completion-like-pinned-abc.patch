--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -684,6 +684,7 @@ namespace {
         std::optional<CandidateRankCursor> avalanche_candidate_cursor;
         size_t avalanche_candidate_index{};
         void ReconcileCandidates();
+        bool initial_download_complete{false};
         bool InitialDownload(uint64_t);
         void TickAvalanche(uint64_t, uint64_t);
         bool HandleApplication(DispatcherNotice, uint64_t);
@@ -1919,7 +1920,11 @@ namespace {
             ++body_cursor;
         }
     }
+    // BEGIN INITIAL DOWNLOAD POLICY
     bool Node::InitialDownload(uint64_t wall) {
+        // Match pinned ABC: completing initial catchup is a process-local latch.
+        // Live runtime authority remains independently fenced by the driver.
+        if (initial_download_complete) return false;
         if (!network.avalanche) return true;
         const auto s = runtime->Snapshot();
         if (!s.chain || s.reopen_required || s.execution_paused || s.chain->pending_journal ||
@@ -1929,9 +1934,12 @@ namespace {
         std::string error;
         if (runtime->ReadHeader(s.chain->stable_tip, tip, error) != Result::Progress || !tip) return true;
         const auto &config = *network.avalanche;
-        return tip->header.height < config.minimum_height || tip->header.time > wall ||
-            wall - tip->header.time > config.maximum_tip_age_seconds;
+        if (tip->header.height < config.minimum_height || tip->header.time > wall ||
+            wall - tip->header.time > config.maximum_tip_age_seconds) return true;
+        initial_download_complete = true;
+        return false;
     }
+    // END INITIAL DOWNLOAD POLICY
     void Node::ClosePeer(ConnectionId id) {
         if (avalanche) avalanche->Disconnect(id);
         avalanche_peers.erase(id);
diff --git a/src/lotus_v2/initial_download_test/CMakeLists.txt b/src/lotus_v2/initial_download_test/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..549d2eda9714fd1c68e6304e722021aa5c251933
--- /dev/null
+++ b/src/lotus_v2/initial_download_test/CMakeLists.txt
@@ -0,0 +1,46 @@
+cmake_minimum_required(VERSION 3.18)
+project(lotus_v2_initial_download_policy LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+file(READ "${CMAKE_CURRENT_SOURCE_DIR}/../development_node_command.cpp" NODE_SOURCE)
+string(FIND "${NODE_SOURCE}" "// BEGIN INITIAL DOWNLOAD POLICY" POLICY_BEGIN)
+string(FIND "${NODE_SOURCE}" "// END INITIAL DOWNLOAD POLICY" POLICY_END)
+math(EXPR POLICY_LENGTH "${POLICY_END} - ${POLICY_BEGIN}")
+string(SUBSTRING "${NODE_SOURCE}" ${POLICY_BEGIN} ${POLICY_LENGTH} POLICY)
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/initial_download.inc" "${POLICY}")
+string(REGEX MATCH "bool initial_download_complete[^;]+;" INITIAL_DOWNLOAD_MEMBER "${NODE_SOURCE}")
+if(NOT INITIAL_DOWNLOAD_MEMBER)
+ message(FATAL_ERROR "Missing production initial download latch member")
+endif()
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/initial_download_member.inc" "${INITIAL_DOWNLOAD_MEMBER}")
+if(NOT LOTUS_INITIAL_DOWNLOAD_NATIVE_AUTHORITY)
+ set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../development_node_command.cpp")
+endif()
+add_executable(initial_download_test initial_download_test.cpp)
+target_include_directories(initial_download_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
+target_compile_options(initial_download_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
+enable_testing()
+add_test(NAME initial_download_test COMMAND initial_download_test)
+# Optional real native driver/runtime authority regression, using the same
+# pinned primitives and source list as the lifecycle regression.
+if(LOTUS_INITIAL_DOWNLOAD_NATIVE_AUTHORITY)
+ find_package(OpenSSL REQUIRED COMPONENTS Crypto)
+ add_subdirectory(../avalanche_lifecycle_test lifecycle)
+ get_target_property(NATIVE_SOURCES avalanche_lifecycle_test SOURCES)
+ # Substitute this directory's authority fixture for the lifecycle main.
+ set(ABS_NATIVE_SOURCES "")
+ foreach(SOURCE IN LISTS NATIVE_SOURCES)
+  if(NOT SOURCE STREQUAL "lifecycle_test.cpp")
+   get_filename_component(ABS_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/../avalanche_lifecycle_test/${SOURCE}" ABSOLUTE)
+   list(APPEND ABS_NATIVE_SOURCES "${ABS_SOURCE}")
+  endif()
+ endforeach()
+ add_executable(initial_download_authority_test authority_test.cpp ${ABS_NATIVE_SOURCES})
+ foreach(PROP INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS LINK_OPTIONS LINK_LIBRARIES)
+  get_target_property(VALUE avalanche_lifecycle_test ${PROP})
+  if(VALUE)
+   set_property(TARGET initial_download_authority_test PROPERTY ${PROP} "${VALUE}")
+  endif()
+ endforeach()
+ add_test(NAME initial_download_authority_test COMMAND initial_download_authority_test)
+endif()
diff --git a/src/lotus_v2/initial_download_test/README.md b/src/lotus_v2/initial_download_test/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..a68e31ad3d1474ed1e2e8a13a5ce628a3090058a
--- /dev/null
+++ b/src/lotus_v2/initial_download_test/README.md
@@ -0,0 +1,36 @@
+# Initial download completion latch
+
+The node retains its existing height, tip age, future-tip and synchronization
+checks until the first successful catchup observation. Completion then latches
+for that Node instance, matching pinned ABC's `IsInitialBlockDownload` process
+latch. Routine header refresh, download jobs, candidate choices and later tip
+aging do not re-enter initial download. Constructing a fresh Node resets the
+latch. No minimum height, maximum age or Avalanche voting default changes.
+
+This catchup flag does not grant current chain authority. The driver's separate
+Snapshot/Tick/Status checks still refuse pending journal, receipt, propagation,
+reopen or paused states and fence the current tip and context generation.
+
+`initial_download_test` extracts the exact production method and latch member
+from `development_node_command.cpp`. Boundary fixtures exercise all original
+startup conditions, first completion, subsequent synchronization noise, aging,
+authority loss and a fresh instance. Optional `initial_download_authority_test`
+links the actual native runtime and Avalanche driver. After completed catchup it
+creates a real native pending journal, checks Tick returns NotReady before
+polling, and confirms current quorum readiness remains false while IBD stays
+false. The native fixture is an observer and does not claim funded quorum
+establishment or finalized polling; those remain separate nine-node gates.
+
+```sh
+cmake -S src/lotus_v2/initial_download_test -B build-initial-download-review -G Ninja \
+  -DLOTUS_INITIAL_DOWNLOAD_NATIVE_AUTHORITY=ON \
+  -DLOTUS_ABC_BUILD=/private/tmp/lotus-v2-daemon-runtime-staging-20261015/build \
+  -DLOTUS_SECP_LIBRARY=/private/tmp/lotus-v2-daemon-runtime-staging-20261015/build/src/secp256k1/libsecp256k1.a \
+  -DLOTUS_BOOST_INCLUDE=/opt/homebrew/include
+cmake --build build-initial-download-review \
+  --target initial_download_test initial_download_authority_test -j2
+ctest --test-dir build-initial-download-review \
+  -R '^initial_download(_authority)?_test$' --output-on-failure
+```
+
+Without the native option, only the small dependency-free policy test builds.
diff --git a/src/lotus_v2/initial_download_test/authority_test.cpp b/src/lotus_v2/initial_download_test/authority_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2cadc093a58b92f1c3c299fbd1335060247033bf
--- /dev/null
+++ b/src/lotus_v2/initial_download_test/authority_test.cpp
@@ -0,0 +1,24 @@
+// Copyright (c) 2026 The Lotus developers
+#include "../avalanche_driver.h"
+#include "../avalanche_peer_test/fixtures.h"
+#include <util/translation.h>
+using namespace lotus::v2::ava;
+const std::function<std::string(const char *)> G_TRANSLATION_FUN=nullptr;
+int main(){ECC_Start();try {
+ Pair pair;DriverConfig config;
+ config.profile.chain_id=pair.a.network.chain_id;config.profile.genesis_id=pair.a.network.genesis_id;
+ config.profile.validation_digest=pair.a.runtime->Snapshot().chain->profile_digest;
+ config.session_key.MakeNewKey(true);config.peer_file=pair.a.home.path+"/ibd-authority-avapeers.dat";
+ AvalancheDriver driver(*pair.a.runtime,*pair.a.dispatcher,config);
+ Check(bool(driver.Start(true,1700000000)),"actual native driver starts in IBD");
+ Check(bool(driver.Tick(false,100,1700000000)) && !driver.Status().initial_download,"node's completed catchup is passed to actual driver");
+ std::string e;HeaderAdmission header;CandidateBodyStatus body;
+ Check(pair.a.runtime->AdmitHeader(HeaderOf(V(0)),header,e)==DevelopmentRuntimeResult::Progress,"actual next native header");
+ Check(pair.a.runtime->RetainBody(H(V(0).id),runtime_fixture::Bytes(V(0).wire),body,e)==DevelopmentRuntimeResult::Progress,"actual next native body");
+ for(size_t n=0;n<300;++n){pair.a.runtime->Tick(UINT64_MAX,0,TickLimits());auto snapshot=pair.a.runtime->Snapshot();if(snapshot.chain&&snapshot.chain->pending_journal)break;}
+ Check(pair.a.runtime->Snapshot().chain->pending_journal,"real pending journal fences authoritative chain");
+ Check(driver.Tick(false,101,1700000001).code==DriverCode::NotReady,"latched false IBD cannot bypass native polling snapshot authority");
+ const auto status=driver.Status();
+ Check(!status.initial_download && !status.quorum_ready && !status.quorum_established,"latched false IBD cannot assert current quorum while authority unavailable");
+ std::cout<<"native IBD authority checks passed\n";
+}catch(const std::exception&e){std::cerr<<e.what()<<'\n';ECC_Stop();return 1;}ECC_Stop();return 0;}
diff --git a/src/lotus_v2/initial_download_test/initial_download_test.cpp b/src/lotus_v2/initial_download_test/initial_download_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1c4ef20e3ba8b63a27ea29d6680e92c2af564b6f
--- /dev/null
+++ b/src/lotus_v2/initial_download_test/initial_download_test.cpp
@@ -0,0 +1,63 @@
+// Copyright (c) 2026 The Lotus developers
+#include <cstdint>
+#include <iostream>
+#include <optional>
+#include <set>
+#include <stdexcept>
+#include <string>
+#define CHECK(x) do {if(!(x))throw std::runtime_error(#x);}while(0)
+namespace {
+// Boundary fixtures feed the exact production method, extracted by CMake.
+// They do not implement a separate download or latch policy.
+enum class Result { Progress, Unavailable };
+struct Header {uint64_t height{2024},time{10000};};
+struct IndexedHeader {Header header;};
+struct Chain {int stable_tip{};bool pending_journal{},pending_receipt{},pending_propagation{};};
+struct Snapshot {std::optional<Chain> chain{Chain{}};bool reopen_required{},execution_paused{};};
+struct Runtime {
+ struct Snapshot snapshot;
+ IndexedHeader tip;
+ bool readable{true};
+ struct Snapshot Snapshot() const{return snapshot;}
+ Result ReadHeader(int,std::optional<IndexedHeader> &out,std::string &) {if(!readable)return Result::Unavailable;out=tip;return Result::Progress;}
+};
+struct Config {uint64_t minimum_height{2024},maximum_tip_age_seconds{100};};
+struct Stats {size_t jobs{};};
+struct Manager {struct Stats stats;struct Stats Stats()const{return stats;}};
+struct Choices {bool best_fetch{},best_ready{};};
+struct Node {
+ struct {std::optional<Config> avalanche{Config{}};}network;
+ Runtime storage;Runtime *runtime{&storage};
+ Manager downloads;Manager *manager{&downloads};
+ std::set<int> pending_headers;
+ std::optional<Choices> choices;
+#include "initial_download_member.inc"
+ bool InitialDownload(uint64_t);
+};
+#include "initial_download.inc"
+}
+int main(){try {
+ Node n;
+ n.storage.tip.header.height=2023;CHECK(n.InitialDownload(10000));
+ n.storage.tip.header.height=2024;n.storage.tip.header.time=9899;CHECK(n.InitialDownload(10000));
+ n.storage.tip.header.time=10001;CHECK(n.InitialDownload(10000));n.storage.tip.header.time=10000;
+ n.downloads.stats.jobs=1;CHECK(n.InitialDownload(10000));n.downloads.stats.jobs=0;
+ n.pending_headers.insert(1);CHECK(n.InitialDownload(10000));n.pending_headers.clear();
+ n.choices=Choices{true,false};CHECK(n.InitialDownload(10000));n.choices=Choices{false,true};CHECK(n.InitialDownload(10000));n.choices.reset();
+ n.storage.snapshot.chain->pending_journal=true;CHECK(n.InitialDownload(10000));n.storage.snapshot.chain->pending_journal=false;
+ n.storage.snapshot.chain->pending_receipt=true;CHECK(n.InitialDownload(10000));n.storage.snapshot.chain->pending_receipt=false;
+ n.storage.snapshot.chain->pending_propagation=true;CHECK(n.InitialDownload(10000));n.storage.snapshot.chain->pending_propagation=false;
+ n.storage.snapshot.reopen_required=true;CHECK(n.InitialDownload(10000));n.storage.snapshot.reopen_required=false;
+ n.storage.snapshot.execution_paused=true;CHECK(n.InitialDownload(10000));n.storage.snapshot.execution_paused=false;
+ n.storage.readable=false;CHECK(n.InitialDownload(10000));n.storage.readable=true;
+ const auto chain=n.storage.snapshot.chain;n.storage.snapshot.chain.reset();CHECK(n.InitialDownload(10000));n.storage.snapshot.chain=chain;
+ CHECK(!n.initial_download_complete);CHECK(!n.InitialDownload(10000));CHECK(n.initial_download_complete);
+ n.pending_headers.insert(1);n.downloads.stats.jobs=3;n.choices=Choices{true,true};CHECK(!n.InitialDownload(10000));
+ CHECK(!n.InitialDownload(20000));CHECK(!n.InitialDownload(1));
+ // Loss of authority after catchup cannot re-enter IBD; the native driver
+ // authority regression separately verifies polling/readiness stay fenced.
+ n.storage.snapshot.chain.reset();n.storage.snapshot.reopen_required=true;n.storage.snapshot.execution_paused=true;n.storage.readable=false;CHECK(!n.InitialDownload(20000));
+ Node fresh;fresh.pending_headers.insert(1);CHECK(!fresh.initial_download_complete && fresh.InitialDownload(10000));
+ Node observer;observer.network.avalanche.reset();CHECK(observer.InitialDownload(10000) && !observer.initial_download_complete);
+ std::cout<<"initial download latch checks passed\n";
+}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}return 0;}
