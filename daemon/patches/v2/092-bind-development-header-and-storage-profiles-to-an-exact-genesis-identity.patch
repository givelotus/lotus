From d6e2075676e282b2d0e8e3df7d0d7bcff399d1b8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:28:56 -0700
Subject: [PATCH] Bind development header and storage profiles to an exact
 genesis identity

Append explicit genesis_id to the contextual header profile and fingerprint version2. Nonzero anchors reject a different genesis even with identical time and target; zero remains only for synthetic module callers. Daemon initialization must require a nonzero manifest anchor. Header tests and disk suites pass, including independent storage fingerprint mismatch. This changes no network defaults or genesis artifact.
---
 src/lotus_v2/disk_block.cpp          |  2 +-
 src/lotus_v2/header_context.cpp      |  5 +++++
 src/lotus_v2/header_context.h        |  3 +++
 src/lotus_v2/test_block_complete.cpp | 10 ++++++++++
 src/lotus_v2/test_header_context.cpp | 11 +++++++++++
 5 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/disk_block.cpp b/src/lotus_v2/disk_block.cpp
index bfa82d74daf42ea41631d88e7af15b068e38049a..f7102bd72a2b115eed5eb7f2fa8fd67cac6748c0 100644
--- a/src/lotus_v2/disk_block.cpp
+++ b/src/lotus_v2/disk_block.cpp
@@ -124,7 +124,7 @@ Hash BlockValidationProfileDigest(const HeaderChainProfile &hp,
         for (unsigned i = 0; i < width; ++i) bytes.push_back(uint8_t(value >> (8 * i)));
     };
     auto hash = [&](const Hash &value) { bytes.insert(bytes.end(), value.begin(), value.end()); };
-    put(1); hash(hp.chain_id); put(hp.version); put(hp.genesis_time);
+    put(2); hash(hp.chain_id); hash(hp.genesis_id); put(hp.version); put(hp.genesis_time);
     put(hp.genesis_bits); hash(hp.pow_limit);
     put(uint64_t(hp.half_life_seconds)); put(uint64_t(hp.spacing_seconds));
     const auto &t = op.transaction;
diff --git a/src/lotus_v2/header_context.cpp b/src/lotus_v2/header_context.cpp
index 070b87545645d85dde84189b05ed54a39dfd304b..bc2488a43d98a332218398e075017c352cc2151d 100644
--- a/src/lotus_v2/header_context.cpp
+++ b/src/lotus_v2/header_context.cpp
@@ -38,6 +38,11 @@ std::optional<uint64_t> ParentMedianTime(const HeaderChainProfile &p,
         if (h.height == 0 && (h.time != p.genesis_time ||
                               h.bits != p.genesis_bits || h.prev_id != Hash{}))
             return std::nullopt;
+        if (h.height == 0 && p.genesis_id != Hash{}) {
+            Hash genesis_id;
+            if (!BlockId(p.chain_id, h, genesis_id) || genesis_id != p.genesis_id)
+                return std::nullopt;
+        }
         times.push_back(h.time);
     }
     std::sort(times.begin(), times.end());
diff --git a/src/lotus_v2/header_context.h b/src/lotus_v2/header_context.h
index 68cdacf9901286ed66871e33227a2395ac0e042f..ce7fa3e257f09776d6e38f9fd997e46eb63f3de1 100644
--- a/src/lotus_v2/header_context.h
+++ b/src/lotus_v2/header_context.h
@@ -14,6 +14,9 @@ struct HeaderChainProfile {
     Hash pow_limit{};
     int64_t half_life_seconds{};
     int64_t spacing_seconds{};
+    // Exact manifest genesis. Zero permits synthetic module fixtures only;
+    // daemon initialization must require a nonzero anchor before opening state.
+    Hash genesis_id{};
 };
 // Authenticated history is newest first, includes parent, and contains exactly
 // min(parent.height+1,11) headers. Caller authenticates its oldest entry
diff --git a/src/lotus_v2/test_block_complete.cpp b/src/lotus_v2/test_block_complete.cpp
index 4fd40e82a6fbea2889681cbba83bb7562cbeb98f..27f04f02594aa6f545325dce25a9dbb0cc961b2d 100644
--- a/src/lotus_v2/test_block_complete.cpp
+++ b/src/lotus_v2/test_block_complete.cpp
@@ -570,6 +570,16 @@ void CompleteChecks() {
         stale_context.candidate_height = 999;
         stale_context.parent_mtp = 999;
         StagedBlockTransition durable;
+        auto different_genesis = hp;
+        different_genesis.genesis_id[0] ^= 1;
+        Check(BlockValidationProfileDigest(different_genesis, profile, DevelopmentGenesis, COST) !=
+                  options.profile_digest, "exact genesis participates in storage profile");
+        Check(!db.MatchesProfile(hp.chain_id, BlockValidationProfileDigest(
+                  different_genesis, profile, DevelopmentGenesis, COST)),
+              "stored profile rejects another genesis independently of history");
+        Check(ConnectStoredDiskBlock(wire, different_genesis, profile,
+                  DevelopmentGenesis, COST, db, durable, error) == CandidateCheckResult::StorageError &&
+                  db.Metadata() == parent_meta, "another genesis cannot reuse existing validator state");
         auto wrong_cost = COST;
         ++wrong_cost.hash_byte;
         Check(ConnectDiskBlock(wire, {parent.header, genesis}, hp, profile,
diff --git a/src/lotus_v2/test_header_context.cpp b/src/lotus_v2/test_header_context.cpp
index f9a4ba3597f8681c5db151747a2125ae1fc18090..4bad1986ac1bfb8453cc136aff39b9bbd1ebfa57 100644
--- a/src/lotus_v2/test_header_context.cpp
+++ b/src/lotus_v2/test_header_context.cpp
@@ -109,6 +109,17 @@ int main() {
     genesis_header.time = 1000;
     genesis_header.bits = p.genesis_bits;
     Check(ParentMedianTime(p, genesis_header, {genesis_header}) == 1000);
+    Check(BlockId(p.chain_id, genesis_header, p.genesis_id));
+    Check(ParentMedianTime(p, genesis_header, {genesis_header}) == 1000,
+          "exact manifest genesis accepted");
+    auto other_genesis = genesis_header;
+    other_genesis.state_root[0] ^= 1;
+    Check(!ParentMedianTime(p, other_genesis, {other_genesis}),
+          "same time and target cannot substitute another genesis state");
+    auto wrong_anchor = p;
+    wrong_anchor.genesis_id[0] ^= 1;
+    Check(!ParentMedianTime(wrong_anchor, genesis_header, {genesis_header}),
+          "different manifest genesis rejected");
     Check(!RequiredAsertCandidateBits(172800, 0, *genesis, 1000, limit,
                                       {1000, 0}),
           "zero spacing must reject: native formerly accepted unlike Python");
