From c1b37af0c7d7b65773acc8ada52a6429b22dfab3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:07:08 -0700
Subject: [PATCH] chronik: native validate-tx decodes raw V2 txs with the node

AbcHost::DecodeRawTx kept the legacy-shaped decoding of a raw tx and
only took the node txid, so a native V2 (v7) tx had no inputs or
outputs. Like the corrected Rust bridge, a V2 node now takes the node's
decoding of the raw bytes: its inputs (mint inputs skipped), outputs,
lock time and GetId, with the coins left unresolved. Bytes the node
cannot decode keep their legacy fields and the node txid of those
fields, built without reserializing them. The eCash path is unchanged.

Tier: V2

Coordinator integration provenance (reference405):
0001-decode-native-before-legacy.patch: Same-purpose introduced defect; original named owner retained.
All60 authored input payloads retained, with prerequisite-aware same-purpose splits; distinct legacy-index and inherited CXX compatibility remain independent. Pre-format source equals exact403+all60 control tree95718fceff83364b74294a751bd752b2f1a4e384. Only pinnedRuff import/format cleanup follows. Original author commands/hashes are historical reference evidence, not combined405 approval. Reference OFF/native/Rust full gates are preserved separately; combined compile/runtime NOT_RUN.

diff --git a/chronik/native/hosts/abc/abc_host.cpp b/chronik/native/hosts/abc/abc_host.cpp
index d9542c33dbf3be8e755864580b3ae1fcc40f5865..f6bd517e5b933e0e2b804a1d35a7a26de02a55fe 100644
--- a/chronik/native/hosts/abc/abc_host.cpp
+++ b/chronik/native/hosts/abc/abc_host.cpp
@@ -535,37 +535,82 @@ Bytes AbcHost::LoadRawTx(uint32_t file_num, uint32_t data_pos) const {
 
 DecodedTx AbcHost::DecodeRawTx(std::span<const uint8_t> raw) const {
     // Same decoder and error texts as the Rust Chronik (TxMut::deser), which
-    // also accepts trailing bytes. The txid is that of the decoded fields.
+    // also accepts trailing bytes.
     LegacyTxDecodeResult decoded = DecodeLegacyTx(raw);
     DecodedTx out;
-    if (decoded.error) {
+    const bool native_v7 = kV2Outputs<CTxOut> && raw.size() >= 4 &&
+                           raw[0] == 7 && raw[1] == 0 && raw[2] == 0 &&
+                           raw[3] == 0;
+    if (decoded.error && !native_v7) {
         out.error = *decoded.error;
         return out;
     }
-    // Lotus V2: the txid is the node's own identity of the raw bytes (a
-    // native V2 tx's real txid). The Rust bridge recomputes it from the
-    // legacy-shaped fields instead, which differs for native V2 txs (design
-    // C1 §1.2, an accepted divergence). Legacy txs get the same txid.
-    std::optional<::TxId> node_txid;
-    try {
-        DataStream raw_stream{MakeByteSpan(raw)};
-        CMutableTransaction node_mtx;
-        raw_stream >> node_mtx;
-        node_txid = CTransaction(std::move(node_mtx)).GetId();
-    } catch (const std::exception &) {
-        // Not a node tx: use the legacy-shaped identity below.
-    }
-    if (!node_txid) {
-        const Bytes ser = SerializeLegacyTx(decoded.tx);
+    out.ok = true;
+    out.tx = std::move(decoded.tx);
+    out.tx.raw = Bytes(raw.begin(), raw.end());
+    if constexpr (kV2Outputs<CTxOut>) {
+        // Lotus V2 (Rust ChronikBridge::decode_raw_tx): a native V2 tx has
+        // no legacy-shaped fields, so the node's own decoding of the raw
+        // bytes gives its inputs, outputs and txid, as indexed once it is
+        // broadcast; its coins are looked up afterwards.
+        std::optional<CMutableTransaction> node_tx;
+        try {
+            DataStream raw_stream{MakeByteSpan(raw)};
+            CMutableTransaction mtx;
+            raw_stream >> mtx;
+            node_tx = std::move(mtx);
+        } catch (const std::exception &e) {
+            if (native_v7) {
+                out.ok = false;
+                out.error = e.what();
+                return out;
+            }
+        }
+        if (node_tx) {
+            const CTransaction ctx{std::move(*node_tx)};
+            Tx tx = ConvertTx(/*is_coinbase=*/true, ctx, {});
+            const bool is_coinbase = ctx.IsCoinBase();
+            tx.inputs.clear();
+            for (const CTxIn &input : ctx.vin) {
+                if (!is_coinbase && IsMintInput(input)) {
+                    continue;
+                }
+                TxInput in;
+                in.prev_out.txid = ToHash(input.prevout.GetTxId());
+                in.prev_out.out_idx = input.prevout.GetN();
+                in.script = InputScript(input);
+                in.sequence = input.nSequence;
+                tx.inputs.push_back(std::move(in));
+            }
+            tx.wire_size = uint32_t(SerializeLegacyTx(tx).size());
+            tx.raw = std::move(out.tx.raw);
+            out.tx = std::move(tx);
+            return out;
+        }
+        // Not a node tx: like the Rust bridge, the txid the node computes
+        // for the legacy-shaped fields, built without reserializing them.
+        CMutableTransaction mtx;
+        mtx.nVersion = out.tx.version;
+        mtx.nLockTime = out.tx.locktime;
+        for (const TxInput &in : out.tx.inputs) {
+            mtx.vin.emplace_back(COutPoint(::TxId(FromHash(in.prev_out.txid)),
+                                           in.prev_out.out_idx),
+                                 CScript(in.script.begin(), in.script.end()),
+                                 in.sequence);
+        }
+        for (const TxOutput &o : out.tx.outputs) {
+            mtx.vout.emplace_back(o.sats * SATOSHI,
+                                  CScript(o.script.begin(), o.script.end()));
+        }
+        out.tx.txid = ToHash(CTransaction(mtx).GetId());
+    } else {
+        // The txid is that of the decoded fields.
+        const Bytes ser = SerializeLegacyTx(out.tx);
         DataStream stream{MakeByteSpan(ser)};
         CMutableTransaction mtx;
         stream >> mtx;
-        node_txid = CTransaction(mtx).GetId();
+        out.tx.txid = ToHash(CTransaction(mtx).GetId());
     }
-    out.ok = true;
-    out.tx = std::move(decoded.tx);
-    out.tx.txid = ToHash(*node_txid);
-    out.tx.raw = Bytes(raw.begin(), raw.end());
     return out;
 }
 
diff --git a/src/test/chronik_native_abc_v2_tests.cpp b/src/test/chronik_native_abc_v2_tests.cpp
index 6dbaf3ffa42c70db2c51a60d9c2e0184d7a04ce1..a72342cfbfae803ef3ee46ae7be74544b4947f33 100644
--- a/src/test/chronik_native_abc_v2_tests.cpp
+++ b/src/test/chronik_native_abc_v2_tests.cpp
@@ -199,4 +199,54 @@ BOOST_FIXTURE_TEST_CASE(test_v2_service_routes, TestChain100Setup) {
     BOOST_CHECK_EQUAL(get("/v2/status").status, 503);
 }
 
+BOOST_FIXTURE_TEST_CASE(test_v2_decode_raw_tx, TestChain100Setup) {
+    // validate-tx and broadcast checks decode a native V2 (v7) tx with the
+    // node's decoding: its own inputs, outputs and txid, which differ per
+    // tx (the legacy decoder sees no inputs or outputs in v7 bytes).
+    const cn::abc::AbcHost host(m_node, cn::HostCapabilities{});
+    std::vector<uint256> txids;
+    for (const int64_t sats : {1000, 2000}) {
+        CMutableTransaction mtx;
+        mtx.vin = {CTxIn(COutPoint(m_coinbase_txns[0]->GetId(), 1),
+                         CScript(), 0xffffffff)};
+        mtx.vout = {CTxOut(sats * SATOSHI, CScript() << OP_TRUE)};
+        AdaptLegacyTxToV7(mtx);
+        const CTransaction tx(mtx);
+        BOOST_REQUIRE_EQUAL(tx.nVersion, 7);
+        DataStream ss{};
+        ss << tx;
+        const auto span = MakeUCharSpan(ss);
+        const cn::Bytes raw(span.begin(), span.end());
+
+        const cn::DecodedTx decoded = host.DecodeRawTx(raw);
+        BOOST_REQUIRE_MESSAGE(decoded.ok, decoded.error);
+        const cn::Tx expected = cn::abc::ConvertTx(
+            false, tx, {::Coin(CTxOut(sats * SATOSHI, CScript()), 1, true)});
+        BOOST_CHECK(std::equal(decoded.tx.txid.b.begin(),
+                               decoded.tx.txid.b.end(), tx.GetId().begin()));
+        BOOST_CHECK_EQUAL(decoded.tx.version, 7);
+        BOOST_REQUIRE_EQUAL(decoded.tx.inputs.size(), 1u);
+        BOOST_CHECK(decoded.tx.inputs[0].prev_out.txid ==
+                    expected.inputs[0].prev_out.txid);
+        BOOST_CHECK_EQUAL(decoded.tx.inputs[0].prev_out.out_idx, 1u);
+        BOOST_CHECK(decoded.tx.inputs[0].script == expected.inputs[0].script);
+        BOOST_CHECK_EQUAL(decoded.tx.inputs[0].sequence, 0xffffffffu);
+        BOOST_CHECK(!decoded.tx.inputs[0].coin);
+        BOOST_REQUIRE_EQUAL(decoded.tx.outputs.size(), 1u);
+        BOOST_CHECK_EQUAL(decoded.tx.outputs[0].sats, sats);
+        BOOST_CHECK(decoded.tx.outputs[0].script ==
+                    expected.outputs[0].script);
+        BOOST_CHECK_EQUAL(decoded.tx.locktime, tx.nLockTime);
+        BOOST_CHECK_EQUAL(decoded.tx.wire_size, expected.wire_size);
+        BOOST_CHECK(decoded.tx.raw == raw);
+
+        // Looking up the spent coins keeps the txid.
+        cn::Tx looked_up = decoded.tx;
+        (void)host.LookupSpentCoins(looked_up);
+        BOOST_CHECK(looked_up.txid == decoded.tx.txid);
+        txids.push_back(tx.GetId());
+    }
+    BOOST_CHECK(txids[0] != txids[1]);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
