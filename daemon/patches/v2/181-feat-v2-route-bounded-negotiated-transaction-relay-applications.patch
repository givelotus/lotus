+void TransactionRouting() {
+    Pair p;
+    for (unsigned i = 0; i < 10; ++i) p.Cycle();
+    Check((*p.a.dispatcher->ActiveFeatures(p.a.connection) & TRANSACTION_RELAY_FEATURE) != 0,
+          "relay feature exposed");
+    Check(p.a.dispatcher->ActiveLimit(p.a.connection) == p.a.transport.ActiveLimit(),
+          "active receive limit exposed");
+    auto send = [&](Message message) {
+        Check(p.b.transport.QueueMessage(message, p.ms) == QueueResult::Queued,
+              "enqueue inbound application");
+        for (unsigned i = 0; i < 10; ++i) {
+            p.b.transport.Poll(p.ms, TransportStep());
+            p.a.dispatcher->Tick(p.ms++, UINT64_MAX, 0, p.a.budget);
+        }
+    };
+    // Fill the actual bounded notice queue without consuming it.
+    for (unsigned i = 0; i < 128; ++i) send({"tx", Bytes{uint8_t(i)}});
+    std::vector<Inventory> mixed{{1, Hash{1}}, {2, Hash{2}}, {1, Hash{3}}};
+    Bytes payload;
+    std::string error;
+    Check(EncodeInventory(mixed, p.b.transport.ActiveLimit(), payload, error), "mixed inventory encoding");
+    send({"inv", payload});
+    size_t transactions = 0;
+    while (auto notice = p.a.dispatcher->TakeNotice()) {
+        if (notice->application) {
+            Check(notice->application->command == "tx", "full queue holds mixed inventory");
+            ++transactions;
+        }
+    }
+    Check(transactions == 128, "notice payload queue is bounded and lossless");
+    for (unsigned i = 0; i < 20; ++i) {
+        p.a.dispatcher->Tick(p.ms++, UINT64_MAX, 0, p.a.budget);
+    }
+    size_t applications = 0, blocks = 0;
+    while (auto notice = p.a.dispatcher->TakeNotice()) {
+        if (notice->application) {
+            std::vector<Inventory> decoded;
+            Check(DecodeInventory(notice->application->payload, p.a.transport.ActiveLimit(), decoded, error)
+                      && decoded.size() == 2 && decoded[0].type == 1 && decoded[1].type == 1,
+                  "mixed inventory delivers only transaction half");
+            ++applications;
+        }
+        if (notice->kind == DispatcherNoticeKind::NeedHeaders) ++blocks;
+    }
+    Check(applications == 1 && blocks == 1, "mixed inventory processed exactly once after backpressure");
+    for (const std::string command : {"getdata", "notfound"}) {
+        send({command, payload});
+        size_t routed = 0;
+        while (auto notice = p.a.dispatcher->TakeNotice()) {
+            if (notice->application) {
+                Check(notice->application->command == command, "inventory command preserved");
+                std::vector<Inventory> decoded;
+                Check(DecodeInventory(notice->application->payload, p.a.transport.ActiveLimit(), decoded, error)
+                          && decoded.size() == 2 && decoded[0].type == 1 && decoded[1].type == 1,
+                      "request/notfound transaction partition");
+                ++routed;
+            }
+        }
+        Check(routed == 1, "mixed request/notfound routed once");
+    }
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes{1}}, p.ms) == DispatcherResult::Queued,
+          "stage single application output");
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes{2}}, p.ms) == DispatcherResult::Busy,
+          "second action reports busy without replacing first");
+    for (unsigned i = 0; i < 20; ++i) p.Cycle();
+    size_t sent = 0;
+    for (const auto &notice : p.b.notices) {
+        if (notice.application && notice.application->command == "tx") {
+            Check(notice.application->payload == Bytes{1}, "busy preserves first output bytes");
+            ++sent;
+        }
+    }
+    Check(sent == 1, "single pending application delivered once");
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"block", {}}, p.ms) == DispatcherResult::CapacityRefused,
+          "application output rejects block command");
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes((1 << 20) + 1)}, p.ms) == DispatcherResult::CapacityRefused,
+          "application payload cap enforced");
+    Pipe ab, ba;
+    MemoryStream sa{ba, ab}, sb{ab, ba};
+    Node a(sa, 71, 64, nullptr, false), b(sb, 81);
+    uint64_t ms = 1;
+    a.dispatcher->Open(a.connection, ms);
+    b.dispatcher->Open(b.connection, ms);
+    for (unsigned i = 0; i < 100; ++i) { a.Poll(ms); b.Poll(ms++); }
+    Check(a.Active() && b.Active(), "mandatory-only peer activates");
+    Check(a.dispatcher->SendApplication(a.connection, {"tx", Bytes{1}}, ms) == DispatcherResult::CapacityRefused,
+          "missing negotiated relay prevents application output");
+    Check(b.transport.QueueMessage({"tx", Bytes{1}}, ms) == QueueResult::Queued,
+          "inject unauthorized relay");
+    for (unsigned i = 0; i < 20; ++i) { a.Poll(ms); b.Poll(ms++); }
+    Check(!a.Active(), "unauthorized incoming transaction closes peer");
+    std::cout << "PASS bounded negotiated transaction routing and backpressure\n";
+}
