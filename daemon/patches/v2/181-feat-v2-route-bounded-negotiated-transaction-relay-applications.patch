+std::optional<uint64_t> PeerDispatcher::ActiveFeatures(ConnectionId id) const {
+    auto p = impl_->peers.find(id);
+    if (p == impl_->peers.end() || p->second.closed || !p->second.handle) return {};
+    return p->second.transport->ActiveFeatures();
+}
+std::optional<uint32_t> PeerDispatcher::ActiveLimit(ConnectionId id) const {
+    auto p = impl_->peers.find(id);
+    if (p == impl_->peers.end() || p->second.closed || !p->second.handle) return {};
+    return p->second.transport->ActiveLimit();
+}
+DispatcherResult PeerDispatcher::SendApplication(ConnectionId id, Message message,
+                                                  uint64_t now) {
+    auto &s = *impl_;
+    if (s.busy) return DispatcherResult::Busy;
+    Guard guard(s.busy);
+    auto found = s.peers.find(id);
+    if (found == s.peers.end()) return DispatcherResult::UnknownPeer;
+    auto &p = found->second;
+    if (s.stopped || p.closed || !p.handle ||
+        p.transport->State() != SessionState::Active) return DispatcherResult::Closed;
+    if (!(p.transport->ActiveFeatures() & TRANSACTION_RELAY_FEATURE))
+        return DispatcherResult::CapacityRefused;
+    if (p.output) return DispatcherResult::Busy;
+    if (message.payload.size() > s.config.limits.max_pending_message_bytes ||
+        message.payload.size() > p.transport->ActiveLimit())
+        return DispatcherResult::CapacityRefused;
+    try {
+        if (message.command != "tx") {
+            if (message.command != "inv" && message.command != "getdata" &&
+                message.command != "notfound") return DispatcherResult::CapacityRefused;
+            std::vector<Inventory> items;
+            std::string error;
+            const uint64_t cap = CompactSizeWidth(s.config.limits.max_inventory_items) +
+                                 36ULL * s.config.limits.max_inventory_items;
+            if (message.payload.size() > cap ||
+                !DecodeInventory(message.payload, p.transport->ActiveLimit(), items, error) ||
+                std::any_of(items.begin(), items.end(), [](const auto &i) { return i.type != 1; }))
+                return DispatcherResult::CapacityRefused;
+        }
+        if (s.have_time && now < s.last_ms) return DispatcherResult::Closed;
+        return s.SetOutput(id, p, std::move(message), Impl::Origin::Application, now)
+                   ? DispatcherResult::Queued : DispatcherResult::Closed;
+    } catch (...) {
+        s.ClosePeer(id, p);
+        return DispatcherResult::Closed;
+    }
+}
 DispatcherUsage PeerDispatcher::Tick(uint64_t now, uint64_t wall,
                                      uint64_t window,
                                      const DispatcherBudget &budget) {
