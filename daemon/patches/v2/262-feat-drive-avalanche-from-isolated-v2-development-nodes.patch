+    ava::DriverConfig AvalancheSettings(const NetworkConfig &network, const std::string &directory) {
+        ava::DriverConfig c;
+        c.profile.chain_id = network.profile.chain_id;
+        c.profile.genesis_id = network.profile.genesis_id;
+        c.profile.validation_digest = network.profile.profile_digest;
+        c.peer_file = directory + "/avalanche-peers.dat";
+        c.limits.max_peers = MaxPeers;
+        if (!network.avalanche->credentials) {
+            c.session_key.MakeNewKey(true);
+            return c;
+        }
+        // Open without following symlinks; validate the opened object, avoiding
+        // a stat/open race and preventing a device/FIFO read from blocking.
+        const int fd = open(network.avalanche->credentials->c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+        Require(fd >= 0, "cannot open private Avalanche credentials");
+        struct Close { int fd; ~Close() { close(fd); } } close_file{fd};
+        struct stat st{};
+        Require(fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == geteuid() &&
+                (st.st_mode & 077) == 0 && st.st_size > 0 && st.st_size <= 1024 * 1024,
+                "Avalanche credentials must be a private owned regular file <=1MiB");
+        std::string text(size_t(st.st_size), '\0');
+        struct Wipe { std::string &text; ~Wipe() { memory_cleanse(text.data(), text.size()); } } wipe{text};
+        size_t offset = 0;
+        while (offset < text.size()) {
+            const auto n = read(fd, text.data() + offset, text.size() - offset);
+            if (n < 0 && errno == EINTR) continue;
+            Require(n > 0, "Avalanche credential read failed");
+            offset += size_t(n);
+        }
+        char extra;
+        Require(read(fd, &extra, 1) == 0, "Avalanche credential file changed while reading");
+        UniValue v;
+        Require(v.read(text), "invalid Avalanche credential JSON");
+        Keys(v, {"schema", "session_key", "proof", "delegation"});
+        Require(Number(v["schema"], 1) == 1, "Avalanche credential schema must be1");
+        auto key = Unhex(v["session_key"], 32);
+        Require(key.size() == 32, "Avalanche session key must be32bytes");
+        c.session_key.Set(key.begin(), key.end(), true);
+        memory_cleanse(key.data(), key.size());
+        // UniValue exposes the parsed string by reference; erase the secret
+        // copy before decoding any public data or propagating validation errors.
+        auto &key_text = const_cast<std::string &>(v["session_key"].get_str());
+        memory_cleanse(key_text.data(), key_text.size());
+        Require(c.session_key.IsValid(), "invalid Avalanche session key");
+        const auto proof = Unhex(v["proof"], c.limits.max_payload);
+        std::string error;
+        Require(ava::DecodeProofEnvelope(proof, c.limits, c.local_proof, error), "invalid Avalanche proof envelope");
+        const auto delegation = Unhex(v["delegation"], 4096);
+        try {
+            DataStream input{Span<const uint8_t>{delegation.data(), delegation.size()}};
+            // Delegation's generic decoder has vectors: scan both their lengths
+            // and level count first, so malformed local bytes cannot allocate.
+            DataStream scan{Span<const uint8_t>{delegation.data(), delegation.size()}};
+            scan.ignore(32);
+            auto skip_key = [&] { const auto n = ReadCompactSize(scan); Require(n <= 65, "invalid delegation key size"); scan.ignore(n); };
+            skip_key();
+            const auto levels = ReadCompactSize(scan);
+            Require(levels <= ::avalanche::MAX_DELEGATION_LEVELS, "delegation level limit");
+            for (uint64_t i = 0; i < levels; ++i) { skip_key(); scan.ignore(64); }
+            Require(scan.empty(), "delegation trailing bytes");
+            input >> c.delegation;
+            Require(input.empty(), "delegation trailing bytes");
+        } catch (const std::ios_base::failure &) { throw std::runtime_error("invalid Avalanche delegation"); }
+        return c;
+    }
