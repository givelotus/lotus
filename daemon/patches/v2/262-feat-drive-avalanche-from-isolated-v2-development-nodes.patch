+    void Node::TickAvalanche(uint64_t ms, uint64_t wall) {
+        if (!avalanche) return;
+        Require(ms <= INT64_MAX && wall <= INT64_MAX, "Avalanche clock outside signed range");
+        // Dispatcher close notices can be suppressed by notice backpressure.
+        for (auto it = avalanche_peers.begin(); it != avalanche_peers.end();) {
+            const auto f = dispatcher->ActiveFeatures(*it);
+            if (!f || !(*f & AVALANCHE_FEATURE)) {
+                avalanche->Disconnect(*it);
+                it = avalanche_peers.erase(it);
+            } else ++it;
+        }
+        for (auto it = avalanche_activations.begin(); it != avalanche_activations.end();) {
+            const auto f = dispatcher->ActiveFeatures(*it);
+            if (!f || !(*f & AVALANCHE_FEATURE)) { it = avalanche_activations.erase(it); continue; }
+            std::string error;
+            const auto r = avalanche->Activate(*it, error);
+            if (r == ava::PeerResult::Backpressure) { ++it; continue; }
+            Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
+            avalanche_peers.insert(*it);
+            it = avalanche_activations.erase(it);
+        }
+        const auto snapshot = runtime->Snapshot();
+        if (snapshot.chain) {
+            RuntimeBlockObservation observation;
+            std::string error;
+            if (runtime->ObserveAvalancheBlock(snapshot.chain->stable_tip, observation, error) &&
+                observation.known && observation.valid && observation.has_data && !observation.finalized) {
+                if (!avalanche->Reconcile({ava::ItemKind::Block, snapshot.chain->stable_tip}, observation.active, error) &&
+                    error != "already-finalized-item" && error != "vote-record-capacity")
+                    throw std::runtime_error("Avalanche reconciliation: " + error);
+            }
+        }
+        const auto result = avalanche->Tick(InitialDownload(wall), int64_t(ms), int64_t(wall));
+        avalanche_error = result.message;
+        Require(result.code == ava::DriverCode::Ok || result.code == ava::DriverCode::NotReady ||
+                result.code == ava::DriverCode::Backpressure, "Avalanche tick: " + result.message);
+        if (ms >= avalanche_save_due) {
+            const auto saved = avalanche->Save();
+            Require(saved.code == ava::DriverCode::Ok || saved.code == ava::DriverCode::NotReady,
+                    "Avalanche peer save: " + saved.message);
+            avalanche_save_due = ms > UINT64_MAX - 60000 ? UINT64_MAX : ms + 60000;
+        }
+    }
+    bool Node::HandleApplication(DispatcherNotice notice, uint64_t now) {
+        auto &message = *notice.application;
+        const bool inventory = message.command == "inv" || message.command == "getdata" || message.command == "notfound";
+        const bool avalanche_message = message.command.starts_with("ava") || message.command == "getavaproofs";
+        std::optional<Message> transaction;
+        if (inventory) {
+            const auto limit = dispatcher->ActiveLimit(notice.connection);
+            if (!limit) return true;
+            std::vector<Inventory> items, tx, proof;
+            std::string error;
+            if (!DecodeInventory(message.payload, *limit, items, error)) { ClosePeer(notice.connection); return true; }
+            for (const auto &i : items) {
+                if (i.type == 1) tx.push_back(i);
+                else if (i.type == PROOF_INVENTORY_TYPE) proof.push_back(i);
+                else { ClosePeer(notice.connection); return true; }
+            }
+            if (!tx.empty()) {
+                Bytes bytes;
+                Require(EncodeInventory(tx, *limit, bytes, error), "transaction inventory encoding failed");
+                transaction = Message{message.command, std::move(bytes)};
+            }
+            if (!proof.empty()) {
+                Bytes bytes;
+                Require(EncodeInventory(proof, *limit, bytes, error), "proof inventory encoding failed");
+                message.payload = std::move(bytes);
+            } else notice.application.reset();
+        } else if (!avalanche_message) {
+            transaction = std::move(message);
+            notice.application.reset();
+        }
+        // Retried notices contain only the proof half; transactions are admitted
+        // exactly once even if Avalanche's outgoing action queue is saturated.
+        if (transaction) {
+            auto result = relay->Handle(notice.connection.value, *transaction, now);
+            if (result.invalid_peer) { ClosePeer(notice.connection); return true; }
+            RelayActions(std::move(result), now);
+        }
+        if (!notice.application) return true;
+        if (!avalanche) { ClosePeer(notice.connection); return true; }
+        std::string error;
+        if (avalanche_activations.contains(notice.connection)) {
+            const auto r = avalanche->Activate(notice.connection, error);
+            if (r == ava::PeerResult::Backpressure) { pending_avalanche_notice = std::move(notice); return false; }
+            Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
+            avalanche_peers.insert(notice.connection);
+            avalanche_activations.erase(notice.connection);
+        }
+        const auto result = avalanche->Handle(notice, now, error);
+        if (result == ava::PeerResult::Backpressure) { pending_avalanche_notice = std::move(notice); return false; }
+        if (result == ava::PeerResult::Rejected || result == ava::PeerResult::UnknownPeer) ClosePeer(notice.connection);
+        else if (result == ava::PeerResult::LocalFailure) {
+            // Runtime may be temporarily nonauthoritative during bounded
+            // recovery. Keep the exact notice until a later loop retries it.
+            if (error == "runtime-not-authoritative" || error == "runtime-header-unavailable" ||
+                error == "runtime-snapshot-changed" || error == "restore-snapshot-changed") {
+                pending_avalanche_notice = std::move(notice); return false;
+            }
+            throw std::runtime_error("Avalanche application: " + error);
+        }
+        return true;
+    }
