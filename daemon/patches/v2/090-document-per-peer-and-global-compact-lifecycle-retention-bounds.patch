From 5cff98fd6846c876b9aca183dec2d73ed882ae7b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:25:19 -0700
Subject: [PATCH] Document per-peer and global compact lifecycle retention
 bounds

Integration review note (2026-10-15; original source commit had no body):
Require explicit per-peer and global bounds for retained compact-request lifecycle guards. At capacity stop new requests or disconnect; eviction followed by same-BlockID reuse would restore stale-response ambiguity. Runtime enforcement remains an integration obligation.

---
 src/lotus_v2/peer_codec.h              | 5 +++--
 src/lotus_v2/peer_codec_test/README.md | 5 +++--
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/peer_codec.h b/src/lotus_v2/peer_codec.h
index 8b516c40826ddab30874e2e41a5dd03345a47c5a..65c6c1de3ffcd0ca4f5420769c586ec9bf6fc1ba 100644
--- a/src/lotus_v2/peer_codec.h
+++ b/src/lotus_v2/peer_codec.h
@@ -156,8 +156,9 @@ enum class ReconstructionStatus {
 // returns RequestOutstanding without mutation; after completion/cancellation it
 // requires full-block fallback. The caller must retain this lifecycle for that
 // peer/BlockID until disconnection, because blocktxn carries no request nonce.
-// The caller bounds these retained tombstones and refuses further compact
-// lifecycles or disconnects when that quota is reached; it cannot evict one
+// The caller bounds these retained tombstones per peer and globally, refusing
+// further compact lifecycles or disconnecting when either quota is reached;
+// it cannot evict one
 // while allowing a same-peer/same-BlockID missing request again.
 // Allocation failures are operational exceptions for the caller to handle.
 class CompactReconstruction {
diff --git a/src/lotus_v2/peer_codec_test/README.md b/src/lotus_v2/peer_codec_test/README.md
index 2653bad034b5a41c7538bcb428b55c0fe7c0c8fd..aa1228fbcbc11618d7d4292dcce197a5957e8089 100644
--- a/src/lotus_v2/peer_codec_test/README.md
+++ b/src/lotus_v2/peer_codec_test/README.md
@@ -46,8 +46,9 @@ Implemented:
   The caller retains lifecycle ownership for each peer/BlockID until disconnect;
   retries on the same connection require a full body. Recreating a fresh object
   for the same peer/BlockID would bypass that caller responsibility. Bound the
-  retained tombstone/object count per peer: refuse new compact lifecycles or
-  rotate/disconnect the connection at that quota. Evicting tombstones while
+  retained tombstone/object count per peer and globally: refuse new compact
+  lifecycles or rotate/disconnect connections at either quota. Do not retain an
+  unbounded per-BlockID map. Evicting tombstones while
   allowing the same peer/BlockID to issue another request is unsafe.
 - Full-hash candidate deduplication, bounded collision buckets, ambiguity
   requests, duplicate compact-short-ID fallback, and strict witness-variant
-- 
