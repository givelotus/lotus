+        /*in_memory_chainstate=*/true, [&] {
+            SetV2StatePersistDir(fs::PathToString(m_path_root / "empty-native-cache"));
+            anchor->hashStateRoot.begin()[0] ^= 1;
+        });
+    anchor->hashStateRoot = original_root;
+    BOOST_CHECK(!accepted);
