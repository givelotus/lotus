From 604106e5d15959f8f7fe4bae3edbaed38776b688 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 23:08:40 -0700
Subject: [PATCH] Prove a later UTXO commit can spend the previous one

Commit coin A, then a second Commit erases A and inserts B. Undo the
newest record first, undo again, and reopen. The reopened root matches
the empty root byte for byte. A connected block must Commit once per
transaction. lotusd does not call this store, and no V2 block is accepted.
---
 src/lotus_v2/test_persistent_utxo.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/lotus_v2/test_persistent_utxo.cpp b/src/lotus_v2/test_persistent_utxo.cpp
index a83003162..430ebc147 100644
--- a/src/lotus_v2/test_persistent_utxo.cpp
+++ b/src/lotus_v2/test_persistent_utxo.cpp
@@ -412,6 +412,31 @@ void Run() {
     Check(PersistentUtxoStore::Open(bad_dir.string(), ignored_temp, error), "temp file is not a record");
     Check(ByteEqual(RootOf(ignored_temp), bad_root), "a temp snapshot root is not published");
 
+    // A connected block must Commit once per transaction, newest Undo first.
+    const std::filesystem::path per_tx_dir = std::filesystem::path(base) / "per-tx";
+    PersistentUtxoStore per_tx;
+    Check(PersistentUtxoStore::Open(per_tx_dir.string(), per_tx, error), "open per-transaction store");
+    const Hash per_tx_empty = RootOf(per_tx);
+    Check(ByteEqual(per_tx_empty, EmptyUtxoRoot()) && per_tx.Size() == 0,
+          "per-transaction store starts at the empty root");
+    const Coin coin_a = MakeCoin(21, 2100);
+    const Coin coin_b = MakeCoin(22, 2200);
+    Check(per_tx.Commit({}, {coin_a}, error), "commit 1 inserts coin A");
+    Check(per_tx.Commit({coin_a.outpoint}, {coin_b}, error),
+          "commit 2 erases A and inserts coin B");
+    Check(per_tx.Size() == 1, "the spending commit leaves only coin B");
+    Check(per_tx.Undo(error), "undo the spending commit first");
+    Check(per_tx.Undo(error), "undo the creating commit");
+    Check(ByteEqual(RootOf(per_tx), per_tx_empty) && per_tx.Size() == 0,
+          "two undos restore the empty root");
+    PersistentUtxoStore per_tx_reopened;
+    Check(PersistentUtxoStore::Open(per_tx_dir.string(), per_tx_reopened, error),
+          "reopen after two undos");
+    const Hash reopened_root = RootOf(per_tx_reopened);
+    Check(per_tx_reopened.Size() == 0 && ByteEqual(reopened_root, per_tx_empty) &&
+              ByteEqual(reopened_root, EmptyUtxoRoot()),
+          "reopened root equals the empty root byte for byte");
+
     std::error_code remove_ec;
     std::filesystem::remove_all(base, remove_ec);
     Check(!remove_ec, "remove temporary directory");
