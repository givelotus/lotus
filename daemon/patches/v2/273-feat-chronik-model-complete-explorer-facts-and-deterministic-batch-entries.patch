From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:04:23 -0700
Subject: [PATCH] feat(chronik): model complete explorer facts and
 deterministic batch entries

---
 chronik/chronik-db/src/v2_explorer.rs | 250 ++++++++++++++++++++++++++
 1 file changed, 250 insertions(+)
 create mode 100644 chronik/chronik-db/src/v2_explorer.rs

diff --git a/chronik/chronik-db/src/v2_explorer.rs b/chronik/chronik-db/src/v2_explorer.rs
new file mode 100644
index 0000000000000000000000000000000000000000..01933e241368801cb7354e82722285657d0876ca
--- /dev/null
+++ b/chronik/chronik-db/src/v2_explorer.rs
@@ -0,0 +1,250 @@
+//! Complete, chunked native explorer facts. Only the V2 DB owner commits these
+//! entries, together with its receipt, checkpoint and undo.
+use bitcoinsuite_core::lotus_v2::{Hash32, OutPoint, Output, TxHash, TxId, TxLocation};
+use crate::v2_branch::{Anchor, CommittedBlock, Error, ReadSnapshot, MAX_BATCH_BYTES};
+use rocksdb::{Direction, IteratorMode};
+use serde::{Deserialize, Serialize, de::DeserializeOwned};
+
+type Result<T> = std::result::Result<T, Error>;
+/// Fixed wire chunk size; a request reads at most two chunks.
+pub const WIRE_CHUNK_BYTES: usize = 32768;
+/// Native header length.
+pub const HEADER_BYTES: usize = 134;
+/// Maximum serialized individual metadata record.
+pub const MAX_RECORD_BYTES: usize = 16 * 1024;
+
+/// Serde adapters preserve native digest order and typed identities.
+pub mod native_serde {
+    use super::*;
+    macro_rules! digest_adapter {
+        ($name:ident,$ty:ty,$to:expr,$from:expr) => {
+            pub mod $name {
+                use super::*;
+                pub fn serialize<S: serde::Serializer>(v: &$ty, s: S) -> std::result::Result<S::Ok,S::Error> { ($to)(v).serialize(s) }
+                pub fn deserialize<'de,D: serde::Deserializer<'de>>(d: D) -> std::result::Result<$ty,D::Error> { Ok(($from)(<[u8;32]>::deserialize(d)?)) }
+            }
+        }
+    }
+    digest_adapter!(hash,Hash32,|v: &Hash32| v.0,Hash32);
+    digest_adapter!(txid,TxId,|v: &TxId| v.0.0,|b| TxId(Hash32(b)));
+    digest_adapter!(txhash,TxHash,|v: &TxHash| v.0.0,|b| TxHash(Hash32(b)));
+    pub mod location {
+        use super::*;
+        pub fn serialize<S: serde::Serializer>(v: &TxLocation,s:S)->std::result::Result<S::Ok,S::Error>{ (v.block_id.0,v.height,v.tx_index,v.txid.0.0,v.txhash.0.0).serialize(s) }
+        pub fn deserialize<'de,D:serde::Deserializer<'de>>(d:D)->std::result::Result<TxLocation,D::Error>{
+            let (block_id,height,tx_index,txid,txhash)=Deserialize::deserialize(d)?;
+            Ok(TxLocation{block_id:Hash32(block_id),height,tx_index,txid:TxId(Hash32(txid)),txhash:TxHash(Hash32(txhash))})
+        }
+    }
+    pub mod outpoint {
+        use super::*;
+        pub fn serialize<S:serde::Serializer>(v:&OutPoint,s:S)->std::result::Result<S::Ok,S::Error>{(v.txid.0.0,v.out_idx).serialize(s)}
+        pub fn deserialize<'de,D:serde::Deserializer<'de>>(d:D)->std::result::Result<OutPoint,D::Error>{let (txid,out_idx)=Deserialize::deserialize(d)?;Ok(OutPoint{txid:TxId(Hash32(txid)),out_idx})}
+    }
+    pub mod output {
+        use super::*;
+        pub fn serialize<S:serde::Serializer>(v:&Output,s:S)->std::result::Result<S::Ok,S::Error>{v.encode().map_err(serde::ser::Error::custom)?.serialize(s)}
+        pub fn deserialize<'de,D:serde::Deserializer<'de>>(d:D)->std::result::Result<Output,D::Error>{Output::decode(&Vec::<u8>::deserialize(d)?).map_err(serde::de::Error::custom)}
+    }
+    pub mod header {
+        use super::*;
+        pub fn serialize<S:serde::Serializer>(v:&[u8;134],s:S)->std::result::Result<S::Ok,S::Error>{s.serialize_bytes(v)}
+        pub fn deserialize<'de,D:serde::Deserializer<'de>>(d:D)->std::result::Result<[u8;134],D::Error>{Vec::<u8>::deserialize(d)?.try_into().map_err(|_|serde::de::Error::custom("header length"))}
+    }
+}
+/// Payload or native framed-table byte interval in the exact transaction.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq, Serialize, Deserialize)]
+pub struct WireRange { pub offset:u64, pub length:u64 }
+impl WireRange {
+    /// Reject overflow and offsets outside the retained frame.
+    pub fn validate(self, wire_size:u64)->Result<()> {
+        if self.offset.checked_add(self.length).filter(|end|*end<=wire_size).is_none(){return Err(Error::Invalid("explorer wire range"));} Ok(())
+    }
+}
+/// One native public witness, represented without large inline vectors.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct WitnessFact {
+    pub script:WireRange, pub siblings_table:WireRange, pub siblings_count:u32,
+    pub arguments_table:WireRange, pub arguments_count:u32,
+}
+/// Immutable creation fact resolved by the single DB owner before the spend.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct ResolvedCreation {
+    #[serde(with="native_serde::outpoint")] pub outpoint:OutPoint,
+    #[serde(with="native_serde::output")] pub output:Output,
+    #[serde(with="native_serde::location")] pub creation:TxLocation,
+}
+/// Complete native input facts; selectors retain their raw meaning by flags.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct InputFact {
+    pub prev_txid:[u8;32], pub prev_index:u32, pub sequence:u32, pub flags:u8,
+    pub path_index:u8, pub has_coinbase_data:bool, pub coinbase_data:WireRange,
+    pub witnesses:Vec<WitnessFact>, pub resolved_creation:Option<ResolvedCreation>,
+}
+/// Required native transaction frame, never reconstructed from output records.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct ExplorerTxFacts { pub wire:Vec<u8>, pub lock:u64, pub inputs:Vec<InputFact> }
+/// Exact authenticated native header (genesis retains its zero predecessor).
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct ExplorerBlockFacts { #[serde(with="native_serde::header")] pub header_wire:[u8;134] }
+/// Fixed transaction metadata; large inputs and bytes live in separate keys.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct TxMeta {
+    #[serde(with="native_serde::location")] pub location:TxLocation,
+    pub lock:u64, pub input_count:u32, pub output_count:u32, pub wire_size:u64,
+}
+/// Fixed block metadata joined to canonical height.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct BlockMeta {
+    pub anchor:Anchor, #[serde(with="native_serde::header")] pub header_wire:[u8;134], pub tx_count:u32,
+}
+/// Input descriptor with a count instead of an unbounded witness vector.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct InputMeta {
+    pub prev_txid:[u8;32], pub prev_index:u32, pub sequence:u32, pub flags:u8,
+    pub path_index:u8, pub has_coinbase_data:bool, pub coinbase_data:WireRange,
+    pub witness_count:u32, pub resolved_creation:Option<ResolvedCreation>,
+}
+impl InputFact {
+    /// Bounded persisted descriptor.
+    pub fn metadata(&self)->Result<InputMeta>{Ok(InputMeta{
+        prev_txid:self.prev_txid,prev_index:self.prev_index,sequence:self.sequence,flags:self.flags,
+        path_index:self.path_index,has_coinbase_data:self.has_coinbase_data,coinbase_data:self.coinbase_data,
+        witness_count:u32::try_from(self.witnesses.len()).map_err(|_|Error::Invalid("witness count"))?,
+        resolved_creation:self.resolved_creation.clone(),
+    })}
+}
+/// Bounded record encoder used by the owner and receipt reconstruction.
+pub fn encode_record<T:Serialize>(value:&T)->Result<Vec<u8>>{
+    let value=postcard::to_allocvec(value).map_err(|_|Error::Corrupt)?;
+    if value.len()>MAX_RECORD_BYTES{return Err(Error::Invalid("explorer record bound"));}Ok(value)
+}
+/// Stored record decoder rejects excessive records before deserialization.
+pub fn decode_record<T:DeserializeOwned>(bytes:&[u8])->Result<T>{
+    if bytes.len()>MAX_RECORD_BYTES{return Err(Error::Corrupt);}postcard::from_bytes(bytes).map_err(|_|Error::Corrupt)
+}
+fn key(prefix:&[u8],suffix:&[u8])->Vec<u8>{let mut k=prefix.to_vec();k.extend(suffix);k}
+pub fn height_key(height:u64)->Vec<u8>{key(b"eH",&height.to_be_bytes())}
+pub fn block_key(id:Hash32)->Vec<u8>{key(b"eB",&id.0)}
+pub fn block_tx_key(id:Hash32,index:u32)->Vec<u8>{let mut k=key(b"eO",&id.0);k.extend(index.to_be_bytes());k}
+pub fn tx_key(id:TxId)->Vec<u8>{key(b"eT",&id.0.0)}
+pub fn txhash_key(id:TxHash)->Vec<u8>{key(b"eX",&id.0.0)}
+pub fn input_key(id:TxId,index:u32)->Vec<u8>{let mut k=key(b"eI",&id.0.0);k.extend(index.to_be_bytes());k}
+pub fn witness_key(id:TxId,input:u32,index:u32)->Vec<u8>{let mut k=key(b"eW",&id.0.0);k.extend(input.to_be_bytes());k.extend(index.to_be_bytes());k}
+pub fn wire_key(id:TxId,index:u32)->Vec<u8>{let mut k=key(b"eR",&id.0.0);k.extend(index.to_be_bytes());k}
+fn add_size(total:&mut usize,amount:usize)->Result<()>{*total=total.checked_add(amount).filter(|n|*n<=MAX_BATCH_BYTES).ok_or(Error::Invalid("explorer batch bound"))?;Ok(())}
+/// Conservative reservation before any planner allocation. Accounts for entries,
+/// copies in receipt/undo/batch, vector objects and fixed per-record overhead.
+pub fn preflight_explorer_block(block:&CommittedBlock)->Result<usize>{
+    let mut size=4096;
+    for tx in &block.transactions {
+        add_size(&mut size,tx.explorer.wire.len().checked_mul(6).ok_or(Error::Invalid("wire bound"))?)?;
+        add_size(&mut size,4096)?;
+        for input in &tx.explorer.inputs {
+            add_size(&mut size,8192)?;
+            add_size(&mut size,input.witnesses.len().checked_mul(2048).ok_or(Error::Invalid("witness bound"))?)?;
+        }
+        add_size(&mut size,(tx.explorer.wire.len()/WIRE_CHUNK_BYTES+1)*1024)?;
+    }Ok(size)
+}
+fn validate_input(input:&InputFact,size:u64)->Result<()>{
+    if !matches!(input.flags,1..=3){return Err(Error::Invalid("input flags"));}
+    input.coinbase_data.validate(size)?;
+    if !input.has_coinbase_data && input.coinbase_data!=WireRange::default(){return Err(Error::Invalid("absent coinbase range"));}
+    match (input.flags,&input.resolved_creation){
+        (1,Some(coin)) if coin.outpoint.txid.0.0==input.prev_txid && coin.outpoint.out_idx==input.prev_index && !coin.output.is_burn()=>{},
+        (2|3,None)=>{},_=>return Err(Error::Invalid("frozen spend creation")),
+    }
+    for witness in &input.witnesses {
+        witness.script.validate(size)?;witness.siblings_table.validate(size)?;witness.arguments_table.validate(size)?;
+        if witness.siblings_table.length==0 || witness.arguments_table.length==0{return Err(Error::Invalid("missing witness table framing"));}
+    }Ok(())
+}
+/// Deterministic exact entries. The owner resolves spends first and stages these
+/// into its one batch, retaining every prior value in its validated undo.
+pub fn plan_explorer_block(block:&CommittedBlock)->Result<Vec<(Vec<u8>,Vec<u8>)>>{
+    preflight_explorer_block(block)?;
+    let h=&block.explorer.header_wire;
+    if u64::from_le_bytes(h[62..70].try_into().unwrap())!=block.anchor.height{return Err(Error::Invalid("explorer header height"));}
+    if (block.anchor.height==0 && h[..32]!=[0;32]) || (block.anchor.height!=0 && h[..32]!=block.parent.block_id){return Err(Error::Invalid("explorer header parent"));}
+    let mut entries=vec![(height_key(block.anchor.height),block.anchor.block_id.to_vec()),(block_key(Hash32(block.anchor.block_id)),encode_record(&BlockMeta{anchor:block.anchor,header_wire:*h,tx_count:u32::try_from(block.transactions.len()).map_err(|_|Error::Invalid("transaction count"))?})?)];
+    for (index,tx) in block.transactions.iter().enumerate(){
+        let loc=tx.location;
+        if loc.block_id.0!=block.anchor.block_id || loc.height!=block.anchor.height || loc.tx_index as usize!=index{return Err(Error::Invalid("explorer transaction location"));}
+        let facts=&tx.explorer;
+        if facts.wire.is_empty(){return Err(Error::Invalid("empty transaction frame"));}
+        let meta=TxMeta{location:loc,lock:facts.lock,input_count:u32::try_from(facts.inputs.len()).map_err(|_|Error::Invalid("input count"))?,output_count:u32::try_from(tx.outputs.len()).map_err(|_|Error::Invalid("output count"))?,wire_size:facts.wire.len() as u64};
+        entries.push((tx_key(loc.txid),encode_record(&meta)?));
+        entries.push((txhash_key(loc.txhash),loc.txid.0.0.to_vec()));
+        let mut ids=loc.txid.0.0.to_vec();ids.extend(loc.txhash.0.0);
+        entries.push((block_tx_key(loc.block_id,loc.tx_index),ids));
+        for (i,input) in facts.inputs.iter().enumerate(){
+            validate_input(input,meta.wire_size)?;
+            entries.push((input_key(loc.txid,i as u32),encode_record(&input.metadata()?)?));
+            for (w,witness) in input.witnesses.iter().enumerate(){entries.push((witness_key(loc.txid,i as u32,w as u32),encode_record(witness)?));}
+        }
+        for (chunk,wire) in facts.wire.chunks(WIRE_CHUNK_BYTES).enumerate(){entries.push((wire_key(loc.txid,chunk as u32),wire.to_vec()));}
+    }
+    entries.sort_by(|a,b|a.0.cmp(&b.0));
+    if entries.windows(2).any(|w|w[0].0==w[1].0){return Err(Error::Invalid("duplicate explorer identity"));}
+    Ok(entries)
+}
+impl ReadSnapshot<'_> {
+    /// Canonical block with validated height/header joins.
+    pub fn explorer_block(&self,id:Hash32)->Result<Option<BlockMeta>>{
+        let Some(bytes)=self.inner.get(block_key(id))? else{return Ok(None)};
+        let meta:BlockMeta=decode_record(&bytes)?;
+        if meta.anchor.block_id!=id.0 || meta.anchor.height>self.anchor.height || self.inner.get(height_key(meta.anchor.height))?.as_deref()!=Some(&id.0){return Err(Error::Corrupt);}
+        if u64::from_le_bytes(meta.header_wire[62..70].try_into().unwrap())!=meta.anchor.height{return Err(Error::Corrupt);}Ok(Some(meta))
+    }
+    pub fn explorer_block_at_height(&self,height:u64)->Result<Option<BlockMeta>>{
+        let Some(bytes)=self.inner.get(height_key(height))? else{return Ok(None)};
+        let id=Hash32(bytes.as_slice().try_into().map_err(|_|Error::Corrupt)?);
+        let meta=self.explorer_block(id)?.ok_or(Error::Corrupt)?;
+        if meta.anchor.height!=height{return Err(Error::Corrupt);}Ok(Some(meta))
+    }
+    /// Transaction metadata joined to the existing location authority and order.
+    pub fn explorer_tx(&self,id:TxId)->Result<Option<TxMeta>>{
+        let Some(bytes)=self.inner.get(tx_key(id))? else{return Ok(None)};
+        let meta:TxMeta=decode_record(&bytes)?;
+        let loc=meta.location;
+        if loc.txid!=id || self.transaction(id)?!=Some(loc){return Err(Error::Corrupt);}
+        let block=self.explorer_block(loc.block_id)?.ok_or(Error::Corrupt)?;
+        if block.anchor.height!=loc.height || loc.tx_index>=block.tx_count || self.explorer_block_tx(loc.block_id,loc.tx_index)?!=Some((id,loc.txhash)){return Err(Error::Corrupt);}Ok(Some(meta))
+    }
+    pub fn explorer_tx_by_hash(&self,hash:TxHash)->Result<Option<TxMeta>>{
+        let Some(bytes)=self.inner.get(txhash_key(hash))? else{return Ok(None)};
+        let id=TxId(Hash32(bytes.as_slice().try_into().map_err(|_|Error::Corrupt)?));
+        let meta=self.explorer_tx(id)?.ok_or(Error::Corrupt)?;
+        if meta.location.txhash!=hash{return Err(Error::Corrupt);}Ok(Some(meta))
+    }
+    pub fn explorer_block_tx(&self,block:Hash32,index:u32)->Result<Option<(TxId,TxHash)>>{
+        self.inner.get(block_tx_key(block,index))?.map(|bytes|{
+            if bytes.len()!=64{return Err(Error::Corrupt);}
+            Ok((TxId(Hash32(bytes[..32].try_into().unwrap())),TxHash(Hash32(bytes[32..].try_into().unwrap()))))
+        }).transpose()
+    }
+    pub fn explorer_input(&self,id:TxId,index:u32)->Result<Option<InputMeta>>{
+        self.inner.get(input_key(id,index))?.map(|bytes|decode_record(&bytes)).transpose()
+    }
+    pub fn explorer_witness(&self,id:TxId,input:u32,index:u32)->Result<Option<WitnessFact>>{
+        self.inner.get(witness_key(id,input,index))?.map(|bytes|decode_record(&bytes)).transpose()
+    }
+    pub fn explorer_wire_chunk(&self,id:TxId,index:u32)->Result<Option<Vec<u8>>>{
+        let bytes=self.inner.get(wire_key(id,index))?;
+        if bytes.as_ref().is_some_and(|b|b.is_empty()||b.len()>WIRE_CHUNK_BYTES){return Err(Error::Corrupt);}Ok(bytes)
+    }
+    /// Exclusive bounded seek. The key shape is constrained by the caller's
+    /// exact family prefix and expected width; no foreign key can continue it.
+    pub fn explorer_next_raw(&self,prefix:&[u8],key_len:usize,after:Option<&[u8]>)->Result<Option<(Vec<u8>,Vec<u8>)>>{
+        let allowed=matches!((prefix.get(..2),prefix.len(),key_len),(Some(b"eH"),2,10)|(Some(b"eO"),34,38)|(Some(b"eI"),34,38)|(Some(b"eW"),38,42));
+        if !allowed || after.is_some_and(|k|k.len()!=key_len||!k.starts_with(prefix)){return Err(Error::Invalid("explorer continuation key"));}
+        let start=after.unwrap_or(prefix);
+        let mut iter=self.inner.iterator(IteratorMode::From(start,Direction::Forward));
+        let mut item=iter.next().transpose()?;
+        if item.as_ref().is_some_and(|(k,_)|Some(k.as_ref())==after){item=iter.next().transpose()?;}
+        let Some((k,v))=item else{return Ok(None)};
+        if !k.starts_with(prefix){return Ok(None)}
+        if k.len()!=key_len || v.len()>MAX_RECORD_BYTES{return Err(Error::Corrupt);}Ok(Some((k.to_vec(),v.to_vec())))
+    }
+}
