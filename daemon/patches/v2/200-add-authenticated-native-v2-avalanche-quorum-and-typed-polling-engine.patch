diff --git a/src/lotus_v2/avalanche_chain.h b/src/lotus_v2/avalanche_chain.h
new file mode 100644
index 0000000000000000000000000000000000000000..054c6b7839ca7169fb1cd591b94d6c136fc019a2
--- /dev/null
