From 6a85acd8bc55c1f6b4a9c41dea6c34e7a45a6742 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:15:46 -0700
Subject: [PATCH] fix(v2): charge actual historical output location joins

---
 chronik/chronik-http/src/v2_explorer.rs | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/chronik/chronik-http/src/v2_explorer.rs b/chronik/chronik-http/src/v2_explorer.rs
index c21445e1c2adddb27af85fc8245e339097e2cd44..d0fabd272b417cf4b20f6efc11b3e67fb84bbe13 100644
--- a/chronik/chronik-http/src/v2_explorer.rs
+++ b/chronik/chronik-http/src/v2_explorer.rs
@@ -888,12 +888,10 @@ fn dispatch(
                     break;
                 };
                 page.read()?;
-                // Reserve the output plus both possible canonical location
-                // joins before ReadSnapshot::output performs any of them.
-                for _ in 0..3 {
-                    db(asset_budget.charge())?;
-                }
-                let out = db(v.output(op))?.ok_or_else(unavailable)?;
+                // The counted helper charges the output and each canonical
+                // location join immediately before its storage read.
+                let out = db(v.output_counted(op, &mut asset_budget))?
+                    .ok_or_else(unavailable)?;
                 if out.outpoint != op
                     || out.creation.txid != op.txid
                     || !out.output.has_token()
