+void Settle(DevelopmentRuntime &r, const Hash &tip) {
+    for (unsigned i=0;i<100;++i) {
+        auto t=r.Tick(UINT64_MAX,0,LimitsForTick());
+        Check(!t.snapshot.reopen_required,"tick storage: " + t.diagnostic);
