From b2940f6995bff47a4f7435ae34b9ea70f1e66349 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 13:23:36 -0700
Subject: [PATCH] vm(v2): reuse prepared snapshots across equivalent resolved
 wrappers

Policy and consensus script checks independently allocate equivalent resolved-coin wrappers. Keep prepared VM state thread-local but accept a replacement wrapper only after matching the complete transaction hash, active chain ID and every field of the owned resolved outputs. Retain the existing wrapper-identity fast path for subsequent inputs. Native transaction and cost profiles at this call site are immutable node constants.

Reuse only immutable preparation: policy and consensus invocation flags, signature verifiers, and deferred effects remain per-run and execute normally. Failed preparation is not promoted to a reusable context. Extend VM context binding coverage to every coin field, transaction and chain changes; execute existing deferred-record cache checks with distinct policy/consensus flags. Source candidate only: normal compilation, native tests and throughput measurement have not yet run.

Coordinator integration: reuse only immutable preparation across equivalent independently allocated resolved-coin wrappers by exact fullTxHash, chain identity and every resolved output field; full policy/consensus VM executions and effects remain fresh. Earlier owner112 receives the inherited outer pointer/live-wrapper hash-binding repair and its later existing crypto fixture the regression. No returned whole-VM verdict, context weakening or borrowed lifetimes.

diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index 08a5d105786a23c4cc68662f4364292e468d90fc..b5bd5b400924729a2130da96926feff185d3e61b 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -2197,7 +2197,34 @@ void PreparedTransactionOwnership() {
 #ifdef LOTUS_V2_VM_TEST_INSTRUMENTATION
     const auto before = VmPreparationWorkCounts();
 #endif
+    CHECK(!prepared.MatchesIdentityAndCoins(Hash{}, chain, coins));
     CHECK(prepared.Prepare(tx, tp, chain, coins, cost, error));
+    const auto txhash = prepared.Signing().Identities().txhash;
+    // Independently allocated wrappers may share preparation only when every
+    // authenticated coin field and the transaction/chain identity agree.
+    const ResolvedCoins independent_coins = coins;
+    CHECK(independent_coins.data() != coins.data());
+    CHECK(prepared.MatchesIdentityAndCoins(txhash, chain, independent_coins));
+    auto other_hash = txhash;
+    other_hash[0] ^= 1;
+    CHECK(!prepared.MatchesIdentityAndCoins(other_hash, chain, coins));
+    auto other_chain = chain;
+    other_chain[0] ^= 1;
+    CHECK(!prepared.MatchesIdentityAndCoins(txhash, other_chain, coins));
+    for (size_t field = 0; field < 8; ++field) {
+        auto changed = coins;
+        switch (field) {
+        case 0: ++changed[0]->value; break;
+        case 1: changed[0]->flags ^= OUTPUT_FLAG_IS_BURN; break;
+        case 2: changed[0]->token_id[0] ^= 1; break;
+        case 3: changed[0]->state_root[0] ^= 1; break;
+        case 4: changed[0]->branches[0][0] ^= 1; break;
+        case 5: changed[0]->paths[0][0] ^= 1; break;
+        case 6: changed[0]->legacy_script = VmBytes{0x51}; break;
+        case 7: changed[0].reset(); break;
+        }
+        CHECK(!prepared.MatchesIdentityAndCoins(txhash, chain, changed));
+    }
     CHECK(prepared.MaxFieldBound(0xe7) > PROFILE.max_element_bytes);
     const auto original_context = VmExecutionContext{tx, tp, chain, coins, 0, 0, std::nullopt};
     const auto original = EvaluateVmCharged(Hex("4e"), {}, PROFILE, cost, 0, 0, &original_context);
diff --git a/src/lotus_v2/vm.h b/src/lotus_v2/vm.h
index b0c38c55bcedb81d1c01c1e1fac71db2be5a0064..0d5cb3e86573791b962559c2ac4c422748f0f879 100644
--- a/src/lotus_v2/vm.h
+++ b/src/lotus_v2/vm.h
@@ -204,6 +204,13 @@ public:
     size_t MintCount() const { return mint_count_; }
     const VmAssetTotalsMap &AssetTotals() const { return asset_totals_; }
     const PreparedSigningContext &Signing() const { return signing_; }
+    // Identity/coin binding only, not an execution verdict. Callers must keep
+    // the transaction profile and cost schedule unchanged when reusing it.
+    bool MatchesIdentityAndCoins(const Hash &txhash, const ChainId &chain,
+                                 const ResolvedCoins &coins) const {
+        return ready_ && signing_.Identities().txhash == txhash &&
+               chain_ == chain && coins_ == coins;
+    }
     bool Owns(const VmExecutionContext &context) const {
         return ready_ && &context.tx == &tx_ && &context.tx_profile == &profile_ &&
             &context.chain_id == &chain_ && &context.resolved == &coins_;
diff --git a/src/test/v2_deferred_block_tests.cpp b/src/test/v2_deferred_block_tests.cpp
index ec60f077b9a83fc31b8f65bbde7cdf789775b40e..e0d387c0b32896d2d8ef2ddbef000e62ac6ad73a 100644
--- a/src/test/v2_deferred_block_tests.cpp
+++ b/src/test/v2_deferred_block_tests.cpp
@@ -302,8 +302,11 @@ BOOST_AUTO_TEST_CASE(deferred_records_bypass_script_cache) {
             TxValidationState state;
             TxSigCheckLimiter limiter;
             int sigchecks = 0;
+            // Different policy/consensus flags may share preparation, never
+            // their execution verdict or the deferred records of a run.
+            const uint32_t flags = round == 0 ? 0 : SCRIPT_VERIFY_NULLFAIL;
             BOOST_CHECK(CheckInputScripts(
-                *tx, state, view, /*flags=*/0, /*sigCacheStore=*/false,
+                *tx, state, view, flags, /*sigCacheStore=*/false,
                 /*scriptCacheStore=*/true, tx->GetPrecomputedData(), cache,
                 sigchecks, limiter, nullptr, nullptr));
         }
diff --git a/src/validation.cpp b/src/validation.cpp
index df3bd1f00ecc462030594a2ea20586e3ea78e301..5c36009acaf5940094325e4724bc57c24a396089 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4394,6 +4394,7 @@ CScriptCheck::CheckInput(lotus::v2::DeferredRecords &records) {
         struct CachedPreparedVm {
             const CTransaction *tx_ptr{nullptr};
             TxHash tx_hash{};
+            lotus::v2::ChainId chain{};
             std::weak_ptr<const V2ResolvedCoins> resolved_wp;
             lotus::v2::PreparedVmTransaction prepared_vm;
             lotus::v2::SigningPreparationStatus status{
@@ -4414,19 +4415,34 @@ CScriptCheck::CheckInput(lotus::v2::DeferredRecords &records) {
         };
 
         if (m_resolved_coins) {
+            const auto &chain = GetActiveV2ChainId();
             if (tl_cache.tx_ptr != ptxTo ||
                 tl_cache.tx_hash != ptxTo->GetHash() ||
+                tl_cache.chain != chain ||
                 tl_cache.resolved_wp.lock() != m_resolved_coins) {
+                lotus::v2::IdentityDigests precomputed_ids{};
+                extract_known_v2_ids(precomputed_ids);
+                // Policy and consensus checks have different execution flags,
+                // but prepare the same immutable transaction/coin snapshot.
+                // A new wrapper alone must not force another whole-tx prepare.
+                // Compare every coin field; never trust tx-pointer reuse or a
+                // transaction ID alone to bind the spent-output context.
+                const bool reusable = tl_cache.tx_ptr == ptxTo &&
+                    tl_cache.status ==
+                        lotus::v2::SigningPreparationStatus::Ready &&
+                    tl_cache.prepared_vm.MatchesIdentityAndCoins(
+                        precomputed_ids.txhash, chain, *m_resolved_coins);
                 tl_cache.tx_ptr = ptxTo;
                 tl_cache.tx_hash = ptxTo->GetHash();
+                tl_cache.chain = chain;
                 tl_cache.resolved_wp = m_resolved_coins;
-                lotus::v2::IdentityDigests precomputed_ids{};
-                extract_known_v2_ids(precomputed_ids);
-                std::string prep_err;
-                tl_cache.status = tl_cache.prepared_vm.PrepareChecked(
-                    ptxTo->ToV2Transaction(), lotus::v2::DefaultTxProfile,
-                    GetActiveV2ChainId(), *m_resolved_coins, kDefaultVmCost,
-                    prep_err, &precomputed_ids);
+                if (!reusable) {
+                    std::string prep_err;
+                    tl_cache.status = tl_cache.prepared_vm.PrepareChecked(
+                        ptxTo->ToV2Transaction(), lotus::v2::DefaultTxProfile,
+                        chain, *m_resolved_coins, kDefaultVmCost,
+                        prep_err, &precomputed_ids);
+                }
             }
             if (tl_cache.status != lotus::v2::SigningPreparationStatus::Ready) {
                 return std::make_pair(ScriptError::EVAL_FALSE,
