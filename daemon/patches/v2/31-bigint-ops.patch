@@ -0,0 +1,286 @@
+// Copyright (c) 2021 Logos Foundation
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Tests for the BIGINT opcodes (0xbf–0xc4):
+//   OP_BIGADD    (a b -- a+b)
+//   OP_BIGSUB    (a b -- a-b)
+//   OP_BIGMUL    (a b -- a*b)
+//   OP_BIGMOD    (a n -- a mod n)
+//   OP_BIGDIVMOD (a b -- quotient remainder)
+//   OP_BIGMULMOD (a b n -- (a*b) mod n)
+//
+// Operands and results use sign-magnitude byte vector encoding
+// (Bitcoin script integer format, extended to 32 bytes).
+//
+// Consensus guarantees tested:
+//   1. Basic correctness for small values
+//   2. Sign rules
+//   3. Commutativity/associativity spot-checks
+//   4. Identity laws
+//   5. Boundary: 256-bit operands accepted; 257-bit rejected
+//   6. BIGMUL overflow (result > 32 bytes) fails
+//   7. BIGDIVMOD: quotient*divisor + remainder == dividend
+//   8. BIGMULMOD: correct modular reduction, n=0 fails
+//   9. Stack underflow
+
+#include <policy/policy.h>
+#include <script/interpreter.h>
+#include <script/script.h>
+#include <script/script_error.h>
+
+#include <test/util/setup_common.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <core_io.h>
+
+BOOST_FIXTURE_TEST_SUITE(op_bigint_tests, BasicTestingSetup)
+
+typedef std::vector<uint8_t> valtype;
+typedef std::vector<valtype> stacktype;
+std::array<uint32_t, 2> bigint_flagset{{0, STANDARD_SCRIPT_VERIFY_FLAGS}};
+
+// ── Helpers ────────────────────────────────────────────────────────────────
+
+static void CheckSuccess(const CScript &script) {
+    BaseSignatureChecker sigchecker;
+    for (uint32_t flags : bigint_flagset) {
+        ScriptError err = ScriptError::OK;
+        stacktype stack{};
+        bool r = EvalScript(stack, script, flags, sigchecker, &err);
+        BOOST_CHECK_MESSAGE(r, "Expected OK but got "
+                                   << ScriptErrorString(err) << " for '"
+                                   << ScriptToAsmStr(script) << "'");
+    }
+}
+
+static void CheckError(const CScript &script, const ScriptError expected) {
+    BaseSignatureChecker sigchecker;
+    for (uint32_t flags : bigint_flagset) {
+        ScriptError err = ScriptError::OK;
+        stacktype stack{};
+        bool r = EvalScript(stack, script, flags, sigchecker, &err);
+        BOOST_CHECK_MESSAGE(!r, "Expected error for '"
+                                    << ScriptToAsmStr(script) << "'");
+        BOOST_CHECK_EQUAL(err, expected);
+    }
+}
+
+// Push a raw byte vector (big-integer operand) onto the script.
+static CScript &PushBytes(CScript &s, const valtype &v) {
+    s << v;
+    return s;
+}
+
+// Build a 32-byte (256-bit) sign-magnitude vector representing +2^255.
+// In script encoding: 32 bytes, all zero except the leading (byte 31)
+// which holds 0x00 (pure magnitude) and byte 30 = 0x80 (high bit = bit 255).
+// Wait — sign-magnitude: bytes 0..30 are magnitude LE, byte 31 has high bit
+// as sign. So 2^255 is represented with bit 255 of magnitude set = byte 31
+// of magnitude = 0x80, but that byte is also the sign byte in the compact
+// encoding. We need an extra sign byte.
+//
+// Actual encoding of 2^255 (positive):
+//   magnitude bytes [0..30] = 0x00, magnitude byte 31 = 0x80 (bit 255 set)
+//   The high bit of byte 31 is the sign bit. Since bit 255 of magnitude is
+//   set, the last byte would be 0x80 — but 0x80 with its high bit set means
+//   NEGATIVE. So we need a 33rd byte (0x00) as the sign byte.
+//   That makes the number 33 bytes — OVER the 32-byte limit.
+//
+// The largest representable positive value is 2^255 - 1:
+//   31 bytes of 0xff + one byte 0x7f = 32 bytes total.
+// 2^255 itself requires 33 bytes and will be rejected.
+//
+// Build 2^255 - 1: 31 bytes 0xff + 0x7f.
+static valtype Make255BitMax() {
+    valtype v(32, 0xff);
+    v[31] = 0x7f; // sign bit clear, all 31 magnitude bits set
+    return v;
+}
+
+// Build a 32-byte encoding that requires 33 bytes (invalid, >32 limit).
+// Use 32 bytes of 0xff — that is a negative number encoded in 32 bytes,
+// but its magnitude requires a 33rd byte to represent as positive... No.
+// Actually 32 bytes of 0xff means magnitude = 0x7fffffff...ff (31 bytes)
+// and the high bit of byte 31 is set = NEGATIVE.
+// We want a value whose minimal POSITIVE encoding exceeds 32 bytes.
+// 2^255: magnitude is 32 bytes (byte 31 = 0x80), needs extra 0x00 sign byte
+// → 33 bytes total. Build as 31 zero bytes + 0x80 + 0x00:
+static valtype Make256BitValue() {
+    // This is 2^255, which requires 33 bytes and will be rejected.
+    valtype v(33, 0x00);
+    v[31] = 0x80; // bit 255 of magnitude
+    // v[32] = 0x00 = positive sign byte
+    return v;
+}
+
+// ── Basic correctness ──────────────────────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_add_basic) {
+    // Small values — same results as OP_ADD.
+    CheckSuccess(CScript() << 3 << 4 << OP_BIGADD << 7 << OP_EQUAL);
+    CheckSuccess(CScript() << -3 << 4 << OP_BIGADD << 1 << OP_EQUAL);
+    CheckSuccess(CScript() << 3 << -4 << OP_BIGADD << -1 << OP_EQUAL);
+    CheckSuccess(CScript() << -3 << -4 << OP_BIGADD << -7 << OP_EQUAL);
+    CheckSuccess(CScript() << 0 << 0 << OP_BIGADD << 0 << OP_EQUAL);
+    CheckSuccess(CScript() << 100 << -100 << OP_BIGADD << 0 << OP_EQUAL);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_sub_basic) {
+    CheckSuccess(CScript() << 7 << 3 << OP_BIGSUB << 4 << OP_EQUAL);
+    CheckSuccess(CScript() << 3 << 7 << OP_BIGSUB << -4 << OP_EQUAL);
+    CheckSuccess(CScript() << -3 << -4 << OP_BIGSUB << 1 << OP_EQUAL);
+    CheckSuccess(CScript() << 0 << 0 << OP_BIGSUB << 0 << OP_EQUAL);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_mul_basic) {
+    CheckSuccess(CScript() << 3 << 4 << OP_BIGMUL << 12 << OP_EQUAL);
+    CheckSuccess(CScript() << -3 << 4 << OP_BIGMUL << -12 << OP_EQUAL);
+    CheckSuccess(CScript() << -3 << -4 << OP_BIGMUL << 12 << OP_EQUAL);
+    CheckSuccess(CScript() << 0 << 1000 << OP_BIGMUL << 0 << OP_EQUAL);
+    CheckSuccess(CScript() << 1 << 1 << OP_BIGMUL << 1 << OP_EQUAL);
+    // Large product within 63-bit range (same as OP_MUL).
+    CheckSuccess(CScript() << (int64_t)3037000499LL << (int64_t)3037000499LL
+                           << OP_BIGMUL
+                           << (int64_t)9223372036854775001LL << OP_EQUAL);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_divmod_basic) {
+    // 10 / 3 = 3 rem 1
+    CheckSuccess(CScript() << 10 << 3 << OP_BIGDIVMOD
+                           << 1 << OP_EQUALVERIFY  // remainder (top)
+                           << 3 << OP_EQUAL);       // quotient (below)
+    // -10 / 3 = -3 rem -1
+    CheckSuccess(CScript() << -10 << 3 << OP_BIGDIVMOD
+                           << -1 << OP_EQUALVERIFY
+                           << -3 << OP_EQUAL);
+    // 10 / -3 = -3 rem 1
+    CheckSuccess(CScript() << 10 << -3 << OP_BIGDIVMOD
+                           << 1 << OP_EQUALVERIFY
+                           << -3 << OP_EQUAL);
+    // Exact: 12 / 4 = 3 rem 0
+    CheckSuccess(CScript() << 12 << 4 << OP_BIGDIVMOD
+                           << 0 << OP_EQUALVERIFY
+                           << 3 << OP_EQUAL);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_mod_basic) {
+    CheckSuccess(CScript() << 10 << 3 << OP_BIGMOD << 1 << OP_EQUAL);
+    CheckSuccess(CScript() << -10 << 3 << OP_BIGMOD << -1 << OP_EQUAL);
+    CheckSuccess(CScript() << 10 << -3 << OP_BIGMOD << 1 << OP_EQUAL);
+    CheckSuccess(CScript() << 12 << 4 << OP_BIGMOD << 0 << OP_EQUAL);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_mulmod_basic) {
+    // (3 * 4) mod 5 = 12 mod 5 = 2
+    CheckSuccess(CScript() << 3 << 4 << 5 << OP_BIGMULMOD << 2 << OP_EQUAL);
+    // (7 * 8) mod 10 = 56 mod 10 = 6
+    CheckSuccess(CScript() << 7 << 8 << 10 << OP_BIGMULMOD << 6 << OP_EQUAL);
+    // (0 * anything) mod n = 0
+    CheckSuccess(CScript() << 0 << 100 << 7 << OP_BIGMULMOD << 0 << OP_EQUAL);
+    // (a * 1) mod n = a mod n
+    CheckSuccess(CScript() << 13 << 1 << 5 << OP_BIGMULMOD << 3 << OP_EQUAL);
+    // Negative: (-3 * 4) mod 5 = -12 mod 5 = -2 (sign follows dividend)
+    CheckSuccess(CScript() << -3 << 4 << 5 << OP_BIGMULMOD << -2 << OP_EQUAL);
+}
+
+// ── Identity laws ──────────────────────────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_identity) {
+    for (int64_t v : {0LL, 1LL, -1LL, 42LL, -42LL, 100000LL, -100000LL}) {
+        CheckSuccess(CScript() << v << 0 << OP_BIGADD << v << OP_EQUAL);
+        CheckSuccess(CScript() << v << 0 << OP_BIGSUB << v << OP_EQUAL);
+        CheckSuccess(CScript() << v << 1 << OP_BIGMUL << v << OP_EQUAL);
+        CheckSuccess(CScript() << v << 0 << OP_BIGMUL << 0 << OP_EQUAL);
+    }
+}
+
+// ── Commutativity ──────────────────────────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_commutative) {
+    for (auto [a, b] :
+         std::vector<std::pair<int64_t, int64_t>>{
+             {3, 7}, {-5, 11}, {100, 200}, {-99, -7}}) {
+        // a+b == b+a
+        CheckSuccess(CScript() << a << b << OP_BIGADD
+                               << b << a << OP_BIGADD << OP_EQUAL);
+        // a*b == b*a
+        CheckSuccess(CScript() << a << b << OP_BIGMUL
+                               << b << a << OP_BIGMUL << OP_EQUAL);
+    }
+}
+
+// ── 256-bit boundary ───────────────────────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_max_operand_accepted) {
+    // 2^255 - 1 (32 bytes) should be accepted as an operand.
+    const valtype max255 = Make255BitMax();
+    // BIGADD(max255, 0) == max255
+    CScript s;
+    s << max255 << 0 << OP_BIGADD << max255 << OP_EQUAL;
+    CheckSuccess(s);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_operand_too_large) {
+    // 33-byte value exceeds the 32-byte limit and must be rejected.
+    const valtype tooBig = Make256BitValue();
+    CScript s;
+    s << tooBig << 1 << OP_BIGADD << OP_1;
+    CheckError(s, ScriptError::BIGINT_OPERAND_TOO_LARGE);
+}
+
+BOOST_AUTO_TEST_CASE(bigint_mul_overflow) {
+    // max255 * 2 overflows 32 bytes.
+    const valtype max255 = Make255BitMax();
+    CScript s;
+    s << max255 << 2 << OP_BIGMUL << OP_1;
+    CheckError(s, ScriptError::BIGINT_OVERFLOW);
+}
+
+// ── Division by zero ───────────────────────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_div_by_zero) {
+    CheckError(CScript() << 10 << 0 << OP_BIGDIVMOD << OP_1,
+               ScriptError::BIGINT_DIV_BY_ZERO);
+    CheckError(CScript() << 10 << 0 << OP_BIGMOD << OP_1,
+               ScriptError::BIGINT_DIV_BY_ZERO);
+    CheckError(CScript() << 3 << 4 << 0 << OP_BIGMULMOD << OP_1,
+               ScriptError::BIGINT_DIV_BY_ZERO);
+}
+
+// ── Stack underflow ────────────────────────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_stack_underflow) {
+    // BIGADD needs 2 args.
+    CheckError(CScript() << OP_BIGADD << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+    CheckError(CScript() << 1 << OP_BIGADD << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+    // BIGMULMOD needs 3 args.
+    CheckError(CScript() << 1 << 2 << OP_BIGMULMOD << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+}
+
+// ── BIGDIVMOD invariant: q*b + r == a ─────────────────────────────────────
+
+BOOST_AUTO_TEST_CASE(bigint_divmod_invariant) {
+    // Check that quotient * divisor + remainder == dividend for several pairs.
+    // We do this entirely in script: push a, push b, OP_BIGDIVMOD,
+    // then verify (q*b + r) == a.
+    // Stack after BIGDIVMOD: ... quotient remainder
+    // We need OP_DUP/OP_SWAP to reuse values.
+    for (auto [a, b] : std::vector<std::pair<int64_t, int64_t>>{
+             {17, 5}, {-17, 5}, {17, -5}, {-17, -5},
+             {0, 7}, {100, 1}, {100, 100}}) {
+        // Script: a b BIGDIVMOD  →  q r
+        // Then: r  SWAP  q  b  BIGMUL  BIGADD  a  EQUAL
+        CheckSuccess(CScript() << a << b << OP_BIGDIVMOD
+                               << OP_SWAP       // q r → r q
+                               << b << OP_BIGMUL // r (q*b)
+                               << OP_BIGADD     // r + q*b
+                               << a << OP_EQUAL);
+    }
+}
+
+BOOST_AUTO_TEST_SUITE_END()
