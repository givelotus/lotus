+// Copyright (c) 2021 Logos Foundation
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <script/bigint.h>
+
+#include <algorithm>
+#include <cassert>
+#include <cstring>
+
+// ── Encoding ─────────────────────────────────────────────────────────────────
+
+bool ScriptBigInt::fromScript(const std::vector<uint8_t> &v,
+                               ScriptBigInt &out) {
+    if (v.size() > MAX_BYTES) {
+        return false;
+    }
+    out = ScriptBigInt{};
+    if (v.empty()) {
+        return true; // zero
+    }
+
+    // Sign is the high bit of the last byte.
+    out.m_negative = (v.back() & 0x80) != 0;
+
+    // Copy bytes into a temp buffer with the sign bit cleared.
+    uint8_t bytes[MAX_BYTES] = {};
+    std::copy(v.begin(), v.end(), bytes);
+    bytes[v.size() - 1] &= 0x7f;
+
+    // Pack bytes (little-endian) into 32-bit limbs.
+    const int nbytes = (int)v.size();
+    for (int i = 0; i < nbytes; i++) {
+        out.m_limbs[i / 4] |= (uint32_t)bytes[i] << (8 * (i % 4));
+    }
+    return true;
+}
+
+std::vector<uint8_t> ScriptBigInt::toScript() const {
+    if (isZero()) {
+        return {};
+    }
+
+    // Serialize limbs to bytes (little-endian).
+    uint8_t bytes[MAX_BYTES * 2] = {}; // extra room for sign byte
+    int nl = numLimbs();
+    for (int i = 0; i < nl; i++) {
+        bytes[4 * i + 0] = (m_limbs[i] >>  0) & 0xff;
+        bytes[4 * i + 1] = (m_limbs[i] >>  8) & 0xff;
+        bytes[4 * i + 2] = (m_limbs[i] >> 16) & 0xff;
+        bytes[4 * i + 3] = (m_limbs[i] >> 24) & 0xff;
+    }
+    int nbytes = nl * 4;
+    // Strip trailing zero bytes.
+    while (nbytes > 1 && bytes[nbytes - 1] == 0) {
+        nbytes--;
+    }
+
+    // Encode sign: if the last byte's high bit is already set, append a
+    // separate sign byte (0x00 for positive, 0x80 for negative).
+    // Otherwise fold the sign into the last byte's high bit.
+    if (bytes[nbytes - 1] & 0x80) {
+        bytes[nbytes] = m_negative ? 0x80 : 0x00;
+        nbytes++;
+    } else if (m_negative) {
+        bytes[nbytes - 1] |= 0x80;
+    }
+
+    return std::vector<uint8_t>(bytes, bytes + nbytes);
+}
+
+bool ScriptBigInt::isZero() const {
+    for (int i = 0; i < MAX_LIMBS; i++) {
+        if (m_limbs[i]) return false;
+    }
+    return true;
+}
+
+// ── Internal helpers ──────────────────────────────────────────────────────────
+
+int ScriptBigInt::numLimbs() const {
+    for (int i = MAX_LIMBS - 1; i >= 0; i--) {
+        if (m_limbs[i]) return i + 1;
+    }
+    return 0;
+}
+
+int ScriptBigInt::cmpMag(const ScriptBigInt &a, const ScriptBigInt &b) {
+    // Compare from most-significant limb downward.
+    for (int i = MAX_LIMBS - 1; i >= 0; i--) {
+        if (a.m_limbs[i] > b.m_limbs[i]) return  1;
+        if (a.m_limbs[i] < b.m_limbs[i]) return -1;
+    }
+    return 0;
+}
+
+// out = a + b (unsigned). Returns significant limb count.
+int ScriptBigInt::addMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                          uint32_t *out) {
+    int n = std::max(na, nb);
+    uint64_t carry = 0;
+    for (int i = 0; i < n || carry; i++) {
+        uint64_t ai = (i < na) ? a[i] : 0;
+        uint64_t bi = (i < nb) ? b[i] : 0;
+        uint64_t sum = ai + bi + carry;
+        out[i] = (uint32_t)sum;
+        carry = sum >> 32;
+    }
+    int nout = n + (carry ? 1 : 0);
+    // If we wrote an extra carry limb, it was already written above.
+    // Find actual significant count.
+    while (nout > 0 && out[nout - 1] == 0) nout--;
+    return nout;
+}
+
+// out = a - b (unsigned, a >= b). Returns significant limb count.
+int ScriptBigInt::subMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                          uint32_t *out) {
+    int64_t borrow = 0;
+    for (int i = 0; i < na; i++) {
+        int64_t bi = (i < nb) ? (int64_t)b[i] : 0;
+        int64_t diff = (int64_t)a[i] - bi - borrow;
+        if (diff < 0) {
+            out[i] = (uint32_t)(diff + ((int64_t)1 << 32));
+            borrow = 1;
+        } else {
+            out[i] = (uint32_t)diff;
+            borrow = 0;
+        }
+    }
+    assert(borrow == 0); // caller ensures a >= b
+    int nout = na;
+    while (nout > 0 && out[nout - 1] == 0) nout--;
+    return nout;
+}
+
+// out = a * b (unsigned). out must have na+nb elements. Returns significant limbs.
+int ScriptBigInt::mulMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                          uint32_t *out) {
+    std::memset(out, 0, (na + nb) * sizeof(uint32_t));
+    for (int i = 0; i < na; i++) {
+        uint64_t carry = 0;
+        for (int j = 0; j < nb; j++) {
+            uint64_t prod = (uint64_t)a[i] * b[j] + out[i + j] + carry;
+            out[i + j] = (uint32_t)prod;
+            carry = prod >> 32;
+        }
+        out[i + nb] += (uint32_t)carry;
+    }
+    int nout = na + nb;
+    while (nout > 0 && out[nout - 1] == 0) nout--;
+    return nout;
+}
+
+// Bit length of a[0..n-1].
+int ScriptBigInt::bitLen(const uint32_t *a, int n) {
+    if (n == 0) return 0;
+    // Find highest set bit in most-significant limb.
+    uint32_t msw = a[n - 1];
+    int bits = (n - 1) * 32;
+    while (msw) { bits++; msw >>= 1; }
+    return bits;
+}
+
+// out = a[0..n-1] << shift. Returns significant limbs.
+// out must have room for n + shift/32 + 1 elements.
+int ScriptBigInt::shlMag(const uint32_t *a, int n, int shift, uint32_t *out) {
+    int wordShift = shift / 32;
+    int bitShift  = shift % 32;
+    int outSize = n + wordShift + 1;
+    std::memset(out, 0, outSize * sizeof(uint32_t));
+    for (int i = 0; i < n; i++) {
+        out[i + wordShift] |= a[i] << bitShift;
+        if (bitShift && (i + wordShift + 1 < outSize)) {
+            out[i + wordShift + 1] |= a[i] >> (32 - bitShift);
+        }
+    }
+    while (outSize > 0 && out[outSize - 1] == 0) outSize--;
+    return outSize;
+}
+
+// a[0..n-1] >>= shift in place. Returns significant limbs.
+int ScriptBigInt::shrMag(uint32_t *a, int n, int shift) {
+    int wordShift = shift / 32;
+    int bitShift  = shift % 32;
+    for (int i = 0; i < n; i++) {
+        int src = i + wordShift;
+        uint32_t lo = (src < n) ? a[src] : 0;
+        uint32_t hi = (src + 1 < n) ? a[src + 1] : 0;
+        if (bitShift) {
+            a[i] = (lo >> bitShift) | (hi << (32 - bitShift));
+        } else {
+            a[i] = lo;
+        }
+    }
+    int nout = n;
+    while (nout > 0 && a[nout - 1] == 0) nout--;
+    return nout;
+}
+
+// Binary long division: a / b → quotient q, remainder r.
+// Works for any na, nb up to 2*MAX_LIMBS (handles 512-bit intermediates).
+// Precondition: b is nonzero.
+void ScriptBigInt::divModMag(const uint32_t *a, int na, const uint32_t *b,
+                              int nb, uint32_t *q, int *nq, uint32_t *r,
+                              int *nr) {
+    // Initialize quotient and remainder.
+    std::memset(q, 0, (na + 1) * sizeof(uint32_t));
+    uint32_t rem[2 * MAX_LIMBS * 2 + 4] = {};
+    std::memcpy(rem, a, na * sizeof(uint32_t));
+    int nrem = na;
+    while (nrem > 0 && rem[nrem - 1] == 0) nrem--;
+
+    int blen = bitLen(b, nb);
+    int alen = bitLen(rem, nrem);
+    int shift = alen - blen;
+
+    if (shift < 0) {
+        // a < b: quotient = 0, remainder = a.
+        std::memset(q, 0, na * sizeof(uint32_t));
+        *nq = 0;
+        std::memcpy(r, a, na * sizeof(uint32_t));
+        *nr = na;
+        while (*nr > 0 && r[*nr - 1] == 0) (*nr)--;
+        return;
+    }
+
+    // Shifted divisor workspace — needs up to na+1 limbs.
+    uint32_t shifted[2 * MAX_LIMBS * 2 + 4] = {};
+
+    for (int s = shift; s >= 0; s--) {
+        // Compute shifted_b = b << s
+        int ns = shlMag(b, nb, s, shifted);
+
+        // Compare rem with shifted_b.
+        // Pad to same length for comparison.
+        int maxLen = std::max(nrem, ns);
+        int cmp = 0;
+        for (int i = maxLen - 1; i >= 0; i--) {
+            uint32_t ri = (i < nrem) ? rem[i] : 0;
+            uint32_t si = (i < ns) ? shifted[i] : 0;
+            if (ri > si) { cmp =  1; break; }
+            if (ri < si) { cmp = -1; break; }
+        }
+
+        if (cmp >= 0) {
+            // rem -= shifted_b
+            uint32_t newrem[2 * MAX_LIMBS * 2 + 4] = {};
+            int newnrem = subMag(rem, maxLen, shifted, ns, newrem);
+            std::memcpy(rem, newrem, maxLen * sizeof(uint32_t));
+            nrem = newnrem;
+
+            // Set bit s in quotient.
+            q[s / 32] |= (uint32_t)1 << (s % 32);
+        }
+    }
+
+    // Count significant quotient limbs.
+    *nq = (shift / 32) + 1;
+    while (*nq > 0 && q[*nq - 1] == 0) (*nq)--;
+
+    // Copy remainder.
+    std::memcpy(r, rem, nrem * sizeof(uint32_t));
+    *nr = nrem;
+}
+
+// ── Signed arithmetic ─────────────────────────────────────────────────────────
+
+bool ScriptBigInt::bigAdd(const ScriptBigInt &a, const ScriptBigInt &b,
+                           ScriptBigInt &result) {
+    result = ScriptBigInt{};
+    int na = a.numLimbs();
+    int nb = b.numLimbs();
+
+    if (a.m_negative == b.m_negative) {
+        // Same sign: add magnitudes.
+        uint32_t out[MAX_LIMBS + 1] = {};
+        int nout = addMag(a.m_limbs, na, b.m_limbs, nb, out);
+        // Overflow if magnitude exceeds 255 bits (bit 255 set → needs 33-byte encoding).
+        if (nout > MAX_LIMBS ||
+            (nout == MAX_LIMBS && (out[MAX_LIMBS - 1] & 0x80000000u))) {
+            return false;
+        }
+        std::memcpy(result.m_limbs, out, nout * sizeof(uint32_t));
+        result.m_negative = a.m_negative;
+    } else {
+        // Different signs: subtract smaller from larger.
+        int cmp = cmpMag(a, b);
+        if (cmp == 0) return true; // result is zero
+        uint32_t out[MAX_LIMBS] = {};
+        int nout;
+        if (cmp > 0) {
+            nout = subMag(a.m_limbs, na, b.m_limbs, nb, out);
+            result.m_negative = a.m_negative;
+        } else {
+            nout = subMag(b.m_limbs, nb, a.m_limbs, na, out);
+            result.m_negative = b.m_negative;
+        }
+        (void)nout;
+        std::memcpy(result.m_limbs, out, MAX_LIMBS * sizeof(uint32_t));
+    }
+    return true;
+}
+
+bool ScriptBigInt::bigSub(const ScriptBigInt &a, const ScriptBigInt &b,
+                           ScriptBigInt &result) {
+    // a - b == a + (-b)
+    ScriptBigInt neg_b = b;
+    if (!neg_b.isZero()) neg_b.m_negative = !b.m_negative;
+    return bigAdd(a, neg_b, result);
+}
+
+bool ScriptBigInt::bigMul(const ScriptBigInt &a, const ScriptBigInt &b,
+                           ScriptBigInt &result) {
+    result = ScriptBigInt{};
+    if (a.isZero() || b.isZero()) return true;
+
+    int na = a.numLimbs();
+    int nb = b.numLimbs();
+    uint32_t out[2 * MAX_LIMBS] = {};
+    int nout = mulMag(a.m_limbs, na, b.m_limbs, nb, out);
+
+    // Overflow if magnitude exceeds 255 bits (bit 255 set → needs 33-byte encoding).
+    if (nout > MAX_LIMBS ||
+        (nout == MAX_LIMBS && (out[MAX_LIMBS - 1] & 0x80000000u))) {
+        return false;
+    }
+
+    std::memcpy(result.m_limbs, out, nout * sizeof(uint32_t));
+    result.m_negative = a.m_negative != b.m_negative;
+    return true;
+}
+
+bool ScriptBigInt::bigDivMod(const ScriptBigInt &a, const ScriptBigInt &b,
+                              ScriptBigInt &quotient, ScriptBigInt &remainder) {
+    quotient = remainder = ScriptBigInt{};
+    if (b.isZero()) return false; // division by zero
+
+    if (a.isZero()) return true;  // 0 / b = 0 rem 0
+
+    int na = a.numLimbs();
+    int nb = b.numLimbs();
+
+    uint32_t q[MAX_LIMBS + 1] = {};
+    uint32_t r[MAX_LIMBS]     = {};
+    int nq, nr;
+    divModMag(a.m_limbs, na, b.m_limbs, nb, q, &nq, r, &nr);
+
+    std::memcpy(quotient.m_limbs,  q, std::min(nq, MAX_LIMBS) * sizeof(uint32_t));
+    std::memcpy(remainder.m_limbs, r, std::min(nr, MAX_LIMBS) * sizeof(uint32_t));
+
+    // Quotient sign: same as a*b would be (i.e., a.sign XOR b.sign).
+    quotient.m_negative  = !quotient.isZero()  && (a.m_negative != b.m_negative);
+    // Remainder sign matches dividend (Euclidean / truncating division).
+    remainder.m_negative = !remainder.isZero() && a.m_negative;
+    return true;
+}
+
+bool ScriptBigInt::bigMulMod(const ScriptBigInt &a, const ScriptBigInt &b,
+                              const ScriptBigInt &n, ScriptBigInt &result) {
+    result = ScriptBigInt{};
+    if (n.isZero()) return false; // modulo by zero
+
+    if (a.isZero() || b.isZero()) return true;
+
+    int na = a.numLimbs();
+    int nb = b.numLimbs();
+
+    // Full product: up to 2*MAX_LIMBS = 16 limbs (512 bits).
+    uint32_t prod[2 * MAX_LIMBS] = {};
+    int nprod = mulMag(a.m_limbs, na, b.m_limbs, nb, prod);
+
+    // Reduce: prod mod |n|.
+    int nn = n.numLimbs();
+    uint32_t q[2 * MAX_LIMBS + 1] = {};
+    uint32_t r[MAX_LIMBS] = {};
+    int nq, nr;
+    divModMag(prod, nprod, n.m_limbs, nn, q, &nq, r, &nr);
+
+    std::memcpy(result.m_limbs, r, std::min(nr, MAX_LIMBS) * sizeof(uint32_t));
+    // Result sign matches a*b (same as a.sign XOR b.sign).
+    result.m_negative = !result.isZero() && (a.m_negative != b.m_negative);
+    return true;
+}
