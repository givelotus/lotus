new file mode 100644
index 000000000..0de856057
--- /dev/null
+++ b/src/script/bigint.h
@@ -0,0 +1,123 @@
+// Copyright (c) 2021 Logos Foundation
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_SCRIPT_BIGINT_H
+#define BITCOIN_SCRIPT_BIGINT_H
+
+#include <cstdint>
+#include <vector>
+
+/**
+ * Bounded arbitrary-precision signed integer for script BIGINT opcodes.
+ *
+ * Supports integers with magnitude up to MAX_BYTES bytes (256 bits).
+ *
+ * Encoding matches CScriptNum / the Bitcoin script integer format:
+ *   - Little-endian bytes
+ *   - The high bit of the last byte is the sign bit (1 = negative)
+ *   - Zero is represented as the empty byte vector
+ *   - Negative zero is not a valid encoding
+ *
+ * Internally, the unsigned magnitude is stored as little-endian 32-bit limbs
+ * to keep schoolbook multiplication simple (32×32→64 via uint64_t).
+ *
+ * All arithmetic returns true on success. Returns false on:
+ *   - Input operand exceeding MAX_BYTES
+ *   - Result magnitude exceeding MAX_BYTES (overflow)
+ *   - Division or modulo by zero
+ */
+class ScriptBigInt {
+public:
+    /// Maximum operand/result size in bytes (256 bits).
+    static constexpr size_t MAX_BYTES = 32;
+
+    /// Number of 32-bit limbs for a MAX_BYTES value.
+    static constexpr int MAX_LIMBS = 8;
+
+    ScriptBigInt() = default;
+
+    // ── Construction ────────────────────────────────────────────────────────
+
+    /// Parse from script byte encoding.
+    /// Returns false if v.size() > MAX_BYTES.
+    static bool fromScript(const std::vector<uint8_t> &v, ScriptBigInt &out);
+
+    /// Encode to minimal script byte format.
+    std::vector<uint8_t> toScript() const;
+
+    bool isZero() const;
+    bool isNegative() const { return m_negative && !isZero(); }
+
+    // ── Arithmetic ──────────────────────────────────────────────────────────
+    //
+    // Each function returns true on success, false on error.
+    //
+    // Error conditions:
+    //   bigAdd / bigSub / bigMul: result magnitude > MAX_BYTES
+    //   bigDivMod / bigMulMod:    divisor/modulus is zero
+
+    static bool bigAdd(const ScriptBigInt &a, const ScriptBigInt &b,
+                       ScriptBigInt &result);
+
+    static bool bigSub(const ScriptBigInt &a, const ScriptBigInt &b,
+                       ScriptBigInt &result);
+
+    /// Fails if |a * b| exceeds MAX_BYTES. Use bigMulMod for large products.
+    static bool bigMul(const ScriptBigInt &a, const ScriptBigInt &b,
+                       ScriptBigInt &result);
+
+    /// Euclidean division: a = q*b + r, sign(r) == sign(a), |r| < |b|.
+    /// Fails if b == 0.
+    static bool bigDivMod(const ScriptBigInt &a, const ScriptBigInt &b,
+                          ScriptBigInt &quotient, ScriptBigInt &remainder);
+
+    /// Computes (a * b) mod n  (result has same sign as a*b, |result| < |n|).
+    /// Fails if n == 0.
+    static bool bigMulMod(const ScriptBigInt &a, const ScriptBigInt &b,
+                          const ScriptBigInt &n, ScriptBigInt &result);
+
+private:
+    // ── Internal representation ─────────────────────────────────────────────
+    // Unsigned magnitude in little-endian 32-bit limbs; m_limbs[0] is LSW.
+    uint32_t m_limbs[MAX_LIMBS] = {};
+    bool m_negative = false;
+
+    // ── Low-level unsigned magnitude helpers ────────────────────────────────
+
+    int numLimbs() const;
+
+    /// -1 / 0 / +1 comparison of unsigned magnitudes.
+    static int cmpMag(const ScriptBigInt &a, const ScriptBigInt &b);
+
+    /// out = |a| + |b|. Returns number of significant output limbs.
+    static int addMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                      uint32_t *out);
+
+    /// out = |a| - |b|, requires |a| >= |b|. Returns significant limbs.
+    static int subMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                      uint32_t *out);
+
+    /// out = |a| * |b|. out must have room for na+nb limbs.
+    static int mulMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                      uint32_t *out);
+
+    /// Divide a[0..na-1] by b[0..nb-1]. Stores quotient in q, remainder in r.
+    /// Precondition: b is nonzero.
+    static void divModMag(const uint32_t *a, int na, const uint32_t *b, int nb,
+                          uint32_t *q, int *nq, uint32_t *r, int *nr);
+
+    // ── Bit manipulation helpers ─────────────────────────────────────────────
+
+    /// Number of significant bits in a[0..n-1].
+    static int bitLen(const uint32_t *a, int n);
+
+    /// out = a[0..n-1] << shift (shift in bits). Returns significant limbs.
+    /// out must have room for n + (shift/32 + 1) limbs.
+    static int shlMag(const uint32_t *a, int n, int shift, uint32_t *out);
+
+    /// a[0..n-1] >>= shift  (in place). Returns significant limbs.
+    static int shrMag(uint32_t *a, int n, int shift);
+};
+
+#endif // BITCOIN_SCRIPT_BIGINT_H
