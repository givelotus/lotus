@@ -0,0 +1,51 @@
+use super::*;
+#[test]
+fn coherent_nonblocking_stamps_and_terminal_overflow() {
+    let authority = Arc::new(Authority::default());
+    assert_eq!(
+        authority.observe(),
+        AuthoritativeState {
+            generation: 0,
+            anchor: None
+        }
+    );
+    let writer = Arc::clone(&authority);
+    let thread = std::thread::spawn(move || {
+        for n in 1..10000u64 {
+            writer
+                .publish(Some(Anchor {
+                    block_id: [(n % 256) as u8; 32],
+                    height: n,
+                }))
+                .unwrap();
+        }
+    });
+    for _ in 0..20000 {
+        let state = authority.observe();
+        if let Some(anchor) = state.anchor {
+            assert_eq!(state.generation % 2, 0);
+            assert_eq!(anchor.block_id, [(anchor.height % 256) as u8; 32]);
+        }
+    }
+    thread.join().unwrap();
+    let guard = authority.writer.lock().unwrap();
+    // The HTTP observation does not block on the publication writer lock.
+    assert!(authority.observe().anchor.is_some());
+    drop(guard);
+    authority.sequence.store(u64::MAX - 1, Ordering::SeqCst);
+    assert!(authority
+        .publish(Some(Anchor {
+            block_id: [8; 32],
+            height: 8
+        }))
+        .is_err());
+    assert_eq!(
+        authority.observe(),
+        AuthoritativeState {
+            generation: u64::MAX,
+            anchor: None
+        }
+    );
+    assert!(authority.publish(None).is_err());
+    assert!(authority.observe().anchor.is_none());
+}
