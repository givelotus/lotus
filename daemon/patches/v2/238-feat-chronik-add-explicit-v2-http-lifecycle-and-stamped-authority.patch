+fn http(address:&str,method:&str,path:&str,body:&str)->String {
+    use std::io::{Read,Write};
+    let mut socket=std::net::TcpStream::connect(address).unwrap();
+    socket.set_read_timeout(Some(std::time::Duration::from_secs(3))).unwrap();
+    socket.set_write_timeout(Some(std::time::Duration::from_secs(3))).unwrap();
+    write!(socket,"{method} {path} HTTP/1.1\r\nHost: {address}\r\nConnection: close\r\nContent-Type: application/json\r\nContent-Length: {}\r\n\r\n{body}",body.len()).unwrap();
+    let mut response=String::new();socket.read_to_string(&mut response).unwrap();response
+}
+#[test]
+fn explicit_loopback_server_lifecycle_authority_and_reorg() {
+    let path=Temp::new();
+    let service=open_service(path.path(),binding(),true,limits()).unwrap();
+    assert!(start_v2_server(&service,"localhost:0").is_err());
+    assert!(start_v2_server(&service,"").is_err());
+    let server=start_v2_server(&service,"127.0.0.1:0").unwrap();
+    let address=server.actual_address();
+    assert_ne!(address.parse::<std::net::SocketAddr>().unwrap().port(),0);
+    let body=format!("{{\"any_branch\":[\"{}\"]}}","09".repeat(32));
+    assert!(http(&address,"GET","/v2/status","").starts_with("HTTP/1.1 503"));
+    service.initialize_genesis(block(2,0,2,10,vec![])).unwrap();
+    assert!(http(&address,"POST","/v2/branches/utxos",&body).starts_with("HTTP/1.1 503"));
+    let first=service.publish_authority(tip(2,0)).unwrap();
+    assert!(http(&address,"GET","/v2/status","").contains("\"ready\":true"));
+    let query=http(&address,"POST","/v2/branches/utxos",&body);
+    assert!(query.starts_with("HTTP/1.1 200"));assert!(query.contains(&"0a".repeat(32)));
+    let unknown=service.invalidate_authority().unwrap();assert!(unknown>first);
+    assert!(http(&address,"POST","/v2/branches/utxos",&body).starts_with("HTTP/1.1 503"));
+    let ahead=service.publish_authority(tip(4,1)).unwrap();assert!(ahead>unknown);
+    assert!(http(&address,"POST","/v2/branches/utxos",&body).starts_with("HTTP/1.1 503"));
+    service.connect_block(block(4,1,2,12,vec![])).unwrap();
+    // DB success does not publish authoritative freshness by itself.
+    assert!(http(&address,"POST","/v2/branches/utxos",&body).starts_with("HTTP/1.1 503"));
+    let connected=service.publish_authority(tip(4,1)).unwrap();assert!(connected>ahead);
+    assert!(http(&address,"POST","/v2/branches/utxos",&body).starts_with("HTTP/1.1 200"));
+    service.invalidate_authority().unwrap();service.disconnect_block(tip(4,1)).unwrap();
+    let aba=service.publish_authority(tip(2,0)).unwrap();assert!(aba>connected);
+    assert!(http(&address,"POST","/v2/branches/utxos",&body).starts_with("HTTP/1.1 200"));
+    service.connect_block(block(5,1,2,14,vec![])).unwrap();service.publish_authority(tip(5,1)).unwrap();
+    assert!(http(&address,"GET","/v2/status","").contains("\"ready\":true"));
+    server.stop().unwrap();server.stop().unwrap();
+    assert!(std::net::TcpStream::connect(&address).is_err());
+    let server=start_v2_server(&service,"127.0.0.1:0").unwrap();
+    let address=server.actual_address();drop(server);
+    assert!(std::net::TcpStream::connect(&address).is_err());
+}
