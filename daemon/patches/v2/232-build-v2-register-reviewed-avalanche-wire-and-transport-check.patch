From 1cbc312699fa97fc513224d93cef07acf7217551 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:48:30 -0700
Subject: [PATCH] build(v2): register reviewed Avalanche wire and transport
 check

---
 src/lotus_v2/CMakeLists.txt | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index af9c8596c092e1df9dec942c4eb7cb4d76913c2c..e9252842efd14169464918b834cfd6e310abc915 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -325,10 +325,10 @@ add_custom_target(check-lotus-v2-transactions
 # adapters do not enable polling or select a development quorum by themselves.
 add_library(lotus_v2_avalanche STATIC
     avalanche_proof.cpp avalanche_protocol.cpp avalanche_quorum.cpp
-    avalanche_poll.cpp avalanche_chain.cpp avalanche_peer_store.cpp)
+    avalanche_poll.cpp avalanche_chain.cpp avalanche_peer_store.cpp avalanche_peer.cpp)
 target_include_directories(lotus_v2_avalanche PUBLIC
     .. "${CMAKE_CURRENT_BINARY_DIR}/..")
-target_link_libraries(lotus_v2_avalanche PUBLIC lotus_v2_validation)
+target_link_libraries(lotus_v2_avalanche PUBLIC lotus_v2_validation lotus_v2_peer_dispatcher)
 add_executable(test_lotus_v2_avalanche test_avalanche_v2.cpp)
 target_link_libraries(test_lotus_v2_avalanche PRIVATE lotus_v2_avalanche
     server common bitcoinconsensus script util crypto univalue secp256k1)
@@ -344,3 +344,10 @@ add_custom_target(check-lotus-v2-avalanche
     COMMAND $<TARGET_FILE:test_lotus_v2_avalanche_peer_store>
     DEPENDS test_lotus_v2_avalanche test_lotus_v2_avalanche_runtime
         test_lotus_v2_avalanche_peer_store)
+
+add_executable(test_lotus_v2_avalanche_peer test_avalanche_peer.cpp)
+target_link_libraries(test_lotus_v2_avalanche_peer PRIVATE lotus_v2_avalanche
+    server common bitcoinconsensus script util crypto univalue secp256k1)
+add_custom_target(check-lotus-v2-avalanche-peer
+    COMMAND $<TARGET_FILE:test_lotus_v2_avalanche_peer>
+    DEPENDS test_lotus_v2_avalanche_peer)
-- 
