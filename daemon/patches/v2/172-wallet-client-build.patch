From c605e6e9f12d9fa80a50103d40973531dcdceb95 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 13:39:08 -0700
Subject: [PATCH] build(v2): register private-FD SQLite wallet client

Link the explicit-manifest wallet client to the reviewed provider and existing wallet library on Linux and macOS. The executable opens only its own SQLite wallet and uses an inherited local stream for node queries; building it does not launch a node or public endpoint.
---
 src/wallet/CMakeLists.txt | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/wallet/CMakeLists.txt b/src/wallet/CMakeLists.txt
index fae91cc63d88d9e300eae6ef17b98186ed5baae0..26a1fe5787dd6eac0aa1002a73df3e0926873668 100644
--- a/src/wallet/CMakeLists.txt
+++ b/src/wallet/CMakeLists.txt
@@ -70,3 +70,10 @@ target_link_libraries(test_lotus_v2_provider PRIVATE wallet common util univalue
 add_custom_target(check-lotus-v2-provider
     COMMAND $<TARGET_FILE:test_lotus_v2_provider>
     DEPENDS test_lotus_v2_provider)
+
+# Explicit local controller client; private POSIX FDs, no public RPC endpoint.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    add_executable(lotus-v2-wallet-client
+        v2_wallet_client.cpp ../lotus_v2/development_command.cpp)
+    target_link_libraries(lotus-v2-wallet-client PRIVATE wallet common util univalue)
+endif()
-- 
