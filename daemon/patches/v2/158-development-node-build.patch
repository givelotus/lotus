From f0a315ad9615e793961822a9f5009fc5cbb2a09d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 13:05:31 -0700
Subject: [PATCH] build(v2): wire explicit POSIX development node entry

Dispatch only the explicit -lotusv2node mode before inherited network initialization. Build its command and transport/runtime dependencies on Linux and macOS; preserve the default daemon entry and all mainnet parsing and chain parameters.
---
 src/CMakeLists.txt | 5 +++++
 src/bitcoind.cpp   | 8 ++++++++
 2 files changed, 13 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 6fe625949b91eab443a7cccf59c6e3dd23d5f769..3e8f47f0a92bf7816aeea5c3d0ec4ea0e537ac51 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -990,6 +990,11 @@ endif()
 # lotusd
 add_executable(lotusd bitcoind.cpp lotus_v2/development_command.cpp)
 target_link_libraries(lotusd server lotus_v2_validation)
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    target_sources(lotusd PRIVATE lotus_v2/development_node_command.cpp)
+    target_compile_definitions(lotusd PRIVATE LOTUS_V2_POSIX_NODE=1)
+    target_link_libraries(lotusd lotus_v2_peer_dispatcher lotus_v2_peer_tcp)
+endif()
 generate_windows_version_info(lotusd
 	DESCRIPTION "Lotus node with a JSON-RPC server"
 )
diff --git a/src/bitcoind.cpp b/src/bitcoind.cpp
index 9ccd911f1062fb4e796ec72089a037327025f639..e2dbae90ebe09d418b1cb1874c98e0594080038f 100644
--- a/src/bitcoind.cpp
+++ b/src/bitcoind.cpp
@@ -8,6 +8,9 @@
 #endif
 
 #include <lotus_v2/development_command.h>
+#ifdef LOTUS_V2_POSIX_NODE
+#include <lotus_v2/development_node_command.h>
+#endif
 #include <chainparams.h>
 #include <clientversion.h>
 #include <common/args.h>
@@ -317,6 +320,11 @@ int main(int argc, char *argv[]) {
     if (argc > 1 && std::string(argv[1]) == "-lotusv2development")
         return lotus::v2::RunDevelopmentCommand(argc, argv);
 
+#ifdef LOTUS_V2_POSIX_NODE
+    if (argc > 1 && std::string(argv[1]) == "-lotusv2node")
+        return lotus::v2::RunDevelopmentNodeCommand(argc, argv);
+#endif
+
     // Connect lotusd signal handlers
     noui_connect();
 
-- 
