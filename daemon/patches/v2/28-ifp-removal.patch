From 195156102888a46d2e860e01581b44c51aee2f59 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 23 Feb 2026 04:29:39 -0800
Subject: [PATCH] Disable IFP and remove coinbase address table

Set enableMinerFund=false on all networks. Remove the coinbasePayoutAddresses
assignment and the ENABLE_MINER_FUND compile-time flag.

The minerfund mechanism (GetMinerFundRequiredOutputs, CoinbaseAddresses struct,
-enableminerfund CLI option) is preserved intact so miners can opt into
paying a development fund in the future if there is consensus to do so.
Currently no addresses are configured and the feature is off by default.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 src/chainparams.cpp | 19 +++++--------------
 1 file changed, 5 insertions(+), 14 deletions(-)

diff --git a/src/chainparams.cpp b/src/chainparams.cpp
index 134e29456..89dbac46e 100644
--- a/src/chainparams.cpp
+++ b/src/chainparams.cpp
@@ -12,13 +12,10 @@
 #include <consensus/merkle.h>
 #include <hash.h>
 #include <currencyunit.h>
-#include <network.h>
 #include <tinyformat.h>
 #include <util/strencodings.h>
 #include <util/system.h>
 
-#include <consensus/addresses.h>
-
 #include <cassert>
 
 static bool UseECashPrefix() {
@@ -88,10 +85,8 @@ public:
         // nPowTargetTimespan / nPowTargetSpacing
         consensus.nMinerConfirmationWindow = 2016;
 
-        // The miner fund is enabled by default on mainnet.
-        consensus.enableMinerFund = ENABLE_MINER_FUND;
-        consensus.coinbasePayoutAddresses = RewardAddresses::AddressSets;
-        assert(consensus.coinbasePayoutAddresses.genesis.size() == 13);
+        // Miner fund disabled by default; no addresses configured.
+        consensus.enableMinerFund = false;
         // Mainnet rewards based on difficulty.
         consensus.enableDifficultyBasedSubsidy = true;
 
@@ -229,10 +224,8 @@ public:
         // nPowTargetTimespan / nPowTargetSpacing
         consensus.nMinerConfirmationWindow = 2016;
 
-        // The miner fund is enabled by default on testnet.
-        consensus.enableMinerFund = ENABLE_MINER_FUND;
-        consensus.coinbasePayoutAddresses = RewardAddresses::AddressSets;
-        assert(consensus.coinbasePayoutAddresses.genesis.size() == 13);
+        // Miner fund disabled by default; no addresses configured.
+        consensus.enableMinerFund = false;
 
         // Testnet rewards based on difficulty.
         consensus.enableDifficultyBasedSubsidy = true;
@@ -372,10 +365,8 @@ public:
         // Faster than normal for regtest (144 instead of 2016)
         consensus.nMinerConfirmationWindow = 144;
 
-        // The miner fund is disabled by default on regnet.
+        // Miner fund disabled; no addresses configured.
         consensus.enableMinerFund = false;
-        consensus.coinbasePayoutAddresses = RewardAddresses::AddressSets;
-        assert(consensus.coinbasePayoutAddresses.genesis.size() == 13);
         // Regtest rewards a constant amount independent of difficulty.
         consensus.enableDifficultyBasedSubsidy = false;
 
