From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:17:10 -0700
Subject: [PATCH] fix(v2): commit normalized explorer cursor filters explicitly

---
 chronik/chronik-http/src/v2_explorer.rs | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/chronik/chronik-http/src/v2_explorer.rs b/chronik/chronik-http/src/v2_explorer.rs
index d0fabd272b417cf4b20f6efc11b3e67fb84bbe13..c5fb2c5c1fee465cce20b53caa962d82e7bd4082 100644
--- a/chronik/chronik-http/src/v2_explorer.rs
+++ b/chronik/chronik-http/src/v2_explorer.rs
@@ -21,6 +21,7 @@ use chronik_indexer::query::v2_branches::{
 };
 use serde::{Deserialize, Serialize};
 use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
 use std::{
     collections::BTreeMap,
     io::{self, Write},
@@ -235,6 +236,7 @@ struct Cursor {
     token: String,
     route: String,
     params: BTreeMap<String, String>,
+    filter_digest: String,
     last: String,
 }
 fn cursor_encode(c: &Cursor) -> Result<String> {
@@ -261,8 +263,19 @@ fn cursor_decode(s: &str) -> Result<Cursor> {
     {
         return Err(err());
     }
+    if c.filter_digest != filter_digest(&c.route, &c.params)? {
+        return Err(err());
+    }
     Ok(c)
 }
+fn filter_digest(
+    route: &str,
+    params: &BTreeMap<String, String>,
+) -> Result<String> {
+    let bytes =
+        encode(&("LotusExplorerCursor/1", route, params), TOKEN_CAP / 2)?;
+    Ok(hex::encode(Sha256::digest(bytes)))
+}
 struct Request {
     route: String,
     params: BTreeMap<String, String>,
@@ -347,6 +360,7 @@ impl Request {
             token: context.token(),
             route: self.route.clone(),
             params: self.params.clone(),
+            filter_digest: filter_digest(&self.route, &self.params)?,
             last: hex::encode(key),
         })
     }
