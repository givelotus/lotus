From 16500e29ee4b02a09d4987de13322689be8b6a72 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 14:57:32 -0700
Subject: [PATCH] fix(v2): restore pinned ABC Avalanche block parking semantics

Maintenance explanation added during mailbox export:
Restore the pinned ABC handling of rejected and invalid Avalanche block votes, including parking, invalidation signals and protection of the finalized fork during chain selection. This preserves the upstream policy contract needed by the development candidate; it does not establish native V2 peer polling interoperability.

---
 src/net_processing.cpp | 35 ++++++++++++++++++++++++++++++-----
 src/validation.cpp     | 14 ++++++++++++++
 2 files changed, 44 insertions(+), 5 deletions(-)

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 6441bffa88bfe576147161290e5e51d335f5de8e..c8128815a1093433f0880ec8938d12388bc54064 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -7060,11 +7060,36 @@ void PeerManagerImpl::ProcessMessage(
                 logVoteUpdate(u, "block", pindex->GetBlockHash());
 
                 switch (u.getStatus()) {
-                    case avalanche::VoteStatus::Rejected:
-                    case avalanche::VoteStatus::Invalid:
-                        // PoW chain selection is authoritative in Lotus;
-                        // Avalanche block votes do not park valid PoW blocks.
-                        break;
+                    case avalanche::VoteStatus::Rejected: {
+                        BlockValidationState state;
+                        m_chainman.ActiveChainstate().ParkBlock(state, pindex);
+                        if (!state.IsValid()) {
+                            LogPrintf("ERROR: Database error: %s\n",
+                                      state.GetRejectReason());
+                            return;
+                        }
+                    } break;
+                    case avalanche::VoteStatus::Invalid: {
+                        BlockValidationState state;
+                        m_chainman.ActiveChainstate().ParkBlock(state, pindex);
+                        if (!state.IsValid()) {
+                            LogPrintf("ERROR: Database error: %s\n",
+                                      state.GetRejectReason());
+                            return;
+                        }
+
+                        auto pblock = getBlockFromIndex(pindex);
+                        if (!pblock) {
+                            LogError("avaresponse: failed to get invalidated "
+                                     "block from index\n");
+                            break;
+                        }
+                        if (m_chainman.m_options.signals) {
+                            LOCK(cs_main);
+                            m_chainman.m_options.signals->BlockInvalidated(
+                                pindex, pblock);
+                        }
+                    } break;
                     case avalanche::VoteStatus::Accepted: {
                         LOCK(cs_main);
                         m_chainman.ActiveChainstate().UnparkBlock(pindex);
diff --git a/src/validation.cpp b/src/validation.cpp
index 9523d1370b18ca77336de1fcb61711a955a24321..f357e26d7da2a516783fc25c3ec010e8fe392f71 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -3065,6 +3065,20 @@ CBlockIndex *Chainstate::FindMostWorkChain(
             pindexNew = *it;
         }
 
+        // If this block will cause an avalanche finalized block to be reorged,
+        // then we park it.
+        {
+            LOCK(cs_avalancheFinalizedBlockIndex);
+            if (m_avalancheFinalizedBlockIndex &&
+                !AreOnTheSameFork(pindexNew, m_avalancheFinalizedBlockIndex)) {
+                LogPrintf("Park block %s because it forks prior to the "
+                          "avalanche finalized chaintip.\n",
+                          pindexNew->GetBlockHash().ToString());
+                pindexNew->nStatus = pindexNew->nStatus.withParked();
+                m_blockman.m_dirty_blockindex.insert(pindexNew);
+            }
+        }
+
         const CBlockIndex *pindexFork = m_chain.FindFork(pindexNew);
 
         // Check whether all blocks on the path between the currently active
