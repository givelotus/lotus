From e5f242ccbc85f14122d003c532092c9fe5cfd42e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:39:20 -0700
Subject: [PATCH] fix(v2): anchor peer file operations and reject poisoned
 reads

---
 src/lotus_v2/avalanche_peer_store.cpp      | 43 +++++++++++++++++-----
 src/lotus_v2/test_avalanche_peer_store.cpp | 13 ++++++-
 2 files changed, 46 insertions(+), 10 deletions(-)

diff --git a/src/lotus_v2/avalanche_peer_store.cpp b/src/lotus_v2/avalanche_peer_store.cpp
index 9c6e9ed289308a01bb29fbb8cb661585cd96bd36..d370c3a9ad904a7a14b4552817248d8a7825746c 100644
--- a/src/lotus_v2/avalanche_peer_store.cpp
+++ b/src/lotus_v2/avalanche_peer_store.cpp
@@ -8,6 +8,7 @@
 #include <cerrno>
 #include <cstring>
 #include <set>
+#include <atomic>
 namespace lotus::v2::ava {
 namespace {
 using Bytes=std::vector<uint8_t>;
@@ -21,6 +22,22 @@ void put(Bytes &b,uint64_t v,size_t n) { for(size_t i=0;i<n;++i)b.push_back(v>>(
 void append(Bytes &b,const auto &v) { b.insert(b.end(),v.begin(),v.end()); }
 Hash digest(const Bytes &b) { Hash h; CSHA256().Write(b.data(),b.size()).Finalize(h.data()); return h; }
 PeerStoreResult fail(PeerStoreCode c,const char *s) { return {c,s}; }
+// Reject every symlink ancestor; all operations remain anchored to this directory
+// even if a concurrent actor renames it or replaces its former pathname.
+int openParent(const std::filesystem::path &path) {
+    if(path.filename().empty() || path.filename()=="." || path.filename()=="..") { errno=EINVAL; return -1; }
+    int fd=open(path.is_absolute()?"/":".",O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+    if(fd<0)return -1;
+    for(const auto &part:path.parent_path().relative_path()) {
+        if(part==".")continue;
+        if(part=="..") { close(fd);errno=EINVAL;return -1; }
+        int next=openat(fd,part.c_str(),O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        close(fd);if(next<0)return -1;fd=next;
+    }
+    return fd;
+}
+struct ScopedFd { int fd; ~ScopedFd(){if(fd>=0)close(fd);} };
+
 void scanProof(const Bytes &b,const PeerStoreLimits &l) {
     Reader r{b}; r.skip(16); auto key=r.compact(); if(key>65)throw std::runtime_error("master key bound"); r.skip(key);
     auto count=r.compact(); if(count>l.locks_per_proof || count>AVALANCHE_MAX_PROOF_STAKES)throw std::runtime_error("stake bound");
@@ -30,9 +47,9 @@ void scanProof(const Bytes &b,const PeerStoreLimits &l) {
 }
 PeerStore::PeerStore(std::filesystem::path p,Profile profile,PeerStoreLimits limits):path_(std::move(p)),profile_(std::move(profile)),limits_(limits) {}
 PeerStoreResult PeerStore::Load(std::vector<PersistedPeer> &out) const {
-    out.clear(); if(limits_.payload_bytes>(1ULL<<30)||limits_.records>1000000||limits_.proof_bytes>(1ULL<<30)||limits_.locks_per_proof>AVALANCHE_MAX_PROOF_STAKES)return fail(PeerStoreCode::Resource,"invalid store limits"); int fd=::open(path_.c_str(),O_RDONLY|O_NOFOLLOW); if(fd<0)return fail(errno==ENOENT?PeerStoreCode::Missing:PeerStoreCode::Io,"open peer store");
+    out.clear(); if(poisoned_)return fail(PeerStoreCode::Poisoned,"peer store requires reopen"); if(limits_.payload_bytes>(1ULL<<30)||limits_.records>1000000||limits_.proof_bytes>(1ULL<<30)||limits_.locks_per_proof>AVALANCHE_MAX_PROOF_STAKES)return fail(PeerStoreCode::Resource,"invalid store limits"); ScopedFd parent{openParent(path_)}; if(parent.fd<0)return fail(PeerStoreCode::Io,"open peer directory"); int fd=::openat(parent.fd,path_.filename().c_str(),O_RDONLY|O_NOFOLLOW|O_CLOEXEC); if(fd<0)return fail(errno==ENOENT?PeerStoreCode::Missing:PeerStoreCode::Io,"open peer store");
     struct stat st{}; if(fstat(fd,&st)||!S_ISREG(st.st_mode)||st.st_size<140||uint64_t(st.st_size)>limits_.payload_bytes+140) { close(fd); return fail(PeerStoreCode::Resource,"peer store file bound"); }
-    Bytes b(st.st_size); size_t off=0; while(off<b.size()) { auto n=read(fd,b.data()+off,b.size()-off); if(n<=0) { close(fd);return fail(PeerStoreCode::Io,"read peer store"); } off+=n; } close(fd);
+    Bytes b; try { b.resize(st.st_size); } catch(const std::exception &) { close(fd);return fail(PeerStoreCode::Resource,"peer store allocation"); } size_t off=0; while(off<b.size()) { auto n=read(fd,b.data()+off,b.size()-off); if(n<=0) { close(fd);return fail(PeerStoreCode::Io,"read peer store"); } off+=n; } close(fd);
     try {
         Bytes body(b.begin(),b.end()-32); Hash expected; std::copy(b.end()-32,b.end(),expected.begin()); if(digest(body)!=expected)return fail(PeerStoreCode::Corrupt,"peer store checksum");
         Reader r{body}; if(r.number(4)!=0x41505632||r.number(4)!=1)return fail(PeerStoreCode::Corrupt,"peer store schema");
@@ -47,7 +64,7 @@ PeerStoreResult PeerStore::Load(std::vector<PersistedPeer> &out) const {
             auto flag=r.number(1); if(flag>1)throw std::runtime_error("finalized flag"); peer.finalized=flag; peer.registration_time=int64_t(r.number(8)); peer.next_conflict_time=int64_t(r.number(8)); records.push_back(std::move(peer));
         }
         if(r.p!=body.size())throw std::runtime_error("trailing bytes"); out=std::move(records); return {};
-    } catch(const std::exception &e) { return {PeerStoreCode::Corrupt,e.what()}; }
+    } catch(const std::bad_alloc &) { return fail(PeerStoreCode::Resource,"peer store allocation"); } catch(const std::length_error &) { return fail(PeerStoreCode::Resource,"peer store allocation bound"); } catch(const std::exception &e) { return {PeerStoreCode::Corrupt,e.what()}; }
 }
 PeerStoreResult PeerStore::Save(const std::vector<PersistedPeer> &peers,Fault fault) {
     if(poisoned_)return fail(PeerStoreCode::Poisoned,"peer store requires reopen");
@@ -67,13 +84,21 @@ PeerStoreResult PeerStore::Save(const std::vector<PersistedPeer> &peers,Fault fa
             put(b,p.finalized,1);put(b,uint64_t(p.registration_time),8);put(b,uint64_t(p.next_conflict_time),8);
         }
     } catch(const std::exception &e) {return {PeerStoreCode::Resource,e.what()};}
-    append(b,digest(b)); auto parent=path_.parent_path(); if(parent.empty())parent=".";
-    std::string temporary=path_.string()+".tmp.XXXXXX"; int fd=mkstemp(temporary.data()); if(fd<0)return fail(PeerStoreCode::Io,"create peer temporary");
+    append(b,digest(b));
+    ScopedFd parent{openParent(path_)}; if(parent.fd<0)return fail(PeerStoreCode::Io,"open peer directory");
+    static std::atomic<uint64_t> sequence{};
+    std::string temporary; int fd=-1;
+    for(unsigned attempt=0;attempt<100;++attempt) {
+        temporary=path_.filename().string()+".tmp."+std::to_string(getpid())+"."+std::to_string(sequence.fetch_add(1));
+        fd=openat(parent.fd,temporary.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+        if(fd>=0 || errno!=EEXIST)break;
+    }
+    if(fd<0)return fail(PeerStoreCode::Io,"create peer temporary");
     size_t off=0; bool good=true; while(off<b.size()) { auto n=write(fd,b.data()+off,b.size()-off); if(n<0&&errno==EINTR)continue; if(n<=0){good=false;break;} off+=n; }
     if(good)good=fsync(fd)==0; if(close(fd)!=0)good=false;
-    if(!good||fault==Fault::BeforeReplace) { unlink(temporary.c_str());return fail(PeerStoreCode::Io,"sync peer temporary"); }
-    int dir=open(parent.c_str(),O_RDONLY|O_DIRECTORY); if(dir<0) {unlink(temporary.c_str());return fail(PeerStoreCode::Io,"open peer directory");}
-    if(rename(temporary.c_str(),path_.c_str())) {close(dir);unlink(temporary.c_str());return fail(PeerStoreCode::Io,"replace peer store");}
-    good=fault!=Fault::AfterReplace&&fsync(dir)==0; close(dir); if(!good){poisoned_=true;return fail(PeerStoreCode::Ambiguous,"peer replacement directory sync uncertain");} return {};
+    if(!good||fault==Fault::BeforeReplace) { unlinkat(parent.fd,temporary.c_str(),0);return fail(PeerStoreCode::Io,"sync peer temporary"); }
+    if(renameat(parent.fd,temporary.c_str(),parent.fd,path_.filename().c_str())) {unlinkat(parent.fd,temporary.c_str(),0);return fail(PeerStoreCode::Io,"replace peer store");}
+    good=fault!=Fault::AfterReplace&&fsync(parent.fd)==0;
+    if(!good){poisoned_=true;return fail(PeerStoreCode::Ambiguous,"peer replacement directory sync uncertain");} return {};
 }
 }
diff --git a/src/lotus_v2/test_avalanche_peer_store.cpp b/src/lotus_v2/test_avalanche_peer_store.cpp
index 8831a4a4216124ff873b20fc16c2e6942d38709a..c880b6524e7567c8e846c05191a642c86e8c1c6e 100644
--- a/src/lotus_v2/test_avalanche_peer_store.cpp
+++ b/src/lotus_v2/test_avalanche_peer_store.cpp
@@ -27,6 +27,17 @@ int main() {
     PersistedPeer peer{{builder.build(),{lock}},true,123,456};
     PeerStore store(path,profile);std::vector<PersistedPeer> loaded;
     BOOST_CHECK(store.Load(loaded).code==PeerStoreCode::Missing);
+    // Parent traversal rejects symlinks, including a pathname replaced after
+    // construction. Existing destination data must survive rejected writes.
+    auto intended=cleanup.p/"intended";auto outside=cleanup.p/"outside";
+    std::filesystem::create_directory(intended);std::filesystem::create_directory(outside);
+    PeerStore parent_replaced(intended/"peers",profile);
+    std::filesystem::rename(intended,cleanup.p/"original");
+    std::filesystem::create_directory_symlink(outside,intended);
+    BOOST_CHECK(parent_replaced.Save({peer}).code==PeerStoreCode::Io);
+    BOOST_CHECK(parent_replaced.Load(loaded).code==PeerStoreCode::Io);
+    BOOST_CHECK(!std::filesystem::exists(outside/"peers"));
+    BOOST_CHECK(!std::filesystem::exists(cleanup.p/"original"/"peers"));
     BOOST_REQUIRE(bool(store.Save({peer})));
     PeerStore restarted(path,profile);BOOST_REQUIRE(bool(restarted.Load(loaded)));BOOST_REQUIRE_EQUAL(loaded.size(),1U);
     BOOST_CHECK(loaded[0].envelope.proof->getId()==peer.envelope.proof->getId());BOOST_CHECK(loaded[0].envelope.payment_locks==peer.envelope.payment_locks);
@@ -34,7 +45,7 @@ int main() {
     BOOST_CHECK(store.Save({},PeerStore::Fault::BeforeReplace).code==PeerStoreCode::Io);BOOST_REQUIRE(bool(restarted.Load(loaded)));BOOST_CHECK_EQUAL(loaded.size(),1U);
     auto foreign=profile;foreign.validation_digest[0]++;PeerStore other(path,foreign);BOOST_CHECK(other.Load(loaded).code==PeerStoreCode::ForeignProfile);BOOST_CHECK(loaded.empty());
     PeerStoreLimits limits;limits.records=0;PeerStore capped(path,profile,limits);BOOST_CHECK(capped.Load(loaded).code==PeerStoreCode::Resource);BOOST_CHECK(capped.Save({peer}).code==PeerStoreCode::Resource);
-    BOOST_CHECK(store.Save({},PeerStore::Fault::AfterReplace).code==PeerStoreCode::Ambiguous);BOOST_CHECK(store.Poisoned());BOOST_CHECK(store.Save({peer}).code==PeerStoreCode::Poisoned);
+    BOOST_CHECK(store.Save({},PeerStore::Fault::AfterReplace).code==PeerStoreCode::Ambiguous);BOOST_CHECK(store.Poisoned());BOOST_CHECK(store.Load(loaded).code==PeerStoreCode::Poisoned);BOOST_CHECK(loaded.empty());BOOST_CHECK(store.Save({peer}).code==PeerStoreCode::Poisoned);
     PeerStore fresh(path,profile);BOOST_REQUIRE(bool(fresh.Load(loaded)));BOOST_CHECK(loaded.empty());BOOST_REQUIRE(bool(fresh.Save({peer})));
     {std::fstream file(path,std::ios::binary|std::ios::in|std::ios::out);file.seekp(120);file.put('\xff');}
     BOOST_CHECK(fresh.Load(loaded).code==PeerStoreCode::Corrupt);BOOST_CHECK(loaded.empty());
