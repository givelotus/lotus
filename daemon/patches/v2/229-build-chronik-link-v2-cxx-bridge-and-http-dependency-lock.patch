From 1ab203f0c53ea4e620fac80ac6781e6176fa3fac Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:46:07 -0700
Subject: [PATCH] build(chronik): link V2 CXX bridge and HTTP dependency lock

---
 Cargo.lock             | 2 ++
 chronik/CMakeLists.txt | 3 ++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/Cargo.lock b/Cargo.lock
index aed6cd561b8f7583bb246632ff5f92ce9b2e41a9..e9f2e5c67336cd28eb82009917ddbb9f4443c552 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -774,10 +774,12 @@ dependencies = [
  "karyon_net",
  "prost",
  "rustls",
+ "serde",
  "serde_json",
  "sha2",
  "thiserror 2.0.17",
  "tokio",
+ "tower 0.5.2",
  "tower-http 0.5.2",
  "tower-service",
  "versions",
diff --git a/chronik/CMakeLists.txt b/chronik/CMakeLists.txt
index 37c3211762be57f9a557c24b7188b3b557db35a6..bb701df47b0762fb308acc7d581512bd3f73299c 100644
--- a/chronik/CMakeLists.txt
+++ b/chronik/CMakeLists.txt
@@ -110,7 +110,8 @@ set(CXXBRIDGE_GENERATED_FOLDER
 set(CHRONIK_BRIDGE_GENERATED_CPP_FILES
     "${CXXBRIDGE_GENERATED_FOLDER}/chronik-bridge/src/ffi.rs.cc")
 set(CHRONIK_LIB_GENERATED_CPP_FILES
-    "${CXXBRIDGE_GENERATED_FOLDER}/chronik_lib/src/ffi.rs.cc")
+    "${CXXBRIDGE_GENERATED_FOLDER}/chronik_lib/src/ffi.rs.cc"
+    "${CXXBRIDGE_GENERATED_FOLDER}/chronik_lib/src/v2_ffi.rs.cc")
 
 add_custom_command(
     OUTPUT
