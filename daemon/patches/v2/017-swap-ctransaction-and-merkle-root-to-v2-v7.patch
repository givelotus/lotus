+lotus::v2::Transaction CMutableTransaction::ToV2Transaction() const {
+    lotus::v2::Transaction v2tx;
+    const bool is_cb =
+        (vin.size() == 1 && (vin[0].prevout.IsNull() || vin[0].nFlags == 2));
+    v2tx.lock =
