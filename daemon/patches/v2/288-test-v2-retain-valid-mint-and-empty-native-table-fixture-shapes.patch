From 9842eaa6aeec30fa6568c8470910390aaa0a08b6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:15:03 -0700
Subject: [PATCH] test(v2): retain valid mint and empty native table fixture
 shapes

---
 chronik/chronik-http/src/v2_explorer_http_tests.rs | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/chronik/chronik-http/src/v2_explorer_http_tests.rs b/chronik/chronik-http/src/v2_explorer_http_tests.rs
index 9c4e602eaba233360d47f3bdea881b6e508db17b..6bb786fab103a2cab46cd9bce2ad26c3492cd919 100644
--- a/chronik/chronik-http/src/v2_explorer_http_tests.rs
+++ b/chronik/chronik-http/src/v2_explorer_http_tests.rs
@@ -42,10 +42,11 @@ impl Fixture {
         };
         let mut header_wire = [0; 134];
         header_wire[54..62].copy_from_slice(&134u64.to_le_bytes());
-        let wire = (0..40000).map(|i| (i % 251) as u8).collect::<Vec<_>>();
+        let mut wire = (0..40000).map(|i| (i % 251) as u8).collect::<Vec<_>>();
+        wire[1] = 0; // Native empty argument table CompactSize count.
         let input = InputFact {
             prev_txid: [9; 32],
-            prev_index: u32::MAX,
+            prev_index: 0,
             sequence: u32::MAX,
             flags: 3,
             path_index: 0,
@@ -205,10 +206,7 @@ async fn every_route_serves_schema_and_exact_native_facts() {
     .await;
     assert_eq!(input["data"]["items"][0]["kind"], "mint");
     assert!(input["data"]["items"][0]["path_index"].is_null());
-    assert_eq!(
-        input["data"]["items"][0]["prev_index"],
-        u32::MAX.to_string()
-    );
+    assert_eq!(input["data"]["items"][0]["sequence"], u32::MAX.to_string());
     let asset =
         value(call(&app, &format!("/assets/{}/events", id(9)), None).await)
             .await;
