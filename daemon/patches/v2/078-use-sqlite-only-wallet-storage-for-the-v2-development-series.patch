-void BerkeleyEnvironment::CloseDb(const std::string &strFile) {
-    LOCK(cs_db);
-    auto it = m_databases.find(strFile);
-    assert(it != m_databases.end());
-    BerkeleyDatabase &database = it->second.get();
-    if (database.m_db) {
