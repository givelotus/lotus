 }
@@ -171,19 +189,25 @@ DriverResult AvalancheDriver::ClosePeer(peer::ConnectionId id,DisconnectCause ca
     Disconnect(id,cause);DriverResult result;result.disconnected_peer=id;return result;
 }
 DriverResult AvalancheDriver::Pump(uint64_t now) {
-    const auto id=peer_.PendingConnection();const auto result=peer_.Pump(now);
-    if(result==peer::DispatcherResult::UnknownPeer || result==peer::DispatcherResult::Closed ||
-       (result==peer::DispatcherResult::CapacityRefused && id && !peer_.Active(*id))) {
-        if(id) {IncrementDiagnostic(diagnostics_.dispatch_dead_targets);return ClosePeer(*id,DisconnectCause::DeadTarget);}
-        return Error(DriverCode::ProtocolFailure,"missing-terminal-action-target");
-    }
-    if(result==peer::DispatcherResult::CapacityRefused) {
-        IncrementDiagnostic(diagnostics_.dispatch_local_failures);
-        return Error(DriverCode::ProtocolFailure,"avalanche-local-dispatch-capacity");
-    }
-    if(result==peer::DispatcherResult::InvalidConfiguration || result==peer::DispatcherResult::OperationalFailure) {
-        IncrementDiagnostic(diagnostics_.dispatch_local_failures);
-        return Error(DriverCode::ProtocolFailure,"avalanche-local-dispatch-failure");
+    while(peer_.PendingActions()) {
+        const auto result=peer_.Pump(now);
+        if(result==peer::DispatcherResult::Queued) continue;
+        if(result==peer::DispatcherResult::Busy || result==peer::DispatcherResult::Progress) break;
+        const auto id=peer_.PendingConnection();
+        if(result==peer::DispatcherResult::UnknownPeer || result==peer::DispatcherResult::Closed ||
+           (result==peer::DispatcherResult::CapacityRefused && id && !peer_.Active(*id))) {
+            if(id) {IncrementDiagnostic(diagnostics_.dispatch_dead_targets);return ClosePeer(*id,DisconnectCause::DeadTarget);}
+            return Error(DriverCode::ProtocolFailure,"missing-terminal-action-target");
+        }
+        if(result==peer::DispatcherResult::CapacityRefused) {
+            IncrementDiagnostic(diagnostics_.dispatch_local_failures);
+            return Error(DriverCode::ProtocolFailure,"avalanche-local-dispatch-capacity");
+        }
+        if(result==peer::DispatcherResult::InvalidConfiguration || result==peer::DispatcherResult::OperationalFailure) {
+            IncrementDiagnostic(diagnostics_.dispatch_local_failures);
+            return Error(DriverCode::ProtocolFailure,"avalanche-local-dispatch-failure");
+        }
+        break;
     }
     return {};
 }
