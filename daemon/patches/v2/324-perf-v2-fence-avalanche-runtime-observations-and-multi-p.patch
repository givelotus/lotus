     if (actions_.empty()) return peer::DispatcherResult::Progress;
-    const auto &a = actions_.front(); auto r = dispatcher_.SendApplication(a.connection, a.message, now);
-    if (r == peer::DispatcherResult::Queued) {
-        if (a.message.command == "avaproofs") {
-            auto p = peers_.find(a.connection);
-            if (p != peers_.end()) callbacks_.sent_proof_inventory(p->second.node);
+    std::vector<peer::ConnectionId> busy;
+    for (auto it = actions_.begin(); it != actions_.end(); ++it) {
+        if (std::find(busy.begin(), busy.end(), it->connection) != busy.end())
+            continue;
+        auto r = dispatcher_.SendApplication(it->connection, it->message, now);
+        if (r == peer::DispatcherResult::Queued) {
+            if (it->message.command == "avaproofs") {
+                auto p = peers_.find(it->connection);
+                if (p != peers_.end()) callbacks_.sent_proof_inventory(p->second.node);
+            }
+            action_bytes_ -= it->message.payload.size();
+            actions_.erase(it);
+            return r;
+        }
+        if (r == peer::DispatcherResult::Busy) {
+            busy.push_back(it->connection);
+            continue;
+        }
+        if (it != actions_.begin()) {
+            auto action = std::move(*it);
+            actions_.erase(it);
+            actions_.push_front(std::move(action));
         }
-        action_bytes_ -= a.message.payload.size(); actions_.pop_front();
+        // Terminal failures retain the action until driver disconnects explicitly.
+        return r;
     }
-    // Terminal failures retain the action until driver disconnects explicitly.
-    return r;
+    return peer::DispatcherResult::Busy;
