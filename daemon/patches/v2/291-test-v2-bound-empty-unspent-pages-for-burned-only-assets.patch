From 97012f1ea50e8b11aeb3ee8fed3e8ac7086425ea Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:16:12 -0700
Subject: [PATCH] test(v2): bound empty unspent pages for burned-only assets

---
 .../src/v2_explorer_http_tests.rs             | 25 +++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/chronik/chronik-http/src/v2_explorer_http_tests.rs b/chronik/chronik-http/src/v2_explorer_http_tests.rs
index 6bb786fab103a2cab46cd9bce2ad26c3492cd919..b2fb3fe0a419028fbe3c8bbbbd88536258f93969 100644
--- a/chronik/chronik-http/src/v2_explorer_http_tests.rs
+++ b/chronik/chronik-http/src/v2_explorer_http_tests.rs
@@ -22,6 +22,9 @@ impl Fixture {
         Self::with_outputs(2)
     }
     fn with_outputs(count: usize) -> Self {
+        Self::with_kind(count, false)
+    }
+    fn with_kind(count: usize, burn: bool) -> Self {
         let path = std::env::temp_dir().join(format!(
             "lotus-explorer-http-{}-{}",
             std::process::id(),
@@ -71,11 +74,11 @@ impl Fixture {
             resolved_creation: None,
         };
         let token = Output {
-            flags: 1,
+            flags: if burn { 3 } else { 1 },
             value: u64::MAX,
             token_id: Hash32([9; 32]),
             branches: vec![Hash32([8; 32]), Hash32([7; 32])],
-            paths: vec![vec![0, 1]],
+            paths: if burn { vec![] } else { vec![vec![0, 1]] },
         };
         db.initialize_genesis(CommittedBlock {
             anchor,
@@ -402,3 +405,21 @@ async fn index_failure_and_absence_are_explicit() {
         StatusCode::SERVICE_UNAVAILABLE
     );
 }
+
+#[tokio::test]
+async fn burned_only_asset_unspent_scan_is_bounded_and_continues_empty() {
+    let f = Fixture::with_kind(1100, true);
+    let app = f.app();
+    let path = format!("/assets/{}/outputs?view=unspent", id(9));
+    let first = value(call(&app, &path, None).await).await;
+    assert_eq!(first["data"]["items"].as_array().unwrap().len(), 0);
+    assert_eq!(first["data"]["exhausted"], false);
+    let cursor = first["data"]["next_cursor"].as_str().unwrap();
+    let next =
+        value(call(&app, &format!("{path}&cursor={cursor}"), None).await).await;
+    assert_eq!(next["data"]["items"].as_array().unwrap().len(), 0);
+    assert_eq!(next["data"]["exhausted"], true);
+    let asset =
+        value(call(&app, &format!("/assets/{}", id(9)), None).await).await;
+    assert_eq!(asset["data"]["output_count"], "1100");
+}
