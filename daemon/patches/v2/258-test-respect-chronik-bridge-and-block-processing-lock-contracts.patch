                       testBlock.GetHash());
     chronik_bridge::Block bridgedTestBlock = chronik_bridge::bridge_block(
-        testBlock, *testBlockUndo, *chainman.ActiveTip());
+        testBlock, *testBlockUndo, bridge.get_chain_tip());
 
     chronik_bridge::Tx expectedTestTx0 = {
         .txid = HashToArray(testBlock.vtx[0]->GetId()),
@@ -306,7 +303,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_detailled, TestChain100Setup) {
                                 .script = ToRustVec<uint8_t>(scriptPad),
                             }},
                 .locktime = 0,
-            };
+    };
     chronik_bridge::Block expectedBridgedTestBlock = {
         .hash = HashToArray(testBlock.GetHash()),
         .prev_hash = HashToArray(testBlock.hashPrevBlock),
@@ -343,8 +340,6 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_detailled, TestChain100Setup) {
 }
 
 BOOST_FIXTURE_TEST_CASE(test_bridge_bad, TestChain100Setup) {
-    LOCK(cs_main);
-
     ChainstateManager &chainman = *Assert(m_node.chainman);
     const chronik_bridge::ChronikBridge bridge(m_node);
 
@@ -354,7 +349,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_bad, TestChain100Setup) {
                                    chainman.ActiveChainstate());
     CBlockUndo badBlockUndo1;
     BOOST_CHECK_EXCEPTION(chronik_bridge::bridge_block(badBlock1, badBlockUndo1,
-                                                       *chainman.ActiveTip()),
+                                                       bridge.get_chain_tip()),
                           std::runtime_error, [](const std::runtime_error &ex) {
                               BOOST_CHECK_EQUAL(ex.what(),
                                                 "Missing undo data for tx");
@@ -374,7 +369,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_bad, TestChain100Setup) {
     CreateAndProcessBlock({tx}, CScript() << OP_1,
                           &chainman.ActiveChainstate());
     std::unique_ptr<CBlockUndo> blockUndo =
-        bridge.load_block_undo(*chainman.ActiveTip());
+        bridge.load_block_undo(bridge.get_chain_tip());
 
     // This time, bad CBlock has two inputs whereas the disk has only one.
     CMutableTransaction badTx;
@@ -382,7 +377,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_bad, TestChain100Setup) {
     CBlock badBlock2 =
         CreateBlock({badTx}, CScript() << OP_1, chainman.ActiveChainstate());
     BOOST_CHECK_EXCEPTION(chronik_bridge::bridge_block(badBlock2, *blockUndo,
-                                                       *chainman.ActiveTip()),
+                                                       bridge.get_chain_tip()),
                           std::runtime_error, [](const std::runtime_error &ex) {
                               BOOST_CHECK_EQUAL(ex.what(),
                                                 "Missing coin for input");
@@ -394,8 +389,6 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_bad, TestChain100Setup) {
 // GetSizeOfCompactSize, therefore we test blocks with "dangerous" number of
 // txs, which cover the cases where GetSizeOfCompactSize goes from 1 -> 3 -> 5.
 BOOST_FIXTURE_TEST_CASE(test_bridge_big, TestChain100Setup) {
-    LOCK(cs_main);
-
     ChainstateManager &chainman = *Assert(m_node.chainman);
     const chronik_bridge::ChronikBridge bridge(m_node);
 
@@ -408,7 +401,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_big, TestChain100Setup) {
         CBlock coinblock = CreateAndProcessBlock({}, CScript() << OP_1,
                                                  &chainman.ActiveChainstate());
         coinblocks.push_back(coinblock);
-        BOOST_CHECK_EQUAL(chainman.ActiveTip()->GetBlockHash(),
+        BOOST_CHECK_EQUAL(bridge.get_chain_tip().GetBlockHash(),
                           coinblock.GetHash());
     }
     mineBlocks(100);
@@ -436,15 +429,15 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_big, TestChain100Setup) {
         }
         CBlock testBlock = CreateAndProcessBlock(txs, CScript() << OP_1,
                                                  &chainman.ActiveChainstate());
-        BOOST_CHECK_EQUAL(chainman.ActiveTip()->GetBlockHash(),
+        BOOST_CHECK_EQUAL(bridge.get_chain_tip().GetBlockHash(),
                           testBlock.GetHash());
 
         std::unique_ptr<CBlockUndo> testBlockUndo =
-            bridge.load_block_undo(*chainman.ActiveTip());
+            bridge.load_block_undo(bridge.get_chain_tip());
 
         // test matches disk
         chronik_bridge::Block bridgedBlock = chronik_bridge::bridge_block(
-            testBlock, *testBlockUndo, *chainman.ActiveTip());
+            testBlock, *testBlockUndo, bridge.get_chain_tip());
         CheckMatchesDisk(chainman.m_blockman, testBlock, bridgedBlock);
 
         for (const chronik_bridge::BlockTx &bridgedTx : bridgedBlock.txs) {
diff --git a/chronik/test/chronikbridge_tests.cpp b/chronik/test/chronikbridge_tests.cpp
index 9542e00fe354028c5f411ca600a21978fd38491b..45d13946409fac13a957542df28a81d2ba4e1808 100644
--- a/chronik/test/chronikbridge_tests.cpp
+++ b/chronik/test/chronikbridge_tests.cpp
@@ -98,9 +98,7 @@ BOOST_FIXTURE_TEST_CASE(test_find_fork, TestChain100Setup) {
 
 BOOST_FIXTURE_TEST_CASE(test_lookup_spent_coin, TestChain100Setup) {
     ChainstateManager &chainman = *Assert(m_node.chainman);
-    LOCK(cs_main);
     const chronik_bridge::ChronikBridge bridge(m_node);
-    CCoinsViewCache &coins_cache = chainman.ActiveChainstate().CoinsTip();
 
     CScript anyoneScript = CScript() << OP_1;
     CScript anyoneP2sh = GetScriptForDestination(ScriptHash(anyoneScript));
@@ -120,7 +118,8 @@ BOOST_FIXTURE_TEST_CASE(test_lookup_spent_coin, TestChain100Setup) {
         CTxOut(coinTx->vout[0].nValue - 10000 * SATOSHI, anyoneP2sh),
     };
     const MempoolAcceptResult result =
-        m_node.chainman->ProcessTransaction(MakeTransactionRef(tx));
+        WITH_LOCK(chainman.GetMutex(),
+                  return chainman.ProcessTransaction(MakeTransactionRef(tx)));
     BOOST_CHECK_EQUAL(result.m_result_type,
                       MempoolAcceptResult::ResultType::VALID);
     TxId txid = tx.GetId();
@@ -149,6 +148,10 @@ BOOST_FIXTURE_TEST_CASE(test_lookup_spent_coin, TestChain100Setup) {
         .locktime = 0,
     };
 
+    // Keep direct cache inspection protected, but release the lock when mining.
+    WAIT_LOCK(chainman.GetMutex(), lock);
+    CCoinsViewCache &coins_cache = chainman.ActiveChainstate().CoinsTip();
+
     // Do lookup
     rust::Vec<chronik_bridge::OutPoint> not_found;
     rust::Vec<chronik_bridge::OutPoint> coins_to_uncache;
@@ -177,9 +180,12 @@ BOOST_FIXTURE_TEST_CASE(test_lookup_spent_coin, TestChain100Setup) {
     BOOST_CHECK(CScript(script1.data(), script1.data() + script1.size()) ==
                 anyoneP2sh);
 
-    // Mine tx
-    CreateAndProcessBlock({tx}, CScript() << OP_1,
-                          &chainman.ActiveChainstate());
+    // ProcessNewBlock requires the caller not to hold cs_main.
+    {
+        REVERSE_LOCK(lock);
+        CreateAndProcessBlock({tx}, CScript() << OP_1,
+                              &chainman.ActiveChainstate());
+    }
     // Coins are now in the cache
     BOOST_CHECK(coins_cache.HaveCoinInCache(COutPoint(txid, 0)));
     BOOST_CHECK(coins_cache.HaveCoinInCache(COutPoint(txid, 1)));
