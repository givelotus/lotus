 chronik/test/chronikbridge_tests.cpp    | 18 +++++++++-----
 2 files changed, 25 insertions(+), 26 deletions(-)

diff --git a/chronik/test/bridgeprimitives_tests.cpp b/chronik/test/bridgeprimitives_tests.cpp
index f3ec1164d2b511e9400823e21cecf73067b8f646..1deb1da047a41f66b02fac0610b76b669f4376ef 100644
