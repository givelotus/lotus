-            break;
-    }
-    textChanged();
-    connect(ui->toggleShowPasswordButton, &QPushButton::toggled, this,
-            &AskPassphraseDialog::toggleShowPassword);
-    connect(ui->passEdit1, &QLineEdit::textChanged, this,
