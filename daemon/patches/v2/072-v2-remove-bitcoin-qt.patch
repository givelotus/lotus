-                                    std::vector<std::string>(
-                                        stack.back().begin() + 1,
-                                        stack.back().end()));
-                                std::string method = stack.back()[0];
-                                std::string uri;
-
-#ifdef ENABLE_WALLET
-                                if (wallet_model) {
-                                    QByteArray encodedName =
