-/**
- * Convert configured prune target MiB to displayed GB. Round up to avoid
- * underestimating max disk usage.
- */
-static inline int PruneMiBtoGB(int64_t mib) {
-    return (mib * 1024 * 1024 + GB_BYTES - 1) / GB_BYTES;
