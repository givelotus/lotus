-TrafficGraphWidget::TrafficGraphWidget(QWidget *parent)
-    : QWidget(parent), timer(nullptr), fMax(0.0f), nMins(0), vSamplesIn(),
-      vSamplesOut(), nLastBytesIn(0), nLastBytesOut(0), clientModel(nullptr) {
