-    Q_EMIT layoutChanged();
-}
-
-int PeerTableModel::getRowByNodeId(NodeId nodeid) {
-    std::map<NodeId, int>::iterator it = priv->mapNodeRows.find(nodeid);
-    if (it == priv->mapNodeRows.end()) {
