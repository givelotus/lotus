-    if (!arg.startsWith(scheme + ":", Qt::CaseInsensitive)) {
-        return {};
-    }
-
-    SendCoinsRecipient r;
-    if (!GUIUtil::parseBitcoinURI(scheme, arg, &r)) {
-        return {};
