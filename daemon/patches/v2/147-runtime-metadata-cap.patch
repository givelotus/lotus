From b291b4abafce069349d77b2d37a6ae11ab29711a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:56:42 -0700
Subject: [PATCH] fix(v2): bound all runtime metadata payloads

Enforce the documented aggregate header, monetary and auxiliary return cap with subtraction to avoid overflow. Preserve outputs on capacity refusal and move the validated snapshot into the caller. Regression coverage checks auxiliary-only, one-byte-short and exact aggregate caps; runtime and disk suites pass.
---
 src/lotus_v2/development_runtime.cpp      | 13 +++++++++----
 src/lotus_v2/test_development_runtime.cpp | 22 ++++++++++++++++++++++
 2 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/development_runtime.cpp b/src/lotus_v2/development_runtime.cpp
index b4d9beb8c78d0dd25c8f8711cd7b068dbf741601..777a99aeb23bc00446cde9abd5eed624a679b530 100644
--- a/src/lotus_v2/development_runtime.cpp
+++ b/src/lotus_v2/development_runtime.cpp
@@ -609,10 +609,15 @@ DevelopmentRuntime::ReadMetadata(uint64_t cap, DiskStateMetadata &out,
     if (const auto r = p.Access(error); r != Result::Progress) return r;
     BusyGuard guard(p.busy);
     // Metadata() takes a creation-capped snapshot before the caller return cap.
-    const auto metadata = p.store.Metadata();
-    if (metadata.auxiliary.size() > cap) return Result::CapacityRefused;
-    out = metadata;
-    root = p.store.Root();
+    auto metadata = p.store.Metadata();
+    for (const auto size : {metadata.header.size(), metadata.monetary.size(),
+                            metadata.auxiliary.size()}) {
+        if (size > cap) return Result::CapacityRefused;
+        cap -= size;
+    }
+    const auto snapshot_root = p.store.Root();
+    out = std::move(metadata);
+    root = snapshot_root;
     return Result::Progress;
 }
 } // namespace lotus::v2
diff --git a/src/lotus_v2/test_development_runtime.cpp b/src/lotus_v2/test_development_runtime.cpp
index 14fb03cac0da626b24a3adfcdd5627bab45b9081..40e2b17a12fcb1c5949124cd95ed547b9ab02093 100644
--- a/src/lotus_v2/test_development_runtime.cpp
+++ b/src/lotus_v2/test_development_runtime.cpp
@@ -102,6 +102,28 @@ DiskStateMetadata Metadata(DevelopmentRuntime &runtime, Hash &root) {
     Check(runtime.ReadMetadata(1 << 20, metadata, root, error) ==
               DevelopmentRuntimeResult::Progress,
           "bounded runtime metadata: " + error);
+    const auto total = metadata.header.size() + metadata.monetary.size() +
+                       metadata.auxiliary.size();
+    Check(total > metadata.auxiliary.size(), "metadata has header/money payload");
+    DiskStateMetadata bounded;
+    bounded.header = {0x42};
+    Hash sentinel{};
+    sentinel[0] = 0x42;
+    for (const auto cap : {metadata.auxiliary.size(), total - 1}) {
+        auto untouched_root = sentinel;
+        Check(runtime.ReadMetadata(cap, bounded, untouched_root, error) ==
+                  DevelopmentRuntimeResult::CapacityRefused &&
+                  bounded.header == std::vector<uint8_t>{0x42} &&
+                  untouched_root == sentinel,
+              "metadata combined payload cap preserves outputs");
+    }
+    Hash exact_root;
+    Check(runtime.ReadMetadata(total, bounded, exact_root, error) ==
+                  DevelopmentRuntimeResult::Progress &&
+                  bounded.header == metadata.header &&
+                  bounded.monetary == metadata.monetary &&
+                  bounded.auxiliary == metadata.auxiliary && exact_root == root,
+          "metadata exact combined payload cap");
     return metadata;
 }
 void Match(DevelopmentRuntime &runtime, size_t n) {
