+cmake_minimum_required(VERSION 3.18)
+project(lotus_v2_block_review LANGUAGES C CXX)
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+find_package(OpenSSL REQUIRED COMPONENTS Crypto)
+find_path(LOTUS_BOOST_INCLUDE boost/multiprecision/cpp_int.hpp
+    PATHS /opt/homebrew/opt/boost/include)
+if(NOT LOTUS_BOOST_INCLUDE)
+    message(FATAL_ERROR "Set LOTUS_BOOST_INCLUDE to Boost headers")
+endif()
+get_filename_component(LOTUS_SRC "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
+if(NOT DEFINED LOTUS_SECP_LIBRARY OR NOT EXISTS "${LOTUS_SECP_LIBRARY}")
+    message(FATAL_ERROR "Set LOTUS_SECP_LIBRARY to a locally built ABC libsecp256k1.a")
+endif()
+add_library(lotus_v2_block_blake3 STATIC
+    ../vendor/blake3/blake3.c
+    ../vendor/blake3/blake3_dispatch.c
+    ../vendor/blake3/blake3_portable.c)
+target_compile_definitions(lotus_v2_block_blake3 PRIVATE
+    BLAKE3_NO_SSE2 BLAKE3_NO_SSE41 BLAKE3_NO_AVX2 BLAKE3_NO_AVX512 BLAKE3_USE_NEON=0)
+add_executable(lotus_v2_block_test
+    ../output.cpp ../transaction.cpp ../commitment.cpp ../tagged_hash.cpp
+    ../signing.cpp ../vm.cpp ../sparse_state.cpp ../incremental_utxo.cpp
+    ../ordinary_validation.cpp ../monetary.cpp ../block.cpp ../test_block.cpp)
+target_include_directories(lotus_v2_block_test PRIVATE
+    "${LOTUS_SRC}/secp256k1/include" "${LOTUS_BOOST_INCLUDE}" ../vendor/blake3)
+target_link_libraries(lotus_v2_block_test PRIVATE
+    lotus_v2_block_blake3 OpenSSL::Crypto "${LOTUS_SECP_LIBRARY}")
+target_compile_options(lotus_v2_block_test PRIVATE
+    $<$<COMPILE_LANGUAGE:CXX>:-Wall;-Wextra;-Wpedantic;-Werror>)
+enable_testing()
+add_test(NAME lotus_v2_block_test COMMAND lotus_v2_block_test)
diff --git a/src/lotus_v2/block_test/check_reference.py b/src/lotus_v2/block_test/check_reference.py
new file mode 100644
index 000000000..48aa26dfd
--- /dev/null
+++ b/src/lotus_v2/block_test/check_reference.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""Differential ordinary-block roots and reject reasons.
+
+Usage: check_reference.py NATIVE_TEST_EXE PATH_TO_lotus-v2-reference
+The reference source is supplied explicitly; no source is copied into this tree.
+This compares a standalone model. It does not mean lotusd parsed or accepted a block.
+"""
+
+import subprocess
+import sys
+from pathlib import Path
+
+reference_root = Path(sys.argv[2]).resolve()
+sys.path.insert(0, str(reference_root))
+sys.path.insert(0, str(reference_root / "tests"))
+from test_block import reference_report  # noqa: E402
+
+expected = reference_report()
+result = subprocess.run([sys.argv[1], "--report"], text=True, capture_output=True, check=True)
+actual = {}
+for line in result.stdout.splitlines():
+    key, value = line.split(" ", 1)
+    actual[key] = value
+missing = [key for key in expected if key not in actual and key not in
+           ("over_root_unchanged", "bad_root_unchanged")]
+if missing:
+    raise SystemExit(f"native report missing {missing}")
+compared = 0
+for key, want in expected.items():
+    if key in ("over_root_unchanged", "bad_root_unchanged"):
+        continue
+    got = actual[key]
+    if got != want:
+        raise SystemExit(f"{key}: native {got} != python {want}")
+    compared += 1
+print(f"{compared} Python/native ordinary-block fields matched")
