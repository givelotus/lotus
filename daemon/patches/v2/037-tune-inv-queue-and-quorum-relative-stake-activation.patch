     auto localProof = getLocalProof();
 
     // Get the registered proof score and registered score we have nodes for
-    uint32_t totalPeersScore;
-    uint32_t connectedPeersScore;
-    {
-        LOCK(cs_peerManager);
-        totalPeersScore = peerManager->getTotalPeersScore();
-        connectedPeersScore = peerManager->getConnectedPeersScore();
-
-        // Consider that we are always connected to our proof, even if we are
-        // the single node using that proof.
-        if (localProof &&
-            peerManager->forPeer(localProof->getId(), [](const Peer &peer) {
-                return peer.node_count == 0;
-            })) {
-            connectedPeersScore += localProof->getScore();
-        }
+    uint32_t totalPeersScore = peerManager->getAtomicTotalPeersScore();
+    uint32_t connectedPeersScore = peerManager->getAtomicConnectedPeersScore();
+    int64_t totalStakedSatoshis =
+        peerManager->getAtomicTotalPeersStakedSatoshis();
+
+    // Consider that we are always connected to our proof, even if we are
+    // the single node using that proof.
+    if (localProof && peerManager->getAtomicLocalProofHasNoNode()) {
+        connectedPeersScore += localProof->getScore();
     }
 
     // Ensure enough is being staked overall
@@ -945,20 +962,48 @@ bool Processor::isQuorumEstablished() {
         return false;
     }
 
-    quorumIsEstablished = true;
+    // Ensure staked amount meets the circulating supply threshold (if enabled)
+    if (minQuorumSupplyPermille > 0) {
+        const BlockHash tipHash =
+            WITH_LOCK(cs_activeTipHash, return m_activeTipHash);
+        const uint64_t circulatingSupply =
+            GetV2BlockCirculatingSupply(tipHash);
+        if (circulatingSupply > 0 &&
+            uint64_t(std::max<int64_t>(0, totalStakedSatoshis)) * 1000 <
+                circulatingSupply * minQuorumSupplyPermille) {
+            return false;
+        }
+    }
+
+    quorumIsEstablished.store(true);
+    return true;
+}
 
-    // Attempt to compute the staking rewards winner now so we don't have to
-    // wait for a block if we already have all the prerequisites.
-    const CBlockIndex *pprev = WITH_LOCK(cs_main, return chainman.ActiveTip());
-    bool computedRewards = false;
-    if (pprev && IsStakingRewardsActivated(chainman.GetConsensus(), pprev)) {
-        computedRewards = computeStakingReward(pprev);
+bool Processor::isQuorumEstablished() NO_THREAD_SAFETY_ANALYSIS {
+    AssertLockNotHeld(cs_main);
+
+    const bool wasEstablished = quorumIsEstablished.load();
+    if (!std::as_const(*this).isQuorumEstablished()) {
+        return false;
     }
-    if (pprev && isStakingPreconsensusActivated(pprev) && !computedRewards) {
-        // It's possible to have quorum shortly after startup if peers were
-        // loaded from disk, but staking rewards may not be ready yet. In this
-        // case, we can still promote and poll for contenders.
-        promoteAndPollStakeContenders(pprev);
+
+    if (!wasEstablished) {
+        // Attempt to compute the staking rewards winner now so we don't have to
+        // wait for a block if we already have all the prerequisites.
+        const CBlockIndex *pprev =
+            WITH_LOCK(cs_main, return chainman.ActiveTip());
+        bool computedRewards = false;
+        if (pprev &&
+            IsStakingRewardsActivated(chainman.GetConsensus(), pprev)) {
+            computedRewards = computeStakingReward(pprev);
+        }
+        if (pprev && isStakingPreconsensusActivated(pprev) &&
+            !computedRewards) {
+            // It's possible to have quorum shortly after startup if peers were
+            // loaded from disk, but staking rewards may not be ready yet. In
+            // this case, we can still promote and poll for contenders.
+            promoteAndPollStakeContenders(pprev);
+        }
     }
 
     return true;
@@ -1552,6 +1597,10 @@ void Processor::updatedBlockTip() {
 
