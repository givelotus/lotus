From 94bd478ecc6d0dde7edf8d7991a26a3a6bd36a6f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:32:55 -0700
Subject: [PATCH] build(v2): provide ABC source and generated headers to
 Avalanche adapters

Maintenance explanation added during mailbox export:
Provide ABC source and generated include paths to the native Avalanche adapters. This fixes integrated compilation of headers that depend on upstream generated configuration.

---
 src/lotus_v2/CMakeLists.txt | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 462bdc40c824bde79eb872eeda62960683aad6d5..59631e16ad1abb1d7a926565df3615654064ed36 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -326,6 +326,8 @@ add_custom_target(check-lotus-v2-transactions
 add_library(lotus_v2_avalanche STATIC
     avalanche_proof.cpp avalanche_protocol.cpp avalanche_quorum.cpp
     avalanche_poll.cpp avalanche_chain.cpp)
+target_include_directories(lotus_v2_avalanche PUBLIC
+    .. "${CMAKE_CURRENT_BINARY_DIR}/..")
 target_link_libraries(lotus_v2_avalanche PUBLIC lotus_v2_validation)
 add_executable(test_lotus_v2_avalanche test_avalanche_v2.cpp)
 target_link_libraries(test_lotus_v2_avalanche PRIVATE lotus_v2_avalanche
-- 
