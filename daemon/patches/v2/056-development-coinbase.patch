 }
+
+bool IsCoinbaseTransaction(const Transaction &tx) {
+    for (const Input &input : tx.inputs) {
+        if (input.flags == 2) return true;
+    }
+    return false;
+}
+
+// Reject a missing front coinbase or a second one before any coin is inserted.
+bool CoinbasePlacement(const std::vector<Transaction> &transactions,
+                       std::string &error) {
+    bool seen = false;
+    for (size_t i = 0; i < transactions.size(); ++i) {
+        if (!IsCoinbaseTransaction(transactions[i])) continue;
+        if (seen || i != 0) {
+            error = "coinbase position";
+            return false;
+        }
+        seen = true;
+    }
+    return true;
+}
+
+// Development candidate only. EncodeTransaction rejects a bad coinbase shape.
+// Non-burn outputs become coins; burn outputs are summed and not inserted.
+bool StageDevelopmentCoinbase(const Transaction &tx,
+                              const OrdinaryParentContext &parent,
+                              const OrdinaryCandidateProfile &profile,
+                              DevelopmentUtxoView &view, IncrementalUtxoSet &utxo,
+                              OrdinaryBlockUndo &undo, PersistentUtxoStore *store,
+                              size_t &store_commits, MonetaryInteger &native_outputs,
+                              MonetaryInteger &native_burn, uint64_t &coinbase_bytes,
+                              std::string &error) {
+    Hash parent_id{};
+    if (!BlockId(parent.chain_id, parent.header, parent_id)) {
+        error = "coinbase parent id";
+        return false;
+    }
+    // prev_txid is the parent header's BlockId. prev_index is this block's
+    // height. A zero id is not the development genesis id.
+    if (!CheckCoinbaseContext(tx, parent_id, profile.candidate_height, error))
+        return false;
+    std::vector<uint8_t> wire;
+    if (!EncodeTransaction(tx, profile.transaction, wire, error)) return false;
+    IdentityDigests identities;
+    if (!ComputeIdentities(tx, profile.transaction, parent.chain_id, identities,
+                           error))
+        return false;
+    MonetaryInteger outputs = 0;
+    MonetaryInteger burned = 0;
+    std::vector<Coin> created;
+    for (size_t j = 0; j < tx.outputs.size(); ++j) {
+        const Output &output = tx.outputs[j];
+        outputs += output.value;
+        if (output.IsBurn()) {
+            burned += output.value;
+            continue;
+        }
+        Coin coin;
+        coin.outpoint.tx_id = identities.txid;
+        coin.outpoint.index = static_cast<uint32_t>(j);
+        coin.output = output;
+        coin.creation_height = profile.candidate_height;
+        coin.creation_parent_mtp = profile.parent_mtp;
+        coin.coinbase = true;
+        created.push_back(std::move(coin));
+    }
+    size_t viewed = 0;
+    for (; viewed < created.size(); ++viewed) {
+        if (view.find(created[viewed].outpoint) != view.end() ||
+            !view.emplace(created[viewed].outpoint, created[viewed]).second)
+            break;
+    }
+    if (viewed != created.size()) {
+        for (size_t i = viewed; i-- > 0;) view.erase(created[i].outpoint);
+        error = "created outpoint already occupied";
+        return false;
+    }
+    size_t inserted = 0;
+    for (; inserted < created.size(); ++inserted) {
+        if (!utxo.Insert(created[inserted])) break;
+    }
+    if (inserted != created.size()) {
+        for (size_t i = inserted; i-- > 0;) utxo.Erase(created[i].outpoint);
+        for (const Coin &coin : created) view.erase(coin.outpoint);
+        error = "incremental utxo update failed";
+        return false;
+    }
+    for (const Coin &coin : created)
+        undo.steps.push_back(OrdinaryUndoStep{true, coin});
+    if (store != nullptr && !created.empty()) {
+        std::string store_error;
+        if (!store->Commit(std::vector<Outpoint>{}, created, store_error)) {
+            error = std::move(store_error);
+            return false;
+        }
+        ++store_commits;
+    }
+    native_outputs = outputs;
+    native_burn = burned;
+    coinbase_bytes = static_cast<uint64_t>(wire.size());
+    return true;
+}
