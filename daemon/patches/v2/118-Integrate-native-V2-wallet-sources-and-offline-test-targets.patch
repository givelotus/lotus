From 9f529da1cf11bc964bc9ebea3489c3a6dc281ca5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 11:00:10 -0700
Subject: [PATCH] Integrate native V2 wallet sources and offline test targets

Build native Payment ownership and signing into the wallet library, register its regression suite, and provide an explicit-manifest offline pilot helper. Link the tested V2 validation boundary without adding network broadcast or inherited wallet transaction handling.
---
 src/test/CMakeLists.txt   |  1 +
 src/wallet/CMakeLists.txt | 14 +++++++++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/test/CMakeLists.txt b/src/test/CMakeLists.txt
index 3afac158c..49ef02d46 100644
--- a/src/test/CMakeLists.txt
+++ b/src/test/CMakeLists.txt
@@ -79,6 +79,7 @@ if(BUILD_WALLET)
 		../wallet/test/wallet_tests.cpp
 		../wallet/test/walletdb_tests.cpp
 		../wallet/test/wallet_crypto_tests.cpp
+		../wallet/test/v2_wallet_tests.cpp
 	)
 endif()
 
diff --git a/src/wallet/CMakeLists.txt b/src/wallet/CMakeLists.txt
index 694a3b9f6..f7ed447a7 100644
--- a/src/wallet/CMakeLists.txt
+++ b/src/wallet/CMakeLists.txt
@@ -36,6 +36,8 @@ add_library(wallet
 	spend.cpp
 	sqlite.cpp
 	transaction.cpp
+	v2_wallet.cpp
+	v2_payment.cpp
 	wallet.cpp
 	walletdb.cpp
 	walletutil.cpp
@@ -45,8 +47,18 @@ add_library(wallet
 # https://github.com/bitcoin/bitcoin/pull/14437#discussion_r226237048
 # This dependency can be dropped after the mempool_ancestors_descendants
 # statistics is removed
-target_link_libraries(wallet server bitcoinconsensus univalue ${SQLITE3_IMPORTED_TARGET})
+target_link_libraries(wallet server bitcoinconsensus univalue ${SQLITE3_IMPORTED_TARGET} lotus_v2_validation)
 
 # wallet-tool library
 add_library(wallet-tool wallettool.cpp)
 target_link_libraries(wallet-tool wallet)
+
+# Offline native V2 wallet checks and explicit-manifest pilot helper.
+add_executable(test_lotus_v2_wallet v2_wallet_test/main.cpp test/v2_wallet_tests.cpp)
+target_compile_definitions(test_lotus_v2_wallet PRIVATE LOTUS_V2_WALLET_STANDALONE=1)
+target_link_libraries(test_lotus_v2_wallet PRIVATE wallet common util)
+add_custom_target(check-lotus-v2-wallet
+    COMMAND $<TARGET_FILE:test_lotus_v2_wallet>
+    DEPENDS test_lotus_v2_wallet)
+add_executable(lotus-v2-wallet-pilot v2_wallet_test/pilot.cpp ../lotus_v2/development_command.cpp)
+target_link_libraries(lotus-v2-wallet-pilot PRIVATE wallet common util univalue)
-- 
