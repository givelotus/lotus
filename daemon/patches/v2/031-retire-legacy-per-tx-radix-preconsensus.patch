@@ -30,6 +30,23 @@
 namespace avalanche {
 static constexpr uint64_t PEERS_DUMP_VERSION{1};
 
+void PeerManager::updateAtomicQuorumMetrics() {
+    m_atomicNodeCount.store(nodes.size(), std::memory_order_relaxed);
+    m_atomicTotalPeersScore.store(totalPeersScore, std::memory_order_relaxed);
+    m_atomicConnectedPeersScore.store(connectedPeersScore,
+                                      std::memory_order_relaxed);
+    m_atomicTotalPeersStakedSatoshis.store(totalPeersStakedAmount / SATOSHI,
+                                           std::memory_order_relaxed);
+    bool localNoNode = false;
+    if (localProof) {
+        forPeer(localProof->getId(), [&](const Peer &p) {
+            localNoNode = (p.node_count == 0);
+            return true;
+        });
+    }
+    m_atomicLocalProofHasNoNode.store(localNoNode, std::memory_order_relaxed);
+}
+
 bool PeerManager::addNode(NodeId nodeid, const ProofId &proofid,
                           size_t max_elements) {
     auto &pview = peers.get<by_proofid>();
@@ -85,6 +102,7 @@ bool PeerManager::addOrUpdateNode(const PeerSet::iterator &it, NodeId nodeid,
     // there is more than 1, in this case it's a no-op.
     shareableProofs.insert(it->proof);
 
+    updateAtomicQuorumMetrics();
     return true;
 }
 
@@ -129,6 +147,7 @@ bool PeerManager::removeNode(NodeId nodeid) {
     bool success = removeNodeFromPeer(peers.find(peerid));
     assert(success);
 
+    updateAtomicQuorumMetrics();
     return true;
 }
 
@@ -434,6 +453,7 @@ bool PeerManager::registerProof(const ProofRef &proof,
 
     // Add to our registered score when adding to the peer list
     totalPeersScore += proof->getScore();
+    totalPeersStakedAmount += proof->getStakedAmount();
 
     // If there are nodes waiting for this proof, add them
     auto &pendingNodesView = pendingNodes.get<by_proofid>();
@@ -458,6 +478,7 @@ bool PeerManager::registerProof(const ProofRef &proof,
         addStakeContender(proof);
     }
 
+    updateAtomicQuorumMetrics();
     return true;
 }
 
@@ -820,7 +841,10 @@ bool PeerManager::removePeer(const PeerId peerid) {
     // score total.
     assert(totalPeersScore >= it->getScore());
     totalPeersScore -= it->getScore();
+    assert(totalPeersStakedAmount >= it->proof->getStakedAmount());
+    totalPeersStakedAmount -= it->proof->getStakedAmount();
     peers.erase(it);
+    updateAtomicQuorumMetrics();
     return true;
 }
 
