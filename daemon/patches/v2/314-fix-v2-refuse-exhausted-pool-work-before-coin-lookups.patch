From 057be43c316f83f49f19c0db267f0669126bc459 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 18:54:04 -0700
Subject: [PATCH] fix(v2): refuse exhausted pool work before coin lookups

Move the validation and invocation budget guard ahead of authoritative input resolution and ancestor/descendant traversal, preserving canonical decode, identity and duplicate checks. Exhausted requests no longer reach coin backend or missing-state callbacks.

Add counters for both callbacks with zero validation budget and zero invocation budget. The focused pool suite passes; the same new regression fails with the prior pool implementation.
---
 src/lotus_v2/test_transaction_pool.cpp | 13 ++++++++++++-
 src/lotus_v2/transaction_pool.cpp      |  3 ++-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/test_transaction_pool.cpp b/src/lotus_v2/test_transaction_pool.cpp
index 32fd5b778fcfb4807c692a0ecafb06a37e2e7949..5535dc481a7a2d844d45b0f3acd913d6f0532fd2 100644
--- a/src/lotus_v2/test_transaction_pool.cpp
+++ b/src/lotus_v2/test_transaction_pool.cpp
@@ -67,7 +67,18 @@ int main() {try {
     CHECK(stale.Admit(Wire(parent),gc,sb).status==PoolStatus::Accepted);gc.profile.candidate_height=100;gc.anchor.generation=2;
     CHECK(stale.Reconcile(gc,{}, {},{},sb).status==PoolStatus::Accepted);CHECK(stale.Size()==0);
     PoolLimits tiny=limits;tiny.max_transaction_bytes=1;TransactionPool cap(tiny);CHECK(cap.Admit(Wire(parent),f.Context(),b).status==PoolStatus::Capacity);
-    PoolBudget zero{0,100};TransactionPool no_work(limits);CHECK(no_work.Admit(Wire(parent),f.Context(),zero).status==PoolStatus::Capacity);
+    // Exhaustion must avoid both authoritative lookup callbacks, even when
+    // an input is absent and would ordinarily need missing-state classification.
+    Fixture exhausted;exhausted.coins.clear();auto ec=exhausted.Context();
+    size_t coin_reads=0,missing_reads=0;
+    ec.active_coins=[&](const Outpoint&,Coin&,std::string&){++coin_reads;return CoinReadResult::Missing;};
+    ec.classify_missing=[&](const Outpoint&,std::string&){++missing_reads;return PoolMissingState::Unknown;};
+    TransactionPool no_work(limits);
+    for(auto zero:{PoolBudget{0,100},PoolBudget{1,0}}) {
+        const auto refused=no_work.Admit(Wire(parent),ec,zero);
+        CHECK(refused.status==PoolStatus::Capacity);CHECK(refused.error=="validation budget");
+        CHECK(coin_reads==0);CHECK(missing_reads==0);CHECK(no_work.Size()==0);
+    }
     tiny=limits;tiny.max_ancestors=0;TransactionPool graph(tiny);CHECK(graph.Admit(Wire(parent),f.Context(),b).status==PoolStatus::Accepted);CHECK(graph.Admit(Wire(left),f.Context(),b).status==PoolStatus::Capacity);
     // Independent local caps are refusal, never invalidity.
     for(int kind=0;kind<4;++kind) {
diff --git a/src/lotus_v2/transaction_pool.cpp b/src/lotus_v2/transaction_pool.cpp
index 327f95f3a2b91c4f2a053a3c5bac82a36ebf32f6..49da5c8aa1f082228a36454156364647f073752a 100644
--- a/src/lotus_v2/transaction_pool.cpp
+++ b/src/lotus_v2/transaction_pool.cpp
@@ -24,6 +24,8 @@ PoolResult TransactionPool::Admit(const std::vector<uint8_t> &wire,
         if (existing!=entries_.end()) return fail(existing->second.effects.txhash==r.txhash ? PoolStatus::Duplicate : PoolStatus::Conflict,"first accepted witness retained");
         if (entries_.size() >= limits_.max_entries || wire.size()>limits_.max_bytes-bytes_)
             return fail(PoolStatus::Capacity,"pool byte or entry limit");
+        // Refuse exhausted work before authoritative coin reads or graph scans.
+        if(!budget.validations || !budget.invocation_cost) return fail(PoolStatus::Capacity,"validation budget");
         PoolEntry staged; staged.wire=wire;
         std::vector<Coin> resolved;
         // Resolve once into a transaction-sized cache, never a full UTXO copy.
@@ -69,7 +71,6 @@ PoolResult TransactionPool::Admit(const std::vector<uint8_t> &wire,
                 for(const auto &p:e.parents) if(closure.contains(p)) {closure.insert(id); ++descendants; changed=true; break;}}
             if(descendants>limits_.max_descendants) return fail(PoolStatus::Capacity,"descendant limit");
         }
-        if(!budget.validations || !budget.invocation_cost) return fail(PoolStatus::Capacity,"validation budget");
         --budget.validations;
         auto profile=ctx.profile;
         profile.max_total_invocation_cost=std::min(profile.max_total_invocation_cost,budget.invocation_cost);
-- 
