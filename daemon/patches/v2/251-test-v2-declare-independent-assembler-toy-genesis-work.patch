From e3b89507810d65d3b0013967b1b3ae7212b2305d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:46:50 -0700
Subject: [PATCH] test(v2): declare independent assembler toy genesis work

The insufficient-funding fixture mines a separate toy genesis at target work 2, so give its monetary profile that explicit genesis anchor. Preserve its initial tail and insufficient-funding assertions.

Before: native LLVM 23 assembler fails opening the toy home with genesis anchor mismatch. After: AppleClang 21 Debug block_assembler_test and disk_state_test pass.
---
 src/lotus_v2/block_assembler_test/fixtures.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/lotus_v2/block_assembler_test/fixtures.h b/src/lotus_v2/block_assembler_test/fixtures.h
index 41c7bc2cafabe070f9514b4fa1c0b129a689b273..a2a4e05449420bf1416ffb94953bae82f95e5068 100644
--- a/src/lotus_v2/block_assembler_test/fixtures.h
+++ b/src/lotus_v2/block_assembler_test/fixtures.h
@@ -27,6 +27,8 @@ struct Home {
         if (insufficient) {
             // Existing bare toy monetary fixture: no invented funding.
             p.monetary = DevelopmentGenesis;
+            // This separately mined toy genesis has target work 2.
+            p.monetary.genesis_work = Hash{2};
             p.ordinary.dust_limit = p.monetary.dust_limit;
             initial = {};
             initial.bootstrap_reserve = 9;
-- 
