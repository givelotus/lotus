From 8cd36091ba9da0665ceab621ce42306963fcbfd9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:37:06 -0700
Subject: [PATCH] fix(v2): retain explorer tokens across unchanged native turns

---
 src/lotus_v2/development_node_command.cpp | 30 ++++++++++++++++-------
 1 file changed, 21 insertions(+), 9 deletions(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index 34eb15737105d0a29bc3a3476108db3dadb8af57..23c038d8ba3b39137a0407b436e86e54f6ca6d64 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -617,7 +617,7 @@ namespace {
 
     private:
         void OpenChronik(const std::string &);
-        void InvalidateChronik();
+        void SuspendChronik();
         void SyncChronik();
         std::string chronik_address, chronik_error;
         bool chronik_ready{};
@@ -726,13 +726,13 @@ namespace {
         (void)directory;
 #endif
     }
-    void Node::InvalidateChronik() {
-        // HTTP authority is invalidated here; retain the last completed sync
-        // result for command diagnostics, which run before the next sync step.
+    void Node::SuspendChronik() {
+        // Temporarily fence HTTP reads while this native turn can mutate state.
+        // Preserve snapshot generations when the completed context is unchanged.
 #ifdef LOTUS_V2_CHRONIK_CXX
-        // Failure to invalidate is fatal: native state must not change while
+        // Failure to suspend is fatal: native state must not change while
         // HTTP could still advertise the old observation as authoritative.
-        if (chronik_service) chronik_service.value()->invalidate_authority();
+        if (chronik_service) chronik_service.value()->suspend_authority();
 #endif
     }
     void Node::SyncChronik() {
@@ -741,13 +741,25 @@ namespace {
         if (!chronik_sync) return;
         try {
             const auto result = chronik_sync->Step(chronik_error);
-            if (result != ChronikSyncResult::Ready) return;
+            if (result != ChronikSyncResult::Ready) {
+                chronik_service.value()->invalidate_authority();
+                return;
+            }
             const auto checkpoint = chronik_sink->Checkpoint();
             Require(bool(checkpoint), "ready Chronik lacks checkpoint");
             chronik_v2::Anchor anchor{};
             anchor.block_id = checkpoint->block_id;
             anchor.height = checkpoint->height;
-            chronik_service.value()->publish_authority(anchor);
+            const auto snapshot = runtime->Snapshot();
+            Require(snapshot.chain && !snapshot.reopen_required &&
+                        !snapshot.execution_paused &&
+                        !snapshot.chain->pending_journal &&
+                        !snapshot.chain->pending_receipt &&
+                        !snapshot.chain->pending_propagation &&
+                        snapshot.chain->stable_tip == checkpoint->block_id,
+                    "ready Chronik lacks stable native context");
+            chronik_service.value()->publish_authority_context(
+                anchor, snapshot.context_generation, snapshot.chain->revision);
             chronik_ready = true;
             chronik_error.clear();
         } catch (const std::exception &e) {
@@ -2240,7 +2252,7 @@ namespace {
                                       size_t(manifest.block_read_limit)};
         const auto limits = TickLimits(manifest.block_read_limit);
         while (!stopping) {
-            InvalidateChronik();
+            SuspendChronik();
             const auto now = Monotonic();
             TickAvalanche(now, Utc());
             Drain();
-- 
