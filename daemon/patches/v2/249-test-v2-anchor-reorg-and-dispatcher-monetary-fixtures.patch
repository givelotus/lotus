From 3b8c982b67034b46dd23076621f7b5808609e4c8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:46:49 -0700
Subject: [PATCH] test(v2): anchor reorg and dispatcher monetary fixtures

Use the immutable fixture genesis tail 1000000 and work 2. The absolute-tail migration requires these explicit profile fields; no fixture block bytes or expectations change.

Before: native LLVM 23 reorg and dispatcher binaries fail with zero genesis work anchor. After: AppleClang 21 Debug reorg_recovery_test and peer_dispatcher_test pass, including their disk_state_test suites.
---
 src/lotus_v2/peer_dispatcher_test/fixtures.h | 4 +++-
 src/lotus_v2/test_reorg_recovery.cpp         | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/peer_dispatcher_test/fixtures.h b/src/lotus_v2/peer_dispatcher_test/fixtures.h
index 8869d6d4c486e1947305227424cd7431e9260ee1..96a9b39d3e0be75d37127855a4b43f7082b1d9ed 100644
--- a/src/lotus_v2/peer_dispatcher_test/fixtures.h
+++ b/src/lotus_v2/peer_dispatcher_test/fixtures.h
@@ -327,7 +327,9 @@ ReorgProfiles Profiles() {
     p.ordinary.coinbase_maturity = 2;
     p.ordinary.dust_limit = 546;
     p.ordinary.max_total_invocation_cost = ~VmCostUnits(0);
-    p.monetary = {20, 17, 10, 65536, 64, 32, 1000000, 1000000000, 546, 1000};
+    // Explicit immutable anchors from this fixture's genesis state.
+    p.monetary = {20, 17, 10, 65536, 64, 32, 1000000, 1000000000, 546, 1000,
+                  1000000, Hash{2}};
     p.cost = {1, 1, 1, 1};
     return p;
 }
diff --git a/src/lotus_v2/test_reorg_recovery.cpp b/src/lotus_v2/test_reorg_recovery.cpp
index db2d718c6af2f5c6a5145fe40a9e09dfe2b58b33..98cee2dd16f25092cbdba490af1671cd9df7c72c 100644
--- a/src/lotus_v2/test_reorg_recovery.cpp
+++ b/src/lotus_v2/test_reorg_recovery.cpp
@@ -494,7 +494,9 @@ ReorgProfiles Profiles() {
     p.ordinary.coinbase_maturity = 2;
     p.ordinary.dust_limit = 546;
     p.ordinary.max_total_invocation_cost = ~VmCostUnits(0);
-    p.monetary = {20, 17, 10, 65536, 64, 32, 1000000, 1000000000, 546, 1000};
+    // Explicit immutable anchors from this fixture's genesis state.
+    p.monetary = {20, 17, 10, 65536, 64, 32, 1000000, 1000000000, 546, 1000,
+                  1000000, Hash{2}};
     p.cost = {1, 1, 1, 1};
     return p;
 }
