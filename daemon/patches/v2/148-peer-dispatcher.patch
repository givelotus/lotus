From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:52:28 -0700
Subject: [PATCH] Route bounded V2 application traffic through runtime and
 shared downloads

---
 src/lotus_v2/peer_dispatcher.cpp | 991 +++++++++++++++++++++++++++++++
 src/lotus_v2/peer_dispatcher.h   | 135 +++++
 2 files changed, 1126 insertions(+)
 create mode 100644 src/lotus_v2/peer_dispatcher.cpp
 create mode 100644 src/lotus_v2/peer_dispatcher.h

diff --git a/src/lotus_v2/peer_dispatcher.cpp b/src/lotus_v2/peer_dispatcher.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f72013de43b7d89bf915846c87aba89b914951d7
--- /dev/null
+++ b/src/lotus_v2/peer_dispatcher.cpp
@@ -0,0 +1,991 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_dispatcher.h"
+#include "development_runtime.h"
+#include <algorithm>
+#include <deque>
+#include <limits>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <utility>
+namespace lotus::v2::peer {
+namespace {
+    struct Guard {
+        bool &busy;
+        explicit Guard(bool &b) : busy(b) { busy = true; }
+        ~Guard() { busy = false; }
+    };
+    bool Deadline(uint64_t now, uint64_t duration, uint64_t &out) {
+        if (duration > UINT64_MAX - now) return false;
+        out = now + duration;
+        return true;
+    }
+    bool RuntimeOk(DevelopmentRuntimeResult r) {
+        return r == DevelopmentRuntimeResult::Progress;
+    }
+} // namespace
+struct PeerDispatcher::Impl {
+    enum class Origin { Control, Headers, Serving, Download };
+    struct Output {
+        Message message;
+        Origin origin;
+        Hash id{};
+        uint64_t deadline{};
+    };
+    struct ServeGuard {
+        uint32_t transactions{};
+        uint64_t deadline{};
+        bool used = false;
+    };
+    struct Peer {
+        Transport *transport;
+        std::optional<PeerHandle> handle;
+        std::optional<Message> input;
+        std::optional<Output> output;
+        std::vector<Header> headers;
+        std::vector<Inventory> inventory;
+        size_t cursor = 0;
+        bool inventory_request = false;
+        bool compact = false, send_headers = false, closed = false;
+        unsigned startup = 0, phase = 0;
+        bool event_ready = false;
+        bool want_headers = false, requested_headers = false,
+             continue_headers = false;
+        Hash stop{}, request_anchor{};
+        std::optional<Hash> header_cursor;
+        uint64_t header_deadline = 0, window_start = 0, window_requests = 0,
+                 window_bytes = 0;
+        std::map<Hash, ServeGuard> serving;
+        std::optional<std::pair<Hash, IndexedHeader>> serving_header;
+    };
+    DevelopmentRuntime &runtime;
+    DownloadManager &downloads;
+    DispatcherConfig config;
+    DispatcherCallbacks callbacks;
+    std::map<ConnectionId, Peer> peers;
+    std::deque<DispatcherNotice> notices;
+    uint64_t next_connection = 0, fetch_epoch, last_ms = 0;
+    ConnectionId peer_cursor{};
+    bool busy = false, have_time = false, authority_lost = false,
+         stopped = false;
+    bool timer_turn = true;
+    std::optional<DispatcherHeaderClock> header_clock;
+    std::optional<CandidateView> binding;
+    std::optional<std::pair<Hash, uint64_t>> active_height;
+    Impl(DevelopmentRuntime &r, DownloadManager &d, DispatcherConfig c,
+         DispatcherCallbacks cb)
+        : runtime(r), downloads(d), config(std::move(c)),
+          callbacks(std::move(cb)), fetch_epoch(config.initial_fetch_epoch) {}
+    bool Room() const { return notices.size() < config.limits.max_notices; }
+    void Notice(DispatcherNoticeKind kind, ConnectionId id,
+                const Hash &hash = {}, std::optional<Header> header = {}) {
+        if (Room()) notices.push_back({kind, id, hash, std::move(header), {}});
+    }
+    void ClosePeer(ConnectionId id, Peer &peer) {
+        if (peer.closed) return;
+        peer.closed = true;
+        peer.transport->Close();
+        if (peer.handle) {
+            downloads.OnDisconnect(*peer.handle);
+            peer.handle.reset();
+        }
+        peer.input.reset();
+        peer.output.reset();
+        peer.headers.clear();
+        peer.inventory.clear();
+        peer.serving.clear();
+        peer.serving_header.reset();
+        peer.want_headers = peer.requested_headers = false;
+        Notice(DispatcherNoticeKind::Closed, id);
+    }
+    bool SetOutput(ConnectionId id, Peer &peer, Message message, Origin origin,
+                   uint64_t now, const Hash &block = {}) {
+        if (peer.output ||
+            message.payload.size() > config.limits.max_pending_message_bytes ||
+            message.payload.size() > peer.transport->ActiveLimit()) {
+            Notice(DispatcherNoticeKind::CapacityRefused, id, block);
+            return false;
+        }
+        uint64_t deadline;
+        if (!Deadline(now, config.limits.output_timeout_ms, deadline)) {
+            ClosePeer(id, peer);
+            return false;
+        }
+        peer.output = Output{std::move(message), origin, block, deadline};
+        return true;
+    }
+    void Download(ConnectionId id, Peer &peer, DownloadEvent event,
+                  uint64_t now) {
+        if (peer.output && peer.output->origin == Origin::Download &&
+            peer.output->id == event.block_id && !event.outbound &&
+            event.result != DownloadResult::Deferred &&
+            event.result != DownloadResult::NeedHeaders)
+            peer.output.reset();
+        if (event.outbound) {
+            auto message = std::move(*event.outbound);
+            event.outbound.reset();
+            if (!SetOutput(id, peer, std::move(message), Origin::Download, now,
+                           event.block_id)) {
+                // An issued action cannot disappear while its job stays live.
+                ClosePeer(id, peer);
+            }
+        }
+        if (Room())
+            notices.push_back({DispatcherNoticeKind::Download,
+                               id,
+                               event.block_id,
+                               {},
+                               std::move(event)});
+    }
+    void InvalidateFetch(uint64_t now) {
+        if (fetch_epoch == UINT64_MAX) {
+            stopped = true;
+            for (auto &[id, p] : peers)
+                ClosePeer(id, p);
+            return;
+        }
+        ++fetch_epoch;
+        auto event = downloads.OnReorg(fetch_epoch);
+        for (auto &[id, p] : peers) {
+            if (p.output && p.output->origin == Origin::Download)
+                p.output.reset();
+            p.input.reset();
+            p.headers.clear();
+            p.inventory.clear();
+            p.cursor = 0;
+            p.serving_header.reset();
+            p.header_cursor.reset();
+            p.want_headers = p.requested_headers = false;
+            // Guards remain for this connection, but an outstanding serve is
+            // retired. Never reenable it or extend its deadline.
+            for (auto &[hash, g] : p.serving) {
+                (void)hash;
+                g.used = true;
+            }
+        }
+        if (Room())
+            notices.push_back({DispatcherNoticeKind::Download,
+                               {},
+                               event.block_id,
+                               {},
+                               std::move(event)});
+        (void)now;
+    }
+    bool Observe(uint64_t now) {
+        const auto snapshot = runtime.Snapshot();
+        if (snapshot.reopen_required || !snapshot.chain) {
+            if (!authority_lost) {
+                InvalidateFetch(now);
+                authority_lost = true;
+            }
+            return false;
+        }
+        const auto &view = *snapshot.chain;
+        if (view.identity != config.network.chain_id ||
+            view.profile_digest != config.network.profile_digest) {
+            stopped = true;
+            for (auto &[id, p] : peers)
+                ClosePeer(id, p);
+            return false;
+        }
+        if (binding && (binding->identity != view.identity ||
+                        binding->profile_digest != view.profile_digest ||
+                        binding->invalid_epoch != view.invalid_epoch))
+            InvalidateFetch(now);
+        binding = view;
+        authority_lost = false;
+        if (active_height && active_height->first != view.stable_tip)
+            active_height.reset();
+        return !stopped;
+    }
+    bool Query(DispatcherUsage &used, const DispatcherBudget &budget,
+               size_t n = 1) {
+        if (n > budget.max_runtime_queries - used.runtime_queries) return false;
+        used.runtime_queries += n;
+        return true;
+    }
+    bool NotFound(ConnectionId id, Peer &peer, uint32_t type, const Hash &hash,
+                  uint64_t now) {
+        Inventory item{type, hash};
+        Bytes payload;
+        std::string error;
+        if (!EncodeInventory(std::span(&item, 1), peer.transport->ActiveLimit(),
+                             payload, error)) {
+            Notice(DispatcherNoticeKind::CapacityRefused, id, hash);
+            return true;
+        }
+        SetOutput(id, peer, {"notfound", std::move(payload)}, Origin::Serving,
+                  now, hash);
+        return true;
+    }
+    bool Rate(Peer &peer, uint64_t now, uint64_t bytes) {
+        const auto &l = config.limits;
+        if (now - peer.window_start >= l.serving_window_ms) {
+            peer.window_start = now;
+            peer.window_requests = peer.window_bytes = 0;
+        }
+        if (peer.window_requests >= l.serving_requests_per_window ||
+            bytes > l.serving_bytes_per_window - peer.window_bytes)
+            return false;
+        return true;
+    }
+    bool Serve(ConnectionId id, Peer &peer, const Inventory &item, uint64_t now,
+               DispatcherUsage &used, const DispatcherBudget &budget,
+               const MissingRequest *missing = nullptr) {
+        if (item.type != 2 && item.type != 4) return true;
+        if (!binding || !peer.handle) return false;
+        std::string error;
+        if (!peer.serving_header || peer.serving_header->first != item.hash) {
+            if (!Query(used, budget)) return false;
+            std::optional<IndexedHeader> indexed;
+            const auto result = runtime.ReadHeader(item.hash, indexed, error);
+            if (!RuntimeOk(result)) {
+                Notice(DispatcherNoticeKind::OperationalFailure, id, item.hash);
+                return true;
+            }
+            if (!indexed || indexed->stage != HeaderStage::Connected)
+                return NotFound(id, peer, 2, item.hash, now);
+            peer.serving_header = std::pair(item.hash, *indexed);
+        }
+        const auto &indexed = peer.serving_header->second;
+        const auto size = indexed.header.size;
+        bool compact = item.type == 4 && peer.compact && !missing;
+        if (compact) {
+            if (!active_height) {
+                if (!Query(used, budget)) return false;
+                std::optional<IndexedHeader> active;
+                if (!RuntimeOk(runtime.ReadHeader(binding->stable_tip, active,
+                                                  error)) ||
+                    !active) {
+                    Notice(DispatcherNoticeKind::OperationalFailure, id,
+                           item.hash);
+                    return true;
+                }
+                active_height =
+                    std::pair(binding->stable_tip, active->header.height);
+            }
+            compact =
+                indexed.header.height <= active_height->second &&
+                active_height->second - indexed.header.height <=
+                    config.limits.compact_near_tip_depth &&
+                !peer.serving.contains(item.hash) &&
+                peer.serving.size() < config.limits.max_compact_guards_per_peer;
+        }
+        if (size > config.limits.max_serving_body_bytes ||
+            (!compact && !missing && size > peer.transport->ActiveLimit()) ||
+            size > budget.max_served_bytes - used.served_bytes ||
+            !Rate(peer, now, size))
+            return NotFound(id, peer, 2, item.hash, now);
+        // ReadHeader and the optional active-tip lookup persist across ticks;
+        // a positive one-query budget can eventually reach this body read.
+        if (!Query(used, budget)) return false;
+        const auto &l = config.limits;
+        const ResourceNeed need{4 * l.max_serving_body_bytes +
+                                    2 * uint64_t(peer.transport->ActiveLimit()),
+                                4 * l.max_serving_transactions};
+        auto reservation = callbacks.reserve_serving(*peer.handle, need);
+        if (reservation.disposition != ReservationDisposition::Granted ||
+            !reservation.lease)
+            return NotFound(id, peer, 2, item.hash, now);
+        // Lease precedes disk body copying, full decoding and output creation.
+        Bytes body;
+        const auto result = runtime.ReadConnectedBody(
+            item.hash, std::min(size, l.max_serving_body_bytes), body, error);
+        if (!RuntimeOk(result)) return NotFound(id, peer, 2, item.hash, now);
+        used.served_bytes += body.size();
+        ++peer.window_requests;
+        peer.window_bytes += body.size();
+        if (body.size() != size) {
+            Notice(DispatcherNoticeKind::OperationalFailure, id, item.hash);
+            return true;
+        }
+        Message response;
+        if (compact || missing) {
+            if (body.size() < HEADER_SIZE + 4)
+                return NotFound(id, peer, 2, item.hash, now);
+            uint32_t count = 0;
+            for (unsigned i = 0; i < 4; ++i)
+                count |= uint32_t(body[HEADER_SIZE + i]) << (8 * i);
+            if (count > l.max_serving_transactions)
+                return NotFound(id, peer, 2, item.hash, now);
+            FramedBlock decoded;
+            if (!DecodeBlockWire(body, config.network.transaction,
+                                 config.network.chain_id, decoded, error)) {
+                Notice(DispatcherNoticeKind::OperationalFailure, id, item.hash);
+                return true;
+            }
+            if (missing) {
+                MissingResponse reply;
+                reply.block_id = item.hash;
+                for (const auto index : missing->indices) {
+                    if (index >= decoded.transactions.size())
+                        return NotFound(id, peer, 2, item.hash, now);
+                    reply.transactions.push_back(decoded.transactions[index]);
+                }
+                Bytes bytes;
+                if (!EncodeMissingResponse(reply, config.network,
+                                           peer.transport->ActiveLimit(), bytes,
+                                           error))
+                    return NotFound(id, peer, 2, item.hash, now);
+                response = {"blocktxn", std::move(bytes)};
+            } else {
+                uint64_t nonce;
+                CompactBlock block;
+                Bytes bytes;
+                const uint32_t zero = 0;
+                if (!callbacks.compact_nonce(nonce)) {
+                    Notice(DispatcherNoticeKind::OperationalFailure, id,
+                           item.hash);
+                    return true;
+                }
+                if (MakeCompact(decoded, config.network, nonce,
+                                std::span(&zero, 1), block, error) &&
+                    EncodeCompact(block, config.network,
+                                  peer.transport->ActiveLimit(), bytes,
+                                  error)) {
+                    uint64_t deadline;
+                    if (!Deadline(now, l.serving_timeout_ms, deadline)) {
+                        ClosePeer(id, peer);
+                        return true;
+                    }
+                    peer.serving.emplace(item.hash,
+                                         ServeGuard{count, deadline, false});
+                    response = {"cmpctblock", std::move(bytes)};
+                }
+            }
+        }
+        if (response.command.empty()) {
+            if (body.size() > peer.transport->ActiveLimit())
+                return NotFound(id, peer, 2, item.hash, now);
+            response = {"block", std::move(body)};
+        }
+        SetOutput(id, peer, std::move(response), Origin::Serving, now,
+                  item.hash);
+        return true;
+    }
+    bool Input(ConnectionId id, Peer &peer, uint64_t now, DispatcherUsage &used,
+               const DispatcherBudget &budget) {
+        if (peer.output || !Room()) return false;
+        if (!peer.headers.empty()) {
+            if (used.header_admissions >= budget.max_header_admissions ||
+                !Query(used, budget))
+                return false;
+            const auto header = peer.headers[peer.cursor];
+            HeaderAdmission admission;
+            std::string error;
+            ++used.header_admissions;
+            const auto result = runtime.AdmitHeader(header, admission, error);
+            if (result == DevelopmentRuntimeResult::Inconclusive ||
+                result == DevelopmentRuntimeResult::Busy)
+                return false;
+            if (!RuntimeOk(result)) {
+                Notice(DispatcherNoticeKind::OperationalFailure, id);
+                peer.headers.clear();
+                peer.cursor = 0;
+                return true;
+            }
+            Hash hash;
+            BlockId(config.network.chain_id, header, hash);
+            if (admission == HeaderAdmission::MissingParent) {
+                Notice(DispatcherNoticeKind::NeedHeaders, id, header.prev_id);
+                peer.headers.clear();
+                peer.cursor = 0;
+                peer.requested_headers = false;
+                peer.want_headers = true;
+                return true;
+            }
+            if (admission == HeaderAdmission::Invalid) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            peer.header_cursor = hash;
+            Notice(DispatcherNoticeKind::HeaderAvailable, id, hash, header);
+            if (++peer.cursor == peer.headers.size()) {
+                const bool progress = hash != peer.request_anchor;
+                peer.headers.clear();
+                peer.cursor = 0;
+                peer.requested_headers = false;
+                peer.want_headers = peer.continue_headers && progress;
+                if (!peer.want_headers)
+                    Notice(DispatcherNoticeKind::HeadersComplete, id, hash);
+            }
+            return true;
+        }
+        if (!peer.inventory.empty()) {
+            const auto item = peer.inventory[peer.cursor];
+            if (peer.inventory_request) {
+                if (!Serve(id, peer, item, now, used, budget)) return false;
+                peer.serving_header.reset();
+            } else if (item.type == 2 || item.type == 4) {
+                if (!Query(used, budget)) return false;
+                std::optional<IndexedHeader> indexed;
+                std::string error;
+                if (!RuntimeOk(runtime.ReadHeader(item.hash, indexed, error)))
+                    Notice(DispatcherNoticeKind::OperationalFailure, id,
+                           item.hash);
+                else if (indexed)
+                    Notice(DispatcherNoticeKind::HeaderAvailable, id, item.hash,
+                           indexed->header);
+                else {
+                    peer.want_headers = true;
+                    peer.stop = item.hash;
+                    Notice(DispatcherNoticeKind::NeedHeaders, id, item.hash);
+                }
+            }
+            if (++peer.cursor == peer.inventory.size()) {
+                peer.inventory.clear();
+                peer.cursor = 0;
+            }
+            return true;
+        }
+        if (!peer.input) return false;
+        auto &message = *peer.input;
+        const auto &command = message.command;
+        std::string error;
+        const uint32_t limit = peer.transport->ActiveLimit();
+        if (command == "block" || command == "cmpctblock" ||
+            command == "blocktxn" || command == "notfound") {
+            auto event = downloads.OnMessage(*peer.handle, message, now);
+            ++used.download_actions;
+            peer.input.reset();
+            Download(id, peer, std::move(event), now);
+            return true;
+        }
+        if (command == "headers") {
+            const uint64_t cap =
+                CompactSizeWidth(config.limits.max_header_items) +
+                135ULL * config.limits.max_header_items;
+            if (message.payload.size() > cap) {
+                Notice(DispatcherNoticeKind::CapacityRefused, id);
+                peer.input.reset();
+                return true;
+            }
+            if (!DecodeHeaders(message.payload, limit, peer.headers, error)) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            for (size_t i = 1; i < peer.headers.size(); ++i) {
+                Hash parent;
+                if (!BlockId(config.network.chain_id, peer.headers[i - 1],
+                             parent) ||
+                    peer.headers[i].prev_id != parent) {
+                    ClosePeer(id, peer);
+                    return true;
+                }
+            }
+            peer.continue_headers = peer.requested_headers;
+            peer.input.reset();
+            peer.cursor = 0;
+            if (peer.headers.empty()) {
+                peer.requested_headers = false;
+                peer.want_headers = false;
+                Notice(DispatcherNoticeKind::HeadersComplete, id);
+            }
+            return true;
+        }
+        if (command == "inv" || command == "getdata") {
+            const uint64_t cap =
+                CompactSizeWidth(config.limits.max_inventory_items) +
+                36ULL * config.limits.max_inventory_items;
+            if (message.payload.size() > cap) {
+                Notice(DispatcherNoticeKind::CapacityRefused, id);
+                peer.input.reset();
+                return true;
+            }
+            if (!DecodeInventory(message.payload, limit, peer.inventory,
+                                 error)) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            peer.inventory_request = command == "getdata";
+            peer.input.reset();
+            peer.cursor = 0;
+            return true;
+        }
+        if (command == "getheaders") {
+            if (!binding || !Query(used, budget)) return false;
+            Locator locator;
+            if (!DecodeLocator(message.payload, limit, locator, error)) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            size_t count =
+                std::min<size_t>(config.limits.max_header_items, limit / 135);
+            while (count && CompactSizeWidth(count) + 135 * count > limit)
+                --count;
+            if (!count) {
+                Notice(DispatcherNoticeKind::CapacityRefused, id);
+                peer.input.reset();
+                return true;
+            }
+            std::vector<Header> headers;
+            DiskStateError e;
+            auto result =
+                runtime.ReadHeaders(binding->stable_tip, locator.ids,
+                                    locator.stop, 101, count, headers, e);
+            if (result == ChainIndexResult::StaleTip) return false;
+            if (result != ChainIndexResult::Complete) {
+                Notice(DispatcherNoticeKind::OperationalFailure, id);
+                peer.input.reset();
+                return true;
+            }
+            Bytes payload;
+            if (!EncodeHeaders(headers, limit, payload, error)) {
+                Notice(DispatcherNoticeKind::CapacityRefused, id);
+                peer.input.reset();
+                return true;
+            }
+            peer.input.reset();
+            SetOutput(id, peer, {"headers", std::move(payload)},
+                      Origin::Headers, now);
+            return true;
+        }
+        if (command == "getblocktxn") {
+            if (message.payload.size() < 32) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            Hash hash;
+            std::copy_n(message.payload.begin(), 32, hash.begin());
+            auto found = peer.serving.find(hash);
+            if (found == peer.serving.end() || found->second.used ||
+                now >= found->second.deadline) {
+                peer.input.reset();
+                return NotFound(id, peer, 2, hash, now);
+            }
+            MissingRequest request;
+            if (!DecodeMissingRequest(message.payload,
+                                      found->second.transactions,
+                                      config.limits.max_serving_transactions,
+                                      limit, request, error)) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            if (!Serve(id, peer, Inventory{2, hash}, now, used, budget,
+                       &request))
+                return false;
+            peer.serving_header.reset();
+            if (auto current = peer.serving.find(hash);
+                current != peer.serving.end())
+                current->second.used = true;
+            peer.input.reset();
+            return true;
+        }
+        if (command == "sendcmpct") {
+            SendCompact compact;
+            if (!DecodeSendCompact(message.payload, compact, error)) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            if (compact.version == 2) peer.compact = true;
+        } else if (command == "sendheaders") {
+            if (!message.payload.empty()) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            peer.send_headers = true;
+        } else if (command == "ping") {
+            if (message.payload.size() != 8) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            Message pong{"pong", std::move(message.payload)};
+            peer.input.reset();
+            SetOutput(id, peer, std::move(pong), Origin::Control, now);
+            return true;
+        }
+        // Transaction relay, discovery and getblocks are explicitly unavailable
+        // in this bounded block-sync packet; unknown optional commands ignore.
+        peer.input.reset();
+        return true;
+    }
+    bool Controls(ConnectionId id, Peer &peer, uint64_t now,
+                  DispatcherUsage &used, const DispatcherBudget &budget) {
+        if (peer.output || peer.input || !peer.headers.empty() ||
+            !peer.inventory.empty())
+            return false;
+        if (peer.startup) {
+            Bytes payload;
+            std::string error;
+            if (peer.startup == 1) {
+                ++peer.startup;
+                SetOutput(id, peer, {"sendheaders", {}}, Origin::Control, now);
+                return true;
+            }
+            peer.startup = 0;
+            if (!EncodeSendCompact({false, 2}, payload, error)) {
+                ClosePeer(id, peer);
+                return true;
+            }
+            SetOutput(id, peer, {"sendcmpct", std::move(payload)},
+                      Origin::Control, now);
+            return true;
+        }
+        if (!peer.want_headers || peer.requested_headers || !binding ||
+            !Query(used, budget))
+            return false;
+        std::vector<Hash> ids;
+        DiskStateError e;
+        const auto result =
+            runtime.BuildLocator(binding->stable_tip, 101, ids, e);
+        if (result == ChainIndexResult::StaleTip) return false;
+        if (result != ChainIndexResult::Complete) {
+            Notice(DispatcherNoticeKind::OperationalFailure, id);
+            peer.want_headers = false;
+            return true;
+        }
+        if (peer.header_cursor &&
+            (ids.empty() || ids.front() != *peer.header_cursor)) {
+            if (ids.size() >= 101) ids.erase(ids.begin() + ids.size() - 2);
+            ids.insert(ids.begin(), *peer.header_cursor);
+        }
+        Locator locator{MIN_V2_PEER_VERSION, std::move(ids), peer.stop};
+        Bytes payload;
+        std::string error;
+        if (!EncodeLocator(locator, peer.transport->ActiveLimit(), payload,
+                           error)) {
+            Notice(DispatcherNoticeKind::CapacityRefused, id);
+            peer.want_headers = false;
+            return true;
+        }
+        uint64_t deadline;
+        if (!Deadline(now, config.limits.header_timeout_ms, deadline)) {
+            ClosePeer(id, peer);
+            return true;
+        }
+        peer.request_anchor = peer.header_cursor.value_or(binding->stable_tip);
+        peer.requested_headers = true;
+        peer.want_headers = false;
+        peer.header_deadline = deadline;
+        SetOutput(id, peer, {"getheaders", std::move(payload)}, Origin::Headers,
+                  now);
+        return true;
+    }
+};
+PeerDispatcher::PeerDispatcher(DevelopmentRuntime &runtime,
+                               DownloadManager &downloads,
+                               DispatcherConfig config,
+                               DispatcherCallbacks callbacks) {
+    const auto &l = config.limits;
+    if (!config.network.receive_limit ||
+        config.network.receive_limit > MAX_RECEIVE_LIMIT || !l.max_peers ||
+        !l.max_notices || !l.max_inventory_items ||
+        l.max_inventory_items > 50000 || !l.max_header_items ||
+        l.max_header_items > 2000 || !l.max_payload_bytes ||
+        l.max_payload_bytes < config.network.receive_limit ||
+        l.max_pending_message_bytes < config.network.receive_limit ||
+        !l.max_serving_transactions ||
+        l.max_serving_transactions > UINT32_MAX / 4 ||
+        !l.max_compact_guards_per_peer || !l.max_serving_body_bytes ||
+        l.max_serving_body_bytes >
+            (UINT64_MAX - 2 * uint64_t(config.network.receive_limit)) / 4 ||
+        !l.header_timeout_ms || !l.output_timeout_ms || !l.serving_timeout_ms ||
+        !l.serving_window_ms || !l.serving_requests_per_window ||
+        !l.serving_bytes_per_window || !callbacks.reserve_serving ||
+        !callbacks.compact_nonce)
+        throw std::invalid_argument(
+            "peer dispatcher explicit limits/callbacks");
+    impl_ = std::make_unique<Impl>(runtime, downloads, std::move(config),
+                                   std::move(callbacks));
+}
+PeerDispatcher::~PeerDispatcher() noexcept {
+    if (!impl_) return;
+    auto &s = *impl_;
+    s.busy = true;
+    for (auto &[id, peer] : s.peers) {
+        (void)id;
+        peer.transport->Close();
+        if (peer.handle) try {
+                s.downloads.OnDisconnect(*peer.handle);
+            } catch (...) {
+            }
+    }
+}
+DispatcherResult PeerDispatcher::Attach(Transport &transport,
+                                        ConnectionId &out) {
+    auto &s = *impl_;
+    if (s.busy) return DispatcherResult::Busy;
+    Guard guard(s.busy);
+    if (s.stopped) return DispatcherResult::Closed;
+    if (transport.State() != SessionState::New)
+        return DispatcherResult::InvalidConfiguration;
+    if (s.peers.size() >= s.config.limits.max_peers ||
+        s.next_connection == UINT64_MAX)
+        return DispatcherResult::CapacityRefused;
+    for (const auto &[id, p] : s.peers) {
+        (void)id;
+        if (p.transport == &transport)
+            return DispatcherResult::InvalidConfiguration;
+    }
+    try {
+        ConnectionId id{s.next_connection + 1};
+        Impl::Peer peer;
+        peer.transport = &transport;
+        s.peers.emplace(id, std::move(peer));
+        s.next_connection = id.value;
+        out = id;
+        return DispatcherResult::Queued;
+    } catch (const std::bad_alloc &) {
+        return DispatcherResult::CapacityRefused;
+    }
+}
+DispatcherResult PeerDispatcher::Open(ConnectionId id, uint64_t now) {
+    auto &s = *impl_;
+    if (s.busy) return DispatcherResult::Busy;
+    Guard guard(s.busy);
+    auto found = s.peers.find(id);
+    if (found == s.peers.end()) return DispatcherResult::UnknownPeer;
+    if (!found->second.transport->Open(now)) return DispatcherResult::Closed;
+    found->second.window_start = now;
+    return DispatcherResult::Queued;
+}
+DispatcherResult PeerDispatcher::Remove(ConnectionId id) {
+    auto &s = *impl_;
+    if (s.busy) return DispatcherResult::Busy;
+    Guard guard(s.busy);
+    const auto found = s.peers.find(id);
+    if (found == s.peers.end()) return DispatcherResult::UnknownPeer;
+    try {
+        s.ClosePeer(id, found->second);
+        s.peers.erase(found);
+        return DispatcherResult::Queued;
+    } catch (...) {
+        s.peers.erase(found);
+        return DispatcherResult::OperationalFailure;
+    }
+}
+DispatcherResult PeerDispatcher::StartHeaders(ConnectionId id, const Hash &stop,
+                                              uint64_t now) {
+    auto &s = *impl_;
+    if (s.busy) return DispatcherResult::Busy;
+    Guard guard(s.busy);
+    const auto found = s.peers.find(id);
+    if (found == s.peers.end()) return DispatcherResult::UnknownPeer;
+    auto &peer = found->second;
+    if (peer.transport->State() == SessionState::Closed)
+        return DispatcherResult::Closed;
+    if (peer.want_headers || peer.requested_headers)
+        return DispatcherResult::Busy;
+    uint64_t deadline;
+    if (!Deadline(now, s.config.limits.header_timeout_ms, deadline))
+        return DispatcherResult::InvalidConfiguration;
+    peer.want_headers = true;
+    peer.stop = stop;
+    return DispatcherResult::Queued;
+}
+DispatcherResult PeerDispatcher::RequestBlock(ConnectionId id,
+                                              const Header &header,
+                                              DownloadMode mode, uint64_t now) {
+    auto &s = *impl_;
+    if (s.busy) return DispatcherResult::Busy;
+    Guard guard(s.busy);
+    const auto found = s.peers.find(id);
+    if (found == s.peers.end()) return DispatcherResult::UnknownPeer;
+    auto &peer = found->second;
+    if (!peer.handle || peer.transport->State() != SessionState::Active)
+        return DispatcherResult::Closed;
+    if (peer.output || !s.Room()) return DispatcherResult::CapacityRefused;
+    if (!s.Observe(now)) return DispatcherResult::OperationalFailure;
+    try {
+        auto event = s.downloads.RequestBlock(*peer.handle, header, mode, now);
+        const bool issued = event.result == DownloadResult::Requested ||
+                            event.result == DownloadResult::Deferred ||
+                            event.result == DownloadResult::NeedHeaders;
+        s.Download(id, peer, std::move(event), now);
+        return issued ? DispatcherResult::Queued
+                      : DispatcherResult::CapacityRefused;
+    } catch (...) {
+        s.ClosePeer(id, peer);
+        return DispatcherResult::OperationalFailure;
+    }
+}
+std::optional<DispatcherNotice> PeerDispatcher::TakeNotice() {
+    auto &s = *impl_;
+    if (s.busy || s.notices.empty()) return std::nullopt;
+    Guard guard(s.busy);
+    auto notice = std::move(s.notices.front());
+    s.notices.pop_front();
+    return notice;
+}
+uint64_t PeerDispatcher::FetchEpoch() const {
+    return impl_->fetch_epoch;
+}
+std::optional<PeerHandle> PeerDispatcher::Handle(ConnectionId id) const {
+    const auto found = impl_->peers.find(id);
+    return found == impl_->peers.end() ? std::nullopt : found->second.handle;
+}
+DispatcherUsage PeerDispatcher::Tick(uint64_t now, uint64_t wall,
+                                     uint64_t window,
+                                     const DispatcherBudget &budget) {
+    auto &s = *impl_;
+    DispatcherUsage used;
+    if (s.busy || s.stopped || !budget.max_actions) return used;
+    Guard guard(s.busy);
+    try {
+        if (s.have_time && now < s.last_ms) {
+            s.stopped = true;
+            for (auto &[id, p] : s.peers)
+                s.ClosePeer(id, p);
+            return used;
+        }
+        s.have_time = true;
+        s.last_ms = now;
+        if (!s.Observe(now)) return used;
+        // Expose the caller sample to coordinator-owned manager callbacks.
+        // Never derive wall eligibility seconds from monotonic milliseconds.
+        s.header_clock = DispatcherHeaderClock{wall, window};
+        bool timer_done = false;
+        auto step_peer = [&](ConnectionId id, Impl::Peer &peer) {
+            if (peer.transport->State() == SessionState::Closed) {
+                if (!peer.closed) {
+                    ++used.actions;
+                    s.ClosePeer(id, peer);
+                    return true;
+                }
+                return false;
+            }
+            if ((peer.output && now >= peer.output->deadline) ||
+                (peer.requested_headers && now >= peer.header_deadline)) {
+                ++used.actions;
+                s.ClosePeer(id, peer);
+                return true;
+            }
+            // At most one actual action; skipped phases consume no budget.
+            // Persist the phase so tiny budgets eventually feed and dispatch,
+            // instead of repeatedly polling an idle transport or Input method.
+            for (unsigned attempts = 0; attempts < 5; ++attempts) {
+                const auto phase = peer.phase;
+                peer.phase = (peer.phase + 1) % 5;
+                if (phase == 0) {
+                    if (used.transport_actions >= budget.transport.max_actions)
+                        continue;
+                    const TransportBudget available{
+                        budget.transport.max_actions - used.transport_actions,
+                        budget.transport.max_io_bytes - used.read_bytes -
+                            used.written_bytes,
+                        budget.transport.max_feed_bytes - used.fed_bytes};
+                    ++used.actions;
+                    const auto p = peer.transport->Poll(now, available);
+                    used.transport_actions += p.actions;
+                    used.io_calls += p.io_calls;
+                    used.read_bytes += p.read_bytes;
+                    used.written_bytes += p.written_bytes;
+                    used.fed_bytes += p.fed_bytes;
+                    peer.event_ready = p.event_pending;
+                    if (p.closed != TransportClose::None) s.ClosePeer(id, peer);
+                    return true;
+                }
+                if (phase == 1 && peer.output) {
+                    ++used.actions;
+                    const auto result =
+                        peer.transport->QueueMessage(peer.output->message, now);
+                    if (result == QueueResult::Queued)
+                        peer.output.reset();
+                    else if (result != QueueResult::Backpressure)
+                        s.ClosePeer(id, peer);
+                    return true;
+                }
+                if (phase == 2 && peer.event_ready && s.Room() && !peer.input &&
+                    peer.headers.empty() && peer.inventory.empty() &&
+                    !peer.output) {
+                    ++used.actions;
+                    auto event = peer.transport->TakeEvent();
+                    peer.event_ready = false;
+                    if (!event) return true;
+                    if (event->result == SessionResult::Activated) {
+                        if (peer.handle) {
+                            s.ClosePeer(id, peer);
+                            return true;
+                        }
+                        auto registration = s.downloads.RegisterPeer(
+                            peer.transport->ActiveLimit());
+                        ++used.download_actions;
+                        if (registration.result != DownloadResult::Registered) {
+                            s.ClosePeer(id, peer);
+                            return true;
+                        }
+                        peer.handle = registration.peer;
+                        peer.startup = 1;
+                        if (s.config.auto_start_headers)
+                            peer.want_headers = true;
+                        s.Notice(DispatcherNoticeKind::Activated, id);
+                    } else if (event->application) {
+                        if (event->application->payload.size() >
+                            s.config.limits.max_payload_bytes)
+                            s.Notice(DispatcherNoticeKind::CapacityRefused, id);
+                        else
+                            peer.input = std::move(*event->application);
+                    }
+                    return true;
+                }
+                if (phase == 3 && peer.handle && !peer.output && s.Room() &&
+                    (peer.input || !peer.headers.empty() ||
+                     !peer.inventory.empty())) {
+                    ++used.actions;
+                    s.Input(id, peer, now, used, budget);
+                    return true;
+                }
+                if (phase == 4 && peer.handle && !peer.output && s.Room() &&
+                    (peer.startup ||
+                     (peer.want_headers && !peer.requested_headers))) {
+                    ++used.actions;
+                    s.Controls(id, peer, now, used, budget);
+                    return true;
+                }
+            }
+            return false;
+        };
+        while (used.actions < budget.max_actions) {
+            if (s.timer_turn && !timer_done && s.Room()) {
+                ++used.actions;
+                ++used.download_actions;
+                auto event = s.downloads.PollTimeout(now);
+                s.timer_turn = false;
+                if (event.result == DownloadResult::Idle)
+                    timer_done = true;
+                else {
+                    auto found = std::find_if(
+                        s.peers.begin(), s.peers.end(), [&](const auto &p) {
+                            return p.second.handle == event.peer;
+                        });
+                    if (found != s.peers.end())
+                        s.Download(found->first, found->second,
+                                   std::move(event), now);
+                }
+                continue;
+            }
+            bool executed = false;
+            auto next = s.peers.upper_bound(s.peer_cursor);
+            if (next == s.peers.end()) next = s.peers.begin();
+            for (size_t visited = 0; visited < s.peers.size(); ++visited) {
+                auto current = next++;
+                if (next == s.peers.end()) next = s.peers.begin();
+                auto &[id, peer] = *current;
+                if (step_peer(id, peer)) {
+                    s.peer_cursor = id;
+                    s.timer_turn = true;
+                    executed = true;
+                    break;
+                }
+            }
+            if (!executed) {
+                if (!timer_done && s.Room()) {
+                    s.timer_turn = true;
+                    continue;
+                }
+                break;
+            }
+        }
+    } catch (...) {
+        // No consensus conclusion follows from allocation/backend/callback
+        // failure. Disable this dispatcher and release all registered work.
+        s.stopped = true;
+        for (auto &[id, p] : s.peers)
+            try {
+                s.ClosePeer(id, p);
+            } catch (...) {
+            }
+    }
+    return used;
+}
+} // namespace lotus::v2::peer
