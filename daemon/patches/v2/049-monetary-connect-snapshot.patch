+// the in-memory result unchanged. DisconnectOrdinaryBlock does not touch
+// either store. This does not accept a block and is not ConnectTip.
 bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
                           const OrdinaryParentContext &parent,
                           const OrdinaryCandidateProfile &profile,
@@ -71,7 +83,8 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
