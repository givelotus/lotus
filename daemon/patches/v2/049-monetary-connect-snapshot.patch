 src/lotus_v2/block.h                       |  19 +-
 src/lotus_v2/block_test/CMakeLists.txt     |  26 +-
 src/lotus_v2/test_block_monetary_store.cpp | 572 +++++++++++++++++++++
 4 files changed, 630 insertions(+), 8 deletions(-)
 create mode 100644 src/lotus_v2/test_block_monetary_store.cpp

