 #include "block.h"
 
+#include "persistent_monetary.h"
 #include "persistent_utxo.h"
 
 #include <limits>
@@ -171,7 +172,8 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
                           DevelopmentUtxoView &view, IncrementalUtxoSet &utxo,
                           MonetaryState &monetary,
                           OrdinaryBlockConnected &connected,
-                          std::string &error, PersistentUtxoStore *store) {
+                          std::string &error, PersistentUtxoStore *store,
+                          PersistentMonetaryStore *monetary_store) {
     if (parent.header.height == std::numeric_limits<uint64_t>::max() ||
         profile.candidate_height != parent.header.height + 1 ||
         profile.parent_mtp != parent.header.time ||
@@ -329,6 +331,23 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
         DisconnectOrdinaryBlock(staged.undo, view, utxo, monetary, ignored);
         return false;
     }
+    // One record for the accepted block. Not per transaction, and not atomic
+    // with the UTXO snapshot renames. A null pointer skips it.
+    if (monetary_store != nullptr) {
+        std::string money_error;
+        if (!monetary_store->Commit(parent.chain_id, profile.candidate_height,
+                                    monetary, staged.state_root, money_error)) {
+            error = std::move(money_error);
+            undo_store(error);
+            std::string undo_error;
+            if (!DisconnectOrdinaryBlock(staged.undo, view, utxo, monetary,
+                                         undo_error)) {
+                error += "; undo failed: ";
+                error += undo_error;
+            }
+            return false;
+        }
+    }
     connected = std::move(staged);
     error.clear();
     return true;
