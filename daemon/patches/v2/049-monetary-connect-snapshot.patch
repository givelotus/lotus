diff --git a/src/lotus_v2/test_block_monetary_store.cpp b/src/lotus_v2/test_block_monetary_store.cpp
new file mode 100644
index 000000000..8c0d8ebd3
--- /dev/null
+++ b/src/lotus_v2/test_block_monetary_store.cpp
@@ -0,0 +1,572 @@
+// Copyright (c) 2026 The Lotus developers
+// File-backed monetary snapshot after an ordinary connect. Not lotusd
+// ConnectTip and not a claim that a block was accepted.
+#include "block.h"
+
+#include "persistent_monetary.h"
+#include "persistent_utxo.h"
+#include "signing.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits.h>
+#include <stdexcept>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+const std::vector<uint8_t> PUSH_ZERO{0x00};
+const MonetaryProfile kMonetary{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000};
+
+OrdinaryCandidateProfile MakeProfile(VmCostUnits block_cap) {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, 100, 50000, 2, 3, block_cap};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+Hash Chain() {
+    Hash chain{};
+    for (size_t i = 0; i < chain.size(); ++i)
+        chain[i] = static_cast<uint8_t>(i);
+    return chain;
+}
+
+MonetaryState InitialMoney() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Coin MakeFunding(uint8_t tag, uint32_t index, uint64_t value, const Hash &branch) {
+    Coin coin;
+    coin.outpoint.tx_id[0] = tag;
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = value;
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = 90;
+    coin.creation_parent_mtp = 49000;
+    coin.coinbase = false;
+    return coin;
+}
+
+Transaction Payment(const Outpoint &spent, uint64_t value,
+                    const std::vector<uint8_t> &witness = TRUE_SCRIPT) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{witness, {}, {}}};
+    tx.inputs.push_back(input);
+    Output output;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    tx.outputs.push_back(output);
+    return tx;
+}
+
+struct World {
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary = InitialMoney();
+    OrdinaryParentContext parent;
+    Hash branch = BranchLeaf(TRUE_SCRIPT);
+    Coin funding;
+    Coin other;
+    World()
+        : funding(MakeFunding(0x71, 3, 20000, branch)),
+          other(MakeFunding(0x72, 1, 8000, branch)) {
+        Check(view.emplace(funding.outpoint, funding).second &&
+                  view.emplace(other.outpoint, other).second &&
+                  utxo.Insert(funding) && utxo.Insert(other),
+              "parent coins");
+        parent.chain_id = Chain();
+        parent.monetary = monetary;
+        parent.header.height = 99;
+        parent.header.time = 50000;
+        parent.header.version = 1;
+        parent.header.size = HEADER_SIZE;
+        parent.header.state_root = StateRoot(
+            parent.chain_id, parent.header.height, utxo.Root(), monetary);
+    }
+};
+
+struct ParentBytes {
+    std::vector<std::vector<uint8_t>> coins;
+    Hash utxo{};
+    std::array<uint8_t, 56> monetary{};
+};
+
+ParentBytes Capture(const World &world) {
+    ParentBytes snap;
+    for (const auto &entry : world.view) {
+        Check(entry.first == entry.second.outpoint, "view outpoint");
+        std::vector<uint8_t> encoded;
+        Check(EncodeCoin(entry.second, encoded), "encode coin");
+        snap.coins.push_back(std::move(encoded));
+    }
+    snap.utxo = world.utxo.Root();
+    snap.monetary = EncodeMonetaryState(world.monetary);
+    return snap;
+}
+
+void ExpectParent(const World &world, const ParentBytes &parent,
+                  const std::string &where) {
+    const ParentBytes now = Capture(world);
+    Check(now.coins == parent.coins, where + " view is not the parent coins");
+    Check(now.utxo == parent.utxo, where + " utxo root moved");
+    Check(now.monetary == parent.monetary, where + " monetary bytes moved");
+}
+
+std::filesystem::path TempDir() {
+    char templ[] = "/tmp/lotus-v2-block-monetary-XXXXXX";
+    Check(::mkdtemp(templ) != nullptr, "mkdtemp");
+    const std::string path(templ);
+    Check(path.rfind("/tmp/", 0) == 0, "temporary directory is under /tmp");
+    Check(path.find("..") == std::string::npos, "temporary path has no parent segment");
+    Check(path.find(".lotus") == std::string::npos &&
+              path.find("datadir") == std::string::npos,
+          "temporary path is not a datadir");
+    char resolved[PATH_MAX];
+    Check(::realpath(path.c_str(), resolved) != nullptr, "realpath");
+    const std::string absolute(resolved);
+    Check(absolute.rfind("/tmp/", 0) == 0 ||
+              absolute.rfind("/private/tmp/", 0) == 0,
+          "resolved temporary directory stays under /tmp");
+    return std::filesystem::path(absolute);
+}
+
+std::vector<uint8_t> ReadRaw(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    Check(static_cast<bool>(in), "read " + path.string());
+    return std::vector<uint8_t>(std::istreambuf_iterator<char>(in),
+                                std::istreambuf_iterator<char>());
+}
+
+size_t DatFiles(const std::filesystem::path &directory) {
+    size_t count = 0;
+    if (!std::filesystem::exists(directory)) return 0;
+    for (const auto &entry : std::filesystem::directory_iterator(directory)) {
+        if (entry.is_regular_file() && entry.path().extension() == ".dat")
+            ++count;
+    }
+    return count;
+}
+
+Hash StoreRoot(const PersistentUtxoStore &store) {
+    Hash root{};
+    Check(store.Root(root), "utxo store root");
+    return root;
+}
+
+std::array<uint8_t, 56> StoreMoney(const PersistentMonetaryStore &store) {
+    std::array<uint8_t, 56> money{};
+    Check(store.Monetary(money), "monetary store bytes");
+    return money;
+}
+
+Hash StoreState(const PersistentMonetaryStore &store) {
+    Hash root{};
+    Check(store.Root(root), "monetary store state root");
+    return root;
+}
+
+void SeedUtxo(PersistentUtxoStore &store, const World &world) {
+    std::vector<Coin> coins;
+    coins.reserve(world.view.size());
+    for (const auto &entry : world.view) coins.push_back(entry.second);
+    std::string error;
+    Check(store.Commit({}, coins, error), "seed parent coins: " + error);
+    Check(StoreRoot(store) == world.utxo.Root(), "seeded utxo root");
+}
+
+void SeedMonetary(PersistentMonetaryStore &store, const World &world) {
+    std::string error;
+    Check(store.Commit(world.parent.chain_id, world.parent.header.height,
+                       world.parent.monetary, world.parent.header.state_root,
+                       error),
+          "seed parent monetary: " + error);
+    Check(StoreMoney(store) == EncodeMonetaryState(world.monetary),
+          "seeded monetary bytes");
+    Check(StoreState(store) == world.parent.header.state_root,
+          "seeded state root");
+}
+
+struct StoredRecord {
+    ChainId chain{};
+    uint64_t height = 0;
+    std::array<uint8_t, 56> monetary{};
+    Hash state_root{};
+};
+
+StoredRecord ReadRecord(const std::filesystem::path &file) {
+    const std::vector<uint8_t> bytes = ReadRaw(file);
+    Check(bytes.size() == 24 + PERSISTENT_MONETARY_SNAPSHOT_BYTES + 32,
+          "monetary record size");
+    Check(std::string(bytes.begin(), bytes.begin() + 8) == "LTSV2MON",
+          "monetary magic");
+    StoredRecord stored;
+    std::copy_n(bytes.begin() + 24, 32, stored.chain.begin());
+    for (unsigned i = 0; i < 8; ++i)
+        stored.height |= uint64_t(bytes[56 + i]) << (8 * i);
+    std::copy_n(bytes.begin() + 64, 56, stored.monetary.begin());
+    std::copy_n(bytes.begin() + 120, 32, stored.state_root.begin());
+    return stored;
+}
+
+struct Built {
+    Transaction first;
+    Transaction second;
+    OrdinaryCandidateProfile profile;
+};
+
+Outpoint OutputOf(const Transaction &tx, const TxProfile &profile,
+                  const ChainId &chain) {
+    IdentityDigests ids;
+    std::string error;
+    Check(ComputeIdentities(tx, profile, chain, ids, error),
+          "output identity: " + error);
+    return Outpoint{ids.txid, 0};
+}
+
+Built TwoPayments(World &world) {
+    Built built;
+    built.first = Payment(world.funding.outpoint, 15000);
+    const OrdinaryCandidateProfile wide = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(built.first, wide, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure first payment: " + error);
+    Check(effects.invocation_cost == 18, "true payment invocation cost");
+    built.profile = MakeProfile(effects.invocation_cost * 2);
+    built.second =
+        Payment(OutputOf(built.first, built.profile.transaction,
+                         world.parent.chain_id),
+                10000);
+    return built;
+}
+
+void UndoCount(PersistentUtxoStore &store, size_t count) {
+    for (size_t i = 0; i < count; ++i) {
+        std::string error;
+        Check(store.Undo(error), "utxo undo: " + error);
+    }
+}
+
+void OnePaymentReopenMatchesConnect() {
+    World world;
+    const std::array<uint8_t, 56> parent_money =
+        EncodeMonetaryState(world.monetary);
+    const Hash parent_state = world.parent.header.state_root;
+    const Transaction payment = Payment(world.funding.outpoint, 15000);
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(payment, profile, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure true payment: " + error);
+    Check(effects.invocation_cost == 18, "true payment invocation cost");
+
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    std::array<uint8_t, 56> connected_money{};
+    Hash connected_state{};
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "open utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "open monetary: " + error);
+        SeedUtxo(utxo_store, world);
+        SeedMonetary(monetary_store, world);
+        OrdinaryBlockConnected connected;
+        Check(ConnectOrdinaryBlock({payment}, world.parent, profile, kMonetary,
+                                   world.view, world.utxo, world.monetary,
+                                   connected, error, &utxo_store,
+                                   &monetary_store),
+              "connect true payment: " + error);
+        Check(connected.invocation_cost == 18, "connected invocation cost");
+        Check(connected.monetary_bytes == EncodeMonetaryState(world.monetary) &&
+                  connected.monetary_bytes != parent_money,
+              "connected monetary bytes");
+        Check(connected.state_root ==
+                      StateRoot(world.parent.chain_id, profile.candidate_height,
+                                world.utxo.Root(), world.monetary) &&
+                  connected.state_root != parent_state,
+              "connected state root");
+        Check(StoreMoney(monetary_store) == connected.monetary_bytes &&
+                  StoreState(monetary_store) == connected.state_root,
+              "live monetary store does not match the connect result");
+        Check(DatFiles(money_dir / "monetary-undo") == 2,
+              "one monetary commit beyond the parent seed");
+        Check(DatFiles(utxo_dir / "undo") == 2,
+              "the payment was not its own utxo commit");
+        const StoredRecord stored = ReadRecord(money_dir / "monetary.dat");
+        Check(stored.chain == world.parent.chain_id, "stored chain id");
+        Check(stored.height == profile.candidate_height, "stored child height");
+        Check(stored.monetary == connected.monetary_bytes &&
+                  stored.state_root == connected.state_root,
+              "monetary file does not match the connect result");
+        connected_money = connected.monetary_bytes;
+        connected_state = connected.state_root;
+    }
+    PersistentMonetaryStore reopened;
+    Check(PersistentMonetaryStore::Open(money_dir.string(), reopened, error),
+          "reopen monetary: " + error);
+    Check(StoreMoney(reopened) == connected_money, "reopened monetary bytes");
+    Check(StoreState(reopened) == connected_state, "reopened state root");
+    std::filesystem::remove_all(directory);
+}
+
+void SecondBlockUndoRestoresFirstThenParent() {
+    World world;
+    const ParentBytes parent = Capture(world);
+    Built built = TwoPayments(world);
+    const Outpoint created =
+        OutputOf(built.second, built.profile.transaction, world.parent.chain_id);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    std::string error;
+    PersistentUtxoStore utxo_store;
+    PersistentMonetaryStore monetary_store;
+    Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+          "open utxo: " + error);
+    Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store, error),
+          "open monetary: " + error);
+    SeedUtxo(utxo_store, world);
+    SeedMonetary(monetary_store, world);
+    const std::vector<uint8_t> parent_file = ReadRaw(money_dir / "monetary.dat");
+    Check(DatFiles(utxo_dir / "undo") == 1 &&
+              DatFiles(money_dir / "monetary-undo") == 1,
+          "parent seed is one commit in each store");
+
+    OrdinaryBlockConnected first;
+    const size_t utxo_seed = DatFiles(utxo_dir / "undo");
+    Check(ConnectOrdinaryBlock({built.first, built.second}, world.parent,
+                               built.profile, kMonetary, world.view, world.utxo,
+                               world.monetary, first, error, &utxo_store,
+                               &monetary_store),
+          "connect first block: " + error);
+    const size_t first_utxo_commits = DatFiles(utxo_dir / "undo") - utxo_seed;
+    Check(first_utxo_commits == 2,
+          "first block was collapsed into one utxo commit");
+    Check(DatFiles(money_dir / "monetary-undo") == 2,
+          "first block wrote more or less than one monetary commit");
+    Check(first.invocation_cost == 36, "first block invocation cost");
+    Check(StoreRoot(utxo_store) == first.utxo_root &&
+              StoreMoney(monetary_store) == first.monetary_bytes &&
+              StoreState(monetary_store) == first.state_root,
+          "stores do not match the first block");
+    const std::vector<uint8_t> first_file = ReadRaw(money_dir / "monetary.dat");
+    Check(first_file != parent_file, "first block did not move monetary.dat");
+    const Hash first_utxo = first.utxo_root;
+    const std::array<uint8_t, 56> first_money = first.monetary_bytes;
+    const Hash first_state = first.state_root;
+
+    OrdinaryParentContext second_parent = world.parent;
+    second_parent.header.height = 100;
+    second_parent.header.state_root = first_state;
+    second_parent.monetary = world.monetary;
+    OrdinaryCandidateProfile second_profile = built.profile;
+    second_profile.candidate_height = second_parent.header.height + 1;
+    second_profile.parent_mtp = second_parent.header.time;
+    const Transaction spend_created = Payment(created, 5000);
+    const Transaction spend_other = Payment(world.other.outpoint, 3000);
+    OrdinaryBlockConnected second;
+    const size_t utxo_after_first = DatFiles(utxo_dir / "undo");
+    const size_t money_after_first = DatFiles(money_dir / "monetary-undo");
+    Check(ConnectOrdinaryBlock({spend_created, spend_other}, second_parent,
+                               second_profile, kMonetary, world.view,
+                               world.utxo, world.monetary, second, error,
+                               &utxo_store, &monetary_store),
+          "connect second block: " + error);
+    const size_t second_utxo_commits =
+        DatFiles(utxo_dir / "undo") - utxo_after_first;
+    Check(second_utxo_commits == 2,
+          "second block was collapsed into one utxo commit");
+    Check(DatFiles(money_dir / "monetary-undo") == money_after_first + 1,
+          "second block wrote more or less than one monetary commit");
+    Check(second.utxo_root != first_utxo &&
+              second.monetary_bytes != first_money &&
+              second.state_root != first_state,
+          "second block did not move both stores");
+    Check(StoreRoot(utxo_store) == second.utxo_root &&
+              StoreMoney(monetary_store) == second.monetary_bytes &&
+              StoreState(monetary_store) == second.state_root,
+          "stores do not match the second block");
+    Check(ReadRaw(money_dir / "monetary.dat") != first_file,
+          "second monetary snapshot did not replace the file");
+
+    Check(monetary_store.Undo(error), "undo second monetary snapshot: " + error);
+    UndoCount(utxo_store, second_utxo_commits);
+    Check(DisconnectOrdinaryBlock(second.undo, world.view, world.utxo,
+                                  world.monetary, error),
+          "disconnect second block: " + error);
+    Check(StoreRoot(utxo_store) == first_utxo && world.utxo.Root() == first_utxo,
+          "utxo store is not back at the first block");
+    Check(StoreMoney(monetary_store) == first_money &&
+              EncodeMonetaryState(world.monetary) == first_money,
+          "monetary bytes are not back at the first block");
+    Check(StoreState(monetary_store) == first_state &&
+              StateRoot(world.parent.chain_id, 100, world.utxo.Root(),
+                        world.monetary) == first_state,
+          "state root is not back at the first block");
+    Check(ReadRaw(money_dir / "monetary.dat") == first_file,
+          "monetary file is not the first block snapshot");
+    Check(world.view.count(created) == 1 &&
+              world.view.count(world.other.outpoint) == 1 &&
+              world.view.count(world.funding.outpoint) == 0,
+          "first block coins were not restored");
+
+    Check(monetary_store.Undo(error), "undo first monetary snapshot: " + error);
+    UndoCount(utxo_store, first_utxo_commits);
+    Check(DisconnectOrdinaryBlock(first.undo, world.view, world.utxo,
+                                  world.monetary, error),
+          "disconnect first block: " + error);
+    ExpectParent(world, parent, "parent");
+    Check(StoreRoot(utxo_store) == parent.utxo, "utxo store is not the parent");
+    Check(StoreMoney(monetary_store) == parent.monetary &&
+              StoreState(monetary_store) == world.parent.header.state_root,
+          "monetary store is not the parent");
+    Check(ReadRaw(money_dir / "monetary.dat") == parent_file,
+          "monetary file is not the parent snapshot");
+    Check(DatFiles(utxo_dir / "undo") == 1 &&
+              DatFiles(money_dir / "monetary-undo") == 1,
+          "block commits were not removed");
+    std::filesystem::remove_all(directory);
+}
+
+void FailingWitnessLeavesParentMonetary() {
+    World world;
+    const ParentBytes parent = Capture(world);
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    Transaction first = Payment(world.funding.outpoint, 15000);
+    first.outputs[0].branches = {BranchLeaf(PUSH_ZERO)};
+    std::string error;
+    const Outpoint created =
+        OutputOf(first, profile.transaction, world.parent.chain_id);
+    const Transaction second = Payment(created, 10000, PUSH_ZERO);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    PersistentUtxoStore utxo_store;
+    PersistentMonetaryStore monetary_store;
+    Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+          "open utxo: " + error);
+    Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store, error),
+          "open monetary: " + error);
+    SeedUtxo(utxo_store, world);
+    SeedMonetary(monetary_store, world);
+    const std::vector<uint8_t> parent_file = ReadRaw(money_dir / "monetary.dat");
+    OrdinaryBlockConnected discarded;
+    Check(!ConnectOrdinaryBlock({first, second}, world.parent, profile,
+                                kMonetary, world.view, world.utxo,
+                                world.monetary, discarded, error, &utxo_store,
+                                &monetary_store),
+          "push-zero witness was accepted");
+    Check(error == "witness VM invalid/unsupported: unclean final stack",
+          "push-zero rejection: " + error);
+    ExpectParent(world, parent, "push-zero");
+    Check(StoreRoot(utxo_store) == parent.utxo, "utxo store moved");
+    Check(StoreMoney(monetary_store) == parent.monetary &&
+              StoreState(monetary_store) == world.parent.header.state_root,
+          "monetary store moved after a failed witness");
+    Check(ReadRaw(money_dir / "monetary.dat") == parent_file,
+          "failed witness changed the monetary file");
+    Check(DatFiles(money_dir / "monetary-undo") == 1 &&
+              DatFiles(utxo_dir / "undo") == 1,
+          "failed witness left a block commit");
+    std::filesystem::remove_all(directory);
+}
+
+// The next monetary undo path is a directory, so the snapshot rename cannot
+// publish. Commit must fail before any new monetary record is visible.
+void MonetaryCommitFailureRestoresParent() {
+    World world;
+    const ParentBytes parent = Capture(world);
+    Built built = TwoPayments(world);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    std::string error;
+    PersistentUtxoStore utxo_store;
+    PersistentMonetaryStore monetary_store;
+    Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+          "open utxo: " + error);
+    Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store, error),
+          "open monetary: " + error);
+    SeedUtxo(utxo_store, world);
+    SeedMonetary(monetary_store, world);
+    const std::vector<uint8_t> parent_file = ReadRaw(money_dir / "monetary.dat");
+    const std::filesystem::path blocker =
+        money_dir / "monetary-undo" / "00000002.dat";
+    Check(std::filesystem::create_directory(blocker), "plant undo blocker");
+    OrdinaryBlockConnected discarded;
+    Check(!ConnectOrdinaryBlock({built.first, built.second}, world.parent,
+                                built.profile, kMonetary, world.view,
+                                world.utxo, world.monetary, discarded, error,
+                                &utxo_store, &monetary_store),
+          "monetary commit failure was accepted");
+    Check(error == "io", "monetary commit failure: " + error);
+    ExpectParent(world, parent, "monetary commit failure");
+    Check(StoreRoot(utxo_store) == parent.utxo,
+          "failed monetary commit left utxo commits");
+    Check(DatFiles(utxo_dir / "undo") == 1,
+          "failed monetary commit did not undo utxo commits newest first");
+    Check(StoreMoney(monetary_store) == parent.monetary &&
+              StoreState(monetary_store) == world.parent.header.state_root,
+          "failed monetary commit published a new snapshot");
+    Check(ReadRaw(money_dir / "monetary.dat") == parent_file,
+          "failed monetary commit changed the monetary file");
+    Check(DatFiles(money_dir / "monetary-undo") == 1,
+          "failed monetary commit left a new undo record");
+    Check(!std::filesystem::exists(money_dir / "monetary.dat.tmp"),
+          "failed monetary commit left a temporary snapshot");
+    std::filesystem::remove_all(directory);
+}
+} // namespace
+
+int main() {
+    try {
+        OnePaymentReopenMatchesConnect();
+        SecondBlockUndoRestoresFirstThenParent();
+        FailingWitnessLeavesParentMonetary();
+        MonetaryCommitFailureRestoresParent();
+        std::cout << "ordinary block monetary snapshot checks passed\n";
+        return 0;
+    } catch (const std::exception &failure) {
+        std::cerr << failure.what() << '\n';
+        return 1;
+    }
+}
