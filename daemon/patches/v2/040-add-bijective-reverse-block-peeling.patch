+static RPCHelpMan peelfastsyncblock() {
+    return RPCHelpMan{
+        "peelfastsyncblock",
+        "\nVerify and peel one historical V2 block backwards using a BLOCKUNDO message.\n",
+        {
+            {"blockhash", RPCArg::Type::STR_HEX, RPCArg::Optional::NO,
+             "The block hash at earliest_verified_height to peel backwards"},
+            {"blockundo_hex", RPCArg::Type::STR_HEX, RPCArg::Optional::NO,
+             "Hex-encoded BLOCKUNDO message"},
+        },
+        RPCResult{RPCResult::Type::OBJ,
+                  "",
+                  "",
+                  {
+                      {RPCResult::Type::STR_HEX, "peeled_blockhash",
+                       "the hash of the peeled block"},
+                      {RPCResult::Type::STR_HEX, "parent_blockhash",
+                       "the hash of the verified parent block"},
+                      {RPCResult::Type::NUM, "parent_height",
+                       "the height of the verified parent block"},
+                      {RPCResult::Type::NUM, "earliest_verified_height",
+                       "updated earliest_verified_height"},
+                      {RPCResult::Type::BOOL, "fast_sync_active",
+                       "whether fast-sync reverse peeling remains active"},
+                      {RPCResult::Type::NUM, "intra_block_spends",
+                       "number of intra-block spent coins partitioned out"},
+                      {RPCResult::Type::NUM, "prior_spends_restored",
+                       "number of prior-block spent coins restored"},
+                      {RPCResult::Type::NUM, "net_outputs_removed",
+                       "number of net unspent block outputs removed"},
+                  }},
+        RPCExamples{""},
+        [&](const RPCHelpMan &self, const Config &config,
+            const JSONRPCRequest &request) -> UniValue {
+            ChainstateManager &chainman = EnsureAnyChainman(request.context);
+            LOCK(cs_main);
+            Chainstate &active_chainstate = chainman.ActiveChainstate();
+
+            if (!active_chainstate.IsFastSyncActive()) {
+                throw JSONRPCError(RPC_MISC_ERROR,
+                                   "Fast-sync reverse peeling is not active");
+            }
+
+            const BlockHash block_hash(ParseHashV(request.params[0], "blockhash"));
+            const CBlockIndex *pindex =
+                chainman.m_blockman.LookupBlockIndex(block_hash);
+            if (!pindex || pindex->nHeight <= 0 || !pindex->pprev) {
+                throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY,
+                                   "Valid non-genesis block not found");
+            }
+            if (pindex->nHeight !=
+                active_chainstate.GetEarliestVerifiedHeight()) {
+                throw JSONRPCError(
+                    RPC_INVALID_PARAMETER,
+                    strprintf("Block height %d does not match "
+                              "earliest_verified_height %d",
+                              pindex->nHeight,
+                              active_chainstate.GetEarliestVerifiedHeight()));
+            }
+
+            if (!IsHex(request.params[1].get_str())) {
+                throw JSONRPCError(RPC_DESERIALIZATION_ERROR,
+                                   "blockundo_hex must be hexadecimal");
+            }
+            const std::vector<uint8_t> undo_bytes =
+                ParseHex(request.params[1].get_str());
+            lotus::v2::BlockUndoMessage undo_msg{};
+            std::string err;
+            if (!lotus::v2::DecodeBlockUndoMessage(undo_bytes, undo_msg, err)) {
+                throw JSONRPCError(
+                    RPC_DESERIALIZATION_ERROR,
+                    strprintf("Invalid BLOCKUNDO payload: %s", err));
+            }
+
+            lotus::v2::Hash expected_block_id{};
+            std::memcpy(expected_block_id.data(), block_hash.begin(), 32);
+            if (undo_msg.block_id != expected_block_id) {
+                throw JSONRPCError(RPC_VERIFY_ERROR,
+                                   "BLOCKUNDO block_id mismatch");
+            }
+
+            lotus::v2::MonetaryState parent_mon_state{};
+            try {
+                parent_mon_state = lotus::v2::DecodeMonetaryState(
+                    std::vector<uint8_t>(undo_msg.parent_monetary_state.begin(),
+                                         undo_msg.parent_monetary_state.end()));
+            } catch (const std::exception &e) {
+                throw JSONRPCError(
+                    RPC_VERIFY_ERROR,
+                    strprintf("Invalid parent_monetary_state: %s", e.what()));
+            }
+
+            CBlock block;
+            if (!chainman.m_blockman.ReadBlock(block, *pindex)) {
+                throw JSONRPCError(RPC_MISC_ERROR, "Failed to read block");
+            }
+
+            std::vector<lotus::v2::Coin> current_coins;
+            lotus::v2::MonetaryState current_mon_state{};
+            if (!GetV2BlockStateCoinsAndMonetary(
+                    block_hash, static_cast<uint64_t>(pindex->nHeight),
+                    current_coins, current_mon_state)) {
+                throw JSONRPCError(RPC_MISC_ERROR,
+                                   "Current block V2 state not found");
+            }
+            lotus::v2::UtxoSet current_utxo;
+            for (const auto &c : current_coins) {
+                if (!current_utxo.Insert(c)) {
+                    throw JSONRPCError(RPC_INTERNAL_ERROR,
+                                       "Failed to populate current UTXO set");
+                }
+            }
+
+            const uint64_t height = static_cast<uint64_t>(pindex->nHeight);
+            const uint64_t parent_mtp =
+                static_cast<uint64_t>(pindex->pprev->GetMedianTimePast());
+
+            struct V2OutpointLess {
+                bool operator()(const lotus::v2::Outpoint &a,
+                                const lotus::v2::Outpoint &b) const {
+                    if (a.tx_id != b.tx_id) {
+                        return a.tx_id < b.tx_id;
+                    }
+                    return a.index < b.index;
+                }
+            };
+
+            // Partition O_h^all and I_h = I_h^prior \sqcup I_h^intra (Hole 12)
+            std::map<lotus::v2::Outpoint, lotus::v2::Coin, V2OutpointLess>
+                created_coins;
+            std::map<lotus::v2::Outpoint, size_t, V2OutpointLess>
+                created_tx_index;
+            for (size_t tx_i = 0; tx_i < block.vtx.size(); ++tx_i) {
+                const CTransaction &tx = *block.vtx[tx_i];
+                lotus::v2::Hash txid{};
+                std::memcpy(txid.data(), tx.GetId().begin(), 32);
+                for (size_t j = 0; j < tx.vout.size(); ++j) {
+                    if (tx.vout[j].scriptPubKey.IsUnspendable()) {
+                        continue;
+                    }
+                    const lotus::v2::Output v2out = tx.vout[j].ToV2Output();
+                    if (!v2out.IsBurn()) {
+                        const lotus::v2::Outpoint op{
+                            txid, static_cast<uint32_t>(j)};
+                        lotus::v2::Coin coin{op, v2out, height, parent_mtp,
+                                             tx.IsCoinBase()};
+                        created_coins.emplace(op, std::move(coin));
+                        created_tx_index.emplace(op, tx_i);
+                    }
+                }
+            }
+
+            std::set<lotus::v2::Outpoint, V2OutpointLess> all_spent;
+            std::set<lotus::v2::Outpoint, V2OutpointLess> intra_spent;
+            std::vector<lotus::v2::Outpoint> prior_spent_order;
+            for (size_t tx_i = 0; tx_i < block.vtx.size(); ++tx_i) {
+                const CTransaction &tx = *block.vtx[tx_i];
+                if (tx.IsCoinBase()) {
+                    continue;
+                }
+                for (const auto &txin : tx.vin) {
+                    if (txin.nFlags == 3) {
+                        continue;
+                    }
+                    lotus::v2::Outpoint op{};
+                    std::memcpy(op.tx_id.data(), txin.prevout.GetTxId().begin(),
+                                32);
+                    op.index = txin.prevout.GetN();
+                    if (!all_spent.insert(op).second) {
+                        throw JSONRPCError(RPC_VERIFY_ERROR,
+                                         "Duplicate input outpoint in block");
+                    }
+                    auto it_created = created_tx_index.find(op);
+                    if (it_created != created_tx_index.end()) {
+                        if (it_created->second == tx_i) {
+                            throw JSONRPCError(
+                                RPC_VERIFY_ERROR,
+                                "Invalid intra-block self-spend");
+                        }
+                        intra_spent.insert(op);
+                    } else {
+                        prior_spent_order.push_back(op);
+                    }
+                }
+            }
+
+            if (undo_msg.prior_spent_coins.size() != prior_spent_order.size()) {
+                throw JSONRPCError(
+                    RPC_VERIFY_ERROR,
+                    "BLOCKUNDO prior_spent_coins count does not match "
+                    "prior_spent");
+            }
+            for (size_t i = 0; i < undo_msg.prior_spent_coins.size(); ++i) {
+                const auto &coin = undo_msg.prior_spent_coins[i];
+                std::vector<uint8_t> encoded_coin;
+                if (!(coin.outpoint == prior_spent_order[i]) ||
+                    !lotus::v2::EncodeCoin(coin, encoded_coin) ||
+                    coin.output.IsBurn() || coin.creation_height >= height) {
+                    throw JSONRPCError(
+                        RPC_VERIFY_ERROR,
+                        "Invalid coin in BLOCKUNDO prior_spent_coins");
+                }
+            }
+
+            // Backward Merklix transition: UTXO_{h-1} = (UTXO_h \ O_h^net) U I_h^prior
+            std::map<lotus::v2::Outpoint, lotus::v2::Coin, V2OutpointLess>
+                current_view;
+            for (const auto &c : current_utxo.Coins()) {
+                current_view.emplace(c.outpoint, c);
+            }
+            lotus::v2::UtxoSet parent_utxo = current_utxo;
+            for (const auto &intra_op : intra_spent) {
+                if (current_view.count(intra_op) > 0) {
+                    throw JSONRPCError(
+                        RPC_VERIFY_ERROR,
+                        "Intra-block spent coin present in end-of-block UTXO");
+                }
+            }
+            size_t net_outputs_removed = 0;
+            for (const auto &[op, expected_coin] : created_coins) {
+                if (intra_spent.count(op) > 0) {
+                    continue;
+                }
+                const auto it_actual = current_view.find(op);
+                std::vector<uint8_t> b1, b2;
+                if (it_actual == current_view.end() ||
+                    !lotus::v2::EncodeCoin(it_actual->second, b1) ||
+                    !lotus::v2::EncodeCoin(expected_coin, b2) || b1 != b2) {
+                    throw JSONRPCError(
+                        RPC_VERIFY_ERROR,
+                        "Net block output missing or mismatched in UTXO_h");
+                }
+                if (!parent_utxo.Erase(op)) {
+                    throw JSONRPCError(RPC_VERIFY_ERROR,
+                                       "Failed to remove net block output");
+                }
+                ++net_outputs_removed;
+            }
+            for (const auto &coin : undo_msg.prior_spent_coins) {
+                if (current_view.count(coin.outpoint) > 0 ||
+                    !parent_utxo.Insert(coin)) {
+                    throw JSONRPCError(
+                        RPC_VERIFY_ERROR,
+                        "Failed to restore prior-block spent coin");
+                }
+            }
+
+            const CBlockIndex *parent_index = pindex->pprev;
+            const lotus::v2::Header parent_hdr =
+                parent_index->GetBlockHeader().ToV2Header();
+            const lotus::v2::Hash expected_parent_state_root =
+                lotus::v2::StateRoot(GetActiveV2ChainId(),
+                                     static_cast<uint64_t>(parent_index->nHeight),
+                                     parent_utxo.Root(), parent_mon_state);
+            if (expected_parent_state_root != parent_hdr.state_root) {
+                throw JSONRPCError(
+                    RPC_VERIFY_ERROR,
+                    "Peeled parent StateRoot mismatch against parent header");
+            }
+
+            const lotus::v2::MonetaryState expected_current_mon =
+                AdvanceV2BlockMonetaryState(block, parent_mon_state);
+            if (lotus::v2::EncodeMonetaryState(expected_current_mon) !=
+                lotus::v2::EncodeMonetaryState(current_mon_state)) {
+                throw JSONRPCError(
+                    RPC_VERIFY_ERROR,
+                    "Forward monetary transition mismatch from parent state");
+            }
+
+            ImportV2BlockStateCoinsAndMonetary(
+                parent_index->GetBlockHash(), parent_utxo.Coins(),
+                parent_mon_state);
+            if (!active_chainstate.RecordReversePeeledBlock(
+                    parent_index->nHeight)) {
+                throw JSONRPCError(RPC_INTERNAL_ERROR,
+                                   "Failed to update earliest_verified_height");
+            }
+            node::PublishChainTipSnapshot(chainman,
+                                          active_chainstate.GetMempool());
+
+            UniValue res(UniValue::VOBJ);
+            res.pushKV("peeled_blockhash", block_hash.GetHex());
+            res.pushKV("parent_blockhash",
+                       parent_index->GetBlockHash().GetHex());
+            res.pushKV("parent_height", parent_index->nHeight);
+            res.pushKV("earliest_verified_height",
+                       active_chainstate.GetEarliestVerifiedHeight());
+            res.pushKV("fast_sync_active",
+                       active_chainstate.IsFastSyncActive());
+            res.pushKV("intra_block_spends",
+                       static_cast<uint64_t>(intra_spent.size()));
+            res.pushKV("prior_spends_restored",
+                       static_cast<uint64_t>(undo_msg.prior_spent_coins.size()));
+            res.pushKV("net_outputs_removed",
+                       static_cast<uint64_t>(net_outputs_removed));
+            return res;
+        },
+    };
+}
