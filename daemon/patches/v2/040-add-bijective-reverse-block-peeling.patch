+
+    def serialize(self) -> bytes:
+        return self.raw_payload
+
+    def __repr__(self):
+        return (
+            f"msg_utxoshard(pivot={self.pivot_block_id.hex()}, "
+            f"depth={self.prefix_depth}, bits=0x{self.prefix_bits:04x}, "
+            f"bytes={len(self.raw_payload)})"
+        )
