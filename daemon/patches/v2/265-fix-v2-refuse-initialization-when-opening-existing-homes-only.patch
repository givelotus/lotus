diff --git a/src/lotus_v2/development_chain.h b/src/lotus_v2/development_chain.h
index 8d7821b86dc1882fd9481c45fcbd5367eeca2cd8..0b58861bf535df4008709608a4a442c48c8d4cc2 100644
--- a/src/lotus_v2/development_chain.h
+++ b/src/lotus_v2/development_chain.h
@@ -7,6 +7,8 @@ namespace lotus::v2 {
 // No defaults or preloaded UTXO snapshot: coins derive only from genesis bytes.
 // Validates before opening storage. A crash before the genesis batch may leave
 // an empty, profile-bound store; reopening safely retries that initialization.
+// With options.existing_only, absent/empty homes fail without initialization.
+// LevelDB still opens exclusively and may maintain its engine files.
 // Existing tips are checked against their stored history/state commitment.
 // Uses the explicit indexed storage schema; pre-index development homes fail
 // closed. Replaying into a new home is separate from this initializer.
diff --git a/src/lotus_v2/disk_state.cpp b/src/lotus_v2/disk_state.cpp
index f2b518fd0ed74a566ddad312bb718596b49a6754..d2187c561c78bfe0967f8527cca08ac472f92c80 100644
--- a/src/lotus_v2/disk_state.cpp
+++ b/src/lotus_v2/disk_state.cpp
@@ -1035,13 +1035,19 @@ bool DiskStateStore::Open(const std::string &directory, const DiskStateOptions &
         auto impl = std::make_shared<Impl>(); impl->options = options;
         impl->cache.reset(leveldb::NewLRUCache(options.cache_bytes));
         leveldb::Options dboptions;
-        dboptions.create_if_missing = true; dboptions.paranoid_checks = true;
+        dboptions.create_if_missing = !options.existing_only; dboptions.paranoid_checks = true;
         dboptions.block_cache = impl->cache.get(); dboptions.write_buffer_size = options.write_buffer_bytes;
         dboptions.max_open_files = 64;
         if (options.env) dboptions.env = options.env;
+        // LevelDB creates its directory/log even when create_if_missing is false.
+        // Refuse an absent database before entering that engine open path.
+        if (options.existing_only && !dboptions.env->FileExists(directory + "/CURRENT"))
+            Fail(DiskStateErrorCode::Missing, "existing initialized database required");
         leveldb::DB *db{}; CheckStatus(leveldb::DB::Open(dboptions, directory, &db)); impl->db.reset(db);
         const Value schema = impl->Read("V"), head = impl->Read("S");
         if (!schema) {
+            if (options.existing_only)
+                Fail(DiskStateErrorCode::Missing, "existing database schema required");
             Require(!head, "head without schema");
             std::unique_ptr<leveldb::Iterator> iterator(impl->db->NewIterator(leveldb::ReadOptions{}));
             iterator->SeekToFirst(); CheckStatus(iterator->status());
@@ -1056,6 +1062,8 @@ bool DiskStateStore::Open(const std::string &directory, const DiskStateOptions &
                 Fail(DiskStateErrorCode::ProfileMismatch, "database identity/profile/schema mismatch; indexed development needs a fresh home");
             Require(head.has_value(), "missing head"); impl->head = ParseHead(*head, options);
         }
+        if (options.existing_only && impl->head.metadata == DiskStateMetadata{})
+            Fail(DiskStateErrorCode::Missing, "existing initialized metadata required");
         const Value node = impl->Read(Path{}.Key());
         if (impl->head.root.kind) {
             Require(node.has_value(), "missing root node");
diff --git a/src/lotus_v2/disk_state.h b/src/lotus_v2/disk_state.h
index e3c2577c8b1f8285d07759da74c316199f0db7fe..214857cb50816f8430c957b4b4341a15a75a4be1 100644
--- a/src/lotus_v2/disk_state.h
+++ b/src/lotus_v2/disk_state.h
@@ -53,6 +53,9 @@ struct DiskStateOptions {
     std::optional<CandidateStoreOptions> candidates;
     // Explicit fresh-home Avalanche policy. Auto-unparking is disabled.
     bool avalanche{};
+    // Open only an initialized home; never create schema or initial metadata.
+    // This still takes LevelDB's exclusive lock and may maintain engine files.
+    bool existing_only{false};
     uint64_t max_avalanche_reads{100000};
     size_t cache_bytes{8 << 20};
     size_t write_buffer_bytes{4 << 20}; // LevelDB's minimum is 64 KiB.
