From 938de811c13ff822267e8ea48df0510ef10db927 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:16:20 -0700
Subject: [PATCH] Retain PoW-valid nonmonotone header history regression

Review correction: Retain PoW-valid nonmonotone header history regression.

This isolated V2 candidate change preserves the existing Bitcoin parser and
mainnet parameters. Module tests do not establish lotusd block acceptance.
---
 src/lotus_v2/test_header_context.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/lotus_v2/test_header_context.cpp b/src/lotus_v2/test_header_context.cpp
index 776eaf414e73393c6f9d66bffabcff7e2346c061..d94f56b89dd6799ddf554b2006d53154c490c539 100644
--- a/src/lotus_v2/test_header_context.cpp
+++ b/src/lotus_v2/test_header_context.cpp
@@ -11,6 +11,9 @@ int main() {
     for(uint64_t height=0;height<12;++height) {
         Header h; h.version=2; h.height=height; h.bits=p.genesis_bits; h.time=height<11?1000+120*height:5000; h.size=200;
         if(!history.empty()) Check(BlockId(p.chain_id,history.front(),h.prev_id));
+        Hash history_target{}, history_id{};
+        Check(DecodeTarget(h.bits,p.pow_limit,history_target));
+        do { Check(BlockId(p.chain_id,h,history_id)); if(MeetsTarget(history_id,history_target)) break; ++h.nonce; } while(true);
         history.insert(history.begin(),h);
     }
     history.resize(11);
