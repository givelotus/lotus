index 000000000..a1dedef59
--- /dev/null
+++ b/src/lotus_v2/persistent_utxo.cpp
@@ -0,0 +1,805 @@
+// Copyright (c) 2026 The Lotus developers
+#include "persistent_utxo.h"
+
+#include "incremental_utxo.h"
+#include "output.h"
+#include "vendor/blake3/blake3.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <fcntl.h>
+#include <filesystem>
+#include <map>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+
+constexpr uint8_t kMagic[8] = {'L', 'T', 'S', 'V', '2', 'U', 'T', 'X'};
+constexpr uint32_t kKindSnapshot = 1;
+constexpr uint32_t kKindUndo = 2;
+constexpr uint64_t kMaxCoins = 1000000;
+constexpr size_t kMaxRecordBytes = 512u * 1024u * 1024u;
+constexpr char kChecksumTag[] = "Lotus/v2/persist-utxo";
+
+struct OutpointLess {
+    bool operator()(const Outpoint &a, const Outpoint &b) const {
+        return a.tx_id < b.tx_id || (a.tx_id == b.tx_id && a.index < b.index);
+    }
+};
+
+using CoinMap = std::map<Outpoint, Coin, OutpointLess>;
+
+bool Fail(std::string &error, const char *what) {
+    error = what;
+    return false;
+}
+
+struct Fd {
+    int fd = -1;
+    explicit Fd(int opened) : fd(opened) {}
+    ~Fd() {
+        if (fd >= 0) ::close(fd);
+    }
+    Fd(const Fd &) = delete;
+    Fd &operator=(const Fd &) = delete;
+};
+
+uint32_t ReadU32(const uint8_t *p) {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) |
+           (uint32_t(p[3]) << 24);
+}
+
+uint64_t ReadU64(const uint8_t *p) {
+    uint64_t value = 0;
+    for (unsigned i = 0; i < 8; ++i) value |= uint64_t(p[i]) << (8 * i);
+    return value;
+}
+
+void AppendU32(std::vector<uint8_t> &out, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i)
+        out.push_back(static_cast<uint8_t>(value >> (8 * i)));
+}
+
+void AppendU64(std::vector<uint8_t> &out, uint64_t value) {
+    for (unsigned i = 0; i < 8; ++i)
+        out.push_back(static_cast<uint8_t>(value >> (8 * i)));
+}
+
+void AppendHash(std::vector<uint8_t> &out, const Hash &hash) {
+    out.insert(out.end(), hash.begin(), hash.end());
+}
+
+Hash Checksum(const uint8_t *data, size_t size) {
+    blake3_hasher hasher;
+    blake3_hasher_init(&hasher);
+    blake3_hasher_update(&hasher, kChecksumTag, sizeof(kChecksumTag) - 1);
+    const uint8_t separator = 0;
+    blake3_hasher_update(&hasher, &separator, 1);
+    if (size != 0) blake3_hasher_update(&hasher, data, size);
+    Hash out{};
+    blake3_hasher_finalize(&hasher, out.data(), out.size());
+    return out;
+}
+
+struct Cursor {
+    const uint8_t *p;
+    const uint8_t *end;
+    size_t Remaining() const { return static_cast<size_t>(end - p); }
+    bool Take(size_t n, const uint8_t *&out) {
+        if (n > Remaining()) return false;
+        out = p;
+        p += n;
+        return true;
+    }
+    bool U32(uint32_t &value) {
+        const uint8_t *bytes = nullptr;
+        if (!Take(4, bytes)) return false;
+        value = ReadU32(bytes);
+        return true;
+    }
+    bool U64(uint64_t &value) {
+        const uint8_t *bytes = nullptr;
+        if (!Take(8, bytes)) return false;
+        value = ReadU64(bytes);
+        return true;
+    }
+    bool CopyHash(Hash &hash) {
+        const uint8_t *bytes = nullptr;
+        if (!Take(32, bytes)) return false;
+        std::copy_n(bytes, 32, hash.begin());
+        return true;
+    }
+    bool Finished() const { return p == end; }
+};
+
+bool ReadCompact(Cursor &cursor, uint64_t cap, uint64_t &value) {
+    const uint8_t *lead_bytes = nullptr;
+    if (!cursor.Take(1, lead_bytes)) return false;
+    const uint64_t lead = *lead_bytes;
+    if (lead < 253) {
+        value = lead;
+    } else {
+        const unsigned width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+        const uint8_t *raw = nullptr;
+        if (!cursor.Take(width, raw)) return false;
+        value = 0;
+        for (unsigned i = 0; i < width; ++i) value |= uint64_t(raw[i]) << (8 * i);
+        const uint64_t min_value = width == 2 ? 253 : width == 4 ? 65536ULL : 4294967296ULL;
+        if (value < min_value) return false;
+    }
+    return value <= cap;
+}
+
+// Canonical EncodeCoin bytes only. Burns and non-canonical lengths reject.
+bool DecodeCoin(const uint8_t *data, size_t size, Coin &out) {
+    if (size == 0 || size > MAX_COIN_BYTES) return false;
+    Cursor cursor{data, data + size};
+    const uint8_t *txid = nullptr;
+    if (!cursor.Take(32, txid)) return false;
+    Coin coin;
+    std::copy_n(txid, 32, coin.outpoint.tx_id.begin());
+    uint32_t index = 0;
+    if (!cursor.U32(index)) return false;
+    coin.outpoint.index = index;
+    uint64_t output_len = 0;
+    if (!ReadCompact(cursor, MAX_OUTPUT_BYTES, output_len)) return false;
+    const uint8_t *output = nullptr;
+    if (!cursor.Take(static_cast<size_t>(output_len), output)) return false;
+    std::string error;
+    if (!DecodeOutput(std::vector<uint8_t>(output, output + output_len), coin.output, error))
+        return false;
+    if (cursor.Remaining() != 17) return false;
+    uint64_t height = 0;
+    uint64_t mtp = 0;
+    if (!cursor.U64(height) || !cursor.U64(mtp)) return false;
+    const uint8_t *flag = nullptr;
+    if (!cursor.Take(1, flag) || !cursor.Finished() || *flag > 1) return false;
+    coin.creation_height = height;
+    coin.creation_parent_mtp = mtp;
+    coin.coinbase = *flag == 1;
+    std::vector<uint8_t> again;
+    if (!EncodeCoin(coin, again) || again.size() != size ||
+        !std::equal(again.begin(), again.end(), data))
+        return false;
+    out = std::move(coin);
+    return true;
+}
+
+bool SameCoin(const Coin &a, const Coin &b) {
+    std::vector<uint8_t> left, right;
+    return EncodeCoin(a, left) && EncodeCoin(b, right) && left == right;
+}
+
+bool SameSet(const CoinMap &a, const CoinMap &b) {
+    if (a.size() != b.size()) return false;
+    for (const auto &entry : a) {
+        const auto it = b.find(entry.first);
+        if (it == b.end() || !SameCoin(entry.second, it->second)) return false;
+    }
+    return true;
+}
+
+bool SameCoins(const std::vector<Coin> &a, const std::vector<Coin> &b) {
+    if (a.size() != b.size()) return false;
+    for (size_t i = 0; i < a.size(); ++i) {
+        if (!SameCoin(a[i], b[i])) return false;
+    }
+    return true;
+}
+
+bool StrictlyIncreasing(const std::vector<Coin> &coins) {
+    for (size_t i = 1; i < coins.size(); ++i) {
+        if (!OutpointLess{}(coins[i - 1].outpoint, coins[i].outpoint)) return false;
+    }
+    return true;
+}
+
+void SortCoins(std::vector<Coin> &coins) {
+    std::sort(coins.begin(), coins.end(), [](const Coin &a, const Coin &b) {
+        return OutpointLess{}(a.outpoint, b.outpoint);
+    });
+}
+
+bool RootOf(const CoinMap &coins, std::unique_ptr<IncrementalUtxoSet> &tree, Hash &root,
+            std::string &error) {
+    auto built = std::make_unique<IncrementalUtxoSet>();
+    for (const auto &entry : coins) {
+        if (!built->Insert(entry.second)) return Fail(error, "key collision");
+    }
+    if (built->Size() != coins.size()) return Fail(error, "coins");
+    root = built->Root();
+    tree = std::move(built);
+    return true;
+}
+
+bool ReadCoins(Cursor &cursor, uint64_t count, std::vector<Coin> &coins, std::string &error) {
+    if (count > kMaxCoins || count > cursor.Remaining() / 4) return Fail(error, "coins");
+    coins.clear();
+    coins.reserve(static_cast<size_t>(count));
+    for (uint64_t i = 0; i < count; ++i) {
+        uint32_t length = 0;
+        if (!cursor.U32(length) || length == 0 || length > MAX_COIN_BYTES)
+            return Fail(error, "coins");
+        const uint8_t *raw = nullptr;
+        if (!cursor.Take(length, raw)) return Fail(error, "coins");
+        Coin coin;
+        if (!DecodeCoin(raw, length, coin)) return Fail(error, "coins");
+        coins.push_back(std::move(coin));
+    }
+    if (!StrictlyIncreasing(coins)) return Fail(error, "order");
+    return true;
+}
+
+struct RecordView {
+    uint32_t kind = 0;
+    const uint8_t *payload = nullptr;
+    size_t payload_len = 0;
+};
+
+// Length is checked before the payload root is interpreted. A truncated file
+// often still contains those 32 bytes; they are not a valid root.
+bool ParseRecord(const std::vector<uint8_t> &bytes, RecordView &out, std::string &error) {
+    if (bytes.size() < 56) return Fail(error, "truncated");
+    if (!std::equal(bytes.begin(), bytes.begin() + 8, kMagic)) return Fail(error, "magic");
+    const size_t payload_len = bytes.size() - 56;
+    if (ReadU64(bytes.data() + 16) != payload_len) return Fail(error, "truncated");
+    const Hash sum = Checksum(bytes.data(), 24 + payload_len);
+    if (!std::equal(sum.begin(), sum.end(), bytes.end() - 32)) return Fail(error, "checksum");
+    if (ReadU32(bytes.data() + 8) != PERSISTENT_UTXO_VERSION) return Fail(error, "version");
+    const uint32_t kind = ReadU32(bytes.data() + 12);
+    if (kind != kKindSnapshot && kind != kKindUndo) return Fail(error, "kind");
+    out.kind = kind;
+    out.payload = bytes.data() + 24;
+    out.payload_len = payload_len;
+    return true;
+}
+
+bool ParseSnapshot(const uint8_t *payload, size_t size, Hash &stored_root,
+                   std::vector<Coin> &coins, std::string &error) {
+    Cursor cursor{payload, payload + size};
+    if (!cursor.CopyHash(stored_root)) return Fail(error, "coins");
+    uint64_t count = 0;
+    if (!cursor.U64(count)) return Fail(error, "coins");
+    if (!ReadCoins(cursor, count, coins, error)) return false;
+    if (!cursor.Finished()) return Fail(error, "coins");
+    return true;
+}
+
+struct UndoBody {
+    Hash prev_root{};
+    Hash next_root{};
+    std::vector<Coin> deleted;
+    std::vector<Coin> inserted;
+};
+
+bool ParseUndo(const uint8_t *payload, size_t size, UndoBody &undo, std::string &error) {
+    Cursor cursor{payload, payload + size};
+    if (!cursor.CopyHash(undo.prev_root) || !cursor.CopyHash(undo.next_root))
+        return Fail(error, "coins");
+    uint64_t count = 0;
+    if (!cursor.U64(count)) return Fail(error, "coins");
+    if (!ReadCoins(cursor, count, undo.deleted, error)) return false;
+    if (!cursor.U64(count)) return Fail(error, "coins");
+    if (!ReadCoins(cursor, count, undo.inserted, error)) return false;
+    if (!cursor.Finished()) return Fail(error, "coins");
+    return true;
+}
+
+bool AppendCoin(std::vector<uint8_t> &out, const Coin &coin, std::string &error) {
+    std::vector<uint8_t> encoded;
+    if (!EncodeCoin(coin, encoded) || encoded.empty() || encoded.size() > MAX_COIN_BYTES)
+        return Fail(error, "coins");
+    AppendU32(out, static_cast<uint32_t>(encoded.size()));
+    out.insert(out.end(), encoded.begin(), encoded.end());
+    return true;
+}
+
+bool BuildSnapshotPayload(const CoinMap &coins, const Hash &root, std::vector<uint8_t> &payload,
+                          std::string &error) {
+    if (coins.size() > kMaxCoins) return Fail(error, "coins");
+    payload.clear();
+    AppendHash(payload, root);
+    AppendU64(payload, coins.size());
+    for (const auto &entry : coins) {
+        if (!AppendCoin(payload, entry.second, error)) return false;
+    }
+    return true;
+}
+
+bool BuildUndoPayload(const Hash &prev, const Hash &next, const std::vector<Coin> &deleted,
+                      const std::vector<Coin> &inserted, std::vector<uint8_t> &payload,
+                      std::string &error) {
+    payload.clear();
+    AppendHash(payload, prev);
+    AppendHash(payload, next);
+    AppendU64(payload, deleted.size());
+    for (const Coin &coin : deleted) {
+        if (!AppendCoin(payload, coin, error)) return false;
+    }
+    AppendU64(payload, inserted.size());
+    for (const Coin &coin : inserted) {
+        if (!AppendCoin(payload, coin, error)) return false;
+    }
+    return true;
+}
+
+std::vector<uint8_t> Finish(uint32_t kind, const std::vector<uint8_t> &payload) {
+    std::vector<uint8_t> out;
+    out.reserve(24 + payload.size() + 32);
+    out.insert(out.end(), kMagic, kMagic + 8);
+    AppendU32(out, PERSISTENT_UTXO_VERSION);
+    AppendU32(out, kind);
+    AppendU64(out, payload.size());
+    out.insert(out.end(), payload.begin(), payload.end());
+    AppendHash(out, Checksum(out.data(), out.size()));
+    return out;
+}
+
+bool ApplyForward(CoinMap state, const std::vector<Coin> &deleted,
+                  const std::vector<Coin> &inserted, CoinMap &out_state,
+                  std::unique_ptr<IncrementalUtxoSet> &tree, Hash &root, std::string &error) {
+    for (const Coin &coin : deleted) {
+        const auto it = state.find(coin.outpoint);
+        if (it == state.end() || !SameCoin(it->second, coin)) return Fail(error, "coins");
+        state.erase(it);
+    }
+    for (const Coin &coin : inserted) {
+        if (state.find(coin.outpoint) != state.end()) return Fail(error, "duplicate");
+        Hash leaf{};
+        if (!UtxoLeaf(coin, leaf)) return Fail(error, "invalid coin");
+        (void)leaf;
+        state.emplace(coin.outpoint, coin);
+    }
+    if (!RootOf(state, tree, root, error)) return false;
+    out_state = std::move(state);
+    return true;
+}
+
+bool ApplyInverse(CoinMap state, const std::vector<Coin> &deleted,
+                  const std::vector<Coin> &inserted, CoinMap &out_state,
+                  std::unique_ptr<IncrementalUtxoSet> &tree, Hash &root, std::string &error) {
+    for (const Coin &coin : inserted) {
+        const auto it = state.find(coin.outpoint);
+        if (it == state.end() || !SameCoin(it->second, coin)) return Fail(error, "coins");
+        state.erase(it);
+    }
+    for (const Coin &coin : deleted) {
+        if (state.find(coin.outpoint) != state.end()) return Fail(error, "duplicate");
+        Hash leaf{};
+        if (!UtxoLeaf(coin, leaf)) return Fail(error, "invalid coin");
+        (void)leaf;
+        state.emplace(coin.outpoint, coin);
+    }
+    if (!RootOf(state, tree, root, error)) return false;
+    out_state = std::move(state);
+    return true;
+}
+
+bool ReadFile(const std::filesystem::path &path, std::vector<uint8_t> &out, std::string &error) {
+    std::error_code ec;
+    if (std::filesystem::is_symlink(path, ec)) return Fail(error, "directory");
+    if (ec) return Fail(error, "io");
+    Fd file(::open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+    if (file.fd < 0) return Fail(error, "io");
+    std::vector<uint8_t> data;
+    uint8_t buffer[8192];
+    for (;;) {
+        const ssize_t n = ::read(file.fd, buffer, sizeof(buffer));
+        if (n < 0) {
+            if (errno == EINTR) continue;
+            return Fail(error, "io");
+        }
+        if (n == 0) break;
+        if (data.size() + static_cast<size_t>(n) > kMaxRecordBytes) return Fail(error, "size");
+        data.insert(data.end(), buffer, buffer + n);
+    }
+    out = std::move(data);
+    return true;
+}
+
+bool WriteAll(int fd, const uint8_t *data, size_t size) {
+    while (size > 0) {
+        const ssize_t n = ::write(fd, data, size);
+        if (n < 0) {
+            if (errno == EINTR) continue;
+            return false;
+        }
+        if (n == 0) return false;
+        data += n;
+        size -= static_cast<size_t>(n);
+    }
+    return true;
+}
+
+bool FsyncFd(int fd) {
+    for (;;) {
+        if (::fsync(fd) == 0) return true;
+        if (errno != EINTR) return false;
+    }
+}
+
+void FsyncDir(const std::filesystem::path &dir) {
+    const int fd = ::open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd < 0) return;
+    ::fsync(fd);
+    ::close(fd);
+}
+
+// Rename is the publication point. A crash before it leaves only the temp file,
+// which reopen ignores. The temp file is in the destination's directory.
+bool WriteAtomic(const std::filesystem::path &destination, const std::vector<uint8_t> &bytes,
+                 std::string &error) {
+    if (bytes.size() > kMaxRecordBytes) return Fail(error, "size");
+    const std::filesystem::path temporary(destination.string() + ".tmp");
+    Fd file(::open(temporary.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0644));
+    if (file.fd < 0) return Fail(error, "io");
+    if (!WriteAll(file.fd, bytes.data(), bytes.size()) || !FsyncFd(file.fd)) {
+        ::unlink(temporary.c_str());
+        return Fail(error, "io");
+    }
+    if (::close(file.fd) != 0) {
+        file.fd = -1;
+        ::unlink(temporary.c_str());
+        return Fail(error, "io");
+    }
+    file.fd = -1;
+    if (::rename(temporary.c_str(), destination.c_str()) != 0) {
+        ::unlink(temporary.c_str());
+        return Fail(error, "io");
+    }
+    std::filesystem::path parent = destination.parent_path();
+    if (parent.empty()) parent = ".";
+    FsyncDir(parent);
+    return true;
+}
+
+bool IsTempName(const std::string &name) {
+    return name.size() >= 4 && name.compare(name.size() - 4, 4, ".tmp") == 0;
+}
+
+bool ParseSequence(const std::string &name, uint32_t &sequence) {
+    if (name.size() != 12 || name.compare(8, 4, ".dat") != 0) return false;
+    sequence = 0;
+    for (int i = 0; i < 8; ++i) {
+        if (name[static_cast<size_t>(i)] < '0' || name[static_cast<size_t>(i)] > '9') return false;
+        sequence = sequence * 10u + static_cast<uint32_t>(name[static_cast<size_t>(i)] - '0');
+    }
+    return sequence >= 1 && sequence <= 99999999u;
+}
+
+std::filesystem::path UndoFile(const std::filesystem::path &undo_dir, uint32_t sequence) {
+    char name[16];
+    std::snprintf(name, sizeof(name), "%08u.dat", static_cast<unsigned>(sequence));
+    return undo_dir / name;
+}
+
+struct LoadedUndo {
+    uint32_t sequence = 0;
+    std::filesystem::path path;
+    UndoBody body;
+};
+
+bool CoinsToMap(const std::vector<Coin> &coins, CoinMap &out, std::string &error) {
+    out.clear();
+    for (const Coin &coin : coins) {
+        if (!out.emplace(coin.outpoint, coin).second) return Fail(error, "duplicate");
+    }
+    return true;
+}
+
+bool Replay(const std::vector<LoadedUndo> &undos, CoinMap &coins,
+            std::unique_ptr<IncrementalUtxoSet> &tree, Hash &root, std::string &error) {
+    coins.clear();
+    tree = std::make_unique<IncrementalUtxoSet>();
+    root = EmptyUtxoRoot();
+    for (const LoadedUndo &undo : undos) {
+        if (undo.body.prev_root != root) return Fail(error, "undo chain");
+        CoinMap next;
+        std::unique_ptr<IncrementalUtxoSet> next_tree;
+        Hash next_root{};
+        if (!ApplyForward(coins, undo.body.deleted, undo.body.inserted, next, next_tree, next_root,
+                          error))
+            return false;
+        if (next_root != undo.body.next_root) return Fail(error, "root");
+        coins = std::move(next);
+        tree = std::move(next_tree);
+        root = next_root;
+    }
+    return true;
+}
+
+} // namespace
+
+struct PersistentUtxoStore::Impl {
+    std::filesystem::path directory;
+    CoinMap coins;
+    Hash root{};
+    std::unique_ptr<IncrementalUtxoSet> tree;
+    uint32_t undo_tip = 0;
+
+    std::filesystem::path SnapshotPath() const { return directory / "snapshot.dat"; }
+    std::filesystem::path UndoDir() const { return directory / "undo"; }
+
+    bool Load(const std::string &dir, std::string &error);
+    bool Commit(const std::vector<Outpoint> &erase, const std::vector<Coin> &insert,
+                std::string &error);
+    bool Undo(std::string &error);
+};
+
+bool PersistentUtxoStore::Impl::Load(const std::string &dir, std::string &error) {
+    directory = std::filesystem::path(dir);
+    if (!directory.is_absolute()) return Fail(error, "directory");
+    std::error_code ec;
+    std::filesystem::create_directories(directory, ec);
+    if (ec || !std::filesystem::is_directory(directory, ec) || ec) return Fail(error, "directory");
+
+    bool saw_snapshot = false;
+    bool saw_undo = false;
+    std::filesystem::directory_iterator it(directory, ec);
+    if (ec) return Fail(error, "io");
+    for (; it != std::filesystem::directory_iterator(); it.increment(ec)) {
+        if (ec) return Fail(error, "io");
+        const std::string name = it->path().filename().string();
+        if (IsTempName(name)) continue;
+        if (std::filesystem::is_symlink(it->path(), ec) || ec) return Fail(error, "directory");
+        if (name == "snapshot.dat") {
+            if (!std::filesystem::is_regular_file(it->path(), ec) || ec)
+                return Fail(error, "directory");
+            saw_snapshot = true;
+            continue;
+        }
+        if (name == "undo") {
+            if (!std::filesystem::is_directory(it->path(), ec) || ec) return Fail(error, "directory");
+            saw_undo = true;
+            continue;
+        }
+        return Fail(error, "directory");
+    }
+
+    CoinMap snapshot_coins;
+    Hash snapshot_root = EmptyUtxoRoot();
+    std::unique_ptr<IncrementalUtxoSet> snapshot_tree = std::make_unique<IncrementalUtxoSet>();
+    if (saw_snapshot) {
+        std::vector<uint8_t> bytes;
+        if (!ReadFile(SnapshotPath(), bytes, error)) return false;
+        RecordView record;
+        if (!ParseRecord(bytes, record, error)) return false;
+        if (record.kind != kKindSnapshot) return Fail(error, "kind");
+        Hash stored{};
+        std::vector<Coin> listed;
+        if (!ParseSnapshot(record.payload, record.payload_len, stored, listed, error)) return false;
+        if (!CoinsToMap(listed, snapshot_coins, error)) return false;
+        if (!RootOf(snapshot_coins, snapshot_tree, snapshot_root, error)) return false;
+        if (snapshot_root != stored) return Fail(error, "root");
+    }
+
+    std::vector<LoadedUndo> undos;
+    if (saw_undo) {
+        std::filesystem::directory_iterator undo_it(UndoDir(), ec);
+        if (ec) return Fail(error, "io");
+        for (; undo_it != std::filesystem::directory_iterator(); undo_it.increment(ec)) {
+            if (ec) return Fail(error, "io");
+            const std::string name = undo_it->path().filename().string();
+            if (IsTempName(name)) continue;
+            if (std::filesystem::is_symlink(undo_it->path(), ec) || ec)
+                return Fail(error, "directory");
+            if (!std::filesystem::is_regular_file(undo_it->path(), ec) || ec)
+                return Fail(error, "directory");
+            LoadedUndo loaded;
+            if (!ParseSequence(name, loaded.sequence)) return Fail(error, "directory");
+            loaded.path = undo_it->path();
+            std::vector<uint8_t> bytes;
+            if (!ReadFile(loaded.path, bytes, error)) return false;
+            RecordView record;
+            if (!ParseRecord(bytes, record, error)) return false;
+            if (record.kind != kKindUndo) return Fail(error, "kind");
+            if (!ParseUndo(record.payload, record.payload_len, loaded.body, error)) return false;
+            undos.push_back(std::move(loaded));
+        }
+    }
+    std::sort(undos.begin(), undos.end(), [](const LoadedUndo &a, const LoadedUndo &b) {
+        return a.sequence < b.sequence;
+    });
+    for (size_t i = 0; i < undos.size(); ++i) {
+        if (undos[i].sequence != i + 1) return Fail(error, "undo chain");
+    }
+    if (!undos.empty() && undos.back().body.next_root != snapshot_root &&
+        undos.back().body.prev_root == snapshot_root) {
+        std::filesystem::remove(undos.back().path, ec);
+        if (ec) return Fail(error, "io");
+        undos.pop_back();
+    }
+
+    CoinMap replay_coins;
+    std::unique_ptr<IncrementalUtxoSet> replay_tree;
+    Hash replay_root{};
+    if (!Replay(undos, replay_coins, replay_tree, replay_root, error)) return false;
+    if (replay_root != snapshot_root || !SameSet(replay_coins, snapshot_coins))
+        return Fail(error, "root");
+    if (!replay_tree || replay_tree->Root() != replay_root || replay_tree->Size() != replay_coins.size())
+        return Fail(error, "root");
+
+    coins = std::move(replay_coins);
+    tree = std::move(replay_tree);
+    root = replay_root;
+    undo_tip = static_cast<uint32_t>(undos.size());
+    error.clear();
+    return true;
+}
+
+bool PersistentUtxoStore::Impl::Commit(const std::vector<Outpoint> &erase,
+                                       const std::vector<Coin> &insert, std::string &error) {
+    if (!tree) return Fail(error, "closed");
+    if (erase.empty() && insert.empty()) return Fail(error, "empty batch");
+    if (undo_tip >= 99999999u) return Fail(error, "undo chain");
+
+    std::vector<Coin> deleted;
+    CoinMap probe = coins;
+    for (const Outpoint &outpoint : erase) {
+        const auto it = probe.find(outpoint);
+        if (it == probe.end()) return Fail(error, "missing coin");
+        deleted.push_back(it->second);
+        probe.erase(it);
+    }
+    std::vector<Coin> inserted = insert;
+    for (const Coin &coin : inserted) {
+        if (probe.find(coin.outpoint) != probe.end()) return Fail(error, "duplicate");
+        Hash leaf{};
+        if (!UtxoLeaf(coin, leaf)) return Fail(error, "invalid coin");
+        (void)leaf;
+        probe.emplace(coin.outpoint, coin);
+    }
+    SortCoins(deleted);
+    SortCoins(inserted);
+    if (!StrictlyIncreasing(deleted) || !StrictlyIncreasing(inserted))
+        return Fail(error, "duplicate");
+
+    CoinMap next;
+    std::unique_ptr<IncrementalUtxoSet> next_tree;
+    Hash next_root{};
+    if (!ApplyForward(coins, deleted, inserted, next, next_tree, next_root, error)) return false;
+    if (!SameSet(next, probe) || !next_tree || next_tree->Root() != next_root)
+        return Fail(error, "inverse");
+    CoinMap back;
+    std::unique_ptr<IncrementalUtxoSet> back_tree;
+    Hash back_root{};
+    if (!ApplyInverse(next, deleted, inserted, back, back_tree, back_root, error) ||
+        back_root != root || !SameSet(back, coins))
+        return Fail(error, "inverse");
+
+    std::vector<uint8_t> undo_payload;
+    std::vector<uint8_t> snapshot_payload;
+    if (!BuildUndoPayload(root, next_root, deleted, inserted, undo_payload, error)) return false;
+    if (!BuildSnapshotPayload(next, next_root, snapshot_payload, error)) return false;
+    const std::vector<uint8_t> undo_bytes = Finish(kKindUndo, undo_payload);
+    const std::vector<uint8_t> snapshot_bytes = Finish(kKindSnapshot, snapshot_payload);
+    RecordView undo_view;
+    RecordView snapshot_view;
+    if (!ParseRecord(undo_bytes, undo_view, error) || undo_view.kind != kKindUndo)
+        return Fail(error, "internal");
+    if (!ParseRecord(snapshot_bytes, snapshot_view, error) || snapshot_view.kind != kKindSnapshot)
+        return Fail(error, "internal");
+    UndoBody parsed_undo;
+    if (!ParseUndo(undo_view.payload, undo_view.payload_len, parsed_undo, error) ||
+        parsed_undo.prev_root != root || parsed_undo.next_root != next_root ||
+        !SameCoins(parsed_undo.deleted, deleted) || !SameCoins(parsed_undo.inserted, inserted))
+        return Fail(error, "internal");
+    Hash stored{};
+    std::vector<Coin> listed;
+    CoinMap listed_map;
+    std::unique_ptr<IncrementalUtxoSet> listed_tree;
+    Hash listed_root{};
+    if (!ParseSnapshot(snapshot_view.payload, snapshot_view.payload_len, stored, listed, error) ||
+        stored != next_root || !CoinsToMap(listed, listed_map, error) ||
+        !RootOf(listed_map, listed_tree, listed_root, error) || listed_root != next_root)
+        return Fail(error, "internal");
+
+    std::error_code ec;
+    std::filesystem::create_directories(UndoDir(), ec);
+    if (ec) return Fail(error, "directory");
+    const uint32_t sequence = undo_tip + 1;
+    const std::filesystem::path undo_path = UndoFile(UndoDir(), sequence);
+    if (!WriteAtomic(undo_path, undo_bytes, error)) return false;
+    if (!WriteAtomic(SnapshotPath(), snapshot_bytes, error)) {
+        ec.clear();
+        std::filesystem::remove(undo_path, ec);
+        if (ec) error = "io";
+        return false;
+    }
+    coins = std::move(next);
+    tree = std::move(next_tree);
+    root = next_root;
+    undo_tip = sequence;
+    error.clear();
+    return true;
+}
+
+bool PersistentUtxoStore::Impl::Undo(std::string &error) {
+    if (!tree || undo_tip == 0) return Fail(error, "no undo");
+    const std::filesystem::path path = UndoFile(UndoDir(), undo_tip);
+    std::vector<uint8_t> bytes;
+    if (!ReadFile(path, bytes, error)) return false;
+    RecordView record;
+    if (!ParseRecord(bytes, record, error)) return false;
+    if (record.kind != kKindUndo) return Fail(error, "kind");
+    UndoBody body;
+    if (!ParseUndo(record.payload, record.payload_len, body, error)) return false;
+    if (body.next_root != root || body.next_root != tree->Root()) return Fail(error, "undo chain");
+
+    CoinMap next;
+    std::unique_ptr<IncrementalUtxoSet> next_tree;
+    Hash next_root{};
+    if (!ApplyInverse(coins, body.deleted, body.inserted, next, next_tree, next_root, error))
+        return false;
+    if (next_root != body.prev_root || !next_tree || next_tree->Root() != next_root)
+        return Fail(error, "root");
+    CoinMap forward;
+    std::unique_ptr<IncrementalUtxoSet> forward_tree;
+    Hash forward_root{};
+    if (!ApplyForward(next, body.deleted, body.inserted, forward, forward_tree, forward_root,
+                      error) ||
+        forward_root != root || !SameSet(forward, coins))
+        return Fail(error, "inverse");
+
+    std::vector<uint8_t> payload;
+    if (!BuildSnapshotPayload(next, next_root, payload, error)) return false;
+    if (!WriteAtomic(SnapshotPath(), Finish(kKindSnapshot, payload), error)) return false;
+    std::error_code ec;
+    if (!std::filesystem::remove(path, ec) || ec) {
+        std::vector<uint8_t> previous_payload;
+        std::string rollback_error;
+        if (BuildSnapshotPayload(coins, root, previous_payload, rollback_error)) {
+            WriteAtomic(SnapshotPath(), Finish(kKindSnapshot, previous_payload), rollback_error);
+        }
+        return Fail(error, "io");
+    }
+    coins = std::move(next);
+    tree = std::move(next_tree);
+    root = next_root;
+    --undo_tip;
+    error.clear();
+    return true;
+}
+
+PersistentUtxoStore::PersistentUtxoStore() = default;
+PersistentUtxoStore::~PersistentUtxoStore() = default;
+PersistentUtxoStore::PersistentUtxoStore(PersistentUtxoStore &&) noexcept = default;
+PersistentUtxoStore &PersistentUtxoStore::operator=(PersistentUtxoStore &&) noexcept = default;
+
+bool PersistentUtxoStore::Open(const std::string &directory, PersistentUtxoStore &store,
+                               std::string &error) {
+    store.impl_.reset();
+    auto loaded = std::make_unique<Impl>();
+    if (!loaded->Load(directory, error)) return false;
+    store.impl_ = std::move(loaded);
+    return true;
+}
+
+bool PersistentUtxoStore::IsOpen() const { return impl_ != nullptr; }
+
+bool PersistentUtxoStore::Root(Hash &out) const {
+    if (!impl_ || !impl_->tree) return false;
+    out = impl_->tree->Root();
+    return true;
+}
+
+size_t PersistentUtxoStore::Size() const {
+    return impl_ && impl_->tree ? impl_->tree->Size() : 0;
+}
+
+bool PersistentUtxoStore::Commit(const std::vector<Outpoint> &erase,
+                                 const std::vector<Coin> &insert, std::string &error) {
+    if (!impl_) return Fail(error, "closed");
+    return impl_->Commit(erase, insert, error);
+}
+
+bool PersistentUtxoStore::Undo(std::string &error) {
+    if (!impl_) return Fail(error, "closed");
+    return impl_->Undo(error);
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/persistent_utxo.h b/src/lotus_v2/persistent_utxo.h
new file mode 100644
index 000000000..8a0013424
--- /dev/null
+++ b/src/lotus_v2/persistent_utxo.h
@@ -0,0 +1,84 @@
+// Copyright (c) 2026 The Lotus developers
+// File-backed incremental UTXO snapshot and batch undo log.
+// Not used by lotusd, not ConnectTip, and not V2 block acceptance.
+//
+// Format version 1. The caller passes an absolute directory, which is created.
+//   snapshot.dat         current coin set; absent only before the first commit
+//   undo/00000001.dat    one record per committed batch, contiguous from 1
+// A record is written to "<final>.tmp" in the same directory, fsynced, and
+// renamed into place. Names ending in ".tmp" are ignored. Any other filename
+// is rejected. A short or length-mismatched record fails as truncated before
+// its embedded root is treated as state. The root is published only after the
+// checksum matches and IncrementalUtxoSet::Root of the decoded coins equals
+// the stored root byte for byte.
+//
+// Little-endian record:
+//   magic[8] = "LTSV2UTX"
+//   version u32 = 1
+//   kind u32 = 1 snapshot, 2 undo
+//   payload_len u64
+//   payload[payload_len]
+//   checksum[32] = BLAKE3("Lotus/v2/persist-utxo" || 0x00 || bytes before it)
+//
+// Snapshot payload. Coins are in (txid, index) order and are canonical
+// EncodeCoin bytes:
+//   root[32] | coin_count u64 | repeated (coin_len u32, coin bytes)
+// Undo payload is the forward batch, with deletions applied before inserts.
+// Applying its inverse must restore prev_root byte for byte:
+//   prev_root[32] | next_root[32]
+//   deleted_count u64 | deleted coins | inserted_count u64 | inserted coins
+// The undo chain runs from the empty UTXO root to the snapshot. A trailing
+// undo whose prev_root is already the snapshot root (crash between the two
+// renames) is discarded. One record is at most 512 MiB and 1000000 coins.
+#ifndef LOTUS_V2_PERSISTENT_UTXO_H
+#define LOTUS_V2_PERSISTENT_UTXO_H
+
+#include "sparse_state.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+
+constexpr uint32_t PERSISTENT_UTXO_VERSION = 1;
+
+class PersistentUtxoStore {
+public:
+    PersistentUtxoStore();
+    ~PersistentUtxoStore();
+    PersistentUtxoStore(PersistentUtxoStore &&) noexcept;
+    PersistentUtxoStore &operator=(PersistentUtxoStore &&) noexcept;
+    PersistentUtxoStore(const PersistentUtxoStore &) = delete;
+    PersistentUtxoStore &operator=(const PersistentUtxoStore &) = delete;
+
+    // Creates `directory` when needed. On failure `store` is closed and no
+    // root is written to an output parameter.
+    static bool Open(const std::string &directory, PersistentUtxoStore &store,
+                     std::string &error);
+
+    bool IsOpen() const;
+
+    // Writes IncrementalUtxoSet::Root. Returns false when closed and does not
+    // modify `out`.
+    bool Root(Hash &out) const;
+    size_t Size() const;
+
+    // Deletes these outpoints first, then inserts. Rejects an empty batch.
+    // Failure leaves the previous directory bytes and this object unchanged.
+    bool Commit(const std::vector<Outpoint> &erase, const std::vector<Coin> &insert,
+                std::string &error);
+
+    // Re-reads the last undo record and applies its inverse. The restored
+    // incremental root equals that record's prev_root byte for byte.
+    bool Undo(std::string &error);
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/test_persistent_utxo.cpp b/src/lotus_v2/test_persistent_utxo.cpp
new file mode 100644
index 000000000..a83003162
--- /dev/null
+++ b/src/lotus_v2/test_persistent_utxo.cpp
@@ -0,0 +1,434 @@
+// Copyright (c) 2026 The Lotus developers
+// Reopen and undo against a directory under /tmp. This does not accept a V2 block.
+#include "incremental_utxo.h"
+#include "persistent_utxo.h"
+#include "vendor/blake3/blake3.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <errno.h>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits.h>
+#include <string>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+std::string g_self;
+
+void Check(bool condition, const char *message) {
+    if (!condition) {
+        std::cerr << "V2 persistent UTXO: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+bool ByteEqual(const Hash &a, const Hash &b) {
+    for (size_t i = 0; i < a.size(); ++i) {
+        if (a[i] != b[i]) return false;
+    }
+    return true;
+}
+
+Coin MakeCoin(uint32_t index, uint64_t value) {
+    Coin coin;
+    for (unsigned i = 0; i < 32; ++i) coin.outpoint.tx_id[i] = static_cast<uint8_t>(i);
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = value;
+    Hash branch;
+    branch.fill(0x11);
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = index + 7;
+    coin.creation_parent_mtp = index + 1234;
+    coin.coinbase = index % 2 == 0;
+    return coin;
+}
+
+Coin MakeCoin(uint32_t index) { return MakeCoin(index, 1000 + index); }
+
+struct Oracle {
+    UtxoSet scalar;
+    IncrementalUtxoSet fast;
+};
+
+void ApplyOracle(Oracle &oracle, const std::vector<Outpoint> &erase,
+                 const std::vector<Coin> &insert) {
+    for (const Outpoint &outpoint : erase) {
+        Check(oracle.scalar.Erase(outpoint) && oracle.fast.Erase(outpoint), "oracle erase");
+    }
+    for (const Coin &coin : insert) {
+        Check(oracle.scalar.Insert(coin) && oracle.fast.Insert(coin), "oracle insert");
+    }
+    Check(ByteEqual(oracle.scalar.Root(), oracle.fast.Root()), "oracles agree");
+}
+
+void Apply(PersistentUtxoStore &store, Oracle &oracle, const std::vector<Outpoint> &erase,
+           const std::vector<Coin> &insert, const char *what) {
+    std::string error;
+    if (!store.Commit(erase, insert, error)) {
+        std::cerr << error << '\n';
+        Check(false, what);
+    }
+    ApplyOracle(oracle, erase, insert);
+    Hash root{};
+    Check(store.Root(root), "store root");
+    Check(ByteEqual(root, oracle.fast.Root()),
+          "committed root matches the incremental oracle byte for byte");
+    Check(store.Size() == oracle.fast.Size(), "size matches the incremental oracle");
+}
+
+std::vector<uint8_t> ReadRaw(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    Check(static_cast<bool>(in), "read record");
+    return std::vector<uint8_t>(std::istreambuf_iterator<char>(in),
+                                std::istreambuf_iterator<char>());
+}
+
+void WriteRaw(const std::filesystem::path &path, const std::vector<uint8_t> &bytes) {
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    Check(static_cast<bool>(out), "write raw record");
+    if (!bytes.empty()) {
+        out.write(reinterpret_cast<const char *>(bytes.data()),
+                  static_cast<std::streamsize>(bytes.size()));
+    }
+    out.close();
+    Check(static_cast<bool>(out), "close raw record");
+}
+
+Hash FileChecksum(const uint8_t *data, size_t size) {
+    blake3_hasher hasher;
+    blake3_hasher_init(&hasher);
+    const char tag[] = "Lotus/v2/persist-utxo";
+    blake3_hasher_update(&hasher, tag, sizeof(tag) - 1);
+    const uint8_t separator = 0;
+    blake3_hasher_update(&hasher, &separator, 1);
+    if (size != 0) blake3_hasher_update(&hasher, data, size);
+    Hash out{};
+    blake3_hasher_finalize(&hasher, out.data(), out.size());
+    return out;
+}
+
+void CheckFraming(const std::vector<uint8_t> &bytes, uint32_t kind) {
+    Check(bytes.size() >= 56, "record has header and checksum");
+    Check(std::string(bytes.begin(), bytes.begin() + 8) == "LTSV2UTX", "magic");
+    const uint32_t version = uint32_t(bytes[8]) | (uint32_t(bytes[9]) << 8) |
+                             (uint32_t(bytes[10]) << 16) | (uint32_t(bytes[11]) << 24);
+    Check(version == PERSISTENT_UTXO_VERSION, "explicit version integer");
+    const uint32_t got_kind = uint32_t(bytes[12]) | (uint32_t(bytes[13]) << 8) |
+                              (uint32_t(bytes[14]) << 16) | (uint32_t(bytes[15]) << 24);
+    Check(got_kind == kind, "record kind");
+    uint64_t payload_len = 0;
+    for (unsigned i = 0; i < 8; ++i) payload_len |= uint64_t(bytes[16 + i]) << (8 * i);
+    Check(payload_len == bytes.size() - 56, "payload length matches file");
+    const Hash sum = FileChecksum(bytes.data(), bytes.size() - 32);
+    Check(std::equal(sum.begin(), sum.end(), bytes.end() - 32), "documented checksum");
+}
+
+Hash RootOf(const PersistentUtxoStore &store) {
+    Hash root{};
+    Check(store.Root(root), "open store has a root");
+    return root;
+}
+
+void ExpectClosed(const std::string &directory, const char *expect_error) {
+    PersistentUtxoStore store;
+    std::string error;
+    Hash sentinel{};
+    sentinel.fill(0x5a);
+    Hash out = sentinel;
+    const bool opened = PersistentUtxoStore::Open(directory, store, error);
+    if (opened || error != expect_error || store.IsOpen() || store.Root(out) ||
+        !ByteEqual(out, sentinel)) {
+        std::cerr << "open error: [" << error << "]\n";
+        Check(false, "corrupt record must not publish a root");
+    }
+}
+
+Hash Child(const char *mode, const std::string &directory) {
+    int fds[2];
+    Check(::pipe(fds) == 0, "pipe");
+    const pid_t pid = ::fork();
+    Check(pid >= 0, "fork");
+    if (pid == 0) {
+        if (::dup2(fds[1], STDOUT_FILENO) < 0) _exit(127);
+        ::close(fds[0]);
+        ::close(fds[1]);
+        ::execl(g_self.c_str(), g_self.c_str(), mode, directory.c_str(),
+                static_cast<char *>(nullptr));
+        _exit(127);
+    }
+    ::close(fds[1]);
+    Hash root{};
+    size_t got = 0;
+    while (got < root.size()) {
+        const ssize_t n = ::read(fds[0], root.data() + got, root.size() - got);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        got += static_cast<size_t>(n);
+    }
+    ::close(fds[0]);
+    int status = 0;
+    for (;;) {
+        const pid_t waited = ::waitpid(pid, &status, 0);
+        if (waited < 0 && errno == EINTR) continue;
+        Check(waited == pid, "wait");
+        break;
+    }
+    Check(WIFEXITED(status) && WEXITSTATUS(status) == 0 && got == root.size(), "new process root");
+    return root;
+}
+
+int PrintRoot(const char *directory) {
+    PersistentUtxoStore store;
+    std::string error;
+    if (!PersistentUtxoStore::Open(directory, store, error)) {
+        std::cerr << error << '\n';
+        return 1;
+    }
+    Hash root{};
+    if (!store.Root(root) || std::fwrite(root.data(), 1, root.size(), stdout) != root.size()) return 1;
+    return 0;
+}
+
+int UndoPrint(const char *directory) {
+    PersistentUtxoStore store;
+    std::string error;
+    if (!PersistentUtxoStore::Open(directory, store, error) || !store.Undo(error)) {
+        std::cerr << error << '\n';
+        return 1;
+    }
+    Hash root{};
+    if (!store.Root(root) || std::fwrite(root.data(), 1, root.size(), stdout) != root.size()) return 1;
+    return 0;
+}
+
+std::string TempDir() {
+    char templ[] = "/tmp/lotus-v2-persist-XXXXXX";
+    Check(::mkdtemp(templ) != nullptr, "mkdtemp");
+    const std::string path(templ);
+    Check(path.rfind("/tmp/", 0) == 0, "temporary directory is under /tmp");
+    Check(path.find("..") == std::string::npos, "temporary path has no parent segment");
+    Check(path.find(".lotus") == std::string::npos && path.find("datadir") == std::string::npos,
+          "temporary path is not a datadir");
+    char resolved[PATH_MAX];
+    Check(::realpath(path.c_str(), resolved) != nullptr, "realpath");
+    const std::string absolute(resolved);
+    Check(absolute.rfind("/tmp/", 0) == 0 || absolute.rfind("/private/tmp/", 0) == 0,
+          "resolved temporary directory stays under /tmp");
+    return path;
+}
+
+std::vector<uint8_t> WithChecksum(std::vector<uint8_t> bytes) {
+    Check(bytes.size() > 32, "checksum span");
+    const Hash sum = FileChecksum(bytes.data(), bytes.size() - 32);
+    std::copy(sum.begin(), sum.end(), bytes.end() - 32);
+    return bytes;
+}
+
+void Run() {
+    const std::string base = TempDir();
+    const std::filesystem::path store_dir = std::filesystem::path(base) / "store";
+    PersistentUtxoStore store;
+    std::string error;
+    Check(PersistentUtxoStore::Open(store_dir.string(), store, error), "create and open empty directory");
+    Check(std::filesystem::is_directory(store_dir), "Open creates the caller directory");
+    Check(!std::filesystem::exists(store_dir / "snapshot.dat"), "empty store has no snapshot yet");
+    Hash empty = RootOf(store);
+    Check(ByteEqual(empty, EmptyUtxoRoot()) && store.Size() == 0, "empty root");
+    Check(ByteEqual(Child("--print-root", store_dir.string()), empty),
+          "new process sees the empty root");
+
+    Check(!store.Commit({MakeCoin(3).outpoint}, {}, error), "missing erase fails");
+    empty = RootOf(store);
+    Check(ByteEqual(empty, EmptyUtxoRoot()) && store.Size() == 0, "failed commit keeps the empty root");
+    Check(!std::filesystem::exists(store_dir / "snapshot.dat"), "failed commit writes no snapshot");
+    Check(!store.Commit({}, {}, error), "empty batch fails");
+
+    Oracle oracle;
+    const Coin c0 = MakeCoin(0);
+    const Coin c47 = MakeCoin(47);
+    const Coin c1 = MakeCoin(1);
+    Apply(store, oracle, {}, {c1, c47, c0}, "insert shared-prefix coins");
+    const Hash root1 = RootOf(store);
+    const std::filesystem::path snapshot = store_dir / "snapshot.dat";
+    const std::filesystem::path undo1 = store_dir / "undo" / "00000001.dat";
+    const std::vector<uint8_t> snapshot1 = ReadRaw(snapshot);
+    CheckFraming(snapshot1, 1);
+    CheckFraming(ReadRaw(undo1), 2);
+    Hash embedded{};
+    std::copy_n(snapshot1.begin() + 24, 32, embedded.begin());
+    Check(ByteEqual(embedded, root1), "snapshot payload begins with the incremental root");
+    Check(ByteEqual(Child("--print-root", store_dir.string()), root1),
+          "new process recomputes the same root");
+
+    const std::filesystem::path order_dir = std::filesystem::path(base) / "order";
+    PersistentUtxoStore reordered;
+    Check(PersistentUtxoStore::Open(order_dir.string(), reordered, error), "open order store");
+    Check(reordered.Commit({}, {c0, c47, c1}, error), "reverse insert order");
+    Check(ReadRaw(order_dir / "snapshot.dat") == snapshot1, "snapshot bytes are independent of insert order");
+    Check(ReadRaw(order_dir / "undo" / "00000001.dat") == ReadRaw(undo1),
+          "undo bytes are independent of insert order");
+
+    Coin token = MakeCoin(9, 50);
+    token.output.flags = 1;
+    token.output.token_id.fill(0x22);
+    token.output.token_id[0] = 1;
+    const Coin created = MakeCoin(10, 77);
+    Apply(store, oracle, {c47.outpoint}, {token, created}, "erase one coin and insert two");
+    const Hash root2 = RootOf(store);
+    Check(!ByteEqual(root2, root1), "mixed batch changes the root");
+    const std::vector<uint8_t> snapshot2 = ReadRaw(snapshot);
+    std::error_code copy_ec;
+    std::filesystem::copy(store_dir, std::filesystem::path(base) / "child",
+                          std::filesystem::copy_options::recursive, copy_ec);
+    Check(!copy_ec, "copy store for a second process");
+    Check(ByteEqual(Child("--undo-root", (std::filesystem::path(base) / "child").string()), root1),
+          "new process undo restores the previous root byte for byte");
+    Check(ByteEqual(RootOf(store), root2), "parent store is unchanged by the child undo");
+
+    Coin replaced = c1;
+    replaced.output.value = 4242;
+    Apply(store, oracle, {c1.outpoint}, {replaced}, "replace one coin");
+    const Hash root3 = RootOf(store);
+    Check(!ByteEqual(root3, root2), "replacement changes the root");
+
+    PersistentUtxoStore reopened;
+    Check(PersistentUtxoStore::Open(store_dir.string(), reopened, error), "reopen after replacement");
+    Check(ByteEqual(RootOf(reopened), root3) && reopened.Size() == oracle.fast.Size(),
+          "reopen recomputes the replacement root");
+    Check(reopened.Undo(error), "undo replacement");
+    Check(ByteEqual(RootOf(reopened), root2), "undo restores the pre-replacement root byte for byte");
+    Check(ReadRaw(snapshot) == snapshot2, "undo rewrites the previous snapshot bytes");
+    Check(reopened.Undo(error), "undo mixed batch");
+    Check(ByteEqual(RootOf(reopened), root1), "second undo restores the first root byte for byte");
+    Check(reopened.Undo(error), "undo the only remaining batch");
+    Check(ByteEqual(RootOf(reopened), EmptyUtxoRoot()) && reopened.Size() == 0,
+          "full undo restores the empty root");
+    Check(!reopened.Undo(error), "no undo record remains");
+    Check(ByteEqual(RootOf(reopened), EmptyUtxoRoot()), "failed undo does not change the empty root");
+    Check(ByteEqual(Child("--print-root", store_dir.string()), EmptyUtxoRoot()),
+          "new process sees the undone empty root");
+
+    Coin burn = MakeCoin(5);
+    burn.output.flags = 2;
+    burn.output.paths.clear();
+    Check(!reopened.Commit({}, {burn}, error), "burn coin rejects");
+    Coin malformed = MakeCoin(6);
+    malformed.output.paths.clear();
+    Check(!reopened.Commit({}, {malformed}, error), "malformed coin rejects");
+    Check(!reopened.Commit({}, {c0, c0}, error), "duplicate insert rejects");
+    Check(ByteEqual(RootOf(reopened), EmptyUtxoRoot()) && reopened.Size() == 0,
+          "rejected batches do not publish a root");
+
+    const std::filesystem::path crash_dir = std::filesystem::path(base) / "crash";
+    PersistentUtxoStore crash;
+    Check(PersistentUtxoStore::Open(crash_dir.string(), crash, error), "open crash store");
+    Oracle crash_oracle;
+    Apply(crash, crash_oracle, {}, {c0}, "crash baseline");
+    const Hash crash_root = RootOf(crash);
+    const std::vector<uint8_t> crash_snapshot = ReadRaw(crash_dir / "snapshot.dat");
+    Apply(crash, crash_oracle, {}, {c1}, "crash second batch");
+    WriteRaw(crash_dir / "snapshot.dat", crash_snapshot);
+    PersistentUtxoStore recovered;
+    Check(PersistentUtxoStore::Open(crash_dir.string(), recovered, error),
+          "undo written without its snapshot is discarded");
+    Check(ByteEqual(RootOf(recovered), crash_root) && recovered.Size() == 1,
+          "reopen keeps the last complete snapshot root");
+    Check(!std::filesystem::exists(crash_dir / "undo" / "00000002.dat"),
+          "uncommitted trailing undo is removed");
+
+    const std::filesystem::path bad_dir = std::filesystem::path(base) / "bad";
+    PersistentUtxoStore bad;
+    Check(PersistentUtxoStore::Open(bad_dir.string(), bad, error), "open corruption store");
+    Oracle bad_oracle;
+    Apply(bad, bad_oracle, {}, {c0, c47}, "corruption baseline");
+    Apply(bad, bad_oracle, {c0.outpoint}, {c1}, "corruption tip");
+    const Hash bad_root = RootOf(bad);
+    const std::filesystem::path bad_snapshot = bad_dir / "snapshot.dat";
+    const std::filesystem::path bad_undo = bad_dir / "undo" / "00000002.dat";
+    const std::vector<uint8_t> good_snapshot = ReadRaw(bad_snapshot);
+    const std::vector<uint8_t> good_undo = ReadRaw(bad_undo);
+    Check(good_snapshot.size() > 56 && good_undo.size() > 88, "records are longer than their roots");
+    Hash snapshot_prefix{};
+    std::copy_n(good_snapshot.begin() + 24, 32, snapshot_prefix.begin());
+    Check(ByteEqual(snapshot_prefix, bad_root), "snapshot prefix is the current root");
+    Hash undo_prev{};
+    Hash undo_next{};
+    std::copy_n(good_undo.begin() + 24, 32, undo_prev.begin());
+    std::copy_n(good_undo.begin() + 56, 32, undo_next.begin());
+    Check(ByteEqual(undo_next, bad_root) && !ByteEqual(undo_prev, bad_root),
+          "undo prefix carries the previous and current roots");
+
+    WriteRaw(bad_snapshot, {});
+    ExpectClosed(bad_dir.string(), "truncated");
+    WriteRaw(bad_snapshot, std::vector<uint8_t>(good_snapshot.begin(), good_snapshot.begin() + 56));
+    ExpectClosed(bad_dir.string(), "truncated");
+    WriteRaw(bad_snapshot, good_snapshot);
+
+    std::vector<uint8_t> short_undo(good_undo.begin(), good_undo.begin() + 88);
+    WriteRaw(bad_undo, short_undo);
+    ExpectClosed(bad_dir.string(), "truncated");
+    WriteRaw(bad_undo, good_undo);
+
+    std::vector<uint8_t> flipped = good_snapshot;
+    flipped.back() ^= 0xff;
+    WriteRaw(bad_snapshot, flipped);
+    ExpectClosed(bad_dir.string(), "checksum");
+    WriteRaw(bad_snapshot, good_snapshot);
+
+    std::vector<uint8_t> versioned = good_snapshot;
+    versioned[8] = 2;
+    WriteRaw(bad_snapshot, WithChecksum(versioned));
+    ExpectClosed(bad_dir.string(), "version");
+    WriteRaw(bad_snapshot, good_snapshot);
+
+    std::vector<uint8_t> wrong_root = good_snapshot;
+    wrong_root[24 + 31] ^= 0xff;
+    WriteRaw(bad_snapshot, WithChecksum(wrong_root));
+    ExpectClosed(bad_dir.string(), "root");
+    WriteRaw(bad_snapshot, good_snapshot);
+
+    PersistentUtxoStore live;
+    Check(PersistentUtxoStore::Open(bad_dir.string(), live, error), "reopen before truncating undo");
+    WriteRaw(bad_undo, short_undo);
+    Check(!live.Undo(error) && error == "truncated", "truncated undo record fails undo");
+    Check(ByteEqual(RootOf(live), bad_root), "failed undo does not publish the half-written previous root");
+    Check(ReadRaw(bad_snapshot) == good_snapshot, "failed undo leaves the snapshot in place");
+    WriteRaw(bad_undo, good_undo);
+
+    std::vector<uint8_t> temp_bytes = wrong_root;
+    WriteRaw(bad_dir / "snapshot.dat.tmp", WithChecksum(temp_bytes));
+    PersistentUtxoStore ignored_temp;
+    Check(PersistentUtxoStore::Open(bad_dir.string(), ignored_temp, error), "temp file is not a record");
+    Check(ByteEqual(RootOf(ignored_temp), bad_root), "a temp snapshot root is not published");
+
+    std::error_code remove_ec;
+    std::filesystem::remove_all(base, remove_ec);
+    Check(!remove_ec, "remove temporary directory");
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+    if (argc < 1 || argv[0] == nullptr) return 2;
+    g_self = argv[0];
+    if (argc == 3 && std::strcmp(argv[1], "--print-root") == 0) return PrintRoot(argv[2]);
+    if (argc == 3 && std::strcmp(argv[1], "--undo-root") == 0) return UndoPrint(argv[2]);
+    if (argc != 1) {
+        std::cerr << "usage: test_lotus_v2_persistent_utxo [--print-root dir | --undo-root dir]\n";
+        return 2;
+    }
+    Run();
+    std::cout << "V2 persistent UTXO snapshot and undo cases passed\n";
+    return 0;
+}
