 #include <algorithm>
 #include <array>
 #include <chrono>
@@ -171,6 +175,7 @@ namespace {
         NetworkProfile profile;
         TcpEndpoint listen;
         std::vector<TcpEndpoint> connect;
+        std::optional<std::string> chronik_bind;
     };
     TcpEndpoint Endpoint(const UniValue &v, bool listening) {
         Keys(v, {"address", "port"});
@@ -186,13 +191,21 @@ namespace {
     NetworkConfig Network(const std::string &path,
                           const DevelopmentManifest &m) {
         const auto v = ReadJson(path);
-        Keys(v, {"schema", "magic", "listen", "connect", "receive_limit",
-                 "local_policy"});
+        std::set<std::string> fields{"schema", "magic", "listen", "connect", "receive_limit", "local_policy"};
+        if (!v["chronik_bind"].isNull()) fields.insert("chronik_bind");
+        Keys(v, fields);
         Require(Number(v["schema"], 1) == 1, "network schema must be1");
         Require(v["local_policy"].isStr() &&
                     v["local_policy"].get_str() == "bounded-local-v1",
                 "explicit bounded-local-v1 policy required");
         NetworkConfig c{};
+        if (!v["chronik_bind"].isNull()) {
+            Require(v["chronik_bind"].isStr(), "chronik_bind must be an explicit numeric socket address");
+            c.chronik_bind = v["chronik_bind"].get_str();
+#ifndef LOTUS_V2_CHRONIK_CXX
+            throw std::runtime_error("V2 Chronik requires a Chronik-enabled build");
+#endif
+        }
         const auto magic = Unhex(v["magic"], 4);
         Require(magic.size() == 4, "explicit4-byte magic required");
         std::copy(magic.begin(), magic.end(), c.profile.magic.begin());
@@ -484,6 +497,7 @@ namespace {
                     PoolBudget budget{1, 1000000};
                     return static_cast<RelayAdmission>(pool->Submit(wire, snap.chain->stable_tip, budget).status);
                 }, [this](const Hash &hash, Bytes &wire) { return pool->ReadWire(hash, wire); });
+            OpenChronik(directory);
             retry.resize(network.connect.size());
             connections.reserve(MaxPeers);
             tracked_bodies.reserve(32);
@@ -493,6 +507,10 @@ namespace {
                     "cannot listen on explicit endpoint");
         }
         ~Node() {
+#ifdef LOTUS_V2_CHRONIK_CXX
+            if (chronik_service) { try { chronik_service.value()->invalidate_authority(); } catch (...) {} }
+            if (chronik_server) { try { chronik_server.value()->stop(); } catch (...) {} }
+#endif
             dispatcher.reset();
             connections.clear();
             manager.reset();
@@ -500,6 +518,17 @@ namespace {
         void Run();
 
     private:
+        void OpenChronik(const std::string &);
+        void InvalidateChronik();
+        void SyncChronik();
+        std::string chronik_address, chronik_error;
+        bool chronik_ready{};
+#ifdef LOTUS_V2_CHRONIK_CXX
+        std::optional<rust::Box<chronik_v2::V2Service>> chronik_service;
+        std::optional<rust::Box<chronik_v2::V2Server>> chronik_server;
+        std::unique_ptr<CxxChronikSink> chronik_sink;
+        std::unique_ptr<ChronikSync> chronik_sync;
+#endif
         DevelopmentManifest manifest;
         NetworkConfig network;
         std::unique_ptr<DevelopmentRuntime> runtime;
@@ -559,6 +588,57 @@ namespace {
         void Headers(uint64_t, bool);
         void Schedule(uint64_t);
     };
+    void Node::OpenChronik(const std::string &directory) {
+#ifdef LOTUS_V2_CHRONIK_CXX
+        if (!network.chronik_bind) return;
+        const auto path = directory + "/chronik-v2";
+        chronik_v2::Binding binding{};
+        binding.chain_id = manifest.hp.chain_id;
+        binding.genesis = manifest.hp.genesis_id;
+        binding.profile = network.profile.profile_digest;
+        // Transport record framing is larger than consensus block framing.
+        chronik_v2::ServiceLimits limits{32 * 1024 * 1024, 4096, 65536,
+                                        256, 16, 100, 65536, 131072, 262144};
+        chronik_service.emplace(chronik_v2::open_service(path, binding,
+            !std::filesystem::exists(path), limits));
+        chronik_sink = std::make_unique<CxxChronikSink>(**chronik_service);
+        chronik_sync = std::make_unique<ChronikSync>(*runtime, *chronik_sink,
+            manifest.hp.chain_id, manifest.op.transaction, manifest.block_read_limit);
+        chronik_server.emplace(chronik_v2::start_v2_server(**chronik_service,
+                                                        *network.chronik_bind));
+        chronik_address = std::string(chronik_server.value()->actual_address());
+#else
+        (void)directory;
+#endif
+    }
+    void Node::InvalidateChronik() {
+        chronik_ready = false;
+#ifdef LOTUS_V2_CHRONIK_CXX
+        // Failure to invalidate is fatal: native state must not change while
+        // HTTP could still advertise the old observation as authoritative.
+        if (chronik_service) chronik_service.value()->invalidate_authority();
+#endif
+    }
+    void Node::SyncChronik() {
+#ifdef LOTUS_V2_CHRONIK_CXX
+        if (!chronik_sync) return;
+        try {
+            const auto result = chronik_sync->Step(chronik_error);
+            if (result != ChronikSyncResult::Ready) return;
+            const auto checkpoint = chronik_sink->Checkpoint();
+            Require(bool(checkpoint), "ready Chronik lacks checkpoint");
+            chronik_v2::Anchor anchor{};
+            anchor.block_id = checkpoint->block_id;
+            anchor.height = checkpoint->height;
+            chronik_service.value()->publish_authority(anchor);
+            chronik_ready = true;
+            chronik_error.clear();
+        } catch (const std::exception &e) {
+            chronik_error = std::string(e.what()).substr(0, 512);
+            chronik_service.value()->invalidate_authority();
+        }
+#endif
+    }
     HeaderDecision Node::CheckHeader(const Header &h, uint64_t epoch) {
         const auto snap = runtime->Snapshot();
         const auto clock =
@@ -824,6 +904,11 @@ namespace {
             v.pushKV("pending_propagation", snap.chain->pending_propagation);
             v.pushKV("invalid_roots", snap.chain->invalid_root_count);
         }
+        if (network.chronik_bind) {
+            v.pushKV("chronik_address", chronik_address);
+            v.pushKV("chronik_ready", chronik_ready);
+            v.pushKV("chronik_error", chronik_error);
+        }
         v.pushKV("mempool_ready", pool->Snapshot(0, 0).status == PoolStatus::Accepted);
         static const char *coordinator_names[] = {"ready", "progress", "deferred", "capacity_refused", "storage_error"};
         v.pushKV("transaction_index", coordinator_names[static_cast<size_t>(pool_result)]);
@@ -1784,6 +1869,7 @@ namespace {
                                       size_t(manifest.block_read_limit)};
         const auto limits = TickLimits(manifest.block_read_limit);
         while (!stopping) {
+            InvalidateChronik();
             const auto now = Monotonic();
             Drain();
             Connections(now);
@@ -1846,6 +1932,7 @@ namespace {
             Drain();
             FlushRelay(Monotonic());
             ReadCommands();
+            if (!stopping) SyncChronik();
             Flush();
             std::array<pollfd, MaxPeers + 3> fds{};
             size_t count = 0;
