From 6c299f17f281fa03f5e3abc0d002fa315e353cd9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 22:56:47 -0700
Subject: [PATCH] Add a development-chain V2 genesis fixture

Record a height-0 regtest header from the existing monetary test profile
and the header version already exercised by the header tests. The helper
rejects a nonzero previous id or height. Subsidy 202 is the existing
height-one expectation; the state root is checked for determinism only,
with no new economic vector. This is not mainnet, not frozen consensus,
and not a block lotusd has accepted.
---
 src/lotus_v2/CMakeLists.txt       |  16 +++
 src/lotus_v2/dev_genesis.cpp      |  63 ++++++++++++
 src/lotus_v2/dev_genesis.h        |  30 ++++++
 src/lotus_v2/test_dev_genesis.cpp | 161 ++++++++++++++++++++++++++++++
 4 files changed, 270 insertions(+)
 create mode 100644 src/lotus_v2/dev_genesis.cpp
 create mode 100644 src/lotus_v2/dev_genesis.h
 create mode 100644 src/lotus_v2/test_dev_genesis.cpp

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index ea100bcc1..23becdfab 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -53,3 +53,19 @@ add_custom_target(check-lotus-v2-incremental-utxo
     COMMAND $<TARGET_FILE:test_lotus_v2_incremental_utxo>
     DEPENDS test_lotus_v2_incremental_utxo
 )
+
+# Development-chain genesis fixture. Not linked from lotusd.
+if(NOT TARGET Boost::headers)
+    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.30)
+        cmake_policy(SET CMP0167 OLD)
+    endif()
+    find_package(Boost 1.64 REQUIRED)
+endif()
+add_executable(test_lotus_v2_dev_genesis
+    test_dev_genesis.cpp dev_genesis.cpp monetary.cpp transaction.cpp)
+target_link_libraries(test_lotus_v2_dev_genesis
+    PRIVATE lotus_v2_sparse_state Boost::headers)
+add_custom_target(check-lotus-v2-dev-genesis
+    COMMAND $<TARGET_FILE:test_lotus_v2_dev_genesis>
+    DEPENDS test_lotus_v2_dev_genesis
+)
diff --git a/src/lotus_v2/dev_genesis.cpp b/src/lotus_v2/dev_genesis.cpp
new file mode 100644
index 000000000..997daa7a7
--- /dev/null
+++ b/src/lotus_v2/dev_genesis.cpp
@@ -0,0 +1,63 @@
+// Copyright (c) 2026 The Lotus developers
+#include "dev_genesis.h"
+
+#include "commitment.h"
+
+#include <algorithm>
+
+namespace lotus::v2 {
+namespace {
+
+// Version test_header.cpp already serializes as a valid header.
+constexpr uint32_t kHeaderVersion = 2;
+// Compact target test_header.cpp accepts. Not a new proof-of-work limit.
+constexpr uint32_t kHeaderBits = 0x1d00ffff;
+// Timestamp test_header.cpp serializes. It is inside MAX_TIME.
+constexpr uint64_t kHeaderTime = 0x010203040506;
+static_assert(kHeaderTime <= MAX_TIME, "development header time exceeds MAX_TIME");
+
+bool ZeroHash(const Hash &hash) {
+    return std::all_of(hash.begin(), hash.end(),
+                       [](uint8_t byte) { return byte == 0; });
+}
+
+// test_monetary.cpp initial state: reserve 9, tail 200, work 9, EMA 4.
+// Genesis records that state and does not issue.
+MonetaryState InitialTestState() {
+    MonetaryState state;
+    state.bootstrap_reserve = 9;
+    state.tail_subsidy = 200;
+    state.prev_work[0] = 9;
+    state.ema_block_cost = 4;
+    return InitializeMonetaryGenesis(DevelopmentGenesis, state, 0);
+}
+
+} // namespace
+
+bool MakeDevelopmentGenesis(const Hash &prev_id, uint64_t height,
+                            DevelopmentGenesisFixture &out) {
+    if (!ZeroHash(prev_id) || height != 0) return false;
+    Hash tx_root{};
+    if (!TransactionRoot({}, tx_root)) return false;
+    const MonetaryState state = InitialTestState();
+    const Hash state_root =
+        StateRoot(kDevelopmentChainId, 0, EmptyUtxoRoot(), state);
+    Header header;
+    header.prev_id = {};
+    header.bits = kHeaderBits;
+    header.time = kHeaderTime;
+    header.nonce = 0;
+    header.version = kHeaderVersion;
+    header.size = HEADER_SIZE; // Header encoding length, not a block-size rule.
+    header.height = 0;
+    header.tx_root = tx_root;
+    header.state_root = state_root;
+    DevelopmentGenesisFixture fixture;
+    fixture.chain_id = kDevelopmentChainId;
+    fixture.state = state;
+    fixture.header = header;
+    out = fixture;
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/dev_genesis.h b/src/lotus_v2/dev_genesis.h
new file mode 100644
index 000000000..0af7958a6
--- /dev/null
+++ b/src/lotus_v2/dev_genesis.h
@@ -0,0 +1,30 @@
+// Copyright (c) 2026 The Lotus developers
+// Development-chain regtest candidate. Not mainnet and not frozen consensus.
+#ifndef LOTUS_V2_DEV_GENESIS_H
+#define LOTUS_V2_DEV_GENESIS_H
+
+#include "monetary.h"
+
+namespace lotus::v2 {
+
+// Constants are the existing test profile and are not a mainnet genesis.
+inline constexpr MonetaryProfile DevelopmentGenesis{
+    2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000};
+
+// All-zero id for this development candidate. Not a mainnet chain id.
+inline constexpr ChainId kDevelopmentChainId{};
+
+struct DevelopmentGenesisFixture {
+    ChainId chain_id{};
+    MonetaryState state{};
+    Header header{};
+};
+
+// Height 0 and a zero previous id only. A nonzero previous id or height is
+// rejected and leaves out unchanged. This does not connect a block.
+bool MakeDevelopmentGenesis(const Hash &prev_id, uint64_t height,
+                            DevelopmentGenesisFixture &out);
+
+} // namespace lotus::v2
+
+#endif
diff --git a/src/lotus_v2/test_dev_genesis.cpp b/src/lotus_v2/test_dev_genesis.cpp
new file mode 100644
index 000000000..b80287004
--- /dev/null
+++ b/src/lotus_v2/test_dev_genesis.cpp
@@ -0,0 +1,161 @@
+// Copyright (c) 2026 The Lotus developers
+#include "dev_genesis.h"
+
+#include "commitment.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const char *message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+std::string Hex(const Hash &hash) {
+    constexpr char chars[] = "0123456789abcdef";
+    std::string result;
+    for (uint8_t byte : hash) {
+        result.push_back(chars[byte >> 4]);
+        result.push_back(chars[byte & 15]);
+    }
+    return result;
+}
+
+bool SameHeader(const Header &a, const Header &b) {
+    return a.prev_id == b.prev_id && a.bits == b.bits && a.time == b.time &&
+           a.nonce == b.nonce && a.version == b.version && a.size == b.size &&
+           a.height == b.height && a.tx_root == b.tx_root &&
+           a.state_root == b.state_root;
+}
+
+bool ZeroHash(const Hash &hash) {
+    for (uint8_t byte : hash) {
+        if (byte != 0) return false;
+    }
+    return true;
+}
+
+void RejectUnchanged(const Hash &prev_id, uint64_t height) {
+    DevelopmentGenesisFixture rejected;
+    rejected.header.version = 0xdeadbeef;
+    rejected.header.nonce = 7;
+    rejected.header.height = 99;
+    rejected.state.bootstrap_reserve = 123;
+    Check(!MakeDevelopmentGenesis(prev_id, height, rejected),
+          "nonzero previous id or height must be rejected");
+    Check(rejected.header.version == 0xdeadbeef && rejected.header.nonce == 7 &&
+              rejected.header.height == 99 &&
+              rejected.state.bootstrap_reserve == 123,
+          "rejected construction leaves the fixture unchanged");
+}
+} // namespace
+
+int main() {
+    try {
+        Check(HEADER_SIZE == 134, "header encoding is 134 bytes");
+        DevelopmentGenesisFixture fixture;
+        fixture.header.version = 1;
+        Check(MakeDevelopmentGenesis({}, 0, fixture), "construct height 0");
+        Check(fixture.chain_id == kDevelopmentChainId &&
+                  ZeroHash(fixture.chain_id),
+              "development chain id is all zeros");
+        const Header &header = fixture.header;
+        Check(ZeroHash(header.prev_id) && header.nonce == 0 &&
+                  header.version == 2 && header.height == 0 &&
+                  header.time <= MAX_TIME && header.bits == 0x1d00ffff &&
+                  header.size == HEADER_SIZE,
+              "height-0 header fields");
+        Hash pow_limit{};
+        pow_limit[31] = 0xff;
+        Hash target{};
+        Check(DecodeTarget(header.bits, pow_limit, target),
+              "bits stay the header test canonical target");
+
+        // Empty transaction root already pinned by test_commitment.cpp.
+        Hash tx_root{};
+        Check(TransactionRoot({}, tx_root) && header.tx_root == tx_root &&
+                  Hex(header.tx_root) ==
+                      "eebdd2bf2b0f92f1764c36eaef67a3ba72195a4206f2ea225db80605833beadb",
+              "tx root is the existing empty commitment");
+
+        Check(fixture.state.bootstrap_reserve == 9 &&
+                  fixture.state.tail_subsidy == 200 &&
+                  fixture.state.prev_work[0] == 9 &&
+                  fixture.state.ema_block_cost == 4,
+              "genesis state is the existing monetary test state");
+        const Hash utxo = EmptyUtxoRoot();
+        const Hash state_root =
+            StateRoot(fixture.chain_id, 0, utxo, fixture.state);
+        const Hash state_root_again =
+            StateRoot(fixture.chain_id, 0, utxo, fixture.state);
+        Check(header.state_root == state_root && state_root == state_root_again,
+              "state root matches two StateRoot calls");
+
+        std::array<uint8_t, HEADER_SIZE> bytes{};
+        Check(SerializeHeader(header, bytes), "serialize development header");
+        Check(bytes.size() == 134, "serialized header is exactly 134 bytes");
+        Header parsed;
+        parsed.version = 0x11111111;
+        Check(ParseHeader(bytes.data(), bytes.size(), parsed), "parse header");
+        Check(SameHeader(parsed, header), "parse restores the same fields");
+        std::array<uint8_t, HEADER_SIZE> repeated{};
+        Check(SerializeHeader(parsed, repeated) && repeated == bytes,
+              "serialize parsed header");
+
+        DevelopmentGenesisFixture again;
+        Check(MakeDevelopmentGenesis({}, 0, again) &&
+                  SameHeader(again.header, header) &&
+                  again.state.bootstrap_reserve ==
+                      fixture.state.bootstrap_reserve &&
+                  again.state.tail_subsidy == fixture.state.tail_subsidy &&
+                  again.state.prev_work == fixture.state.prev_work &&
+                  again.state.ema_block_cost == fixture.state.ema_block_cost,
+              "fixture construction is deterministic");
+
+        Hash nonzero{};
+        nonzero[0] = 1;
+        RejectUnchanged(nonzero, 0);
+        nonzero[0] = 0;
+        nonzero[31] = 1;
+        RejectUnchanged(nonzero, 0);
+        RejectUnchanged({}, 1);
+        RejectUnchanged({}, UINT64_MAX);
+        nonzero[0] = 1;
+        RejectUnchanged(nonzero, 1);
+
+        // Same AdvanceMonetary arguments as test_monetary.cpp Step(state).
+        // Subsidy 202 is that test's expected integer. The monetary tests do
+        // not pin a state-root integer, so only two calls are compared.
+        // No new economic vector was added.
+        const MonetaryTransition first = AdvanceMonetary(
+            DevelopmentGenesis, fixture.state, 9, {}, 0, 0, 1, 1, 4, 4);
+        const MonetaryTransition second = AdvanceMonetary(
+            DevelopmentGenesis, fixture.state, 9, {}, 0, 0, 1, 1, 4, 4);
+        Check(first.subsidy == 202 && second.subsidy == 202 &&
+                  first.bootstrap_issued == 2 && second.bootstrap_issued == 2 &&
+                  first.state.bootstrap_reserve == 7 &&
+                  second.state.bootstrap_reserve == 7 &&
+                  first.state.tail_subsidy == 200 &&
+                  second.state.tail_subsidy == 200,
+              "existing height-one subsidy");
+        const Hash transition_root =
+            StateRoot(fixture.chain_id, 1, utxo, first.state);
+        const Hash transition_root_again =
+            StateRoot(fixture.chain_id, 1, utxo, second.state);
+        Check(transition_root == transition_root_again,
+              "transition state root is deterministic");
+        Check(transition_root != header.state_root,
+              "issuance step is not the recorded genesis root");
+        std::cout << "development genesis fixture checks passed\n"
+                  << "subsidy 202 matches the existing monetary test; "
+                  << "state root checked for determinism only; "
+                  << "no new economic vector\n";
+    } catch (const std::exception &error) {
+        std::cerr << "development genesis: " << error.what() << '\n';
+        return EXIT_FAILURE;
+    }
+}
