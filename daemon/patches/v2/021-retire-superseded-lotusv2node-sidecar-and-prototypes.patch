-        Check(known && p.b.serving.grants == 0,
-              "cold compact request has no previously served body cache");
-        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(4)),
-                                           DownloadMode::Compact,
-                                           p.ms) == DispatcherResult::Queued,
-              "cold compact starts under two-query serving budget");
-        bool missing = false, retained = false;
-        for (unsigned n = 0; n < 1000 && !p.a.Stable(4); ++n) {
-            p.a.Poll(p.ms);
