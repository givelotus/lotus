-        if (!EncodeMissingRequest(j.reconstruction->Request(), uint32_t(count),
-                                  peers.at(j.key.first).limit, request, error))
-            return Fallback(j, now, error,
-                            FallbackReason::MissingRequestCapacity);
-        j.phase = Phase::Missing;
-        j.deadline = Until(j, now, config.limits.request_timeout_ms);
