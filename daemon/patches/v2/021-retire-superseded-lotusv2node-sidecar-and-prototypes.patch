-// Memory endpoints exercise real framing, Session and Transport while bounding
-// stream capacity and each short Read/Write. They implement no chain decisions.
-struct Pipe {
-    std::deque<uint8_t> bytes;
-    size_t capacity = 1 << 20;
-    bool closed = false;
-};
-class MemoryStream final : public ByteStream {
-public:
-    Pipe &in, &out;
-    size_t fragment = 31, write_allowance = SIZE_MAX;
-    bool block_write = false;
-    unsigned closes = 0;
-    MemoryStream(Pipe &i, Pipe &o) : in(i), out(o) {}
-    StreamResult Read(std::span<uint8_t> dst) override {
-        if (in.bytes.empty())
-            return {in.closed ? StreamStatus::Eof : StreamStatus::WouldBlock};
-        const auto n = std::min({dst.size(), fragment, in.bytes.size()});
-        for (size_t k = 0; k < n; ++k) {
-            dst[k] = in.bytes.front();
-            in.bytes.pop_front();
-        }
-        return {StreamStatus::Progress, n};
-    }
-    StreamResult Write(std::span<const uint8_t> src) override {
-        if (out.closed) return {StreamStatus::Error};
-        if (block_write || !write_allowance || out.bytes.size() == out.capacity)
-            return {StreamStatus::WouldBlock};
-        const auto n =
-            std::min({src.size(), fragment, out.capacity - out.bytes.size(),
-                      write_allowance});
-        out.bytes.insert(out.bytes.end(), src.begin(), src.begin() + n);
-        write_allowance -= n;
-        return {StreamStatus::Progress, n};
-    }
-    void Close() noexcept override {
-        ++closes;
-        out.closed = true;
-    }
-};
