-                        DevelopmentRuntimeResult::Progress)
-                    return HeaderDecision{
-                        HeaderDisposition::OperationalError, {}, e};
-                if (invalid)
-                    return HeaderDecision{HeaderDisposition::ConsensusInvalid,
-                                          {},
