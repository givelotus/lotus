-    void Node::OpenChronik(const std::string &directory) {
-#ifdef LOTUS_V2_CHRONIK_CXX
-        if (!network.chronik_bind) return;
-        // Schema 3 uses a fresh index; preserve earlier schema 2 data.
-        const auto path = directory + "/chronik-v2-explorer-v1";
-        chronik_v2::Binding binding{};
-        binding.chain_id = manifest.hp.chain_id;
-        binding.genesis = manifest.hp.genesis_id;
-        binding.profile = network.profile.profile_digest;
-        // Transport record framing is larger than consensus block framing.
-        chronik_v2::ServiceLimits limits{32 * 1024 * 1024, 4096, 65536,
-                                        256, 16, 100, 65536, 131072, 262144};
-        chronik_service.emplace(chronik_v2::open_service(path, binding,
-            !std::filesystem::exists(path), limits));
-        chronik_sink = std::make_unique<CxxChronikSink>(**chronik_service);
-        chronik_sync = std::make_unique<ChronikSync>(*runtime, *chronik_sink,
-            manifest.hp.chain_id, manifest.op.transaction, manifest.block_read_limit);
-        chronik_server.emplace(chronik_v2::start_v2_server(**chronik_service,
-                                                        *network.chronik_bind));
-        chronik_address = std::string(chronik_server.value()->actual_address());
-#else
-        (void)directory;
-#endif
-    }
-    void Node::SuspendChronik() {
-        // Temporarily fence HTTP reads while this native turn can mutate state.
-        // Preserve snapshot generations when the completed context is unchanged.
-#ifdef LOTUS_V2_CHRONIK_CXX
-        // Failure to suspend is fatal: native state must not change while
-        // HTTP could still advertise the old observation as authoritative.
-        if (chronik_service) chronik_service.value()->suspend_authority();
-#endif
-    }
-    void Node::SyncChronik() {
-        chronik_ready = false;
-#ifdef LOTUS_V2_CHRONIK_CXX
-        if (!chronik_sync) return;
-        try {
-            const auto result = chronik_sync->Step(chronik_error);
-            if (result != ChronikSyncResult::Ready) {
-                chronik_service.value()->invalidate_authority();
-                return;
-            }
-            const auto checkpoint = chronik_sink->Checkpoint();
-            Require(bool(checkpoint), "ready Chronik lacks checkpoint");
-            chronik_v2::Anchor anchor{};
-            anchor.block_id = checkpoint->block_id;
-            anchor.height = checkpoint->height;
-            const auto snapshot = runtime->Snapshot();
-            Require(snapshot.chain && !snapshot.reopen_required &&
-                        !snapshot.execution_paused &&
-                        !snapshot.chain->pending_journal &&
-                        !snapshot.chain->pending_receipt &&
-                        !snapshot.chain->pending_propagation &&
-                        snapshot.chain->stable_tip == checkpoint->block_id,
-                    "ready Chronik lacks stable native context");
-            chronik_service.value()->publish_authority_context(
-                anchor, snapshot.context_generation, snapshot.chain->revision);
-            chronik_ready = true;
-            chronik_error.clear();
-        } catch (const std::exception &e) {
-            chronik_error = std::string(e.what()).substr(0, 512);
-            chronik_service.value()->invalidate_authority();
-        }
-#endif
-    }
-    HeaderDecision Node::CheckHeader(const Header &h, uint64_t epoch) {
-        const auto snap = runtime->Snapshot();
-        const auto clock =
-            dispatcher ? dispatcher->HeaderClock() : std::nullopt;
-        if (!snap.chain || snap.reopen_required ||
-            snap.chain->profile_digest != network.profile.profile_digest ||
-            !dispatcher || epoch != dispatcher->FetchEpoch() || !clock)
-            return {HeaderDisposition::OperationalError,
-                    {},
-                    "runtime authority/fetch epoch unavailable"};
-        Hash id;
-        std::string error;
-        std::optional<IndexedHeader> indexed;
-        std::optional<Hash> invalid;
-        if (h.size > manifest.block_read_limit)
-            return {HeaderDisposition::Unsupported,
-                    {},
-                    "header body exceeds selected local policy capacity"};
-        if (!BlockId(network.profile.chain_id, h, id))
-            return {HeaderDisposition::Unsupported, {}, "unencodable header"};
-        if (runtime->ReadHeader(id, indexed, error) != Result::Progress ||
-            runtime->ReadInvalidity(id, invalid, error) != Result::Progress)
-            return {HeaderDisposition::OperationalError, {}, error};
-        if (invalid)
-            return {HeaderDisposition::ConsensusInvalid,
-                    {},
-                    "durable invalidity root"};
-        if (!indexed)
-            return {HeaderDisposition::MissingParent, h.prev_id,
-                    "header not indexed"};
-        std::array<uint8_t, HEADER_SIZE> a{}, b{};
-        if (!SerializeHeader(h, a) || !SerializeHeader(indexed->header, b) ||
-            a != b)
-            return {HeaderDisposition::OperationalError,
-                    {},
-                    "indexed header mismatch"};
-        if (indexed->max_ancestor_time > clock->wall_seconds &&
-            indexed->max_ancestor_time - clock->wall_seconds >
-                clock->future_window)
-            return {HeaderDisposition::Deferred,
-                    {},
-                    "authenticated ancestor temporarily future"};
-        return {HeaderDisposition::Eligible, {}, {}};
-    }
-    DownloadCallbacks Node::Callbacks() {
-        return {[this](const Header &h, uint64_t epoch) {
-                    return CheckHeader(h, epoch);
-                },
-                [this](PeerHandle, const ResourceNeed &n) {
-                    return staging.Reserve(n);
-                },
-                [](const Header &) { return CachedTransactions{{}, 0}; },
-                [this](std::span<const uint8_t> bytes, uint64_t epoch) {
-                    if (bytes.size() > manifest.block_read_limit)
-                        return BodyDecision{BodyDisposition::CapacityRefused,
-                                            {},
-                                            "local body capacity"};
-                    Header h;
-                    if (!ParseHeader(bytes.data(),
-                                     std::min(bytes.size(), HEADER_SIZE), h))
-                        return BodyDecision{BodyDisposition::MalformedBody,
-                                            {},
-                                            "body header framing"};
-                    const auto decision = CheckHeader(h, epoch);
-                    if (decision.disposition != HeaderDisposition::Eligible) {
-                        const auto d =
-                            decision.disposition ==
-                                    HeaderDisposition::ConsensusInvalid
-                                ? BodyDisposition::ConsensusInvalid
-                            : decision.disposition ==
-                                    HeaderDisposition::Deferred
-                                ? BodyDisposition::Deferred
-                            : decision.disposition ==
-                                    HeaderDisposition::MissingParent
-                                ? BodyDisposition::MissingParent
-                                : BodyDisposition::ContextChanged;
-                        return BodyDecision{d, decision.missing_parent,
-                                            decision.diagnostic};
-                    }
-                    Hash id;
-                    BlockId(network.profile.chain_id, h, id);
-                    CandidateBodyStatus status{};
-                    std::string error;
-                    const auto result = runtime->RetainBody(
-                        id, std::vector<uint8_t>(bytes.begin(), bytes.end()),
-                        status, error);
-                    if (result == Result::Progress &&
-                        (status == CandidateBodyStatus::RetainedAuthenticated ||
-                         status == CandidateBodyStatus::Duplicate)) {
-                        Track(id);
-                        return BodyDecision{
-                            BodyDisposition::RetainedAuthenticated, {}, {}};
-                    }
-                    return BodyDecision{result == Result::CapacityRefused
-                                            ? BodyDisposition::CapacityRefused
-                                        : result == Result::MalformedBody
-                                            ? BodyDisposition::MalformedBody
-                                            : BodyDisposition::StorageError,
-                                        {},
-                                        error};
-                }};
-    }
-    void Node::Queue(UniValue value) {
-        auto line = value.write() + "\n";
-        Require(line.size() <= OutputCap - output_bytes,
-                "local output backpressure capacity exhausted");
-        output_bytes += line.size();
-        output.push_back(std::move(line));
