-            answer.pushKV("tip", Hex(metadata.tip));
-            answer.pushKV("height", tip.height);
-            answer.pushKV("utxo_root", Hex(root));
-            answer.pushKV("state_root", Hex(tip.state_root));
-            answer.pushKV("monetary_bytes", Hex(metadata.monetary));
-            answer.pushKV("tip_header", Hex(metadata.header));
-            answer.pushKV("history", history);
-            answer.pushKV("proof", proof);
-            // Include the echoed id in the final wire-size check. No status or
-            // peer counters are added to this deliberately exact response.
-            answer.pushKV("id", request["id"].get_str());
-            if (answer.write().size() + 1 > 32768)
-                throw ProducerFailure("inconclusive",
-                                      "wallet context response capacity");
-            return answer;
-        } catch (const ProducerFailure &error) {
-            return failed(error.result, error.what());
-        } catch (const std::bad_alloc &) {
-            return failed("inconclusive",
-                          "wallet context allocation unavailable");
-        } catch (const std::length_error &) {
-            return failed("inconclusive", "wallet context allocation capacity");
-        } catch (const std::exception &error) {
-            return failed(phase, error.what());
-        }
-    }
-    bool Node::Command(const std::string &line) {
-        UniValue request, answer(UniValue::VOBJ);
-        std::string id;
-        bool producer = false, wallet = false;
-        try {
-            Require(request.read(line) && request.isObject(),
-                    "invalid command JSON");
-            wallet = request["command"].isStr() &&
-                     request["command"].get_str() == "walletcontext";
-            if (wallet)
-                Require(line.size() <= 1024,
-                        "walletcontext request exceeds1024bytes");
-            Require(request["id"].isStr(), "command id required");
-            id = request["id"].get_str();
-            if (wallet && id.size() > 64) id.clear();
-            Require(!id.empty() && id.size() <= 64, "command id bound");
-            Require(request["command"].isStr(), "command name required");
-            const auto name = request["command"].get_str();
-            producer = name == "mineblock" || name == "minepool";
-            if (name == "status" || name == "stop") {
-                Keys(request, {"id", "command"});
-                answer = Status();
-                if (name == "stop") stopping = true;
-            } else if (name == "submitblock") {
-                Keys(request, {"id", "command", "block"});
-                answer = SubmitBlock(
-                    Unhex(request["block"], manifest.block_read_limit));
-            } else if (name == "submittransaction") {
-                answer = SubmitTransaction(request);
-            } else if (name == "transactionstatus") {
-                answer = TransactionQuery(request);
-            } else if (name == "mempool") {
-                Keys(request, {"id", "command"});
-                answer = Mempool();
-            } else if (name == "minepool") {
-                answer = MinePool(request);
-            } else if (name == "mineblock") {
-                answer = MineBlock(request);
-            } else if (name == "readblock") {
-                answer = ReadBlock(request);
-            } else if (name == "walletcontext") {
-                answer = WalletContext(request, line.size());
-            } else if (name == "blockstatus") {
-                Keys(request, {"id", "command", "block_id"});
-                const auto block = HashOf(request["block_id"]);
-                std::optional<Hash> invalid;
-                std::optional<IndexedHeader> header;
-                std::string error;
-                Require(runtime->ReadInvalidity(block, invalid, error) ==
-                                Result::Progress &&
-                            runtime->ReadHeader(block, header, error) ==
-                                Result::Progress,
-                        error);
-                UniValue observation(UniValue::VOBJ);
-                RuntimeBlockObservation observed;
-                std::string observation_error;
-                const bool available = avalanche && runtime->ObserveAvalancheBlock(block, observed, observation_error);
-                observation.pushKV("observation_available", available);
-                observation.pushKV("reason", available ? "available" : avalanche ? "unavailable" : "disabled");
-                if (available) {
-                    observation.pushKV("known", observed.known);
-                    observation.pushKV("valid", observed.valid);
-                    observation.pushKV("active", observed.active);
-                    observation.pushKV("parked", observed.parked);
-                    observation.pushKV("finalized", observed.finalized);
-                    observation.pushKV("conflicting_finalized", observed.conflicting_finalized);
-                    observation.pushKV("forks_active", observed.forks_active);
-                    observation.pushKV("has_data", observed.has_data);
-                } else if (avalanche) {
-                    observation.pushKV("error", observation_error.substr(0, 1024));
-                }
-                answer = Status();
-                answer.pushKV("block_id", Hex(block));
-                answer.pushKV("block_observation", observation);
-                answer.pushKV("known_header", bool(header));
-                answer.pushKV("deterministic_invalid", bool(invalid));
-                answer.pushKV("invalid_root",
-                              invalid ? UniValue(Hex(*invalid)) : UniValue());
-                const auto snap = runtime->Snapshot();
-                answer.pushKV("is_active_tip",
-                              snap.chain && !snap.reopen_required &&
-                                  snap.chain->stable_tip == block);
-                answer.pushKV("ever_connected",
-                              header &&
-                                  header->stage == HeaderStage::Connected);
-            } else if (name == "coin" || name == "proof") {
-                Keys(request, {"id", "command", "txid", "index"});
-                Outpoint key{HashOf(request["txid"]),
-                             uint32_t(Number(request["index"], UINT32_MAX))};
-                std::string error;
-                answer = Status();
-                Require(answer["tip_known"].get_bool(),
-                        "coin authority unavailable");
-                auto coinHex = [](const std::optional<Coin> &coin) {
-                    if (!coin) return UniValue();
-                    std::vector<uint8_t> wire;
-                    Require(EncodeCoin(*coin, wire), "coin encoding failure");
-                    return UniValue(Hex(wire));
-                };
-                if (name == "coin") {
-                    std::optional<Coin> coin;
-                    Require(runtime->ReadCoin(key, coin, error) ==
-                                Result::Progress,
-                            error);
-                    answer.pushKV("coin", coinHex(coin));
-                } else {
-                    CoinProof proof;
-                    Require(runtime->ProveCoin(key, proof, error) ==
-                                Result::Progress,
-                            error);
-                    Require(VerifyCoinProof(key, proof,
-                                            HashOf(answer["utxo_root"])),
-                            "proof/root mismatch");
-                    UniValue p(UniValue::VOBJ), siblings(UniValue::VARR);
-                    p.pushKV("presence", uint64_t(proof.presence));
-                    p.pushKV("coin", coinHex(proof.coin));
-                    p.pushKV("bitmap", Hex(proof.bitmap));
-                    for (const auto &h : proof.siblings)
-                        siblings.push_back(Hex(h));
-                    p.pushKV("siblings", siblings);
-                    answer.pushKV("proof", p);
-                }
-            } else
-                throw std::runtime_error(
-                    "unsupported local command");
-            if (!answer.exists("ok")) answer.pushKV("ok", true);
-        } catch (const std::exception &e) {
-            answer = UniValue(UniValue::VOBJ);
-            answer.pushKV("ok", false);
-            if (wallet) answer.pushKV("result", "invalid");
-            answer.pushKV("error", std::string(e.what()).substr(0, 1024));
-        }
-        if (!answer.exists("id")) answer.pushKV("id", id);
-        Queue(std::move(answer));
-        return producer;
-    }
-    void Node::ReadCommands() {
-        const size_t cap =
-            2 * manifest.block_read_limit + 4 * MaxTransactions + 1024;
-        std::array<char, 8192> buf{};
-        // At most eight reads/64KiB and eight commands per loop, separate from
-        // sockets.
-        for (unsigned reads = 0; reads < 8 && !eof && input.size() < cap;
-             ++reads) {
-            const auto n = read(STDIN_FILENO, buf.data(),
-                                std::min(buf.size(), cap - input.size()));
-            if (n > 0)
-                input.append(buf.data(), n);
-            else if (n == 0)
-                eof = true;
-            else {
-                Require(errno == EAGAIN || errno == EWOULDBLOCK ||
-                            errno == EINTR,
-                        "local command input failure");
-                break;
-            }
-        }
-        unsigned processed = 0;
-        bool produced = false;
-        while (processed++ < 8) {
-            const auto end = input.find('\n');
-            if (end == std::string::npos) break;
-            produced = Command(input.substr(0, end));
-            input.erase(0, end + 1);
-            if (stopping || produced) break;
-        }
-        if (produced)
-            return; // retain buffered commands for the next network/runtime
-                    // turn
-        Require(input.size() < cap, "local command line capacity exceeded");
-        if (eof && input.empty()) stopping = true;
-        if (eof && !input.empty() && input.find('\n') == std::string::npos) {
-            Command(input);
-            input.clear();
-            stopping = true;
-        }
-    }
-    void Node::Attach(Connection &c, uint64_t now) {
-        Require(Entropy(c.nonce), "version entropy unavailable");
-        uint64_t extra;
-        Require(Entropy(extra), "version extra entropy unavailable");
-        SessionConfig s{};
-        s.network = network.profile;
-        s.supported_features |= TRANSACTION_RELAY_FEATURE;
-        if (avalanche) s.supported_features |= AVALANCHE_FEATURE;
-        // This development node requires relay-capable peers as local policy;
-        // bit 8 remains optional in the protocol's SessionConfig defaults.
-        s.required_features |= TRANSACTION_RELAY_FEATURE;
-        s.inbound = c.inbound;
-        s.handshake_timeout_ms = 10000;
-        s.incoming_nonce_allowed = [this](uint64_t nonce) {
-            return !outbound_nonces.contains(nonce);
-        };
-        s.local_version.timestamp = int64_t(Utc());
-        s.local_version.sender = VersionSender{VersionAddress{}, c.nonce};
-        s.local_version.user_agent =
-            Bytes{'l', 'o', 't', 'u', 's', '-', 'v', '2', '-', 'd', 'e', 'v'};
-        const auto snap = runtime->Snapshot();
-        std::optional<IndexedHeader> tip;
-        std::string error;
-        if (snap.chain) runtime->ReadHeader(snap.chain->stable_tip, tip, error);
-        s.local_version.starting_height =
-            tip ? int32_t(std::min<uint64_t>(tip->header.height, INT32_MAX))
-                : 0;
-        s.local_version.relay = true;
-        s.local_version.extra_entropy = extra;
-        c.transport = std::make_unique<Transport>(
-            c.stream, s,
-            TransportLimits{8192, size_t(network.profile.receive_limit) + 4096,
-                            16, 10000, 10000});
-        if (!c.inbound) outbound_nonces.insert(c.nonce);
-        if (dispatcher->Attach(*c.transport, c.id) !=
-            DispatcherResult::Queued) {
-            outbound_nonces.erase(c.nonce);
-            throw std::runtime_error("dispatcher attach refused");
-        }
-        if (dispatcher->Open(c.id, now) != DispatcherResult::Queued) {
-            dispatcher->Remove(c.id);
-            outbound_nonces.erase(c.nonce);
-            c.transport.reset();
-            throw std::runtime_error("dispatcher open refused");
-        }
-        c.refresh = now + 1000;
-    }
-    void Node::Connections(uint64_t now) {
-        for (auto i = connections.begin(); i != connections.end();) {
-            auto &c = **i;
-            if (!c.transport) {
-                const auto state = c.stream.PollConnect(now);
-                if (state == TcpConnectStatus::Connected)
-                    Attach(c, now);
-                else if (state != TcpConnectStatus::Pending)
-                    c.stream.Close();
-            }
-            if (!c.stream.IsOpen() ||
-                (c.transport && c.transport->State() == SessionState::Closed)) {
-                if (avalanche) avalanche->Disconnect(c.id, TransportDisconnectCause(
-                    c.transport ? c.transport->CloseReason() : TransportClose::None));
-                avalanche_peers.erase(c.id);
-                avalanche_activations.erase(c.id);
-                pending_headers.erase(c.id);
-                if (pending_avalanche_notice && pending_avalanche_notice->connection == c.id) pending_avalanche_notice.reset();
-                if (c.transport) dispatcher->Remove(c.id);
-                relay_output.Remove(c.id.value);
-                relay->RemovePeer(c.id.value);
-                relay_peers.erase(c.id);
-                outbound_nonces.erase(c.nonce);
-                if (c.target) retry[*c.target] = now + 1000;
-                i = connections.erase(i);
-            } else
-                ++i;
-        }
-        for (unsigned i = 0; i < 2 && connections.size() < MaxPeers; ++i) {
-            auto c = std::make_unique<Connection>();
-            TcpEndpoint remote;
-            const auto result = listener.Accept(c->stream, remote);
-            if (result == TcpAcceptStatus::WouldBlock) break;
-            Require(result == TcpAcceptStatus::Accepted,
-                    "listener accept failure");
-            c->inbound = true;
-            connections.push_back(std::move(c));
-            Attach(*connections.back(), now);
-        }
-        if (connections.size() >= MaxPeers || network.connect.empty()) return;
-        const size_t target = target_cursor++ % network.connect.size();
-        if (now < retry[target]) return;
-        for (const auto &c : connections)
-            if (c->target == target) return;
-        auto c = std::make_unique<Connection>();
-        c->target = target;
-        const auto result =
-            c->stream.BeginConnect(network.connect[target], now, 5000);
-        if (result != TcpConnectStatus::Connected &&
-            result != TcpConnectStatus::Pending) {
-            retry[target] = now + 1000;
-            return;
-        }
-        connections.push_back(std::move(c));
-        if (result == TcpConnectStatus::Connected)
-            Attach(*connections.back(), now);
-    }
-    void Node::Track(const Hash &id) {
-        if (std::find(tracked_bodies.begin(), tracked_bodies.end(), id) ==
-            tracked_bodies.end()) {
-            Require(tracked_bodies.size() < 32, "local body tracking capacity");
-            tracked_bodies.push_back(id);
-        }
-    }
-    void Node::CleanupBodies() {
-        // Four body entries/eight fixed-size queries per turn; only durable
-        // connected or invalid bodies can leave the volatile pool.
-        // Pinned/recovery bodies retain their leases.
-        for (unsigned n = 0; n < 4 && !tracked_bodies.empty(); ++n) {
-            body_cursor %= tracked_bodies.size();
-            const auto id = tracked_bodies[body_cursor];
-            std::optional<IndexedHeader> h;
-            std::optional<Hash> invalid;
-            std::string error;
-            const auto a = runtime->ReadHeader(id, h, error),
-                       b = runtime->ReadInvalidity(id, invalid, error);
-            if (a == Result::Progress && b == Result::Progress &&
-                (invalid || (h && h->stage == HeaderStage::Connected))) {
-                CandidateBodyStatus status =
-                    CandidateBodyStatus::OperationalError;
-                if (runtime->EvictBody(id, status, error) == Result::Progress ||
-                    status == CandidateBodyStatus::Missing) {
-                    tracked_bodies.erase(tracked_bodies.begin() + body_cursor);
-                    continue;
-                }
-            }
-            ++body_cursor;
-        }
-    }
-    // BEGIN INITIAL DOWNLOAD POLICY
-    bool Node::InitialDownload(uint64_t wall) {
-        // Match pinned ABC: completing initial catchup is a process-local latch.
-        // Live runtime authority remains independently fenced by the driver.
-        if (initial_download_complete) return false;
-        if (!network.avalanche) return true;
-        const auto s = runtime->Snapshot();
-        if (!s.chain || s.reopen_required || s.execution_paused || s.chain->pending_journal ||
-            s.chain->pending_receipt || s.chain->pending_propagation || manager->Stats().jobs ||
-            !pending_headers.empty() || (choices && (choices->best_fetch || choices->best_ready))) return true;
-        std::optional<IndexedHeader> tip;
-        std::string error;
-        if (runtime->ReadHeader(s.chain->stable_tip, tip, error) != Result::Progress || !tip) return true;
-        const auto &config = *network.avalanche;
-        if (tip->header.height < config.minimum_height || tip->header.time > wall ||
-            wall - tip->header.time > config.maximum_tip_age_seconds) return true;
-        initial_download_complete = true;
-        return false;
-    }
-    // END INITIAL DOWNLOAD POLICY
-    ava::DisconnectCause Node::ConnectionDisconnectCause(ConnectionId id) const {
-        for (const auto &c : connections)
-            if (c->id == id && c->transport)
-                return TransportDisconnectCause(c->transport->CloseReason());
-        return ava::DisconnectCause::Unknown;
-    }
-    void Node::ClosePeer(ConnectionId id, ava::DisconnectCause cause) {
-        if (cause == ava::DisconnectCause::Unknown) cause = ConnectionDisconnectCause(id);
-        if (avalanche) avalanche->Disconnect(id, cause);
-        avalanche_peers.erase(id);
-        avalanche_activations.erase(id);
-        pending_headers.erase(id);
-        relay_output.Remove(id.value);
-        relay->RemovePeer(id.value);
-        relay_peers.erase(id);
-        dispatcher->Remove(id);
-        for (auto &c : connections) if (c->id == id) c->stream.Close();
-    }
-    void Node::ReconcileCandidates() {
-        const auto snapshot = runtime->Snapshot();
-        if (!snapshot.chain || snapshot.reopen_required || snapshot.execution_paused ||
-            snapshot.chain->pending_journal || snapshot.chain->pending_receipt || snapshot.chain->pending_propagation) return;
-        const auto &view = *snapshot.chain;
-        if (!avalanche_scan_anchor || avalanche_scan_anchor->body_epoch != snapshot.body_epoch ||
-            avalanche_scan_anchor->context_generation != snapshot.context_generation ||
-            !avalanche_scan_anchor->chain || avalanche_scan_anchor->chain->stable_tip != view.stable_tip ||
-            avalanche_scan_anchor->chain->revision != view.revision) {
-            avalanche_scan_anchor = snapshot;
-            avalanche_candidate_page.reset();
-            avalanche_candidate_cursor.reset();
-            avalanche_candidate_index = 0;
-            avalanche_scan_complete = false;
-        }
-        if (avalanche_scan_complete) return;
-        if (!avalanche_candidate_page) {
-            CandidatePage page;
-            std::string error;
-            const auto result = runtime->ReadAvalancheCandidates(avalanche_candidate_cursor,
-                {16, 4096, 4096, 64 * 1024}, page, error);
-            if (result != Result::Progress) {
-                avalanche_reconcile_error = error;
-                Require(result == Result::CapacityRefused || result == Result::Recovering ||
-                    result == Result::Busy || result == Result::ReopenRequired, "Avalanche candidate scan: " + error);
-                return;
-            }
-            if (page.view.stable_tip != view.stable_tip || page.view.revision != view.revision) {
-                avalanche_scan_anchor.reset();
-                return;
-            }
-            avalanche_candidate_page = std::move(page);
-            avalanche_candidate_index = 0;
-        }
-        // A retained page is <=16 rows. Vote-record capacity retains the exact
-        // current row, allowing Tick/polls to free capacity before enrollment.
-        auto &page = *avalanche_candidate_page;
-        for (size_t work = 0; work < 16 && avalanche_candidate_index < page.rows.size(); ++work) {
-            const auto &id = page.rows[avalanche_candidate_index].id;
-            RuntimeBlockObservation observation;
-            std::string error;
-            if (!runtime->ObserveAvalancheBlock(id, observation, error)) {
-                avalanche_reconcile_error = error;
-                return;
-            }
-            if (observation.known && observation.valid && observation.has_data &&
-                !observation.finalized && !observation.conflicting_finalized) {
-                if (!avalanche->Reconcile({ava::ItemKind::Block, id}, !observation.parked, error)) {
-                    avalanche_reconcile_error = error;
-                    if (error == "vote-record-capacity") return;
-                    Require(error == "already-finalized-item", "Avalanche candidate reconciliation: " + error);
-                } else {
-                    Count(avalanche_reconciled);
-                    avalanche_last_reconciled = id;
-                    avalanche_reconcile_error.clear();
-                }
-            }
-            ++avalanche_candidate_index;
-        }
-        if (avalanche_candidate_index == page.rows.size()) {
-            avalanche_scan_complete = page.complete;
-            avalanche_candidate_cursor = page.complete ? std::nullopt : page.next;
-            avalanche_candidate_page.reset();
-        }
-    }
-    void Node::TickAvalanche(uint64_t ms, uint64_t wall) {
-        if (!avalanche) return;
-        Require(ms <= INT64_MAX && wall <= INT64_MAX, "Avalanche clock outside signed range");
-        // Dispatcher close notices can be suppressed by notice backpressure.
-        for (auto it = avalanche_peers.begin(); it != avalanche_peers.end();) {
-            const auto f = dispatcher->ActiveFeatures(*it);
-            if (!f || !(*f & AVALANCHE_FEATURE)) {
-                avalanche->Disconnect(*it, ConnectionDisconnectCause(*it));
-                it = avalanche_peers.erase(it);
-            } else ++it;
-        }
-        for (auto it = avalanche_activations.begin(); it != avalanche_activations.end();) {
-            const auto f = dispatcher->ActiveFeatures(*it);
-            if (!f || !(*f & AVALANCHE_FEATURE)) { it = avalanche_activations.erase(it); continue; }
-            std::string error;
-            const auto r = avalanche->Activate(*it, error);
-            if (r == ava::PeerResult::Backpressure) { ++it; continue; }
-            if (r == ava::PeerResult::Rejected) {
-                const auto id = *it; ++it;
-                ClosePeer(id, ava::DisconnectCause::NegotiatedCapacity);
-                continue;
-            }
-            if (r == ava::PeerResult::UnknownPeer) {
-                const auto id = *it; ++it; ClosePeer(id); continue;
-            }
-            Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
-            avalanche_peers.insert(*it);
-            it = avalanche_activations.erase(it);
-        }
-        const auto snapshot = runtime->Snapshot();
-        if (snapshot.chain) {
-            RuntimeBlockObservation observation;
-            std::string error;
-            if (runtime->ObserveAvalancheBlock(snapshot.chain->stable_tip, observation, error) &&
-                observation.known && observation.valid && observation.has_data && !observation.finalized) {
-                if (avalanche->Reconcile({ava::ItemKind::Block, snapshot.chain->stable_tip}, !observation.parked, error)) {
-                    Count(avalanche_reconciled);
-                    avalanche_last_reconciled = snapshot.chain->stable_tip;
-                    avalanche_reconcile_error.clear();
-                } else {
-                    avalanche_reconcile_error = error;
-                    if (error != "already-finalized-item" && error != "vote-record-capacity")
-                        throw std::runtime_error("Avalanche reconciliation: " + error);
-                }
-            }
-        }
-        ReconcileCandidates();
-        const auto result = avalanche->Tick(InitialDownload(wall), int64_t(ms), int64_t(wall));
-        if(result.disconnected_peer) ClosePeer(*result.disconnected_peer);
-        avalanche_error = result.message;
-        Require(result.code == ava::DriverCode::Ok || result.code == ava::DriverCode::NotReady ||
-                result.code == ava::DriverCode::Backpressure, "Avalanche tick: " + result.message);
-        if (ms >= avalanche_save_due) {
-            const auto saved = avalanche->Save();
-            Require(saved.code == ava::DriverCode::Ok || saved.code == ava::DriverCode::NotReady,
-                    "Avalanche peer save: " + saved.message);
-            avalanche_save_due = ms > UINT64_MAX - 60000 ? UINT64_MAX : ms + 60000;
-        }
-    }
-    bool Node::HandleApplication(DispatcherNotice notice, uint64_t now) {
-        auto &message = *notice.application;
-        const bool inventory = message.command == "inv" || message.command == "getdata" || message.command == "notfound";
-        const bool avalanche_message = message.command.starts_with("ava") || message.command == "getavaproofs";
-        std::optional<Message> transaction;
-        if (inventory) {
-            const auto limit = dispatcher->ActiveLimit(notice.connection);
-            if (!limit) return true;
-            std::vector<Inventory> items, tx, proof;
-            std::string error;
-            if (!DecodeInventory(message.payload, *limit, items, error)) { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
-            for (const auto &i : items) {
-                if (i.type == 1) tx.push_back(i);
-                else if (i.type == PROOF_INVENTORY_TYPE) proof.push_back(i);
-                else { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
-            }
-            if (!tx.empty()) {
-                Bytes bytes;
-                Require(EncodeInventory(tx, *limit, bytes, error), "transaction inventory encoding failed");
-                transaction = Message{message.command, std::move(bytes)};
-            }
-            if (!proof.empty()) {
-                Bytes bytes;
-                Require(EncodeInventory(proof, *limit, bytes, error), "proof inventory encoding failed");
-                message.payload = std::move(bytes);
-            } else notice.application.reset();
-        } else if (!avalanche_message) {
-            transaction = std::move(message);
