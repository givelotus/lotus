-        ReconstructionStatus status = ReconstructionStatus::NeedFullBlock;
-        uint32_t count = 0;
-        DownloadResult preflight_failure = DownloadResult::Idle;
-        {
-            CompactBlock compact;
-            auto decoded =
-                DecodeCompact(payload, config.network,
-                              peers.at(j.key.first).limit, compact, error);
-            if (decoded == CompactDecodeStatus::CapacityRefused)
-                return Fallback(j, now, error, FallbackReason::CompactCapacity);
-            if (decoded == CompactDecodeStatus::InvalidPeerMessage)
-                return End(j, DownloadResult::PeerMessageInvalid, error);
-            count = uint32_t(uint64_t(compact.short_ids.size()) +
-                             compact.prefilled.size());
-            j.reconstruction =
-                std::make_unique<CompactReconstruction>(config.network);
-            try {
-                CachedTransactions cache;
-                {
-                    CallbackScope scope(callback_active);
-                    cache = callbacks.cached_transactions(j.header);
-                }
-                if (cache.transactions.size() >
-                        config.limits.cache_candidates ||
-                    cache.complete_wire_bytes > config.limits.cache_bytes) {
-                    error = "cache candidate/byte quota";
-                    preflight_failure = DownloadResult::CapacityRefused;
-                } else {
-                    uint64_t actual_bytes;
-                    auto size = CacheWireBytes(
-                        cache.transactions, config.network.transaction,
-                        config.limits.cache_bytes, actual_bytes);
-                    if (size == CacheSize::Capacity) {
-                        error = "cache byte quota";
-                        preflight_failure = DownloadResult::CapacityRefused;
-                    } else if (size == CacheSize::Invalid ||
-                               actual_bytes != cache.complete_wire_bytes) {
-                        error = "invalid/stale validated-cache metadata";
-                        preflight_failure = DownloadResult::OperationalFailure;
-                    } else
-                        status = j.reconstruction->Start(
-                            compact, cache.transactions, error);
-                }
-            } catch (...) {
-                error = "cache/reconstruction exception";
-                preflight_failure = DownloadResult::OperationalFailure;
-            }
-        } // No decoded compact/prefilled copy survives a lease release.
-        if (preflight_failure == DownloadResult::CapacityRefused)
