-                    Unhex(request["coinbase_data"], 8192);
-            block_request.ordinary.reserve(request["transactions"].size());
-            for (const auto &encoded : request["transactions"].getValues()) {
-                const auto bytes = Unhex(encoded, manifest.block_read_limit);
-                Transaction tx;
-                if (!DecodeTransaction(bytes, manifest.op.transaction, tx,
-                                       error) ||
-                    !EncodeTransaction(tx, manifest.op.transaction, canonical,
-                                       error) ||
-                    canonical != bytes)
