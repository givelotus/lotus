-    UniValue Node::SubmitBlock(const std::vector<uint8_t> &wire,
-                               bool *retained) {
-        Header h;
-        Hash block;
-        Require(
-            ParseHeader(wire.data(), std::min(wire.size(), HEADER_SIZE), h) &&
-                BlockId(network.profile.chain_id, h, block),
-            "invalid block header framing");
-        HeaderAdmission header;
-        std::string error;
-        const auto admitted = runtime->AdmitHeader(h, header, error);
-        if (admitted != Result::Progress)
-            throw ProducerFailure(RuntimeFailure(admitted),
-                                  "header admission: " + error);
-        Require(header == HeaderAdmission::Stored ||
-                    header == HeaderAdmission::Known,
-                "header admission: " + error);
-        std::optional<Hash> invalid;
-        const auto invalidity = runtime->ReadInvalidity(block, invalid, error);
-        if (invalidity != Result::Progress)
-            throw ProducerFailure(RuntimeFailure(invalidity), error);
-        Require(!invalid, "block has a durable invalidity root");
-        CandidateBodyStatus status;
-        const auto body = runtime->RetainBody(block, wire, status, error);
-        if (body != Result::Progress)
-            throw ProducerFailure(RuntimeFailure(body),
-                                  "body retention: " + error);
-        Require(status == CandidateBodyStatus::RetainedAuthenticated ||
-                    status == CandidateBodyStatus::Duplicate,
-                "body retention: " + error);
-        if (retained) *retained = true;
-        Track(block);
-        choices.reset();
-        auto answer = Status();
-        answer.pushKV("block_id", Hex(block));
-        answer.pushKV("retained_authenticated", true);
-        answer.pushKV("accepted", false);
-        answer.pushKV("pending_validation", true);
-        return answer;
-    }
-    UniValue Node::MineBlock(const UniValue &request) {
-        std::optional<Hash> found_id;
-        bool retained = false;
-        const auto failure = [&](const std::string &category,
-                                 const std::string &error) {
-            UniValue answer(UniValue::VOBJ);
-            answer.pushKV("ok", false);
-            answer.pushKV("result", category);
-            answer.pushKV("error", error.substr(0, 1024));
-            answer.pushKV("found", bool(found_id));
-            answer.pushKV("accepted", false);
-            answer.pushKV("pending_validation", retained);
-            if (found_id) {
-                answer.pushKV("block_id", Hex(*found_id));
-                answer.pushKV("retained_authenticated", retained);
-            }
-            return answer;
-        };
-        std::string failure_phase = "invalid_request";
-        try {
-            Keys(request, {"id", "command", "expected_parent", "time",
-                           "max_claim", "coinbase_output", "coinbase_data",
-                           "transactions", "start_nonce", "max_attempts"});
-            LocalBlockRequest block_request;
-            block_request.expected_parent = HashOf(request["expected_parent"]);
-            block_request.time = Number(request["time"], MAX_TIME);
-            block_request.max_claim = DecimalU64(request["max_claim"]);
-            const auto start = DecimalU64(request["start_nonce"]);
-            const auto attempts =
-                Number(request["max_attempts"], MAX_NONCE_ATTEMPTS);
-            Require(request["transactions"].isArray(),
-                    "ordinary transactions must be an array");
-            if (request["transactions"].size() > MaxTransactions - 1)
-                throw ProducerFailure(
-                    "capacity_refused",
-                    "ordinary transaction count exceeds local capacity");
-            // Validate ALL aggregate byte/count bounds before copying hex or
-            // reserving the decoded transaction array. JSON parse/input storage
-            // retains its separate explicit line allowance.
-            uint64_t remaining = manifest.block_read_limit;
-            const auto destination_size =
-                HexSize(request["coinbase_output"], remaining);
-            if (destination_size > MAX_OUTPUT_BYTES)
-                throw ProducerFailure("capacity_refused",
-                                      "coinbase output exceeds codec capacity");
-            remaining -= destination_size;
-            if (!request["coinbase_data"].isNull()) {
-                const auto size = HexSize(request["coinbase_data"],
-                                          std::min<uint64_t>(8192, remaining));
-                Require(size != 0, "present coinbase_data must be nonempty");
-                remaining -= size;
-            }
-            for (const auto &tx : request["transactions"].getValues()) {
-                const auto size = HexSize(tx, remaining);
-                Require(size != 0, "empty ordinary transaction frame");
-                remaining -= size;
-            }
-            const auto snapshot = runtime->Snapshot();
-            if (snapshot.reopen_required)
-                throw ProducerFailure("reopen_required",
-                                      "runtime authority requires reopening");
-            if (!snapshot.chain || snapshot.execution_paused)
-                throw ProducerFailure(
-                    "inconclusive", "runtime execution authority unavailable");
-            if (snapshot.chain->pending_journal ||
-                snapshot.chain->pending_receipt ||
-                snapshot.chain->pending_propagation)
-                throw ProducerFailure(
-                    "busy", "runtime recovery/receipt/propagation pending");
-            if (snapshot.chain->stable_tip != block_request.expected_parent)
-                throw ProducerFailure(
-                    "stale_parent",
-                    "expected parent is not the authoritative stable tip");
-            const auto now = Utc();
-            const auto future = [&](uint64_t time) {
-                return time > now && time - now > manifest.future_window;
-            };
-            if (future(block_request.time) ||
-                future(snapshot.chain->active_max_ancestor_time))
-                throw ProducerFailure("deferred",
-                                      "candidate or authenticated ancestor is "
-                                      "temporarily future");
