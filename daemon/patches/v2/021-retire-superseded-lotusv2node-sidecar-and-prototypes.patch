-DownloadEvent DownloadManager::RegisterPeer(uint32_t limit) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, {}, false);
-    if (!limit || limit > s.config.network.receive_limit)
-        return Event(DownloadResult::OperationalFailure, {}, {},
-                     "invalid negotiated peer capacity");
-    if (s.stats.peers >= s.config.limits.peers)
-        return Event(DownloadResult::CapacityRefused, {}, {}, "peer quota");
-    PeerHandle handle;
-    if (!NextPeerHandle(s.previous_handle, handle))
-        return Event(DownloadResult::OperationalFailure, {}, {},
-                     "peer handle exhausted");
-    s.peers.emplace(handle, Impl::Peer{limit, 0, 0, 0, {}});
-    s.previous_handle = handle.value;
-    ++s.stats.peers;
-    return Event(DownloadResult::Registered, handle);
-}
-DownloadEvent DownloadManager::RequestBlock(PeerHandle peer,
-                                            const Header &header,
-                                            DownloadMode mode, uint64_t now) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, peer);
-    DownloadEvent failure;
-    if (!s.Time(now, failure)) return failure;
-    auto p = s.peers.find(peer);
-    if (p == s.peers.end())
-        return Event(DownloadResult::Ignored, peer, {},
-                     "disconnected/unknown peer handle");
-    if (p->second.disabled)
-        return Event(DownloadResult::OperationalFailure, peer, {},
-                     "peer disabled after operational failure");
-    Hash id;
-    if (header.version != 2 || !BlockId(s.config.network.chain_id, header, id))
-        return Event(DownloadResult::PeerMessageInvalid, peer, {},
-                     "header structure");
-    Key key{peer, id};
-    if (s.jobs.count(key))
-        return Event(DownloadResult::Busy, peer, id, "download already active");
-    if (p->second.guards.count(id))
-        return Event(DownloadResult::RetryElsewhere, peer, id,
-                     "retired connection/BlockID lifecycle");
-    if (s.stats.jobs >= s.config.limits.jobs_global ||
-        p->second.jobs >= s.config.limits.jobs_per_peer)
-        return Event(DownloadResult::CapacityRefused, peer, id,
-                     "download job quota");
-    if (s.config.limits.lifecycle_timeout_ms > UINT64_MAX - now)
-        return Event(DownloadResult::OperationalFailure, peer, id,
-                     "download deadline overflow");
-    auto job = std::make_unique<Impl::Job>();
-    job->key = key;
-    job->header = header;
-    job->mode = mode;
-    job->generation = s.config.context_generation;
-    job->lifecycle = now + s.config.limits.lifecycle_timeout_ms;
-    job->deadline = job->lifecycle;
-    auto &j = *job;
-    s.jobs.emplace(key, std::move(job));
-    ++s.stats.jobs;
-    ++p->second.jobs;
-    auto h = s.HeaderCheck(j);
-    if (DeferredHeader(h.disposition)) return s.DeferHeader(j, h, now);
-    if (h.disposition != HeaderDisposition::Eligible)
-        return s.HeaderFailure(j, h);
-    return s.Issue(j, now);
-}
-DownloadEvent DownloadManager::OnMessage(PeerHandle peer,
-                                         const Message &message, uint64_t now) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, peer);
-    DownloadEvent failure;
-    if (!s.Time(now, failure)) return failure;
-    auto p = s.peers.find(peer);
-    if (p == s.peers.end())
-        return Event(DownloadResult::Ignored, peer, {},
-                     "disconnected/unknown peer handle");
-    if (p->second.disabled)
-        return Event(DownloadResult::OperationalFailure, peer, {},
-                     "peer disabled after operational failure");
-    if (message.payload.size() > p->second.limit)
-        return Event(DownloadResult::PeerMessageInvalid, peer, {},
-                     "payload exceeds negotiated limit");
-    if (message.command == "notfound") return s.NotFound(peer, message.payload);
-    Hash id;
-    if (message.command == "block" || message.command == "cmpctblock") {
-        Header h;
-        if (message.payload.size() < HEADER_SIZE ||
-            !ParseHeader(message.payload.data(), HEADER_SIZE, h) ||
-            h.version != 2 || !BlockId(s.config.network.chain_id, h, id))
-            return Event(DownloadResult::PeerMessageInvalid, peer, {},
-                         "response header structure");
-    } else if (message.command == "blocktxn") {
-        if (message.payload.size() < 32)
-            return Event(DownloadResult::PeerMessageInvalid, peer, {},
-                         "blocktxn identity prefix");
-        std::copy_n(message.payload.begin(), 32, id.begin());
-    } else
-        return Event(DownloadResult::Ignored, peer);
-    auto it = s.jobs.find({peer, id});
-    if (it == s.jobs.end())
-        return Event(DownloadResult::Ignored, peer, id,
-                     "unsolicited/retired response");
-    auto &j = *it->second;
-    if (now >= j.deadline)
-        return s.End(j, DownloadResult::RetryElsewhere, "download timeout");
-    if (message.command == "block") return s.Full(j, message.payload, now);
-    if (message.command == "cmpctblock")
-        return s.Compact(j, message.payload, now);
-    return s.Missing(j, message.payload, now);
-}
-DownloadEvent DownloadManager::PollTimeout(uint64_t now) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, {});
-    DownloadEvent failure;
-    if (!s.Time(now, failure)) return failure;
-    for (auto &entry : s.jobs) {
-        auto &j = *entry.second;
-        if (now >= j.deadline)
-            return s.End(j, DownloadResult::RetryElsewhere, "download timeout");
-    }
-    for (auto &entry : s.jobs) {
-        auto &j = *entry.second;
-        if (!s.IsDeferred(j) || now < j.retry) continue;
-        auto h = s.HeaderCheck(j);
-        if (DeferredHeader(h.disposition)) {
-            if (h.disposition == HeaderDisposition::MissingParent &&
-                !h.missing_parent)
-                return s.End(j, DownloadResult::OperationalFailure,
-                             "missing parent ID");
-            j.retry = s.Until(j, now, s.config.limits.retry_interval_ms);
-            auto e = Event(h.disposition == HeaderDisposition::MissingParent
-                               ? DownloadResult::NeedHeaders
-                               : DownloadResult::Deferred,
-                           j.key.first, j.key.second, h.diagnostic);
-            e.missing_parent = h.missing_parent;
-            return e;
-        }
-        if (h.disposition != HeaderDisposition::Eligible)
-            return s.HeaderFailure(j, h);
-        if (j.phase == Impl::Phase::DeferredBody)
-            return s.Admit(j, j.body, now);
-        return s.Issue(j, now);
-    }
-    return {};
-}
-DownloadEvent DownloadManager::Cancel(PeerHandle peer, const Hash &id) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, peer);
-    auto it = s.jobs.find({peer, id});
-    if (it == s.jobs.end()) return Event(DownloadResult::Ignored, peer, id);
-    return s.End(*it->second, DownloadResult::Cancelled, "download cancelled");
-}
-DownloadEvent DownloadManager::OnReorg(uint64_t generation) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, {});
-    if (generation <= s.config.context_generation)
-        return Event(DownloadResult::OperationalFailure, {}, {},
-                     "context generation must advance");
-    auto e = Event(DownloadResult::Cancelled, {}, {}, "chain context changed");
-    while (!s.jobs.empty()) {
-        e.affected.push_back(s.jobs.begin()->first.second);
-        s.Erase(s.jobs.begin()->first);
-    }
-    s.config.context_generation = generation;
-    return e;
-}
-DownloadEvent DownloadManager::OnDisconnect(PeerHandle peer) {
-    auto &s = *impl_;
-    if (s.callback_active || s.operation_active)
-        return Event(DownloadResult::OperationalFailure);
-    Impl::OperationScope operation(s, peer);
-    auto p = s.peers.find(peer);
-    if (p == s.peers.end()) return Event(DownloadResult::Ignored, peer);
-    auto e = Event(DownloadResult::Cancelled, peer, {}, "peer disconnected");
-    for (auto it = s.jobs.begin(); it != s.jobs.end();) {
-        if (it->first.first == peer) {
-            auto key = it->first;
-            ++it;
-            e.affected.push_back(key.second);
-            s.Erase(key);
-        } else
-            ++it;
-    }
-    s.stats.tombstones -= uint32_t(p->second.guards.size());
-    s.peers.erase(p);
-    --s.stats.peers;
-    return e;
-}
-DownloadStats DownloadManager::Stats() const {
-    return impl_->stats;
-}
-} // namespace lotus::v2::peer
