-                const auto count = it == pending.end() ? 0 : it->second.messages.size();
-                const auto bytes = it == pending.end() ? 0 : it->second.bytes;
-                if (need.first > MaxMessages - count || need.second > MaxBytes - bytes)
-                    refused.insert(peer);
-            }
-            // Each peer's whole result is staged or removed. Peer state cannot
-            // survive any uncommitted action that the relay already recorded.
-            for (const auto peer : refused) Remove(peer);
-            for (auto &action : actions) if (!refused.contains(action.peer)) {
-                auto &queue = pending[action.peer];
-                queue.bytes += 24 + action.message.payload.size();
-                queue.messages.push_back(std::move(action.message));
-            }
-            return refused;
-        }
-        template <typename Send> std::set<uint64_t> Flush(Send send) {
-            std::set<uint64_t> failed;
-            for (auto it = pending.begin(); it != pending.end();) {
-                auto &queue = it->second;
-                // The dispatcher takes by value; preserve the original until
-                // Queued, including on ordinary Busy output backpressure.
-                const auto result = send(it->first, queue.messages.front());
-                if (result == DispatcherResult::Busy) { ++it; continue; }
-                if (result != DispatcherResult::Queued) {
-                    failed.insert(it->first);
-                    it = pending.erase(it);
-                    continue;
-                }
-                queue.bytes -= 24 + queue.messages.front().payload.size();
-                queue.messages.pop_front();
-                if (queue.messages.empty()) it = pending.erase(it);
-                else ++it;
-            }
-            return failed;
-        }
-    };
