-            Event(DownloadResult::NeedTransactions, j.key.first, j.key.second);
-        e.outbound = Message{"getblocktxn", std::move(request)};
-        return e;
-    }
-    DownloadEvent Full(Job &j, std::span<const uint8_t> payload, uint64_t now) {
-        if (IsDeferred(j))
-            return Event(DownloadResult::Ignored, j.key.first, j.key.second,
-                         "late full response while deferred");
-        if (payload.size() != j.header.size)
-            return End(j, DownloadResult::PeerMessageInvalid,
-                       "complete body/header size mismatch");
-        auto h = HeaderCheck(j);
-        if (DeferredHeader(h.disposition)) {
-            if (h.disposition == HeaderDisposition::MissingParent &&
-                !h.missing_parent)
-                return End(j, DownloadResult::OperationalFailure,
-                           "missing parent ID");
-            DownloadEvent failure;
-            if (!SetDeferred(j, Phase::DeferredBody, now, failure))
-                return failure;
-            j.body.assign(payload.begin(), payload.end());
-            j.reconstruction.reset();
-            auto e = Event(h.disposition == HeaderDisposition::MissingParent
-                               ? DownloadResult::NeedHeaders
-                               : DownloadResult::Deferred,
-                           j.key.first, j.key.second, h.diagnostic);
-            e.missing_parent = h.missing_parent;
-            return e;
-        }
-        if (h.disposition != HeaderDisposition::Eligible)
-            return HeaderFailure(j, h);
-        return Admit(j, payload, now);
-    }
-    DownloadEvent Missing(Job &j, std::span<const uint8_t> payload,
-                          uint64_t now) {
-        if (j.phase != Phase::Missing || !j.reconstruction)
-            return Event(DownloadResult::Ignored, j.key.first, j.key.second,
-                         "late or unsolicited blocktxn");
-        std::string error;
-        ReconstructionStatus result;
-        {
-            MissingResponse response;
-            if (!DecodeMissingResponse(
-                    payload, config.network,
-                    uint32_t(j.reconstruction->Request().indices.size()),
-                    peers.at(j.key.first).limit, response, error))
-                return End(j, DownloadResult::PeerMessageInvalid, error);
-            result = j.reconstruction->Apply(response, error);
-        }
-        if (result == ReconstructionStatus::CompleteUnvalidated)
-            return Complete(j, now);
-        if (result == ReconstructionStatus::NeedFullBlock)
-            return Fallback(j, now, error);
-        if (result == ReconstructionStatus::InvalidPeerMessage)
-            return End(j, DownloadResult::PeerMessageInvalid, error);
-        return End(j, DownloadResult::OperationalFailure,
-                   "unexpected missing-response result");
-    }
-    DownloadEvent NotFound(PeerHandle peer, std::span<const uint8_t> payload) {
-        ControlReader r(payload);
-        uint64_t count;
-        if (!r.Compact(count) || count > r.Left() / 36 ||
-            count * 36 != r.Left())
-            return Event(DownloadResult::PeerMessageInvalid, peer, {},
-                         "notfound count/bytes");
-        // Stack-only parsing, retaining at most the already bounded peer jobs.
-        std::set<Hash> found;
-        for (uint64_t i = 0; i < count; ++i) {
-            uint64_t type;
-            Hash id;
-            if (!r.Int(4, type) || !r.HashValue(id))
-                return Event(DownloadResult::PeerMessageInvalid, peer, {},
-                             "notfound item");
-            auto it = jobs.find({peer, id});
-            if (it == jobs.end() || IsDeferred(*it->second)) continue;
-            if (type == 2 || (type == 4 && it->second->phase == Phase::Compact))
-                found.insert(id);
-        }
-        auto e = Event(
-            found.empty() ? DownloadResult::Ignored
-                          : DownloadResult::RetryElsewhere,
-            peer, {}, "notfound: absence/capacity reason not supplied on wire");
-        for (const auto &id : found) {
-            e.affected.push_back(id);
-            Erase({peer, id});
-        }
-        return e;
-    }
-};
-DownloadManager::DownloadManager(DownloadConfig c, DownloadCallbacks f)
