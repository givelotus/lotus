-    UniValue Node::ReadBlock(const UniValue &request) {
-        std::string phase = "invalid_request";
-        try {
-            Keys(request, {"id", "command", "block_id", "offset", "length"});
-            const auto id = HashOf(request["block_id"]);
-            const auto offset = Number(request["offset"], UINT32_MAX);
-            const auto length = Number(request["length"], 65536);
-            Require(length > 0, "readblock length must be1..65536");
-            phase = "inconclusive";
-            DevelopmentBodyChunk chunk;
-            std::string error;
-            const auto result = runtime->ReadConnectedBodyChunk(
-                id, manifest.block_read_limit, offset, length, chunk, error);
-            if (result != Result::Progress)
-                throw ProducerFailure(
-                    result == Result::InvalidConfiguration
-                        ? "invalid_request"
-                        : result == Result::MissingBody || result == Result::MissingHeader
-                              ? "missing_body"
-                              : RuntimeFailure(result),
-                    error.empty() ? "connected body unavailable" : error);
-            auto answer = Status();
-            // Status can fault while reading storage or Avalanche observations.
-            // Publish the slice only if its full authority stamp still matches.
-            if (!SameDevelopmentBodyAuthority(chunk.snapshot, runtime->Snapshot()))
-                throw ProducerFailure("inconclusive",
-                                      "connected body authority changed");
-            answer.pushKV("block_id", Hex(id));
-            answer.pushKV("offset", offset);
-            answer.pushKV("total_bytes", chunk.total_bytes);
-            answer.pushKV("data", Hex(chunk.bytes));
-            answer.pushKV("eof", offset + chunk.bytes.size() == chunk.total_bytes);
-            answer.pushKV("ok", true);
-            return answer;
-        } catch (const ProducerFailure &error) {
-            UniValue answer(UniValue::VOBJ);
-            answer.pushKV("ok", false);
-            answer.pushKV("result", error.result);
-            answer.pushKV("error", std::string(error.what()).substr(0, 1024));
-            return answer;
-        } catch (const std::bad_alloc &) {
-            UniValue answer(UniValue::VOBJ);
-            answer.pushKV("ok", false);
-            answer.pushKV("result", "capacity_refused");
-            return answer;
-        } catch (const std::length_error &) {
-            UniValue answer(UniValue::VOBJ);
-            answer.pushKV("ok", false);
-            answer.pushKV("result", "capacity_refused");
-            return answer;
-        } catch (const std::exception &error) {
-            UniValue answer(UniValue::VOBJ);
-            answer.pushKV("ok", false);
-            answer.pushKV("result", phase);
-            answer.pushKV("error", std::string(error.what()).substr(0, 1024));
-            return answer;
-        }
-    }
-    UniValue Node::WalletContext(const UniValue &request,
-                                 size_t request_bytes) {
-        std::string phase = "invalid";
-        const auto failed = [&](const std::string &result,
-                                const std::string &error) {
-            UniValue answer(UniValue::VOBJ);
