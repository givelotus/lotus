-                    switch (build_status) {
-                        case LocalBlockBuildResult::InvalidTransactions:
-                            return "invalid_transactions";
-                        case LocalBlockBuildResult::CapacityRefused:
-                            return "capacity_refused";
-                        case LocalBlockBuildResult::StaleParent:
