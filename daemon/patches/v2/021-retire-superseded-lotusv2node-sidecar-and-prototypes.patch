-    void Node::Flush() {
-        size_t budget = 65536;
-        while (!output.empty() && budget) {
-            auto &s = output.front();
-            const auto n = write(STDOUT_FILENO, s.data() + output_offset,
-                                 std::min(budget, s.size() - output_offset));
-            if (n < 0 &&
-                (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
-                return;
-            Require(n > 0, "local output pipe unavailable");
-            budget -= n;
-            output_bytes -= n;
-            output_offset += n;
-            if (output_offset == s.size()) {
-                output.pop_front();
-                output_offset = 0;
-            }
-        }
-    }
