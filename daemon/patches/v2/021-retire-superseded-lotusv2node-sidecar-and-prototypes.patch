-            answer.pushKV("result", "pending_validation");
-            answer.pushKV("found", true);
-            answer.pushKV("nonce", std::to_string(mined.preview.header.nonce));
-            answer.pushKV("coinbase_txid", Hex(ids.txid));
-            answer.pushKV("coinbase_index", uint64_t{0});
-            answer.pushKV(
-                "coinbase_value",
-                std::to_string(framed.transactions[0].outputs[0].value));
