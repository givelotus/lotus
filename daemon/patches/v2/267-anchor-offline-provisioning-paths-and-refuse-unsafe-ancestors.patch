-struct File { int fd{-1}; ~File(){if(fd>=0) close(fd);} };
+struct File {
+    int fd{-1};
+    File()=default;
+    explicit File(int value):fd(value){}
+    File(const File &)=delete;
+    File &operator=(const File &)=delete;
+    ~File(){if(fd>=0) close(fd);}
+};
+struct AnchoredPath { File parent; std::string name; };
+bool TrustedDirectory(int fd, bool final) {
+    struct stat st{};
+    if(fstat(fd,&st)!=0 || !S_ISDIR(st.st_mode)) return false;
+    const auto uid=geteuid();
+    if(final) return st.st_uid==uid && (st.st_mode&0022)==0;
+    if(st.st_uid!=0 && st.st_uid!=uid) return false;
+    return (st.st_mode&0022)==0 || (st.st_uid==0 && (st.st_mode&S_ISVTX));
+}
+// Reject every symlink component and directory writable by another uid. Root
+// owned sticky ancestors are permitted, but the final parent must be owned by
+// this uid and cannot be writable by group/other. Hold the parent fd across all
+// private-file operations, including cleanup; never re-resolve their pathname.
+bool Anchor(const std::filesystem::path &path, AnchoredPath &out) {
+    const auto absolute=std::filesystem::absolute(path);
+    const auto name=absolute.filename().string();
+    if(name.empty() || name=="." || name=="..") return false;
+    File current(open("/",O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC));
+    if(current.fd<0 || !TrustedDirectory(current.fd,false)) return false;
+    for(const auto &part:absolute.parent_path()) {
+        const auto component=part.string();
+        if(component.empty() || component=="/" || component==".") continue;
+        if(component=="..") return false;
+        const int next=openat(current.fd,component.c_str(),O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        if(next<0) return false;
+        close(current.fd); current.fd=next;
+        if(!TrustedDirectory(current.fd,false)) return false;
+    }
+    if(!TrustedDirectory(current.fd,true)) return false;
+    out.parent.fd=current.fd; current.fd=-1; out.name=name; return true;
+}
+bool SameEntry(const AnchoredPath &path, const struct stat &opened) {
+    struct stat named{};
+    return fstatat(path.parent.fd,path.name.c_str(),&named,AT_SYMLINK_NOFOLLOW)==0 &&
+        named.st_dev==opened.st_dev && named.st_ino==opened.st_ino;
+}
+void RemoveCreated(const AnchoredPath &path, const struct stat &created) {
+    // The uid-owned non-writable parent excludes other-uid replacement races;
+    // the inode comparison also avoids removing an already replaced entry.
+    if(SameEntry(path,created)) (void)unlinkat(path.parent.fd,path.name.c_str(),0);
+}
 bool ReadPrivate(const std::filesystem::path &path, std::string &data) {
-    File f{open(path.c_str(),O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC)}; struct stat st{};
