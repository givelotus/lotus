+    File f(openat(anchored.parent.fd,anchored.name.c_str(),O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC)); struct stat st{};
     if(f.fd<0 || fstat(f.fd,&st)!=0 || !S_ISREG(st.st_mode) || st.st_uid!=geteuid() ||
-       (st.st_mode&0777)!=0600 || st.st_nlink!=1 || st.st_size<0 || st.st_size>1048576) return false;
+       (st.st_mode&0777)!=0600 || st.st_nlink!=1 || st.st_size<0 || st.st_size>1048576 || !SameEntry(anchored,st)) return false;
     data.resize(size_t(st.st_size)); size_t offset=0;
     while(offset<data.size()) { auto n=read(f.fd,data.data()+offset,data.size()-offset); if(n<=0)return false; offset+=size_t(n); }
-    char extra; return read(f.fd,&extra,1)==0;
+    char extra; return read(f.fd,&extra,1)==0 && SameEntry(anchored,st);
 }
 bool WritePrivate(const std::filesystem::path &path, const std::string &data) {
-    File f{open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600)};
+    AnchoredPath anchored; if(!Anchor(path,anchored)) return false;
+    File f(openat(anchored.parent.fd,anchored.name.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600));
     if(f.fd<0) return false;
-    if(fchmod(f.fd,0600)!=0) {unlink(path.c_str());return false;}
+    struct stat created{};
+    if(fstat(f.fd,&created)!=0) return false;
+    if(!S_ISREG(created.st_mode) || created.st_uid!=geteuid() || created.st_nlink!=1 || fchmod(f.fd,0600)!=0) {
+        RemoveCreated(anchored,created); return false;
+    }
     size_t offset=0;
-    while(offset<data.size()) { auto n=write(f.fd,data.data()+offset,data.size()-offset); if(n<=0){unlink(path.c_str());return false;} offset+=size_t(n); }
-    if(fsync(f.fd)!=0) {unlink(path.c_str());return false;} return true;
+    while(offset<data.size()) { auto n=write(f.fd,data.data()+offset,data.size()-offset); if(n<=0){RemoveCreated(anchored,created);return false;} offset+=size_t(n); }
+    if(fsync(f.fd)!=0 || !SameEntry(anchored,created)) {RemoveCreated(anchored,created);return false;} return true;
 }
 }
