From 307570da46f9bae7c4425085eb6ed6ddaf591b5a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 19:30:36 -0700
Subject: [PATCH] test(v2): preserve Chronik review targets with shared runtime
 objects

The runtime review project now exposes a shared production object library. Its test executable SOURCES list contains only the test main, so the previous Chronik source-list introspection would omit every runtime implementation.

Link both Chronik sync and explorer review targets directly to the shared object library, preserving transitive native dependencies without duplicating runtime compilation. Audit the remaining CMake SOURCES consumers; none depend on the changed runtime executable. Both focused Chronik targets build and pass.
---
 src/lotus_v2/chronik_sync_test/CMakeLists.txt | 16 ++++------------
 1 file changed, 4 insertions(+), 12 deletions(-)

diff --git a/src/lotus_v2/chronik_sync_test/CMakeLists.txt b/src/lotus_v2/chronik_sync_test/CMakeLists.txt
index 10359dfb36..43519a5b76 100644
--- a/src/lotus_v2/chronik_sync_test/CMakeLists.txt
+++ b/src/lotus_v2/chronik_sync_test/CMakeLists.txt
@@ -3,25 +3,17 @@ project(lotus_v2_chronik_sync LANGUAGES C CXX)
 add_subdirectory(../development_runtime_test runtime)
 find_package(OpenSSL REQUIRED COMPONENTS Crypto)
 
-get_target_property(runtime_sources development_runtime_test SOURCES)
-set(sync_sources)
-foreach(source IN LISTS runtime_sources)
-    if(NOT source MATCHES "test_development_runtime.cpp$")
-        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../development_runtime_test")
-        list(APPEND sync_sources "${absolute}")
-    endif()
-endforeach()
-add_executable(chronik_sync_test ../chronik_sync.cpp ../chronik_explorer.cpp ../test_chronik_sync.cpp ${sync_sources})
+add_executable(chronik_sync_test ../chronik_sync.cpp ../chronik_explorer.cpp ../test_chronik_sync.cpp)
 target_compile_features(chronik_sync_test PRIVATE cxx_std_20)
 target_include_directories(chronik_sync_test PRIVATE ../.. ../../secp256k1/include "${LOTUS_BOOST_INCLUDE}" ../vendor/blake3)
-target_link_libraries(chronik_sync_test PRIVATE lotus_v2_disk_state blake3 OpenSSL::Crypto "${LOTUS_SECP_LIBRARY}")
+target_link_libraries(chronik_sync_test PRIVATE development_runtime_review_objects)
 target_compile_options(chronik_sync_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
 enable_testing()
 add_test(NAME chronik_sync_test COMMAND chronik_sync_test)
 
-add_executable(chronik_explorer_test ../chronik_sync.cpp ../chronik_explorer.cpp ../test_chronik_explorer.cpp ${sync_sources})
+add_executable(chronik_explorer_test ../chronik_sync.cpp ../chronik_explorer.cpp ../test_chronik_explorer.cpp)
 target_compile_features(chronik_explorer_test PRIVATE cxx_std_20)
 target_include_directories(chronik_explorer_test PRIVATE ../.. ../../secp256k1/include "${LOTUS_BOOST_INCLUDE}" ../vendor/blake3)
-target_link_libraries(chronik_explorer_test PRIVATE lotus_v2_disk_state blake3 OpenSSL::Crypto "${LOTUS_SECP_LIBRARY}")
+target_link_libraries(chronik_explorer_test PRIVATE development_runtime_review_objects)
 target_compile_options(chronik_explorer_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
 add_test(NAME chronik_explorer_test COMMAND chronik_explorer_test)
