     // BEGIN INVENTORY REFRESH POLICY
     bool RefreshInventory(size_t cursor, size_t count, uint64_t now,
-                          uint64_t deadline) {
-        // Zero explicitly invalidates an epoch. Periodic refresh waits for
-        // every page, including when a traversal spans several seconds.
-        return deadline == 0 || (cursor >= count && now >= deadline);
+                          uint64_t deadline, bool requested = false) {
+        // Zero fences stale cached identities immediately. Soft requests from
+        // submissions/new peers wait for every page, then revisit the prefix
+        // and include newly accepted entries without starving the current tail.
+        return deadline == 0 || (cursor >= count && (requested || now >= deadline));
     }
