diff --git a/src/lotus_v2/development_pool_command_test/test_inventory_fairness.py b/src/lotus_v2/development_pool_command_test/test_inventory_fairness.py
new file mode 100644
index 0000000000..48fb8b4881
--- /dev/null
+++ b/src/lotus_v2/development_pool_command_test/test_inventory_fairness.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Compile actual node refresh helper/callsites against bounded scheduling adapters.
+
+No sockets, pool admission, transaction validation or relay wire claims. Extracted
+code owns refresh decisions, cached snapshot replacement and four-item cursor
+advancement; adapters supply pool identities, soft events and output readiness.
+Run directly; no CMake/project build is needed. --source selects a saved baseline.
+"""
+from pathlib import Path
+import argparse
+import os
+import subprocess
+import tempfile
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--source', type=Path)
+args = parser.parse_args()
+source = (args.source or Path(__file__).resolve().parent.parent /
+          'development_node_command.cpp').read_text()
+helper = source.split('// BEGIN INVENTORY REFRESH POLICY\n', 1)[1].split(
+    '// END INVENTORY REFRESH POLICY', 1)[0]
+schedule = source.split('            if (changed) inventory_refresh = 0;\n', 1)[1].split(
+    '            CleanupBodies();', 1)[0]
+schedule = 'if (changed) inventory_refresh = 0;\n' + schedule
+submit = source.split('if (result.status == PoolStatus::Accepted)', 1)[1].split(
+    'return answer;', 1)[0]
+activate = source.split('relay_peers.insert(notice->connection);', 1)[1].split('}', 1)[0]
+preamble = r'''
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <map>
+#include <set>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <vector>
+using Hash = unsigned;
+enum class PoolStatus { Accepted, Stale };
+void Check(bool ok, const char *message) {
+    if (!ok) throw std::runtime_error(message);
+}
+struct Entry { struct { Hash txhash; } effects; };
+struct Snapshot { PoolStatus status; std::vector<Entry> entries; };
+struct Pool {
+    bool authoritative = true;
+    std::vector<Entry> entries;
+    ::Snapshot Snapshot(size_t count, uint64_t) {
+        Check(count <= 1000, "snapshot identity cap changed");
+        auto result = ::Snapshot{authoritative ? PoolStatus::Accepted : PoolStatus::Stale, {}};
+        if (authoritative && count)
+            result.entries.assign(entries.begin(), entries.begin() + std::min(count, entries.size()));
+        return result;
+    }
+};
+struct Relay {
+    std::span<const Hash> AnnounceMany(std::span<const Hash> page, uint64_t) {
+        Check(page.size() <= 4, "inventory page exceeds four-item budget");
+        return page;
+    }
+};
+struct Output { bool ready = true; bool Empty() const { return ready; } };
+'''
+fixture = r'''
+struct Fixture {
+    Pool storage;
+    Pool *pool = &storage;
+    Relay engine;
+    Relay *relay = &engine;
+    Output relay_output;
+    size_t inventory_cursor = 0;
+    uint64_t inventory_refresh = 0, now_ms = 0;
+    bool inventory_refresh_requested = false;
+    std::vector<Hash> relay_inventory;
+    std::map<unsigned, std::set<Hash>> delivered{{1, {}}};
+    Fixture() { for (unsigned h = 1; h <= 1000; ++h) storage.entries.push_back({{h}}); }
+    uint64_t Monotonic() const { return now_ms; }
+    void RelayActions(std::span<const Hash> ids, uint64_t) {
+        for (auto &[peer, seen] : delivered) {
+            (void)peer;
+            seen.insert(ids.begin(), ids.end());
+        }
+    }
+    void Submit() {
+'''
+fixture += submit + '\n}\nvoid Activate(unsigned peer) { delivered.emplace(peer, std::set<Hash>{});\n' + activate
+fixture += '\n}\nvoid Step(bool changed = false) { now_ms += 10; const auto now = now_ms;\n'
+fixture += schedule + '\n}\n};\n'
+tests = r'''
+int main() {
+    try {
+        Fixture submit;
+        for (unsigned turn = 0; turn < 600; ++turn) {
+            submit.Submit();
+            submit.Step();
+        }
+        Check(submit.delivered.at(1).contains(1000),
+              "steady accepted submissions starve the cached inventory tail");
+
+        Fixture peers;
+        peers.Step(); // peer 2 arrives after the cached prefix was advertised
+        for (unsigned turn = 0; turn < 600; ++turn) {
+            // Model repeated successful peer activations without an unbounded
+            // live-peer set: replacement peers request refresh every turn.
+            peers.Activate(2);
+            peers.Step();
+        }
+        Check(peers.delivered.at(1).contains(1000),
+              "steady peer activations starve the cached inventory tail");
+        Check(peers.delivered.at(2).contains(1) && peers.delivered.at(2).contains(1000),
+              "new peer never revisits prefix and completes its inventory");
+
+        Fixture changed_pool;
+        changed_pool.Step(); // freeze the first bounded snapshot
+        // An entry accepted after snapshot creation must appear in the next
+        // snapshot even if soft refresh requests continue forever.
+        changed_pool.storage.entries.back().effects.txhash = 1001;
+        for (unsigned turn = 0; turn < 600; ++turn) {
+            changed_pool.Submit();
+            changed_pool.Step();
+        }
+        Check(changed_pool.delivered.at(1).contains(1000) &&
+                  changed_pool.delivered.at(1).contains(1001),
+              "soft requests prevent completion or refreshed snapshot inclusion");
+
+        Fixture busy;
+        busy.Step();
+        const auto cursor = busy.inventory_cursor;
+        busy.relay_output.ready = false;
+        for (unsigned turn = 0; turn < 300; ++turn) {
+            busy.Submit(); busy.Step();
+        }
+        Check(busy.inventory_cursor == cursor, "backpressure resets or advances cursor");
+        busy.relay_output.ready = true;
+        for (unsigned turn = 0; turn < 600; ++turn) { busy.Submit(); busy.Step(); }
+        Check(busy.delivered.at(1).contains(1000), "finite output backpressure loses tail");
+
+        Fixture fenced;
+        fenced.Step();
+        fenced.storage.entries = {{{2001}}, {{2002}}, {{2003}}};
+        fenced.Step(true);
+        Check(fenced.relay_inventory == std::vector<Hash>({2001, 2002, 2003}),
+              "hard tip invalidation must replace stale cached identities immediately");
+        fenced.storage.authoritative = false;
+        fenced.Step();
+        Check(fenced.relay_inventory.empty(), "authority fence keeps cached identities");
+        fenced.storage.authoritative = true;
+        fenced.storage.entries = {{{3001}}};
+        fenced.Step();
+        Check(fenced.delivered.at(1).contains(3001), "authority restoration fails fresh snapshot");
+        std::cout << "PASS actual inventory scheduler: submissions, peer churn, prefix revisit, "
+                     "snapshot inclusion, backpressure and hard fences\n";
+    } catch (const std::exception &error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
+'''
+with tempfile.TemporaryDirectory(prefix='lotus-node-inventory-fairness-') as directory:
+    path = Path(directory)
+    (path / 'test.cpp').write_text(preamble + helper + fixture + tests)
+    subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++20', '-Wall', '-Wextra',
+                    '-Wpedantic', '-Werror', str(path / 'test.cpp'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
