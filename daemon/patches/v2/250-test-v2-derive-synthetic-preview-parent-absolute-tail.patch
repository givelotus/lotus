From 01f5e0c009cc74d378cef53738fd0a01d8530eff Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:46:50 -0700
Subject: [PATCH] test(v2): derive synthetic preview parent absolute tail

The synthetic parent has work 2 while DevelopmentGenesis anchors work 9. Derive its authenticated monetary tail from the absolute formula before committing the state root.

Before: LLVM 23 native preview fails at ready signed preview with monetary tail context. After: AppleClang 21 Debug preview, complete and checksig suites pass.
---
 src/lotus_v2/test_block_preview.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/test_block_preview.cpp b/src/lotus_v2/test_block_preview.cpp
index cbdc0529e8f10b325d68b273e0f3444b23ed0810..f1bfe0f093d2eab3a86863210545571cb3690ce8 100644
--- a/src/lotus_v2/test_block_preview.cpp
+++ b/src/lotus_v2/test_block_preview.cpp
@@ -102,7 +102,9 @@ struct Fixture {
         funding.output.branches = {BranchLeaf(Checksig())}; funding.creation_parent_mtp = 1000;
         initial.emplace(funding.outpoint, funding); IncrementalUtxoSet tree;
         Check(tree.Insert(funding), "funding tree"); parent_root = tree.Root();
-        parent.monetary.bootstrap_reserve = 9; parent.monetary.tail_subsidy = 200;
+        parent.monetary.bootstrap_reserve = 9;
+        // The synthetic parent has work 2; the development genesis anchor is 9.
+        parent.monetary.tail_subsidy = AbsoluteTail(DevelopmentGenesis, 2);
         parent.monetary.prev_work[0] = 2; parent.monetary.ema_block_cost = 4;
         Header genesis; genesis.version = hp.version; genesis.bits = hp.genesis_bits;
         genesis.time = hp.genesis_time; genesis.size = HEADER_SIZE; Mine({}, hp.pow_limit, genesis);
