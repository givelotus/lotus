From 0473291662622fb32db963c49bba4bae725802d5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 14:53:00 -0700
Subject: [PATCH] rpc(v2): advertise the explicit native receiving provider

Extend version1 discovery with optional wallet.native_receiving and the actual native address prefix/codec. Capability reflects the compiled wallet provider; it does not claim ordinary native funding or native message signing. Keep default legacy address policy metadata unchanged and expose native receiving separately for the shared ChainAdaptor.

Depends on explicit native receiving plus the shared discovery feature and native mining adapter. Native lifecycle and descriptor tests assert the backend contract; matched PWA parser agreement recorded with the pool lane. Normal endpoint build and runtime checks pending.

diff --git a/doc/native-wallet-receiving.md b/doc/native-wallet-receiving.md
index 0ab3bd491cb442ed6121a2a7cb01deb1f9d315e9..c47dabca2094bbd98c3879c423c25b2470ab5256 100644
--- a/doc/native-wallet-receiving.md
+++ b/doc/native-wallet-receiving.md
@@ -27,4 +27,7 @@ unchanged.
 
 The optional discovery field `wallet.native_receiving` advertises this
 provider only in a binary that includes the receiving feature. It does not
-advertise ordinary native funding or native message-signing support.
+advertise ordinary native funding or native message-signing support. Discovery
+also includes `address.nativehrp` and `xpiaddr` in `address.acceptedformats`;
+clients use that declared prefix, not a ticker or network-name heuristic. The
+existing default address format and its legacy prefix remain unchanged.
diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 276802a7cfb49b68809eeeb3f3e1c67f76ea1ee1..f6453e692e278144ac629b90635934ccba8de17c 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -3,6 +3,10 @@
 // Distributed under the MIT software license, see the accompanying
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
+#if defined(HAVE_CONFIG_H)
+#include <config/bitcoin-config.h>
+#endif
+
 #include <avalanche/avalanche.h>
 #include <avalanche/processor.h>
 #include <blockvalidity.h>
@@ -686,6 +690,9 @@ static RPCHelpMan getchainconfig() {
             UniValue formats(UniValue::VARR);
             formats.push_back("cashaddr");
             formats.push_back("base58check");
+            formats.push_back("xpiaddr");
+            address.pushKV("nativehrp", std::string(lotus::v2::AddressPrefix(
+                                            NativeAddressNetwork(params))));
             address.pushKV("acceptedformats", std::move(formats));
             UniValue prefixes(UniValue::VOBJ);
             prefixes.pushKV("pubkeyhash", HexStr(params.Base58Prefix(
@@ -726,6 +733,18 @@ static RPCHelpMan getchainconfig() {
             result.pushKV("address", std::move(address));
             result.pushKV("mining", std::move(mining));
             result.pushKV("features", std::move(features));
+            UniValue receiving(UniValue::VOBJ);
+#ifdef ENABLE_WALLET
+            receiving.pushKV("available", true);
+#else
+            receiving.pushKV("available", false);
+#endif
+            receiving.pushKV("address_type", "native");
+            receiving.pushKV("format", "xpiaddr");
+            receiving.pushKV("template", "keyhash");
+            UniValue wallet(UniValue::VOBJ);
+            wallet.pushKV("native_receiving", std::move(receiving));
+            result.pushKV("wallet", std::move(wallet));
             result.pushKV("node", std::move(node));
             return result;
         },
diff --git a/test/functional/mining_pow_descriptor.py b/test/functional/mining_pow_descriptor.py
index 202e1d869f437bba21d6dc0cd7556a265d9695fc..eff6c78c27b66f02de265a5c0e5442bff30d5daa 100644
--- a/test/functional/mining_pow_descriptor.py
+++ b/test/functional/mining_pow_descriptor.py
@@ -100,7 +100,11 @@ class MiningProofOfWorkTest(BitcoinTestFramework):
         address = config["address"]
         assert_equal(address["format"], "cashaddr")
         assert_equal(address["types"], [0, 1])
-        assert_equal(address["acceptedformats"], ["cashaddr", "base58check"])
+        expected_formats = ["cashaddr", "base58check"]
+        if self.expected_kind() == "lotus-v2":
+            expected_formats.append("xpiaddr")
+            assert_equal(address["nativehrp"], "rxpi")
+        assert_equal(address["acceptedformats"], expected_formats)
         destination = node.validateaddress(node.get_deterministic_priv_key().address)
         assert_equal(destination["isvalid"], True)
         assert destination["address"].startswith(address["hrp"] + ":")
diff --git a/test/functional/wallet_v2_native_receive.py b/test/functional/wallet_v2_native_receive.py
index 7ea67b382f600c150b3bf116a8237587ef9c2906..99f81f3e750f299c4321cb305d2e3224dcba9014 100644
--- a/test/functional/wallet_v2_native_receive.py
+++ b/test/functional/wallet_v2_native_receive.py
@@ -38,6 +38,18 @@ class NativeReceiveTest(BitcoinTestFramework):
         node = self.nodes[0]
         wallet = node.get_wallet_rpc(self.default_wallet_name)
         address = wallet.getnewaddress("native receive", "native")
+        discovery = node.getchainconfig()
+        assert_equal(
+            discovery["wallet"]["native_receiving"],
+            {
+                "available": True,
+                "address_type": "native",
+                "format": "xpiaddr",
+                "template": "keyhash",
+            },
+        )
+        assert_equal(discovery["address"]["nativehrp"], "rxpi")
+        assert "xpiaddr" in discovery["address"]["acceptedformats"]
         info = wallet.getaddressinfo(address)
         assert_equal(info["native"], True)
         assert_equal(info["type"], 1)
