From f93ea73fdf8ed3890b5ce85570326a9f10cdad5f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:02:27 -0700
Subject: [PATCH] Register bounded candidate body pool and checks in the full
 build

Expose the volatile authenticated-byte pool through the existing validation dependencies and a separate test target. Root strict standalone Debug pool checks pass; independent source review found no blocker. Retention is distinct from contextual acceptance and activates no network.
---
 src/lotus_v2/CMakeLists.txt | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index f02e87445..5544f129d 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -236,3 +236,12 @@ target_link_libraries(test_lotus_v2_candidate_selection PRIVATE lotus_v2_candida
 add_custom_target(check-lotus-v2-candidate-selection
     COMMAND $<TARGET_FILE:test_lotus_v2_candidate_selection>
     DEPENDS test_lotus_v2_candidate_selection)
+
+# Volatile authenticated candidate bytes; retention is not block acceptance.
+add_library(lotus_v2_candidate_body_pool STATIC candidate_body_pool.cpp)
+target_link_libraries(lotus_v2_candidate_body_pool PUBLIC lotus_v2_validation)
+add_executable(test_lotus_v2_candidate_body_pool test_candidate_body_pool.cpp)
+target_link_libraries(test_lotus_v2_candidate_body_pool PRIVATE lotus_v2_candidate_body_pool)
+add_custom_target(check-lotus-v2-candidate-body-pool
+    COMMAND $<TARGET_FILE:test_lotus_v2_candidate_body_pool>
+    DEPENDS test_lotus_v2_candidate_body_pool)
