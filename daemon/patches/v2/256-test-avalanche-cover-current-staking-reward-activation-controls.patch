From f4ff503868af329ab680016478ac9e6466c7ee9c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:45:13 -0700
Subject: [PATCH] test(avalanche): cover current staking reward activation
 controls

---
 src/avalanche/test/stakingrewards_tests.cpp | 30 ++++++++++++---------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/src/avalanche/test/stakingrewards_tests.cpp b/src/avalanche/test/stakingrewards_tests.cpp
index ca4a05f804fa9e8a918895b756fbd52070ef0308..8a85400c5cedbbf066180d7ce6777826ec2352b1 100644
--- a/src/avalanche/test/stakingrewards_tests.cpp
+++ b/src/avalanche/test/stakingrewards_tests.cpp
@@ -6,7 +6,7 @@
 #include <avalanche/processor.h>
 #include <avalanche/stakecontender.h>
 #include <chainparams.h>
-#include <consensus/activation.h>
+#include <common/args.h>
 #include <net_processing.h>
 #include <policy/block/stakingrewards.h>
 #include <util/chaintype.h>
@@ -17,6 +17,8 @@
 
 #include <boost/test/unit_test.hpp>
 
+#include <limits>
+
 using namespace avalanche;
 
 struct StakingRewardsActivationTestingSetup : public TestingSetup {
@@ -25,20 +27,22 @@ struct StakingRewardsActivationTestingSetup : public TestingSetup {
         SelectParams(chain_type);
         const Consensus::Params &params = Params().GetConsensus();
 
-        // Before Cowperthwaite activation
-        const auto activationHeight = params.cowperthwaiteHeight;
+        BOOST_CHECK(!IsStakingRewardsActivated(params, nullptr));
 
+        // Staking rewards are controlled by the network default and explicit
+        // runtime override; there is no longer a height activation boundary.
         CBlockIndex block;
-        block.nHeight = activationHeight - 1;
-        BOOST_CHECK(!IsStakingRewardsActivated(params, &block));
-
-        block.nHeight = activationHeight;
-        BOOST_CHECK_EQUAL(IsStakingRewardsActivated(params, &block),
-                          expectActivation);
-
-        block.nHeight = activationHeight + 1;
-        BOOST_CHECK_EQUAL(IsStakingRewardsActivated(params, &block),
-                          expectActivation);
+        for (const int height : {0, 1, std::numeric_limits<int>::max()}) {
+            block.nHeight = height;
+            BOOST_CHECK_EQUAL(IsStakingRewardsActivated(params, &block),
+                              expectActivation);
+        }
+        for (const bool enabled : {false, true}) {
+            gArgs.ForceSetArg("-avalanchestakingrewards", enabled ? "1" : "0");
+            BOOST_CHECK(!IsStakingRewardsActivated(params, nullptr));
+            BOOST_CHECK_EQUAL(IsStakingRewardsActivated(params, &block), enabled);
+        }
+        gArgs.ClearForcedArg("-avalanchestakingrewards");
     }
 };
 
