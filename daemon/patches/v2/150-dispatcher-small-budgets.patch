From 64666707d3cdb543b8790e1f72a38fc654733a38 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:51:30 -0700
Subject: [PATCH] Cover dispatcher serving with one-query tick budgets

---
 src/lotus_v2/peer_dispatcher_test/README.md | 20 ++++++
 src/lotus_v2/test_peer_dispatcher.cpp       | 71 ++++++++++++++++++++-
 2 files changed, 89 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/peer_dispatcher_test/README.md b/src/lotus_v2/peer_dispatcher_test/README.md
index 7fd9f073e79ef71efaf46991eb511fc18e7aabf9..e4f843f4d757cc0ab0f3ca18a0c9a7d27a6cce58 100644
--- a/src/lotus_v2/peer_dispatcher_test/README.md
+++ b/src/lotus_v2/peer_dispatcher_test/README.md
@@ -96,3 +96,23 @@ All nine printed integration groups passed. Debug CTest passed 1/1 in 2.86s;
 ASan/UBSan CTest passed 1/1 in 7.66s. Logs:
 `/private/tmp/lotus-v2-peer-dispatcher-debug-ctest.log` and
 `/private/tmp/lotus-v2-peer-dispatcher-sanitize-ctest.log`.
+
+### Small serving-query followup
+
+A tenth integration group constrains only the serving peer's per-Tick runtime
+query allowance. All five selected full blocks complete with allowance **1**.
+A cold compact request completes with allowance **2**; immediately after the
+client reports missing transactions, the server allowance becomes **1** before
+it handles `getblocktxn`. The reconstructed complete block reaches the exact
+reference checkpoint, both sessions remain active, and download/serving leases
+are released. Every server Tick asserts its usage stays within that allowance.
+
+The earlier atomic multi-query implementation failed the full-block case;
+`/private/tmp/lotus-v2-peer-dispatcher-before-query.log` and its printed temporary
+homes preserve that observation. With staged serving and the exact-fit headers
+refinement, all ten groups pass. Final dispatcher source SHA256:
+`f8b66a5d147c2ef850543fd7290067dbe69719d17272eabd298ab7e2cc433fb7`
+(header unchanged). Final Debug CTest passed 1/1 in 3.51s; ASan/UBSan passed 1/1
+in 8.74s. Logs:
+`/private/tmp/lotus-v2-peer-dispatcher-query-final-debug-ctest.log` and
+`/private/tmp/lotus-v2-peer-dispatcher-query-final-sanitize-ctest.log`.
diff --git a/src/lotus_v2/test_peer_dispatcher.cpp b/src/lotus_v2/test_peer_dispatcher.cpp
index 8472b3a5a74296bc4a086edf37463253cb911fbe..08b16cd0399f224e3815b95db4ce33345183018a 100644
--- a/src/lotus_v2/test_peer_dispatcher.cpp
+++ b/src/lotus_v2/test_peer_dispatcher.cpp
@@ -306,6 +306,7 @@ struct Node {
     ConnectionId connection;
     std::vector<DispatcherNotice> notices;
     uint64_t nonce = 100, admissions = 0;
+    DispatcherBudget budget{DispatcherStep()};
     explicit Node(ByteStream &stream, uint64_t identity,
                   uint32_t reconstruction_limit = 64,
                   leveldb::Env *env = nullptr)
@@ -414,8 +415,8 @@ struct Node {
             }};
     }
     DispatcherUsage Poll(uint64_t ms) {
-        auto u = dispatcher->Tick(ms, UINT64_MAX, 0, DispatcherStep());
-        const auto b = DispatcherStep();
+        auto u = dispatcher->Tick(ms, UINT64_MAX, 0, budget);
+        const auto b = budget;
         Check(u.actions <= b.max_actions &&
                   u.transport_actions <= b.transport.max_actions &&
                   u.read_bytes + u.written_bytes <= b.transport.max_io_bytes &&
@@ -981,9 +982,75 @@ void TcpActualSync() {
     std::cout << "PASS actual ephemeral TCP fullblock sync between two real V4 "
                  "runtimes\n";
 }
+
+void SmallServingQueryBudgets() {
+    {
+        Pair p;
+        p.b.budget.max_runtime_queries = 1;
+        Sync(p, DownloadMode::Full);
+        Check(p.b.serving.grants >= 5,
+              "one-query full serving produces every selected response");
+    }
+    {
+        Pair p;
+        Seed(*p.a.runtime, {0, 1});
+        Seed(*p.b.runtime, {0, 1, 4});
+        p.b.budget.max_runtime_queries = 2;
+        p.Headers();
+        bool known = false;
+        for (unsigned n = 0; n < 1000 && !known; ++n) {
+            p.Cycle();
+            std::optional<IndexedHeader> h;
+            std::string error;
+            Check(p.a.runtime->ReadHeader(H(V(4).id), h, error) ==
+                      DevelopmentRuntimeResult::Progress,
+                  "small-query compact indexed header lookup");
+            known = bool(h);
+        }
+        Check(known && p.b.serving.grants == 0,
+              "cold compact request has no previously served body cache");
+        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(4)),
+                                           DownloadMode::Compact,
+                                           p.ms) == DispatcherResult::Queued,
+              "cold compact starts under two-query serving budget");
+        bool missing = false, retained = false;
+        for (unsigned n = 0; n < 1000 && !p.a.Stable(4); ++n) {
+            p.a.Poll(p.ms);
+            for (const auto &notice : p.a.notices)
+                if (notice.download) {
+                    missing |= notice.download->result ==
+                               DownloadResult::NeedTransactions;
+                    retained |= notice.download->result ==
+                                DownloadResult::RetainedAuthenticated;
+                }
+            // This switch occurs after the client processes the compact reply
+            // and before the remote handles its getblocktxn request.
+            if (missing) p.b.budget.max_runtime_queries = 1;
+            p.b.Poll(p.ms++);
+            const auto t = p.a.runtime->Tick(UINT64_MAX, 0, TickLimits());
+            Check(t.result != DevelopmentRuntimeResult::StorageError,
+                  "small-query compact actual chain admission");
+        }
+        Check(missing && retained && p.b.budget.max_runtime_queries == 1,
+              "cold compact budget2 and getblocktxn budget1 both eventually "
+              "respond");
+        Check(p.a.Stable(4),
+              "small serving query budgets reach exact accepted reference tip");
+        Match(*p.a.runtime, 4);
+        Check(p.a.manager->Stats().jobs == 0 && p.a.staging.live_bytes == 0 &&
+                  p.b.serving.live_bytes == 0,
+              "small-query serving releases separate download and serving "
+              "leases");
+        Check(p.a.Active() && p.b.Active(),
+              "small-query progress requires no reconnect");
+    }
+    std::cout << "PASS full/getblocktxn query budget1 and cold compact query "
+                 "budget2\n";
+}
 } // namespace
 int main() {
     try {
+        SmallServingQueryBudgets();
         BaselineActualSync();
         CompactMissingAndFallback();
         PendingBodiesSurviveTipAdvance();
