+class FaultEnv final : public leveldb::EnvWrapper {
+public:
+    bool fail_after_sync = false;
+    unsigned failures = 0;
+    std::function<void()> on_sync;
+    FaultEnv() : EnvWrapper(leveldb::Env::Default()) {}
+    class File final : public leveldb::WritableFile {
