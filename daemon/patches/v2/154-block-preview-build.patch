From 539f438109a74dba4502d038feaa8e3a6020e6a6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:59:48 -0700
Subject: [PATCH] build(v2): register abort-only block preview checks

Link the signed preview regression suite against the same validation library used by the daemon. Preview success does not bypass normal proof-of-work, failure-proof or state-commit gates.
---
 src/lotus_v2/CMakeLists.txt | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index bd2dfd74dab7a33f13ddd1fa1da251e54950d5d8..0c1fb5ec374813b3313472b07e866a0caaa81f8b 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -282,3 +282,10 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
         COMMAND $<TARGET_FILE:test_lotus_v2_peer_dispatcher>
         DEPENDS test_lotus_v2_peer_dispatcher)
 endif()
+
+# Preview always aborts; mined templates still require ordinary full validation.
+add_executable(test_lotus_v2_block_preview test_block_preview.cpp)
+target_link_libraries(test_lotus_v2_block_preview PRIVATE lotus_v2_validation)
+add_custom_target(check-lotus-v2-block-preview
+    COMMAND $<TARGET_FILE:test_lotus_v2_block_preview>
+    DEPENDS test_lotus_v2_block_preview)
-- 
