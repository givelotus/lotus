-// Seal one ordinary child header and store that exact 134-byte encoding.
+// Seal ordinary child headers and store those exact 134-byte encodings.
 // Nonce stays 0. This does not mine, search a nonce, or check proof of work
-// beyond SealChildHeader's pow_limit ceiling. lotusd has not accepted the
-// header. This is not ConnectTip.
+// beyond SealChildHeader's pow_limit ceiling. lotusd has not accepted a
+// header. Two stored headers are a header-file chain, not block acceptance.
+// This is not ConnectTip.
 #include "persistent_header.h"
 #include "persistent_monetary.h"
 #include "persistent_utxo.h"
@@ -125,10 +126,12 @@ struct World {
     }
 };
 
-std::filesystem::path TempDir() {
-    char templ[] = "/tmp/lotus-v2-seal-header-XXXXXX";
-    Check(::mkdtemp(templ) != nullptr, "mkdtemp");
-    const std::string path(templ);
+std::filesystem::path TempDir(const char *name = "lotus-v2-seal-header") {
+    std::string pattern = std::string("/tmp/") + name + "-XXXXXX";
+    std::vector<char> templ(pattern.begin(), pattern.end());
+    templ.push_back('\0');
+    Check(::mkdtemp(templ.data()) != nullptr, "mkdtemp");
+    const std::string path(templ.data());
     Check(path.rfind("/tmp/", 0) == 0, "temporary directory is under /tmp");
     Check(path.find("..") == std::string::npos, "temporary path has no parent segment");
     Check(path.find(".lotus") == std::string::npos &&
@@ -610,6 +613,469 @@ void FailedWitnessWritesNoHeader() {
     }
     std::filesystem::remove_all(directory);
 }
+
+struct SealedChild {
+    Header header;
+    std::array<uint8_t, HEADER_SIZE> bytes{};
+    Hash id{};
+    Hash tx_root{};
+};
+
+// Nonce stays 0. pow_limit is only SealChildHeader's DecodeTarget ceiling.
+SealedChild SealPayment(const OrdinaryParentContext &parent,
+                        const OrdinaryBlockConnected &connected,
+                        const Transaction &tx, const TxProfile &tx_profile,
+                        uint64_t time) {
+    std::string error;
+    IdentityDigests ids;
+    Check(ComputeIdentities(tx, tx_profile, parent.chain_id, ids, error),
+          "seal identity: " + error);
+    const TxRootInput tx_input = RootInput(tx, ids, parent.chain_id);
+    SealedChild sealed;
+    sealed.tx_root = ExpectTxRoot(parent.chain_id, tx_input);
+    const std::vector<TxRootInput> txs{tx_input};
+    Check(SealChildHeaderWithTxRoot(parent, connected, txs, 2, time, HEADER_SIZE,
+                                    0x1d00ffff, PowLimit(), sealed.header, error),
+          "seal child header: " + error);
+    Check(error.empty(), "seal left an error");
+    Check(sealed.header.nonce == 0, "nonce was searched");
+    Check(sealed.header.size == HEADER_SIZE, "header is not 134 bytes");
+    Check(sealed.header.height == parent.header.height + 1, "child height");
+    Check(sealed.header.state_root == connected.state_root, "sealed state root");
+    Check(sealed.header.tx_root == sealed.tx_root, "sealed tx root");
+    Check(sealed.header.version == 2 && sealed.header.time == time &&
+              sealed.header.bits == 0x1d00ffff,
+          "sealed header fields");
+    Hash parent_id{};
+    Check(BlockId(parent.chain_id, parent.header, parent_id) &&
+              sealed.header.prev_id == parent_id,
+          "prev_id is not the parent block id");
+    Check(SerializeHeader(sealed.header, sealed.bytes), "serialize sealed header");
+    Check(sealed.bytes.size() == 134, "serialization is not 134 bytes");
+    Check(std::all_of(sealed.bytes.begin() + 42, sealed.bytes.begin() + 50,
+                      [](uint8_t byte) { return byte == 0; }),
+          "encoded nonce is not 0");
+    Check(BlockId(parent.chain_id, sealed.header, sealed.id), "existing block id");
+    return sealed;
+}
+
+void ExpectLiveHeader(PersistentHeaderStore &store, const SealedChild &sealed,
+                      const ChainId &chain, const std::filesystem::path &header_dir,
+                      uint64_t undo_records, const std::string &where) {
+    Header live;
+    uint64_t height = 0;
+    ChainId live_chain{};
+    Hash live_id{};
+    Check(store.IsOpen(), where + " header store is closed");
+    Check(store.GetHeader(live) && SameHeader(live, sealed.header),
+          where + " header");
+    std::array<uint8_t, HEADER_SIZE> again{};
+    Check(SerializeHeader(live, again) && again == sealed.bytes, where + " bytes");
+    Check(live.nonce == 0 && live.size == HEADER_SIZE, where + " nonce or size");
+    Check(store.Height(height) && height == sealed.header.height, where + " height");
+    Check(store.Chain(live_chain) && live_chain == chain, where + " chain");
+    Check(store.HeaderId(live_id) && live_id == sealed.id, where + " BlockId");
+    Hash recomputed{};
+    Check(BlockId(live_chain, live, recomputed) && recomputed == live_id,
+          where + " BlockId is not the existing header id");
+    ExpectHeaderFile(header_dir / "header.dat", chain, height, again, live_id);
+    Check(DatFiles(header_dir) == 1 &&
+              DatFiles(header_dir / "undo") == undo_records,
+          where + " header record count");
+}
+
+void UndoStoredBlock(PersistentHeaderStore &header, PersistentMonetaryStore &money,
+                     PersistentUtxoStore &utxo, size_t utxo_commits, std::string &error,
+                     const std::string &where) {
+    Check(header.Undo(error), where + " header undo: " + error);
+    Check(money.Undo(error), where + " monetary undo: " + error);
+    for (size_t i = 0; i < utxo_commits; ++i)
+        Check(utxo.Undo(error), where + " utxo undo: " + error);
+}
+
+// Two stored headers. The second block is one spend of the coin the first
+// block created, so that spend is its own UTXO commit. A later transaction
+// that spends an earlier one in the same block is not folded into that
+// earlier Commit; this second block does not need more than one spend.
+// Nonce stays 0. lotusd has not accepted either header.
+void TwoSuccessiveSealedHeaders() {
+    World world;
+    const Hash parent_utxo = world.utxo.Root();
+    const std::array<uint8_t, 56> parent_money =
+        EncodeMonetaryState(world.monetary);
+    const Hash parent_state = world.parent.header.state_root;
+    const Transaction payment = Payment(world.funding.outpoint, 15000);
+    Check(payment.inputs.size() == 1 &&
+              payment.inputs[0].witnesses.size() == 1 &&
+              payment.inputs[0].witnesses[0].script == TRUE_SCRIPT &&
+              TRUE_SCRIPT.size() == 1 && TRUE_SCRIPT[0] == 0x4e,
+          "first block is not the OP_TRUE payment");
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(payment, profile, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure true payment: " + error);
+    Check(effects.invocation_cost == 18, "true payment invocation cost");
+    const Outpoint created =
+        OutputOf(payment, profile.transaction, world.parent.chain_id);
+
+    const std::filesystem::path directory = TempDir("lotus-v2-two-header");
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    const std::filesystem::path header_dir = directory / "header";
+    std::vector<uint8_t> parent_utxo_file;
+    std::vector<uint8_t> parent_money_file;
+    std::vector<uint8_t> first_utxo_file;
+    std::vector<uint8_t> first_money_file;
+    std::vector<uint8_t> first_header_file;
+    std::vector<uint8_t> second_utxo_file;
+    std::vector<uint8_t> second_money_file;
+    std::vector<uint8_t> second_header_file;
+    SealedChild first_sealed;
+    SealedChild second_sealed;
+    Hash first_utxo{};
+    Hash second_utxo{};
+    std::array<uint8_t, 56> first_money{};
+    std::array<uint8_t, 56> second_money{};
+    Hash first_state{};
+    Hash second_state{};
+    size_t first_utxo_commits = 0;
+    size_t second_utxo_commits = 0;
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "open utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "open monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "open header: " + error);
+        SeedUtxo(utxo_store, world);
+        SeedMonetary(monetary_store, world);
+        parent_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        parent_money_file = ReadRaw(money_dir / "monetary.dat");
+        const size_t seeded_utxo = DatFiles(utxo_dir / "undo");
+        const size_t seeded_money = DatFiles(money_dir / "monetary-undo");
+        Check(seeded_utxo == 1 && seeded_money == 1,
+              "parent seed is one commit in each store");
+        ExpectEmptyHeader(header_store, header_dir, "before first header");
+
+        OrdinaryBlockConnected first_connected;
+        Check(ConnectOrdinaryBlock({payment}, world.parent, profile, kMonetary,
+                                   world.view, world.utxo, world.monetary,
+                                   first_connected, error, &utxo_store,
+                                   &monetary_store),
+              "connect first payment: " + error);
+        Check(first_connected.invocation_cost == 18, "first block invocation cost");
+        first_utxo_commits = DatFiles(utxo_dir / "undo") - seeded_utxo;
+        Check(first_utxo_commits == 1, "the first payment was not its own utxo commit");
+        Check(DatFiles(money_dir / "monetary-undo") == seeded_money + 1,
+              "the first block was not one monetary snapshot");
+        Check(world.view.count(created) == 1 &&
+                  world.view.at(created).output.branches.size() == 1 &&
+                  world.view.at(created).output.branches[0] ==
+                      BranchLeaf(TRUE_SCRIPT) &&
+                  world.view.at(created).output.value == 15000,
+              "first block did not create the OP_TRUE coin");
+        first_sealed = SealPayment(world.parent, first_connected, payment,
+                                   profile.transaction, 50120);
+        Check(first_sealed.header.height == world.parent.header.height + 1,
+              "first header height is not parent+1");
+        Check(header_store.Commit(world.parent.chain_id, first_sealed.header.height,
+                                  first_sealed.header, error),
+              "commit first header: " + error);
+        ExpectLiveHeader(header_store, first_sealed, world.parent.chain_id,
+                         header_dir, 1, "live first header");
+        first_utxo = first_connected.utxo_root;
+        first_money = first_connected.monetary_bytes;
+        first_state = first_connected.state_root;
+        Check(StoreRoot(utxo_store) == first_utxo &&
+                  StoreMoney(monetary_store) == first_money &&
+                  StoreState(monetary_store) == first_state,
+              "live stores do not match the first connect");
+        first_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        first_money_file = ReadRaw(money_dir / "monetary.dat");
+        first_header_file = ReadRaw(header_dir / "header.dat");
+
+        OrdinaryParentContext second_parent = world.parent;
+        second_parent.header = first_sealed.header;
+        second_parent.monetary = world.monetary;
+        OrdinaryCandidateProfile second_profile = profile;
+        second_profile.candidate_height = first_sealed.header.height + 1;
+        second_profile.parent_mtp = first_sealed.header.time;
+        const Transaction spend = Payment(created, 10000);
+        Check(spend.inputs.size() == 1 && spend.inputs[0].witnesses.size() == 1 &&
+                  spend.inputs[0].witnesses[0].script == TRUE_SCRIPT &&
+                  spend.inputs[0].prev_txid == created.tx_id &&
+                  spend.inputs[0].prev_index == created.index,
+              "second block does not spend the coin the first block created");
+        OrdinaryCandidateEffects spend_effects;
+        Check(CheckOrdinaryCandidate(spend, second_profile, world.parent.chain_id,
+                                     world.view, spend_effects, error),
+              "measure second spend: " + error);
+        Check(spend_effects.invocation_cost == 18, "second spend invocation cost");
+        Check(spend_effects.consumed.size() == 1 &&
+                  spend_effects.consumed[0] == created,
+              "second spend effects do not name the created coin");
+        OrdinaryBlockConnected second_connected;
+        const size_t utxo_after_first = DatFiles(utxo_dir / "undo");
+        const size_t money_after_first = DatFiles(money_dir / "monetary-undo");
+        Check(ConnectOrdinaryBlock({spend}, second_parent, second_profile,
+                                   kMonetary, world.view, world.utxo,
+                                   world.monetary, second_connected, error,
+                                   &utxo_store, &monetary_store),
+              "connect second spend: " + error);
+        Check(second_connected.invocation_cost == 18,
+              "second block invocation cost");
+        // One spend is one Commit. It is not merged into the first block's
+        // commit. A later transaction spending an earlier one in the same
+        // block would be another Commit; this block is a single spend.
+        second_utxo_commits = DatFiles(utxo_dir / "undo") - utxo_after_first;
+        Check(second_utxo_commits == 1,
+              "second block UTXO updates were collapsed");
+        Check(DatFiles(money_dir / "monetary-undo") == money_after_first + 1,
+              "the second block was not one monetary snapshot");
+        Check(world.view.count(created) == 0,
+              "second block did not spend the created coin");
+        second_sealed = SealPayment(second_parent, second_connected, spend,
+                                    second_profile.transaction, 50240);
+        Check(second_sealed.header.prev_id == first_sealed.id,
+              "second header does not commit the first BlockId as prev_id");
+        Check(second_sealed.header.height == first_sealed.header.height + 1,
+              "second header height is not the next height");
+        Check(second_sealed.header.nonce == 0 && second_sealed.bytes.size() == 134,
+              "second header nonce or size");
+        Check(second_sealed.bytes != first_sealed.bytes &&
+                  second_sealed.id != first_sealed.id,
+              "second header collapsed to the first header");
+        Check(header_store.Commit(world.parent.chain_id,
+                                  second_sealed.header.height,
+                                  second_sealed.header, error),
+              "commit second header: " + error);
+        ExpectLiveHeader(header_store, second_sealed, world.parent.chain_id,
+                         header_dir, 2, "live second header");
+        second_utxo = second_connected.utxo_root;
+        second_money = second_connected.monetary_bytes;
+        second_state = second_connected.state_root;
+        Check(second_utxo != first_utxo && second_money != first_money &&
+                  second_state != first_state,
+              "second connect did not move the utxo root and monetary bytes");
+        Check(StoreRoot(utxo_store) == second_utxo &&
+                  StoreMoney(monetary_store) == second_money &&
+                  StoreState(monetary_store) == second_state,
+              "live stores do not match the second connect");
+        second_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        second_money_file = ReadRaw(money_dir / "monetary.dat");
+        second_header_file = ReadRaw(header_dir / "header.dat");
+        Check(second_header_file != first_header_file,
+              "second header commit did not replace the header file");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen second utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen second monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "reopen second header: " + error);
+        Check(ReadRaw(header_dir / "header.dat") == second_header_file &&
+                  ReadRaw(utxo_dir / "snapshot.dat") == second_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == second_money_file,
+              "reopen changed a second-block file");
+        ExpectLiveHeader(header_store, second_sealed, world.parent.chain_id,
+                         header_dir, 2, "reopened second header");
+        Check(StoreRoot(utxo_store) == second_utxo &&
+                  StoreMoney(monetary_store) == second_money &&
+                  StoreState(monetary_store) == second_state,
+              "reopened utxo root or monetary bytes do not match the second connect");
+        UndoStoredBlock(header_store, monetary_store, utxo_store,
+                        second_utxo_commits, error, "second block");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen first utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen first monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "reopen first header: " + error);
+        Check(ReadRaw(header_dir / "header.dat") == first_header_file &&
+                  ReadRaw(utxo_dir / "snapshot.dat") == first_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == first_money_file,
+              "undo of the second block did not restore the first files");
+        ExpectLiveHeader(header_store, first_sealed, world.parent.chain_id,
+                         header_dir, 1, "reopened first header");
+        Check(StoreRoot(utxo_store) == first_utxo &&
+                  StoreMoney(monetary_store) == first_money &&
+                  StoreState(monetary_store) == first_state,
+              "reopened utxo root or monetary bytes do not match the first block");
+        UndoStoredBlock(header_store, monetary_store, utxo_store,
+                        first_utxo_commits, error, "first block");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen parent utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen parent monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "reopen parent header: " + error);
+        ExpectEmptyHeader(header_store, header_dir, "reopened empty header");
+        ExpectParentStores(utxo_store, monetary_store, parent_utxo, parent_money,
+                           parent_state, "reopened parent seed");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "second undo did not restore the parent seed files");
+    }
+    std::filesystem::remove_all(directory);
+}
+
+// The second transaction's 0x00 witness fails after the first header is
+// already in the header file. That failure must not replace it.
+void FailingSecondWitnessKeepsFirstHeader() {
+    World world;
+    const Transaction payment = Payment(world.funding.outpoint, 15000);
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    std::string error;
+    OrdinaryCandidateEffects effects;
+    Check(CheckOrdinaryCandidate(payment, profile, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure stored payment: " + error);
+    Check(effects.invocation_cost == 18, "stored payment invocation cost");
+    const Outpoint created =
+        OutputOf(payment, profile.transaction, world.parent.chain_id);
+    const std::filesystem::path directory = TempDir("lotus-v2-two-header-fail");
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    const std::filesystem::path header_dir = directory / "header";
+    SealedChild stored;
+    Hash stored_utxo{};
+    std::array<uint8_t, 56> stored_money{};
+    Hash stored_state{};
+    std::vector<uint8_t> stored_header_file;
+    std::vector<uint8_t> stored_utxo_file;
+    std::vector<uint8_t> stored_money_file;
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        PersistentHeaderStore header_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "open kept utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "open kept monetary: " + error);
+        Check(PersistentHeaderStore::Open(header_dir.string(), header_store,
+                                          error),
+              "open kept header: " + error);
+        SeedUtxo(utxo_store, world);
+        SeedMonetary(monetary_store, world);
+        OrdinaryBlockConnected connected;
+        Check(ConnectOrdinaryBlock({payment}, world.parent, profile, kMonetary,
+                                   world.view, world.utxo, world.monetary,
+                                   connected, error, &utxo_store, &monetary_store),
+              "connect stored payment: " + error);
+        stored = SealPayment(world.parent, connected, payment, profile.transaction,
+                             50120);
+        Check(header_store.Commit(world.parent.chain_id, stored.header.height,
+                                  stored.header, error),
+              "commit stored header: " + error);
+        stored_utxo = connected.utxo_root;
+        stored_money = connected.monetary_bytes;
+        stored_state = connected.state_root;
+        stored_header_file = ReadRaw(header_dir / "header.dat");
+        stored_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        stored_money_file = ReadRaw(money_dir / "monetary.dat");
+        const size_t header_undos = DatFiles(header_dir / "undo");
+        const size_t utxo_undos = DatFiles(utxo_dir / "undo");
+        const size_t money_undos = DatFiles(money_dir / "monetary-undo");
+        Check(header_undos == 1 && utxo_undos == 2 && money_undos == 2,
+              "stored header is not one commit past the seed");
+
+        OrdinaryParentContext second_parent = world.parent;
+        second_parent.header = stored.header;
+        second_parent.monetary = world.monetary;
+        OrdinaryCandidateProfile second_profile = profile;
+        second_profile.candidate_height = stored.header.height + 1;
+        second_profile.parent_mtp = stored.header.time;
+        Transaction earlier = Payment(created, 10000);
+        earlier.outputs[0].branches = {BranchLeaf(PUSH_ZERO)};
+        const Outpoint locked =
+            OutputOf(earlier, second_profile.transaction, world.parent.chain_id);
+        const Transaction later = Payment(locked, 5000, PUSH_ZERO);
+        Check(later.inputs.size() == 1 && later.inputs[0].witnesses.size() == 1 &&
+                  later.inputs[0].witnesses[0].script == PUSH_ZERO &&
+                  PUSH_ZERO.size() == 1 && PUSH_ZERO[0] == 0x00 &&
+                  earlier.outputs[0].branches[0] == BranchLeaf(PUSH_ZERO),
