From 3c52d4e0d0dee795e2ae990ca7a44e52a9b83290 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:12:49 -0700
Subject: [PATCH] Bound retained Avalanche terminal inventory and invalid
 proofs

Maintenance explanation added during mailbox export:
Apply explicit bounds to retained terminal Avalanche inventory and invalid proof records. This prevents completed or rejected work from growing retained state indefinitely.

---
 src/lotus_v2/avalanche_poll.cpp   | 2 +-
 src/lotus_v2/avalanche_quorum.cpp | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/avalanche_poll.cpp b/src/lotus_v2/avalanche_poll.cpp
index 3c23f260215649e707ec9502ba6bbfafd3a7160a..b707e008d90f8d3debdd882f4261fb9b2c9b989e 100644
--- a/src/lotus_v2/avalanche_poll.cpp
+++ b/src/lotus_v2/avalanche_poll.cpp
@@ -30,7 +30,7 @@ PollEngine::~PollEngine()=default;
 bool PollEngine::Reconcile(const PollItem &item,bool accepted,std::string &error) {
     if(impl_->finished.contains(item)) return Fail(error,"already-finalized-item");
     if(impl_->records.contains(item)) return true;
-    if(impl_->records.size()>=impl_->profile.max_queries) return Fail(error,"vote-record-capacity");
+    if(impl_->records.size()+impl_->finished.size()>=impl_->profile.max_queries) return Fail(error,"vote-record-capacity");
     impl_->records.try_emplace(item,accepted); return true;
 }
 bool PollEngine::Next(Quorum &quorum,const ChainSnapshot &snapshot,int64_t now,OutgoingPoll &out,std::string &error) {
diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index 472e267b7ce187129e7705303b7fa967af032409..4d333507d318b01f7332a6a559bcaf3299091dcd 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -40,7 +40,7 @@ bool Quorum::Register(const ProofEnvelope &envelope,const ChainSnapshot &snapsho
     auto proof=envelope.proof; auto id=proof->getId();
     if(impl_->invalid.contains(id)) return Fail(error,"avalanche-invalidated");
     if(impl_->entries.contains(id)) return Fail(error,"proof-already-registered");
-    if(impl_->entries.size()>=impl_->profile.max_proofs) return Fail(error,"proof-capacity");
+    if(impl_->entries.size()+impl_->invalid.size()>=impl_->profile.max_proofs) return Fail(error,"proof-capacity");
     ::avalanche::ProofPool::ConflictingProofSet conflicts;
     auto result=impl_->active.addProofIfNoConflict(proof,conflicts);
     const auto cooldown=AddTime(now,impl_->profile.conflicting_proof_cooldown_seconds);
