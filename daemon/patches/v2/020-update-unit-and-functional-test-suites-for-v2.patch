index a621241daa313ba8e20232ccfe38c0d1c80c91de..d181f8c6e00b2010a098fffee8d7b5c0fa680a09 100644
--- a/src/test/getarg_tests.cpp
+++ b/src/test/getarg_tests.cpp
@@ -454,7 +454,32 @@ BOOST_AUTO_TEST_CASE(logargs) {
     BOOST_CHECK(str.find("Command-line arg: okaylog=\"public\"") !=
                 std::string::npos);
     BOOST_CHECK(str.find("dontlog=****") != std::string::npos);
-    BOOST_CHECK(str.find("private") == std::string::npos);
+    // Debug logs can include source paths such as /private/tmp. Check the
+    // argument payload on every line so logger metadata cannot masquerade as
+    // a leaked secret, while an unredacted sensitive value still fails.
+    const auto contains_private_payload = [](const std::string &log) {
+        const std::string marker = "Command-line arg: ";
+        for (const auto &line : SplitString(log, "\n")) {
+            const auto payload = line.find(marker);
+            if (payload != std::string::npos &&
+                line.find("private", payload + marker.size()) !=
+                    std::string::npos) {
+                return true;
+            }
+        }
+        return false;
+    };
+    BOOST_CHECK(!contains_private_payload(str));
+
+    // Adversarial controls use the same predicate as the captured log. Even
+    // after a correctly redacted line, a leaked value must be detected.
+    const std::string redacted =
+        "[/private/tmp/args.cpp:846] Command-line arg: dontlog=****\n";
+    BOOST_CHECK(!contains_private_payload(redacted));
+    BOOST_CHECK(contains_private_payload(
+        redacted + "Command-line arg: dontlog=\"private\"\n"));
+    BOOST_CHECK(contains_private_payload(
+        "[/private/tmp/args.cpp:846] Command-line arg: dontlog=\"private\"\n"));
 }
 
 BOOST_AUTO_TEST_SUITE_END()
