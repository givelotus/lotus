-            p.input.reset();
+            if (p.input) {
+                const auto &command = p.input->command;
+                const bool application = command == "tx" ||
+                    AvalancheCommand(command) || command == "inv" ||
+                    command == "getdata" || command == "notfound";
+                // A rewritten block-only notfound has already emitted its
+                // application half. Retire that stale fetch response, never
+                // repeat the transaction/proof notice on resume.
+                if (!application || p.block_notfound) p.input.reset();
+            }
+            p.block_notfound = false;
+            p.inventory_request = false;
             p.headers.clear();
             p.inventory.clear();
             p.cursor = 0;
