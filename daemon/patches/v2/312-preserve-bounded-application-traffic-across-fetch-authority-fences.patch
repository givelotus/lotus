         auto event = downloads.OnReorg(fetch_epoch);
         for (auto &[id, p] : peers) {
-            // Relay output is already committed by the enclosing engine. A
-            // fetch epoch reset must retain it or close its connection.
-            if ((p.output && p.output->origin == Origin::Application) ||
-                (p.input && (p.input->command == "tx" || p.input->command == "inv" ||
-                             p.input->command == "getdata" || p.input->command == "notfound"))) {
-                ClosePeer(id, p);
-                continue;
-            }
