+void AuthorityFencePreservesApplications() {
+    for (const std::string command : {"tx", "avahello", "inv", "getdata", "notfound", "mixednotfound"}) {
+        FaultEnv env;
+        Pair p(64, &env, true);
+        Seed(*p.a.runtime, {0, 1});
+        for (unsigned i = 0; i < 10; ++i) p.Cycle();
+        p.a.notices.clear();
+        p.b.notices.clear();
+        const bool rewritten = command == "mixednotfound";
+        Message inbound{rewritten ? "notfound" : command, Bytes{17}};
+        if (command == "inv" || command == "getdata" || command == "notfound" || rewritten) {
+            std::vector<Inventory> items{{1, Hash{17}}};
+            if (rewritten) items.push_back({2, Hash{18}});
+            std::string error;
+            Check(EncodeInventory(items, p.a.transport.ActiveLimit(),
+                                  inbound.payload, error), "encode retained inventory");
+        }
+        Check(p.b.transport.QueueMessage(inbound, p.ms) == QueueResult::Queued,
+              "queue inbound application before authority fence");
+        bool pending = false;
+        for (unsigned i = 0; i < 100 && !pending; ++i) {
+            p.b.transport.Poll(p.ms, TransportStep());
+            pending = p.a.transport.Poll(p.ms++, TransportStep()).event_pending;
+        }
+        Check(pending, "application waits in transport event");
+        // One dispatcher action cannot both take and process the event. Stop
+        // immediately when ownership transfers into the private input slot.
+        auto one = p.a.budget;
+        one.max_actions = 1;
+        for (unsigned i = 0; i < 30 && pending; ++i) {
+            p.a.dispatcher->Tick(p.ms, UINT64_MAX, 0, one);
+            pending = p.a.transport.Poll(p.ms++, {1, 0, 0}).event_pending;
+        }
+        Check(!pending, "dispatcher retains unprocessed application input");
+        while (auto notice = p.a.dispatcher->TakeNotice())
+            Check(!notice->application, "application has not been dispatched yet");
+        if (rewritten) {
+            bool emitted = false;
+            for (unsigned i = 0; i < 30 && !emitted; ++i) {
+                p.a.dispatcher->Tick(p.ms++, UINT64_MAX, 0, one);
+                while (auto notice = p.a.dispatcher->TakeNotice())
+                    if (notice->application) {
+                        std::vector<Inventory> items;
+                        std::string error;
+                        Check(!emitted && notice->application->command == "notfound" &&
+                                  DecodeInventory(notice->application->payload,
+                                      p.a.transport.ActiveLimit(), items, error) &&
+                                  items.size() == 1 && items[0].type == 1,
+                              "mixed notfound emits application half once before fence");
+                        emitted = true;
+                    }
+            }
+            Check(emitted, "mixed notfound leaves rewritten block half pending");
+        }
+        const auto staged = p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes{23}}, p.ms);
+        Check(staged == DispatcherResult::Queued,
+              "retain committed application output: " + std::to_string(int(staged)));
+        const auto epoch = p.a.dispatcher->FetchEpoch();
+        const auto queued = p.a.transport.QueuedBytes();
+        env.fail_after_sync = true;
+        HeaderAdmission out;
+        std::string error;
+        Check(p.a.runtime->AdmitHeader(HeaderOf(V(4)), out, error) ==
+                  DevelopmentRuntimeResult::ReopenRequired,
+              "ambiguous storage write fences application work");
+        p.a.dispatcher->Tick(p.ms++, UINT64_MAX, 0, p.a.budget);
+        Check(p.a.dispatcher->FetchEpoch() > epoch && p.a.Active(),
+              "authority fence retains application connection");
+        Check(p.a.transport.QueuedBytes() == queued,
+              "lost authority does not stage application output");
+        while (auto notice = p.a.dispatcher->TakeNotice())
+            Check(!notice->application, "lost authority does not dispatch application input");
+        Check(p.a.runtime->Tick(UINT64_MAX, 0, TickLimits()).result ==
+                  DevelopmentRuntimeResult::Reopened,
+              "application fixture explicitly restores authority");
+        for (unsigned i = 0; i < 20; ++i) p.Cycle();
+        size_t received = 0, sent = 0;
+        for (const auto &notice : p.a.notices)
+            if (notice.application) {
+                Check(notice.application->command == inbound.command &&
+                          notice.application->payload == inbound.payload,
+                      "retained application input bytes unchanged");
+                ++received;
+            }
+        for (const auto &notice : p.b.notices)
+            if (notice.application) {
+                Check(notice.application->command == "tx" &&
+                          notice.application->payload == Bytes{23},
+                      "retained application output bytes unchanged");
+                ++sent;
+            }
+        Check(received == (rewritten ? 0U : 1U) && sent == 1 && p.a.Active() && p.b.Active(),
+              "retained applications resume exactly once after authority restoration");
+        if (rewritten) {
+            p.a.notices.clear();
+            const Inventory item{1, Hash{19}};
+            Bytes payload;
+            Check(EncodeInventory(std::span(&item, 1), p.a.transport.ActiveLimit(),
+                                  payload, error), "encode fresh transaction notfound");
+            Check(p.b.transport.QueueMessage({"notfound", payload}, p.ms) == QueueResult::Queued,
+                  "queue fresh transaction notfound after fence");
+            for (unsigned i = 0; i < 20; ++i) p.Cycle();
+            size_t fresh = 0;
+            for (const auto &notice : p.a.notices)
+                if (notice.application) {
+                    Check(notice.application->command == "notfound" &&
+                              notice.application->payload == payload,
+                          "fresh notfound uses application path after block flag reset");
+                    ++fresh;
+                }
+            Check(fresh == 1, "fresh transaction notfound delivered exactly once");
+        }
+    }
+    std::cout << "PASS authority fence preserves bounded applications and gates resume\n";
+}
