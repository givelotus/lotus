 src/lotus_v2/peer_dispatcher.h              |   5 +-
 src/lotus_v2/peer_dispatcher_test/README.md |  36 +++++
 src/lotus_v2/test_peer_dispatcher.cpp       | 145 +++++++++++++++++++-
 4 files changed, 195 insertions(+), 16 deletions(-)

