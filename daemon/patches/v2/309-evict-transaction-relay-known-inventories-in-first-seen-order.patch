From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 18:47:26 -0700
Subject: [PATCH] Evict transaction relay known inventories in first-seen order

Lexicographic eviction lets high-valued inventory hashes pin old entries and evict newer low-valued hashes under saturation. Maintain a bounded FIFO alongside the membership set, without refreshing duplicate sightings, and roll back queue insertion if set allocation fails.

The two-entry adversarial regression fails before the repair and passes afterward; the focused relay suite, including real pool/VM admission, passes.
---
 src/lotus_v2/test_transaction_relay.cpp       | 23 +++++++++++++++++++
 src/lotus_v2/transaction_relay.cpp            | 17 ++++++++++----
 src/lotus_v2/transaction_relay.h              |  1 +
 src/lotus_v2/transaction_relay_test/README.md | 10 +++++++-
 4 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/src/lotus_v2/test_transaction_relay.cpp b/src/lotus_v2/test_transaction_relay.cpp
index 6d2e5734e53375ac0f54606391aa12954d40084e..7df13ac7b0333d0cdb8c532944af818921de87f6 100644
--- a/src/lotus_v2/test_transaction_relay.cpp
+++ b/src/lotus_v2/test_transaction_relay.cpp
@@ -188,6 +188,28 @@ void Test() {
     bad.push_back(0);
     CHECK(bounded.Handle(1, {"tx", bad}, 5).invalid_peer);
 }
+// High-valued attacker inventory must not pin the bounded known cache forever.
+void KnownInventoryRecency() {
+    auto profile = Profile();
+    RelayLimits limits;
+    limits.known_per_peer = 2;
+    TransactionRelay relay(
+        profile, limits, [](const Bytes &) { return RelayAdmission::Accepted; },
+        [](const Hash &, Bytes &) { return true; });
+    CHECK(relay.AddPeer(1, profile.receive_limit, true));
+    Hash high{}, middle{}, low{};
+    high.fill(255);
+    middle.fill(254);
+    low[0] = 1;
+    CHECK(relay.Handle(1, Inv(high), 1).actions.empty());
+    CHECK(relay.Handle(1, Inv(middle), 2).actions.empty());
+    CHECK(relay.Handle(1, Inv(low), 3).actions.empty());
+    // First-seen FIFO retains the recent low hash and evicts the oldest high.
+    CHECK(relay.AnnounceMany(std::span(&low, 1), 4).actions.empty());
+    CHECK(relay.AnnounceMany(std::span(&high, 1), 5).actions.size() == 1);
+    CHECK(relay.AnnounceMany(std::span(&high, 1), 6).actions.empty());
+    CHECK(relay.AnnounceMany(std::span(&middle, 1), 7).actions.size() == 1);
+}
