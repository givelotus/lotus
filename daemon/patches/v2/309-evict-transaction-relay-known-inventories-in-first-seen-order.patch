-    return peers_.emplace(id, Peer{limit, {}, {}}).second;
+    return peers_.emplace(id, Peer{limit, {}, {}, {}}).second;
 }
 void TransactionRelay::RemovePeer(RelayPeer id) {
     peers_.erase(id);
@@ -79,9 +79,18 @@ bool TransactionRelay::Send(RelayPeer id, Message m, RelayResult &r) {
     return true;
 }
 void TransactionRelay::Remember(Peer &p, const Hash &h) {
-    if (p.known.size() >= limits_.known_per_peer && !p.known.contains(h))
-        p.known.erase(p.known.begin());
-    p.known.insert(h);
+    if (p.known.contains(h)) return;
+    p.known_fifo.push_back(h);
+    try {
+        p.known.insert(h);
+    } catch (...) {
+        p.known_fifo.pop_back();
+        throw;
+    }
+    if (p.known.size() > limits_.known_per_peer) {
+        p.known.erase(p.known_fifo.front());
+        p.known_fifo.pop_front();
+    }
 }
