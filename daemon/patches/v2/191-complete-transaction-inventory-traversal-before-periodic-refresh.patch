From cc62a54a8646fc7e6bf6d1ab603ebe940750e724 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:20:47 -0700
Subject: [PATCH] Complete transaction inventory traversal before periodic
 refresh

Maintenance explanation added during mailbox export:
Finish the current bounded transaction inventory traversal before starting its periodic refresh. Extend relay output tests to prevent repeated refresh resets from starving later inventory entries.

---
 src/lotus_v2/development_node_command.cpp     | 10 +++++-
 .../test_relay_output.py                      | 34 ++++++++++++++++++-
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index 651771aa4bcaa819f598031b74e97b8398071a9d..b303e43aefb904e68b64ed8d7272cd117ed0c0a9 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -368,6 +368,14 @@ namespace {
         l.serving_bytes_per_window = 64 * MiB;
         return c;
     }
+    // BEGIN INVENTORY REFRESH POLICY
+    bool RefreshInventory(size_t cursor, size_t count, uint64_t now,
+                          uint64_t deadline) {
+        // Zero explicitly invalidates an epoch. Periodic refresh waits for
+        // every page, including when a traversal spans several seconds.
+        return deadline == 0 || (cursor >= count && now >= deadline);
+    }
+    // END INVENTORY REFRESH POLICY
     // BEGIN RELAY OUTPUT QUEUE
     class RelayOutputQueue {
         struct Pending { std::deque<Message> messages; size_t bytes{}; };
@@ -1816,7 +1824,7 @@ namespace {
             if (pool->Snapshot(0, 0).status != PoolStatus::Accepted) {
                 relay_inventory.clear();
                 inventory_refresh = 0;
-            } else if (now >= inventory_refresh) {
+            } else if (RefreshInventory(inventory_cursor, relay_inventory.size(), now, inventory_refresh)) {
                 // Snapshot order is parent before child; Inventory() itself
                 // does not promise this order. Cache only identities between
                 // bounded one-second refreshes and fence every page above.
diff --git a/src/lotus_v2/development_pool_command_test/test_relay_output.py b/src/lotus_v2/development_pool_command_test/test_relay_output.py
index e4e7ab108074cb4d7bdc08496804c1221ac14a70..71d6c3171f4589c29ba857100a245bcbd6d44dc9 100644
--- a/src/lotus_v2/development_pool_command_test/test_relay_output.py
+++ b/src/lotus_v2/development_pool_command_test/test_relay_output.py
@@ -7,6 +7,7 @@ import tempfile
 
 source = (Path(__file__).resolve().parent.parent / 'development_node_command.cpp').read_text()
 queue = source.split('// BEGIN RELAY OUTPUT QUEUE\n', 1)[1].split('// END RELAY OUTPUT QUEUE', 1)[0]
+refresh = source.split('// BEGIN INVENTORY REFRESH POLICY\n', 1)[1].split('// END INVENTORY REFRESH POLICY', 1)[0]
 preamble = r'''
 #include <cassert>
 #include <cstdint>
@@ -22,6 +23,37 @@ enum class DispatcherResult { Queued, Busy, Closed, CapacityRefused };
 '''
 test = r'''
 int main() {
+    // A thousand-item traversal takes >1s at four identities per 10ms turn.
+    // Periodic refresh must not restart the cursor before its last page.
+    size_t cursor = 0;
+    uint64_t deadline = 0;
+    unsigned refreshes = 0;
+    bool last_advertised = false;
+    for (uint64_t now = 10; now <= 3000; now += 10) {
+        if (RefreshInventory(cursor, 1000, now, deadline)) {
+            cursor = 0; deadline = now + 1000; ++refreshes;
+        }
+        for (unsigned item = 0; item < 4 && cursor < 1000; ++item)
+            if (++cursor == 1000) last_advertised = true;
+    }
+    assert(last_advertised && refreshes == 2);
+    // Explicit anchor invalidation refreshes immediately; a finite burst of
+    // epoch changes still leaves the complete new snapshot traversable.
+    for (unsigned epoch = 0; epoch < 3; ++epoch) {
+        deadline = 0;
+        assert(RefreshInventory(cursor, 1000, 4000 + epoch, deadline));
+        cursor = 0; deadline = 5000 + epoch;
+    }
+    last_advertised = false;
+    for (uint64_t now = 4010; now < 7010; now += 10) {
+        if (RefreshInventory(cursor, 1000, now, deadline)) {
+            cursor = 0; deadline = now + 1000;
+        }
+        for (unsigned item = 0; item < 4 && cursor < 1000; ++item)
+            if (++cursor == 1000) last_advertised = true;
+    }
+    assert(last_advertised);
+
     RelayOutputQueue queue;
     assert(queue.Stage({{1,{"inv",{1}}},{1,{"inv",{2}}}}).empty());
     unsigned calls = 0;
@@ -68,7 +100,7 @@ int main() {
 '''
 with tempfile.TemporaryDirectory(prefix='lotus-node-relay-output-') as directory:
     path = Path(directory)
-    (path / 'test.cpp').write_text(preamble + queue + test)
+    (path / 'test.cpp').write_text(preamble + queue + refresh + test)
     subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++20', '-Wall', '-Wextra', '-Werror', str(path / 'test.cpp'), '-o', str(path / 'test')], check=True)
     subprocess.run([str(path / 'test')], check=True)
 print('relay output queue: FIFO, Busy retry, multi-message, capacity and lifecycle checks passed')
