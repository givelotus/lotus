From 6a527b286f03aa268be3c4719aa0cf39572d2db2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:56:52 -0700
Subject: [PATCH] build(v2): link runtime peer dispatcher and integration
 checks

Expose the dispatcher library over existing runtime, download and transport libraries. Enable its real TCP integration checks only on supported POSIX platforms; no node or network profile is started by building these targets.
---
 src/lotus_v2/CMakeLists.txt | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 30cd2872495468a17976c829c1bf67e21fe7ddfd..bd2dfd74dab7a33f13ddd1fa1da251e54950d5d8 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -269,3 +269,16 @@ target_link_libraries(test_lotus_v2_development_runtime PRIVATE lotus_v2_develop
 add_custom_target(check-lotus-v2-development-runtime
     COMMAND $<TARGET_FILE:test_lotus_v2_development_runtime>
     DEPENDS test_lotus_v2_development_runtime)
+
+# Bounded application dispatch over the runtime and one shared download manager.
+add_library(lotus_v2_peer_dispatcher STATIC peer_dispatcher.cpp)
+target_link_libraries(lotus_v2_peer_dispatcher PUBLIC
+    lotus_v2_development_runtime lotus_v2_peer_download lotus_v2_peer_transport)
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    add_executable(test_lotus_v2_peer_dispatcher test_peer_dispatcher.cpp)
+    target_link_libraries(test_lotus_v2_peer_dispatcher PRIVATE
+        lotus_v2_peer_dispatcher lotus_v2_peer_tcp)
+    add_custom_target(check-lotus-v2-peer-dispatcher
+        COMMAND $<TARGET_FILE:test_lotus_v2_peer_dispatcher>
+        DEPENDS test_lotus_v2_peer_dispatcher)
+endif()
