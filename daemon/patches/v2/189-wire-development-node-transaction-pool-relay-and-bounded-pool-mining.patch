+            RelayActions(relay->Tick(now), now);
+            if (changed) inventory_refresh = 0;
+            if (pool->Snapshot(0, 0).status != PoolStatus::Accepted) {
+                relay_inventory.clear();
+                inventory_refresh = 0;
+            } else if (now >= inventory_refresh) {
+                // Snapshot order is parent before child; Inventory() itself
+                // does not promise this order. Cache only identities between
+                // bounded one-second refreshes and fence every page above.
+                const auto snapshot = pool->Snapshot(1000, 16000000);
+                relay_inventory.clear();
+                for (const auto &entry : snapshot.entries)
+                    relay_inventory.push_back(entry.effects.txhash);
+                inventory_cursor = 0;
+                inventory_refresh = now + 1000;
+            }
+            if (inventory_cursor < relay_inventory.size()) {
+                const auto count = std::min<size_t>(128, relay_inventory.size() - inventory_cursor);
+                RelayActions(relay->AnnounceMany(std::span<const Hash>(relay_inventory).subspan(inventory_cursor, count), now), now);
+                inventory_cursor += count;
+            }
             CleanupBodies();
