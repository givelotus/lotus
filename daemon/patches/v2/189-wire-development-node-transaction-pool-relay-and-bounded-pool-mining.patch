+    void Node::RelayActions(RelayResult result, uint64_t now) {
+        // SendApplication accepts a whole Message or none. A failed enqueue
+        // invalidates that peer's relay state and closes its physical session.
+        for (auto &action : result.actions) {
+            const ConnectionId connection{action.peer};
+            if (!relay_peers.contains(connection)) continue;
+            if (dispatcher->SendApplication(connection, std::move(action.message), now) != DispatcherResult::Queued) {
+                relay->RemovePeer(action.peer);
+                relay_peers.erase(connection);
+                dispatcher->Remove(connection);
+                for (auto &c : connections) if(c->id == connection) c->stream.Close();
+            }
+        }
+    }
+    UniValue Node::SubmitTransaction(const UniValue &request) {
+        Keys(request, {"id", "command", "wire", "expected_tip"});
+        const auto wire = Unhex(request["wire"], 1000000);
+        PoolBudget budget{1, 1000000};
+        const auto result = pool->Submit(wire, HashOf(request["expected_tip"]), budget);
+        static const char *names[] = {"accepted", "duplicate", "conflict", "missing_parents", "invalid", "capacity_refused", "stale_tip", "inconclusive"};
+        UniValue answer(UniValue::VOBJ), missing(UniValue::VARR);
+        answer.pushKV("ok", result.status == PoolStatus::Accepted || result.status == PoolStatus::Duplicate);
+        answer.pushKV("result", names[static_cast<size_t>(result.status)]);
+        answer.pushKV("txid", Hex(result.txid));
+        answer.pushKV("txhash", Hex(result.txhash));
+        answer.pushKV("error", result.error.substr(0, 1024));
+        for (const auto &outpoint : result.missing) {
+            UniValue item(UniValue::VOBJ);
+            item.pushKV("txid", Hex(outpoint.tx_id));
+            item.pushKV("index", uint64_t(outpoint.index));
+            missing.push_back(item);
+        }
+        answer.pushKV("missing", missing);
+        if (result.status == PoolStatus::Accepted) inventory_refresh = 0;
+        return answer;
+    }
+    UniValue Node::TransactionQuery(const UniValue &request) {
+        std::set<std::string> keys{"id", "command", "txid"};
+        if (request.exists("txhash")) keys.insert("txhash");
+        if (request.exists("wire")) keys.insert("wire");
+        Keys(request, keys);
+        std::optional<Hash> hash;
+        if (request.exists("txhash")) hash = HashOf(request["txhash"]);
+        std::vector<uint8_t> wire;
+        const bool has_wire = request.exists("wire");
+        if (has_wire) wire = Unhex(request["wire"], 1000000);
+        const auto status = pool->Status(HashOf(request["txid"]), hash, has_wire ? &wire : nullptr);
+        static const char *names[] = {"pending", "confirmed", "conflicted", "unknown", "inconclusive"};
+        UniValue answer(UniValue::VOBJ);
+        answer.pushKV("state", names[static_cast<size_t>(status.state)]);
+        answer.pushKV("txid", Hex(status.txid));
+        answer.pushKV("txhash", Hex(status.txhash));
+        answer.pushKV("error", status.diagnostic.substr(0, 1024));
+        if (status.confirmation) {
+            answer.pushKV("block_id", Hex(status.confirmation->block));
+            answer.pushKV("height", status.confirmation->height);
+        }
+        return answer;
+    }
+    UniValue Node::Mempool() {
+        const auto snapshot = pool->Snapshot(1000, 16000000);
+        UniValue answer(UniValue::VOBJ), entries(UniValue::VARR);
+        size_t bytes = 0;
+        for (const auto &entry : snapshot.entries) {
+            UniValue item(UniValue::VOBJ);
+            item.pushKV("txid", Hex(entry.effects.txid));
+            item.pushKV("txhash", Hex(entry.effects.txhash));
+            entries.push_back(item);
+            bytes += entry.wire.size();
+        }
+        answer.pushKV("ready", snapshot.status == PoolStatus::Accepted);
+        answer.pushKV("tip", Hex(snapshot.anchor.tip));
+        answer.pushKV("count", uint64_t(snapshot.entries.size()));
+        answer.pushKV("bytes", uint64_t(bytes));
+        answer.pushKV("transactions", entries);
+        return answer;
+    }
+    UniValue Node::MinePool(const UniValue &request) {
+        Keys(request, {"id", "command", "expected_parent", "time", "max_claim", "coinbase_output", "coinbase_data", "start_nonce", "max_attempts"});
+        const auto snapshot = pool->Snapshot(1000, 16000000);
+        Require(snapshot.status == PoolStatus::Accepted, "transaction pool authority unavailable");
+        Require(snapshot.anchor.tip == HashOf(request["expected_parent"]), "stale pool parent");
+        UniValue expanded = request;
+        UniValue transactions(UniValue::VARR);
+        // Validate each candidate prefix against the real block builder. Costs
+        // and parabolic burn may reject a pool-valid transaction in a block.
+        // One rejection does not prevent independent later entries being used.
+        size_t attempts = 0, skipped = 0;
+        for (const auto &entry : snapshot.entries) {
+            if (++attempts > 64) break;
+            UniValue candidate = transactions;
+            candidate.push_back(Hex(entry.wire));
+            UniValue probe = request;
+            probe.pushKV("transactions", candidate);
+            probe.pushKV("max_attempts", uint64_t(0));
+            const auto result = MineBlock(probe);
+            if (result["result"].isStr() && result["result"].get_str() == "nonce_exhausted") transactions = std::move(candidate);
+            else ++skipped;
+        }
+        expanded.pushKV("transactions", transactions);
+        auto answer = MineBlock(expanded);
+        answer.pushKV("pool_selected", uint64_t(transactions.size()));
+        answer.pushKV("pool_skipped", uint64_t(skipped));
+        return answer;
+    }
