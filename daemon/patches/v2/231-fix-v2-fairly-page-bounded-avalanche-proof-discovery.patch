From fa1c281f3786281874a2ef5867a841de7c1cc825 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:47:34 -0700
Subject: [PATCH] fix(v2): fairly page bounded Avalanche proof discovery

---
 src/lotus_v2/avalanche_peer.cpp            | 26 +++++++--
 src/lotus_v2/avalanche_peer.h              |  6 ++-
 src/lotus_v2/avalanche_peer_test/README.md | 14 +++++
 src/lotus_v2/test_avalanche_peer.cpp       | 63 ++++++++++++++++++++++
 4 files changed, 102 insertions(+), 7 deletions(-)

diff --git a/src/lotus_v2/avalanche_peer.cpp b/src/lotus_v2/avalanche_peer.cpp
index 1a238dab50eab8c3b0ae5c6523b0cada38673b33..84916ee4dbf2353cf88662f6e4e7aed06ab7c05a 100644
--- a/src/lotus_v2/avalanche_peer.cpp
+++ b/src/lotus_v2/avalanche_peer.cpp
@@ -84,7 +84,7 @@ bool EncodeProofEnvelope(const ProofEnvelope &p, const PeerLimits &l, peer::Byte
 AvalanchePeer::AvalanchePeer(peer::PeerDispatcher &d, PeerLimits l, PeerCallbacks c)
     : dispatcher_(d), limits_(l), callbacks_(std::move(c)) {
     if (!l.max_peers || !l.max_payload || !l.max_stakes || l.max_stakes > AVALANCHE_MAX_PROOF_STAKES ||
-        !l.max_elements || l.max_elements > 1024 || !l.max_proofs || !l.max_actions ||
+        !l.max_elements || l.max_elements > 1024 || !l.max_proofs || !l.max_actions || !l.max_enumerated_proofs ||
         l.max_actions < l.max_proofs || l.max_action_bytes < uint64_t(l.max_proofs) * l.max_payload || !l.discovery_interval_ms || !l.request_timeout_ms || !l.proof_request_interval_ms || !l.poll_cooldown_ms ||
         !callbacks_.register_proof || !callbacks_.bind || !callbacks_.disconnect ||
         !callbacks_.sent_proof_inventory || !callbacks_.respond || !callbacks_.receive || !callbacks_.proof || !callbacks_.proofs ||
@@ -119,6 +119,7 @@ PeerResult AvalanchePeer::Hello(peer::ConnectionId id, const ::avalanche::Delega
     AuthenticatedHello checked;
     if (!AuthenticateHello(delegation, sig, {t->local_nonce, t->remote_nonce, t->local_entropy, t->remote_entropy}, limits_.max_elements, checked, e))
         return PeerResult::LocalFailure;
+    if (checked.session_key != callbacks_.local_session_key) { e = "local-session-key-mismatch"; return PeerResult::LocalFailure; }
     auto b = WireBytes(delegation, sig, limits_.max_elements);
     return Queue(id, {"avahello", std::move(b)}, e) ? PeerResult::Accepted : PeerResult::Backpressure;
 }
@@ -273,8 +274,16 @@ PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice, uint64_t
         if (m.command == "getavaproofs") {
             if (!b.empty()) { e = "getavaproofs-framing"; return PeerResult::Rejected; }
             if (now < state.next_discovery) { e = "discovery-cooldown"; return PeerResult::Rejected; }
-            auto proofs = callbacks_.proofs();
-            if (proofs.size() > limits_.max_proofs) { e = "local-proof-list-capacity"; return PeerResult::LocalFailure; }
+            if (state.discovery_cursor == state.discovery_catalog.size()) {
+                auto catalog = callbacks_.proofs();
+                if (catalog.size() > limits_.max_enumerated_proofs) { e = "local-proof-enumeration-capacity"; return PeerResult::LocalFailure; }
+                std::sort(catalog.begin(), catalog.end());
+                catalog.erase(std::unique(catalog.begin(), catalog.end()), catalog.end());
+                state.discovery_catalog = std::move(catalog); state.discovery_cursor = 0;
+            }
+            const size_t end = state.discovery_cursor + std::min(size_t(limits_.max_proofs), state.discovery_catalog.size() - state.discovery_cursor);
+            std::vector<::avalanche::ProofId> proofs(state.discovery_catalog.begin() + state.discovery_cursor,
+                                                    state.discovery_catalog.begin() + end);
             uint64_t k0, k1; if (!callbacks_.discovery_keys(k0, k1)) return PeerResult::LocalFailure;
             DataStream s; s << k0 << k1; WriteCompactSize(s, proofs.size());
             for (const auto &proof : proofs) {
@@ -284,6 +293,7 @@ PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice, uint64_t
             WriteCompactSize(s, 0); // No prefills: every proof travels with native binding.
             auto ptr = reinterpret_cast<const uint8_t *>(s.data()); peer::Bytes bytes(ptr, ptr + s.size());
             if (!Queue(id, {"avaproofs", std::move(bytes)}, e)) return PeerResult::LocalFailure;
+            state.discovery_cursor = end;
             state.advertised = std::move(proofs); state.next_discovery = Deadline(now, limits_.discovery_interval_ms);
             return PeerResult::Accepted;
         }
@@ -348,8 +358,14 @@ PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice, uint64_t
             if (!c.End()) { e = "proof-request-trailing-bytes"; return PeerResult::Rejected; }
             std::vector<peer::Message> responses; responses.reserve(indices.size());
             for (auto i : indices) { auto proof = callbacks_.proof(state.advertised[i]); peer::Bytes bytes;
-                if (!proof || !EncodeProofEnvelope(*proof, limits_, bytes, e)) return PeerResult::LocalFailure;
-                responses.push_back({"avaproof", std::move(bytes)});
+                if (proof) {
+                    if (!EncodeProofEnvelope(*proof, limits_, bytes, e)) return PeerResult::LocalFailure;
+                    responses.push_back({"avaproof", std::move(bytes)});
+                } else {
+                    const peer::Inventory missing{peer::PROOF_INVENTORY_TYPE, HashOf(state.advertised[i])};
+                    if (!peer::EncodeInventory(std::span{&missing, 1}, limits_.max_payload, bytes, e)) return PeerResult::LocalFailure;
+                    responses.push_back({"notfound", std::move(bytes)});
+                }
             }
             for (auto &message : responses) if (!Queue(id, std::move(message), e)) return PeerResult::LocalFailure;
             state.advertised.clear(); state.next_proof_request = Deadline(now, limits_.proof_request_interval_ms);
diff --git a/src/lotus_v2/avalanche_peer.h b/src/lotus_v2/avalanche_peer.h
index d122e6d50ce51ff33ae6d008b25c0d0230a6a61a..be2fcb8ac40e6181679c0cfbd82d017332e18983 100644
--- a/src/lotus_v2/avalanche_peer.h
+++ b/src/lotus_v2/avalanche_peer.h
@@ -9,7 +9,7 @@
 namespace lotus::v2::ava {
 struct PeerLimits {
     uint32_t max_peers{64}, max_payload{256000}, max_stakes{1000}, max_payout_script{10000};
-    uint32_t max_elements{1024}, max_proofs{64}, max_actions{128};
+    uint32_t max_elements{1024}, max_proofs{64}, max_actions{128}, max_enumerated_proofs{10000};
     uint64_t max_action_bytes{16 * 1024 * 1024}, discovery_interval_ms{60000}, request_timeout_ms{10000}, proof_request_interval_ms{100}, poll_cooldown_ms{AVALANCHE_DEFAULT_COOLDOWN};
 };
 // V2 avaproof extends the exact pinned ABC proof bytes with CompactSize lock
@@ -27,6 +27,7 @@ struct PeerCallbacks {
     std::function<bool(const OutgoingPoll &, SignedResponse &, std::string &)> respond;
     std::function<bool(NodeId, const SignedResponse &, std::string &)> receive;
     std::function<std::optional<ProofEnvelope>(const ::avalanche::ProofId &)> proof;
+    // Must enumerate at most limits.max_enumerated_proofs (native quorum cap).
     std::function<std::vector<::avalanche::ProofId>()> proofs;
     std::function<bool(uint64_t &, uint64_t &)> discovery_keys;
     // Root retains the secret; callback must sign this actual connection digest.
@@ -59,7 +60,8 @@ private:
         SchnorrSig hello_signature{};
         ConnectionTranscript incoming;
         std::map<::avalanche::ProofId, uint64_t> requested;
-        std::vector<::avalanche::ProofId> advertised;
+        std::vector<::avalanche::ProofId> advertised, discovery_catalog;
+        size_t discovery_cursor{};
         uint32_t hello_elements{}, discovery_expected{};
         bool discovery_outstanding{};
         uint64_t discovery_deadline{}, next_discovery{}, next_proof_request{}, next_poll{};
diff --git a/src/lotus_v2/avalanche_peer_test/README.md b/src/lotus_v2/avalanche_peer_test/README.md
index 3cf6bd60dece8a30b760ed683f2d05b17b1cd30d..1245d7f5eefad0ba63ad814b3a2e3cf205612e3b 100644
--- a/src/lotus_v2/avalanche_peer_test/README.md
+++ b/src/lotus_v2/avalanche_peer_test/README.md
@@ -66,3 +66,17 @@ unauthenticated poll rejection, typed block poll and real Schnorr response,
 invalid signature isolation, compact discovery/native envelope relay, native
 prefill admission, proof truncation/trailing/oversized count rejection, mandatory
 native binding and action retention under dispatcher Busy.
+
+Discovery availability: each peer retains a deduplicated sorted catalog of at
+most max_enumerated_proofs (default 10,000, matching the native quorum bound),
+plus one advertised page of at most max_proofs (default 64). The proofs callback
+must itself enforce the enumeration cap; adapter validation cannot bound memory
+allocated inside a caller callback. Enumeration runs once per catalog cycle.
+Each accepted getavaproofs advances through the current catalog without
+restarting it when the live set changes. Every catalog member is offered within
+ceil(catalog size / max_proofs) accepted requests; the next cycle refreshes the
+live set. Thus additions cannot indefinitely displace an existing snapshot's
+remaining members. Removed advertised proofs produce notfound. Peers that never
+request another page cannot receive further discovery information. Tests cover
+65-proof stable catalogs, mutation between pages, subsequent cycle refresh,
+removed-proof notfound, and local hello/session key mismatch before queuing.
diff --git a/src/lotus_v2/test_avalanche_peer.cpp b/src/lotus_v2/test_avalanche_peer.cpp
index 3a76dbce4d62c1820c4cc5b5e89e04484cdb1405..896dafb397c56ba2a7b0a77b77cf072924733bd5 100644
--- a/src/lotus_v2/test_avalanche_peer.cpp
+++ b/src/lotus_v2/test_avalanche_peer.cpp
@@ -4,6 +4,7 @@
 #include <avalanche/proofbuilder.h>
 #include <avalanche/delegationbuilder.h>
 #include <streams.h>
+#include <crypto/siphash.h>
 using namespace lotus::v2::ava;
 namespace {
 PeerCallbacks Callbacks(CKey &key, ProofEnvelope &proof, unsigned &registered, unsigned &bound, unsigned &received) {
@@ -103,6 +104,68 @@ int main() {
                                   Message{"avaproofs", Bytes(prefptr, prefptr + prefill.size())}};
         Check(a.Handle(prefilled, pair.ms, e) == PeerResult::Accepted && registered == 2, "bounded native prefilled proof admitted: " + e);
         a.Disconnect(pair.a.connection); Check(!a.PendingActions() && !a.Node(pair.a.connection), "disconnect releases peer actions");
+        Pair pages; unsigned enumerations = 0;
+        std::vector<::avalanche::ProofId> catalog;
+        for (unsigned i = 1; i <= 65; ++i) {
+            uint256 id; id.begin()[0] = uint8_t(i); catalog.emplace_back(id);
+        }
+        auto page_callbacks = Callbacks(key, proof, registered, bound, received);
+        page_callbacks.proofs = [&] { ++enumerations; return catalog; };
+        AvalanchePeer server(*pages.b.dispatcher, limits, std::move(page_callbacks));
+        Check(server.Activate(pages.b.connection, e) == PeerResult::Accepted, "activate bounded discovery server");
+        auto page = [&](uint64_t now) {
+            DispatcherNotice request{DispatcherNoticeKind::Application, pages.b.connection, {}, {}, {}, Message{"getavaproofs", {}}};
+            Check(server.Handle(request, now, e) == PeerResult::Accepted, "bounded catalog page: " + e);
+            std::vector<uint64_t> ids;
+            for (unsigned tick = 0; tick < 100; ++tick) {
+                server.Pump(pages.ms); pages.Cycle();
+                for (const auto &notice : pages.a.notices) if (notice.application && notice.application->command == "avaproofs") {
+                    const auto &wire = notice.application->payload;
+                    DataStream s{Span<const uint8_t>{wire.data(), wire.size()}};
+                    uint64_t k0, k1; s >> k0 >> k1;
+                    const auto count = ReadCompactSize(s);
+                    for (uint64_t i = 0; i < count; ++i) {
+                        uint64_t id = 0;
+                        for (unsigned j = 0; j < 6; ++j) { uint8_t octet; s >> octet; id |= uint64_t(octet) << (8 * j); }
+                        ids.push_back(id);
+                    }
+                    Check(ReadCompactSize(s) == 0 && s.empty(), "exact bounded discovery page wire");
+                }
+                pages.a.notices.clear(); pages.b.notices.clear();
+            }
+            return ids;
+        };
+        auto first = page(1000); auto second = page(61000);
+        Check(first.size() == 64 && second.size() == 1 && enumerations == 1, "65 proofs span two bounded pages with one enumeration");
+        auto sorted_catalog = catalog; std::sort(sorted_catalog.begin(), sorted_catalog.end());
+        std::set<uint64_t> expected;
+        for (const auto &id : sorted_catalog) expected.insert(SipHashUint256(2, 3, id) & 0xffffffffffffULL);
+        std::set<uint64_t> announced(first.begin(), first.end()); announced.insert(second.begin(), second.end());
+        Check(announced == expected, "stable catalog visits all proofs without starvation");
+        auto third = page(121000);
+        const auto removed_tail = sorted_catalog.back();
+        catalog.erase(std::find(catalog.begin(), catalog.end(), removed_tail));
+        uint256 newcomer; newcomer.begin()[0] = 99; catalog.emplace_back(newcomer);
+        auto fourth = page(181000);
+        Check(third == first && fourth == second && enumerations == 2, "mutation cannot restart or starve a snapshot's final page");
+        DispatcherNotice vanished{DispatcherNoticeKind::Application, pages.b.connection, {}, {}, {}, Message{"avaproofsreq", {1, 0}}};
+        Check(server.Handle(vanished, 181001, e) == PeerResult::Accepted, "removed snapshot proof produces bounded notfound");
+        bool notfound = false;
+        for (unsigned i = 0; i < 100; ++i) {
+            server.Pump(pages.ms); pages.Cycle();
+            for (const auto &notice : pages.a.notices) if (notice.application && notice.application->command == "notfound") notfound = true;
+            pages.a.notices.clear(); pages.b.notices.clear();
+        }
+        Check(notfound, "removed advertised proof does not close discovery server");
+        auto fifth = page(241000); auto sixth = page(301000);
+        std::set<uint64_t> updated(fifth.begin(), fifth.end()); updated.insert(sixth.begin(), sixth.end());
+        expected.clear(); for (const auto &id : catalog) expected.insert(SipHashUint256(2, 3, id) & 0xffffffffffffULL);
+        Check(updated == expected && enumerations == 3, "new cycle fairly enumerates additions and removals");
+        auto mismatch_callbacks = Callbacks(key, proof, registered, bound, received);
+        CKey other; other.MakeNewKey(true); mismatch_callbacks.local_session_key = other.GetPubKey();
+        AvalanchePeer mismatch(*pages.a.dispatcher, limits, std::move(mismatch_callbacks));
+        Check(mismatch.Activate(pages.a.connection, e) == PeerResult::Accepted, "activate mismatched local key fixture");
+        Check(mismatch.Hello(pages.a.connection, delegation, e) == PeerResult::LocalFailure && e == "local-session-key-mismatch" && !mismatch.PendingActions(), "local hello/session key mismatch queues no bytes");
         std::cout << "Avalanche bounded peer wire checks passed\n";
     } catch (const std::exception &e) { std::cerr << e.what() << '\n'; ECC_Stop(); return 1; }
     ECC_Stop(); return 0;
