From 7505c866f0bd07f7012589826d2c663296cb8849 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 13:30:20 -0700
Subject: [PATCH] build(v2): link authenticated wallet provider and independent
 tests

Build the proof-verifying adapter into the existing SQLite wallet library and register independent provider tests against the exact daemon dependencies. No node access or wallet keys are activated by building the target.
---
 src/wallet/CMakeLists.txt | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/wallet/CMakeLists.txt b/src/wallet/CMakeLists.txt
index f7ed447a7911160916fe45a422a703dea7b16f2a..fae91cc63d88d9e300eae6ef17b98186ed5baae0 100644
--- a/src/wallet/CMakeLists.txt
+++ b/src/wallet/CMakeLists.txt
@@ -38,6 +38,7 @@ add_library(wallet
 	transaction.cpp
 	v2_wallet.cpp
 	v2_payment.cpp
+	v2_node_provider.cpp
 	wallet.cpp
 	walletdb.cpp
 	walletutil.cpp
@@ -62,3 +63,10 @@ add_custom_target(check-lotus-v2-wallet
     DEPENDS test_lotus_v2_wallet)
 add_executable(lotus-v2-wallet-pilot v2_wallet_test/pilot.cpp ../lotus_v2/development_command.cpp)
 target_link_libraries(lotus-v2-wallet-pilot PRIVATE wallet common util univalue)
+
+# Provider context/proof checks use the same wallet library as the client.
+add_executable(test_lotus_v2_provider test/v2_provider_tests.cpp)
+target_link_libraries(test_lotus_v2_provider PRIVATE wallet common util univalue)
+add_custom_target(check-lotus-v2-provider
+    COMMAND $<TARGET_FILE:test_lotus_v2_provider>
+    DEPENDS test_lotus_v2_provider)
-- 
