     pub fn explorer_witness(
         &self,
         id: TxId,
-        input: u32,
+        input_index: u32,
         index: u32,
     ) -> Result<Option<WitnessFact>> {
-        self.inner
-            .get(witness_key(id, input, index))?
-            .map(|bytes| decode_record(&bytes))
-            .transpose()
+        let Some(input) = self.explorer_input(id, input_index)? else {
+            return Ok(None);
+        };
+        let Some(bytes) = self.inner.get(witness_key(id, input_index, index))? else {
+            return if index < input.witness_count {
+                Err(Error::Corrupt)
+            } else {
+                Ok(None)
+            };
+        };
+        if index >= input.witness_count {
+            return Err(Error::Corrupt);
+        }
+        let tx = self.explorer_tx(id)?.ok_or(Error::Corrupt)?;
+        let witness: WitnessFact = decode_record(&bytes)?;
+        validate_witness_fact(&witness, tx.wire_size)?;
+        let (siblings, count_bytes) =
+            self.explorer_table_count(id, tx.wire_size, witness.siblings_table)?;
+        let (arguments, _) =
+            self.explorer_table_count(id, tx.wire_size, witness.arguments_table)?;
+        if siblings != u64::from(witness.siblings_count)
+            || arguments != u64::from(witness.arguments_count)
+            || siblings
+                .checked_mul(32)
+                .and_then(|n| n.checked_add(count_bytes))
+                != Some(witness.siblings_table.length)
+        {
+            return Err(Error::Corrupt);
+        }
+        Ok(Some(witness))
+    }
+    // Read only the <=9 count bytes, from at most two fixed wire chunks. No
+    // arbitrary table allocation or second native transaction parser is needed.
+    fn explorer_table_count(
+        &self,
+        id: TxId,
+        wire_size: u64,
+        range: WireRange,
+    ) -> Result<(u64, u64)> {
+        range.validate(wire_size).map_err(|_| Error::Corrupt)?;
+        if range.length == 0 {
+            return Err(Error::Corrupt);
+        }
+        let needed = range.length.min(9) as usize;
+        let mut bytes = [0u8; 9];
+        let mut copied = 0usize;
+        while copied < needed {
+            let offset = range.offset + copied as u64;
+            let index =
+                u32::try_from(offset / WIRE_CHUNK_BYTES as u64).map_err(|_| Error::Corrupt)?;
+            let chunk = self.explorer_wire_chunk(id, index)?.ok_or(Error::Corrupt)?;
+            let chunk_start = u64::from(index) * WIRE_CHUNK_BYTES as u64;
+            let expected = (wire_size - chunk_start).min(WIRE_CHUNK_BYTES as u64) as usize;
+            if chunk.len() != expected {
+                return Err(Error::Corrupt);
+            }
+            let local = (offset - chunk_start) as usize;
+            let take = (needed - copied).min(expected - local);
+            if take == 0 {
+                return Err(Error::Corrupt);
+            }
+            bytes[copied..copied + take].copy_from_slice(&chunk[local..local + take]);
+            copied += take;
+        }
+        let (value, width) = match bytes[0] {
+            0..=252 => (u64::from(bytes[0]), 1),
+            253 if needed >= 3 => (
+                u64::from(u16::from_le_bytes(bytes[1..3].try_into().unwrap())),
+                3,
+            ),
+            254 if needed >= 5 => (
+                u64::from(u32::from_le_bytes(bytes[1..5].try_into().unwrap())),
+                5,
+            ),
+            255 if needed >= 9 => (u64::from_le_bytes(bytes[1..9].try_into().unwrap()), 9),
+            _ => return Err(Error::Corrupt),
+        };
+        if (width == 3 && value < 253)
+            || (width == 5 && value <= u16::MAX as u64)
+            || (width == 9 && value <= u32::MAX as u64)
+        {
+            return Err(Error::Corrupt);
+        }
+        Ok((value, width))
     }
     pub fn explorer_wire_chunk(&self, id: TxId, index: u32) -> Result<Option<Vec<u8>>> {
         let bytes = self.inner.get(wire_key(id, index))?;
