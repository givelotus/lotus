     pub fn explorer_input(&self, id: TxId, index: u32) -> Result<Option<InputMeta>> {
-        self.inner
-            .get(input_key(id, index))?
-            .map(|bytes| decode_record(&bytes))
-            .transpose()
+        let Some(tx) = self.explorer_tx(id)? else {
