From 93c9fa3a3e59836f84bed267bd74915574870aad Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:10:48 -0700
Subject: [PATCH] Preserve complete block error API for invalid tail anchors

Maintenance explanation added during mailbox export:
Translate invalid absolute tail anchors into the complete block validator error API and cover the failure with a native regression. Callers receive the expected validation result rather than an escaping monetary exception.

---
 src/lotus_v2/block.cpp               |  9 +++++++--
 src/lotus_v2/test_block_complete.cpp | 15 +++++++++++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/block.cpp b/src/lotus_v2/block.cpp
index 8aaa585afaa64b4531c95e2d9871e6796bb050f1..86b39522cd4f090b9f02f1e6bc0707e14b81f3c8 100644
--- a/src/lotus_v2/block.cpp
+++ b/src/lotus_v2/block.cpp
@@ -605,8 +605,13 @@ bool ConnectCompleteBlock(const std::vector<uint8_t> &wire,
         error = "parent monetary work does not match target";
         return false;
     }
-    if (parent.monetary.tail_subsidy != AbsoluteTail(monetary_profile, parent_work)) {
-        error = "parent cached tail mismatch";
+    try {
+        if (parent.monetary.tail_subsidy != AbsoluteTail(monetary_profile, parent_work)) {
+            error = "parent cached tail mismatch";
+            return false;
+        }
+    } catch (const std::invalid_argument &failure) {
+        error = failure.what();
         return false;
     }
     // Derive work from accepted candidate bits; P06 reward is parent-work
diff --git a/src/lotus_v2/test_block_complete.cpp b/src/lotus_v2/test_block_complete.cpp
index 4483c1474414b80eec8931c251a7203056ce25d8..ea239ce7010da8ad93aae66beeafea6ef9a8ab79 100644
--- a/src/lotus_v2/test_block_complete.cpp
+++ b/src/lotus_v2/test_block_complete.cpp
@@ -731,6 +731,21 @@ void CompleteChecks() {
 #endif
     const auto before_root = utxo.Root();
     const auto before_money = EncodeMonetaryState(money);
+    // Invalid absolute anchors are reported through the bool/error API and
+    // must preserve both caller state and the output record.
+    auto invalid_anchor = DevelopmentGenesis;
+    invalid_anchor.genesis_work = {};
+    OrdinaryBlockConnected anchor_rejected;
+    anchor_rejected.state_root[0] = 123;
+    Check(!ConnectCompleteBlock(wire, parent, {parent.header, genesis}, hp,
+                                profile, invalid_anchor, COST, view, utxo,
+                                money, anchor_rejected, error) &&
+              error == "zero genesis work anchor",
+          "invalid anchor returns failure without throwing");
+    Check(utxo.Root() == before_root &&
+              EncodeMonetaryState(money) == before_money && view.size() == 1 &&
+              anchor_rejected.state_root[0] == 123,
+          "invalid anchor preserves caller state and output");
     // Invalid PoW wins over malformed transaction bytes: no body hashing/VM
     // or state copying happens before the cheap contextual header gate.
     Header bad_pow = child;
-- 
