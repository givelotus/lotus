+BOOST_AUTO_TEST_CASE(SnapshotSchedulerOnDevelopmentChain) {
+    // The inherited mining fixture cannot connect its historical blocks until
+    // V2 has its own genesis. Exercise template selection without that chain.
+    LOCK2(cs_main, m_node.mempool->cs);
+    m_node.mempool->clear(/*include_finalized_txs=*/true);
+    TestMemPoolEntryHelper entry;
+
+    CMutableTransaction parent;
+    parent.vin.resize(1);
+    parent.vin[0].prevout = COutPoint(TxId{}, 1);
+    parent.vin[0].scriptSig = CScript() << OP_1;
+    parent.vout.emplace_back(1000000 * SATOSHI, CScript() << OP_TRUE);
+    parent.vout.emplace_back(1000000 * SATOSHI, CScript() << OP_TRUE);
+    parent.vout.emplace_back(Amount::zero(),
+                             CScript() << OP_RETURN << std::vector<uint8_t>(8000));
+    const auto parentRef = MakeTransactionRef(parent);
+    AddUnchecked(entry.Fee(20000 * SATOSHI).FromTx(parentRef));
+
+    CMutableTransaction freeChild;
+    freeChild.vin.resize(1);
+    freeChild.vin[0].prevout = COutPoint(parentRef->GetId(), 0);
+    freeChild.vin[0].scriptSig = CScript() << OP_1;
+    freeChild.vout.emplace_back(parentRef->vout[0].nValue,
+                                CScript() << OP_TRUE);
+    freeChild.vout.emplace_back(Amount::zero(),
+                                CScript() << OP_RETURN << std::vector<uint8_t>(80));
+    const auto freeRef = MakeTransactionRef(freeChild);
+    AddUnchecked(entry.Fee(Amount::zero()).FromTx(freeRef));
+
+    CMutableTransaction paidChild = freeChild;
+    paidChild.vin[0].prevout = COutPoint(parentRef->GetId(), 1);
+    paidChild.vout[0].nValue -= 10000 * SATOSHI;
+    paidChild.vout[1].scriptPubKey =
+        CScript() << OP_RETURN << std::vector<uint8_t>(8000);
+    const auto paidRef = MakeTransactionRef(paidChild);
+    AddUnchecked(entry.Fee(10000 * SATOSHI).FromTx(paidRef));
+    CMutableTransaction freeGrandchild = freeChild;
+    freeGrandchild.vin[0].prevout = COutPoint(freeRef->GetId(), 0);
+    freeGrandchild.vout[0].nValue -= 50000 * SATOSHI;
+    const auto grandchildRef = MakeTransactionRef(freeGrandchild);
+    AddUnchecked(entry.Fee(50000 * SATOSHI).FromTx(grandchildRef));
+    BOOST_REQUIRE_EQUAL(m_node.mempool->size(), 4U);
+    const auto paidIt = m_node.mempool->GetIter(paidRef->GetId());
+    const auto grandchildIt = m_node.mempool->GetIter(grandchildRef->GetId());
+    BOOST_REQUIRE(paidIt);
+    BOOST_REQUIRE(grandchildIt);
+    BOOST_REQUIRE_EQUAL((**paidIt)->GetMemPoolParentsConst().size(), 1U);
+    BOOST_REQUIRE_EQUAL((**grandchildIt)->GetMemPoolParentsConst().size(), 1U);
+    TxValidationState parentState;
+    BOOST_CHECK_MESSAGE(ContextualCheckTransaction(
+                            m_node.chainman->GetConsensus(), *parentRef,
+                            parentState, m_node.chainman->ActiveTip()->nHeight + 1,
+                            m_node.chainman->ActiveTip()->GetMedianTimePast()),
+                        parentState.ToString());
+
+    BlockFitter::Options limits;
+    limits.blockMinFeeRate = blockMinFeeRate;
+    limits.nMaxGeneratedBlockSize = BlockFitter::COINBASE_RESERVED_SIZE +
+        ::GetSerializeSize(*parentRef) + ::GetSerializeSize(*paidRef) + 1;
+    BlockAssembler::Options options;
+    options.test_block_validity = false;
+    options.add_finalized_txs = false;
+    BlockFitter::Options roomyLimits;
+    roomyLimits.blockMinFeeRate = blockMinFeeRate;
+    const auto roomy = BlockAssembler{
+        BlockFitter(roomyLimits), m_node.chainman->ActiveChainstate(),
+        m_node.mempool.get(), options}
+                           .CreateNewBlock(CScript() << OP_TRUE);
+    BOOST_CHECK(std::none_of(roomy->block.vtx.begin(), roomy->block.vtx.end(),
+                             [&](const auto &tx) {
+                                 return tx->GetId() == freeRef->GetId() ||
+                                        tx->GetId() == grandchildRef->GetId();
+                             }));
+    BlockAssembler assembler{BlockFitter(limits),
+                             m_node.chainman->ActiveChainstate(),
+                             m_node.mempool.get(), options};
+    const auto result = assembler.CreateNewBlock(CScript() << OP_TRUE);
+    BOOST_REQUIRE_EQUAL(result->block.vtx.size(), 3U);
+    BOOST_CHECK(std::any_of(result->block.vtx.begin(), result->block.vtx.end(),
+                            [&](const auto &tx) {
+                                return tx->GetId() == parentRef->GetId();
+                            }));
+    BOOST_CHECK(std::any_of(result->block.vtx.begin(), result->block.vtx.end(),
+                            [&](const auto &tx) {
+                                return tx->GetId() == paidRef->GetId();
+                            }));
+    BOOST_CHECK(std::none_of(result->block.vtx.begin(), result->block.vtx.end(),
+                             [&](const auto &tx) {
+                                 return tx->GetId() == freeRef->GetId();
+                             }));
+}
