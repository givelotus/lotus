 namespace lotus::v2 {
 
+class PersistentUtxoStore;
+
 // Parent header plus the monetary record committed at that header. The child
 // block header, PoW, and coinbase transaction are not represented.
 struct OrdinaryParentContext {
@@ -53,6 +55,14 @@ struct OrdinaryBlockConnected {
 // they were. profile.candidate_height must be parent.header.height+1 and
 // profile.parent_mtp must be parent.header.time. The parent state_root must
 // already commit the supplied UTXO root and monetary record.
+//
+// store, when not null, commits each applied transaction on its own after
+// the in-memory view and incremental set accept it. One Commit cannot spend
+// a coin created inside that same Commit. A transaction that erases nothing
+// and creates nothing is not committed, because Commit rejects an empty
+// batch. Rejection undoes those commits newest first, then restores the
+// in-memory parent. Monetary bytes are not written to the store. A null
+// store leaves the in-memory behavior unchanged. This does not accept a block.
 bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
                           const OrdinaryParentContext &parent,
                           const OrdinaryCandidateProfile &profile,
@@ -60,7 +70,8 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
