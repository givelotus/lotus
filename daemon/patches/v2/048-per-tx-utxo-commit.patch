diff --git a/src/lotus_v2/test_block_store.cpp b/src/lotus_v2/test_block_store.cpp
new file mode 100644
index 000000000..0483b77f7
--- /dev/null
+++ b/src/lotus_v2/test_block_store.cpp
@@ -0,0 +1,399 @@
+// Copyright (c) 2026 The Lotus developers
+// Per-transaction UTXO commits during ordinary connect. Not lotusd ConnectTip
+// and not a claim that a block was accepted.
+#include "block.h"
+
+#include "persistent_utxo.h"
+#include "signing.h"
+
+#include <cstdint>
+#include <filesystem>
+#include <iostream>
+#include <limits.h>
+#include <stdexcept>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+const std::vector<uint8_t> PUSH_ZERO{0x00};
+const MonetaryProfile kMonetary{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000};
+
+OrdinaryCandidateProfile MakeProfile(VmCostUnits block_cap) {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, 100, 50000, 2, 3, block_cap};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+Hash Chain() {
+    Hash chain{};
+    for (size_t i = 0; i < chain.size(); ++i)
+        chain[i] = static_cast<uint8_t>(i);
+    return chain;
+}
+
+MonetaryState InitialMoney() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Coin MakeFunding(uint8_t tag, uint32_t index, uint64_t value, const Hash &branch) {
+    Coin coin;
+    coin.outpoint.tx_id[0] = tag;
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = value;
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = 90;
+    coin.creation_parent_mtp = 49000;
+    coin.coinbase = false;
+    return coin;
+}
+
+Transaction Payment(const Outpoint &spent, uint64_t value,
+                    const std::vector<uint8_t> &witness = TRUE_SCRIPT) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{witness, {}, {}}};
+    tx.inputs.push_back(input);
+    Output output;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    tx.outputs.push_back(output);
+    return tx;
+}
+
+struct World {
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary = InitialMoney();
+    OrdinaryParentContext parent;
+    Hash branch = BranchLeaf(TRUE_SCRIPT);
+    Coin funding;
+    Coin other;
+    World()
+        : funding(MakeFunding(0x71, 3, 20000, branch)),
+          other(MakeFunding(0x72, 1, 8000, branch)) {
+        Check(view.emplace(funding.outpoint, funding).second &&
+                  view.emplace(other.outpoint, other).second &&
+                  utxo.Insert(funding) && utxo.Insert(other),
+              "parent coins");
+        parent.chain_id = Chain();
+        parent.monetary = monetary;
+        parent.header.height = 99;
+        parent.header.time = 50000;
+        parent.header.version = 1;
+        parent.header.size = HEADER_SIZE;
+        parent.header.state_root = StateRoot(
+            parent.chain_id, parent.header.height, utxo.Root(), monetary);
+    }
+};
+
+struct ParentBytes {
+    std::vector<std::vector<uint8_t>> coins;
+    Hash utxo{};
+    std::array<uint8_t, 56> monetary{};
+};
+
+ParentBytes Capture(const World &world) {
+    ParentBytes snap;
+    for (const auto &entry : world.view) {
+        Check(entry.first == entry.second.outpoint, "view outpoint");
+        std::vector<uint8_t> encoded;
+        Check(EncodeCoin(entry.second, encoded), "encode parent coin");
+        snap.coins.push_back(std::move(encoded));
+    }
+    snap.utxo = world.utxo.Root();
+    snap.monetary = EncodeMonetaryState(world.monetary);
+    return snap;
+}
+
+void ExpectParent(const World &world, const ParentBytes &parent,
+                  const std::string &where) {
+    const ParentBytes now = Capture(world);
+    Check(now.coins == parent.coins, where + " view is not the parent coins");
+    Check(now.utxo == parent.utxo, where + " utxo root moved");
+    Check(now.monetary == parent.monetary, where + " monetary bytes moved");
+}
+
+std::string TempDir() {
+    char templ[] = "/tmp/lotus-v2-block-store-XXXXXX";
+    Check(::mkdtemp(templ) != nullptr, "mkdtemp");
+    const std::string path(templ);
+    Check(path.rfind("/tmp/", 0) == 0, "temporary directory is under /tmp");
+    Check(path.find("..") == std::string::npos, "temporary path has no parent segment");
+    Check(path.find(".lotus") == std::string::npos &&
+              path.find("datadir") == std::string::npos,
+          "temporary path is not a datadir");
+    char resolved[PATH_MAX];
+    Check(::realpath(path.c_str(), resolved) != nullptr, "realpath");
+    const std::string absolute(resolved);
+    Check(absolute.rfind("/tmp/", 0) == 0 ||
+              absolute.rfind("/private/tmp/", 0) == 0,
+          "resolved temporary directory stays under /tmp");
+    return absolute;
+}
+
+Hash StoreRoot(const PersistentUtxoStore &store) {
+    Hash root{};
+    Check(store.Root(root), "store root");
+    return root;
+}
+
+void SeedParent(PersistentUtxoStore &store, const World &world) {
+    std::vector<Coin> coins;
+    coins.reserve(world.view.size());
+    for (const auto &entry : world.view) coins.push_back(entry.second);
+    std::string error;
+    Check(store.Commit({}, coins, error), "seed parent coins: " + error);
+    Check(StoreRoot(store) == world.utxo.Root(),
+          "seeded store root differs from the parent incremental root");
+}
+
+size_t UndoFiles(const std::filesystem::path &directory) {
+    size_t count = 0;
+    const std::filesystem::path undo = directory / "undo";
+    if (!std::filesystem::exists(undo)) return 0;
+    for (const auto &entry : std::filesystem::directory_iterator(undo)) {
+        if (entry.path().extension() == ".dat") ++count;
+    }
+    return count;
+}
+
+Hash ReopenedRoot(const std::filesystem::path &directory) {
+    PersistentUtxoStore store;
+    std::string error;
+    Check(PersistentUtxoStore::Open(directory.string(), store, error),
+          "reopen store: " + error);
+    return StoreRoot(store);
+}
+
+struct Built {
+    Transaction first;
+    Transaction second;
+    OrdinaryCandidateProfile profile;
+};
+
+Outpoint FirstOut(const Built &built, const World &world) {
+    IdentityDigests ids;
+    std::string error;
+    Check(ComputeIdentities(built.first, built.profile.transaction,
+                            world.parent.chain_id, ids, error),
+          "first outpoint");
+    return Outpoint{ids.txid, 0};
+}
+
+Built BuildPayments(World &world) {
+    Built built;
+    built.first = Payment(world.funding.outpoint, 15000);
+    const OrdinaryCandidateProfile wide = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(built.first, wide, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure first payment: " + error);
+    Check(effects.invocation_cost == 18 && effects.native_fee == 5000,
+          "unexpected first payment cost or fee");
+    built.profile = MakeProfile(effects.invocation_cost * 2);
+    IdentityDigests first_id;
+    Check(ComputeIdentities(built.first, built.profile.transaction,
+                            world.parent.chain_id, first_id, error),
+          "first identity");
+    built.second = Payment(Outpoint{first_id.txid, 0}, 10000);
+    return built;
+}
+
+void DependentPaymentsMatchReopenedRoot() {
+    World world;
+    const Hash parent_root = world.utxo.Root();
+    Built built = BuildPayments(world);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path store_dir = directory / "store";
+    Hash connected_root{};
+    {
+        PersistentUtxoStore store;
+        std::string error;
+        Check(PersistentUtxoStore::Open(store_dir.string(), store, error),
+              "open store: " + error);
+        SeedParent(store, world);
+        OrdinaryBlockConnected connected;
+        Check(ConnectOrdinaryBlock({built.first, built.second}, world.parent,
+                                   built.profile, kMonetary, world.view,
+                                   world.utxo, world.monetary, connected, error,
+                                   &store),
+              "connect two dependent payments: " + error);
+        Check(connected.utxo_root == world.utxo.Root(),
+              "connected root is not the in-memory incremental root");
+        Check(connected.utxo_root != parent_root, "dependent payments did not move the root");
+        Check(StoreRoot(store) == connected.utxo_root,
+              "live store root differs from the connected incremental root");
+        Check(UndoFiles(store_dir) == 3, "seed plus one commit per transaction");
+        Check(std::filesystem::exists(store_dir / "snapshot.dat"),
+              "snapshot.dat is the store record");
+        connected_root = connected.utxo_root;
+        IdentityDigests second_id;
+        Check(ComputeIdentities(built.second, built.profile.transaction,
+                                world.parent.chain_id, second_id, error),
+              "second identity");
+        Check(world.view.count(world.funding.outpoint) == 0 &&
+                  world.view.count(FirstOut(built, world)) == 0 &&
+                  world.view.count(Outpoint{second_id.txid, 0}) == 1 &&
+                  world.view.count(world.other.outpoint) == 1,
+              "in-memory view after the dependent payments");
+    }
+    Check(ReopenedRoot(store_dir) == connected_root,
+          "reopened store root differs from the connected incremental root byte for byte");
+    std::filesystem::remove_all(directory);
+}
+
+void OverCapRestoresParentStore() {
+    World world;
+    const ParentBytes parent = Capture(world);
+    Built built = BuildPayments(world);
+    std::string error;
+    IdentityDigests second_id;
+    Check(ComputeIdentities(built.second, built.profile.transaction,
+                            world.parent.chain_id, second_id, error),
+          "over-cap second identity");
+    const Transaction third = Payment(Outpoint{second_id.txid, 0}, 5000);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path store_dir = directory / "store";
+    {
+        PersistentUtxoStore store;
+        Check(PersistentUtxoStore::Open(store_dir.string(), store, error),
+              "open over-cap store: " + error);
+        SeedParent(store, world);
+        OrdinaryBlockConnected discarded;
+        Check(!ConnectOrdinaryBlock(
+                  {built.first, built.second, third}, world.parent,
+                  built.profile, kMonetary, world.view, world.utxo,
+                  world.monetary, discarded, error, &store),
+              "over-cap block was accepted");
+        Check(error == "block invocation cost over cap",
+              "over-cap rejection: " + error);
+        Check(StoreRoot(store) == parent.utxo,
+              "over-cap left the live store past the parent root");
+        Check(UndoFiles(store_dir) == 1, "over-cap did not undo its commits");
+    }
+    ExpectParent(world, parent, "over-cap");
+    Check(ReopenedRoot(store_dir) == parent.utxo,
+          "reopened over-cap root differs from the parent root byte for byte");
+    std::filesystem::remove_all(directory);
+}
+
+void PushZeroSecondRestoresParent() {
+    World world;
+    const ParentBytes parent = Capture(world);
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    Transaction first = Payment(world.funding.outpoint, 15000);
+    first.outputs[0].branches = {BranchLeaf(PUSH_ZERO)};
+    std::string error;
+    IdentityDigests first_id;
+    Check(ComputeIdentities(first, profile.transaction, world.parent.chain_id,
+                            first_id, error),
+          "push-zero first identity");
+    Transaction second =
+        Payment(Outpoint{first_id.txid, 0}, 10000, PUSH_ZERO);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path store_dir = directory / "store";
+    {
+        PersistentUtxoStore store;
+        Check(PersistentUtxoStore::Open(store_dir.string(), store, error),
+              "open failure store: " + error);
+        SeedParent(store, world);
+        OrdinaryBlockConnected discarded;
+        Check(!ConnectOrdinaryBlock({first, second}, world.parent, profile,
+                                    kMonetary, world.view, world.utxo,
+                                    world.monetary, discarded, error, &store),
+              "push-zero second payment was accepted");
+        Check(error == "witness VM invalid/unsupported: unclean final stack",
+              "push-zero rejection: " + error);
+        Check(StoreRoot(store) == parent.utxo,
+              "failed connect left the live store past the parent root");
+        Check(UndoFiles(store_dir) == 1,
+              "failed connect did not undo the first payment's commit");
+    }
+    ExpectParent(world, parent, "push-zero");
+    Check(world.view.count(Outpoint{first_id.txid, 0}) == 0,
+          "first payment's created coin remained in the view");
+    Check(ReopenedRoot(store_dir) == parent.utxo,
+          "reopened store root differs from the parent root byte for byte");
+    std::filesystem::remove_all(directory);
+}
+
+// A spend whose only output is a burn creates nothing. Commit must still
+// record the erasure; skipping every empty create list would drop the coin.
+void BurnErasureStillCommits() {
+    World world;
+    const Hash parent_root = world.utxo.Root();
+    Transaction burn = Payment(world.other.outpoint, 7000);
+    burn.outputs[0].flags = 2;
+    burn.outputs[0].paths.clear();
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path store_dir = directory / "store";
+    Hash connected_root{};
+    {
+        PersistentUtxoStore store;
+        std::string error;
+        Check(PersistentUtxoStore::Open(store_dir.string(), store, error),
+              "open burn store: " + error);
+        SeedParent(store, world);
+        OrdinaryBlockConnected connected;
+        Check(ConnectOrdinaryBlock({burn}, world.parent, profile, kMonetary,
+                                   world.view, world.utxo, world.monetary,
+                                   connected, error, &store),
+              "burn-only spend: " + error);
+        Check(world.view.count(world.other.outpoint) == 0 &&
+                  world.view.count(world.funding.outpoint) == 1 &&
+                  world.view.size() == 1,
+              "burn-only spend left a created coin or kept the spent coin");
+        Check(connected.utxo_root == world.utxo.Root() &&
+                  connected.utxo_root != parent_root,
+              "burn-only spend did not move the incremental root");
+        Check(UndoFiles(store_dir) == 2, "burn erasure was not committed");
+        connected_root = connected.utxo_root;
+    }
+    Check(ReopenedRoot(store_dir) == connected_root,
+          "reopened burn root differs from the incremental root byte for byte");
+    std::filesystem::remove_all(directory);
+}
+} // namespace
+
+int main() {
+    try {
+        DependentPaymentsMatchReopenedRoot();
+        OverCapRestoresParentStore();
+        PushZeroSecondRestoresParent();
+        BurnErasureStillCommits();
+        std::cout << "ordinary block store commit/undo checks passed\n";
+        return 0;
+    } catch (const std::exception &failure) {
+        std::cerr << failure.what() << '\n';
+        return 1;
+    }
+}
