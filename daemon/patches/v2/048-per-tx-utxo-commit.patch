 src/lotus_v2/block.h                   |  13 +-
 src/lotus_v2/block_test/CMakeLists.txt |  29 +-
 src/lotus_v2/test_block_store.cpp      | 399 +++++++++++++++++++++++++
 4 files changed, 463 insertions(+), 10 deletions(-)
