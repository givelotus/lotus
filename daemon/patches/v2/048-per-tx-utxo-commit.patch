 #include <limits>
 #include <stdexcept>
 #include <utility>
@@ -169,7 +171,7 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
                           DevelopmentUtxoView &view, IncrementalUtxoSet &utxo,
                           MonetaryState &monetary,
                           OrdinaryBlockConnected &connected,
-                          std::string &error) {
+                          std::string &error, PersistentUtxoStore *store) {
     if (parent.header.height == std::numeric_limits<uint64_t>::max() ||
         profile.candidate_height != parent.header.height + 1 ||
         profile.parent_mtp != parent.header.time ||
@@ -192,7 +194,22 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
     undo.prior_monetary = monetary;
     undo.prior_utxo_root = utxo.Root();
     undo.prior_monetary_bytes = EncodeMonetaryState(monetary);
+    // Commits made by this attempt only. A failed Undo stops the store
+    // rollback; the in-memory parent is still restored below.
+    size_t store_commits = 0;
+    auto undo_store = [&](std::string &why) {
+        while (store != nullptr && store_commits > 0) {
+            std::string store_error;
+            if (!store->Undo(store_error)) {
+                why += "; store undo failed: ";
+                why += store_error;
+                break;
+            }
+            --store_commits;
+        }
+    };
     auto rollback = [&](std::string &why) {
+        undo_store(why);
         std::string undo_error;
         if (!DisconnectOrdinaryBlock(undo, view, utxo, monetary, undo_error)) {
             why += "; undo failed: ";
@@ -252,6 +269,18 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
             undo.steps.push_back(OrdinaryUndoStep{false, coin});
         for (const Coin &coin : effects.created)
             undo.steps.push_back(OrdinaryUndoStep{true, coin});
+        // Commit this transaction alone so a later one can spend its coins.
+        // Skip an empty batch; Commit would reject it and fail a valid block.
+        if (store != nullptr &&
+            (!effects.consumed.empty() || !effects.created.empty())) {
+            std::string store_error;
+            if (!store->Commit(effects.consumed, effects.created, store_error)) {
+                error = std::move(store_error);
+                rollback(error);
+                return false;
+            }
+            ++store_commits;
+        }
         if (effects.invocation_cost > ~VmCostUnits(0) - invocation_cost) {
             error = "block invocation cost overflow";
             rollback(error);
@@ -295,6 +324,7 @@ bool ConnectOrdinaryBlock(const std::vector<Transaction> &transactions,
     staged.undo = std::move(undo);
     staged.invocation_cost = invocation_cost;
     if (!ViewAgrees(view, utxo, error)) {
+        undo_store(error);
         std::string ignored;
         DisconnectOrdinaryBlock(staged.undo, view, utxo, monetary, ignored);
         return false;
