+BOOST_AUTO_TEST_CASE(wire_chunks_reconstruct_only_with_pinned_snapshot) {
+    Fixture f;
+    const Router app = f.MakeRouter();
+    const std::string path = "/transactions/by-id/" + HexFill(4) + "/wire";
+    const JsonNode first = Value(Get(app, path));
