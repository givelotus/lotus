+uint64_t ReadLe(const HeaderWire &w, size_t from, size_t to) {
+    uint64_t v = 0;
+    for (size_t i = from; i < to; ++i) {
+        v |= uint64_t(w[i]) << (8 * (i - from));
+    }
+    return v;
+}
