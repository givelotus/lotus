+
+/** hex::encode (lowercase). */
+std::string Hex(const uint8_t *data, size_t len);
+template <typename C> std::string Hex(const C &c) {
+    return Hex(reinterpret_cast<const uint8_t *>(c.data()), c.size());
+}
