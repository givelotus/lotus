+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_PEER_H
+#define LOTUS_V2_AVALANCHE_PEER_H
+#include "avalanche_poll.h"
+#include "peer_dispatcher.h"
+#include <deque>
+#include <map>
+#include <set>
+namespace lotus::v2::ava {
+struct PeerLimits {
+    uint32_t max_peers{64}, max_payload{256000}, max_stakes{1000}, max_payout_script{10000};
+    uint32_t max_elements{1024}, max_proofs{64}, max_actions{128};
+    uint64_t max_action_bytes{16 * 1024 * 1024}, discovery_interval_ms{60000}, request_timeout_ms{10000}, proof_request_interval_ms{100}, poll_cooldown_ms{AVALANCHE_DEFAULT_COOLDOWN};
+};
+// V2 avaproof extends the exact pinned ABC proof bytes with CompactSize lock
+// count and CompactSize byte vectors. These bindings are mandatory, ordered
+// with stakes, and never inferred from an upstream proof or dropped on relay.
+bool EncodeProofEnvelope(const ProofEnvelope &, const PeerLimits &, peer::Bytes &, std::string &);
+bool DecodeProofEnvelope(std::span<const uint8_t>, const PeerLimits &, ProofEnvelope &, std::string &);
+struct PeerCallbacks {
+    CPubKey local_session_key;
+    std::function<bool(const ProofEnvelope &, std::string &)> register_proof;
+    std::function<bool(NodeId, const ::avalanche::Delegation &, const SchnorrSig &,
+                       const ConnectionTranscript &, uint32_t, std::string &)> bind;
+    std::function<void(NodeId)> disconnect;
+    std::function<void(NodeId)> sent_proof_inventory;
+    std::function<bool(const OutgoingPoll &, SignedResponse &, std::string &)> respond;
+    std::function<bool(NodeId, const SignedResponse &, std::string &)> receive;
+    std::function<std::optional<ProofEnvelope>(const ::avalanche::ProofId &)> proof;
+    std::function<std::vector<::avalanche::ProofId>()> proofs;
+    std::function<bool(uint64_t &, uint64_t &)> discovery_keys;
+    // Root retains the secret; callback must sign this actual connection digest.
+    std::function<bool(const uint256 &, SchnorrSig &)> sign_hello;
+};
+enum class PeerResult { Accepted, Backpressure, Rejected, LocalFailure, UnknownPeer };
+// Single owner; use the existing dispatcher's Application notices. The caller
+// retains a notice on Backpressure. All outbound actions stay charged until
+// SendApplication returns Queued. Pump must run independently of stdout.
+// No callback may reenter this object. Disconnect clears volatile peer state.
+class AvalanchePeer {
+public:
+    AvalanchePeer(peer::PeerDispatcher &, PeerLimits, PeerCallbacks);
+    PeerResult Activate(peer::ConnectionId, std::string &);
+    PeerResult Hello(peer::ConnectionId, const ::avalanche::Delegation &, std::string &);
+    PeerResult Handle(const peer::DispatcherNotice &, uint64_t now_ms, std::string &);
+    PeerResult Poll(const OutgoingPoll &, std::string &);
+    PeerResult Discover(peer::ConnectionId, uint64_t now_ms, std::string &);
+    void Tick(uint64_t now_ms);
+    peer::DispatcherResult Pump(uint64_t now_ms);
+    void Disconnect(peer::ConnectionId);
+    std::optional<NodeId> Node(peer::ConnectionId) const;
+    size_t PendingActions() const { return actions_.size(); }
+    uint64_t PendingBytes() const { return action_bytes_; }
+private:
+    struct State {
+        NodeId node{};
+        std::optional<AuthenticatedHello> authenticated;
+        std::optional<::avalanche::Delegation> delegation;
+        SchnorrSig hello_signature{};
+        ConnectionTranscript incoming;
+        std::map<::avalanche::ProofId, uint64_t> requested;
+        std::vector<::avalanche::ProofId> advertised;
+        uint32_t hello_elements{}, discovery_expected{};
+        bool discovery_outstanding{};
+        uint64_t discovery_deadline{}, next_discovery{}, next_proof_request{}, next_poll{};
+        std::set<::avalanche::ProofId> discovery_received;
+        uint64_t discovery_k0{}, discovery_k1{};
+        std::vector<uint64_t> discovery_shortids;
+    };
+    struct Action { peer::ConnectionId connection; peer::Message message; };
+    bool Room(uint32_t count, uint64_t bytes) const;
+    bool Queue(peer::ConnectionId, peer::Message, std::string &);
+    peer::PeerDispatcher &dispatcher_;
+    PeerLimits limits_;
+    PeerCallbacks callbacks_;
+    std::map<peer::ConnectionId, State> peers_;
+    std::deque<Action> actions_;
+    uint64_t action_bytes_{};
+    NodeId next_node_{};
+};
+}
+#endif
