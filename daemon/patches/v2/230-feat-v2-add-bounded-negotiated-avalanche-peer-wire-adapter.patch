+}
+// Memory endpoints exercise real framing, Session and Transport while bounding
+// stream capacity and each short Read/Write. They implement no chain decisions.
+struct Pipe {
+    std::deque<uint8_t> bytes;
+    size_t capacity = 1 << 20;
+    bool closed = false;
+};
+class MemoryStream final : public ByteStream {
+public:
+    Pipe &in, &out;
+    size_t fragment = 31, write_allowance = SIZE_MAX;
+    bool block_write = false;
+    unsigned closes = 0;
+    MemoryStream(Pipe &i, Pipe &o) : in(i), out(o) {}
+    StreamResult Read(std::span<uint8_t> dst) override {
+        if (in.bytes.empty())
+            return {in.closed ? StreamStatus::Eof : StreamStatus::WouldBlock};
+        const auto n = std::min({dst.size(), fragment, in.bytes.size()});
+        for (size_t k = 0; k < n; ++k) {
+            dst[k] = in.bytes.front();
+            in.bytes.pop_front();
+        }
+        return {StreamStatus::Progress, n};
+    }
+    StreamResult Write(std::span<const uint8_t> src) override {
+        if (out.closed) return {StreamStatus::Error};
+        if (block_write || !write_allowance || out.bytes.size() == out.capacity)
+            return {StreamStatus::WouldBlock};
+        const auto n =
+            std::min({src.size(), fragment, out.capacity - out.bytes.size(),
+                      write_allowance});
+        out.bytes.insert(out.bytes.end(), src.begin(), src.begin() + n);
+        write_allowance -= n;
+        return {StreamStatus::Progress, n};
+    }
+    void Close() noexcept override {
+        ++closes;
+        out.closed = true;
+    }
+};
+NetworkProfile Network(DevelopmentRuntime &r,
+                       uint32_t reconstruction_limit = 64) {
+    NetworkProfile p{};
+    const auto c = runtime_fixture::Profiles();
+    p.magic = {0x31, 0x43, 0x57,
+               0x69}; // explicit fixture bytes, no network allocation
+    p.chain_id = c.header.chain_id;
+    p.genesis_id = c.header.genesis_id;
+    const auto snapshot = r.Snapshot();
+    Check(bool(snapshot.chain), "runtime has authoritative profile");
+    p.profile_digest = snapshot.chain->profile_digest;
+    p.receive_limit = 4096;
+    p.transaction = c.ordinary.transaction;
+    p.max_reconstruction_transactions = reconstruction_limit;
+    p.max_reconstruction_bytes = 1 << 20;
+    return p;
+}
+SessionConfig SessionSettings(const NetworkProfile &p, uint64_t nonce, bool relay = true) {
+    SessionConfig c{};
+    c.network = p;
+    if (relay) c.supported_features |= TRANSACTION_RELAY_FEATURE;
+    c.supported_features |= AVALANCHE_FEATURE;
+    c.required_features |= AVALANCHE_FEATURE;
+    c.handshake_timeout_ms = 1000;
+    c.local_version.sender = VersionSender{VersionAddress{}, nonce};
+    c.local_version.user_agent = {'t', 'e', 's', 't'};
+    c.local_version.starting_height = 0;
+    c.local_version.relay = true;
+    c.local_version.extra_entropy = nonce + 1;
+    return c;
+}
+TransportLimits TransportSettings() {
+    return {4096, 2 << 20, 32, 1000, 1000};
+}
+TransportBudget TransportStep() {
+    return {100, 65536, 65536};
+}
