+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_peer.h"
+#include "avalanche_peer_test/fixtures.h"
+#include <avalanche/proofbuilder.h>
+#include <avalanche/delegationbuilder.h>
+#include <streams.h>
+using namespace lotus::v2::ava;
+namespace {
+PeerCallbacks Callbacks(CKey &key, ProofEnvelope &proof, unsigned &registered, unsigned &bound, unsigned &received) {
+    PeerCallbacks c;
+    c.local_session_key = key.GetPubKey();
+    c.register_proof = [&](const ProofEnvelope &p, std::string &) { ++registered; return p.payment_locks == proof.payment_locks; };
+    c.bind = [&](NodeId, const ::avalanche::Delegation &, const SchnorrSig &, const ConnectionTranscript &, uint32_t, std::string &) { ++bound; return true; };
+    c.disconnect = [](NodeId) {};
+    c.sent_proof_inventory = [](NodeId) {};
+    c.respond = [&](const OutgoingPoll &p, SignedResponse &r, std::string &) {
+        std::vector<::avalanche::Vote> votes;
+        for (const auto &i : p.items) { uint256 h; std::copy(i.id.begin(), i.id.end(), h.begin()); votes.emplace_back(0, h); }
+        r.response = ::avalanche::Response{p.round, 0, std::move(votes)};
+        return key.SignSchnorr(ResponseDigest(r.response), r.signature);
+    };
+    c.receive = [&](NodeId, const SignedResponse &, std::string &) { ++received; return true; };
+    c.proof = [&](const ::avalanche::ProofId &id) -> std::optional<ProofEnvelope> { return proof.proof->getId() == id ? std::optional(proof) : std::nullopt; };
+    c.proofs = [&] { return std::vector<::avalanche::ProofId>{proof.proof->getId()}; };
+    c.sign_hello = [&](const uint256 &h, SchnorrSig &s) { return key.SignSchnorr(h, s); };
+    c.discovery_keys = [](uint64_t &a, uint64_t &b) { a = 2; b = 3; return true; };
+    return c;
+}
+void Deliver(Node &node, AvalanchePeer &adapter, uint64_t now) {
+    std::string e;
+    for (auto i = node.notices.begin(); i != node.notices.end();) {
+        if (i->kind == DispatcherNoticeKind::Application) {
+            const auto r = adapter.Handle(*i, now, e);
+            Check(r == PeerResult::Accepted, "adapter accepts application: " + e);
+        }
+        i = node.notices.erase(i);
+    }
+}
+}
+int main() {
+    ECC_Start();
+    try {
+        CKey key; key.MakeNewKey(true); const auto pub = key.GetPubKey();
+        std::vector<uint8_t> lock{32}; lock.insert(lock.end(), pub.begin() + 1, pub.end()); lock.push_back(0xbc); lock.push_back(0x4e);
+        ::avalanche::ProofBuilder builder(1, 0, key, CScript{} << OP_TRUE);
+        Check(builder.addUTXO(COutPoint{TxId{uint256::ONE}, 0}, int64_t(10000000000ULL) * SATOSHI, 1, false, key), "build signed proof");
+        ProofEnvelope proof{builder.build(), {lock}};
+        PeerLimits limits; limits.max_payload = 4096; limits.max_action_bytes = 1 << 20;
+        std::string e; Bytes encoded; ProofEnvelope decoded;
+        Check(EncodeProofEnvelope(proof, limits, encoded, e), "encode native envelope: " + e);
+        Check(DecodeProofEnvelope(encoded, limits, decoded, e), "decode native envelope: " + e);
+        Check(decoded.proof->getId() == proof.proof->getId() && decoded.payment_locks == proof.payment_locks, "exact proof and native binding");
+        for (size_t i = 0; i < encoded.size(); ++i)
+            Check(!DecodeProofEnvelope(std::span{encoded}.first(i), limits, decoded, e), "truncation rejected");
+        auto trailing = encoded; trailing.push_back(0);
+        Check(!DecodeProofEnvelope(trailing, limits, decoded, e), "trailing bytes rejected");
+        auto unbound = proof; unbound.payment_locks.clear();
+        Check(!EncodeProofEnvelope(unbound, limits, trailing, e), "upstream proof cannot drop native lock");
+        auto huge = encoded; huge[50] = 255;
+        Check(!DecodeProofEnvelope(huge, limits, decoded, e), "oversized signed stake count rejected before allocation");
+        Pair pair; unsigned registered = 0, bound = 0, received = 0;
+        AvalanchePeer a(*pair.a.dispatcher, limits, Callbacks(key, proof, registered, bound, received));
+        AvalanchePeer b(*pair.b.dispatcher, limits, Callbacks(key, proof, registered, bound, received));
+        Check(a.Activate(pair.a.connection, e) == PeerResult::Accepted && b.Activate(pair.b.connection, e) == PeerResult::Accepted, "negotiated adapter admission");
+        auto ta = pair.a.dispatcher->Transcript(pair.a.connection); auto tb = pair.b.dispatcher->Transcript(pair.b.connection);
+        Check(ta && tb && ta->local_nonce == tb->remote_nonce && ta->local_entropy == tb->remote_entropy, "real immutable version transcript");
+        DataStream unsigned_poll; unsigned_poll << uint64_t(1) << std::vector<CInv>{};
+        auto unsigned_ptr = reinterpret_cast<const uint8_t *>(unsigned_poll.data());
+        DispatcherNotice unauthenticated{DispatcherNoticeKind::Application, pair.a.connection, {}, {}, {},
+            Message{"avapoll", Bytes(unsigned_ptr, unsigned_ptr + unsigned_poll.size())}};
+        Check(a.Handle(unauthenticated, pair.ms, e) == PeerResult::Rejected && e == "unauthenticated-poll", "poll bound to authenticated connection");
+        auto delegation = ::avalanche::DelegationBuilder(*proof.proof).build();
+        Check(a.Hello(pair.a.connection, delegation, e) == PeerResult::Accepted && b.Hello(pair.b.connection, delegation, e) == PeerResult::Accepted, "sign actual connection hello");
+        for (unsigned i = 0; i < 100; ++i) { a.Pump(pair.ms); b.Pump(pair.ms); pair.Cycle(); Deliver(pair.a, a, pair.ms); Deliver(pair.b, b, pair.ms); }
+        Check(bound == 2 && a.Node(pair.a.connection) && b.Node(pair.b.connection), "authenticate both actual connection hellos");
+        OutgoingPoll poll{*a.Node(pair.a.connection), 9, {{ItemKind::Block, lotus::v2::Hash{}}}};
+        Check(a.Poll(poll, e) == PeerResult::Accepted, "queue typed block poll");
+        for (unsigned i = 0; i < 100; ++i) { a.Pump(pair.ms); b.Pump(pair.ms); pair.Cycle(); Deliver(pair.a, a, pair.ms); Deliver(pair.b, b, pair.ms); }
+        Check(received == 1, "exact signed poll response dispatched");
+        SignedResponse corrupt; corrupt.response = ::avalanche::Response{10, 0, {}};
+        Check(key.SignSchnorr(ResponseDigest(corrupt.response), corrupt.signature), "sign response fixture");
+        corrupt.signature[0] ^= 1;
+        DataStream bad_response; bad_response << corrupt.response << corrupt.signature;
+        auto badptr = reinterpret_cast<const uint8_t *>(bad_response.data());
+        DispatcherNotice tampered{DispatcherNoticeKind::Application, pair.a.connection, {}, {}, {},
+            Message{"avaresponse", Bytes(badptr, badptr + bad_response.size())}};
+        Check(a.Handle(tampered, pair.ms, e) == PeerResult::Rejected && received == 1, "invalid signature never reaches runtime vote callback");
+        Check(a.Discover(pair.a.connection, pair.ms, e) == PeerResult::Accepted, "queue discovery");
+        for (unsigned i = 0; i < 100; ++i) { a.Pump(pair.ms); b.Pump(pair.ms); pair.Cycle(); Deliver(pair.a, a, pair.ms); Deliver(pair.b, b, pair.ms); }
+        Check(registered == 1, "compact discovery requests signed native envelope");
+        // Bounded queue retains its front action when dispatcher is occupied.
+        Check(a.Poll(poll, e) == PeerResult::Accepted && a.Poll(poll, e) == PeerResult::Accepted, "stage two actions");
+        Check(a.Pump(pair.ms) == DispatcherResult::Queued, "dispatcher accepts first action");
+        const auto retained = a.PendingBytes();
+        Check(a.Pump(pair.ms) == DispatcherResult::Busy && a.PendingActions() == 1 && a.PendingBytes() == retained, "busy retains action and bytes");
+        // A V2 compact prefill carries the complete native envelope inline.
+        Check(a.Discover(pair.a.connection, pair.ms, e) == PeerResult::Accepted, "stage second discovery");
+        DataStream prefill; prefill << uint64_t(10) << uint64_t(20);
+        WriteCompactSize(prefill, 0); WriteCompactSize(prefill, 1); WriteCompactSize(prefill, 0);
+        prefill.write(AsBytes(Span<const uint8_t>{encoded.data(), encoded.size()}));
+        auto prefptr = reinterpret_cast<const uint8_t *>(prefill.data());
+        DispatcherNotice prefilled{DispatcherNoticeKind::Application, pair.a.connection, {}, {}, {},
+                                  Message{"avaproofs", Bytes(prefptr, prefptr + prefill.size())}};
+        Check(a.Handle(prefilled, pair.ms, e) == PeerResult::Accepted && registered == 2, "bounded native prefilled proof admitted: " + e);
+        a.Disconnect(pair.a.connection); Check(!a.PendingActions() && !a.Node(pair.a.connection), "disconnect releases peer actions");
+        std::cout << "Avalanche bounded peer wire checks passed\n";
+    } catch (const std::exception &e) { std::cerr << e.what() << '\n'; ECC_Stop(); return 1; }
+    ECC_Stop(); return 0;
+}
