+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_peer.h"
+#include <avalanche/compactproofs.h>
+#include <crypto/siphash.h>
+#include <streams.h>
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+namespace lotus::v2::ava {
+namespace {
+bool Fail(std::string &e, const char *s) { e = s; return false; }
+struct Cursor {
+    std::span<const uint8_t> bytes;
+    size_t pos{};
+    bool Skip(uint64_t n) { if (n > bytes.size() - pos) return false; pos += size_t(n); return true; }
+    bool Integer(unsigned width, uint64_t &v) {
+        if (width > bytes.size() - pos) return false;
+        v = 0; for (unsigned i = 0; i < width; ++i) v |= uint64_t(bytes[pos++]) << (8 * i);
+        return true;
+    }
+    bool Count(uint64_t cap, uint64_t &v) {
+        uint64_t tag; if (!Integer(1, tag)) return false;
+        if (tag < 253) v = tag;
+        else {
+            if (!Integer(tag == 253 ? 2 : tag == 254 ? 4 : 8, v)) return false;
+            if (v < (tag == 253 ? 253ULL : tag == 254 ? 65536ULL : 4294967296ULL)) return false;
+        }
+        return v <= cap;
+    }
+    bool Blob(uint64_t cap) { uint64_t n; return Count(cap, n) && Skip(n); }
+    bool End() const { return pos == bytes.size(); }
+};
+// Check every variable count before ABC's generic vector deserialization can
+// allocate. Fixed-width stake elements still carry bounded pubkey vectors.
+bool ScanProof(Cursor &c, const PeerLimits &l, uint64_t &stakes) {
+    if (!c.Skip(16) || !c.Blob(65) || !c.Count(l.max_stakes, stakes)) return false;
+    for (uint64_t i = 0; i < stakes; ++i)
+        if (!c.Skip(48) || !c.Blob(65) || !c.Skip(64)) return false;
+    return c.Blob(l.max_payout_script) && c.Skip(64);
+}
+bool ScanHello(Cursor &c) {
+    uint64_t levels;
+    if (!c.Skip(32) || !c.Blob(65) || !c.Count(::avalanche::MAX_DELEGATION_LEVELS, levels)) return false;
+    for (uint64_t i = 0; i < levels; ++i) if (!c.Blob(65) || !c.Skip(64)) return false;
+    return c.Skip(68) && c.End();
+}
+template<typename... T> peer::Bytes WireBytes(const T &...v) {
+    DataStream s; (s << ... << v);
+    auto p = reinterpret_cast<const uint8_t *>(s.data());
+    return {p, p + s.size()};
+}
+DataStream Stream(std::span<const uint8_t> b) { return DataStream{Span<const uint8_t>{b.data(), b.size()}}; }
+Hash HashOf(const uint256 &id) { Hash h; std::copy(id.begin(), id.end(), h.begin()); return h; }
+::avalanche::ProofId ProofIdOf(const Hash &h) { uint256 v; std::copy(h.begin(), h.end(), v.begin()); return ::avalanche::ProofId{v}; }
+uint64_t Deadline(uint64_t now, uint64_t interval) { return now > UINT64_MAX - interval ? UINT64_MAX : now + interval; }
+}
+bool DecodeProofEnvelope(std::span<const uint8_t> b, const PeerLimits &l, ProofEnvelope &out, std::string &e) {
+    if (b.size() > l.max_payload) return Fail(e, "proof-envelope-capacity");
+    Cursor c{b}; uint64_t stakes, locks;
+    if (!ScanProof(c, l, stakes) || !c.Count(l.max_stakes, locks) || locks != stakes)
+        return Fail(e, "proof-envelope-count");
+    for (uint64_t i = 0; i < locks; ++i) {
+        uint64_t n; if (!c.Count(35, n) || n != 35 || !c.Skip(n)) return Fail(e, "payment-lock-size");
+    }
+    if (!c.End()) return Fail(e, "proof-envelope-trailing-bytes");
+    try {
+        auto s = Stream(b); ProofEnvelope p; s >> p.proof >> p.payment_locks;
+        if (!s.empty() || !p.proof) return Fail(e, "invalid-proof-envelope");
+        for (const auto &lock : p.payment_locks)
+            if (lock[0] != 32 || lock[33] != 0xbc || lock[34] != 0x4e) return Fail(e, "invalid-payment-lock");
+        out = std::move(p); e.clear(); return true;
+    } catch (const std::ios_base::failure &) { return Fail(e, "invalid-proof-envelope"); }
+}
+bool EncodeProofEnvelope(const ProofEnvelope &p, const PeerLimits &l, peer::Bytes &out, std::string &e) {
+    if (!p.proof || p.proof->getStakes().size() > l.max_stakes || p.payment_locks.size() != p.proof->getStakes().size())
+        return Fail(e, "proof-envelope-count");
+    if (p.proof->getPayoutScript().size() > l.max_payout_script) return Fail(e, "payout-script-capacity");
+    for (const auto &lock : p.payment_locks)
+        if (lock.size() != 35 || lock[0] != 32 || lock[33] != 0xbc || lock[34] != 0x4e) return Fail(e, "invalid-payment-lock");
+    auto bytes = WireBytes(p.proof, p.payment_locks);
+    if (bytes.size() > l.max_payload) return Fail(e, "proof-envelope-capacity");
+    out = std::move(bytes); e.clear(); return true;
+}
+AvalanchePeer::AvalanchePeer(peer::PeerDispatcher &d, PeerLimits l, PeerCallbacks c)
+    : dispatcher_(d), limits_(l), callbacks_(std::move(c)) {
+    if (!l.max_peers || !l.max_payload || !l.max_stakes || l.max_stakes > AVALANCHE_MAX_PROOF_STAKES ||
+        !l.max_elements || l.max_elements > 1024 || !l.max_proofs || !l.max_actions ||
+        l.max_actions < l.max_proofs || l.max_action_bytes < uint64_t(l.max_proofs) * l.max_payload || !l.discovery_interval_ms || !l.request_timeout_ms || !l.proof_request_interval_ms || !l.poll_cooldown_ms ||
+        !callbacks_.register_proof || !callbacks_.bind || !callbacks_.disconnect ||
+        !callbacks_.sent_proof_inventory || !callbacks_.respond || !callbacks_.receive || !callbacks_.proof || !callbacks_.proofs ||
+        !callbacks_.sign_hello || !callbacks_.discovery_keys || !callbacks_.local_session_key.IsFullyValid())
+        throw std::invalid_argument("invalid-avalanche-peer-configuration");
+}
+bool AvalanchePeer::Room(uint32_t n, uint64_t bytes) const {
+    return n <= limits_.max_actions - actions_.size() && bytes <= limits_.max_action_bytes - action_bytes_;
+}
+bool AvalanchePeer::Queue(peer::ConnectionId id, peer::Message m, std::string &e) {
+    if (m.payload.size() > limits_.max_payload || !Room(1, m.payload.size())) return Fail(e, "avalanche-action-backpressure");
+    const auto limit = dispatcher_.ActiveLimit(id);
+    if (!limit || m.payload.size() > *limit) return Fail(e, "avalanche-negotiated-capacity");
+    action_bytes_ += m.payload.size(); actions_.push_back({id, std::move(m)}); return true;
+}
+PeerResult AvalanchePeer::Activate(peer::ConnectionId id, std::string &e) {
+    if (peers_.contains(id)) return PeerResult::Accepted;
+    auto f = dispatcher_.ActiveFeatures(id); auto t = dispatcher_.Transcript(id);
+    if (!f || !(*f & REQUIRED_CAPABILITY) || !t) { e = "avalanche-not-negotiated"; return PeerResult::Rejected; }
+    if (peers_.size() >= limits_.max_peers || next_node_ == std::numeric_limits<NodeId>::max()) return PeerResult::Backpressure;
+    State state; state.node = next_node_++;
+    state.incoming = {t->remote_nonce, t->local_nonce, t->remote_entropy, t->local_entropy};
+    peers_.emplace(id, std::move(state)); e.clear(); return PeerResult::Accepted;
+}
+PeerResult AvalanchePeer::Hello(peer::ConnectionId id, const ::avalanche::Delegation &delegation, std::string &e) {
+    if (!peers_.contains(id)) return PeerResult::UnknownPeer;
+    if (!Room(1, limits_.max_payload)) return PeerResult::Backpressure;
+    auto t = dispatcher_.Transcript(id); if (!t) return PeerResult::UnknownPeer;
+    SchnorrSig sig;
+    if (!callbacks_.sign_hello(HelloDigest(delegation, {t->local_nonce, t->remote_nonce, t->local_entropy, t->remote_entropy}), sig))
+        return PeerResult::LocalFailure;
+    AuthenticatedHello checked;
+    if (!AuthenticateHello(delegation, sig, {t->local_nonce, t->remote_nonce, t->local_entropy, t->remote_entropy}, limits_.max_elements, checked, e))
+        return PeerResult::LocalFailure;
+    auto b = WireBytes(delegation, sig, limits_.max_elements);
+    return Queue(id, {"avahello", std::move(b)}, e) ? PeerResult::Accepted : PeerResult::Backpressure;
+}
+std::optional<NodeId> AvalanchePeer::Node(peer::ConnectionId id) const {
+    auto p = peers_.find(id); if (p == peers_.end() || !p->second.authenticated) return std::nullopt;
+    return p->second.node;
+}
+void AvalanchePeer::Disconnect(peer::ConnectionId id) {
+    auto p = peers_.find(id); if (p != peers_.end()) { callbacks_.disconnect(p->second.node); peers_.erase(p); }
+    for (auto a = actions_.begin(); a != actions_.end();) {
+        if (a->connection == id) { action_bytes_ -= a->message.payload.size(); a = actions_.erase(a); } else ++a;
+    }
+}
+peer::DispatcherResult AvalanchePeer::Pump(uint64_t now) {
+    if (actions_.empty()) return peer::DispatcherResult::Progress;
+    const auto &a = actions_.front(); auto r = dispatcher_.SendApplication(a.connection, a.message, now);
+    if (r == peer::DispatcherResult::Queued) {
+        if (a.message.command == "avaproofs") {
+            auto p = peers_.find(a.connection);
+            if (p != peers_.end()) callbacks_.sent_proof_inventory(p->second.node);
+        }
+        action_bytes_ -= a.message.payload.size(); actions_.pop_front();
+    }
+    // Terminal failures retain the action until driver disconnects explicitly.
+    return r;
+}
+PeerResult AvalanchePeer::Poll(const OutgoingPoll &p, std::string &e) {
+    for (const auto &[id, state] : peers_) if (state.node == p.node && state.authenticated) {
+        if (p.items.size() > std::min(limits_.max_elements, state.authenticated->max_elements)) { e = "poll-count"; return PeerResult::LocalFailure; }
+        std::vector<CInv> invs; invs.reserve(p.items.size());
+        for (const auto &i : p.items) { uint256 hash; std::copy(i.id.begin(), i.id.end(), hash.begin()); invs.emplace_back(i.kind == ItemKind::Block ? MSG_BLOCK : MSG_AVA_PROOF, hash); }
+        return Queue(id, {"avapoll", WireBytes(p.round, invs)}, e) ? PeerResult::Accepted : PeerResult::Backpressure;
+    }
+    return PeerResult::UnknownPeer;
+}
+PeerResult AvalanchePeer::Discover(peer::ConnectionId id, uint64_t now, std::string &e) {
+    Tick(now);
+    if (!peers_.contains(id)) return PeerResult::UnknownPeer;
+    if (peers_.at(id).discovery_outstanding || peers_.at(id).discovery_expected) return PeerResult::Backpressure;
+    if (!Queue(id, {"getavaproofs", {}}, e)) return PeerResult::Backpressure;
+    peers_.at(id).discovery_outstanding = true;
+    peers_.at(id).discovery_deadline = Deadline(now, limits_.request_timeout_ms);
+    return PeerResult::Accepted;
+}
+void AvalanchePeer::Tick(uint64_t now) {
+    for (auto &[id, state] : peers_) {
+        (void)id;
+        for (auto r = state.requested.begin(); r != state.requested.end();)
+            if (now >= r->second) r = state.requested.erase(r); else ++r;
+        if (now >= state.discovery_deadline) {
+            state.discovery_outstanding = false; state.discovery_expected = 0;
+            state.discovery_received.clear(); state.discovery_shortids.clear();
+        }
+    }
+}
+PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice, uint64_t now, std::string &e) {
+    auto found = peers_.find(notice.connection);
+    if (found == peers_.end()) return PeerResult::UnknownPeer;
+    if (notice.kind != peer::DispatcherNoticeKind::Application || !notice.application) return PeerResult::Rejected;
+    auto &state = found->second; const auto &m = *notice.application; const auto id = notice.connection;
+    const auto &b = m.payload;
+    if (b.size() > limits_.max_payload) { e = "avalanche-payload-capacity"; return PeerResult::Rejected; }
+    // Reserve worst-case action count/bytes before callbacks or state changes.
+    // This is bounded logical staging; it does not promise allocator success.
+    uint32_t reserve_actions = 1;
+    if (m.command == "avaproofsreq" || m.command == "getdata") {
+        Cursor count_cursor{b}; uint64_t count;
+        if (!count_cursor.Count(limits_.max_proofs, count)) { e = "avalanche-request-count"; return PeerResult::Rejected; }
+        reserve_actions = uint32_t(count);
+    }
+    if (!Room(reserve_actions, uint64_t(reserve_actions) * limits_.max_payload)) return PeerResult::Backpressure;
+    Tick(now);
+    if ((m.command == "getdata" || m.command == "avaproofsreq") && now < state.next_proof_request) {
+        e = "proof-request-cooldown"; return PeerResult::Rejected;
+    }
+    try {
+        if (m.command == "avahello") {
+            if (state.authenticated || state.delegation) { e = "duplicate-avahello"; return PeerResult::Rejected; }
+            Cursor c{b}; if (!ScanHello(c)) { e = "avahello-framing"; return PeerResult::Rejected; }
+            auto s = Stream(b); ::avalanche::Delegation d; SchnorrSig sig; uint32_t count;
+            s >> d >> sig >> count;
+            AuthenticatedHello h;
+            if (!AuthenticateHello(d, sig, state.incoming, count, h, e)) return PeerResult::Rejected;
+            state.delegation = d; state.hello_signature = sig; state.hello_elements = count;
+            if (callbacks_.proof(h.proof_id)) {
+                if (!callbacks_.bind(state.node, d, sig, state.incoming, count, e)) return PeerResult::Rejected;
+                state.authenticated = h;
+            } else {
+                state.requested[h.proof_id] = Deadline(now, limits_.request_timeout_ms);
+                peer::Bytes bytes;
+                const peer::Inventory request{peer::PROOF_INVENTORY_TYPE, HashOf(h.proof_id)};
+                if (!peer::EncodeInventory(std::span{&request, 1}, limits_.max_payload, bytes, e) ||
+                    !Queue(id, {"getdata", std::move(bytes)}, e)) return PeerResult::LocalFailure;
+            }
+            return PeerResult::Accepted;
+        }
+        if (m.command == "avaproof") {
+            ProofEnvelope p; if (!DecodeProofEnvelope(b, limits_, p, e)) return PeerResult::Rejected;
+            // Only responses to bounded announced proof requests are admitted.
+            if (!state.requested.contains(p.proof->getId()) && (!state.discovery_expected || state.discovery_received.contains(p.proof->getId()))) { e = "unsolicited-avaproof"; return PeerResult::Rejected; }
+            const bool direct_request = state.requested.contains(p.proof->getId());
+            const uint64_t shortid = SipHashUint256(state.discovery_k0, state.discovery_k1, p.proof->getId()) & 0xffffffffffffULL;
+            auto slot = std::find(state.discovery_shortids.begin(), state.discovery_shortids.end(), shortid);
+            if (!direct_request && slot == state.discovery_shortids.end()) { e = "unannounced-discovery-proof"; return PeerResult::Rejected; }
+            if (!callbacks_.register_proof(p, e)) return PeerResult::Rejected;
+            if (!state.requested.erase(p.proof->getId())) {
+                --state.discovery_expected; state.discovery_received.insert(p.proof->getId());
+                state.discovery_shortids.erase(slot);
+            }
+            if (state.delegation && !state.authenticated && state.delegation->getProofId() == p.proof->getId()) {
+                // The cryptographically authenticated hello was retained while
+                // native UTXO/payment-lock admission completed.
+                AuthenticatedHello h;
+                if (!AuthenticateHello(*state.delegation, state.hello_signature, state.incoming, state.hello_elements, h, e) ||
+                    !callbacks_.bind(state.node, *state.delegation, state.hello_signature, state.incoming, state.hello_elements, e))
+                    return PeerResult::Rejected;
+                state.authenticated = h;
+            }
+            return PeerResult::Accepted;
+        }
+        if (m.command == "avapoll") {
+            if (!state.authenticated) { e = "unauthenticated-poll"; return PeerResult::Rejected; }
+            const bool cooling = now < state.next_poll;
+            state.next_poll = Deadline(now, limits_.poll_cooldown_ms);
+            if (cooling) return PeerResult::Accepted; // pinned ABC ignores repeated polls
+            Cursor c{b}; uint64_t round, count;
+            if (!c.Integer(8, round) || !c.Count(limits_.max_elements, count) || !c.Skip(count * 36) || !c.End()) { e = "poll-framing"; return PeerResult::Rejected; }
+            auto s = Stream(b); std::vector<CInv> invs; s >> round >> invs;
+            OutgoingPoll poll{state.node, round, {}}; poll.items.reserve(invs.size());
+            for (const auto &inv : invs) {
+                if (inv.type != MSG_BLOCK && inv.type != MSG_AVA_PROOF) { e = "poll-inventory-type"; return PeerResult::Rejected; }
+                PollItem item{inv.type == MSG_BLOCK ? ItemKind::Block : ItemKind::Proof, HashOf(inv.hash)};
+                if (std::find_if(poll.items.begin(), poll.items.end(), [&](const auto &i) { return i.kind == item.kind && i.id == item.id; }) != poll.items.end()) { e = "duplicate-poll-item"; return PeerResult::Rejected; }
+                poll.items.push_back(item);
+            }
+            SignedResponse response;
+            if (!callbacks_.respond(poll, response, e)) return PeerResult::LocalFailure;
+            if (response.response.getRound() != round || response.response.GetVotes().size() != invs.size() ||
+                !AuthenticateResponse(callbacks_.local_session_key, response, e)) { e = "invalid-local-response"; return PeerResult::LocalFailure; }
+            for (size_t i = 0; i < invs.size(); ++i)
+                if (response.response.GetVotes()[i].GetHash() != invs[i].hash) { e = "local-response-order"; return PeerResult::LocalFailure; }
+            return Queue(id, {"avaresponse", WireBytes(response.response, response.signature)}, e) ? PeerResult::Accepted : PeerResult::LocalFailure;
+        }
+        if (m.command == "avaresponse") {
+            if (!state.authenticated) { e = "unauthenticated-response"; return PeerResult::Rejected; }
+            Cursor c{b}; uint64_t n;
+            if (!c.Skip(12) || !c.Count(limits_.max_elements, n) || !c.Skip(n * 36 + 64) || !c.End()) { e = "response-framing"; return PeerResult::Rejected; }
+            auto s = Stream(b); SignedResponse response; s >> response.response >> response.signature;
+            if (!AuthenticateResponse(state.authenticated->session_key, response, e) || !callbacks_.receive(state.node, response, e)) return PeerResult::Rejected;
+            return PeerResult::Accepted;
+        }
+        if (m.command == "getavaproofs") {
+            if (!b.empty()) { e = "getavaproofs-framing"; return PeerResult::Rejected; }
+            if (now < state.next_discovery) { e = "discovery-cooldown"; return PeerResult::Rejected; }
+            auto proofs = callbacks_.proofs();
+            if (proofs.size() > limits_.max_proofs) { e = "local-proof-list-capacity"; return PeerResult::LocalFailure; }
+            uint64_t k0, k1; if (!callbacks_.discovery_keys(k0, k1)) return PeerResult::LocalFailure;
+            DataStream s; s << k0 << k1; WriteCompactSize(s, proofs.size());
+            for (const auto &proof : proofs) {
+                auto shortid = SipHashUint256(k0, k1, proof);
+                for (unsigned i = 0; i < 6; ++i) { uint8_t octet = uint8_t(shortid >> (8 * i)); s << octet; }
+            }
+            WriteCompactSize(s, 0); // No prefills: every proof travels with native binding.
+            auto ptr = reinterpret_cast<const uint8_t *>(s.data()); peer::Bytes bytes(ptr, ptr + s.size());
+            if (!Queue(id, {"avaproofs", std::move(bytes)}, e)) return PeerResult::LocalFailure;
+            state.advertised = std::move(proofs); state.next_discovery = Deadline(now, limits_.discovery_interval_ms);
+            return PeerResult::Accepted;
+        }
+        if (m.command == "avaproofs") {
+            if (!state.discovery_outstanding) { e = "unsolicited-avaproofs"; return PeerResult::Rejected; }
+            Cursor c{b}; uint64_t count, prefilled, k0, k1;
+            if (!c.Integer(8, k0) || !c.Integer(8, k1) || !c.Count(limits_.max_proofs, count)) { e = "avaproofs-count"; return PeerResult::Rejected; }
+            std::vector<uint64_t> shortids; shortids.reserve(size_t(count));
+            for (uint64_t i = 0; i < count; ++i) {
+                uint64_t shortid; if (!c.Integer(6, shortid)) { e = "avaproofs-shortids"; return PeerResult::Rejected; }
+                shortids.push_back(shortid);
+            }
+            if (!c.Count(limits_.max_proofs - count, prefilled)) { e = "avaproofs-count"; return PeerResult::Rejected; }
+            std::vector<std::pair<uint32_t, ProofEnvelope>> prefills;
+            prefills.reserve(size_t(prefilled)); uint64_t index = 0;
+            for (uint64_t i = 0; i < prefilled; ++i) {
+                uint64_t diff, stakes, locks;
+                if (!c.Count(UINT32_MAX, diff) || diff > UINT32_MAX - index || index + diff >= count + prefilled) {
+                    e = "avaproofs-prefill-index"; return PeerResult::Rejected;
+                }
+                index += diff; const size_t start = c.pos;
+                if (!ScanProof(c, limits_, stakes) || !c.Count(limits_.max_stakes, locks) || locks != stakes) {
+                    e = "avaproofs-prefill-binding-count"; return PeerResult::Rejected;
+                }
+                for (uint64_t j = 0; j < locks; ++j) {
+                    uint64_t n; if (!c.Count(35, n) || n != 35 || !c.Skip(n)) { e = "avaproofs-prefill-lock"; return PeerResult::Rejected; }
+                }
+                ProofEnvelope envelope;
+                if (!DecodeProofEnvelope(std::span{b}.subspan(start, c.pos - start), limits_, envelope, e)) return PeerResult::Rejected;
+                prefills.emplace_back(uint32_t(index), std::move(envelope)); ++index;
+            }
+            if (!c.End()) { e = "avaproofs-trailing-bytes"; return PeerResult::Rejected; }
+            // Conservative collision-safe fallback requests every non-prefilled
+            // slot. Full signed proofs/native bindings determine admission.
+            ::avalanche::ProofsRequest request; request.indices.reserve(size_t(count));
+            size_t filled = 0;
+            for (uint32_t i = 0; i < count + prefilled; ++i) {
+                if (filled < prefills.size() && prefills[filled].first == i) ++filled;
+                else request.indices.push_back(i);
+            }
+            for (const auto &p : prefills) if (!callbacks_.register_proof(p.second, e)) return PeerResult::Rejected;
+            if (state.delegation && !state.authenticated && callbacks_.proof(state.delegation->getProofId())) {
+                AuthenticatedHello h;
+                if (!AuthenticateHello(*state.delegation, state.hello_signature, state.incoming, state.hello_elements, h, e) ||
+                    !callbacks_.bind(state.node, *state.delegation, state.hello_signature, state.incoming, state.hello_elements, e)) return PeerResult::Rejected;
+                state.authenticated = h;
+            }
+            if (!Queue(id, {"avaproofsreq", WireBytes(request)}, e)) return PeerResult::LocalFailure;
+            state.discovery_outstanding = false; state.discovery_expected = uint32_t(count);
+            state.discovery_received.clear(); state.discovery_deadline = Deadline(now, limits_.request_timeout_ms);
+            state.discovery_k0 = k0; state.discovery_k1 = k1; state.discovery_shortids = std::move(shortids);
+            return PeerResult::Accepted;
+        }
+        if (m.command == "avaproofsreq") {
+            Cursor c{b}; uint64_t count, diff, index = 0;
+            if (!c.Count(limits_.max_proofs, count)) { e = "proof-request-count"; return PeerResult::Rejected; }
+            std::vector<uint32_t> indices; indices.reserve(size_t(count));
+            for (uint64_t i = 0; i < count; ++i) {
+                if (!c.Count(UINT32_MAX, diff) || diff > UINT32_MAX - index || index + diff >= state.advertised.size()) { e = "proof-request-index"; return PeerResult::Rejected; }
+                index += diff; indices.push_back(uint32_t(index)); ++index;
+            }
+            if (!c.End()) { e = "proof-request-trailing-bytes"; return PeerResult::Rejected; }
+            std::vector<peer::Message> responses; responses.reserve(indices.size());
+            for (auto i : indices) { auto proof = callbacks_.proof(state.advertised[i]); peer::Bytes bytes;
+                if (!proof || !EncodeProofEnvelope(*proof, limits_, bytes, e)) return PeerResult::LocalFailure;
+                responses.push_back({"avaproof", std::move(bytes)});
+            }
+            for (auto &message : responses) if (!Queue(id, std::move(message), e)) return PeerResult::LocalFailure;
+            state.advertised.clear(); state.next_proof_request = Deadline(now, limits_.proof_request_interval_ms);
+            return PeerResult::Accepted;
+        }
+        if (m.command == "inv" || m.command == "getdata" || m.command == "notfound") {
+            Cursor c{b}; uint64_t count;
+            if (!c.Count(limits_.max_proofs, count) || !c.Skip(count * 36) || !c.End()) { e = "proof-inventory-framing"; return PeerResult::Rejected; }
+            std::vector<peer::Inventory> invs;
+            if (!peer::DecodeInventory(b, limits_.max_payload, invs, e)) return PeerResult::Rejected;
+            for (const auto &inv : invs) if (inv.type != peer::PROOF_INVENTORY_TYPE) { e = "non-proof-application-inventory"; return PeerResult::Rejected; }
+            std::vector<peer::Inventory> requests;
+            std::vector<peer::Message> responses;
+            for (const auto &inv : invs) {
+                const auto proofid = ProofIdOf(inv.hash);
+                if (m.command == "inv") {
+                    if (!callbacks_.proof(proofid) && !state.requested.contains(proofid)) requests.push_back(inv);
+                } else if (m.command == "notfound") state.requested.erase(proofid);
+                else {
+                    auto p = callbacks_.proof(proofid); peer::Bytes bytes;
+                    if (p) { if (!EncodeProofEnvelope(*p, limits_, bytes, e)) return PeerResult::LocalFailure; responses.push_back({"avaproof", std::move(bytes)}); }
+                    else { if (!peer::EncodeInventory(std::span{&inv, 1}, limits_.max_payload, bytes, e)) return PeerResult::LocalFailure; responses.push_back({"notfound", std::move(bytes)}); }
+                }
+            }
+            if (state.requested.size() + requests.size() > limits_.max_proofs) return PeerResult::Backpressure;
+            if (!requests.empty()) {
+                peer::Bytes bytes; if (!peer::EncodeInventory(requests, limits_.max_payload, bytes, e) || !Queue(id, {"getdata", std::move(bytes)}, e)) return PeerResult::LocalFailure;
+                for (const auto &inv : requests) state.requested.emplace(ProofIdOf(inv.hash), Deadline(now, limits_.request_timeout_ms));
+            }
+            for (auto &message : responses) if (!Queue(id, std::move(message), e)) return PeerResult::LocalFailure;
+            if (m.command == "getdata") state.next_proof_request = Deadline(now, limits_.proof_request_interval_ms);
+            return PeerResult::Accepted;
+        }
+    } catch (const std::ios_base::failure &) { e = "invalid-avalanche-serialization"; return PeerResult::Rejected; }
+    e = "unsupported-avalanche-command"; return PeerResult::Rejected;
+}
+} // namespace lotus::v2::ava
