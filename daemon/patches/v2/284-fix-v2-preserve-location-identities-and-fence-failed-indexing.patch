@@ -423,7 +423,7 @@ impl Page {
     }
 }
 fn location(l: TxLocation) -> Value {
-    json!({"block_id":hex::encode(l.block_id.0),"height":l.height.to_string(),"tx_index":l.tx_index.to_string()})
+    json!({"block_id":hex::encode(l.block_id.0),"height":l.height.to_string(),"tx_index":l.tx_index.to_string(),"txid":hex::encode(l.txid.0.0),"txhash":hex::encode(l.txhash.0.0)})
 }
 fn output_fields(out: &Output) -> Value {
     json!({"flags":out.flags.to_string(),"value":out.value.to_string(),"has_token":out.has_token(),"token_id":hex::encode(out.token_id.0),"is_burn":out.is_burn(),"branches":out.branches.iter().map(|h|hex::encode(h.0)).collect::<Vec<_>>(),"paths":out.paths.iter().map(|p|p.iter().map(u8::to_string).collect::<Vec<_>>()).collect::<Vec<_>>()})
@@ -442,7 +442,7 @@ fn byte_ref(r: chronik_db::v2_explorer::WireRange) -> Value {
 }
 fn tx_summary(t: &TxMeta, c: &Context) -> Result<Value> {
     Ok(
-        json!({"txid":hex::encode(t.location.txid.0.0),"txhash":hex::encode(t.location.txhash.0.0),"location":location(t.location),"status":"confirmed","confirmations":c.confirmations(t.location.height)?,"input_count":t.input_count.to_string(),"output_count":t.output_count.to_string(),"wire_size":t.wire_size.to_string()}),
+        json!({"txid":hex::encode(t.location.txid.0.0),"txhash":hex::encode(t.location.txhash.0.0),"location":{"block_id":hex::encode(t.location.block_id.0),"height":t.location.height.to_string(),"tx_index":t.location.tx_index.to_string()},"status":"confirmed","confirmations":c.confirmations(t.location.height)?,"input_count":t.input_count.to_string(),"output_count":t.output_count.to_string(),"wire_size":t.wire_size.to_string()}),
     )
 }
 fn read_le(b: &[u8]) -> u64 {
@@ -549,7 +549,9 @@ async fn handle(
             failure(unavailable(), None)
         };
     }
-    if stamp.is_none_or(|s| s.anchor.is_none()) {
+    if s.index_error.load(std::sync::atomic::Ordering::Acquire)
+        || stamp.is_none_or(|s| s.anchor.is_none())
+    {
         return failure(unavailable(), None);
     }
     let view = match db.snapshot() {
@@ -574,7 +576,9 @@ async fn handle(
             Ok(response(StatusCode::OK, &value))
         })
         .unwrap_or_else(|e| failure(e, Some(&context)));
-    if observe(&s) == Some(stamp) {
+    if !s.index_error.load(std::sync::atomic::Ordering::Acquire)
+        && observe(&s) == Some(stamp)
+    {
         result
     } else {
         failure(unavailable(), None)
