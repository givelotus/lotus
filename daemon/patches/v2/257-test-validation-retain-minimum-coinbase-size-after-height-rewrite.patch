From dc2dea6dbccbd0b6a4b8256594b184e4f40d62b0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:47:58 -0700
Subject: [PATCH] test(validation): retain minimum coinbase size after height
 rewrite

---
 src/test/validation_block_tests.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/test/validation_block_tests.cpp b/src/test/validation_block_tests.cpp
index bbb39628ce094284feddc9bde9cf460eedb320e6..a5c67ac3daa8c1095a0aee88f43baba3fb4d990d 100644
--- a/src/test/validation_block_tests.cpp
+++ b/src/test/validation_block_tests.cpp
@@ -8,6 +8,7 @@
 #include <chain.h>
 #include <chainparams.h>
 #include <config.h>
+#include <consensus/consensus.h>
 #include <consensus/merkle.h>
 #include <consensus/validation.h>
 #include <node/miner.h>
@@ -114,6 +115,14 @@ std::shared_ptr<CBlock> MinerTestingSetup::Block(const Config &config,
     txCoinbase.vout[1].nValue =
         GetBlockSubsidy(height, config.GetChainParams().GetConsensus());
     txCoinbase.vout[0].nValue = Amount::zero();
+    // Replacing the assembler's height script also removes its size padding.
+    // Keep these otherwise valid coinbases above the consensus minimum.
+    const auto coinbase_size = ::GetSerializeSize(txCoinbase);
+    if (coinbase_size < MIN_TX_SIZE) {
+        txCoinbase.vin[0].scriptSig
+            << std::vector<uint8_t>(MIN_TX_SIZE - coinbase_size - 1);
+    }
+    assert(::GetSerializeSize(txCoinbase) >= MIN_TX_SIZE);
     pblock->vtx[0] = MakeTransactionRef(std::move(txCoinbase));
 
     return pblock;
-- 
