@@ -390,6 +391,7 @@ void InterruptRPC() {
         LogDebug(BCLog::RPC, "Interrupting RPC\n");
         // Interrupt e.g. running longpolls
         g_rpc_running = false;
+        GetRPCBlockChangeWaiter().NotifyAll();
     });
 }
 
