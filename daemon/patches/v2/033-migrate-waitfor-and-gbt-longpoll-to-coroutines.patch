From 06b949cb276b7fb0c13b7c20894bcb5d51c1c49b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Fri, 16 Oct 2026 16:55:45 -0700
Subject: [PATCH] 033-migrate-waitfor-and-gbt-longpoll-to-coroutines: migrate
 waitfor* and getblocktemplate long-polling to coroutines

---
 src/rpc/blockchain.cpp | 92 +++++++++++++++++-------------------------
 src/rpc/mining.cpp     | 90 ++++++++++++++++++++++++++---------------
 src/rpc/server.cpp     |  2 +
 src/validation.cpp     |  2 +
 4 files changed, 100 insertions(+), 86 deletions(-)

diff --git a/src/rpc/blockchain.cpp b/src/rpc/blockchain.cpp
index d8a2fdeedb179ac179722ed87a9a4de55d4d6be2..b81d1bef9e63792b3634272c6b953968c3036f7a 100644
--- a/src/rpc/blockchain.cpp
+++ b/src/rpc/blockchain.cpp
@@ -28,6 +28,7 @@
 #include <node/context.h>
 #include <node/utxo_snapshot.h>
 #include <primitives/transaction.h>
+#include <rpc/async_waiter.h>
 #include <rpc/server.h>
 #include <rpc/server_util.h>
 #include <rpc/util.h>
@@ -262,6 +263,7 @@ void RPCNotifyBlockChange(const CBlockIndex *pindex) {
         latestblock.height = pindex->nHeight;
     }
     cond_blockchange.notify_all();
+    GetRPCBlockChangeWaiter().NotifyAll();
 }
 
 static RPCHelpMan waitfornewblock() {
@@ -284,7 +286,9 @@ static RPCHelpMan waitfornewblock() {
         RPCExamples{HelpExampleCli("waitfornewblock", "1000") +
                     HelpExampleRpc("waitfornewblock", "1000")},
         [&](const RPCHelpMan &self, const Config &config,
-            const JSONRPCRequest &request) -> UniValue {
+            const JSONRPCRequest &request,
+            boost::asio::any_io_executor executor)
+            -> boost::asio::awaitable<UniValue> {
             int timeout = 0;
             if (!request.params[0].isNull()) {
                 timeout = request.params[0].getInt<int>();
@@ -292,31 +296,23 @@ static RPCHelpMan waitfornewblock() {
 
             CUpdatedBlock block;
             {
-                WAIT_LOCK(cs_blockchange, lock);
+                LOCK(cs_blockchange);
                 block = latestblock;
-                if (timeout) {
-                    cond_blockchange.wait_for(
-                        lock, std::chrono::milliseconds(timeout),
-                        [&block]() EXCLUSIVE_LOCKS_REQUIRED(cs_blockchange) {
-                            return latestblock.height != block.height ||
-                                   latestblock.hash != block.hash ||
-                                   !IsRPCRunning();
-                        });
-                } else {
-                    cond_blockchange.wait(
-                        lock,
-                        [&block]() EXCLUSIVE_LOCKS_REQUIRED(cs_blockchange) {
-                            return latestblock.height != block.height ||
-                                   latestblock.hash != block.hash ||
-                                   !IsRPCRunning();
-                        });
-                }
+            }
+            co_await GetRPCBlockChangeWaiter().WaitUntil(
+                executor, std::chrono::milliseconds(timeout), [&block]() {
+                    LOCK(cs_blockchange);
+                    return latestblock.height != block.height ||
+                           latestblock.hash != block.hash || !IsRPCRunning();
+                });
+            {
+                LOCK(cs_blockchange);
                 block = latestblock;
             }
             UniValue ret(UniValue::VOBJ);
             ret.pushKV("hash", block.hash.GetHex());
             ret.pushKV("height", block.height);
-            return ret;
+            co_return ret;
         },
     };
 }
@@ -347,7 +343,9 @@ static RPCHelpMan waitforblock() {
                                    "\"0000000000079f8ef3d2c688c244eb7a4570b24c9"
                                    "ed7b4a8c619eb02596f8862\", 1000")},
         [&](const RPCHelpMan &self, const Config &config,
-            const JSONRPCRequest &request) -> UniValue {
+            const JSONRPCRequest &request,
+            boost::asio::any_io_executor executor)
+            -> boost::asio::awaitable<UniValue> {
             int timeout = 0;
 
             BlockHash hash(ParseHashV(request.params[0], "blockhash"));
@@ -356,29 +354,22 @@ static RPCHelpMan waitforblock() {
                 timeout = request.params[1].getInt<int>();
             }
 
+            co_await GetRPCBlockChangeWaiter().WaitUntil(
+                executor, std::chrono::milliseconds(timeout), [&hash]() {
+                    LOCK(cs_blockchange);
+                    return latestblock.hash == hash || !IsRPCRunning();
+                });
+
             CUpdatedBlock block;
             {
-                WAIT_LOCK(cs_blockchange, lock);
-                if (timeout) {
-                    cond_blockchange.wait_for(
-                        lock, std::chrono::milliseconds(timeout),
-                        [&hash]() EXCLUSIVE_LOCKS_REQUIRED(cs_blockchange) {
-                            return latestblock.hash == hash || !IsRPCRunning();
-                        });
-                } else {
-                    cond_blockchange.wait(
-                        lock,
-                        [&hash]() EXCLUSIVE_LOCKS_REQUIRED(cs_blockchange) {
-                            return latestblock.hash == hash || !IsRPCRunning();
-                        });
-                }
+                LOCK(cs_blockchange);
                 block = latestblock;
             }
 
             UniValue ret(UniValue::VOBJ);
             ret.pushKV("hash", block.hash.GetHex());
             ret.pushKV("height", block.height);
-            return ret;
+            co_return ret;
         },
     };
 }
@@ -406,7 +397,9 @@ static RPCHelpMan waitforblockheight() {
         RPCExamples{HelpExampleCli("waitforblockheight", "100 1000") +
                     HelpExampleRpc("waitforblockheight", "100, 1000")},
         [&](const RPCHelpMan &self, const Config &config,
-            const JSONRPCRequest &request) -> UniValue {
+            const JSONRPCRequest &request,
+            boost::asio::any_io_executor executor)
+            -> boost::asio::awaitable<UniValue> {
             int timeout = 0;
 
             int height = request.params[0].getInt<int>();
@@ -415,30 +408,21 @@ static RPCHelpMan waitforblockheight() {
                 timeout = request.params[1].getInt<int>();
             }
 
+            co_await GetRPCBlockChangeWaiter().WaitUntil(
+                executor, std::chrono::milliseconds(timeout), [height]() {
+                    LOCK(cs_blockchange);
+                    return latestblock.height >= height || !IsRPCRunning();
+                });
+
             CUpdatedBlock block;
             {
-                WAIT_LOCK(cs_blockchange, lock);
-                if (timeout) {
-                    cond_blockchange.wait_for(
-                        lock, std::chrono::milliseconds(timeout),
-                        [&height]() EXCLUSIVE_LOCKS_REQUIRED(cs_blockchange) {
-                            return latestblock.height >= height ||
-                                   !IsRPCRunning();
-                        });
-                } else {
-                    cond_blockchange.wait(
-                        lock,
-                        [&height]() EXCLUSIVE_LOCKS_REQUIRED(cs_blockchange) {
-                            return latestblock.height >= height ||
-                                   !IsRPCRunning();
-                        });
-                }
+                LOCK(cs_blockchange);
                 block = latestblock;
             }
             UniValue ret(UniValue::VOBJ);
             ret.pushKV("hash", block.hash.GetHex());
             ret.pushKV("height", block.height);
-            return ret;
+            co_return ret;
         },
     };
 }
diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 2346a54e3f8ab7125f1c2de0f5c92ed153a1384f..fdc640cbfcbe83e518776a115df2b1f6c34e56bf 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -27,6 +27,7 @@
 #include <policy/block/stakingrewards.h>
 #include <policy/policy.h>
 #include <pow/pow.h>
+#include <rpc/async_waiter.h>
 #include <rpc/blockchain.h>
 #include <rpc/mining.h>
 #include <rpc/server.h>
@@ -896,19 +897,18 @@ static RPCHelpMan getblocktemplate() {
         RPCExamples{HelpExampleCli("getblocktemplate", "") +
                     HelpExampleRpc("getblocktemplate", "")},
         [&](const RPCHelpMan &self, const Config &config,
-            const JSONRPCRequest &request) -> UniValue {
+            const JSONRPCRequest &request,
+            boost::asio::any_io_executor executor)
+            -> boost::asio::awaitable<UniValue> {
             NodeContext &node = EnsureAnyNodeContext(request.context);
             ChainstateManager &chainman = EnsureChainman(node);
             ArgsManager &argsman = EnsureArgsman(node);
-            LOCK(cs_main);
 
             const CChainParams &chainparams = config.GetChainParams();
 
             std::string strMode = "template";
             UniValue lpval = NullUniValue;
             std::set<std::string> setClientRules;
-            Chainstate &active_chainstate = chainman.ActiveChainstate();
-            CChain &active_chain = active_chainstate.m_chain;
             if (!request.params[0].isNull()) {
                 const UniValue &oparam = request.params[0].get_obj();
                 const UniValue &modeval = oparam.find_value("mode");
@@ -935,24 +935,27 @@ static RPCHelpMan getblocktemplate() {
                                            "Block decode failed");
                     }
 
+                    LOCK(cs_main);
+                    Chainstate &active_chainstate = chainman.ActiveChainstate();
+                    CChain &active_chain = active_chainstate.m_chain;
                     const BlockHash hash = block.GetHash();
                     const CBlockIndex *pindex =
                         chainman.m_blockman.LookupBlockIndex(hash);
                     if (pindex) {
                         if (pindex->IsValid(BlockValidity::SCRIPTS)) {
-                            return "duplicate";
+                            co_return "duplicate";
                         }
                         if (pindex->nStatus.isInvalid()) {
-                            return "duplicate-invalid";
+                            co_return "duplicate-invalid";
                         }
-                        return "duplicate-inconclusive";
+                        co_return "duplicate-inconclusive";
                     }
 
                     CBlockIndex *const pindexPrev = active_chain.Tip();
                     // TestBlockValidity only supports blocks built on the
                     // current Tip
                     if (block.hashPrevBlock != pindexPrev->GetBlockHash()) {
-                        return "inconclusive-not-best-prevblk";
+                        co_return "inconclusive-not-best-prevblk";
                     }
                     BlockValidationState state;
                     TestBlockValidity(state, chainparams, active_chainstate,
@@ -960,7 +963,7 @@ static RPCHelpMan getblocktemplate() {
                                       BlockValidationOptions(config)
                                           .withCheckPoW(false)
                                           .withCheckMerkleRoot(true));
-                    return BIP22ValidationResult(config, state);
+                    co_return BIP22ValidationResult(config, state);
                 }
             }
 
@@ -1004,7 +1007,9 @@ static RPCHelpMan getblocktemplate() {
                 } else {
                     // NOTE: Spec does not specify behaviour for non-string
                     // longpollid, but this makes testing easier
-                    hashWatchedChain = active_chain.Tip()->GetBlockHash();
+                    LOCK(cs_main);
+                    hashWatchedChain =
+                        chainman.ActiveChain().Tip()->GetBlockHash();
                     nTransactionsUpdatedLastLP = nTransactionsUpdatedLast;
                 }
 
@@ -1012,29 +1017,47 @@ static RPCHelpMan getblocktemplate() {
                 const auto initialLongpollDelay = isRegtest ? 5s : 1min;
                 const auto newTxCheckLongpollDelay = isRegtest ? 1s : 10s;
 
-                // Release lock while waiting
-                LEAVE_CRITICAL_SECTION(cs_main);
-                {
-                    checktxtime =
-                        std::chrono::steady_clock::now() + initialLongpollDelay;
-
-                    WAIT_LOCK(g_best_block_mutex, lock);
-                    while (g_best_block &&
-                           g_best_block->GetBlockHash() == hashWatchedChain &&
-                           IsRPCRunning()) {
-                        if (g_best_block_cv.wait_until(lock, checktxtime) ==
-                            std::cv_status::timeout) {
-                            // Timeout: Check transactions for update
-                            // without holding the mempool look to avoid
-                            // deadlocks
-                            if (mempool.GetTransactionsUpdated() !=
-                                nTransactionsUpdatedLastLP) {
-                                break;
-                            }
-                            checktxtime += newTxCheckLongpollDelay;
+                checktxtime =
+                    std::chrono::steady_clock::now() + initialLongpollDelay;
+
+                while (IsRPCRunning()) {
+                    {
+                        LOCK(g_best_block_mutex);
+                        if (!g_best_block ||
+                            g_best_block->GetBlockHash() != hashWatchedChain) {
+                            break;
+                        }
+                    }
+
+                    co_await GetRPCBlockChangeWaiter().WaitUntilDeadline(
+                        executor, checktxtime, [&hashWatchedChain]() {
+                            LOCK(g_best_block_mutex);
+                            return !g_best_block ||
+                                   g_best_block->GetBlockHash() !=
+                                       hashWatchedChain ||
+                                   !IsRPCRunning();
+                        });
+
+                    {
+                        LOCK(g_best_block_mutex);
+                        if (!g_best_block ||
+                            g_best_block->GetBlockHash() != hashWatchedChain ||
+                            !IsRPCRunning()) {
+                            break;
                         }
                     }
 
+                    // Timeout: Check transactions for update without holding
+                    // the mempool lock to avoid deadlocks.
+                    if (mempool.GetTransactionsUpdated() !=
+                        nTransactionsUpdatedLastLP) {
+                        break;
+                    }
+                    checktxtime += newTxCheckLongpollDelay;
+                }
+
+                {
+                    LOCK(g_best_block_mutex);
                     if (node.avalanche && IsStakingRewardsActivated(
                                               consensusParams, g_best_block)) {
                         // At this point the staking reward winner might not be
@@ -1048,7 +1071,6 @@ static RPCHelpMan getblocktemplate() {
                         node.avalanche->computeStakingReward(g_best_block);
                     }
                 }
-                ENTER_CRITICAL_SECTION(cs_main);
 
                 if (!IsRPCRunning()) {
                     throw JSONRPCError(RPC_CLIENT_NOT_CONNECTED,
@@ -1058,6 +1080,10 @@ static RPCHelpMan getblocktemplate() {
                 // send an expires-immediately template to stop miners?
             }
 
+            LOCK(cs_main);
+            Chainstate &active_chainstate = chainman.ActiveChainstate();
+            CChain &active_chain = active_chainstate.m_chain;
+
             // Update block
             static CBlockIndex *pindexPrev;
             static int64_t time_start;
@@ -1287,7 +1313,7 @@ static RPCHelpMan getblocktemplate() {
                 result.pushKV("rtt", std::move(rtt));
             }
 
-            return result;
+            co_return result;
         },
     };
 }
diff --git a/src/rpc/server.cpp b/src/rpc/server.cpp
