From d8203d7f6c3cc195c7edff53a7223a28ad810b05 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 16:22:37 -0700
Subject: [PATCH] build: match Chronik Debug lock-order definitions to native
 code

---
 chronik/CMakeLists.txt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/chronik/CMakeLists.txt b/chronik/CMakeLists.txt
index bb701df47b0762fb308acc7d581512bd3f73299c..b6325b531df6a920a0733748c6e3b624c4dcd909 100644
--- a/chronik/CMakeLists.txt
+++ b/chronik/CMakeLists.txt
@@ -3,6 +3,11 @@
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+# Match src/ Debug definitions for every C++ translation unit, including the
+# generated CXX bridges. sync.h defines inline lock operations differently with
+# DEBUG_LOCKORDER; mixing those definitions can pop an empty lock stack.
+add_compile_definitions_to_configuration(Debug DEBUG DEBUG_LOCKORDER ABORT_ON_FAILED_ASSUME)
+
 include(RustHelper)
 
 set(CHRONIK_CARGO_FLAGS --locked)
-- 
