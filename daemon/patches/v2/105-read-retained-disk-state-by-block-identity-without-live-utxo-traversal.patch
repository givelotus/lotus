+bool DiskStateStore::ReadRetainedState(const Hash &id, std::optional<RetainedDiskState> &out,
+                                       DiskStateError &error) const {
+    return Guard(error, [&] {
+        if (!impl_) Fail(DiskStateErrorCode::Closed, "closed store");
+        // Fence the cached tip against persisted state even for historical
+        // requests; an external change must never be silently served through.
+        const Value current = impl_->Read("S"); Require(current.has_value(), "missing retained current head");
+        Head head = ParseHead(*current, impl_->options);
+        Require(*current == EncodeHead(impl_->head, impl_->options), "persisted/cached head mismatch");
+        if (head.metadata.tip == id) {
+            out = RetainedDiskState{std::move(head.metadata), head.root.digest}; return;
+        }
+        const Value undo = impl_->Read(UndoKey(id));
+        if (!undo) { out.reset(); return; }
+        Reader r{*undo};
+        const Head before = ParseHead(r.Blob(), impl_->options);
+        Head after = ParseHead(r.Blob(), impl_->options);
+        Require(after.metadata.tip == id, "retained undo key/tip mismatch");
+        Require(before.metadata.tip != after.metadata.tip, "retained undo does not advance tip");
+        const uint64_t count = r.Int(); Require(count <= undo->size() / 10, "retained undo count");
+        Bytes previous_key;
+        for (uint64_t i = 0; i < count; ++i) {
+            const Bytes key = r.Blob(37);
+            Require((key.size() == 37 && key[0] == 'C') || (key.size() == 35 && key[0] == 'N'), "retained undo key");
+            Require(previous_key.empty() || key > previous_key, "retained undo key ordering"); previous_key = key;
+            const Value old_value = GetValue(r), next_value = GetValue(r);
+            Require(old_value != next_value, "retained undo no-op change");
+            ValidateRetainedValue(key, old_value); ValidateRetainedValue(key, next_value);
+        }
+        r.End();
+        // Historical row values naturally differ from live C/N records. Their
+        // local grammar is checked; no historical tree/consensus claim follows.
+        out = RetainedDiskState{std::move(after.metadata), after.root.digest};
+    });
+}
