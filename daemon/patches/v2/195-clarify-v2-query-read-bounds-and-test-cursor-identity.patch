From 5d320b0e92716595d16d387ee647bee6481665b7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:25:33 -0700
Subject: [PATCH] Clarify V2 query read bounds and test cursor identity

Maintenance explanation added during mailbox export:
Clarify how V2 branch query limits count reads and add cursor identity regressions. These checks prevent continuation tokens from being accepted under the wrong snapshot or query identity.

---
 .../chronik-indexer/src/query/v2_branches.rs  | 17 ++++-
 .../src/query/v2_branches_test/tests.rs       | 68 +++++++++++++++++++
 2 files changed, 84 insertions(+), 1 deletion(-)

diff --git a/chronik/chronik-indexer/src/query/v2_branches.rs b/chronik/chronik-indexer/src/query/v2_branches.rs
index 31152277a395059726d6dcc50519adbf6c45d847..95f37413c747b22e9d567251b3f34a4e6da335f0 100644
--- a/chronik/chronik-indexer/src/query/v2_branches.rs
+++ b/chronik/chronik-indexer/src/query/v2_branches.rs
@@ -17,7 +17,11 @@ pub struct BranchFilter {
 }
 #[derive(Clone, Copy, Debug, Eq, PartialEq)]
 pub enum QueryKind {
-    History { include_burn: bool },
+    /// Output creation/spend records, deduplicated by outpoint. This is not a
+    /// transaction history projection; multiple outputs may share a TxID.
+    History {
+        include_burn: bool,
+    },
     Utxos,
 }
 #[derive(Clone, Copy, Debug, Eq, PartialEq)]
@@ -41,6 +45,9 @@ pub struct Limits {
     pub clauses: usize,
     pub page_size: usize,
     pub posting_reads: usize,
+    /// Source read calls (posting seeks plus output lookups), not CPU time or
+    /// resident memory. Predicate/encoding work is bounded by request root caps
+    /// and the native 16-branch, 812-byte output grammar.
     pub work: usize,
     pub result_bytes: usize,
 }
@@ -75,6 +82,12 @@ pub trait PostingSource {
         position: Option<u8>,
         after: Option<OutPoint>,
     ) -> Result<Option<OutPoint>, QueryError>;
+    /// Return at most one native record. Enforce a fixed serialized record cap
+    /// before deserialization/allocation (2048 bytes suffices for this model),
+    /// and MAX_OUTPUT_BYTES before decoding the native output frame. Reject
+    /// malformed counts before allocating branch/path vectors. Never return
+    /// unchecked arbitrarily sized vectors: kernel validation occurs after the
+    /// source has already allocated its result. Database corruption is an error.
     fn output(&self, key: OutPoint)
         -> Result<Option<OutputRecord>, QueryError>;
 }
@@ -84,6 +97,8 @@ pub struct Match {
     pub matching_positions: Vec<u8>,
 }
 #[derive(Clone, Debug)]
+/// A page of complete output records, with each outpoint included at most once.
+/// `work` counts source read calls; response transport size is a separate bound.
 pub struct Page {
     pub snapshot: Snapshot,
     pub matches: Vec<Match>,
diff --git a/chronik/chronik-indexer/src/query/v2_branches_test/tests.rs b/chronik/chronik-indexer/src/query/v2_branches_test/tests.rs
index b9e8f02a9ca20b7ac1e67dd8b34943369e8a4f31..9281c60ff72af85ce6f8f5cded09ef559e2bf3f8 100644
--- a/chronik/chronik-indexer/src/query/v2_branches_test/tests.rs
+++ b/chronik/chronik-indexer/src/query/v2_branches_test/tests.rs
@@ -326,3 +326,71 @@ fn spent_token_history_and_missing_positions() {
     .matches
     .is_empty());
 }
+
+#[test]
+fn all_snapshot_components_bind_cursor() {
+    let s = source();
+    let f = BranchFilter {
+        any_branch: vec![root(1)],
+        positions: vec![],
+    };
+    let limits = Limits {
+        page_size: 1,
+        ..Limits::default()
+    };
+    let cursor = query(&s, &f, QueryKind::Utxos, limits, None)
+        .unwrap()
+        .continuation
+        .unwrap();
+    for component in 0..4 {
+        let mut changed = cursor;
+        match component {
+            0 => changed.snapshot.chain_id = root(90),
+            1 => changed.snapshot.profile_id = root(90),
+            2 => changed.snapshot.tip = root(90),
+            _ => changed.snapshot.height += 1,
+        }
+        assert!(matches!(
+            query(&s, &f, QueryKind::Utxos, limits, Some(changed)),
+            Err(QueryError::StaleCursor)
+        ));
+    }
+}
+
+#[test]
+fn matching_outputs_in_same_transaction_remain_distinct() {
+    let mut s = source();
+    let mut record = s.0.values().nth(1).unwrap().clone();
+    let first = record.outpoint;
+    record.outpoint.out_idx = 1;
+    let second = record.outpoint;
+    s.0.insert(second, record);
+    let f = BranchFilter {
+        any_branch: vec![root(1), root(9)],
+        positions: vec![],
+    };
+    let limits = Limits {
+        page_size: 1,
+        ..Limits::default()
+    };
+    let mut cursor = None;
+    let mut found = vec![];
+    loop {
+        let p = query(
+            &s,
+            &f,
+            QueryKind::History { include_burn: true },
+            limits,
+            cursor,
+        )
+        .unwrap();
+        found.extend(p.matches.into_iter().map(|m| m.record.outpoint));
+        cursor = p.continuation;
+        if cursor.is_none() {
+            break;
+        }
+    }
+    assert_eq!(found.iter().filter(|&&key| key == first).count(), 1);
+    assert_eq!(found.iter().filter(|&&key| key == second).count(), 1);
+    assert!(found.windows(2).all(|w| w[0] < w[1]));
+}
