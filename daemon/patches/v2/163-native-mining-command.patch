+    UniValue Node::MineBlock(const UniValue &request) {
+        std::optional<Hash> found_id;
+        bool retained = false;
+        const auto failure = [&](const std::string &category,
+                                 const std::string &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", category);
+            answer.pushKV("error", error.substr(0, 1024));
+            answer.pushKV("found", bool(found_id));
+            answer.pushKV("accepted", false);
+            answer.pushKV("pending_validation", retained);
+            if (found_id) {
+                answer.pushKV("block_id", Hex(*found_id));
+                answer.pushKV("retained_authenticated", retained);
+            }
+            return answer;
+        };
+        std::string failure_phase = "invalid_request";
+        try {
+            Keys(request, {"id", "command", "expected_parent", "time",
+                           "max_claim", "coinbase_output", "coinbase_data",
+                           "transactions", "start_nonce", "max_attempts"});
+            LocalBlockRequest block_request;
+            block_request.expected_parent = HashOf(request["expected_parent"]);
+            block_request.time = Number(request["time"], MAX_TIME);
+            block_request.max_claim = DecimalU64(request["max_claim"]);
+            const auto start = DecimalU64(request["start_nonce"]);
+            const auto attempts =
+                Number(request["max_attempts"], MAX_NONCE_ATTEMPTS);
+            Require(request["transactions"].isArray() &&
+                        request["transactions"].size() <= MaxTransactions - 1,
+                    "ordinary transaction count exceeds local capacity");
+            // Validate ALL aggregate byte/count bounds before copying hex or
+            // reserving the decoded transaction array. JSON parse/input storage
+            // retains its separate explicit line allowance.
+            uint64_t remaining = manifest.block_read_limit;
+            const auto destination_size =
+                HexSize(request["coinbase_output"], remaining);
+            Require(destination_size <= MAX_OUTPUT_BYTES,
+                    "coinbase output exceeds codec capacity");
+            remaining -= destination_size;
+            if (!request["coinbase_data"].isNull()) {
+                const auto size = HexSize(request["coinbase_data"],
+                                          std::min<uint64_t>(8192, remaining));
+                Require(size != 0, "present coinbase_data must be nonempty");
+                remaining -= size;
+            }
+            for (const auto &tx : request["transactions"].getValues()) {
+                const auto size = HexSize(tx, remaining);
+                Require(size != 0, "empty ordinary transaction frame");
+                remaining -= size;
+            }
+            const auto snapshot = runtime->Snapshot();
+            if (snapshot.reopen_required)
+                throw ProducerFailure("reopen_required",
+                                      "runtime authority requires reopening");
+            if (!snapshot.chain || snapshot.execution_paused)
+                throw ProducerFailure(
+                    "inconclusive", "runtime execution authority unavailable");
+            if (snapshot.chain->pending_journal ||
+                snapshot.chain->pending_receipt ||
+                snapshot.chain->pending_propagation)
+                throw ProducerFailure(
+                    "busy", "runtime recovery/receipt/propagation pending");
+            if (snapshot.chain->stable_tip != block_request.expected_parent)
+                throw ProducerFailure(
+                    "stale_parent",
+                    "expected parent is not the authoritative stable tip");
+            const auto now = Utc();
+            const auto future = [&](uint64_t time) {
+                return time > now && time - now > manifest.future_window;
+            };
+            if (future(block_request.time) ||
+                future(snapshot.chain->active_max_ancestor_time))
+                throw ProducerFailure("deferred",
+                                      "candidate or authenticated ancestor is "
+                                      "temporarily future");
+            std::string error;
+            const auto destination =
+                Unhex(request["coinbase_output"], MAX_OUTPUT_BYTES);
+            Require(DecodeOutput(destination,
+                                 block_request.coinbase_destination, error),
+                    error);
+            std::vector<uint8_t> canonical;
+            Require(EncodeOutput(block_request.coinbase_destination, canonical,
+                                 error) &&
+                        canonical == destination,
+                    "noncanonical coinbase output");
+            Require(block_request.coinbase_destination.flags == 0 &&
+                        block_request.coinbase_destination.value == 0,
+                    "coinbase_output must be native, spendable and have value "
+                    "zero");
+            if (!request["coinbase_data"].isNull())
+                block_request.coinbase_data =
+                    Unhex(request["coinbase_data"], 8192);
+            block_request.ordinary.reserve(request["transactions"].size());
+            for (const auto &encoded : request["transactions"].getValues()) {
+                const auto bytes = Unhex(encoded, manifest.block_read_limit);
+                Transaction tx;
+                if (!DecodeTransaction(bytes, manifest.op.transaction, tx,
+                                       error) ||
+                    !EncodeTransaction(tx, manifest.op.transaction, canonical,
+                                       error) ||
+                    canonical != bytes)
+                    throw ProducerFailure(
+                        "invalid_transactions",
+                        "noncanonical ordinary transaction: " + error);
+                if (std::any_of(tx.inputs.begin(), tx.inputs.end(),
+                                [](const Input &i) { return i.flags == 2; }))
+                    throw ProducerFailure(
+                        "invalid_transactions",
+                        "supplied ordinary list contains coinbase input");
+                block_request.ordinary.push_back(std::move(tx));
+            }
+            failure_phase = "inconclusive";
+            LocalBlockBuildResult build_status =
+                LocalBlockBuildResult::Inconclusive;
+            LocalBlockTemplate block;
+            const auto access = runtime->BuildTemplate(
+                block_request,
+                {MaxTransactions - 1, manifest.block_read_limit, 8192},
+                build_status, block, error);
+            if (access != Result::Progress)
+                throw ProducerFailure(
+                    RuntimeFailure(access),
+                    error.empty() ? "runtime assembly access refused" : error);
+            if (build_status != LocalBlockBuildResult::Ready) {
+                const auto category = [&]() -> std::string {
+                    switch (build_status) {
+                        case LocalBlockBuildResult::InvalidTransactions:
+                            return "invalid_transactions";
+                        case LocalBlockBuildResult::CapacityRefused:
+                            return "capacity_refused";
+                        case LocalBlockBuildResult::StaleParent:
+                            return "stale_parent";
+                        case LocalBlockBuildResult::StorageError:
+                            return "storage_error";
+                        default:
+                            return "inconclusive";
+                    }
+                }();
+                throw ProducerFailure(category, error);
+            }
+            LocalBlockTemplate mined;
+            const auto nonce = SearchLocalBlockNonce(
+                block, manifest.hp.chain_id, manifest.hp.pow_limit, start,
+                attempts, mined, error);
+            if (nonce == LocalNonceResult::Exhausted) {
+                auto answer = Status();
+                answer.pushKV("ok", true);
+                answer.pushKV("result", "nonce_exhausted");
+                answer.pushKV("found", false);
+                answer.pushKV("accepted", false);
+                answer.pushKV("pending_validation", false);
+                answer.pushKV("next_nonce",
+                              attempts > UINT64_MAX - start
+                                  ? UniValue()
+                                  : UniValue(std::to_string(start + attempts)));
+                return answer;
+            }
+            if (nonce != LocalNonceResult::Found || !mined.mined_id)
+                throw ProducerFailure(nonce == LocalNonceResult::CapacityRefused
+                                          ? "capacity_refused"
+                                          : "inconclusive",
+                                      error);
+            found_id = mined.mined_id;
+            // One additional bounded codec pass obtains the actual native
+            // coinbase identity/value, without returning a full block echo.
+            FramedBlock framed;
+            IdentityDigests ids;
+            Require(DecodeBlockWire(mined.wire, manifest.op.transaction,
+                                    manifest.hp.chain_id, framed, error) &&
+                        !framed.transactions.empty() &&
+                        framed.transactions[0].outputs.size() == 1 &&
+                        ComputeIdentities(framed.transactions[0],
+                                          manifest.op.transaction,
+                                          manifest.hp.chain_id, ids, error),
+                    "mined coinbase identity unavailable: " + error);
+            auto answer = SubmitBlock(mined.wire, &retained);
+            answer.pushKV("ok", true);
+            answer.pushKV("result", "pending_validation");
+            answer.pushKV("found", true);
+            answer.pushKV("nonce", std::to_string(mined.preview.header.nonce));
+            answer.pushKV("coinbase_txid", Hex(ids.txid));
+            answer.pushKV("coinbase_index", uint64_t{0});
+            answer.pushKV(
+                "coinbase_value",
+                std::to_string(framed.transactions[0].outputs[0].value));
+            return answer;
+        } catch (const ProducerFailure &error) {
+            return failure(error.result, error.what());
+        } catch (const std::bad_alloc &) {
+            return failure("capacity_refused",
+                           "local mining allocation capacity");
+        } catch (const std::length_error &) {
+            return failure("capacity_refused",
+                           "local mining allocation length");
+        } catch (const std::exception &error) {
+            return failure(failure_phase, error.what());
+        }
+    }
+    UniValue Node::ReadBlock(const UniValue &request) {
+        std::string phase = "invalid_request";
+        try {
+            Keys(request, {"id", "command", "block_id", "offset", "length"});
+            const auto id = HashOf(request["block_id"]);
+            const auto offset = Number(request["offset"], UINT32_MAX);
+            const auto length = Number(request["length"], 65536);
+            Require(length > 0, "readblock length must be1..65536");
+            phase = "inconclusive";
+            std::vector<uint8_t> body;
+            std::string error;
+            const auto result = runtime->ReadConnectedBody(
+                id, manifest.block_read_limit, body, error);
+            if (result != Result::Progress)
+                throw ProducerFailure(
+                    result == Result::MissingBody ||
+                            result == Result::MissingHeader
+                        ? "missing_body"
+                        : RuntimeFailure(result),
+                    error.empty() ? "connected body unavailable" : error);
+            if (offset > body.size())
+                throw ProducerFailure("invalid_request",
+                                      "readblock offset exceeds body size");
+            const auto count = std::min<uint64_t>(length, body.size() - offset);
+            auto answer = Status();
+            answer.pushKV("block_id", Hex(id));
+            answer.pushKV("offset", offset);
+            answer.pushKV("total_bytes", uint64_t(body.size()));
+            answer.pushKV("data", Hex(std::span<const uint8_t>(body).subspan(
+                                      offset, count)));
+            answer.pushKV("eof", offset + count == body.size());
+            answer.pushKV("ok", true);
+            return answer;
+        } catch (const ProducerFailure &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", error.result);
+            answer.pushKV("error", std::string(error.what()).substr(0, 1024));
+            return answer;
+        } catch (const std::bad_alloc &) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", "capacity_refused");
+            return answer;
+        } catch (const std::length_error &) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", "capacity_refused");
+            return answer;
+        } catch (const std::exception &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", phase);
+            answer.pushKV("error", std::string(error.what()).substr(0, 1024));
+            return answer;
+        }
+    }
