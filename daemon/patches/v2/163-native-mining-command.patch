+    uint64_t DecimalU64(const UniValue &v) {
+        Require(v.isStr(), "expected canonical decimal u64 string");
+        const auto &s = v.get_str();
+        Require(!s.empty() && s.size() <= 20 &&
+                    (s.size() == 1 || s.front() != '0'),
+                "noncanonical decimal u64 string");
+        uint64_t n = 0;
+        for (char c : s) {
+            Require(c >= '0' && c <= '9' &&
+                        n <= (UINT64_MAX - uint64_t(c - '0')) / 10,
+                    "decimal u64 outside range");
+            n = n * 10 + uint64_t(c - '0');
+        }
+        return n;
+    }
+    size_t HexSize(const UniValue &v, uint64_t cap) {
+        Require(v.isStr(), "expected lowercase hex string");
+        const auto &s = v.get_str();
+        Require(s.size() % 2 == 0 && s.size() / 2 <= cap,
+                "hex exceeds local aggregate capacity");
+        for (char c : s)
+            Require((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'),
+                    "expected lowercase hex");
+        return s.size() / 2;
+    }
+    struct ProducerFailure : std::runtime_error {
+        std::string result;
+        ProducerFailure(std::string category, const std::string &message)
+            : std::runtime_error(message), result(std::move(category)) {}
+    };
+    std::string RuntimeFailure(Result result) {
+        switch (result) {
+            case Result::Busy:
+                return "busy";
+            case Result::CapacityRefused:
+                return "capacity_refused";
+            case Result::ReopenRequired:
+                return "reopen_required";
+            case Result::StorageError:
+                return "storage_error";
+            default:
+                return "inconclusive";
+        }
+    }
