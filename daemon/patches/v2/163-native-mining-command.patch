+    UniValue Node::SubmitBlock(const std::vector<uint8_t> &wire,
+                               bool *retained) {
+        Header h;
+        Hash block;
+        Require(
+            ParseHeader(wire.data(), std::min(wire.size(), HEADER_SIZE), h) &&
+                BlockId(network.profile.chain_id, h, block),
+            "invalid block header framing");
