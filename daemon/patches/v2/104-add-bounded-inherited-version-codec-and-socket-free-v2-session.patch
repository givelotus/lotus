diff --git a/src/lotus_v2/peer_session.cpp b/src/lotus_v2/peer_session.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e551d4a8de2dd8b0027861f43106ec13c1e57ab8
--- /dev/null
+++ b/src/lotus_v2/peer_session.cpp
@@ -0,0 +1,336 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_session.h"
+#include <algorithm>
+#include <bit>
+#include <limits>
+#include <utility>
+namespace lotus::v2::peer {
+namespace {
+    bool Fail(std::string &e, const char *s) {
+        e = s;
+        return false;
+    }
+    void Put(Bytes &b, uint64_t n, unsigned width) {
+        for (unsigned i = 0; i < width; ++i)
+            b.push_back(uint8_t(n >> (8 * i)));
+    }
+    void Compact(Bytes &b, size_t n) {
+        if (n < 253)
+            Put(b, n, 1);
+        else {
+            b.push_back(253);
+            Put(b, n, 2);
+        }
+    }
+    void Address(Bytes &b, const VersionAddress &a) {
+        Put(b, a.services, 8);
+        b.insert(b.end(), a.address.begin(), a.address.end());
+        b.push_back(uint8_t(a.port >> 8));
+        b.push_back(uint8_t(a.port));
+    }
+    class Reader {
+    public:
+        explicit Reader(std::span<const uint8_t> b) : bytes_(b) {}
+        size_t Left() const { return bytes_.size() - offset_; }
+        bool Int(unsigned width, uint64_t &n) {
+            if (width > Left()) return false;
+            n = 0;
+            for (unsigned i = 0; i < width; ++i)
+                n |= uint64_t(bytes_[offset_++]) << (8 * i);
+            return true;
+        }
+        bool Addr(VersionAddress &a) {
+            uint64_t n;
+            if (!Int(8, a.services) || Left() < 18) return false;
+            std::copy_n(bytes_.begin() + offset_, 16, a.address.begin());
+            offset_ += 16;
+            if (!Int(1, n)) return false;
+            a.port = uint16_t(n << 8);
+            if (!Int(1, n)) return false;
+            a.port |= uint16_t(n);
+            return true;
+        }
+        bool Agent(Bytes &out) {
+            uint64_t n, lead;
+            if (!Int(1, lead)) return false;
+            if (lead < 253)
+                n = lead;
+            else {
+                unsigned width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+                if (!Int(width, n) || n < (width == 2   ? 253ULL
+                                           : width == 4 ? 65536ULL
+                                                        : 4294967296ULL))
+                    return false;
+            }
+            if (n > MAX_VERSION_USER_AGENT || n > Left()) return false;
+            out.assign(bytes_.begin() + offset_,
+                       bytes_.begin() + offset_ + size_t(n));
+            offset_ += size_t(n);
+            return true;
+        }
+
+    private:
+        std::span<const uint8_t> bytes_;
+        size_t offset_ = 0;
+    };
+    bool ApplicationCommand(const std::string &c) {
+        static constexpr const char *commands[] = {
+            "sendheaders", "sendcmpct",   "ping",      "pong",    "getaddr",
+            "addr",        "addrv2",      "inv",       "getdata", "notfound",
+            "getheaders",  "headers",     "getblocks", "tx",      "block",
+            "cmpctblock",  "getblocktxn", "blocktxn"};
+        return std::any_of(std::begin(commands), std::end(commands),
+                           [&](const char *known) { return c == known; });
+    }
+} // namespace
+bool EncodeVersion(const VersionMessage &v, Bytes &out, std::string &e) {
+    if (v.version < MIN_V2_PEER_VERSION)
+        return Fail(e, "obsolete peer version");
+    if ((!v.sender &&
+         (v.user_agent || v.starting_height || v.relay || v.extra_entropy)) ||
+        (!v.user_agent && (v.starting_height || v.relay || v.extra_entropy)) ||
+        (!v.starting_height && (v.relay || v.extra_entropy)) ||
+        (!v.relay && v.extra_entropy))
+        return Fail(e, "version optional suffix gap");
+    if (v.user_agent && v.user_agent->size() > MAX_VERSION_USER_AGENT)
+        return Fail(e, "version user agent limit");
+    Bytes b;
+    Put(b, uint32_t(v.version), 4);
+    Put(b, v.services, 8);
+    Put(b, uint64_t(v.timestamp), 8);
+    Address(b, v.receiver);
+    if (v.sender) {
+        Address(b, v.sender->address);
+        Put(b, v.sender->nonce, 8);
+    }
+    if (v.user_agent) {
+        Compact(b, v.user_agent->size());
+        b.insert(b.end(), v.user_agent->begin(), v.user_agent->end());
+    }
+    if (v.starting_height) Put(b, uint32_t(*v.starting_height), 4);
+    if (v.relay) Put(b, *v.relay, 1);
+    if (v.extra_entropy) Put(b, *v.extra_entropy, 8);
+    out = std::move(b);
+    e.clear();
+    return true;
+}
+bool DecodeVersion(std::span<const uint8_t> b, VersionMessage &out,
+                   std::string &e) {
+    if (b.size() > PRE_HELLO_LIMIT)
+        return Fail(e, "version transport capacity");
+    Reader r(b);
+    VersionMessage v;
+    uint64_t n;
+    if (!r.Int(4, n)) return Fail(e, "version prefix");
+    v.version = std::bit_cast<int32_t>(uint32_t(n));
+    if (v.version < MIN_V2_PEER_VERSION)
+        return Fail(e, "obsolete peer version");
+    if (!r.Int(8, v.services) || !r.Int(8, n) || !r.Addr(v.receiver))
+        return Fail(e, "version prefix");
+    v.timestamp = std::max(int64_t(0), std::bit_cast<int64_t>(n));
+    if (r.Left()) {
+        VersionSender s{};
+        if (!r.Addr(s.address) || !r.Int(8, s.nonce))
+            return Fail(e, "version sender/nonce");
+        v.sender = s;
+    }
+    if (r.Left()) {
+        Bytes agent;
+        if (!r.Agent(agent)) return Fail(e, "version user agent");
+        v.user_agent = std::move(agent);
+    }
+    if (r.Left()) {
+        if (!r.Int(4, n)) return Fail(e, "version starting height");
+        v.starting_height = std::bit_cast<int32_t>(uint32_t(n));
+    }
+    if (r.Left()) {
+        if (!r.Int(1, n)) return Fail(e, "version relay");
+        v.relay = n != 0;
+    }
+    if (r.Left()) {
+        if (!r.Int(8, n)) return Fail(e, "version entropy");
+        v.extra_entropy = n;
+    }
+    v.ignored_suffix_bytes =
+        r.Left(); // ABC deliberately ignores a bounded tail.
+    out = std::move(v);
+    e.clear();
+    return true;
+}
+Session::Session(SessionConfig c)
+    : config_(std::move(c)), decoder_(config_.network) {}
+SessionEvent Session::Stop(SessionResult result, std::string reason) {
+    state_ = SessionState::Closed;
+    decoder_.Reset();
+    peer_version_.reset();
+    return {result, {}, std::nullopt, std::move(reason)};
+}
+std::optional<SessionEvent> Session::CheckTime(uint64_t now) {
+    if (state_ == SessionState::New)
+        return Stop(SessionResult::LocalFailure, "session not opened");
+    if (state_ == SessionState::Closed)
+        return SessionEvent{SessionResult::Closed, {}, std::nullopt, {}};
+    if (now < last_ms_)
+        return Stop(SessionResult::LocalFailure,
+                    "monotonic clock moved backwards");
+    last_ms_ = now;
+    if (state_ == SessionState::Handshaking && now >= deadline_ms_)
+        return Stop(SessionResult::TimedOut, "handshake deadline");
+    return std::nullopt;
+}
+bool Session::QueueHandshake(const Message &m, SessionEvent &event,
+                             std::string &error) {
+    Bytes bytes;
+    if (!EncodeHandshakeEnvelope(config_.network, m, bytes, error))
+        return false;
+    if (event.outbound.size() >= 2)
+        return Fail(error, "handshake action quota");
+    event.outbound.push_back(std::move(bytes));
+    return true;
+}
+SessionEvent Session::OnOpen(uint64_t now) {
+    if (state_ != SessionState::New)
+        return Stop(SessionResult::LocalFailure, "session already opened");
+    if (!config_.handshake_timeout_ms ||
+        config_.handshake_timeout_ms > UINT64_MAX - now)
+        return Stop(SessionResult::LocalFailure,
+                    "handshake timeout configuration");
+    if (!config_.local_version.Complete() || config_.local_version.services ||
+        config_.local_version.receiver.services ||
+        (config_.local_version.sender &&
+         config_.local_version.sender->address.services))
+        return Stop(SessionResult::LocalFailure,
+                    "complete version with zero services required");
+    if (config_.inbound && !config_.incoming_nonce_allowed)
+        return Stop(SessionResult::LocalFailure,
+                    "inbound nonce check required");
+    Bytes payload;
+    std::string e;
+    if (!EncodeVersion(config_.local_version, payload, e))
+        return Stop(SessionResult::LocalFailure, e);
+    SessionEvent event;
+    event.result = SessionResult::Send;
+    if (!QueueHandshake({"version", std::move(payload)}, event, e))
+        return Stop(SessionResult::LocalFailure, e);
+    last_ms_ = now;
+    deadline_ms_ = now + config_.handshake_timeout_ms;
+    state_ = SessionState::Handshaking;
+    sent_version_ = true;
+    return event;
+}
+SessionEvent Session::Feed(std::span<const uint8_t> b, uint64_t now,
+                           size_t &consumed) {
+    consumed = 0;
+    if (auto failure = CheckTime(now)) return std::move(*failure);
+    Message message;
+    std::string e;
+    auto result = decoder_.Feed(b, consumed, message, e);
+    if (result == FeedStatus::InvalidPeerMessage)
+        return Stop(SessionResult::PeerRejected, e);
+    if (result == FeedStatus::Incomplete) return {};
+    return Handle(std::move(message));
+}
+SessionEvent Session::Handle(Message message) {
+    const auto &command = message.command;
+    std::string e;
+    SessionEvent event;
+    if (command == "version") {
+        // Upstream ignores duplicate version without parsing or side effects.
+        if (peer_version_) {
+            event.result = SessionResult::Ignored;
+            return event;
+        }
+        VersionMessage peer;
+        if (!DecodeVersion(message.payload, peer, e))
+            return Stop(SessionResult::PeerRejected, e);
+        if (config_.inbound) {
+            bool allowed;
+            try {
+                allowed = config_.incoming_nonce_allowed(peer.Nonce());
+            } catch (...) {
+                return Stop(SessionResult::LocalFailure,
+                            "nonce check failed operationally");
+            }
+            if (!allowed)
+                return Stop(SessionResult::PeerRejected,
+                            "self connection nonce");
+        }
+        Hello hello;
+        hello.chain_id = config_.network.chain_id;
+        hello.genesis_id = config_.network.genesis_id;
+        hello.profile_digest = config_.network.profile_digest;
+        hello.receive_limit = config_.network.receive_limit;
+        Bytes payload;
+        if (!EncodeHello(hello, payload, e))
+            return Stop(SessionResult::LocalFailure, e);
+        if (!QueueHandshake({"v2hello", std::move(payload)}, event, e))
+            return Stop(SessionResult::LocalFailure, e);
+        if (config_.send_address_v2 &&
+            !QueueHandshake({"sendaddrv2", {}}, event, e))
+            return Stop(SessionResult::LocalFailure, e);
+        peer_version_ = std::move(peer);
+        sent_hello_ = true;
+        event.result = SessionResult::Send;
+        return event;
+    }
+    if (!peer_version_)
+        return Stop(SessionResult::PeerRejected, "version required first");
+    if (command == "v2hello") {
+        if (received_hello_)
+            return Stop(SessionResult::PeerRejected, "duplicate v2hello");
+        Hello hello;
+        if (!DecodeHello(message.payload, hello, e) ||
+            !NegotiateHello(config_.network, hello, negotiated_limit_, e))
+            return Stop(SessionResult::PeerRejected, e);
+        if (!QueueHandshake({"verack", {}}, event, e))
+            return Stop(SessionResult::LocalFailure, e);
+        received_hello_ = true;
+        sent_verack_ = true;
+        event.result = SessionResult::Send;
+        return event;
+    }
+    if (command == "verack") {
+        if (!received_hello_)
+            return Stop(SessionResult::PeerRejected,
+                        "verack before accepted v2hello");
+        if (received_verack_) {
+            event.result = SessionResult::Ignored;
+            return event;
+        }
+        received_verack_ = true;
+        if (!sent_version_ || !sent_hello_ || !sent_verack_)
+            return Stop(SessionResult::LocalFailure,
+                        "incomplete local handshake");
+        if (!decoder_.SetActiveLimit(negotiated_limit_, e))
+            return Stop(SessionResult::LocalFailure, e);
+        state_ = SessionState::Active;
+        event.result = SessionResult::Activated;
+        return event;
+    }
+    if (command == "sendaddrv2") {
+        wants_address_v2_ = true;
+        event.result = SessionResult::Ignored;
+        return event;
+    }
+    if (state_ != SessionState::Active)
+        return Stop(SessionResult::PeerRejected,
+                    "application before activation");
+    // Explicit allowlist keeps inherited Bloom, filters, Avalanche, snapshots,
+    // package/mempool enumeration and feefilter handlers unavailable. Unknown
+    // optional commands are ignored after bounded envelope verification.
+    if (!ApplicationCommand(command)) {
+        event.result = SessionResult::Ignored;
+        return event;
+    }
+    event.result = SessionResult::Application;
+    event.application = std::move(message);
+    return event;
+}
+SessionEvent Session::OnTimer(uint64_t now) {
+    if (auto failure = CheckTime(now)) return std::move(*failure);
+    return {};
+}
+SessionEvent Session::OnClosed() {
+    return Stop(SessionResult::Closed, "connection closed");
+}
+} // namespace lotus::v2::peer
