+void SentinelAndControlMessages() {
+    auto c = Config();
+    c.inbound = true;
+    uint64_t observed = 0;
+    c.incoming_nonce_allowed = [&](uint64_t nonce) {
+        observed = nonce;
+        return nonce != 1;
+    };
+    Session absent_nonce(c);
+    absent_nonce.OnOpen(100);
+    auto minimal = VersionBytes();
+    minimal.resize(46);
+    CHECK(Send(absent_nonce, {"version", minimal}).result ==
+          SessionResult::PeerRejected);
+    CHECK(observed == 1); // inherited missing-group sentinel reaches checker
+    auto nonempty_control = [&](const std::string &command) {
+        // Build a checksum-valid frame bypassing the *encoder's* empty-command
+        // guard, so the session's receive path exercises the same bound.
+        auto bytes = Frame({"unknown", {1}});
+        std::fill(bytes.begin() + 4, bytes.begin() + 16, 0);
+        std::copy(command.begin(), command.end(), bytes.begin() + 4);
+        return bytes;
+    };
+    Session verack(Config());
+    Activate(verack);
+    size_t used;
+    auto bytes = nonempty_control("verack");
+    CHECK(verack.Feed(bytes, 101, used).result == SessionResult::PeerRejected &&
+          used == 24);
+    Session address(Config());
+    address.OnOpen(100);
+    Send(address, {"version", VersionBytes()});
+    bytes = nonempty_control("sendaddrv2");
+    CHECK(address.Feed(bytes, 101, used).result ==
+              SessionResult::PeerRejected &&
+          used == 24);
+    Session suffix(Config());
+    suffix.OnOpen(100);
+    auto extended = VersionBytes();
+    extended.resize(PRE_HELLO_LIMIT, 0x91);
+    CHECK(Send(suffix, {"version", extended}).result == SessionResult::Send);
+    CHECK(suffix.PeerVersion()->ignored_suffix_bytes ==
+          PRE_HELLO_LIMIT - VersionBytes().size());
+}
+void TwoSessionExchange() {
+    auto a_config = Config();
+    a_config.local_version.sender->nonce = 11;
+    a_config.local_version.relay = false;
+    auto b_config = Config();
+    b_config.local_version.sender->nonce = 22;
+    b_config.inbound = true;
+    b_config.send_address_v2 = true;
+    size_t nonce_checks = 0;
+    b_config.incoming_nonce_allowed = [&](uint64_t nonce) {
+        ++nonce_checks;
+        return nonce != 22;
+    };
+    Session a(a_config), b(b_config);
+    struct Delivery {
+        Session *receiver;
+        Bytes bytes;
+    };
+    std::vector<Delivery> queue;
+    for (auto &wire : a.OnOpen(100).outbound)
+        queue.push_back({&b, std::move(wire)});
+    for (auto &wire : b.OnOpen(100).outbound)
+        queue.push_back({&a, std::move(wire)});
+    size_t index = 0;
+    while (index < queue.size()) {
+        CHECK(queue.size() <= 10);
+        Delivery delivery = std::move(queue[index++]);
+        size_t used;
+        auto event = delivery.receiver->Feed(delivery.bytes, 101, used);
+        CHECK(used == delivery.bytes.size());
+        CHECK(event.result == SessionResult::Send ||
+              event.result == SessionResult::Ignored ||
+              event.result == SessionResult::Activated);
+        for (auto &wire : event.outbound)
+            queue.push_back(
+                {delivery.receiver == &a ? &b : &a, std::move(wire)});
+    }
+    CHECK(a.State() == SessionState::Active &&
+          b.State() == SessionState::Active);
+    CHECK(nonce_checks == 1 && a.PeerWantsAddressV2() &&
+          !b.PeerVersion()->Relay());
+    CHECK(a.PeerVersion()->services == 0 && b.PeerVersion()->services == 0);
+}
+void SplitAndCoalescedLimits() {
+    auto version = Frame({"version", VersionBytes()});
+    for (size_t split = 0; split <= version.size(); ++split) {
+        Session s(Config());
+        s.OnOpen(100);
+        size_t used;
+        auto event = s.Feed(std::span(version).first(split), 101, used);
+        CHECK(used == split);
+        if (split < version.size()) {
+            CHECK(event.result == SessionResult::Idle);
+            event = s.Feed(std::span(version).subspan(split), 101, used);
+            CHECK(used == version.size() - split);
+        }
+        CHECK(event.result == SessionResult::Send);
+    }
+    for (uint32_t limit : {1U, 117U, 118U}) {
+        auto c = Config(limit);
+        Session s(c);
+        CHECK(s.OnOpen(100).result == SessionResult::Send);
+        CHECK(Send(s, {"version", VersionBytes()}).result ==
+              SessionResult::Send);
+        CHECK(Send(s, {"v2hello", HelloBytes(Profile(limit))}).result ==
+              SessionResult::Send);
+        auto verack = Frame({"verack", {}});
+        auto app = Frame({"tx", Bytes(limit + 1, 0)});
+        Bytes coalesced = verack;
+        coalesced.insert(coalesced.end(), app.begin(), app.end());
+        size_t used;
+        CHECK(s.Feed(coalesced, 101, used).result == SessionResult::Activated &&
+              used == verack.size() && s.ActiveLimit() == limit);
+        auto result = s.Feed(std::span(coalesced).subspan(used), 101, used);
+        CHECK(result.result == SessionResult::PeerRejected && used == 24);
+        Session exact(c);
+        Activate(exact, limit);
+        auto event = Send(exact, {"tx", Bytes(limit, 0)});
+        CHECK(event.result == SessionResult::Application &&
+              event.application->payload.size() == limit);
+    }
+    Session asymmetric(Config(118));
+    Activate(asymmetric, 117);
+    CHECK(asymmetric.ActiveLimit() == 117);
+    Session partial(Config());
+    partial.OnOpen(100);
+    size_t used;
+    CHECK(partial.Feed(std::span(version).first(1), 101, used).result ==
+          SessionResult::Idle);
+    CHECK(partial.OnTimer(10100).result == SessionResult::TimedOut);
+}
+} // namespace
