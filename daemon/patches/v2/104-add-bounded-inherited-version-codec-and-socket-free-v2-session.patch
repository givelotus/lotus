+    Session backwards(Config());
+    backwards.OnOpen(100);
+    CHECK(backwards.OnTimer(99).result == SessionResult::LocalFailure);
+    Session not_open(Config());
+    size_t used = 99;
+    CHECK(not_open.Feed({}, 0, used).result == SessionResult::LocalFailure &&
