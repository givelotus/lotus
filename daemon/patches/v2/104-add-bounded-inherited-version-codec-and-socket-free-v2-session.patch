+// Copyright (c) 2026 The Lotus developers
+#include "peer_session.h"
+#include <iostream>
+#include <stdexcept>
+using namespace lotus::v2;
+using namespace lotus::v2::peer;
+#define CHECK(c)                                                               \
+    do {                                                                       \
+        if (!(c))                                                              \
+            throw std::runtime_error("line " + std::to_string(__LINE__) +      \
+                                     ": " #c);                                 \
