new file mode 100644
index 0000000000000000000000000000000000000000..574ac9ec0aee37eac187824e4a05d2e75565ad74
--- /dev/null
+++ b/src/lotus_v2/peer_session.h
@@ -0,0 +1,119 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_PEER_SESSION_H
+#define LOTUS_V2_PEER_SESSION_H
+#include "peer_codec.h"
+#include <functional>
+#include <optional>
+namespace lotus::v2::peer {
+constexpr int32_t MIN_V2_PEER_VERSION = 70017;
+constexpr size_t MAX_VERSION_USER_AGENT = 256;
+struct VersionAddress {
+    uint64_t services = 0;
+    std::array<uint8_t, 16> address{};
+    uint16_t port = 0; // network byte order on the wire
+};
+struct VersionSender {
+    VersionAddress address;
+    uint64_t nonce;
+};
+// Required 46-byte prefix followed by contiguous optional suffix groups.
+// Decoding supplies the same absent-field defaults as ABC through accessors.
+struct VersionMessage {
+    int32_t version = MIN_V2_PEER_VERSION;
+    uint64_t services = 0;
+    int64_t timestamp = 0;
+    VersionAddress receiver;
+    std::optional<VersionSender> sender;
+    std::optional<Bytes> user_agent;
+    std::optional<int32_t> starting_height;
+    std::optional<bool> relay;
+    std::optional<uint64_t> extra_entropy;
+    size_t ignored_suffix_bytes = 0;
+    uint64_t Nonce() const { return sender ? sender->nonce : 1; }
+    uint64_t ExtraEntropy() const { return extra_entropy.value_or(1); }
+    int32_t StartingHeight() const { return starting_height.value_or(-1); }
+    bool Relay() const { return relay.value_or(true); }
+    bool Complete() const {
+        return sender && user_agent && starting_height && relay &&
+               extra_entropy;
+    }
+};
+// Preserve inherited optional-group parsing, any-nonzero relay interpretation,
+// negative-time normalization and bounded ignored trailing suffix. No address
+// time field appears. Failure leaves output unchanged. Encoder emits known
+// fields only; ignored_suffix_bytes is diagnostic, not a serialized extension.
+bool EncodeVersion(const VersionMessage &, Bytes &, std::string &);
+bool DecodeVersion(std::span<const uint8_t>, VersionMessage &, std::string &);
+struct SessionConfig {
+    NetworkProfile network;
+    VersionMessage local_version; // complete modern form; all service fields 0
+    bool inbound = false;
+    bool send_address_v2 = false;
+    uint64_t handshake_timeout_ms = 0; // caller-selected, positive
+    // Required for inbound sessions. Matches CConnman::CheckIncomingNonce:
+    // false identifies a local outstanding outbound nonce/self-connection.
+    // As upstream does, an omitted sender group still passes default nonce 1.
+    std::function<bool(uint64_t)> incoming_nonce_allowed;
+};
+enum class SessionState { New, Handshaking, Active, Closed };
+enum class SessionResult {
+    Idle,
+    Send,
+    Activated,
+    Application,
+    Ignored,
+    PeerRejected,
+    LocalFailure,
+    TimedOut,
+    Closed
+};
+struct SessionEvent {
+    SessionResult result = SessionResult::Idle;
+    // At most two complete handshake frames per event. Caller atomically
+    // enqueues these in order into its bounded output queue or closes session.
+    std::vector<Bytes> outbound;
+    std::optional<Message> application; // complete envelope, unvalidated body
+    std::string reason;
+};
+// Socket-free single-owner session. Monotonic milliseconds and local version
+// nonce/entropy are injected. No profile selection, I/O, randomness, discovery,
+// service claim, transaction validation or chain mutation happens here.
+// Feed emits at most one event/message and reports input consumed. Re-feed the
+// remainder: final verack activation switches limits before a coalesced next
+// frame is parsed. Allocation failure is operational and caller closes session.
+class Session {
+public:
+    explicit Session(SessionConfig);
+    Session(const Session &) = delete;
+    Session &operator=(const Session &) = delete;
+    SessionEvent OnOpen(uint64_t monotonic_ms);
+    SessionEvent Feed(std::span<const uint8_t>, uint64_t monotonic_ms,
+                      size_t &consumed);
+    SessionEvent OnTimer(uint64_t monotonic_ms);
+    SessionEvent OnClosed();
+    SessionState State() const { return state_; }
+    uint32_t ActiveLimit() const {
+        return state_ == SessionState::Active ? negotiated_limit_ : 0;
+    }
+    const std::optional<VersionMessage> &PeerVersion() const {
+        return peer_version_;
+    }
+    bool PeerWantsAddressV2() const { return wants_address_v2_; }
+
+private:
+    SessionEvent Handle(Message);
+    SessionEvent Stop(SessionResult, std::string);
+    std::optional<SessionEvent> CheckTime(uint64_t);
+    bool QueueHandshake(const Message &, SessionEvent &, std::string &);
+    SessionConfig config_;
+    EnvelopeDecoder decoder_;
+    SessionState state_ = SessionState::New;
+    uint64_t last_ms_ = 0, deadline_ms_ = 0;
+    uint32_t negotiated_limit_ = 0;
+    std::optional<VersionMessage> peer_version_;
+    bool sent_version_ = false, sent_hello_ = false, received_hello_ = false;
+    bool sent_verack_ = false, received_verack_ = false,
+         wants_address_v2_ = false;
+};
+} // namespace lotus::v2::peer
+#endif
