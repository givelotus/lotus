+namespace {
+Bytes Hex(const std::string &hex) {
+    CHECK(hex.size() % 2 == 0);
+    Bytes b;
+    auto digit = [](char c) -> uint8_t {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        throw std::runtime_error("bad hex");
+    };
+    for (size_t i = 0; i < hex.size(); i += 2)
+        b.push_back(uint8_t(digit(hex[i]) * 16 + digit(hex[i + 1])));
+    return b;
+}
+NetworkProfile Profile(uint32_t limit = PRE_HELLO_LIMIT) {
+    NetworkProfile p{};
+    p.magic = {0x23, 0x41, 0x59,
+               0x67}; // arbitrary test bytes, no network allocation
+    p.chain_id[0] = 21;
+    p.genesis_id[0] = 22;
+    p.profile_digest[0] = 23;
+    p.receive_limit = limit;
+    p.transaction = {32, 32, 8, 8192, 16, 8192, 64};
+    p.max_reconstruction_transactions = 1000;
+    p.max_reconstruction_bytes = 4 * 1024 * 1024;
+    return p;
+}
+VersionMessage Modern() {
+    VersionMessage v;
+    v.timestamp = 123456;
+    v.sender = VersionSender{VersionAddress{}, 0x12345678};
+    v.user_agent = Bytes{'a', 'b', 'c'};
+    v.starting_height = 0;
+    v.relay = true;
+    v.extra_entropy = 0x99887766;
+    return v;
+}
+SessionConfig Config(uint32_t limit = PRE_HELLO_LIMIT) {
+    SessionConfig c;
+    c.network = Profile(limit);
+    c.local_version = Modern();
+    c.handshake_timeout_ms = 10000;
+    return c;
+}
+Bytes VersionBytes() {
+    Bytes b;
+    std::string e;
+    CHECK(EncodeVersion(Modern(), b, e));
+    return b;
+}
+Bytes HelloBytes(const NetworkProfile &p) {
+    Hello h;
+    h.chain_id = p.chain_id;
+    h.genesis_id = p.genesis_id;
+    h.profile_digest = p.profile_digest;
+    h.receive_limit = p.receive_limit;
+    Bytes b;
+    std::string e;
+    CHECK(EncodeHello(h, b, e));
+    return b;
+}
+Bytes Frame(const Message &m) {
+    Bytes b;
+    std::string e;
+    auto p = Profile();
+    if (m.command == "version" || m.command == "v2hello" ||
+        m.command == "verack" || m.command == "sendaddrv2")
+        CHECK(EncodeHandshakeEnvelope(p, m, b, e));
+    else
+        CHECK(EncodeEnvelope(p, p.receive_limit, m, b, e));
+    return b;
+}
+Message Unframe(const Bytes &b) {
+    EnvelopeDecoder decoder(Profile());
+    size_t n;
+    Message m;
+    std::string e;
+    CHECK(decoder.Feed(b, n, m, e) == FeedStatus::MessageReady &&
+          n == b.size());
+    return m;
+}
+SessionEvent Send(Session &s, const Message &m, uint64_t time = 101) {
+    auto b = Frame(m);
+    size_t n;
+    auto event = s.Feed(b, time, n);
+    CHECK(n <= b.size());
+    return event;
+}
+void Activate(Session &s, uint32_t peer_limit = PRE_HELLO_LIMIT) {
+    CHECK(s.OnOpen(100).result == SessionResult::Send);
+    auto v = Send(s, {"version", VersionBytes()});
+    CHECK(v.result == SessionResult::Send);
+    auto h = Send(s, {"v2hello", HelloBytes(Profile(peer_limit))});
+    CHECK(h.result == SessionResult::Send);
+    CHECK(Send(s, {"verack", {}}).result == SessionResult::Activated);
+    CHECK(s.State() == SessionState::Active);
+}
+void VersionVectors() {
+    // Literal independent wire assembly: fixed-width LE integers, BE ports,
+    // no CAddress time field, arbitrary raw user-agent bytes accepted.
+    const Bytes literal = Hex("81110100"
+                              "0807060504030201"
+                              "ffffffffffffffff"
+                              "0807060504030201"
+                              "000102030405060708090a0b0c0d0e0f"
+                              "1234"
+                              "1817161514131211"
+                              "101112131415161718191a1b1c1d1e1f"
+                              "abcd"
+                              "2827262524232221"
+                              "03616263"
+                              "feffffff"
+                              "02"
+                              "3837363534333231");
+    CHECK(literal.size() == 97);
+    VersionMessage decoded;
+    std::string e;
+    CHECK(DecodeVersion(literal, decoded, e));
+    CHECK(decoded.version == 70017 &&
+          decoded.services == 0x0102030405060708ULL);
+    CHECK(decoded.timestamp == 0 && decoded.receiver.port == 0x1234 &&
+          decoded.sender->address.port == 0xabcd);
+    CHECK(decoded.Nonce() == 0x2122232425262728ULL &&
+          decoded.ExtraEntropy() == 0x3132333435363738ULL);
+    CHECK(decoded.StartingHeight() == -2 && decoded.Relay() &&
+          decoded.Complete());
+    // Match upstream's exact optional cutoffs. Every partial group rejects.
+    for (size_t n = 0; n <= literal.size(); ++n) {
+        VersionMessage out;
+        out.version = 99999;
+        const bool valid =
+            n == 46 || n == 80 || n == 84 || n == 88 || n == 89 || n == 97;
+        CHECK(DecodeVersion(std::span(literal).first(n), out, e) == valid);
+        if (!valid) CHECK(out.version == 99999);
+    }
+    CHECK(DecodeVersion(std::span(literal).first(46), decoded, e));
+    CHECK(decoded.Nonce() == 1 && decoded.ExtraEntropy() == 1 &&
+          decoded.StartingHeight() == -1 && decoded.Relay() &&
+          !decoded.Complete());
+    auto wire = literal;
+    wire.push_back(0x99);
+    wire.push_back(0xff);
+    CHECK(DecodeVersion(wire, decoded, e) && decoded.ignored_suffix_bytes == 2);
+    wire.resize(PRE_HELLO_LIMIT, 0x91);
+    CHECK(DecodeVersion(wire, decoded, e) &&
+          decoded.ignored_suffix_bytes == PRE_HELLO_LIMIT - 97);
+    wire.push_back(0);
+    CHECK(!DecodeVersion(wire, decoded, e));
+    auto source = Modern();
+    source.services = 0x0102030405060708ULL;
+    source.timestamp = 0x01020304;
+    source.receiver.services = source.services;
+    source.receiver.port = 0x1234;
+    source.sender->address.services = 0x1112131415161718ULL;
+    source.sender->address.port = 0xabcd;
+    source.sender->nonce = 0x2122232425262728ULL;
+    source.starting_height = -2;
+    source.extra_entropy = 0x3132333435363738ULL;
+    for (size_t i = 0; i < 16; ++i) {
+        source.receiver.address[i] = uint8_t(i);
+        source.sender->address.address[i] = uint8_t(i + 16);
+    }
+    auto expected = literal;
+    std::fill(expected.begin() + 12, expected.begin() + 20, 0);
+    expected[12] = 4;
+    expected[13] = 3;
+    expected[14] = 2;
+    expected[15] = 1;
+    expected[88] = 1;
+    CHECK(EncodeVersion(source, wire, e) && wire == expected);
+    for (size_t length : {0U, 252U, 253U, 256U}) {
+        source.user_agent = Bytes(length, 0xff);
+        CHECK(EncodeVersion(source, wire, e));
+        CHECK(wire.size() == 93 + (length < 253 ? 1 : 3) + length);
+        CHECK(DecodeVersion(wire, decoded, e) &&
+              decoded.user_agent->size() == length);
+    }
+    source.user_agent = Bytes(257, 0);
+    CHECK(!EncodeVersion(source, wire, e));
+    wire = literal;
+    wire[80] = 253;
+    wire.insert(wire.begin() + 81, {3, 0});
+    CHECK(!DecodeVersion(wire, decoded, e));
+    wire = literal;
+    wire[80] = 253;
+    wire.insert(wire.begin() + 81, {1, 1});
+    CHECK(!DecodeVersion(wire, decoded, e));
+    wire = literal;
+    wire[0] = 0x80;
+    CHECK(!DecodeVersion(wire, decoded, e)); // 70016
+    source = Modern();
+    source.version = 70016;
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.sender.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.user_agent.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.starting_height.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.relay.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+}
+void HandshakeAndDispatch() {
+    auto c = Config();
+    c.send_address_v2 = true;
+    Session s(c);
+    auto open = s.OnOpen(100);
+    CHECK(open.result == SessionResult::Send && open.outbound.size() == 1);
+    auto local = Unframe(open.outbound[0]);
+    VersionMessage version;
+    std::string e;
+    CHECK(local.command == "version" &&
+          DecodeVersion(local.payload, version, e) && version.Complete());
+    CHECK(version.services == 0 && version.receiver.services == 0 &&
+          version.sender->address.services == 0);
+    auto event = Send(s, {"version", VersionBytes()});
+    CHECK(event.result == SessionResult::Send && event.outbound.size() == 2);
+    CHECK(Unframe(event.outbound[0]).command == "v2hello" &&
+          Unframe(event.outbound[1]).command == "sendaddrv2");
+    CHECK(s.State() == SessionState::Handshaking && s.ActiveLimit() == 0);
+    // Duplicate version ignores even a malformed known payload, as upstream.
+    CHECK(Send(s, {"version", {0}}).result == SessionResult::Ignored);
+    CHECK(s.PeerVersion()->Nonce() == Modern().Nonce());
+    CHECK(Send(s, {"sendaddrv2", {}}).result == SessionResult::Ignored &&
+          s.PeerWantsAddressV2());
+    event = Send(s, {"v2hello", HelloBytes(c.network)});
+    CHECK(event.result == SessionResult::Send && event.outbound.size() == 1 &&
+          Unframe(event.outbound[0]).command == "verack");
+    CHECK(s.State() == SessionState::Handshaking && s.ActiveLimit() == 0);
+    CHECK(Send(s, {"verack", {}}).result == SessionResult::Activated &&
+          s.State() == SessionState::Active);
+    CHECK(Send(s, {"verack", {}}).result == SessionResult::Ignored);
+    CHECK(Send(s, {"version", {}}).result == SessionResult::Ignored);
+    for (const auto *command :
+         {"mempool", "filterload", "filteradd", "filterclear", "getcfheaders",
+          "avapoll", "feefilter", "unknown"})
+        CHECK(Send(s, {command, {1, 2, 3}}).result == SessionResult::Ignored);
+    for (const auto *command :
+         {"tx", "block", "headers", "cmpctblock", "blocktxn"}) {
+        event = Send(s, {command, {1}});
+        CHECK(event.result == SessionResult::Application && event.application &&
+              event.application->command == command &&
+              event.application->payload == Bytes{1});
+    }
+    // An application event is merely an envelope, never a validated object.
+    CHECK(Send(s, {"v2hello", HelloBytes(c.network)}).result ==
+              SessionResult::PeerRejected &&
+          s.State() == SessionState::Closed);
+    CHECK(s.OnClosed().result == SessionResult::Closed);
+}
+void RejectOrderingAndIdentity() {
+    for (const auto *first :
+         {"v2hello", "verack", "sendaddrv2", "tx", "unknown"}) {
+        Session s(Config());
+        CHECK(s.OnOpen(100).result == SessionResult::Send);
+        Bytes payload;
+        if (std::string(first) == "v2hello") payload = HelloBytes(Profile());
+        CHECK(Send(s, {first, payload}).result == SessionResult::PeerRejected &&
+              s.State() == SessionState::Closed);
+    }
+    for (const auto *second : {"verack", "tx", "sendheaders", "unknown"}) {
+        Session s(Config());
+        s.OnOpen(100);
+        CHECK(Send(s, {"version", VersionBytes()}).result ==
+              SessionResult::Send);
+        CHECK(Send(s, {second, {}}).result == SessionResult::PeerRejected);
+    }
+    Session duplicate(Config());
+    duplicate.OnOpen(100);
+    Send(duplicate, {"version", VersionBytes()});
+    CHECK(Send(duplicate, {"v2hello", HelloBytes(Profile())}).result ==
+          SessionResult::Send);
+    CHECK(Send(duplicate, {"v2hello", HelloBytes(Profile())}).result ==
+          SessionResult::PeerRejected);
+    Session mismatch(Config());
+    mismatch.OnOpen(100);
+    Send(mismatch, {"version", VersionBytes()});
+    auto wrong = Profile();
+    wrong.genesis_id[0] ^= 1;
+    CHECK(Send(mismatch, {"v2hello", HelloBytes(wrong)}).result ==
+          SessionResult::PeerRejected);
+    Session unknown_features(Config());
+    unknown_features.OnOpen(100);
+    Send(unknown_features, {"version", VersionBytes()});
+    auto hello = HelloBytes(Profile());
+    hello[106] |= 8;
+    CHECK(Send(unknown_features, {"v2hello", hello}).result ==
+          SessionResult::PeerRejected);
+    Session obsolete(Config());
+    obsolete.OnOpen(100);
+    auto version = VersionBytes();
+    version[0] = 0x80;
+    CHECK(Send(obsolete, {"version", version}).result ==
+          SessionResult::PeerRejected);
+}
+void NonceTimeAndLocalErrors() {
+    auto c = Config();
+    c.inbound = true;
+    size_t calls = 0;
+    c.incoming_nonce_allowed = [&](uint64_t nonce) {
+        ++calls;
+        return nonce != Modern().Nonce();
+    };
+    Session self(c);
+    self.OnOpen(100);
+    CHECK(Send(self, {"version", VersionBytes()}).result ==
+              SessionResult::PeerRejected &&
+          calls == 1);
+    c.incoming_nonce_allowed = [&](uint64_t nonce) {
+        ++calls;
+        return nonce == Modern().Nonce();
+    };
+    Session inbound(c);
+    inbound.OnOpen(100);
+    CHECK(Send(inbound, {"version", VersionBytes()}).result ==
+          SessionResult::Send);
+    CHECK(Send(inbound, {"version", VersionBytes()}).result ==
+              SessionResult::Ignored &&
+          calls == 2);
+    c.incoming_nonce_allowed = [](uint64_t) -> bool {
+        throw std::runtime_error("operational");
+    };
+    Session callback(c);
+    callback.OnOpen(100);
+    CHECK(Send(callback, {"version", VersionBytes()}).result ==
+          SessionResult::LocalFailure);
+    c.incoming_nonce_allowed = {};
+    Session no_callback(c);
+    CHECK(no_callback.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.services = 1;
+    Session services(c);
+    CHECK(services.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.receiver.services = 1;
+    Session receiver(c);
+    CHECK(receiver.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.sender->address.services = 1;
+    Session sender(c);
+    CHECK(sender.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.extra_entropy.reset();
+    Session incomplete(c);
+    CHECK(incomplete.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.handshake_timeout_ms = 0;
+    Session zero(c);
+    CHECK(zero.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    Session overflow(c);
+    CHECK(overflow.OnOpen(UINT64_MAX - 5).result ==
+          SessionResult::LocalFailure);
+    Session deadline(Config());
+    deadline.OnOpen(100);
+    CHECK(Send(deadline, {"version", VersionBytes()}, 101).result ==
+          SessionResult::Send);
+    CHECK(Send(deadline, {"version", {}}, 10099).result ==
+          SessionResult::Ignored);
+    CHECK(deadline.OnTimer(10100).result == SessionResult::TimedOut);
+    Session final_deadline(Config());
+    final_deadline.OnOpen(100);
+    Send(final_deadline, {"version", VersionBytes()}, 101);
+    Send(final_deadline, {"v2hello", HelloBytes(Profile())}, 101);
+    CHECK(Send(final_deadline, {"verack", {}}, 10100).result ==
