 #include "disk_block.h"
+#include "vendor/blake3/blake3.h"
 #include <stdexcept>
 namespace lotus::v2 {
 namespace {
@@ -30,6 +31,44 @@ public:
     void Abort() noexcept override { tx.Abort(); }
 };
 } // namespace
+Hash BlockValidationProfileDigest(const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp) {
+    std::vector<uint8_t> bytes;
+    auto put = [&](VmCostUnits value, unsigned width = 8) {
+        for (unsigned i = 0; i < width; ++i) bytes.push_back(uint8_t(value >> (8 * i)));
+    };
+    auto hash = [&](const Hash &value) { bytes.insert(bytes.end(), value.begin(), value.end()); };
+    put(1); hash(hp.chain_id); put(hp.version); put(hp.genesis_time);
+    put(hp.genesis_bits); hash(hp.pow_limit);
+    put(uint64_t(hp.half_life_seconds)); put(uint64_t(hp.spacing_seconds));
+    const auto &t = op.transaction;
+    for (auto value : {t.max_inputs, t.max_outputs, t.max_mints, t.max_script_bytes,
+                      t.max_arguments, t.max_argument_bytes, t.max_branch_proof_depth}) put(value);
+    const auto &v = op.vm;
+    for (auto value : {v.max_script_bytes, v.max_arguments, v.max_element_bytes,
+                      v.max_stack_items, v.max_altstack_items, v.max_vm_bytes,
+                      v.max_ast_depth, v.max_steps}) put(value);
+    put(op.coinbase_maturity); put(op.dust_limit); put(op.max_total_invocation_cost, 16);
+    put(op.vm_cost.max_invocation_cost, 16); put(op.vm_cost.structural_byte_cost);
+    for (const auto &cost : op.vm_cost.opcode) {
+        put(cost.base); put(cost.per_operand_byte); put(cost.per_result_byte);
+    }
+    put(op.vm_cost.field_sizes.size());
+    for (const auto &[opcode, sizes] : op.vm_cost.field_sizes) {
+        put(opcode, 1); put(sizes.size()); for (auto value : sizes) put(value);
+    }
+    put(mp.boot_shift); put(mp.tx_knee_shift); put(mp.ema_shift); put(mp.ema_min);
+    put(mp.linear_shift); put(mp.quad_shift); put(mp.tail_min); put(mp.tail_max);
+    put(mp.dust_limit); put(mp.min_fee_per_kb);
+    put(cp.hash_base); put(cp.hash_byte); put(cp.resolve_byte); put(cp.asset_comparison);
+    blake3_hasher hasher; blake3_hasher_init(&hasher);
+    constexpr char domain[] = "Lotus/v2/storage-validator-profile";
+    blake3_hasher_update(&hasher, domain, sizeof(domain));
+    blake3_hasher_update(&hasher, bytes.data(), bytes.size());
+    Hash digest; blake3_hasher_finalize(&hasher, digest.data(), digest.size());
+    return digest;
+}
 CandidateCheckResult ConnectDiskBlock(
     const std::vector<uint8_t> &wire, const std::vector<Header> &history,
     const HeaderChainProfile &hp, const OrdinaryCandidateProfile &op,
@@ -38,6 +77,9 @@ CandidateCheckResult ConnectDiskBlock(
     using Result = CandidateCheckResult;
     try {
         if (!store.IsOpen()) { error = "chainstate database unavailable"; return Result::StorageError; }
+        if (!store.MatchesProfile(hp.chain_id, BlockValidationProfileDigest(hp, op, mp, cp))) {
+            error = "stored validator profile mismatch"; return Result::StorageError;
+        }
         const auto before = store.Metadata();
         OrdinaryParentContext parent;
         parent.chain_id = hp.chain_id;
