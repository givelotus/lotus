+
+struct SmtNode {
+    lotus::v2::Hash digest{};
+    size_t count{};
+    lotus::v2::Hash key{};
+    std::shared_ptr<const lotus::v2::Coin> coin;
+    std::array<std::shared_ptr<const SmtNode>, 2> child;
+
+    bool IsLeaf() const { return coin != nullptr; }
+    lotus::v2::Hash ChildHash(unsigned bit) const {
+        return child[bit] ? child[bit]->digest : lotus::v2::EmptyUtxoRoot();
+    }
+    void Refresh(unsigned depth) {
+        const bool ok =
+            lotus::v2::UtxoNode(depth, ChildHash(0), ChildHash(1), digest);
+        assert(ok);
+        (void)ok;
+    }
+};
+
+bool SmtKeyBit(const lotus::v2::Hash &key, unsigned depth) {
+    return (key[depth / 8] >> (depth % 8)) & 1;
+}
+
+std::shared_ptr<const SmtNode> MakeSmtLeaf(const lotus::v2::Coin &coin,
+                                           const lotus::v2::Hash &key,
+                                           const lotus::v2::Hash &leaf_hash) {
+    auto node = std::make_shared<SmtNode>();
+    node->digest = leaf_hash;
+    node->count = 1;
+    node->key = key;
+    node->coin = std::make_shared<const lotus::v2::Coin>(coin);
+    return node;
+}
+
+std::shared_ptr<const SmtNode>
+JoinSmtLeaves(const std::shared_ptr<const SmtNode> &existing,
+              const std::shared_ptr<const SmtNode> &added, unsigned depth) {
+    const lotus::v2::Hash old_key = existing->key;
+    unsigned split = depth;
+    while (SmtKeyBit(existing->key, split) == SmtKeyBit(added->key, split)) {
+        ++split;
+    }
+    auto subtree = std::make_shared<SmtNode>();
+    subtree->count = 2;
+    const unsigned old_bit = SmtKeyBit(existing->key, split);
+    subtree->child[old_bit] = existing;
+    subtree->child[1 - old_bit] = added;
+    subtree->Refresh(split);
+    for (unsigned d = split; d-- > depth;) {
+        auto parent = std::make_shared<SmtNode>();
+        parent->count = 2;
+        parent->child[SmtKeyBit(old_key, d)] = std::move(subtree);
+        parent->Refresh(d);
+        subtree = std::move(parent);
+    }
+    return subtree;
+}
+
+std::shared_ptr<const SmtNode>
+SmtInsertAt(const std::shared_ptr<const SmtNode> &node,
+            const lotus::v2::Coin &coin, const lotus::v2::Hash &key,
+            const lotus::v2::Hash &leaf_hash, unsigned depth) {
+    if (!node) {
+        return MakeSmtLeaf(coin, key, leaf_hash);
+    }
+    if (node->IsLeaf()) {
+        if (node->key == key) {
+            return node;
+        }
+        return JoinSmtLeaves(node, MakeSmtLeaf(coin, key, leaf_hash), depth);
+    }
+    if (depth >= 256) {
+        return node;
+    }
+    const unsigned bit = SmtKeyBit(key, depth);
+    auto new_child =
+        SmtInsertAt(node->child[bit], coin, key, leaf_hash, depth + 1);
+    if (new_child == node->child[bit]) {
+        return node;
+    }
+    auto next = std::make_shared<SmtNode>(*node);
+    next->child[bit] = std::move(new_child);
+    next->count = (next->child[0] ? next->child[0]->count : 0) +
+                  (next->child[1] ? next->child[1]->count : 0);
+    next->Refresh(depth);
+    return next;
+}
+
+std::shared_ptr<const SmtNode>
+SmtEraseAt(const std::shared_ptr<const SmtNode> &node,
+           const lotus::v2::Outpoint &outpoint, const lotus::v2::Hash &key,
+           unsigned depth) {
+    if (!node) {
+        return nullptr;
+    }
+    if (node->IsLeaf()) {
+        if (node->key != key || node->coin->outpoint != outpoint) {
+            return node;
+        }
+        return nullptr;
+    }
+    if (depth >= 256) {
+        return node;
+    }
+    const unsigned bit = SmtKeyBit(key, depth);
+    auto new_child = SmtEraseAt(node->child[bit], outpoint, key, depth + 1);
+    if (new_child == node->child[bit]) {
+        return node;
+    }
+    const auto &other = node->child[1 - bit];
+    const size_t new_count =
+        (new_child ? new_child->count : 0) + (other ? other->count : 0);
+    if (new_count == 0) {
+        return nullptr;
+    }
+    if (new_count == 1) {
+        return new_child ? new_child : other;
+    }
+    auto next = std::make_shared<SmtNode>(*node);
+    next->child[bit] = std::move(new_child);
+    next->count = new_count;
+    next->Refresh(depth);
+    return next;
+}
+
+void SmtInsert(std::shared_ptr<const SmtNode> &root,
+               const lotus::v2::Coin &coin) {
+    lotus::v2::Hash leaf_hash{};
+    if (!lotus::v2::UtxoLeaf(coin, leaf_hash)) {
+        return;
+    }
+    const lotus::v2::Hash key = lotus::v2::OutpointKey(coin.outpoint);
+    root = SmtInsertAt(root, coin, key, leaf_hash, 0);
+}
+
+void SmtErase(std::shared_ptr<const SmtNode> &root,
+              const lotus::v2::Outpoint &outpoint) {
+    const lotus::v2::Hash key = lotus::v2::OutpointKey(outpoint);
+    root = SmtEraseAt(root, outpoint, key, 0);
+}
+
+lotus::v2::Hash SmtRoot(const std::shared_ptr<const SmtNode> &root) {
+    return root ? root->digest : lotus::v2::EmptyUtxoRoot();
+}
+
+struct V2BlockStateSnapshot {
+    std::shared_ptr<const SmtNode> utxo_root;
+    lotus::v2::MonetaryState mon_state;
+    BlockHash parent_hash{};
+    std::vector<lotus::v2::Outpoint> erased_outpoints;
+    std::vector<lotus::v2::Coin> inserted_coins;
+};
+
+std::map<BlockHash, V2BlockStateSnapshot> g_v2_state_snapshots;
+
+constexpr uint64_t kDeltaSnapshotMagic = 0xFFFFFFFFFFFFFFFEULL;
+
+constexpr lotus::v2::MonetaryProfile kDefaultMonetaryProfile{
+    2, 16, 2, 4, 32, 60, 2, 2000, 3, 1000, 200, lotus::v2::Hash{2}};
+
+lotus::v2::MonetaryState InitialV2MonetaryState() {
+    lotus::v2::MonetaryState state{};
+    state.bootstrap_reserve = 9;
+    state.tail_subsidy = 200;
+    state.prev_work[0] = 2;
+    state.ema_block_cost = 4;
+    return lotus::v2::InitializeMonetaryGenesis(kDefaultMonetaryProfile, state,
+                                                0);
+}
+
+void SaveV2BlockStateToDiskLocked(const BlockHash &blockHash,
+                                  const V2BlockStateSnapshot &snap) {
+    if (g_v2_state_persist_dir.empty()) {
+        return;
+    }
+    std::error_code ec;
+    const std::filesystem::path dir(g_v2_state_persist_dir);
+    std::filesystem::create_directories(dir, ec);
+    if (ec) {
+        return;
+    }
+    const std::filesystem::path final_path =
+        dir / (blockHash.GetHex() + ".bin");
+    const std::filesystem::path tmp_path =
+        dir / (blockHash.GetHex() + ".bin.tmp");
+    std::ofstream out(tmp_path, std::ios::binary | std::ios::trunc);
+    if (!out) {
+        return;
+    }
+    const auto mon_bytes = lotus::v2::EncodeMonetaryState(snap.mon_state);
+    out.write(reinterpret_cast<const char *>(mon_bytes.data()),
+              mon_bytes.size());
+    for (unsigned i = 0; i < 8; ++i) {
+        const uint8_t b = static_cast<uint8_t>(kDeltaSnapshotMagic >> (8 * i));
+        out.write(reinterpret_cast<const char *>(&b), 1);
+    }
+    out.write(reinterpret_cast<const char *>(snap.parent_hash.begin()), 32);
+    const uint32_t erased_count =
+        static_cast<uint32_t>(snap.erased_outpoints.size());
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint8_t b = static_cast<uint8_t>(erased_count >> (8 * i));
+        out.write(reinterpret_cast<const char *>(&b), 1);
+    }
+    for (const auto &op : snap.erased_outpoints) {
+        out.write(reinterpret_cast<const char *>(op.tx_id.data()), 32);
+        for (unsigned i = 0; i < 4; ++i) {
+            const uint8_t b = static_cast<uint8_t>(op.index >> (8 * i));
+            out.write(reinterpret_cast<const char *>(&b), 1);
+        }
+    }
+    const uint32_t inserted_count =
+        static_cast<uint32_t>(snap.inserted_coins.size());
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint8_t b = static_cast<uint8_t>(inserted_count >> (8 * i));
+        out.write(reinterpret_cast<const char *>(&b), 1);
+    }
+    for (const auto &coin : snap.inserted_coins) {
+        std::vector<uint8_t> encoded;
+        if (!lotus::v2::EncodeCoin(coin, encoded)) {
+            return;
+        }
+        const uint32_t len = static_cast<uint32_t>(encoded.size());
+        for (unsigned i = 0; i < 4; ++i) {
+            const uint8_t b = static_cast<uint8_t>(len >> (8 * i));
+            out.write(reinterpret_cast<const char *>(&b), 1);
+        }
+        out.write(reinterpret_cast<const char *>(encoded.data()),
+                  encoded.size());
+    }
+    out.close();
+    if (!out) {
+        std::filesystem::remove(tmp_path, ec);
+        return;
+    }
+    std::filesystem::rename(tmp_path, final_path, ec);
+}
+
+bool LoadV2BlockStateFromDiskLocked(const BlockHash &blockHash,
+                                    V2BlockStateSnapshot &snap) {
+    if (g_v2_state_persist_dir.empty()) {
+        return false;
+    }
+    const std::filesystem::path path =
+        std::filesystem::path(g_v2_state_persist_dir) /
+        (blockHash.GetHex() + ".bin");
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    std::vector<uint8_t> mon_bytes(56);
+    if (!in.read(reinterpret_cast<char *>(mon_bytes.data()), 56)) {
+        return false;
+    }
+    try {
+        snap.mon_state = lotus::v2::DecodeMonetaryState(mon_bytes);
+    } catch (...) {
+        return false;
+    }
+    uint8_t count_buf[8]{};
+    if (!in.read(reinterpret_cast<char *>(count_buf), 8)) {
+        return false;
+    }
+    uint64_t count = 0;
+    for (unsigned i = 0; i < 8; ++i) {
+        count |= uint64_t(count_buf[i]) << (8 * i);
+    }
+    if (count == kDeltaSnapshotMagic) {
+        uint256 parent_raw;
+        if (!in.read(reinterpret_cast<char *>(parent_raw.begin()), 32)) {
+            return false;
+        }
+        snap.parent_hash = BlockHash{parent_raw};
+        snap.utxo_root.reset();
+        if (!snap.parent_hash.IsNull()) {
+            auto it = g_v2_state_snapshots.find(snap.parent_hash);
+            if (it != g_v2_state_snapshots.end()) {
+                snap.utxo_root = it->second.utxo_root;
+            } else {
+                V2BlockStateSnapshot parent_snap;
+                if (!LoadV2BlockStateFromDiskLocked(snap.parent_hash,
+                                                    parent_snap)) {
+                    return false;
+                }
+                snap.utxo_root = parent_snap.utxo_root;
+                g_v2_state_snapshots[snap.parent_hash] = std::move(parent_snap);
+            }
+        }
+        uint8_t erased_buf[4]{};
+        if (!in.read(reinterpret_cast<char *>(erased_buf), 4)) {
+            return false;
+        }
+        uint32_t erased_count = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            erased_count |= uint32_t(erased_buf[i]) << (8 * i);
+        }
+        if (erased_count > 1000000) {
+            return false;
+        }
+        snap.erased_outpoints.clear();
+        snap.erased_outpoints.reserve(erased_count);
+        for (uint32_t c = 0; c < erased_count; ++c) {
+            lotus::v2::Outpoint op{};
+            if (!in.read(reinterpret_cast<char *>(op.tx_id.data()), 32)) {
+                return false;
+            }
+            uint8_t idx_buf[4]{};
+            if (!in.read(reinterpret_cast<char *>(idx_buf), 4)) {
+                return false;
+            }
+            op.index = 0;
+            for (unsigned i = 0; i < 4; ++i) {
+                op.index |= uint32_t(idx_buf[i]) << (8 * i);
+            }
+            SmtErase(snap.utxo_root, op);
+            snap.erased_outpoints.push_back(op);
+        }
+        uint8_t inserted_buf[4]{};
+        if (!in.read(reinterpret_cast<char *>(inserted_buf), 4)) {
+            return false;
+        }
+        uint32_t inserted_count = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            inserted_count |= uint32_t(inserted_buf[i]) << (8 * i);
+        }
+        if (inserted_count > 1000000) {
+            return false;
+        }
+        snap.inserted_coins.clear();
+        snap.inserted_coins.reserve(inserted_count);
+        for (uint32_t c = 0; c < inserted_count; ++c) {
+            uint8_t len_buf[4]{};
+            if (!in.read(reinterpret_cast<char *>(len_buf), 4)) {
+                return false;
+            }
+            uint32_t len = 0;
+            for (unsigned i = 0; i < 4; ++i) {
+                len |= uint32_t(len_buf[i]) << (8 * i);
+            }
+            if (len == 0 || len > lotus::v2::MAX_COIN_BYTES) {
+                return false;
+            }
+            std::vector<uint8_t> encoded(len);
+            if (!in.read(reinterpret_cast<char *>(encoded.data()), len)) {
+                return false;
+            }
+            lotus::v2::Coin coin;
+            if (!lotus::v2::DecodeCoinBytes(encoded, coin)) {
+                return false;
+            }
+            SmtInsert(snap.utxo_root, coin);
+            snap.inserted_coins.push_back(std::move(coin));
+        }
+        return true;
+    }
+    if (count > 1000000) {
+        return false;
+    }
+    snap.utxo_root.reset();
+    snap.erased_outpoints.clear();
+    snap.inserted_coins.clear();
+    for (uint64_t c = 0; c < count; ++c) {
+        uint8_t len_buf[4]{};
+        if (!in.read(reinterpret_cast<char *>(len_buf), 4)) {
+            return false;
+        }
+        uint32_t len = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            len |= uint32_t(len_buf[i]) << (8 * i);
+        }
+        if (len == 0 || len > lotus::v2::MAX_COIN_BYTES) {
+            return false;
+        }
+        std::vector<uint8_t> encoded(len);
+        if (!in.read(reinterpret_cast<char *>(encoded.data()), len)) {
+            return false;
+        }
+        lotus::v2::Coin coin;
+        if (!lotus::v2::DecodeCoinBytes(encoded, coin)) {
+            return false;
+        }
+        SmtInsert(snap.utxo_root, coin);
+        snap.inserted_coins.push_back(std::move(coin));
+    }
+    return true;
+}
+
+V2BlockStateSnapshot BuildNextV2BlockState(const CBlock &block,
+                                           const BlockHash &hashPrevBlock,
+                                           uint64_t nHeight,
+                                           uint64_t nParentMtp) {
+    V2BlockStateSnapshot state{{}, InitialV2MonetaryState(), hashPrevBlock, {}, {}};
+    if (nHeight == 0) {
+        return state;
+    }
+    if (!hashPrevBlock.IsNull()) {
+        std::lock_guard<std::mutex> lock(g_v2_utxo_mutex);
+        auto it = g_v2_state_snapshots.find(hashPrevBlock);
+        if (it != g_v2_state_snapshots.end()) {
+            state.utxo_root = it->second.utxo_root;
+            state.mon_state = it->second.mon_state;
+        } else if (LoadV2BlockStateFromDiskLocked(hashPrevBlock, state)) {
+            V2BlockStateSnapshot cached = state;
+            g_v2_state_snapshots[hashPrevBlock] = std::move(cached);
+            state.parent_hash = hashPrevBlock;
+            state.erased_outpoints.clear();
+            state.inserted_coins.clear();
+        }
+    }
+    std::vector<uint64_t> tx_linear_costs;
+    tx_linear_costs.reserve(block.vtx.size());
+    for (const auto &ptx : block.vtx) {
+        const CTransaction &tx = *ptx;
+        const uint64_t linear_cost =
+            ::GetSerializeSize(tx) +
+            uint64_t(tx.vin.size() * 64 + tx.vout.size() * 64);
+        tx_linear_costs.push_back(linear_cost);
+        if (!tx.IsCoinBase()) {
+            for (const auto &txin : tx.vin) {
+                if (txin.nFlags != 3) {
+                    lotus::v2::Outpoint op{};
+                    std::memcpy(op.tx_id.data(), txin.prevout.GetTxId().begin(),
+                                32);
+                    op.index = txin.prevout.GetN();
+                    SmtErase(state.utxo_root, op);
+                    state.erased_outpoints.push_back(op);
+                }
+            }
+        }
+        lotus::v2::Hash txid{};
+        std::memcpy(txid.data(), tx.GetId().begin(), 32);
+        for (size_t j = 0; j < tx.vout.size(); ++j) {
+            if (tx.vout[j].scriptPubKey.IsUnspendable()) {
+                continue;
+            }
+            const lotus::v2::Output v2out = tx.vout[j].ToV2Output();
+            if (!v2out.IsBurn()) {
+                lotus::v2::Coin coin{
+                    {txid, static_cast<uint32_t>(j)},
+                    v2out,
+                    nHeight,
+                    nParentMtp,
+                    tx.IsCoinBase()};
+                SmtInsert(state.utxo_root, coin);
+                state.inserted_coins.push_back(std::move(coin));
+            }
+        }
+    }
+    lotus::v2::Hash pow_limit{};
+    pow_limit.fill(0xff);
+    lotus::v2::Hash target_hash{};
+    lotus::v2::MonetaryInteger work = 2;
+    if (lotus::v2::DecodeTarget(block.nBits, pow_limit, target_hash)) {
+        lotus::v2::MonetaryInteger target_int = 0;
+        for (size_t i = target_hash.size(); i > 0; --i) {
+            target_int <<= 8;
+            target_int += target_hash[i - 1];
+        }
+        work = (lotus::v2::MonetaryInteger(1) << 256) / (target_int + 1);
+        if (work == 0) {
+            work = 1;
+        }
+    }
+    const lotus::v2::MonetaryInteger envelope_cost =
+        138 + uint64_t(block.vtx.size()) * 64;
+    const lotus::v2::MonetaryInteger block_cost = lotus::v2::BlockEffectiveCost(
+        envelope_cost, tx_linear_costs, kDefaultMonetaryProfile);
+    const lotus::v2::MonetaryInteger capped_cost =
+        (lotus::v2::RequiredBlockBurn(block_cost,
+                                      state.mon_state.ema_block_cost,
+                                      kDefaultMonetaryProfile) >
+         state.mon_state.tail_subsidy)
+            ? lotus::v2::MonetaryInteger(kDefaultMonetaryProfile.ema_min)
+            : block_cost;
+    const lotus::v2::MonetaryTransition transition = lotus::v2::AdvanceMonetary(
+        kDefaultMonetaryProfile, state.mon_state, work, {},
+        /*coinbase_native_outputs=*/0, /*coinbase_native_burn=*/0,
+        /*coinbase_bytes=*/0, /*tx_frame_prefix_bytes=*/0, capped_cost,
+        capped_cost);
+    state.mon_state = transition.state;
+    return state;
+}
