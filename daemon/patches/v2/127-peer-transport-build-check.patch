From 3fa0c70732321a09aee5c8d2f5d017e1196381c8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 11:32:22 -0700
Subject: [PATCH] Wire bounded peer transport library and mocked-stream check
 into CMake

Expose the caller-owned stream adapter as an isolated library and test target. This build integration does not activate sockets or select network parameters. Root standalone Debug transport test passes; independent agent review and mocked-stream test pass.
---
 src/lotus_v2/CMakeLists.txt | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index eb5f632c0..929a18a60 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -211,3 +211,12 @@ add_custom_target(check-lotus-v2-reorg
     COMMAND $<TARGET_FILE:test_lotus_v2_reorg_storage>
     COMMAND $<TARGET_FILE:test_lotus_v2_reorg_recovery>
     DEPENDS test_lotus_v2_reorg_storage test_lotus_v2_reorg_recovery)
+
+# Bounded adapter over a caller-owned connected stream; no socket activation.
+add_library(lotus_v2_peer_transport STATIC peer_transport.cpp)
+target_link_libraries(lotus_v2_peer_transport PUBLIC lotus_v2_peer_session)
+add_executable(test_lotus_v2_peer_transport test_peer_transport.cpp)
+target_link_libraries(test_lotus_v2_peer_transport PRIVATE lotus_v2_peer_transport)
+add_custom_target(check-lotus-v2-peer-transport
+    COMMAND $<TARGET_FILE:test_lotus_v2_peer_transport>
+    DEPENDS test_lotus_v2_peer_transport)
