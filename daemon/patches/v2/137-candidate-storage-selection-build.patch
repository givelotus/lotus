From ae42363091d252f7aee8d05b16b5bf546682feb9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 11:57:57 -0700
Subject: [PATCH] Build candidate storage and selection with shared validation
 dependencies

Register the V4 candidate factory in full-tree validation and standalone disk storage, with explicit Boost headers for the shared standalone target. Add full-tree candidate store and selection checks. Root Debug candidate store, focused selector, and real V3/V4 recovery suites pass; full-tree exact-source verification follows separately.
---
 src/lotus_v2/CMakeLists.txt                 | 18 +++++++++++++++++-
 src/lotus_v2/disk_state_test/CMakeLists.txt |  3 ++-
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 929a18a60..f02e87445 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -134,7 +134,7 @@ find_package(OpenSSL REQUIRED COMPONENTS Crypto)
 add_library(lotus_v2_validation STATIC
     transaction.cpp signing.cpp vm.cpp field_size.cpp ordinary_validation.cpp
     monetary.cpp block_wire.cpp block_cost.cpp header_context.cpp
-    asert_candidate.cpp block_transition.cpp disk_state.cpp disk_block.cpp development_chain.cpp disk_body.cpp
+    asert_candidate.cpp block_transition.cpp disk_state.cpp candidate_store.cpp disk_block.cpp development_chain.cpp disk_body.cpp
     chain_index.cpp header_admission.cpp)
 target_link_libraries(lotus_v2_validation PUBLIC
     lotus_v2_sparse_state lotus_v2_incremental_utxo Boost::headers secp256k1 leveldb OpenSSL::Crypto crypto)
@@ -220,3 +220,19 @@ target_link_libraries(test_lotus_v2_peer_transport PRIVATE lotus_v2_peer_transpo
 add_custom_target(check-lotus-v2-peer-transport
     COMMAND $<TARGET_FILE:test_lotus_v2_peer_transport>
     DEPENDS test_lotus_v2_peer_transport)
+
+# Explicit V4 candidate inventory and durable receipt storage checks.
+add_executable(test_lotus_v2_candidate_store test_candidate_store.cpp)
+target_link_libraries(test_lotus_v2_candidate_store PRIVATE lotus_v2_validation)
+add_custom_target(check-lotus-v2-candidate-store
+    COMMAND $<TARGET_FILE:test_lotus_v2_candidate_store>
+    DEPENDS test_lotus_v2_candidate_store)
+
+# Bounded candidate selection; choices remain unvalidated recovery attempts.
+add_library(lotus_v2_candidate_selection STATIC candidate_selection.cpp)
+target_link_libraries(lotus_v2_candidate_selection PUBLIC lotus_v2_validation)
+add_executable(test_lotus_v2_candidate_selection test_candidate_selection.cpp)
+target_link_libraries(test_lotus_v2_candidate_selection PRIVATE lotus_v2_candidate_selection)
+add_custom_target(check-lotus-v2-candidate-selection
+    COMMAND $<TARGET_FILE:test_lotus_v2_candidate_selection>
+    DEPENDS test_lotus_v2_candidate_selection)
diff --git a/src/lotus_v2/disk_state_test/CMakeLists.txt b/src/lotus_v2/disk_state_test/CMakeLists.txt
index 4cc2b5e5e..f32eec335 100644
--- a/src/lotus_v2/disk_state_test/CMakeLists.txt
+++ b/src/lotus_v2/disk_state_test/CMakeLists.txt
@@ -14,7 +14,8 @@ add_subdirectory(../../leveldb leveldb)
 find_path(LOTUS_BOOST_INCLUDE boost/multiprecision/cpp_int.hpp PATHS /opt/homebrew/opt/boost/include REQUIRED)
 add_library(blake3 STATIC ../vendor/blake3/blake3.c ../vendor/blake3/blake3_dispatch.c ../vendor/blake3/blake3_portable.c)
 target_compile_definitions(blake3 PRIVATE BLAKE3_NO_SSE2 BLAKE3_NO_SSE41 BLAKE3_NO_AVX2 BLAKE3_NO_AVX512 BLAKE3_USE_NEON=0)
-add_library(lotus_v2_disk_state STATIC ../disk_state.cpp)
+add_library(lotus_v2_disk_state STATIC ../disk_state.cpp ../candidate_store.cpp)
+target_include_directories(lotus_v2_disk_state SYSTEM PRIVATE "${LOTUS_BOOST_INCLUDE}")
 target_compile_features(lotus_v2_disk_state PUBLIC cxx_std_20)
 target_link_libraries(lotus_v2_disk_state PUBLIC leveldb)
 target_compile_options(lotus_v2_disk_state PRIVATE -Wall -Wextra -Wpedantic -Werror)
-- 
