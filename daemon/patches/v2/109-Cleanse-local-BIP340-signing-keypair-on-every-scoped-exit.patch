From 01d62c83b9ab9c3de45c40c44b48706b96ae2c27 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 10:30:06 -0700
Subject: [PATCH] Cleanse local BIP340 signing keypair on every scoped exit

Integration review note (2026-10-15; original source commit had no body):
Cleanse the scoped BIP340 keypair on successful signing and exception exits
using the existing vetted memory_cleanse primitive. Add instrumented cleanup
coverage alongside existing signing vectors. Caller-owned secret buffers
remain the caller's responsibility.

---
 src/lotus_v2/signing.cpp                   | 16 ++++-
 src/lotus_v2/signing.h                     |  2 +
 src/lotus_v2/signing_test/CMakeLists.txt   | 19 +++++-
 src/lotus_v2/signing_test/test_cleanup.cpp | 69 ++++++++++++++++++++++
 4 files changed, 101 insertions(+), 5 deletions(-)
 create mode 100644 src/lotus_v2/signing_test/test_cleanup.cpp

diff --git a/src/lotus_v2/signing.cpp b/src/lotus_v2/signing.cpp
index e6269d760..fc003086c 100644
--- a/src/lotus_v2/signing.cpp
+++ b/src/lotus_v2/signing.cpp
@@ -2,6 +2,8 @@
 
 #include "tagged_hash.h"
 
+#include "../support/cleanse.h"
+
 #include <secp256k1.h>
 #include <secp256k1_extrakeys.h>
 #include <secp256k1_schnorrsig.h>
@@ -349,14 +351,22 @@ bool SignBip340Message(const std::array<uint8_t, 32> &secret_key,
         error = "secp256k1 context";
         return false;
     }
-    secp256k1_keypair pair;
-    if (!secp256k1_keypair_create(ctx.get(), &pair, secret_key.data())) {
+    // The keypair embeds the private scalar. Keep cleanup attached to its
+    // lifetime, including invalid-key/signing failures and allocation throws.
+    struct ScopedKeypair {
+        secp256k1_keypair value{};
+        ScopedKeypair() = default;
+        ScopedKeypair(const ScopedKeypair &) = delete;
+        ScopedKeypair &operator=(const ScopedKeypair &) = delete;
+        ~ScopedKeypair() { memory_cleanse(&value, sizeof(value)); }
+    } pair;
+    if (!secp256k1_keypair_create(ctx.get(), &pair.value, secret_key.data())) {
         error = "invalid secret key";
         return false;
     }
     std::vector<uint8_t> sig(64);
     if (!secp256k1_schnorrsig_sign32(ctx.get(), sig.data(), message.data(),
-                                     &pair, aux_randomness.data())) {
+                                     &pair.value, aux_randomness.data())) {
         error = "BIP340 signing failed";
         return false;
     }
diff --git a/src/lotus_v2/signing.h b/src/lotus_v2/signing.h
index 73b4fe3c8..9804ebcac 100644
--- a/src/lotus_v2/signing.h
+++ b/src/lotus_v2/signing.h
@@ -101,6 +101,8 @@ SignatureStatus VerifyBip340Signature(std::span<const uint8_t> public_key,
                                       const Hash &message, bool mint);
 // Test/wallet helper. Caller supplies fresh nonce auxiliary entropy for real
 // signing; deterministic zero auxiliary bytes are used only in fixed vectors.
+// Local keypair storage is cleansed on every exit. Caller-owned secret_key and
+// aux_randomness remain the caller's responsibility; this API retains no copy.
 bool SignBip340Message(const std::array<uint8_t, 32> &secret_key,
                        const Hash &message, uint8_t mode,
                        const std::array<uint8_t, 32> &aux_randomness,
diff --git a/src/lotus_v2/signing_test/CMakeLists.txt b/src/lotus_v2/signing_test/CMakeLists.txt
index 2040e97f2..238fb9b65 100644
--- a/src/lotus_v2/signing_test/CMakeLists.txt
+++ b/src/lotus_v2/signing_test/CMakeLists.txt
@@ -15,9 +15,24 @@ target_compile_definitions(lotus_v2_signing_blake3 PRIVATE
     BLAKE3_NO_SSE2 BLAKE3_NO_SSE41 BLAKE3_NO_AVX2 BLAKE3_NO_AVX512 BLAKE3_USE_NEON=0)
 add_executable(lotus_v2_signing_test
     ../output.cpp ../transaction.cpp ../commitment.cpp ../tagged_hash.cpp
-    ../signing.cpp ../test_signing.cpp)
-target_include_directories(lotus_v2_signing_test PRIVATE "${LOTUS_SRC}/secp256k1/include")
+    ../signing.cpp ../test_signing.cpp "${LOTUS_SRC}/support/cleanse.cpp")
+target_include_directories(lotus_v2_signing_test PRIVATE "${LOTUS_SRC}/secp256k1/include" "${LOTUS_SRC}")
 target_link_libraries(lotus_v2_signing_test PRIVATE lotus_v2_signing_blake3 "${LOTUS_SECP_LIBRARY}")
 target_compile_options(lotus_v2_signing_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
 enable_testing()
 add_test(NAME lotus_v2_signing_test COMMAND lotus_v2_signing_test)
+
+# Instrument the cleansing boundary without recording secret contents. The
+# wrapper delegates to the exact ABC primitive and checks zeroed bytes.
+add_library(lotus_v2_test_cleanse OBJECT "${LOTUS_SRC}/support/cleanse.cpp")
+target_include_directories(lotus_v2_test_cleanse PRIVATE "${LOTUS_SRC}")
+target_compile_definitions(lotus_v2_test_cleanse PRIVATE memory_cleanse=lotus_v2_test_real_cleanse)
+add_executable(lotus_v2_signing_cleanup_test
+    test_cleanup.cpp ../output.cpp ../transaction.cpp ../commitment.cpp
+    ../tagged_hash.cpp ../signing.cpp $<TARGET_OBJECTS:lotus_v2_test_cleanse>)
+target_include_directories(lotus_v2_signing_cleanup_test PRIVATE
+    "${LOTUS_SRC}/secp256k1/include" "${LOTUS_SRC}")
+target_link_libraries(lotus_v2_signing_cleanup_test PRIVATE
+    lotus_v2_signing_blake3 "${LOTUS_SECP_LIBRARY}")
+target_compile_options(lotus_v2_signing_cleanup_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
+add_test(NAME lotus_v2_signing_cleanup_test COMMAND lotus_v2_signing_cleanup_test)
diff --git a/src/lotus_v2/signing_test/test_cleanup.cpp b/src/lotus_v2/signing_test/test_cleanup.cpp
new file mode 100644
index 000000000..f1b798b43
--- /dev/null
+++ b/src/lotus_v2/signing_test/test_cleanup.cpp
@@ -0,0 +1,69 @@
+// Public fixture material only. No private bytes are logged or retained here.
+#include "../signing.h"
+#include <secp256k1_extrakeys.h>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+
+namespace {
+size_t cleanups = 0;
+size_t allocations_until_failure = 0;
+void Check(bool condition) { if (!condition) std::abort(); }
+}
+
+// Exercise an exception after keypair creation. Other allocations use the
+// ordinary malloc/free allocation contract for this isolated test executable.
+void *operator new(std::size_t size) {
+    if (allocations_until_failure && --allocations_until_failure == 0) {
+        throw std::bad_alloc();
+    }
+    if (void *result = std::malloc(size ? size : 1)) return result;
+    throw std::bad_alloc();
+}
+void operator delete(void *ptr) noexcept { std::free(ptr); }
+void operator delete(void *ptr, std::size_t) noexcept { std::free(ptr); }
+
+void lotus_v2_test_real_cleanse(void *, size_t);
+void memory_cleanse(void *ptr, size_t size) {
+    Check(size == sizeof(secp256k1_keypair));
+    lotus_v2_test_real_cleanse(ptr, size);
+    const auto *bytes = static_cast<const unsigned char *>(ptr);
+    for (size_t i = 0; i < size; ++i) Check(bytes[i] == 0);
+    ++cleanups;
+}
+
+int main() {
+    using namespace lotus::v2;
+    std::array<uint8_t, 32> secret{};
+    secret.back() = 3; // Public BIP340 fixture key; never real wallet material.
+    const auto original = secret;
+    const Hash message{};
+    const std::array<uint8_t, 32> aux{};
+    std::vector<uint8_t> result;
+    std::string error;
+    for (uint8_t mode = 0; mode <= 2; ++mode) {
+        Check(SignBip340Message(secret, message, mode, aux, result, error));
+        Check(result.size() == (mode ? 65 : 64));
+        Check(!mode || result.back() == mode);
+        Check(cleanups == size_t(mode) + 1 && error.empty());
+        Check(secret == original); // Caller owns its scalar's cleanup.
+    }
+    const auto saved = result;
+    std::array<uint8_t, 32> invalid{};
+    Check(!SignBip340Message(invalid, message, 0, aux, result, error));
+    Check(cleanups == 4 && result == saved && error == "invalid secret key");
+    Check(!SignBip340Message(secret, message, 3, aux, result, error));
+    Check(cleanups == 4 && result == saved && error == "signing mode");
+    for (size_t allocation : {size_t(1), size_t(2)}) {
+        // First allocation creates sig; second grows it for a mode suffix.
+        allocations_until_failure = allocation;
+        try {
+            SignBip340Message(secret, message, allocation == 1 ? 0 : 1, aux, result, error);
+            std::abort();
+        } catch (const std::bad_alloc &) {
+            Check(!allocations_until_failure && result == saved);
+        }
+    }
+    Check(cleanups == 6);
+    std::cout << "Signing keypair cleanup passes success, invalid-key, and allocation exception exits\n";
+}
