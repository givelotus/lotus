index 000000000..01e0b400d
--- /dev/null
+++ b/src/lotus_v2/peer_transport_test/README.md
@@ -0,0 +1,62 @@
+# Parameterized byte-stream adapter review
+
+This slice tests `Transport` with an injected nonblocking byte stream. It opens
+no socket, listener or node and adopts no network magic, genesis or endpoint.
+The arbitrary profile bytes live only in the test. Existing `Session` and
+`EnvelopeDecoder` own all handshake and framing semantics.
+
+```sh
+cmake -S src/lotus_v2/peer_transport_test -B /tmp/peer-transport-build \
+  -DLOTUS_SECP_LIBRARY=/path/to/libsecp256k1.a -DCMAKE_BUILD_TYPE=Debug
+cmake --build /tmp/peer-transport-build
+ctest --test-dir /tmp/peer-transport-build --output-on-failure
+```
+
+`-DLOTUS_SANITIZE=ON` instruments the C++ target with address and undefined
+behavior sanitizers. Root build integration needs `peer_transport.cpp` in the
+existing V2 source library and a `test_peer_transport.cpp` executable linked to
+that library. This packet does not edit shared CMake files.
+
+The adapter borrows a caller-owned connected stream object, adopts connection
+cleanup on successful construction, and calls `Close` exactly once before that
+object may be destroyed. ABC's socket wrapper can later implement the three
+stream virtual methods without exposing socket types here. Interrupted I/O maps
+to WouldBlock; retries remain subject to Poll's budget. Half-close is terminal.
+
+Each Poll bounds timer/feed/I/O actions, combined transferred I/O bytes, and
+separately fed buffered bytes. Every I/O span is authorized against the remaining
+byte allowance before calling the stream; a WouldBlock response uses an action
+but no bytes. A stalled write leaves receive progress available. Poll does not
+invoke application handlers. It retains at most one activation/application event
+until `TakeEvent` transfers ownership, applying receive backpressure meanwhile.
+Whole-operation guards reject reentrant mutations from stream callbacks,
+including cleanup callbacks. The stream itself must obey its span boundaries;
+count validation can detect an invalid report, but cannot repair an external
+implementation writing outside its authorized span.
+
+Logical retained-byte quotas cover read leftovers, output frames including sent
+prefixes, decoder payload and pending application payload. They are independent
+of download staging leases. Vector capacity slack, allocator overhead, transient
+encoding output, caller/stream/kernel memory and downstream validator caches are
+separate. Enclosing runtime must reserve a separate global/per-peer transport
+budget and charge transferred events while DownloadManager holds its own staging
+lease; it must not count a download lease as paying for duplicate receive bytes.
+Closing frees transport/session buffers; it does not release downstream leases.
+The integration owner must call DownloadManager::OnDisconnect using its own peer
+handle when the adapter reports closure.
+
+Incomplete-input deadlines start on receive, preserving the receive timestamp
+for coalesced leftovers even when CPU limits delay feeding. Complete frames reset
+only their own deadline. Each queued output has its original enqueue deadline.
+Trickle progress and event backpressure extend neither deadline. Session enforces
+its fixed handshake deadline independently. Active idle input has no deadline.
+Close reasons separate capacity, stream EOF/error/contract violation, local
+failure, timeouts and peer protocol rejection; no reputation side effects occur.
+
+Coverage includes small chunk sizes 1–32, short writes, coalesced handshake and
+application frames, exact output ordering, pending-event backpressure, exact
+queue caps and atomic handshake batch refusal, fixed trickle/stalled deadlines,
+clock rollback/overflow, EOF/truncation, invalid progress counts, injected
+exceptions, zero CPU budget and callback reentry. This proves only the mocked
+adapter/session composition. Actual TCP, profile adoption, daemon dispatch,
+block download/admission and synchronization remain later integration work.
diff --git a/src/lotus_v2/test_peer_transport.cpp b/src/lotus_v2/test_peer_transport.cpp
new file mode 100644
index 000000000..3449e8cf9
--- /dev/null
+++ b/src/lotus_v2/test_peer_transport.cpp
@@ -0,0 +1,485 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_transport.h"
+#include <algorithm>
+#include <functional>
+#include <iostream>
+#include <stdexcept>
+using namespace lotus::v2;
+using namespace lotus::v2::peer;
+#define CHECK(c)                                                               \
+    do {                                                                       \
+        if (!(c))                                                              \
+            throw std::runtime_error("line " + std::to_string(__LINE__) +      \
+                                     ": " #c);                                 \
+    } while (false)
+namespace {
+SessionConfig Config() {
+    SessionConfig c{};
+    c.network.magic = {17, 29, 41,
+                       53}; // arbitrary mock bytes, no network profile
+    c.network.chain_id[0] = 7;
+    c.network.genesis_id[0] = 8;
+    c.network.profile_digest[0] = 9;
+    c.network.receive_limit = 4096;
+    c.network.transaction = {32, 32, 8, 8192, 16, 8192, 64};
+    c.network.max_reconstruction_transactions = 100;
+    c.network.max_reconstruction_bytes = 8192;
+    c.local_version.sender = VersionSender{VersionAddress{}, 42};
+    c.local_version.user_agent = Bytes{'t'};
+    c.local_version.starting_height = 0;
+    c.local_version.relay = true;
+    c.local_version.extra_entropy = 43;
+    c.handshake_timeout_ms = 1000;
+    return c;
+}
+TransportLimits Limits() {
+    return {4096, 8192, 16, 200, 300};
+}
+TransportBudget Budget() {
+    return {100, 65536, 65536};
+}
+Bytes Frame(const Message &message) {
+    Bytes out;
+    std::string error;
+    auto c = Config();
+    const bool handshake =
+        message.command == "version" || message.command == "v2hello" ||
+        message.command == "verack" || message.command == "sendaddrv2";
+    CHECK(handshake ? EncodeHandshakeEnvelope(c.network, message, out, error)
+                    : EncodeEnvelope(c.network, c.network.receive_limit,
+                                     message, out, error));
+    return out;
+}
+Bytes Handshake() {
+    auto c = Config();
+    Bytes version, hello;
+    std::string error;
+    CHECK(EncodeVersion(c.local_version, version, error));
+    Hello h;
+    h.chain_id = c.network.chain_id;
+    h.genesis_id = c.network.genesis_id;
+    h.profile_digest = c.network.profile_digest;
+    h.receive_limit = c.network.receive_limit;
+    CHECK(EncodeHello(h, hello, error));
+    Bytes result;
+    for (const auto &m : std::vector<Message>{
+             {"version", version}, {"v2hello", hello}, {"verack", {}}}) {
+        auto b = Frame(m);
+        result.insert(result.end(), b.begin(), b.end());
+    }
+    return result;
+}
+class MockStream : public ByteStream {
+public:
+    Bytes incoming, written;
+    size_t offset = 0, read_max = SIZE_MAX, write_max = SIZE_MAX;
+    unsigned reads = 0, writes = 0, closes = 0;
+    bool block_read = false, block_write = false;
+    bool throw_read = false, throw_write = false;
+    StreamStatus empty = StreamStatus::WouldBlock;
+    std::optional<StreamResult> bad_read, bad_write;
+    std::function<void()> on_read, on_write, on_close;
+    StreamResult Read(std::span<uint8_t> out) override {
+        ++reads;
+        if (on_read) on_read();
+        if (throw_read) throw std::runtime_error("mock read");
+        if (bad_read) return *bad_read;
+        if (block_read) return {StreamStatus::WouldBlock};
+        if (offset == incoming.size()) return {empty};
+        const size_t n =
+            std::min({out.size(), read_max, incoming.size() - offset});
+        std::copy_n(incoming.begin() + offset, n, out.begin());
+        offset += n;
+        return {StreamStatus::Progress, n};
+    }
+    StreamResult Write(std::span<const uint8_t> in) override {
+        ++writes;
+        if (on_write) on_write();
+        if (throw_write) throw std::runtime_error("mock write");
+        if (bad_write) return *bad_write;
+        if (block_write) return {StreamStatus::WouldBlock};
+        const size_t n = std::min(in.size(), write_max);
+        written.insert(written.end(), in.begin(), in.begin() + n);
+        return {StreamStatus::Progress, n};
+    }
+    void Close() noexcept override {
+        ++closes;
+        if (on_close) on_close();
+    }
+    void Append(const Bytes &b) {
+        incoming.insert(incoming.end(), b.begin(), b.end());
+    }
+};
+void Activate(MockStream &stream, Transport &t, uint64_t now = 1) {
+    stream.Append(Handshake());
+    CHECK(t.Open(now));
+    for (unsigned i = 0; i < 1000 && t.State() != SessionState::Active; ++i) {
+        auto p = t.Poll(now, Budget());
+        CHECK(p.closed == TransportClose::None);
+    }
+    CHECK(t.State() == SessionState::Active);
+    auto event = t.TakeEvent();
+    CHECK(event && event->result == SessionResult::Activated);
+    CHECK(!t.TakeEvent());
+    t.Poll(now, Budget()); // drain final handshake output
+}
+void PartialAndBackpressure() {
+    MockStream stream;
+    stream.read_max = 3;
+    stream.write_max = 2;
+    Transport t(stream, Config(), Limits());
+    Activate(stream, t);
+    CHECK(t.ActiveLimit() == 4096);
+    auto first = Frame({"ping", Bytes{1, 2, 3}}),
+         second = Frame({"pong", Bytes{4, 5}});
+    stream.Append(first);
+    stream.Append(second);
+    for (unsigned i = 0; i < 100; ++i) {
+        auto p = t.Poll(2, Budget());
+        if (p.event_pending) break;
+    }
+    const unsigned reads = stream.reads;
+    const size_t buffered = t.BufferedReadBytes();
+    auto p = t.Poll(3, Budget());
+    CHECK(p.event_pending && stream.reads == reads &&
+          t.BufferedReadBytes() == buffered);
+    auto e = t.TakeEvent();
+    CHECK(e && e->application && e->application->command == "ping" &&
+          e->application->payload == Bytes({1, 2, 3}));
+    for (unsigned i = 0; i < 100; ++i) {
+        if (t.Poll(3, Budget()).event_pending) break;
+    }
+    e = t.TakeEvent();
+    CHECK(e && e->application->command == "pong");
+    CHECK(t.QueueMessage({"ping", {7, 8}}, 3) == QueueResult::Queued);
+    CHECK(t.QueueMessage({"pong", {9}}, 3) == QueueResult::Queued);
+    for (unsigned i = 0; i < 100 && t.QueuedBytes(); ++i)
+        t.Poll(3, Budget());
+    CHECK(t.QueuedBytes() == 0 && t.QueuedFrames() == 0);
+    EnvelopeDecoder decoder(Config().network);
+    size_t offset = 0;
+    std::vector<std::string> commands;
+    while (offset < stream.written.size()) {
+        size_t n = 0;
+        Message message;
+        std::string error;
+        CHECK(decoder.Feed(
+                  std::span<const uint8_t>(stream.written).subspan(offset), n,
+                  message, error) == FeedStatus::MessageReady);
+        offset += n;
+        commands.push_back(message.command);
+    }
+    CHECK(commands == std::vector<std::string>(
+                          {"version", "v2hello", "verack", "ping", "pong"}));
+    CHECK(t.Close() && t.Close());
+    CHECK(stream.closes == 1);
+}
+void CoalescedAndBudget() {
+    MockStream stream;
+    stream.Append(Handshake());
+    stream.Append(Frame({"ping", {1}}));
+    stream.Append(Frame({"pong", {2}}));
+    Transport t(stream, Config(), Limits());
+    CHECK(t.Open(0));
+    CHECK(t.Poll(0, Budget()).event_pending);
+    CHECK(t.State() == SessionState::Active);
+    auto remainder = t.BufferedReadBytes();
+    CHECK(remainder > 0);
+    CHECK(t.TakeEvent()->result == SessionResult::Activated);
+    CHECK(t.Poll(1, Budget()).event_pending);
+    CHECK(t.TakeEvent()->application->command == "ping");
+    CHECK(t.Poll(1, Budget()).event_pending);
+    CHECK(t.TakeEvent()->application->command == "pong");
+    CHECK(t.BufferedReadBytes() == 0);
+    CHECK(t.QueueMessage({"tx", Bytes(100, 3)}, 2) == QueueResult::Queued);
+    stream.Append(Frame({"tx", Bytes(100, 4)}));
+    for (unsigned i = 0; i < 100; ++i) {
+        auto p = t.Poll(2, {3, 7, 5});
+        CHECK(p.actions <= 3 && p.io_calls <= 3 &&
+              p.read_bytes + p.written_bytes <= 7 && p.fed_bytes <= 5);
+        if (p.event_pending) break;
+    }
+    // Zero I/O and feed budgets still service the bounded timer action.
+    const auto reads = stream.reads, writes = stream.writes;
+    auto p = t.Poll(3, {1, 0, 0});
+    CHECK(p.actions == 1 && stream.reads == reads && stream.writes == writes);
+}
+void Capacity() {
+    MockStream s;
+    auto limits = Limits();
+    limits.outbound_bytes = 200;
+    limits.outbound_frames = 1;
+    Transport t(s, Config(), limits);
+    Activate(s, t);
+    CHECK(t.QueueMessage({"tx", Bytes(176, 7)}, 1) == QueueResult::Queued);
+    CHECK(t.QueuedBytes() == 200);
+    CHECK(t.QueueMessage({"pong", {}}, 1) == QueueResult::Backpressure);
+    CHECK(t.QueuedBytes() == 200 && t.State() == SessionState::Active);
+    t.Poll(1, Budget());
+    CHECK(t.QueuedBytes() == 0);
+    CHECK(t.QueueMessage({"tx", Bytes(177, 7)}, 1) ==
+          QueueResult::Backpressure);
+    CHECK(t.QueueMessage({"command-is-too-long", {}}, 1) ==
+          QueueResult::InvalidMessage);
+    CHECK(t.State() == SessionState::Active);
+    MockStream s2;
+    auto c = Config();
+    c.send_address_v2 = true;
+    Transport batch(s2, c, limits);
+    CHECK(batch.Open(1));
+    s2.Append(Handshake());
+    CHECK(batch.Poll(1, Budget()).closed == TransportClose::Capacity);
+    CHECK(s2.closes == 1);
+    CHECK(batch.QueuedBytes() == 0 && batch.QueuedFrames() == 0);
+    MockStream s3;
+    limits.outbound_bytes = 1;
+    Transport tiny(s3, Config(), limits);
+    CHECK(!tiny.Open(1) && tiny.CloseReason() == TransportClose::Capacity &&
+          s3.written.empty());
+}
+void Deadlines() {
+    MockStream s;
+    Transport t(s, Config(), Limits());
+    Activate(s, t);
+    auto frame = Frame({"tx", Bytes(10, 1)});
+    s.Append(Bytes(frame.begin(), frame.begin() + 1));
+    CHECK(t.Poll(10, Budget()).closed == TransportClose::None);
+    s.Append(Bytes(frame.begin() + 1, frame.begin() + 2));
+    CHECK(t.Poll(209, Budget()).closed == TransportClose::None);
+    CHECK(t.Poll(210, Budget()).closed == TransportClose::TimedOut);
+    CHECK(s.closes == 1);
+    MockStream output;
+    Transport q(output, Config(), Limits());
+    Activate(output, q);
+    CHECK(q.QueueMessage({"tx", Bytes(100, 1)}, 10) == QueueResult::Queued);
+    output.write_max = 1;
+    CHECK(q.Poll(309, {2, 1, 0}).closed == TransportClose::None);
+    CHECK(q.Poll(310, Budget()).closed == TransportClose::TimedOut);
+    MockStream handshake;
+    auto l = Limits();
+    l.queued_frame_timeout_ms = 2000;
+    Transport h(handshake, Config(), l);
+    CHECK(h.Open(0));
+    CHECK(h.Poll(999, Budget()).closed == TransportClose::None);
+    CHECK(h.Poll(1000, Budget()).closed == TransportClose::TimedOut);
+    MockStream idle;
+    Transport id(idle, Config(), Limits());
+    Activate(idle, id);
+    CHECK(id.Poll(99999, Budget()).closed == TransportClose::None);
+    MockStream backwards;
+    Transport b(backwards, Config(), Limits());
+    Activate(backwards, b, 10);
+    CHECK(b.Poll(9, Budget()).closed == TransportClose::LocalFailure);
+    MockStream overflow;
+    Transport ov(overflow, Config(), Limits());
+    CHECK(!ov.Open(UINT64_MAX));
+    CHECK(ov.CloseReason() == TransportClose::LocalFailure);
+}
+void BackpressureDeadline() {
+    MockStream s;
+    Transport t(s, Config(), Limits());
+    Activate(s, t);
+    s.Append(Frame({"ping", {1}}));
+    s.Append(Frame({"pong", {2}}));
+    CHECK(t.Poll(10, Budget()).event_pending);
+    CHECK(t.BufferedReadBytes() > 0);
+    CHECK(t.Poll(209, Budget()).event_pending);
+    CHECK(t.Poll(210, Budget()).closed == TransportClose::TimedOut);
+    CHECK(!t.TakeEvent());
+    MockStream blocked;
+    Transport b(blocked, Config(), Limits());
+    Activate(blocked, b);
+    blocked.block_write = true;
+    CHECK(b.QueueMessage({"ping", {}}, 10) == QueueResult::Queued);
+    blocked.Append(Frame({"pong", {4}}));
+    auto p = b.Poll(10, Budget());
+    CHECK(p.write_blocked && p.event_pending);
+    CHECK(b.TakeEvent()->application->command == "pong");
+    CHECK(b.Poll(310, Budget()).closed == TransportClose::TimedOut);
+}
+void BoundaryRegressions() {
+    // Receiving a coalesced buffer starts the next frame's deadline even if
+    // the first frame is fed later under a CPU budget.
+    MockStream delayed;
+    Transport d(delayed, Config(), Limits());
+    Activate(delayed, d);
+    delayed.Append(Frame({"ping", {1}}));
+    delayed.Append(Frame({"pong", {2}}));
+    CHECK(d.Poll(10, {2, 65536, 0}).read_bytes > 0);
+    CHECK(d.Poll(100, Budget()).event_pending);
+    CHECK(d.Poll(210, Budget()).closed == TransportClose::TimedOut);
+    // All small read chunks and short writes must preserve exact message bytes.
+    for (size_t chunk = 1; chunk <= 32; ++chunk) {
+        MockStream s;
+        auto l = Limits();
+        l.read_chunk_bytes = chunk;
+        s.write_max = chunk;
+        Transport t(s, Config(), l);
+        Activate(s, t);
+        auto payload = Bytes(65, static_cast<uint8_t>(chunk));
+        s.Append(Frame({"tx", payload}));
+        bool received = false;
+        for (unsigned i = 0; i < 100; ++i) {
+            auto p = t.Poll(2, {10, 17, 13});
+            CHECK(p.actions <= 10 && p.io_calls <= 10 &&
+                  p.read_bytes + p.written_bytes <= 17 && p.fed_bytes <= 13);
+            CHECK(t.BufferedReadBytes() <= chunk);
+            if (p.event_pending) {
+                received = true;
+                break;
+            }
+        }
+        CHECK(received);
+        auto e = t.TakeEvent();
+        CHECK(e && e->application->payload == payload);
+    }
+    MockStream partial;
+    Transport p(partial, Config(), Limits());
+    Activate(partial, p);
+    partial.Append(Bytes{17});
+    partial.empty = StreamStatus::Eof;
+    CHECK(p.Poll(2, Budget()).closed == TransportClose::EndOfStream);
+    CHECK(p.BufferedReadBytes() == 0 && p.QueuedFrames() == 0);
+    MockStream pre;
+    Transport pending(pre, Config(), Limits());
+    CHECK(pending.Open(0));
+    CHECK(pending.QueueMessage({"ping", {}}, 1) == QueueResult::NotActive);
+    CHECK(pending.Poll(1, {0, 1, 1}).closed == TransportClose::LocalFailure);
+    CHECK(pending.QueueMessage({"ping", {}}, 2) == QueueResult::Closed);
+    MockStream full;
+    auto l = Limits();
+    l.outbound_bytes = 200;
+    l.outbound_frames = 1;
+    Transport q(full, Config(), l);
+    Activate(full, q);
+    full.write_max = 1;
+    CHECK(q.QueueMessage({"tx", Bytes(176, 2)}, 10) == QueueResult::Queued);
+    auto report = q.Poll(11, {2, 1, 0});
+    CHECK(report.written_bytes == 1);
+    CHECK(q.QueuedBytes() == 200 &&
+          q.QueueMessage({"ping", {}}, 11) == QueueResult::Backpressure);
+    for (const auto status : {StreamStatus::Eof, StreamStatus::Error}) {
+        MockStream s;
+        Transport t(s, Config(), Limits());
+        Activate(s, t);
+        CHECK(t.QueueMessage({"ping", {}}, 2) == QueueResult::Queued);
+        s.bad_write = StreamResult{status, 0};
+        CHECK(t.Poll(2, Budget()).closed ==
+              (status == StreamStatus::Eof ? TransportClose::EndOfStream
+                                           : TransportClose::StreamError));
+    }
+    MockStream s;
+    Transport overflow(s, Config(), Limits());
+    Activate(s, overflow);
+    CHECK(overflow.QueueMessage({"ping", {}}, UINT64_MAX) ==
+          QueueResult::Closed);
+    CHECK(overflow.CloseReason() == TransportClose::LocalFailure);
+    MockStream callbacks;
+    Transport guarded(callbacks, Config(), Limits());
+    Activate(callbacks, guarded);
+    callbacks.on_write = [&] {
+        CHECK(!guarded.Close());
+        CHECK(!guarded.Open(2));
+        CHECK(guarded.Poll(2, Budget()).busy);
+        CHECK(!guarded.TakeEvent());
+        CHECK(guarded.QueueMessage({"ping", {}}, 2) == QueueResult::Busy);
+    };
+    CHECK(guarded.QueueMessage({"ping", {}}, 2) == QueueResult::Queued);
+    CHECK(guarded.Poll(2, Budget()).closed == TransportClose::None);
+}
+void FaultsAndReentry() {
+    for (const auto status : {StreamStatus::Eof, StreamStatus::Error}) {
+        MockStream s;
+        Transport t(s, Config(), Limits());
+        Activate(s, t);
+        s.empty = status;
+        CHECK(t.Poll(2, Budget()).closed ==
+              (status == StreamStatus::Eof ? TransportClose::EndOfStream
+                                           : TransportClose::StreamError));
+        CHECK(s.closes == 1);
+    }
+    for (const auto bad : {StreamResult{StreamStatus::Progress, 0},
+                           StreamResult{StreamStatus::Progress, SIZE_MAX},
+                           StreamResult{StreamStatus::WouldBlock, 1},
+                           StreamResult{static_cast<StreamStatus>(99), 0}}) {
+        MockStream s;
+        Transport t(s, Config(), Limits());
+        Activate(s, t);
+        s.bad_read = bad;
+        CHECK(t.Poll(2, Budget()).closed == TransportClose::StreamContract);
+        MockStream w;
+        Transport q(w, Config(), Limits());
+        Activate(w, q);
+        w.bad_write = bad;
+        CHECK(q.QueueMessage({"ping", {}}, 2) == QueueResult::Queued);
+        CHECK(q.Poll(2, Budget()).closed == TransportClose::StreamContract);
+    }
+    for (const bool write : {false, true}) {
+        MockStream s;
+        Transport t(s, Config(), Limits());
+        Activate(s, t);
+        if (write) {
+            s.throw_write = true;
+            CHECK(t.QueueMessage({"ping", {}}, 2) == QueueResult::Queued);
+        } else
+            s.throw_read = true;
+        CHECK(t.Poll(2, Budget()).closed == TransportClose::LocalFailure);
+        CHECK(s.closes == 1);
+    }
+    MockStream s;
+    Transport t(s, Config(), Limits());
+    Activate(s, t);
+    bool callback = false;
+    s.on_read = [&] {
+        callback = true;
+        CHECK(!t.Open(2));
+        CHECK(!t.Close());
+        CHECK(t.QueueMessage({"ping", {}}, 2) == QueueResult::Busy);
+        CHECK(t.Poll(2, Budget()).busy);
+        CHECK(!t.TakeEvent());
+    };
+    CHECK(t.Poll(2, Budget()).closed == TransportClose::None && callback);
+    s.on_close = [&] {
+        CHECK(!t.Close());
+        CHECK(t.QueueMessage({"ping", {}}, 2) == QueueResult::Busy);
+    };
+    CHECK(t.Close());
+    CHECK(s.closes == 1);
+    MockStream rejected;
+    Transport r(rejected, Config(), Limits());
+    CHECK(r.Open(0));
+    rejected.Append(Frame({"ping", {}}));
+    CHECK(r.Poll(1, Budget()).closed == TransportClose::PeerRejected);
+    MockStream unopened;
+    {
+        Transport u(unopened, Config(), Limits());
+    }
+    CHECK(unopened.closes == 1);
+    MockStream invalid;
+    auto l = Limits();
+    l.read_chunk_bytes = 0;
+    bool threw = false;
+    try {
+        Transport x(invalid, Config(), l);
+    } catch (const std::invalid_argument &) {
+        threw = true;
+    }
+    CHECK(threw && invalid.closes == 0);
+}
+} // namespace
+int main() {
+    try {
+        PartialAndBackpressure();
+        CoalescedAndBudget();
+        Capacity();
+        Deadlines();
+        BackpressureDeadline();
+        BoundaryRegressions();
+        FaultsAndReentry();
+        std::cout << "peer transport mocked-stream checks passed\n";
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
