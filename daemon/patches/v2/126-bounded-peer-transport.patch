--- /dev/null
+++ b/src/lotus_v2/peer_transport.cpp
@@ -0,0 +1,312 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_transport.h"
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+namespace lotus::v2::peer {
+namespace {
+    struct Guard {
+        bool &flag;
+        explicit Guard(bool &f) : flag(f) { flag = true; }
+        ~Guard() { flag = false; }
+    };
+} // namespace
+Transport::Transport(ByteStream &stream, SessionConfig config,
+                     TransportLimits limits)
+    : stream_(stream), network_(config.network), limits_(limits) {
+    if (!limits.read_chunk_bytes ||
+        limits.read_chunk_bytes > MAX_RECEIVE_LIMIT || !limits.outbound_bytes ||
+        !limits.outbound_frames || !limits.incomplete_frame_timeout_ms ||
+        !limits.queued_frame_timeout_ms)
+        throw std::invalid_argument(
+            "transport limits must be positive and read chunk bounded");
+    session_ = std::make_unique<Session>(std::move(config));
+    read_.resize(limits.read_chunk_bytes);
+}
+Transport::~Transport() noexcept {
+    busy_ = true;
+    Stop(TransportClose::Requested);
+}
+SessionState Transport::State() const {
+    return session_ ? session_->State() : SessionState::Closed;
+}
+uint32_t Transport::ActiveLimit() const {
+    return session_ ? session_->ActiveLimit() : 0;
+}
+void Transport::Stop(TransportClose reason) noexcept {
+    if (closed_ != TransportClose::None) return;
+    closed_ = reason;
+    // Destroy Session to release decoder allocation even if diagnostics cannot
+    // allocate. Cleanup never calls an allocation-producing OnClosed method.
+    session_.reset();
+    event_.reset();
+    outbound_.clear();
+    Bytes{}.swap(read_);
+    queued_bytes_ = read_begin_ = read_end_ = 0;
+    read_deadline_.reset();
+    stream_.Close();
+}
+bool Transport::Close() noexcept {
+    if (busy_) return false;
+    Guard guard(busy_);
+    Stop(TransportClose::Requested);
+    return true;
+}
+bool Transport::Deadline(uint64_t now, uint64_t duration, uint64_t &out) {
+    if (duration > UINT64_MAX - now) {
+        Stop(TransportClose::LocalFailure);
+        return false;
+    }
+    out = now + duration;
+    return true;
+}
+bool Transport::Time(uint64_t now) {
+    if (closed_ != TransportClose::None) return false;
+    if (!opened_ || now < last_ms_) {
+        Stop(TransportClose::LocalFailure);
+        return false;
+    }
+    last_ms_ = now;
+    if ((read_deadline_ && now >= *read_deadline_) ||
+        (!outbound_.empty() && now >= outbound_.front().deadline)) {
+        Stop(TransportClose::TimedOut);
+        return false;
+    }
+    return true;
+}
+bool Transport::Handle(SessionEvent event, uint64_t now) {
+    switch (event.result) {
+        case SessionResult::PeerRejected:
+            Stop(TransportClose::PeerRejected);
+            return false;
+        case SessionResult::LocalFailure:
+            Stop(TransportClose::LocalFailure);
+            return false;
+        case SessionResult::TimedOut:
+            Stop(TransportClose::TimedOut);
+            return false;
+        case SessionResult::Closed:
+            Stop(TransportClose::Requested);
+            return false;
+        default:
+            break;
+    }
+    size_t extra = 0;
+    if (event.outbound.size() > limits_.outbound_frames - outbound_.size()) {
+        Stop(TransportClose::Capacity);
+        return false;
+    }
+    for (const auto &frame : event.outbound) {
+        if (frame.size() > limits_.outbound_bytes - queued_bytes_ - extra) {
+            Stop(TransportClose::Capacity);
+            return false;
+        }
+        extra += frame.size();
+    }
+    if (!event.outbound.empty()) {
+        uint64_t deadline;
+        if (!Deadline(now, limits_.queued_frame_timeout_ms, deadline))
+            return false;
+        for (auto &frame : event.outbound)
+            outbound_.push_back({std::move(frame), 0, deadline});
+        queued_bytes_ += extra;
+    }
+    event.outbound.clear();
+    if (event.result == SessionResult::Application ||
+        event.result == SessionResult::Activated)
+        event_ = std::move(event);
+    return true;
+}
+bool Transport::Open(uint64_t now) {
+    if (busy_ || closed_ != TransportClose::None) return false;
+    Guard guard(busy_);
+    if (opened_) {
+        Stop(TransportClose::LocalFailure);
+        return false;
+    }
+    opened_ = true;
+    last_ms_ = now;
+    try {
+        return Handle(session_->OnOpen(now), now);
+    } catch (...) {
+        Stop(TransportClose::LocalFailure);
+        return false;
+    }
+}
+QueueResult Transport::QueueMessage(const Message &message, uint64_t now) {
+    if (busy_) return QueueResult::Busy;
+    Guard guard(busy_);
+    if (!Time(now)) return QueueResult::Closed;
+    if (State() != SessionState::Active) return QueueResult::NotActive;
+    // Preflight checked 24-byte overhead before the codec copies or allocates.
+    if (message.payload.size() > std::numeric_limits<size_t>::max() - 24)
+        return QueueResult::Backpressure;
+    const size_t bytes = 24 + message.payload.size();
+    if (outbound_.size() >= limits_.outbound_frames ||
+        bytes > limits_.outbound_bytes - queued_bytes_)
+        return QueueResult::Backpressure;
+    uint64_t deadline;
+    if (!Deadline(now, limits_.queued_frame_timeout_ms, deadline))
+        return QueueResult::Closed;
+    try {
+        Bytes frame;
+        std::string error;
+        if (!EncodeEnvelope(network_, ActiveLimit(), message, frame, error))
+            return QueueResult::InvalidMessage;
+        outbound_.push_back({std::move(frame), 0, deadline});
+        queued_bytes_ += bytes;
+        return QueueResult::Queued;
+    } catch (...) {
+        Stop(TransportClose::LocalFailure);
+        return QueueResult::Closed;
+    }
+}
+std::optional<SessionEvent> Transport::TakeEvent() {
+    if (busy_) return std::nullopt;
+    Guard guard(busy_);
+    auto event = std::move(event_);
+    event_.reset();
+    return event;
+}
+bool Transport::Valid(const StreamResult &result, size_t authorized) {
+    bool valid =
+        result.status == StreamStatus::Progress
+            ? result.count > 0 && result.count <= authorized
+            : result.count == 0 && (result.status == StreamStatus::WouldBlock ||
+                                    result.status == StreamStatus::Eof ||
+                                    result.status == StreamStatus::Error);
+    if (!valid) Stop(TransportClose::StreamContract);
+    return valid;
+}
+TransportPoll Transport::Poll(uint64_t now, const TransportBudget &budget) {
+    TransportPoll report;
+    if (busy_) {
+        report.busy = true;
+        return report;
+    }
+    Guard guard(busy_);
+    auto done = [&] {
+        report.closed = closed_;
+        report.event_pending = event_.has_value();
+        return report;
+    };
+    if (!Time(now)) return done();
+    // At least one action is necessary to service Session's timer. Zero budget
+    // is a caller operational error, not a peer protocol failure.
+    if (!budget.max_actions) {
+        Stop(TransportClose::LocalFailure);
+        return done();
+    }
+    try {
+        ++report.actions;
+        if (!Handle(session_->OnTimer(now), now)) return done();
+        size_t io_authorized = 0;
+        bool read_blocked = false, write_blocked = false;
+        while (report.actions < budget.max_actions) {
+            bool worked = false;
+            // Output gets one bounded attempt per iteration; a blocked write
+            // does not block receive/handshake progress.
+            if (!write_blocked && !outbound_.empty() &&
+                io_authorized < budget.max_io_bytes) {
+                auto &frame = outbound_.front();
+                const size_t n = std::min(frame.bytes.size() - frame.sent,
+                                          budget.max_io_bytes - io_authorized);
+                ++report.actions;
+                ++report.io_calls;
+                const auto result =
+                    stream_.Write(std::span<const uint8_t>(frame.bytes)
+                                      .subspan(frame.sent, n));
+                if (!Valid(result, n)) return done();
+                if (result.status == StreamStatus::Progress) {
+                    io_authorized += result.count;
+                    frame.sent += result.count;
+                    report.written_bytes += result.count;
+                    if (frame.sent == frame.bytes.size()) {
+                        queued_bytes_ -= frame.bytes.size();
+                        outbound_.pop_front();
+                    }
+                    worked = true;
+                } else if (result.status == StreamStatus::WouldBlock) {
+                    report.write_blocked = write_blocked = true;
+                } else {
+                    Stop(result.status == StreamStatus::Eof
+                             ? TransportClose::EndOfStream
+                             : TransportClose::StreamError);
+                    return done();
+                }
+            }
+            if (report.actions >= budget.max_actions) break;
+            if (!event_ && read_begin_ < read_end_ &&
+                report.fed_bytes < budget.max_feed_bytes) {
+                const size_t n =
+                    std::min(read_end_ - read_begin_,
+                             budget.max_feed_bytes - report.fed_bytes);
+                size_t consumed = 0;
+                ++report.actions;
+                auto event = session_->Feed(
+                    std::span<const uint8_t>(read_).subspan(read_begin_, n),
+                    now, consumed);
+                if (consumed > n ||
+                    (consumed == 0 && event.result == SessionResult::Idle)) {
+                    Stop(TransportClose::LocalFailure);
+                    return done();
+                }
+                read_begin_ += consumed;
+                report.fed_bytes += consumed;
+                // Any non-Idle successful event marks a complete envelope.
+                if (event.result != SessionResult::Idle) {
+                    read_deadline_.reset();
+                    if (read_begin_ < read_end_) {
+                        uint64_t deadline;
+                        if (!Deadline(read_arrival_ms_,
+                                      limits_.incomplete_frame_timeout_ms,
+                                      deadline))
+                            return done();
+                        read_deadline_ = deadline;
+                    }
+                }
+                if (read_begin_ == read_end_) read_begin_ = read_end_ = 0;
+                if (!Handle(std::move(event), now)) return done();
+                worked = true;
+            }
+            if (report.actions >= budget.max_actions) break;
+            if (!event_ && !read_blocked && read_end_ == 0 &&
+                io_authorized < budget.max_io_bytes) {
+                const size_t n =
+                    std::min(read_.size(), budget.max_io_bytes - io_authorized);
+                ++report.actions;
+                ++report.io_calls;
+                auto result = stream_.Read(std::span<uint8_t>(read_).first(n));
+                if (!Valid(result, n)) return done();
+                if (result.status == StreamStatus::Progress) {
+                    io_authorized += result.count;
+                    read_arrival_ms_ = now;
+                    read_end_ = result.count;
+                    report.read_bytes += result.count;
+                    if (!read_deadline_) {
+                        uint64_t deadline;
+                        if (!Deadline(read_arrival_ms_,
+                                      limits_.incomplete_frame_timeout_ms,
+                                      deadline))
+                            return done();
+                        read_deadline_ = deadline;
+                    }
+                    worked = true;
+                } else if (result.status == StreamStatus::WouldBlock) {
+                    report.read_blocked = read_blocked = true;
+                } else {
+                    Stop(result.status == StreamStatus::Eof
+                             ? TransportClose::EndOfStream
+                             : TransportClose::StreamError);
+                    return done();
+                }
+            }
+            if (!worked) break;
+        }
+    } catch (...) {
+        Stop(TransportClose::LocalFailure);
+    }
+    return done();
+}
+} // namespace lotus::v2::peer
diff --git a/src/lotus_v2/peer_transport.h b/src/lotus_v2/peer_transport.h
new file mode 100644
index 000000000..7150ed5b3
--- /dev/null
+++ b/src/lotus_v2/peer_transport.h
@@ -0,0 +1,131 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_PEER_TRANSPORT_H
+#define LOTUS_V2_PEER_TRANSPORT_H
+#include "peer_session.h"
+#include <deque>
+#include <memory>
+
+namespace lotus::v2::peer {
+enum class StreamStatus { Progress, WouldBlock, Eof, Error };
+struct StreamResult {
+    StreamStatus status;
+    size_t count = 0;
+};
+// Caller-owned already-connected nonblocking byte stream. No socket creation,
+// endpoint selection or platform type is required. Progress must
+// be 1..span.size; all other statuses require count=0. Interrupted system calls
+// should map to WouldBlock, rather than retrying without the adapter's action
+// budget.
+class ByteStream {
+public:
+    virtual ~ByteStream() = default;
+    virtual StreamResult Read(std::span<uint8_t>) = 0;
+    virtual StreamResult Write(std::span<const uint8_t>) = 0;
+    virtual void Close() noexcept = 0;
+};
+struct TransportLimits {
+    size_t read_chunk_bytes;
+    size_t outbound_bytes; // complete retained frames, including sent prefixes
+    size_t outbound_frames;
+    uint64_t incomplete_frame_timeout_ms;
+    uint64_t queued_frame_timeout_ms;
+};
+struct TransportBudget {
+    size_t
+        max_actions; // each timer, Session::Feed, Read or Write is one action
+    size_t max_io_bytes; // combined read+write transferred bytes; each span <=
+                         // remainder
+    size_t max_feed_bytes; // separately bounded buffered bytes fed to Session
+};
+enum class TransportClose {
+    None,
+    Requested,
+    EndOfStream,
+    StreamError,
+    StreamContract,
+    PeerRejected,
+    LocalFailure,
+    Capacity,
+    TimedOut
+};
+enum class QueueResult {
+    Queued,
+    Backpressure,
+    NotActive,
+    InvalidMessage,
+    Closed,
+    Busy
+};
+struct TransportPoll {
+    size_t actions = 0, io_calls = 0;
+    size_t read_bytes = 0, written_bytes = 0, fed_bytes = 0;
+    bool read_blocked = false, write_blocked = false, event_pending = false;
+    bool busy = false;
+    TransportClose closed = TransportClose::None;
+};
+// Single-owner adapter. The stream object must outlive this adapter. Successful
+// construction adopts connection cleanup, not ownership of the stream object.
+// Destruction/Close closes it exactly once, including an unopened connection.
+// Every public mutation and injected callback is under a whole-operation guard;
+// reentrant Open/Close returns false, QueueMessage returns Busy, Poll reports
+// busy, and TakeEvent returns nullopt. Reentrant destruction is unsupported.
+//
+// Local quotas bound logical retained wire bytes: one read_chunk, Session's
+// <=max(PRE_HELLO_LIMIT, network.receive_limit) decoder payload, one pending
+// application payload, and outbound_bytes over <=outbound_frames. Session will
+// not decode a second message while a delivered event remains pending. Vector
+// growth slack, allocator metadata, caller-owned Message/stream/kernel buffers
+// and transient codec output are separate overhead; this is not an RSS bound.
+// TakeEvent transfers payload ownership to caller. Caller must charge/release
+// that payload separately before DownloadManager reserves staging bytes; its
+// DownloadReservation does not include these transport/session buffers.
+//
+// Fixed frame deadlines start at the first received byte (including leftovers)
+// and at output enqueue respectively; trickle I/O and backpressure never extend
+// them. Idle active connections have no read deadline. Session independently
+// enforces its fixed handshake deadline. No parser or reputation policy here.
+class Transport {
+public:
+    Transport(ByteStream &, SessionConfig, TransportLimits);
+    ~Transport() noexcept;
+    Transport(const Transport &) = delete;
+    Transport &operator=(const Transport &) = delete;
+    bool Open(uint64_t monotonic_ms);
+    QueueResult QueueMessage(const Message &, uint64_t monotonic_ms);
+    TransportPoll Poll(uint64_t monotonic_ms, const TransportBudget &);
+    std::optional<SessionEvent> TakeEvent(); // activation or application only
+    bool Close() noexcept;
+    SessionState State() const;
+    TransportClose CloseReason() const { return closed_; }
+    size_t QueuedBytes() const { return queued_bytes_; }
+    size_t QueuedFrames() const { return outbound_.size(); }
+    size_t BufferedReadBytes() const { return read_end_ - read_begin_; }
+    uint32_t ActiveLimit() const;
+
+private:
+    struct Frame {
+        Bytes bytes;
+        size_t sent;
+        uint64_t deadline;
+    };
+    bool Time(uint64_t);
+    bool Deadline(uint64_t, uint64_t, uint64_t &);
+    bool Handle(SessionEvent, uint64_t);
+    void Stop(TransportClose) noexcept;
+    bool Valid(const StreamResult &, size_t);
+    ByteStream &stream_;
+    NetworkProfile network_;
+    TransportLimits limits_;
+    std::unique_ptr<Session> session_;
+    Bytes read_;
+    size_t read_begin_ = 0, read_end_ = 0;
+    std::deque<Frame> outbound_;
+    size_t queued_bytes_ = 0;
+    std::optional<SessionEvent> event_;
+    std::optional<uint64_t> read_deadline_;
+    uint64_t last_ms_ = 0, read_arrival_ms_ = 0;
+    bool opened_ = false, busy_ = false;
+    TransportClose closed_ = TransportClose::None;
+};
+} // namespace lotus::v2::peer
+#endif
