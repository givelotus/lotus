+    CHECK(MakeCompact(b, p, 999, first, compact, e));
+    Bytes wire;
+    CHECK(EncodeCompact(compact, p, p.receive_limit, wire, e));
+    auto small_count = p;
+    small_count.max_reconstruction_transactions = 2;
+    CompactBlock unchanged;
+    unchanged.nonce = 123;
+    CHECK(DecodeCompact(wire, small_count, p.receive_limit, unchanged, e) ==
+          CompactDecodeStatus::CapacityRefused);
+    CHECK(unchanged.nonce == 123);
+    CompactReconstruction count_refusal(small_count);
+    CHECK(count_refusal.Start(compact, {}, e) ==
+          ReconstructionStatus::NeedFullBlock);
+    // A malformed count is peer-invalid even when it also exceeds our quota.
+    auto malformed = wire;
+    malformed[HEADER_SIZE + 8] = 200;
+    CHECK(DecodeCompact(malformed, small_count, p.receive_limit, unchanged,
+                        e) == CompactDecodeStatus::InvalidPeerMessage);
+    malformed = wire;
+    malformed[HEADER_SIZE + 8 + 1 + 12 + 1] = 3;
+    CHECK(DecodeCompact(malformed, small_count, p.receive_limit, unchanged,
+                        e) == CompactDecodeStatus::InvalidPeerMessage);
+    malformed = wire;
+    malformed.push_back(0);
+    CHECK(DecodeCompact(malformed, small_count, p.receive_limit, unchanged,
+                        e) == CompactDecodeStatus::InvalidPeerMessage);
+    auto small_bytes = p;
+    small_bytes.max_reconstruction_bytes = b.header.size - 1;
+    CHECK(DecodeCompact(wire, small_bytes, p.receive_limit, unchanged, e) ==
+          CompactDecodeStatus::CapacityRefused);
+    CHECK(DecodeCompact(wire, p, uint32_t(wire.size() - 1), unchanged, e) ==
+          CompactDecodeStatus::CapacityRefused);
+    CHECK(unchanged.nonce == 123);
+    // A small claimed size cannot authorize copying large prefilled bodies.
+    // Decode scans the bounded object but retains no over-quota output;
+    // Start preflights complete prefills before allocating/copying its slots.
+    const uint32_t extra[] = {0, 1};
+    CHECK(MakeCompact(b, p, 999, extra, compact, e));
+    compact.prefilled[1].transaction.inputs[0].witnesses[0].arguments[0].resize(
+        8192);
+    compact.header.size = 400;
+    auto budget = p;
+    budget.max_reconstruction_bytes = 500;
+    CHECK(EncodeCompact(compact, p, p.receive_limit, wire, e));
+    CHECK(DecodeCompact(wire, budget, p.receive_limit, unchanged, e) ==
+          CompactDecodeStatus::CapacityRefused);
+    CHECK(unchanged.nonce == 123);
+    CompactReconstruction prefilled_refusal(budget);
+    CHECK(prefilled_refusal.Start(compact, {}, e) ==
+          ReconstructionStatus::NeedFullBlock);
