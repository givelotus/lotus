 // Caller supplies validated, complete cached transactions, reserves quotas and
 // checks contextual header/PoW eligibility before Start(). No consensus-invalid
 // verdict is returned. A failed root/size always requests a full body.
+// A lifecycle issues at most one missing request. Start while it is outstanding
+// returns RequestOutstanding without mutation; after completion/cancellation it
+// requires full-block fallback. The caller must retain this lifecycle for that
+// peer/BlockID until disconnection, because blocktxn carries no request nonce.
+// The caller bounds these retained tombstones and refuses further compact
+// lifecycles or disconnects when that quota is reached; it cannot evict one
+// while allowing a same-peer/same-BlockID missing request again.
+// Allocation failures are operational exceptions for the caller to handle.
 class CompactReconstruction {
 public:
     explicit CompactReconstruction(const NetworkProfile &);
+#ifdef LOTUS_V2_PEER_CODEC_TESTING
+    // Standalone test-only seam to exercise true collision state transitions.
+    // Absent from production builds; production hashing is not configurable.
+    using TestShortId = uint64_t (*)(const CompactKeys &, const Hash &);
+    CompactReconstruction(const NetworkProfile &, TestShortId);
+#endif
     ReconstructionStatus Start(const CompactBlock &,
                                std::span<const Transaction>, std::string &);
     const MissingRequest &Request() const { return request_; }
@@ -161,13 +181,20 @@ private:
     bool Store(uint32_t, const Transaction &, std::string &);
     uint64_t retained_wire_bytes_ = HEADER_SIZE + 4;
     NetworkProfile profile_;
-    CompactBlock compact_;
+    Header header_{};
+    uint64_t MatchShortId(const Hash &) const;
+#ifdef LOTUS_V2_PEER_CODEC_TESTING
+    TestShortId test_short_id_ = nullptr;
+#endif
     CompactKeys keys_{};
     MissingRequest request_{};
     std::vector<std::optional<Transaction>> slots_;
     std::vector<std::optional<uint64_t>> expected_short_ids_;
     std::optional<FramedBlock> complete_;
     bool outstanding_ = false;
+    // A blocktxn response has no nonce/request generation. Never issue another
+    // missing request from this lifecycle after cancellation/completion.
+    bool request_issued_ = false;
 };
 } // namespace lotus::v2::peer
 #endif
