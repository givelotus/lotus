 src/lotus_v2/test_vm.cpp             | 62 ++++++++++++++++++++++++
 src/lotus_v2/vm.cpp                  | 71 +++++++++++++++++++++-------
 src/lotus_v2/vm.h                    | 35 ++++++++++++++
 src/lotus_v2/vm_test/CMakeLists.txt  |  1 +
 7 files changed, 161 insertions(+), 24 deletions(-)

