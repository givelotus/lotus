+FUZZ_TARGET(v2_merklix_sync) {
+    FuzzedDataProvider fdp(buffer.data(), buffer.size());
+
+    const uint64_t k0 = fdp.ConsumeIntegral<uint64_t>();
+    const uint64_t k1 = fdp.ConsumeIntegral<uint64_t>();
+
+    // 1. Fuzz IndexedTreeRoot & IndexedProofRoot.
+    {
+        const size_t n_leaves = fdp.ConsumeIntegralInRange<size_t>(1, 16);
+        std::vector<lotus::v2::Hash> leaves;
+        leaves.reserve(n_leaves);
+        for (size_t i = 0; i < n_leaves; ++i) {
+            leaves.push_back(ConsumeHash(fdp));
+        }
+        const lotus::v2::Hash tree_root = lotus::v2::IndexedTreeRoot(leaves);
+        const lotus::v2::Hash tree_root_again =
+            lotus::v2::IndexedTreeRoot(leaves);
+        Assert(tree_root == tree_root_again);
+    }
+
+    // 2. Fuzz Merklix TransactionRoot & GF(2^64) (s1, s3) set reconciliation
+    // with the Strict 256-Bit Root-Verification Gate.
+    lotus::v2::TxIdentityPair coinbase{ConsumeHash(fdp), ConsumeHash(fdp)};
+
+    const size_t base_count = fdp.ConsumeIntegralInRange<size_t>(0, 12);
+    std::map<lotus::v2::Hash, lotus::v2::TxIdentityPair> map_a;
+    std::map<uint64_t, lotus::v2::TxIdentityPair> universe_by_sid;
+
+    auto add_to_universe = [&](const lotus::v2::TxIdentityPair &pair) -> bool {
+        const uint64_t sid = ShortIdForTxHash(k0, k1, pair.tx_hash);
+        if (universe_by_sid.count(sid) != 0) {
+            return false;
+        }
+        universe_by_sid.emplace(sid, pair);
+        return true;
+    };
+
+    for (size_t i = 0; i < base_count; ++i) {
+        lotus::v2::TxIdentityPair p{ConsumeHash(fdp), ConsumeHash(fdp)};
+        if (map_a.count(p.tx_id) == 0 && add_to_universe(p)) {
+            map_a.emplace(p.tx_id, p);
+        }
+    }
+
+    std::map<lotus::v2::Hash, lotus::v2::TxIdentityPair> map_b = map_a;
+    const size_t diff_mode = fdp.ConsumeIntegralInRange<size_t>(0, 3);
+    size_t actual_diff = 0;
+    for (size_t d = 0; d < diff_mode; ++d) {
+        lotus::v2::TxIdentityPair extra{ConsumeHash(fdp), ConsumeHash(fdp)};
+        if (map_a.count(extra.tx_id) == 0 && map_b.count(extra.tx_id) == 0 &&
+            add_to_universe(extra)) {
+            if (fdp.ConsumeBool()) {
+                map_b.emplace(extra.tx_id, extra);
+            } else {
+                map_a.emplace(extra.tx_id, extra);
+            }
+            ++actual_diff;
+        }
+    }
+
+    std::vector<lotus::v2::TxIdentityPair> vec_a, vec_b;
+    for (const auto &[_, tx] : map_a) vec_a.push_back(tx);
+    for (const auto &[_, tx] : map_b) vec_b.push_back(tx);
+
+    const BucketSyndrome syn_a = ComputeBucketSyndrome(coinbase, vec_a, k0, k1);
+    const BucketSyndrome syn_b = ComputeBucketSyndrome(coinbase, vec_b, k0, k1);
+
+    const uint64_t ds1 = syn_a.s1 ^ syn_b.s1;
+    const uint64_t ds3 = syn_a.s3 ^ syn_b.s3;
+
+    if (actual_diff == 0) {
+        Assert(syn_a.root == syn_b.root);
+        Assert(ds1 == 0 && ds3 == 0);
+    } else if (actual_diff == 1) {
+        Assert(ds1 != 0);
+        Assert(Gf64Cube(ds1) == ds3);
+        const auto it = universe_by_sid.find(ds1);
+        Assert(it != universe_by_sid.end());
+
+        // Apply symmetric difference to A and verify 256-bit Merklix root!
+        auto reconciled = map_a;
+        if (!reconciled.erase(it->second.tx_id)) {
+            reconciled.emplace(it->second.tx_id, it->second);
+        }
+        std::vector<lotus::v2::TxIdentityPair> rec_vec;
+        for (const auto &[_, tx] : reconciled) rec_vec.push_back(tx);
+        const BucketSyndrome syn_rec =
+            ComputeBucketSyndrome(coinbase, rec_vec, k0, k1);
+        Assert(syn_rec.root == syn_b.root);
+    } else if (actual_diff == 2) {
+        const auto roots = SolveQuadraticGf64(ds1, ds3);
+        Assert(roots.has_value());
+        const auto it1 = universe_by_sid.find(roots->first);
+        const auto it2 = universe_by_sid.find(roots->second);
+        Assert(it1 != universe_by_sid.end());
+        Assert(it2 != universe_by_sid.end());
+
+        auto reconciled = map_a;
+        for (const auto *it : {&it1, &it2}) {
+            if (!reconciled.erase((*it)->second.tx_id)) {
+                reconciled.emplace((*it)->second.tx_id, (*it)->second);
+            }
+        }
+        std::vector<lotus::v2::TxIdentityPair> rec_vec;
+        for (const auto &[_, tx] : reconciled) rec_vec.push_back(tx);
+        const BucketSyndrome syn_rec =
+            ComputeBucketSyndrome(coinbase, rec_vec, k0, k1);
+        Assert(syn_rec.root == syn_b.root);
+    } else {
+        // Strict 256-Bit Root-Verification Gate: even if a >=3-tx difference
+        // or adversarial syndrome happens to yield a 1-tx or 2-tx candidate,
+        // the recomputed 32-byte Merklix root will NOT equal syn_b.root.
+        Assert(syn_a.root != syn_b.root);
+    }
+}
diff --git a/src/test/fuzz/v2_tmplblock.cpp b/src/test/fuzz/v2_tmplblock.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..67e99bf0dcf77f8ba76fa8a2bf207864f1de593b
--- /dev/null
+++ b/src/test/fuzz/v2_tmplblock.cpp
@@ -0,0 +1,212 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <lotus_v2/block_template.h>
+#include <lotus_v2/block_wire.h>
+#include <lotus_v2/commitment.h>
+#include <lotus_v2/header.h>
+#include <lotus_v2/sparse_state.h>
+#include <lotus_v2/tagged_hash.h>
+#include <lotus_v2/transaction.h>
+
+#include <test/fuzz/FuzzedDataProvider.h>
+#include <test/fuzz/fuzz.h>
+#include <util/check.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace {
+
+lotus::v2::Hash ConsumeHash(FuzzedDataProvider &fdp) {
+    lotus::v2::Hash h{};
+    const auto b = fdp.ConsumeBytes<uint8_t>(32);
+    std::copy(b.begin(), b.end(), h.begin());
+    return h;
+}
+
+// Compute Subtree A root over CTOR-sorted non-coinbase (TxID, TxHash) pairs,
+// and combine with CoinbaseLeaf in O(1) as specified in Section 3.6.
+lotus::v2::Hash ComputeCoinbaseLeaf(const lotus::v2::TxIdentityPair &cb) {
+    std::array<uint8_t, 65> payload{};
+    payload[0] = 0x00;
+    std::copy(cb.tx_hash.begin(), cb.tx_hash.end(), payload.begin() + 1);
+    std::copy(cb.tx_id.begin(), cb.tx_id.end(), payload.begin() + 33);
+    return lotus::v2::TaggedHash(lotus::v2::HashDomain::TxRoot, payload);
+}
+
+lotus::v2::Hash CombineCoinbaseAndSubtreeA(const lotus::v2::Hash &cb_leaf,
+                                           const lotus::v2::Hash &subtree_a) {
+    std::array<uint8_t, 65> payload{};
+    payload[0] = 0x03;
+    std::copy(cb_leaf.begin(), cb_leaf.end(), payload.begin() + 1);
+    std::copy(subtree_a.begin(), subtree_a.end(), payload.begin() + 33);
+    return lotus::v2::TaggedHash(lotus::v2::HashDomain::TxRoot, payload);
+}
+
+struct CandidateOverlayStub {
+    lotus::v2::Hash subtree_a_root{};
+    lotus::v2::Hash utxo_root{};
+    lotus::v2::MonetaryState monetary{};
+    uint64_t total_body_bytes = 0;
+};
+
+} // namespace
+
+FUZZ_TARGET(v2_tmplblock) {
+    FuzzedDataProvider fdp(buffer.data(), buffer.size());
+
+    const lotus::v2::ChainId chain_id = ConsumeHash(fdp);
+    lotus::v2::Hash max_pow_limit{};
+    max_pow_limit.fill(0xff);
+
+    // 1. Fuzz 134-byte V2 Header parsing, serialization, PoW hashing & child template.
+    {
+        const std::vector<uint8_t> raw_hdr =
+            fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 160));
+        lotus::v2::Header parsed{};
+        if (lotus::v2::ParseHeader(raw_hdr.data(), raw_hdr.size(), parsed)) {
+            Assert(raw_hdr.size() == lotus::v2::HEADER_SIZE);
+            Assert(parsed.time <= lotus::v2::MAX_TIME);
+
+            std::array<uint8_t, lotus::v2::HEADER_SIZE> ser{};
+            Assert(lotus::v2::SerializeHeader(parsed, ser));
+            Assert(std::equal(ser.begin(), ser.end(), raw_hdr.begin()));
+
+            lotus::v2::Header reparsed{};
+            Assert(lotus::v2::ParseHeader(ser.data(), ser.size(), reparsed));
+            Assert(reparsed.prev_id == parsed.prev_id);
+            Assert(reparsed.bits == parsed.bits);
+            Assert(reparsed.time == parsed.time);
+            Assert(reparsed.nonce == parsed.nonce);
+            Assert(reparsed.version == parsed.version);
+            Assert(reparsed.size == parsed.size);
+            Assert(reparsed.height == parsed.height);
+            Assert(reparsed.tx_root == parsed.tx_root);
+            Assert(reparsed.state_root == parsed.state_root);
+
+            const lotus::v2::Hash body_hash =
+                lotus::v2::BodyHash(chain_id, parsed);
+            lotus::v2::Hash work_hash{}, block_id{};
+            Assert(lotus::v2::WorkHash(chain_id, parsed, work_hash));
+            Assert(lotus::v2::BlockId(chain_id, parsed, block_id));
+            (void)body_hash;
+
+            lotus::v2::Hash target{};
+            if (lotus::v2::DecodeTarget(parsed.bits, max_pow_limit, target)) {
+                (void)lotus::v2::MeetsTarget(block_id, target);
+                auto child = lotus::v2::BuildChildHeader(
+                    parsed, chain_id, ConsumeHash(fdp), ConsumeHash(fdp),
+                    parsed.time, 512, parsed.bits);
+                if (child.has_value()) {
+                    Assert(child->prev_id == block_id);
+                    Assert(child->height == parsed.height + 1);
+                    lotus::v2::Header search_hdr = *child;
+                    (void)lotus::v2::SearchNonce(search_hdr, chain_id,
+                                                 max_pow_limit, 0, 4);
+                }
+            }
+        }
+    }
+
+    // 2. Fuzz DecodeBlockWire / EncodeBlockWire on arbitrary byte streams.
+    {
+        const lotus::v2::TxProfile tx_profile{8, 8, 4, 256, 4, 512, 16};
+        const std::vector<uint8_t> raw_block =
+            fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 512));
+        lotus::v2::FramedBlock framed{};
+        std::string err;
+        if (lotus::v2::DecodeBlockWire(raw_block, tx_profile, chain_id, framed,
+                                       err)) {
+            Assert(err.empty());
+            std::vector<uint8_t> reencoded;
+            Assert(lotus::v2::EncodeBlockWire(framed.header, framed.transactions,
+                                              tx_profile, reencoded, err));
+            Assert(reencoded == raw_block);
+
+            lotus::v2::Hash tx_root{};
+            Assert(lotus::v2::CompleteTransactionRoot(
+                framed.transactions, tx_profile, chain_id, tx_root, err));
+        }
+    }
+
+    // 3. Fuzz tmplblock (Header || CoinbaseTx) Pre-Allocation PoW Gate &
+    // Stage 1 Candidate Overlay Root Match ({L_k, L_{k-1}, L_0, L_spec}).
+    {
+        std::array<CandidateOverlayStub, 4> overlays{};
+        for (auto &ov : overlays) {
+            ov.subtree_a_root = ConsumeHash(fdp);
+            ov.utxo_root = ConsumeHash(fdp);
+            ov.monetary.bootstrap_reserve = fdp.ConsumeIntegral<uint64_t>();
+            ov.monetary.tail_subsidy = fdp.ConsumeIntegral<uint64_t>();
+            ov.monetary.prev_work = ConsumeHash(fdp);
+            ov.monetary.ema_block_cost = fdp.ConsumeIntegral<uint64_t>();
+            ov.total_body_bytes = fdp.ConsumeIntegralInRange<uint64_t>(0, 1'000'000);
+        }
+
+        // Construct a valid CoinbaseTx and matching/mismatched Header.
+        const size_t chosen_idx = fdp.ConsumeIntegralInRange<size_t>(0, 3);
+        const CandidateOverlayStub &chosen = overlays[chosen_idx];
+
+        const lotus::v2::TxIdentityPair cb_pair{ConsumeHash(fdp),
+                                                ConsumeHash(fdp)};
+        const lotus::v2::Hash cb_leaf = ComputeCoinbaseLeaf(cb_pair);
+        const lotus::v2::Hash expected_tx_root =
+            CombineCoinbaseAndSubtreeA(cb_leaf, chosen.subtree_a_root);
+        const uint64_t height = fdp.ConsumeIntegralInRange<uint64_t>(1, 100'000);
+        const lotus::v2::Hash expected_state_root = lotus::v2::StateRoot(
+            chain_id, height, chosen.utxo_root, chosen.monetary);
+
+        lotus::v2::Header hdr{};
+        hdr.prev_id = ConsumeHash(fdp);
+        hdr.bits = 0x207fffffU;
+        hdr.time = fdp.ConsumeIntegralInRange<uint64_t>(0, lotus::v2::MAX_TIME);
+        hdr.nonce = fdp.ConsumeIntegral<uint64_t>();
+        hdr.version = lotus::v2::kHeaderVersion;
+        const uint64_t cb_framed_len = fdp.ConsumeIntegralInRange<uint64_t>(64, 512);
+        hdr.size = lotus::v2::HEADER_SIZE +
+                   lotus::v2::CompactSizeWidth(10) + cb_framed_len +
+                   chosen.total_body_bytes;
+        hdr.height = height;
+        hdr.tx_root = expected_tx_root;
+        hdr.state_root = expected_state_root;
+
+        const bool corrupt_root = fdp.ConsumeBool();
+        if (corrupt_root) {
+            if (fdp.ConsumeBool()) {
+                hdr.tx_root[0] ^= 0x01;
+            } else {
+                hdr.state_root[0] ^= 0x01;
+            }
+        }
+
+        // Stage 1 Candidate Root Check across {L_k, L_{k-1}, L_0, L_spec}:
+        std::optional<size_t> matched;
+        for (size_t i = 0; i < overlays.size(); ++i) {
+            const lotus::v2::Hash cand_tx_root =
+                CombineCoinbaseAndSubtreeA(cb_leaf, overlays[i].subtree_a_root);
+            if (cand_tx_root == hdr.tx_root) {
+                const lotus::v2::Hash cand_state_root = lotus::v2::StateRoot(
+                    chain_id, hdr.height, overlays[i].utxo_root,
+                    overlays[i].monetary);
+                if (cand_state_root == hdr.state_root) {
+                    matched = i;
+                    break;
+                }
+            }
+        }
+
+        if (!corrupt_root) {
+            Assert(matched.has_value());
+            Assert( overlays[*matched].subtree_a_root == chosen.subtree_a_root);
+            Assert( overlays[*matched].utxo_root == chosen.utxo_root);
+        } else {
+            Assert(!matched.has_value());
+        }
+    }
+}
diff --git a/src/test/fuzz/v2_vm_and_tx.cpp b/src/test/fuzz/v2_vm_and_tx.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5bb5fb47cd9ea40c555443d67fbe0636080d8b51
--- /dev/null
+++ b/src/test/fuzz/v2_vm_and_tx.cpp
@@ -0,0 +1,328 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <lotus_v2/commitment.h>
+#include <lotus_v2/incremental_utxo.h>
+#include <lotus_v2/ordinary_validation.h>
+#include <lotus_v2/output.h>
+#include <lotus_v2/sparse_state.h>
+#include <lotus_v2/transaction.h>
+#include <lotus_v2/vm.h>
+
+#include <test/fuzz/FuzzedDataProvider.h>
+#include <test/fuzz/fuzz.h>
+#include <util/check.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace {
+
+lotus::v2::Hash ConsumeHash32(FuzzedDataProvider &fdp) {
+    lotus::v2::Hash h{};
+    const auto bytes = fdp.ConsumeBytes<uint8_t>(32);
+    std::copy(bytes.begin(), bytes.end(), h.begin());
+    return h;
+}
+
+lotus::v2::Output ConsumeValidOutput(FuzzedDataProvider &fdp) {
+    lotus::v2::Output out;
+    out.flags = fdp.ConsumeIntegralInRange<uint8_t>(0, 3);
+    out.value = fdp.ConsumeIntegralInRange<uint64_t>(0, 1'000'000'000ULL);
+    if (out.HasToken()) {
+        out.token_id = ConsumeHash32(fdp);
+    }
+    if (!out.IsBurn()) {
+        const size_t n_branches = fdp.ConsumeIntegralInRange<size_t>(1, 4);
+        for (size_t i = 0; i < n_branches; ++i) {
+            out.branches.push_back(ConsumeHash32(fdp));
+        }
+        const size_t n_paths = fdp.ConsumeIntegralInRange<size_t>(1, 4);
+        for (size_t i = 0; i < n_paths; ++i) {
+            const size_t path_len = fdp.ConsumeIntegralInRange<size_t>(1, 4);
+            std::vector<uint8_t> path;
+            path.reserve(path_len);
+            for (size_t j = 0; j < path_len; ++j) {
+                path.push_back(static_cast<uint8_t>(
+                    fdp.ConsumeIntegralInRange<size_t>(0, n_branches - 1)));
+            }
+            std::sort(path.begin(), path.end());
+            path.erase(std::unique(path.begin(), path.end()), path.end());
+            out.paths.push_back(std::move(path));
+        }
+    }
+    return out;
+}
+
+} // namespace
+
+FUZZ_TARGET(v2_vm_and_tx) {
+    FuzzedDataProvider fdp(buffer.data(), buffer.size());
+
+    const lotus::v2::TxProfile tx_profile{
+        16,   // max_inputs
+        16,   // max_outputs
+        8,    // max_mints
+        512,  // max_script_bytes
+        8,    // max_arguments
+        1024, // max_argument_bytes
+        16,   // max_branch_proof_depth
+    };
+
+    const lotus::v2::ChainId chain_id = ConsumeHash32(fdp);
+
+    // 1. Fuzz raw Output and Transaction parsing & round-trip serialization.
+    {
+        const std::vector<uint8_t> raw_out_bytes =
+            fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 256));
+        lotus::v2::Output decoded_out;
+        std::string err;
+        if (lotus::v2::DecodeOutput(raw_out_bytes, decoded_out, err)) {
+            Assert(err.empty());
+            std::vector<uint8_t> reencoded;
+            Assert(lotus::v2::EncodeOutput(decoded_out, reencoded, err));
+            Assert(reencoded == raw_out_bytes);
+            lotus::v2::Output decoded_again;
+            Assert(lotus::v2::DecodeOutput(reencoded, decoded_again, err));
+            Assert(decoded_again.flags == decoded_out.flags);
+            Assert(decoded_again.value == decoded_out.value);
+            Assert(decoded_again.token_id == decoded_out.token_id);
+            Assert(decoded_again.branches == decoded_out.branches);
+            Assert(decoded_again.paths == decoded_out.paths);
+        }
+    }
+
+    {
+        const std::vector<uint8_t> raw_tx_bytes =
+            fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
+        lotus::v2::Transaction decoded_tx;
+        std::string err;
+        if (lotus::v2::DecodeTransaction(raw_tx_bytes, tx_profile, decoded_tx,
+                                         err)) {
+            Assert(err.empty());
+            std::vector<uint8_t> reencoded;
+            Assert(lotus::v2::EncodeTransaction(decoded_tx, tx_profile,
+                                                reencoded, err));
+            Assert(reencoded == raw_tx_bytes);
+
+            lotus::v2::Hash32 txid1{}, txhash1{};
+            Assert(lotus::v2::ComputeTransactionIdentities(
+                decoded_tx, tx_profile, chain_id, txid1, txhash1, err));
+
+            lotus::v2::Transaction decoded_again;
+            Assert(lotus::v2::DecodeTransaction(reencoded, tx_profile,
+                                                decoded_again, err));
+            lotus::v2::Hash32 txid2{}, txhash2{};
+            Assert(lotus::v2::ComputeTransactionIdentities(
+                decoded_again, tx_profile, chain_id, txid2, txhash2, err));
+            Assert(txid1 == txid2);
+            Assert(txhash1 == txhash2);
+
+            for (const auto &in : decoded_tx.inputs) {
+                std::vector<uint8_t> core_bytes, full_bytes;
+                Assert(lotus::v2::EncodeInputCore(in, tx_profile, core_bytes,
+                                                  err));
+                Assert(lotus::v2::EncodeInputFull(in, tx_profile, full_bytes,
+                                                  err));
+                (void)lotus::v2::InputCoreLeaf(core_bytes);
+                (void)lotus::v2::InputFullLeaf(full_bytes);
+            }
+            (void)lotus::v2::CheckCoinbaseContext(decoded_tx, chain_id, 10, err);
+        }
+    }
+
+    // 2. Fuzz Lotus V2 VM (EvaluateVm, EvaluateVmCharged, EvaluateVmWithContext)
+    // including 1KB BigInt operands.
+    {
+        const lotus::v2::VmProfile vm_profile{
+            256,   // max_script_bytes
+            8,     // max_arguments
+            2048,  // max_element_bytes (allows 1KB BigInt & 2KB mul result)
+            32,    // max_stack_items
+            16,    // max_altstack_items
+            16384, // max_vm_bytes
+            12,    // max_ast_depth
+            2048,  // max_steps
+        };
+        lotus::v2::VmCostProfile cost_profile{};
+        cost_profile.max_invocation_cost = 500'000;
+        cost_profile.structural_byte_cost = 1;
+        for (auto &op : cost_profile.opcode) {
+            op = {1, 1, 1};
+        }
+        std::string cost_err;
+        Assert(lotus::v2::ValidateVmCostProfile(vm_profile, cost_profile,
+                                                cost_err));
+
+        const std::vector<uint8_t> script =
+            fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 256));
+        const size_t num_args = fdp.ConsumeIntegralInRange<size_t>(0, 6);
+        std::vector<lotus::v2::VmBytes> args;
+        args.reserve(num_args);
+        for (size_t i = 0; i < num_args; ++i) {
+            // Mix 16-byte numbers, 1024-byte BigInts, and arbitrary sizes.
+            const size_t arg_len = fdp.PickValueInArray<size_t>(
+                {0, 1, 16, 32, 64, 128, 512, 1024});
+            args.push_back(fdp.ConsumeBytes<uint8_t>(arg_len));
+        }
+
+        const uint16_t in_cnt = fdp.ConsumeIntegralInRange<uint16_t>(0, 8);
+        const uint16_t out_cnt = fdp.ConsumeIntegralInRange<uint16_t>(0, 8);
+
+        const lotus::v2::VmResult res1 =
+            lotus::v2::EvaluateVm(script, args, vm_profile, in_cnt, out_cnt);
+        const lotus::v2::VmResult res2 =
+            lotus::v2::EvaluateVm(script, args, vm_profile, in_cnt, out_cnt);
+        Assert(res1.status == res2.status);
+        Assert(res1.final_stack == res2.final_stack);
+
+        const lotus::v2::VmChargedResult charged =
+            lotus::v2::EvaluateVmCharged(script, args, vm_profile, cost_profile,
+                                         in_cnt, out_cnt, nullptr);
+        if (charged.charged &&
+            charged.invocation.status == lotus::v2::VmStatus::Success) {
+            Assert(charged.enforcement_cost <= cost_profile.max_invocation_cost);
+            Assert(!charged.invocation.final_stack.empty());
+        }
+
+        // Also exercise EvaluateVmWithContext & CheckOrdinaryCandidate on a
+        // synthesized single-input spend transaction.
+        if (!script.empty() && script.size() <= vm_profile.max_script_bytes &&
+            args.size() <= vm_profile.max_arguments) {
+            lotus::v2::Coin spent_coin{};
+            spent_coin.outpoint.tx_id = ConsumeHash32(fdp);
+            spent_coin.outpoint.index = 0;
+            spent_coin.output.flags = 0;
+            spent_coin.output.value = 100'000;
+            spent_coin.output.branches = {lotus::v2::BranchLeaf(script)};
+            spent_coin.output.paths = {{0}};
+            spent_coin.creation_height = 1;
+            spent_coin.creation_parent_mtp = 1000;
+            spent_coin.coinbase = false;
+
+            lotus::v2::Transaction tx{};
+            tx.lock = 0;
+            lotus::v2::Input in{};
+            in.prev_txid = spent_coin.outpoint.tx_id;
+            in.prev_index = 0;
+            in.sequence = 0;
+            in.flags = 1; // spend
+            in.path_index = 0;
+            in.witnesses.push_back(lotus::v2::BranchWitness{script, {}, args});
+            tx.inputs.push_back(in);
+
+            lotus::v2::Output out{};
+            out.flags = 0;
+            out.value = 90'000;
+            out.branches = {spent_coin.output.branches[0]};
+            out.paths = {{0}};
+            tx.outputs.push_back(out);
+
+            lotus::v2::OrdinaryCandidateProfile ord_profile{
+                tx_profile, vm_profile, cost_profile,
+                100,        50000,      2,
+                100,        5'000'000};
+            lotus::v2::DevelopmentUtxoView utxo_view;
+            utxo_view.emplace(spent_coin.outpoint, spent_coin);
+            lotus::v2::OrdinaryCandidateEffects effects{};
+            std::string ord_err;
+            (void)lotus::v2::CheckOrdinaryCandidate(
+                tx, ord_profile, chain_id, utxo_view, effects, ord_err);
+        }
+    }
+
+    // 3. Fuzz Sparse State Tree (UtxoSet vs IncrementalUtxoSet, Commutativity,
+    // and Proof Verification).
+    {
+        lotus::v2::UtxoSet ref_set;
+        lotus::v2::IncrementalUtxoSet inc_set;
+
+        Assert(ref_set.Root() == lotus::v2::EmptyUtxoRoot());
+        Assert(inc_set.Root() == lotus::v2::EmptyUtxoRoot());
+
+        std::vector<lotus::v2::Outpoint> known_outpoints;
+        const size_t num_ops = fdp.ConsumeIntegralInRange<size_t>(1, 24);
+        for (size_t step = 0; step < num_ops && fdp.remaining_bytes() > 0;
+             ++step) {
+            const bool do_erase =
+                !known_outpoints.empty() && fdp.ConsumeBool();
+            if (do_erase) {
+                const size_t idx = fdp.ConsumeIntegralInRange<size_t>(
+                    0, known_outpoints.size() - 1);
+                const lotus::v2::Outpoint op = known_outpoints[idx];
+                const bool r1 = ref_set.Erase(op);
+                const bool r2 = inc_set.Erase(op);
+                Assert(r1 == r2);
+                if (r1) {
+                    known_outpoints.erase(known_outpoints.begin() +
+                                          static_cast<std::ptrdiff_t>(idx));
+                }
+            } else {
+                lotus::v2::Coin coin{};
+                coin.outpoint.tx_id = ConsumeHash32(fdp);
+                coin.outpoint.index = fdp.ConsumeIntegral<uint32_t>();
+                coin.output = ConsumeValidOutput(fdp);
+                if (coin.output.IsBurn()) {
+                    coin.output.flags &= ~uint8_t{2};
+                    if (coin.output.branches.empty()) {
+                        coin.output.branches.push_back(ConsumeHash32(fdp));
+                        coin.output.paths.push_back({0});
+                    }
+                }
+                coin.creation_height = fdp.ConsumeIntegral<uint32_t>();
+                coin.creation_parent_mtp = fdp.ConsumeIntegral<uint32_t>();
+                coin.coinbase = fdp.ConsumeBool();
+
+                std::vector<uint8_t> encoded_coin;
+                if (lotus::v2::EncodeCoin(coin, encoded_coin)) {
+                    lotus::v2::Coin decoded_coin{};
+                    Assert(lotus::v2::DecodeCoinBytes(encoded_coin,
+                                                      decoded_coin));
+                    const bool r1 = ref_set.Insert(coin);
+                    const bool r2 = inc_set.Insert(coin);
+                    Assert(r1 == r2);
+                    if (r1) {
+                        known_outpoints.push_back(coin.outpoint);
+                    }
+                }
+            }
+        }
+
+        Assert(ref_set.Size() == inc_set.Size());
+        const lotus::v2::Hash root_ref = ref_set.Root();
+        const lotus::v2::Hash root_inc = inc_set.Root();
+        Assert(root_ref == root_inc);
+
+        // Verify commutativity (reverse insertion order produces identical root).
+        lotus::v2::IncrementalUtxoSet rev_set;
+        const auto &surviving = ref_set.Coins();
+        for (auto it = surviving.rbegin(); it != surviving.rend(); ++it) {
+            Assert(rev_set.Insert(*it));
+        }
+        Assert(rev_set.Root() == root_ref);
+
+        // Verify membership and non-membership proofs.
+        if (!known_outpoints.empty()) {
+            const lotus::v2::Outpoint q = known_outpoints.front();
+            const lotus::v2::CoinProof p_ref = ref_set.Prove(q);
+            const lotus::v2::CoinProof p_inc = inc_set.Prove(q);
+            Assert(p_ref.presence == lotus::v2::ProofPresence::Present);
+            Assert(p_inc.presence == lotus::v2::ProofPresence::Present);
+            Assert(lotus::v2::VerifyCoinProof(q, p_ref, root_ref));
+            Assert(lotus::v2::VerifyCoinProof(q, p_inc, root_inc));
+
+            lotus::v2::Hash bad_root = root_ref;
+            bad_root[0] ^= 0x01;
+            Assert(!lotus::v2::VerifyCoinProof(q, p_inc, bad_root));
+        }
+
+        const lotus::v2::Outpoint absent_q{ConsumeHash32(fdp),
+                                           fdp.ConsumeIntegral<uint32_t>()};
+        const lotus::v2::CoinProof absent_proof = inc_set.Prove(absent_q);
+        Assert(lotus::v2::VerifyCoinProof(absent_q, absent_proof, root_inc));
+    }
+}
