From 8a083a48b8db4ce416ffcd9058e4c530f9204ccf Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 13:05:27 -0700
Subject: [PATCH] Define dispatcher header clock and preserve active duplicate
 downloads

---
 src/lotus_v2/peer_dispatcher.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/lotus_v2/peer_dispatcher.cpp b/src/lotus_v2/peer_dispatcher.cpp
index f72013de43b7d89bf915846c87aba89b914951d7..6d31f6ddf1c4c1587a5c363f26f2c7a04c3b6aa5 100644
--- a/src/lotus_v2/peer_dispatcher.cpp
+++ b/src/lotus_v2/peer_dispatcher.cpp
@@ -788,10 +788,12 @@ DispatcherResult PeerDispatcher::RequestBlock(ConnectionId id,
     if (!s.Observe(now)) return DispatcherResult::OperationalFailure;
     try {
         auto event = s.downloads.RequestBlock(*peer.handle, header, mode, now);
+        const bool already_active = event.result == DownloadResult::Busy;
         const bool issued = event.result == DownloadResult::Requested ||
                             event.result == DownloadResult::Deferred ||
                             event.result == DownloadResult::NeedHeaders;
         s.Download(id, peer, std::move(event), now);
+        if (already_active) return DispatcherResult::Busy;
         return issued ? DispatcherResult::Queued
                       : DispatcherResult::CapacityRefused;
     } catch (...) {
@@ -810,6 +812,9 @@ std::optional<DispatcherNotice> PeerDispatcher::TakeNotice() {
 uint64_t PeerDispatcher::FetchEpoch() const {
     return impl_->fetch_epoch;
 }
+std::optional<DispatcherHeaderClock> PeerDispatcher::HeaderClock() const {
+    return impl_->header_clock;
+}
 std::optional<PeerHandle> PeerDispatcher::Handle(ConnectionId id) const {
     const auto found = impl_->peers.find(id);
     return found == impl_->peers.end() ? std::nullopt : found->second.handle;
