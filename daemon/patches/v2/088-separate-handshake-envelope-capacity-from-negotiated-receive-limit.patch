+++ b/src/lotus_v2/peer_codec.h
@@ -39,6 +39,12 @@ struct Message {
     std::string command;
     Bytes payload;
 };
+// Before negotiation, use the independent 2 MiB cap even when the advertised
+// receive_limit is smaller than the mandatory hello/version payloads.
+// Message ordering and handshake activation remain caller responsibilities.
+bool EncodeHandshakeEnvelope(const NetworkProfile &, const Message &, Bytes &,
+                             std::string &);
+// After negotiation only: active_limit cannot exceed local receive_limit.
 bool EncodeEnvelope(const NetworkProfile &, uint32_t active_limit,
                     const Message &, Bytes &, std::string &);
 enum class FeedStatus { Incomplete, MessageReady, InvalidPeerMessage };
diff --git a/src/lotus_v2/peer_codec_test/README.md b/src/lotus_v2/peer_codec_test/README.md
index 15fa53c22ec7c0a8889bf5a88da4e2ae59339091..b0c861c180658e64faab5ff5a420bb7f427e14ef 100644
--- a/src/lotus_v2/peer_codec_test/README.md
+++ b/src/lotus_v2/peer_codec_test/README.md
@@ -14,6 +14,13 @@ Implemented:
   and fragmented-input decoding. `Feed` emits one message and reports input
   consumption; callers must retain any remaining input. Length checks precede
   payload allocation, and no allocation uses an unchecked announced length.
+  Before negotiation the decoder uses an independent 2 MiB receive cap, even
+  when the advertised local receive limit is 1..117 bytes. Use
+  `EncodeHandshakeEnvelope` for version/hello/verack/sendaddrv2 records; hello
+  retains its separate 118-byte cap. After negotiation call `SetActiveLimit`
+  and use `EncodeEnvelope`, which enforces the local advertised cap. Tiny
+  negotiated limits may make application objects unavailable without blocking
+  mandatory handshake records.
 - Exact 118-byte hello codecs, explicit identity/revision/required-feature
   negotiation, min(local, remote) receive capacity, and the proposed canonical
   BLAKE3 consensus-profile digest. Unknown supported features are ignored.
