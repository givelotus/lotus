From c43a20d758baca53d5da3a57395b71bc19d10c00 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:17:39 -0700
Subject: [PATCH] Separate handshake envelope capacity from negotiated receive
 limit

Integration review note (2026-10-15; original source commit had no body):
Use an independent pre-handshake envelope cap so a tiny advertised application receive limit cannot prevent the mandatory hello. After negotiation enforce the advertised limit. Low-limit handshake and post-negotiation boundaries have dedicated tests.

---
 src/lotus_v2/peer_codec.cpp            | 25 ++++++++++---
 src/lotus_v2/peer_codec.h              |  6 ++++
 src/lotus_v2/peer_codec_test/README.md |  7 ++++
 src/lotus_v2/test_peer_codec.cpp       | 50 ++++++++++++++++++++++++++
 4 files changed, 83 insertions(+), 5 deletions(-)

diff --git a/src/lotus_v2/peer_codec.cpp b/src/lotus_v2/peer_codec.cpp
index 2cee73b6a74b1c8a75c982554d771ae9ebfb00cf..6702742e64073d8a2d25e0fe4f456a1cb8511a31 100644
--- a/src/lotus_v2/peer_codec.cpp
+++ b/src/lotus_v2/peer_codec.cpp
@@ -253,9 +253,10 @@ bool NegotiateHello(const NetworkProfile &p, const Hello &h, uint32_t &active,
     active = std::min(p.receive_limit, h.receive_limit);
     return Success(e);
 }
-bool EncodeEnvelope(const NetworkProfile &p, uint32_t limit, const Message &m,
-                    Bytes &out, std::string &e) {
-    if (limit > p.receive_limit || !Bound(m.payload.size(), limit, e) ||
+static bool EncodeBoundedEnvelope(const NetworkProfile &p, uint32_t limit,
+                                  const Message &m, Bytes &out,
+                                  std::string &e) {
+    if (!Bound(m.payload.size(), limit, e) ||
         m.payload.size() > CommandCap(m.command, limit) || m.command.empty() ||
         m.command.size() > 12)
         return Fail(e, "envelope bounds");
@@ -273,8 +274,21 @@ bool EncodeEnvelope(const NetworkProfile &p, uint32_t limit, const Message &m,
     out = std::move(b);
     return Success(e);
 }
+bool EncodeHandshakeEnvelope(const NetworkProfile &p, const Message &m,
+                             Bytes &out, std::string &e) {
+    if (!Limit(p.receive_limit)) return Fail(e, "local receive limit");
+    if (m.command != "version" && m.command != "v2hello" &&
+        m.command != "verack" && m.command != "sendaddrv2")
+        return Fail(e, "pre-handshake command");
+    return EncodeBoundedEnvelope(p, PRE_HELLO_LIMIT, m, out, e);
+}
+bool EncodeEnvelope(const NetworkProfile &p, uint32_t limit, const Message &m,
+                    Bytes &out, std::string &e) {
+    if (limit > p.receive_limit) return Fail(e, "active receive limit");
+    return EncodeBoundedEnvelope(p, limit, m, out, e);
+}
 EnvelopeDecoder::EnvelopeDecoder(const NetworkProfile &p)
-    : profile_(p), limit_(std::min(p.receive_limit, PRE_HELLO_LIMIT)) {}
+    : profile_(p), limit_(PRE_HELLO_LIMIT) {}
 void EnvelopeDecoder::Reset() {
     header_bytes_ = 0;
     expected_ = 0;
@@ -296,7 +310,8 @@ FeedStatus EnvelopeDecoder::Feed(std::span<const uint8_t> b, size_t &used,
         pending_ = {};
         return FeedStatus::InvalidPeerMessage;
     };
-    if (failed_ || !Limit(limit_)) return invalid("decoder state/profile");
+    if (failed_ || !Limit(limit_) || !Limit(profile_.receive_limit))
+        return invalid("decoder state/profile");
     if (header_bytes_ < 24) {
         size_t take = std::min(b.size(), 24 - header_bytes_);
         std::copy_n(b.begin(), take, header_.begin() + header_bytes_);
diff --git a/src/lotus_v2/peer_codec.h b/src/lotus_v2/peer_codec.h
index 909bd01a6e0418415ca192f5fbcc907e92cb3d80..bdff648e7fd5e521832d83301786e6b75834f668 100644
