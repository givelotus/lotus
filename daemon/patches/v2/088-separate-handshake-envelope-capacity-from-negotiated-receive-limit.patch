     CHECK(!partial.SetActiveLimit(100, e));
 }
+void SmallHandshakeLimits() {
+    for (uint32_t local_limit : {1U, 117U, 118U}) {
+        auto p = Profile();
+        p.receive_limit = local_limit;
+        Hello hello;
+        hello.chain_id = p.chain_id;
+        hello.genesis_id = p.genesis_id;
+        hello.profile_digest = p.profile_digest;
+        hello.receive_limit = local_limit;
+        std::string e;
+        Bytes hello_bytes, wire;
+        CHECK(EncodeHello(hello, hello_bytes, e));
+        CHECK(hello_bytes.size() == 118);
+        EnvelopeDecoder decoder(p);
+        Message output;
+        size_t consumed;
+        // Both mandatory handshake records fit the independent pre-hello cap.
+        for (const Message &message :
+             std::vector<Message>{{"version", Bytes(350, 0)},
+                                  {"v2hello", hello_bytes},
+                                  {"sendaddrv2", {}},
+                                  {"verack", {}}}) {
+            CHECK(EncodeHandshakeEnvelope(p, message, wire, e));
+            CHECK(decoder.Feed(wire, consumed, output, e) ==
+                  FeedStatus::MessageReady);
+            CHECK(consumed == wire.size() && output.payload == message.payload);
+        }
+        CHECK(!EncodeHandshakeEnvelope(p, {"tx", {}}, wire, e));
+        CHECK(!EncodeHandshakeEnvelope(p, {"v2hello", Bytes(119)}, wire, e));
+        CHECK(!EncodeHandshakeEnvelope(
+            p, {"version", Bytes(PRE_HELLO_LIMIT + 1)}, wire, e));
+        uint32_t negotiated;
+        CHECK(NegotiateHello(p, hello, negotiated, e));
+        CHECK(negotiated == local_limit);
+        CHECK(decoder.SetActiveLimit(negotiated, e));
+        // After activation, the tiny negotiated cap applies immediately.
+        Message fits{"tx", Bytes(local_limit, 0)};
+        CHECK(EncodeEnvelope(p, negotiated, fits, wire, e));
+        CHECK(decoder.Feed(wire, consumed, output, e) ==
+              FeedStatus::MessageReady);
+        CHECK(!EncodeEnvelope(p, PRE_HELLO_LIMIT, fits, wire, e));
+        Message oversized{"tx", Bytes(local_limit + 1, 0)};
+        CHECK(!EncodeEnvelope(p, negotiated, oversized, wire, e));
+        auto sender = Profile();
+        CHECK(EncodeEnvelope(sender, sender.receive_limit, oversized, wire, e));
+        CHECK(decoder.Feed(wire, consumed, output, e) ==
+              FeedStatus::InvalidPeerMessage);
+    }
+}
 void Vectors() {
     auto p = Profile();
     auto block = Block(p);
@@ -414,6 +463,7 @@ void CompactTests() {
 int main() {
     HelloTests();
     EnvelopeTests();
+    SmallHandshakeLimits();
     Vectors();
     CompactTests();
     std::cout
