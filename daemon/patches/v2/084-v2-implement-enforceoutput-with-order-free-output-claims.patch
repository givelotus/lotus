diff --git a/src/lotus_v2/output_template.h b/src/lotus_v2/output_template.h
new file mode 100644
index 0000000000000000000000000000000000000000..89c716f28fbde4eee90c906d1412a3cc1da5c045
--- /dev/null
+++ b/src/lotus_v2/output_template.h
@@ -0,0 +1,199 @@
+// Copyright (c) 2026 The Lotus developers
+// ENFORCEOUTPUT (eb) OutputTemplate binary format. Header-only so every
+// target that compiles the VM gets it without build-file changes.
+//
+//   flags:u8          value bits 0-1, token bits 2-3, paths bits 4-5,
+//                     burn bit 6, wildcard bit 7
+//   [value:u64]       iff value mode is EXACT (01) or MIN (10)
+//   [token_id:h32]    iff token mode is EXACT (10)
+//   branch_count:u8   0..16 (0 = any count)
+//   branch_mask:u16   slots pinned to roots carried in the template
+//   branch_stack_mask:u16  slots pinned to roots popped from the stack
+//   state_mode:u8     0 none, 1 root in template, 2 root from the stack
+//   output_mode:u8    0 first match, 1 index in template, 2 index from stack
+//   [state_root:h32]  iff state_mode == 1 (nonzero)
+//   [output_index:u16] iff output_mode == 1
+//   popcount(branch_mask) x h32, in ascending slot order
+//   [paths: Vec(Vec(CS))]  iff paths mode is EXPLICIT (01)
+//
+// All integers are little-endian; CompactSize is shortest-form. Malformed
+// templates, including trailing bytes, are script errors.
+#ifndef LOTUS_V2_OUTPUT_TEMPLATE_H
+#define LOTUS_V2_OUTPUT_TEMPLATE_H
+
+#include "output.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+
+struct OutputTemplate {
+    enum : uint8_t { OMIT = 0 };
+    // Value: OMIT, EXACT, MIN, FROM_STACK.
+    enum : uint8_t { VALUE_EXACT = 1, VALUE_MIN = 2, VALUE_FROM_STACK = 3 };
+    // Token: OMIT, NATIVE, EXACT, SELF (the active branch root).
+    enum : uint8_t { TOKEN_NATIVE = 1, TOKEN_EXACT = 2, TOKEN_SELF = 3 };
+    // Paths: OMIT, EXPLICIT, INHERIT (the spent coin's paths).
+    enum : uint8_t { PATHS_EXPLICIT = 1, PATHS_INHERIT = 2 };
+    enum : uint8_t { STATE_NONE = 0, STATE_TEMPLATE = 1, STATE_STACK = 2 };
+    enum : uint8_t { OUTPUT_FIRST = 0, OUTPUT_TEMPLATE = 1, OUTPUT_STACK = 2 };
+
+    uint8_t value_mode = 0;
+    uint8_t token_mode = 0;
+    uint8_t paths_mode = 0;
+    bool burn = false;
+    bool wildcard = false;
+    uint64_t value = 0;
+    Hash32 token_id{};
+    uint8_t branch_count = 0;
+    uint16_t branch_mask = 0;
+    uint16_t branch_stack_mask = 0;
+    uint8_t state_mode = 0;
+    uint8_t output_mode = 0;
+    Hash32 state_root{};
+    uint16_t output_index = 0;
+    // Static pinned roots, ascending slot order (one per branch_mask bit).
+    std::vector<Hash32> branches;
+    std::vector<std::vector<uint8_t>> paths;
+};
+
+namespace output_template_detail {
+    inline unsigned PopCount16(uint16_t v) {
+        unsigned n = 0;
+        for (; v; v &= uint16_t(v - 1)) ++n;
+        return n;
+    }
+    class Reader {
+    public:
+        explicit Reader(std::span<const uint8_t> bytes) : bytes_(bytes) {}
+        bool Done() const { return at_ == bytes_.size(); }
+        bool Le(size_t width, uint64_t &out) {
+            if (bytes_.size() - at_ < width) return false;
+            out = 0;
+            for (size_t i = 0; i < width; ++i)
+                out |= uint64_t(bytes_[at_ + i]) << (8 * i);
+            at_ += width;
+            return true;
+        }
+        bool H32(Hash32 &out) {
+            if (bytes_.size() - at_ < 32) return false;
+            for (size_t i = 0; i < 32; ++i) out[i] = bytes_[at_ + i];
+            at_ += 32;
+            return true;
+        }
+        // Shortest-form CompactSize bounded by `cap`.
+        bool Compact(uint64_t cap, uint64_t &out) {
+            uint64_t lead;
+            if (!Le(1, lead)) return false;
+            if (lead < 253) {
+                out = lead;
+            } else {
+                const size_t width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+                if (!Le(width, out)) return false;
+                const uint64_t min = width == 2   ? 253
+                                     : width == 4 ? 0x10000
+                                                  : 0x100000000ULL;
+                if (out < min) return false;
+            }
+            return out <= cap;
+        }
+
+    private:
+        std::span<const uint8_t> bytes_;
+        size_t at_ = 0;
+    };
+} // namespace output_template_detail
+
+// Parses and validates the template-level rules that do not depend on the
+// invocation (a mint check for INHERIT is the caller's). On failure `out` is
+// unspecified and `error` names the rule.
+inline bool ParseOutputTemplate(std::span<const uint8_t> bytes,
+                                OutputTemplate &out, std::string &error) {
+    using namespace output_template_detail;
+    out = OutputTemplate{};
+    Reader r(bytes);
+    uint64_t v;
+    auto fail = [&](const char *message) {
+        error = message;
+        return false;
+    };
+    if (!r.Le(1, v)) return fail("template truncated");
+    const uint8_t flags = uint8_t(v);
+    out.value_mode = flags & 3;
+    out.token_mode = (flags >> 2) & 3;
+    out.paths_mode = (flags >> 4) & 3;
+    out.burn = (flags >> 6) & 1;
+    out.wildcard = (flags >> 7) & 1;
+    if (out.paths_mode == 3) return fail("template paths mode");
+    if (out.value_mode == OutputTemplate::VALUE_EXACT ||
+        out.value_mode == OutputTemplate::VALUE_MIN) {
+        if (!r.Le(8, out.value)) return fail("template truncated");
+    }
+    if (out.token_mode == OutputTemplate::TOKEN_EXACT &&
+        !r.H32(out.token_id))
+        return fail("template truncated");
+    uint64_t count, mask, stack_mask, state_mode, output_mode;
+    if (!r.Le(1, count) || !r.Le(2, mask) || !r.Le(2, stack_mask) ||
+        !r.Le(1, state_mode) || !r.Le(1, output_mode))
+        return fail("template truncated");
+    if (count > MAX_OUTPUT_BRANCHES) return fail("template branch count");
+    if (state_mode > 2) return fail("template state mode");
+    if (output_mode > 2) return fail("template output mode");
+    out.branch_count = uint8_t(count);
+    out.branch_mask = uint16_t(mask);
+    out.branch_stack_mask = uint16_t(stack_mask);
+    out.state_mode = uint8_t(state_mode);
+    out.output_mode = uint8_t(output_mode);
+    if (out.branch_mask & out.branch_stack_mask)
+        return fail("template mask overlap");
+    if (out.branch_count &&
+        ((out.branch_mask | out.branch_stack_mask) >> out.branch_count))
+        return fail("template mask beyond branch count");
+    if (out.state_mode == OutputTemplate::STATE_TEMPLATE) {
+        if (!r.H32(out.state_root)) return fail("template truncated");
+        if (out.state_root == Hash32{}) return fail("template zero state root");
+    }
+    if (out.output_mode == OutputTemplate::OUTPUT_TEMPLATE) {
+        if (!r.Le(2, v)) return fail("template truncated");
+        out.output_index = uint16_t(v);
+    }
+    out.branches.resize(PopCount16(out.branch_mask));
+    for (auto &root : out.branches)
+        if (!r.H32(root)) return fail("template truncated");
+    if (out.paths_mode == OutputTemplate::PATHS_EXPLICIT) {
+        uint64_t path_count;
+        if (!r.Compact(MAX_OUTPUT_PATHS, path_count))
+            return fail("template paths");
+        out.paths.resize(size_t(path_count));
+        for (auto &path : out.paths) {
+            uint64_t length;
+            if (!r.Compact(MAX_OUTPUT_BRANCHES, length))
+                return fail("template paths");
+            path.resize(size_t(length));
+            for (auto &index : path) {
+                uint64_t value;
+                if (!r.Compact(MAX_OUTPUT_BRANCHES - 1, value))
+                    return fail("template paths");
+                index = uint8_t(value);
+            }
+        }
+    }
+    if (!r.Done()) return fail("template trailing bytes");
+    if (out.burn) {
+        if (out.paths_mode == OutputTemplate::PATHS_INHERIT)
+            return fail("template burn inherits paths");
+        if (out.paths_mode == OutputTemplate::PATHS_EXPLICIT &&
+            !out.paths.empty())
+            return fail("template burn with paths");
+    }
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
+
+#endif
diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index 4739ad8c82508f1d4f74c973141b3d7b2f563b72..dbea900eaac2673c1dc49e8ea912882835a4fc55 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -1089,6 +1089,494 @@ void TransactionEffects() {
               accumulator.state_authorized == effects.state_authorized);
     }
 }
+struct TemplateSpec {
+    uint8_t value_mode = 0, token_mode = 0, paths_mode = 0;
+    bool burn = false, wildcard = false;
+    uint64_t value = 0;
+    Hash token{};
+    uint8_t branch_count = 0;
+    uint16_t mask = 0, stack_mask = 0;
+    uint8_t state_mode = 0, output_mode = 0;
+    Hash state_root{};
+    uint16_t output_index = 0;
+    std::vector<Hash> branches;
+    std::vector<std::vector<uint8_t>> paths;
+};
+VmBytes EncodeTemplate(const TemplateSpec &t) {
+    VmBytes out{uint8_t(t.value_mode | t.token_mode << 2 | t.paths_mode << 4 |
+                        uint8_t(t.burn) << 6 | uint8_t(t.wildcard) << 7)};
+    auto le = [&](uint64_t v, size_t width) {
+        for (size_t i = 0; i < width; ++i) out.push_back(uint8_t(v >> (8 * i)));
+    };
+    if (t.value_mode == 1 || t.value_mode == 2) le(t.value, 8);
+    if (t.token_mode == 2) out.insert(out.end(), t.token.begin(), t.token.end());
+    le(t.branch_count, 1);
+    le(t.mask, 2);
+    le(t.stack_mask, 2);
+    le(t.state_mode, 1);
+    le(t.output_mode, 1);
+    if (t.state_mode == 1)
+        out.insert(out.end(), t.state_root.begin(), t.state_root.end());
+    if (t.output_mode == 1) le(t.output_index, 2);
+    for (const auto &b : t.branches) out.insert(out.end(), b.begin(), b.end());
+    if (t.paths_mode == 1) {
+        out.push_back(uint8_t(t.paths.size()));
+        for (const auto &path : t.paths) {
+            out.push_back(uint8_t(path.size()));
+            out.insert(out.end(), path.begin(), path.end());
+        }
+    }
+    return out;
+}
+void PushBytes(VmBytes &script, const VmBytes &data) {
+    if (data.empty()) {
+        script.insert(script.end(), {0x4c, 0x00}); // 0x00 is N(0)
+    } else if (data.size() <= 75) {
+        script.push_back(uint8_t(data.size()));
+    } else {
+        CHECK(data.size() <= 255);
+        script.insert(script.end(), {0x4c, uint8_t(data.size())});
+    }
+    script.insert(script.end(), data.begin(), data.end());
+}
+
+void EnforceOutput() {
+    const TxProfile tx_profile{32, 32, 8, 8192, 16, 8192, 64};
+    const VmProfile vm{4096, 16, 1024, 64, 16, 65536, 16, 100000};
+    ChainId chain{};
+    auto fill = [](uint8_t b) {
+        Hash h;
+        h.fill(b);
+        return h;
+    };
+    Transaction tx;
+    Input spend;
+    spend.flags = 1;
+    spend.prev_txid.fill(0x81);
+    spend.sequence = UINT32_MAX;
+    spend.witnesses = {BranchWitness{Hex("4e"), {}, {}}};
+    Input mint;
+    mint.flags = 3;
+    mint.sequence = UINT32_MAX;
+    mint.witnesses = {BranchWitness{Hex("79794e"), {}, {}}};
+    tx.inputs = {spend, mint};
+    Output coin;
+    coin.value = 200;
+    coin.branches = {Hash{}, fill(0xb1)};
+    coin.paths = {{0}, {1}};
+    ResolvedCoins resolved{coin, std::nullopt};
+    const Hash state = fill(0x5e);
+    Output o0;  // native 100, two branches
+    o0.value = 100;
+    o0.branches = {fill(0xa0), fill(0xa1)};
+    o0.paths = {{0}, {1}};
+    Output o1;  // continuation of the spent coin (synced per run)
+    o1.value = 200;
+    Output o2;  // minted token with state
+    o2.flags = 5;
+    o2.value = 5;
+    o2.branches = {fill(0xa0)};
+    o2.paths = {{0}};
+    o2.state_root = state;
+    Output o3;  // native burn
+    o3.flags = 2;
+    o3.value = 7;
+    o3.branches = {fill(0xa2)};
+    tx.outputs = {o0, o1, o2, o3};
+    VmCostProfile cost;
+    cost.max_invocation_cost = 100000000;
+    cost.structural_byte_cost = 1;
+    for (auto &op : cost.opcode) op = {1, 1, 1};
+    cost.opcode[0xeb].per_scanned_output = 5;
+
+    struct Run {
+        VmChargedResult charged;
+        VmTransactionEffects effects;
+    };
+    // Runs `script` as input `input` (0 spend, 1 mint) with fresh effects.
+    auto run = [&](size_t input, const VmBytes &script,
+                   std::vector<VmBytes> args = {}, bool sync = true) {
+        tx.inputs[input].witnesses[0].script = script;
+        tx.inputs[input].witnesses[0].arguments = args;
+        resolved[0]->branches[0] = BranchLeaf(tx.inputs[0].witnesses[0].script);
+        tx.inputs[1].prev_txid = BranchLeaf(tx.inputs[1].witnesses[0].script);
+        tx.outputs[2].token_id = tx.inputs[1].prev_txid;
+        if (sync) {
+            tx.outputs[1].branches = resolved[0]->branches;
+            tx.outputs[1].paths = resolved[0]->paths;
+        }
+        PositiveDelta delta{};
+        delta[0] = 5;
+        Run r;
+        VmExecutionContext ctx{tx, tx_profile, chain, resolved, input, 0,
+                               input == 1 ? std::optional(delta)
+                                          : std::nullopt};
+        ctx.effects = &r.effects;
+        r.charged = EvaluateVmCharged(script, args, vm, cost, 2, 4, &ctx);
+        return r;
+    };
+    // `<template> <claim> eb <j> EQUALVERIFY [drop delta] TRUE`
+    auto script_for = [&](const TemplateSpec &t, uint64_t claim,
+                          int expect_j, bool for_mint = false,
+                          const VmBytes &prefix = {}) {
+        VmBytes script = prefix;
+        PushBytes(script, EncodeTemplate(t));
+        VmBytes claim_n(16);
+        for (size_t i = 0; i < 8; ++i) claim_n[i] = uint8_t(claim >> (8 * i));
+        PushBytes(script, claim_n);
+        script.push_back(0xeb);
+        PushBytes(script, Number(uint8_t(expect_j)));
+        script.push_back(0x92);
+        if (for_mint) script.push_back(0x79);
+        script.push_back(0x4e);
+        return script;
+    };
+    auto expect_match = [&](const TemplateSpec &t, int j, size_t input = 0,
+                            std::vector<VmBytes> args = {},
+                            const VmBytes &prefix = {}) {
+        const auto r = run(input, script_for(t, 0, j, input == 1, prefix), args);
+        if (r.charged.invocation.status != VmStatus::Success)
+            throw std::runtime_error("ENFORCEOUTPUT expected output " +
+                                     std::to_string(j) + ": " +
+                                     r.charged.invocation.error);
+        CHECK(r.effects.claims.size() == 1 && r.effects.claims[0].first == j);
+        return r;
+    };
+    auto expect_error = [&](const TemplateSpec &t, const std::string &error,
+                            size_t input = 0, std::vector<VmBytes> args = {},
+                            const VmBytes &prefix = {}) {
+        const auto r = run(input, script_for(t, 0, 0, input == 1, prefix), args);
+        if (r.charged.invocation.status != VmStatus::Invalid ||
+            r.charged.invocation.error != error)
+            throw std::runtime_error("ENFORCEOUTPUT expected '" + error +
+                                     "', got: " + r.charged.invocation.error);
+        CHECK(r.effects.Empty()); // staged effects are discarded on failure
+    };
+    const std::string none = "ENFORCEOUTPUT no matching output";
+
+    // Value modes: OMIT, EXACT, MIN, FROM_STACK. The scan takes the first
+    // non-burn, stateless match.
+    TemplateSpec any;
+    expect_match(any, 0);
+    TemplateSpec exact;
+    exact.value_mode = 1;
+    exact.value = 200;
+    expect_match(exact, 1);
+    exact.value = 201;
+    expect_error(exact, none);
+    TemplateSpec min;
+    min.value_mode = 2;
+    min.value = 101;
+    expect_match(min, 1);
+    TemplateSpec from_stack;
+    from_stack.value_mode = 3;
+    expect_match(from_stack, 0, 0, {}, Hex("10 64000000000000000000000000000000"));
+    // Burn: only burn outputs match burn templates.
+    TemplateSpec burn;
+    burn.burn = true;
+    expect_match(burn, 3);
+    burn.value_mode = 1;
+    burn.value = 8;
+    expect_error(burn, none);
+    // Tokens: NATIVE, EXACT (zero = native), SELF from the mint invocation.
+    TemplateSpec token;
+    token.state_mode = 2; // o2 carries state
+    token.token_mode = 2;
+    auto state_push = [&] {
+        VmBytes p;
+        PushBytes(p, VmBytes(state.begin(), state.end()));
+        return p;
+    };
+    token.token = BranchLeaf(Hex("4e")); // not the minted id
+    expect_error(token, none, 0, {}, state_push());
+    token.token_mode = 3; // SELF: the mint's own token id
+    {
+        const auto r = expect_match(token, 2, 1, {}, state_push());
+        CHECK(r.effects.state_authorized == std::vector<uint16_t>{2});
+    }
+    TemplateSpec native = any;
+    native.token_mode = 1;
+    expect_match(native, 0);
+    native.token_mode = 2; // EXACT with a zero id means native
+    expect_match(native, 0);
+    // Branch count and static/stack pins (stack roots pushed ascending).
+    TemplateSpec pins;
+    pins.branch_count = 2;
+    pins.mask = 1;
+    pins.branches = {fill(0xa0)};
+    // o0's path {1} omits branch 0, so OMIT paths cannot pin it (below);
+    // these pin cases state the paths explicitly.
+    pins.paths_mode = 1;
+    pins.paths = {{0}, {1}};
+    expect_match(pins, 0);
+    pins.branches = {fill(0xa2)};
+    expect_error(pins, none);
+    TemplateSpec stack_pins;
+    stack_pins.branch_count = 2;
+    stack_pins.stack_mask = 3;
+    stack_pins.paths_mode = 1;
+    stack_pins.paths = {{0}, {1}};
+    VmBytes roots;
+    PushBytes(roots, VmBytes(32, 0xa0)); // slot 0 (deeper)
+    PushBytes(roots, VmBytes(32, 0xa1)); // slot 1 (top, popped first)
+    expect_match(stack_pins, 0, 0, {}, roots);
+    VmBytes swapped;
+    PushBytes(swapped, VmBytes(32, 0xa1));
+    PushBytes(swapped, VmBytes(32, 0xa0));
+    expect_error(stack_pins, none, 0, {}, swapped);
+    // Three stack roots and a stack value: pop order value, roots, state.
+    {
+        TemplateSpec three;
+        three.value_mode = 3;
+        three.stack_mask = 0b111;
+        three.branch_count = 3;
+        three.paths_mode = 1;
+        three.paths = {{0}, {1}, {2}};
+        tx.outputs[0].branches = {fill(0xa0), fill(0xa1), fill(0xa3)};
+        tx.outputs[0].paths = {{0}, {1}, {2}};
+        VmBytes prefix;
+        PushBytes(prefix, VmBytes(32, 0xa0));
+        PushBytes(prefix, VmBytes(32, 0xa1));
+        PushBytes(prefix, VmBytes(32, 0xa3));
+        PushBytes(prefix, Number(100));
+        expect_match(three, 0, 0, {}, prefix);
