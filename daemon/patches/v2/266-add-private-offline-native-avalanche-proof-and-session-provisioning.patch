+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_PROVISION_H
+#define LOTUS_V2_AVALANCHE_PROVISION_H
+#include "avalanche_proof.h"
+#include <avalanche/delegation.h>
+#include <key.h>
+#include <filesystem>
+namespace lotus::v2::ava {
+struct ProvisionStake {
+    Outpoint outpoint{};
+    uint64_t amount{};
+    uint32_t height{};
+    bool coinbase{};
+    CKey key;
+    std::vector<uint8_t> payment_lock;
+};
+struct ProvisionRequest {
+    uint64_t sequence{};
+    int64_t expiration{};
+    CKey master_key, session_key;
+    CScript payout_script;
+    std::vector<ProvisionStake> stakes;
+};
+struct ProvisionedCredentials {
+    CKey session_key;
+    ProofEnvelope envelope;
+    ::avalanche::Delegation delegation;
+};
+// Caller owns ECC initialization and supplies the authoritative offline chain
+// view. All stake fields and maturity are checked through AdmitProof; no coins
+// or confirmation counts are inferred from keys or JSON input.
+bool BuildProvisionedCredentials(const ProvisionRequest &, const Profile &,
+    const ChainSnapshot &, const CoinLookup &, const SnapshotReader &,
+    ProvisionedCredentials &, std::string &);
+// Input and output must be local owner-only regular files. Input is opened
+// without following symlinks; output is created exclusively, never replaced.
+// The only serialized secret in output is the session key. Errors are fixed
+// identifiers and never contain input or key material.
+bool ProvisionCredentialsFromFile(const std::filesystem::path &input,
+    const std::filesystem::path &output, const Profile &, const ChainSnapshot &,
+    const CoinLookup &, const SnapshotReader &, std::string &);
+// Offline argv: lotusd -lotusv2provision MANIFEST EXISTING_HOME PRIVATE_REQUEST OUTPUT_CREDENTIALS
+int RunAvalancheProvisionCommand(int argc, char *argv[]);
+}
+#endif
