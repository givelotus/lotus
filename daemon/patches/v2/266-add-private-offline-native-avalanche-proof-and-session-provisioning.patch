+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_provision.h"
+#include "avalanche_peer.h"
+#include "development_command.h"
+#include "development_runtime.h"
+#include <iostream>
+#include <avalanche/proofbuilder.h>
+#include <avalanche/delegationbuilder.h>
+#include <avalanche/validation.h>
+#include <streams.h>
+#include <univalue.h>
+#include <util/strencodings.h>
+#include <algorithm>
+#include <charconv>
+#include <limits>
+#include <set>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+namespace lotus::v2::ava {
+namespace {
+bool Fail(std::string &e, const char *s) { e=s; return false; }
+bool KeyValid(const CKey &key) { return key.IsValid() && key.IsCompressed(); }
+std::vector<uint8_t> PaymentLock(const CKey &key) {
+    const auto pub=key.GetPubKey();
+    std::vector<uint8_t> lock{0x20}; lock.insert(lock.end(),pub.begin()+1,pub.end());
+    lock.push_back(0xbc); lock.push_back(0x4e); return lock;
+}
+bool Fields(const UniValue &v, std::initializer_list<const char *> names) {
+    if(!v.isObject() || v.size()!=names.size()) return false;
+    std::set<std::string> actual(v.getKeys().begin(),v.getKeys().end());
+    if(actual.size()!=v.size()) return false;
+    for(const auto *n:names) if(!actual.contains(n)) return false;
+    return true;
+}
+bool Hex(const UniValue &v, std::vector<uint8_t> &out, size_t bytes=0) {
+    if(!v.isStr()) return false;
+    const auto &s=v.get_str();
+    if(s.size()%2 || (bytes && s.size()!=2*bytes) ||
+       !std::all_of(s.begin(),s.end(),[](char c){return (c>='0'&&c<='9')||(c>='a'&&c<='f');})) return false;
+    out=ParseHex(s); return true;
+}
+bool Key(const UniValue &v, CKey &out) {
+    std::vector<uint8_t> bytes;
+    if(!Hex(v,bytes,32)) return false;
+    out.Set(bytes.begin(),bytes.end(),true); return KeyValid(out);
+}
+template<class T> bool Integer(const UniValue &v, T &out) {
+    if(!v.isNum()) return false;
+    const auto &s=v.getValStr();
+    auto r=std::from_chars(s.data(),s.data()+s.size(),out);
+    return r.ec==std::errc{} && r.ptr==s.data()+s.size();
+}
+bool ParseRequest(const UniValue &json, ProvisionRequest &out) {
+    if(!Fields(json,{"schema","sequence","expiration","master_key","session_key","payout_script","stakes"})) return false;
+    unsigned schema{}; std::vector<uint8_t> payout;
+    if(!Integer(json["schema"],schema) || schema!=1 || !Integer(json["sequence"],out.sequence) ||
+       !Integer(json["expiration"],out.expiration) || !Key(json["master_key"],out.master_key) ||
+       !Key(json["session_key"],out.session_key) || !Hex(json["payout_script"],payout) ||
+       payout.size()>10000 || !json["stakes"].isArray() || json["stakes"].size()>1000) return false;
+    out.payout_script=CScript(payout.begin(),payout.end());
+    for(const auto &v:json["stakes"].getValues()) {
+        if(!Fields(v,{"tx_id","index","amount","height","coinbase","key","payment_lock"})) return false;
+        ProvisionStake s; std::vector<uint8_t> tx;
+        if(!Hex(v["tx_id"],tx,32) || !Integer(v["index"],s.outpoint.index) ||
+           !Integer(v["amount"],s.amount) || !Integer(v["height"],s.height) ||
+           !v["coinbase"].isBool() || !Key(v["key"],s.key) || !Hex(v["payment_lock"],s.payment_lock,35)) return false;
+        std::copy(tx.begin(),tx.end(),s.outpoint.tx_id.begin()); s.coinbase=v["coinbase"].get_bool();
+        out.stakes.push_back(std::move(s));
+    }
+    return true;
+}
+struct File { int fd{-1}; ~File(){if(fd>=0) close(fd);} };
+bool ReadPrivate(const std::filesystem::path &path, std::string &data) {
+    File f{open(path.c_str(),O_RDONLY|O_NOFOLLOW|O_NONBLOCK|O_CLOEXEC)}; struct stat st{};
+    if(f.fd<0 || fstat(f.fd,&st)!=0 || !S_ISREG(st.st_mode) || st.st_uid!=geteuid() ||
+       (st.st_mode&0777)!=0600 || st.st_nlink!=1 || st.st_size<0 || st.st_size>1048576) return false;
+    data.resize(size_t(st.st_size)); size_t offset=0;
+    while(offset<data.size()) { auto n=read(f.fd,data.data()+offset,data.size()-offset); if(n<=0)return false; offset+=size_t(n); }
+    char extra; return read(f.fd,&extra,1)==0;
+}
+bool WritePrivate(const std::filesystem::path &path, const std::string &data) {
+    File f{open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600)};
+    if(f.fd<0) return false;
+    if(fchmod(f.fd,0600)!=0) {unlink(path.c_str());return false;}
+    size_t offset=0;
+    while(offset<data.size()) { auto n=write(f.fd,data.data()+offset,data.size()-offset); if(n<=0){unlink(path.c_str());return false;} offset+=size_t(n); }
+    if(fsync(f.fd)!=0) {unlink(path.c_str());return false;} return true;
+}
+}
+bool BuildProvisionedCredentials(const ProvisionRequest &r, const Profile &p,
+    const ChainSnapshot &snapshot, const CoinLookup &lookup, const SnapshotReader &read,
+    ProvisionedCredentials &out, std::string &e) {
+    if(!ValidateProfile(p,e)) return false;
+    if(!KeyValid(r.master_key) || !KeyValid(r.session_key)) return Fail(e,"invalid-provision-key");
+    if(r.stakes.empty() || r.stakes.size()>1000 || r.payout_script.size()>10000 || r.expiration<0)
+        return Fail(e,"invalid-provision-request");
+    ::avalanche::ProofBuilder builder(r.sequence,r.expiration,r.master_key,r.payout_script);
+    for(const auto &s:r.stakes) {
+        if(s.height>0x7fffffffU) return Fail(e,"invalid-provision-height");
+        if(!KeyValid(s.key) || s.payment_lock!=PaymentLock(s.key)) return Fail(e,"invalid-provision-payment-lock");
+        if(s.amount>uint64_t(std::numeric_limits<int64_t>::max()) || !MoneyRange(int64_t(s.amount)*SATOSHI))
+            return Fail(e,"invalid-provision-amount");
+        uint256 id; std::copy(s.outpoint.tx_id.begin(),s.outpoint.tx_id.end(),id.begin());
+        if(!builder.addUTXO(COutPoint(TxId(id),s.outpoint.index),int64_t(s.amount)*SATOSHI,s.height,s.coinbase,s.key))
+            return Fail(e,"duplicate-or-invalid-provision-stake");
+    }
+    ProvisionedCredentials result; result.session_key=r.session_key; result.envelope.proof=builder.build();
+    if(!result.envelope.proof) return Fail(e,"provision-proof-signing-failed");
+    // ABC sorts signed stakes by stake id, independently of the input order.
+    for(const auto &signed_stake:result.envelope.proof->getStakes()) {
+        const auto &pub=signed_stake.getStake().getPubkey();
+        std::vector<uint8_t> lock{0x20}; lock.insert(lock.end(),pub.begin()+1,pub.end());
+        lock.push_back(0xbc); lock.push_back(0x4e); result.envelope.payment_locks.push_back(std::move(lock));
+    }
+    AdmittedProof admitted;
+    if(!AdmitProof(p,snapshot,lookup,result.envelope,admitted,read,e)) return false;
+    ::avalanche::DelegationBuilder delegation(*result.envelope.proof);
+    if(!delegation.addLevel(r.master_key,r.session_key.GetPubKey())) return Fail(e,"provision-delegation-signing-failed");
+    result.delegation=delegation.build(); ::avalanche::DelegationState state; CPubKey auth;
+    if(!result.delegation.verify(state,auth) || auth!=r.session_key.GetPubKey() ||
+       result.delegation.getProofId()!=result.envelope.proof->getId()) return Fail(e,"provision-delegation-invalid");
+    out=std::move(result); e.clear(); return true;
+}
+bool ProvisionCredentialsFromFile(const std::filesystem::path &input,
+    const std::filesystem::path &output, const Profile &p, const ChainSnapshot &snapshot,
+    const CoinLookup &lookup, const SnapshotReader &read, std::string &e) {
+    std::string data; if(!ReadPrivate(input,data)) return Fail(e,"provision-input-file-invalid");
+    ProvisionRequest request; UniValue json;
+    try { if(!json.read(data) || !ParseRequest(json,request)) return Fail(e,"provision-input-invalid"); }
+    catch(const std::exception &) {return Fail(e,"provision-input-invalid");}
+    ProvisionedCredentials result;
+    if(!BuildProvisionedCredentials(request,p,snapshot,lookup,read,result,e)) return false;
+    peer::Bytes proof; if(!EncodeProofEnvelope(result.envelope,PeerLimits{},proof,e)) return false;
+    DataStream delegation; delegation<<result.delegation;
+    UniValue credentials(UniValue::VOBJ); credentials.pushKV("schema",1);
+    credentials.pushKV("session_key",HexStr(result.session_key)); credentials.pushKV("proof",HexStr(proof));
+    credentials.pushKV("delegation",HexStr(delegation));
+    if(!WritePrivate(output,credentials.write()+"\n")) return Fail(e,"provision-output-file-failed");
+    e.clear(); return true;
+}
+int RunAvalancheProvisionCommand(int argc, char *argv[]) {
+    // This branch runs before normal daemon initialization. No key material is
+    // accepted in argv, and no raw exception/manifest/runtime text is logged.
+    if(argc!=6) { std::cerr<<"usage: lotusd -lotusv2provision MANIFEST EXISTING_HOME PRIVATE_REQUEST OUTPUT_CREDENTIALS\n"; return 1; }
+    struct EccScope { EccScope(){ECC_Start();} ~EccScope(){ECC_Stop();} };
+    try {
+        EccScope ecc;
+        namespace fs=std::filesystem;
+        const fs::path home(argv[3]), marker=home/"lotus-v2-development.identity", database=home/"chainstate-v2";
+        auto regular=[](const fs::path &p){return !fs::is_symlink(p) && fs::is_regular_file(p);};
+        if(fs::is_symlink(home) || !fs::is_directory(home) || !regular(marker) ||
+           fs::is_symlink(database) || !fs::is_directory(database) || !regular(database/"CURRENT")) {
+            std::cerr<<"provision-existing-home-required\n"; return 1;
+        }
+        DevelopmentManifest m; std::string e, directory;
+        if(!LoadDevelopmentManifest(argv[2],m,e)) {std::cerr<<"provision-manifest-invalid\n";return 1;}
+        if(!PrepareDevelopmentHomeDirectory(m,home.string(),directory,e)) {std::cerr<<"provision-home-identity-invalid\n";return 1;}
+        constexpr uint64_t MiB=uint64_t{1}<<20;
+        DevelopmentRuntimeConfig config;
+        config.directory=directory; config.genesis_wire=m.genesis; config.profiles={m.hp,m.op,m.mp,m.cp};
+        config.initial_money=m.initial; config.storage.avalanche=true; config.storage.recovery=DiskRecoveryOptions{128*MiB,16*MiB};
+        config.storage.candidates=CandidateStoreOptions{4096,4096,128};
+        config.storage.max_metadata_bytes=16*MiB; config.storage.max_pending_bytes=64*MiB;
+        config.bodies={32,m.block_read_limit,64*MiB,32,64*MiB,65536};
+        config.initial_body_epoch=1; config.initial_context_generation=1;
+        // LevelDB's existing exclusive database lock is acquired by Open. A
+        // running node on the same home therefore prevents offline provisioning.
+        std::unique_ptr<DevelopmentRuntime> runtime;
+        if(!DevelopmentRuntime::Open(std::move(config),runtime,e)) {std::cerr<<"provision-runtime-open-failed\n";return 1;}
+        Profile profile; profile.chain_id=m.hp.chain_id; profile.genesis_id=m.hp.genesis_id;
+        profile.validation_digest=BlockValidationProfileDigest(m.hp,m.op,m.mp,m.cp);
+        auto capture=[&](ChainSnapshot &out)->bool {
+            const auto before=runtime->Snapshot();
+            if(!before.chain || before.reopen_required || before.execution_paused ||
+               before.chain->identity!=profile.chain_id || before.chain->profile_digest!=profile.validation_digest ||
+               before.chain->pending_journal || before.chain->pending_receipt || before.chain->pending_propagation) return false;
+            ChainSnapshot snap; snap.tip=before.chain->stable_tip; snap.generation=before.context_generation;
+            Hash id=snap.tip; std::vector<uint64_t> times;
+            for(size_t i=0;i<11;++i) {
+                std::optional<IndexedHeader> h;
+                if(runtime->ReadHeader(id,h,e)!=DevelopmentRuntimeResult::Progress || !h || h->stage!=HeaderStage::Connected) return false;
+                if(i==0) snap.height=h->header.height;
+                times.push_back(h->header.time); if(h->header.height==0) break; id=h->header.prev_id;
+            }
+            std::sort(times.begin(),times.end()); snap.median_time_past=times[times.size()/2];
+            const auto after=runtime->Snapshot();
+            if(!after.chain || after.reopen_required || after.execution_paused || after.context_generation!=before.context_generation ||
+               after.chain->stable_tip!=snap.tip || after.chain->root!=before.chain->root || after.chain->revision!=before.chain->revision) return false;
+            out=snap; return true;
+        };
+        ChainSnapshot snapshot;
+        if(!capture(snapshot)) {std::cerr<<"provision-runtime-not-authoritative\n";return 1;}
+        CoinLookup lookup=[&](const Outpoint &point,std::optional<Coin> &out,std::string &error) {
+            const auto before=runtime->Snapshot();
+            if(!before.chain) return Fail(error,"provision-runtime-not-authoritative");
+            CoinProof proof;
+            if(runtime->ProveCoin(point,proof,error)!=DevelopmentRuntimeResult::Progress ||
+               !VerifyCoinProof(point,proof,before.chain->root)) return Fail(error,"provision-native-coin-proof-invalid");
+            const auto after=runtime->Snapshot();
+            if(!after.chain || after.chain->root!=before.chain->root || after.chain->revision!=before.chain->revision)
+                return Fail(error,"provision-runtime-snapshot-changed");
+            out=proof.coin; return true;
+        };
+        SnapshotReader read=[&]{ChainSnapshot result; if(!capture(result)){result.generation=UINT64_MAX;result.initial_download=true;}return result;};
+        if(!ProvisionCredentialsFromFile(argv[4],argv[5],profile,snapshot,lookup,read,e)) {
+            // Never forward supplied callback or parser content to stderr.
+            std::cerr<<"provision-credentials-failed\n"; return 1;
+        }
+        std::cout<<"provisioned\n"; return 0;
+    } catch(const std::exception &) {std::cerr<<"provision-command-failed\n"; return 1;}
+}
+
+}
