@@ -0,0 +1,35 @@
+// Copyright (c) 2026 The Lotus developers
+#include "tx_root_seal.h"
+
+#include <vector>
+
+namespace lotus::v2 {
+
+bool SealChildHeaderWithTxRoot(const OrdinaryParentContext &parent,
+                               const OrdinaryBlockConnected &connected,
+                               std::span<const TxRootInput> transactions,
+                               uint32_t version, uint64_t time, uint64_t size,
+                               uint32_t bits, const Hash &pow_limit,
+                               Header &out, std::string &error) {
+    std::vector<TxIdentityPair> pairs;
+    pairs.reserve(transactions.size());
+    for (const TxRootInput &tx : transactions) {
+        // TxIdentityPair stores tx_hash then tx_id. TransactionSubtree
+        // hashes that order; do not sort or swap the fields.
+        TxIdentityPair pair{};
+        pair.tx_hash = TransactionHash(parent.chain_id, tx.header_core,
+                                       tx.full_inputs_root, tx.outputs_root);
+        pair.tx_id = TransactionId(parent.chain_id, tx.header_core,
+                                   tx.inputs_root, tx.outputs_root);
+        pairs.push_back(pair);
+    }
+    Hash tx_root{};
+    if (!TransactionRoot(pairs, tx_root)) {
+        error = "transaction root";
+        return false;
+    }
+    return SealChildHeader(parent, connected, tx_root, version, time, size,
+                           bits, pow_limit, out, error);
+}
+
+} // namespace lotus::v2
