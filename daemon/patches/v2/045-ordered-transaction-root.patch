 using namespace lotus::v2;
 
@@ -102,6 +104,154 @@ bool Unchanged(const Header &header) {
            header.state_root == saved.state_root;
 }
 
+// Development genesis fixture commits TransactionRoot of no transactions.
+const char *kEmptyTxRoot =
+    "eebdd2bf2b0f92f1764c36eaef67a3ba72195a4206f2ea225db80605833beadb";
+
+TxRootInput MakeTx(uint8_t tag) {
+    TxRootInput tx{};
+    tx.header_core[0] = 7;
+    for (size_t i = 1; i < tx.header_core.size(); ++i) {
+        tx.header_core[i] = static_cast<uint8_t>(tag + i);
+    }
+    tx.inputs_root = Pattern(tag);
+    tx.full_inputs_root = Pattern(static_cast<uint8_t>(tag + 40));
+    tx.outputs_root = Pattern(static_cast<uint8_t>(tag + 80));
+    return tx;
+}
+
+Hash ExpectTxRoot(const ChainId &chain_id, std::span<const TxRootInput> txs) {
+    std::vector<TxIdentityPair> pairs;
+    pairs.reserve(txs.size());
+    for (const TxRootInput &tx : txs) {
+        TxIdentityPair pair{};
+        pair.tx_hash = TransactionHash(chain_id, tx.header_core,
+                                       tx.full_inputs_root, tx.outputs_root);
+        pair.tx_id = TransactionId(chain_id, tx.header_core, tx.inputs_root,
+                                   tx.outputs_root);
+        pairs.push_back(pair);
+    }
+    Hash root{};
+    Check(TransactionRoot(pairs, root), "TransactionRoot");
+    return root;
+}
+
+Header SealTxs(const Sample &sample, std::span<const TxRootInput> txs,
+               const std::string &label) {
+    Header out = Sentinel();
+    std::string error = "sentinel";
+    Check(SealChildHeaderWithTxRoot(sample.parent, sample.connected, txs, 2,
+                                    50120, 400, 0x1d00ffff, sample.pow_limit,
+                                    out, error),
+          label + ": " + error);
+    Check(error.empty(), label + " clears the error");
+    Check(out.nonce == 0, label + " nonce stays 0");
+    Check(out.tx_root == ExpectTxRoot(sample.parent.chain_id, txs),
+          label + " tx_root is TransactionRoot");
+    Check(out.state_root == sample.connected.state_root,
+          label + " state root is the connected StateRoot");
+    return out;
+}
+
+void RunTransactionRootSeal(const Sample &sample) {
+    Hash direct{};
+    Check(TransactionRoot({}, direct), "empty TransactionRoot call");
+    const std::string got = Hex(direct.data(), direct.size());
+    if (got != kEmptyTxRoot) {
+        throw std::runtime_error("empty root " + got + " expected " +
+                                 kEmptyTxRoot);
+    }
+
+    const std::vector<TxRootInput> none;
+    Header empty = SealTxs(sample, none, "empty");
+    Check(Hex(empty.tx_root.data(), empty.tx_root.size()) == kEmptyTxRoot,
+          "empty transaction list matches the development digest");
+    Check(empty.tx_root == direct, "helper empty root is TransactionRoot");
+    Check(empty.tx_root != sample.tx_root,
+          "helper does not copy the fixture root");
+    std::array<uint8_t, HEADER_SIZE> bytes{};
+    Check(SerializeHeader(empty, bytes), "serialize empty header");
+    Check(bytes.size() == 134, "empty header is 134 bytes");
+    Check(std::all_of(bytes.begin() + 42, bytes.begin() + 50,
+                      [](uint8_t byte) { return byte == 0; }),
+          "encoded nonce stays 0");
+    Check(std::equal(empty.tx_root.begin(), empty.tx_root.end(),
+                     bytes.begin() + 70),
+          "encoded empty tx root");
+    Header parsed;
+    Check(ParseHeader(bytes.data(), bytes.size(), parsed) &&
+              parsed.nonce == 0 && parsed.tx_root == empty.tx_root,
+          "parsed empty header keeps nonce 0 and the tx root");
+
+    const TxRootInput a = MakeTx(1);
+    const TxRootInput b = MakeTx(2);
+    const TxRootInput c = MakeTx(3);
+    const std::vector<TxRootInput> one{a};
+    const std::vector<TxRootInput> three{a, b, c};
+    const std::vector<TxRootInput> reordered{a, c, b};
+    Header sealed_one = SealTxs(sample, one, "one");
+    Header sealed_three = SealTxs(sample, three, "three");
+    Header sealed_order = SealTxs(sample, reordered, "reordered three");
+    Check(sealed_one.tx_root != empty.tx_root,
+          "one transaction changes the root");
+    Check(sealed_three.tx_root != sealed_one.tx_root &&
+              sealed_three.tx_root != empty.tx_root,
+          "three transactions change the root");
+    Check(sealed_order.tx_root != sealed_three.tx_root,
+          "transaction order changes the three-tx root");
+    Check(sealed_one.nonce == 0 && sealed_three.nonce == 0 &&
+              sealed_order.nonce == 0,
+          "transaction seals do not search a nonce");
+
+    std::vector<TxRootInput> mutated_one{a};
+    mutated_one[0].inputs_root[0] ^= 0xff;
+    const Hash txid_before = TransactionId(
+        sample.parent.chain_id, a.header_core, a.inputs_root, a.outputs_root);
+    const Hash txid_after =
+        TransactionId(sample.parent.chain_id, mutated_one[0].header_core,
+                      mutated_one[0].inputs_root, mutated_one[0].outputs_root);
+    const Hash txhash_before =
+        TransactionHash(sample.parent.chain_id, a.header_core,
+                        a.full_inputs_root, a.outputs_root);
+    const Hash txhash_after = TransactionHash(
+        sample.parent.chain_id, mutated_one[0].header_core,
+        mutated_one[0].full_inputs_root, mutated_one[0].outputs_root);
+    Check(txid_before != txid_after && txhash_before == txhash_after,
+          "mutated txid input changes only the txid");
+    Header sealed_mut_one = SealTxs(sample, mutated_one, "mutated one");
+    Check(sealed_mut_one.tx_root != sealed_one.tx_root,
+          "mutated txid input changes the one-tx root");
+
+    std::vector<TxRootInput> mutated_three = three;
+    mutated_three[1].inputs_root[4] ^= 0x5a;
+    Header sealed_mut_three = SealTxs(sample, mutated_three, "mutated three");
+    Check(sealed_mut_three.tx_root != sealed_three.tx_root,
+          "mutated txid input changes the three-tx root");
+
+    // SealChildHeader copies the supplied tx_root and does not recompute it.
+    // The helper fills that field. Different lists must not share a root.
+    Check(sealed_one.tx_root != sealed_three.tx_root &&
+              sealed_order.tx_root != sealed_three.tx_root &&
+              sealed_mut_one.tx_root != sealed_one.tx_root,
+          "two transaction lists do not seal to the same tx_root");
+
+    Sample wrong_height = sample;
+    wrong_height.connected.state_root =
+        StateRoot(sample.parent.chain_id, 101, sample.connected.utxo_root,
+                  sample.connected.monetary.state);
+    Header out = Sentinel();
+    std::string error = "sentinel";
+    Check(!SealChildHeaderWithTxRoot(
+              wrong_height.parent, wrong_height.connected, three, 2, 50120, 400,
+              0x1d00ffff, wrong_height.pow_limit, out, error),
+          "helper rejects a state root that is not StateRoot");
+    Check(error == "connect result height", "helper state-root reason");
+    Check(Unchanged(out), "state-root failure preserves the header");
+
+    std::cout << "empty tx root " << kEmptyTxRoot << "\n";
+    std::cout << "V2 child transaction root seal passed\n";
+}
