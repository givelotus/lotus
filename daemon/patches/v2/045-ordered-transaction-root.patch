+// Copyright (c) 2026 The Lotus developers
+// Ordered transaction root for SealChildHeader. Not a nonce search and not
+// lotusd acceptance of the header.
+#ifndef LOTUS_V2_TX_ROOT_SEAL_H
+#define LOTUS_V2_TX_ROOT_SEAL_H
+
+#include "block_seal.h"
+#include "commitment.h"
+
+#include <span>
+#include <string>
+
+namespace lotus::v2 {
+
+// Arguments of TransactionId and TransactionHash, other than chain id.
+// inputs_root is the TxId input. full_inputs_root is the TxHash input.
+// Chain id is the parent's. This is not a wire transaction.
+struct TxRootInput {
+    TxHeaderCore header_core{};
+    Hash inputs_root{};
+    Hash full_inputs_root{};
+    Hash outputs_root{};
+};
+
+// Fills `out` on success and leaves it unchanged on failure.
+//
+// One TxIdentityPair per transaction, tx_hash then tx_id, is committed with
+// TransactionRoot. That digest is SealChildHeader's tx_root. The sealer
+// rejects a connected state_root that is not StateRoot at the child height.
+// Nonce is zero. Identity or transaction-root failure does not write `out`.
+bool SealChildHeaderWithTxRoot(const OrdinaryParentContext &parent,
+                               const OrdinaryBlockConnected &connected,
+                               std::span<const TxRootInput> transactions,
+                               uint32_t version, uint64_t time, uint64_t size,
+                               uint32_t bits, const Hash &pow_limit,
+                               Header &out, std::string &error);
+
+} // namespace lotus::v2
+#endif
