 // Copyright (c) 2026 The Lotus developers
 // Structural child-header seal. No nonce search and no lotusd ConnectTip.
 #include "block_seal.h"
+#include "tx_root_seal.h"
 
 #include <algorithm>
 #include <iostream>
 #include <stdexcept>
 #include <string>
