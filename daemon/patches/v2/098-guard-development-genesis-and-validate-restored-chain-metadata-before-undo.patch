From 7b9d8c12dbe9d28d3774c5438d78f812e19601f8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:42:26 -0700
Subject: [PATCH] Guard development genesis and validate restored chain
 metadata before undo

Require the exact active tip and validator profile, forbid genesis disconnect, and validate restored history, PoW, monetary work, state commitment and retained body before the backend publishes its undo batch. The predecessor must match the active child parent ID and height. Local corruption remains an operational error.
---
 src/lotus_v2/development_chain.cpp | 40 +++++++++++++++++++++++++++---
 src/lotus_v2/development_chain.h   |  7 ++++++
 2 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/development_chain.cpp b/src/lotus_v2/development_chain.cpp
index ab12b23a09ba987df232361c4590e7c6fd2c41dc..88a620971f84671d265ebb438194692a5050477d 100644
--- a/src/lotus_v2/development_chain.cpp
+++ b/src/lotus_v2/development_chain.cpp
@@ -14,8 +14,8 @@ MonetaryInteger Integer(const Hash &hash) {
 void Require(bool condition, const char *message) {
     if (!condition) throw std::invalid_argument(message);
 }
-void CheckStoredTip(const DiskStateStore &store, const HeaderChainProfile &hp) {
-    const auto meta = store.Metadata();
+void CheckStoredTip(const DiskStateMetadata &meta, const Hash &root,
+                    const HeaderChainProfile &hp) {
     std::vector<Header> history;
     std::vector<uint8_t> body;
     std::string error;
@@ -27,7 +27,7 @@ void CheckStoredTip(const DiskStateStore &store, const HeaderChainProfile &hp) {
             MeetsTarget(meta.tip, target), "stored tip proof of work");
     Require(Integer(money.prev_work) == (MonetaryInteger(1) << 256) / (Integer(target) + 1),
             "stored monetary target work");
-    Require(StateRoot(hp.chain_id, history.front().height, store.Root(), money) ==
+    Require(StateRoot(hp.chain_id, history.front().height, root, money) ==
             history.front().state_root, "stored tip state commitment");
 }
 } // namespace
@@ -104,7 +104,7 @@ bool OpenDevelopmentChain(
             Require(tx.Root() == tree.Root(), "genesis disk root");
             if (!tx.Commit(expected, failure)) { error = failure.message; return false; }
         }
-        CheckStoredTip(candidate, hp);
+        CheckStoredTip(candidate.Metadata(), candidate.Root(), hp);
         Header stored;
         const auto metadata = candidate.Metadata();
         Require(ParseHeader(metadata.header.data(), metadata.header.size(), stored), "stored header");
@@ -114,4 +114,36 @@ bool OpenDevelopmentChain(
         error.clear(); return true;
     } catch (const std::exception &e) { error = e.what(); return false; }
 }
+bool DisconnectDevelopmentTip(
+    const Hash &expected_tip, const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp, DiskStateStore &store, std::string &error) {
+    try {
+        Require(hp.genesis_id != Hash{}, "explicit genesis identity required");
+        Require(store.MatchesProfile(hp.chain_id, BlockValidationProfileDigest(hp, op, mp, cp)),
+                "stored validator profile mismatch");
+        const auto current = store.Metadata();
+        Require(current.tip == expected_tip, "active tip changed");
+        CheckStoredTip(current, store.Root(), hp);
+        Header child;
+        Require(ParseHeader(current.header.data(), current.header.size(), child), "stored child header");
+        Require(child.height != 0 && current.tip != hp.genesis_id, "cannot disconnect genesis");
+        DiskStateMetadataValidator validate = [&](const DiskStateMetadata &before,
+                                                  const Hash &root, DiskStateError &failure) {
+            try {
+                CheckStoredTip(before, root, hp);
+                Header parent;
+                Require(ParseHeader(before.header.data(), before.header.size(), parent), "restored parent header");
+                Require(parent.height == child.height - 1 && before.tip == child.prev_id,
+                        "undo is not the active child's exact predecessor");
+                return true;
+            } catch (const std::exception &e) {
+                failure = {DiskStateErrorCode::Corruption, e.what()}; return false;
+            }
+        };
+        DiskStateError failure;
+        if (!store.Disconnect(expected_tip, validate, failure)) { error = failure.message; return false; }
+        error.clear(); return true;
+    } catch (const std::exception &e) { error = e.what(); return false; }
+}
 } // namespace lotus::v2
diff --git a/src/lotus_v2/development_chain.h b/src/lotus_v2/development_chain.h
index a574ddbc1b0f26a526c5cebe16d1c01a07570589..a5daf629dbbf1de99b0d0752b23a6200e650ee83 100644
--- a/src/lotus_v2/development_chain.h
+++ b/src/lotus_v2/development_chain.h
@@ -15,5 +15,12 @@ bool OpenDevelopmentChain(
     const MonetaryProfile &mp, const BlockCostProfile &cp,
     const MonetaryState &initial, DiskStateOptions options,
     DiskStateStore &out, std::string &error);
+// Chain-aware undo: refuses genesis and validates the exact predecessor's
+// history, monetary/root commitment and retained body before publication.
+// Caller serializes access and supplies the expected active tip.
+bool DisconnectDevelopmentTip(
+    const Hash &expected_tip, const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp, DiskStateStore &store, std::string &error);
 } // namespace lotus::v2
 #endif
