From 18113131bd99f62110f96d6cb80cf608979f767e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:10:15 -0700
Subject: [PATCH] test: validate actual Avalanche observers with retained
 process evidence

---
 src/lotus_v2/node_avalanche_test/README.md    | 17 +++++++++
 .../node_avalanche_test/check_node.py         | 36 ++++++++++++++++---
 2 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/node_avalanche_test/README.md b/src/lotus_v2/node_avalanche_test/README.md
index cecafed54a56749c73226689d1c18c030e80913a..064a5d980a4a6e67e64636afe04964792f36036d 100644
--- a/src/lotus_v2/node_avalanche_test/README.md
+++ b/src/lotus_v2/node_avalanche_test/README.md
@@ -19,3 +19,20 @@ fixture. These process checks do not claim that coverage. The existing peer and
 driver component suites cover authenticated transcript/signature validation and
 proof-only backpressure. Mixed inventory is demultiplexed by the actual node;
 transaction notices are consumed once before a retained proof-only retry.
+
+Use `--evidence /new/physical/path --binary-source <exact-revision>` to preserve
+public command/event JSONL traces and SHA256 bindings for the binary, manifest
+and harness. The evidence directory must be new. Temporary node homes and
+processes are cleaned after the run; private credential bytes are never traced.
+
+Actual process validation on macOS arm64 passed against the Chronik-enabled
+binary built from `d4119718505d0bfbd358c97ac9bfb81aeb48b2da`, binary SHA256
+`97190feb57f60b4c567a9248c1e0bb4018d8d62dfbfadd41ffd5a9d20b4184e8`.
+The run includes runtime policy observation and successful reconciliation,
+height/freshness IBD, absent quorum/finality without proofs, refusal to reopen a
+disabled home with enabled options, and the credential failures listed above.
+Evidence was retained at
+`/private/tmp/lotus-v2-node-process-evidence-d411971850-20261015`.
+This does not establish funded quorum, parked-candidate transitions or other
+platform behavior. The macOS dependency deployment-target warning remains a
+separate build portability limitation.
diff --git a/src/lotus_v2/node_avalanche_test/check_node.py b/src/lotus_v2/node_avalanche_test/check_node.py
index 2c17bb998586a3be2cbfb1b3df6ed4c7c50683ad..edf08d55b606e58bfeffcb9204f9481ecfb0ceab 100644
--- a/src/lotus_v2/node_avalanche_test/check_node.py
+++ b/src/lotus_v2/node_avalanche_test/check_node.py
@@ -1,6 +1,7 @@
 #!/usr/bin/env python3
 """Actual-process development-node Avalanche checks (isolated fresh directories)."""
 import argparse
+import hashlib
 import json
 import os
 from pathlib import Path
@@ -36,6 +37,12 @@ class Node:
                                         stderr=subprocess.PIPE, bufsize=0)
         self.buffer = b""
         self.next_id = 0
+        self.evidence = Path(args.evidence) / (name + ".jsonl") if args.evidence else None
+
+    def record(self, direction, value):
+        if self.evidence:
+            with self.evidence.open("a") as file:
+                file.write(json.dumps(dict(direction=direction, value=value), sort_keys=True) + "\n")
 
     def event(self, deadline):
         while b"\n" not in self.buffer:
@@ -47,12 +54,16 @@ class Node:
             assert data, "node exited: " + self.process.stderr.read().decode()
             self.buffer += data
         line, self.buffer = self.buffer.split(b"\n", 1)
-        return json.loads(line)
+        event = json.loads(line)
+        self.record("received", event)
+        return event
 
     def request(self, command):
         self.next_id += 1
         tag = str(self.next_id)
-        self.process.stdin.write((json.dumps(dict(id=tag, command=command)) + "\n").encode())
+        request = dict(id=tag, command=command)
+        self.record("sent", request)
+        self.process.stdin.write((json.dumps(request) + "\n").encode())
         deadline = time.monotonic() + 10
         while True:
             event = self.event(deadline)
@@ -78,11 +89,26 @@ def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--node", required=True)
     parser.add_argument("--manifest", required=True)
+    parser.add_argument("--evidence", help="new directory for public command/event traces and exact input hashes")
+    parser.add_argument("--binary-source", default="unspecified", help="immutable binary source revision for evidence")
     args = parser.parse_args()
     args.node = str(Path(args.node).resolve())
     args.manifest = str(Path(args.manifest).resolve())
+    if args.evidence:
+        evidence = Path(args.evidence).resolve()
+        evidence.mkdir()
+        args.evidence = str(evidence)
+        bindings = dict(binary_source=args.binary_source,
+                        binary_sha256=hashlib.sha256(Path(args.node).read_bytes()).hexdigest(),
+                        manifest_sha256=hashlib.sha256(Path(args.manifest).read_bytes()).hexdigest(),
+                        harness_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+                        binary=args.node, manifest=args.manifest)
+        (evidence / "inputs.json").write_text(json.dumps(bindings, sort_keys=True, indent=2) + "\n")
     nodes = []
-    with tempfile.TemporaryDirectory(prefix="lotus-v2-node-avalanche-") as directory:
+    # PeerStore deliberately refuses symlink ancestors; macOS's default /var
+    # temp prefix passes through a symlink. Use its canonical physical path.
+    with tempfile.TemporaryDirectory(prefix="lotus-v2-node-avalanche-",
+                                     dir=Path(tempfile.gettempdir()).resolve()) as directory:
         root = Path(directory)
         try:
             disabled = Node(args, root, "disabled", network())
@@ -142,7 +168,7 @@ def main():
             cases = [("invalid-proof", private), ("symlink", link), ("fifo", fifo),
                      ("directory", root), ("oversized", oversized)]
             for name, path in cases:
-                node = Node(args, root, name, network(config(str(path))))
+                node = Node(args, root, "reject-" + name, network(config(str(path))))
                 nodes.append(node)
                 _, stderr = node.process.communicate(timeout=10)
                 assert node.process.returncode != 0, name
@@ -161,6 +187,8 @@ def main():
         finally:
             for node in nodes:
                 node.kill()
+    if args.evidence:
+        (Path(args.evidence) / "result.json").write_text(json.dumps(dict(result="pass", temporary_nodes_cleaned=True)) + "\n")
     print("Actual node observer negotiation, explicit IBD, no fake quorum, credential file validation: PASS")
 
 
-- 
