+// Copyright (c) 2026 The Lotus developers
+// Actual loopback ephemeral-port tests. No daemon, chain data or network profile.
+#include "peer_tcp.h"
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <fcntl.h>
+#include <iostream>
+#include <stdexcept>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+using namespace lotus::v2;
+using namespace lotus::v2::peer;
+#define CHECK(c) do { if (!(c)) throw std::runtime_error("line " + std::to_string(__LINE__) + ": " #c); } while (false)
+namespace {
+template <typename F> void Until(F f) {
+    for (unsigned i = 0; i < 1000; ++i) { if (f()) return; std::this_thread::sleep_for(std::chrono::milliseconds(1)); }
+    throw std::runtime_error("bounded loopback wait expired");
+}
+TcpEndpoint Loopback(const char *text = "127.0.0.1") {
+    TcpEndpoint endpoint; CHECK(ParseNumericEndpoint(text, 0, 0, endpoint)); return endpoint;
+}
+struct Pair {
+    TcpListener listener;
+    TcpStream client, server;
+    TcpEndpoint endpoint;
+    explicit Pair(const char *text = "127.0.0.1") {
+        auto requested = Loopback(text);
+        CHECK(listener.Listen(requested, {4, requested.family == TcpFamily::IPv6}));
+        CHECK(listener.BoundEndpoint(endpoint) && endpoint.port && endpoint.port != 10604 && endpoint.port != 10605 && endpoint.port != 8331);
+        const auto status = client.BeginConnect(endpoint, 10, 1000);
+        CHECK(status == TcpConnectStatus::Pending || status == TcpConnectStatus::Connected);
+        TcpEndpoint remote;
+        Until([&] {
+            const auto connected = client.PollConnect(10);
+            CHECK(connected != TcpConnectStatus::Error && connected != TcpConnectStatus::TimedOut);
+            if (!server.IsOpen()) {
+                const auto accepted = listener.Accept(server, remote);
+                CHECK(accepted != TcpAcceptStatus::Error);
+            }
+            return client.IsConnected() && server.IsConnected();
+        });
+        CHECK(remote.family == requested.family && remote.port);
+    }
+};
+void NumericAndLifecycle() {
+    auto endpoint = Loopback(); const auto unchanged = endpoint;
+    CHECK(!ParseNumericEndpoint("localhost", 1, 0, endpoint) && endpoint == unchanged);
+    CHECK(!ParseNumericEndpoint(std::string_view("127.0.0.1\0x", 11), 1, 0, endpoint));
+    CHECK(!ParseNumericEndpoint("127.0.0.1", 1, 9, endpoint));
+    TcpListener listener;
+    CHECK(!listener.Listen({}, {1, false}) && !listener.IsOpen());
+    CHECK(!listener.Listen(endpoint, {0, false}));
+    CHECK(listener.Listen(endpoint, {1, false}));
+    const int fd = listener.NativeHandle();
+    CHECK((fcntl(fd, F_GETFL) & O_NONBLOCK) && (fcntl(fd, F_GETFD) & FD_CLOEXEC));
+    CHECK(!listener.Listen(endpoint, {1, false}) && listener.NativeHandle() == fd);
+    TcpEndpoint bound; CHECK(listener.BoundEndpoint(bound));
+    TcpListener conflict;
+    CHECK(!conflict.Listen(bound, {1, false}) && !conflict.IsOpen() && conflict.LastError() == EADDRINUSE);
+    TcpStream out; TcpEndpoint remote = unchanged;
+    CHECK(listener.Accept(out, remote) == TcpAcceptStatus::WouldBlock && !out.IsOpen() && remote == unchanged);
+    TcpListener moved(std::move(listener)); CHECK(!listener.IsOpen() && moved.NativeHandle() == fd);
+    moved.Close(); moved.Close(); CHECK(fcntl(fd, F_GETFD) == -1 && errno == EBADF);
+    TcpStream invalid;
+    CHECK(invalid.BeginConnect(endpoint, 0, 1) == TcpConnectStatus::Error && !invalid.IsOpen()); // port0
+    endpoint.port = 1;
+    CHECK(invalid.BeginConnect(endpoint, UINT64_MAX, 1) == TcpConnectStatus::Error && !invalid.IsOpen());
+    CHECK(invalid.BeginConnect(endpoint, 1, 0) == TcpConnectStatus::Error && !invalid.IsOpen());
+}
+void IoAndMoves(const char *address) {
+    Pair pair(address);
+    std::array<uint8_t, 5> buffer{};
+    CHECK(pair.server.Read(buffer).status == StreamStatus::WouldBlock);
+    CHECK(pair.server.Read({}).status == StreamStatus::Error);
+    CHECK(pair.client.Write({}).status == StreamStatus::Error);
+    const Bytes payload{1, 2, 3, 4, 5}; size_t sent{}, received{};
+    Until([&] {
+        if (sent < payload.size()) { auto r = pair.client.Write(std::span(payload).subspan(sent));
+            CHECK(r.status == StreamStatus::Progress || r.status == StreamStatus::WouldBlock); sent += r.count; }
+        if (received < buffer.size()) { auto r = pair.server.Read(std::span(buffer).subspan(received));
+            CHECK(r.status == StreamStatus::Progress || r.status == StreamStatus::WouldBlock); received += r.count; }
+        return received == payload.size();
+    });
+    CHECK(std::equal(buffer.begin(), buffer.end(), payload.begin()));
+    const int fd = pair.client.NativeHandle();
+    CHECK((fcntl(fd, F_GETFL) & O_NONBLOCK) && (fcntl(fd, F_GETFD) & FD_CLOEXEC));
+    CHECK((fcntl(pair.server.NativeHandle(), F_GETFL) & O_NONBLOCK) &&
+          (fcntl(pair.server.NativeHandle(), F_GETFD) & FD_CLOEXEC));
+    CHECK(pair.client.BeginConnect(pair.endpoint, 20, 100) == TcpConnectStatus::Error && pair.client.NativeHandle() == fd);
+    TcpEndpoint remote = Loopback(); const auto saved = remote;
+    const int server_fd = pair.server.NativeHandle(), server_error = pair.server.LastError();
+    CHECK(pair.listener.Accept(pair.server, remote) == TcpAcceptStatus::Error && remote == saved &&
+          pair.server.NativeHandle() == server_fd && pair.server.LastError() == server_error);
+    TcpStream moved(std::move(pair.client)); CHECK(!pair.client.IsOpen() && moved.NativeHandle() == fd);
+    CHECK(moved.PollReadiness(false, true).writable);
+    moved.Close(); moved.Close(); CHECK(fcntl(fd, F_GETFD) == -1 && errno == EBADF);
+    const int reused = fcntl(pair.server.NativeHandle(), F_DUPFD, fd);
+    CHECK(reused == fd); // This test owns the duplicated descriptor.
+    moved.Close(); pair.client.Close();
+    CHECK(fcntl(reused, F_GETFD) >= 0); // stale owners cannot close reused fd
+    CHECK(::close(reused) == 0);
+    Until([&] { const auto r = pair.server.Read(buffer); CHECK(r.status != StreamStatus::Error); return r.status == StreamStatus::Eof; });
+    pair.server.Close();
+}
+void BackpressureAndSigpipe() {
+    Pair pair;
+    const int small = 4096;
+    CHECK(setsockopt(pair.client.NativeHandle(), SOL_SOCKET, SO_SNDBUF, &small, sizeof(small)) == 0);
+    CHECK(setsockopt(pair.server.NativeHandle(), SOL_SOCKET, SO_RCVBUF, &small, sizeof(small)) == 0);
+    const Bytes chunk(65536, 17); bool blocked{}; size_t bytes{};
+    for (unsigned i = 0; i < 1024; ++i) {
+        const auto r = pair.client.Write(chunk);
+        CHECK(r.status == StreamStatus::Progress || r.status == StreamStatus::WouldBlock);
+        bytes += r.count;
+        if (r.status == StreamStatus::WouldBlock) { blocked = true; break; }
+    }
+    CHECK(blocked && bytes > 0 && bytes <= 1024 * chunk.size());
+    // Explicit reset exercises write-after-close without installing a process
+    // SIGPIPE handler. Survival plus Error is the per-socket suppression check.
+    linger reset{1, 0}; CHECK(setsockopt(pair.server.NativeHandle(), SOL_SOCKET, SO_LINGER, &reset, sizeof(reset)) == 0);
+    pair.server.Close();
+    bool failed{};
+    Until([&] { const auto r = pair.client.Write(chunk); failed = r.status == StreamStatus::Error; return failed; });
+    CHECK(failed);
+    Until([&] { const auto r = pair.client.Write(chunk);
+        CHECK(r.status == StreamStatus::Error || r.status == StreamStatus::WouldBlock);
+        return r.status == StreamStatus::Error && pair.client.LastError() == EPIPE;
+    }); // EPIPE specifically exercises the normally signal-generating path.
+}
+void DeadlineAndRefusal() {
+    TcpListener listener; CHECK(listener.Listen(Loopback(), {1, false})); TcpEndpoint endpoint;
+    CHECK(listener.BoundEndpoint(endpoint));
+    TcpStream timeout; const auto start = timeout.BeginConnect(endpoint, 10, 20);
+    CHECK(start == TcpConnectStatus::Connected || start == TcpConnectStatus::Pending);
+    if (start == TcpConnectStatus::Pending) CHECK(timeout.PollConnect(30) == TcpConnectStatus::TimedOut && !timeout.IsOpen());
+    timeout.Close();
+    TcpStream backwards; const auto rollback = backwards.BeginConnect(endpoint, 10, 20);
+    if (rollback == TcpConnectStatus::Pending) CHECK(backwards.PollConnect(9) == TcpConnectStatus::Error && !backwards.IsOpen());
+    backwards.Close(); listener.Close();
+    TcpStream refused; auto result = refused.BeginConnect(endpoint, 10, 100);
+    if (result == TcpConnectStatus::Pending) Until([&] { result = refused.PollConnect(10); return result != TcpConnectStatus::Pending; });
+    CHECK(result == TcpConnectStatus::Error && !refused.IsOpen());
+}
+SessionConfig Config(uint64_t nonce) {
+    SessionConfig c{}; c.network.magic = {17, 29, 41, 53}; // synthetic explicit fixture
+    c.network.chain_id[0] = 7; c.network.genesis_id[0] = 8; c.network.profile_digest[0] = 9;
+    c.network.receive_limit = 4096; c.network.transaction = {32, 32, 8, 8192, 16, 8192, 64};
+    c.network.max_reconstruction_transactions = 100; c.network.max_reconstruction_bytes = 8192;
+    c.local_version.sender = VersionSender{VersionAddress{}, nonce}; c.local_version.user_agent = Bytes{'t'};
+    c.local_version.starting_height = 0; c.local_version.relay = true; c.local_version.extra_entropy = nonce + 1;
+    c.handshake_timeout_ms = 1000; return c;
+}
+void TransportHandshake() {
+    Pair pair;
+    Transport left(pair.client, Config(42), {31, 8192, 16, 1000, 1000});
+    Transport right(pair.server, Config(43), {29, 8192, 16, 1000, 1000});
+    CHECK(left.Open(10) && right.Open(10)); bool activated_left{}, activated_right{};
+    Until([&] {
+        CHECK(left.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        CHECK(right.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        if (auto e = left.TakeEvent()) { CHECK(e->result == SessionResult::Activated); activated_left = true; }
+        if (auto e = right.TakeEvent()) { CHECK(e->result == SessionResult::Activated); activated_right = true; }
+        return activated_left && activated_right;
+    });
+    CHECK(left.QueueMessage({"ping", {7, 8, 9}}, 10) == QueueResult::Queued);
+    bool application{};
+    Until([&] {
+        CHECK(left.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        CHECK(right.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        if (auto e = right.TakeEvent()) { CHECK(e->application && e->application->command == "ping" && e->application->payload == Bytes({7,8,9})); application = true; }
+        return application;
+    });
+    CHECK(left.Close());
+    Until([&] { return right.Poll(10, {8, 64, 64}).closed == TransportClose::EndOfStream; });
+    CHECK(!pair.client.IsOpen() && !pair.server.IsOpen());
+}
+} // namespace
+int main() {
+    try { NumericAndLifecycle(); IoAndMoves("127.0.0.1"); IoAndMoves("::1"); BackpressureAndSigpipe(); DeadlineAndRefusal(); TransportHandshake();
+        std::cout << "nonblocking localhost TCP tests passed\n";
+    } catch (const std::exception &e) { std::cerr << e.what() << '\n'; return 1; }
+}
