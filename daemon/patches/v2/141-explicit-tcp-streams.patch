index 0000000000000000000000000000000000000000..f9d959bd5a53c4d5210291e46a99b1b2e0f85a0f
--- /dev/null
+++ b/src/lotus_v2/peer_tcp.cpp
@@ -0,0 +1,197 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_tcp.h"
+#if !defined(__linux__) && !defined(__APPLE__)
+#error "peer_tcp currently supports POSIX Linux and macOS only"
+#endif
+#include <arpa/inet.h>
+#include <algorithm>
+#include <cerrno>
+#include <climits>
+#include <cstring>
+#include <fcntl.h>
+#include <limits>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <utility>
+namespace lotus::v2::peer {
+namespace {
+void CloseFd(int &fd) noexcept { const int old = std::exchange(fd, -1); if (old >= 0) (void)::close(old); }
+bool Blocked(int error) noexcept { return error == EINTR || error == EAGAIN || error == EWOULDBLOCK; }
+bool Configure(int fd) noexcept {
+    const int flags = fcntl(fd, F_GETFL, 0);
+    if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) return false;
+    const int descriptor = fcntl(fd, F_GETFD, 0);
+    if (descriptor < 0 || fcntl(fd, F_SETFD, descriptor | FD_CLOEXEC) < 0) return false;
+#ifdef __APPLE__
+    const int one = 1;
+    if (setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one)) < 0) return false;
+#endif
+    return true;
+}
+int NewSocket(int family) noexcept {
+#ifdef __linux__
+    int fd = socket(family, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, IPPROTO_TCP);
+#else
+    int fd = socket(family, SOCK_STREAM, IPPROTO_TCP);
+#endif
+    if (fd >= 0 && !Configure(fd)) { const int error = errno; CloseFd(fd); errno = error; }
+    return fd;
+}
+bool Address(const TcpEndpoint &endpoint, sockaddr_storage &storage, socklen_t &length) noexcept {
+    storage = {};
+    if (endpoint.family == TcpFamily::IPv4 && !endpoint.scope_id &&
+        std::all_of(endpoint.address.begin() + 4, endpoint.address.end(), [](uint8_t b) { return b == 0; })) {
+        sockaddr_in address{}; address.sin_family = AF_INET; address.sin_port = htons(endpoint.port);
+        std::memcpy(&address.sin_addr, endpoint.address.data(), 4);
+        std::memcpy(&storage, &address, sizeof(address)); length = sizeof(address); return true;
+    }
+    if (endpoint.family == TcpFamily::IPv6) {
+        sockaddr_in6 address{}; address.sin6_family = AF_INET6; address.sin6_port = htons(endpoint.port);
+        address.sin6_scope_id = endpoint.scope_id;
+        std::memcpy(&address.sin6_addr, endpoint.address.data(), 16);
+        std::memcpy(&storage, &address, sizeof(address)); length = sizeof(address); return true;
+    }
+    return false;
+}
+bool Endpoint(const sockaddr_storage &storage, socklen_t length, TcpEndpoint &out) noexcept {
+    TcpEndpoint endpoint;
+    if (storage.ss_family == AF_INET && length >= sizeof(sockaddr_in)) {
+        sockaddr_in address{}; std::memcpy(&address, &storage, sizeof(address));
+        endpoint.family = TcpFamily::IPv4; endpoint.port = ntohs(address.sin_port);
+        std::memcpy(endpoint.address.data(), &address.sin_addr, 4);
+    } else if (storage.ss_family == AF_INET6 && length >= sizeof(sockaddr_in6)) {
+        sockaddr_in6 address{}; std::memcpy(&address, &storage, sizeof(address));
+        endpoint.family = TcpFamily::IPv6; endpoint.port = ntohs(address.sin6_port); endpoint.scope_id = address.sin6_scope_id;
+        std::memcpy(endpoint.address.data(), &address.sin6_addr, 16);
+    } else return false;
+    out = endpoint; return true;
+}
+TcpReadiness Ready(int fd, bool read, bool write, int &error) noexcept {
+    if (fd < 0 || (!read && !write)) { error = EINVAL; return {StreamStatus::Error}; }
+    pollfd descriptor{fd, short((read ? POLLIN : 0) | (write ? POLLOUT : 0)), 0};
+    const int result = poll(&descriptor, 1, 0);
+    if (result < 0) { error = errno; return {Blocked(error) ? StreamStatus::WouldBlock : StreamStatus::Error}; }
+    if (!result) return {};
+    if (descriptor.revents & POLLNVAL) { error = EBADF; return {StreamStatus::Error}; }
+    return {StreamStatus::Progress, bool(descriptor.revents & (POLLIN | POLLERR | POLLHUP)),
+        bool(descriptor.revents & (POLLOUT | POLLERR | POLLHUP)), bool(descriptor.revents & POLLHUP)};
+}
+} // namespace
+bool ParseNumericEndpoint(std::string_view text, uint16_t port, uint32_t scope, TcpEndpoint &out) noexcept {
+    if (text.empty() || text.size() >= INET6_ADDRSTRLEN || text.find('\0') != std::string_view::npos) return false;
+    char address[INET6_ADDRSTRLEN]{}; std::memcpy(address, text.data(), text.size());
+    TcpEndpoint endpoint; endpoint.port = port; endpoint.scope_id = scope;
+    if (!scope && inet_pton(AF_INET, address, endpoint.address.data()) == 1) endpoint.family = TcpFamily::IPv4;
+    else if (inet_pton(AF_INET6, address, endpoint.address.data()) == 1) endpoint.family = TcpFamily::IPv6;
+    else return false;
+    out = endpoint; return true;
+}
+TcpStream::~TcpStream() { Close(); }
+TcpStream::TcpStream(TcpStream &&other) noexcept { *this = std::move(other); }
+TcpStream &TcpStream::operator=(TcpStream &&other) noexcept {
+    if (this != &other) { Close(); fd_ = std::exchange(other.fd_, -1); error_ = other.error_;
+        connected_ = std::exchange(other.connected_, false); deadline_ = other.deadline_; last_ms_ = other.last_ms_; }
+    return *this;
+}
+void TcpStream::Close() noexcept { CloseFd(fd_); connected_ = false; }
+TcpConnectStatus TcpStream::BeginConnect(const TcpEndpoint &endpoint, uint64_t now, uint64_t timeout) noexcept {
+    if (IsOpen()) { error_ = EALREADY; return TcpConnectStatus::Error; }
+    sockaddr_storage address{}; socklen_t length{};
+    if (!endpoint.port || !timeout || timeout > std::numeric_limits<uint64_t>::max() - now || !Address(endpoint, address, length)) {
+        error_ = EINVAL; return TcpConnectStatus::Error;
+    }
+    fd_ = NewSocket(address.ss_family);
+    if (fd_ < 0) { error_ = errno; return TcpConnectStatus::Error; }
+    deadline_ = now + timeout; last_ms_ = now;
+    if (connect(fd_, reinterpret_cast<const sockaddr *>(&address), length) == 0) {
+        connected_ = true; error_ = 0; return TcpConnectStatus::Connected;
+    }
+    error_ = errno;
+    if (error_ == EINPROGRESS || error_ == EALREADY || error_ == EINTR) return TcpConnectStatus::Pending;
+    Close(); return TcpConnectStatus::Error;
+}
+TcpConnectStatus TcpStream::PollConnect(uint64_t now) noexcept {
+    if (connected_) return TcpConnectStatus::Connected;
+    if (!IsOpen()) { error_ = ENOTCONN; return TcpConnectStatus::Error; }
+    if (now < last_ms_) { error_ = EINVAL; Close(); return TcpConnectStatus::Error; }
+    last_ms_ = now;
+    if (now >= deadline_) { error_ = ETIMEDOUT; Close(); return TcpConnectStatus::TimedOut; }
+    const auto ready = Ready(fd_, false, true, error_);
+    if (ready.status == StreamStatus::Error) { Close(); return TcpConnectStatus::Error; }
+    if (ready.status == StreamStatus::WouldBlock) return TcpConnectStatus::Pending;
+    int result{}; socklen_t length = sizeof(result);
+    if (getsockopt(fd_, SOL_SOCKET, SO_ERROR, &result, &length) < 0) {
+        error_ = errno; if (Blocked(error_)) return TcpConnectStatus::Pending;
+        Close(); return TcpConnectStatus::Error;
+    }
+    if (length != sizeof(result)) result = EIO;
+    if (result) { error_ = result; Close(); return TcpConnectStatus::Error; }
+    connected_ = true; error_ = 0; return TcpConnectStatus::Connected;
+}
+TcpReadiness TcpStream::PollReadiness(bool read, bool write) noexcept { return Ready(fd_, read, write, error_); }
+StreamResult TcpStream::Read(std::span<uint8_t> bytes) {
+    if (!connected_ || bytes.empty()) { error_ = EINVAL; return {StreamStatus::Error}; }
+    const auto n = recv(fd_, bytes.data(), std::min(bytes.size(), size_t(SSIZE_MAX)), 0);
+    if (n > 0) return {StreamStatus::Progress, size_t(n)};
+    if (!n) return {StreamStatus::Eof};
+    error_ = errno; return {Blocked(error_) ? StreamStatus::WouldBlock : StreamStatus::Error};
+}
+StreamResult TcpStream::Write(std::span<const uint8_t> bytes) {
+    if (!connected_ || bytes.empty()) { error_ = EINVAL; return {StreamStatus::Error}; }
+#ifdef __linux__
+    constexpr int flags = MSG_NOSIGNAL;
+#else
+    constexpr int flags = 0; // SO_NOSIGPIPE set before ownership publication.
+#endif
+    const auto n = send(fd_, bytes.data(), std::min(bytes.size(), size_t(SSIZE_MAX)), flags);
+    if (n > 0) return {StreamStatus::Progress, size_t(n)};
+    error_ = n < 0 ? errno : EIO;
+    return {Blocked(error_) ? StreamStatus::WouldBlock : StreamStatus::Error};
+}
+TcpListener::~TcpListener() { Close(); }
+TcpListener::TcpListener(TcpListener &&other) noexcept { *this = std::move(other); }
+TcpListener &TcpListener::operator=(TcpListener &&other) noexcept {
+    if (this != &other) { Close(); fd_ = std::exchange(other.fd_, -1); error_ = other.error_; }
+    return *this;
+}
+void TcpListener::Close() noexcept { CloseFd(fd_); }
+bool TcpListener::Listen(const TcpEndpoint &endpoint, const TcpListenOptions &options) noexcept {
+    if (IsOpen()) { error_ = EALREADY; return false; }
+    sockaddr_storage address{}; socklen_t length{};
+    if (!options.backlog || options.backlog > INT_MAX || !Address(endpoint, address, length) ||
+        (endpoint.family != TcpFamily::IPv6 && options.ipv6_only)) { error_ = EINVAL; return false; }
+    int fd = NewSocket(address.ss_family);
+    if (fd < 0) { error_ = errno; return false; }
+    const int v6_only = options.ipv6_only;
+    if ((endpoint.family == TcpFamily::IPv6 && setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &v6_only, sizeof(v6_only)) < 0) ||
+        bind(fd, reinterpret_cast<const sockaddr *>(&address), length) < 0 || listen(fd, int(options.backlog)) < 0) {
+        error_ = errno; CloseFd(fd); return false;
+    }
+    fd_ = fd; error_ = 0; return true;
+}
+bool TcpListener::BoundEndpoint(TcpEndpoint &out) noexcept {
+    sockaddr_storage address{}; socklen_t length = sizeof(address);
+    if (fd_ < 0 || getsockname(fd_, reinterpret_cast<sockaddr *>(&address), &length) < 0) {
+        error_ = fd_ < 0 ? EBADF : errno; return false;
+    }
+    if (!Endpoint(address, length, out)) { error_ = EAFNOSUPPORT; return false; }
+    return true;
+}
+TcpAcceptStatus TcpListener::Accept(TcpStream &out, TcpEndpoint &remote) noexcept {
+    if (fd_ < 0 || out.IsOpen()) { error_ = fd_ < 0 ? EBADF : EALREADY; return TcpAcceptStatus::Error; }
+    sockaddr_storage address{}; socklen_t length = sizeof(address);
+#ifdef __linux__
+    int fd = accept4(fd_, reinterpret_cast<sockaddr *>(&address), &length, SOCK_NONBLOCK | SOCK_CLOEXEC);
+#else
+    int fd = accept(fd_, reinterpret_cast<sockaddr *>(&address), &length);
+#endif
+    if (fd < 0) { error_ = errno; return Blocked(error_) ? TcpAcceptStatus::WouldBlock : TcpAcceptStatus::Error; }
+    TcpEndpoint endpoint;
+    if (!Configure(fd)) { error_ = errno; CloseFd(fd); return TcpAcceptStatus::Error; }
+    if (!Endpoint(address, length, endpoint)) { error_ = EAFNOSUPPORT; CloseFd(fd); return TcpAcceptStatus::Error; }
+    out.fd_ = fd; out.connected_ = true; out.error_ = 0; remote = endpoint; error_ = 0;
+    return TcpAcceptStatus::Accepted;
+}
+TcpReadiness TcpListener::PollReadiness() noexcept { return Ready(fd_, true, false, error_); }
+} // namespace lotus::v2::peer
