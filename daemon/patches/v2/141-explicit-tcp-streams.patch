@@ -0,0 +1,78 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_PEER_TCP_H
+#define LOTUS_V2_PEER_TCP_H
+#include "peer_transport.h"
+#include <array>
+#include <string_view>
+namespace lotus::v2::peer {
+// POSIX Linux/macOS only. No DNS, defaults, seeds, implicit wildcard bind, or
+// protocol/network selection. Unspecified endpoints are rejected.
+enum class TcpFamily { Unspecified, IPv4, IPv6 };
+struct TcpEndpoint {
+    TcpFamily family{TcpFamily::Unspecified};
+    std::array<uint8_t, 16> address{};
+    uint16_t port{};
+    uint32_t scope_id{};
+    bool operator==(const TcpEndpoint &) const = default;
+};
+bool ParseNumericEndpoint(std::string_view address, uint16_t port, uint32_t scope_id,
+                          TcpEndpoint &out) noexcept;
+enum class TcpConnectStatus { Connected, Pending, TimedOut, Error };
+enum class TcpAcceptStatus { Accepted, WouldBlock, Error };
+struct TcpReadiness {
+    StreamStatus status{StreamStatus::WouldBlock};
+    bool readable{}, writable{}, hangup{};
+};
+class TcpListener;
+// Owns exactly one fd. Single-owner/caller-serialized. Transport borrows this
+// object: never move, replace or destroy it while a Transport still borrows it.
+// Close sets fd=-1 before one close syscall, never retries ambiguous EINTR.
+class TcpStream final : public ByteStream {
+public:
+    TcpStream() = default;
+    ~TcpStream() override;
+    TcpStream(TcpStream &&) noexcept;
+    TcpStream &operator=(TcpStream &&) noexcept;
+    TcpStream(const TcpStream &) = delete;
+    TcpStream &operator=(const TcpStream &) = delete;
+    TcpConnectStatus BeginConnect(const TcpEndpoint &, uint64_t monotonic_ms, uint64_t timeout_ms) noexcept;
+    TcpConnectStatus PollConnect(uint64_t monotonic_ms) noexcept;
+    TcpReadiness PollReadiness(bool read, bool write) noexcept; // one fd, timeout0
+    StreamResult Read(std::span<uint8_t>) override;
+    StreamResult Write(std::span<const uint8_t>) override;
+    void Close() noexcept override;
+    bool IsOpen() const noexcept { return fd_ >= 0; }
+    bool IsConnected() const noexcept { return connected_; }
+    int LastError() const noexcept { return error_; } // POSIX errno, never peer invalidity
+    int NativeHandle() const noexcept { return fd_; } // borrowed; never close/change flags
+private:
+    friend class TcpListener;
+    int fd_{-1}, error_{};
+    bool connected_{};
+    uint64_t deadline_{}, last_ms_{};
+};
+struct TcpListenOptions { uint32_t backlog{}; bool ipv6_only{}; };
+class TcpListener {
+public:
+    TcpListener() = default;
+    ~TcpListener();
+    TcpListener(TcpListener &&) noexcept;
+    TcpListener &operator=(TcpListener &&) noexcept;
+    TcpListener(const TcpListener &) = delete;
+    TcpListener &operator=(const TcpListener &) = delete;
+    // Port0 explicitly requests OS ephemeral allocation. No reuseport/reuseaddr.
+    bool Listen(const TcpEndpoint &, const TcpListenOptions &) noexcept;
+    bool BoundEndpoint(TcpEndpoint &out) noexcept;
+    // At most one accepted fd per call. Refuses an already-open output before
+    // accept. Stream/remote outputs remain unchanged on every failure.
+    TcpAcceptStatus Accept(TcpStream &out, TcpEndpoint &remote) noexcept;
+    TcpReadiness PollReadiness() noexcept;
+    void Close() noexcept;
+    bool IsOpen() const noexcept { return fd_ >= 0; }
+    int LastError() const noexcept { return error_; }
+    int NativeHandle() const noexcept { return fd_; } // borrowed
+private:
+    int fd_{-1}, error_{};
+};
+} // namespace lotus::v2::peer
+#endif
