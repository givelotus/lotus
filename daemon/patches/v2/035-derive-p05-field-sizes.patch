new file mode 100644
index 000000000..58a5130d1
--- /dev/null
+++ b/src/lotus_v2/field_size.cpp
@@ -0,0 +1,67 @@
+// Copyright (c) 2026 The Lotus developers
+#include "field_size.h"
+
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+
+void AccumulatePaths(const std::vector<std::vector<uint8_t>> &paths,
+                     std::vector<size_t> &sizes) {
+    for (size_t slot = 0; slot < paths.size(); ++slot) {
+        const size_t encoded = PathSerializedSize(paths[slot]);
+        if (sizes.size() <= slot) sizes.resize(slot + 1, 0);
+        if (encoded > sizes[slot]) sizes[slot] = encoded;
+    }
+}
+
+} // namespace
+
+bool OutputSerializedSize(const Output &output, size_t &size,
+                          std::string &error) {
+    std::vector<uint8_t> encoded;
+    if (!EncodeOutput(output, encoded, error)) return false;
+    size = encoded.size();
+    error.clear();
+    return true;
+}
+
+bool DeriveFieldSizes(const VmExecutionContext &context,
+                      std::map<uint8_t, std::vector<size_t>> &field_sizes,
+                      std::string &error) {
+    std::vector<size_t> outputs;
+    outputs.reserve(context.tx.outputs.size());
+    for (const Output &output : context.tx.outputs) {
+        size_t size = 0;
+        if (!OutputSerializedSize(output, size, error)) {
+            field_sizes.clear();
+            return false;
+        }
+        outputs.push_back(size);
+    }
+    std::vector<size_t> coins(context.tx.inputs.size(), 0);
+    std::vector<size_t> coin_paths;
+    std::vector<size_t> output_paths;
+    for (size_t i = 0; i < context.tx.inputs.size(); ++i) {
+        if (i >= context.resolved.size() || !context.resolved[i]) continue;
+        const Output &coin = *context.resolved[i];
+        size_t size = 0;
+        if (!OutputSerializedSize(coin, size, error)) {
+            field_sizes.clear();
+            return false;
+        }
+        coins[i] = size;
+        AccumulatePaths(coin.paths, coin_paths);
+    }
+    for (const Output &output : context.tx.outputs)
+        AccumulatePaths(output.paths, output_paths);
+    field_sizes.clear();
+    field_sizes.emplace(0xdb, std::move(coin_paths));
+    field_sizes.emplace(0xdc, std::move(coins));
+    field_sizes.emplace(0xe6, std::move(output_paths));
+    field_sizes.emplace(0xe7, std::move(outputs));
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/field_size.h b/src/lotus_v2/field_size.h
new file mode 100644
index 000000000..19d68ba2d
--- /dev/null
+++ b/src/lotus_v2/field_size.h
@@ -0,0 +1,35 @@
+// Copyright (c) 2026 The Lotus developers
+// Serialized sizes of authenticated output, coin and path fields. This is not
+// a block-acceptance check.
+#ifndef LOTUS_V2_FIELD_SIZE_H
+#define LOTUS_V2_FIELD_SIZE_H
+
+#include "vm.h"
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+
+// Bytes pushed for one path: a single length byte plus the branch indices.
+// Valid paths are at most MAX_OUTPUT_BRANCHES indices, each one byte on the
+// wire, so this matches Vec(CompactSize(index)).
+inline size_t PathSerializedSize(const std::vector<uint8_t> &path) {
+    return 1 + path.size();
+}
+
+// EncodeOutput's byte length. Fails closed on a field that will not encode.
+bool OutputSerializedSize(const Output &output, size_t &size, std::string &error);
+
+// Fills 0xdb (UTXOPATH), 0xdc (UTXOOUTPUT), 0xe6 (OUTPUTPATH) and 0xe7
+// (OUTPUTRECORD). One complete-record entry per input or output; a missing
+// coin is 0. Path vectors are indexed by slot and hold the widest authenticated
+// path at that slot. Empty path vectors mean no path exists. Caller hints are
+// not consulted.
+bool DeriveFieldSizes(const VmExecutionContext &context,
+                      std::map<uint8_t, std::vector<size_t>> &field_sizes,
+                      std::string &error);
+
+} // namespace lotus::v2
+#endif
