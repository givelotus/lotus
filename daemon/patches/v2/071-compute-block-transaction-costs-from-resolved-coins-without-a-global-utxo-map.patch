From c917ba04892774af9abb34d97e6da39d5e22ae8f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:50:34 -0700
Subject: [PATCH] Compute block transaction costs from resolved coins without a
 global UTXO map

Expose the existing cost arithmetic over exact resolved spends in input order. Preserve the map adapter as an oracle, reject missing/mismatched/extra records, and compare both paths in complete-block tests. This prepares bounded disk lookup without changing development charges.
---
 src/lotus_v2/block_cost.cpp          | 33 ++++++++++++++++++++--------
 src/lotus_v2/block_cost.h            |  8 +++++++
 src/lotus_v2/test_block_complete.cpp | 20 +++++++++++++++++
 3 files changed, 52 insertions(+), 9 deletions(-)

diff --git a/src/lotus_v2/block_cost.cpp b/src/lotus_v2/block_cost.cpp
index d8150b435af16634795940a5e8c2c880a9d9ff2b..bef68f19f85dbcf036b90932754ef98a0ef971d5 100644
--- a/src/lotus_v2/block_cost.cpp
+++ b/src/lotus_v2/block_cost.cpp
@@ -35,9 +35,9 @@ namespace {
                Int(256) * HashCost(67, p);
     }
 } // namespace
-TransactionCosts AuthenticatedTransactionCosts(const Transaction &tx,
+TransactionCosts AuthenticatedTransactionCostsResolved(const Transaction &tx,
                                                const TxProfile &profile,
-                                               const DevelopmentUtxoView &view,
+                                               const std::vector<Coin> &resolved_spends,
                                                uint64_t height, uint64_t mtp,
                                                VmCostUnits invocation,
                                                const BlockCostProfile &p) {
@@ -66,13 +66,13 @@ TransactionCosts AuthenticatedTransactionCosts(const Transaction &tx,
                               p) +
                      Int(w.siblings.size()) * HashCost(65, p);
         if (input.flags == 1) {
-            ++spends;
-            const auto found =
-                view.find(Outpoint{input.prev_txid, input.prev_index});
-            Require(found != view.end(), "cost unresolved coin");
+            Require(spends < resolved_spends.size(), "cost unresolved coin");
+            const Coin &coin_record = resolved_spends[spends++];
+            Require(coin_record.outpoint == Outpoint{input.prev_txid, input.prev_index},
+                    "cost resolved outpoint mismatch");
             std::vector<uint8_t> output, coin;
-            Require(EncodeOutput(found->second.output, output, error) &&
-                        EncodeCoin(found->second, coin),
+            Require(EncodeOutput(coin_record.output, output, error) &&
+                        EncodeCoin(coin_record, coin),
                     "cost resolved encoding");
             total += Int(coin.size()) * p.resolve_byte;
             total +=
@@ -82,10 +82,11 @@ TransactionCosts AuthenticatedTransactionCosts(const Transaction &tx,
                               p);
             // Path selection and matching is bounded by the frozen 16x16 caps.
             total += Int(256) * p.asset_comparison;
-            total += StateKey(found->second, p);
+            total += StateKey(coin_record, p);
         } else if (input.flags == 3)
             total += HashCost(0, p); // absent resolved CoinEntry
     }
+    Require(spends == resolved_spends.size(), "cost extra resolved coin");
     const bool coinbase = tx.inputs.front().flags == 2;
     total += (coinbase ? 2 : 3) * Tree(tx.inputs.size(), p) +
              Tree(tx.outputs.size(), p);
@@ -111,6 +112,20 @@ TransactionCosts AuthenticatedTransactionCosts(const Transaction &tx,
     uint64_t result = Narrow(total);
     return {result, result};
 }
+TransactionCosts AuthenticatedTransactionCosts(
+    const Transaction &tx, const TxProfile &profile,
+    const DevelopmentUtxoView &view, uint64_t height, uint64_t mtp,
+    VmCostUnits invocation, const BlockCostProfile &p) {
+    std::vector<Coin> resolved;
+    for (const auto &input : tx.inputs) {
+        if (input.flags != 1) continue;
+        const auto found = view.find(Outpoint{input.prev_txid, input.prev_index});
+        Require(found != view.end(), "cost unresolved coin");
+        resolved.push_back(found->second);
+    }
+    return AuthenticatedTransactionCostsResolved(tx, profile, resolved, height,
+                                                 mtp, invocation, p);
+}
 MonetaryInteger AuthenticatedEnvelopeCost(uint64_t frames, uint32_t count,
                                           const BlockCostProfile &p) {
     Profile(p);
diff --git a/src/lotus_v2/block_cost.h b/src/lotus_v2/block_cost.h
index 29dada4d598d740338dcc0848ce3362b496be50a..ab91123b2e68f3d01e821c757ddd78975dc6b418 100644
--- a/src/lotus_v2/block_cost.h
+++ b/src/lotus_v2/block_cost.h
@@ -29,6 +29,14 @@ AuthenticatedTransactionCosts(const Transaction &tx, const TxProfile &profile,
                               const DevelopmentUtxoView &view, uint64_t height,
                               uint64_t parent_mtp, VmCostUnits invocation_cost,
                               const BlockCostProfile &cost);
+// Same arithmetic over the validated transaction's resolved spends, in input
+// order with mint/coinbase inputs omitted. This avoids backend reads or a
+// complete UTXO map in the persistent connector. Reject mismatched records.
+TransactionCosts AuthenticatedTransactionCostsResolved(
+    const Transaction &tx, const TxProfile &profile,
+    const std::vector<Coin> &resolved_spends, uint64_t height,
+    uint64_t parent_mtp, VmCostUnits invocation_cost,
+    const BlockCostProfile &cost);
 MonetaryInteger AuthenticatedEnvelopeCost(uint64_t frame_prefix_bytes,
                                           uint32_t count,
                                           const BlockCostProfile &cost);
diff --git a/src/lotus_v2/test_block_complete.cpp b/src/lotus_v2/test_block_complete.cpp
index 17056bc2c9d19e9b04956104b4fed611b42d06ab..4a7a732288f76b36df18cbbb6fd4e36e78757dae 100644
--- a/src/lotus_v2/test_block_complete.cpp
+++ b/src/lotus_v2/test_block_complete.cpp
@@ -201,6 +201,26 @@ void CompleteChecks() {
         AuthenticatedTransactionCosts(cb, TX, view, 2, 1120, 0, COST);
     const auto s = AuthenticatedTransactionCosts(spend, TX, view, 2, 1120,
                                                  effects.invocation_cost, COST);
+    const auto resolved_cost = AuthenticatedTransactionCostsResolved(
+        spend, TX, {funding}, 2, 1120, effects.invocation_cost, COST);
+    Check(resolved_cost.account_linear == s.account_linear &&
+              resolved_cost.enforce_linear == s.enforce_linear,
+          "resolved cost matches map oracle");
+    const auto cb_cost = AuthenticatedTransactionCostsResolved(
+        cb, TX, {}, 2, 1120, 0, COST);
+    Check(cb_cost.account_linear == c.account_linear,
+          "coinbase needs no resolved spends");
+    Coin wrong = funding;
+    ++wrong.outpoint.index;
+    for (const auto &coins : std::vector<std::vector<Coin>>{
+             {}, {wrong}, {funding, funding}}) {
+        bool rejected = false;
+        try {
+            AuthenticatedTransactionCostsResolved(
+                spend, TX, coins, 2, 1120, effects.invocation_cost, COST);
+        } catch (const std::invalid_argument &) { rejected = true; }
+        Check(rejected, "reject missing mismatched or surplus cost coins");
+    }
     std::vector<uint8_t> cbraw, spraw;
     Check(EncodeTransaction(cb, TX, cbraw, error) &&
               EncodeTransaction(spend, TX, spraw, error),
