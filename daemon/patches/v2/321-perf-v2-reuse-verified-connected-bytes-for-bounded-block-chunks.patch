+#!/usr/bin/env python3
+"""Test exact ReadBlock response wiring against a real runtime storage fault.
+
+The generated adapter extracts production ReadBlock and its parsing helpers
+verbatim. Its Status callback injects an actual durable-sync error into the real
+runtime, then returns normally. This models silent authority loss during Status;
+it does not execute the full Node::Status or launch a node/listener.
+"""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+
+
+def extract(source, signature, *, declaration=False):
+    start = source.index(signature)
+    brace = source.index("{", start)
+    # The selected functions contain balanced braces in literals/comments.
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    if declaration:
+        assert source[end] == ";"
+        end += 1
+    return source[start:end]
+
+
+def emit(node_source, runtime_test, directory):
+    source = node_source.read_text()
+    helpers = "\n".join(extract(source, signature, declaration=declaration)
+                        for signature, declaration in (
+                            ("void Require(", False), ("void Keys(", False),
+                            ("uint64_t Number(", False),
+                            ("std::vector<uint8_t> Unhex(", False),
+                            ("struct ProducerFailure :", True),
+                            ("std::string RuntimeFailure(", False),
+                            ("Hash HashOf(", False),
+                            ("std::string Hex(std::span", False)))
+    readblock = extract(source, "UniValue Node::ReadBlock(")
+    fence = (
+        '            if (!SameDevelopmentBodyAuthority(chunk.snapshot, runtime->Snapshot()))\n'
+        '                throw ProducerFailure("inconclusive",\n'
+        '                                      "connected body authority changed");')
+    assert readblock.count(fence) == 1, "Production authority fence changed; update explicit negative control"
+    prefix = '''#include <set>
+#include <univalue.h>
+#define main ExistingRuntimeSuiteMain
+#include RUNTIME_TEST_SOURCE
+#undef main
+namespace command_adapter {
+using namespace lotus::v2;
+using Result = DevelopmentRuntimeResult;
+'''.replace('RUNTIME_TEST_SOURCE', json.dumps(str(runtime_test.resolve())))
+    node = '''
+struct Node {
+    DevelopmentRuntime *runtime;
+    struct { uint64_t block_read_limit = 1 << 20; } manifest;
+    std::function<void()> on_status;
+    UniValue Status() {
+        if (on_status) on_status();
+        return UniValue(UniValue::VOBJ);
+    }
+    UniValue ReadBlock(const UniValue &);
+};
+'''
+    main = r'''
+} // namespace command_adapter
+int main() {
+    try {
+        FaultEnv env;
+        Home home(32 << 20, Profiles(), true, &env);
+        Seed(home);
+        auto runtime = Open(Config(home));
+        command_adapter::Node node{runtime.get(), {}, {}};
+        UniValue request(UniValue::VOBJ);
+        request.pushKV("id", "chunk-fault");
+        request.pushKV("command", "readblock");
+        request.pushKV("block_id", command_adapter::Hex(H(V(3).id)));
+        request.pushKV("offset", uint64_t{0});
+        request.pushKV("length", uint64_t{7});
+        const auto success = node.ReadBlock(request);
+        const auto wire = Bytes(V(3).wire);
+        Check(success["ok"].get_bool() && success["data"].get_str() ==
+                  command_adapter::Hex(std::span<const uint8_t>(wire).first(7)),
+              "actual ReadBlock returns the requested verified slice");
+        request.pushKV("offset", uint64_t(wire.size() + 1));
+        const auto range = node.ReadBlock(request);
+        Check(!range["ok"].get_bool() && range["result"].get_str() == "invalid_request" &&
+                  !range.exists("data"), "actual ReadBlock preserves invalid range errors");
+        request.pushKV("offset", uint64_t(wire.size()));
+        const auto eof = node.ReadBlock(request);
+        Check(eof["ok"].get_bool() && eof["eof"].get_bool() && eof["data"].get_str().empty(),
+              "actual ReadBlock preserves empty EOF");
+        request.pushKV("offset", uint64_t{0});
+        node.manifest.block_read_limit = wire.size() - 1;
+        const auto cap = node.ReadBlock(request);
+        Check(!cap["ok"].get_bool() && cap["result"].get_str() == "capacity_refused" &&
+                  !cap.exists("data"), "actual ReadBlock applies smaller caps on hits");
+        node.manifest.block_read_limit = 1 << 20;
+        unsigned status_calls = 0;
+        node.on_status = [&] {
+            ++status_calls;
+            env.fail_after_sync = true;
+            HeaderAdmission admitted = HeaderAdmission::Invalid;
+            std::string error;
+            Check(runtime->AdmitHeader(HeaderOf(V(4)), admitted, error) ==
