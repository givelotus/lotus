From 40d66a7d93b268957ca6b20b703d321a00f522b1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:58:02 -0700
Subject: [PATCH] fix(chronik): translate genesis checkpoint convention at
 native bridge

---
 src/lotus_v2/chronik_sync.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/chronik_sync.cpp b/src/lotus_v2/chronik_sync.cpp
index 78d4ff3301a123b23f056d927732dafd2e6fed5c..dde127f441571dea1a1161e19031b4dcefd66ddd 100644
--- a/src/lotus_v2/chronik_sync.cpp
+++ b/src/lotus_v2/chronik_sync.cpp
@@ -187,7 +187,11 @@ std::optional<ChronikAnchor> CxxChronikSink::Checkpoint() {
     return ChronikAnchor{status.indexed.block_id, status.indexed.height};
 }
 void CxxChronikSink::Initialize(const ChronikBlock &b) {
-    service_.initialize_genesis(BridgeBlock(b));
+    auto genesis = BridgeBlock(b);
+    // The index ABI uses a self-parented checkpoint for genesis; the native
+    // block header correctly retains its all-zero predecessor.
+    genesis.parent = genesis.anchor;
+    service_.initialize_genesis(std::move(genesis));
 }
 void CxxChronikSink::Connect(const ChronikBlock &b) {
     service_.connect_block(BridgeBlock(b));
