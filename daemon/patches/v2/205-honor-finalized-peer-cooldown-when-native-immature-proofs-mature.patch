From 9e977239da934bdc1545551ec55a8d9bda319296 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:19:23 -0700
Subject: [PATCH] Honor finalized peer cooldown when native immature proofs
 mature

Maintenance explanation added during mailbox export:
Preserve finalized peer cooldown rules when native immature proofs become mature. Regressions cover promotion timing so maturity does not bypass the upstream peer lifecycle restrictions.

---
 src/lotus_v2/avalanche_poll.h      |  3 +++
 src/lotus_v2/avalanche_quorum.cpp  | 25 ++++++++++++++-----------
 src/lotus_v2/avalanche_quorum.h    |  2 +-
 src/lotus_v2/test_avalanche_v2.cpp | 23 ++++++++++++++++++++---
 4 files changed, 38 insertions(+), 15 deletions(-)

diff --git a/src/lotus_v2/avalanche_poll.h b/src/lotus_v2/avalanche_poll.h
index 8c2d03b05c5c7dad6b8bd6cf3545f45414249662..cb35b42f0d2de8f6d4051ace1392d89ea206f223 100644
--- a/src/lotus_v2/avalanche_poll.h
+++ b/src/lotus_v2/avalanche_poll.h
@@ -15,6 +15,9 @@ public:
     bool Reconcile(const PollItem &, bool accepted, std::string &);
     bool Next(Quorum &, const ChainSnapshot &, int64_t now_milliseconds,
               OutgoingPoll &, std::string &);
+    // Single-owner operation: apply must atomically accept/reject the whole
+    // block batch and must not reenter this engine or mutate quorum. Proof
+    // transitions and staged vote confidence commit only after it accepts.
     bool Receive(Quorum &, NodeId, const SignedResponse &, const ChainSnapshot &,
                  int64_t now_milliseconds, const ApplyBlockUpdates &, std::string &);
     // Signatures for incoming polls are not required by ABC; only authenticated
diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index 81267dbd0df72990fa307c56c9b3a71d23609ea1..2c1606c2b41a64020b3b74e83d98c5dbbcca3a7b 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -137,30 +137,33 @@ std::optional<NodeId> Quorum::Select(int64_t now) {
 }
 std::optional<AuthenticatedHello> Quorum::Node(NodeId id) const { auto it=impl_->nodes.find(id); if(it==impl_->nodes.end()) return {}; return it->second.hello; }
 void Quorum::Cooldown(NodeId id,int64_t until) { auto it=impl_->nodes.find(id); if(it!=impl_->nodes.end()) it->second.next=until; }
-bool Quorum::Revalidate(const ChainSnapshot &snapshot,const CoinLookup &lookup,const SnapshotReader &reader,std::string &error) {
+bool Quorum::Revalidate(const ChainSnapshot &snapshot,const CoinLookup &lookup,int64_t now,const SnapshotReader &reader,std::string &error) {
+    Quorum staged(impl_->profile); staged.impl_=std::make_unique<Impl>(*impl_);
     std::vector<::avalanche::ProofId> remove, mature, immature;
-    for(const auto &[id,entry]:impl_->entries) {
+    for(const auto &[id,entry]:staged.impl_->entries) {
         AdmittedProof admitted;
-        if(AdmitProof(impl_->profile,snapshot,lookup,entry.envelope,admitted,reader,error)) {
+        if(AdmitProof(staged.impl_->profile,snapshot,lookup,entry.envelope,admitted,reader,error)) {
             if(entry.immature) mature.push_back(id);
             continue;
         }
         if(error=="immature-utxo") {
-            auto relaxed=impl_->profile; relaxed.stake_confirmations=1;
+            auto relaxed=staged.impl_->profile; relaxed.stake_confirmations=1;
             if(AdmitProof(relaxed,snapshot,lookup,entry.envelope,admitted,reader,error)) { immature.push_back(id); continue; }
         }
         remove.push_back(id);
     }
     if(reader()!=snapshot) return Fail(error,"stale-proof-snapshot");
-    for(const auto &id:remove) { impl_->Remove(id); impl_->entries.erase(id); }
-    for(const auto &id:immature) { impl_->Remove(id); auto &entry=impl_->entries.at(id); entry.immature=true; entry.finalized=false; }
+    for(const auto &id:remove) { staged.impl_->Remove(id); staged.impl_->entries.erase(id); }
+    for(const auto &id:immature) { staged.impl_->Remove(id); auto &entry=staged.impl_->entries.at(id); entry.immature=true; entry.finalized=false; }
     for(const auto &id:mature) {
-        auto &entry=impl_->entries.at(id); entry.immature=false;
-        ::avalanche::ProofPool::ConflictingProofSet conflicts;
-        if(impl_->active.addProofIfPreferred(entry.envelope.proof,conflicts)==::avalanche::ProofPool::REJECTED) {
-            impl_->conflicting.addProofIfPreferred(entry.envelope.proof);
-        } else for(const auto &other:conflicts) impl_->conflicting.addProofIfPreferred(other);
+        auto envelope=staged.impl_->entries.at(id).envelope;
+        staged.impl_->entries.erase(id);
+        // The native immature pool has now released this proof. Ordinary
+        // registration must still honor existing peers' replacement cooldown.
+        staged.Register(envelope,snapshot,lookup,now,reader,error);
     }
+    if(reader()!=snapshot) return Fail(error,"stale-proof-snapshot");
+    impl_.swap(staged.impl_);
     error.clear();
     return true;
 }
diff --git a/src/lotus_v2/avalanche_quorum.h b/src/lotus_v2/avalanche_quorum.h
index 916d6aa9933732e61d25dd868b3f05d9c02773e6..8fa9a851b3a9996f373fa0e8045579ca126fb889 100644
--- a/src/lotus_v2/avalanche_quorum.h
+++ b/src/lotus_v2/avalanche_quorum.h
@@ -25,7 +25,7 @@ public:
     std::optional<NodeId> Select(int64_t now_milliseconds);
     std::optional<AuthenticatedHello> Node(NodeId) const;
     void Cooldown(NodeId, int64_t until_milliseconds);
-    bool Revalidate(const ChainSnapshot &, const CoinLookup &, const SnapshotReader &, std::string &);
+    bool Revalidate(const ChainSnapshot &, const CoinLookup &, int64_t now_seconds, const SnapshotReader &, std::string &);
     bool ApplyProofVote(const ::avalanche::ProofId &, Status, int64_t now_seconds,
                         std::string &);
     uint32_t Vote(const ::avalanche::ProofId &) const;
diff --git a/src/lotus_v2/test_avalanche_v2.cpp b/src/lotus_v2/test_avalanche_v2.cpp
index c78efe882658ade53c2c218d10aaac2d3e6f5901..756b99f08487538df4823368ab415d3b4b973460 100644
--- a/src/lotus_v2/test_avalanche_v2.cpp
+++ b/src/lotus_v2/test_avalanche_v2.cpp
@@ -35,8 +35,25 @@ int main() {
   Quorum young(profile); snapshot.height=1;
   CHECK(!young.Register(envelope,snapshot,lookup,0,read,error)); CHECK(error=="immature-utxo");
   CHECK(young.Vote(envelope.proof->getId())==2); CHECK(!young.Pollable(envelope.proof->getId()));
-  snapshot.height=3000; CHECK(young.Revalidate(snapshot,lookup,read,error)); CHECK(young.Vote(envelope.proof->getId())==0);
-  snapshot.height=1; CHECK(young.Revalidate(snapshot,lookup,read,error)); CHECK(young.Vote(envelope.proof->getId())==2);
+  snapshot.height=3000; CHECK(young.Revalidate(snapshot,lookup,0,read,error)); CHECK(young.Vote(envelope.proof->getId())==0);
+  snapshot.height=1; CHECK(young.Revalidate(snapshot,lookup,0,read,error)); CHECK(young.Vote(envelope.proof->getId())==2);
+  snapshot.height=3000;
+  // Maturing a preferred aggregate cannot bypass a finalized peer's cooldown.
+  Quorum cooldown(profile); CHECK(cooldown.Register(envelope,snapshot,lookup,0,read,error));
+  CHECK(cooldown.ApplyProofVote(envelope.proof->getId(),Status::Finalized,100,error));
+  Coin recent=coin; recent.outpoint.tx_id[0]=10; recent.creation_height=2500;
+  uint256 recent_tx; std::copy(recent.outpoint.tx_id.begin(),recent.outpoint.tx_id.end(),recent_tx.begin());
+  ::avalanche::ProofBuilder replacement_builder(2,0,key,CScript{} << OP_DUP << OP_HASH160 << std::vector<uint8_t>(20,1) << OP_EQUALVERIFY << OP_CHECKSIG);
+  CHECK(replacement_builder.addUTXO(COutPoint(TxId(tx),0),int64_t(coin.output.value)*SATOSHI,1,false,key));
+  CHECK(replacement_builder.addUTXO(COutPoint(TxId(recent_tx),0),int64_t(recent.output.value)*SATOSHI,2500,false,key));
+  ProofEnvelope replacement{replacement_builder.build(),{lock,lock}};
+  CoinLookup mixed=[&](const Outpoint &point,std::optional<Coin> &out,std::string &){out=point==coin.outpoint?std::optional<Coin>(coin):point==recent.outpoint?std::optional<Coin>(recent):std::nullopt;return true;};
+  CHECK(!cooldown.Register(replacement,snapshot,mixed,101,read,error)); CHECK(error=="immature-utxo");
+  CHECK(cooldown.Vote(replacement.proof->getId())==2);
+  snapshot.height=5000; CHECK(cooldown.Revalidate(snapshot,mixed,102,read,error));
+  CHECK(cooldown.Vote(envelope.proof->getId())==0); CHECK(cooldown.Vote(replacement.proof->getId())==uint32_t(-1));
+  CHECK(cooldown.Register(replacement,snapshot,mixed,101+int64_t(profile.peer_replacement_cooldown_seconds),read,error));
+  CHECK(cooldown.Vote(replacement.proof->getId())==0); CHECK(cooldown.Vote(envelope.proof->getId())==3);
   snapshot.height=3000;
   auto bad_profile=profile; bad_profile.min_quorum_stake=MAX_MONEY+SATOSHI;
   bool invalid_constructor=false; try { Quorum invalid(bad_profile); } catch(const std::invalid_argument &) { invalid_constructor=true; } CHECK(invalid_constructor);
@@ -100,7 +117,7 @@ int main() {
   CHECK(!quorum.Established(snapshot));
   CHECK(engine.Respond(poll,observe,quorum,key,response,error));
   for(const auto &vote:response.response.GetVotes()) CHECK(vote.GetError()==uint32_t(-1));
-  coin.output.value--; CHECK(quorum.Revalidate(snapshot,lookup,read,error)); CHECK(!quorum.Select(1000));
+  coin.output.value--; CHECK(quorum.Revalidate(snapshot,lookup,0,read,error)); CHECK(!quorum.Select(1000));
   std::cout<<"native Avalanche admission, quorum, typed polls, authentication and release checks passed\n";
  } catch(const std::exception &e) { std::cerr<<e.what()<<'\n'; ECC_Stop(); return 1; }
  ECC_Stop(); return 0;
