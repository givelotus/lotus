+    Check(p.a.Stable(6),
+          "pending pipeline completes without reconnect or re-request");
+    Match(*p.a.runtime, 6);
+    Check(p.a.manager->Stats().jobs == 0 && p.a.staging.live_bytes == 0 &&
+              p.a.Active(),
+          "pipeline releases leases on existing session");
+    std::cout << "PASS ordinary tip advance preserves pending body jobs\n";
+}
+void PendingOutputTimeoutCancels() {
+    Pair p;
+    Seed(*p.b.runtime, {0, 1});
+    // Saturate the real Transport queue while its nonblocking stream refuses
+    // writes, leaving a dispatcher reply in its separately bounded slot.
+    for (unsigned n = 0; n < 5; ++n)
+        p.Cycle();
+    p.sb.block_write = true;
+    for (unsigned n = 0; n < 32; ++n)
+        Check(p.b.transport.QueueMessage({"ping", Bytes(8, 0)}, p.ms) ==
+                  QueueResult::Queued,
+              "fill bounded transport output");
+    Check(p.b.transport.QueueMessage({"ping", Bytes(8, 0)}, p.ms) ==
+              QueueResult::Backpressure,
+          "real transport backpressure");
+    std::string e;
+    HeaderAdmission out;
+    Check(p.a.runtime->AdmitHeader(HeaderOf(V(0)), out, e) ==
+              DevelopmentRuntimeResult::Progress,
+          "authenticate requested header");
+    Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(0)),
+                                       DownloadMode::Full,
+                                       p.ms) == DispatcherResult::Queued,
+          "outstanding staging lease");
+    p.Headers();
+    const auto begun = p.ms;
+    for (unsigned n = 0; n < 40; ++n)
+        p.Cycle();
+    Check(p.b.transport.CloseReason() == TransportClose::None,
+          "temporary output backpressure leaves session alive");
+    Check(p.b.transport.QueuedFrames() <= 32 &&
+              p.b.transport.QueuedBytes() <= size_t(2 << 20),
+          "transport output stays capped");
+    p.ms = begun + 501;
+    for (unsigned n = 0; n < 10; ++n)
+        p.Cycle();
+    Check(p.b.transport.CloseReason() != TransportClose::None,
+          "pending dispatcher output has fixed timeout under backpressure");
+    Check(p.a.manager->Stats().jobs == 0 && p.a.staging.live_bytes == 0 &&
+              p.a.staging.live_slots == 0,
+          "timeout/disconnect cancels all download leases");
+    Check(p.a.runtime->Snapshot().chain &&
+              p.a.runtime->Snapshot().chain->invalid_root_count == 0,
+          "operational timeout never marks header invalid");
+    std::cout << "PASS bounded backpressure and pending-output timeout "
+                 "cancellation\n";
+}
