+void PendingBodiesSurviveTipAdvance() {
+    Pair p;
+    Seed(*p.b.runtime, {0, 1, 4, 5, 6});
+    p.Headers();
+    for (unsigned n = 0; n < 1000; ++n) {
+        p.Cycle();
+        std::optional<IndexedHeader> h;
