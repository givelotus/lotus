+                     TransportSettings());
+    ConnectionId extra;
+    Check(p.a.dispatcher->Attach(second, extra) == DispatcherResult::Queued,
+          "second transport attaches to shared manager");
+    struct Attached {
+        PeerDispatcher &dispatcher;
+        ConnectionId id;
+        ~Attached() { dispatcher.Remove(id); }
+    } attached{*p.a.dispatcher, extra};
+    Check(p.a.dispatcher->Open(extra, p.ms) == DispatcherResult::Queued &&
+              c.dispatcher->Open(c.connection, p.ms) ==
+                  DispatcherResult::Queued,
+          "open additional real sessions");
+    for (unsigned n = 0;
+         n < 1000 && (!p.a.dispatcher->Handle(extra) || !c.Active()); ++n) {
+        p.Cycle();
+        c.Poll(p.ms);
+    }
+    Check(bool(p.a.dispatcher->Handle(extra)) && c.Active(),
+          "both peers registered in one manager");
+    for (unsigned n = 0; n < 10; ++n) {
+        p.Cycle();
+        c.Poll(p.ms);
+    }
+    Check(p.a.transport.QueuedFrames() == 0 && second.QueuedFrames() == 0,
+          "startup messages drained");
+    Check(p.b.transport.QueueMessage({"ping", Bytes(8, 1)}, p.ms) ==
+                  QueueResult::Queued &&
+              c.transport.QueueMessage({"ping", Bytes(8, 2)}, p.ms) ==
+                  QueueResult::Queued,
+          "two real peer pings queued");
+    for (unsigned n = 0; n < 20; ++n) {
+        p.b.transport.Poll(p.ms, TransportStep());
+        c.transport.Poll(p.ms, TransportStep());
+    }
+    // Prime through the dispatcher itself so its event-ready observations
+    // accompany the native Transport events. Then remove all I/O allowance.
+    auto prime = DispatcherStep();
+    prime.max_actions = 1;
+    for (unsigned n = 0; n < 128 && (!p.ba.bytes.empty() || !ca.bytes.empty());
+         ++n)
