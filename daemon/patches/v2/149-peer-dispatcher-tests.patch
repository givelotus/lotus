+        const auto u = p.a.dispatcher->Tick(p.ms, UINT64_MAX, 0, budget);
+        Check(u.actions <= 1 && u.transport_actions == 0 && u.io_calls == 0,
+              "zero transport allowance honored");
+        while (p.a.dispatcher->TakeNotice()) {
+        }
