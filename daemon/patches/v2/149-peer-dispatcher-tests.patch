+void Seed(DevelopmentRuntime &r, const std::vector<size_t> &path) {
+    std::string error;
+    for (size_t n : path) {
+        HeaderAdmission h = HeaderAdmission::Invalid;
+        Check(r.AdmitHeader(HeaderOf(V(n)), h, error) ==
+                  DevelopmentRuntimeResult::Progress,
+              "seed real contextual header: " + error);
+        Check(h == HeaderAdmission::Stored || h == HeaderAdmission::Known,
+              "seed stored/known header");
+        CandidateBodyStatus b = CandidateBodyStatus::Malformed;
+        Check(r.RetainBody(H(V(n).id), runtime_fixture::Bytes(V(n).wire), b,
+                           error) == DevelopmentRuntimeResult::Progress,
+              "seed authenticated body: " + error);
+    }
+    for (unsigned calls = 0; calls < 300; ++calls) {
+        const auto t = r.Tick(UINT64_MAX, 0, TickLimits());
+        Check(t.result != DevelopmentRuntimeResult::StorageError,
+              "seed tick storage: " + t.diagnostic);
+        const auto s = r.Snapshot();
+        if (s.chain && s.chain->stable_tip == H(V(path.back()).id) &&
+            !s.chain->pending_journal && !s.chain->pending_receipt &&
+            !s.chain->pending_propagation)
+            return;
+    }
+    throw std::runtime_error("seed did not reach reference tip");
+}
+void Match(DevelopmentRuntime &r, size_t n) {
+    const auto &v = V(n);
+    DiskStateMetadata m;
+    Hash root;
+    std::string error;
+    Check(r.ReadMetadata(1 << 20, m, root, error) ==
+              DevelopmentRuntimeResult::Progress,
+          "authoritative metadata: " + error);
+    Check(m.tip == H(v.id) && root == H(v.root) &&
+              m.monetary == runtime_fixture::Bytes(v.monetary),
+          "exact reference tip/state root/monetary bytes");
+    const auto wire = runtime_fixture::Bytes(v.wire);
+    Check(m.header == Bytes(wire.begin(), wire.begin() + HEADER_SIZE),
+          "exact reference header");
+    Bytes body;
+    Check(r.ReadConnectedBody(m.tip, 1 << 20, body, error) ==
+                  DevelopmentRuntimeResult::Progress &&
+              body == wire,
+          "accepted connected full body persisted");
+    std::map<Outpoint, Bytes, OutpointLess> expected, all;
+    for (const auto &encoded : v.coins) {
+        auto b = runtime_fixture::Bytes(encoded);
+        expected.emplace(runtime_fixture::Key(b), b);
+    }
+    for (const auto &row : runtime_fixture::vectors)
+        for (const auto &encoded : row.coins) {
+            auto b = runtime_fixture::Bytes(encoded);
+            all.emplace(runtime_fixture::Key(b), b);
+        }
+    for (const auto &[key, ignored] : all) {
+        (void)ignored;
+        std::optional<Coin> coin;
+        Check(r.ReadCoin(key, coin, error) ==
+                  DevelopmentRuntimeResult::Progress,
+              "authoritative coin read");
+        const auto wanted = expected.find(key);
+        Check(bool(coin) == (wanted != expected.end()),
+              "all touched reference coin presence");
+        if (coin) {
+            Bytes encoded;
+            Check(EncodeCoin(*coin, encoded) && encoded == wanted->second,
+                  "exact reference CoinEntry");
+        }
+        CoinProof proof;
+        Check(r.ProveCoin(key, proof, error) ==
+                      DevelopmentRuntimeResult::Progress &&
+                  VerifyCoinProof(key, proof, root),
+              "reference touched coin proof");
+    }
+}
