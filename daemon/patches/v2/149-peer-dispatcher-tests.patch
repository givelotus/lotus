+struct Allowance {
+    uint64_t live_bytes = 0, peak_bytes = 0, cap = 64 << 20;
+    uint32_t live_slots = 0, peak_slots = 0, slots = 16384;
+    uint64_t grants = 0, releases = 0;
+    struct Lease final : DownloadReservation {
+        Allowance &owner;
+        ResourceNeed need;
+        Lease(Allowance &o, ResourceNeed n) : owner(o), need(n) {}
+        ~Lease() override {
+            owner.live_bytes -= need.staging_bytes;
+            owner.live_slots -= need.transaction_slots;
+            ++owner.releases;
+        }
+    };
+    ReservationResult Reserve(const ResourceNeed &n) {
+        if (n.staging_bytes > cap - live_bytes ||
+            n.transaction_slots > slots - live_slots)
+            return {ReservationDisposition::CapacityRefused, nullptr,
+                    "explicit test staging cap"};
+        auto lease = std::make_unique<Lease>(*this, n);
+        live_bytes += n.staging_bytes;
+        live_slots += n.transaction_slots;
+        ++grants;
+        peak_bytes = std::max(peak_bytes, live_bytes);
+        peak_slots = std::max(peak_slots, live_slots);
+        return {ReservationDisposition::Granted, std::move(lease), {}};
+    }
+};
