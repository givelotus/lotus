+std::vector<uint8_t> Bytes(const std::string &hex) {
+    Check(hex.size() % 2 == 0, "hex length");
+    std::vector<uint8_t> out;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        out.push_back(uint8_t(std::stoul(hex.substr(i, 2), nullptr, 16)));
+    return out;
