+// Preserve an ambiguous durable-write result: report failure only after real
+// LevelDB WAL Sync succeeds. This is a storage seam, never a chain validator.
+class FaultEnv final : public leveldb::EnvWrapper {
+public:
+    bool fail_after_sync = false;
+    unsigned failures = 0;
+    FaultEnv() : EnvWrapper(leveldb::Env::Default()) {}
+    class File final : public leveldb::WritableFile {
+        FaultEnv &owner;
+        std::unique_ptr<leveldb::WritableFile> file;
+
+    public:
+        File(FaultEnv &o, leveldb::WritableFile *f) : owner(o), file(f) {}
+        std::string GetName() const override { return file->GetName(); }
+        leveldb::Status Append(const leveldb::Slice &s) override {
+            return file->Append(s);
+        }
+        leveldb::Status Flush() override { return file->Flush(); }
+        leveldb::Status Close() override { return file->Close(); }
+        leveldb::Status Sync() override {
+            auto result = file->Sync();
+            if (result.ok() && owner.fail_after_sync) {
+                owner.fail_after_sync = false;
+                ++owner.failures;
+                return leveldb::Status::IOError(
+                    "peer test ambiguous sync result");
+            }
+            return result;
+        }
+    };
+    leveldb::Status NewWritableFile(const std::string &path,
+                                    leveldb::WritableFile **out) override {
+        auto r = target()->NewWritableFile(path, out);
+        if (r.ok() && path.ends_with(".log")) *out = new File(*this, *out);
+        return r;
+    }
+    leveldb::Status NewAppendableFile(const std::string &path,
+                                      leveldb::WritableFile **out) override {
+        auto r = target()->NewAppendableFile(path, out);
+        if (r.ok() && path.ends_with(".log")) *out = new File(*this, *out);
+        return r;
+    }
+};
+void AuthorityLossCancelsBeforeReopen() {
+    FaultEnv env;
+    Pair p(64, &env);
+    Seed(*p.a.runtime, {0, 1});
+    Seed(*p.b.runtime, {0, 1, 4, 5, 6});
+    std::string error;
+    HeaderAdmission out;
+    for (size_t n : {4, 5})
+        Check(p.a.runtime->AdmitHeader(HeaderOf(V(n)), out, error) ==
+                  DevelopmentRuntimeResult::Progress,
+              "authority test header admission");
+    p.sb.block_write = true;
+    Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(4)),
+                                       DownloadMode::Full,
+                                       p.ms) == DispatcherResult::Queued,
+          "live job before authority loss");
+    Check(p.a.manager->Stats().jobs == 1 && p.a.staging.live_bytes > 0,
+          "one staging lease before storage fault");
+    const auto epoch = p.a.dispatcher->FetchEpoch();
+    env.fail_after_sync = true;
+    Check(p.a.runtime->AdmitHeader(HeaderOf(V(6)), out, error) ==
+              DevelopmentRuntimeResult::ReopenRequired,
+          "real ambiguous write loses runtime authority");
+    Check(env.failures == 1 && p.a.runtime->Snapshot().reopen_required &&
+              !p.a.runtime->Snapshot().chain,
+          "lost authority exposes no stale chain snapshot");
+    p.a.Poll(p.ms++);
+    Check(p.a.dispatcher->FetchEpoch() > epoch &&
+              p.a.manager->Stats().jobs == 0 && p.a.staging.live_bytes == 0,
+          "authority loss fences/cancels pending downloads before reopen");
+    const auto reopened = p.a.runtime->Tick(UINT64_MAX, 0, TickLimits());
+    Check(reopened.result == DevelopmentRuntimeResult::Reopened &&
+              reopened.snapshot.chain,
+          "runtime explicitly reconciles durable store");
+    Check(reopened.snapshot.chain->invalid_root_count == 0,
+          "storage uncertainty creates no permanent invalidity");
+    Match(*p.a.runtime, 1);
+    std::cout << "PASS ambiguous durable write cancels fetches before "
+                 "authoritative reopen\n";
+}
+void InvalidBodyRestoresForkAndFences() {
+    Pair p;
+    Seed(*p.a.runtime, {0, 1, 2, 3});
+    Seed(*p.b.runtime, {0, 1, 4, 5, 6});
+    std::string error;
+    HeaderAdmission out;
