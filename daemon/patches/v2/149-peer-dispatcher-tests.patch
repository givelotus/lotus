+struct Node {
+    Home home;
+    std::unique_ptr<DevelopmentRuntime> runtime{Open(home)};
+    NetworkProfile network;
+    Allowance staging, serving;
+    std::unique_ptr<DownloadManager> manager;
+    Transport transport;
+    std::unique_ptr<PeerDispatcher> dispatcher;
+    ConnectionId connection;
+    std::vector<DispatcherNotice> notices;
+    uint64_t nonce = 100, admissions = 0;
+    explicit Node(ByteStream &stream, uint64_t identity,
+                  uint32_t reconstruction_limit = 64,
+                  leveldb::Env *env = nullptr)
+        : home(env), network(Network(*runtime, reconstruction_limit)),
+          transport(stream, SessionSettings(network, identity),
+                    TransportSettings()) {
+        manager = std::make_unique<DownloadManager>(DownloadSettings(network),
+                                                    Callbacks());
+        dispatcher = std::make_unique<PeerDispatcher>(
+            *runtime, *manager, DispatcherSettings(network),
+            DispatcherCallbacks{[this](PeerHandle, const ResourceNeed &n) {
+                                    return serving.Reserve(n);
+                                },
+                                [this](uint64_t &out) {
+                                    out = ++nonce;
+                                    return true;
+                                }});
+        Check(dispatcher->Attach(transport, connection) ==
+                  DispatcherResult::Queued,
+              "attach real transport");
+    }
+    DownloadCallbacks Callbacks() {
+        return {
+            [this](const Header &h, uint64_t epoch) {
+                std::string e;
+                Hash id;
+                std::optional<IndexedHeader> indexed;
+                std::optional<Hash> invalid;
+                const auto snap = runtime->Snapshot();
+                if (!snap.chain || snap.reopen_required ||
+                    snap.chain->profile_digest != network.profile_digest ||
+                    epoch != dispatcher->FetchEpoch())
+                    return HeaderDecision{HeaderDisposition::OperationalError,
+                                          {},
+                                          "authority/epoch unavailable"};
+                if (!BlockId(network.chain_id, h, id))
+                    return HeaderDecision{HeaderDisposition::Unsupported,
+                                          {},
+                                          "unencodable header"};
+                if (runtime->ReadHeader(id, indexed, e) !=
+                        DevelopmentRuntimeResult::Progress ||
+                    runtime->ReadInvalidity(id, invalid, e) !=
+                        DevelopmentRuntimeResult::Progress)
+                    return HeaderDecision{
+                        HeaderDisposition::OperationalError, {}, e};
+                if (invalid)
+                    return HeaderDecision{HeaderDisposition::ConsensusInvalid,
+                                          {},
+                                          "excluded by durable invalidity"};
+                if (!indexed)
+                    return HeaderDecision{HeaderDisposition::MissingParent,
+                                          h.prev_id,
+                                          "header not authenticated"};
+                std::array<uint8_t, HEADER_SIZE> a{}, b{};
+                Check(SerializeHeader(h, a) &&
+                          SerializeHeader(indexed->header, b) && a == b,
+                      "exact indexed header binding");
+                return HeaderDecision{HeaderDisposition::Eligible, {}, {}};
+            },
+            [this](PeerHandle, const ResourceNeed &n) {
+                return staging.Reserve(n);
+            },
+            [](const Header &) { return CachedTransactions{{}, 0}; },
+            [this](std::span<const uint8_t> bytes, uint64_t epoch) {
+                ++admissions;
+                const auto snap = runtime->Snapshot();
+                if (!snap.chain || snap.reopen_required ||
+                    epoch != dispatcher->FetchEpoch())
+                    return BodyDecision{BodyDisposition::ContextChanged,
+                                        {},
+                                        "authority/epoch unavailable"};
+                Header h;
+                Hash id;
+                std::string e;
+                std::optional<Hash> invalid;
+                if (!ParseHeader(bytes.data(),
+                                 std::min(bytes.size(), HEADER_SIZE), h) ||
+                    !BlockId(network.chain_id, h, id))
+                    return BodyDecision{BodyDisposition::MalformedBody,
+                                        {},
+                                        "invalid body header"};
+                if (runtime->ReadInvalidity(id, invalid, e) !=
+                    DevelopmentRuntimeResult::Progress)
+                    return BodyDecision{BodyDisposition::StorageError, {}, e};
+                if (invalid)
+                    return BodyDecision{BodyDisposition::ConsensusInvalid,
+                                        {},
+                                        "excluded by durable invalidity"};
+                CandidateBodyStatus out = CandidateBodyStatus::Malformed;
+                const auto r = runtime->RetainBody(
+                    id, Bytes(bytes.begin(), bytes.end()), out, e);
+                if (r == DevelopmentRuntimeResult::Progress &&
+                    (out == CandidateBodyStatus::RetainedAuthenticated ||
+                     out == CandidateBodyStatus::Duplicate))
+                    return BodyDecision{
+                        BodyDisposition::RetainedAuthenticated, {}, {}};
+                if (r == DevelopmentRuntimeResult::CapacityRefused)
+                    return BodyDecision{
+                        BodyDisposition::CapacityRefused, {}, e};
+                if (r == DevelopmentRuntimeResult::MissingHeader)
+                    return BodyDecision{BodyDisposition::MissingParent,
+                                        h.prev_id, e};
+                if (r == DevelopmentRuntimeResult::MalformedBody)
+                    return BodyDecision{BodyDisposition::MalformedBody, {}, e};
+                return BodyDecision{BodyDisposition::StorageError, {}, e};
+            }};
+    }
+    DispatcherUsage Poll(uint64_t ms) {
+        auto u = dispatcher->Tick(ms, UINT64_MAX, 0, DispatcherStep());
+        const auto b = DispatcherStep();
+        Check(u.actions <= b.max_actions &&
+                  u.transport_actions <= b.transport.max_actions &&
+                  u.read_bytes + u.written_bytes <= b.transport.max_io_bytes &&
+                  u.fed_bytes <= b.transport.max_feed_bytes &&
+                  u.runtime_queries <= b.max_runtime_queries &&
+                  u.header_admissions <= b.max_header_admissions &&
+                  u.served_bytes <= b.max_served_bytes,
+              "dispatcher aggregate budgets");
+        while (auto n = dispatcher->TakeNotice())
+            notices.push_back(std::move(*n));
+        return u;
+    }
+    bool Active() const {
+        return transport.State() == SessionState::Active &&
+               bool(dispatcher->Handle(connection));
+    }
+    bool Stable(size_t n) const {
+        const auto s = runtime->Snapshot();
+        return s.chain && s.chain->stable_tip == H(V(n).id) &&
+               !s.chain->pending_journal && !s.chain->pending_receipt &&
+               !s.chain->pending_propagation;
+    }
+};
+struct Pair {
+    Pipe ab, ba;
+    MemoryStream sa{ba, ab}, sb{ab, ba};
+    Node a, b;
+    uint64_t ms = 1;
+    explicit Pair(uint32_t reconstruction_limit = 64,
+                  leveldb::Env *env = nullptr)
+        : a(sa, 41, reconstruction_limit, env), b(sb, 51) {
+        Check(a.dispatcher->Open(a.connection, ms) == DispatcherResult::Queued,
+              "open first connection");
+        Check(b.dispatcher->Open(b.connection, ms) == DispatcherResult::Queued,
+              "open second connection");
+        for (unsigned n = 0; n < 1000 && (!a.Active() || !b.Active()); ++n)
+            Cycle();
+        Check(a.Active() && b.Active(),
+              "actual Session handshake activates both runtimes");
+    }
+    void Cycle() {
+        a.Poll(ms);
+        b.Poll(ms);
+        ++ms;
+    }
+    void Headers() {
+        Check(a.dispatcher->StartHeaders(a.connection, Hash{}, ms) ==
+                  DispatcherResult::Queued,
+              "request header pages");
+    }
+};
+template <typename Link> void Sync(Link &p, DownloadMode mode) {
+    Seed(*p.b.runtime, {0, 1, 4, 5, 6});
+    Match(*p.b.runtime, 6);
+    const auto initial = p.a.runtime->Snapshot();
+    p.Headers();
+    for (unsigned n = 0; n < 2000; ++n) {
+        p.Cycle();
+        std::optional<IndexedHeader> h;
+        std::string e;
+        Check(p.a.runtime->ReadHeader(H(V(6).id), h, e) ==
+                  DevelopmentRuntimeResult::Progress,
+              "client indexed lookup");
+        if (h) break;
+    }
+    std::optional<IndexedHeader> h;
+    std::string e;
+    Check(p.a.runtime->ReadHeader(H(V(6).id), h, e) ==
+                  DevelopmentRuntimeResult::Progress &&
+              h,
+          "multiple header pages reach remote height5");
+    Check(p.a.runtime->Snapshot().chain->stable_tip ==
+              initial.chain->stable_tip,
+          "header pages progress while active tip lags");
+    std::set<Hash> requested;
+    for (unsigned n = 0; n < 3000 && !p.a.Stable(6); ++n) {
+        p.Cycle();
+        auto tick = p.a.runtime->Tick(UINT64_MAX, 0, TickLimits());
+        Check(tick.result != DevelopmentRuntimeResult::StorageError,
+              "client actual runtime Tick: " + tick.diagnostic);
+        if (tick.choices && tick.choices->best_fetch)
+            for (const auto &need : tick.choices->best_fetch->missing)
+                if (!requested.count(need.id)) {
+                    const auto r = p.a.dispatcher->RequestBlock(
+                        p.a.connection, need.header, mode, p.ms);
+                    Check(r == DispatcherResult::Queued ||
+                              r == DispatcherResult::CapacityRefused,
+                          "selected body request result");
+                    if (r == DispatcherResult::Queued)
+                        requested.insert(need.id);
+                    break;
+                }
+    }
+    Check(p.a.Stable(6),
+          "full blocks reach reference checkpoint without reconnect");
+    Match(*p.a.runtime, 6);
+    Check(requested.size() == 5, "all five selected bodies requested");
+    Check(p.a.dispatcher->FetchEpoch() == 1,
+          "ordinary header/body/tip changes preserve fetch epoch");
+    Check(p.a.Active() && p.b.Active(),
+          "one session remains active throughout sync");
+    Check(p.a.manager->Stats().jobs == 0 && p.a.staging.live_bytes == 0 &&
+              p.a.staging.live_slots == 0,
+          "accepted body staging leases released");
+    Check(p.b.serving.live_bytes == 0 && p.b.serving.grants > 0,
+          "separate serving leases released");
+}
