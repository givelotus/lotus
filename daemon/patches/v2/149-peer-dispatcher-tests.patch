+void CompactMissingAndFallback() {
+    {
+        Pair p;
+        Sync(p, DownloadMode::Compact);
+        bool missing = false, retained = false;
+        for (const auto &n : p.a.notices)
+            if (n.download) {
+                missing |=
+                    n.download->result == DownloadResult::NeedTransactions;
+                retained |=
+                    n.download->result == DownloadResult::RetainedAuthenticated;
+                Check(n.download->result != DownloadResult::Accepted,
+                      "download retention never claims chain acceptance");
+            }
+        Check(missing && retained,
+              "real compact body requests missing ordinary transactions before "
+              "authentication");
+        Check(p.a.manager->Stats().tombstones > 0,
+              "compact lifecycle tombstones remain bounded");
+    }
+    {
+        Pair p(1);
+        Sync(p, DownloadMode::Compact);
+        bool fallback = false;
+        for (const auto &n : p.a.notices)
+            if (n.download) fallback |= n.download->fallback.has_value();
+        Check(
+            fallback,
+            "real compact capacity refusal falls back to requested full block");
+    }
+    std::cout
+        << "PASS compact missing transaction exchange and fullbody fallback\n";
+}
