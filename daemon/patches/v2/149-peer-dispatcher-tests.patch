+        << "PASS zero-transport budget application fairness across two peers\n";
+}
+struct TcpPair {
+    TcpListener listener;
+    TcpStream client, server;
+    Node a{client, 81}, b{server, 91};
+    uint64_t ms = 1;
+    std::chrono::steady_clock::time_point start =
+        std::chrono::steady_clock::now();
+    TcpPair() {
+        TcpEndpoint endpoint;
+        Check(ParseNumericEndpoint("127.0.0.1", 0, 0, endpoint),
+              "explicit numeric loopback");
+        Check(listener.Listen(endpoint, {4, false}) &&
+                  listener.BoundEndpoint(endpoint),
+              "ephemeral loopback listener");
+        Check(endpoint.port && endpoint.port != 10604 &&
+                  endpoint.port != 10605 && endpoint.port != 8331,
+              "ephemeral test excludes production ports");
+        const auto status = client.BeginConnect(endpoint, ms, 1000);
+        Check(status == TcpConnectStatus::Connected ||
+                  status == TcpConnectStatus::Pending,
+              "nonblocking TCP connect begins");
+        for (unsigned n = 0;
+             n < 1000 && (!client.IsConnected() || !server.IsConnected());
+             ++n) {
+            const auto connected = client.PollConnect(ms);
+            Check(connected != TcpConnectStatus::Error &&
+                      connected != TcpConnectStatus::TimedOut,
+                  "nonblocking TCP connects");
+            if (!server.IsOpen()) {
+                TcpEndpoint remote;
+                const auto accepted = listener.Accept(server, remote);
+                Check(accepted != TcpAcceptStatus::Error,
+                      "nonblocking TCP accept");
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            UpdateTime();
+        }
+        Check(client.IsConnected() && server.IsConnected(),
+              "two connected TCP streams");
+        Check(a.dispatcher->Open(a.connection, ms) ==
+                      DispatcherResult::Queued &&
+                  b.dispatcher->Open(b.connection, ms) ==
+                      DispatcherResult::Queued,
+              "open TCP transports");
+        for (unsigned n = 0; n < 1000 && (!a.Active() || !b.Active()); ++n)
+            Cycle();
+        Check(a.Active() && b.Active(),
+              "actual TCP Session handshake binds exact fixture profile");
+        listener.Close(); // only this one connection is needed
+    }
+    void UpdateTime() {
+        ms = 1 + uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                              std::chrono::steady_clock::now() - start)
+                              .count());
+    }
+    void Cycle() {
+        UpdateTime();
+        a.Poll(ms);
+        b.Poll(ms);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    void Headers() {
+        Check(a.dispatcher->StartHeaders(a.connection, Hash{}, ms) ==
+                  DispatcherResult::Queued,
+              "TCP header pages requested");
+    }
+};
+void TcpActualSync() {
+    TcpPair pair;
+    Sync(pair, DownloadMode::Full);
+    Check(pair.client.IsConnected() && pair.server.IsConnected(),
+          "TCP connection remains live at exact synced checkpoint");
+    std::cout << "PASS actual ephemeral TCP fullblock sync between two real V4 "
+                 "runtimes\n";
+}
