 }
+
+// Destroys both store objects and opens the same directories again. This is a
+// process restart of the two files, not lotusd and not ConnectTip. The
+// monetary rename is still not atomic with the UTXO snapshot.
+void OrdinaryStoresReopenAfterConnect() {
+    World world;
+    const Hash parent_utxo = world.utxo.Root();
+    const std::array<uint8_t, 56> parent_money =
+        EncodeMonetaryState(world.monetary);
+    const Hash parent_state = world.parent.header.state_root;
+    const Transaction payment = Payment(world.funding.outpoint, 15000);
+    Check(payment.inputs.size() == 1 &&
+              payment.inputs[0].witnesses.size() == 1 &&
+              payment.inputs[0].witnesses[0].script == TRUE_SCRIPT &&
+              TRUE_SCRIPT.size() == 1 && TRUE_SCRIPT[0] == 0x4e,
+          "ordinary payment is not OP_TRUE");
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(payment, profile, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure true payment: " + error);
+    Check(effects.invocation_cost == 18, "true payment invocation cost");
+
+    const std::filesystem::path directory = TempDir();
+    const std::filesystem::path utxo_dir = directory / "utxo";
+    const std::filesystem::path money_dir = directory / "monetary";
+    Hash connected_utxo{};
+    std::array<uint8_t, 56> connected_money{};
+    Hash connected_state{};
+    std::vector<uint8_t> parent_utxo_file;
+    std::vector<uint8_t> parent_money_file;
+    std::vector<uint8_t> connected_utxo_file;
+    std::vector<uint8_t> connected_money_file;
+    size_t utxo_commits = 0;
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "open utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "open monetary: " + error);
+        SeedUtxo(utxo_store, world);
+        SeedMonetary(monetary_store, world);
+        parent_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        parent_money_file = ReadRaw(money_dir / "monetary.dat");
+        const size_t seeded_utxo = DatFiles(utxo_dir / "undo");
+        const size_t seeded_money = DatFiles(money_dir / "monetary-undo");
+        Check(seeded_utxo == 1 && seeded_money == 1,
+              "parent seed is one commit in each store");
+        OrdinaryBlockConnected connected;
+        Check(ConnectOrdinaryBlock({payment}, world.parent, profile, kMonetary,
+                                   world.view, world.utxo, world.monetary,
+                                   connected, error, &utxo_store,
+                                   &monetary_store),
+              "connect true payment: " + error);
+        Check(connected.invocation_cost == 18, "connected invocation cost");
+        Check(connected.utxo_root == world.utxo.Root() &&
+                  connected.utxo_root != parent_utxo,
+              "connected utxo root");
+        Check(connected.monetary_bytes ==
+                      EncodeMonetaryState(world.monetary) &&
+                  connected.monetary_bytes != parent_money,
+              "connected monetary bytes");
+        Check(connected.state_root ==
+                      StateRoot(world.parent.chain_id, profile.candidate_height,
+                                world.utxo.Root(), world.monetary) &&
+                  connected.state_root != parent_state,
+              "connected state root");
+        Check(StoreRoot(utxo_store) == connected.utxo_root &&
+                  StoreMoney(monetary_store) == connected.monetary_bytes &&
+                  StoreState(monetary_store) == connected.state_root,
+              "live stores do not match the connect result");
+        utxo_commits = DatFiles(utxo_dir / "undo") - seeded_utxo;
+        Check(utxo_commits == 1, "the payment was not its own utxo commit");
+        Check(DatFiles(money_dir / "monetary-undo") == seeded_money + 1,
+              "the block was not one monetary commit");
+        connected_utxo = connected.utxo_root;
+        connected_money = connected.monetary_bytes;
+        connected_state = connected.state_root;
+        connected_utxo_file = ReadRaw(utxo_dir / "snapshot.dat");
+        connected_money_file = ReadRaw(money_dir / "monetary.dat");
+        Check(connected_utxo_file != parent_utxo_file &&
+                  connected_money_file != parent_money_file,
+              "connect did not replace both store files");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen monetary: " + error);
+        Check(StoreRoot(utxo_store) == connected_utxo &&
+                  StoreMoney(monetary_store) == connected_money &&
+                  StoreState(monetary_store) == connected_state,
+              "reopened stores do not match the connect result");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == connected_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == connected_money_file,
+              "reopen changed a store file");
+        Check(monetary_store.Undo(error), "undo monetary snapshot: " + error);
+        UndoCount(utxo_store, utxo_commits);
+        Check(StoreRoot(utxo_store) == parent_utxo &&
+                  StoreMoney(monetary_store) == parent_money &&
+                  StoreState(monetary_store) == parent_state,
+              "undone stores are not the parent seed");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "undo did not restore both parent files");
+        Check(DatFiles(utxo_dir / "undo") == 1 &&
+                  DatFiles(money_dir / "monetary-undo") == 1,
+              "block commits were not removed");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(utxo_dir.string(), utxo_store, error),
+              "reopen undone utxo: " + error);
+        Check(PersistentMonetaryStore::Open(money_dir.string(), monetary_store,
+                                            error),
+              "reopen undone monetary: " + error);
+        Check(StoreRoot(utxo_store) == parent_utxo &&
+                  StoreMoney(monetary_store) == parent_money &&
+                  StoreState(monetary_store) == parent_state,
+              "reopened undone stores are not the parent seed");
+        Check(ReadRaw(utxo_dir / "snapshot.dat") == parent_utxo_file &&
+                  ReadRaw(money_dir / "monetary.dat") == parent_money_file,
+              "second reopen changed a parent file");
+    }
+    std::filesystem::remove_all(directory);
+
+    World fresh;
+    const ParentBytes fresh_parent = Capture(fresh);
+    Transaction first = Payment(fresh.funding.outpoint, 15000);
+    first.outputs[0].branches = {BranchLeaf(PUSH_ZERO)};
+    const Outpoint created =
+        OutputOf(first, profile.transaction, fresh.parent.chain_id);
+    const Transaction second = Payment(created, 10000, PUSH_ZERO);
+    Check(second.inputs.size() == 1 &&
+              second.inputs[0].witnesses.size() == 1 &&
+              second.inputs[0].witnesses[0].script ==
+                  std::vector<uint8_t>{0x00} &&
+              first.outputs[0].branches[0] == BranchLeaf(PUSH_ZERO),
+          "failing witness is not 0x00");
+    const std::filesystem::path failed_dir = TempDir();
+    const std::filesystem::path failed_utxo = failed_dir / "utxo";
+    const std::filesystem::path failed_money = failed_dir / "monetary";
+    std::vector<uint8_t> seeded_utxo_file;
+    std::vector<uint8_t> seeded_money_file;
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(failed_utxo.string(), utxo_store,
+                                        error),
+              "open fresh utxo: " + error);
+        Check(PersistentMonetaryStore::Open(failed_money.string(),
+                                            monetary_store, error),
+              "open fresh monetary: " + error);
+        SeedUtxo(utxo_store, fresh);
+        SeedMonetary(monetary_store, fresh);
+        seeded_utxo_file = ReadRaw(failed_utxo / "snapshot.dat");
+        seeded_money_file = ReadRaw(failed_money / "monetary.dat");
+        OrdinaryBlockConnected discarded;
+        Check(!ConnectOrdinaryBlock({first, second}, fresh.parent, profile,
+                                    kMonetary, fresh.view, fresh.utxo,
+                                    fresh.monetary, discarded, error,
+                                    &utxo_store, &monetary_store),
+              "0x00 witness was accepted");
+        Check(error == "witness VM invalid/unsupported: unclean final stack",
+              "0x00 witness rejection: " + error);
+        ExpectParent(fresh, fresh_parent, "0x00 witness");
+        Check(StoreRoot(utxo_store) == fresh_parent.utxo &&
+                  StoreMoney(monetary_store) == fresh_parent.monetary &&
+                  StoreState(monetary_store) == fresh.parent.header.state_root,
+              "0x00 witness moved a live store");
+        Check(ReadRaw(failed_utxo / "snapshot.dat") == seeded_utxo_file &&
+                  ReadRaw(failed_money / "monetary.dat") == seeded_money_file,
+              "0x00 witness changed a store file");
+        Check(DatFiles(failed_utxo / "undo") == 1 &&
+                  DatFiles(failed_money / "monetary-undo") == 1,
+              "0x00 witness left a block commit");
+        Check(!std::filesystem::exists(failed_utxo / "snapshot.dat.tmp") &&
+                  !std::filesystem::exists(failed_money / "monetary.dat.tmp"),
+              "0x00 witness left a temporary file");
+    }
+    {
+        PersistentUtxoStore utxo_store;
+        PersistentMonetaryStore monetary_store;
+        Check(PersistentUtxoStore::Open(failed_utxo.string(), utxo_store,
+                                        error),
+              "reopen fresh utxo: " + error);
+        Check(PersistentMonetaryStore::Open(failed_money.string(),
+                                            monetary_store, error),
+              "reopen fresh monetary: " + error);
+        Check(StoreRoot(utxo_store) == fresh_parent.utxo &&
+                  StoreMoney(monetary_store) == fresh_parent.monetary &&
+                  StoreState(monetary_store) == fresh.parent.header.state_root,
+              "reopened fresh stores are not the parent seed");
+        Check(ReadRaw(failed_utxo / "snapshot.dat") == seeded_utxo_file &&
+                  ReadRaw(failed_money / "monetary.dat") == seeded_money_file,
+              "reopen after 0x00 witness changed a store file");
+    }
+    std::filesystem::remove_all(failed_dir);
+}
 } // namespace
 
 int main() {
@@ -563,7 +771,9 @@ int main() {
         SecondBlockUndoRestoresFirstThenParent();
         FailingWitnessLeavesParentMonetary();
         MonetaryCommitFailureRestoresParent();
+        OrdinaryStoresReopenAfterConnect();
         std::cout << "ordinary block monetary snapshot checks passed\n";
+        std::cout << "ordinary block store reopen checks passed\n";
         return 0;
     } catch (const std::exception &failure) {
         std::cerr << failure.what() << '\n';
