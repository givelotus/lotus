index 0000000000000000000000000000000000000000..5bc92db10114567fe059f50c7206b8c259aa3315
--- /dev/null
+++ b/contrib/logging/conversion/rules/coinstats-v2-diagnostics.json
@@ -0,0 +1,71 @@
+{
