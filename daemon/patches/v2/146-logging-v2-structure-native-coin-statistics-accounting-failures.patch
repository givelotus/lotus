+  "batch": "coinstats-v2-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "v2",
+  "v2_owner": "3c491043cec867e5f00beac01027c9a83023ca5f",
