diff --git a/src/lotus_v2/test_transaction_relay.cpp b/src/lotus_v2/test_transaction_relay.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6d2e5734e53375ac0f54606391aa12954d40084e
--- /dev/null
+++ b/src/lotus_v2/test_transaction_relay.cpp
@@ -0,0 +1,279 @@
+// Copyright (c) 2026 The Lotus developers
+#include "signing.h"
+#include "transaction_relay.h"
+#include <iostream>
+#include <stdexcept>
+using namespace lotus::v2;
+using namespace lotus::v2::peer;
+#define CHECK(x)                                                               \
+    do {                                                                       \
+        if (!(x))                                                              \
+            throw std::runtime_error("line " + std::to_string(__LINE__) +      \
+                                     ": " #x);                                 \
+    } while (false)
+NetworkProfile Profile() {
+    NetworkProfile p{};
+    p.magic = {1, 2, 3, 4};
+    p.chain_id[0] = 21;
+    p.genesis_id[0] = 22;
+    p.profile_digest[0] = 23;
+    p.receive_limit = PRE_HELLO_LIMIT;
+    p.transaction = {32, 32, 8, 8192, 16, 8192, 64};
+    return p;
+}
+Bytes Hex(const std::string &h) {
+    Bytes b;
+    for (size_t i = 0; i < h.size(); i += 2)
+        b.push_back(uint8_t(std::stoul(h.substr(i, 2), nullptr, 16)));
+    return b;
+}
+Bytes Wire() {
+    return Hex("070000000000000000000000010001001111111111111111111111111111111"
+               "11111111111111111111111111111111100000000ffffffff010001014e0001"
+               "016100e80300000000000001a88cef369f758aec3e594eaa4e8d08c9f12ef3f"
+               "11bea972ec53a416a148f0605010100");
+}
+Hash Identity(const Bytes &wire) {
+    Transaction t;
+    IdentityDigests d;
+    std::string e;
+    auto p = Profile();
+    CHECK(DecodeTransaction(wire, p.transaction, t, e));
+    CHECK(ComputeIdentities(t, p.transaction, p.chain_id, d, e));
+    return d.txhash;
+}
+Message Inv(const Hash &h, const std::string &cmd = "inv") {
+    Bytes b;
+    std::string e;
+    Inventory i{1, h};
+    CHECK(EncodeInventory(std::span(&i, 1), PRE_HELLO_LIMIT, b, e));
+    return {cmd, b};
+}
+SessionConfig Config(bool relay) {
+    SessionConfig c;
+    c.network = Profile();
+    c.handshake_timeout_ms = 1000;
+    c.local_version.sender = VersionSender{{}, 42};
+    c.local_version.user_agent = Bytes{};
+    c.local_version.starting_height = 0;
+    c.local_version.relay = true;
+    c.local_version.extra_entropy = 43;
+    if (relay) c.supported_features |= TRANSACTION_RELAY_FEATURE;
+    return c;
+}
+SessionEvent Feed(Session &s, const Message &m, uint64_t now,
+                  bool fragmented = true) {
+    Bytes frame;
+    std::string e;
+    auto p = Profile();
+    if (m.command == "version" || m.command == "v2hello" ||
+        m.command == "verack")
+        CHECK(EncodeHandshakeEnvelope(p, m, frame, e));
+    else
+        CHECK(EncodeEnvelope(p, p.receive_limit, m, frame, e));
+    SessionEvent event;
+    for (size_t i = 0; i < frame.size();) {
+        size_t n = 0;
+        auto count = fragmented ? size_t(1) : frame.size() - i;
+        event = s.Feed(std::span(frame).subspan(i, count), now, n);
+        CHECK(n == count);
+        i += n;
+        if (i < frame.size()) CHECK(event.result == SessionResult::Idle);
+    }
+    return event;
+}
+void Activate(Session &s, bool relay) {
+    CHECK(s.OnOpen(1).result == SessionResult::Send);
+    Bytes b;
+    std::string e;
+    CHECK(EncodeVersion(Config(false).local_version, b, e));
+    CHECK(Feed(s, {"version", b}, 2).result == SessionResult::Send);
+    Hello h;
+    auto p = Profile();
+    h.chain_id = p.chain_id;
+    h.genesis_id = p.genesis_id;
+    h.profile_digest = p.profile_digest;
+    h.receive_limit = p.receive_limit;
+    if (relay) h.supported |= TRANSACTION_RELAY_FEATURE;
+    CHECK(EncodeHello(h, b, e));
+    CHECK(Feed(s, {"v2hello", b}, 3).result == SessionResult::Send);
+    CHECK(Feed(s, {"verack", {}}, 4).result == SessionResult::Activated);
+}
+void Test() {
+    auto p = Profile();
+    RelayLimits l;
+    l.request_timeout_ms = 10;
+    l.retries = 1;
+    auto wire = Wire();
+    auto hash = Identity(wire);
+    size_t calls = 0;
+    RelayAdmission outcome = RelayAdmission::Accepted;
+    std::map<Hash, Bytes> pool;
+    TransactionRelay r(
+        p, l,
+        [&](const Bytes &w) {
+            ++calls;
+            CHECK(w == wire);
+            if (outcome == RelayAdmission::Accepted) pool[hash] = w;
+            return outcome;
+        },
+        [&](const Hash &h, Bytes &w) {
+            auto i = pool.find(h);
+            if (i == pool.end()) return false;
+            w = i->second;
+            return true;
+        });
+    CHECK(r.AddPeer(1, p.receive_limit, true));
+    CHECK(r.AddPeer(2, p.receive_limit, true));
+    CHECK(!r.AddPeer(3, p.receive_limit, false));
+    Session s(Config(true));
+    Activate(s, true);
+    CHECK(s.ActiveFeatures() & TRANSACTION_RELAY_FEATURE);
+    auto event = Feed(s, Inv(hash), 5);
+    CHECK(event.result == SessionResult::Application);
+    auto got = r.Handle(1, *event.application, 5);
+    CHECK(got.actions.size() == 1 &&
+          got.actions[0].message.command == "getdata");
+    CHECK(r.Outstanding() == 1);
+    CHECK(r.Handle(1, Inv(hash), 6).actions.empty());
+    CHECK(r.Handle(2, Inv(hash), 6).actions.empty());
+    got = r.Handle(1, *Feed(s, {"tx", wire}, 7).application, 7);
+    CHECK(calls == 1 && got.admitted == 1);
+    CHECK(r.Outstanding() == 0);
+    CHECK(r.Handle(1, {"tx", wire}, 8).invalid_peer);
+    CHECK(calls == 1);
+    got = r.Handle(2, Inv(hash, "getdata"), 8);
+    CHECK(got.actions.size() == 1 && got.actions[0].message.payload == wire);
+    Session old(Config(false));
+    Activate(old, false);
+    CHECK(Feed(old, {"tx", wire}, 5).result == SessionResult::PeerRejected);
+    Hash missing{};
+    missing[0] = 99;
+    CHECK(r.Handle(1, Inv(missing), 9).actions.size() == 1);
+    CHECK(r.Tick(19).actions.size() == 1);
+    CHECK(r.Tick(29).actions.empty());
+    CHECK(r.Outstanding() == 0);
+    CHECK(r.Handle(1, Inv(missing), 30).actions.size() == 1);
+    got = r.Handle(1, {"tx", wire}, 31);
+    CHECK(got.invalid_peer && calls == 1);
+    r.RemovePeer(1);
+    CHECK(r.Outstanding() == 0);
+    pool.clear();
+    outcome = RelayAdmission::MissingParents;
+    CHECK(r.Handle(2, Inv(hash), 32).actions.size() == 1);
+    got = r.Handle(2, {"tx", wire}, 33);
+    CHECK(got.missing_parents == 1 && r.OrphanCount() == 1);
+    CHECK(r.Tick(42).admitted == 0);
+    outcome = RelayAdmission::Accepted;
+    CHECK(r.Tick(43).admitted == 1 && r.OrphanCount() == 0);
+    CHECK(r.Tick(42).local_refusal);
+    RelayLimits small = l;
+    small.actions_per_call = 1;
+    small.inflight_total = 1;
+    small.orphans = 0;
+    TransactionRelay bounded(
+        p, small, [](const Bytes &) { return RelayAdmission::Capacity; },
+        [](const Hash &, Bytes &) { return false; });
+    CHECK(bounded.AddPeer(1, p.receive_limit, true));
+    CHECK(bounded.AddPeer(2, p.receive_limit, true));
+    CHECK(bounded.Handle(1, Inv(hash), 1).actions.size() == 1);
+    CHECK(bounded.Handle(2, Inv(missing), 1).local_refusal);
+    CHECK(bounded.Outstanding() == 1);
+    CHECK(bounded.Handle(1, {"tx", wire}, 2).local_refusal);
+    CHECK(bounded.Outstanding() == 0);
+    std::vector<Hash> many(l.inventory_per_message + 1, hash);
+    CHECK(bounded.AnnounceMany(many, 3).local_refusal);
+    CHECK(bounded.Handle(1, Inv(hash), 4).actions.size() == 1);
+    Bytes bad = wire;
+    bad.push_back(0);
+    CHECK(bounded.Handle(1, {"tx", bad}, 5).invalid_peer);
+}
+#ifdef LOTUS_RELAY_POOL_TEST
+#include "transaction_pool_test/fixtures.h"
+void PoolIntegration() {
+    pool_fixture::Fixture f;
+    auto context = f.Context();
+    TransactionPool pool(PoolLimits{});
+    auto profile = Profile();
+    profile.chain_id = {};
+    profile.transaction = pool_fixture::Profile().transaction;
+    RelayLimits limits;
+    limits.request_timeout_ms = 10;
+    auto parent =
+        pool_fixture::Spend({f.funding}, {pool_fixture::Native(90000)});
+    auto child = pool_fixture::Spend({Outpoint{pool_fixture::Id(parent), 0}},
+                                     {pool_fixture::Native(80000)});
+    auto parent_wire = pool_fixture::Wire(parent),
+         child_wire = pool_fixture::Wire(child);
+    auto hash = [&](const Transaction &t) {
+        IdentityDigests i;
+        std::string e;
+        CHECK(ComputeIdentities(t, profile.transaction, {}, i, e));
+        return i.txhash;
+    };
+    auto parent_hash = hash(parent), child_hash = hash(child);
+    size_t calls = 0;
+    TransactionRelay relay(
+        profile, limits,
+        [&](const Bytes &w) {
+            ++calls;
+            PoolBudget budget{100, 10000000};
+            auto result = pool.Admit(w, context, budget);
+            switch (result.status) {
+                case PoolStatus::Accepted:
+                    return RelayAdmission::Accepted;
+                case PoolStatus::Duplicate:
+                    return RelayAdmission::Duplicate;
+                case PoolStatus::Conflict:
+                    return RelayAdmission::Conflict;
+                case PoolStatus::MissingParents:
+                    return RelayAdmission::MissingParents;
+                case PoolStatus::Invalid:
+                    return RelayAdmission::Invalid;
+                case PoolStatus::Capacity:
+                    return RelayAdmission::Capacity;
+                case PoolStatus::Stale:
+                    return RelayAdmission::Stale;
+                case PoolStatus::Operational:
+                    return RelayAdmission::Operational;
+            }
+            throw std::runtime_error("pool status");
+        },
+        [&](const Hash &h, Bytes &w) { return pool.ReadWire(h, w); });
+    CHECK(relay.AddPeer(1, profile.receive_limit, true));
+    CHECK(relay.AddPeer(2, profile.receive_limit, true));
+    auto invalid = parent;
+    invalid.inputs[0].witnesses[0].script = {0};
+    auto invalid_hash = hash(invalid);
+    CHECK(relay.Handle(1, Inv(invalid_hash), 0).actions.size() == 1);
+    CHECK(relay.Handle(1, {"tx", pool_fixture::Wire(invalid)}, 0).invalid_peer);
+    CHECK(calls == 1);
+    calls = 0;
+
+    CHECK(relay.Handle(1, Inv(child_hash), 1).actions.size() == 1);
+    CHECK(relay.Handle(1, {"tx", child_wire}, 2).missing_parents == 1);
+    CHECK(relay.OrphanCount() == 1);
+    CHECK(relay.Handle(1, Inv(parent_hash), 3).actions.size() == 1);
+    auto accepted = relay.Handle(1, {"tx", parent_wire}, 4);
+    CHECK(accepted.admitted == 2 && relay.OrphanCount() == 0 && calls == 3);
+    Bytes fetched;
+    CHECK(pool.ReadWire(parent_hash, fetched) && fetched == parent_wire);
+    CHECK(pool.ReadWire(child_hash, fetched) && fetched == child_wire);
+    CHECK(relay.Handle(2, Inv(child_hash, "getdata"), 5)
+              .actions[0]
+              .message.payload == child_wire);
+}
+#endif
+int main() {
+    try {
+        Test();
+#ifdef LOTUS_RELAY_POOL_TEST
+        PoolIntegration();
+#endif
+        std::cout << "transaction relay checks passed\n";
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/transaction_relay.cpp b/src/lotus_v2/transaction_relay.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..833170faf0682e417975a48320cfd48a7f9b8faf
--- /dev/null
+++ b/src/lotus_v2/transaction_relay.cpp
@@ -0,0 +1,319 @@
+// Copyright (c) 2026 The Lotus developers
+#include "transaction_relay.h"
+#include "signing.h"
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+namespace lotus::v2::peer {
+namespace {
+    uint64_t Deadline(uint64_t n, uint64_t d) {
+        return d > UINT64_MAX - n ? UINT64_MAX : n + d;
+    }
+} // namespace
+TransactionRelay::TransactionRelay(NetworkProfile p, RelayLimits l, Admit a,
+                                   Read r)
+    : profile_(std::move(p)), limits_(l), admit_(std::move(a)),
+      read_(std::move(r)) {
+    if (!admit_) throw std::invalid_argument("relay admission callback");
+    if (!read_ || !l.peers || !l.known_per_peer || !l.inflight_per_peer ||
+        !l.inflight_total || !l.inventory_per_message || !l.actions_per_call ||
+        !l.action_bytes_per_call || !l.transaction_bytes ||
+        !l.validations_per_call || !l.request_timeout_ms || !l.orphan_expiry_ms)
+        throw std::invalid_argument("relay limits/callback");
+}
+RelayAdmission TransactionRelay::AdmitWire(const Bytes &wire) {
+    try {
+        return admit_(wire);
+    } catch (...) {
+        return RelayAdmission::Operational;
+    }
+}
+bool TransactionRelay::ReadWire(const Hash &hash, Bytes &wire, RelayResult &r) {
+    try {
+        return read_(hash, wire);
+    } catch (...) {
+        r.local_refusal = true;
+        r.reason = "pool read operational failure";
+        return false;
+    }
+}
+bool TransactionRelay::AddPeer(RelayPeer id, uint32_t limit, bool authorized) {
+    if (!authorized || !limit || limit > profile_.receive_limit ||
+        peers_.size() >= limits_.peers)
+        return false;
+    return peers_.emplace(id, Peer{limit, {}, {}}).second;
+}
+void TransactionRelay::RemovePeer(RelayPeer id) {
+    peers_.erase(id);
+}
+size_t TransactionRelay::Outstanding() const {
+    size_t n = 0;
+    for (const auto &[id, p] : peers_) {
+        (void)id;
+        n += p.requests.size();
+    }
+    return n;
+}
+bool TransactionRelay::Time(uint64_t now, RelayResult &r) {
+    if (now < last_ms_) {
+        r.local_refusal = true;
+        r.reason = "backward monotonic time";
+        return false;
+    }
+    last_ms_ = now;
+    return true;
+}
+bool TransactionRelay::Send(RelayPeer id, Message m, RelayResult &r) {
+    auto p = peers_.find(id);
+    if (p == peers_.end()) return false;
+    size_t bytes = 24 + m.payload.size();
+    for (const auto &a : r.actions)
+        bytes += 24 + a.message.payload.size();
+    if (m.payload.size() > p->second.limit ||
+        r.actions.size() >= limits_.actions_per_call ||
+        bytes > limits_.action_bytes_per_call) {
+        r.local_refusal = true;
+        return false;
+    }
+    r.actions.push_back({id, std::move(m)});
+    return true;
+}
+void TransactionRelay::Remember(Peer &p, const Hash &h) {
+    if (p.known.size() >= limits_.known_per_peer && !p.known.contains(h))
+        p.known.erase(p.known.begin());
+    p.known.insert(h);
+}
+void TransactionRelay::Announce(const Hash &h, RelayResult &r) {
+    for (auto &[id, p] : peers_) {
+        if (p.known.contains(h)) continue;
+        Bytes b;
+        std::string e;
+        Inventory i{1, h};
+        if (EncodeInventory(std::span(&i, 1), p.limit, b, e) &&
+            Send(id, {"inv", std::move(b)}, r))
+            Remember(p, h);
+    }
+}
+RelayResult TransactionRelay::AnnounceMany(std::span<const Hash> hashes,
+                                           uint64_t now) {
+    RelayResult r;
+    if (!Time(now, r)) return r;
+    if (hashes.size() > limits_.inventory_per_message) {
+        r.local_refusal = true;
+        r.reason = "inventory page limit";
+        return r;
+    }
+    for (const auto &h : hashes)
+        Announce(h, r);
+    return r;
+}
+RelayResult TransactionRelay::Handle(RelayPeer id, const Message &m,
+                                     uint64_t now) {
+    RelayResult r;
+    if (!Time(now, r)) return r;
+    auto it = peers_.find(id);
+    if (it == peers_.end()) {
+        r.local_refusal = true;
+        return r;
+    }
+    Peer &p = it->second;
+    std::string e;
+    if (m.payload.size() > p.limit) {
+        r.invalid_peer = true;
+        r.reason = "negotiated message limit";
+        return r;
+    }
+    if (m.command == "inv" || m.command == "getdata" ||
+        m.command == "notfound") {
+        std::vector<Inventory> inv;
+        // Bound allocation BEFORE generic inventory decoder.
+        if (m.payload.size() > 9 + 36 * limits_.inventory_per_message) {
+            r.local_refusal = true;
+            return r;
+        }
+        if (!DecodeInventory(m.payload, p.limit, inv, e)) {
+            r.invalid_peer = true;
+            r.reason = e;
+            return r;
+        }
+        if (inv.size() > limits_.inventory_per_message) {
+            r.local_refusal = true;
+            return r;
+        }
+        size_t reads = 0;
+        for (const auto &i : inv) {
+            if (i.type != 1) continue;
+            if (m.command == "notfound") {
+                p.requests.erase(i.hash);
+                continue;
+            }
+            if (m.command == "inv") {
+                Remember(p, i.hash);
+                if (p.requests.contains(i.hash) || orphans_.contains(i.hash))
+                    continue;
+                bool requested = false;
+                for (const auto &[pid, other] : peers_) {
+                    (void)pid;
+                    if (other.requests.contains(i.hash)) {
+                        requested = true;
+                        break;
+                    }
+                }
+                if (requested) continue;
+                if (reads++ >= limits_.validations_per_call) {
+                    r.local_refusal = true;
+                    break;
+                }
+                Bytes have;
+                if (ReadWire(i.hash, have, r)) continue;
+                if (r.local_refusal) break;
+                if (p.requests.size() >= limits_.inflight_per_peer ||
+                    Outstanding() >= limits_.inflight_total) {
+                    r.local_refusal = true;
+                    continue;
+                }
+                Bytes b;
+                if (EncodeInventory(std::span(&i, 1), p.limit, b, e) &&
+                    Send(id, {"getdata", std::move(b)}, r))
+                    p.requests.emplace(
+                        i.hash,
+                        Request{Deadline(now, limits_.request_timeout_ms), 0});
+            } else {
+                if (reads++ >= limits_.validations_per_call) {
+                    r.local_refusal = true;
+                    break;
+                }
+                Bytes wire;
+                if (ReadWire(i.hash, wire, r)) {
+                    if (wire.size() > limits_.transaction_bytes) {
+                        r.local_refusal = true;
+                        continue;
+                    }
+                    if (Send(id, {"tx", std::move(wire)}, r))
+                        Remember(p, i.hash);
+                } else if (!r.local_refusal) {
+                    Bytes b;
+                    if (EncodeInventory(std::span(&i, 1), p.limit, b, e))
+                        Send(id, {"notfound", std::move(b)}, r);
+                }
+            }
+        }
+        return r;
+    }
+    if (m.command != "tx") return r;
+    if (p.requests.empty()) {
+        r.invalid_peer = true;
+        r.reason = "unsolicited transaction";
+        return r;
+    }
+    if (m.payload.size() > limits_.transaction_bytes) {
+        r.local_refusal = true;
+        return r;
+    }
+    Transaction tx;
+    Bytes canonical;
+    IdentityDigests identities;
+    if (!DecodeTransaction(m.payload, profile_.transaction, tx, e) ||
+        !EncodeTransaction(tx, profile_.transaction, canonical, e) ||
+        canonical != m.payload ||
+        !ComputeIdentities(tx, profile_.transaction, profile_.chain_id,
+                           identities, e)) {
+        r.invalid_peer = true;
+        r.reason = "noncanonical transaction";
+        return r;
+    }
+    auto request = p.requests.find(identities.txhash);
+    if (request == p.requests.end()) {
+        r.invalid_peer = true;
+        r.reason = "transaction does not match outstanding TxHash";
+        return r;
+    }
+    p.requests.erase(request);
+    Remember(p, identities.txhash);
+    RelayAdmission status = AdmitWire(canonical);
+    if (status == RelayAdmission::Accepted) {
+        ++r.admitted;
+        Announce(identities.txhash, r);
+    } else if (status == RelayAdmission::Invalid) {
+        r.invalid_peer = true;
+        r.reason = "invalid transaction";
+    } else if (status == RelayAdmission::MissingParents) {
+        ++r.missing_parents;
+        if (orphans_.size() < limits_.orphans &&
+            canonical.size() <= limits_.orphan_bytes - orphan_bytes_) {
+            orphan_bytes_ += canonical.size();
+            orphans_.emplace(identities.txhash,
+                             Orphan{std::move(canonical),
+                                    Deadline(now, limits_.orphan_expiry_ms),
+                                    Deadline(now, limits_.request_timeout_ms),
+                                    0});
+        } else
+            r.local_refusal = true;
+    } else if (status != RelayAdmission::Duplicate &&
+               status != RelayAdmission::Conflict)
+        r.local_refusal = true;
+    // Accepted parent triggers retries; total admissions in this call stay
+    // bounded.
+    size_t budget = limits_.validations_per_call - 1;
+    if (status == RelayAdmission::Accepted) Retry(now, r, budget);
+    return r;
+}
+void TransactionRelay::Retry(uint64_t now, RelayResult &r, size_t &budget) {
+    for (auto it = orphans_.begin(); it != orphans_.end();) {
+        auto &o = it->second;
+        if (now >= o.expiry || o.attempts >= limits_.retries) {
+            orphan_bytes_ -= o.wire.size();
+            it = orphans_.erase(it);
+            continue;
+        }
+        if (!budget || (now < o.retry && !r.admitted)) {
+            ++it;
+            continue;
+        }
+        --budget;
+        ++o.attempts;
+        auto status = AdmitWire(o.wire);
+        o.retry = Deadline(now, limits_.request_timeout_ms);
+        if (status == RelayAdmission::MissingParents ||
+            status == RelayAdmission::Capacity ||
+            status == RelayAdmission::Stale ||
+            status == RelayAdmission::Operational) {
+            ++it;
+            continue;
+        }
+        if (status == RelayAdmission::Accepted) {
+            ++r.admitted;
+            Announce(it->first, r);
+        }
+        orphan_bytes_ -= o.wire.size();
+        it = orphans_.erase(it);
+    }
+}
+RelayResult TransactionRelay::Tick(uint64_t now) {
+    RelayResult r;
+    if (!Time(now, r)) return r;
+    for (auto &[id, p] : peers_)
+        for (auto it = p.requests.begin(); it != p.requests.end();) {
+            if (now < it->second.deadline) {
+                ++it;
+                continue;
+            }
+            if (it->second.attempts >= limits_.retries) {
+                it = p.requests.erase(it);
+                continue;
+            }
+            Bytes b;
+            std::string e;
+            Inventory inv{1, it->first};
+            if (EncodeInventory(std::span(&inv, 1), p.limit, b, e) &&
+                Send(id, {"getdata", std::move(b)}, r)) {
+                ++it->second.attempts;
+                it->second.deadline = Deadline(now, limits_.request_timeout_ms);
+            }
+            ++it;
+        }
+    size_t budget = limits_.validations_per_call;
+    Retry(now, r, budget);
+    return r;
+}
+} // namespace lotus::v2::peer
