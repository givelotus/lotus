+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_TRANSACTION_RELAY_H
+#define LOTUS_V2_TRANSACTION_RELAY_H
+#include "peer_session.h"
+#include <deque>
+#include <set>
+namespace lotus::v2::peer {
+using RelayPeer = uint64_t;
+enum class RelayAdmission {
+    Accepted,
+    Duplicate,
+    Conflict,
+    MissingParents,
+    Invalid,
+    Capacity,
+    Stale,
+    Operational
+};
+struct RelayLimits {
+    size_t peers = 16, known_per_peer = 1024, inflight_per_peer = 16;
+    size_t inflight_total = 128, inventory_per_message = 128;
+    size_t actions_per_call = 32, action_bytes_per_call = 1024 * 1024;
+    size_t transaction_bytes = 256 * 1024, validations_per_call = 8;
+    size_t orphans = 32, orphan_bytes = 1024 * 1024;
+    uint64_t request_timeout_ms = 5000, orphan_expiry_ms = 30000;
+    uint32_t retries = 2;
+};
+struct RelayAction {
+    RelayPeer peer;
+    Message message;
+};
+struct RelayResult {
+    std::vector<RelayAction> actions;
+    bool invalid_peer = false, local_refusal = false;
+    size_t admitted = 0, missing_parents = 0;
+    std::string reason;
+};
+// Serialized caller ownership. Every returned action MUST be staged atomically
+// into bounded transport output, or caller MUST RemovePeer(action.peer).
+// Admission callback is synchronous and owns the authoritative context/budget.
+class TransactionRelay {
+public:
+    using Admit = std::function<RelayAdmission(const Bytes &)>;
+    using Read = std::function<bool(const Hash &, Bytes &)>;
+    TransactionRelay(NetworkProfile, RelayLimits, Admit, Read);
+    bool AddPeer(RelayPeer, uint32_t active_limit, bool authorized);
+    void RemovePeer(RelayPeer);
+    RelayResult Handle(RelayPeer, const Message &, uint64_t now_ms);
+    RelayResult Tick(uint64_t now_ms);
+    // Parent-before-child pool inventory, bounded by inventory_per_message.
+    RelayResult AnnounceMany(std::span<const Hash>, uint64_t now_ms);
+    size_t Outstanding() const;
+    size_t OrphanCount() const { return orphans_.size(); }
+
+private:
+    struct Request {
+        uint64_t deadline;
+        uint32_t attempts;
+    };
+    struct Peer {
+        uint32_t limit;
+        std::set<Hash> known;
+        std::map<Hash, Request> requests;
+    };
+    struct Orphan {
+        Bytes wire;
+        uint64_t expiry, retry;
+        uint32_t attempts;
+    };
+    NetworkProfile profile_;
+    RelayLimits limits_;
+    Admit admit_;
+    Read read_;
+    std::map<RelayPeer, Peer> peers_;
+    std::map<Hash, Orphan> orphans_;
+    size_t orphan_bytes_ = 0;
+    uint64_t last_ms_ = 0;
+    bool Time(uint64_t, RelayResult &);
+    bool Send(RelayPeer, Message, RelayResult &);
+    void Remember(Peer &, const Hash &);
+    void Announce(const Hash &, RelayResult &);
+    void Retry(uint64_t, RelayResult &, size_t &);
+    RelayAdmission AdmitWire(const Bytes &);
+    bool ReadWire(const Hash &, Bytes &, RelayResult &);
+};
+} // namespace lotus::v2::peer
+#endif
