From 1102778d6dd819aefd2e9642a5788923bb86c3aa Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 22:59:15 -0700
Subject: [PATCH] Search at most 256 local V2 header nonces

SearchNonce tries a caller-supplied start nonce and stops at the first
header whose block id meets the target. More than 256 attempts fails
before hashing and leaves the header unchanged. A miss does too. The
search does not open a socket or submit a found header.
---
 src/lotus_v2/block_template.cpp      | 18 ++++++++
 src/lotus_v2/block_template.h        | 15 ++++++-
 src/lotus_v2/test_block_template.cpp | 67 +++++++++++++++++++++++-----
 3 files changed, 87 insertions(+), 13 deletions(-)

diff --git a/src/lotus_v2/block_template.cpp b/src/lotus_v2/block_template.cpp
index 56def9532..f30917d73 100644
--- a/src/lotus_v2/block_template.cpp
+++ b/src/lotus_v2/block_template.cpp
@@ -40,4 +40,22 @@ std::optional<Header> BuildChildHeader(const Header &parent, const ChainId &chai
     return child;
 }
 
+bool SearchNonce(Header &header, const ChainId &chain_id, const Hash &target,
+                 uint64_t start_nonce, uint64_t max_attempts) {
+    if (max_attempts > MAX_NONCE_ATTEMPTS) return false;
+
+    for (uint64_t attempt = 0; attempt < max_attempts; ++attempt) {
+        if (attempt > std::numeric_limits<uint64_t>::max() - start_nonce) return false;
+        Header candidate = header;
+        candidate.nonce = start_nonce + attempt;
+        Hash block_id{};
+        if (!BlockId(chain_id, candidate, block_id)) return false;
+        if (MeetsTarget(block_id, target)) {
+            header = candidate;
+            return true;
+        }
+    }
+    return false;
+}
+
 } // namespace lotus::v2
diff --git a/src/lotus_v2/block_template.h b/src/lotus_v2/block_template.h
index 9f8e747b4..ed506f2de 100644
--- a/src/lotus_v2/block_template.h
+++ b/src/lotus_v2/block_template.h
@@ -1,5 +1,6 @@
 // Copyright (c) 2026 The Lotus developers
-// Local child-header template. No socket, daemon, pool, or nonce search.
+// Local child-header template and bounded nonce search.
+// No socket, daemon, pool, or network submission.
 #ifndef LOTUS_V2_BLOCK_TEMPLATE_H
 #define LOTUS_V2_BLOCK_TEMPLATE_H
 
@@ -22,5 +23,17 @@ std::optional<Header> BuildChildHeader(const Header &parent, const ChainId &chai
                                        const Hash &tx_root, const Hash &state_root,
                                        uint64_t time, uint64_t size, uint32_t bits);
 
+// Inclusive cap for one local SearchNonce call. A larger request fails
+// before any hash and does not modify the caller's header.
+constexpr uint64_t MAX_NONCE_ATTEMPTS = 256;
+
+// Local search only. Tries start_nonce and then the following nonces, at
+// most max_attempts, and does not wrap. Returns true and writes the first
+// header whose BlockId meets target. Returns false, leaving header
+// unchanged, when max_attempts exceeds MAX_NONCE_ATTEMPTS, the block id
+// cannot be computed, or no attempt meets target.
+bool SearchNonce(Header &header, const ChainId &chain_id, const Hash &target,
+                 uint64_t start_nonce, uint64_t max_attempts);
+
 } // namespace lotus::v2
 #endif
diff --git a/src/lotus_v2/test_block_template.cpp b/src/lotus_v2/test_block_template.cpp
index 4529e2025..cdfe52bff 100644
--- a/src/lotus_v2/test_block_template.cpp
+++ b/src/lotus_v2/test_block_template.cpp
@@ -52,6 +52,25 @@ Hash Ceiling() {
     ceiling.fill(0xff);
     return ceiling;
 }
+
+bool SameHeader(const Header &left, const Header &right) {
+    return left.prev_id == right.prev_id && left.bits == right.bits && left.time == right.time &&
+           left.nonce == right.nonce && left.version == right.version && left.size == right.size &&
+           left.height == right.height && left.tx_root == right.tx_root &&
+           left.state_root == right.state_root;
+}
+
+bool SubtractOne(Hash &value) {
+    for (uint8_t &byte : value) {
+        if (byte == 0) {
+            byte = 0xff;
+            continue;
+        }
+        --byte;
+        return true;
+    }
+    return false;
+}
 } // namespace
 
 int main() {
@@ -112,22 +131,46 @@ int main() {
 
     Hash target{};
     Check(DecodeTarget(bits, Ceiling(), target), "decode the easy target");
-    // Local unit check only: a few nonce increments, no socket and no miner.
-    bool meets = false;
-    uint64_t tried = 0;
-    for (uint64_t nonce = 0; nonce < 8; ++nonce) {
+    // Local searches only. No call below tries more than 256 nonces.
+    Header easy = *child;
+    Check(SearchNonce(easy, chain_id, target, 0, 8), "easy target found within 8 attempts");
+    Hash found_id{};
+    Check(BlockId(chain_id, easy, found_id) && MeetsTarget(found_id, target),
+          "found header meets target");
+    Check(easy.nonce < 8, "winning nonce is inside the attempt window");
+    Check(easy.prev_id == child->prev_id && easy.bits == child->bits && easy.time == child->time &&
+              easy.version == child->version && easy.size == child->size &&
+              easy.height == child->height && easy.tx_root == child->tx_root &&
+              easy.state_root == child->state_root,
+          "search changes only the nonce");
+    Check(child->nonce == 0, "the template nonce stays zero");
+
+    Header at_cap = *child;
+    Check(SearchNonce(at_cap, chain_id, target, easy.nonce, MAX_NONCE_ATTEMPTS),
+          "256 attempts are allowed");
+    Check(at_cap.nonce == easy.nonce, "known nonce is accepted at the attempt cap");
+
+    Header refused = *child;
+    refused.nonce = 77;
+    const Header refused_before = refused;
+    Check(!SearchNonce(refused, chain_id, target, 3, 257), "257 attempts are refused");
+    Check(SameHeader(refused, refused_before), "refused search leaves the header unchanged");
+
+    Hash lowest{};
+    lowest.fill(0xff);
+    for (uint64_t nonce = 0; nonce < 4; ++nonce) {
         Header candidate = *child;
         candidate.nonce = nonce;
         Hash block_id{};
-        Check(BlockId(chain_id, candidate, block_id), "child block id");
-        ++tried;
-        if (MeetsTarget(block_id, target)) {
-            meets = true;
-            break;
-        }
+        Check(BlockId(chain_id, candidate, block_id), "hard-target candidate id");
+        if (MeetsTarget(block_id, lowest)) lowest = block_id;
     }
-    Check(meets && tried <= 8, "easy target met within a few local nonces");
-    Check(child->nonce == 0, "the template nonce stays zero");
+    Check(SubtractOne(lowest), "candidate block ids are not zero");
+    Header missed = *child;
+    missed.nonce = 55;
+    const Header missed_before = missed;
+    Check(!SearchNonce(missed, chain_id, lowest, 0, 4), "hard target misses within 4 attempts");
+    Check(SameHeader(missed, missed_before), "a miss leaves the header unchanged");
 
     const Hash body = BodyHash(chain_id, *child);
     Hash work{};
-- 
