+    /**
+     * Access the progressive Merklix overlay manager (Subtree A + UTXO SMT
+     * overlay + non-coinbase effective block cost accumulator).
+     */
+    lotus::v2::MerklixOverlayManager &GetMerklixOverlay() const
+        EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        AssertLockHeld(cs);
+        return m_merklix_overlay;
+    }
+
+    /**
+     * Freeze the current speculative mempool overlay as an immutable epoch
+     * batch snapshot and advance the epoch counter.
+     */
+    const lotus::v2::MempoolOverlayLayer &FreezeEpochBatch()
+        EXCLUSIVE_LOCKS_REQUIRED(cs);
+
+    /**
+     * Ensure the Merklix overlay is anchored at the given tip block snapshot,
+     * next block height, and parent MTP. O(1) no-op if already anchored.
+     */
+    void SyncMerklixOverlayToTip(const BlockHash &tip_hash,
+                                 uint64_t next_height,
+                                 uint64_t next_mtp) const
+        EXCLUSIVE_LOCKS_REQUIRED(cs);
+
+    /**
+     * Reset or re-anchor the Merklix overlay after a block connects or
+     * disconnects so subsequent mempool arrivals build directly on the new tip.
+     */
+    void ConnectBlockReset(const BlockHash &new_tip_hash,
+                           uint64_t next_height,
+                           uint64_t next_mtp)
+        EXCLUSIVE_LOCKS_REQUIRED(cs);
+
 private:
+    mutable lotus::v2::MerklixOverlayManager m_merklix_overlay GUARDED_BY(cs);
+
     /** Set ancestor state for an entry */
     void UpdateEntryForAncestors(txiter it, const setEntries *setAncestors)
         EXCLUSIVE_LOCKS_REQUIRED(cs);
