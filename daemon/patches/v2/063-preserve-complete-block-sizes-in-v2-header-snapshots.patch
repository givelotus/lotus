From 02fa66788b3acd586320d7c1bc37c1575be8ed6a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:27:14 -0700
Subject: [PATCH] Preserve complete block sizes in V2 header snapshots

The stored header remains 134 bytes but its size field describes the complete block. Retain compatibility with header-only fixtures and reject sizes shorter than the header. The existing commit/reopen/undo suite now uses a 4096-byte block size and fails before this repair; it passes afterward.
---
 src/lotus_v2/persistent_header.cpp            |  4 ++--
 src/lotus_v2/persistent_header.h              |  7 ++++--
 .../persistent_header_test/CMakeLists.txt     | 22 +++++++++++++++++++
 src/lotus_v2/test_persistent_header.cpp       |  6 ++---
 4 files changed, 32 insertions(+), 7 deletions(-)
 create mode 100644 src/lotus_v2/persistent_header_test/CMakeLists.txt

diff --git a/src/lotus_v2/persistent_header.cpp b/src/lotus_v2/persistent_header.cpp
index 3c825513a5fb760e33ff3880eb2d9cc87a6121d4..1c0cff1a78cfb6c0898f340b7366554a78cff3af 100644
--- a/src/lotus_v2/persistent_header.cpp
+++ b/src/lotus_v2/persistent_header.cpp
@@ -103,7 +103,7 @@ bool DecodeHeaderBytes(const uint8_t *data, size_t size, Header &out, std::strin
     if (data == nullptr || size != HEADER_SIZE) return Fail(error, "truncated");
     Header parsed;
     if (!ParseHeader(data, size, parsed)) return Fail(error, "truncated");
-    if (parsed.size != HEADER_SIZE) return Fail(error, "header");
+    if (parsed.size < HEADER_SIZE) return Fail(error, "header");
     std::array<uint8_t, HEADER_SIZE> again{};
     if (!SerializeHeader(parsed, again) ||
         !std::equal(again.begin(), again.end(), data))
@@ -461,7 +461,7 @@ bool PersistentHeaderStore::Impl::Load(const std::string &dir, std::string &erro
 bool PersistentHeaderStore::Impl::Commit(const ChainId &chain_id, uint64_t height,
                                          const Header &header, std::string &error) {
     if (undo_tip >= 99999999u) return Fail(error, "undo chain");
-    if (header.size != HEADER_SIZE) return Fail(error, "header");
+    if (header.size < HEADER_SIZE) return Fail(error, "header");
     std::array<uint8_t, HEADER_SIZE> serialized{};
     if (!SerializeHeader(header, serialized)) return Fail(error, "header");
     Header parsed;
diff --git a/src/lotus_v2/persistent_header.h b/src/lotus_v2/persistent_header.h
index 92cdf5d234577ad3566567a093eb45b1a9e6e9c2..15d5c1d7811745f302c6e7417933b14b0d8c00b6 100644
--- a/src/lotus_v2/persistent_header.h
+++ b/src/lotus_v2/persistent_header.h
@@ -28,8 +28,11 @@
 // Snapshot payload, 206 bytes:
 //   chain_id[32] | height u64 | header[134] | header_id[32]
 // header[134] is SerializeHeader. A buffer that is not 134 bytes is rejected,
-// as is a header whose size field is not 134. header_id is BlockId(chain_id,
-// header), the existing header id. No new header-id domain is defined.
+// as is a header whose block-size field is smaller than 134. The size field
+// commits to the complete block length; it does not measure header encoding.
+// Header-only historical fixtures remain storable. This store does not verify
+// the body or its length. header_id is BlockId(chain_id, header), the existing
+// header id. No new header-id domain is defined.
 // The chain starts at 206 zero bytes, which is not a header and is not written
 // as header.dat. The first undo stores that predecessor.
 #ifndef LOTUS_V2_PERSISTENT_HEADER_H
diff --git a/src/lotus_v2/persistent_header_test/CMakeLists.txt b/src/lotus_v2/persistent_header_test/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..eb1d5daf719f0a33186006e849b1db26125e8667
--- /dev/null
+++ b/src/lotus_v2/persistent_header_test/CMakeLists.txt
@@ -0,0 +1,22 @@
+cmake_minimum_required(VERSION 3.18)
+project(lotus_v2_persistent_header_review LANGUAGES C CXX)
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+find_path(LOTUS_BOOST_INCLUDE boost/multiprecision/cpp_int.hpp
+    PATHS /opt/homebrew/opt/boost/include REQUIRED)
+add_library(blake3 STATIC
+    ../vendor/blake3/blake3.c
+    ../vendor/blake3/blake3_dispatch.c
+    ../vendor/blake3/blake3_portable.c)
+target_compile_definitions(blake3 PRIVATE
+    BLAKE3_NO_SSE2 BLAKE3_NO_SSE41 BLAKE3_NO_AVX2 BLAKE3_NO_AVX512
+    BLAKE3_USE_NEON=0)
+add_executable(persistent_header_test
+    ../header.cpp ../tagged_hash.cpp ../commitment.cpp ../output.cpp
+    ../sparse_state.cpp ../transaction.cpp ../monetary.cpp ../dev_genesis.cpp
+    ../persistent_header.cpp ../test_persistent_header.cpp)
+target_include_directories(persistent_header_test SYSTEM PRIVATE "${LOTUS_BOOST_INCLUDE}")
+target_link_libraries(persistent_header_test PRIVATE blake3)
+target_compile_options(persistent_header_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
+enable_testing()
+add_test(NAME persistent_header_test COMMAND persistent_header_test)
diff --git a/src/lotus_v2/test_persistent_header.cpp b/src/lotus_v2/test_persistent_header.cpp
index b48a8417939b38b8f686938e29001937f959bd9e..9712da1ebbaf7585ac610ff7c5ad25447ac67d5e 100644
--- a/src/lotus_v2/test_persistent_header.cpp
+++ b/src/lotus_v2/test_persistent_header.cpp
@@ -203,7 +203,7 @@ Header SecondHeader(const Header &first) {
     header.nonce = 0;
     header.time = first.time + 1;
     header.state_root[0] ^= 0x5a;
-    header.size = HEADER_SIZE;
+    header.size = 4096; // Complete block length, distinct from header encoding.
     return header;
 }
 
@@ -353,7 +353,7 @@ void Run() {
     bad_size.size = 80;
     Check(!store.Commit(genesis.chain_id, genesis.header.height, bad_size, error) &&
               error == "header",
-          "reject a header whose size field is not 134");
+          "reject a block size shorter than its header");
     Check(ReadRaw(header_path) == bytes_a, "rejected size leaves the snapshot bytes");
     Header bad_time = genesis.header;
     bad_time.time = MAX_TIME + 1;
@@ -372,7 +372,7 @@ void Run() {
     const ChainId chain_b = SecondChain();
     Hash second_id{};
     Check(BlockId(chain_b, second, second_id), "second header has a BlockId");
-    Check(second.nonce == 0 && second.size == HEADER_SIZE, "second header is not mined");
+    Check(second.nonce == 0 && second.size == 4096, "store complete block size without mining");
     Check(!store.Commit(chain_b, second.height, second, error) && error == "io",
           "failed commit");
     Check(ReadRaw(header_path) == bytes_a, "failed commit leaves the previous snapshot bytes");
-- 
