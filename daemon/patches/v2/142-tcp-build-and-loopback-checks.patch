From 8a4cc1aa7004dff7b93d6974700196b03124f89e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:31:52 -0700
Subject: [PATCH] Register explicit TCP adapter and loopback checks on POSIX
 targets

Build the V2 TCP adapter and real ephemeral-loopback tests only on Linux and macOS. Other platforms retain the abstract ByteStream interface. No daemon listener, network profile, endpoint or default port is enabled by these targets.
---
 src/lotus_v2/CMakeLists.txt | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 5544f129dc052c5dcea53dca6d8ad71f5ea1b72b..3e15b8bbf456bae5820ce9522c2bacda709b28f9 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -245,3 +245,15 @@ target_link_libraries(test_lotus_v2_candidate_body_pool PRIVATE lotus_v2_candida
 add_custom_target(check-lotus-v2-candidate-body-pool
     COMMAND $<TARGET_FILE:test_lotus_v2_candidate_body_pool>
     DEPENDS test_lotus_v2_candidate_body_pool)
+
+# Explicit-endpoint POSIX sockets. Other platforms retain the abstract stream
+# interface; building this adapter does not select or start a development node.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    add_library(lotus_v2_peer_tcp STATIC peer_tcp.cpp)
+    target_link_libraries(lotus_v2_peer_tcp PUBLIC lotus_v2_peer_transport)
+    add_executable(test_lotus_v2_peer_tcp test_peer_tcp.cpp)
+    target_link_libraries(test_lotus_v2_peer_tcp PRIVATE lotus_v2_peer_tcp)
+    add_custom_target(check-lotus-v2-peer-tcp
+        COMMAND $<TARGET_FILE:test_lotus_v2_peer_tcp>
+        DEPENDS test_lotus_v2_peer_tcp)
+endif()
