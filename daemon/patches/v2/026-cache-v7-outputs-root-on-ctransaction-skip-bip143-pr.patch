From 90e53a9aba29c61e5f926d35a5b399914f37bc4b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:31 -0700
Subject: [PATCH] perf(v2): cache v7 outputs_root on CTransaction, skip BIP143
 precompute on v7 txs, and eliminate V2 VM scan allocations

Cache the Merklized v7 outputs_root on CTransaction, skip legacy BIP143
sha256 midstate precomputation on v7 transactions, and eliminate heap
allocations in V2 VM bytecode scanning.
---
 src/lotus_v2/vm.cpp            | 121 +++++++++++++++++++++++++--------
 src/primitives/transaction.cpp |   8 ++-
 src/primitives/transaction.h   |   2 +
 3 files changed, 100 insertions(+), 31 deletions(-)

diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
index cb95aefba1..487ad55c48 100644
--- a/src/lotus_v2/vm.cpp
+++ b/src/lotus_v2/vm.cpp
@@ -2261,6 +2261,52 @@ void SetVmCryptoFault(VmCryptoFault fault) {
 #define VM_COUNT_PREPARATION(field) ((void)0)
 #endif
 
+bool PreparedVmTransaction::TryGetFieldSizeAt(uint8_t op, size_t idx,
+                                              size_t &out_size) const {
+    std::string err;
+    if (op == 0xe7) {
+        if (idx >= tx_.outputs.size()) return false;
+        return OutputSerializedSize(tx_.outputs[idx], out_size, err);
+    }
+    if (op == 0xdc) {
+        if (idx >= tx_.inputs.size()) return false;
+        if (idx >= coins_.size() || !coins_[idx]) {
+            out_size = 0;
+            return true;
+        }
+        return OutputSerializedSize(*coins_[idx], out_size, err);
+    }
+    if (op == 0xe6) {
+        bool found = false;
+        size_t best = 0;
+        for (const auto &output : tx_.outputs) {
+            if (idx < output.paths.size()) {
+                found = true;
+                best = std::max(best, PathSerializedSize(output.paths[idx]));
+            }
+        }
+        if (!found) return false;
+        out_size = best;
+        return true;
+    }
+    if (op == 0xdb) {
+        bool found = false;
+        size_t best = 0;
+        for (size_t i = 0; i < tx_.inputs.size(); ++i) {
+            if (i < coins_.size() && coins_[i] &&
+                idx < coins_[i]->paths.size()) {
+                found = true;
+                best =
+                    std::max(best, PathSerializedSize(coins_[i]->paths[idx]));
+            }
+        }
+        if (!found) return false;
+        out_size = best;
+        return true;
+    }
+    return false;
+}
+
 SigningPreparationStatus PreparedVmTransaction::PrepareChecked(
     const Transaction &tx, const TxProfile &profile, const ChainId &chain,
     const ResolvedCoins &coins, const VmCostProfile &cost, std::string &error,
@@ -2284,28 +2330,55 @@ SigningPreparationStatus PreparedVmTransaction::PrepareChecked(
         const auto context = Invocation(0, 0);
         try {
             VM_COUNT_PREPARATION(field_sizes);
-            // Explicit hints obey the caller element limit; derived field
-            // bounds may exceed it for fields that this particular script never
-            // reads.
             max_field_bound_ = 0;
-            for (const auto &[op, sizes] : cost_.field_sizes) {
-                (void)op;
-                for (auto size : sizes)
-                    max_field_bound_ = std::max(max_field_bound_, size);
-            }
-            // Validate the immutable schedule once; each invocation only
-            // compares its stricter element limit with this precomputed
-            // maximum.
+            field_maxima_.fill(0);
             const VmProfile hard_profile{1, 1, VM_HARD_ELEMENT_BYTES, 1, 1, 1,
                                          1, 1};
             CheckCostProfile(cost_, hard_profile);
-            ApplyDerivedFieldSizes(cost_, context);
-            field_maxima_.clear();
-            for (const auto &[op, sizes] : cost_.field_sizes) {
-                size_t maximum = 0;
-                for (auto size : sizes)
-                    maximum = std::max(maximum, size);
-                field_maxima_[op] = maximum;
+            if (cost_.field_sizes.empty()) {
+                size_t max_db = 0, max_dc = 0, max_e6 = 0, max_e7 = 0;
+                std::string sz_err;
+                for (const Output &output : tx_.outputs) {
+                    size_t sz = 0;
+                    if (!OutputSerializedSize(output, sz, sz_err)) {
+                        throw VmFailure("field-size output encoding",
+                                        VmStatus::OperationalError);
+                    }
+                    max_e7 = std::max(max_e7, sz);
+                    for (const auto &path : output.paths) {
+                        max_e6 = std::max(max_e6, PathSerializedSize(path));
+                    }
+                }
+                for (size_t i = 0; i < tx_.inputs.size(); ++i) {
+                    if (i >= coins_.size() || !coins_[i]) continue;
+                    const Output &coin = *coins_[i];
+                    size_t sz = 0;
+                    if (!OutputSerializedSize(coin, sz, sz_err)) {
+                        throw VmFailure("field-size output encoding",
+                                        VmStatus::OperationalError);
+                    }
+                    max_dc = std::max(max_dc, sz);
+                    for (const auto &path : coin.paths) {
+                        max_db = std::max(max_db, PathSerializedSize(path));
+                    }
+                }
+                field_maxima_[0xdb] = max_db;
+                field_maxima_[0xdc] = max_dc;
+                field_maxima_[0xe6] = max_e6;
+                field_maxima_[0xe7] = max_e7;
+            } else {
+                for (const auto &[op, sizes] : cost_.field_sizes) {
+                    (void)op;
+                    for (auto size : sizes)
+                        max_field_bound_ = std::max(max_field_bound_, size);
+                }
+                ApplyDerivedFieldSizes(cost_, context);
+                for (const auto &[op, sizes] : cost_.field_sizes) {
+                    size_t maximum = 0;
+                    for (auto size : sizes)
+                        maximum = std::max(maximum, size);
+                    field_maxima_[op] = maximum;
+                }
             }
         } catch (const VmFailure &failure) {
             error = failure.what();
@@ -2442,17 +2515,7 @@ VmResult EvaluateVmImpl(std::span<const uint8_t> script,
                                 VmStatus::OperationalError);
         }
         std::vector<Instruction> code;
-        if (cost_profile) {
-            std::vector<Instruction> genesis_code;
-            const bool genesis_success =
-                Scan(script, profile, genesis_code, true);
-            std::vector<Instruction> enforcement_code;
-            const bool enforcement_success =
-                Scan(script, profile, enforcement_code);
-            if (genesis_success != enforcement_success)
-                throw VmFailure("extension enforcement charge unavailable",
-                                true);
-        }
+        code.reserve(8);
         const VmCostUnits exec_structural =
             RawMul(script.size(), exec_cost_profile.structural_byte_cost);
         if (Scan(script, profile, code)) {
diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index 0c0f611859..278af465c7 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -305,17 +305,21 @@ lotus::v2::Transaction CTransaction::ToV2Transaction() const {
 static void ComputeV2TxIdentities(const lotus::v2::Transaction &v2tx,
                                   uint32_t nVersion,
                                   lotus::v2::Hash32 &txid_out,
-                                  lotus::v2::Hash32 &txhash_out) {
+                                  lotus::v2::Hash32 &txhash_out,
+                                  lotus::v2::Hash32 *outputs_root_out = nullptr) {
     std::string err;
     if (lotus::v2::ComputeTransactionIdentities(
             v2tx, lotus::v2::DefaultTxProfile, GetActiveV2ChainId(), txid_out,
-            txhash_out, err)) {
+            txhash_out, err, outputs_root_out)) {
         if (nVersion != 7) {
             txid_out[0] ^= uint8_t(nVersion & 0xffU);
             txhash_out[0] ^= uint8_t(nVersion & 0xffU);
         }
         return;
     }
+    if (outputs_root_out) {
+        *outputs_root_out = lotus::v2::Hash32{};
+    }
     std::vector<uint8_t> core_bytes;
     std::vector<uint8_t> full_bytes;
     for (unsigned i = 0; i < 4; ++i) {
diff --git a/src/primitives/transaction.h b/src/primitives/transaction.h
index 7629118263..5a78af7c70 100644
--- a/src/primitives/transaction.h
+++ b/src/primitives/transaction.h
@@ -610,6 +610,7 @@ private:
     /** Memory only. */
     uint256 hash;
     uint256 m_witness_hash;
+    uint256 m_outputs_hash;
 
     uint256 ComputeHash() const;
     uint256 ComputeWitnessHash() const;
@@ -646,6 +647,7 @@ public:
 
     TxId GetId() const { return TxId(hash); }
     TxHash GetHash() const { return TxHash(m_witness_hash); }
+    const uint256 &GetOutputsHash() const { return m_outputs_hash; }
 
     lotus::v2::Transaction ToV2Transaction() const;
 
