From 96d67f8bb9699c937cfd59354f2c53e400598064 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:11:15 -0700
Subject: [PATCH] Reject zero absolute tail lower bounds and anchors

Maintenance explanation added during mailbox export:
Reject zero tail lower bounds and zero genesis tail anchors in monetary profiles. The additional regressions prevent degenerate absolute tail configurations from passing profile validation.

---
 src/lotus_v2/monetary.cpp      | 2 +-
 src/lotus_v2/test_monetary.cpp | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/monetary.cpp b/src/lotus_v2/monetary.cpp
index a25abc10d7315f74b67ba7da05d63d7dff4c085e..1735e1af6dcb410c40d54e7dae07c075e23fcd3c 100644
--- a/src/lotus_v2/monetary.cpp
+++ b/src/lotus_v2/monetary.cpp
@@ -29,7 +29,7 @@ Int WorkInteger(const Hash &work);
 void ValidateProfile(const MonetaryProfile &p) {
     Require(WorkInteger(p.genesis_work) != 0, "zero genesis work anchor");
     Require(p.genesis_tail >= p.tail_min && p.genesis_tail <= p.tail_max, "genesis tail anchor bounds");
-    Require(p.tail_min <= p.tail_max, "tail bounds");
+    Require(p.tail_min > 0 && p.tail_min <= p.tail_max, "tail bounds");
     Require(p.min_fee_per_kb == 1000, "P05 byte fee rate");
 }
 Int WorkInteger(const Hash &work) {
diff --git a/src/lotus_v2/test_monetary.cpp b/src/lotus_v2/test_monetary.cpp
index 3b6084da6f8949c68c5499b73b059af62422da64..957dc48d8e4c20977e5071719589b317acadd73c 100644
--- a/src/lotus_v2/test_monetary.cpp
+++ b/src/lotus_v2/test_monetary.cpp
@@ -77,6 +77,15 @@ void HandCalculated() {
           "wide numerator clamps before narrowing");
     auto zero = P; zero.genesis_work = {};
     Reject([&] { AbsoluteTail(zero, 9); }, "zero genesis anchor");
+    zero = P; zero.genesis_tail = 0;
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero genesis tail");
+    zero = P; zero.tail_min = 0;
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero tail lower bound");
+    zero.genesis_tail = 0;
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero lower bound and anchor");
+    auto smallest = P; smallest.tail_min = 1; smallest.genesis_tail = 1;
+    smallest.genesis_work = Hash{1};
+    Check(AbsoluteTail(smallest, 1) == 1, "positive minimum anchor accepted");
     Reject([&] { Step(State(9, 199, 9, 4)); }, "tampered cached tail");
     Reject([&] { InitializeMonetaryGenesis(P, State(9, 201, 9, 4), 0); },
            "initial anchor mismatch");
