From 7ceb3ea9e9e16b6ae316fd9338c3feb04fd96380 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 10:48:50 -0700
Subject: [PATCH] Share strict offline development manifest and home opening

Expose the existing manifest parser, namespace checks and chain initializer to offline wallet test consumers. The daemon command uses the same adapter. Outputs publish only after successful initialization. Syntax verification passes against the exact full-build dependencies; process-level validation follows the integrated build.
---
 src/lotus_v2/development_command.cpp | 27 ++++++++++++++++-----------
 src/lotus_v2/development_command.h   | 12 ++++++++++++
 2 files changed, 28 insertions(+), 11 deletions(-)

diff --git a/src/lotus_v2/development_command.cpp b/src/lotus_v2/development_command.cpp
index 617c100ee..26c2e4f07 100644
--- a/src/lotus_v2/development_command.cpp
+++ b/src/lotus_v2/development_command.cpp
@@ -97,12 +97,7 @@ std::string Namespace(const std::string &directory, const std::string &identity)
     Require(std::string(saved.begin(),saved.end()) == identity, "development namespace identity mismatch");
     return (root / "chainstate-v2").string();
 }
-struct Manifest {
-    HeaderChainProfile hp{}; OrdinaryCandidateProfile op{}; MonetaryProfile mp{};
-    BlockCostProfile cp{}; MonetaryState initial{}; std::vector<uint8_t> genesis;
-    uint64_t future_window{}, block_read_limit{};
-};
-Manifest Load(const std::string &path) {
+DevelopmentManifest Load(const std::string &path) {
     const auto bytes = ReadFile(path, 8 << 20); // Local config limit, not consensus.
     UniValue v; Require(v.read(std::string(bytes.begin(), bytes.end())), "manifest JSON");
     Keys(v, {"schema", "header", "transaction_limits", "vm_limits", "invocation_limits",
@@ -111,7 +106,7 @@ Manifest Load(const std::string &path) {
     Require(Number(v["schema"]) == 1, "unsupported development manifest schema");
     const auto &h = v["header"];
     Keys(h, {"chain_id", "genesis_id", "version", "time", "bits", "pow_limit", "half_life", "spacing"});
-    Manifest m;
+    DevelopmentManifest m;
     m.hp.chain_id = HashValue(h["chain_id"]); m.hp.genesis_id = HashValue(h["genesis_id"]);
     m.hp.version = Number(h["version"],32); m.hp.genesis_time = Number(h["time"]);
     m.hp.genesis_bits = Number(h["bits"],32); m.hp.pow_limit = HashValue(h["pow_limit"]);
@@ -151,6 +146,18 @@ Manifest Load(const std::string &path) {
     return m;
 }
 } // namespace
+bool OpenDevelopmentHome(const std::string &manifest_path, const std::string &home,
+    DevelopmentManifest &out, DiskStateStore &store, std::string &error) {
+    try {
+        auto m = Load(manifest_path);
+        const auto directory = Namespace(home, "Lotus V2 development command 1\n" + Hex(m.hp.chain_id) + "\n" +
+            Hex(m.hp.genesis_id) + "\n" + Hex(BlockValidationProfileDigest(m.hp,m.op,m.mp,m.cp)) + "\n");
+        DiskStateStore candidate;
+        if (!OpenDevelopmentChain(directory,m.genesis,m.hp,m.op,m.mp,m.cp,m.initial,{},candidate,error))
+            return false;
+        out = std::move(m); store = std::move(candidate); error.clear(); return true;
+    } catch (const std::exception &e) { error = e.what(); return false; }
+}
 int RunDevelopmentCommand(int argc, char *argv[]) {
     try {
         Require(argc == 5 || argc == 6,
@@ -158,10 +165,8 @@ int RunDevelopmentCommand(int argc, char *argv[]) {
         const std::string command = argv[4];
         Require((command == "status" && argc == 5) || ((command == "submit" || command == "disconnect") && argc == 6),
                 "unknown development command or arguments");
-        const auto m = Load(argv[2]); DiskStateStore store; std::string error;
-        const auto directory = Namespace(argv[3], "Lotus V2 development command 1\n" + Hex(m.hp.chain_id) + "\n" +
-            Hex(m.hp.genesis_id) + "\n" + Hex(BlockValidationProfileDigest(m.hp,m.op,m.mp,m.cp)) + "\n");
-        if (!OpenDevelopmentChain(directory,m.genesis,m.hp,m.op,m.mp,m.cp,m.initial,{},store,error))
+        DevelopmentManifest m; DiskStateStore store; std::string error;
+        if (!OpenDevelopmentHome(argv[2],argv[3],m,store,error))
             throw std::runtime_error(error);
         int result = 0; UniValue answer(UniValue::VOBJ);
         if (command == "submit") {
diff --git a/src/lotus_v2/development_command.h b/src/lotus_v2/development_command.h
index b60bbde63..f7130938b 100644
--- a/src/lotus_v2/development_command.h
+++ b/src/lotus_v2/development_command.h
@@ -1,7 +1,19 @@
 // Copyright (c) 2026 The Lotus developers
 #ifndef LOTUS_V2_DEVELOPMENT_COMMAND_H
 #define LOTUS_V2_DEVELOPMENT_COMMAND_H
+#include "development_chain.h"
 namespace lotus::v2 {
+struct DevelopmentManifest {
+    HeaderChainProfile hp{}; OrdinaryCandidateProfile op{}; MonetaryProfile mp{};
+    BlockCostProfile cp{}; MonetaryState initial{}; std::vector<uint8_t> genesis;
+    uint64_t future_window{}, block_read_limit{};
+};
+// Reuses the offline command's strict manifest and isolated namespace checks.
+// Caller supplies the home explicitly and serializes its access. A fresh home
+// is initialized; existing homes must match. Outputs change only on success.
+bool OpenDevelopmentHome(const std::string &manifest_path, const std::string &directory,
+    DevelopmentManifest &out, DiskStateStore &store, std::string &error);
+
 int RunDevelopmentCommand(int argc, char *argv[]);
 }
 #endif
