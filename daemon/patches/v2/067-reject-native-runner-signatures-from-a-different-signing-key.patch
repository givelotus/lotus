From 03a08817667011571aaff387544aa9441c827106 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 08:31:39 -0700
Subject: [PATCH] Reject native runner signatures from a different signing key

Review correction: Reject native runner signatures from a different signing key.

This isolated V2 candidate change preserves the existing Bitcoin parser and
mainnet parameters. Module tests do not establish lotusd block acceptance.
---
 src/lotus_v2/vm_test/context_runner_test.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/lotus_v2/vm_test/context_runner_test.py b/src/lotus_v2/vm_test/context_runner_test.py
index 05a71cbb9697a1d6cb3fe1a7ac1691fcc024a5e1..7922284c995d69d986c8e8cd2d274347e2122613 100644
--- a/src/lotus_v2/vm_test/context_runner_test.py
+++ b/src/lotus_v2/vm_test/context_runner_test.py
@@ -39,6 +39,10 @@ for mode in range(3):
         witnesses=(Witness(script, (), (signature,)),)),))
     result = call(signed)
     assert result[0] == 'S' and result[1] == result[2] and result[3] == '01' + '00'*15, result
+    wrong_signature = PrivateKey((4).to_bytes(32, 'big')).sign_schnorr(digest, bytes(32)) + (bytes([mode]) if mode else b'')
+    wrong_key = dataclasses.replace(signed, inputs=(dataclasses.replace(signed.inputs[0],
+        witnesses=(Witness(script, (), (wrong_signature,)),)),))
+    assert call(wrong_key)[0] == 'I'
     assert call(signed, chain=b'\xff'*32)[0] == 'I'
     assert call(signed, coin=dataclasses.replace(coin, value=1999))[0] == 'I'
     assert call(signed, coin=dataclasses.replace(coin, branches=(bytes(32),)))[0] == 'I'
