From 359ac351281f853b939bab492c1a2c08d9ed3bea Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:09:02 -0700
Subject: [PATCH] test(chronik): count examined records rejected by page byte
 budget

---
 .../src/query/v2_explorer_query_tests.rs          | 15 +++++----------
 1 file changed, 5 insertions(+), 10 deletions(-)

diff --git a/chronik/chronik-indexer/src/query/v2_explorer_query_tests.rs b/chronik/chronik-indexer/src/query/v2_explorer_query_tests.rs
index a4ff39efc3ceb7c590f01725e46708011184c20c..6f2b14eb7a05ed1c8dd668777d02fa8749778f39 100644
--- a/chronik/chronik-indexer/src/query/v2_explorer_query_tests.rs
+++ b/chronik/chronik-indexer/src/query/v2_explorer_query_tests.rs
@@ -71,11 +71,7 @@ impl ExplorerSource for Fixture {
     fn transaction_by_hash(&self, h: TxHash) -> Result<Option<TxMeta>> {
         Ok(self.tx.clone().filter(|tx| tx.location.txhash == h))
     }
-    fn block_transaction(
-        &self,
-        b: Hash32,
-        i: u32,
-    ) -> Result<Option<(TxId, TxHash)>> {
+    fn block_transaction(&self, b: Hash32, i: u32) -> Result<Option<(TxId, TxHash)>> {
         Ok(self
             .tx
             .as_ref()
@@ -180,12 +176,11 @@ fn pages_advance_and_reorg_removes_canonical_objects() {
 }
 #[test]
 fn oversize_indivisible_record_errors_without_stuck_cursor() {
-    assert!(
-        ordinal_page(1, None, 1, 1, |_| Ok(((), MAX_PAGE_BYTES + 1))).is_err()
-    );
-    let page =
-        ordinal_page(3, None, 3, 1, |i| Ok((i, MAX_PAGE_BYTES / 2))).unwrap();
+    assert!(ordinal_page(1, None, 1, 1, |_| Ok(((), MAX_PAGE_BYTES + 1))).is_err());
+    let page = ordinal_page(3, None, 3, 1, |i| Ok((i, MAX_PAGE_BYTES / 2))).unwrap();
     assert_eq!(page.items, vec![0, 1]);
+    assert_eq!(page.examined, 3);
+    assert_eq!(page.key_reads, 3);
     assert_eq!(page.next_index, Some(1));
     assert!(!page.exhausted);
     assert!(ordinal_page::<()>(2, Some(2), 1, 1, |_| Ok(((), 1))).is_err());
-- 
