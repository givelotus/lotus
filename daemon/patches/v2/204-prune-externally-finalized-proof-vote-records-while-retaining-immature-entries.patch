From 6e2af269141e59df220fc569726ab30eae81a426 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:17:16 -0700
Subject: [PATCH] Prune externally finalized proof vote records while retaining
 immature entries

Maintenance explanation added during mailbox export:
Prune proof vote records that were finalized externally while retaining immature proof entries. This separates obsolete polling state from proofs that still need maturity handling.

---
 src/lotus_v2/avalanche_poll.cpp   | 2 +-
 src/lotus_v2/avalanche_quorum.cpp | 1 +
 src/lotus_v2/avalanche_quorum.h   | 1 +
 3 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/avalanche_poll.cpp b/src/lotus_v2/avalanche_poll.cpp
index d35cd9f969bcb38f98220876cab37e613d6f2e59..6bd28ee433ce29a32037dcd445af1ca60645ac2c 100644
--- a/src/lotus_v2/avalanche_poll.cpp
+++ b/src/lotus_v2/avalanche_poll.cpp
@@ -38,7 +38,7 @@ bool PollEngine::Reconcile(const PollItem &item,bool accepted,std::string &error
 }
 bool PollEngine::Next(Quorum &quorum,const ChainSnapshot &snapshot,int64_t now,OutgoingPoll &out,std::string &error) {
     for(auto it=impl_->records.begin();it!=impl_->records.end();) {
-        if(it->first.kind==ItemKind::Proof && !quorum.Known(::avalanche::ProofId(Native(it->first.id)))) it=impl_->records.erase(it);
+        if(it->first.kind==ItemKind::Proof && !quorum.Pollable(::avalanche::ProofId(Native(it->first.id))) && !quorum.Immature(::avalanche::ProofId(Native(it->first.id)))) it=impl_->records.erase(it);
         else ++it;
     }
     if(!quorum.Established(snapshot)) return Fail(error,"quorum-not-established");
diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index 8a0b6c1a3bc3471470b60e97d79a7863e625bd4c..81267dbd0df72990fa307c56c9b3a71d23609ea1 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -187,6 +187,7 @@ uint32_t Quorum::Vote(const ::avalanche::ProofId &id) const {
     if(impl_->conflicting.getProof(id)) return 3;
     return impl_->entries.contains(id)?uint32_t(-2):uint32_t(-1);
 }
+bool Quorum::Immature(const ::avalanche::ProofId &id) const { auto it=impl_->entries.find(id); return it!=impl_->entries.end() && it->second.immature; }
 bool Quorum::Known(const ::avalanche::ProofId &id) const { return impl_->entries.contains(id); }
 bool Quorum::Pollable(const ::avalanche::ProofId &id) const { auto it=impl_->entries.find(id); return it!=impl_->entries.end() && !it->second.immature && !it->second.finalized && !impl_->finalized.contains(id) && !impl_->invalid.contains(id); }
 std::vector<::avalanche::ProofId> Quorum::Proofs() const { std::vector<::avalanche::ProofId> out; for(const auto &[id,entry]:impl_->entries) out.push_back(id); return out; }
diff --git a/src/lotus_v2/avalanche_quorum.h b/src/lotus_v2/avalanche_quorum.h
index a0de731a3454bec508c0cde72f3f50c7d57a1b98..916d6aa9933732e61d25dd868b3f05d9c02773e6 100644
--- a/src/lotus_v2/avalanche_quorum.h
+++ b/src/lotus_v2/avalanche_quorum.h
@@ -29,6 +29,7 @@ public:
     bool ApplyProofVote(const ::avalanche::ProofId &, Status, int64_t now_seconds,
                         std::string &);
     uint32_t Vote(const ::avalanche::ProofId &) const;
+    bool Immature(const ::avalanche::ProofId &) const;
     bool Known(const ::avalanche::ProofId &) const;
     bool Pollable(const ::avalanche::ProofId &) const;
     std::vector<::avalanche::ProofId> Proofs() const;
