From c599f13159a9d8238032c1a2d9af97b45899e33c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:24:14 -0700
Subject: [PATCH] Defer future V2 blocks at explicit caller clock admission
 boundary

Keep now and future-window values as caller arguments. Return Deferred without state mutation while time exceeds the window, avoiding addition overflow; eligible inputs enter the stored-context block validator. Clock eligibility never creates a permanent consensus-invalid result. Companion regressions cover retry, backwards clock, maximum u64 arguments and separate invalid/storage failures.
---
 src/lotus_v2/disk_block.cpp | 22 ++++++++++++++++++++++
 src/lotus_v2/disk_block.h   |  9 +++++++++
 2 files changed, 31 insertions(+)

diff --git a/src/lotus_v2/disk_block.cpp b/src/lotus_v2/disk_block.cpp
index 19a34a67fb53668ddab0481189d42ef64e33a6ec..bfa82d74daf42ea41631d88e7af15b068e38049a 100644
--- a/src/lotus_v2/disk_block.cpp
+++ b/src/lotus_v2/disk_block.cpp
@@ -94,6 +94,28 @@ CandidateCheckResult ConnectStoredDiskBlock(
         error = e.what(); return CandidateCheckResult::StorageError;
     }
 }
+DiskBlockAdmission ConnectEligibleDiskBlock(
+    const std::vector<uint8_t> &wire, uint64_t now, uint64_t future_window,
+    const HeaderChainProfile &hp, OrdinaryCandidateProfile op,
+    const MonetaryProfile &mp, const BlockCostProfile &cp,
+    DiskStateStore &store, StagedBlockTransition &out, std::string &error) {
+    Header header;
+    if (wire.size() < HEADER_SIZE || !ParseHeader(wire.data(), HEADER_SIZE, header)) {
+        error = "block header encoding"; return DiskBlockAdmission::Invalid;
+    }
+    // Subtraction avoids overflow in now + future_window. A clock moving
+    // backwards changes only eligibility; no database mutation has happened.
+    if (header.time > now && header.time - now > future_window) {
+        error = "block time not yet eligible"; return DiskBlockAdmission::Deferred;
+    }
+    switch (ConnectStoredDiskBlock(wire, hp, std::move(op), mp, cp, store, out, error)) {
+    case CandidateCheckResult::Accepted: return DiskBlockAdmission::Accepted;
+    case CandidateCheckResult::Invalid: return DiskBlockAdmission::Invalid;
+    case CandidateCheckResult::StorageError: return DiskBlockAdmission::StorageError;
+    }
+    error = "unknown block validation result";
+    return DiskBlockAdmission::StorageError;
+}
 Hash BlockValidationProfileDigest(const HeaderChainProfile &hp,
     const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
     const BlockCostProfile &cp) {
diff --git a/src/lotus_v2/disk_block.h b/src/lotus_v2/disk_block.h
index df8abbf74facecca14c807c1e418d6518843c054..3e35c311539895431621c90c0e7b5aa78af94797 100644
--- a/src/lotus_v2/disk_block.h
+++ b/src/lotus_v2/disk_block.h
@@ -25,6 +25,15 @@ CandidateCheckResult ConnectStoredDiskBlock(
     const std::vector<uint8_t> &wire, const HeaderChainProfile &hp,
     OrdinaryCandidateProfile op, const MonetaryProfile &mp, const BlockCostProfile &cp,
     DiskStateStore &store, StagedBlockTransition &out, std::string &error);
+// Node admission adds external-clock eligibility without changing deterministic
+// consensus. Deferred bodies must be reconsidered as time advances; callers own
+// bounded retry queues and best-chain selection. No time-window default exists.
+enum class DiskBlockAdmission { Accepted, Invalid, Deferred, StorageError };
+DiskBlockAdmission ConnectEligibleDiskBlock(
+    const std::vector<uint8_t> &wire, uint64_t now, uint64_t future_window,
+    const HeaderChainProfile &hp, OrdinaryCandidateProfile op,
+    const MonetaryProfile &mp, const BlockCostProfile &cp,
+    DiskStateStore &store, StagedBlockTransition &out, std::string &error);
 // Caller serializes access to the store. History is authenticated chain ancestry
 // ending at its stored tip; clock eligibility and best-chain selection are
 // enclosing-node responsibilities. Success means one durable database batch.
