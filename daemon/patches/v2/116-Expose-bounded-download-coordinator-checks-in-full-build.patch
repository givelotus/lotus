From fbe6dc8159ea2569f20390e1a5976a7ef04cd2d5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 10:58:49 -0700
Subject: [PATCH] Expose bounded download coordinator checks in full build

Link the socket-free download library to the existing peer codec and add a focused check target. Root Debug standalone suite passes. Release standalone compilation stops on the inherited sha256.cpp unused SelfTest under NDEBUG and Werror; that separate limitation is retained without changing upstream cryptography.
---
 src/lotus_v2/CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 0e3de3427..27c578a91 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -187,3 +187,13 @@ target_link_libraries(test_lotus_v2_peer_session PRIVATE lotus_v2_peer_session)
 add_custom_target(check-lotus-v2-peer-session
     COMMAND $<TARGET_FILE:test_lotus_v2_peer_session>
     DEPENDS test_lotus_v2_peer_session)
+
+# Bounded download state machine; callbacks supply validation and reservations.
+# Building this library does not start sockets or choose a network profile.
+add_library(lotus_v2_peer_download STATIC peer_download.cpp)
+target_link_libraries(lotus_v2_peer_download PUBLIC lotus_v2_peer_codec)
+add_executable(test_lotus_v2_peer_download test_peer_download.cpp)
+target_link_libraries(test_lotus_v2_peer_download PRIVATE lotus_v2_peer_download)
+add_custom_target(check-lotus-v2-peer-download
+    COMMAND $<TARGET_FILE:test_lotus_v2_peer_download>
+    DEPENDS test_lotus_v2_peer_download)
