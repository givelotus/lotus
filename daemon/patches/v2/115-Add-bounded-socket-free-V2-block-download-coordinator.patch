+    ../peer_codec.cpp ../header.cpp ../block_wire.cpp ../transaction.cpp ../output.cpp
+    ../commitment.cpp ../signing.cpp ../tagged_hash.cpp
+    ../../crypto/sha256.cpp ../../crypto/siphash.cpp ../../support/cleanse.cpp)
+target_include_directories(lotus_v2_peer_download_test PRIVATE "${LOTUS_SRC}"
+    "${LOTUS_SRC}/secp256k1/include")
+target_link_libraries(lotus_v2_peer_download_test PRIVATE download_blake3 "${LOTUS_SECP_LIBRARY}")
+target_compile_options(lotus_v2_peer_download_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
+if(LOTUS_SANITIZE)
