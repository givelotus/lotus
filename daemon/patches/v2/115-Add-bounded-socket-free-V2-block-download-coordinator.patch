@@ -0,0 +1,950 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_download.h"
+#include <algorithm>
+#include <exception>
+#include <limits>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <utility>
+namespace lotus::v2::peer {
+bool NextPeerHandle(uint64_t previous, PeerHandle &out) {
+    if (previous == UINT64_MAX) return false;
+    out = {previous + 1};
+    return true;
+}
+namespace {
+    using Key = std::pair<PeerHandle, Hash>;
+    DownloadEvent Event(DownloadResult r, PeerHandle peer = {}, Hash id = {},
+                        std::string why = {}) {
+        DownloadEvent e;
+        e.result = r;
+        e.peer = peer;
+        e.block_id = id;
+        e.diagnostic = std::move(why);
+        return e;
+    }
+    bool DeferredHeader(HeaderDisposition d) {
+        return d == HeaderDisposition::Deferred ||
+               d == HeaderDisposition::MissingParent;
+    }
+    class ControlReader {
+    public:
+        explicit ControlReader(std::span<const uint8_t> b) : bytes(b) {}
+        size_t Left() const { return bytes.size() - pos; }
+        bool Int(unsigned width, uint64_t &n) {
+            if (width > Left()) return false;
+            n = 0;
+            for (unsigned i = 0; i < width; ++i)
+                n |= uint64_t(bytes[pos++]) << (8 * i);
+            return true;
+        }
+        bool Compact(uint64_t &n) {
+            uint64_t lead;
+            if (!Int(1, lead)) return false;
+            if (lead < 253)
+                n = lead;
+            else {
+                unsigned width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+                if (!Int(width, n) || n < (width == 2   ? 253ULL
+                                           : width == 4 ? 65536ULL
+                                                        : 4294967296ULL))
+                    return false;
+            }
+            return n <= 50000;
+        }
+        bool HashValue(Hash &h) {
+            if (Left() < 32) return false;
+            std::copy_n(bytes.begin() + pos, 32, h.begin());
+            pos += 32;
+            return true;
+        }
+
+    private:
+        std::span<const uint8_t> bytes;
+        size_t pos = 0;
+    };
+    enum class CacheSize { Valid, Capacity, Invalid };
+    CacheSize CacheWireBytes(std::span<const Transaction> txs,
+                             const TxProfile &p, uint64_t cap,
+                             uint64_t &total) {
+        total = 0;
+        auto add = [&](uint64_t n) {
+            if (n > cap - total) return false;
+            total += n;
+            return true;
+        };
+        auto bytes = [&](size_t n) {
+            return add(CompactSizeWidth(n)) && add(n);
+        };
+        auto witness = [&](const BranchWitness &w) {
+            if (w.script.size() > p.max_script_bytes ||
+                w.siblings.size() > p.max_branch_proof_depth ||
+                w.arguments.size() > p.max_arguments)
+                return CacheSize::Invalid;
+            if (!bytes(w.script.size()) ||
+                !add(CompactSizeWidth(w.siblings.size())) ||
+                !add(uint64_t(w.siblings.size()) * 32) ||
+                !add(CompactSizeWidth(w.arguments.size())))
+                return CacheSize::Capacity;
+            for (const auto &a : w.arguments) {
+                if (a.size() > p.max_argument_bytes) return CacheSize::Invalid;
+                if (!bytes(a.size())) return CacheSize::Capacity;
+            }
+            return CacheSize::Valid;
+        };
+        for (const auto &tx : txs) {
+            if (tx.inputs.empty() || tx.inputs.size() > p.max_inputs ||
+                tx.outputs.size() > p.max_outputs)
+                return CacheSize::Invalid;
+            if (!add(16)) return CacheSize::Capacity;
+            for (const auto &in : tx.inputs) {
+                if (!add(41)) return CacheSize::Capacity;
+                if (in.flags == 1) {
+                    if (in.witnesses.size() > MAX_OUTPUT_BRANCHES)
+                        return CacheSize::Invalid;
+                    if (!add(CompactSizeWidth(in.path_index)) ||
+                        !add(CompactSizeWidth(in.witnesses.size())))
+                        return CacheSize::Capacity;
+                    for (const auto &w : in.witnesses) {
+                        auto r = witness(w);
+                        if (r != CacheSize::Valid) return r;
+                    }
+                } else if (in.flags == 2) {
+                    if (!add(1) || (in.has_coinbase_data &&
+                                    !bytes(in.coinbase_data.size())))
+                        return CacheSize::Capacity;
+                } else if (in.flags == 3) {
+                    if (in.witnesses.size() != 1) return CacheSize::Invalid;
+                    auto r = witness(in.witnesses[0]);
+                    if (r != CacheSize::Valid) return r;
+                } else
+                    return CacheSize::Invalid;
+            }
+            for (const auto &out : tx.outputs) {
+                if (out.branches.size() > MAX_OUTPUT_BRANCHES ||
+                    out.paths.size() > MAX_OUTPUT_PATHS)
+                    return CacheSize::Invalid;
+                if (!add(9 + (out.HasToken() ? 32 : 0)) ||
+                    !add(CompactSizeWidth(out.branches.size())) ||
+                    !add(uint64_t(out.branches.size()) * 32) ||
+                    !add(CompactSizeWidth(out.paths.size())))
+                    return CacheSize::Capacity;
+                for (const auto &path : out.paths) {
+                    if (path.size() > MAX_OUTPUT_BRANCHES)
+                        return CacheSize::Invalid;
+                    if (!add(CompactSizeWidth(path.size())))
+                        return CacheSize::Capacity;
+                    for (auto index : path)
+                        if (!add(CompactSizeWidth(index)))
+                            return CacheSize::Capacity;
+                }
+            }
+        }
+        return CacheSize::Valid;
+    }
+} // namespace
+struct DownloadManager::Impl {
+    enum class Phase { Full, Compact, Missing, DeferredRequest, DeferredBody };
+    struct Peer {
+        uint32_t limit;
+        uint32_t jobs = 0, slots = 0;
+        uint64_t bytes = 0;
+        std::set<Hash> guards;
+        bool disabled = false;
+    };
+    struct Job {
+        Key key;
+        Header header;
+        DownloadMode mode;
+        Phase phase = Phase::Full;
+        uint64_t generation = 0, deadline = 0, lifecycle = 0, retry = 0;
+        bool full_requested = false, charged = false;
+        ResourceNeed need{};
+        std::unique_ptr<DownloadReservation> lease;
+        std::unique_ptr<CompactReconstruction> reconstruction;
+        Bytes body;
+    };
+    DownloadConfig config;
+    DownloadCallbacks callbacks;
+    std::map<PeerHandle, Peer> peers;
+    std::map<Key, std::unique_ptr<Job>> jobs;
+    DownloadStats stats;
+    uint64_t previous_handle = 0, last_ms = 0;
+    bool clock_started = false, callback_active = false,
+         operation_active = false;
+    struct OperationScope {
+        Impl &owner;
+        PeerHandle peer;
+        bool abort_on_unwind;
+        int exceptions = std::uncaught_exceptions();
+        OperationScope(Impl &s, PeerHandle p, bool abort = true)
+            : owner(s), peer(p), abort_on_unwind(abort) {
+            owner.operation_active = true;
+        }
+        ~OperationScope() {
+            if (abort_on_unwind && std::uncaught_exceptions() > exceptions)
+                owner.AbortWork(peer);
+            owner.operation_active = false;
+        }
+    };
+    struct CallbackScope {
+        bool &active;
+        explicit CallbackScope(bool &flag) : active(flag) { active = true; }
+        ~CallbackScope() { active = false; }
+    };
+    Impl(DownloadConfig c, DownloadCallbacks f)
+        : config(std::move(c)), callbacks(std::move(f)) {
+        const auto &l = config.limits;
+        const auto &n = config.network;
+        if (!callbacks.check_header || !callbacks.reserve ||
+            !callbacks.cached_transactions || !callbacks.admit_body)
+            throw std::invalid_argument("download callbacks required");
+        if (!n.receive_limit || n.receive_limit > MAX_RECEIVE_LIMIT ||
+            !n.max_reconstruction_transactions ||
+            n.max_reconstruction_bytes < HEADER_SIZE + 4 + 17)
+            throw std::invalid_argument(
+                "download network capacity configuration");
+        if (!l.peers || !l.jobs_per_peer || !l.jobs_global ||
+            l.jobs_per_peer > l.jobs_global || !l.tombstones_per_peer ||
+            !l.tombstones_global ||
+            l.tombstones_per_peer > l.tombstones_global ||
+            l.jobs_per_peer > l.tombstones_per_peer ||
+            l.jobs_global > l.tombstones_global || !l.deferred_jobs_global ||
+            l.deferred_jobs_global > l.jobs_global || !l.cache_candidates ||
+            !l.cache_bytes || l.cache_candidates == UINT32_MAX ||
+            l.cache_bytes == UINT64_MAX || l.peers == UINT32_MAX ||
+            l.jobs_global == UINT32_MAX || l.tombstones_global == UINT32_MAX ||
+            l.staging_bytes_global == UINT64_MAX ||
+            l.transaction_slots_global == UINT32_MAX ||
+            !l.staging_bytes_per_peer ||
+            l.staging_bytes_per_peer > l.staging_bytes_global ||
+            !l.transaction_slots_per_peer ||
+            l.transaction_slots_per_peer > l.transaction_slots_global ||
+            !l.request_timeout_ms || !l.deferred_timeout_ms ||
+            !l.retry_interval_ms || l.request_timeout_ms == UINT64_MAX ||
+            l.deferred_timeout_ms == UINT64_MAX ||
+            l.lifecycle_timeout_ms == UINT64_MAX ||
+            l.retry_interval_ms > l.deferred_timeout_ms ||
+            l.lifecycle_timeout_ms <
+                std::max(l.request_timeout_ms, l.deferred_timeout_ms))
+            throw std::invalid_argument("download quota/time configuration");
+        // Permit at least one worst-case job locally. Quotas are explicit
+        // serialized staging/slot allowances, not claims about equal peak RAM.
+        if (n.max_reconstruction_bytes > UINT64_MAX / 4 ||
+            n.max_reconstruction_transactions > UINT32_MAX / 4 ||
+            l.cache_bytes > l.staging_bytes_per_peer ||
+            uint64_t(n.receive_limit) * 2 >
+                l.staging_bytes_per_peer - l.cache_bytes ||
+            n.max_reconstruction_bytes * 4 >
+                l.staging_bytes_per_peer - l.cache_bytes -
+                    uint64_t(n.receive_limit) * 2 ||
+            n.max_reconstruction_transactions * 4 >
+                l.transaction_slots_per_peer ||
+            uint64_t(n.receive_limit) * 4 > l.staging_bytes_per_peer ||
+            (n.receive_limit / 17) * 4 > l.transaction_slots_per_peer)
+            throw std::invalid_argument(
+                "download quota cannot reserve one job");
+    }
+    ~Impl() {
+        operation_active = true;
+        while (!jobs.empty())
+            Erase(jobs.begin()->first);
+    }
+    bool IsDeferred(const Job &j) const {
+        return j.phase == Phase::DeferredRequest ||
+               j.phase == Phase::DeferredBody;
+    }
+    bool Time(uint64_t now, DownloadEvent &e) {
+        if (clock_started && now < last_ms) {
+            e = Event(DownloadResult::OperationalFailure, {}, {},
+                      "monotonic clock moved backwards");
+            return false;
+        }
+        last_ms = now;
+        clock_started = true;
+        return true;
+    }
+    uint64_t Until(const Job &j, uint64_t now, uint64_t interval) const {
+        return now + std::min(interval, j.lifecycle - now);
+    }
+    void Release(Job &j) {
+        j.reconstruction.reset();
+        Bytes{}.swap(j.body);
+        if (j.charged) {
+            auto &p = peers.at(j.key.first);
+            p.bytes -= j.need.staging_bytes;
+            p.slots -= j.need.transaction_slots;
+            stats.staging_bytes -= j.need.staging_bytes;
+            stats.transaction_slots -= j.need.transaction_slots;
+            j.charged = false;
+        }
+        j.lease.reset();
+    }
+    void Erase(const Key &key) {
+        auto it = jobs.find(key);
+        if (it == jobs.end()) return;
+        auto &j = *it->second;
+        if (IsDeferred(j)) --stats.deferred_jobs;
+        Release(j);
+        --peers.at(key.first).jobs;
+        --stats.jobs;
+        jobs.erase(it);
+    }
+    void AbortWork(PeerHandle peer) noexcept {
+        for (auto it = jobs.begin(); it != jobs.end();) {
+            if (!peer.value || it->first.first == peer) {
+                auto key = it->first;
+                ++it;
+                Erase(key);
+            } else
+                ++it;
+        }
+        for (auto &entry : peers)
+            if (!peer.value || entry.first == peer)
+                entry.second.disabled = true;
+    }
+    DownloadEvent End(Job &j, DownloadResult r, std::string why = {}) {
+        auto e = Event(r, j.key.first, j.key.second, std::move(why));
+        auto key = j.key;
+        Erase(key);
+        return e;
+    }
+    HeaderDecision HeaderCheck(const Job &j) {
+        try {
+            CallbackScope scope(callback_active);
+            return callbacks.check_header(j.header, j.generation);
+        } catch (...) {
+            return {HeaderDisposition::OperationalError, std::nullopt,
+                    "header callback exception"};
+        }
+    }
+    DownloadEvent HeaderFailure(Job &j, const HeaderDecision &h) {
+        if (h.disposition == HeaderDisposition::ConsensusInvalid)
+            return End(j, DownloadResult::ConsensusRejected, h.diagnostic);
+        if (h.disposition == HeaderDisposition::Unsupported)
+            return End(j, DownloadResult::Unsupported, h.diagnostic);
+        return End(j, DownloadResult::OperationalFailure, h.diagnostic);
+    }
+    bool Reserve(Job &j, DownloadEvent &failure) {
+        if (j.charged) return true;
+        auto &p = peers.at(j.key.first);
+        const auto &l = config.limits;
+        const uint64_t full_bytes = uint64_t(p.limit) * 4;
+        const uint32_t full_slots = (p.limit / 17) * 4;
+        j.need =
+            j.mode == DownloadMode::Compact
+                ? ResourceNeed{std::max(
+                                   full_bytes,
+                                   uint64_t(p.limit) * 2 +
+                                       config.network.max_reconstruction_bytes *
+                                           4 +
+                                       config.limits.cache_bytes),
+                               std::max(
+                                   full_slots,
+                                   config.network
+                                           .max_reconstruction_transactions *
+                                       4)}
+                : ResourceNeed{full_bytes, full_slots};
+        if (j.need.staging_bytes > l.staging_bytes_per_peer - p.bytes ||
+            j.need.staging_bytes >
+                l.staging_bytes_global - stats.staging_bytes ||
+            j.need.transaction_slots > l.transaction_slots_per_peer - p.slots ||
+            j.need.transaction_slots >
+                l.transaction_slots_global - stats.transaction_slots) {
+            failure = End(j, DownloadResult::CapacityRefused,
+                          "download reservation quota");
+            return false;
+        }
+        ReservationResult result;
+        try {
+            CallbackScope scope(callback_active);
+            result = callbacks.reserve(j.key.first, j.need);
+        } catch (...) {
+            failure = End(j, DownloadResult::OperationalFailure,
+                          "reservation callback exception");
+            return false;
+        }
+        if (result.disposition != ReservationDisposition::Granted ||
+            !result.lease) {
+            auto disposition =
+                result.disposition == ReservationDisposition::CapacityRefused &&
+                        !result.lease
+                    ? DownloadResult::CapacityRefused
+                    : DownloadResult::OperationalFailure;
+            failure = End(j, disposition,
+                          result.diagnostic.empty() ? "reservation not granted"
+                                                    : result.diagnostic);
+            return false;
+        }
+        j.lease = std::move(result.lease);
+        j.charged = true;
+        p.bytes += j.need.staging_bytes;
+        p.slots += j.need.transaction_slots;
+        stats.staging_bytes += j.need.staging_bytes;
+        stats.transaction_slots += j.need.transaction_slots;
+        return true;
+    }
+    bool SetDeferred(Job &j, Phase phase, uint64_t now,
+                     DownloadEvent &failure) {
+        if (!IsDeferred(j)) {
+            if (stats.deferred_jobs >= config.limits.deferred_jobs_global) {
+                failure = End(j, DownloadResult::CapacityRefused,
+                              "deferred job quota");
+                return false;
+            }
+            ++stats.deferred_jobs;
+            j.deadline = Until(j, now, config.limits.deferred_timeout_ms);
+        }
+        j.phase = phase;
+        j.retry = Until(j, now, config.limits.retry_interval_ms);
+        return true;
+    }
+    DownloadEvent DeferHeader(Job &j, const HeaderDecision &h, uint64_t now) {
+        if (h.disposition == HeaderDisposition::MissingParent &&
+            !h.missing_parent)
+            return End(j, DownloadResult::OperationalFailure,
+                       "missing-parent callback omitted parent ID");
+        // A compact already in flight cannot safely be requested again under a
+        // new nonce. After parent recovery continue with one full-body
+        // fallback.
+        if (peers.at(j.key.first).guards.count(j.key.second))
+            j.mode = DownloadMode::Full;
+        DownloadEvent failure;
+        if (!SetDeferred(j, Phase::DeferredRequest, now, failure))
+            return failure;
+        j.reconstruction.reset();
+        j.body.clear();
+        auto e = Event(h.disposition == HeaderDisposition::MissingParent
+                           ? DownloadResult::NeedHeaders
+                           : DownloadResult::Deferred,
+                       j.key.first, j.key.second, h.diagnostic);
+        e.missing_parent = h.missing_parent;
+        return e;
+    }
+    DownloadEvent Issue(Job &j, uint64_t now) {
+        auto &p = peers.at(j.key.first);
+        if (j.mode == DownloadMode::Compact &&
+            j.header.size > config.network.max_reconstruction_bytes)
+            j.mode = DownloadMode::Full;
+        if (p.limit < 37 ||
+            (j.mode == DownloadMode::Full && j.header.size > p.limit))
+            return End(j, DownloadResult::CapacityRefused,
+                       "peer cannot carry requested full object/request");
+        if (j.mode == DownloadMode::Full && j.full_requested)
+            return End(j, DownloadResult::RetryElsewhere,
+                       "full-body fallback already requested");
+        const bool new_guard = !p.guards.count(j.key.second);
+        if (new_guard &&
+            (p.guards.size() >= config.limits.tombstones_per_peer ||
+             stats.tombstones >= config.limits.tombstones_global))
+            return End(j, DownloadResult::CapacityRefused,
+                       "connection lifecycle tombstone quota");
+        DownloadEvent failure;
+        if (!Reserve(j, failure)) return failure;
+        Inventory item{j.mode == DownloadMode::Full ? 2U : 4U, j.key.second};
+        Bytes payload;
+        std::string error;
+        if (!EncodeInventory(std::span(&item, 1), p.limit, payload, error))
+            return End(j, DownloadResult::CapacityRefused, error);
+        if (new_guard) {
+            p.guards.insert(j.key.second);
+            ++stats.tombstones;
+        }
+        if (IsDeferred(j)) --stats.deferred_jobs;
+        j.phase = j.mode == DownloadMode::Full ? Phase::Full : Phase::Compact;
+        if (j.mode == DownloadMode::Full) j.full_requested = true;
+        j.deadline = Until(j, now, config.limits.request_timeout_ms);
+        auto e = Event(DownloadResult::Requested, j.key.first, j.key.second);
+        e.outbound = Message{"getdata", std::move(payload)};
+        return e;
+    }
+    DownloadEvent
+    Fallback(Job &j, uint64_t now, std::string why,
+             FallbackReason cause = FallbackReason::Reconstruction) {
+        j.reconstruction.reset();
+        j.body.clear();
+        j.mode = DownloadMode::Full;
+        if (j.header.size > peers.at(j.key.first).limit || j.full_requested) {
+            auto e = End(j, DownloadResult::RetryElsewhere, std::move(why));
+            e.fallback = cause;
+            return e;
+        }
+        auto e = Issue(j, now);
+        if (e.diagnostic.empty()) e.diagnostic = std::move(why);
+        e.fallback = cause;
+        return e;
+    }
+    DownloadEvent Admit(Job &j, std::span<const uint8_t> wire, uint64_t now) {
+        BodyDecision result;
+        try {
+            CallbackScope scope(callback_active);
+            result = callbacks.admit_body(wire, j.generation);
+        } catch (...) {
+            return End(j, DownloadResult::OperationalFailure,
+                       "body admission callback exception");
+        }
+        if (result.disposition == BodyDisposition::MissingParent ||
+            result.disposition == BodyDisposition::Deferred) {
+            if (result.disposition == BodyDisposition::MissingParent &&
+                !result.missing_parent)
+                return End(j, DownloadResult::OperationalFailure,
+                           "missing-parent admission omitted parent ID");
+            DownloadEvent failure;
+            if (!SetDeferred(j, Phase::DeferredBody, now, failure))
+                return failure;
+            if (wire.data() != j.body.data() || wire.size() != j.body.size())
+                j.body.assign(wire.begin(), wire.end());
+            j.reconstruction.reset();
+            auto e = Event(result.disposition == BodyDisposition::MissingParent
+                               ? DownloadResult::NeedHeaders
+                               : DownloadResult::Deferred,
+                           j.key.first, j.key.second, result.diagnostic);
+            e.admission = result.disposition;
+            e.missing_parent = result.missing_parent;
+            return e;
+        }
+        DownloadResult kind;
+        switch (result.disposition) {
+            case BodyDisposition::Accepted:
+                kind = DownloadResult::Accepted;
+                break;
+            case BodyDisposition::MalformedBody:
+                kind = DownloadResult::PeerMessageInvalid;
+                break;
+            case BodyDisposition::ConsensusInvalid:
+                kind = DownloadResult::ConsensusRejected;
+                break;
+            case BodyDisposition::CapacityRefused:
+                kind = DownloadResult::CapacityRefused;
+                break;
+            case BodyDisposition::Unsupported:
+                kind = DownloadResult::Unsupported;
+                break;
+            case BodyDisposition::StorageError:
+                kind = DownloadResult::OperationalFailure;
+                break;
+            case BodyDisposition::ContextChanged:
+                kind = DownloadResult::RetryElsewhere;
+                break;
+            default:
+                return End(j, DownloadResult::OperationalFailure,
+                           "invalid admission disposition");
+        }
+        auto e = End(j, kind, result.diagnostic);
+        e.admission = result.disposition;
+        return e;
+    }
+    DownloadEvent Complete(Job &j, uint64_t now) {
+        std::string error;
+        bool found = false, encoded = false;
+        {
+            FramedBlock b;
+            found = j.reconstruction && j.reconstruction->TakeComplete(b);
+            if (found) {
+                Bytes wire;
+                encoded =
+                    EncodeBlockWire(b.header, b.transactions,
+                                    config.network.transaction, wire, error);
+                if (encoded) j.body = std::move(wire);
+            }
+        } // Release decoded/serialization temporaries while lease is live.
+        if (!found)
+            return End(j, DownloadResult::OperationalFailure,
+                       "missing completed reconstruction");
+        if (!encoded) return Fallback(j, now, error);
+        j.reconstruction.reset();
+        auto h = HeaderCheck(j);
+        if (DeferredHeader(h.disposition)) {
+            if (h.disposition == HeaderDisposition::MissingParent &&
+                !h.missing_parent)
+                return End(j, DownloadResult::OperationalFailure,
+                           "missing parent ID");
+            DownloadEvent failure;
+            if (!SetDeferred(j, Phase::DeferredBody, now, failure))
+                return failure;
+            auto e = Event(h.disposition == HeaderDisposition::MissingParent
+                               ? DownloadResult::NeedHeaders
+                               : DownloadResult::Deferred,
+                           j.key.first, j.key.second, h.diagnostic);
+            e.missing_parent = h.missing_parent;
+            return e;
+        }
+        if (h.disposition != HeaderDisposition::Eligible)
+            return HeaderFailure(j, h);
+        return Admit(j, j.body, now);
+    }
+    DownloadEvent Compact(Job &j, std::span<const uint8_t> payload,
+                          uint64_t now) {
+        if (j.phase != Phase::Compact)
+            return Event(DownloadResult::Ignored, j.key.first, j.key.second,
+                         "late or duplicate compact response");
+        auto h = HeaderCheck(j);
+        if (DeferredHeader(h.disposition)) return DeferHeader(j, h, now);
+        if (h.disposition != HeaderDisposition::Eligible)
+            return HeaderFailure(j, h);
+        std::string error;
+        ReconstructionStatus status = ReconstructionStatus::NeedFullBlock;
+        uint32_t count = 0;
+        DownloadResult preflight_failure = DownloadResult::Idle;
+        {
+            CompactBlock compact;
+            auto decoded =
+                DecodeCompact(payload, config.network,
+                              peers.at(j.key.first).limit, compact, error);
+            if (decoded == CompactDecodeStatus::CapacityRefused)
+                return Fallback(j, now, error, FallbackReason::CompactCapacity);
+            if (decoded == CompactDecodeStatus::InvalidPeerMessage)
+                return End(j, DownloadResult::PeerMessageInvalid, error);
+            count = uint32_t(uint64_t(compact.short_ids.size()) +
+                             compact.prefilled.size());
+            j.reconstruction =
+                std::make_unique<CompactReconstruction>(config.network);
+            try {
+                CachedTransactions cache;
+                {
+                    CallbackScope scope(callback_active);
+                    cache = callbacks.cached_transactions(j.header);
+                }
+                if (cache.transactions.size() >
+                        config.limits.cache_candidates ||
+                    cache.complete_wire_bytes > config.limits.cache_bytes) {
+                    error = "cache candidate/byte quota";
+                    preflight_failure = DownloadResult::CapacityRefused;
+                } else {
+                    uint64_t actual_bytes;
+                    auto size = CacheWireBytes(
+                        cache.transactions, config.network.transaction,
+                        config.limits.cache_bytes, actual_bytes);
+                    if (size == CacheSize::Capacity) {
+                        error = "cache byte quota";
+                        preflight_failure = DownloadResult::CapacityRefused;
+                    } else if (size == CacheSize::Invalid ||
+                               actual_bytes != cache.complete_wire_bytes) {
+                        error = "invalid/stale validated-cache metadata";
+                        preflight_failure = DownloadResult::OperationalFailure;
+                    } else
+                        status = j.reconstruction->Start(
+                            compact, cache.transactions, error);
+                }
+            } catch (...) {
+                error = "cache/reconstruction exception";
+                preflight_failure = DownloadResult::OperationalFailure;
+            }
+        } // No decoded compact/prefilled copy survives a lease release.
+        if (preflight_failure == DownloadResult::CapacityRefused)
+            return Fallback(j, now, error, FallbackReason::CacheCapacity);
+        if (preflight_failure == DownloadResult::OperationalFailure)
+            return End(j, preflight_failure, error);
+        if (status == ReconstructionStatus::NeedFullBlock)
+            return Fallback(j, now, error);
+        if (status == ReconstructionStatus::InvalidPeerMessage)
+            return End(j, DownloadResult::PeerMessageInvalid, error);
+        if (status == ReconstructionStatus::CompleteUnvalidated)
+            return Complete(j, now);
+        if (status != ReconstructionStatus::NeedTransactions)
+            return End(j, DownloadResult::OperationalFailure,
+                       "unexpected reconstruction lifecycle");
+        Bytes request;
+        if (!EncodeMissingRequest(j.reconstruction->Request(), uint32_t(count),
+                                  peers.at(j.key.first).limit, request, error))
+            return Fallback(j, now, error,
+                            FallbackReason::MissingRequestCapacity);
+        j.phase = Phase::Missing;
+        j.deadline = Until(j, now, config.limits.request_timeout_ms);
+        auto e =
+            Event(DownloadResult::NeedTransactions, j.key.first, j.key.second);
+        e.outbound = Message{"getblocktxn", std::move(request)};
+        return e;
+    }
+    DownloadEvent Full(Job &j, std::span<const uint8_t> payload, uint64_t now) {
+        if (IsDeferred(j))
+            return Event(DownloadResult::Ignored, j.key.first, j.key.second,
+                         "late full response while deferred");
+        if (payload.size() != j.header.size)
+            return End(j, DownloadResult::PeerMessageInvalid,
+                       "complete body/header size mismatch");
+        auto h = HeaderCheck(j);
+        if (DeferredHeader(h.disposition)) {
+            if (h.disposition == HeaderDisposition::MissingParent &&
+                !h.missing_parent)
+                return End(j, DownloadResult::OperationalFailure,
+                           "missing parent ID");
+            DownloadEvent failure;
+            if (!SetDeferred(j, Phase::DeferredBody, now, failure))
+                return failure;
+            j.body.assign(payload.begin(), payload.end());
+            j.reconstruction.reset();
+            auto e = Event(h.disposition == HeaderDisposition::MissingParent
+                               ? DownloadResult::NeedHeaders
+                               : DownloadResult::Deferred,
+                           j.key.first, j.key.second, h.diagnostic);
+            e.missing_parent = h.missing_parent;
+            return e;
+        }
+        if (h.disposition != HeaderDisposition::Eligible)
+            return HeaderFailure(j, h);
+        return Admit(j, payload, now);
+    }
+    DownloadEvent Missing(Job &j, std::span<const uint8_t> payload,
+                          uint64_t now) {
+        if (j.phase != Phase::Missing || !j.reconstruction)
+            return Event(DownloadResult::Ignored, j.key.first, j.key.second,
+                         "late or unsolicited blocktxn");
+        std::string error;
+        ReconstructionStatus result;
+        {
+            MissingResponse response;
+            if (!DecodeMissingResponse(
+                    payload, config.network,
+                    uint32_t(j.reconstruction->Request().indices.size()),
+                    peers.at(j.key.first).limit, response, error))
+                return End(j, DownloadResult::PeerMessageInvalid, error);
+            result = j.reconstruction->Apply(response, error);
+        }
+        if (result == ReconstructionStatus::CompleteUnvalidated)
+            return Complete(j, now);
+        if (result == ReconstructionStatus::NeedFullBlock)
+            return Fallback(j, now, error);
+        if (result == ReconstructionStatus::InvalidPeerMessage)
+            return End(j, DownloadResult::PeerMessageInvalid, error);
+        return End(j, DownloadResult::OperationalFailure,
+                   "unexpected missing-response result");
+    }
+    DownloadEvent NotFound(PeerHandle peer, std::span<const uint8_t> payload) {
+        ControlReader r(payload);
+        uint64_t count;
+        if (!r.Compact(count) || count > r.Left() / 36 ||
+            count * 36 != r.Left())
+            return Event(DownloadResult::PeerMessageInvalid, peer, {},
+                         "notfound count/bytes");
+        // Stack-only parsing, retaining at most the already bounded peer jobs.
+        std::set<Hash> found;
+        for (uint64_t i = 0; i < count; ++i) {
+            uint64_t type;
+            Hash id;
+            if (!r.Int(4, type) || !r.HashValue(id))
+                return Event(DownloadResult::PeerMessageInvalid, peer, {},
+                             "notfound item");
+            auto it = jobs.find({peer, id});
+            if (it == jobs.end() || IsDeferred(*it->second)) continue;
+            if (type == 2 || (type == 4 && it->second->phase == Phase::Compact))
+                found.insert(id);
+        }
+        auto e = Event(
+            found.empty() ? DownloadResult::Ignored
+                          : DownloadResult::RetryElsewhere,
+            peer, {}, "notfound: absence/capacity reason not supplied on wire");
+        for (const auto &id : found) {
+            e.affected.push_back(id);
+            Erase({peer, id});
+        }
+        return e;
+    }
+};
+DownloadManager::DownloadManager(DownloadConfig c, DownloadCallbacks f)
+    : impl_(std::make_unique<Impl>(std::move(c), std::move(f))) {}
+DownloadManager::~DownloadManager() = default;
+DownloadEvent DownloadManager::RegisterPeer(uint32_t limit) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, {}, false);
+    if (!limit || limit > s.config.network.receive_limit)
+        return Event(DownloadResult::OperationalFailure, {}, {},
+                     "invalid negotiated peer capacity");
+    if (s.stats.peers >= s.config.limits.peers)
+        return Event(DownloadResult::CapacityRefused, {}, {}, "peer quota");
+    PeerHandle handle;
+    if (!NextPeerHandle(s.previous_handle, handle))
+        return Event(DownloadResult::OperationalFailure, {}, {},
+                     "peer handle exhausted");
+    s.peers.emplace(handle, Impl::Peer{limit, 0, 0, 0, {}});
+    s.previous_handle = handle.value;
+    ++s.stats.peers;
+    return Event(DownloadResult::Registered, handle);
+}
+DownloadEvent DownloadManager::RequestBlock(PeerHandle peer,
+                                            const Header &header,
+                                            DownloadMode mode, uint64_t now) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, peer);
+    DownloadEvent failure;
+    if (!s.Time(now, failure)) return failure;
+    auto p = s.peers.find(peer);
+    if (p == s.peers.end())
+        return Event(DownloadResult::Ignored, peer, {},
+                     "disconnected/unknown peer handle");
+    if (p->second.disabled)
+        return Event(DownloadResult::OperationalFailure, peer, {},
+                     "peer disabled after operational failure");
+    Hash id;
+    if (header.version != 2 || !BlockId(s.config.network.chain_id, header, id))
+        return Event(DownloadResult::PeerMessageInvalid, peer, {},
+                     "header structure");
+    Key key{peer, id};
+    if (s.jobs.count(key))
+        return Event(DownloadResult::Busy, peer, id, "download already active");
+    if (p->second.guards.count(id))
+        return Event(DownloadResult::RetryElsewhere, peer, id,
+                     "retired connection/BlockID lifecycle");
+    if (s.stats.jobs >= s.config.limits.jobs_global ||
+        p->second.jobs >= s.config.limits.jobs_per_peer)
+        return Event(DownloadResult::CapacityRefused, peer, id,
+                     "download job quota");
+    if (s.config.limits.lifecycle_timeout_ms > UINT64_MAX - now)
+        return Event(DownloadResult::OperationalFailure, peer, id,
+                     "download deadline overflow");
+    auto job = std::make_unique<Impl::Job>();
+    job->key = key;
+    job->header = header;
+    job->mode = mode;
+    job->generation = s.config.context_generation;
+    job->lifecycle = now + s.config.limits.lifecycle_timeout_ms;
+    job->deadline = job->lifecycle;
+    auto &j = *job;
+    s.jobs.emplace(key, std::move(job));
+    ++s.stats.jobs;
+    ++p->second.jobs;
+    auto h = s.HeaderCheck(j);
+    if (DeferredHeader(h.disposition)) return s.DeferHeader(j, h, now);
+    if (h.disposition != HeaderDisposition::Eligible)
+        return s.HeaderFailure(j, h);
+    return s.Issue(j, now);
+}
+DownloadEvent DownloadManager::OnMessage(PeerHandle peer,
+                                         const Message &message, uint64_t now) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, peer);
+    DownloadEvent failure;
+    if (!s.Time(now, failure)) return failure;
+    auto p = s.peers.find(peer);
+    if (p == s.peers.end())
+        return Event(DownloadResult::Ignored, peer, {},
+                     "disconnected/unknown peer handle");
+    if (p->second.disabled)
+        return Event(DownloadResult::OperationalFailure, peer, {},
+                     "peer disabled after operational failure");
+    if (message.payload.size() > p->second.limit)
+        return Event(DownloadResult::PeerMessageInvalid, peer, {},
+                     "payload exceeds negotiated limit");
+    if (message.command == "notfound") return s.NotFound(peer, message.payload);
+    Hash id;
+    if (message.command == "block" || message.command == "cmpctblock") {
+        Header h;
+        if (message.payload.size() < HEADER_SIZE ||
+            !ParseHeader(message.payload.data(), HEADER_SIZE, h) ||
+            h.version != 2 || !BlockId(s.config.network.chain_id, h, id))
+            return Event(DownloadResult::PeerMessageInvalid, peer, {},
+                         "response header structure");
+    } else if (message.command == "blocktxn") {
+        if (message.payload.size() < 32)
+            return Event(DownloadResult::PeerMessageInvalid, peer, {},
+                         "blocktxn identity prefix");
+        std::copy_n(message.payload.begin(), 32, id.begin());
+    } else
+        return Event(DownloadResult::Ignored, peer);
+    auto it = s.jobs.find({peer, id});
+    if (it == s.jobs.end())
+        return Event(DownloadResult::Ignored, peer, id,
+                     "unsolicited/retired response");
+    auto &j = *it->second;
+    if (now >= j.deadline)
+        return s.End(j, DownloadResult::RetryElsewhere, "download timeout");
+    if (message.command == "block") return s.Full(j, message.payload, now);
+    if (message.command == "cmpctblock")
+        return s.Compact(j, message.payload, now);
+    return s.Missing(j, message.payload, now);
+}
+DownloadEvent DownloadManager::PollTimeout(uint64_t now) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, {});
+    DownloadEvent failure;
+    if (!s.Time(now, failure)) return failure;
+    for (auto &entry : s.jobs) {
+        auto &j = *entry.second;
+        if (now >= j.deadline)
+            return s.End(j, DownloadResult::RetryElsewhere, "download timeout");
+    }
+    for (auto &entry : s.jobs) {
+        auto &j = *entry.second;
+        if (!s.IsDeferred(j) || now < j.retry) continue;
+        auto h = s.HeaderCheck(j);
+        if (DeferredHeader(h.disposition)) {
+            if (h.disposition == HeaderDisposition::MissingParent &&
+                !h.missing_parent)
+                return s.End(j, DownloadResult::OperationalFailure,
+                             "missing parent ID");
+            j.retry = s.Until(j, now, s.config.limits.retry_interval_ms);
+            auto e = Event(h.disposition == HeaderDisposition::MissingParent
+                               ? DownloadResult::NeedHeaders
+                               : DownloadResult::Deferred,
+                           j.key.first, j.key.second, h.diagnostic);
+            e.missing_parent = h.missing_parent;
+            return e;
+        }
+        if (h.disposition != HeaderDisposition::Eligible)
+            return s.HeaderFailure(j, h);
+        if (j.phase == Impl::Phase::DeferredBody)
+            return s.Admit(j, j.body, now);
+        return s.Issue(j, now);
+    }
+    return {};
+}
+DownloadEvent DownloadManager::Cancel(PeerHandle peer, const Hash &id) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, peer);
+    auto it = s.jobs.find({peer, id});
+    if (it == s.jobs.end()) return Event(DownloadResult::Ignored, peer, id);
+    return s.End(*it->second, DownloadResult::Cancelled, "download cancelled");
+}
+DownloadEvent DownloadManager::OnReorg(uint64_t generation) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, {});
+    if (generation <= s.config.context_generation)
+        return Event(DownloadResult::OperationalFailure, {}, {},
+                     "context generation must advance");
+    auto e = Event(DownloadResult::Cancelled, {}, {}, "chain context changed");
+    while (!s.jobs.empty()) {
+        e.affected.push_back(s.jobs.begin()->first.second);
+        s.Erase(s.jobs.begin()->first);
+    }
+    s.config.context_generation = generation;
+    return e;
+}
+DownloadEvent DownloadManager::OnDisconnect(PeerHandle peer) {
+    auto &s = *impl_;
+    if (s.callback_active || s.operation_active)
+        return Event(DownloadResult::OperationalFailure);
+    Impl::OperationScope operation(s, peer);
+    auto p = s.peers.find(peer);
+    if (p == s.peers.end()) return Event(DownloadResult::Ignored, peer);
+    auto e = Event(DownloadResult::Cancelled, peer, {}, "peer disconnected");
+    for (auto it = s.jobs.begin(); it != s.jobs.end();) {
+        if (it->first.first == peer) {
+            auto key = it->first;
+            ++it;
+            e.affected.push_back(key.second);
+            s.Erase(key);
+        } else
+            ++it;
+    }
+    s.stats.tombstones -= uint32_t(p->second.guards.size());
+    s.peers.erase(p);
+    --s.stats.peers;
+    return e;
+}
+DownloadStats DownloadManager::Stats() const {
+    return impl_->stats;
+}
+} // namespace lotus::v2::peer
