+++ b/src/lotus_v2/test_peer_download.cpp
@@ -0,0 +1,879 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_download.h"
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <stdexcept>
+// Standalone deterministic allocator fault injection. Disabled except during
+// the specific unwinding test; no production allocation seam is compiled.
+static int fail_allocation_after = -1;
+void *operator new(std::size_t n) {
+    if (fail_allocation_after == 0) {
+        fail_allocation_after = -1;
+        throw std::bad_alloc();
+    }
+    if (fail_allocation_after > 0) --fail_allocation_after;
+    if (void *p = std::malloc(n ? n : 1)) return p;
+    throw std::bad_alloc();
+}
+void operator delete(void *p) noexcept {
+    std::free(p);
+}
+void *operator new[](std::size_t n) {
+    return ::operator new(n);
+}
+void operator delete[](void *p) noexcept {
+    ::operator delete(p);
+}
+void operator delete(void *p, std::size_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete[](void *p, std::size_t) noexcept {
+    ::operator delete(p);
+}
+using namespace lotus::v2;
+using namespace lotus::v2::peer;
+#define CHECK(c)                                                               \
+    do {                                                                       \
+        if (!(c))                                                              \
+            throw std::runtime_error("line " + std::to_string(__LINE__) +      \
+                                     ": " #c);                                 \
+    } while (false)
+namespace {
+DownloadConfig Config() {
+    DownloadConfig c{};
+    auto &p = c.network;
+    p.magic = {0x12, 0x34, 0x56, 0x78}; // arbitrary synthetic profile
+    p.chain_id[0] = 1;
+    p.genesis_id[0] = 2;
+    p.profile_digest[0] = 3;
+    p.receive_limit = 4096;
+    p.transaction = {8, 8, 2, 8192, 8, 8192, 64};
+    p.max_reconstruction_transactions = 16;
+    p.max_reconstruction_bytes = 4096;
+    auto &l = c.limits;
+    l.peers = 3;
+    l.jobs_per_peer = 2;
+    l.jobs_global = 4;
+    l.tombstones_per_peer = 3;
+    l.tombstones_global = 6;
+    l.deferred_jobs_global = 2;
+    l.cache_candidates = 16;
+    l.cache_bytes = 4096;
+    l.staging_bytes_per_peer = 65536;
+    l.staging_bytes_global = 131072;
+    l.transaction_slots_per_peer = 2048;
+    l.transaction_slots_global = 8192;
+    l.request_timeout_ms = 100;
+    l.deferred_timeout_ms = 500;
+    l.retry_interval_ms = 10;
+    l.lifecycle_timeout_ms = 1000;
+    c.context_generation = 7;
+    return c;
+}
+Transaction Spend(uint8_t id) {
+    Transaction tx;
+    Input i;
+    i.prev_txid[0] = id;
+    i.flags = 1;
+    i.sequence = UINT32_MAX;
+    i.witnesses.push_back({{0x51}, {}, {{7}}});
+    tx.inputs.push_back(i);
+    Output o;
+    o.value = 100;
+    o.branches.push_back(Hash{});
+    o.paths = {{0}};
+    tx.outputs.push_back(o);
+    return tx;
+}
+FramedBlock Block(const DownloadConfig &c, uint64_t nonce = 1) {
+    FramedBlock b;
+    b.header.version = 2;
+    b.header.time = 12345;
+    b.header.bits = 0x207fffff;
+    b.header.nonce = nonce;
+    b.header.height = 1;
+    auto cb = Spend(0);
+    cb.inputs[0].flags = 2;
+    cb.inputs[0].witnesses.clear();
+    b.transactions = {cb, Spend(1), Spend(2)};
+    std::string e;
+    CHECK(CompleteTransactionRoot(b.transactions, c.network.transaction,
+                                  c.network.chain_id, b.header.tx_root, e));
+    b.header.size = HEADER_SIZE + 4;
+    for (const auto &tx : b.transactions) {
+        Bytes wire;
+        CHECK(EncodeTransaction(tx, c.network.transaction, wire, e));
+        b.header.size += wire.size() + CompactSizeWidth(wire.size());
+    }
+    return b;
+}
+Hash Id(const DownloadConfig &c, const Header &h) {
+    Hash id;
+    CHECK(BlockId(c.network.chain_id, h, id));
+    return id;
+}
+Message Full(const DownloadConfig &c, const FramedBlock &b) {
+    Bytes wire;
+    std::string e;
+    CHECK(EncodeBlockWire(b.header, b.transactions, c.network.transaction, wire,
+                          e));
+    return {"block", std::move(wire)};
+}
+Message Compact(const DownloadConfig &c, const FramedBlock &b) {
+    CompactBlock compact;
+    std::string e;
+    const uint32_t first[] = {0};
+    CHECK(MakeCompact(b, c.network, 999, first, compact, e));
+    Bytes wire;
+    CHECK(EncodeCompact(compact, c.network, c.network.receive_limit, wire, e));
+    return {"cmpctblock", std::move(wire)};
+}
+struct Harness {
+    Harness() { trace.reserve(512); } // release hooks must not allocate
+    DownloadConfig config = Config();
+    HeaderDisposition header = HeaderDisposition::Eligible;
+    BodyDisposition body = BodyDisposition::Accepted;
+    ReservationDisposition reservation = ReservationDisposition::Granted;
+    bool throw_header = false, throw_reserve = false, throw_cache = false,
+         throw_body = false;
+    bool bad_lease = false, bad_cache_bytes = false;
+    size_t reserves = 0, releases = 0, live = 0, admissions = 0,
+           cache_calls = 0;
+    uint64_t last_generation = 0;
+    ResourceNeed last_need{};
+    std::function<void()> on_release;
+    std::vector<std::string> trace;
+    std::vector<Transaction> cache;
+    std::vector<Bytes> admitted;
+    struct Lease : DownloadReservation {
+        Harness &h;
+        explicit Lease(Harness &x) : h(x) { ++h.live; }
+        ~Lease() override {
+            --h.live;
+            ++h.releases;
+            h.trace.push_back("release");
+            if (h.on_release) h.on_release();
+        }
+    };
+    DownloadCallbacks Callbacks() {
+        return {
+            [&](const Header &h, uint64_t generation) {
+                trace.push_back("header");
+                last_generation = generation;
+                if (throw_header) throw std::runtime_error("header");
+                return HeaderDecision{header,
+                                      header == HeaderDisposition::MissingParent
+                                          ? std::optional<Hash>(h.prev_id)
+                                          : std::nullopt,
+                                      "header diagnostic"};
+            },
+            [&](PeerHandle, const ResourceNeed &need) {
+                trace.push_back("reserve");
+                ++reserves;
+                CHECK(need.staging_bytes > 0);
+                last_need = need;
+                if (throw_reserve) throw std::runtime_error("reserve");
+                ReservationResult r{reservation, nullptr,
+                                    "reservation diagnostic"};
+                if (reservation == ReservationDisposition::Granted &&
+                    !bad_lease)
+                    r.lease = std::make_unique<Lease>(*this);
+                return r;
+            },
+            [&](const Header &) {
+                trace.push_back("cache");
+                ++cache_calls;
+                CHECK(live > 0);
+                if (throw_cache) throw std::runtime_error("cache");
+                uint64_t bytes = 0;
+                // A deliberately over-count cache must be refused before
+                // manager scans invalid elements; return its bounded-view
+                // metadata directly.
+                if (cache.size() > config.limits.cache_candidates)
+                    return CachedTransactions{cache, 0};
+                for (const auto &tx : cache) {
+                    Bytes raw;
+                    std::string e;
+                    CHECK(EncodeTransaction(tx, config.network.transaction, raw,
+                                            e));
+                    bytes += raw.size();
+                }
+                return CachedTransactions{cache,
+                                          bytes + (bad_cache_bytes ? 1 : 0)};
+            },
+            [&](std::span<const uint8_t> wire, uint64_t generation) {
+                trace.push_back("admit");
+                CHECK(live > 0);
+                ++admissions;
+                last_generation = generation;
+                if (throw_body) throw std::runtime_error("body");
+                // Test admission adapter checks real full framing/roots only.
+                // It is deliberately not a claim of VM/state/monetary consensus
+                // evidence.
+                FramedBlock parsed;
+                std::string e;
+                CHECK(DecodeBlockWire(Bytes(wire.begin(), wire.end()),
+                                      config.network.transaction,
+                                      config.network.chain_id, parsed, e));
+                admitted.emplace_back(wire.begin(), wire.end());
+                return BodyDecision{
+                    body,
+                    body == BodyDisposition::MissingParent
+                        ? std::optional<Hash>(parsed.header.prev_id)
+                        : std::nullopt,
+                    "body diagnostic"};
+            }};
+    }
+    PeerHandle Peer(DownloadManager &m, uint32_t limit = 4096) {
+        auto e = m.RegisterPeer(limit);
+        CHECK(e.result == DownloadResult::Registered);
+        return e.peer;
+    }
+    void Clean(DownloadManager &m) {
+        CHECK(m.Stats().jobs == 0 && m.Stats().staging_bytes == 0 &&
+              m.Stats().transaction_slots == 0 &&
+              m.Stats().deferred_jobs == 0 && live == 0 &&
+              releases == reserves);
+    }
+};
+void FullAndAssociation() {
+    Harness h;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m), other = h.Peer(m);
+    auto b = Block(h.config);
+    auto id = Id(h.config, b.header);
+    auto e = m.RequestBlock(p, b.header, DownloadMode::Full, 0);
+    CHECK(e.result == DownloadResult::Requested &&
+          e.outbound->command == "getdata");
+    std::vector<Inventory> items;
+    std::string error;
+    CHECK(DecodeInventory(e.outbound->payload, 4096, items, error) &&
+          items.size() == 1 && items[0].type == 2 && items[0].hash == id);
+    CHECK(m.RequestBlock(p, b.header, DownloadMode::Full, 1).result ==
+              DownloadResult::Busy &&
+          h.reserves == 1);
+    CHECK(m.OnMessage(other, Full(h.config, b), 2).result ==
+              DownloadResult::Ignored &&
+          m.Stats().jobs == 1);
+    auto wrong = Block(h.config, 2);
+    CHECK(m.OnMessage(p, Full(h.config, wrong), 3).result ==
+              DownloadResult::Ignored &&
+          m.Stats().jobs == 1);
+    CHECK(m.OnMessage(p, Full(h.config, b), 4).result ==
+              DownloadResult::Accepted &&
+          h.admissions == 1);
+    CHECK(h.admitted[0] == Full(h.config, b).payload);
+    h.Clean(m);
+    CHECK(m.Stats().tombstones == 1);
+    CHECK(m.RequestBlock(p, b.header, DownloadMode::Full, 5).result ==
+          DownloadResult::RetryElsewhere);
+    CHECK(m.OnMessage(p, Full(h.config, b), 6).result ==
+          DownloadResult::Ignored);
+    CHECK(m.OnDisconnect(p).result == DownloadResult::Cancelled &&
+          m.Stats().tombstones == 0);
+    auto fresh = h.Peer(m);
+    CHECK(fresh.value > other.value);
+    CHECK(m.RequestBlock(fresh, b.header, DownloadMode::Full, 7).result ==
+          DownloadResult::Requested);
+    m.Cancel(fresh, id);
+    h.Clean(m);
+}
+void CompactPaths() {
+    for (unsigned overlap : {0U, 1U, 2U}) {
+        Harness h;
+        auto b = Block(h.config);
+        if (overlap) h.cache.push_back(b.transactions[1]);
+        if (overlap == 2) h.cache.push_back(b.transactions[2]);
+        DownloadManager m(h.config, h.Callbacks());
+        auto p = h.Peer(m);
+        auto request = m.RequestBlock(p, b.header, DownloadMode::Compact, 0);
+        CHECK(request.result == DownloadResult::Requested);
+        auto e = m.OnMessage(p, Compact(h.config, b), 1);
+        if (overlap < 2) {
+            CHECK(e.result == DownloadResult::NeedTransactions &&
+                  e.outbound->command == "getblocktxn");
+            MissingRequest q;
+            std::string error;
+            CHECK(DecodeMissingRequest(e.outbound->payload, 3, 3, 4096, q,
+                                       error));
+            CHECK(q.indices == (overlap ? std::vector<uint32_t>{2}
+                                        : std::vector<uint32_t>{1, 2}));
+            MissingResponse r{q.block_id, {}};
+            for (auto idx : q.indices)
+                r.transactions.push_back(b.transactions[idx]);
+            Bytes raw;
+            CHECK(EncodeMissingResponse(r, h.config.network, 4096, raw, error));
+            CHECK(m.OnMessage(p, {"blocktxn", raw}, 2).result ==
+                  DownloadResult::Accepted);
+            CHECK(m.OnMessage(p, {"blocktxn", raw}, 3).result ==
+                  DownloadResult::Ignored);
+        } else
+            CHECK(e.result == DownloadResult::Accepted);
+        CHECK(h.admitted[0] == Full(h.config, b).payload);
+        CHECK(h.trace.front() == "header");
+        auto reserved = std::find(h.trace.begin(), h.trace.end(), "reserve"),
+             cached = std::find(h.trace.begin(), h.trace.end(), "cache"),
+             admitted = std::find(h.trace.begin(), h.trace.end(), "admit");
+        CHECK(reserved < cached && cached < admitted);
+        h.Clean(m);
+    }
+    Harness h;
+    auto b = Block(h.config);
+    h.cache = b.transactions;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m);
+    m.RequestBlock(p, b.header, DownloadMode::Compact, 0);
+    auto c = Compact(h.config, b);
+    c.payload.push_back(0);
+    CHECK(m.OnMessage(p, c, 1).result == DownloadResult::PeerMessageInvalid &&
+          h.admissions == 0);
+    h.Clean(m);
+}
+void FallbackAndCacheBounds() {
+    Harness h;
+    auto b = Block(h.config);
+    h.cache = b.transactions;
+    auto bad = b;
+    bad.header.tx_root[0] ^= 1;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m);
+    CHECK(m.RequestBlock(p, bad.header, DownloadMode::Compact, 0).result ==
+          DownloadResult::Requested);
+    auto e = m.OnMessage(p, Compact(h.config, bad), 1);
+    CHECK(e.result == DownloadResult::Requested &&
+          e.outbound->command == "getdata");
+    // A wrong committed root triggers retrieval without a consensus-invalid
+    // verdict. Cancel this artificial root; valid-body recovery is below.
+    m.Cancel(p, Id(h.config, bad.header));
+    h.Clean(m);
+    // A duplicate compact short ID allows valid full-body recovery unchanged.
+    Harness recovery;
+    auto valid = Block(recovery.config);
+    DownloadManager r(recovery.config, recovery.Callbacks());
+    auto peer = recovery.Peer(r);
+    r.RequestBlock(peer, valid.header, DownloadMode::Compact, 0);
+    CompactBlock compact;
+    const uint32_t first[] = {0};
+    std::string error;
+    CHECK(MakeCompact(valid, recovery.config.network, 999, first, compact,
+                      error));
+    compact.short_ids[1] = compact.short_ids[0];
+    Bytes raw;
+    CHECK(EncodeCompact(compact, recovery.config.network, 4096, raw, error));
+    CHECK(r.OnMessage(peer, {"cmpctblock", raw}, 1).result ==
+          DownloadResult::Requested);
+    CHECK(r.OnMessage(peer, {"cmpctblock", raw}, 2).result ==
+          DownloadResult::Ignored);
+    CHECK(r.OnMessage(peer, Full(recovery.config, valid), 3).result ==
+          DownloadResult::Accepted);
+    recovery.Clean(r);
+    Harness huge;
+    huge.cache.resize(huge.config.limits.cache_candidates + 1);
+    DownloadManager bounded(huge.config, huge.Callbacks());
+    auto hp = huge.Peer(bounded);
+    bounded.RequestBlock(hp, b.header, DownloadMode::Compact, 0);
+    CHECK(bounded.OnMessage(hp, Compact(huge.config, b), 1).result ==
+              DownloadResult::Requested &&
+          huge.admissions ==
+              0); // fallback, no invalid empty cache entries scanned
+    CHECK(bounded.OnMessage(hp, Full(huge.config, b), 2).result ==
+          DownloadResult::Accepted);
+    huge.Clean(bounded);
+    Harness stale;
+    stale.cache = {b.transactions[1]};
+    stale.bad_cache_bytes = true;
+    DownloadManager stale_manager(stale.config, stale.Callbacks());
+    auto sp = stale.Peer(stale_manager);
+    stale_manager.RequestBlock(sp, b.header, DownloadMode::Compact, 0);
+    CHECK(stale_manager.OnMessage(sp, Compact(stale.config, b), 1).result ==
+              DownloadResult::OperationalFailure &&
+          stale.admissions == 0);
+    stale.Clean(stale_manager);
+}
+void TimeCancelReorg() {
+    Harness h;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m);
+    auto b = Block(h.config), other = Block(h.config, 2);
+    auto id = Id(h.config, b.header);
+    m.RequestBlock(p, b.header, DownloadMode::Compact, 0);
+    CHECK(m.OnMessage(p, {"unknown", {}}, 99).result ==
+          DownloadResult::Ignored);
+    CHECK(m.RequestBlock(p, b.header, DownloadMode::Compact, 99).result ==
+          DownloadResult::Busy);
+    CHECK(m.PollTimeout(100).result == DownloadResult::RetryElsewhere);
+    h.Clean(m);
+    CHECK(m.OnMessage(p, Compact(h.config, b), 100).result ==
+          DownloadResult::Ignored);
+    CHECK(m.RequestBlock(p, b.header, DownloadMode::Compact, 100).result ==
+          DownloadResult::RetryElsewhere);
+    m.RequestBlock(p, other.header, DownloadMode::Full, 101);
+    CHECK(m.Cancel(p, Id(h.config, other.header)).result ==
+          DownloadResult::Cancelled);
+    h.Clean(m);
+    auto third = Block(h.config, 3);
+    m.RequestBlock(p, third.header, DownloadMode::Compact, 102);
+    auto event = m.OnReorg(8);
+    CHECK(event.result == DownloadResult::Cancelled &&
+          event.affected.size() == 1);
+    h.Clean(m);
+    CHECK(m.Stats().tombstones == 3);
+    CHECK(m.RequestBlock(p, third.header, DownloadMode::Compact, 103).result ==
+          DownloadResult::RetryElsewhere);
+    CHECK(m.OnMessage(p, Compact(h.config, third), 103).result ==
+          DownloadResult::Ignored);
+    CHECK(m.OnReorg(8).result == DownloadResult::OperationalFailure);
+    m.OnDisconnect(p);
+    auto fresh = h.Peer(m);
+    CHECK(m.RequestBlock(fresh, b.header, DownloadMode::Full, 104).result ==
+              DownloadResult::Requested &&
+          h.last_generation == 8);
+    m.Cancel(fresh, id);
+    h.Clean(m);
+    CHECK(m.PollTimeout(103).result == DownloadResult::OperationalFailure);
+}
+void DeferredRecovery() {
+    Harness h;
+    h.header = HeaderDisposition::MissingParent;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m);
+    auto b = Block(h.config);
+    CHECK(m.RequestBlock(p, b.header, DownloadMode::Compact, 0).result ==
+              DownloadResult::NeedHeaders &&
+          h.reserves == 0 && m.Stats().deferred_jobs == 1);
+    CHECK(m.PollTimeout(9).result == DownloadResult::Idle);
+    CHECK(m.PollTimeout(10).result == DownloadResult::NeedHeaders &&
+          h.reserves == 0);
+    h.header = HeaderDisposition::Eligible;
+    CHECK(m.PollTimeout(20).result == DownloadResult::Requested &&
+          h.reserves == 1 && m.Stats().deferred_jobs == 0);
+    h.body = BodyDisposition::Deferred;
+    CHECK(m.OnMessage(p, Full(h.config, b), 21).result ==
+              DownloadResult::Deferred &&
+          h.live == 1 && m.Stats().deferred_jobs == 1);
+    h.body = BodyDisposition::Accepted;
+    CHECK(m.PollTimeout(31).result == DownloadResult::Accepted &&
+          h.admitted.size() == 2);
+    h.Clean(m);
+    Harness pending;
+    pending.body = BodyDisposition::MissingParent;
+    DownloadManager body(pending.config, pending.Callbacks());
+    auto peer = pending.Peer(body);
+    body.RequestBlock(peer, b.header, DownloadMode::Full, 0);
+    CHECK(body.OnMessage(peer, Full(pending.config, b), 1).result ==
+          DownloadResult::NeedHeaders);
+    pending.body = BodyDisposition::Accepted;
+    CHECK(body.PollTimeout(11).result == DownloadResult::Accepted);
+    pending.Clean(body);
+    Harness expire;
+    expire.header = HeaderDisposition::Deferred;
+    DownloadManager deferred(expire.config, expire.Callbacks());
+    auto ep = expire.Peer(deferred);
+    deferred.RequestBlock(ep, b.header, DownloadMode::Full, 0);
+    for (uint64_t now = 10; now < 500; now += 10)
+        CHECK(deferred.PollTimeout(now).result == DownloadResult::Deferred);
+    CHECK(deferred.PollTimeout(500).result == DownloadResult::RetryElsewhere &&
+          expire.reserves == 0);
+    CHECK(deferred.Stats().jobs == 0);
+}
+void OutcomesAndExceptions() {
+    for (auto disposition :
+         {BodyDisposition::Accepted, BodyDisposition::MalformedBody,
+          BodyDisposition::ConsensusInvalid, BodyDisposition::CapacityRefused,
+          BodyDisposition::Unsupported, BodyDisposition::StorageError,
+          BodyDisposition::ContextChanged}) {
+        Harness h;
+        h.body = disposition;
+        DownloadManager m(h.config, h.Callbacks());
+        auto p = h.Peer(m);
+        auto b = Block(h.config);
+        m.RequestBlock(p, b.header, DownloadMode::Full, 0);
+        auto e = m.OnMessage(p, Full(h.config, b), 1);
+        CHECK(e.admission == disposition);
+        DownloadResult expected =
+            disposition == BodyDisposition::Accepted ? DownloadResult::Accepted
+            : disposition == BodyDisposition::MalformedBody
+                ? DownloadResult::PeerMessageInvalid
+            : disposition == BodyDisposition::ConsensusInvalid
+                ? DownloadResult::ConsensusRejected
+            : disposition == BodyDisposition::CapacityRefused
+                ? DownloadResult::CapacityRefused
+            : disposition == BodyDisposition::Unsupported
+                ? DownloadResult::Unsupported
+            : disposition == BodyDisposition::StorageError
+                ? DownloadResult::OperationalFailure
+                : DownloadResult::RetryElsewhere;
+        CHECK(e.result == expected);
+        h.Clean(m);
+    }
+    for (auto disposition :
+         {HeaderDisposition::ConsensusInvalid, HeaderDisposition::Unsupported,
+          HeaderDisposition::OperationalError}) {
+        Harness h;
+        h.header = disposition;
+        DownloadManager m(h.config, h.Callbacks());
+        auto p = h.Peer(m);
+        auto e =
+            m.RequestBlock(p, Block(h.config).header, DownloadMode::Full, 0);
+        CHECK(e.result == (disposition == HeaderDisposition::ConsensusInvalid
+                               ? DownloadResult::ConsensusRejected
+                           : disposition == HeaderDisposition::Unsupported
+                               ? DownloadResult::Unsupported
+                               : DownloadResult::OperationalFailure));
+        CHECK(h.reserves == 0 && m.Stats().jobs == 0);
+    }
+    for (unsigned failure = 0; failure < 4; ++failure) {
+        Harness h;
+        h.throw_header = failure == 0;
+        h.throw_reserve = failure == 1;
+        h.throw_cache = failure == 2;
+        h.throw_body = failure == 3;
+        DownloadManager m(h.config, h.Callbacks());
+        auto p = h.Peer(m);
+        auto b = Block(h.config);
+        auto e = m.RequestBlock(
+            p, b.header,
+            failure == 2 ? DownloadMode::Compact : DownloadMode::Full, 0);
+        if (failure >= 2)
+            e = m.OnMessage(
+                p, failure == 2 ? Compact(h.config, b) : Full(h.config, b), 1);
+        CHECK(e.result == DownloadResult::OperationalFailure &&
+              m.Stats().jobs == 0 && m.Stats().staging_bytes == 0 &&
+              h.live == 0);
+    }
+    Harness denied;
+    denied.reservation = ReservationDisposition::CapacityRefused;
+    DownloadManager m(denied.config, denied.Callbacks());
+    auto p = denied.Peer(m);
+    CHECK(m.RequestBlock(p, Block(denied.config).header, DownloadMode::Full, 0)
+                  .result == DownloadResult::CapacityRefused &&
+          m.Stats().tombstones == 0 && denied.live == 0);
+    Harness invalid;
+    invalid.bad_lease = true;
+    DownloadManager bad(invalid.config, invalid.Callbacks());
+    auto peer = invalid.Peer(bad);
+    CHECK(bad.RequestBlock(peer, Block(invalid.config).header,
+                           DownloadMode::Full, 0)
+                  .result == DownloadResult::OperationalFailure &&
+          bad.Stats().jobs == 0);
+}
+void QuotasAndControl() {
+    Harness h;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m), other = h.Peer(m), third = h.Peer(m);
+    CHECK(m.RegisterPeer(4096).result == DownloadResult::CapacityRefused);
+    auto b = Block(h.config), b2 = Block(h.config, 2), b3 = Block(h.config, 3),
+         b4 = Block(h.config, 4);
+    m.RequestBlock(p, b.header, DownloadMode::Full, 0);
+    m.RequestBlock(p, b2.header, DownloadMode::Full, 0);
+    CHECK(m.RequestBlock(p, b3.header, DownloadMode::Full, 0).result ==
+          DownloadResult::CapacityRefused);
+    m.RequestBlock(other, b3.header, DownloadMode::Full, 0);
+    m.RequestBlock(other, b4.header, DownloadMode::Full, 0);
+    CHECK(m.RequestBlock(third, b.header, DownloadMode::Full, 0).result ==
+          DownloadResult::CapacityRefused);
+    Inventory absent[] = {{2, Id(h.config, b.header)},
+                          {2, Id(h.config, b2.header)},
+                          {99, Id(h.config, b3.header)}};
+    Bytes wire;
+    std::string error;
+    CHECK(EncodeInventory(absent, 4096, wire, error));
+    auto event = m.OnMessage(p, {"notfound", wire}, 1);
+    CHECK(event.result == DownloadResult::RetryElsewhere &&
+          event.affected.size() == 2 && m.Stats().jobs == 2);
+    m.OnDisconnect(other);
+    m.OnDisconnect(third);
+    h.Clean(m);
+    CHECK(m.RequestBlock(p, b3.header, DownloadMode::Full, 2).result ==
+          DownloadResult::Requested);
+    m.Cancel(p, Id(h.config, b3.header));
+    CHECK(m.Stats().tombstones == 3);
+    CHECK(m.RequestBlock(p, b4.header, DownloadMode::Full, 3).result ==
+              DownloadResult::CapacityRefused &&
+          m.Stats().jobs == 0);
+    m.OnDisconnect(p);
+    CHECK(m.Stats().tombstones == 0);
+    auto tiny = h.Peer(m, 1);
+    CHECK(m.RequestBlock(tiny, b.header, DownloadMode::Full, 4).result ==
+              DownloadResult::CapacityRefused &&
+          m.Stats().jobs == 0 && m.Stats().tombstones == 0);
+    CHECK(m.OnMessage(tiny, {"block", Full(h.config, b).payload}, 5).result ==
+          DownloadResult::PeerMessageInvalid);
+    CHECK(m.RegisterPeer(0).result == DownloadResult::OperationalFailure &&
+          m.RegisterPeer(4097).result == DownloadResult::OperationalFailure);
+    PeerHandle next{17};
+    CHECK(!NextPeerHandle(UINT64_MAX, next) && next.value == 17);
+    CHECK(NextPeerHandle(UINT64_MAX - 1, next) && next.value == UINT64_MAX);
+    CHECK(m.RequestBlock(tiny, b.header, DownloadMode::Full, UINT64_MAX - 1)
+              .result == DownloadResult::OperationalFailure);
+}
+void CapacityFallbackAndInvalidResponses() {
+    Harness h;
+    h.config.network.max_reconstruction_transactions = 1;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m);
+    auto normal = Config();
+    auto b = Block(normal);
+    CHECK(m.RequestBlock(p, b.header, DownloadMode::Compact, 0).result ==
+          DownloadResult::Requested);
+    CHECK(h.last_need.transaction_slots >= (4096 / 17) * 4 &&
+          h.last_need.staging_bytes >= 4096 * 4);
+    auto event = m.OnMessage(p, Compact(normal, b), 1);
+    CHECK(event.result == DownloadResult::Requested &&
+          event.fallback == FallbackReason::CompactCapacity);
+    CHECK(m.OnMessage(p, Full(normal, b), 2).result ==
+          DownloadResult::Accepted);
+    h.Clean(m);
+    Harness small;
+    DownloadManager limited(small.config, small.Callbacks());
+    auto peer = small.Peer(limited, 300);
+    CHECK(Compact(small.config, b).payload.size() <= 300 &&
+          Full(small.config, b).payload.size() > 300);
+    CHECK(
+        limited.RequestBlock(peer, b.header, DownloadMode::Compact, 0).result ==
+        DownloadResult::Requested);
+    CompactBlock c;
+    const uint32_t first[] = {0};
+    std::string error;
+    CHECK(MakeCompact(b, small.config.network, 999, first, c, error));
+    c.short_ids[1] = c.short_ids[0];
+    Bytes raw;
+    CHECK(EncodeCompact(c, small.config.network, 300, raw, error));
+    CHECK(limited.OnMessage(peer, {"cmpctblock", raw}, 1).result ==
+          DownloadResult::RetryElsewhere);
+    small.Clean(limited);
+    Harness invalid;
+    DownloadManager invalid_manager(invalid.config, invalid.Callbacks());
+    auto ip = invalid.Peer(invalid_manager);
+    invalid_manager.RequestBlock(ip, b.header, DownloadMode::Compact, 0);
+    CHECK(invalid_manager.OnMessage(ip, Compact(invalid.config, b), 1).result ==
+          DownloadResult::NeedTransactions);
+    MissingResponse response{Id(invalid.config, b.header), {b.transactions[1]}};
+    CHECK(EncodeMissingResponse(response, invalid.config.network, 4096, raw,
+                                error));
+    CHECK(invalid_manager.OnMessage(ip, {"blocktxn", raw}, 2).result ==
+              DownloadResult::PeerMessageInvalid &&
+          invalid.admissions == 0);
+    invalid.Clean(invalid_manager);
+    Harness size;
+    DownloadManager sizes(size.config, size.Callbacks());
+    auto sp = size.Peer(sizes);
+    sizes.RequestBlock(sp, b.header, DownloadMode::Full, 0);
+    auto wrong = Full(size.config, b);
+    wrong.payload.push_back(0);
+    CHECK(sizes.OnMessage(sp, wrong, 1).result ==
+              DownloadResult::PeerMessageInvalid &&
+          size.admissions == 0);
+    size.Clean(sizes);
+}
+void ReentryAndAllocationUnwind() {
+    Harness h;
+    DownloadManager m(h.config, h.Callbacks());
+    auto p = h.Peer(m);
+    auto b = Block(h.config);
+    bool blocked = false;
+    h.on_release = [&] {
+        blocked =
+            m.OnDisconnect(p).result == DownloadResult::OperationalFailure;
+    };
+    m.RequestBlock(p, b.header, DownloadMode::Full, 0);
+    CHECK(m.Cancel(p, Id(h.config, b.header)).result ==
+              DownloadResult::Cancelled &&
+          blocked && m.Stats().peers == 1);
+    h.Clean(m);
+    size_t propagated = 0;
+    for (int fault = 0; fault < 220; ++fault) {
+        Harness inject;
+        inject.cache = b.transactions;
+        DownloadManager manager(inject.config, inject.Callbacks());
+        auto peer = inject.Peer(manager);
+        CHECK(manager.RequestBlock(peer, b.header, DownloadMode::Compact, 0)
+                  .result == DownloadResult::Requested);
+        auto message = Compact(inject.config, b);
+        bool threw = false;
+        fail_allocation_after = fault;
+        try {
+            manager.OnMessage(peer, message, 1);
+        } catch (const std::bad_alloc &) {
+            threw = true;
+        }
+        fail_allocation_after = -1;
+        CHECK(manager.Stats().jobs == 0 && manager.Stats().staging_bytes == 0 &&
+              manager.Stats().transaction_slots == 0 && inject.live == 0);
+        if (threw) {
+            ++propagated;
+            CHECK(manager
+                      .RequestBlock(peer, Block(inject.config, 2).header,
+                                    DownloadMode::Full, 2)
+                      .result == DownloadResult::OperationalFailure);
+        }
+        manager.OnDisconnect(peer);
+        CHECK(manager.Stats().tombstones == 0);
+    }
+    CHECK(propagated > 0);
+    Harness reorg;
+    DownloadManager pending(reorg.config, reorg.Callbacks());
+    auto a = reorg.Peer(pending), c = reorg.Peer(pending);
+    pending.RequestBlock(a, b.header, DownloadMode::Full, 0);
+    pending.RequestBlock(c, b.header, DownloadMode::Full, 0);
+    bool failed = false;
+    fail_allocation_after = 0;
+    try {
+        pending.OnReorg(8);
+    } catch (const std::bad_alloc &) {
+        failed = true;
+    }
+    fail_allocation_after = -1;
+    CHECK(failed && pending.Stats().jobs == 0 &&
+          pending.Stats().staging_bytes == 0 && reorg.live == 0 &&
+          pending.Stats().tombstones == 2);
+    CHECK(pending
+              .RequestBlock(a, Block(reorg.config, 2).header,
+                            DownloadMode::Full, 1)
+              .result == DownloadResult::OperationalFailure);
+    pending.OnDisconnect(a);
+    pending.OnDisconnect(c);
+    CHECK(pending.Stats().tombstones == 0);
+}
+void ResourceAndGlobalBounds() {
+    auto template_config = Config();
+    auto b = Block(template_config);
+    // Exercise bytes and slots independently of job-count admission.
+    for (unsigned resource = 0; resource < 3; ++resource) {
+        Harness h;
+        if (resource == 0) h.config.limits.staging_bytes_per_peer = 28672;
+        if (resource == 1) {
+            h.config.limits.staging_bytes_per_peer = 28672;
+            h.config.limits.staging_bytes_global = 28672;
+        }
+        if (resource == 2) {
+            h.config.limits.transaction_slots_per_peer = 960;
+            h.config.limits.transaction_slots_global = 960;
+        }
+        DownloadManager m(h.config, h.Callbacks());
+        auto p = h.Peer(m), q = h.Peer(m);
+        CHECK(m.RequestBlock(p, b.header, DownloadMode::Compact, 0).result ==
+              DownloadResult::Requested);
+        auto second = resource == 0 ? p : q;
+        auto other = Block(h.config, 2);
+        CHECK(m.RequestBlock(second, other.header, DownloadMode::Compact, 1)
+                  .result == DownloadResult::CapacityRefused);
+        CHECK(m.Stats().jobs == 1 && h.reserves == 1 && h.live == 1);
+        m.Cancel(p, Id(h.config, b.header));
+        h.Clean(m);
+        CHECK(m.RequestBlock(second, other.header, DownloadMode::Compact, 2)
+                  .result == DownloadResult::Requested);
+        m.Cancel(second, Id(h.config, other.header));
+        h.Clean(m);
+    }
+    Harness guards;
+    guards.config.limits.jobs_per_peer = 1;
+    guards.config.limits.jobs_global = 2;
+    guards.config.limits.tombstones_per_peer = 2;
+    guards.config.limits.tombstones_global = 2;
+    DownloadManager tombstones(guards.config, guards.Callbacks());
+    auto p = guards.Peer(tombstones), q = guards.Peer(tombstones),
+         r = guards.Peer(tombstones);
+    tombstones.RequestBlock(p, b.header, DownloadMode::Full, 0);
+    tombstones.Cancel(p, Id(guards.config, b.header));
+    tombstones.RequestBlock(q, b.header, DownloadMode::Full, 1);
+    tombstones.Cancel(q, Id(guards.config, b.header));
+    CHECK(tombstones.Stats().tombstones == 2);
+    CHECK(tombstones.RequestBlock(r, b.header, DownloadMode::Full, 2).result ==
+          DownloadResult::CapacityRefused);
+    tombstones.OnDisconnect(p);
+    CHECK(tombstones.RequestBlock(r, b.header, DownloadMode::Full, 3).result ==
+          DownloadResult::Requested);
+    tombstones.Cancel(r, Id(guards.config, b.header));
+    guards.Clean(tombstones);
+    Harness pending;
+    pending.header = HeaderDisposition::MissingParent;
+    DownloadManager deferred(pending.config, pending.Callbacks());
+    auto a = pending.Peer(deferred), d = pending.Peer(deferred);
+    CHECK(deferred.RequestBlock(a, b.header, DownloadMode::Full, 0).result ==
+          DownloadResult::NeedHeaders);
+    auto b2 = Block(pending.config, 2), b3 = Block(pending.config, 3);
+    CHECK(deferred.RequestBlock(a, b2.header, DownloadMode::Full, 0).result ==
+          DownloadResult::NeedHeaders);
+    CHECK(deferred.RequestBlock(d, b3.header, DownloadMode::Full, 0).result ==
+          DownloadResult::CapacityRefused);
+    CHECK(deferred.Stats().deferred_jobs == 2 && pending.reserves == 0);
+    CHECK(deferred.OnReorg(8).affected.size() == 2 &&
+          deferred.Stats().deferred_jobs == 0 && deferred.Stats().jobs == 0);
+    Harness changed;
+    DownloadManager current(changed.config, changed.Callbacks());
+    auto cp = changed.Peer(current);
+    current.RequestBlock(cp, b.header, DownloadMode::Compact, 0);
+    changed.header = HeaderDisposition::Unsupported;
+    CHECK(current.OnMessage(cp, Compact(changed.config, b), 1).result ==
+              DownloadResult::Unsupported &&
+          changed.cache_calls == 0 && changed.admissions == 0);
+    changed.Clean(current);
+}
