+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_PEER_DOWNLOAD_H
+#define LOTUS_V2_PEER_DOWNLOAD_H
+#include "peer_codec.h"
+#include <functional>
+#include <memory>
+namespace lotus::v2::peer {
+struct PeerHandle {
+    uint64_t value = 0;
+    auto operator<=>(const PeerHandle &) const = default;
+};
+bool NextPeerHandle(uint64_t previous, PeerHandle &out);
+enum class DownloadMode { Full, Compact };
+enum class HeaderDisposition {
+    Eligible,
+    MissingParent,
+    Deferred,
+    ConsensusInvalid,
+    Unsupported,
+    OperationalError
+};
+struct HeaderDecision {
+    HeaderDisposition disposition;
+    std::optional<Hash> missing_parent;
+    std::string diagnostic;
+};
+enum class BodyDisposition {
+    Accepted,
+    MalformedBody,
+    ConsensusInvalid,
+    MissingParent,
+    Deferred,
+    CapacityRefused,
+    Unsupported,
+    StorageError,
+    ContextChanged
+};
+struct BodyDecision {
+    BodyDisposition disposition;
+    std::optional<Hash> missing_parent;
+    std::string diagnostic;
+};
+struct ResourceNeed {
+    uint64_t staging_bytes;
+    uint32_t transaction_slots;
+};
+class DownloadReservation {
+public:
+    virtual ~DownloadReservation() = default; // implementation must not throw
+};
+enum class ReservationDisposition {
+    Granted,
+    CapacityRefused,
+    OperationalError
+};
+struct ReservationResult {
+    ReservationDisposition disposition;
+    std::unique_ptr<DownloadReservation> lease;
+    std::string diagnostic;
+};
+struct DownloadLimits {
+    uint32_t peers, jobs_per_peer, jobs_global;
+    uint32_t tombstones_per_peer, tombstones_global;
+    uint32_t deferred_jobs_global;
+    uint32_t cache_candidates;
+    uint64_t cache_bytes;
+    uint64_t staging_bytes_per_peer, staging_bytes_global;
+    uint32_t transaction_slots_per_peer, transaction_slots_global;
+    uint64_t request_timeout_ms, deferred_timeout_ms, retry_interval_ms;
+    uint64_t lifecycle_timeout_ms;
+};
+struct DownloadConfig {
+    NetworkProfile network;
+    DownloadLimits limits;
+    uint64_t context_generation;
+};
+struct CachedTransactions {
+    std::span<const Transaction> transactions;
+    uint64_t complete_wire_bytes; // canonical total, independently preflighted
+};
+struct DownloadCallbacks {
+    std::function<HeaderDecision(const Header &, uint64_t)> check_header;
+    std::function<ReservationResult(PeerHandle, const ResourceNeed &)> reserve;
+    // Borrowed complete validated transactions, stable until Start returns.
+    // Called only after a lease is granted; no pointer is retained afterward.
+    std::function<CachedTransactions(const Header &)> cached_transactions;
+    // Synchronous, borrowed full bytes under a live lease. Accepted must mean
+    // the enclosing validator's intended atomic admission completed. No pointer
+    // survives this callback unless the enclosing runtime separately owns it.
+    std::function<BodyDecision(std::span<const uint8_t>, uint64_t)> admit_body;
+};
+enum class DownloadResult {
+    Idle,
+    Registered,
+    Requested,
+    NeedTransactions,
+    NeedHeaders,
+    Deferred,
+    Accepted,
+    ConsensusRejected,
+    PeerMessageInvalid,
+    CapacityRefused,
+    Unsupported,
+    OperationalFailure,
+    RetryElsewhere,
+    Cancelled,
+    Ignored,
+    Busy
+};
+enum class FallbackReason {
+    Reconstruction,
+    CompactCapacity,
+    CacheCapacity,
+    MissingRequestCapacity
+};
+struct DownloadEvent {
+    DownloadResult result = DownloadResult::Idle;
+    PeerHandle peer;
+    Hash block_id{};
+    std::optional<Hash> missing_parent;
+    std::optional<Message> outbound; // at most one bounded application message
+    std::optional<BodyDisposition> admission;
+    std::optional<FallbackReason> fallback;
+    // Batched notfound/reorg/disconnect notices, bounded by configured jobs.
+    std::vector<Hash> affected;
+    std::string diagnostic;
+};
+struct DownloadStats {
+    uint32_t peers = 0, jobs = 0, tombstones = 0, deferred_jobs = 0;
+    uint64_t staging_bytes = 0;
+    uint32_t transaction_slots = 0;
+};
+// Single-owner, socket-free block coordinator. Callbacks/lease destructors must
+// not reenter mutating methods; attempted reentry returns OperationalFailure.
+// Configuration is explicit;
+// inconsistent/zero limits throw invalid_argument. No permanent-invalid cache,
+// best-chain selection, profile adoption, serving or service advertising.
+// Allocation exceptions propagate after aborting the peer's work (all work for
+// a global operation), releasing leases and disabling the peer(s). Tombstones
+// survive until runtime closes sessions and calls OnDisconnect. Backend storage
+// and validator caches need separate budgets. An admission exception/storage
+// failure may follow an external commit: reconcile authoritative tip; no
+// rollback or no-mutation promise is made by this coordinator. Session framing
+// buffers and event queues are enclosing-runtime resources.
+class DownloadManager {
+public:
+    DownloadManager(DownloadConfig, DownloadCallbacks);
+    ~DownloadManager();
+    DownloadManager(const DownloadManager &) = delete;
+    DownloadManager &operator=(const DownloadManager &) = delete;
+    DownloadEvent
+    RegisterPeer(uint32_t negotiated_limit); // activated session only
+    DownloadEvent RequestBlock(PeerHandle, const Header &, DownloadMode,
+                               uint64_t monotonic_ms);
+    DownloadEvent OnMessage(PeerHandle, const Message &, uint64_t monotonic_ms);
+    DownloadEvent PollTimeout(uint64_t monotonic_ms); // one due job per call
+    DownloadEvent Cancel(PeerHandle, const Hash &block_id);
+    DownloadEvent
+    OnReorg(uint64_t new_context_generation); // immediate bounded cleanup
+    DownloadEvent OnDisconnect(PeerHandle);
+    DownloadStats Stats() const;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+} // namespace lotus::v2::peer
+#endif
