From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:23:39 -0700
Subject: [PATCH] feat(v2): isolate explorer schema3 index from previous
 Chronik data

---
 src/lotus_v2/development_node_command.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index d2255d56088a04f937cba81ecbfb7fd8869cc446..34eb15737105d0a29bc3a3476108db3dadb8af57 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -705,7 +705,8 @@ namespace {
     void Node::OpenChronik(const std::string &directory) {
 #ifdef LOTUS_V2_CHRONIK_CXX
         if (!network.chronik_bind) return;
-        const auto path = directory + "/chronik-v2";
+        // Schema 3 uses a fresh index; preserve earlier schema 2 data.
+        const auto path = directory + "/chronik-v2-explorer-v1";
         chronik_v2::Binding binding{};
         binding.chain_id = manifest.hp.chain_id;
         binding.genesis = manifest.hp.genesis_id;
