From cecfdc1ed69c60c72ad5457a0f99c88e8b1e8a01 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 13:04:42 -0700
Subject: [PATCH] Test dispatcher clock samples and duplicate active fetch Busy

---
 src/lotus_v2/test_peer_dispatcher.cpp | 83 +++++++++++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/src/lotus_v2/test_peer_dispatcher.cpp b/src/lotus_v2/test_peer_dispatcher.cpp
index 08b16cd0399f224e3815b95db4ce33345183018a..ae20d649c4199ff3f8c2a10d478869d23da37791 100644
--- a/src/lotus_v2/test_peer_dispatcher.cpp
+++ b/src/lotus_v2/test_peer_dispatcher.cpp
@@ -1047,9 +1047,92 @@ void SmallServingQueryBudgets() {
     std::cout << "PASS full/getblocktxn query budget1 and cold compact query "
                  "budget2\n";
 }
+
+void HeaderClockSampleAndDuplicateRequest() {
+    {
+        Pipe outgoing, incoming;
+        MemoryStream stream(incoming, outgoing);
+        Node node(stream, 111);
+        Check(!node.dispatcher->HeaderClock(),
+              "header clock absent before first Tick");
+        Check(node.dispatcher->Open(node.connection, 1) ==
+                  DispatcherResult::Queued,
+              "clock test opens transport");
+        Check(!node.dispatcher->HeaderClock(),
+              "Open does not invent a wall-clock sample");
+        node.dispatcher->Tick(2, 123456, 77, DispatcherStep());
+        auto clock = node.dispatcher->HeaderClock();
+        Check(clock && clock->wall_seconds == 123456 &&
+                  clock->future_window == 77,
+              "HeaderClock accessor returns exact caller Tick sample");
+        node.dispatcher->Tick(3, 222222, 88, DispatcherStep());
+        clock = node.dispatcher->HeaderClock();
+        Check(clock && clock->wall_seconds == 222222 &&
+                  clock->future_window == 88,
+              "next Tick replaces both sampled clock fields exactly");
+    }
+    {
+        Pair p;
+        Seed(*p.b.runtime, {0});
+        std::string error;
+        HeaderAdmission out;
+        Check(p.a.runtime->AdmitHeader(HeaderOf(V(0)), out, error) ==
+                  DevelopmentRuntimeResult::Progress,
+              "duplicate request header authenticated");
+        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(0)),
+                                           DownloadMode::Full,
+                                           p.ms) == DispatcherResult::Queued,
+              "original body job starts");
+        p.a.Poll(p.ms++); // clear the dispatcher output slot without serving
+        const auto before = p.a.manager->Stats();
+        const auto bytes = p.a.staging.live_bytes, grants = p.a.staging.grants,
+                   releases = p.a.staging.releases;
+        const auto slots = p.a.staging.live_slots;
+        Check(before.jobs == 1 && bytes > 0,
+              "original job and lease remain live");
+        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(0)),
+                                           DownloadMode::Full,
+                                           p.ms) == DispatcherResult::Busy,
+              "duplicate live manager job returns DispatcherResult Busy");
+        const auto after = p.a.manager->Stats();
+        Check(after.jobs == before.jobs &&
+                  after.staging_bytes == before.staging_bytes &&
+                  after.transaction_slots == before.transaction_slots &&
+                  after.tombstones == before.tombstones &&
+                  after.deferred_jobs == before.deferred_jobs &&
+                  p.a.staging.live_bytes == bytes &&
+                  p.a.staging.live_slots == slots &&
+                  p.a.staging.grants == grants &&
+                  p.a.staging.releases == releases,
+              "duplicate Busy preserves exact existing job reservations");
+        bool busy_notice = false;
+        while (auto notice = p.a.dispatcher->TakeNotice())
+            if (notice->download)
+                busy_notice |=
+                    notice->download->result == DownloadResult::Busy &&
+                    notice->download->block_id == H(V(0).id) &&
+                    !notice->download->outbound;
+        Check(busy_notice, "duplicate Busy download event remains observable");
+        for (unsigned n = 0; n < 200 && !p.a.Stable(0); ++n) {
+            p.Cycle();
+            p.a.runtime->Tick(UINT64_MAX, 0, TickLimits());
+        }
+        Check(p.a.Stable(0), "original job completes after duplicate request");
+        Match(*p.a.runtime, 0);
+        Check(p.a.admissions == 1 && p.a.manager->Stats().jobs == 0 &&
+                  p.a.staging.live_bytes == 0 && p.a.staging.grants == grants &&
+                  p.a.staging.releases == releases + 1 && p.a.Active() &&
+                  p.b.Active(),
+              "duplicate request causes no extra body admission, lease or "
+              "connection closure");
+    }
+    std::cout << "PASS exact header clock sampling and duplicate active-job "
+                 "Busy preservation\n";
+}
 } // namespace
 int main() {
     try {
+        HeaderClockSampleAndDuplicateRequest();
         SmallServingQueryBudgets();
         BaselineActualSync();
         CompactMissingAndFallback();
