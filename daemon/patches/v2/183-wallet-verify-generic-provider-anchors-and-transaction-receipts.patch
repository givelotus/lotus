From a8106474da61e24552c7ddaba0fb24767d1474ec Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:18:41 -0700
Subject: [PATCH] wallet: verify generic provider anchors and transaction
 receipts

Maintenance explanation added during mailbox export:
Validate provider anchors through the wallet profile and check returned submission and status identities against the persisted payment. Reject mismatched receipts as inconclusive so a generic provider cannot silently substitute another transaction.

---
 src/wallet/test/v2_provider_tests.cpp | 50 ++++++++++++++++++++++++++-
 src/wallet/v2_payment.cpp             | 20 ++++++++---
 2 files changed, 65 insertions(+), 5 deletions(-)

diff --git a/src/wallet/test/v2_provider_tests.cpp b/src/wallet/test/v2_provider_tests.cpp
index 5a8ac75ab131c52c172c000bcaeeec636d0ba9f0..19d3412c9a63c57f1d35366f9ff04e502a9b43ca 100644
--- a/src/wallet/test/v2_provider_tests.cpp
+++ b/src/wallet/test/v2_provider_tests.cpp
@@ -18,7 +18,21 @@ public:
     unsigned stale_read{}, stale_lookup{}, stale_recheck{};
     Result lookup_failure{Result::Success};
     unsigned failure_lookup{};
-    bool wrong_profile{}, wrong_point{};
+    bool wrong_profile{}, wrong_point{}, max_height{};
+    V2Hash receipt_id{}, receipt_hash{};
+    unsigned submits{}, statuses{};
+    Result Submit(const std::vector<uint8_t> &, const V2Hash &, Submission &out,
+                  std::string &) override {
+        ++submits;
+        out = {"accepted", receipt_id, receipt_hash, {}};
+        return Result::Success;
+    }
+    Result Status(const V2Hash &, const V2Hash &, const std::vector<uint8_t> &,
+                  TransactionState &out, std::string &) override {
+        ++statuses;
+        out = {"pending", receipt_id, receipt_hash, {}, 0};
+        return Result::Success;
+    }
     explicit DiskProofProvider(Chain &c) : chain(c) {}
     Result ReadAnchor(const Profile &expected, ChainAnchor &out,
                       std::string &error) override {
@@ -31,6 +45,7 @@ public:
                {chain.store.Metadata().tip, chain.store.Root(),
                 chain.history.front().height, *mtp}};
         if (wrong_profile) out.profile.validation_digest[0] ^= 1;
+        if (max_height) out.snapshot.height = UINT64_MAX;
         error.clear();
         return Result::Success;
     }
@@ -427,6 +442,39 @@ void EngineProvider(const std::string &directory) {
                                  1000, reserved,
                                  error) == Result::InsufficientFunds,
           "reserved funding unavailable");
+    DiskProofProvider bad_receipt(chain);
+    bad_receipt.receipt_id = exported.txid;
+    bad_receipt.receipt_hash = exported.txhash;
+    Submission guarded_receipt{"sentinel", {}, {}, {}};
+    for (bool maximum : {false, true}) {
+        bad_receipt.wrong_profile = !maximum;
+        bad_receipt.max_height = maximum;
+        Check(PaymentEngine::Broadcast(*wallet, chain.profile, bad_receipt,
+                                       exported.txid, guarded_receipt, error) == Result::StorageError,
+              "generic provider invalid anchor rejected before submission");
+        Check(bad_receipt.submits == 0 && guarded_receipt.result == "sentinel",
+              "invalid anchor cannot submit or publish receipt");
+    }
+    bad_receipt.wrong_profile = bad_receipt.max_height = false;
+    for (bool hash : {false, true}) {
+        bad_receipt.receipt_id = exported.txid;
+        bad_receipt.receipt_hash = exported.txhash;
+        if (hash) bad_receipt.receipt_hash[0] ^= 1;
+        else bad_receipt.receipt_id[0] ^= 1;
+        Check(PaymentEngine::Broadcast(*wallet, chain.profile, bad_receipt,
+                                       exported.txid, guarded_receipt, error) == Result::Inconclusive,
+              "generic provider wrong submission identity inconclusive");
+        Check(guarded_receipt.result == "sentinel", "wrong receipt leaves output untouched");
+        TransactionState guarded_state{"sentinel", {}, {}, {}, 0};
+        Check(PaymentEngine::Status(*wallet, chain.profile, bad_receipt,
+                                    exported.txid, guarded_state, error) == Result::Inconclusive,
+              "generic provider wrong status identity inconclusive");
+        Check(guarded_state.state == "sentinel", "wrong status leaves output untouched");
+    }
+    Success(PaymentEngine::Reconcile(*wallet, chain.profile, node, reconciled, error), error);
+    Check(std::any_of(reconciled.coins.begin(), reconciled.coins.end(),
+                      [](const CoinStatus &coin) { return coin.reserved; }),
+          "bad_receipt generic provider cannot release reservation");
     // Reopen locked, requery authoritative history, and retry exactly the
     // persisted transaction after an ambiguous send. No signing occurs.
     std::vector<uint8_t> submitted;
diff --git a/src/wallet/v2_payment.cpp b/src/wallet/v2_payment.cpp
index 1d7917776d188c8aae59e7e95de3dab6fb4ad9d4..bf213390a9568c05fbb643444d42181f3584a38b 100644
--- a/src/wallet/v2_payment.cpp
+++ b/src/wallet/v2_payment.cpp
@@ -518,16 +518,28 @@ Result PaymentEngine::Broadcast(const Wallet &wallet, const ChainProfile &profil
     auto result = Recover(wallet, profile, id, payment, error);
     if (result != Result::Success) return result;
     ChainAnchor anchor;
-    result = provider.ReadAnchor(wallet.Binding(), anchor, error);
+    result = ReadAnchor(wallet.Binding(), profile, provider, anchor, error);
     if (result != Result::Success) return result;
-    return provider.Submit(payment.wire, anchor.snapshot.tip, out, error);
+    Submission receipt;
+    result = provider.Submit(payment.wire, anchor.snapshot.tip, receipt, error);
+    if (result != Result::Success) return result;
+    if (receipt.txid != payment.txid || receipt.txhash != payment.txhash)
+        return Error(Result::Inconclusive, error, "submission receipt identity mismatch");
+    out = std::move(receipt);
+    return Result::Success;
 }
 Result PaymentEngine::Status(const Wallet &wallet, const ChainProfile &profile,
                             PaymentChainProvider &provider, const Hash &id,
                             TransactionState &out, std::string &error) {
     ExportedPayment payment;
-    const auto result = Recover(wallet, profile, id, payment, error);
+    auto result = Recover(wallet, profile, id, payment, error);
     if (result != Result::Success) return result;
-    return provider.Status(payment.txid, payment.txhash, payment.wire, out, error);
+    TransactionState observed;
+    result = provider.Status(payment.txid, payment.txhash, payment.wire, observed, error);
+    if (result != Result::Success) return result;
+    if (observed.txid != payment.txid || observed.txhash != payment.txhash)
+        return Error(Result::Inconclusive, error, "transaction status identity mismatch");
+    out = std::move(observed);
+    return Result::Success;
 }
 } // namespace lotus::v2::wallet
