-PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice, uint64_t now, std::string &e) {
+PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice,uint64_t now,std::string &e) {
+    const auto result=HandleImpl(notice,now,e);
+    if(result==PeerResult::UnknownPeer) IncrementDiagnostic(diagnostics_.dead_applications);
+    if(notice.kind==peer::DispatcherNoticeKind::Application && notice.application && notice.application->command=="avaresponse") {
+        switch(result) {
+            case PeerResult::Accepted:IncrementDiagnostic(diagnostics_.responses_applied);break;
+            case PeerResult::Ignored:IncrementDiagnostic(diagnostics_.responses_ignored);break;
+            case PeerResult::Rejected:IncrementDiagnostic(diagnostics_.responses_rejected);break;
+            case PeerResult::LocalFailure:IncrementDiagnostic(diagnostics_.responses_local_failure);break;
+            default:break;
+        }
+    }
+    if(result==PeerResult::Rejected) {
+        auto category=PeerRejection::Other;
+        if(notice.kind!=peer::DispatcherNoticeKind::Application || !notice.application) category=PeerRejection::Other;
+        else if(e=="invalid-response-signature") category=PeerRejection::Signature;
+        else if(e=="response-framing" || e=="invalid-avalanche-serialization") category=PeerRejection::Framing;
+        else if(e=="invalid-ava-response-size" || e=="invalid-ava-response-content" || e=="unknown-response-node") category=PeerRejection::Content;
+        else if(e=="unexpected-ava-response-abuse") category=PeerRejection::LateResponseAbuse;
+        else if(e=="discovery-cooldown") category=PeerRejection::DiscoveryCooldown;
+        else if(e=="proof-request-cooldown") category=PeerRejection::ProofCooldown;
+        else if(e=="avalanche-negotiated-capacity") category=PeerRejection::NegotiatedCapacity;
+        else if(e=="avalanche-payload-capacity") category=PeerRejection::PayloadCapacity;
+        IncrementDiagnostic(diagnostics_.application_rejections[static_cast<size_t>(category)]);
+    }
+    return result;
+}
+PeerResult AvalanchePeer::HandleImpl(const peer::DispatcherNotice &notice, uint64_t now, std::string &e) {
     if(!Active(notice.connection)) {e="avalanche-inactive-peer";return PeerResult::UnknownPeer;}
     auto found = peers_.find(notice.connection);
     if (found == peers_.end()) return PeerResult::UnknownPeer;
