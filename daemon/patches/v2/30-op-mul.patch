+++ b/src/test/op_mul_tests.cpp
@@ -0,0 +1,164 @@
+// Copyright (c) 2021 Logos Foundation
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Tests for OP_MUL (0x95): (a b -- a*b)
+//
+// OP_MUL re-enabled for Lotus with 63-bit signed result range.
+// Uses __int128 internally; overflows to scriptnum_error (UNKNOWN).
+//
+// Consensus guarantees tested:
+//   1. Correct results for small integers
+//   2. Correct results near the int63 boundary
+//   3. Commutativity: a*b == b*a
+//   4. Associativity spot-checks
+//   5. Identity: a*1 == a, a*0 == 0
+//   6. Sign rules: (-a)*b == -(a*b)
+//   7. Overflow: result > 2^63-1 or < -(2^63-1) fails
+//   8. Stack underflow with 0 or 1 elements
+
+#include <policy/policy.h>
+#include <script/interpreter.h>
+#include <script/script.h>
+#include <script/script_error.h>
+
+#include <test/util/setup_common.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <core_io.h>
+
+BOOST_FIXTURE_TEST_SUITE(op_mul_tests, BasicTestingSetup)
+
+typedef std::vector<uint8_t> valtype;
+typedef std::vector<valtype> stacktype;
+std::array<uint32_t, 2> flagset{{0, STANDARD_SCRIPT_VERIFY_FLAGS}};
+
+static void CheckSuccess(const CScript &script) {
+    BaseSignatureChecker sigchecker;
+    for (uint32_t flags : flagset) {
+        ScriptError err = ScriptError::OK;
+        stacktype stack{};
+        bool r = EvalScript(stack, script, flags, sigchecker, &err);
+        BOOST_CHECK_MESSAGE(r, "Expected OK but got "
+                                   << ScriptErrorString(err) << " for '"
+                                   << ScriptToAsmStr(script) << "'");
+    }
+}
+
+static void CheckError(const CScript &script, const ScriptError expected) {
+    BaseSignatureChecker sigchecker;
+    for (uint32_t flags : flagset) {
+        ScriptError err = ScriptError::OK;
+        stacktype stack{};
+        bool r = EvalScript(stack, script, flags, sigchecker, &err);
+        BOOST_CHECK_MESSAGE(!r, "Expected error for '"
+                                    << ScriptToAsmStr(script) << "'");
+        BOOST_CHECK_EQUAL(err, expected);
+    }
+}
+
+// Verify a * b == expected via script.
+static void CheckMul(int64_t a, int64_t b, int64_t expected) {
+    CheckSuccess(CScript() << a << b << OP_MUL << expected << OP_EQUAL);
+}
+
+// Verify a * b fails (overflow).
+static void CheckMulOverflow(int64_t a, int64_t b) {
+    // Overflow throws scriptnum_error which maps to ScriptError::UNKNOWN.
+    CheckError(CScript() << a << b << OP_MUL << OP_1,
+               ScriptError::UNKNOWN);
+}
+
+// -------------------------------------------------------------------------
+// Basic correctness.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_mul_basic) {
+    CheckMul(0, 0, 0);
+    CheckMul(1, 1, 1);
+    CheckMul(2, 3, 6);
+    CheckMul(7, 8, 56);
+    CheckMul(100, 200, 20000);
+    CheckMul(1000, 1000, 1000000);
+    CheckMul(-1, 1, -1);
+    CheckMul(-3, 4, -12);
+    CheckMul(-3, -4, 12);
+    CheckMul(3, -4, -12);
+}
+
+// -------------------------------------------------------------------------
+// Identity laws.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_mul_identity) {
+    for (int64_t v : {0LL, 1LL, -1LL, 42LL, -42LL, 1000000LL, -1000000LL,
+                      0x7fffffffLL, -0x7fffffffLL}) {
+        CheckMul(v, 1, v);
+        CheckMul(1, v, v);
+        CheckMul(v, 0, 0);
+        CheckMul(0, v, 0);
+    }
+}
+
+// -------------------------------------------------------------------------
+// Commutativity.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_mul_commutative) {
+    const std::vector<std::pair<int64_t,int64_t>> pairs = {
+        {3, 7}, {-5, 11}, {100, 200}, {-99, -7},
+        {0x7fff, 0x7fff}, {1000000, 999},
+    };
+    for (auto [a, b] : pairs) {
+        // a*b == b*a in script
+        CheckSuccess(CScript() << a << b << OP_MUL
+                               << b << a << OP_MUL
+                               << OP_EQUAL);
+    }
+}
+
+// -------------------------------------------------------------------------
+// Near int63 boundary — largest values that don't overflow.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_mul_boundary) {
+    // 2^31 * 2^31 = 2^62, fits in int63.
+    const int64_t two31 = (int64_t)1 << 31;
+    CheckMul(two31, two31, (int64_t)1 << 62);
+
+    // 3037000499 * 3037000499 = 9223372036854775001 < 2^63-1.
+    CheckMul(3037000499LL, 3037000499LL, 9223372036854775001LL);
+
+    // Largest product that fits: 2^62 * 2 = 2^63-1 is off by one —
+    // use floor(sqrt(INT63_MAX)) ^ 2 which we just checked above.
+
+    // Negative boundary.
+    CheckMul(-3037000499LL, 3037000499LL, -9223372036854775001LL);
+    CheckMul(-3037000499LL, -3037000499LL, 9223372036854775001LL);
+}
+
+// -------------------------------------------------------------------------
+// Overflow: result exceeds 63-bit signed range.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_mul_overflow) {
+    // 3037000500^2 > 2^63-1.
+    CheckMulOverflow(3037000500LL, 3037000500LL);
+    // Large values that clearly overflow.
+    CheckMulOverflow(0x7fffffffffffffffLL, 2);
+    CheckMulOverflow(0x7fffffffffffffffLL, -2);
+    // 4e9 * 4e9 = 16e18 > 9.22e18 (int63 max).
+    CheckMulOverflow(4000000000LL, 4000000000LL);
+    // 2^32 * 2^32 = 2^64 >> int63 max.
+    CheckMulOverflow((int64_t)1 << 32, (int64_t)1 << 32);
+    // 2^31 * (2^32 + 1) overflows.
+    CheckMulOverflow((int64_t)1 << 31, ((int64_t)1 << 32) + 1);
+}
+
+// -------------------------------------------------------------------------
+// Stack underflow.
+// -------------------------------------------------------------------------
+BOOST_AUTO_TEST_CASE(op_mul_stack_underflow) {
+    CheckError(CScript() << OP_MUL << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+    CheckError(CScript() << 5 << OP_MUL << OP_1,
+               ScriptError::INVALID_STACK_OPERATION);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
