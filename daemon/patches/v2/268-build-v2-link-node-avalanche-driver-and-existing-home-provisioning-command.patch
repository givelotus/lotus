From d4119718505d0bfbd358c97ac9bfb81aeb48b2da Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:06:14 -0700
Subject: [PATCH] build(v2): link node Avalanche driver and existing-home
 provisioning command

---
 src/CMakeLists.txt                   | 5 +++--
 src/bitcoind.cpp                     | 3 +++
 src/lotus_v2/avalanche_provision.cpp | 2 +-
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 86946d77cf41aae90eff692e8e58e2f0e55639a2..c3ee8d82c8a536115ba803057a89796065519f17 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -991,7 +991,8 @@ endif()
 add_executable(lotusd bitcoind.cpp lotus_v2/development_command.cpp)
 target_link_libraries(lotusd server lotus_v2_validation)
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
-    target_sources(lotusd PRIVATE lotus_v2/development_node_command.cpp)
+    target_sources(lotusd PRIVATE lotus_v2/development_node_command.cpp
+        lotus_v2/avalanche_provision.cpp)
     target_compile_definitions(lotusd PRIVATE LOTUS_V2_POSIX_NODE=1)
     if(BUILD_CHRONIK)
         target_sources(lotusd PRIVATE lotus_v2/chronik_sync.cpp)
@@ -999,7 +1000,7 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
         target_link_libraries(lotusd chronik)
     endif()
     target_link_libraries(lotusd lotus_v2_peer_dispatcher lotus_v2_peer_tcp
-        lotus_v2_pool_coordinator lotus_v2_transaction_relay)
+        lotus_v2_pool_coordinator lotus_v2_transaction_relay lotus_v2_avalanche)
 endif()
 generate_windows_version_info(lotusd
 	DESCRIPTION "Lotus node with a JSON-RPC server"
diff --git a/src/bitcoind.cpp b/src/bitcoind.cpp
index e2dbae90ebe09d418b1cb1874c98e0594080038f..e9006a37bea9fedeef1f494a409e0ed23d47d5c4 100644
--- a/src/bitcoind.cpp
+++ b/src/bitcoind.cpp
@@ -10,6 +10,7 @@
 #include <lotus_v2/development_command.h>
 #ifdef LOTUS_V2_POSIX_NODE
 #include <lotus_v2/development_node_command.h>
+#include <lotus_v2/avalanche_provision.h>
 #endif
 #include <chainparams.h>
 #include <clientversion.h>
@@ -321,6 +322,8 @@ int main(int argc, char *argv[]) {
         return lotus::v2::RunDevelopmentCommand(argc, argv);
 
 #ifdef LOTUS_V2_POSIX_NODE
+    if (argc > 1 && std::string(argv[1]) == "-lotusv2provision")
+        return lotus::v2::ava::RunAvalancheProvisionCommand(argc, argv);
     if (argc > 1 && std::string(argv[1]) == "-lotusv2node")
         return lotus::v2::RunDevelopmentNodeCommand(argc, argv);
 #endif
diff --git a/src/lotus_v2/avalanche_provision.cpp b/src/lotus_v2/avalanche_provision.cpp
index 981c0766f30f7da939c1bea688e7278dc54e5b28..cb54eb0f43a82ffcd21bb36230542c9ae74b4c80 100644
--- a/src/lotus_v2/avalanche_provision.cpp
+++ b/src/lotus_v2/avalanche_provision.cpp
@@ -220,7 +220,7 @@ int RunAvalancheProvisionCommand(int argc, char *argv[]) {
         constexpr uint64_t MiB=uint64_t{1}<<20;
         DevelopmentRuntimeConfig config;
         config.directory=directory; config.genesis_wire=m.genesis; config.profiles={m.hp,m.op,m.mp,m.cp};
-        config.initial_money=m.initial; config.storage.avalanche=true; config.storage.recovery=DiskRecoveryOptions{128*MiB,16*MiB};
+        config.initial_money=m.initial; config.storage.avalanche=true; config.storage.existing_only=true; config.storage.recovery=DiskRecoveryOptions{128*MiB,16*MiB};
         config.storage.candidates=CandidateStoreOptions{4096,4096,128};
         config.storage.max_metadata_bytes=16*MiB; config.storage.max_pending_bytes=64*MiB;
         config.bodies={32,m.block_read_limit,64*MiB,32,64*MiB,65536};
-- 
2.50.1 (Apple Git-155)

