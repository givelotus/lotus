From 7808120ec6a7087df9b506c6e16c7fc7d771c05c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:14:25 -0700
Subject: [PATCH] feat: expose requested block Avalanche policy observations

---
 src/lotus_v2/development_node_command.cpp     | 20 ++++++++++++++++++
 src/lotus_v2/development_node_command.h       |  9 ++++++--
 .../node_avalanche_test/check_node.py         | 21 ++++++++++++++++---
 3 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index de1fe9687aab2193b148d60092d125c141e51726..d2255d56088a04f937cba81ecbfb7fd8869cc446 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -1611,7 +1611,27 @@ namespace {
                             runtime->ReadHeader(block, header, error) ==
                                 Result::Progress,
                         error);
+                UniValue observation(UniValue::VOBJ);
+                RuntimeBlockObservation observed;
+                std::string observation_error;
+                const bool available = avalanche && runtime->ObserveAvalancheBlock(block, observed, observation_error);
+                observation.pushKV("observation_available", available);
+                observation.pushKV("reason", available ? "available" : avalanche ? "unavailable" : "disabled");
+                if (available) {
+                    observation.pushKV("known", observed.known);
+                    observation.pushKV("valid", observed.valid);
+                    observation.pushKV("active", observed.active);
+                    observation.pushKV("parked", observed.parked);
+                    observation.pushKV("finalized", observed.finalized);
+                    observation.pushKV("conflicting_finalized", observed.conflicting_finalized);
+                    observation.pushKV("forks_active", observed.forks_active);
+                    observation.pushKV("has_data", observed.has_data);
+                } else if (avalanche) {
+                    observation.pushKV("error", observation_error.substr(0, 1024));
+                }
                 answer = Status();
+                answer.pushKV("block_id", Hex(block));
+                answer.pushKV("block_observation", observation);
                 answer.pushKV("known_header", bool(header));
                 answer.pushKV("deterministic_invalid", bool(invalid));
                 answer.pushKV("invalid_root",
diff --git a/src/lotus_v2/development_node_command.h b/src/lotus_v2/development_node_command.h
index 7ea945d6a8fe66a2ef38b84dc88a788fd5e33c7a..17687d6b4093b01a1cbeee10365c6135289dfd61 100644
--- a/src/lotus_v2/development_node_command.h
+++ b/src/lotus_v2/development_node_command.h
@@ -47,8 +47,13 @@ namespace lotus::v2 {
 // txid:64lowerhex,index:u32; blockstatus adds block_id:64lowerhex. Responses
 // echo id and ok. Retention is never acceptance: submitblock returns
 // pending_validation; blockstatus reports durable invalid_root, historical
-// ever_connected and authoritative is_active_tip. ready/tip events and status
-// report authoritative metadata and peer counters. EOF exits; no
+// ever_connected and authoritative is_active_tip. blockstatus additionally
+// binds block_id and reports block_observation:{observation_available,reason}
+// where reason is available|disabled|unavailable. Only available observations
+// include known,valid,active,parked,finalized,conflicting_finalized,forks_active,
+// has_data, copied from the requested block's native policy observation.
+// Unavailable includes bounded error; disabled/unavailable omit block flags.
+// ready/tip events and status report authoritative metadata and peer counters. EOF exits; no
 // signing/transaction relay, wallet secrets or mainnet initialization.
 // Additional exact commands:
 // mineblock requires id,command,expected_parent:64lowerhex,time:JSONu48,
diff --git a/src/lotus_v2/node_avalanche_test/check_node.py b/src/lotus_v2/node_avalanche_test/check_node.py
index edf08d55b606e58bfeffcb9204f9481ecfb0ceab..159ca2ba68fbfff3332d2be3ef6e21a0b68f7e6e 100644
--- a/src/lotus_v2/node_avalanche_test/check_node.py
+++ b/src/lotus_v2/node_avalanche_test/check_node.py
@@ -58,10 +58,10 @@ class Node:
         self.record("received", event)
         return event
 
-    def request(self, command):
+    def request(self, command, **fields):
         self.next_id += 1
         tag = str(self.next_id)
-        request = dict(id=tag, command=command)
+        request = dict(id=tag, command=command, **fields)
         self.record("sent", request)
         self.process.stdin.write((json.dumps(request) + "\n").encode())
         deadline = time.monotonic() + 10
@@ -113,7 +113,11 @@ def main():
         try:
             disabled = Node(args, root, "disabled", network())
             nodes.append(disabled)
-            assert "avalanche" not in disabled.event(time.monotonic() + 10)
+            disabled_ready = disabled.event(time.monotonic() + 10)
+            assert "avalanche" not in disabled_ready
+            disabled_status = disabled.request("blockstatus", block_id=disabled_ready["genesis_id"])
+            assert disabled_status["block_id"] == disabled_ready["genesis_id"]
+            assert disabled_status["block_observation"] == dict(observation_available=False, reason="disabled")
             disabled.close()
             # Options are part of the on-disk profile; enabling Avalanche must
             # refuse the old disabled home rather than reset or adopt it.
@@ -132,6 +136,17 @@ def main():
             ready = observer.event(time.monotonic() + 10)
             assert ready["avalanche"]["started"] and ready["avalanche"]["observer"]
             assert ready["avalanche"]["initial_download"]
+            genesis_status = observer.request("blockstatus", block_id=ready["genesis_id"])
+            assert genesis_status["block_id"] == ready["genesis_id"]
+            assert genesis_status["block_observation"] == dict(observation_available=True, reason="available",
+                    known=True, valid=True, active=True, parked=False, finalized=False,
+                    conflicting_finalized=False, forks_active=False, has_data=True)
+            unknown_id = "ff" * 32
+            unknown_status = observer.request("blockstatus", block_id=unknown_id)
+            assert unknown_status["block_id"] == unknown_id
+            assert unknown_status["block_observation"] == dict(observation_available=True, reason="available",
+                    known=False, valid=False, active=False, parked=False, finalized=False,
+                    conflicting_finalized=False, forks_active=False, has_data=False)
             peer = Node(args, root, "peer", network(config(height=1), [ready["listen"]]))
             nodes.append(peer)
             peer.event(time.monotonic() + 10)
-- 
2.50.1 (Apple Git-155)

