From ed02b683372b7ebc8cc4a83ddc244940ddf94a67 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 17:00:50 -0700
Subject: [PATCH] fix: reconcile retained inactive Avalanche candidates in
 bounded pages

---
 src/lotus_v2/development_node_command.cpp     | 68 +++++++++++++++++++
 src/lotus_v2/development_node_command.h       |  5 ++
 .../node_avalanche_test/check_node.py         | 12 ++++
 3 files changed, 85 insertions(+)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index 2e5ebf7525083d72248a0165e7e4583c320f44ec..de1fe9687aab2193b148d60092d125c141e51726 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -641,6 +641,11 @@ namespace {
         uint64_t avalanche_reconciled{};
         std::optional<Hash> avalanche_last_reconciled;
         uint64_t avalanche_save_due{};
+        std::optional<DevelopmentRuntimeSnapshot> avalanche_scan_anchor;
+        std::optional<CandidatePage> avalanche_candidate_page;
+        std::optional<CandidateRankCursor> avalanche_candidate_cursor;
+        size_t avalanche_candidate_index{};
+        void ReconcileCandidates();
         bool InitialDownload(uint64_t);
         void TickAvalanche(uint64_t, uint64_t);
         bool HandleApplication(DispatcherNotice, uint64_t);
@@ -1867,6 +1872,68 @@ namespace {
         dispatcher->Remove(id);
         for (auto &c : connections) if (c->id == id) c->stream.Close();
     }
+    void Node::ReconcileCandidates() {
+        const auto snapshot = runtime->Snapshot();
+        if (!snapshot.chain || snapshot.reopen_required || snapshot.execution_paused ||
+            snapshot.chain->pending_journal || snapshot.chain->pending_receipt || snapshot.chain->pending_propagation) return;
+        const auto &view = *snapshot.chain;
+        if (!avalanche_scan_anchor || avalanche_scan_anchor->body_epoch != snapshot.body_epoch ||
+            avalanche_scan_anchor->context_generation != snapshot.context_generation ||
+            !avalanche_scan_anchor->chain || avalanche_scan_anchor->chain->stable_tip != view.stable_tip ||
+            avalanche_scan_anchor->chain->revision != view.revision) {
+            avalanche_scan_anchor = snapshot;
+            avalanche_candidate_page.reset();
+            avalanche_candidate_cursor.reset();
+            avalanche_candidate_index = 0;
+        }
+        if (!avalanche_candidate_page) {
+            CandidatePage page;
+            std::string error;
+            const auto result = runtime->ReadAvalancheCandidates(avalanche_candidate_cursor,
+                {16, 4096, 4096, 64 * 1024}, page, error);
+            if (result != Result::Progress) {
+                avalanche_reconcile_error = error;
+                Require(result == Result::CapacityRefused || result == Result::Recovering ||
+                    result == Result::Busy || result == Result::ReopenRequired, "Avalanche candidate scan: " + error);
+                return;
+            }
+            if (page.view.stable_tip != view.stable_tip || page.view.revision != view.revision) {
+                avalanche_scan_anchor.reset();
+                return;
+            }
+            avalanche_candidate_page = std::move(page);
+            avalanche_candidate_index = 0;
+        }
+        // A retained page is <=16 rows. Vote-record capacity retains the exact
+        // current row, allowing Tick/polls to free capacity before enrollment.
+        auto &page = *avalanche_candidate_page;
+        for (size_t work = 0; work < 16 && avalanche_candidate_index < page.rows.size(); ++work) {
+            const auto &id = page.rows[avalanche_candidate_index].id;
+            RuntimeBlockObservation observation;
+            std::string error;
+            if (!runtime->ObserveAvalancheBlock(id, observation, error)) {
+                avalanche_reconcile_error = error;
+                return;
+            }
+            if (observation.known && observation.valid && observation.has_data &&
+                !observation.finalized && !observation.conflicting_finalized) {
+                if (!avalanche->Reconcile({ava::ItemKind::Block, id}, !observation.parked, error)) {
+                    avalanche_reconcile_error = error;
+                    if (error == "vote-record-capacity") return;
+                    Require(error == "already-finalized-item", "Avalanche candidate reconciliation: " + error);
+                } else {
+                    Count(avalanche_reconciled);
+                    avalanche_last_reconciled = id;
+                    avalanche_reconcile_error.clear();
+                }
+            }
+            ++avalanche_candidate_index;
+        }
+        if (avalanche_candidate_index == page.rows.size()) {
+            avalanche_candidate_cursor = page.complete ? std::nullopt : page.next;
+            avalanche_candidate_page.reset();
+        }
+    }
     void Node::TickAvalanche(uint64_t ms, uint64_t wall) {
         if (!avalanche) return;
         Require(ms <= INT64_MAX && wall <= INT64_MAX, "Avalanche clock outside signed range");
@@ -1905,6 +1972,7 @@ namespace {
                 }
             }
         }
+        ReconcileCandidates();
         const auto result = avalanche->Tick(InitialDownload(wall), int64_t(ms), int64_t(wall));
         avalanche_error = result.message;
         Require(result.code == ava::DriverCode::Ok || result.code == ava::DriverCode::NotReady ||
diff --git a/src/lotus_v2/development_node_command.h b/src/lotus_v2/development_node_command.h
index bb74aec376c553baeb5f59c3ab5ef7e8b1969896..7ea945d6a8fe66a2ef38b84dc88a788fd5e33c7a 100644
--- a/src/lotus_v2/development_node_command.h
+++ b/src/lotus_v2/development_node_command.h
@@ -34,6 +34,11 @@ namespace lotus::v2 {
 // work, height below the explicit minimum, future tip, or tip older than the
 // explicit age. Thresholds do not manufacture peer/quorum/finality evidence.
 // status.avalanche reports actual driver readiness/quorum and tip finality.
+// Enabling/disabling Avalanche changes the storage policy profile; an existing
+// home with different options is refused. Import historical blocks into a new
+// isolated home explicitly. Bounded candidate pages (16 rows/call) enroll valid
+// parked and inactive retained blocks; vote capacity retains the current row
+// while transport/poll Tick continues. No automatic unpark policy is enabled.
 // stdout<=8MiB, nonblocking; output saturation terminates cleanly rather than
 // stalling peers.
 //
diff --git a/src/lotus_v2/node_avalanche_test/check_node.py b/src/lotus_v2/node_avalanche_test/check_node.py
index 2d2c0a0b0718e108500763dd3c50b65f0fce9da0..2c17bb998586a3be2cbfb1b3df6ed4c7c50683ad 100644
--- a/src/lotus_v2/node_avalanche_test/check_node.py
+++ b/src/lotus_v2/node_avalanche_test/check_node.py
@@ -89,6 +89,18 @@ def main():
             nodes.append(disabled)
             assert "avalanche" not in disabled.event(time.monotonic() + 10)
             disabled.close()
+            # Options are part of the on-disk profile; enabling Avalanche must
+            # refuse the old disabled home rather than reset or adopt it.
+            disabled.settings.write_text(json.dumps(network(config())))
+            refused = subprocess.run([args.node, "-lotusv2node", args.manifest,
+                                      str(disabled.root / "home"), str(disabled.settings)],
+                                     input=b"", capture_output=True, timeout=10)
+            assert refused.returncode != 0, "disabled home silently adopted Avalanche policy"
+            stale = Node(args, root, "stale", network(config(age=1)))
+            nodes.append(stale)
+            stale.event(time.monotonic() + 10)
+            assert stale.request("status")["avalanche"]["initial_download"]
+            stale.close()
             observer = Node(args, root, "observer", network(config()))
             nodes.append(observer)
             ready = observer.event(time.monotonic() + 10)
