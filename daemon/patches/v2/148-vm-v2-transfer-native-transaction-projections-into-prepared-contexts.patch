From 33b5bf137b14f2a07709f47ced5aa83ef0ad4fba Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 12:08:34 -0700
Subject: [PATCH] vm(v2): transfer native transaction projections into prepared
 contexts

Allow preparation to consume an owned V2 transaction projection. Script checks construct the projection directly into preparation and subsequently read the prepared owned transaction, removing the second deep copy of input witnesses, arguments, branch proofs and output vectors. Preserve the copying overload for callers which keep their inputs, including allocation reuse and typed failure handling.

Resolved coins remain copied into the prepared context; TLS identity and coin-context binding, policy and consensus execution, and deferred effects are unchanged. This is a separate ownership optimization rather than a cached VM verdict. Extend VM ownership coverage to verify transferred nested storage remains valid after the caller clears its moved-from transaction and resolved coins.

diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index b9b6d3cf4a31c3730e5960cfa831a391763129be..08a5d105786a23c4cc68662f4364292e468d90fc 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -2236,6 +2236,45 @@ void PreparedTransactionOwnership() {
     CHECK(rejected.invocation.status == VmStatus::OperationalError);
     CHECK(rejected.invocation.error == "prepared transaction ownership mismatch");
 }
+void PreparedTransactionMoveOwnership() {
+    const TxProfile tp{64, 64, 8, 8192, 16, 8192, 64};
+    ChainId chain{};
+    Transaction tx;
+    Input input;
+    input.flags = 1;
+    input.prev_txid.fill(1);
+    input.sequence = UINT32_MAX;
+    input.witnesses.push_back({Hex("4e"), {}, {}});
+    tx.inputs.push_back(std::move(input));
+    Output coin;
+    coin.value = 1000;
+    coin.branches = {BranchLeaf(Hex("4e"))};
+    coin.paths = {{0}};
+    tx.outputs.push_back(coin);
+    ResolvedCoins coins{coin};
+    const auto *inputs = tx.inputs.data();
+    const auto *witnesses = tx.inputs[0].witnesses.data();
+    const auto *script = tx.inputs[0].witnesses[0].script.data();
+    const auto *outputs = tx.outputs.data();
+    PreparedVmTransaction prepared;
+    std::string error;
+    CHECK(prepared.PrepareChecked(std::move(tx), tp, chain, coins,
+                                 IllustrativeCost(), error) ==
+          SigningPreparationStatus::Ready);
+    // Ownership transfers all nested storage, including the witness bytecode.
+    // These are lifetime requirements, rather than a source-conversion check.
+    const auto context = prepared.Invocation(0, 0);
+    CHECK(context.tx.inputs.data() == inputs);
+    CHECK(context.tx.inputs[0].witnesses.data() == witnesses);
+    CHECK(context.tx.inputs[0].witnesses[0].script.data() == script);
+    CHECK(context.tx.outputs.data() == outputs);
+    tx = Transaction{};
+    coins.clear();
+    CHECK(prepared.Owns(context));
+    const auto vm = EvaluateVmCharged(Hex("4e"), {}, PROFILE, prepared.Cost(),
+                                    0, 0, &context);
+    CHECK(vm.invocation.status == VmStatus::Success && vm.charged);
+}
 #ifdef LOTUS_V2_VM_TEST_INSTRUMENTATION
 void TypedCryptoFailures() {
     SetVmCryptoFault(VmCryptoFault::Digest);
@@ -2453,6 +2492,7 @@ int main() {
     AuthenticatedPayment();
     AuthenticatedFieldSizeHints();
     PreparedTransactionOwnership();
+    PreparedTransactionMoveOwnership();
 #ifdef LOTUS_V2_VM_TEST_INSTRUMENTATION
     TypedCryptoFailures();
 #endif
diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
index e9f8353abf3a58f5f71aaeb6d27a9e710079c2f2..172f5a2ce058addf5e1f727c2cbdf23e57baed98 100644
--- a/src/lotus_v2/vm.cpp
+++ b/src/lotus_v2/vm.cpp
@@ -2804,6 +2804,35 @@ SigningPreparationStatus PreparedVmTransaction::PrepareChecked(
     try {
         ready_ = false;
         tx_ = tx;
+        return PrepareStoredChecked(profile, chain, coins, cost, error,
+                                    precomputed_identities);
+    } catch (const std::exception &exception) {
+        ready_ = false;
+        error = exception.what();
+        return SigningPreparationStatus::OperationalError;
+    }
+}
+
+SigningPreparationStatus PreparedVmTransaction::PrepareChecked(
+    Transaction &&tx, const TxProfile &profile, const ChainId &chain,
+    const ResolvedCoins &coins, const VmCostProfile &cost, std::string &error,
+    const IdentityDigests *precomputed_identities) {
+    try {
+        ready_ = false;
+        tx_ = std::move(tx);
+        return PrepareStoredChecked(profile, chain, coins, cost, error,
+                                    precomputed_identities);
+    } catch (const std::exception &exception) {
+        error = exception.what();
+        return SigningPreparationStatus::OperationalError;
+    }
+}
+
+SigningPreparationStatus PreparedVmTransaction::PrepareStoredChecked(
+    const TxProfile &profile, const ChainId &chain, const ResolvedCoins &coins,
+    const VmCostProfile &cost, std::string &error,
+    const IdentityDigests *precomputed_identities) {
+    try {
         profile_ = profile;
         chain_ = chain;
         coins_ = coins;
diff --git a/src/lotus_v2/vm.h b/src/lotus_v2/vm.h
index 08b57df24568a8d9beca8f82188bbc5e88840a66..b0c38c55bcedb81d1c01c1e1fac71db2be5a0064 100644
--- a/src/lotus_v2/vm.h
+++ b/src/lotus_v2/vm.h
@@ -181,6 +181,12 @@ public:
     PrepareChecked(const Transaction &, const TxProfile &, const ChainId &,
                    const ResolvedCoins &, const VmCostProfile &, std::string &,
                    const IdentityDigests *precomputed_identities = nullptr);
+    // Consume an already-owned projection without copying its witness trees.
+    // The prepared context still owns all bytes for every borrowed invocation.
+    SigningPreparationStatus
+    PrepareChecked(Transaction &&, const TxProfile &, const ChainId &,
+                   const ResolvedCoins &, const VmCostProfile &, std::string &,
+                   const IdentityDigests *precomputed_identities = nullptr);
     bool Prepare(const Transaction &, const TxProfile &, const ChainId &,
                  const ResolvedCoins &, const VmCostProfile &, std::string &);
     // Borrowed contexts are valid until this object is prepared again or
@@ -203,6 +209,9 @@ public:
             &context.chain_id == &chain_ && &context.resolved == &coins_;
     }
 private:
+    SigningPreparationStatus PrepareStoredChecked(
+        const TxProfile &, const ChainId &, const ResolvedCoins &,
+        const VmCostProfile &, std::string &, const IdentityDigests *);
     Transaction tx_;
     TxProfile profile_{};
     ChainId chain_{};
