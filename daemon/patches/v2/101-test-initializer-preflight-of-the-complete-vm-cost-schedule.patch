From cef57401908a2f731c3515fb81c0626a9802d17c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:50:24 -0700
Subject: [PATCH] Test initializer preflight of the complete VM cost schedule

Integration review note (2026-10-15; original source commit had no body):
Supply explicit valid VM cost fixtures and reject missing assigned costs and invalid field hints before chainstore creation.

---
 src/lotus_v2/test_development_chain.cpp | 36 +++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/src/lotus_v2/test_development_chain.cpp b/src/lotus_v2/test_development_chain.cpp
index 3a12b4efcabcbc304ce5847ee8de3edc86ae7a2d..c5ea226a43f25d6ff34749d57a6b9db9a78e6c7d 100644
--- a/src/lotus_v2/test_development_chain.cpp
+++ b/src/lotus_v2/test_development_chain.cpp
@@ -40,6 +40,10 @@ struct Fixture {
         op.dust_limit = DevelopmentGenesis.dust_limit;
         op.max_total_invocation_cost = 1000000;
         op.vm_cost.max_invocation_cost = 1000000;
+        op.vm_cost.structural_byte_cost = 1;
+        // Synthetic positive schedule, not a calibrated network cost profile.
+        for (auto &opcode : op.vm_cost.opcode)
+            opcode.base = 1;
         money.bootstrap_reserve = 9;
         money.tail_subsidy = 200;
         money.prev_work[0] = 2;
@@ -269,6 +273,37 @@ void InvalidProfilesBeforeOpen() {
               "invalid profile created database path");
     }
 }
+void InvalidCostProfilesBeforeOpen() {
+    const char *reasons[] = {
+        "invalid explicit cost profile", "missing assigned opcode cost",
+        "invalid field-size opcode", "invalid field-size bound"};
+    for (unsigned mutation = 0; mutation < 4; ++mutation) {
+        Fixture f(true);
+        switch (mutation) {
+            case 0:
+                f.op.vm_cost.structural_byte_cost = 0;
+                break;
+            case 1:
+                f.op.vm_cost.opcode[0x75].base = 0;
+                break; // Assigned DROP.
+            case 2:
+                f.op.vm_cost.field_sizes[0x75] = {1};
+                break;
+            case 3:
+                f.op.vm_cost.field_sizes[0xdb] = {f.op.vm.max_element_bytes +
+                                                  1};
+                break;
+        }
+        const auto path = FreshPath();
+        DiskStateStore out;
+        std::string error;
+        Check(!f.Open(path, out, error), "invalid VM cost schedule accepted");
+        Check(error == reasons[mutation],
+              "unexpected VM cost preflight error: " + error);
+        Check(!out.IsOpen() && !std::filesystem::exists(path),
+              "invalid VM cost schedule created database path");
+    }
+}
 void DevelopmentDisconnectChecks() {
     for (const bool corrupt_predecessor : {false, true}) {
         Fixture f(corrupt_predecessor);
@@ -406,6 +441,7 @@ int main() {
         CheckValid(false);
         InvalidBeforeOpen();
         InvalidProfilesBeforeOpen();
+        InvalidCostProfilesBeforeOpen();
         BlankRetry();
         DevelopmentDisconnectChecks();
         std::cout << "development chain initialization checks passed\n";
-- 
