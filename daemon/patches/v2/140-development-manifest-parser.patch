From 17d6c881e52e2680213a0f540b3bb34ce3707259 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:26:12 -0700
Subject: [PATCH] Expose strict development manifest parsing for runtime
 callers

Separate bounded configuration parsing from opening the offline command home so the runtime can supply explicit V4 storage and networking configuration. Preserve the existing command path and failure handling. Parsing alone does not establish genesis validity or select any network parameters; chain initialization remains responsible for validation.
---
 src/lotus_v2/development_command.cpp | 10 +++++++++-
 src/lotus_v2/development_command.h   |  6 ++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/development_command.cpp b/src/lotus_v2/development_command.cpp
index a24be3c35e8f05b53b7585ae29e41e215b0aa00f..5c165d6d2ae4e861783a49a7bc4017b8ba7c0521 100644
--- a/src/lotus_v2/development_command.cpp
+++ b/src/lotus_v2/development_command.cpp
@@ -146,10 +146,18 @@ DevelopmentManifest Load(const std::string &path) {
     return m;
 }
 } // namespace
+bool LoadDevelopmentManifest(const std::string &manifest_path,
+    DevelopmentManifest &out, std::string &error) {
+    try {
+        auto candidate = Load(manifest_path);
+        out = std::move(candidate); error.clear(); return true;
+    } catch (const std::exception &e) { error = e.what(); return false; }
+}
 bool OpenDevelopmentHome(const std::string &manifest_path, const std::string &home,
     DevelopmentManifest &out, DiskStateStore &store, std::string &error) {
     try {
-        auto m = Load(manifest_path);
+        DevelopmentManifest m;
+        if (!LoadDevelopmentManifest(manifest_path, m, error)) return false;
         const auto directory = Namespace(home, "Lotus V2 development command 1\n" + Hex(m.hp.chain_id) + "\n" +
             Hex(m.hp.genesis_id) + "\n" + Hex(BlockValidationProfileDigest(m.hp,m.op,m.mp,m.cp)) + "\n");
         DiskStateStore candidate;
diff --git a/src/lotus_v2/development_command.h b/src/lotus_v2/development_command.h
index f7130938b8fffd393f5ffbfe906730be1278ee94..016a1dcf461f8bf42624d5fa86041f0cebef2e0f 100644
--- a/src/lotus_v2/development_command.h
+++ b/src/lotus_v2/development_command.h
@@ -8,6 +8,12 @@ struct DevelopmentManifest {
     BlockCostProfile cp{}; MonetaryState initial{}; std::vector<uint8_t> genesis;
     uint64_t future_window{}, block_read_limit{};
 };
+// Strict, bounded configuration parsing only. Does not open/create a home or
+// establish genesis/chain validity; OpenDevelopmentChain performs those checks.
+// Runtime callers retain explicit profiles and storage creation options. Output
+// changes only on success. No network parameters or defaults are supplied.
+bool LoadDevelopmentManifest(const std::string &manifest_path,
+    DevelopmentManifest &out, std::string &error);
 // Reuses the offline command's strict manifest and isolated namespace checks.
 // Caller supplies the home explicitly and serializes its access. A fresh home
 // is initialized; existing homes must match. Outputs change only on success.
