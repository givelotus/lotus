From dca9abe768316068d2cb63c2857d6736ba0c5b04 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 10:03:24 -0700
Subject: [PATCH] Report authenticated costs for accepted offline development
 blocks

Retain the effective costs passed to monetary validation and expose accepted-only decimal diagnostics for invocation cost, accounting/enforcement cost, fees, subsidy and underclaim. Compare the proposed first block costs against the independent Python artifact and ensure rejected submissions expose no accepted charges. Full development-chain and disk checks plus process-level restart, undo and malformed-input checks pass. No consensus schedule or network defaults change.
---
 src/lotus_v2/block_transition.cpp               |  5 +++--
 src/lotus_v2/block_transition.h                 |  2 ++
 src/lotus_v2/development_command.cpp            | 12 ++++++++++++
 src/lotus_v2/development_command_test/verify.py |  7 +++++++
 4 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/block_transition.cpp b/src/lotus_v2/block_transition.cpp
index dfeb34490e1cf4a696d67eeb25d776134d71a0bf..f854dea0ec820d28e1ed70eecc255f9803ba19d4 100644
--- a/src/lotus_v2/block_transition.cpp
+++ b/src/lotus_v2/block_transition.cpp
@@ -161,10 +161,11 @@ CandidateCheckResult StageCompleteBlock(
         StagedBlockTransition staged;
         staged.header = claimed;
         staged.utxo_root = StorageCall([&] { return state.Root(); });
+        staged.account_cost = BlockEffectiveCost(envelope, account_linear, mp);
+        staged.enforce_cost = BlockEffectiveCost(envelope, enforce_linear, mp);
         staged.monetary = AdvanceMonetary(
             mp, parent.monetary, child_work, accounted, cb_outputs, cb_burn,
-            coinbase_bytes, frames, BlockEffectiveCost(envelope, account_linear, mp),
-            BlockEffectiveCost(envelope, enforce_linear, mp));
+            coinbase_bytes, frames, staged.account_cost, staged.enforce_cost);
         staged.state_root = StateRoot(parent.chain_id, claimed.height,
                                       staged.utxo_root, staged.monetary.state);
         if (!ValidateChildHeader(hp, parent.header, history, claimed,
diff --git a/src/lotus_v2/block_transition.h b/src/lotus_v2/block_transition.h
index ec8b0685cf587d263a2b053802e3f27379efab19..23d24adb9b9eaf6a3632ac7ca0407837d6e40c79 100644
--- a/src/lotus_v2/block_transition.h
+++ b/src/lotus_v2/block_transition.h
@@ -21,6 +21,8 @@ struct StagedBlockTransition {
     Hash utxo_root{};
     Hash state_root{};
     MonetaryTransition monetary;
+    // Authenticated effective costs used by this accepted transition.
+    MonetaryInteger account_cost{}, enforce_cost{};
     VmCostUnits invocation_cost{};
 };
 // No full UTXO enumeration/copy. Memory is bounded by the decoded block and
diff --git a/src/lotus_v2/development_command.cpp b/src/lotus_v2/development_command.cpp
index 58a9714dabb203714fe7da92989202350749e862..617c100ee8952c17892a455e01dc136b3802e21b 100644
--- a/src/lotus_v2/development_command.cpp
+++ b/src/lotus_v2/development_command.cpp
@@ -171,6 +171,18 @@ int RunDevelopmentCommand(int argc, char *argv[]) {
             Require(now >= 0, "invalid local UTC clock"); StagedBlockTransition connected;
             const auto status = ConnectEligibleDiskBlock(wire,uint64_t(now),m.future_window,m.hp,m.op,m.mp,m.cp,store,connected,error);
             result = status == DiskBlockAdmission::Accepted ? 0 : status == DiskBlockAdmission::Invalid ? 2 : status == DiskBlockAdmission::Deferred ? 3 : 4;
+            if (result == 0) {
+                // Decimal strings preserve all bits for JSON consumers.
+                UniValue charges(UniValue::VOBJ);
+                charges.pushKV("invocation", MonetaryInteger(connected.invocation_cost).str());
+                charges.pushKV("account", connected.account_cost.str());
+                charges.pushKV("enforce", connected.enforce_cost.str());
+                charges.pushKV("required_underclaim", connected.monetary.required_underclaim.str());
+                charges.pushKV("actual_underclaim", connected.monetary.actual_underclaim.str());
+                charges.pushKV("fees", connected.monetary.total_fees.str());
+                charges.pushKV("subsidy", std::to_string(connected.monetary.subsidy));
+                answer.pushKV("charges", charges);
+            }
             answer.pushKV("accepted",result == 0);
             answer.pushKV("result",result == 0 ? "accepted" : result == 2 ? "invalid" : result == 3 ? "deferred" : "storage_error");
         } else if (command == "disconnect") {
diff --git a/src/lotus_v2/development_command_test/verify.py b/src/lotus_v2/development_command_test/verify.py
index 5a2d10234d952d2feccbe12bb3794c654dc8b32c..c03db7d26a0df215c2f984dfd8652c47abc79568 100644
--- a/src/lotus_v2/development_command_test/verify.py
+++ b/src/lotus_v2/development_command_test/verify.py
@@ -41,6 +41,12 @@ child = run('first-block', ['submit', str(a.first_block.resolve())])
 assert child['accepted'] and child['height'] == 1
 assert child['tip'] == reference['first_id']
 assert child['state_root'] == reference['first_stateroot']
+assert child['charges']['invocation'] == '0'
+assert child['charges']['account'] == str(reference['block_cost'])
+assert child['charges']['enforce'] == str(reference['block_cost'])
+assert child['charges']['fees'] == '0'
+assert int(child['charges']['subsidy']) - reference['payout'] == int(child['charges']['actual_underclaim'])
+assert int(child['charges']['required_underclaim']) <= int(child['charges']['actual_underclaim'])
 assert run('restart-child', ['status']) == {key: child[key] for key in initial}
 parent = run('disconnect', ['disconnect', reference['first_id']])
 assert all(parent[key] == value for key, value in initial.items())
@@ -53,6 +59,7 @@ bad[-1] ^= 1
 (root / 'mutated.block').write_bytes(bad)
 rejected = run('reject-body', ['submit', str(root / 'mutated.block')], 2)
 assert not rejected['accepted'] and rejected['tip'] == initial['tip']
+assert 'charges' not in rejected
 assert run('restart-after-reject', ['status']) == initial
 assert run('reconnect', ['submit', str(a.first_block.resolve())])['tip'] == child['tip']
 legacy = root / 'legacy-looking'
