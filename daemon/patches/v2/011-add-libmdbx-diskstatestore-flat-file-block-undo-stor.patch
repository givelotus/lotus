+        op.vm_cost.max_invocation_cost = 1000000; op.vm_cost.structural_byte_cost = 1;
+        for (auto &cost : op.vm_cost.opcode) cost = {1, 1, 1};
+        Input coinbase; coinbase.prev_txid = Id({}, parent.header); coinbase.prev_index = 2;
