+DevelopmentTickLimits TickLimits() {
+    DevelopmentTickLimits limits;
+    limits.selection.query = {64, 20000, 20000, 1 << 20};
+    limits.selection.fork = {8, 8, 1000};
+    limits.selection.max_probe_calls = 128;
