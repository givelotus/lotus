+        DiskStateTransaction tx; Ok(store.Begin(tx, error), error, "capped seed begin"); Ok(tx.Insert(CoinAt(1), error), error, "capped seed coin");
+        const bool committed = tx.Commit(f.Meta(f.genesis), f.genesis, error);
