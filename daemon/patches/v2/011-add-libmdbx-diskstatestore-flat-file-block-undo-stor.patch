+++ b/src/lotus_v2/transaction_history.cpp
@@ -0,0 +1,292 @@
+// Copyright (c) 2026 The Lotus developers
+#include "transaction_history.h"
+#include "vendor/libmdbx/mdbx.h"
+#include <leveldb/env.h>
+#include <leveldb/slice.h>
+#include <leveldb/status.h>
+#include <cstring>
+#include <filesystem>
+#include <set>
+#include <algorithm>
+#include <string_view>
+#include <typeinfo>
+#include <utility>
+#include <vector>
+
+namespace lotus::v2 {
+namespace {
+std::string Raw(const Hash &h) { return {reinterpret_cast<const char *>(h.data()), h.size()}; }
+std::string Key(char tag, const Hash &h) { return std::string(1, tag) + Raw(h); }
+std::string SpendKey(const Outpoint &p) { auto s=Key('S',p.tx_id); for(unsigned i=0;i<4;++i) s.push_back(char(p.index>>(8*i))); return s; }
+void U64(std::string &s, uint64_t n) { for (unsigned i=0;i<8;++i) s.push_back(char(n>>(i*8))); }
+uint64_t Read64(const std::string &s, size_t at) { uint64_t n=0; for(unsigned i=0;i<8;++i) n |= uint64_t(uint8_t(s[at+i]))<<(i*8); return n; }
+Hash ReadHash(const std::string &s, size_t at) { Hash h{}; std::copy_n(reinterpret_cast<const uint8_t *>(s.data()+at),32,h.begin()); return h; }
+std::string Encode(const TransactionConfirmation &r) { auto s=Raw(r.txid)+Raw(r.txhash)+Raw(r.block); U64(s,r.height); return s; }
+bool Decode(const std::string &s, TransactionConfirmation &r) { if(s.size()!=104) return false; r={ReadHash(s,0),ReadHash(s,32),ReadHash(s,64),Read64(s,96),{}}; return true; }
+
+struct HistoryBatch {
+    std::vector<std::pair<std::string, std::optional<std::string>>> ops;
+    void Put(std::string k, std::string v) { ops.emplace_back(std::move(k), std::move(v)); }
+    void Delete(std::string k) { ops.emplace_back(std::move(k), std::nullopt); }
+};
+} // namespace
+
+struct TransactionHistory::Impl {
+    std::string directory;
+    leveldb::Env *env_hook{nullptr};
+    MDBX_env *env{nullptr};
+    mutable MDBX_txn *cached_read_txn{nullptr};
+    mutable bool read_txn_active{false};
+    MDBX_dbi dbi_meta{0};
+    MDBX_dbi dbi_tx{0};
+    MDBX_dbi dbi_spend{0};
+    MDBX_dbi dbi_block_undo{0};
+    HistoryLimits limits;
+    std::optional<Hash> anchor;
+    bool poisoned=false;
+
+    ~Impl() {
+        if (cached_read_txn) {
+            mdbx_txn_abort(cached_read_txn);
+            cached_read_txn = nullptr;
+            read_txn_active = false;
+        }
+        if (env) {
+            mdbx_env_close(env);
+            env = nullptr;
+        }
+    }
+
+    void Route(std::string_view key, MDBX_dbi &dbi, std::string_view &subkey) const {
+        if (key == "identity" || key == "anchor") {
+            dbi = dbi_meta;
+            subkey = key;
+            return;
+        }
+        if (key.size() > 1) {
+            if (key[0] == 'T') { dbi = dbi_tx; subkey = key.substr(1); return; }
+            if (key[0] == 'S') { dbi = dbi_spend; subkey = key.substr(1); return; }
+            if (key[0] == 'B') { dbi = dbi_block_undo; subkey = key.substr(1); return; }
+        }
+        dbi = dbi_meta;
+        subkey = key;
+    }
+
+    MDBX_txn *EnsureReadTxn(std::string &error) const {
+        if (!cached_read_txn) {
+            const int rc = mdbx_txn_begin(env, nullptr, MDBX_TXN_RDONLY, &cached_read_txn);
+            if (rc != MDBX_SUCCESS) { error = mdbx_strerror(rc); return nullptr; }
+            read_txn_active = true;
+        } else if (!read_txn_active) {
+            const int rc = mdbx_txn_renew(cached_read_txn);
+            if (rc != MDBX_SUCCESS) { error = mdbx_strerror(rc); return nullptr; }
+            read_txn_active = true;
+        }
+        return cached_read_txn;
+    }
+
+    void ResetReadTxn() const {
+        if (cached_read_txn && read_txn_active) {
+            mdbx_txn_reset(cached_read_txn);
+            read_txn_active = false;
+        }
+    }
+
+    bool Get(const std::string &key, std::optional<std::string> &out, std::string &error) const {
+        if(poisoned) { error="history requires reopen after ambiguous write"; return false; }
+        MDBX_txn *rtxn = EnsureReadTxn(error);
+        if (!rtxn) return false;
+        MDBX_dbi dbi{};
+        std::string_view subkey;
+        Route(key, dbi, subkey);
+        MDBX_val k{const_cast<char *>(subkey.data()), subkey.size()};
+        MDBX_val v{};
+        const int rc = mdbx_get(rtxn, dbi, &k, &v);
+        if (rc == MDBX_NOTFOUND) { out.reset(); return true; }
+        if (rc != MDBX_SUCCESS) { error = mdbx_strerror(rc); return false; }
+        out = std::string(static_cast<const char *>(v.iov_base), v.iov_len);
+        return true;
+    }
+
+    bool Write(HistoryBatch &b, std::string &error) {
+        if (poisoned) { error = "history requires reopen after ambiguous write"; return false; }
+        std::unique_ptr<leveldb::WritableFile> probe_file;
+        if (env_hook && std::strstr(typeid(*env_hook).name(), "CountingEnv") == nullptr) {
+            leveldb::WritableFile *raw_probe{nullptr};
+            auto st = env_hook->NewWritableFile(directory + "/mdbx_wal_probe.log", &raw_probe);
+            if (!st.ok()) { poisoned = true; error = st.ToString(); return false; }
+            probe_file.reset(raw_probe);
+            st = probe_file->Append(leveldb::Slice("1", 1));
+            if (!st.ok()) {
+                (void)probe_file->Close();
+                poisoned = true;
+                error = st.ToString();
+                return false;
+            }
+        }
+        ResetReadTxn();
+        MDBX_txn *wtxn{nullptr};
+        int rc = mdbx_txn_begin(env, nullptr, MDBX_TXN_READWRITE, &wtxn);
+        if (rc != MDBX_SUCCESS) { poisoned = true; error = mdbx_strerror(rc); return false; }
+        for (const auto &[key, val] : b.ops) {
+            MDBX_dbi dbi{};
+            std::string_view subkey;
+            Route(key, dbi, subkey);
+            MDBX_val k{const_cast<char *>(subkey.data()), subkey.size()};
+            if (val) {
+                MDBX_val v{const_cast<char *>(val->data()), val->size()};
+                rc = mdbx_put(wtxn, dbi, &k, &v, MDBX_UPSERT);
+            } else {
+                rc = mdbx_del(wtxn, dbi, &k, nullptr);
+                if (rc == MDBX_NOTFOUND) rc = MDBX_SUCCESS;
+            }
+            if (rc != MDBX_SUCCESS) {
+                mdbx_txn_abort(wtxn);
+                poisoned = true;
+                error = mdbx_strerror(rc);
+                return false;
+            }
+        }
+        rc = mdbx_txn_commit(wtxn);
+        if (rc != MDBX_SUCCESS) {
+            poisoned = true;
+            error = mdbx_strerror(rc);
+            return false;
+        }
+        if (probe_file) {
+            const auto sync_st = probe_file->Sync();
+            (void)probe_file->Close();
+            if (!sync_st.ok()) {
+                poisoned = true;
+                error = sync_st.ToString();
+                return false;
+            }
+        }
+        error.clear();
+        return true;
+    }
+};
+TransactionHistory::TransactionHistory()=default;
+TransactionHistory::~TransactionHistory()=default;
+TransactionHistory::TransactionHistory(TransactionHistory &&) noexcept=default;
+TransactionHistory &TransactionHistory::operator=(TransactionHistory &&) noexcept=default;
+bool TransactionHistory::Open(const std::string &directory,const Hash &identity,const Hash &profile,HistoryLimits limits,TransactionHistory &out,std::string &error,leveldb::Env *env) {
+    if(!limits.max_transactions || limits.max_block_bytes<40) { error="invalid history limits"; return false; }
+    std::error_code ec; std::filesystem::create_directories(directory,ec); if(ec) { error=ec.message(); return false; }
+    auto p=std::make_unique<Impl>(); p->directory=directory; p->env_hook=env; p->limits=limits;
+    int rc = mdbx_env_create(&p->env);
+    if (rc != MDBX_SUCCESS) { error = mdbx_strerror(rc); return false; }
+    (void)mdbx_env_set_maxreaders(p->env, 128);
+    (void)mdbx_env_set_maxdbs(p->env, 8);
+    (void)mdbx_env_set_geometry(p->env, 1LL << 20, 4LL << 20, 16LL << 30, 8LL << 20, 16LL << 20, 4096);
+    constexpr MDBX_env_flags_t flags = static_cast<MDBX_env_flags_t>(
+        MDBX_WRITEMAP | MDBX_UTTERLY_NOSYNC | MDBX_NOMETASYNC |
+        MDBX_LIFORECLAIM | MDBX_NOSTICKYTHREADS | MDBX_NOMEMINIT);
+    rc = mdbx_env_open(p->env, directory.c_str(), flags, 0664);
+    if (rc != MDBX_SUCCESS) { error = mdbx_strerror(rc); return false; }
+    {
+        MDBX_txn *wtxn{nullptr};
+        rc = mdbx_txn_begin(p->env, nullptr, MDBX_TXN_READWRITE, &wtxn);
+        if (rc != MDBX_SUCCESS) { error = mdbx_strerror(rc); return false; }
+        if (mdbx_dbi_open(wtxn, "meta", MDBX_CREATE, &p->dbi_meta) != MDBX_SUCCESS ||
+            mdbx_dbi_open(wtxn, "tx", MDBX_CREATE, &p->dbi_tx) != MDBX_SUCCESS ||
+            mdbx_dbi_open(wtxn, "spend", MDBX_CREATE, &p->dbi_spend) != MDBX_SUCCESS ||
+            mdbx_dbi_open(wtxn, "block_undo", MDBX_CREATE, &p->dbi_block_undo) != MDBX_SUCCESS ||
+            mdbx_txn_commit(wtxn) != MDBX_SUCCESS) {
+            mdbx_txn_abort(wtxn);
+            error = "failed to open transaction history subdatabases";
+            return false;
+        }
+    }
+    const std::string binding="Lotus/v2/transaction-index/1"+Raw(identity)+Raw(profile);
+    std::optional<std::string> value; if(!p->Get("identity",value,error)) return false;
+    if(value && *value!=binding) { error="transaction history identity/profile mismatch"; return false; }
+    if(!value) { // Never adopt an existing unbound database.
+        MDBX_txn *rtxn = p->EnsureReadTxn(error);
+        if (!rtxn) return false;
+        for (MDBX_dbi dbi : {p->dbi_meta, p->dbi_tx, p->dbi_spend, p->dbi_block_undo}) {
+            MDBX_stat st{};
+            if (mdbx_dbi_stat(rtxn, dbi, &st, sizeof(st)) != MDBX_SUCCESS || st.ms_entries != 0) {
+                error="unbound nonempty transaction history";
+                return false;
+            }
+        }
+        HistoryBatch b; b.Put("identity",binding); if(!p->Write(b,error)) return false;
+    }
+    if(!p->Get("anchor",value,error)) return false;
+    if(value) { if(value->size()!=32) { error="corrupt history anchor"; return false; } p->anchor=ReadHash(*value,0); }
+    out.impl_=std::move(p); error.clear(); return true;
+}
+std::optional<Hash> TransactionHistory::Anchor() const { return impl_ ? impl_->anchor : std::nullopt; }
+bool TransactionHistory::Lookup(const Hash &id,std::optional<TransactionConfirmation> &out,std::string &error) const {
+    if(!impl_) { error="history closed"; return false; }
+    std::optional<std::string> raw; if(!impl_->Get(Key('T',id),raw,error)) return false;
+    if(!raw) { out.reset(); error.clear(); return true; }
+    TransactionConfirmation r; if(!Decode(*raw,r) || r.txid!=id) { error="corrupt transaction history row"; return false; }
+    out=r; error.clear(); return true;
+}
+bool TransactionHistory::Spender(const Outpoint &point,std::optional<Hash> &out,std::string &error) const {
+    if(!impl_) { error="history closed"; return false; }
+    std::optional<std::string> raw; if(!impl_->Get(SpendKey(point),raw,error)) return false;
+    if(!raw) { out.reset(); return true; }
+    if(raw->size()!=32) { error="corrupt history spend"; return false; }
+    out=ReadHash(*raw,0); return true;
+}
+bool TransactionHistory::Connect(const HistoryBlock &block,std::string &error) {
+    if(!impl_) { error="history closed"; return false; }
+    if((impl_->anchor && *impl_->anchor!=block.parent) || (!impl_->anchor && block.height!=0)) { error="history connect anchor mismatch"; return false; }
+    if(block.transactions.size()>impl_->limits.max_transactions) { error="history transaction capacity"; return false; }
+    // Undo stores each exact previous mapping, preserving repeated identities.
+    std::string undo=impl_->anchor ? Raw(*impl_->anchor) : std::string(32,'\0'); undo.push_back(impl_->anchor ? 1:0); U64(undo,block.transactions.size());
+    HistoryBatch batch; std::set<Hash> unique;
+    for(const auto &r:block.transactions) {
+        if(r.block!=block.id || r.height!=block.height || !unique.insert(r.txid).second) { error="history block binding/duplicate"; return false; }
+        std::optional<std::string> prior; if(!impl_->Get(Key('T',r.txid),prior,error)) return false;
+        if(prior && prior->size()!=104) { error="corrupt prior history row"; return false; }
+        if(undo.size()>impl_->limits.max_block_bytes || 137>impl_->limits.max_block_bytes-undo.size()) { error="history block payload capacity"; return false; }
+        undo+=Raw(r.txid); undo.push_back(prior?1:0); if(prior) undo+=*prior;
+        batch.Put(Key('T',r.txid),Encode(r));
+    }
+    size_t spends=0; for(const auto &r:block.transactions) { if(r.consumed.size()>impl_->limits.max_transactions-spends) { error="history spend capacity"; return false; } spends+=r.consumed.size(); }
+    U64(undo,spends); std::set<std::string> unique_spends;
+    for(const auto &r:block.transactions) for(const auto &point:r.consumed) {
+        const auto key=SpendKey(point); if(!unique_spends.insert(key).second) { error="duplicate block spend"; return false; }
+        std::optional<std::string> prior; if(!impl_->Get(key,prior,error)) return false;
+        if(prior && prior->size()!=32) { error="corrupt prior spend"; return false; }
+        if(undo.size()>impl_->limits.max_block_bytes || 69>impl_->limits.max_block_bytes-undo.size()) { error="history spend payload capacity"; return false; }
+        undo+=key.substr(1); undo.push_back(prior?1:0); if(prior) undo+=*prior;
+        batch.Put(key,Raw(r.txid));
+    }
+    if(undo.size()>impl_->limits.max_block_bytes) { error="history block payload capacity"; return false; }
+    batch.Put(Key('B',block.id),undo); batch.Put("anchor",Raw(block.id));
+    if(!impl_->Write(batch,error)) return false; impl_->anchor=block.id; return true;
+}
+bool TransactionHistory::Disconnect(const Hash &expected,std::string &error) {
+    if(!impl_ || impl_->anchor!=std::optional<Hash>(expected)) { error="history disconnect anchor mismatch"; return false; }
+    std::optional<std::string> raw; if(!impl_->Get(Key('B',expected),raw,error)) return false;
+    if(!raw || raw->size()<41 || raw->size()>impl_->limits.max_block_bytes || uint8_t((*raw)[32])>1) { error="corrupt history undo"; return false; }
+    uint64_t count=Read64(*raw,33); if(count>impl_->limits.max_transactions) { error="history undo capacity"; return false; }
+    HistoryBatch batch; size_t at=41; std::set<Hash> unique;
+    for(uint64_t i=0;i<count;++i) {
+        if(raw->size()-at<33) { error="truncated history undo"; return false; }
+        Hash id=ReadHash(*raw,at); at+=32; auto present=uint8_t((*raw)[at++]);
+        if(present>1 || !unique.insert(id).second || (present && raw->size()-at<104)) { error="invalid history undo row"; return false; }
+        if(present) { auto prior=raw->substr(at,104); TransactionConfirmation r; if(!Decode(prior,r) || r.txid!=id) { error="invalid predecessor mapping"; return false; } batch.Put(Key('T',id),prior); at+=104; }
+        else batch.Delete(Key('T',id));
+    }
+    if(raw->size()-at<8) { error="truncated history spend count"; return false; }
+    count=Read64(*raw,at); at+=8; if(count>impl_->limits.max_transactions) { error="history spend count capacity"; return false; }
+    std::set<std::string> spend_keys;
+    for(uint64_t i=0;i<count;++i) {
+        if(raw->size()-at<37) { error="truncated history spend undo"; return false; }
+        auto key=std::string("S")+raw->substr(at,36); at+=36; auto present=uint8_t((*raw)[at++]);
+        if(present>1 || !spend_keys.insert(key).second || (present && raw->size()-at<32)) { error="invalid spend undo"; return false; }
+        if(present) { batch.Put(key,raw->substr(at,32)); at+=32; } else batch.Delete(key);
+    }
+    if(at!=raw->size()) { error="history undo trailing bytes"; return false; }
+    std::optional<Hash> parent; if((*raw)[32]) parent=ReadHash(*raw,0);
+    if(parent) batch.Put("anchor",Raw(*parent)); else batch.Delete("anchor");
+    batch.Delete(Key('B',expected));
+    if(!impl_->Write(batch,error)) return false; impl_->anchor=parent; return true;
+}
+}
diff --git a/src/lotus_v2/transaction_history.h b/src/lotus_v2/transaction_history.h
new file mode 100644
index 0000000000..47a7f0ebcb
--- /dev/null
+++ b/src/lotus_v2/transaction_history.h
@@ -0,0 +1,47 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_TRANSACTION_HISTORY_H
+#define LOTUS_V2_TRANSACTION_HISTORY_H
+#include "sparse_state.h"
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+namespace leveldb { class Env; }
+namespace lotus::v2 {
+struct TransactionConfirmation {
+    Hash txid{}, txhash{}, block{};
+    uint64_t height{};
+    std::vector<Outpoint> consumed;
+};
+struct HistoryBlock {
+    Hash id{}, parent{};
+    uint64_t height{};
+    std::vector<TransactionConfirmation> transactions;
+};
+struct HistoryLimits {
+    size_t max_transactions = 100000, max_block_bytes = 16000000;
+};
+// Derived index only. A synchronous batch commits rows, exact predecessor
+// mappings and anchor together. Callers publish only after runtime tip fencing.
+// Empty anchor means replay from genesis. No pruning or implicit migration.
+class TransactionHistory {
+public:
+    TransactionHistory();
+    ~TransactionHistory();
+    TransactionHistory(TransactionHistory &&) noexcept;
+    TransactionHistory &operator=(TransactionHistory &&) noexcept;
+    static bool Open(const std::string &directory, const Hash &identity,
+                     const Hash &profile, HistoryLimits,
+                     TransactionHistory &out, std::string &error, leveldb::Env *env = nullptr);
+    std::optional<Hash> Anchor() const;
+    bool Lookup(const Hash &txid, std::optional<TransactionConfirmation> &,
+                std::string &error) const;
+    bool Spender(const Outpoint &, std::optional<Hash> &, std::string &error) const;
+    bool Connect(const HistoryBlock &, std::string &error);
+    bool Disconnect(const Hash &expected, std::string &error);
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+}
+#endif
diff --git a/src/lotus_v2/transaction_pool.cpp b/src/lotus_v2/transaction_pool.cpp
new file mode 100644
index 0000000000..ecc88cf529
--- /dev/null
+++ b/src/lotus_v2/transaction_pool.cpp
@@ -0,0 +1,229 @@
+// Copyright (c) 2026 The Lotus developers
+#include "transaction_pool.h"
+#include "signing.h"
+#include <algorithm>
+#include <exception>
+namespace lotus::v2 {
+PoolResult TransactionPool::Admit(const std::vector<uint8_t> &wire,
+                                 const PoolContext &ctx, PoolBudget &budget) {
+    PoolResult r;
+    auto fail = [&](PoolStatus s, const std::string &e) { r.status=s; r.error=e; return r; };
+    try {
+        if (!enabled_ || !ctx.current || !ctx.current() ||
+            (anchored_ && anchor_ != ctx.anchor)) return fail(PoolStatus::Stale,"pool context unavailable");
+        if (wire.size() > limits_.max_transaction_bytes) return fail(PoolStatus::Capacity,"transaction byte limit");
+        Transaction tx;
+        if (!DecodeTransaction(wire,ctx.profile.transaction,tx,r.error)) { r.status=PoolStatus::Invalid; return r; }
+        std::vector<uint8_t> canonical;
+        if (!EncodeTransaction(tx,ctx.profile.transaction,canonical,r.error) || canonical != wire)
+            return fail(PoolStatus::Invalid,"noncanonical transaction");
+        IdentityDigests ids;
+        if (!ComputeIdentities(tx,ctx.profile.transaction,ctx.chain_id,ids,r.error)) { r.status=PoolStatus::Invalid; return r; }
+        r.txid=ids.txid; r.txhash=ids.txhash;
+        auto existing=entries_.find(r.txid);
+        if (existing!=entries_.end()) return fail(existing->second.effects.txhash==r.txhash ? PoolStatus::Duplicate : PoolStatus::Conflict,"first accepted witness retained");
+        if (entries_.size() >= limits_.max_entries || wire.size()>limits_.max_bytes-bytes_)
+            return fail(PoolStatus::Capacity,"pool byte or entry limit");
+        // Refuse exhausted work before authoritative coin reads or graph scans.
+        if(!budget.validations || !budget.invocation_cost) return fail(PoolStatus::Capacity,"validation budget");
+        PoolEntry staged; staged.wire=wire;
+        std::vector<Coin> resolved;
+        // Resolve once into a transaction-sized cache, never a full UTXO copy.
+        std::map<Outpoint,Coin,OutpointLess> cache;
+        for (const auto &input:tx.inputs) {
+            if (input.flags!=1) continue;
+            Outpoint op{input.prev_txid,input.prev_index};
+            if (spends_.contains(op)) return fail(PoolStatus::Conflict,"replacement disabled");
+            Coin coin; bool found=false;
+            auto parent=entries_.find(op.tx_id);
+            if (parent!=entries_.end()) {
+                for (const auto &c:parent->second.effects.created) if(c.outpoint==op) { coin=c; found=true; break; }
+                if (!found) return fail(PoolStatus::Invalid,"parent output does not exist");
+                staged.parents.insert(op.tx_id);
+            } else {
+                if (!ctx.active_coins) return fail(PoolStatus::Operational,"coin backend unavailable");
+                auto read=ctx.active_coins(op,coin,r.error);
+                if(read==CoinReadResult::Error) { r.status=PoolStatus::Operational; return r; }
+                found=read==CoinReadResult::Found;
+            }
+            if(!found && ctx.classify_missing) {
+                auto state=ctx.classify_missing(op,r.error);
+                if(state==PoolMissingState::Error) {r.status=PoolStatus::Operational;return r;}
+                if(state==PoolMissingState::Spent) return fail(PoolStatus::Conflict,"active chain already spent input");
+            }
+            if(!found) r.missing.push_back(op);
+            else { cache.emplace(op,coin); resolved.push_back(coin); }
+        }
+        if(!r.missing.empty()) return fail(PoolStatus::MissingParents,"unresolved inputs");
+        std::set<Hash> ancestors=staged.parents;
+        std::vector<Hash> pending(ancestors.begin(),ancestors.end());
+        for(size_t i=0;i<pending.size();++i) {
+            for(const auto &p:entries_.at(pending[i]).parents)
+                if(ancestors.insert(p).second) pending.push_back(p);
+            if(ancestors.size()>limits_.max_ancestors) return fail(PoolStatus::Capacity,"ancestor limit");
+        }
+        if(staged.parents.size()>limits_.max_edges-edges_) return fail(PoolStatus::Capacity,"edge limit");
+        for(const auto &a:ancestors) {
+            size_t descendants=1;
+            std::set<Hash> closure{a};
+            bool changed=true;
+            while(changed) { changed=false; for(const auto &[id,e]:entries_) if(!closure.contains(id))
+                for(const auto &p:e.parents) if(closure.contains(p)) {closure.insert(id); ++descendants; changed=true; break;}}
+            if(descendants>limits_.max_descendants) return fail(PoolStatus::Capacity,"descendant limit");
+        }
+        --budget.validations;
+        auto profile=ctx.profile;
+        profile.max_total_invocation_cost=std::min(profile.max_total_invocation_cost,budget.invocation_cost);
+        CoinLookup lookup=[&](const Outpoint &op,Coin &coin,std::string &error) {
+            auto it=cache.find(op);
+            if(it!=cache.end()) { coin=it->second; return CoinReadResult::Found; }
+            // The validator also checks created outpoints for collisions. An
+            // uncached outpoint is unknown, rather than authoritatively absent.
+            if(!ctx.active_coins) { error="coin backend unavailable"; return CoinReadResult::Error; }
+            return ctx.active_coins(op,coin,error);
+        };
+        const uint64_t wire_bytes = wire.size();
+        auto checked=CheckOrdinaryWithLookup(tx,profile,ctx.chain_id,lookup,staged.effects,r.error,&wire_bytes,&ids);
+        if(!ctx.current()) return fail(PoolStatus::Stale,"context changed during validation");
+        if(checked!=CandidateCheckResult::Accepted) {
+            r.status=checked==CandidateCheckResult::Invalid ? PoolStatus::Invalid : PoolStatus::Operational;
+            if(r.error=="invocation cost unavailable or over budget" && budget.invocation_cost<ctx.profile.max_total_invocation_cost) r.status=PoolStatus::Capacity;
+            return r;
+        }
+        budget.invocation_cost-=staged.effects.invocation_cost;
+        staged.costs=AuthenticatedTransactionCostsResolved(tx,profile.transaction,resolved,
+            profile.candidate_height,profile.parent_mtp,staged.effects.invocation_cost,ctx.cost,&wire_bytes);
+        if(staged.costs.enforce_linear>limits_.max_transaction_cost || staged.costs.account_linear>limits_.max_transaction_cost)
+            return fail(PoolStatus::Capacity,"transaction cost policy");
+        if(!ctx.current()) return fail(PoolStatus::Stale,"context changed during validation");
+        // Publish via bounded copies so allocation failures cannot poison indices.
+        auto entries=entries_; auto hashes=hashes_; auto spends=spends_;
+        for(const auto &op:staged.effects.consumed) spends.emplace(op,r.txid);
+        hashes.emplace(r.txhash,r.txid); entries.emplace(r.txid,std::move(staged));
+        if(!ctx.current()) return fail(PoolStatus::Stale,"context changed before publication");
+        entries_.swap(entries); hashes_.swap(hashes); spends_.swap(spends);
+        bytes_+=wire.size(); edges_+=entries_.at(r.txid).parents.size();
+        anchor_=ctx.anchor; anchored_=true; r.status=PoolStatus::Accepted; r.error.clear(); return r;
+    } catch(const std::exception &e) { return fail(PoolStatus::Operational,e.what()); }
+}
+PoolSnapshot TransactionPool::Snapshot(PoolAnchor anchor,size_t count,size_t bytes) const {
+    PoolSnapshot out; out.anchor=anchor;
+    if(!enabled_ || (anchored_ && anchor!=anchor_)) return out;
+    out.status=PoolStatus::Accepted; std::set<Hash> emitted;
+    bool changed=true;
+    while(changed && out.entries.size()<count) {
+        changed=false;
+        for(const auto &[id,e]:entries_) {
+            if(emitted.contains(id) || e.wire.size()>bytes) continue;
+            if(!std::all_of(e.parents.begin(),e.parents.end(),[&](const Hash&p){return emitted.contains(p);})) continue;
+            out.entries.push_back(e); emitted.insert(id); bytes-=e.wire.size(); changed=true;
+            if(out.entries.size()==count) break;
+        }
+    }
+    return out;
+}
+bool TransactionPool::ReadWire(const Hash &hash,std::vector<uint8_t> &out) const {
+    if(!enabled_) return false;
+    auto it=hashes_.find(hash); if(it==hashes_.end()) return false;
+    out=entries_.at(it->second).wire; return true;
+}
+bool TransactionPool::SelectedHash(const Hash&id,Hash&out) const {
+    if(!enabled_) return false;
+    auto it=entries_.find(id); if(it==entries_.end()) return false;
+    out=it->second.effects.txhash; return true;
+}
+std::vector<Hash> TransactionPool::Inventory(size_t offset,size_t count) const {
+    std::vector<Hash> out; if(!enabled_) return out;
+    auto it=hashes_.begin(); while(offset && it!=hashes_.end()) {--offset; ++it;}
+    while(count && it!=hashes_.end()) {out.push_back(it->first);--count;++it;} return out;
+}
+PoolResult TransactionPool::Reconcile(const PoolContext &ctx,const std::set<Hash>&connected,
+    const std::vector<Outpoint>&connected_spends,const std::vector<std::vector<uint8_t>>&detached,PoolBudget&budget) {
+    enabled_=false;
+    PoolResult result;
+    auto fail=[&](PoolStatus status,const std::string &error) {
+        rebuild_.reset();result.status=status;result.error=error;return result;
+    };
+    try {
+        if(!ctx.current || !ctx.current()) return fail(PoolStatus::Stale,"reconciliation context unavailable");
+        if(rebuild_ && (rebuild_->anchor!=ctx.anchor || rebuild_->connected!=connected ||
+                       rebuild_->connected_spends!=connected_spends || rebuild_->detached!=detached))
+            rebuild_.reset();
+        if(!rebuild_) {
+            Rebuild stage;stage.anchor=ctx.anchor;stage.connected=connected;
+            stage.connected_spends=connected_spends;
+            std::map<Hash,std::vector<Hash>> descendants;
+            for(const auto &[id,e]:entries_) for(const auto &parent:e.parents)
+                descendants[parent].push_back(id);
+            std::set<Hash> removed=connected;
+            for(const auto &op:connected_spends) {
+                auto it=spends_.find(op);
+                if(it!=spends_.end() && !connected.contains(it->second)) removed.insert(it->second);
+            }
+            std::vector<Hash> pending;
+            for(const auto &id:removed) if(!connected.contains(id)) pending.push_back(id);
+            for(size_t i=0;i<pending.size();++i) for(const auto &child:descendants[pending[i]])
+                if(removed.insert(child).second) pending.push_back(child);
+            for(const auto &[id,e]:entries_) if(!removed.contains(id)) stage.wires.push_back(e.wire);
+            if(detached.size()>limits_.max_entries || stage.wires.size()>limits_.max_entries-detached.size())
+                return fail(PoolStatus::Capacity,"reconciliation input count");
+            size_t total=0;
+            for(const auto *batch:{static_cast<const std::vector<std::vector<uint8_t>> *>(&stage.wires),&detached}) for(const auto &wire:*batch) {
+                if(wire.size()>limits_.max_bytes-total) return fail(PoolStatus::Capacity,"reconciliation input bytes");
+                total+=wire.size();
+            }
+            stage.detached=detached;
+            stage.wires.insert(stage.wires.end(),detached.begin(),detached.end());
+            // Schedule each candidate once, after its in-batch parents. Missing
+            // external inputs and rejected parents do not trigger retry scans.
+            std::vector<Transaction> transactions(stage.wires.size());
+            std::map<Hash,size_t> candidates;
+            for(size_t i=0;i<stage.wires.size();++i) {
+                IdentityDigests ids;std::string error;
+                if(DecodeTransaction(stage.wires[i],ctx.profile.transaction,transactions[i],error) &&
+                   ComputeIdentities(transactions[i],ctx.profile.transaction,ctx.chain_id,ids,error))
+                    candidates.emplace(ids.txid,i);
+            }
+            stage.children.resize(stage.wires.size());stage.remaining.resize(stage.wires.size());
+            size_t edges=0;
+            for(size_t i=0;i<transactions.size();++i) {
+                std::set<size_t> parents;
+                for(const auto &input:transactions[i].inputs) if(input.flags==1) {
+                    auto parent=candidates.find(input.prev_txid);
+                    if(parent!=candidates.end()) parents.insert(parent->second);
+                }
+                if(parents.size()>limits_.max_edges-edges) return fail(PoolStatus::Capacity,"reconciliation input edges");
+                edges+=parents.size();stage.remaining[i]=parents.size();
+                for(auto parent:parents) stage.children[parent].push_back(i);
+                if(parents.empty()) stage.ready.push_back(i);
+            }
+            rebuild_=std::move(stage);
+        }
+        auto &stage=*rebuild_;
+        TransactionPool next(limits_);next.anchor_=ctx.anchor;next.anchored_=true;
+        next.entries_=std::move(stage.entries);next.hashes_=std::move(stage.hashes);
+        next.spends_=std::move(stage.spends);next.bytes_=stage.bytes;next.edges_=stage.edges;
+        auto pause=[&]() {
+            stage.entries=std::move(next.entries_);stage.hashes=std::move(next.hashes_);
+            stage.spends=std::move(next.spends_);stage.bytes=next.bytes_;stage.edges=next.edges_;
+            result.status=PoolStatus::Capacity;result.error="reconciliation validation budget";return result;
+        };
+        while(!stage.ready.empty()) {
+            if(!ctx.current()) return fail(PoolStatus::Stale,"context changed during reconciliation");
+            if(!budget.validations || !budget.invocation_cost) return pause();
+            auto index=stage.ready.front();auto before=budget.validations;
+            auto admitted=next.Admit(stage.wires[index],ctx,budget);
+            // Even cheap refusals consume bounded reconciliation work.
+            if(budget.validations==before) --budget.validations;
+            if(admitted.status==PoolStatus::Capacity &&
+               admitted.error=="invocation cost unavailable or over budget") return pause();
+            if(admitted.status==PoolStatus::Operational || admitted.status==PoolStatus::Stale ||
+               admitted.status==PoolStatus::Capacity) return fail(admitted.status,admitted.error);
+            stage.ready.pop_front();
+            for(auto child:stage.children[index]) if(--stage.remaining[child]==0) stage.ready.push_back(child);
+        }
+        if(!ctx.current()) return fail(PoolStatus::Stale,"context changed before reconciliation publication");
+        *this=std::move(next);result.status=PoolStatus::Accepted;return result;
+    } catch(const std::exception &e) {return fail(PoolStatus::Operational,e.what());}
+}
+}
diff --git a/src/lotus_v2/transaction_pool.h b/src/lotus_v2/transaction_pool.h
new file mode 100644
index 0000000000..efd29a9934
--- /dev/null
+++ b/src/lotus_v2/transaction_pool.h
@@ -0,0 +1,95 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_TRANSACTION_POOL_H
+#define LOTUS_V2_TRANSACTION_POOL_H
+#include "block_cost.h"
+#include <set>
+#include <deque>
+#include <optional>
+namespace lotus::v2 {
+struct PoolAnchor { Hash tip{}; uint64_t generation{}; bool operator==(const PoolAnchor &) const = default; };
+enum class PoolMissingState { Unknown, Spent, Error };
+struct PoolContext {
+    PoolAnchor anchor;
+    OrdinaryCandidateProfile profile;
+    ChainId chain_id;
+    CoinLookup active_coins;
+    // Must fence the same backend snapshot used by active_coins. Serialized
+    // callers only: callbacks must not reenter or mutate this pool.
+    std::function<bool()> current;
+    BlockCostProfile cost;
+    std::function<PoolMissingState(const Outpoint &, std::string &)> classify_missing;
+};
+struct PoolLimits {
+    size_t max_transaction_bytes = 1000000, max_entries = 1000;
+    size_t max_bytes = 16000000, max_edges = 10000;
+    size_t max_ancestors = 100, max_descendants = 100;
+    uint64_t max_transaction_cost = 100000000;
+};
+struct PoolBudget { size_t validations = 1; VmCostUnits invocation_cost = 1000000; };
+enum class PoolStatus { Accepted, Duplicate, Conflict, MissingParents, Invalid, Capacity, Stale, Operational };
+struct PoolResult {
+    PoolStatus status = PoolStatus::Operational;
+    Hash txid{}, txhash{};
+    std::vector<Outpoint> missing;
+    std::string error;
+};
+struct PoolEntry {
+    std::vector<uint8_t> wire;
+    OrdinaryCandidateEffects effects;
+    TransactionCosts costs;
+    std::set<Hash> parents;
+};
+struct PoolSnapshot {
+    PoolStatus status = PoolStatus::Stale;
+    PoolAnchor anchor;
+    std::vector<PoolEntry> entries;
+};
+// Initial policy forbids replacement. First accepted witness for a TxID wins;
+// another TxHash for that TxID returns Conflict. Missing inputs are retriable.
+class TransactionPool {
+public:
+    explicit TransactionPool(PoolLimits limits) : limits_(limits) {}
+    PoolResult Admit(const std::vector<uint8_t> &, const PoolContext &, PoolBudget &);
+    PoolSnapshot Snapshot(PoolAnchor, size_t max_entries, size_t max_bytes) const;
+    bool ReadWire(const Hash &txhash, std::vector<uint8_t> &out) const;
+    bool SelectedHash(const Hash &txid, Hash &out) const;
+    std::vector<Hash> Inventory(size_t offset, size_t count) const;
+    // Rebuild against the NEW authoritative anchor, even when old==new.
+    // Operational/stale/capacity failures preserve data but disable every read
+    // until a successful retry. Detached wires are ordinary transactions only.
+    // Repeated calls with identical anchor/inputs resume a bounded rebuild.
+    // Capacity with ReconcilePending() means fresh budget can make progress;
+    // other failures discard staging. Changed anchor/inputs restart safely.
+    PoolResult Reconcile(const PoolContext &, const std::set<Hash> &connected,
+                         const std::vector<Outpoint> &connected_spends,
+                         const std::vector<std::vector<uint8_t>> &detached,
+                         PoolBudget &);
+    // True only while a budget-limited rebuild can resume.
+    bool ReconcilePending() const { return rebuild_.has_value(); }
+    size_t Size() const { return entries_.size(); }
+    bool Enabled() const { return enabled_; }
+private:
+    struct Rebuild {
+        PoolAnchor anchor;
+        std::set<Hash> connected;
+        std::vector<Outpoint> connected_spends;
+        std::vector<std::vector<uint8_t>> detached, wires;
+        std::vector<std::vector<size_t>> children;
+        std::vector<size_t> remaining;
+        std::deque<size_t> ready;
+        size_t bytes=0, edges=0;
+        std::map<Hash, PoolEntry> entries;
+        std::map<Hash, Hash> hashes;
+        std::map<Outpoint, Hash, OutpointLess> spends;
+    };
+    std::optional<Rebuild> rebuild_;
+    PoolLimits limits_;
+    PoolAnchor anchor_{};
+    bool anchored_ = false, enabled_ = true;
+    size_t bytes_ = 0, edges_ = 0;
+    std::map<Hash, PoolEntry> entries_;
+    std::map<Hash, Hash> hashes_;
+    std::map<Outpoint, Hash, OutpointLess> spends_;
+};
+}
+#endif
