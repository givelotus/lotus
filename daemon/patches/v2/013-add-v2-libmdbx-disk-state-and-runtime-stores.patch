+std::mutex &OpenDirsMutex() {
+    static std::mutex m;
+    return m;
+}
+std::set<std::string> &OpenDirsSet() {
+    static std::set<std::string> s;
+    return s;
+}
+std::string NormalizeDirPath(const std::string &dir) {
+    std::error_code ec;
+    auto p = std::filesystem::weakly_canonical(dir, ec);
+    return ec ? dir : p.string();
+}
