+        Check(quiet_peer.Hello(quiet_pair.a.connection,delegation,e)==PeerResult::Accepted && quiet_remote.Hello(quiet_pair.b.connection,delegation,e)==PeerResult::Accepted,"authenticate quiet-reset fixture");
