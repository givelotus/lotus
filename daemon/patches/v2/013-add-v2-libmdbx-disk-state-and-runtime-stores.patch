+        receive_outcome=PollReceiveResult::LocalFailure;
+        Check(ignored_peer.Handle(ignored_notice,ignored_pair.ms,e)==PeerResult::LocalFailure,"genuine local receive failure remains owner failure");
+        receive_outcome=PollReceiveResult::Ignored;
+        for(unsigned n=1;n<62;++n) Check(ignored_peer.Handle(ignored_notice,ignored_pair.ms+n,e)==PeerResult::Ignored,"pinned ABC tolerates first62 authenticated unknown replies");
+        Check(ignored_peer.Handle(ignored_notice,ignored_pair.ms+62,e)==PeerResult::Rejected && e=="unexpected-ava-response-abuse","63rd authenticated fault crosses unchanged ban-score threshold");
