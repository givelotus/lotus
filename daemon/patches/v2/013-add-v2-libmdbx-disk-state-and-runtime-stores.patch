+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_DRIVER_H
+#define LOTUS_V2_AVALANCHE_DRIVER_H
+#include "avalanche_peer.h"
+#include "avalanche_peer_store.h"
+#include "development_runtime.h"
+namespace lotus::v2::ava {
+struct DriverConfig {
+    Profile profile;
+    PeerLimits limits;
+    CKey session_key;
+    ::avalanche::Delegation delegation;
+    ProofEnvelope local_proof;
+    std::filesystem::path peer_file;
+};
+enum class DriverCode { Ok, NotReady, InvalidConfiguration, StoreFailure, ProtocolFailure, Backpressure };
+struct DriverResult {
+    DriverCode code{DriverCode::Ok};
+    PeerStoreCode store_code{PeerStoreCode::Ok};
+    std::string message;
+    // Peer state was disconnected locally; transport owner must close this id.
+    std::optional<peer::ConnectionId> disconnected_peer{};
+    explicit operator bool() const { return code == DriverCode::Ok; }
+};
+// Read-only observation. Quorum readiness also requires completed IBD and a
+// current authoritative runtime snapshot matching the last proof validation.
+// Establishment is the actual quorum latch, independent of current readiness.
+struct DriverStatus {
+    bool started{}, failed{}, initial_download{true};
+    bool quorum_ready{}, quorum_established{};
+    uint64_t proof_count{}, authenticated_peer_count{}, eligible_peer_count{};
+    uint64_t active_stake_score{}, connected_stake_score{};
+    PollDiagnostics polls;
+    PeerDiagnostics peer;
+    DriverDiagnostics diagnostics;
+    // Null when the current authoritative tip has no live record or authority
+    // is unavailable. Runtime tip_finalized distinguishes finalized absence.
+    std::optional<uint16_t> tip_confidence;
+    bool operator==(const DriverStatus &) const = default;
+};
+// Single owner. Application inv/getdata notices must contain proof inventory
+// only: the node demultiplexes transaction inventory before calling Handle.
+// Caller retains notices on Backpressure. IBD is explicit; clocks are supplied
+// separately (monotonic milliseconds and Unix seconds). Never reenter callbacks.
+class AvalancheDriver {
+public:
+    AvalancheDriver(DevelopmentRuntime &, peer::PeerDispatcher &, DriverConfig);
+    DriverResult Start(bool initial_download, int64_t wall_seconds);
+    DriverResult Tick(bool initial_download, int64_t monotonic_ms, int64_t wall_seconds);
+    PeerResult Activate(peer::ConnectionId, std::string &);
+    PeerResult Handle(const peer::DispatcherNotice &, uint64_t monotonic_ms, std::string &);
+    void Disconnect(peer::ConnectionId, DisconnectCause = DisconnectCause::Unknown);
+    // Durably saves the last active admitted public peer records even while runtime
+    // recovery is pending. Does not assert their current chain eligibility;
+    // Start revalidates every restored record before it can enter the quorum.
+    DriverResult Save();
+    bool Reconcile(const PollItem &, bool, std::string &);
+    bool Ready() const { return started_ && !failed_; }
+    DriverStatus Status() const;
+private:
+    PeerResult HandleImpl(const peer::DispatcherNotice &, uint64_t, std::string &);
+    DriverResult ClosePeer(peer::ConnectionId, DisconnectCause);
+    DriverResult Pump(uint64_t);
+    bool Snapshot(ChainSnapshot &, std::string &);
+    bool Refresh(ChainSnapshot &, std::string &);
+    ChainSnapshot ReadSnapshot();
+    bool Register(const ProofEnvelope &, std::string &);
+    bool ReconcileProofs(std::string &);
+    std::optional<ProofEnvelope> Proof(const ::avalanche::ProofId &) const;
+    bool Apply(const std::vector<BlockUpdate> &, std::string &);
+    PeerCallbacks Callbacks();
+    DriverDiagnostics diagnostics_;
+    DevelopmentRuntime &runtime_;
+    DriverConfig config_;
+    Quorum quorum_;
+    PollEngine polls_;
+    PeerStore store_;
+    AvalanchePeer peer_;
+    bool initial_download_{true}, started_{}, failed_{}, proof_reconcile_pending_{};
+    int64_t now_ms_{}, wall_seconds_{};
+    struct SnapshotCache {
+        Hash tip{};
+        uint64_t revision{};
+        uint64_t generation{};
+        uint64_t height{};
+        uint64_t median_time_past{};
+    };
+    std::optional<SnapshotCache> snapshot_cache_;
+    std::optional<ChainSnapshot> validated_;
+    std::optional<OutgoingPoll> pending_poll_;
+    std::map<peer::ConnectionId, uint64_t> discovery_due_;
+    std::map<::avalanche::ProofId, ProofEnvelope> envelopes_;
+};
+}
+#endif
