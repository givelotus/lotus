+    // BEGIN INVENTORY REFRESH POLICY
+    bool RefreshInventory(size_t cursor, size_t count, uint64_t now,
+                          uint64_t deadline, bool requested = false) {
+        // Zero fences stale cached identities immediately. Soft requests from
+        // submissions/new peers wait for every page, then revisit the prefix
+        // and include newly accepted entries without starving the current tail.
+        return deadline == 0 || (cursor >= count && (requested || now >= deadline));
+    }
+    // END INVENTORY REFRESH POLICY
+    // BEGIN RELAY OUTPUT QUEUE
+    class RelayOutputQueue {
+        struct Pending { std::deque<Message> messages; size_t bytes{}; };
+        std::map<uint64_t, Pending> pending;
+    public:
+        static constexpr size_t MaxMessages = 32, MaxBytes = 2 * 1024 * 1024;
+        bool Empty() const { return pending.empty(); }
+        void Remove(uint64_t peer) { pending.erase(peer); }
+        std::set<uint64_t> Stage(std::vector<RelayAction> actions) {
+            std::map<uint64_t, std::pair<size_t, size_t>> needs;
+            std::set<uint64_t> refused;
+            for (const auto &action : actions) {
+                auto &need = needs[action.peer];
+                ++need.first;
+                if (action.message.payload.size() > MaxBytes - 24 ||
+                    need.second > MaxBytes - 24 - action.message.payload.size())
+                    refused.insert(action.peer);
+                else need.second += 24 + action.message.payload.size();
+            }
+            for (const auto &[peer, need] : needs) {
+                const auto it = pending.find(peer);
+                const auto count = it == pending.end() ? 0 : it->second.messages.size();
+                const auto bytes = it == pending.end() ? 0 : it->second.bytes;
+                if (need.first > MaxMessages - count || need.second > MaxBytes - bytes)
+                    refused.insert(peer);
+            }
+            // Each peer's whole result is staged or removed. Peer state cannot
+            // survive any uncommitted action that the relay already recorded.
+            for (const auto peer : refused) Remove(peer);
+            for (auto &action : actions) if (!refused.contains(action.peer)) {
+                auto &queue = pending[action.peer];
+                queue.bytes += 24 + action.message.payload.size();
+                queue.messages.push_back(std::move(action.message));
+            }
+            return refused;
+        }
+        template <typename Send> std::set<uint64_t> Flush(Send send) {
+            std::set<uint64_t> failed;
+            for (auto it = pending.begin(); it != pending.end();) {
+                auto &queue = it->second;
+                // The dispatcher takes by value; preserve the original until
+                // Queued, including on ordinary Busy output backpressure.
+                const auto result = send(it->first, queue.messages.front());
+                if (result == DispatcherResult::Busy) { ++it; continue; }
+                if (result != DispatcherResult::Queued) {
+                    failed.insert(it->first);
+                    it = pending.erase(it);
+                    continue;
+                }
+                queue.bytes -= 24 + queue.messages.front().payload.size();
+                queue.messages.pop_front();
+                if (queue.messages.empty()) it = pending.erase(it);
+                else ++it;
+            }
+            return failed;
+        }
+    };
+    // END RELAY OUTPUT QUEUE
+    struct Connection {
+        TcpStream stream;
+        std::unique_ptr<Transport> transport;
+        ConnectionId id{};
+        uint64_t nonce{};
+        uint64_t refresh{};
+        bool inbound{};
+        std::optional<size_t> target;
+        std::optional<Hash> requested;
+        bool requested_compact{}, requested_fallback{};
+        uint32_t issued_requests{};
+    };
+    // BEGIN AVALANCHE STARTUP RECOVERY
+    bool RecoverAvalancheStartup(DevelopmentRuntime &runtime, uint64_t future_window,
+        const DevelopmentTickLimits &limits, const std::function<uint64_t()> &utc,
+        const std::function<uint64_t()> &monotonic, std::string &error) {
+        const auto begin=monotonic();
+        for(size_t ticks=0;ticks<10000;++ticks) {
+            const auto now=monotonic();
+            if(now<begin || now-begin>=120000) {error="runtime-recovery-deadline";return false;}
+            const auto snapshot=runtime.Snapshot();
+            if(snapshot.execution_paused) {error="runtime-execution-paused";return false;}
+            if(!snapshot.reopen_required) {
+                if(!snapshot.chain) {error="runtime-authority-unavailable";return false;}
+                if(!snapshot.chain->pending_journal && !snapshot.chain->pending_receipt &&
+                   !snapshot.chain->pending_propagation) {error.clear();return true;}
+            }
+            // Only resume existing durable work. Never perform selection after
+            // an idle authoritative snapshot, and never expose peers/ready yet.
+            const auto tick=runtime.Tick(utc(),future_window,limits);
+            switch(tick.result) {
+                case DevelopmentRuntimeResult::Progress:
+                case DevelopmentRuntimeResult::Prepared:
+                case DevelopmentRuntimeResult::Recovering:
+                case DevelopmentRuntimeResult::CompleteTarget:
+                case DevelopmentRuntimeResult::RestoredSource:
+                case DevelopmentRuntimeResult::Acknowledged:
+                case DevelopmentRuntimeResult::Invalidated:
+                case DevelopmentRuntimeResult::Reopened: break;
+                default: error="runtime-recovery-incomplete";return false;
+            }
+        }
+        error="runtime-recovery-tick-limit";return false;
+    }
+    // END AVALANCHE STARTUP RECOVERY
+    class Node {
+    public:
+        Node(DevelopmentManifest m, NetworkConfig n,
+             std::unique_ptr<DevelopmentRuntime> r, const std::string &directory)
+            : manifest(std::move(m)), network(std::move(n)),
+              runtime(std::move(r)) {
+            std::string error;
+            if(network.avalanche) {
+                const bool recovered=RecoverAvalancheStartup(*runtime,manifest.future_window,
+                    TickLimits(manifest.block_read_limit),Utc,Monotonic,error);
+                Require(recovered,"Avalanche startup recovery: " + error);
+            }
+            manager = std::make_unique<DownloadManager>(
+                DownloadSettings(network.profile), Callbacks());
+            dispatcher = std::make_unique<PeerDispatcher>(
+                *runtime, *manager,
+                DispatcherSettings(network.profile, manifest.block_read_limit),
+                DispatcherCallbacks{
+                    [this](PeerHandle, const ResourceNeed &need) {
+                        return serving.Reserve(need);
+                    },
+                    [](uint64_t &nonce) { return Entropy(nonce); }});
+            const auto anchor = runtime->Snapshot();
+            Require(bool(anchor.chain), "pool runtime anchor unavailable");
+            PoolCoordinatorConfig pc{};
+            pc.directory = directory + "/transaction-index";
+            pc.identity = anchor.chain->identity;
+            pc.profile_digest = network.profile.profile_digest;
+            pc.headers = manifest.hp;
+            pc.ordinary = manifest.op;
+            pc.cost = manifest.cp;
+            pc.max_block_bytes = manifest.block_read_limit;
+            Require(PoolCoordinator::Open(*runtime, pc, pool, error), error);
+            RelayLimits rl{};
+            rl.peers = MaxPeers;
+            rl.transaction_bytes = pc.pool.max_transaction_bytes;
+            relay = std::make_unique<TransactionRelay>(network.profile, rl,
+                [this](const Bytes &wire) {
+                    const auto snap = runtime->Snapshot();
+                    if (!snap.chain) return RelayAdmission::Stale;
+                    PoolBudget budget{1, 1000000};
+                    return static_cast<RelayAdmission>(pool->Submit(wire, snap.chain->stable_tip, budget).status);
+                }, [this](const Hash &hash, Bytes &wire) { return pool->ReadWire(hash, wire); });
+            if (network.avalanche) {
+                avalanche = std::make_unique<ava::AvalancheDriver>(*runtime, *dispatcher, AvalancheSettings(network, directory));
+                const auto started = avalanche->Start(true, Utc());
+                Require(bool(started), "Avalanche startup: " + started.message);
+            }
+            OpenChronik(directory);
+            retry.resize(network.connect.size());
+            connections.reserve(MaxPeers);
+            tracked_bodies.reserve(32);
+            Require(listener.Listen(network.listen, {8, network.listen.family ==
+                                                            TcpFamily::IPv6}) &&
+                        listener.BoundEndpoint(bound),
+                    "cannot listen on explicit endpoint");
+        }
+        ~Node() {
+#ifdef LOTUS_V2_CHRONIK_CXX
+            if (chronik_service) { try { chronik_service.value()->invalidate_authority(); } catch (...) {} }
+            if (chronik_server) { try { chronik_server.value()->stop(); } catch (...) {} }
+#endif
+            avalanche.reset();
+            dispatcher.reset();
+            connections.clear();
+            manager.reset();
+        }
+        void Run();
+
+    private:
