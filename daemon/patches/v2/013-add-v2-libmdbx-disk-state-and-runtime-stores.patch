+// Copyright (c) 2026 The Lotus developers
+// In-memory rollback when an ordinary witness script fails.
+// Not lotusd ConnectTip and not a claim that lotusd accepted a block.
+#include "block.h"
+
+#include "commitment.h"
+#include "signing.h"
+
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+// 0x4e is the numeric literal 1. 0x00 is ZERO. 0x65 is VERIFY.
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+const std::vector<uint8_t> PUSH_ZERO{0x00};
+const std::vector<uint8_t> VERIFY_FALSE{0x00, 0x65};
+const MonetaryProfile kMonetary{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000, 200, Hash{9}};
+
+OrdinaryCandidateProfile MakeProfile(VmCostUnits block_cap) {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, 100, 50000, 2, 3, block_cap};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+Hash Chain() {
+    Hash chain{};
+    for (size_t i = 0; i < chain.size(); ++i)
+        chain[i] = static_cast<uint8_t>(i);
+    return chain;
+}
+
+MonetaryState InitialMoney() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Coin MakeFunding(uint8_t tag, uint32_t index, uint64_t value,
+                 const Hash &branch) {
+    Coin coin;
+    coin.outpoint.tx_id[0] = tag;
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = value;
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = 90;
+    coin.creation_parent_mtp = 49000;
+    coin.coinbase = false;
+    return coin;
+}
+
+Transaction Payment(const Outpoint &spent, uint64_t value,
+                    const std::vector<uint8_t> &witness = TRUE_SCRIPT) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{witness, {}, {}}};
+    tx.inputs.push_back(input);
+    Output output;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    tx.outputs.push_back(output);
+    return tx;
+}
+
+// funding_alternate, when set, is a second spend path on the parent funding
+// coin. Path 0 stays TRUE_SCRIPT so that coin can be spent again after the
+// alternate witness fails. other_script is the single branch on the other coin.
+struct World {
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary = InitialMoney();
+    OrdinaryParentContext parent;
+    Coin funding;
+    Coin other;
+    explicit World(const std::vector<uint8_t> &other_script = TRUE_SCRIPT,
+                   const std::vector<uint8_t> &funding_alternate = {}) {
+        funding = MakeFunding(0x71, 3, 20000, BranchLeaf(TRUE_SCRIPT));
+        if (!funding_alternate.empty()) {
+            funding.output.branches.push_back(BranchLeaf(funding_alternate));
+            funding.output.paths.push_back({1});
+        }
+        other = MakeFunding(0x72, 1, 8000, BranchLeaf(other_script));
+        Check(view.emplace(funding.outpoint, funding).second &&
+                  view.emplace(other.outpoint, other).second &&
+                  utxo.Insert(funding) && utxo.Insert(other),
+              "parent coins");
+        parent.chain_id = Chain();
+        parent.monetary = monetary;
+        parent.header.height = 99;
+        parent.header.time = 50000;
+        parent.header.version = 1;
+        parent.header.size = HEADER_SIZE;
+        parent.header.state_root = StateRoot(
+            parent.chain_id, parent.header.height, utxo.Root(), monetary);
+    }
+};
+
+struct ParentBytes {
+    std::vector<std::vector<uint8_t>> coins;
+    Hash utxo{};
+    std::array<uint8_t, 56> monetary{};
+    Hash state{};
+};
+
+ParentBytes Capture(const World &world) {
+    ParentBytes snap;
+    for (const auto &entry : world.view) {
+        Check(entry.first == entry.second.outpoint, "view outpoint");
+        std::vector<uint8_t> encoded;
+        Check(EncodeCoin(entry.second, encoded), "encode parent coin");
+        snap.coins.push_back(std::move(encoded));
+    }
+    snap.utxo = world.utxo.Root();
+    snap.monetary = EncodeMonetaryState(world.monetary);
+    snap.state = world.parent.header.state_root;
+    return snap;
+}
+
+void ExpectParent(const World &world, const ParentBytes &parent,
+                  const std::string &where) {
+    const ParentBytes now = Capture(world);
+    Check(now.coins == parent.coins, where + " view is not the parent coins");
+    Check(now.utxo == parent.utxo, where + " utxo root moved");
+    Check(now.monetary == parent.monetary, where + " monetary bytes moved");
+    Check(StateRoot(world.parent.chain_id, world.parent.header.height,
+                    world.utxo.Root(), world.monetary) == parent.state,
+          where + " state root moved");
+}
+
+bool Connect(World &world, const std::vector<Transaction> &txs,
+             const OrdinaryCandidateProfile &profile,
+             OrdinaryBlockConnected &connected, std::string &error) {
+    return ConnectOrdinaryBlock(txs, world.parent, profile, kMonetary,
+                                world.view, world.utxo, world.monetary,
+                                connected, error);
+}
+
+void FailingScriptRestoresParentAndTrueSpendWorks() {
+    World world(TRUE_SCRIPT, PUSH_ZERO);
+    const ParentBytes parent = Capture(world);
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    Transaction failing = Payment(world.funding.outpoint, 15000, PUSH_ZERO);
+    failing.inputs[0].path_index = 1;
+    OrdinaryBlockConnected discarded;
+    std::string error;
+    Check(!Connect(world, {failing}, profile, discarded, error),
+          "push-zero witness was accepted");
+    Check(error == "witness VM invalid/unsupported: unclean final stack",
+          "push-zero rejection: " + error);
+    ExpectParent(world, parent, "push-zero");
+
+    Transaction again = Payment(world.funding.outpoint, 15000);
+    OrdinaryBlockConnected connected;
+    error.clear();
+    Check(Connect(world, {again}, profile, connected, error),
+          "TRUE_SCRIPT spend of the parent coin after rollback: " + error);
+    Check(connected.invocation_cost == 18, "true spend cost");
+    Check(world.view.count(world.funding.outpoint) == 0,
+          "parent coin was not spent by TRUE_SCRIPT");
+    IdentityDigests ids;
+    Check(ComputeIdentities(again, profile.transaction, world.parent.chain_id,
+                            ids, error),
+          "true spend identity");
+    Check(world.view.count(Outpoint{ids.txid, 0}) == 1,
+          "TRUE_SCRIPT output missing");
+    Check(world.view.count(world.other.outpoint) == 1, "other coin missing");
+}
+
+void FailedSecondDropsFirstCreatedCoin() {
+    World world(VERIFY_FALSE);
+    const ParentBytes parent = Capture(world);
+    const OrdinaryCandidateProfile profile = MakeProfile(1000000);
+    const Transaction first = Payment(world.funding.outpoint, 15000);
+    Transaction second = Payment(world.other.outpoint, 3000, VERIFY_FALSE);
+    OrdinaryBlockConnected discarded;
+    std::string error;
+    Check(!Connect(world, {first, second}, profile, discarded, error),
+          "block with a failing second script was accepted");
+    Check(error == "witness VM invalid/unsupported: VERIFY false",
+          "second-script rejection: " + error);
+    ExpectParent(world, parent, "two-tx script failure");
+    IdentityDigests first_id;
+    Check(ComputeIdentities(first, profile.transaction, world.parent.chain_id,
+                            first_id, error),
+          "first identity");
+    Check(world.view.count(Outpoint{first_id.txid, 0}) == 0,
+          "first payment's created coin remained in the view");
+    Check(world.view.count(world.funding.outpoint) == 1,
+          "parent funding coin was not restored");
+    Check(world.view.count(world.other.outpoint) == 1,
+          "failing spend removed its parent coin");
+
+    OrdinaryBlockConnected connected;
+    error.clear();
+    Check(Connect(world, {first}, profile, connected, error),
+          "TRUE_SCRIPT payment after the two-tx rollback: " + error);
+    Check(world.view.count(world.funding.outpoint) == 0 &&
+              world.view.count(Outpoint{first_id.txid, 0}) == 1,
+          "restored parent coin did not pay with TRUE_SCRIPT");
+}
+
+struct Built {
+    Transaction first;
+    Transaction second;
+    VmCostUnits one_cost{};
+    OrdinaryCandidateProfile profile;
+};
+
+Built BuildPayments(World &world) {
+    Built built;
+    built.first = Payment(world.funding.outpoint, 15000);
+    const OrdinaryCandidateProfile wide = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(built.first, wide, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure first payment: " + error);
+    Check(effects.invocation_cost == 18 && effects.native_fee == 5000,
+          "unexpected first payment cost or fee");
+    built.one_cost = effects.invocation_cost;
+    built.profile = MakeProfile(built.one_cost * 2);
+    IdentityDigests first_id;
+    Check(ComputeIdentities(built.first, built.profile.transaction,
+                            world.parent.chain_id, first_id, error),
+          "first identity");
+    built.second = Payment(Outpoint{first_id.txid, 0}, 10000);
+    return built;
+}
+
+void TrueScriptBlockStillConnects() {
+    World world;
+    const ParentBytes parent = Capture(world);
+    Built built = BuildPayments(world);
+    OrdinaryBlockConnected connected;
+    std::string error;
+    Check(Connect(world, {built.first, built.second}, built.profile, connected,
+                  error),
+          "true-script block: " + error);
+    Check(connected.invocation_cost == built.one_cost * 2, "block cost");
+    Check(world.utxo.Root() == connected.utxo_root &&
+              world.utxo.Root() != parent.utxo,
+          "true-script block did not move the utxo root");
+    Check(EncodeMonetaryState(world.monetary) == connected.monetary_bytes &&
+              connected.monetary_bytes != parent.monetary,
+          "true-script block did not move monetary bytes");
+    IdentityDigests second_id;
+    Check(ComputeIdentities(built.second, built.profile.transaction,
+                            world.parent.chain_id, second_id, error),
+          "second identity");
+    Check(world.view.count(world.funding.outpoint) == 0 &&
+              world.view.count(world.other.outpoint) == 1 &&
+              world.view.count(Outpoint{second_id.txid, 0}) == 1 &&
+              world.view.size() == 2,
+          "true-script block view");
+}
+} // namespace
+
+int main() {
+    try {
+        FailingScriptRestoresParentAndTrueSpendWorks();
+        FailedSecondDropsFirstCreatedCoin();
+        TrueScriptBlockStillConnects();
+        std::cout << "ordinary script rollback checks passed\n";
+        return 0;
+    } catch (const std::exception &failure) {
+        std::cerr << failure.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_block_template.cpp b/src/lotus_v2/test_block_template.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cdfe52bff51b629ca2d2f0ba264f6fc7c587b6a5
--- /dev/null
+++ b/src/lotus_v2/test_block_template.cpp
@@ -0,0 +1,197 @@
+#include "block_template.h"
+
+#include <array>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool condition, const char *message) {
+    if (!condition) {
+        std::cerr << "V2 block template: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+std::string Hex(const uint8_t *data, size_t size) {
+    constexpr char chars[] = "0123456789abcdef";
+    std::string result;
+    result.reserve(size * 2);
+    for (size_t i = 0; i < size; ++i) {
+        result.push_back(chars[data[i] >> 4]);
+        result.push_back(chars[data[i] & 15]);
+    }
+    return result;
+}
+
+std::string Hex(const Hash &hash) { return Hex(hash.data(), hash.size()); }
+
+Header Parent() {
+    Header parent;
+    for (size_t i = 0; i < parent.prev_id.size(); ++i) {
+        parent.prev_id[i] = static_cast<uint8_t>(0x40 + i);
+        parent.tx_root[i] = 0x11;
+        parent.state_root[i] = 0x22;
+    }
+    parent.bits = 0x2100ffff;
+    parent.time = 1700000000;
+    parent.nonce = 0;
+    parent.version = 2;
+    parent.size = 200;
+    parent.height = 4;
+    return parent;
+}
+
+Hash Ceiling() {
+    Hash ceiling{};
+    ceiling.fill(0xff);
+    return ceiling;
+}
+
+bool SameHeader(const Header &left, const Header &right) {
+    return left.prev_id == right.prev_id && left.bits == right.bits && left.time == right.time &&
+           left.nonce == right.nonce && left.version == right.version && left.size == right.size &&
+           left.height == right.height && left.tx_root == right.tx_root &&
+           left.state_root == right.state_root;
+}
+
+bool SubtractOne(Hash &value) {
+    for (uint8_t &byte : value) {
+        if (byte == 0) {
+            byte = 0xff;
+            continue;
+        }
+        --byte;
+        return true;
+    }
+    return false;
+}
+} // namespace
+
+int main() {
+    const ChainId chain_id = [] {
+        ChainId id{};
+        for (size_t i = 0; i < id.size(); ++i) id[i] = static_cast<uint8_t>(i);
+        return id;
+    }();
+    const Header parent = Parent();
+    Hash tx_root{};
+    Hash state_root{};
+    tx_root.fill(0x33);
+    state_root.fill(0x44);
+    constexpr uint64_t time = 1700000120;
+    constexpr uint64_t size = 400;
+    constexpr uint32_t bits = 0x2100ffff;
+
+    const std::optional<Header> child =
+        BuildChildHeader(parent, chain_id, tx_root, state_root, time, size, bits);
+    Check(child.has_value(), "build child header");
+    Hash parent_id{};
+    Check(BlockId(chain_id, parent, parent_id), "parent block id");
+    Check(child->prev_id == parent_id, "prev_id is the parent block id");
+    Check(child->height == parent.height + 1, "height is parent plus one");
+    Check(child->nonce == 0, "nonce starts at zero");
+    Check(child->version == parent.version, "version is copied from the parent");
+    Check(child->tx_root == tx_root && child->state_root == state_root, "supplied roots");
+    Check(child->tx_root != parent.tx_root && child->state_root != parent.state_root,
+          "roots are not copied from the parent");
+    Check(child->time == time && child->size == size && child->bits == bits,
+          "supplied time, size, and bits");
+
+    std::array<uint8_t, HEADER_SIZE> bytes{};
+    Check(SerializeHeader(*child, bytes), "serialize child");
+    Check(bytes.size() == 134, "serialized header is 134 bytes");
+    Header parsed;
+    parsed.nonce = 99;
+    Check(ParseHeader(bytes.data(), bytes.size(), parsed) && parsed.nonce == 0,
+          "serialized header round-trips");
+
+    Check(!BuildChildHeader(parent, chain_id, tx_root, state_root, MAX_TIME + 1, size, bits),
+          "reject timestamp above MAX_TIME");
+    const uint32_t rejected_bits[] = {0x1d80ffff, 0x1d000000, 0x22010000, 0x03000001, 0};
+    for (uint32_t bad : rejected_bits) {
+        Check(!BuildChildHeader(parent, chain_id, tx_root, state_root, time, size, bad),
+              "reject bits DecodeTarget rejects");
+    }
+    Header overflow = parent;
+    overflow.height = std::numeric_limits<uint64_t>::max();
+    Check(!BuildChildHeader(overflow, chain_id, tx_root, state_root, time, size, bits),
+          "reject height overflow");
+    Header unhashable = parent;
+    unhashable.time = MAX_TIME + 1;
+    Check(!BuildChildHeader(unhashable, chain_id, tx_root, state_root, time, size, bits),
+          "reject a parent whose block id cannot be computed");
+    Check(BuildChildHeader(parent, chain_id, tx_root, state_root, MAX_TIME, size, bits).has_value(),
+          "maximum u48 timestamp is accepted");
+
+    Hash target{};
+    Check(DecodeTarget(bits, Ceiling(), target), "decode the easy target");
+    // Local searches only. No call below tries more than 256 nonces.
+    Header easy = *child;
+    Check(SearchNonce(easy, chain_id, target, 0, 8), "easy target found within 8 attempts");
+    Hash found_id{};
+    Check(BlockId(chain_id, easy, found_id) && MeetsTarget(found_id, target),
+          "found header meets target");
+    Check(easy.nonce < 8, "winning nonce is inside the attempt window");
+    Check(easy.prev_id == child->prev_id && easy.bits == child->bits && easy.time == child->time &&
+              easy.version == child->version && easy.size == child->size &&
+              easy.height == child->height && easy.tx_root == child->tx_root &&
+              easy.state_root == child->state_root,
+          "search changes only the nonce");
+    Check(child->nonce == 0, "the template nonce stays zero");
+
+    Header at_cap = *child;
+    Check(SearchNonce(at_cap, chain_id, target, easy.nonce, MAX_NONCE_ATTEMPTS),
+          "256 attempts are allowed");
+    Check(at_cap.nonce == easy.nonce, "known nonce is accepted at the attempt cap");
+
+    Header refused = *child;
+    refused.nonce = 77;
+    const Header refused_before = refused;
+    Check(!SearchNonce(refused, chain_id, target, 3, 257), "257 attempts are refused");
+    Check(SameHeader(refused, refused_before), "refused search leaves the header unchanged");
+
+    Hash lowest{};
+    lowest.fill(0xff);
+    for (uint64_t nonce = 0; nonce < 4; ++nonce) {
+        Header candidate = *child;
+        candidate.nonce = nonce;
+        Hash block_id{};
+        Check(BlockId(chain_id, candidate, block_id), "hard-target candidate id");
+        if (MeetsTarget(block_id, lowest)) lowest = block_id;
+    }
+    Check(SubtractOne(lowest), "candidate block ids are not zero");
+    Header missed = *child;
+    missed.nonce = 55;
+    const Header missed_before = missed;
+    Check(!SearchNonce(missed, chain_id, lowest, 0, 4), "hard target misses within 4 attempts");
+    Check(SameHeader(missed, missed_before), "a miss leaves the header unchanged");
+
+    const Hash body = BodyHash(chain_id, *child);
+    Hash work{};
+    Hash block_id{};
+    Check(WorkHash(chain_id, *child, work), "child work hash");
+    Check(BlockId(chain_id, *child, block_id), "child template block id");
+
+    const std::string json =
+        std::string("{\"protocol\":\"v2\",\"job_id\":\"native-037-template\",\"chain_id\":\"") +
+        Hex(chain_id) + "\",\"header\":\"" + Hex(bytes.data(), bytes.size()) +
+        "\",\"target\":\"" + Hex(target) + "\"}";
+    const std::filesystem::path path = "/tmp/lotus-v2-native-037-packet/job.json";
+    std::filesystem::create_directories(path.parent_path());
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    Check(static_cast<bool>(file), "open job json");
+    file << json << '\n';
+    Check(static_cast<bool>(file), "write job json");
+
+    std::cout << "V2 block template passed\n";
+    std::cout << "body " << Hex(body) << '\n';
+    std::cout << "work " << Hex(work) << '\n';
+    std::cout << "block_id " << Hex(block_id) << '\n';
+    std::cout << "job " << json << '\n';
+}
diff --git a/src/lotus_v2/test_candidate_body_pool.cpp b/src/lotus_v2/test_candidate_body_pool.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..37d2552eddf5a08e85d5835ad0922fb68d68e5cb
--- /dev/null
+++ b/src/lotus_v2/test_candidate_body_pool.cpp
@@ -0,0 +1,366 @@
+// Copyright (c) 2026 The Lotus developers
+#include "candidate_body_pool.h"
+#include <algorithm>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <stdexcept>
+using namespace lotus::v2;
+// Executable-local allocation fault seam, absent from the pool API. Fail once
+// then disarm so diagnostics and exception cleanup can run normally.
+namespace {
+long allocation_countdown = -1;
+}
+void *operator new(std::size_t size) {
+    if (allocation_countdown == 0) {
+        allocation_countdown = -1;
+        throw std::bad_alloc();
+    }
+    if (allocation_countdown > 0) --allocation_countdown;
+    if (auto *p = std::malloc(size ? size : 1)) return p;
+    throw std::bad_alloc();
+}
+void *operator new[](std::size_t n) {
+    return ::operator new(n);
+}
+void operator delete(void *p) noexcept {
+    std::free(p);
+}
+void operator delete[](void *p) noexcept {
+    std::free(p);
+}
+void operator delete(void *p, std::size_t) noexcept {
+    std::free(p);
+}
+void operator delete[](void *p, std::size_t) noexcept {
+    std::free(p);
+}
+#define CHECK(c)                                                               \
+    do {                                                                       \
+        if (!(c))                                                              \
+            throw std::runtime_error("line " + std::to_string(__LINE__) +      \
+                                     ": " #c);                                 \
+    } while (false)
+namespace {
+const TxProfile PROFILE{32, 32, 8, 512, 8, 8192, 64};
+ChainId Chain() {
+    ChainId c{};
+    c[0] = 77;
+    return c;
+}
+struct Fixture {
+    Header header;
+    std::vector<uint8_t> wire;
+    Hash id;
+    explicit Fixture(uint32_t tag = 1, unsigned count = 1) {
+        std::vector<Transaction> transactions;
+        for (unsigned n = 0; n < count; ++n) {
+            Transaction tx;
+            Input input;
+            input.flags = n ? 1 : 2;
+            input.prev_txid[0] = static_cast<uint8_t>(tag + n);
+            input.prev_index = 42;
+            input.sequence = UINT32_MAX;
+            if (n) input.witnesses = {BranchWitness{{0x4e}, {}, {}}};
+            tx.inputs = {input};
+            Output output;
+            output.value = 100 + n;
+            output.branches = {BranchLeaf(std::vector<uint8_t>{0x4e})};
+            output.paths = {{0}};
+            tx.outputs = {output};
+            transactions.push_back(std::move(tx));
+        }
+        header.version = 2;
+        header.height = 5;
+        header.prev_id[0] = 99;
+        header.time = 1000 + tag;
+        header.bits = 0x207fffff;
+        header.state_root[0] = static_cast<uint8_t>(tag);
+        header.size = HEADER_SIZE + 4;
+        std::string error;
+        for (const auto &tx : transactions) {
+            std::vector<uint8_t> bytes;
+            CHECK(EncodeTransaction(tx, PROFILE, bytes, error));
+            header.size += bytes.size() + CompactSizeWidth(bytes.size());
+        }
+        CHECK(CompleteTransactionRoot(transactions, PROFILE, Chain(),
+                                      header.tx_root, error));
+        CHECK(EncodeBlockWire(header, transactions, PROFILE, wire, error));
+        CHECK(BlockId(Chain(), header, id));
+    }
+};
+CandidateBodyLimits Limits(uint64_t bytes = 65536) {
+    return {8, bytes, bytes * 4, 8, bytes * 4, 32};
+}
+void BindingAndContext() {
+    Fixture f;
+    CandidateBodyPool pool(Chain(), PROFILE, Limits(), 10);
+    CHECK(pool.PutAuthenticated(f.id, f.header, f.wire) ==
+          CandidateBodyStatus::RetainedAuthenticated);
+    CHECK(pool.Stats().epoch == 11 && pool.Stats().bodies == 1 &&
+          pool.Stats().resident_wire_bytes == f.wire.size());
+    CHECK(pool.Probe(f.id, f.header, f.wire.size()) ==
+          CandidateBodyStatus::Available);
+    CHECK(pool.Probe(f.id, f.header, f.wire.size() - 1) ==
+          CandidateBodyStatus::CapacityRefused);
+    CHECK(pool.PutAuthenticated(f.id, f.header, f.wire) ==
+              CandidateBodyStatus::Duplicate &&
+          pool.Stats().epoch == 11);
+    FramedBlock decoded;
+    std::string error;
+    CHECK(DecodeBlockWire(f.wire, PROFILE, Chain(), decoded, error));
+    CHECK(!CheckCoinbaseContext(decoded.transactions.front(), f.header.prev_id,
+                                f.header.height, error));
+    // Retention authenticates these exact bytes despite a known contextual
+    // coinbase failure; it is never reported as a block acceptance result.
+    CandidateBodyPin pin;
+    CHECK(pool.Pin(f.id, f.header, f.wire.size(), pin) ==
+          CandidateBodyStatus::Available);
+    CHECK(pin && std::equal(pin.Wire().begin(), pin.Wire().end(),
+                            f.wire.begin(), f.wire.end()));
+    CHECK(pin.BoundHeader() && pin.BoundHeader()->height == f.header.height);
+    std::vector<uint8_t> copy{9};
+    CHECK(pin.CopyTo(f.wire.size() - 1, copy) ==
+              CandidateBodyStatus::CapacityRefused &&
+          copy == std::vector<uint8_t>{9});
+    CHECK(pin.CopyTo(f.wire.size(), copy) == CandidateBodyStatus::Available &&
+          copy == f.wire);
+    auto altered = f.header;
+    ++altered.time;
+    CHECK(pool.Probe(f.id, altered, f.wire.size()) ==
+          CandidateBodyStatus::Malformed);
+    CHECK(pool.Pin(f.id, altered, f.wire.size(), pin) ==
+              CandidateBodyStatus::Malformed &&
+          pin);
+    CHECK(pool.Evict(f.id) == CandidateBodyStatus::Pinned);
+    pin = {};
+    CHECK(pool.Stats().pins == 0 && pool.Stats().pinned_wire_bytes == 0);
+    CHECK(pool.Evict(f.id) == CandidateBodyStatus::Evicted &&
+          pool.Stats().epoch == 12);
+    CHECK(pool.Stats().resident_wire_bytes == 0 &&
+          pool.Probe(f.id, f.header, UINT64_MAX) ==
+              CandidateBodyStatus::Missing);
+    CHECK(pool.PutAuthenticated(f.id, f.header, f.wire) ==
+              CandidateBodyStatus::RetainedAuthenticated &&
+          pool.Stats().epoch == 13);
+}
+void Corruption() {
+    Fixture f;
+    CandidateBodyPool pool(Chain(), PROFILE, Limits(), 0);
+    auto bad = f.wire;
+    bad.back() ^= 1;
+    CHECK(pool.PutAuthenticated(f.id, f.header, bad) ==
+          CandidateBodyStatus::Malformed);
+    bad = f.wire;
+    bad.push_back(0);
+    CHECK(pool.PutAuthenticated(f.id, f.header, bad) ==
+          CandidateBodyStatus::Malformed);
+    auto wrong = f.id;
+    wrong[0] ^= 1;
+    CHECK(pool.PutAuthenticated(wrong, f.header, f.wire) ==
+          CandidateBodyStatus::Malformed);
+    auto h = f.header;
+    ++h.time;
+    CHECK(pool.PutAuthenticated(f.id, h, f.wire) ==
+          CandidateBodyStatus::Malformed);
+    // Well-framed bytes with a wrong root fail before publication.
+    h = f.header;
+    h.tx_root[0] ^= 1;
+    std::array<uint8_t, HEADER_SIZE> header;
+    CHECK(SerializeHeader(h, header));
+    bad = f.wire;
+    std::copy(header.begin(), header.end(), bad.begin());
+    Hash id;
+    CHECK(BlockId(Chain(), h, id));
+    CHECK(pool.PutAuthenticated(id, h, bad) == CandidateBodyStatus::Malformed);
+    CandidateBodyPool wrong_chain(ChainId{}, PROFILE, Limits(), 0);
+    CHECK(wrong_chain.PutAuthenticated(f.id, f.header, f.wire) ==
+          CandidateBodyStatus::Malformed);
+    CHECK(pool.Stats().bodies == 0 && pool.Stats().epoch == 0 &&
+          pool.Stats().resident_wire_bytes == 0);
+    // Truncations cannot publish partial entries or change the epoch.
+    for (size_t n = 0; n < f.wire.size(); ++n) {
+        bad.assign(f.wire.begin(), f.wire.begin() + n);
+        CHECK(pool.PutAuthenticated(f.id, f.header, bad) ==
+              CandidateBodyStatus::Malformed);
+    }
+}
+void CapsAndEpoch() {
+    auto invalid_profile = PROFILE;
+    invalid_profile.max_inputs = 0;
+    bool rejected = false;
+    try {
+        CandidateBodyPool bad(Chain(), invalid_profile, Limits(), 0);
+    } catch (const std::invalid_argument &) {
+        rejected = true;
+    }
+    CHECK(rejected);
+    Fixture a, b(2), multiple(3, 2);
+    auto limits = Limits(a.wire.size());
+    limits.max_resident_wire_bytes = a.wire.size();
+    limits.max_bodies = 1;
+    limits.max_pins = 1;
+    limits.max_pinned_wire_bytes = a.wire.size();
+    CandidateBodyPool pool(Chain(), PROFILE, limits, 0);
+    CHECK(pool.PutAuthenticated(a.id, a.header, a.wire) ==
+          CandidateBodyStatus::RetainedAuthenticated);
+    CHECK(pool.PutAuthenticated(b.id, b.header, b.wire) ==
+          CandidateBodyStatus::CapacityRefused);
+    CandidateBodyPin one, two;
+    CHECK(pool.Pin(a.id, a.header, a.wire.size(), one) ==
+          CandidateBodyStatus::Available);
+    CHECK(pool.Pin(a.id, a.header, a.wire.size(), two) ==
+              CandidateBodyStatus::CapacityRefused &&
+          !two);
+    CHECK(pool.Stats().pins == 1 &&
+          pool.Stats().pinned_wire_bytes == a.wire.size() &&
+          pool.Stats().epoch == 1);
+    one = {};
+    CHECK(pool.Evict(a.id) == CandidateBodyStatus::Evicted);
+    CHECK(pool.PutAuthenticated(b.id, b.header, b.wire) ==
+          CandidateBodyStatus::RetainedAuthenticated);
+    auto l = Limits();
+    l.max_decode_transactions = 1;
+    CandidateBodyPool count(Chain(), PROFILE, l, 0);
+    CHECK(count.PutAuthenticated(multiple.id, multiple.header, multiple.wire) ==
+              CandidateBodyStatus::CapacityRefused &&
+          count.Stats().epoch == 0);
+    l = Limits(a.wire.size() - 1);
+    CandidateBodyPool bytes(Chain(), PROFILE, l, 0);
+    CHECK(bytes.PutAuthenticated(a.id, a.header, a.wire) ==
+          CandidateBodyStatus::CapacityRefused);
+    l = Limits();
+    l.max_pinned_wire_bytes = a.wire.size() - 1;
+    CandidateBodyPool pinbytes(Chain(), PROFILE, l, 0);
+    CHECK(pinbytes.PutAuthenticated(a.id, a.header, a.wire) ==
+          CandidateBodyStatus::RetainedAuthenticated);
+    CHECK(pinbytes.Pin(a.id, a.header, UINT64_MAX, two) ==
+          CandidateBodyStatus::CapacityRefused);
+    CandidateBodyPool epoch(Chain(), PROFILE, Limits(), UINT64_MAX - 1);
+    CHECK(epoch.PutAuthenticated(a.id, a.header, a.wire) ==
+              CandidateBodyStatus::RetainedAuthenticated &&
+          epoch.Stats().epoch == UINT64_MAX);
+    CHECK(epoch.PutAuthenticated(a.id, a.header, a.wire) ==
+          CandidateBodyStatus::Duplicate);
+    CHECK(epoch.Evict(a.id) == CandidateBodyStatus::EpochExhausted);
+    CHECK(epoch.PutAuthenticated(b.id, b.header, b.wire) ==
+              CandidateBodyStatus::EpochExhausted &&
+          epoch.Stats().bodies == 1);
+    CHECK(epoch.Pin(a.id, a.header, UINT64_MAX, two) ==
+          CandidateBodyStatus::Available);
+    CandidateBodyPool exhausted(Chain(), PROFILE, Limits(), UINT64_MAX);
+    CHECK(exhausted.PutAuthenticated(a.id, a.header, a.wire) ==
+              CandidateBodyStatus::EpochExhausted &&
+          exhausted.Stats().bodies == 0);
+}
+void PinLifetime() {
+    {
+        Fixture repeated;
+        auto l = Limits();
+        l.max_pins = 2;
+        l.max_pinned_wire_bytes = repeated.wire.size() * 2;
+        CandidateBodyPool pool(Chain(), PROFILE, l, 0);
+        CHECK(pool.PutAuthenticated(repeated.id, repeated.header,
+                                    repeated.wire) ==
+              CandidateBodyStatus::RetainedAuthenticated);
+        CandidateBodyPin a, b, c;
+        CHECK(pool.Pin(repeated.id, repeated.header, UINT64_MAX, a) ==
+              CandidateBodyStatus::Available);
+        CHECK(pool.Pin(repeated.id, repeated.header, UINT64_MAX, b) ==
+              CandidateBodyStatus::Available);
+        CHECK(pool.Stats().pins == 2 &&
+              pool.Stats().pinned_wire_bytes == repeated.wire.size() * 2);
+        CHECK(pool.Pin(repeated.id, repeated.header, UINT64_MAX, c) ==
+              CandidateBodyStatus::CapacityRefused);
+        a = {};
+        CHECK(pool.Stats().pins == 1 &&
+              pool.Stats().pinned_wire_bytes == repeated.wire.size());
+    }
+    Fixture f, other(2);
+    CandidateBodyPin pin;
+    {
+        CandidateBodyPool pool(Chain(), PROFILE, Limits(), 0);
+        CHECK(pool.PutAuthenticated(f.id, f.header, f.wire) ==
+              CandidateBodyStatus::RetainedAuthenticated);
+        CHECK(pool.PutAuthenticated(other.id, other.header, other.wire) ==
+              CandidateBodyStatus::RetainedAuthenticated);
+        CHECK(pool.Pin(f.id, f.header, UINT64_MAX, pin) ==
+              CandidateBodyStatus::Available);
+        CandidateBodyPin moved = std::move(pin);
+        CHECK(!pin && moved);
+        pin = std::move(moved);
+        CHECK(pin && !moved && pool.Stats().pins == 1);
+        CHECK(pool.Evict(other.id) == CandidateBodyStatus::Evicted);
+    }
+    std::vector<uint8_t> copy;
+    CHECK(pin.CopyTo(UINT64_MAX, copy) == CandidateBodyStatus::Available &&
+          copy == f.wire);
+    pin = {};
+    CHECK(!pin && pin.Wire().empty() && !pin.BoundHeader());
+    CHECK(pin.CopyTo(UINT64_MAX, copy) == CandidateBodyStatus::Missing);
+}
+void AllocationFailures() {
+    Fixture f;
+    bool success = false;
+    unsigned failures = 0;
+    for (long n = 0; n < 1000; ++n) {
+        CandidateBodyPool pool(Chain(), PROFILE, Limits(), 0);
+        allocation_countdown = n;
+        const auto result = pool.PutAuthenticated(f.id, f.header, f.wire);
+        allocation_countdown = -1;
+        if (result == CandidateBodyStatus::RetainedAuthenticated) {
+            success = true;
+            break;
+        }
+        CHECK(result == CandidateBodyStatus::CapacityRefused);
+        CHECK(pool.Stats().bodies == 0 &&
+              pool.Stats().resident_wire_bytes == 0 && pool.Stats().epoch == 0);
+        CHECK(pool.Probe(f.id, f.header, UINT64_MAX) ==
+              CandidateBodyStatus::Missing);
+        ++failures;
+    }
+    CHECK(success && failures > 10);
+    CandidateBodyPool pool(Chain(), PROFILE, Limits(), 0);
+    CHECK(pool.PutAuthenticated(f.id, f.header, f.wire) ==
+          CandidateBodyStatus::RetainedAuthenticated);
+    CandidateBodyPin pin;
+    allocation_countdown = 0;
+    auto result = pool.Pin(f.id, f.header, UINT64_MAX, pin);
+    allocation_countdown = -1;
+    CHECK(result == CandidateBodyStatus::CapacityRefused && !pin &&
+          pool.Stats().pins == 0 && pool.Stats().epoch == 1);
+    CHECK(pool.Pin(f.id, f.header, UINT64_MAX, pin) ==
+          CandidateBodyStatus::Available);
+    std::vector<uint8_t> copy{9};
+    allocation_countdown = 0;
+    result = pin.CopyTo(UINT64_MAX, copy);
+    allocation_countdown = -1;
+    CHECK(result == CandidateBodyStatus::CapacityRefused &&
+          copy == std::vector<uint8_t>{9} && pin && pool.Stats().pins == 1);
+    // Preflight capacity refusals allocate nothing, even with the next
+    // allocation armed to fail; no decode/copy happens under an exhausted cap.
+    auto l = Limits(f.wire.size() - 1);
+    CandidateBodyPool capped(Chain(), PROFILE, l, 0);
+    allocation_countdown = 0;
+    result = capped.PutAuthenticated(f.id, f.header, f.wire);
+    const bool untouched = allocation_countdown == 0;
+    allocation_countdown = -1;
+    CHECK(result == CandidateBodyStatus::CapacityRefused && untouched);
+    std::cout << "allocation failure points checked: " << failures << '\n';
+}
+} // namespace
+int main() {
+    try {
+        BindingAndContext();
+        Corruption();
+        CapsAndEpoch();
+        PinLifetime();
+        AllocationFailures();
+        std::cout << "candidate body pool checks passed\n";
+        return 0;
+    } catch (const std::exception &e) {
+        allocation_countdown = -1;
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_candidate_selection.cpp b/src/lotus_v2/test_candidate_selection.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7e7d5e9ab2d061bc65bbb54b12314b8a90adb4a4
--- /dev/null
+++ b/src/lotus_v2/test_candidate_selection.cpp
@@ -0,0 +1,383 @@
+// Copyright (c) 2026 The Lotus developers
+// Socket-free selector/storage tests. Headers are explicitly synthetic mechanical
+// index fixtures; body availability is injected, not a VM/consensus-valid claim.
+#include "candidate_selection.h"
+#include "disk_state.h"
+#include "vendor/blake3/blake3.h"
+#include <leveldb/db.h>
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <iostream>
+#include <limits>
+#include <map>
+#include <set>
+#include <stdexcept>
+using namespace lotus::v2;
+namespace {
+void Check(bool ok, const std::string &why) { if (!ok) throw std::runtime_error(why); }
+Hash Tag(uint32_t n) { Hash h{}; for (unsigned i = 0; i < 4; ++i) h[i] = uint8_t(n >> (8 * i)); return h; }
+struct Fixture {
+    std::string path;
+    HeaderChainProfile profile;
+    DiskStateOptions options;
+    DiskStateStore store;
+    Header genesis, active;
+    uint32_t sequence{1};
+    std::set<Hash> bodies;
+    std::vector<Hash> probes;
+    explicit Fixture(const std::string &directory) : path(directory) {
+        std::filesystem::remove_all(path);
+        std::filesystem::create_directories(std::filesystem::path(path).parent_path());
+        profile.chain_id = Tag(0x1234); profile.version = 2; profile.genesis_time = 1000;
+        profile.genesis_bits = 0x207fffff; profile.half_life_seconds = 172800; profile.spacing_seconds = 120;
+        Hash maximum; maximum.fill(255);
+        Check(DecodeTarget(profile.genesis_bits, maximum, profile.pow_limit), "target");
+        genesis.version = profile.version; genesis.bits = profile.genesis_bits;
+        genesis.time = profile.genesis_time; genesis.size = HEADER_SIZE + 4;
+        genesis.tx_root = Tag(sequence++); genesis.state_root = Tag(2); Mine(genesis);
+        profile.genesis_id = Id(genesis);
+        options.identity = profile.chain_id; options.profile_digest = Tag(0x5678); options.header_index = profile;
+        options.recovery = DiskRecoveryOptions{65536, 65536};
+        options.candidates = CandidateStoreOptions{1024, 1024, 16};
+        options.cache_bytes = 1024; options.write_buffer_bytes = 65536;
+        DiskStateError error;
+        Check(DiskStateStore::Open(path, options, {}, store, error), "open: " + error.message);
+        Commit(genesis);
+    }
+    ~Fixture() { store = {}; if (!std::uncaught_exceptions()) std::filesystem::remove_all(path); }
+    Hash Id(const Header &h) const { Hash id; Check(BlockId(profile.chain_id, h, id), "ID"); return id; }
+    void Mine(Header &h) const {
+        Hash target; Check(DecodeTarget(h.bits, profile.pow_limit, target), "mine target");
+        while (!MeetsTarget(Id(h), target)) ++h.nonce;
+    }
+    Header Child(const Header &parent, uint32_t bits = 0x207fffff, uint64_t time = 0) {
+        Header h; h.prev_id = Id(parent); h.height = parent.height + 1; h.version = profile.version;
+        h.bits = bits; h.time = time ? time : parent.time + 120;
+        h.size = HEADER_SIZE + 4; h.tx_root = Tag(sequence++); h.state_root = Tag(sequence++);
+        Mine(h); return h;
+    }
+    DiskStateMetadata Meta(const Header &h) const {
+        DiskStateMetadata m; m.tip = Id(h); std::array<uint8_t, HEADER_SIZE> bytes;
+        Check(SerializeHeader(h, bytes), "header serialization"); m.header.assign(bytes.begin(), bytes.end());
+        m.monetary = {1, 2, 3}; m.auxiliary = {4, 5, 6}; return m;
+    }
+    void Commit(const Header &h) {
+        DiskStateError error; DiskStateTransaction tx;
+        Check(store.Begin(tx, error), "begin: " + error.message);
+        Check(tx.Commit(Meta(h), h, error), "commit: " + error.message);
+        active = h; bodies.insert(Id(h));
+    }
+    void Add(const Header &h, bool body = true) {
+        DiskStateError error;
+        Check(store.PutCheckedHeader(h, error), "header admission: " + error.message);
+        if (body) bodies.insert(Id(h));
+    }
+    CandidateBodyProbe Probe() {
+        return [&](const Hash &id, const Header &h, uint64_t maximum, std::string &) {
+            Check(Id(h) == id && maximum, "authenticated bounded probe input"); probes.push_back(id);
+            return bodies.contains(id) ? CandidateBodyResult::Available : CandidateBodyResult::Missing;
+        };
+    }
+};
+CandidateLimits Limits() {
+    CandidateLimits l; l.query = {64, 20000, 20000, 1 << 20}; l.fork = {64, 64, 4096};
+    l.max_probe_calls = 128; l.max_probe_bytes = 65536; l.max_missing_bodies = 8;
+    l.max_resident_bytes = 1 << 20; return l;
+}
+CandidateResult Poll(Fixture &f, CandidateSelector &selector, CandidateChoices &choices,
+    const CandidateLimits &limits, uint64_t now = 20000, uint64_t window = 0, uint64_t epoch = 1,
+    const CandidateBodyProbe &custom = {}) {
+    CandidatePollUsage used; DiskStateError error;
+    const auto before = f.store.LastStats().database_reads;
+    const auto result = selector.Poll(f.Id(f.active), now, window, epoch, limits,
+                                     custom ? custom : f.Probe(), f.store, choices, used, error);
+    Check(used.query.reads == f.store.LastStats().database_reads - before, "all actual Gets reported");
+    Check(used.query.reads <= limits.query.max_reads && used.query.rows <= limits.query.max_rows &&
+          used.query.iterator_steps <= limits.query.max_iterator_steps &&
+          used.query.decoded_bytes <= limits.query.max_decoded_bytes && used.probe_calls <= limits.max_probe_calls,
+          "all per-poll caps respected");
+    Check(result != CandidateResult::StorageError, "unexpected storage error: " + error.message);
+    return result;
+}
+CandidateResult Finish(Fixture &f, CandidateSelector &selector, CandidateChoices &choices,
+    const CandidateLimits &limits, uint64_t now = 20000, uint64_t window = 0, uint64_t epoch = 1) {
+    for (unsigned n = 0; n < 1000; ++n) {
+        const auto result = Poll(f, selector, choices, limits, now, window, epoch);
+        if (result != CandidateResult::Progress) return result;
+    }
+    throw std::runtime_error("finite stable workload made no bounded progress");
+}
+void Ranking(const std::string &base) {
+    Fixture f(base + "/ranking"); f.Commit(f.Child(f.genesis)); f.Commit(f.Child(f.active));
+    Header long_tip = f.genesis;
+    for (unsigned n = 0; n < 5; ++n) { long_tip = f.Child(long_tip); f.Add(long_tip); }
+    const Header short_tip = f.Child(f.genesis, 0x200fffff); f.Add(short_tip);
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::Ready &&
+          choices.best_ready && choices.best_ready->target == f.Id(short_tip) &&
+          short_tip.height < long_tip.height, "greatest work beats height and prior announcements");
+    CandidatePollUsage used; DiskStateError error;
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 20000, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::Ready, "exact choice revalidation");
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 20000, 0, 2, Limits(), f.store, used, error) ==
+          CandidateResult::Stale, "body epoch fence");
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 19999, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::Stale, "clock rollback fence");
+    auto altered = *choices.best_ready; altered.fork.connect.clear();
+    Check(ValidateCandidateChoice(choices, altered, 20000, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::Stale, "public fork output is rechecked");
+    const auto newer = f.Child(short_tip); f.Add(newer);
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 20000, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::Stale, "inventory revision fence");
+}
+void Ties(const std::string &base) {
+    Fixture f(base + "/ties"); f.Commit(f.Child(f.genesis));
+    const auto equal = f.Child(f.genesis); f.Add(equal);
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::RetainActive && !choices.best_ready,
+          "exact active-work tie retains active");
+    auto left = f.Child(equal), right = f.Child(equal); f.Add(left); f.Add(right);
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::Ready && choices.best_ready &&
+          choices.best_ready->target == std::max(f.Id(left), f.Id(right)), "equal nonactive work deterministic ID order");
+}
+void Bodies(const std::string &base) {
+    Fixture f(base + "/bodies"); f.Commit(f.Child(f.genesis));
+    auto ready = f.Child(f.genesis); f.Add(ready); ready = f.Child(ready); f.Add(ready);
+    auto highest = f.Child(f.genesis, 0x200fffff); f.Add(highest, false);
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::Ready &&
+          choices.best_fetch && choices.best_fetch->target == f.Id(highest) &&
+          choices.best_fetch->missing.size() == 1 && choices.best_fetch->missing[0].id == f.Id(highest) &&
+          choices.best_ready && choices.best_ready->target == f.Id(ready), "higher missing branch does not starve ready branch");
+    Check(!choices.higher_operationally_blocked, "replacement missing is download-only");
+    f.bodies.insert(f.Id(highest));
+    Check(Finish(f, selector, choices, Limits(), 20000, 0, 2) == CandidateResult::Ready &&
+          choices.best_ready->target == f.Id(highest), "body arrival reranks greatest work");
+    f.bodies.erase(f.Id(f.active));
+    Check(Finish(f, selector, choices, Limits(), 20000, 0, 3) == CandidateResult::CapacityRefused,
+          "missing source restoration is operational, not replacement fetch or invalidity");
+    CandidateView view; DiskStateError error;
+    Check(f.store.ReadCandidateView(view, error) && view.invalid_root_count == 0, "availability never persists invalidity");
+}
+void Clock(const std::string &base) {
+    Fixture f(base + "/clock"); f.Commit(f.Child(f.genesis, 0x207fffff, 5000));
+    auto lower = f.Child(f.genesis); f.Add(lower); lower = f.Child(lower); f.Add(lower);
+    const auto future = f.Child(f.genesis, 0x200fffff, 10000); f.Add(future);
+    const auto early_child = f.Child(future, 0x207fffff, 1500); f.Add(early_child);
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Finish(f, selector, choices, Limits(), 2000) == CandidateResult::Ready &&
+          choices.best_ready->target == f.Id(lower) && choices.next_eligibility_time == 10000 &&
+          choices.active_temporarily_ineligible, "all ancestors gate future descendant; stable active retained diagnostically");
+    CandidatePollUsage usage; DiskStateError error;
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 9999, 0, 1, Limits(), f.store, usage, error) ==
+          CandidateResult::Ready, "ordinary clock advance below future threshold does not invalidate");
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 10000, 0, 1, Limits(), f.store, usage, error) ==
+          CandidateResult::Stale, "higher branch eligibility crossing requires rerank");
+    Check(Finish(f, selector, choices, Limits(), 10000) == CandidateResult::Ready &&
+          choices.best_ready->target == f.Id(early_child), "future branch eventually reconsidered");
+    Check(Finish(f, selector, choices, Limits(), 0, std::numeric_limits<uint64_t>::max()) == CandidateResult::Ready,
+          "overflow-safe future window");
+}
+void DeferredAndMissingPrefix(const std::string &base) {
+    Fixture f(base + "/deferred"); f.Commit(f.Child(f.genesis));
+    const auto future = f.Child(f.genesis, 0x200fffff, 10000); f.Add(future);
+    const auto child = f.Child(future, 0x207fffff, 1500); f.Add(child);
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Finish(f, selector, choices, Limits(), 9000) == CandidateResult::Deferred &&
+          !choices.best_ready && choices.next_eligibility_time == 10000, "only future competitors produce explicit deferral");
+    Check(Finish(f, selector, choices, Limits(), 10000) == CandidateResult::Ready &&
+          choices.best_ready->target == f.Id(child), "deferred branch wakes at exact ancestor threshold");
+    Check(Poll(f, selector, choices, Limits(), 9000) == CandidateResult::Deferred,
+          "clock rollback reconsiders ancestry without invalidity");
+    Fixture m(base + "/prefix"); m.Commit(m.Child(m.genesis));
+    Header tip = m.genesis; std::vector<Header> branch;
+    for (unsigned n = 0; n < 5; ++n) { tip = m.Child(tip); m.Add(tip, false); branch.push_back(tip); }
+    auto limits = Limits(); limits.max_missing_bodies = 1;
+    Check(Finish(m, selector, choices, limits) == CandidateResult::NeedBodies &&
+          choices.best_fetch && choices.best_fetch->target == m.Id(tip) &&
+          choices.best_fetch->missing.size() == 1 && choices.best_fetch->missing[0].id == m.Id(branch[0]),
+          "bounded missing-body prefix requests parent-first data without whole inventory allocation");
+    m.bodies.insert(m.Id(branch[0]));
+    Check(Finish(m, selector, choices, limits, 20000, 0, 2) == CandidateResult::NeedBodies &&
+          choices.best_fetch->missing[0].id == m.Id(branch[1]), "body epoch exposes next bounded missing prefix");
+}
+void BoundedProgress(const std::string &base) {
+    Fixture f(base + "/progress"); f.Commit(f.Child(f.genesis));
+    Header target = f.genesis;
+    for (unsigned n = 0; n < 8; ++n) { target = f.Child(target); f.Add(target); }
+    auto limits = Limits(); limits.query.max_rows = 1; limits.max_probe_calls = 1;
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Poll(f, selector, choices, limits) == CandidateResult::Progress, "one bounded call cannot scan/probe branch");
+    const size_t already = f.probes.size();
+    const auto stronger = f.Child(f.genesis, 0x200fffff); f.Add(stronger);
+    Check(Poll(f, selector, choices, limits) == CandidateResult::Progress && f.probes.size() > already,
+          "insertion does not restart pending branch probe");
+    Check(Finish(f, selector, choices, limits) == CandidateResult::Ready && choices.best_ready->target == f.Id(stronger),
+          "completed pass verifies insertion revision and finite stable workload terminates");
+    Check(Poll(f, selector, choices, limits) == CandidateResult::Progress, "new bounded scan");
+    f.Commit(f.Child(f.active));
+    Check(Poll(f, selector, choices, limits) == CandidateResult::Stale, "stable source change invalidates pending scan");
+    Check(Finish(f, selector, choices, limits, 20000, 0, 2) == CandidateResult::Ready, "restart after stable tip fence");
+}
+void RecoveryFences(const std::string &base) {
+    Fixture f(base + "/fences"); f.Commit(f.Child(f.genesis));
+    const auto target = f.Child(f.genesis, 0x200fffff); f.Add(target);
+    CandidateSelector selector; CandidateChoices choices;
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::Ready, "choice before recovery");
+    DiskRecoveryUpdate update; update.expected_tip = f.Id(f.active); update.expected_root = f.store.Root();
+    update.next_tip = update.expected_tip; update.next_journal = std::vector<uint8_t>{1, 2, 3};
+    DiskStateError error;
+    Check(f.store.WriteRecoveryJournal(update, error), "journal fence: " + error.message);
+    Check(Poll(f, selector, choices, Limits()) == CandidateResult::RecoveryRequired, "pending journal fences selection");
+    CandidatePollUsage used;
+    Check(ValidateCandidateChoice(choices, *choices.best_ready, 20000, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::RecoveryRequired, "pending journal fences dispatch");
+    f.store = {};
+    Check(DiskStateStore::Open(f.path, f.options, {}, f.store, error), "journal reopen");
+    Check(Poll(f, selector, choices, Limits()) == CandidateResult::RecoveryRequired, "restart preserves recovery fence");
+    update.expected_journal = update.next_journal; update.next_journal.reset();
+    CandidateTerminalClaim claim; claim.attempt = Tag(999); claim.source = f.Id(f.active); claim.target = f.Id(target);
+    claim.outcome = CandidateTerminalOutcome::RestoredSourceUnknown; claim.revision = 1;
+    Check(f.store.FinishCandidateRecovery(update, claim, error), "durable unknown receipt: " + error.message);
+    Check(Poll(f, selector, choices, Limits()) == CandidateResult::AcknowledgeRequired, "terminal receipt fences selection");
+    std::optional<CandidateTerminalReceipt> receipt;
+    Check(f.store.ReadCandidateReceipt(receipt, error) && receipt && !receipt->failure, "unknown receipt carries no invalid proof");
+    Check(f.store.AcknowledgeCandidateReceipt(receipt->id, f.Id(f.active), error), "unknown receipt acknowledgement");
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::Ready, "acknowledgement permits selection");
+    CandidateView view;
+    Check(f.store.ReadCandidateView(view, error) && view.invalid_root_count == 0, "unknown recovery outcome never creates invalid fact");
+}
+std::string Raw(const std::string &path, const std::string &key, const std::optional<std::string> &put = {}) {
+    std::string error;
+    if (put) {
+        Check(RawDiskStateAccess(path, std::nullopt, nullptr, {{key, *put}}, &error),
+              "raw mechanical fixture write: " + error);
+        return {};
+    }
+    std::optional<std::string> value;
+    Check(RawDiskStateAccess(path, key, &value, {}, &error) && value.has_value(),
+          "raw mechanical fixture read: " + error);
+    return *value;
+}
+Hash Digest(const char *domain, const std::string &bytes) {
+    blake3_hasher hasher; blake3_hasher_init(&hasher);
+    blake3_hasher_update(&hasher, domain, std::char_traits<char>::length(domain) + 1);
+    blake3_hasher_update(&hasher, bytes.data(), bytes.size()); Hash hash;
+    blake3_hasher_finalize(&hasher, hash.data(), hash.size()); return hash;
+}
+// Explicit trusted-format storage mechanics fixture, adapted from the storage
+// owner's InjectReceipt. Closed database injection is not VM failure evidence.
+// Production R creation remains opaque typed-validator/trusted-journal owned.
+Hash InjectMechanicalReceipt(Fixture &f, const Header &target, const Header &bad, const Hash &root) {
+    const auto head = Raw(f.path, "S"); std::string bytes(1, 1);
+    auto hash = [&](const Hash &h) { bytes.append(reinterpret_cast<const char *>(h.data()), h.size()); };
+    hash(f.options.identity); hash(f.options.profile_digest); hash(Tag(444)); hash(f.Id(f.active));
+    hash(f.Id(target)); hash(f.Id(f.active)); hash(root); hash(Digest("Lotus/v2/storage/head", head));
+    for (unsigned i = 0; i < 8; ++i) bytes.push_back(i ? 0 : 7);
+    bytes.push_back(3); bytes.push_back(1);
+    hash(f.Id(bad)); hash(bad.prev_id); hash(f.options.profile_digest); hash(root);
+    Raw(f.path, "R", bytes); return Digest("Lotus/v2/storage/receipt", bytes);
+}
+void PropagationFence(const std::string &base) {
+    Fixture f(base + "/propagation"); f.Commit(f.Child(f.genesis));
+    const auto bad = f.Child(f.active, 0x200fffff); f.Add(bad);
+    const auto descendant = f.Child(bad); f.Add(descendant);
+    const auto healthy = f.Child(f.active, 0x201fffff); f.Add(healthy);
+    CandidateSelector selector; CandidateChoices before;
+    Check(Finish(f, selector, before, Limits()) == CandidateResult::Ready &&
+          before.best_ready->target == f.Id(descendant), "mechanical ranked subtree before exclusion fixture");
+    const auto root = f.store.Root(); f.store = {};
+    const auto receipt = InjectMechanicalReceipt(f, descendant, bad, root); DiskStateError error;
+    Check(DiskStateStore::Open(f.path, f.options, {}, f.store, error), "mechanical receipt reopen");
+    Check(f.store.AcknowledgeCandidateReceipt(receipt, f.Id(f.active), error), "mechanical receipt acknowledgement");
+    CandidateChoices choices;
+    Check(Poll(f, selector, choices, Limits()) == CandidateResult::InvalidationRequired, "pending propagation fences selection");
+    CandidatePollUsage used;
+    Check(ValidateCandidateChoice(before, *before.best_ready, 20000, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::InvalidationRequired, "pending propagation fences dispatch");
+    bool complete{};
+    auto step_limits = Limits().query; step_limits.max_rows = 1;
+    for (unsigned i = 0; i < 32 && !complete; ++i) {
+        CandidateInvalidationProgress progress;
+        Check(f.store.StepCandidateInvalidation(step_limits, progress, error), "bounded propagation fixture step");
+        complete = progress.complete; f.store = {};
+        Check(DiskStateStore::Open(f.path, f.options, {}, f.store, error), "propagation restart");
+    }
+    Check(complete, "finite mechanical propagation completes");
+    Check(Finish(f, selector, choices, Limits()) == CandidateResult::Ready &&
+          choices.best_ready->target == f.Id(healthy), "excluded subtree cannot hide healthy candidate");
+    // Public output mutability must not bypass explicit persisted invalidity.
+    CandidateChoices forged = choices; CandidateChoice excluded;
+    excluded.target = f.Id(descendant); std::optional<IndexedHeader> indexed;
+    Check(f.store.ReadIndexedHeader(excluded.target, indexed, error) && indexed, "excluded H remains retained");
+    excluded.indexed = *indexed;
+    Check(PlanHeaderFork(f.store, f.Id(f.active), excluded.target, Limits().fork, 20000, 0,
+                        excluded.fork, error) == ChainIndexResult::Complete, "legacy fork planner alone does not classify invalidity");
+    forged.best_ready = excluded;
+    Check(ValidateCandidateChoice(forged, excluded, 20000, 0, 1, Limits(), f.store, used, error) ==
+          CandidateResult::Stale, "forged retained excluded target is refused by causal-invalidity lookup");
+    Check(used.query.reads <= Limits().query.max_reads, "invalidity recheck bounded");
+}
+void ResourceAndCallbacks(const std::string &base) {
+    Fixture f(base + "/resources"); f.Commit(f.Child(f.genesis));
+    auto target = f.Child(f.genesis, 0x200fffff); f.Add(target);
+    CandidateSelector selector; CandidateChoices choices; auto limits = Limits();
+    const auto reads = f.store.LastStats().database_reads;
+    limits.max_resident_bytes = 1;
+    Check(Poll(f, selector, choices, limits) == CandidateResult::InvalidConfiguration &&
+          f.store.LastStats().database_reads == reads, "resident reservation refusal before reads/copies");
+    limits = Limits(); limits.query.max_decoded_bytes = 1;
+    CandidatePollUsage partial; DiskStateError partial_error;
+    choices.body_epoch = 999;
+    const auto before_partial = f.store.LastStats().database_reads;
+    Check(selector.Poll(f.Id(f.active), 20000, 0, 1, limits, f.Probe(), f.store, choices, partial, partial_error) ==
+          CandidateResult::CapacityRefused && choices.body_epoch == 999 && partial.query.iterator_steps > 0 &&
+          partial.query.reads == f.store.LastStats().database_reads - before_partial &&
+          partial.query.decoded_bytes <= limits.query.max_decoded_bytes,
+          "failed page reports partial usage and preserves choices");
+    limits = Limits();
+    const uint64_t exact_resident = (limits.fork.max_connect + limits.fork.max_disconnect) * 6 * sizeof(Hash) +
+        limits.max_missing_bodies * 2 * sizeof(CandidateBodyNeed) + sizeof(CandidateRow);
+    limits.max_resident_bytes = exact_resident - 1;
+    Check(Poll(f, selector, choices, limits) == CandidateResult::InvalidConfiguration, "one byte below resident authorization rejected");
+    limits.max_resident_bytes = exact_resident;
+    Check(Finish(f, selector, choices, limits) == CandidateResult::Ready, "exact resident authorization boundary accepted");
+    limits = Limits();
+    auto unsupported = [](const Hash &, const Header &, uint64_t, std::string &) { return CandidateBodyResult::Unsupported; };
+    Check(Poll(f, selector, choices, limits, 20000, 0, 1, unsupported) == CandidateResult::Unsupported,
+          "unsupported body backend remains operational");
+    CandidateBodyProbe reentrant = [&](const Hash &id, const Header &, uint64_t, std::string &) {
+        Check(!selector.Reset(), "callback reset refused");
+        CandidatePollUsage use; DiskStateError error; CandidateChoices other;
+        Check(selector.Poll(f.Id(f.active), 20000, 0, 1, limits, f.Probe(), f.store, other, use, error) ==
+              CandidateResult::StorageError, "callback poll reentry refused");
+        return f.bodies.contains(id) ? CandidateBodyResult::Available : CandidateBodyResult::Missing;
+    };
+    Check(Poll(f, selector, choices, limits, 20000, 0, 1, reentrant) == CandidateResult::Ready,
+          "reentry cannot cancel active scan");
+    CandidatePollUsage outer_use; DiskStateError outer_error;
+    CandidateBodyProbe aliased_reentry = [&](const Hash &id, const Header &, uint64_t, std::string &) {
+        const auto reads_before = outer_use.query.reads;
+        const auto probes_before = outer_use.probe_calls;
+        Check(selector.Poll(f.Id(f.active), 20000, 0, 1, limits, f.Probe(), f.store,
+                            choices, outer_use, outer_error) == CandidateResult::StorageError &&
+              outer_use.query.reads == reads_before && outer_use.probe_calls == probes_before,
+              "aliased reentry preserves outer counters and outputs");
+        return f.bodies.contains(id) ? CandidateBodyResult::Available : CandidateBodyResult::Missing;
+    };
+    const auto before_alias = f.store.LastStats().database_reads;
+    Check(selector.Poll(f.Id(f.active), 20000, 0, 1, limits, aliased_reentry, f.store,
+                        choices, outer_use, outer_error) == CandidateResult::Ready &&
+          outer_use.query.reads == f.store.LastStats().database_reads - before_alias && outer_use.probe_calls > 0,
+          "outer accounting remains exact after aliased reentry attempts");
+}
+} // namespace
+int main() {
+    try {
+        const auto base = (std::filesystem::temp_directory_path() / ("lotus-v2-selector-" + std::to_string(std::rand()))).string();
+        Ranking(base); Ties(base); Bodies(base); Clock(base); DeferredAndMissingPrefix(base); BoundedProgress(base); RecoveryFences(base); PropagationFence(base); ResourceAndCallbacks(base);
+        std::filesystem::remove_all(base);
+        std::cout << "bounded candidate selection tests passed\n";
+    } catch (const std::exception &e) { std::cerr << "candidate selection: " << e.what() << '\n'; return 1; }
+}
