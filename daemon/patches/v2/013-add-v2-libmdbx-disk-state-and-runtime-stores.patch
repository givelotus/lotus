+}
+std::optional<NodeId> AvalanchePeer::Node(peer::ConnectionId id) const {
+    auto p = peers_.find(id); if (p == peers_.end() || !p->second.authenticated) return std::nullopt;
+    return p->second.node;
+}
+void AvalanchePeer::Disconnect(peer::ConnectionId id) {
+    auto p = peers_.find(id); if (p != peers_.end()) { callbacks_.disconnect(p->second.node); peers_.erase(p); }
+    for (auto a = actions_.begin(); a != actions_.end();) {
+        if (a->connection == id) { action_bytes_ -= a->message.payload.size(); a = actions_.erase(a); } else ++a;
+    }
+}
+peer::DispatcherResult AvalanchePeer::Pump(uint64_t now) {
+    if (actions_.empty()) return peer::DispatcherResult::Progress;
+    std::vector<peer::ConnectionId> busy;
+    for (auto it = actions_.begin(); it != actions_.end(); ++it) {
+        if (std::find(busy.begin(), busy.end(), it->connection) != busy.end())
+            continue;
+        auto r = dispatcher_.SendApplication(it->connection, it->message, now);
+        if (r == peer::DispatcherResult::Queued) {
+            if (it->message.command == "avaproofs") {
+                auto p = peers_.find(it->connection);
+                if (p != peers_.end()) callbacks_.sent_proof_inventory(p->second.node);
+            }
+            action_bytes_ -= it->message.payload.size();
+            actions_.erase(it);
+            return r;
+        }
+        if (r == peer::DispatcherResult::Busy) {
+            busy.push_back(it->connection);
+            continue;
+        }
+        if (it != actions_.begin()) {
+            auto action = std::move(*it);
+            actions_.erase(it);
+            actions_.push_front(std::move(action));
+        }
+        // Terminal failures retain the action until driver disconnects explicitly.
+        return r;
+    }
+    return peer::DispatcherResult::Busy;
+}
+PeerResult AvalanchePeer::Poll(const OutgoingPoll &p, std::string &e) {
+    for (const auto &[id, state] : peers_) if (state.node == p.node && state.authenticated) {
+        if(!Active(id)) return PeerResult::UnknownPeer;
+        if(p.items.size()>limits_.max_elements) {e="local-poll-count";return PeerResult::LocalFailure;}
+        if(p.items.size()>state.authenticated->max_elements) {e="negotiated-poll-count";return PeerResult::Rejected;}
+        std::vector<CInv> invs; invs.reserve(p.items.size());
+        for (const auto &i : p.items) { uint256 hash; std::copy(i.id.begin(), i.id.end(), hash.begin()); invs.emplace_back(i.kind == ItemKind::Block ? MSG_BLOCK : MSG_AVA_PROOF, hash); }
+        return Queue(id, {"avapoll", WireBytes(p.round, invs)}, e);
+    }
+    return PeerResult::UnknownPeer;
+}
+PeerResult AvalanchePeer::Discover(peer::ConnectionId id, uint64_t now, std::string &e) {
+    Tick(now);
+    if (!Active(id)) return PeerResult::UnknownPeer;
+    if (peers_.at(id).discovery_outstanding || peers_.at(id).discovery_expected) return PeerResult::Backpressure;
+    const auto queued=Queue(id, {"getavaproofs", {}}, e); if(queued!=PeerResult::Accepted)return queued;
+    peers_.at(id).discovery_outstanding = true;
+    peers_.at(id).discovery_deadline = Deadline(now, limits_.request_timeout_ms);
+    return PeerResult::Accepted;
+}
+void AvalanchePeer::Tick(uint64_t now) {
+    for (auto &[id, state] : peers_) {
+        (void)id;
+        for (auto r = state.requested.begin(); r != state.requested.end();)
+            if (now >= r->second) r = state.requested.erase(r); else ++r;
+        if (now >= state.discovery_deadline) {
+            state.discovery_outstanding = false; state.discovery_expected = 0;
+            state.discovery_received.clear(); state.discovery_shortids.clear();
+        }
+    }
+}
+PeerResult AvalanchePeer::Handle(const peer::DispatcherNotice &notice,uint64_t now,std::string &e) {
+    const auto result=HandleImpl(notice,now,e);
+    if(result==PeerResult::UnknownPeer) IncrementDiagnostic(diagnostics_.dead_applications);
+    if(notice.kind==peer::DispatcherNoticeKind::Application && notice.application && notice.application->command=="avaresponse") {
+        switch(result) {
+            case PeerResult::Accepted:IncrementDiagnostic(diagnostics_.responses_applied);break;
+            case PeerResult::Ignored:IncrementDiagnostic(diagnostics_.responses_ignored);break;
+            case PeerResult::Rejected:IncrementDiagnostic(diagnostics_.responses_rejected);break;
+            case PeerResult::LocalFailure:IncrementDiagnostic(diagnostics_.responses_local_failure);break;
+            default:break;
+        }
+    }
+    if(result==PeerResult::Rejected) {
+        auto category=PeerRejection::Other;
+        if(notice.kind!=peer::DispatcherNoticeKind::Application || !notice.application) category=PeerRejection::Other;
+        else if(e=="invalid-response-signature") category=PeerRejection::Signature;
+        else if(e=="response-framing" || e=="invalid-avalanche-serialization") category=PeerRejection::Framing;
+        else if(e=="invalid-ava-response-size" || e=="invalid-ava-response-content" || e=="unknown-response-node") category=PeerRejection::Content;
+        else if(e=="unexpected-ava-response-abuse") category=PeerRejection::LateResponseAbuse;
+        else if(e=="discovery-cooldown") category=PeerRejection::DiscoveryCooldown;
+        else if(e=="proof-request-cooldown") category=PeerRejection::ProofCooldown;
+        else if(e=="avalanche-negotiated-capacity") category=PeerRejection::NegotiatedCapacity;
+        else if(e=="avalanche-payload-capacity") category=PeerRejection::PayloadCapacity;
+        IncrementDiagnostic(diagnostics_.application_rejections[static_cast<size_t>(category)]);
+    }
+    return result;
+}
+PeerResult AvalanchePeer::HandleImpl(const peer::DispatcherNotice &notice, uint64_t now, std::string &e) {
