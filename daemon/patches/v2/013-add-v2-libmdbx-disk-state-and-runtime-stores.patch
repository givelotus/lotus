+    CHECK(b[4] == 't' && b[5] == 'x' && b[6] == 0 && b[16] == 4);
+    CHECK(b[20] == 0x8d && b[21] == 0xe4 && b[22] == 0x72 &&
+          b[23] == 0xe2); // Python hashlib vector
+    for (size_t split = 0; split <= b.size(); ++split) {
+        EnvelopeDecoder decoder(p);
+        size_t used;
+        auto s = decoder.Feed(std::span(b).first(split), used, out, e);
+        CHECK(used == split);
+        if (split < b.size()) {
+            CHECK(s == FeedStatus::Incomplete);
+            s = decoder.Feed(std::span(b).subspan(split), used, out, e);
+            CHECK(used == b.size() - split);
+        }
+        CHECK(s == FeedStatus::MessageReady && out.command == m.command &&
+              out.payload == m.payload);
+    }
+    EnvelopeDecoder decoder(p);
+    size_t used;
+    for (size_t i = 0; i < b.size(); ++i) {
+        auto s = decoder.Feed(std::span(b).subspan(i, 1), used, out, e);
+        CHECK(used == 1);
+        CHECK(s == (i + 1 == b.size() ? FeedStatus::MessageReady
+                                      : FeedStatus::Incomplete));
+    }
+    Bytes joined = b;
+    joined.insert(joined.end(), b.begin(), b.end());
+    CHECK(decoder.Feed(joined, used, out, e) == FeedStatus::MessageReady &&
+          used == b.size());
+    auto reject = [&](Bytes bad) {
+        EnvelopeDecoder d(p);
+        CHECK(d.Feed(bad, used, out, e) == FeedStatus::InvalidPeerMessage);
+        CHECK(d.Feed(b, used, out, e) == FeedStatus::InvalidPeerMessage);
+    };
+    auto bad = b;
+    bad[0] ^= 1;
+    reject(bad);
+    bad = b;
+    bad[7] = 'z';
+    reject(bad);
+    bad = b;
+    bad[4] = 0x1f;
+    reject(bad);
+    bad = b;
+    bad.back() ^= 1;
+    reject(bad);
+    bad = b;
+    bad[16] = 255;
+    bad[17] = 255;
+    bad[18] = 255;
+    bad[19] = 255;
+    bad.resize(24);
+    reject(bad);
+    Message empty{"verack", {}};
+    CHECK(EncodeEnvelope(p, p.receive_limit, empty, b, e));
+    CHECK(decoder.Feed(b, used, out, e) == FeedStatus::MessageReady);
+    empty.payload = {0};
+    CHECK(!EncodeEnvelope(p, p.receive_limit, empty, b, e));
+    CHECK(!EncodeEnvelope(p, p.receive_limit, {"a\nb", {}}, b, e));
+    CHECK(decoder.SetActiveLimit(1, e));
+    CHECK(!decoder.SetActiveLimit(p.receive_limit + 1, e));
+    CHECK(EncodeEnvelope(p, p.receive_limit, m, b, e));
+    CHECK(decoder.Feed(b, used, out, e) == FeedStatus::InvalidPeerMessage);
+    EnvelopeDecoder partial(p);
+    CHECK(partial.Feed(std::span(b).first(1), used, out, e) ==
+          FeedStatus::Incomplete);
+    CHECK(!partial.SetActiveLimit(100, e));
+}
+void SmallHandshakeLimits() {
+    for (uint32_t local_limit : {1U, 117U, 118U}) {
+        auto p = Profile();
+        p.receive_limit = local_limit;
+        Hello hello;
+        hello.chain_id = p.chain_id;
+        hello.genesis_id = p.genesis_id;
+        hello.profile_digest = p.profile_digest;
+        hello.receive_limit = local_limit;
+        std::string e;
+        Bytes hello_bytes, wire;
+        CHECK(EncodeHello(hello, hello_bytes, e));
+        CHECK(hello_bytes.size() == 118);
+        EnvelopeDecoder decoder(p);
+        Message output;
+        size_t consumed;
+        // Both mandatory handshake records fit the independent pre-hello cap.
+        for (const Message &message :
+             std::vector<Message>{{"version", Bytes(350, 0)},
+                                  {"v2hello", hello_bytes},
+                                  {"sendaddrv2", {}},
+                                  {"verack", {}}}) {
+            CHECK(EncodeHandshakeEnvelope(p, message, wire, e));
+            CHECK(decoder.Feed(wire, consumed, output, e) ==
+                  FeedStatus::MessageReady);
+            CHECK(consumed == wire.size() && output.payload == message.payload);
+        }
+        CHECK(!EncodeHandshakeEnvelope(p, {"tx", {}}, wire, e));
+        CHECK(!EncodeHandshakeEnvelope(p, {"v2hello", Bytes(119)}, wire, e));
+        CHECK(!EncodeHandshakeEnvelope(
+            p, {"version", Bytes(PRE_HELLO_LIMIT + 1)}, wire, e));
+        uint32_t negotiated;
+        CHECK(NegotiateHello(p, hello, negotiated, e));
+        CHECK(negotiated == local_limit);
+        CHECK(decoder.SetActiveLimit(negotiated, e));
+        // After activation, the tiny negotiated cap applies immediately.
+        Message fits{"tx", Bytes(local_limit, 0)};
+        CHECK(EncodeEnvelope(p, negotiated, fits, wire, e));
+        CHECK(decoder.Feed(wire, consumed, output, e) ==
+              FeedStatus::MessageReady);
+        CHECK(!EncodeEnvelope(p, PRE_HELLO_LIMIT, fits, wire, e));
+        Message oversized{"tx", Bytes(local_limit + 1, 0)};
+        CHECK(!EncodeEnvelope(p, negotiated, oversized, wire, e));
+        auto sender = Profile();
+        CHECK(EncodeEnvelope(sender, sender.receive_limit, oversized, wire, e));
+        CHECK(decoder.Feed(wire, consumed, output, e) ==
+              FeedStatus::InvalidPeerMessage);
+    }
+}
+void Vectors() {
+    auto p = Profile();
+    auto block = Block(p);
+    std::string e;
+    Bytes b, again;
+    CHECK(EncodeHeaders(std::span(&block.header, 1), p.receive_limit, b, e) &&
+          b.size() == 136 && b[0] == 1 && b.back() == 0);
+    std::vector<Header> headers;
+    CHECK(DecodeHeaders(b, p.receive_limit, headers, e));
+    CHECK(EncodeHeaders(headers, p.receive_limit, again, e) && again == b);
+    b.back() = 1;
+    CHECK(!DecodeHeaders(b, p.receive_limit, headers, e));
+    b.back() = 0;
+    b.push_back(0);
+    CHECK(!DecodeHeaders(b, p.receive_limit, headers, e));
+    std::vector<Header> huge(2000, block.header);
+    CHECK(EncodeHeaders(huge, p.receive_limit, b, e));
+    CHECK(DecodeHeaders(b, p.receive_limit, headers, e) &&
+          headers.size() == 2000);
+    huge.push_back(block.header);
+    CHECK(!EncodeHeaders(huge, p.receive_limit, b, e));
+    std::vector<Inventory> inv{{1, {}}, {2, {}}, {4, {}}, {99, {}}}, items;
+    inv[0].hash[0] = 55;
+    CHECK(EncodeInventory(inv, p.receive_limit, b, e));
+    CHECK(DecodeInventory(b, p.receive_limit, items, e) && items.size() == 4 &&
+          items[3].type == 99);
+    CHECK(KnownInventoryType(1) && KnownInventoryType(2) &&
+          KnownInventoryType(4) && !KnownInventoryType(99));
+    CHECK(EncodeInventory(items, p.receive_limit, again, e) && again == b);
+    b[0] = 5;
+    CHECK(!DecodeInventory(b, p.receive_limit, items, e));
+    CHECK(!EncodeInventory(inv, 100, b, e));
+    b = {253, 0, 0};
+    CHECK(!DecodeInventory(b, p.receive_limit, items, e));
+    Locator l{70017, {p.genesis_id, p.chain_id}, p.profile_digest}, ld;
+    CHECK(EncodeLocator(l, p.receive_limit, b, e) &&
+          DecodeLocator(b, p.receive_limit, ld, e));
+    CHECK(ld.ids == l.ids && ld.stop == l.stop && ld.version == 70017);
+    b.push_back(0);
+    CHECK(!DecodeLocator(b, p.receive_limit, ld, e));
+    l.ids.resize(102);
+    CHECK(!EncodeLocator(l, p.receive_limit, b, e));
+    SendCompact s{true, 2}, sd;
+    CHECK(EncodeSendCompact(s, b, e) && DecodeSendCompact(b, sd, e) &&
+          sd.announce && sd.version == 2);
+    b[0] = 2;
+    CHECK(!DecodeSendCompact(b, sd, e));
+    s.version = 123;
+    CHECK(EncodeSendCompact(s, b, e) && DecodeSendCompact(b, sd, e) &&
+          sd.version == 123); // caller ignores version !=2
+}
