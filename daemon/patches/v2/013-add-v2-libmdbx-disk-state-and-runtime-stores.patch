+bool DiskStateTransaction::Commit(const DiskStateMetadata &next, DiskStateError &error) {
+    return CommitImpl(next, nullptr, error);
+}
+bool DiskStateTransaction::Commit(const DiskStateMetadata &next, const Header &fully_connected,
+                                  DiskStateError &error) {
+    return CommitImpl(next, &fully_connected, error);
+}
+bool DiskStateTransaction::CommitImpl(const DiskStateMetadata &next, const Header *fully_connected,
+                                      DiskStateError &error) {
+    return Guard(error, [&] {
+        if (!impl_) Fail(DiskStateErrorCode::Closed, "closed transaction");
+        impl_->Usable(); auto &store = *impl_->store;
+        const uint64_t commit_reads_before = store.stats.database_reads;
+        if (impl_->recovery_update) {
+            store.RecoveryFence(*impl_->recovery_update, true);
+            Require(next.tip == impl_->recovery_update->next_tip, "recovery connected tip fence");
+        } else store.Ordinary();
+        if (next.tip == store.head.metadata.tip) Fail(DiskStateErrorCode::UndoMismatch, "commit must advance tip identity");
+        if (fully_connected) {
+            Hash id;
+            Require(HeaderBytes(*fully_connected) == Bytes(next.header.begin(), next.header.end()) &&
+                    BlockId(store.options.identity, *fully_connected, id) && id == next.tip,
+                    "connected header/metadata binding");
+        }
+        std::optional<IndexedHeader> prepared;
+        if (store.options.header_index) {
+            if (!fully_connected) Fail(DiskStateErrorCode::ProfileMismatch, "indexed commit requires connected header");
+            const auto active = store.CheckedActive();
+            if (active) {
+                Require(active->height != std::numeric_limits<uint64_t>::max() &&
+                        fully_connected->height == active->height + 1 && fully_connected->prev_id == active->tip,
+                        "connected header does not extend active index");
+            } else Require(fully_connected->height == 0 && next.tip == store.options.header_index->genesis_id,
+                           "first indexed commit must be configured genesis");
+            prepared = store.PrepareHeader(*fully_connected, HeaderStage::Connected);
+            const auto existing = store.CheckedHeader(next.tip);
+            if (existing)
+                Require(HeaderBytes(existing->header) == HeaderBytes(*fully_connected) &&
+                        existing->chain_work == prepared->chain_work &&
+                        existing->max_ancestor_time == prepared->max_ancestor_time, "connected immutable header mismatch");
+            Require(!store.Read(ActiveKey(fully_connected->height)), "occupied next active height");
+        }
+        Head next_head = impl_->head; next_head.metadata = next;
+        CheckUndoCreationSize(store.options, store.head, next_head, impl_->changes);
+        const Bytes before = EncodeHead(store.head, store.options), after = EncodeHead(next_head, store.options);
+        const Bytes undo = EncodeUndo(before, after, impl_->changes);
+        const Bytes undo_key = UndoKey(next.tip);
+        const Value prior = store.Read(undo_key);
+        if (prior && *prior != undo) Fail(DiskStateErrorCode::UndoMismatch, "immutable undo differs for existing tip");
+        auto stats = impl_->Stats();
+        const uint64_t staged_reads = stats.database_reads;
+        MdbxWriteBatch batch;
+        if (auto body = ExtractBlockBodyFromMetadata(next)) {
+            batch.block_body_write = std::pair{next.tip, std::move(*body)};
+        }
+        for (const auto &[key, change] : impl_->changes) AddBatch(batch, key, change.after, stats);
+        AddBatch(batch, "S", after, stats); AddBatch(batch, "V", StorageSchema(store.options), stats);
+        if (!prior) AddBatch(batch, undo_key, undo, stats);
+        if (prepared) {
+            store.CandidateConnect(next.tip, *prepared, batch, stats);
+            AddBatch(batch, HeaderKey(next.tip), EncodeIndexedHeader(*prepared), stats);
+            AddBatch(batch, ActiveKey(prepared->header.height), HashBytes(next.tip), stats);
+            AddBatch(batch, "I", EncodeActiveIndex(ActiveFrom(next.tip, *prepared)), stats);
+        }
+        if (impl_->recovery_update)
+            AddBatch(batch, "J", EncodeJournal(*impl_->recovery_update->next_journal, next_head,
+                     store.options.recovery->max_journal_bytes), stats);
+        stats.database_reads = staged_reads + store.stats.database_reads - commit_reads_before;
+        store.Write(batch); store.head = std::move(next_head); store.stats = stats; impl_->End();
+    });
+}
+bool DiskStateStore::Disconnect(const Hash &expected_tip, DiskStateError &error) {
+    return Disconnect(expected_tip, DiskStateMetadataValidator{}, error);
+}
+bool DiskStateStore::Disconnect(const Hash &expected_tip, const DiskStateMetadataValidator &validate,
+                                DiskStateError &error) {
+    return DisconnectImpl(expected_tip, validate, nullptr, error);
+}
+bool DiskStateStore::DisconnectRecovery(const Hash &expected_tip, const DiskStateMetadataValidator &validate,
+                                        const DiskRecoveryUpdate &update, DiskStateError &error) {
+    return DisconnectImpl(expected_tip, validate, &update, error);
+}
+bool DiskStateStore::DisconnectImpl(const Hash &expected_tip, const DiskStateMetadataValidator &validate,
+                                    const DiskRecoveryUpdate *recovery, DiskStateError &error) {
+    return Guard(error, [&] {
+        if (!impl_) Fail(DiskStateErrorCode::Closed, "closed store");
+        impl_->Usable();
+        if (impl_->active) Fail(DiskStateErrorCode::TransactionAborted, "active transaction");
+        if (recovery) {
+            impl_->RecoveryFence(*recovery, true);
+            Require(recovery->expected_tip == expected_tip, "recovery disconnect tip fence");
+        } else impl_->Ordinary();
+        if (impl_->head.metadata.tip != expected_tip) Fail(DiskStateErrorCode::UndoMismatch, "disconnect tip mismatch");
+        const uint64_t reads_before = impl_->stats.database_reads;
+        std::optional<ActiveChainIndex> indexed_active;
+        if (impl_->options.header_index) {
+            indexed_active = impl_->CheckedActive();
+            Require(indexed_active && indexed_active->tip == expected_tip, "indexed disconnect active tip");
+            if (indexed_active->height == 0) Fail(DiskStateErrorCode::UndoMismatch, "cannot disconnect indexed genesis");
+        }
+        const Value undo = impl_->Read(UndoKey(expected_tip));
+        if (!undo) Fail(DiskStateErrorCode::Missing, "missing undo");
+        if (recovery && recovery->expected_undo_digest)
+            Require(UndoFingerprint(*undo) == *recovery->expected_undo_digest, "pinned recovery undo digest mismatch");
+        Reader r{*undo}; const BytesView before_view = r.BlobView(), after_view = r.BlobView();
+        Require(after_view == EncodeHead(impl_->head, impl_->options), "undo successor mismatch");
+        Head previous = ParseHead(before_view, impl_->options);
+        const Bytes before(before_view.data(), before_view.size());
+        if (recovery) Require(previous.metadata.tip == recovery->next_tip, "recovery restored tip fence");
+        std::optional<ActiveChainIndex> indexed_previous;
+        if (indexed_active) {
+            const auto parent = impl_->CheckedHeader(previous.metadata.tip);
+            Require(parent && parent->stage == HeaderStage::Connected &&
+                    parent->header.height == indexed_active->height - 1 &&
+                    HeaderBytes(parent->header) == Bytes(previous.metadata.header.begin(), previous.metadata.header.end()),
+                    "indexed undo predecessor binding");
+            const auto child = impl_->CheckedHeader(expected_tip);
+            Require(child && child->header.prev_id == previous.metadata.tip, "indexed undo parent identity");
+            indexed_previous = ActiveFrom(previous.metadata.tip, *parent);
+        }
+        const uint64_t count = r.Int(); Require(count <= undo->size() / 10, "undo count");
+        MdbxWriteBatch batch; DiskStateStats stats;
+        std::map<Bytes, Value> restored;
+        Bytes previous_key;
+        for (uint64_t i = 0; i < count; ++i) {
+            const Bytes key = r.Blob(37);
+            Require((key.size() == 37 && key[0] == 'C') || (key.size() == 35 && key[0] == 'N'), "undo key");
+            Require(previous_key.empty() || key > previous_key, "unordered/duplicate undo key"); previous_key = key;
+            const Value old_value = GetValue(r), current_value = GetValue(r);
+            Require(impl_->Read(key) == current_value, "undo current value mismatch");
+            restored.emplace(key, old_value);
+            AddBatch(batch, key, old_value, stats);
+            if (key[0] == 'C') ++stats.dirty_coins; else ++stats.dirty_nodes;
+        }
+        r.End();
+        const auto ReadRestored = [&](const Bytes &key) -> ValueView {
+            const auto it = restored.find(key);
+            if (it != restored.end()) return it->second ? ValueView(*it->second) : std::nullopt;
+            return impl_->ReadView(key);
+        };
+        // Validate the inverse view before publishing any old bytes. This
+        // visits the changed paths and immediate siblings, never the full set.
+        // ParseHead above checks framing/profile/limits; opaque metadata's
+        // semantic agreement with its block belongs to the enclosing validator.
+        ValidateRestoredPath(ReadRestored, previous, Path{});
+        for (const auto &[key, value] : restored) {
+            (void)value;
+            if (key[0] == 'C') {
+                std::optional<Coin> coin;
+                AuthReadCoin(ReadRestored, previous, ParseCoinKey(key), coin);
+            } else ValidateRestoredPath(ReadRestored, previous, ParseNodeKey(key));
+        }
+        if (validate) {
+            struct CallbackScope {
+                bool &active;
+                explicit CallbackScope(bool &flag) : active(flag) { active = true; }
+                ~CallbackScope() { active = false; }
+            } scope(impl_->active);
+            DiskStateError callback_error;
+            bool accepted{};
+            try { accepted = validate(previous.metadata, previous.root.digest, callback_error); }
+            catch (const std::bad_alloc &) { throw; }
+            catch (const std::length_error &) { throw; }
+            catch (const std::exception &exception) {
+                Fail(DiskStateErrorCode::Database, std::string("metadata validation exception: ") + exception.what());
+            }
+            catch (...) { Fail(DiskStateErrorCode::Database, "metadata validation exception"); }
+            if (!accepted) {
+                // A callback cannot turn stored-state validation failure into
+                // a consensus mutation error, even if it supplies that code.
+                auto code = callback_error.code;
+                if (code == DiskStateErrorCode::None || code == DiskStateErrorCode::Duplicate ||
+                    code == DiskStateErrorCode::Missing || code == DiskStateErrorCode::InvalidCoin)
+                    code = DiskStateErrorCode::Corruption;
+                Fail(code, callback_error.message.empty() ? "predecessor metadata validation failed"
+                                                         : callback_error.message);
+            }
+        }
+        AddBatch(batch, "S", before, stats); AddBatch(batch, "V", StorageSchema(impl_->options), stats);
+        if (indexed_active) {
+            const auto current = impl_->CheckedHeader(expected_tip); Require(current.has_value(), "missing disconnected inventory header");
+            impl_->CandidateDisconnect(expected_tip, *current, batch, stats);
+            AddBatch(batch, ActiveKey(indexed_active->height), std::nullopt, stats);
+            AddBatch(batch, "I", EncodeActiveIndex(indexed_previous), stats);
+        }
+        if (recovery)
+            AddBatch(batch, "J", EncodeJournal(*recovery->next_journal, previous,
+                     impl_->options.recovery->max_journal_bytes), stats);
+        // Undo records are immutable and retained across disconnect/reorg.
+        stats.database_reads = impl_->stats.database_reads - reads_before;
+        impl_->Write(batch); impl_->head = std::move(previous); impl_->stats = stats;
+    });
+}
+
+bool RawDiskStateAccess(const std::string &directory,
+                        const std::optional<std::string> &read_key,
+                        std::optional<std::string> *read_out,
+                        const std::vector<std::pair<std::string, std::optional<std::string>>> &writes,
+                        std::string *error) {
+    DiskStateError err;
+    const bool ok = Guard(err, [&] {
+        DiskStateStore::Impl impl;
+        impl.directory = directory;
+        OpenMdbxEnvironment(directory, impl.env,
+                            impl.dbi_meta, impl.dbi_coins, impl.dbi_smt_nodes,
+                            impl.dbi_headers, impl.dbi_active_h, impl.dbi_block_locs,
+                            impl.dbi_undo_locs, impl.dbi_candidates, impl.dbi_children,
+                            impl.dbi_queue, impl.dbi_excluded, impl.dbi_failures,
+                            impl.dbi_parked);
+        if (read_key && read_out) {
+            *read_out = impl.Read(*read_key);
+        }
+        if (!writes.empty()) {
+            MdbxWriteBatch batch;
+            for (const auto &[k, v] : writes) {
+                if (v) batch.Put(k, *v);
+                else batch.Delete(k);
+            }
+            impl.Write(batch);
+        }
+    });
+    if (!ok && error) *error = err.message;
+    return ok;
+}
+
+bool RawDiskStateSnapshot(const std::string &directory,
+                          std::map<std::string, std::string> &out,
+                          std::string *error) {
+    DiskStateError err;
+    const bool ok = Guard(err, [&] {
+        out.clear();
+        DiskStateStore::Impl impl;
+        impl.directory = directory;
+        OpenMdbxEnvironment(directory, impl.env,
+                            impl.dbi_meta, impl.dbi_coins, impl.dbi_smt_nodes,
+                            impl.dbi_headers, impl.dbi_active_h, impl.dbi_block_locs,
+                            impl.dbi_undo_locs, impl.dbi_candidates, impl.dbi_children,
+                            impl.dbi_queue, impl.dbi_excluded, impl.dbi_failures,
+                            impl.dbi_parked);
+        MDBX_txn *rtxn = impl.EnsureReadTxn();
+        auto scan_dbi = [&](MDBX_dbi dbi, char prefix) {
+            MdbxCursorGuard cur;
+            CheckMdbx(mdbx_cursor_open(rtxn, dbi, &cur.cur), "mdbx_cursor_open(snapshot)");
+            MDBX_val k{}, v{};
+            for (int rc = mdbx_cursor_get(cur.cur, &k, &v, MDBX_FIRST);
+                 rc == MDBX_SUCCESS;
+                 rc = mdbx_cursor_get(cur.cur, &k, &v, MDBX_NEXT)) {
+                BytesView sk(static_cast<const char *>(k.iov_base), k.iov_len);
+                BytesView sv(static_cast<const char *>(v.iov_base), v.iov_len);
+                if (prefix == 0) {
+                    if (sk == "B_cursor" || sk == "U_cursor") continue;
+                    if (sk == "S") {
+                        out[Bytes(sk)] = ExpandCompactHeadBytes(sv, [&](const DiskBlockLocation &loc) {
+                            return impl.ReadFlatSegment(true, loc);
+                        });
+                    } else {
+                        out[Bytes(sk)] = Bytes(sv);
+                    }
+                } else if (prefix == 'U') {
+                    Bytes full_key(1, 'U');
+                    full_key.append(sk.data(), sk.size());
+                    const DiskUndoLocation loc = ParseLocation(sv);
+                    out[std::move(full_key)] = impl.ReadFlatSegment(false, loc);
+                } else {
+                    Bytes full_key(1, prefix);
+                    full_key.append(sk.data(), sk.size());
+                    out[std::move(full_key)] = Bytes(sv);
+                }
+            }
+        };
+        scan_dbi(impl.dbi_meta, 0);
+        scan_dbi(impl.dbi_coins, 'C');
+        scan_dbi(impl.dbi_smt_nodes, 'N');
+        scan_dbi(impl.dbi_headers, 'H');
+        scan_dbi(impl.dbi_active_h, 'A');
+        scan_dbi(impl.dbi_undo_locs, 'U');
+        scan_dbi(impl.dbi_candidates, 'W');
+        scan_dbi(impl.dbi_children, 'X');
+        scan_dbi(impl.dbi_queue, 'Q');
+        scan_dbi(impl.dbi_excluded, 'E');
+        scan_dbi(impl.dbi_failures, 'F');
+        scan_dbi(impl.dbi_parked, 'Z');
+    });
+    if (!ok && error) *error = err.message;
+    return ok;
+}
+} // namespace lotus::v2
diff --git a/src/lotus_v2/disk_state.h b/src/lotus_v2/disk_state.h
new file mode 100644
index 0000000000000000000000000000000000000000..7e17e029e02e93486a90cce886798dea06d31130
--- /dev/null
+++ b/src/lotus_v2/disk_state.h
@@ -0,0 +1,263 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_DISK_STATE_H
+#define LOTUS_V2_DISK_STATE_H
+
+#include "sparse_state.h"
+#include "chain_index.h"
+#include "candidate_store.h"
+
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace leveldb { class Env; }
+namespace lotus::v2 {
+
+// Storage failures are operational; callers must never translate them into a
+// consensus-invalid block. Mutation errors are separate from storage errors.
+enum class DiskStateErrorCode {
+    None, Database, Resource, Corruption, ProfileMismatch, Closed,
+    Duplicate, Missing, InvalidCoin, UndoMismatch, TransactionAborted
+};
+struct DiskStateError {
+    DiskStateErrorCode code{DiskStateErrorCode::None};
+    std::string message;
+};
+struct DiskFileLocation {
+    uint32_t file_num{};
+    uint32_t data_pos{};
+    uint32_t length{};
+    bool operator==(const DiskFileLocation &) const = default;
+};
+using DiskBlockLocation = DiskFileLocation;
+using DiskUndoLocation = DiskFileLocation;
+// Explicit journal-aware indexed-home creation limits, not consensus caps.
+// Embedded pinned bodies live inside the bounded coordinator journal payload.
+struct DiskRecoveryOptions {
+    size_t max_journal_bytes{};
+    size_t max_undo_bytes{};
+};
+struct DiskRecoveryUpdate {
+    std::optional<std::vector<uint8_t>> expected_journal, next_journal;
+    Hash expected_tip{}, expected_root{}, next_tip{};
+    std::optional<Hash> expected_undo_digest;
+};
+struct DiskRecoveryUndoInfo {
+    uint64_t bytes{};
+    Hash digest{}, before_tip{}, after_tip{}, before_root{}, after_root{};
+};
+struct DiskStateOptions {
+    Hash identity{};
+    Hash profile_digest{};
+    // Explicit indexed development format. Generic mode remains schema v1;
+    // indexed mode requires a fresh home and rejects generic existing stores.
+    std::optional<HeaderChainProfile> header_index;
+    // Explicit V3 home: requires header_index and a fresh directory. V1/V2
+    // homes remain usable in their own modes; no implicit migration/reset.
+    std::optional<DiskRecoveryOptions> recovery;
+    // Explicit V4 inventory/receipt home; requires recovery and a new directory.
+    // Existing modes remain usable; no implicit scan/migration/reset.
+    std::optional<CandidateStoreOptions> candidates;
+    // Explicit fresh-home Avalanche policy. Auto-unparking is disabled.
+    bool avalanche{};
+    // Open only an initialized home; never create schema or initial metadata.
+    // This still takes LevelDB's exclusive lock and may maintain engine files.
+    bool existing_only{false};
+    uint64_t max_avalanche_reads{100000};
+    size_t cache_bytes{8 << 20};
+    size_t write_buffer_bytes{4 << 20}; // LevelDB's minimum is 64 KiB.
+    // Limits retained overlay key/value payload, not total RAM. Map overhead,
+    // LevelDB buffers and temporary batch/undo encoding add memory overhead.
+    size_t max_pending_bytes{64 << 20}; // Operational limit, not consensus.
+    size_t max_metadata_bytes{16 << 20};
+    // Optional borrowed Env for embedding/testing; must outlive store/transactions.
+    leveldb::Env *env{nullptr};
+};
+// Enclosing validator owns framing and semantic checks of these opaque bytes.
+// All metadata and the authenticated UTXO root commit in the same sync batch.
+struct DiskStateMetadata {
+    Hash tip{};
+    std::vector<uint8_t> header;
+    std::vector<uint8_t> monetary;
+    std::vector<uint8_t> auxiliary;
+    bool operator==(const DiskStateMetadata &) const = default;
+};
+// Raw retained metadata plus its historical UTXO commitment. This neither
+// classifies active-chain membership nor revalidates block/VM semantics.
+struct RetainedDiskState {
+    DiskStateMetadata metadata;
+    Hash root{};
+};
+// The enclosing validator checks opaque predecessor metadata against this
+// restored authenticated root before publication. Callback reads on the store
+// still see the current state; validate the supplied arguments. Begin and
+// Disconnect are blocked during the callback. Refusal/exception is operational.
+using DiskStateMetadataValidator = std::function<bool(const DiskStateMetadata &,
+                                                     const Hash &, DiskStateError &)>;
+struct DiskStateStats {
+    uint64_t database_reads{};
+    uint64_t dirty_nodes{};
+    uint64_t dirty_coins{};
+    uint64_t batch_puts{};
+    uint64_t batch_deletes{};
+    uint64_t batch_bytes{};
+    uint64_t pending_bytes{};
+};
+struct DiskBlockPolicy {
+    bool known{}, parked{}, finalized{}, conflicting_finalized{};
+    std::optional<Hash> park_root;
+};
+struct DiskParkUpdate { Hash block{}; bool parked{}; };
+class DiskStateTransaction;
+// Bundled ABC LevelDB, hidden behind this backend seam. No complete UTXO set is
+// held in memory or scanned on open, connect, proof, or disconnect. Callers must
+// serialize operations on one store and its transactions. A transaction keeps
+// its store alive; only one may be active. Read the staged view through it.
+class DiskStateStore {
+public:
+    DiskStateStore();
+    ~DiskStateStore();
+    DiskStateStore(DiskStateStore &&) noexcept;
+    DiskStateStore &operator=(DiskStateStore &&) noexcept;
+    DiskStateStore(const DiskStateStore &) = delete;
+    DiskStateStore &operator=(const DiskStateStore &) = delete;
+    static bool Open(const std::string &directory, const DiskStateOptions &options,
+                     const DiskStateMetadata &initial, DiskStateStore &out,
+                     DiskStateError &error);
+    bool IsOpen() const;
+    bool CandidatesEnabled() const;
+    bool MatchesProfile(const Hash &identity, const Hash &digest) const;
+    Hash Root() const;
+    DiskStateMetadata Metadata() const;
+    // Current S or immutable U.after lookup; true + nullopt means no directly
+    // addressable record. On false out is unchanged. Reads/checksums the full
+    // LevelDB value before parsing; caller quotas do not bound Get allocation.
+    // No historical C/N lookup, height index, pruning or availability promise.
+    bool ReadRetainedState(const Hash &, std::optional<RetainedDiskState> &out,
+                           DiskStateError &) const;
+    bool ReadBlockLocation(const Hash &, std::optional<DiskBlockLocation> &out,
+                           DiskStateError &) const;
+    bool ReadUndoLocation(const Hash &, std::optional<DiskUndoLocation> &out,
+                          DiskStateError &) const;
+    bool ReadBlockSlice(const Hash &, uint64_t offset, uint64_t length,
+                        std::vector<uint8_t> &out, uint64_t *total_bytes,
+                        DiskStateError &) const;
+    bool ReadUndoSlice(const Hash &, uint64_t offset, uint64_t length,
+                       std::vector<uint8_t> &out, uint64_t *total_bytes,
+                       DiskStateError &) const;
+    bool ReadCoin(const Outpoint &, std::optional<Coin> &, DiskStateError &) const;
+    bool Prove(const Outpoint &, CoinProof &, DiskStateError &) const;
+    // Enclosing validator has already checked contextual header rules. This
+    // mechanically binds identity/PoW/parent/height and derives work/time itself.
+    // HeaderChecked never writes active-height mappings or Connected status.
+    bool PutCheckedHeader(const Header &, DiskStateError &);
+    bool ReadIndexedHeader(const Hash &, std::optional<IndexedHeader> &, DiskStateError &) const;
+    bool ReadActiveId(uint64_t height, std::optional<Hash> &, DiskStateError &) const;
+    bool ReadActiveIndex(std::optional<ActiveChainIndex> &, DiskStateError &) const;
+    bool Begin(DiskStateTransaction &, DiskStateError &);
+    // Coordinator owns canonical phase/revision/plan grammar in opaque bytes.
+    // Payload CAS plus expected tip/root fences updates. Stored J independently
+    // binds the actual checkpoint. Only WriteRecoveryJournal may remove J after
+    // coordinator-verified completion; state-changing recovery steps retain J.
+    bool ReadRecoveryJournal(size_t max_bytes, std::optional<std::vector<uint8_t>> &out,
+                             DiskStateError &) const;
+    bool WriteRecoveryJournal(const DiskRecoveryUpdate &, DiskStateError &);
+    bool BeginRecovery(const DiskRecoveryUpdate &, DiskStateTransaction &, DiskStateError &);
+    bool DisconnectRecovery(const Hash &expected_tip, const DiskStateMetadataValidator &,
+                            const DiskRecoveryUpdate &, DiskStateError &);
+    // Size-probes value before copying to an application string. Engine SST
+    // block allocation is bounded by trusted creation caps, not this quota;
+    // forged/corrupt oversized engine records are outside that allocation claim.
+    bool ProbeRecoveryUndo(const Hash &, size_t max_bytes,
+                           std::optional<DiskRecoveryUndoInfo> &out, DiskStateError &) const;
+    bool Disconnect(const Hash &expected_tip, DiskStateError &);
+    bool Disconnect(const Hash &expected_tip, const DiskStateMetadataValidator &validate,
+                    DiskStateError &);
+    // Candidate pages are exclusive descending-work scans with fixed cursors.
+    // Insertions may advance revision while a pass continues. The selector must
+    // finish/revalidate a stable pass before claiming the best candidate.
+    bool ReadCandidateView(CandidateView &, DiskStateError &) const;
+    bool ReadCandidatePage(const std::optional<CandidateRankCursor> &after,
+                           const CandidateQueryLimits &, CandidatePage &, DiskStateError &,
+                           CandidateQueryUsage *usage = nullptr) const;
+    bool ReadCandidateChildren(const Hash &parent, const std::optional<Hash> &after,
+                               const CandidateQueryLimits &, CandidateChildrenPage &, DiskStateError &,
+                               CandidateQueryUsage *usage = nullptr) const;
+    bool ReadCandidateInvalidity(const Hash &, std::optional<Hash> &causal_root, DiskStateError &) const;
+    // Must recheck at serialized preparation handoff; observation is no lease.
+    bool CheckCandidateRecoveryCapacity(uint64_t max_disconnects, DiskStateError &) const;
+    bool EvictCandidateLeaf(const Hash &, DiskStateError &);
+    // J-clear and typed terminal receipt publish together. Unknown outcomes can
+    // never establish permanent invalidity. Ack fences exact receipt/stable tip,
+    // publishes causal fact/propagation cursor if proven, and removes receipt.
+    bool FinishCandidateRecovery(const DiskRecoveryUpdate &, const CandidateTerminalClaim &, DiskStateError &);
+    bool ReadCandidateReceipt(std::optional<CandidateTerminalReceipt> &, DiskStateError &) const;
+    bool AcknowledgeCandidateReceipt(const Hash &expected_receipt_id,
+                                    const Hash &expected_stable_tip, DiskStateError &);
+    bool StepCandidateInvalidation(const CandidateQueryLimits &, CandidateInvalidationProgress &, DiskStateError &,
+                                   CandidateQueryUsage *usage = nullptr);
+    bool AvalancheEnabled() const;
+    // Bounded ancestry lookup; parking is policy, never consensus invalidity.
+    bool ReadBlockPolicy(const Hash &, uint64_t max_reads, DiskBlockPolicy &,
+                         DiskStateError &) const;
+    // One sync batch, no J/R/P or active transaction. Volatile finality publishes
+    // only after successful sync and resets when the store is reopened.
+    bool ApplyBlockPolicy(const Hash &expected_tip, uint64_t expected_revision,
+                          const std::vector<DiskParkUpdate> &,
+                          const std::optional<Hash> &finalize, DiskStateError &);
+    DiskStateStats LastStats() const;
+private:
+    struct Impl;
+    std::shared_ptr<Impl> impl_;
+    bool DisconnectImpl(const Hash &, const DiskStateMetadataValidator &,
+                        const DiskRecoveryUpdate *, DiskStateError &);
+    friend class DiskStateTransaction;
+    friend bool RawDiskStateAccess(const std::string &, const std::optional<std::string> &,
+                                   std::optional<std::string> *,
+                                   const std::vector<std::pair<std::string, std::optional<std::string>>> &,
+                                   std::string *);
+    friend bool RawDiskStateSnapshot(const std::string &, std::map<std::string, std::string> &,
+                                     std::string *);
+};
+class DiskStateTransaction {
+public:
+    DiskStateTransaction();
+    ~DiskStateTransaction();
+    DiskStateTransaction(DiskStateTransaction &&) noexcept;
+    DiskStateTransaction &operator=(DiskStateTransaction &&) noexcept;
+    DiskStateTransaction(const DiskStateTransaction &) = delete;
+    DiskStateTransaction &operator=(const DiskStateTransaction &) = delete;
+    bool ReadCoin(const Outpoint &, std::optional<Coin> &, DiskStateError &) const;
+    bool Prove(const Outpoint &, CoinProof &, DiskStateError &) const;
+    bool Insert(const Coin &, DiskStateError &);
+    bool Erase(const Outpoint &, DiskStateError &);
+    Hash Root() const;
+    DiskStateStats Stats() const;
+    // One sync WriteBatch: changed coins/nodes, head, identity/profile and
+    // immutable undo keyed by next.tip. A failed write poisons the store until
+    // reopen because a failed sync can have an ambiguous durability outcome.
+    bool Commit(const DiskStateMetadata &next, DiskStateError &);
+    // Required in indexed mode; upgrades H and writes A/I atomically with S and
+    // coins/nodes/undo. In generic mode binds the header then uses legacy commit.
+    bool Commit(const DiskStateMetadata &next, const Header &fully_connected,
+                DiskStateError &);
+    void Abort();
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+    bool CommitImpl(const DiskStateMetadata &, const Header *, DiskStateError &);
+    friend class DiskStateStore;
+};
+bool RawDiskStateAccess(const std::string &directory,
+                        const std::optional<std::string> &read_key,
+                        std::optional<std::string> *read_out,
+                        const std::vector<std::pair<std::string, std::optional<std::string>>> &writes,
+                        std::string *error = nullptr);
+bool RawDiskStateSnapshot(const std::string &directory,
+                          std::map<std::string, std::string> &out,
+                          std::string *error = nullptr);
+} // namespace lotus::v2
+#endif
