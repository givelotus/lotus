+Transaction Spend(uint8_t outpoint, uint8_t argument) {
+    Transaction tx;
+    Input i;
+    i.prev_txid[0] = outpoint;
+    i.sequence = UINT32_MAX;
+    i.flags = 1;
+    i.witnesses.push_back({{0x51}, {}, {{argument}}});
+    tx.inputs.push_back(i);
+    Output o;
+    o.value = 100;
+    o.branches.push_back(Hash{});
+    o.paths = {{0}};
+    tx.outputs.push_back(o);
+    return tx;
+}
+Transaction Coinbase() {
+    Transaction tx = Spend(0, 0);
+    auto &i = tx.inputs[0];
+    i.flags = 2;
+    i.witnesses.clear();
+    return tx;
+}
