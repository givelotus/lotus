+    void Node::OpenChronik(const std::string &directory) {
+#ifdef LOTUS_V2_CHRONIK_CXX
+        if (!network.chronik_bind) return;
+        // Schema 3 uses a fresh index; preserve earlier schema 2 data.
+        const auto path = directory + "/chronik-v2-explorer-v1";
+        chronik_v2::Binding binding{};
+        binding.chain_id = manifest.hp.chain_id;
+        binding.genesis = manifest.hp.genesis_id;
+        binding.profile = network.profile.profile_digest;
+        // Transport record framing is larger than consensus block framing.
+        chronik_v2::ServiceLimits limits{32 * 1024 * 1024, 4096, 65536,
+                                        256, 16, 100, 65536, 131072, 262144};
+        chronik_service.emplace(chronik_v2::open_service(path, binding,
+            !std::filesystem::exists(path), limits));
+        chronik_sink = std::make_unique<CxxChronikSink>(**chronik_service);
+        chronik_sync = std::make_unique<ChronikSync>(*runtime, *chronik_sink,
+            manifest.hp.chain_id, manifest.op.transaction, manifest.block_read_limit);
+        chronik_server.emplace(chronik_v2::start_v2_server(**chronik_service,
+                                                        *network.chronik_bind));
+        chronik_address = std::string(chronik_server.value()->actual_address());
+#else
+        (void)directory;
+#endif
+    }
+    void Node::SuspendChronik() {
+        // Temporarily fence HTTP reads while this native turn can mutate state.
+        // Preserve snapshot generations when the completed context is unchanged.
+#ifdef LOTUS_V2_CHRONIK_CXX
+        // Failure to suspend is fatal: native state must not change while
+        // HTTP could still advertise the old observation as authoritative.
+        if (chronik_service) chronik_service.value()->suspend_authority();
+#endif
+    }
+    void Node::SyncChronik() {
+        chronik_ready = false;
+#ifdef LOTUS_V2_CHRONIK_CXX
+        if (!chronik_sync) return;
+        try {
+            const auto result = chronik_sync->Step(chronik_error);
+            if (result != ChronikSyncResult::Ready) {
+                chronik_service.value()->invalidate_authority();
+                return;
+            }
+            const auto checkpoint = chronik_sink->Checkpoint();
+            Require(bool(checkpoint), "ready Chronik lacks checkpoint");
+            chronik_v2::Anchor anchor{};
+            anchor.block_id = checkpoint->block_id;
+            anchor.height = checkpoint->height;
+            const auto snapshot = runtime->Snapshot();
+            Require(snapshot.chain && !snapshot.reopen_required &&
+                        !snapshot.execution_paused &&
+                        !snapshot.chain->pending_journal &&
+                        !snapshot.chain->pending_receipt &&
+                        !snapshot.chain->pending_propagation &&
+                        snapshot.chain->stable_tip == checkpoint->block_id,
+                    "ready Chronik lacks stable native context");
+            chronik_service.value()->publish_authority_context(
+                anchor, snapshot.context_generation, snapshot.chain->revision);
+            chronik_ready = true;
+            chronik_error.clear();
+        } catch (const std::exception &e) {
+            chronik_error = std::string(e.what()).substr(0, 512);
+            chronik_service.value()->invalidate_authority();
+        }
+#endif
+    }
+    HeaderDecision Node::CheckHeader(const Header &h, uint64_t epoch) {
+        const auto snap = runtime->Snapshot();
+        const auto clock =
+            dispatcher ? dispatcher->HeaderClock() : std::nullopt;
+        if (!snap.chain || snap.reopen_required ||
+            snap.chain->profile_digest != network.profile.profile_digest ||
+            !dispatcher || epoch != dispatcher->FetchEpoch() || !clock)
+            return {HeaderDisposition::OperationalError,
+                    {},
+                    "runtime authority/fetch epoch unavailable"};
+        Hash id;
+        std::string error;
+        std::optional<IndexedHeader> indexed;
+        std::optional<Hash> invalid;
+        if (h.size > manifest.block_read_limit)
+            return {HeaderDisposition::Unsupported,
+                    {},
+                    "header body exceeds selected local policy capacity"};
+        if (!BlockId(network.profile.chain_id, h, id))
+            return {HeaderDisposition::Unsupported, {}, "unencodable header"};
+        if (runtime->ReadHeader(id, indexed, error) != Result::Progress ||
+            runtime->ReadInvalidity(id, invalid, error) != Result::Progress)
+            return {HeaderDisposition::OperationalError, {}, error};
+        if (invalid)
+            return {HeaderDisposition::ConsensusInvalid,
+                    {},
+                    "durable invalidity root"};
+        if (!indexed)
+            return {HeaderDisposition::MissingParent, h.prev_id,
+                    "header not indexed"};
+        std::array<uint8_t, HEADER_SIZE> a{}, b{};
+        if (!SerializeHeader(h, a) || !SerializeHeader(indexed->header, b) ||
+            a != b)
+            return {HeaderDisposition::OperationalError,
+                    {},
+                    "indexed header mismatch"};
+        if (indexed->max_ancestor_time > clock->wall_seconds &&
+            indexed->max_ancestor_time - clock->wall_seconds >
+                clock->future_window)
+            return {HeaderDisposition::Deferred,
+                    {},
+                    "authenticated ancestor temporarily future"};
+        return {HeaderDisposition::Eligible, {}, {}};
+    }
+    DownloadCallbacks Node::Callbacks() {
+        return {[this](const Header &h, uint64_t epoch) {
+                    return CheckHeader(h, epoch);
+                },
+                [this](PeerHandle, const ResourceNeed &n) {
+                    return staging.Reserve(n);
+                },
+                [](const Header &) { return CachedTransactions{{}, 0}; },
+                [this](std::span<const uint8_t> bytes, uint64_t epoch) {
+                    if (bytes.size() > manifest.block_read_limit)
+                        return BodyDecision{BodyDisposition::CapacityRefused,
+                                            {},
+                                            "local body capacity"};
+                    Header h;
+                    if (!ParseHeader(bytes.data(),
+                                     std::min(bytes.size(), HEADER_SIZE), h))
+                        return BodyDecision{BodyDisposition::MalformedBody,
+                                            {},
+                                            "body header framing"};
+                    const auto decision = CheckHeader(h, epoch);
+                    if (decision.disposition != HeaderDisposition::Eligible) {
+                        const auto d =
+                            decision.disposition ==
+                                    HeaderDisposition::ConsensusInvalid
+                                ? BodyDisposition::ConsensusInvalid
+                            : decision.disposition ==
+                                    HeaderDisposition::Deferred
+                                ? BodyDisposition::Deferred
+                            : decision.disposition ==
+                                    HeaderDisposition::MissingParent
+                                ? BodyDisposition::MissingParent
+                                : BodyDisposition::ContextChanged;
+                        return BodyDecision{d, decision.missing_parent,
+                                            decision.diagnostic};
+                    }
+                    Hash id;
+                    BlockId(network.profile.chain_id, h, id);
+                    CandidateBodyStatus status{};
+                    std::string error;
+                    const auto result = runtime->RetainBody(
+                        id, std::vector<uint8_t>(bytes.begin(), bytes.end()),
+                        status, error);
+                    if (result == Result::Progress &&
+                        (status == CandidateBodyStatus::RetainedAuthenticated ||
+                         status == CandidateBodyStatus::Duplicate)) {
+                        Track(id);
+                        return BodyDecision{
+                            BodyDisposition::RetainedAuthenticated, {}, {}};
+                    }
+                    return BodyDecision{result == Result::CapacityRefused
+                                            ? BodyDisposition::CapacityRefused
+                                        : result == Result::MalformedBody
+                                            ? BodyDisposition::MalformedBody
+                                            : BodyDisposition::StorageError,
+                                        {},
+                                        error};
+                }};
+    }
+    void Node::Queue(UniValue value) {
+        auto line = value.write() + "\n";
+        Require(line.size() <= OutputCap - output_bytes,
+                "local output backpressure capacity exhausted");
+        output_bytes += line.size();
+        output.push_back(std::move(line));
+    }
+    void Node::Flush() {
+        size_t budget = 65536;
+        while (!output.empty() && budget) {
+            auto &s = output.front();
+            const auto n = write(STDOUT_FILENO, s.data() + output_offset,
+                                 std::min(budget, s.size() - output_offset));
+            if (n < 0 &&
+                (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
+                return;
+            Require(n > 0, "local output pipe unavailable");
+            budget -= n;
+            output_bytes -= n;
+            output_offset += n;
+            if (output_offset == s.size()) {
+                output.pop_front();
+                output_offset = 0;
+            }
+        }
+    }
+    void Node::RemoveRelayPeer(uint64_t peer) {
+        const ConnectionId connection{peer};
+        relay_output.Remove(peer);
+        relay->RemovePeer(peer);
+        relay_peers.erase(connection);
+        dispatcher->Remove(connection);
+        for (auto &c : connections) if (c->id == connection) c->stream.Close();
+    }
+    void Node::FlushRelay(uint64_t now) {
+        const auto failed = relay_output.Flush([&](uint64_t peer, const Message &message) {
+            if (!relay_peers.contains(ConnectionId{peer})) return DispatcherResult::Closed;
+            return dispatcher->SendApplication(ConnectionId{peer}, message, now);
+        });
+        for (const auto peer : failed) RemoveRelayPeer(peer);
+    }
+    void Node::RelayActions(RelayResult result, uint64_t) {
+        for (const auto peer : relay_output.Stage(std::move(result.actions)))
+            RemoveRelayPeer(peer);
+    }
+    UniValue Node::SubmitTransaction(const UniValue &request) {
+        Keys(request, {"id", "command", "wire", "expected_tip"});
+        const auto wire = Unhex(request["wire"], 1000000);
+        PoolBudget budget{1, 1000000};
+        const auto result = pool->Submit(wire, HashOf(request["expected_tip"]), budget);
+        static const char *names[] = {"accepted", "duplicate", "conflict", "missing_parents", "invalid", "capacity_refused", "stale_tip", "inconclusive"};
+        UniValue answer(UniValue::VOBJ), missing(UniValue::VARR);
+        answer.pushKV("ok", result.status == PoolStatus::Accepted || result.status == PoolStatus::Duplicate);
+        answer.pushKV("result", names[static_cast<size_t>(result.status)]);
+        answer.pushKV("txid", Hex(result.txid));
+        answer.pushKV("txhash", Hex(result.txhash));
+        answer.pushKV("error", result.error.substr(0, 1024));
+        for (const auto &outpoint : result.missing) {
+            UniValue item(UniValue::VOBJ);
+            item.pushKV("txid", Hex(outpoint.tx_id));
+            item.pushKV("index", uint64_t(outpoint.index));
+            missing.push_back(item);
+        }
+        answer.pushKV("missing", missing);
+        if (result.status == PoolStatus::Accepted) inventory_refresh_requested = true;
+        return answer;
+    }
+    UniValue Node::TransactionQuery(const UniValue &request) {
+        std::set<std::string> keys{"id", "command", "txid"};
+        if (request.exists("txhash")) keys.insert("txhash");
+        if (request.exists("wire")) keys.insert("wire");
+        Keys(request, keys);
+        std::optional<Hash> hash;
+        if (request.exists("txhash")) hash = HashOf(request["txhash"]);
+        std::vector<uint8_t> wire;
+        const bool has_wire = request.exists("wire");
+        if (has_wire) wire = Unhex(request["wire"], 1000000);
+        const auto status = pool->Status(HashOf(request["txid"]), hash, has_wire ? &wire : nullptr);
+        static const char *names[] = {"pending", "confirmed", "conflicted", "unknown", "inconclusive"};
+        UniValue answer(UniValue::VOBJ);
+        answer.pushKV("state", names[static_cast<size_t>(status.state)]);
+        answer.pushKV("txid", Hex(status.txid));
+        answer.pushKV("txhash", Hex(status.txhash));
+        answer.pushKV("error", status.diagnostic.substr(0, 1024));
+        if (status.confirmation) {
+            answer.pushKV("block_id", Hex(status.confirmation->block));
+            answer.pushKV("height", status.confirmation->height);
+        }
+        return answer;
+    }
+    UniValue Node::Mempool() {
+        const auto snapshot = pool->Snapshot(1000, 16000000);
+        UniValue answer(UniValue::VOBJ), entries(UniValue::VARR);
+        size_t bytes = 0;
+        for (const auto &entry : snapshot.entries) {
+            UniValue item(UniValue::VOBJ);
+            item.pushKV("txid", Hex(entry.effects.txid));
+            item.pushKV("txhash", Hex(entry.effects.txhash));
+            entries.push_back(item);
+            bytes += entry.wire.size();
+        }
+        answer.pushKV("ready", snapshot.status == PoolStatus::Accepted);
+        answer.pushKV("tip", Hex(snapshot.anchor.tip));
+        answer.pushKV("count", uint64_t(snapshot.entries.size()));
+        answer.pushKV("bytes", uint64_t(bytes));
+        answer.pushKV("transactions", entries);
+        return answer;
+    }
+    UniValue Node::MinePool(const UniValue &request) {
+        Keys(request, {"id", "command", "expected_parent", "time", "max_claim", "coinbase_output", "coinbase_data", "start_nonce", "max_attempts"});
+        const auto snapshot = pool->Snapshot(1000, 16000000);
+        Require(snapshot.status == PoolStatus::Accepted, "transaction pool authority unavailable");
+        Require(snapshot.anchor.tip == HashOf(request["expected_parent"]), "stale pool parent");
+        UniValue expanded = request;
+        UniValue transactions(UniValue::VARR);
+        // Validate each candidate prefix against the real block builder. Costs
+        // and parabolic burn may reject a pool-valid transaction in a block.
+        // One rejection does not prevent independent later entries being used.
+        size_t attempts = 0, skipped = 0;
+        for (const auto &entry : snapshot.entries) {
+            if (++attempts > 64) break;
+            UniValue candidate = transactions;
+            candidate.push_back(Hex(entry.wire));
+            UniValue probe = request;
+            probe.pushKV("transactions", candidate);
+            probe.pushKV("max_attempts", uint64_t(0));
+            const auto result = MineBlock(probe);
+            if (result["result"].isStr() && result["result"].get_str() == "nonce_exhausted") transactions = std::move(candidate);
+            else ++skipped;
+        }
+        expanded.pushKV("transactions", transactions);
+        auto answer = MineBlock(expanded);
+        answer.pushKV("pool_selected", uint64_t(transactions.size()));
+        answer.pushKV("pool_skipped", uint64_t(skipped));
+        return answer;
+    }
+    UniValue Node::Status() {
+        UniValue v(UniValue::VOBJ);
+        const auto snap = runtime->Snapshot();
+        v.pushKV("tip_known", bool(snap.chain) && !snap.reopen_required);
+        v.pushKV("reopen_required", snap.reopen_required);
+        v.pushKV("execution_paused", snap.execution_paused);
+        if (snap.chain && !snap.reopen_required) {
+            DiskStateMetadata metadata;
+            Hash root;
+            std::string error;
+            Require(runtime->ReadMetadata(16 * MiB, metadata, root, error) ==
+                        Result::Progress,
+                    error);
+            Header h;
+            Require(
+                ParseHeader(metadata.header.data(), metadata.header.size(), h),
+                "authoritative header unavailable");
+            v.pushKV("tip", Hex(metadata.tip));
+            v.pushKV("height", h.height);
+            v.pushKV("utxo_root", Hex(root));
+            v.pushKV("state_root", Hex(h.state_root));
+            v.pushKV("monetary_bytes", Hex(metadata.monetary));
+            v.pushKV("pending_journal", snap.chain->pending_journal);
+            v.pushKV("pending_receipt", snap.chain->pending_receipt);
+            v.pushKV("pending_propagation", snap.chain->pending_propagation);
+            v.pushKV("invalid_roots", snap.chain->invalid_root_count);
+        }
+        if (network.chronik_bind) {
+            v.pushKV("chronik_address", chronik_address);
+            v.pushKV("chronik_last_sync_ready", chronik_ready);
+            v.pushKV("chronik_error", chronik_error);
+        }
+        if (avalanche) {
+            const auto a = avalanche->Status();
+            UniValue status(UniValue::VOBJ);
+            status.pushKV("started", a.started);
+            status.pushKV("failed", a.failed);
+            status.pushKV("observer", !network.avalanche->credentials.has_value());
+            status.pushKV("initial_download", a.initial_download);
+            status.pushKV("quorum_ready", a.quorum_ready);
+            status.pushKV("quorum_established", a.quorum_established);
+            status.pushKV("proof_count", a.proof_count);
+            status.pushKV("authenticated_peer_count", a.authenticated_peer_count);
+            status.pushKV("eligible_peer_count", a.eligible_peer_count);
+            status.pushKV("active_stake_score", a.active_stake_score);
+            status.pushKV("connected_stake_score", a.connected_stake_score);
+            status.pushKVs(AvalancheDiagnosticsJson(a.polls, a.peer, a.diagnostics,
+                                                   a.tip_confidence));
+            status.pushKV("error", avalanche_error.substr(0, 1024));
+            status.pushKV("reconcile_error", avalanche_reconcile_error.substr(0, 1024));
+            status.pushKV("reconcile_successes", avalanche_reconciled);
+            if (avalanche_last_reconciled) status.pushKV("last_reconciled_block", Hex(*avalanche_last_reconciled));
+            RuntimeBlockObservation observation;
+            std::string error;
+            const bool observed = snap.chain && runtime->ObserveAvalancheBlock(snap.chain->stable_tip, observation, error);
+            status.pushKV("tip_observation_available", observed);
+            status.pushKV("tip_finalized", observed && observation.finalized);
+            v.pushKV("avalanche", status);
+        }
+        v.pushKV("mempool_ready", pool->Snapshot(0, 0).status == PoolStatus::Accepted);
+        static const char *coordinator_names[] = {"ready", "progress", "deferred", "capacity_refused", "storage_error"};
+        v.pushKV("transaction_index", coordinator_names[static_cast<size_t>(pool_result)]);
+        v.pushKV("transaction_index_error", pool_diagnostic.substr(0, 1024));
+        v.pushKV("chain_id", Hex(network.profile.chain_id));
+        v.pushKV("genesis_id", Hex(network.profile.genesis_id));
+        v.pushKV("profile_digest", Hex(network.profile.profile_digest));
+        uint64_t active = 0;
+        for (const auto &c : connections)
+            if (c->transport && c->transport->State() == SessionState::Active)
+                ++active;
+        v.pushKV("peer_connections", uint64_t(connections.size()));
+        v.pushKV("peer_active", active);
+        v.pushKV("peer_activations", active_events);
+        v.pushKV("download_full_requests", full_requests);
+        v.pushKV("download_compact_requests", compact_requests);
+        v.pushKV("download_retained", retained);
+        v.pushKV("download_full_retained", full_retained);
+        v.pushKV("download_compact_retained", compact_retained);
+        v.pushKV("download_fallbacks", fallbacks);
+        v.pushKV("serving_bytes", served_bytes);
+        v.pushKV("accepted_tip_changes", tip_changes);
+        const auto stats = manager->Stats();
+        v.pushKV("download_jobs", uint64_t(stats.jobs));
+        v.pushKV("fetch_epoch", dispatcher->FetchEpoch());
+        return v;
+    }
+    UniValue Node::SubmitBlock(const std::vector<uint8_t> &wire,
+                               bool *retained) {
+        Header h;
+        Hash block;
+        Require(
+            ParseHeader(wire.data(), std::min(wire.size(), HEADER_SIZE), h) &&
+                BlockId(network.profile.chain_id, h, block),
+            "invalid block header framing");
+        HeaderAdmission header;
+        std::string error;
+        const auto admitted = runtime->AdmitHeader(h, header, error);
+        if (admitted != Result::Progress)
+            throw ProducerFailure(RuntimeFailure(admitted),
+                                  "header admission: " + error);
+        Require(header == HeaderAdmission::Stored ||
+                    header == HeaderAdmission::Known,
+                "header admission: " + error);
+        std::optional<Hash> invalid;
+        const auto invalidity = runtime->ReadInvalidity(block, invalid, error);
+        if (invalidity != Result::Progress)
+            throw ProducerFailure(RuntimeFailure(invalidity), error);
+        Require(!invalid, "block has a durable invalidity root");
+        CandidateBodyStatus status;
+        const auto body = runtime->RetainBody(block, wire, status, error);
+        if (body != Result::Progress)
+            throw ProducerFailure(RuntimeFailure(body),
+                                  "body retention: " + error);
+        Require(status == CandidateBodyStatus::RetainedAuthenticated ||
+                    status == CandidateBodyStatus::Duplicate,
+                "body retention: " + error);
+        if (retained) *retained = true;
+        Track(block);
+        choices.reset();
+        auto answer = Status();
+        answer.pushKV("block_id", Hex(block));
+        answer.pushKV("retained_authenticated", true);
+        answer.pushKV("accepted", false);
+        answer.pushKV("pending_validation", true);
+        return answer;
+    }
+    UniValue Node::MineBlock(const UniValue &request) {
+        std::optional<Hash> found_id;
+        bool retained = false;
+        const auto failure = [&](const std::string &category,
+                                 const std::string &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", category);
+            answer.pushKV("error", error.substr(0, 1024));
+            answer.pushKV("found", bool(found_id));
+            answer.pushKV("accepted", false);
+            answer.pushKV("pending_validation", retained);
+            if (found_id) {
+                answer.pushKV("block_id", Hex(*found_id));
+                answer.pushKV("retained_authenticated", retained);
+            }
+            return answer;
+        };
+        std::string failure_phase = "invalid_request";
+        try {
+            Keys(request, {"id", "command", "expected_parent", "time",
+                           "max_claim", "coinbase_output", "coinbase_data",
+                           "transactions", "start_nonce", "max_attempts"});
+            LocalBlockRequest block_request;
+            block_request.expected_parent = HashOf(request["expected_parent"]);
+            block_request.time = Number(request["time"], MAX_TIME);
+            block_request.max_claim = DecimalU64(request["max_claim"]);
+            const auto start = DecimalU64(request["start_nonce"]);
+            const auto attempts =
+                Number(request["max_attempts"], MAX_NONCE_ATTEMPTS);
+            Require(request["transactions"].isArray(),
+                    "ordinary transactions must be an array");
+            if (request["transactions"].size() > MaxTransactions - 1)
+                throw ProducerFailure(
+                    "capacity_refused",
+                    "ordinary transaction count exceeds local capacity");
+            // Validate ALL aggregate byte/count bounds before copying hex or
+            // reserving the decoded transaction array. JSON parse/input storage
+            // retains its separate explicit line allowance.
+            uint64_t remaining = manifest.block_read_limit;
+            const auto destination_size =
+                HexSize(request["coinbase_output"], remaining);
+            if (destination_size > MAX_OUTPUT_BYTES)
+                throw ProducerFailure("capacity_refused",
+                                      "coinbase output exceeds codec capacity");
+            remaining -= destination_size;
+            if (!request["coinbase_data"].isNull()) {
+                const auto size = HexSize(request["coinbase_data"],
+                                          std::min<uint64_t>(8192, remaining));
+                Require(size != 0, "present coinbase_data must be nonempty");
+                remaining -= size;
+            }
+            for (const auto &tx : request["transactions"].getValues()) {
+                const auto size = HexSize(tx, remaining);
+                Require(size != 0, "empty ordinary transaction frame");
+                remaining -= size;
+            }
+            const auto snapshot = runtime->Snapshot();
+            if (snapshot.reopen_required)
+                throw ProducerFailure("reopen_required",
+                                      "runtime authority requires reopening");
+            if (!snapshot.chain || snapshot.execution_paused)
+                throw ProducerFailure(
+                    "inconclusive", "runtime execution authority unavailable");
+            if (snapshot.chain->pending_journal ||
+                snapshot.chain->pending_receipt ||
+                snapshot.chain->pending_propagation)
+                throw ProducerFailure(
+                    "busy", "runtime recovery/receipt/propagation pending");
+            if (snapshot.chain->stable_tip != block_request.expected_parent)
+                throw ProducerFailure(
+                    "stale_parent",
+                    "expected parent is not the authoritative stable tip");
+            const auto now = Utc();
+            const auto future = [&](uint64_t time) {
+                return time > now && time - now > manifest.future_window;
+            };
+            if (future(block_request.time) ||
+                future(snapshot.chain->active_max_ancestor_time))
+                throw ProducerFailure("deferred",
+                                      "candidate or authenticated ancestor is "
+                                      "temporarily future");
+            std::string error;
+            const auto destination =
+                Unhex(request["coinbase_output"], MAX_OUTPUT_BYTES);
+            Require(DecodeOutput(destination,
+                                 block_request.coinbase_destination, error),
+                    error);
+            std::vector<uint8_t> canonical;
+            Require(EncodeOutput(block_request.coinbase_destination, canonical,
+                                 error) &&
+                        canonical == destination,
+                    "noncanonical coinbase output");
+            Require(block_request.coinbase_destination.flags == 0 &&
+                        block_request.coinbase_destination.value == 0,
+                    "coinbase_output must be native, spendable and have value "
+                    "zero");
+            if (!request["coinbase_data"].isNull())
+                block_request.coinbase_data =
+                    Unhex(request["coinbase_data"], 8192);
+            block_request.ordinary.reserve(request["transactions"].size());
+            for (const auto &encoded : request["transactions"].getValues()) {
+                const auto bytes = Unhex(encoded, manifest.block_read_limit);
+                Transaction tx;
+                if (!DecodeTransaction(bytes, manifest.op.transaction, tx,
+                                       error) ||
+                    !EncodeTransaction(tx, manifest.op.transaction, canonical,
+                                       error) ||
+                    canonical != bytes)
+                    throw ProducerFailure(
+                        "invalid_transactions",
+                        "noncanonical ordinary transaction: " + error);
+                if (std::any_of(tx.inputs.begin(), tx.inputs.end(),
+                                [](const Input &i) { return i.flags == 2; }))
+                    throw ProducerFailure(
+                        "invalid_transactions",
+                        "supplied ordinary list contains coinbase input");
+                block_request.ordinary.push_back(std::move(tx));
+            }
+            failure_phase = "inconclusive";
+            LocalBlockBuildResult build_status =
+                LocalBlockBuildResult::Inconclusive;
+            LocalBlockTemplate block;
+            const auto access = runtime->BuildTemplate(
+                block_request,
+                {MaxTransactions - 1, manifest.block_read_limit, 8192},
+                build_status, block, error);
+            if (access != Result::Progress)
+                throw ProducerFailure(
+                    RuntimeFailure(access),
+                    error.empty() ? "runtime assembly access refused" : error);
+            if (build_status != LocalBlockBuildResult::Ready) {
+                const auto category = [&]() -> std::string {
+                    switch (build_status) {
+                        case LocalBlockBuildResult::InvalidTransactions:
+                            return "invalid_transactions";
+                        case LocalBlockBuildResult::CapacityRefused:
+                            return "capacity_refused";
+                        case LocalBlockBuildResult::StaleParent:
+                            return "stale_parent";
+                        case LocalBlockBuildResult::StorageError:
+                            return "storage_error";
+                        default:
+                            return "inconclusive";
+                    }
+                }();
+                throw ProducerFailure(category, error);
+            }
+            LocalBlockTemplate mined;
+            const auto nonce = SearchLocalBlockNonce(
+                block, manifest.hp.chain_id, manifest.hp.pow_limit, start,
+                attempts, mined, error);
+            if (nonce == LocalNonceResult::Exhausted) {
+                auto answer = Status();
+                answer.pushKV("ok", true);
+                answer.pushKV("result", "nonce_exhausted");
+                answer.pushKV("found", false);
+                answer.pushKV("accepted", false);
+                answer.pushKV("pending_validation", false);
+                answer.pushKV("next_nonce",
+                              attempts > UINT64_MAX - start
+                                  ? UniValue()
+                                  : UniValue(std::to_string(start + attempts)));
+                return answer;
+            }
+            if (nonce != LocalNonceResult::Found || !mined.mined_id)
+                throw ProducerFailure(nonce == LocalNonceResult::CapacityRefused
+                                          ? "capacity_refused"
+                                          : "inconclusive",
+                                      error);
+            found_id = mined.mined_id;
+            // One additional bounded codec pass obtains the actual native
+            // coinbase identity/value, without returning a full block echo.
+            FramedBlock framed;
+            IdentityDigests ids;
+            Require(DecodeBlockWire(mined.wire, manifest.op.transaction,
+                                    manifest.hp.chain_id, framed, error) &&
+                        !framed.transactions.empty() &&
+                        framed.transactions[0].outputs.size() == 1 &&
+                        ComputeIdentities(framed.transactions[0],
+                                          manifest.op.transaction,
+                                          manifest.hp.chain_id, ids, error),
+                    "mined coinbase identity unavailable: " + error);
+            auto answer = SubmitBlock(mined.wire, &retained);
+            answer.pushKV("ok", true);
+            answer.pushKV("result", "pending_validation");
+            answer.pushKV("found", true);
+            answer.pushKV("nonce", std::to_string(mined.preview.header.nonce));
+            answer.pushKV("coinbase_txid", Hex(ids.txid));
+            answer.pushKV("coinbase_index", uint64_t{0});
+            answer.pushKV(
+                "coinbase_value",
+                std::to_string(framed.transactions[0].outputs[0].value));
+            return answer;
+        } catch (const ProducerFailure &error) {
+            return failure(error.result, error.what());
+        } catch (const std::bad_alloc &) {
+            return failure("capacity_refused",
+                           "local mining allocation capacity");
+        } catch (const std::length_error &) {
+            return failure("capacity_refused",
+                           "local mining allocation length");
+        } catch (const std::exception &error) {
+            return failure(failure_phase, error.what());
+        }
+    }
+    UniValue Node::ReadBlock(const UniValue &request) {
+        std::string phase = "invalid_request";
+        try {
+            Keys(request, {"id", "command", "block_id", "offset", "length"});
+            const auto id = HashOf(request["block_id"]);
+            const auto offset = Number(request["offset"], UINT32_MAX);
+            const auto length = Number(request["length"], 65536);
+            Require(length > 0, "readblock length must be1..65536");
+            phase = "inconclusive";
+            DevelopmentBodyChunk chunk;
+            std::string error;
+            const auto result = runtime->ReadConnectedBodyChunk(
+                id, manifest.block_read_limit, offset, length, chunk, error);
+            if (result != Result::Progress)
+                throw ProducerFailure(
+                    result == Result::InvalidConfiguration
+                        ? "invalid_request"
+                        : result == Result::MissingBody || result == Result::MissingHeader
+                              ? "missing_body"
+                              : RuntimeFailure(result),
+                    error.empty() ? "connected body unavailable" : error);
+            auto answer = Status();
+            // Status can fault while reading storage or Avalanche observations.
+            // Publish the slice only if its full authority stamp still matches.
+            if (!SameDevelopmentBodyAuthority(chunk.snapshot, runtime->Snapshot()))
+                throw ProducerFailure("inconclusive",
+                                      "connected body authority changed");
+            answer.pushKV("block_id", Hex(id));
+            answer.pushKV("offset", offset);
+            answer.pushKV("total_bytes", chunk.total_bytes);
+            answer.pushKV("data", Hex(chunk.bytes));
+            answer.pushKV("eof", offset + chunk.bytes.size() == chunk.total_bytes);
+            answer.pushKV("ok", true);
+            return answer;
+        } catch (const ProducerFailure &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", error.result);
+            answer.pushKV("error", std::string(error.what()).substr(0, 1024));
+            return answer;
+        } catch (const std::bad_alloc &) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", "capacity_refused");
+            return answer;
+        } catch (const std::length_error &) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", "capacity_refused");
+            return answer;
+        } catch (const std::exception &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", phase);
+            answer.pushKV("error", std::string(error.what()).substr(0, 1024));
+            return answer;
+        }
+    }
+    UniValue Node::WalletContext(const UniValue &request,
+                                 size_t request_bytes) {
+        std::string phase = "invalid";
+        const auto failed = [&](const std::string &result,
+                                const std::string &error) {
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("result", result);
+            answer.pushKV("error", error.substr(0, 1024));
+            return answer;
+        };
+        try {
+            Require(request_bytes <= 1024,
+                    "walletcontext request exceeds1024bytes");
+            Keys(request, {"id", "command", "tip", "outpoint"});
+            std::optional<Hash> expected;
+            if (!request["tip"].isNull()) expected = HashOf(request["tip"]);
+            std::optional<Outpoint> outpoint;
+            if (!request["outpoint"].isNull()) {
+                Keys(request["outpoint"], {"txid", "index"});
+                outpoint = Outpoint{
+                    HashOf(request["outpoint"]["txid"]),
+                    uint32_t(Number(request["outpoint"]["index"], UINT32_MAX))};
+            }
+            phase = "inconclusive";
+            const auto before = runtime->Snapshot();
+            const auto quiescent = [](const DevelopmentRuntimeSnapshot &s) {
+                return s.chain && !s.reopen_required && !s.execution_paused &&
+                       !s.chain->pending_journal && !s.chain->pending_receipt &&
+                       !s.chain->pending_propagation;
+            };
+            if (!quiescent(before))
+                throw ProducerFailure(
+                    "inconclusive",
+                    "authoritative quiescent wallet context unavailable");
+            if (before.chain->identity != network.profile.chain_id ||
+                before.chain->profile_digest != network.profile.profile_digest)
+                throw ProducerFailure("storage_error",
+                                      "runtime profile identity mismatch");
+            if (expected && *expected != before.chain->stable_tip)
+                throw ProducerFailure(
+                    "stale",
+                    "requested tip is not the authoritative stable tip");
+            const auto read_ok = [&](Result result, const std::string &error) {
+                if (result == Result::Progress) return;
+                // With a quiescent single owner, a new read fault/reopen means
+                // storage lost authority during this call. Existing
+                // unavailability was refused above; local capacity remains
+                // inconclusive.
+                throw ProducerFailure(
+                    result == Result::StorageError ||
+                            result == Result::ReopenRequired
+                        ? "storage_error"
+                        : "inconclusive",
+                    error.empty() ? "wallet context read unavailable" : error);
+            };
+            phase = "storage_error";
+            DiskStateMetadata metadata;
+            Hash root;
+            std::string error;
+            read_ok(runtime->ReadMetadata(16 * MiB, metadata, root, error),
+                    error);
+            phase = "storage_error";
+            Require(metadata.tip == before.chain->stable_tip &&
+                        root == before.chain->root,
+                    "wallet metadata disagrees with authoritative tip/root");
+            Header tip;
+            Require(metadata.header.size() == HEADER_SIZE &&
+                        ParseHeader(metadata.header.data(),
+                                    metadata.header.size(), tip),
+                    "malformed wallet tip header");
+            Hash computed_tip;
+            Require(BlockId(network.profile.chain_id, tip, computed_tip) &&
+                        computed_tip == metadata.tip,
+                    "wallet tip header identity mismatch");
+            Require(metadata.monetary.size() == 56,
+                    "wallet monetary state must be56bytes");
+            const auto money = DecodeMonetaryState(metadata.monetary);
+            Require(StateRoot(network.profile.chain_id, tip.height, root,
+                              money) == tip.state_root,
+                    "wallet state commitment mismatch");
+            UniValue history(UniValue::VARR);
+            Hash current = metadata.tip;
+            const auto history_count = std::min<uint64_t>(tip.height, 10) + 1;
+            uint64_t expected_height = tip.height;
+            for (uint64_t n = 0; n < history_count; ++n) {
+                std::optional<IndexedHeader> indexed;
+                read_ok(runtime->ReadHeader(current, indexed, error), error);
+                Require(bool(indexed),
+                        "missing authenticated wallet history header");
+                std::array<uint8_t, HEADER_SIZE> raw{};
+                Hash id;
+                Require(indexed->header.height == expected_height &&
+                            indexed->header.version == manifest.hp.version &&
+                            SerializeHeader(indexed->header, raw) &&
+                            BlockId(network.profile.chain_id, indexed->header,
+                                    id) &&
+                            id == current,
+                        "wallet history identity/height/version mismatch");
+                if (n == 0)
+                    Require(std::equal(raw.begin(), raw.end(),
+                                       metadata.header.begin()),
+                            "wallet history tip serialization mismatch");
+                if (expected_height == 0)
+                    Require(current == network.profile.genesis_id,
+                            "wallet history genesis mismatch");
+                history.push_back(Hex(raw));
+                current = indexed->header.prev_id;
+                if (expected_height) --expected_height;
+            }
+            UniValue proof;
+            if (outpoint) {
+                CoinProof value;
+                read_ok(runtime->ProveCoin(*outpoint, value, error), error);
+                Require(VerifyCoinProof(*outpoint, value, root),
+                        "wallet proof does not bind authoritative UTXO root");
+                proof = UniValue(UniValue::VOBJ);
+                proof.pushKV("presence", uint64_t(value.presence));
+                if (value.coin) {
+                    std::vector<uint8_t> encoded;
+                    Require(EncodeCoin(*value.coin, encoded) &&
+                                encoded.size() <= MAX_COIN_BYTES,
+                            "wallet proof coin encoding invalid");
+                    proof.pushKV("coin", Hex(encoded));
+                } else
+                    proof.pushKV("coin", UniValue());
+                proof.pushKV("bitmap", Hex(value.bitmap));
+                UniValue siblings(UniValue::VARR);
+                Require(value.siblings.size() <= 256,
+                        "wallet proof sibling capacity");
+                for (const auto &sibling : value.siblings)
+                    siblings.push_back(Hex(sibling));
+                proof.pushKV("siblings", siblings);
+            }
+            const auto after = runtime->Snapshot();
+            if (!quiescent(after))
+                throw ProducerFailure(
+                    "inconclusive",
+                    "wallet context authority changed during read");
+            if (after.chain->stable_tip != before.chain->stable_tip ||
+                after.chain->root != before.chain->root ||
+                after.chain->identity != before.chain->identity ||
+                after.chain->profile_digest != before.chain->profile_digest)
+                throw ProducerFailure(
+                    "stale",
+                    "wallet context tip/root/profile changed during read");
+            UniValue answer(UniValue::VOBJ);
+            answer.pushKV("ok", true);
+            answer.pushKV("chain_id", Hex(network.profile.chain_id));
+            answer.pushKV("genesis_id", Hex(network.profile.genesis_id));
+            answer.pushKV("profile_digest",
+                          Hex(network.profile.profile_digest));
+            answer.pushKV("tip", Hex(metadata.tip));
+            answer.pushKV("height", tip.height);
+            answer.pushKV("utxo_root", Hex(root));
+            answer.pushKV("state_root", Hex(tip.state_root));
+            answer.pushKV("monetary_bytes", Hex(metadata.monetary));
+            answer.pushKV("tip_header", Hex(metadata.header));
+            answer.pushKV("history", history);
+            answer.pushKV("proof", proof);
+            // Include the echoed id in the final wire-size check. No status or
+            // peer counters are added to this deliberately exact response.
+            answer.pushKV("id", request["id"].get_str());
+            if (answer.write().size() + 1 > 32768)
+                throw ProducerFailure("inconclusive",
+                                      "wallet context response capacity");
+            return answer;
+        } catch (const ProducerFailure &error) {
+            return failed(error.result, error.what());
+        } catch (const std::bad_alloc &) {
+            return failed("inconclusive",
+                          "wallet context allocation unavailable");
+        } catch (const std::length_error &) {
+            return failed("inconclusive", "wallet context allocation capacity");
+        } catch (const std::exception &error) {
+            return failed(phase, error.what());
+        }
+    }
+    bool Node::Command(const std::string &line) {
+        UniValue request, answer(UniValue::VOBJ);
+        std::string id;
+        bool producer = false, wallet = false;
+        try {
+            Require(request.read(line) && request.isObject(),
+                    "invalid command JSON");
+            wallet = request["command"].isStr() &&
+                     request["command"].get_str() == "walletcontext";
+            if (wallet)
+                Require(line.size() <= 1024,
+                        "walletcontext request exceeds1024bytes");
+            Require(request["id"].isStr(), "command id required");
+            id = request["id"].get_str();
+            if (wallet && id.size() > 64) id.clear();
+            Require(!id.empty() && id.size() <= 64, "command id bound");
+            Require(request["command"].isStr(), "command name required");
+            const auto name = request["command"].get_str();
+            producer = name == "mineblock" || name == "minepool";
+            if (name == "status" || name == "stop") {
+                Keys(request, {"id", "command"});
+                answer = Status();
+                if (name == "stop") stopping = true;
+            } else if (name == "submitblock") {
+                Keys(request, {"id", "command", "block"});
+                answer = SubmitBlock(
+                    Unhex(request["block"], manifest.block_read_limit));
+            } else if (name == "submittransaction") {
+                answer = SubmitTransaction(request);
+            } else if (name == "transactionstatus") {
+                answer = TransactionQuery(request);
+            } else if (name == "mempool") {
+                Keys(request, {"id", "command"});
+                answer = Mempool();
+            } else if (name == "minepool") {
+                answer = MinePool(request);
+            } else if (name == "mineblock") {
+                answer = MineBlock(request);
+            } else if (name == "readblock") {
+                answer = ReadBlock(request);
+            } else if (name == "walletcontext") {
+                answer = WalletContext(request, line.size());
+            } else if (name == "blockstatus") {
+                Keys(request, {"id", "command", "block_id"});
+                const auto block = HashOf(request["block_id"]);
+                std::optional<Hash> invalid;
+                std::optional<IndexedHeader> header;
+                std::string error;
+                Require(runtime->ReadInvalidity(block, invalid, error) ==
+                                Result::Progress &&
+                            runtime->ReadHeader(block, header, error) ==
+                                Result::Progress,
+                        error);
+                UniValue observation(UniValue::VOBJ);
+                RuntimeBlockObservation observed;
+                std::string observation_error;
+                const bool available = avalanche && runtime->ObserveAvalancheBlock(block, observed, observation_error);
+                observation.pushKV("observation_available", available);
+                observation.pushKV("reason", available ? "available" : avalanche ? "unavailable" : "disabled");
+                if (available) {
+                    observation.pushKV("known", observed.known);
+                    observation.pushKV("valid", observed.valid);
+                    observation.pushKV("active", observed.active);
+                    observation.pushKV("parked", observed.parked);
+                    observation.pushKV("finalized", observed.finalized);
+                    observation.pushKV("conflicting_finalized", observed.conflicting_finalized);
+                    observation.pushKV("forks_active", observed.forks_active);
+                    observation.pushKV("has_data", observed.has_data);
+                } else if (avalanche) {
+                    observation.pushKV("error", observation_error.substr(0, 1024));
+                }
+                answer = Status();
+                answer.pushKV("block_id", Hex(block));
+                answer.pushKV("block_observation", observation);
+                answer.pushKV("known_header", bool(header));
+                answer.pushKV("deterministic_invalid", bool(invalid));
+                answer.pushKV("invalid_root",
+                              invalid ? UniValue(Hex(*invalid)) : UniValue());
+                const auto snap = runtime->Snapshot();
+                answer.pushKV("is_active_tip",
+                              snap.chain && !snap.reopen_required &&
+                                  snap.chain->stable_tip == block);
+                answer.pushKV("ever_connected",
+                              header &&
+                                  header->stage == HeaderStage::Connected);
+            } else if (name == "coin" || name == "proof") {
+                Keys(request, {"id", "command", "txid", "index"});
+                Outpoint key{HashOf(request["txid"]),
+                             uint32_t(Number(request["index"], UINT32_MAX))};
+                std::string error;
+                answer = Status();
+                Require(answer["tip_known"].get_bool(),
+                        "coin authority unavailable");
+                auto coinHex = [](const std::optional<Coin> &coin) {
+                    if (!coin) return UniValue();
+                    std::vector<uint8_t> wire;
+                    Require(EncodeCoin(*coin, wire), "coin encoding failure");
+                    return UniValue(Hex(wire));
+                };
+                if (name == "coin") {
+                    std::optional<Coin> coin;
+                    Require(runtime->ReadCoin(key, coin, error) ==
+                                Result::Progress,
+                            error);
+                    answer.pushKV("coin", coinHex(coin));
+                } else {
+                    CoinProof proof;
+                    Require(runtime->ProveCoin(key, proof, error) ==
+                                Result::Progress,
+                            error);
+                    Require(VerifyCoinProof(key, proof,
+                                            HashOf(answer["utxo_root"])),
+                            "proof/root mismatch");
+                    UniValue p(UniValue::VOBJ), siblings(UniValue::VARR);
+                    p.pushKV("presence", uint64_t(proof.presence));
+                    p.pushKV("coin", coinHex(proof.coin));
+                    p.pushKV("bitmap", Hex(proof.bitmap));
+                    for (const auto &h : proof.siblings)
+                        siblings.push_back(Hex(h));
+                    p.pushKV("siblings", siblings);
+                    answer.pushKV("proof", p);
+                }
+            } else
+                throw std::runtime_error(
+                    "unsupported local command");
+            if (!answer.exists("ok")) answer.pushKV("ok", true);
+        } catch (const std::exception &e) {
+            answer = UniValue(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            if (wallet) answer.pushKV("result", "invalid");
+            answer.pushKV("error", std::string(e.what()).substr(0, 1024));
+        }
+        if (!answer.exists("id")) answer.pushKV("id", id);
+        Queue(std::move(answer));
+        return producer;
+    }
+    void Node::ReadCommands() {
+        const size_t cap =
+            2 * manifest.block_read_limit + 4 * MaxTransactions + 1024;
+        std::array<char, 8192> buf{};
+        // At most eight reads/64KiB and eight commands per loop, separate from
+        // sockets.
+        for (unsigned reads = 0; reads < 8 && !eof && input.size() < cap;
+             ++reads) {
+            const auto n = read(STDIN_FILENO, buf.data(),
+                                std::min(buf.size(), cap - input.size()));
+            if (n > 0)
+                input.append(buf.data(), n);
+            else if (n == 0)
+                eof = true;
+            else {
+                Require(errno == EAGAIN || errno == EWOULDBLOCK ||
+                            errno == EINTR,
+                        "local command input failure");
+                break;
+            }
+        }
+        unsigned processed = 0;
+        bool produced = false;
+        while (processed++ < 8) {
+            const auto end = input.find('\n');
+            if (end == std::string::npos) break;
+            produced = Command(input.substr(0, end));
+            input.erase(0, end + 1);
+            if (stopping || produced) break;
+        }
+        if (produced)
+            return; // retain buffered commands for the next network/runtime
+                    // turn
+        Require(input.size() < cap, "local command line capacity exceeded");
+        if (eof && input.empty()) stopping = true;
+        if (eof && !input.empty() && input.find('\n') == std::string::npos) {
+            Command(input);
+            input.clear();
+            stopping = true;
+        }
+    }
+    void Node::Attach(Connection &c, uint64_t now) {
+        Require(Entropy(c.nonce), "version entropy unavailable");
+        uint64_t extra;
+        Require(Entropy(extra), "version extra entropy unavailable");
+        SessionConfig s{};
+        s.network = network.profile;
+        s.supported_features |= TRANSACTION_RELAY_FEATURE;
+        if (avalanche) s.supported_features |= AVALANCHE_FEATURE;
+        // This development node requires relay-capable peers as local policy;
+        // bit 8 remains optional in the protocol's SessionConfig defaults.
+        s.required_features |= TRANSACTION_RELAY_FEATURE;
+        s.inbound = c.inbound;
+        s.handshake_timeout_ms = 10000;
+        s.incoming_nonce_allowed = [this](uint64_t nonce) {
+            return !outbound_nonces.contains(nonce);
+        };
+        s.local_version.timestamp = int64_t(Utc());
+        s.local_version.sender = VersionSender{VersionAddress{}, c.nonce};
+        s.local_version.user_agent =
+            Bytes{'l', 'o', 't', 'u', 's', '-', 'v', '2', '-', 'd', 'e', 'v'};
+        const auto snap = runtime->Snapshot();
+        std::optional<IndexedHeader> tip;
+        std::string error;
+        if (snap.chain) runtime->ReadHeader(snap.chain->stable_tip, tip, error);
+        s.local_version.starting_height =
+            tip ? int32_t(std::min<uint64_t>(tip->header.height, INT32_MAX))
+                : 0;
+        s.local_version.relay = true;
+        s.local_version.extra_entropy = extra;
+        c.transport = std::make_unique<Transport>(
+            c.stream, s,
+            TransportLimits{8192, size_t(network.profile.receive_limit) + 4096,
+                            16, 10000, 10000});
+        if (!c.inbound) outbound_nonces.insert(c.nonce);
+        if (dispatcher->Attach(*c.transport, c.id) !=
+            DispatcherResult::Queued) {
+            outbound_nonces.erase(c.nonce);
+            throw std::runtime_error("dispatcher attach refused");
+        }
+        if (dispatcher->Open(c.id, now) != DispatcherResult::Queued) {
+            dispatcher->Remove(c.id);
+            outbound_nonces.erase(c.nonce);
+            c.transport.reset();
+            throw std::runtime_error("dispatcher open refused");
+        }
+        c.refresh = now + 1000;
+    }
+    void Node::Connections(uint64_t now) {
+        for (auto i = connections.begin(); i != connections.end();) {
+            auto &c = **i;
+            if (!c.transport) {
+                const auto state = c.stream.PollConnect(now);
+                if (state == TcpConnectStatus::Connected)
+                    Attach(c, now);
+                else if (state != TcpConnectStatus::Pending)
+                    c.stream.Close();
+            }
+            if (!c.stream.IsOpen() ||
+                (c.transport && c.transport->State() == SessionState::Closed)) {
+                if (avalanche) avalanche->Disconnect(c.id, TransportDisconnectCause(
+                    c.transport ? c.transport->CloseReason() : TransportClose::None));
+                avalanche_peers.erase(c.id);
+                avalanche_activations.erase(c.id);
+                pending_headers.erase(c.id);
+                if (pending_avalanche_notice && pending_avalanche_notice->connection == c.id) pending_avalanche_notice.reset();
+                if (c.transport) dispatcher->Remove(c.id);
+                relay_output.Remove(c.id.value);
+                relay->RemovePeer(c.id.value);
+                relay_peers.erase(c.id);
+                outbound_nonces.erase(c.nonce);
+                if (c.target) retry[*c.target] = now + 1000;
+                i = connections.erase(i);
+            } else
+                ++i;
+        }
+        for (unsigned i = 0; i < 2 && connections.size() < MaxPeers; ++i) {
+            auto c = std::make_unique<Connection>();
+            TcpEndpoint remote;
+            const auto result = listener.Accept(c->stream, remote);
+            if (result == TcpAcceptStatus::WouldBlock) break;
+            Require(result == TcpAcceptStatus::Accepted,
+                    "listener accept failure");
+            c->inbound = true;
+            connections.push_back(std::move(c));
+            Attach(*connections.back(), now);
+        }
+        if (connections.size() >= MaxPeers || network.connect.empty()) return;
+        const size_t target = target_cursor++ % network.connect.size();
+        if (now < retry[target]) return;
+        for (const auto &c : connections)
+            if (c->target == target) return;
+        auto c = std::make_unique<Connection>();
+        c->target = target;
+        const auto result =
+            c->stream.BeginConnect(network.connect[target], now, 5000);
+        if (result != TcpConnectStatus::Connected &&
+            result != TcpConnectStatus::Pending) {
+            retry[target] = now + 1000;
+            return;
+        }
+        connections.push_back(std::move(c));
+        if (result == TcpConnectStatus::Connected)
+            Attach(*connections.back(), now);
+    }
+    void Node::Track(const Hash &id) {
+        if (std::find(tracked_bodies.begin(), tracked_bodies.end(), id) ==
+            tracked_bodies.end()) {
+            Require(tracked_bodies.size() < 32, "local body tracking capacity");
+            tracked_bodies.push_back(id);
+        }
+    }
+    void Node::CleanupBodies() {
+        // Four body entries/eight fixed-size queries per turn; only durable
+        // connected or invalid bodies can leave the volatile pool.
+        // Pinned/recovery bodies retain their leases.
+        for (unsigned n = 0; n < 4 && !tracked_bodies.empty(); ++n) {
+            body_cursor %= tracked_bodies.size();
+            const auto id = tracked_bodies[body_cursor];
+            std::optional<IndexedHeader> h;
+            std::optional<Hash> invalid;
+            std::string error;
+            const auto a = runtime->ReadHeader(id, h, error),
+                       b = runtime->ReadInvalidity(id, invalid, error);
+            if (a == Result::Progress && b == Result::Progress &&
+                (invalid || (h && h->stage == HeaderStage::Connected))) {
+                CandidateBodyStatus status =
+                    CandidateBodyStatus::OperationalError;
+                if (runtime->EvictBody(id, status, error) == Result::Progress ||
+                    status == CandidateBodyStatus::Missing) {
+                    tracked_bodies.erase(tracked_bodies.begin() + body_cursor);
+                    continue;
+                }
+            }
+            ++body_cursor;
+        }
+    }
+    // BEGIN INITIAL DOWNLOAD POLICY
+    bool Node::InitialDownload(uint64_t wall) {
+        // Match pinned ABC: completing initial catchup is a process-local latch.
+        // Live runtime authority remains independently fenced by the driver.
+        if (initial_download_complete) return false;
+        if (!network.avalanche) return true;
+        const auto s = runtime->Snapshot();
+        if (!s.chain || s.reopen_required || s.execution_paused || s.chain->pending_journal ||
+            s.chain->pending_receipt || s.chain->pending_propagation || manager->Stats().jobs ||
+            !pending_headers.empty() || (choices && (choices->best_fetch || choices->best_ready))) return true;
+        std::optional<IndexedHeader> tip;
+        std::string error;
+        if (runtime->ReadHeader(s.chain->stable_tip, tip, error) != Result::Progress || !tip) return true;
+        const auto &config = *network.avalanche;
+        if (tip->header.height < config.minimum_height || tip->header.time > wall ||
+            wall - tip->header.time > config.maximum_tip_age_seconds) return true;
+        initial_download_complete = true;
+        return false;
+    }
+    // END INITIAL DOWNLOAD POLICY
+    ava::DisconnectCause Node::ConnectionDisconnectCause(ConnectionId id) const {
+        for (const auto &c : connections)
+            if (c->id == id && c->transport)
+                return TransportDisconnectCause(c->transport->CloseReason());
+        return ava::DisconnectCause::Unknown;
+    }
+    void Node::ClosePeer(ConnectionId id, ava::DisconnectCause cause) {
+        if (cause == ava::DisconnectCause::Unknown) cause = ConnectionDisconnectCause(id);
+        if (avalanche) avalanche->Disconnect(id, cause);
+        avalanche_peers.erase(id);
+        avalanche_activations.erase(id);
+        pending_headers.erase(id);
+        relay_output.Remove(id.value);
+        relay->RemovePeer(id.value);
+        relay_peers.erase(id);
+        dispatcher->Remove(id);
+        for (auto &c : connections) if (c->id == id) c->stream.Close();
+    }
+    void Node::ReconcileCandidates() {
+        const auto snapshot = runtime->Snapshot();
+        if (!snapshot.chain || snapshot.reopen_required || snapshot.execution_paused ||
+            snapshot.chain->pending_journal || snapshot.chain->pending_receipt || snapshot.chain->pending_propagation) return;
+        const auto &view = *snapshot.chain;
+        if (!avalanche_scan_anchor || avalanche_scan_anchor->body_epoch != snapshot.body_epoch ||
+            avalanche_scan_anchor->context_generation != snapshot.context_generation ||
+            !avalanche_scan_anchor->chain || avalanche_scan_anchor->chain->stable_tip != view.stable_tip ||
+            avalanche_scan_anchor->chain->revision != view.revision) {
+            avalanche_scan_anchor = snapshot;
+            avalanche_candidate_page.reset();
+            avalanche_candidate_cursor.reset();
+            avalanche_candidate_index = 0;
+            avalanche_scan_complete = false;
+        }
+        if (avalanche_scan_complete) return;
+        if (!avalanche_candidate_page) {
+            CandidatePage page;
+            std::string error;
+            const auto result = runtime->ReadAvalancheCandidates(avalanche_candidate_cursor,
+                {16, 4096, 4096, 64 * 1024}, page, error);
+            if (result != Result::Progress) {
+                avalanche_reconcile_error = error;
+                Require(result == Result::CapacityRefused || result == Result::Recovering ||
+                    result == Result::Busy || result == Result::ReopenRequired, "Avalanche candidate scan: " + error);
+                return;
+            }
+            if (page.view.stable_tip != view.stable_tip || page.view.revision != view.revision) {
+                avalanche_scan_anchor.reset();
+                return;
+            }
+            avalanche_candidate_page = std::move(page);
+            avalanche_candidate_index = 0;
+        }
+        // A retained page is <=16 rows. Vote-record capacity retains the exact
+        // current row, allowing Tick/polls to free capacity before enrollment.
+        auto &page = *avalanche_candidate_page;
+        for (size_t work = 0; work < 16 && avalanche_candidate_index < page.rows.size(); ++work) {
+            const auto &id = page.rows[avalanche_candidate_index].id;
+            RuntimeBlockObservation observation;
+            std::string error;
+            if (!runtime->ObserveAvalancheBlock(id, observation, error)) {
+                avalanche_reconcile_error = error;
+                return;
+            }
+            if (observation.known && observation.valid && observation.has_data &&
+                !observation.finalized && !observation.conflicting_finalized) {
+                if (!avalanche->Reconcile({ava::ItemKind::Block, id}, !observation.parked, error)) {
+                    avalanche_reconcile_error = error;
+                    if (error == "vote-record-capacity") return;
+                    Require(error == "already-finalized-item", "Avalanche candidate reconciliation: " + error);
+                } else {
+                    Count(avalanche_reconciled);
+                    avalanche_last_reconciled = id;
+                    avalanche_reconcile_error.clear();
+                }
+            }
+            ++avalanche_candidate_index;
+        }
+        if (avalanche_candidate_index == page.rows.size()) {
+            avalanche_scan_complete = page.complete;
+            avalanche_candidate_cursor = page.complete ? std::nullopt : page.next;
+            avalanche_candidate_page.reset();
+        }
+    }
+    void Node::TickAvalanche(uint64_t ms, uint64_t wall) {
+        if (!avalanche) return;
+        Require(ms <= INT64_MAX && wall <= INT64_MAX, "Avalanche clock outside signed range");
+        // Dispatcher close notices can be suppressed by notice backpressure.
+        for (auto it = avalanche_peers.begin(); it != avalanche_peers.end();) {
+            const auto f = dispatcher->ActiveFeatures(*it);
+            if (!f || !(*f & AVALANCHE_FEATURE)) {
+                avalanche->Disconnect(*it, ConnectionDisconnectCause(*it));
+                it = avalanche_peers.erase(it);
+            } else ++it;
+        }
+        for (auto it = avalanche_activations.begin(); it != avalanche_activations.end();) {
+            const auto f = dispatcher->ActiveFeatures(*it);
+            if (!f || !(*f & AVALANCHE_FEATURE)) { it = avalanche_activations.erase(it); continue; }
+            std::string error;
+            const auto r = avalanche->Activate(*it, error);
+            if (r == ava::PeerResult::Backpressure) { ++it; continue; }
+            if (r == ava::PeerResult::Rejected) {
+                const auto id = *it; ++it;
+                ClosePeer(id, ava::DisconnectCause::NegotiatedCapacity);
+                continue;
+            }
+            if (r == ava::PeerResult::UnknownPeer) {
+                const auto id = *it; ++it; ClosePeer(id); continue;
+            }
+            Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
+            avalanche_peers.insert(*it);
+            it = avalanche_activations.erase(it);
+        }
+        const auto snapshot = runtime->Snapshot();
+        if (snapshot.chain) {
+            RuntimeBlockObservation observation;
+            std::string error;
+            if (runtime->ObserveAvalancheBlock(snapshot.chain->stable_tip, observation, error) &&
+                observation.known && observation.valid && observation.has_data && !observation.finalized) {
+                if (avalanche->Reconcile({ava::ItemKind::Block, snapshot.chain->stable_tip}, !observation.parked, error)) {
+                    Count(avalanche_reconciled);
+                    avalanche_last_reconciled = snapshot.chain->stable_tip;
+                    avalanche_reconcile_error.clear();
+                } else {
+                    avalanche_reconcile_error = error;
+                    if (error != "already-finalized-item" && error != "vote-record-capacity")
+                        throw std::runtime_error("Avalanche reconciliation: " + error);
+                }
+            }
+        }
+        ReconcileCandidates();
+        const auto result = avalanche->Tick(InitialDownload(wall), int64_t(ms), int64_t(wall));
+        if(result.disconnected_peer) ClosePeer(*result.disconnected_peer);
+        avalanche_error = result.message;
+        Require(result.code == ava::DriverCode::Ok || result.code == ava::DriverCode::NotReady ||
+                result.code == ava::DriverCode::Backpressure, "Avalanche tick: " + result.message);
+        if (ms >= avalanche_save_due) {
+            const auto saved = avalanche->Save();
+            Require(saved.code == ava::DriverCode::Ok || saved.code == ava::DriverCode::NotReady,
+                    "Avalanche peer save: " + saved.message);
+            avalanche_save_due = ms > UINT64_MAX - 60000 ? UINT64_MAX : ms + 60000;
+        }
+    }
+    bool Node::HandleApplication(DispatcherNotice notice, uint64_t now) {
+        auto &message = *notice.application;
+        const bool inventory = message.command == "inv" || message.command == "getdata" || message.command == "notfound";
+        const bool avalanche_message = message.command.starts_with("ava") || message.command == "getavaproofs";
+        std::optional<Message> transaction;
+        if (inventory) {
+            const auto limit = dispatcher->ActiveLimit(notice.connection);
+            if (!limit) return true;
+            std::vector<Inventory> items, tx, proof;
+            std::string error;
+            if (!DecodeInventory(message.payload, *limit, items, error)) { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
+            for (const auto &i : items) {
+                if (i.type == 1) tx.push_back(i);
+                else if (i.type == PROOF_INVENTORY_TYPE) proof.push_back(i);
+                else { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
+            }
+            if (!tx.empty()) {
+                Bytes bytes;
+                Require(EncodeInventory(tx, *limit, bytes, error), "transaction inventory encoding failed");
+                transaction = Message{message.command, std::move(bytes)};
+            }
+            if (!proof.empty()) {
+                Bytes bytes;
+                Require(EncodeInventory(proof, *limit, bytes, error), "proof inventory encoding failed");
+                message.payload = std::move(bytes);
+            } else notice.application.reset();
+        } else if (!avalanche_message) {
+            transaction = std::move(message);
+            notice.application.reset();
+        }
+        // Retried notices contain only the proof half; transactions are admitted
+        // exactly once even if Avalanche's outgoing action queue is saturated.
+        if (transaction) {
+            auto result = relay->Handle(notice.connection.value, *transaction, now);
+            if (result.invalid_peer) { ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected); return true; }
+            RelayActions(std::move(result), now);
+        }
+        if (!notice.application) return true;
+        if (!avalanche) { ClosePeer(notice.connection); return true; }
+        std::string error;
+        if (avalanche_activations.contains(notice.connection)) {
+            const auto r = avalanche->Activate(notice.connection, error);
+            if (r == ava::PeerResult::Backpressure) { pending_avalanche_notice = std::move(notice); return false; }
+            if (r == ava::PeerResult::Rejected) {
+                // Activation rejection comes from the hello's negotiated byte cap.
+                ClosePeer(notice.connection, ava::DisconnectCause::NegotiatedCapacity);
+                return true;
+            }
+            if (r == ava::PeerResult::UnknownPeer) { ClosePeer(notice.connection); return true; }
+            Require(r == ava::PeerResult::Accepted, "Avalanche activation: " + error);
+            avalanche_peers.insert(notice.connection);
+            avalanche_activations.erase(notice.connection);
+        }
+        const auto result = avalanche->Handle(notice, now, error);
+        if (result == ava::PeerResult::Backpressure) { pending_avalanche_notice = std::move(notice); return false; }
+        if (result == ava::PeerResult::Rejected)
+            ClosePeer(notice.connection, ava::DisconnectCause::ApplicationRejected);
+        else if (result == ava::PeerResult::UnknownPeer) ClosePeer(notice.connection);
+        else if (result == ava::PeerResult::LocalFailure) {
+            // Runtime may be temporarily nonauthoritative during bounded
+            // recovery. Keep the exact notice until a later loop retries it.
+            if (error == "runtime-not-authoritative" || error == "runtime-header-unavailable" ||
+                error == "runtime-snapshot-changed" || error == "restore-snapshot-changed") {
+                pending_avalanche_notice = std::move(notice); return false;
+            }
+            throw std::runtime_error("Avalanche application: " + error);
+        }
+        return true;
+    }
+    void Node::Drain() {
+        if (observed_fetch_epoch != dispatcher->FetchEpoch()) {
+            observed_fetch_epoch = dispatcher->FetchEpoch();
+            for (auto &c : connections)
+                c->requested.reset();
+        }
+        for (size_t n = 0; n < 256; ++n) {
+            auto notice = pending_avalanche_notice ? std::exchange(pending_avalanche_notice, std::nullopt) : dispatcher->TakeNotice();
+            if (!notice) break;
+            if (notice->kind == DispatcherNoticeKind::Activated) {
+                Count(active_events);
+                if (avalanche) {
+                    const auto f = dispatcher->ActiveFeatures(notice->connection);
+                    if (f && (*f & AVALANCHE_FEATURE)) avalanche_activations.insert(notice->connection);
+                    // auto_start_headers is enabled in DispatcherSettings.
+                    pending_headers.insert(notice->connection);
+                }
+                const auto features = dispatcher->ActiveFeatures(notice->connection);
+                const auto limit = dispatcher->ActiveLimit(notice->connection);
+                if (features && limit && relay->AddPeer(notice->connection.value, *limit,
+                        (*features & TRANSACTION_RELAY_FEATURE) != 0)) {
+                    relay_peers.insert(notice->connection);
+                    inventory_refresh_requested = true;
+                }
+            }
+            if (notice->kind == DispatcherNoticeKind::HeadersComplete) pending_headers.erase(notice->connection);
+            if (notice->kind == DispatcherNoticeKind::Closed) {
+                if (avalanche) avalanche->Disconnect(notice->connection, ConnectionDisconnectCause(notice->connection));
+                avalanche_peers.erase(notice->connection);
+                avalanche_activations.erase(notice->connection);
+                pending_headers.erase(notice->connection);
+            }
+            if (notice->kind == DispatcherNoticeKind::Application && notice->application) {
+                if (!HandleApplication(std::move(*notice), Monotonic())) break;
+                continue;
+            }
+            if (notice->kind == DispatcherNoticeKind::Download &&
+                notice->download) {
+                const auto &e = *notice->download;
+                // Ignored/Busy are observations about an unsolicited or
+                // repeated message, not completion of an existing full fallback
+                // job.
+                const bool terminal = [&]() {
+                    switch (e.result) {
+                        case DownloadResult::Accepted:
+                        case DownloadResult::ConsensusRejected:
+                        case DownloadResult::PeerMessageInvalid:
+                        case DownloadResult::CapacityRefused:
+                        case DownloadResult::Unsupported:
+                        case DownloadResult::OperationalFailure:
+                        case DownloadResult::RetryElsewhere:
+                        case DownloadResult::Cancelled:
+                        case DownloadResult::RetainedAuthenticated:
+                            return true;
+                        default:
+                            return false;
+                    }
+                }();
+                if (terminal)
+                    for (auto &c : connections)
+                        if (c->id == notice->connection &&
+                            c->requested == e.block_id)
+                            c->requested.reset();
+                if (e.result == DownloadResult::RetryElsewhere)
+                    for (auto &c : connections)
+                        if (c->id == notice->connection && c->transport)
+                            c->transport->Close();
+                if (e.fallback)
+                    for (auto &c : connections)
+                        if (c->id == notice->connection)
+                            c->requested_fallback = true;
+                if (e.result == DownloadResult::RetainedAuthenticated) {
+                    for (const auto &c : connections)
+                        if (c->id == notice->connection) {
+                            if (c->requested_compact && !c->requested_fallback)
+                                Count(compact_retained);
+                            else
+                                Count(full_retained);
+                        }
+                    Count(retained);
+                    choices.reset();
+                }
+                if (e.fallback) Count(fallbacks);
+            }
+            // Generic capacity notices can be transient output/notice/staging
+            // backpressure; they never justify aborting an unrelated live job.
+            if (notice->kind == DispatcherNoticeKind::HeaderAvailable)
+                choices.reset();
+        }
+    }
+    void Node::Headers(uint64_t now, bool changed) {
+        for (auto &c : connections)
+            if (c->transport && c->transport->State() == SessionState::Active &&
+                (changed || now >= c->refresh)) {
+                if (dispatcher->StartHeaders(c->id, Hash{}, now) == DispatcherResult::Queued) pending_headers.insert(c->id);
+                c->refresh = now + 1000;
+            }
+    }
+    void Node::Schedule(uint64_t now) {
+        if (!choices || !choices->best_fetch || connections.empty()) return;
+        const auto snap = runtime->Snapshot();
+        if (!snap.chain || snap.reopen_required || snap.execution_paused ||
+            snap.chain->pending_journal || snap.chain->pending_receipt)
+            return;
+        if (choices->view.stable_tip != snap.chain->stable_tip ||
+            choices->body_epoch != snap.body_epoch) {
+            choices.reset();
+            return;
+        }
+        // One request per loop. Manager tombstones suppress duplicates until a
+        // bounded connection rotation releases that physical session's guards.
+        for (const auto &need : choices->best_fetch->missing) {
+            bool inflight = false;
+            for (const auto &c : connections)
+                if (c->requested == need.id) inflight = true;
+            if (inflight) continue;
+            std::optional<IndexedHeader> tip;
+            std::string error;
+            runtime->ReadHeader(snap.chain->stable_tip, tip, error);
+            const auto mode =
+                tip && (choices->best_fetch->indexed.header.height <=
+                            tip->header.height ||
+                        choices->best_fetch->indexed.header.height -
+                                tip->header.height <=
+                            1)
+                    ? DownloadMode::Compact
+                    : DownloadMode::Full;
+            for (size_t k = 0; k < connections.size(); ++k) {
+                auto &c =
+                    *connections[(request_cursor + k) % connections.size()];
+                if (!c.transport ||
+                    c.transport->State() != SessionState::Active || c.requested)
+                    continue;
+                if (c.issued_requests >= 64) {
+                    c.transport->Close();
+                    return;
+                }
+                const auto result =
+                    dispatcher->RequestBlock(c.id, need.header, mode, now);
+                if (result == DispatcherResult::Queued) {
+                    ++c.issued_requests;
+                    c.requested = need.id;
+                    c.requested_compact = mode == DownloadMode::Compact;
+                    c.requested_fallback = false;
+                    if (mode == DownloadMode::Full)
+                        Count(full_requests);
+                    else
+                        Count(compact_requests);
+                    ++request_cursor;
+                    return;
+                }
+                if (result == DispatcherResult::CapacityRefused) return;
+            }
+        }
+    }
+    void Node::Run() {
+        Nonblocking in(STDIN_FILENO), out(STDOUT_FILENO);
+        IgnorePipe pipe;
+        auto ready = Status();
+        UniValue endpoint(UniValue::VOBJ);
+        endpoint.pushKV("address", Address(bound));
+        endpoint.pushKV("port", uint64_t(bound.port));
+        ready.pushKV("listen", endpoint);
+        ready.pushKV("event", "ready");
+        Queue(ready);
+        auto snap = runtime->Snapshot();
+        if (snap.chain) last_tip = snap.chain->stable_tip;
+        const DispatcherBudget budget{64,
+                                      {128, 256 * 1024, 256 * 1024},
+                                      64,
+                                      16,
+                                      size_t(manifest.block_read_limit)};
+        const auto limits = TickLimits(manifest.block_read_limit);
+        while (!stopping) {
+            SuspendChronik();
+            const auto now = Monotonic();
+            TickAvalanche(now, Utc());
+            Drain();
+            Connections(now);
+            const auto usage =
+                dispatcher->Tick(now, Utc(), manifest.future_window, budget);
+            Count(served_bytes, usage.served_bytes);
+            // Closed notices may be suppressed by notice backpressure. Fence
+            // relay ownership against dispatcher authority every turn anyway.
+            for (auto i = relay_peers.begin(); i != relay_peers.end();) {
+                const auto features = dispatcher->ActiveFeatures(*i);
+                if (!features || !(*features & TRANSACTION_RELAY_FEATURE)) {
+                    relay_output.Remove(i->value);
+                    relay->RemovePeer(i->value);
+                    i = relay_peers.erase(i);
+                } else ++i;
+            }
+            Drain();
+            auto tick = runtime->Tick(Utc(), manifest.future_window, limits);
+            if (tick.choices) choices = std::move(tick.choices);
+            bool changed = false;
+            const auto current = runtime->Snapshot();
+            if (current.chain && !current.reopen_required &&
+                !current.chain->pending_receipt &&
+                !current.chain->pending_journal &&
+                current.chain->stable_tip != last_tip) {
+                last_tip = current.chain->stable_tip;
+                Count(tip_changes);
+                changed = true;
+                auto event = Status();
+                event.pushKV("event", "tip");
+                Queue(event);
+            }
+            TickAvalanche(Monotonic(), Utc());
+            PoolCoordinatorBudget pool_budget{};
+            pool_budget.validation = {1000, 100000000};
+            pool_result = pool->Tick(pool_budget, pool_diagnostic);
+            RelayActions(relay->Tick(Monotonic()), Monotonic());
+            if (changed) inventory_refresh = 0;
+            if (pool->Snapshot(0, 0).status != PoolStatus::Accepted) {
+                relay_inventory.clear();
+                inventory_refresh = 0;
+            } else if (RefreshInventory(inventory_cursor, relay_inventory.size(), now,
+                                        inventory_refresh, inventory_refresh_requested)) {
+                // Snapshot order is parent before child; Inventory() itself
+                // does not promise this order. Cache only identities between
+                // bounded one-second refreshes and fence every page above.
+                const auto snapshot = pool->Snapshot(1000, 16000000);
+                relay_inventory.clear();
+                for (const auto &entry : snapshot.entries)
+                    relay_inventory.push_back(entry.effects.txhash);
+                inventory_cursor = 0;
+                inventory_refresh = now + 1000;
+                inventory_refresh_requested = false;
+            }
+            if (relay_output.Empty() && inventory_cursor < relay_inventory.size()) {
+                const auto count = std::min<size_t>(4, relay_inventory.size() - inventory_cursor);
+                RelayActions(relay->AnnounceMany(std::span<const Hash>(relay_inventory).subspan(inventory_cursor, count), Monotonic()), Monotonic());
+                inventory_cursor += count;
+            }
+            CleanupBodies();
+            Headers(now, changed);
+            Schedule(now);
+            Drain();
+            FlushRelay(Monotonic());
+            ReadCommands();
+            if (!stopping) SyncChronik();
+            Flush();
+            std::array<pollfd, MaxPeers + 3> fds{};
+            size_t count = 0;
+            fds[count++] = {STDIN_FILENO, POLLIN, 0};
+            if (!output.empty()) fds[count++] = {STDOUT_FILENO, POLLOUT, 0};
+            fds[count++] = {listener.NativeHandle(), POLLIN, 0};
+            for (const auto &c : connections)
+                fds[count++] = {
+                    c->stream.NativeHandle(),
+                    short(POLLIN |
+                          (c->transport && c->transport->QueuedBytes() ? POLLOUT
+                                                                       : 0)),
+                    0};
+            const int result = poll(fds.data(), count, 10);
+            Require(result >= 0 || errno == EINTR, "local event poll failure");
+        }
+        if (avalanche) {
+            const auto saved = avalanche->Save();
+            Require(bool(saved), "Avalanche peer save: " + saved.message);
+        }
+        const auto deadline = Monotonic() + 2000;
+        while (!output.empty() && Monotonic() < deadline) {
+            Flush();
+            if (!output.empty()) {
+                pollfd fd{STDOUT_FILENO, POLLOUT, 0};
+                poll(&fd, 1, 10);
+            }
+        }
+    }
+} // namespace
+#endif
+int RunDevelopmentNodeCommand(int argc, char *argv[]) {
+#if defined(__linux__) || defined(__APPLE__)
+    try {
+        Require(argc == 5,
+                "usage: lotusd -lotusv2node MANIFEST DATADIR NETWORK.json");
+        DevelopmentManifest manifest;
+        std::string error;
+        Require(LoadDevelopmentManifest(argv[2], manifest, error), error);
+        const auto network = Network(argv[4], manifest);
+        std::string directory;
+        Require(PrepareDevelopmentHomeDirectory(manifest, argv[3], directory,
+                                                error),
+                error);
+        std::unique_ptr<DevelopmentRuntime> runtime;
+        Require(DevelopmentRuntime::Open(RuntimeConfig(manifest, directory, bool(network.avalanche)),
+                                         runtime, error),
+                error);
+        struct ECCLifetime {
+            bool enabled;
+            explicit ECCLifetime(bool enabled) : enabled(enabled) { if (enabled) ECC_Start(); }
+            ~ECCLifetime() { if (enabled) ECC_Stop(); }
+        } ecc(bool(network.avalanche));
+        Node node(std::move(manifest), network, std::move(runtime), directory);
+        node.Run();
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << "V2 development node: " << e.what() << '\n';
+        return 1;
+    }
+#else
+    (void)argc;
+    (void)argv;
+    std::cerr << "V2 development node requires Linux or macOS\n";
+    return 1;
+#endif
+}
+} // namespace lotus::v2
