+++ b/src/lotus_v2/node_avalanche_test/check_node.py
@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""Actual-process development-node Avalanche checks (isolated fresh directories)."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import select
+import subprocess
+import tempfile
+import time
+
+
+def network(avalanche=None, connect=()):
+    value = dict(schema=1, magic="76326176", listen=dict(address="127.0.0.1", port=0),
+                 connect=list(connect), receive_limit=2097152, local_policy="bounded-local-v1")
+    if avalanche is not None:
+        value["avalanche"] = avalanche
+    return value
+
+
+def config(credentials=None, height=0, age=4294967295):
+    return dict(credentials=credentials,
+                initial_download=dict(minimum_height=height, maximum_tip_age_seconds=age))
+
+
+class Node:
+    def __init__(self, args, root, name, settings):
+        self.args = args
+        self.root = root / name
+        self.root.mkdir()
+        self.settings = self.root / "network.json"
+        self.settings.write_text(json.dumps(settings))
+        self.process = subprocess.Popen([args.node, "-lotusv2node", args.manifest,
+                                         str(self.root / "home"), str(self.settings)],
+                                        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                        stderr=subprocess.PIPE, bufsize=0)
+        self.buffer = b""
+        self.next_id = 0
+        self.evidence = Path(args.evidence) / (name + ".jsonl") if args.evidence else None
+
+    def record(self, direction, value):
+        if self.evidence:
+            with self.evidence.open("a") as file:
+                file.write(json.dumps(dict(direction=direction, value=value), sort_keys=True) + "\n")
+
+    def event(self, deadline):
+        while b"\n" not in self.buffer:
+            remaining = deadline - time.monotonic()
+            assert remaining > 0, "node event deadline"
+            ready, _, _ = select.select([self.process.stdout], [], [], remaining)
+            assert ready, "node event timeout"
+            data = os.read(self.process.stdout.fileno(), 65536)
+            assert data, "node exited: " + self.process.stderr.read().decode()
+            self.buffer += data
+        line, self.buffer = self.buffer.split(b"\n", 1)
+        event = json.loads(line)
+        self.record("received", event)
+        return event
+
+    def request(self, command, **fields):
+        self.next_id += 1
+        tag = str(self.next_id)
+        request = dict(id=tag, command=command, **fields)
+        self.record("sent", request)
+        self.process.stdin.write((json.dumps(request) + "\n").encode())
+        deadline = time.monotonic() + 10
+        while True:
+            event = self.event(deadline)
+            if event.get("id") == tag:
+                assert event["ok"], event
+                return event
+
+    def close(self):
+        if self.process.poll() is None:
+            self.request("stop")
+        self.process.wait(timeout=10)
+        error = self.process.stderr.read().decode()
+        assert self.process.returncode == 0, error
+        return error
+
+    def kill(self):
+        if self.process.poll() is None:
+            self.process.kill()
+        self.process.wait(timeout=10)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--node", required=True)
+    parser.add_argument("--manifest", required=True)
+    parser.add_argument("--evidence", help="new directory for public command/event traces and exact input hashes")
+    parser.add_argument("--binary-source", default="unspecified", help="immutable binary source revision for evidence")
+    args = parser.parse_args()
+    args.node = str(Path(args.node).resolve())
+    args.manifest = str(Path(args.manifest).resolve())
+    if args.evidence:
+        evidence = Path(args.evidence).resolve()
+        evidence.mkdir()
+        args.evidence = str(evidence)
+        bindings = dict(binary_source=args.binary_source,
+                        binary_sha256=hashlib.sha256(Path(args.node).read_bytes()).hexdigest(),
+                        manifest_sha256=hashlib.sha256(Path(args.manifest).read_bytes()).hexdigest(),
+                        harness_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+                        binary=args.node, manifest=args.manifest)
+        (evidence / "inputs.json").write_text(json.dumps(bindings, sort_keys=True, indent=2) + "\n")
+    nodes = []
+    # PeerStore deliberately refuses symlink ancestors; macOS's default /var
+    # temp prefix passes through a symlink. Use its canonical physical path.
+    with tempfile.TemporaryDirectory(prefix="lotus-v2-node-avalanche-",
+                                     dir=Path(tempfile.gettempdir()).resolve()) as directory:
+        root = Path(directory)
+        try:
+            disabled = Node(args, root, "disabled", network())
+            nodes.append(disabled)
+            disabled_ready = disabled.event(time.monotonic() + 10)
+            assert "avalanche" not in disabled_ready
+            disabled_status = disabled.request("blockstatus", block_id=disabled_ready["genesis_id"])
+            assert disabled_status["block_id"] == disabled_ready["genesis_id"]
+            assert disabled_status["block_observation"] == dict(observation_available=False, reason="disabled")
+            disabled.close()
+            # Options are part of the on-disk profile; enabling Avalanche must
+            # refuse the old disabled home rather than reset or adopt it.
+            disabled.settings.write_text(json.dumps(network(config())))
+            refused = subprocess.run([args.node, "-lotusv2node", args.manifest,
+                                      str(disabled.root / "home"), str(disabled.settings)],
+                                     input=b"", capture_output=True, timeout=10)
+            assert refused.returncode != 0, "disabled home silently adopted Avalanche policy"
+            stale = Node(args, root, "stale", network(config(age=1)))
+            nodes.append(stale)
+            stale.event(time.monotonic() + 10)
+            assert stale.request("status")["avalanche"]["initial_download"]
+            stale.close()
+            observer = Node(args, root, "observer", network(config()))
+            nodes.append(observer)
+            ready = observer.event(time.monotonic() + 10)
+            assert ready["avalanche"]["started"] and ready["avalanche"]["observer"]
+            assert ready["avalanche"]["initial_download"]
+            genesis_status = observer.request("blockstatus", block_id=ready["genesis_id"])
+            assert genesis_status["block_id"] == ready["genesis_id"]
+            assert genesis_status["block_observation"] == dict(observation_available=True, reason="available",
+                    known=True, valid=True, active=True, parked=False, finalized=False,
+                    conflicting_finalized=False, forks_active=False, has_data=True)
+            unknown_id = "ff" * 32
+            unknown_status = observer.request("blockstatus", block_id=unknown_id)
+            assert unknown_status["block_id"] == unknown_id
+            assert unknown_status["block_observation"] == dict(observation_available=True, reason="available",
+                    known=False, valid=False, active=False, parked=False, finalized=False,
+                    conflicting_finalized=False, forks_active=False, has_data=False)
+            peer = Node(args, root, "peer", network(config(height=1), [ready["listen"]]))
+            nodes.append(peer)
+            peer.event(time.monotonic() + 10)
+            deadline = time.monotonic() + 15
+            while True:
+                first, second = observer.request("status"), peer.request("status")
+                if first["peer_active"] and second["peer_active"] and not first["avalanche"]["initial_download"]:
+                    break
+                assert time.monotonic() < deadline, (first, second)
+                time.sleep(0.05)
+            assert second["avalanche"]["initial_download"], second
+            for status in (first, second):
+                a = status["avalanche"]
+                assert a["tip_observation_available"], status
+                assert a["reconcile_successes"] > 0 and a["last_reconciled_block"] == status["tip"], status
+                assert a["proof_count"] == a["authenticated_peer_count"] == a["eligible_peer_count"] == 0
+                assert not a["quorum_ready"] and not a["quorum_established"] and not a["tip_finalized"]
+            peer.close()
+            observer.close()
+            # Public peer persistence must not contain the private credential schema.
+            for file in root.glob("*/home/**/avalanche-peers.dat"):
+                assert b"session_key" not in file.read_bytes()
+            private = root / "credentials.json"
+            sentinel = "ab" * 32
+            private.write_text(json.dumps(dict(schema=1, session_key=sentinel, proof="", delegation="")))
+            private.chmod(0o600)
+            link = root / "credential-link"
+            link.symlink_to(private)
+            fifo = root / "credential-fifo"
+            os.mkfifo(fifo, 0o600)
+            oversized = root / "oversized"
+            oversized.write_bytes(b" " * (1048576 + 1))
+            oversized.chmod(0o600)
+            cases = [("invalid-proof", private), ("symlink", link), ("fifo", fifo),
+                     ("directory", root), ("oversized", oversized)]
+            for name, path in cases:
+                node = Node(args, root, "reject-" + name, network(config(str(path))))
+                nodes.append(node)
+                _, stderr = node.process.communicate(timeout=10)
+                assert node.process.returncode != 0, name
+                assert sentinel.encode() not in stderr, "credential leaked"
+            private.chmod(0o644)
+            node = Node(args, root, "public-credentials", network(config(str(private))))
+            nodes.append(node)
+            _, stderr = node.process.communicate(timeout=10)
+            assert node.process.returncode != 0 and b"private owned regular file" in stderr
+            for name, bad in [("zero-age", config(age=0)), ("relative", config("relative.json")),
+                              ("unknown-config-field", dict(config(), fake_quorum=True))]:
+                node = Node(args, root, name, network(bad))
+                nodes.append(node)
+                node.process.communicate(timeout=10)
+                assert node.process.returncode != 0, name
+        finally:
+            for node in nodes:
+                node.kill()
+    if args.evidence:
+        (Path(args.evidence) / "result.json").write_text(json.dumps(dict(result="pass", temporary_nodes_cleaned=True)) + "\n")
+    print("Actual node observer negotiation, explicit IBD, no fake quorum, credential file validation: PASS")
+
+
+if __name__ == "__main__":
+    main()
