+    Seed(f, store, f.genesis, 1); const Header child = f.Child(f.genesis, 2); Seed(f, store, child, 2);
+    const Payload j1{1, 0xff}, j2{2}; const auto prepare = Update(store, std::nullopt, j1, f.Id(child));
