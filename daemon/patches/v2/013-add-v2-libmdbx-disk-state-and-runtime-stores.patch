+target_compile_options(lotus_v2_peer_codec_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
+if(LOTUS_SANITIZE)
+    target_compile_options(lotus_v2_peer_codec_test PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
+    target_link_options(lotus_v2_peer_codec_test PRIVATE -fsanitize=address,undefined)
+endif()
+enable_testing()
+add_test(NAME lotus_v2_peer_codec_test COMMAND lotus_v2_peer_codec_test)
