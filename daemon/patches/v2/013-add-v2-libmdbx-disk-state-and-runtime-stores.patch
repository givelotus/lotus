+struct TcpPair {
+    TcpListener listener;
+    TcpStream client, server;
+    Node a{client, 81}, b{server, 91};
+    uint64_t ms = 1;
+    std::chrono::steady_clock::time_point start =
+        std::chrono::steady_clock::now();
+    TcpPair() {
+        TcpEndpoint endpoint;
+        Check(ParseNumericEndpoint("127.0.0.1", 0, 0, endpoint),
+              "explicit numeric loopback");
+        Check(listener.Listen(endpoint, {4, false}) &&
+                  listener.BoundEndpoint(endpoint),
+              "ephemeral loopback listener");
+        Check(endpoint.port && endpoint.port != 10604 &&
+                  endpoint.port != 10605 && endpoint.port != 8331,
+              "ephemeral test excludes production ports");
+        const auto status = client.BeginConnect(endpoint, ms, 1000);
+        Check(status == TcpConnectStatus::Connected ||
+                  status == TcpConnectStatus::Pending,
+              "nonblocking TCP connect begins");
+        for (unsigned n = 0;
+             n < 1000 && (!client.IsConnected() || !server.IsConnected());
+             ++n) {
+            const auto connected = client.PollConnect(ms);
+            Check(connected != TcpConnectStatus::Error &&
+                      connected != TcpConnectStatus::TimedOut,
+                  "nonblocking TCP connects");
+            if (!server.IsOpen()) {
+                TcpEndpoint remote;
+                const auto accepted = listener.Accept(server, remote);
+                Check(accepted != TcpAcceptStatus::Error,
+                      "nonblocking TCP accept");
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            UpdateTime();
+        }
+        Check(client.IsConnected() && server.IsConnected(),
+              "two connected TCP streams");
+        Check(a.dispatcher->Open(a.connection, ms) ==
+                      DispatcherResult::Queued &&
+                  b.dispatcher->Open(b.connection, ms) ==
+                      DispatcherResult::Queued,
+              "open TCP transports");
+        for (unsigned n = 0; n < 1000 && (!a.Active() || !b.Active()); ++n)
+            Cycle();
+        Check(a.Active() && b.Active(),
+              "actual TCP Session handshake binds exact fixture profile");
+        listener.Close(); // only this one connection is needed
+    }
+    void UpdateTime() {
+        ms = 1 + uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                              std::chrono::steady_clock::now() - start)
+                              .count());
+    }
+    void Cycle() {
+        UpdateTime();
+        a.Poll(ms);
+        b.Poll(ms);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    void Headers() {
+        Check(a.dispatcher->StartHeaders(a.connection, Hash{}, ms) ==
+                  DispatcherResult::Queued,
+              "TCP header pages requested");
+    }
+};
+void TcpActualSync() {
+    TcpPair pair;
+    Sync(pair, DownloadMode::Full);
+    Check(pair.client.IsConnected() && pair.server.IsConnected(),
+          "TCP connection remains live at exact synced checkpoint");
+    std::cout << "PASS actual ephemeral TCP fullblock sync between two real V4 "
+                 "runtimes\n";
+}
+
+void SmallServingQueryBudgets() {
+    {
+        Pair p;
+        p.b.budget.max_runtime_queries = 1;
+        Sync(p, DownloadMode::Full);
+        Check(p.b.serving.grants >= 5,
+              "one-query full serving produces every selected response");
+    }
+    {
+        Pair p;
+        Seed(*p.a.runtime, {0, 1});
+        Seed(*p.b.runtime, {0, 1, 4});
+        p.b.budget.max_runtime_queries = 2;
+        p.Headers();
+        bool known = false;
+        for (unsigned n = 0; n < 1000 && !known; ++n) {
+            p.Cycle();
+            std::optional<IndexedHeader> h;
+            std::string error;
+            Check(p.a.runtime->ReadHeader(H(V(4).id), h, error) ==
+                      DevelopmentRuntimeResult::Progress,
+                  "small-query compact indexed header lookup");
+            known = bool(h);
+        }
+        Check(known && p.b.serving.grants == 0,
+              "cold compact request has no previously served body cache");
+        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(4)),
+                                           DownloadMode::Compact,
+                                           p.ms) == DispatcherResult::Queued,
+              "cold compact starts under two-query serving budget");
+        bool missing = false, retained = false;
+        for (unsigned n = 0; n < 1000 && !p.a.Stable(4); ++n) {
+            p.a.Poll(p.ms);
+            for (const auto &notice : p.a.notices)
+                if (notice.download) {
+                    missing |= notice.download->result ==
+                               DownloadResult::NeedTransactions;
+                    retained |= notice.download->result ==
+                                DownloadResult::RetainedAuthenticated;
+                }
+            // This switch occurs after the client processes the compact reply
+            // and before the remote handles its getblocktxn request.
+            if (missing) p.b.budget.max_runtime_queries = 1;
+            p.b.Poll(p.ms++);
+            const auto t = p.a.runtime->Tick(UINT64_MAX, 0, TickLimits());
+            Check(t.result != DevelopmentRuntimeResult::StorageError,
+                  "small-query compact actual chain admission");
+        }
+        Check(missing && retained && p.b.budget.max_runtime_queries == 1,
+              "cold compact budget2 and getblocktxn budget1 both eventually "
+              "respond");
+        Check(p.a.Stable(4),
+              "small serving query budgets reach exact accepted reference tip");
+        Match(*p.a.runtime, 4);
+        Check(p.a.manager->Stats().jobs == 0 && p.a.staging.live_bytes == 0 &&
+                  p.b.serving.live_bytes == 0,
+              "small-query serving releases separate download and serving "
+              "leases");
+        Check(p.a.Active() && p.b.Active(),
+              "small-query progress requires no reconnect");
+    }
+    std::cout << "PASS full/getblocktxn query budget1 and cold compact query "
+                 "budget2\n";
+}
+
+void HeaderClockSampleAndDuplicateRequest() {
+    {
+        Pipe outgoing, incoming;
+        MemoryStream stream(incoming, outgoing);
+        Node node(stream, 111);
+        Check(!node.dispatcher->HeaderClock(),
+              "header clock absent before first Tick");
+        Check(node.dispatcher->Open(node.connection, 1) ==
+                  DispatcherResult::Queued,
+              "clock test opens transport");
+        Check(!node.dispatcher->HeaderClock(),
+              "Open does not invent a wall-clock sample");
+        node.dispatcher->Tick(2, 123456, 77, DispatcherStep());
+        auto clock = node.dispatcher->HeaderClock();
+        Check(clock && clock->wall_seconds == 123456 &&
+                  clock->future_window == 77,
+              "HeaderClock accessor returns exact caller Tick sample");
+        node.dispatcher->Tick(3, 222222, 88, DispatcherStep());
+        clock = node.dispatcher->HeaderClock();
+        Check(clock && clock->wall_seconds == 222222 &&
+                  clock->future_window == 88,
+              "next Tick replaces both sampled clock fields exactly");
+    }
+    {
+        Pair p;
+        Seed(*p.b.runtime, {0});
+        std::string error;
+        HeaderAdmission out;
+        Check(p.a.runtime->AdmitHeader(HeaderOf(V(0)), out, error) ==
+                  DevelopmentRuntimeResult::Progress,
+              "duplicate request header authenticated");
+        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(0)),
+                                           DownloadMode::Full,
+                                           p.ms) == DispatcherResult::Queued,
+              "original body job starts");
+        p.a.Poll(p.ms++); // clear the dispatcher output slot without serving
+        const auto before = p.a.manager->Stats();
+        const auto bytes = p.a.staging.live_bytes, grants = p.a.staging.grants,
+                   releases = p.a.staging.releases;
+        const auto slots = p.a.staging.live_slots;
+        Check(before.jobs == 1 && bytes > 0,
+              "original job and lease remain live");
+        Check(p.a.dispatcher->RequestBlock(p.a.connection, HeaderOf(V(0)),
+                                           DownloadMode::Full,
+                                           p.ms) == DispatcherResult::Busy,
+              "duplicate live manager job returns DispatcherResult Busy");
+        const auto after = p.a.manager->Stats();
+        Check(after.jobs == before.jobs &&
+                  after.staging_bytes == before.staging_bytes &&
+                  after.transaction_slots == before.transaction_slots &&
+                  after.tombstones == before.tombstones &&
+                  after.deferred_jobs == before.deferred_jobs &&
+                  p.a.staging.live_bytes == bytes &&
+                  p.a.staging.live_slots == slots &&
+                  p.a.staging.grants == grants &&
+                  p.a.staging.releases == releases,
+              "duplicate Busy preserves exact existing job reservations");
+        bool busy_notice = false;
+        while (auto notice = p.a.dispatcher->TakeNotice())
+            if (notice->download)
+                busy_notice |=
+                    notice->download->result == DownloadResult::Busy &&
+                    notice->download->block_id == H(V(0).id) &&
+                    !notice->download->outbound;
+        Check(busy_notice, "duplicate Busy download event remains observable");
+        for (unsigned n = 0; n < 200 && !p.a.Stable(0); ++n) {
+            p.Cycle();
+            p.a.runtime->Tick(UINT64_MAX, 0, TickLimits());
+        }
+        Check(p.a.Stable(0), "original job completes after duplicate request");
+        Match(*p.a.runtime, 0);
+        Check(p.a.admissions == 1 && p.a.manager->Stats().jobs == 0 &&
+                  p.a.staging.live_bytes == 0 && p.a.staging.grants == grants &&
+                  p.a.staging.releases == releases + 1 && p.a.Active() &&
+                  p.b.Active(),
+              "duplicate request causes no extra body admission, lease or "
+              "connection closure");
+    }
+    std::cout << "PASS exact header clock sampling and duplicate active-job "
+                 "Busy preservation\n";
+}
+void TransactionRouting() {
+    Pair p;
+    for (unsigned i = 0; i < 10; ++i) p.Cycle();
+    Check((*p.a.dispatcher->ActiveFeatures(p.a.connection) & TRANSACTION_RELAY_FEATURE) != 0,
+          "relay feature exposed");
+    Check(p.a.dispatcher->ActiveLimit(p.a.connection) == p.a.transport.ActiveLimit(),
+          "active receive limit exposed");
+    auto send = [&](Message message) {
+        Check(p.b.transport.QueueMessage(message, p.ms) == QueueResult::Queued,
+              "enqueue inbound application");
+        for (unsigned i = 0; i < 10; ++i) {
+            p.b.transport.Poll(p.ms, TransportStep());
+            p.a.dispatcher->Tick(p.ms++, UINT64_MAX, 0, p.a.budget);
+        }
+    };
+    // Fill the actual bounded notice queue without consuming it.
+    for (unsigned i = 0; i < 128; ++i) send({"tx", Bytes{uint8_t(i)}});
+    std::vector<Inventory> mixed{{1, Hash{1}}, {2, Hash{2}}, {1, Hash{3}}};
+    Bytes payload;
+    std::string error;
+    Check(EncodeInventory(mixed, p.b.transport.ActiveLimit(), payload, error), "mixed inventory encoding");
+    send({"inv", payload});
+    size_t transactions = 0;
+    while (auto notice = p.a.dispatcher->TakeNotice()) {
+        if (notice->application) {
+            Check(notice->application->command == "tx", "full queue holds mixed inventory");
+            ++transactions;
+        }
+    }
+    Check(transactions == 128, "notice payload queue is bounded and lossless");
+    for (unsigned i = 0; i < 20; ++i) {
+        p.a.dispatcher->Tick(p.ms++, UINT64_MAX, 0, p.a.budget);
+    }
+    size_t applications = 0, blocks = 0;
+    while (auto notice = p.a.dispatcher->TakeNotice()) {
+        if (notice->application) {
+            std::vector<Inventory> decoded;
+            Check(DecodeInventory(notice->application->payload, p.a.transport.ActiveLimit(), decoded, error)
+                      && decoded.size() == 2 && decoded[0].type == 1 && decoded[1].type == 1,
+                  "mixed inventory delivers only transaction half");
+            ++applications;
+        }
+        if (notice->kind == DispatcherNoticeKind::NeedHeaders) ++blocks;
+    }
+    Check(applications == 1 && blocks == 1, "mixed inventory processed exactly once after backpressure");
+    for (const std::string command : {"getdata", "notfound"}) {
+        send({command, payload});
+        size_t routed = 0;
+        while (auto notice = p.a.dispatcher->TakeNotice()) {
+            if (notice->application) {
+                Check(notice->application->command == command, "inventory command preserved");
+                std::vector<Inventory> decoded;
+                Check(DecodeInventory(notice->application->payload, p.a.transport.ActiveLimit(), decoded, error)
+                          && decoded.size() == 2 && decoded[0].type == 1 && decoded[1].type == 1,
+                      "request/notfound transaction partition");
+                ++routed;
+            }
+        }
+        Check(routed == 1, "mixed request/notfound routed once");
+    }
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes{1}}, p.ms) == DispatcherResult::Queued,
+          "stage single application output");
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes{2}}, p.ms) == DispatcherResult::Busy,
+          "second action reports busy without replacing first");
+    for (unsigned i = 0; i < 20; ++i) p.Cycle();
+    size_t sent = 0;
+    for (const auto &notice : p.b.notices) {
+        if (notice.application && notice.application->command == "tx") {
+            Check(notice.application->payload == Bytes{1}, "busy preserves first output bytes");
+            ++sent;
+        }
+    }
+    Check(sent == 1, "single pending application delivered once");
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"block", {}}, p.ms) == DispatcherResult::CapacityRefused,
+          "application output rejects block command");
+    Check(p.a.dispatcher->SendApplication(p.a.connection, {"tx", Bytes((1 << 20) + 1)}, p.ms) == DispatcherResult::CapacityRefused,
+          "application payload cap enforced");
+    Pipe ab, ba;
+    MemoryStream sa{ba, ab}, sb{ab, ba};
+    Node a(sa, 71, 64, nullptr, false), b(sb, 81);
+    uint64_t ms = 1;
+    a.dispatcher->Open(a.connection, ms);
+    b.dispatcher->Open(b.connection, ms);
+    for (unsigned i = 0; i < 100; ++i) { a.Poll(ms); b.Poll(ms++); }
+    Check(a.Active() && b.Active(), "mandatory-only peer activates");
+    Check(a.dispatcher->SendApplication(a.connection, {"tx", Bytes{1}}, ms) == DispatcherResult::CapacityRefused,
+          "missing negotiated relay prevents application output");
+    Check(b.transport.QueueMessage({"tx", Bytes{1}}, ms) == QueueResult::Queued,
+          "inject unauthorized relay");
+    for (unsigned i = 0; i < 20; ++i) { a.Poll(ms); b.Poll(ms++); }
+    Check(!a.Active(), "unauthorized incoming transaction closes peer");
+    std::cout << "PASS bounded negotiated transaction routing and backpressure\n";
+}
+} // namespace
+int main() {
+    try {
+        AuthorityFencePreservesApplications();
+        TransactionRouting();
+        HeaderClockSampleAndDuplicateRequest();
+        SmallServingQueryBudgets();
+        BaselineActualSync();
+        CompactMissingAndFallback();
+        PendingBodiesSurviveTipAdvance();
+        PendingOutputTimeoutCancels();
+        AuthorityLossCancelsBeforeReopen();
+        InvalidBodyRestoresForkAndFences();
+        TinyBudgetReleasesDeadline();
+        ZeroTransportBudgetVisitsBothPeers();
+        TcpActualSync();
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
