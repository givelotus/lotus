+namespace {
+Bytes Hex(const std::string &hex) {
+    CHECK(hex.size() % 2 == 0);
+    Bytes b;
+    auto digit = [](char c) -> uint8_t {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        throw std::runtime_error("bad hex");
+    };
+    for (size_t i = 0; i < hex.size(); i += 2)
+        b.push_back(uint8_t(digit(hex[i]) * 16 + digit(hex[i + 1])));
+    return b;
+}
+NetworkProfile Profile(uint32_t limit = PRE_HELLO_LIMIT) {
+    NetworkProfile p{};
+    p.magic = {0x23, 0x41, 0x59,
+               0x67}; // arbitrary test bytes, no network allocation
+    p.chain_id[0] = 21;
+    p.genesis_id[0] = 22;
+    p.profile_digest[0] = 23;
+    p.receive_limit = limit;
+    p.transaction = {32, 32, 8, 8192, 16, 8192, 64};
+    p.max_reconstruction_transactions = 1000;
+    p.max_reconstruction_bytes = 4 * 1024 * 1024;
+    return p;
+}
+VersionMessage Modern() {
+    VersionMessage v;
+    v.timestamp = 123456;
+    v.sender = VersionSender{VersionAddress{}, 0x12345678};
+    v.user_agent = Bytes{'a', 'b', 'c'};
+    v.starting_height = 0;
+    v.relay = true;
+    v.extra_entropy = 0x99887766;
+    return v;
+}
+SessionConfig Config(uint32_t limit = PRE_HELLO_LIMIT) {
+    SessionConfig c;
+    c.network = Profile(limit);
+    c.local_version = Modern();
+    c.handshake_timeout_ms = 10000;
+    return c;
+}
+Bytes VersionBytes() {
+    Bytes b;
+    std::string e;
+    CHECK(EncodeVersion(Modern(), b, e));
+    return b;
+}
+Bytes HelloBytes(const NetworkProfile &p,
+                 uint64_t supported = MANDATORY_FEATURES,
+                 uint64_t required = MANDATORY_FEATURES) {
+    Hello h;
+    h.chain_id = p.chain_id;
+    h.genesis_id = p.genesis_id;
+    h.profile_digest = p.profile_digest;
+    h.receive_limit = p.receive_limit;
+    h.supported = supported;
+    h.required = required;
+    Bytes b;
+    std::string e;
+    CHECK(EncodeHello(h, b, e));
+    return b;
+}
+Bytes Frame(const Message &m) {
+    Bytes b;
+    std::string e;
+    auto p = Profile();
+    if (m.command == "version" || m.command == "v2hello" ||
+        m.command == "verack" || m.command == "sendaddrv2")
+        CHECK(EncodeHandshakeEnvelope(p, m, b, e));
+    else
+        CHECK(EncodeEnvelope(p, p.receive_limit, m, b, e));
+    return b;
+}
+Message Unframe(const Bytes &b) {
+    EnvelopeDecoder decoder(Profile());
+    size_t n;
+    Message m;
+    std::string e;
+    CHECK(decoder.Feed(b, n, m, e) == FeedStatus::MessageReady &&
+          n == b.size());
+    return m;
+}
+SessionEvent Send(Session &s, const Message &m, uint64_t time = 101) {
+    auto b = Frame(m);
+    size_t n;
+    auto event = s.Feed(b, time, n);
+    CHECK(n <= b.size());
+    return event;
+}
+void Activate(Session &s, uint32_t peer_limit = PRE_HELLO_LIMIT,
+              uint64_t supported = MANDATORY_FEATURES) {
+    CHECK(s.OnOpen(100).result == SessionResult::Send);
+    auto v = Send(s, {"version", VersionBytes()});
+    CHECK(v.result == SessionResult::Send);
+    auto h = Send(s, {"v2hello", HelloBytes(Profile(peer_limit), supported)});
+    CHECK(h.result == SessionResult::Send);
+    CHECK(Send(s, {"verack", {}}).result == SessionResult::Activated);
+    CHECK(s.State() == SessionState::Active);
+}
+void VersionVectors() {
+    // Literal independent wire assembly: fixed-width LE integers, BE ports,
+    // no CAddress time field, arbitrary raw user-agent bytes accepted.
+    const Bytes literal = Hex("81110100"
+                              "0807060504030201"
+                              "ffffffffffffffff"
+                              "0807060504030201"
+                              "000102030405060708090a0b0c0d0e0f"
+                              "1234"
+                              "1817161514131211"
+                              "101112131415161718191a1b1c1d1e1f"
+                              "abcd"
+                              "2827262524232221"
+                              "03616263"
+                              "feffffff"
+                              "02"
+                              "3837363534333231");
+    CHECK(literal.size() == 97);
+    VersionMessage decoded;
+    std::string e;
+    CHECK(DecodeVersion(literal, decoded, e));
+    CHECK(decoded.version == 70017 &&
+          decoded.services == 0x0102030405060708ULL);
+    CHECK(decoded.timestamp == 0 && decoded.receiver.port == 0x1234 &&
+          decoded.sender->address.port == 0xabcd);
+    CHECK(decoded.Nonce() == 0x2122232425262728ULL &&
+          decoded.ExtraEntropy() == 0x3132333435363738ULL);
+    CHECK(decoded.StartingHeight() == -2 && decoded.Relay() &&
+          decoded.Complete());
+    // Match upstream's exact optional cutoffs. Every partial group rejects.
+    for (size_t n = 0; n <= literal.size(); ++n) {
+        VersionMessage out;
+        out.version = 99999;
+        const bool valid =
+            n == 46 || n == 80 || n == 84 || n == 88 || n == 89 || n == 97;
+        CHECK(DecodeVersion(std::span(literal).first(n), out, e) == valid);
+        if (!valid) CHECK(out.version == 99999);
+    }
+    CHECK(DecodeVersion(std::span(literal).first(46), decoded, e));
+    CHECK(decoded.Nonce() == 1 && decoded.ExtraEntropy() == 1 &&
+          decoded.StartingHeight() == -1 && decoded.Relay() &&
+          !decoded.Complete());
+    auto wire = literal;
+    wire.push_back(0x99);
+    wire.push_back(0xff);
+    CHECK(DecodeVersion(wire, decoded, e) && decoded.ignored_suffix_bytes == 2);
+    wire.resize(PRE_HELLO_LIMIT, 0x91);
+    CHECK(DecodeVersion(wire, decoded, e) &&
+          decoded.ignored_suffix_bytes == PRE_HELLO_LIMIT - 97);
+    wire.push_back(0);
+    CHECK(!DecodeVersion(wire, decoded, e));
+    auto source = Modern();
+    source.services = 0x0102030405060708ULL;
+    source.timestamp = 0x01020304;
+    source.receiver.services = source.services;
+    source.receiver.port = 0x1234;
+    source.sender->address.services = 0x1112131415161718ULL;
+    source.sender->address.port = 0xabcd;
+    source.sender->nonce = 0x2122232425262728ULL;
+    source.starting_height = -2;
+    source.extra_entropy = 0x3132333435363738ULL;
+    for (size_t i = 0; i < 16; ++i) {
+        source.receiver.address[i] = uint8_t(i);
+        source.sender->address.address[i] = uint8_t(i + 16);
+    }
+    auto expected = literal;
+    std::fill(expected.begin() + 12, expected.begin() + 20, 0);
+    expected[12] = 4;
+    expected[13] = 3;
+    expected[14] = 2;
+    expected[15] = 1;
+    expected[88] = 1;
+    CHECK(EncodeVersion(source, wire, e) && wire == expected);
+    for (size_t length : {0U, 252U, 253U, 256U}) {
+        source.user_agent = Bytes(length, 0xff);
+        CHECK(EncodeVersion(source, wire, e));
+        CHECK(wire.size() == 93 + (length < 253 ? 1 : 3) + length);
+        CHECK(DecodeVersion(wire, decoded, e) &&
+              decoded.user_agent->size() == length);
+    }
+    source.user_agent = Bytes(257, 0);
+    CHECK(!EncodeVersion(source, wire, e));
+    wire = literal;
+    wire[80] = 253;
+    wire.insert(wire.begin() + 81, {3, 0});
+    CHECK(!DecodeVersion(wire, decoded, e));
+    wire = literal;
+    wire[80] = 253;
+    wire.insert(wire.begin() + 81, {1, 1});
+    CHECK(!DecodeVersion(wire, decoded, e));
+    wire = literal;
+    wire[0] = 0x80;
+    CHECK(!DecodeVersion(wire, decoded, e)); // 70016
+    source = Modern();
+    source.version = 70016;
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.sender.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.user_agent.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.starting_height.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+    source = Modern();
+    source.relay.reset();
+    CHECK(!EncodeVersion(source, wire, e));
+}
+void HandshakeAndDispatch() {
+    auto c = Config();
+    c.supported_features |= TRANSACTION_RELAY_FEATURE;
+    c.send_address_v2 = true;
+    Session s(c);
+    auto open = s.OnOpen(100);
+    CHECK(open.result == SessionResult::Send && open.outbound.size() == 1);
+    auto local = Unframe(open.outbound[0]);
+    VersionMessage version;
+    std::string e;
+    CHECK(local.command == "version" &&
+          DecodeVersion(local.payload, version, e) && version.Complete());
+    CHECK(version.services == 0 && version.receiver.services == 0 &&
+          version.sender->address.services == 0);
+    auto event = Send(s, {"version", VersionBytes()});
+    CHECK(event.result == SessionResult::Send && event.outbound.size() == 2);
+    CHECK(Unframe(event.outbound[0]).command == "v2hello" &&
+          Unframe(event.outbound[1]).command == "sendaddrv2");
+    CHECK(s.State() == SessionState::Handshaking && s.ActiveLimit() == 0);
+    // Duplicate version ignores even a malformed known payload, as upstream.
+    CHECK(Send(s, {"version", {0}}).result == SessionResult::Ignored);
+    CHECK(s.PeerVersion()->Nonce() == Modern().Nonce());
+    CHECK(Send(s, {"sendaddrv2", {}}).result == SessionResult::Ignored &&
+          s.PeerWantsAddressV2());
+    event = Send(s, {"v2hello", HelloBytes(c.network, c.supported_features)});
+    CHECK(event.result == SessionResult::Send && event.outbound.size() == 1 &&
+          Unframe(event.outbound[0]).command == "verack");
+    CHECK(s.State() == SessionState::Handshaking && s.ActiveLimit() == 0);
+    CHECK(Send(s, {"verack", {}}).result == SessionResult::Activated &&
+          s.State() == SessionState::Active);
+    CHECK(s.ActiveFeatures() == c.supported_features);
+    CHECK(Send(s, {"verack", {}}).result == SessionResult::Ignored);
+    CHECK(Send(s, {"version", {}}).result == SessionResult::Ignored);
+    for (const auto *command :
+         {"mempool", "filterload", "filteradd", "filterclear", "getcfheaders",
+          "avapoll", "feefilter", "unknown"})
+        CHECK(Send(s, {command, {1, 2, 3}}).result == SessionResult::Ignored);
+    for (const auto *command :
+         {"tx", "block", "headers", "cmpctblock", "blocktxn"}) {
+        event = Send(s, {command, {1}});
+        CHECK(event.result == SessionResult::Application && event.application &&
+              event.application->command == command &&
+              event.application->payload == Bytes{1});
+    }
+    // An application event is merely an envelope, never a validated object.
+    CHECK(Send(s, {"v2hello", HelloBytes(c.network)}).result ==
+              SessionResult::PeerRejected &&
+          s.State() == SessionState::Closed);
+    CHECK(s.OnClosed().result == SessionResult::Closed);
+}
+void TransactionRelayNegotiation() {
+    for (bool local_relay : {false, true}) {
+        for (bool peer_relay : {false, true}) {
+            auto c = Config();
+            if (local_relay) c.supported_features |= TRANSACTION_RELAY_FEATURE;
+            Session s(c);
+            const uint64_t peer_features =
+                MANDATORY_FEATURES |
+                (peer_relay ? TRANSACTION_RELAY_FEATURE : 0);
+            Activate(s, PRE_HELLO_LIMIT, peer_features);
+            CHECK(s.ActiveFeatures() == (c.supported_features & peer_features));
+            // Block envelopes remain available without transaction relay.
+            CHECK(Send(s, {"block", {1}}).result == SessionResult::Application);
+            auto tx = Send(s, {"tx", {1}});
+            if (local_relay && peer_relay) {
+                CHECK(tx.result == SessionResult::Application &&
+                      tx.application->command == "tx");
+            } else {
+                CHECK(tx.result == SessionResult::PeerRejected &&
+                      !tx.application && s.State() == SessionState::Closed);
+            }
+        }
+    }
+    const uint64_t relay_features =
+        MANDATORY_FEATURES | TRANSACTION_RELAY_FEATURE;
+    for (bool local_requires : {false, true}) {
+        auto c = Config();
+        if (local_requires) {
+            c.supported_features = relay_features;
+            c.required_features = relay_features;
+        }
+        Session s(c);
+        CHECK(s.OnOpen(100).result == SessionResult::Send);
+        CHECK(Send(s, {"version", VersionBytes()}).result ==
+              SessionResult::Send);
+        const uint64_t peer_features =
+            local_requires ? MANDATORY_FEATURES : relay_features;
+        CHECK(Send(s, {"v2hello",
+                       HelloBytes(c.network, peer_features, peer_features)})
+                  .result == SessionResult::PeerRejected);
+        CHECK(s.State() == SessionState::Closed && s.ActiveFeatures() == 0);
+    }
+    auto c = Config();
+    c.supported_features = c.required_features = relay_features;
+    Session required(c);
+    CHECK(required.OnOpen(100).result == SessionResult::Send);
+    CHECK(Send(required, {"version", VersionBytes()}).result ==
+          SessionResult::Send);
+    CHECK(Send(required, {"v2hello", HelloBytes(c.network, relay_features,
+                                                relay_features)})
+              .result == SessionResult::Send);
+    CHECK(Send(required, {"verack", {}}).result == SessionResult::Activated);
+    CHECK(required.ActiveFeatures() == relay_features);
+}
+void RejectOrderingAndIdentity() {
+    for (const auto *first :
+         {"v2hello", "verack", "sendaddrv2", "tx", "unknown"}) {
+        Session s(Config());
+        CHECK(s.OnOpen(100).result == SessionResult::Send);
+        Bytes payload;
+        if (std::string(first) == "v2hello") payload = HelloBytes(Profile());
+        CHECK(Send(s, {first, payload}).result == SessionResult::PeerRejected &&
+              s.State() == SessionState::Closed);
+    }
+    for (const auto *second : {"verack", "tx", "sendheaders", "unknown"}) {
+        Session s(Config());
+        s.OnOpen(100);
+        CHECK(Send(s, {"version", VersionBytes()}).result ==
+              SessionResult::Send);
+        CHECK(Send(s, {second, {}}).result == SessionResult::PeerRejected);
+    }
+    Session duplicate(Config());
+    duplicate.OnOpen(100);
+    Send(duplicate, {"version", VersionBytes()});
+    CHECK(Send(duplicate, {"v2hello", HelloBytes(Profile())}).result ==
+          SessionResult::Send);
+    CHECK(Send(duplicate, {"v2hello", HelloBytes(Profile())}).result ==
+          SessionResult::PeerRejected);
+    Session mismatch(Config());
+    mismatch.OnOpen(100);
+    Send(mismatch, {"version", VersionBytes()});
+    auto wrong = Profile();
+    wrong.genesis_id[0] ^= 1;
+    CHECK(Send(mismatch, {"v2hello", HelloBytes(wrong)}).result ==
+          SessionResult::PeerRejected);
+    Session unknown_features(Config());
+    unknown_features.OnOpen(100);
+    Send(unknown_features, {"version", VersionBytes()});
+    auto hello = HelloBytes(Profile());
+    hello[106] |= 8;
+    CHECK(Send(unknown_features, {"v2hello", hello}).result ==
+          SessionResult::PeerRejected);
+    Session obsolete(Config());
+    obsolete.OnOpen(100);
+    auto version = VersionBytes();
+    version[0] = 0x80;
+    CHECK(Send(obsolete, {"version", version}).result ==
+          SessionResult::PeerRejected);
+}
+void NonceTimeAndLocalErrors() {
+    auto c = Config();
+    c.inbound = true;
+    size_t calls = 0;
+    c.incoming_nonce_allowed = [&](uint64_t nonce) {
+        ++calls;
+        return nonce != Modern().Nonce();
+    };
+    Session self(c);
+    self.OnOpen(100);
+    CHECK(Send(self, {"version", VersionBytes()}).result ==
+              SessionResult::PeerRejected &&
+          calls == 1);
+    c.incoming_nonce_allowed = [&](uint64_t nonce) {
+        ++calls;
+        return nonce == Modern().Nonce();
+    };
+    Session inbound(c);
+    inbound.OnOpen(100);
+    CHECK(Send(inbound, {"version", VersionBytes()}).result ==
+          SessionResult::Send);
+    CHECK(Send(inbound, {"version", VersionBytes()}).result ==
+              SessionResult::Ignored &&
+          calls == 2);
+    c.incoming_nonce_allowed = [](uint64_t) -> bool {
+        throw std::runtime_error("operational");
+    };
+    Session callback(c);
+    callback.OnOpen(100);
+    CHECK(Send(callback, {"version", VersionBytes()}).result ==
+          SessionResult::LocalFailure);
+    c.incoming_nonce_allowed = {};
+    Session no_callback(c);
+    CHECK(no_callback.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.services = 1;
+    Session services(c);
+    CHECK(services.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.receiver.services = 1;
+    Session receiver(c);
+    CHECK(receiver.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.sender->address.services = 1;
+    Session sender(c);
+    CHECK(sender.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.local_version.extra_entropy.reset();
+    Session incomplete(c);
+    CHECK(incomplete.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    c.handshake_timeout_ms = 0;
+    Session zero(c);
+    CHECK(zero.OnOpen(100).result == SessionResult::LocalFailure);
+    c = Config();
+    Session overflow(c);
+    CHECK(overflow.OnOpen(UINT64_MAX - 5).result ==
+          SessionResult::LocalFailure);
+    Session deadline(Config());
+    deadline.OnOpen(100);
+    CHECK(Send(deadline, {"version", VersionBytes()}, 101).result ==
+          SessionResult::Send);
+    CHECK(Send(deadline, {"version", {}}, 10099).result ==
+          SessionResult::Ignored);
+    CHECK(deadline.OnTimer(10100).result == SessionResult::TimedOut);
+    Session final_deadline(Config());
+    final_deadline.OnOpen(100);
+    Send(final_deadline, {"version", VersionBytes()}, 101);
+    Send(final_deadline, {"v2hello", HelloBytes(Profile())}, 101);
+    CHECK(Send(final_deadline, {"verack", {}}, 10100).result ==
+          SessionResult::TimedOut);
+    Session backwards(Config());
+    backwards.OnOpen(100);
+    CHECK(backwards.OnTimer(99).result == SessionResult::LocalFailure);
+    Session not_open(Config());
+    size_t used = 99;
+    CHECK(not_open.Feed({}, 0, used).result == SessionResult::LocalFailure &&
+          used == 0);
+    Session twice(Config());
+    twice.OnOpen(100);
+    CHECK(twice.OnOpen(101).result == SessionResult::LocalFailure);
+    Session active(Config());
+    Activate(active);
+    CHECK(active.OnTimer(999999).result == SessionResult::Idle &&
+          active.State() == SessionState::Active);
+}
+void SentinelAndControlMessages() {
+    auto c = Config();
+    c.inbound = true;
+    uint64_t observed = 0;
+    c.incoming_nonce_allowed = [&](uint64_t nonce) {
+        observed = nonce;
+        return nonce != 1;
+    };
+    Session absent_nonce(c);
+    absent_nonce.OnOpen(100);
+    auto minimal = VersionBytes();
+    minimal.resize(46);
+    CHECK(Send(absent_nonce, {"version", minimal}).result ==
+          SessionResult::PeerRejected);
+    CHECK(observed == 1); // inherited missing-group sentinel reaches checker
+    auto nonempty_control = [&](const std::string &command) {
+        // Build a checksum-valid frame bypassing the *encoder's* empty-command
+        // guard, so the session's receive path exercises the same bound.
+        auto bytes = Frame({"unknown", {1}});
+        std::fill(bytes.begin() + 4, bytes.begin() + 16, 0);
+        std::copy(command.begin(), command.end(), bytes.begin() + 4);
+        return bytes;
+    };
+    Session verack(Config());
+    Activate(verack);
+    size_t used;
+    auto bytes = nonempty_control("verack");
+    CHECK(verack.Feed(bytes, 101, used).result == SessionResult::PeerRejected &&
+          used == 24);
+    Session address(Config());
+    address.OnOpen(100);
+    Send(address, {"version", VersionBytes()});
+    bytes = nonempty_control("sendaddrv2");
+    CHECK(address.Feed(bytes, 101, used).result ==
+              SessionResult::PeerRejected &&
+          used == 24);
+    Session suffix(Config());
+    suffix.OnOpen(100);
+    auto extended = VersionBytes();
+    extended.resize(PRE_HELLO_LIMIT, 0x91);
+    CHECK(Send(suffix, {"version", extended}).result == SessionResult::Send);
+    CHECK(suffix.PeerVersion()->ignored_suffix_bytes ==
+          PRE_HELLO_LIMIT - VersionBytes().size());
+}
+void TwoSessionExchange() {
+    auto a_config = Config();
+    a_config.local_version.sender->nonce = 11;
+    a_config.local_version.relay = false;
+    auto b_config = Config();
+    b_config.local_version.sender->nonce = 22;
+    b_config.inbound = true;
+    b_config.send_address_v2 = true;
+    size_t nonce_checks = 0;
+    b_config.incoming_nonce_allowed = [&](uint64_t nonce) {
+        ++nonce_checks;
+        return nonce != 22;
+    };
+    Session a(a_config), b(b_config);
+    struct Delivery {
+        Session *receiver;
+        Bytes bytes;
+    };
+    std::vector<Delivery> queue;
+    for (auto &wire : a.OnOpen(100).outbound)
+        queue.push_back({&b, std::move(wire)});
+    for (auto &wire : b.OnOpen(100).outbound)
+        queue.push_back({&a, std::move(wire)});
+    size_t index = 0;
+    while (index < queue.size()) {
+        CHECK(queue.size() <= 10);
+        Delivery delivery = std::move(queue[index++]);
+        size_t used;
+        auto event = delivery.receiver->Feed(delivery.bytes, 101, used);
+        CHECK(used == delivery.bytes.size());
+        CHECK(event.result == SessionResult::Send ||
+              event.result == SessionResult::Ignored ||
+              event.result == SessionResult::Activated);
+        for (auto &wire : event.outbound)
+            queue.push_back(
+                {delivery.receiver == &a ? &b : &a, std::move(wire)});
+    }
+    CHECK(a.State() == SessionState::Active &&
+          b.State() == SessionState::Active);
+    CHECK(nonce_checks == 1 && a.PeerWantsAddressV2() &&
+          !b.PeerVersion()->Relay());
+    CHECK(a.PeerVersion()->services == 0 && b.PeerVersion()->services == 0);
+}
+void SplitAndCoalescedLimits() {
+    auto version = Frame({"version", VersionBytes()});
+    for (size_t split = 0; split <= version.size(); ++split) {
+        Session s(Config());
+        s.OnOpen(100);
+        size_t used;
+        auto event = s.Feed(std::span(version).first(split), 101, used);
+        CHECK(used == split);
+        if (split < version.size()) {
+            CHECK(event.result == SessionResult::Idle);
+            event = s.Feed(std::span(version).subspan(split), 101, used);
+            CHECK(used == version.size() - split);
+        }
+        CHECK(event.result == SessionResult::Send);
+    }
+    for (uint32_t limit : {1U, 117U, 118U}) {
+        auto c = Config(limit);
+        c.supported_features |= TRANSACTION_RELAY_FEATURE;
+        Session s(c);
+        CHECK(s.OnOpen(100).result == SessionResult::Send);
+        CHECK(Send(s, {"version", VersionBytes()}).result ==
+              SessionResult::Send);
+        CHECK(Send(s, {"v2hello",
+                       HelloBytes(Profile(limit), c.supported_features)})
+                  .result == SessionResult::Send);
+        auto verack = Frame({"verack", {}});
+        auto app = Frame({"tx", Bytes(limit + 1, 0)});
+        Bytes coalesced = verack;
+        coalesced.insert(coalesced.end(), app.begin(), app.end());
+        size_t used;
+        CHECK(s.Feed(coalesced, 101, used).result == SessionResult::Activated &&
+              used == verack.size() && s.ActiveLimit() == limit);
+        auto result = s.Feed(std::span(coalesced).subspan(used), 101, used);
+        CHECK(result.result == SessionResult::PeerRejected && used == 24);
+        Session exact(c);
+        Activate(exact, limit, c.supported_features);
+        auto event = Send(exact, {"tx", Bytes(limit, 0)});
+        CHECK(event.result == SessionResult::Application &&
+              event.application->payload.size() == limit);
+    }
+    Session asymmetric(Config(118));
+    Activate(asymmetric, 117);
+    CHECK(asymmetric.ActiveLimit() == 117);
+    Session partial(Config());
+    partial.OnOpen(100);
+    size_t used;
+    CHECK(partial.Feed(std::span(version).first(1), 101, used).result ==
+          SessionResult::Idle);
+    CHECK(partial.OnTimer(10100).result == SessionResult::TimedOut);
+}
+} // namespace
+int main() {
+    VersionVectors();
+    HandshakeAndDispatch();
+    TransactionRelayNegotiation();
+    RejectOrderingAndIdentity();
+    NonceTimeAndLocalErrors();
+    SplitAndCoalescedLimits();
+    SentinelAndControlMessages();
+    TwoSessionExchange();
+    std::cout
+        << "V2 inherited version codec and socket-free session checks pass\n";
+}
diff --git a/src/lotus_v2/test_peer_tcp.cpp b/src/lotus_v2/test_peer_tcp.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6fd6eb48864764244dec0cbec72ed45917de7e36
--- /dev/null
+++ b/src/lotus_v2/test_peer_tcp.cpp
@@ -0,0 +1,184 @@
+// Copyright (c) 2026 The Lotus developers
+// Actual loopback ephemeral-port tests. No daemon, chain data or network profile.
+#include "peer_tcp.h"
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <fcntl.h>
+#include <iostream>
+#include <stdexcept>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+using namespace lotus::v2;
+using namespace lotus::v2::peer;
+#define CHECK(c) do { if (!(c)) throw std::runtime_error("line " + std::to_string(__LINE__) + ": " #c); } while (false)
+namespace {
+template <typename F> void Until(F f) {
+    for (unsigned i = 0; i < 1000; ++i) { if (f()) return; std::this_thread::sleep_for(std::chrono::milliseconds(1)); }
+    throw std::runtime_error("bounded loopback wait expired");
+}
+TcpEndpoint Loopback(const char *text = "127.0.0.1") {
+    TcpEndpoint endpoint; CHECK(ParseNumericEndpoint(text, 0, 0, endpoint)); return endpoint;
+}
+struct Pair {
+    TcpListener listener;
+    TcpStream client, server;
+    TcpEndpoint endpoint;
+    explicit Pair(const char *text = "127.0.0.1") {
+        auto requested = Loopback(text);
+        CHECK(listener.Listen(requested, {4, requested.family == TcpFamily::IPv6}));
+        CHECK(listener.BoundEndpoint(endpoint) && endpoint.port && endpoint.port != 10604 && endpoint.port != 10605 && endpoint.port != 8331);
+        const auto status = client.BeginConnect(endpoint, 10, 1000);
+        CHECK(status == TcpConnectStatus::Pending || status == TcpConnectStatus::Connected);
+        TcpEndpoint remote;
+        Until([&] {
+            const auto connected = client.PollConnect(10);
+            CHECK(connected != TcpConnectStatus::Error && connected != TcpConnectStatus::TimedOut);
+            if (!server.IsOpen()) {
+                const auto accepted = listener.Accept(server, remote);
+                CHECK(accepted != TcpAcceptStatus::Error);
+            }
+            return client.IsConnected() && server.IsConnected();
+        });
+        CHECK(remote.family == requested.family && remote.port);
+    }
+};
+void NumericAndLifecycle() {
+    auto endpoint = Loopback(); const auto unchanged = endpoint;
+    CHECK(!ParseNumericEndpoint("localhost", 1, 0, endpoint) && endpoint == unchanged);
+    CHECK(!ParseNumericEndpoint(std::string_view("127.0.0.1\0x", 11), 1, 0, endpoint));
+    CHECK(!ParseNumericEndpoint("127.0.0.1", 1, 9, endpoint));
+    TcpListener listener;
+    CHECK(!listener.Listen({}, {1, false}) && !listener.IsOpen());
+    CHECK(!listener.Listen(endpoint, {0, false}));
+    CHECK(listener.Listen(endpoint, {1, false}));
+    const int fd = listener.NativeHandle();
+    CHECK((fcntl(fd, F_GETFL) & O_NONBLOCK) && (fcntl(fd, F_GETFD) & FD_CLOEXEC));
+    CHECK(!listener.Listen(endpoint, {1, false}) && listener.NativeHandle() == fd);
+    TcpEndpoint bound; CHECK(listener.BoundEndpoint(bound));
+    TcpListener conflict;
+    CHECK(!conflict.Listen(bound, {1, false}) && !conflict.IsOpen() && conflict.LastError() == EADDRINUSE);
+    TcpStream out; TcpEndpoint remote = unchanged;
+    CHECK(listener.Accept(out, remote) == TcpAcceptStatus::WouldBlock && !out.IsOpen() && remote == unchanged);
+    TcpListener moved(std::move(listener)); CHECK(!listener.IsOpen() && moved.NativeHandle() == fd);
+    moved.Close(); moved.Close(); CHECK(fcntl(fd, F_GETFD) == -1 && errno == EBADF);
+    TcpStream invalid;
+    CHECK(invalid.BeginConnect(endpoint, 0, 1) == TcpConnectStatus::Error && !invalid.IsOpen()); // port0
+    endpoint.port = 1;
+    CHECK(invalid.BeginConnect(endpoint, UINT64_MAX, 1) == TcpConnectStatus::Error && !invalid.IsOpen());
+    CHECK(invalid.BeginConnect(endpoint, 1, 0) == TcpConnectStatus::Error && !invalid.IsOpen());
+}
+void IoAndMoves(const char *address) {
+    Pair pair(address);
+    std::array<uint8_t, 5> buffer{};
+    CHECK(pair.server.Read(buffer).status == StreamStatus::WouldBlock);
+    CHECK(pair.server.Read({}).status == StreamStatus::Error);
+    CHECK(pair.client.Write({}).status == StreamStatus::Error);
+    const Bytes payload{1, 2, 3, 4, 5}; size_t sent{}, received{};
+    Until([&] {
+        if (sent < payload.size()) { auto r = pair.client.Write(std::span(payload).subspan(sent));
+            CHECK(r.status == StreamStatus::Progress || r.status == StreamStatus::WouldBlock); sent += r.count; }
+        if (received < buffer.size()) { auto r = pair.server.Read(std::span(buffer).subspan(received));
+            CHECK(r.status == StreamStatus::Progress || r.status == StreamStatus::WouldBlock); received += r.count; }
+        return received == payload.size();
+    });
+    CHECK(std::equal(buffer.begin(), buffer.end(), payload.begin()));
+    const int fd = pair.client.NativeHandle();
+    CHECK((fcntl(fd, F_GETFL) & O_NONBLOCK) && (fcntl(fd, F_GETFD) & FD_CLOEXEC));
+    CHECK((fcntl(pair.server.NativeHandle(), F_GETFL) & O_NONBLOCK) &&
+          (fcntl(pair.server.NativeHandle(), F_GETFD) & FD_CLOEXEC));
+    CHECK(pair.client.BeginConnect(pair.endpoint, 20, 100) == TcpConnectStatus::Error && pair.client.NativeHandle() == fd);
+    TcpEndpoint remote = Loopback(); const auto saved = remote;
+    const int server_fd = pair.server.NativeHandle(), server_error = pair.server.LastError();
+    CHECK(pair.listener.Accept(pair.server, remote) == TcpAcceptStatus::Error && remote == saved &&
+          pair.server.NativeHandle() == server_fd && pair.server.LastError() == server_error);
+    TcpStream moved(std::move(pair.client)); CHECK(!pair.client.IsOpen() && moved.NativeHandle() == fd);
+    CHECK(moved.PollReadiness(false, true).writable);
+    moved.Close(); moved.Close(); CHECK(fcntl(fd, F_GETFD) == -1 && errno == EBADF);
+    const int reused = fcntl(pair.server.NativeHandle(), F_DUPFD, fd);
+    CHECK(reused == fd); // This test owns the duplicated descriptor.
+    moved.Close(); pair.client.Close();
+    CHECK(fcntl(reused, F_GETFD) >= 0); // stale owners cannot close reused fd
+    CHECK(::close(reused) == 0);
+    Until([&] { const auto r = pair.server.Read(buffer); CHECK(r.status != StreamStatus::Error); return r.status == StreamStatus::Eof; });
+    pair.server.Close();
+}
+void BackpressureAndSigpipe() {
+    Pair pair;
+    const int small = 4096;
+    CHECK(setsockopt(pair.client.NativeHandle(), SOL_SOCKET, SO_SNDBUF, &small, sizeof(small)) == 0);
+    CHECK(setsockopt(pair.server.NativeHandle(), SOL_SOCKET, SO_RCVBUF, &small, sizeof(small)) == 0);
+    const Bytes chunk(65536, 17); bool blocked{}; size_t bytes{};
+    for (unsigned i = 0; i < 1024; ++i) {
+        const auto r = pair.client.Write(chunk);
+        CHECK(r.status == StreamStatus::Progress || r.status == StreamStatus::WouldBlock);
+        bytes += r.count;
+        if (r.status == StreamStatus::WouldBlock) { blocked = true; break; }
+    }
+    CHECK(blocked && bytes > 0 && bytes <= 1024 * chunk.size());
+    // Explicit reset exercises write-after-close without installing a process
+    // SIGPIPE handler. Survival plus Error is the per-socket suppression check.
+    linger reset{1, 0}; CHECK(setsockopt(pair.server.NativeHandle(), SOL_SOCKET, SO_LINGER, &reset, sizeof(reset)) == 0);
+    pair.server.Close();
+    bool failed{};
+    Until([&] { const auto r = pair.client.Write(chunk); failed = r.status == StreamStatus::Error; return failed; });
+    CHECK(failed);
+    Until([&] { const auto r = pair.client.Write(chunk);
+        CHECK(r.status == StreamStatus::Error || r.status == StreamStatus::WouldBlock);
+        return r.status == StreamStatus::Error && pair.client.LastError() == EPIPE;
+    }); // EPIPE specifically exercises the normally signal-generating path.
+}
+void DeadlineAndRefusal() {
+    TcpListener listener; CHECK(listener.Listen(Loopback(), {1, false})); TcpEndpoint endpoint;
+    CHECK(listener.BoundEndpoint(endpoint));
+    TcpStream timeout; const auto start = timeout.BeginConnect(endpoint, 10, 20);
+    CHECK(start == TcpConnectStatus::Connected || start == TcpConnectStatus::Pending);
+    if (start == TcpConnectStatus::Pending) CHECK(timeout.PollConnect(30) == TcpConnectStatus::TimedOut && !timeout.IsOpen());
+    timeout.Close();
+    TcpStream backwards; const auto rollback = backwards.BeginConnect(endpoint, 10, 20);
+    if (rollback == TcpConnectStatus::Pending) CHECK(backwards.PollConnect(9) == TcpConnectStatus::Error && !backwards.IsOpen());
+    backwards.Close(); listener.Close();
+    TcpStream refused; auto result = refused.BeginConnect(endpoint, 10, 100);
+    if (result == TcpConnectStatus::Pending) Until([&] { result = refused.PollConnect(10); return result != TcpConnectStatus::Pending; });
+    CHECK(result == TcpConnectStatus::Error && !refused.IsOpen());
+}
+SessionConfig Config(uint64_t nonce) {
+    SessionConfig c{}; c.network.magic = {17, 29, 41, 53}; // synthetic explicit fixture
+    c.network.chain_id[0] = 7; c.network.genesis_id[0] = 8; c.network.profile_digest[0] = 9;
+    c.network.receive_limit = 4096; c.network.transaction = {32, 32, 8, 8192, 16, 8192, 64};
+    c.network.max_reconstruction_transactions = 100; c.network.max_reconstruction_bytes = 8192;
+    c.local_version.sender = VersionSender{VersionAddress{}, nonce}; c.local_version.user_agent = Bytes{'t'};
+    c.local_version.starting_height = 0; c.local_version.relay = true; c.local_version.extra_entropy = nonce + 1;
+    c.handshake_timeout_ms = 1000; return c;
+}
+void TransportHandshake() {
+    Pair pair;
+    Transport left(pair.client, Config(42), {31, 8192, 16, 1000, 1000});
+    Transport right(pair.server, Config(43), {29, 8192, 16, 1000, 1000});
+    CHECK(left.Open(10) && right.Open(10)); bool activated_left{}, activated_right{};
+    Until([&] {
+        CHECK(left.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        CHECK(right.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        if (auto e = left.TakeEvent()) { CHECK(e->result == SessionResult::Activated); activated_left = true; }
+        if (auto e = right.TakeEvent()) { CHECK(e->result == SessionResult::Activated); activated_right = true; }
+        return activated_left && activated_right;
+    });
+    CHECK(left.QueueMessage({"ping", {7, 8, 9}}, 10) == QueueResult::Queued);
+    bool application{};
+    Until([&] {
+        CHECK(left.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        CHECK(right.Poll(10, {8, 64, 64}).closed == TransportClose::None);
+        if (auto e = right.TakeEvent()) { CHECK(e->application && e->application->command == "ping" && e->application->payload == Bytes({7,8,9})); application = true; }
+        return application;
+    });
+    CHECK(left.Close());
+    Until([&] { return right.Poll(10, {8, 64, 64}).closed == TransportClose::EndOfStream; });
+    CHECK(!pair.client.IsOpen() && !pair.server.IsOpen());
+}
+} // namespace
+int main() {
+    try { NumericAndLifecycle(); IoAndMoves("127.0.0.1"); IoAndMoves("::1"); BackpressureAndSigpipe(); DeadlineAndRefusal(); TransportHandshake();
+        std::cout << "nonblocking localhost TCP tests passed\n";
+    } catch (const std::exception &e) { std::cerr << e.what() << '\n'; return 1; }
+}
