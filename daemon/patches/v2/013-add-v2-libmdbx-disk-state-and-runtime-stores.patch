+    l.tombstones_per_peer = 16;
+    l.tombstones_global = 32;
+    l.deferred_jobs_global = 8;
+    l.cache_candidates = 64;
+    l.cache_bytes = 1 << 20;
+    l.staging_bytes_per_peer = 32 << 20;
+    l.staging_bytes_global = 64 << 20;
+    l.transaction_slots_per_peer = 8192;
+    l.transaction_slots_global = 16384;
+    l.request_timeout_ms = 200;
+    l.deferred_timeout_ms = 1000;
+    l.retry_interval_ms = 10;
+    l.lifecycle_timeout_ms = 5000;
+    return c;
+}
+DispatcherConfig DispatcherSettings(const NetworkProfile &p) {
+    DispatcherConfig c{};
+    c.network = p;
+    c.initial_fetch_epoch = 1;
+    auto &l = c.limits;
+    l.max_peers = 2;
+    l.max_notices = 128;
+    l.max_inventory_items = 16;
+    l.max_header_items = 2;
