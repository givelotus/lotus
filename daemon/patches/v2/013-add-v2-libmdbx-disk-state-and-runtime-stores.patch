+  CHECK(replacement_records.Reconcile(old_record,false,error));
+  size_t block_batch_commits=0;
+  CHECK(cooldown.ApplyProofVotes(conflicting_batch,100000,[&](std::string &){++block_batch_commits;return true;},error));
+  CHECK(block_batch_commits==1); CHECK(cooldown.Vote(replacement.proof->getId())==3);
+  CHECK(cooldown.Vote(envelope.proof->getId())==uint32_t(-1));
+  CHECK(cooldown.ApplyProofVote(replacement.proof->getId(),Status::Accepted,100001,error));
+  CHECK(!replacement_records.Reconcile(new_record,true,error)); CHECK(error=="vote-record-capacity");
+  replacement_records.PruneProofs(cooldown);
+  CHECK(replacement_records.Reconcile(new_record,true,error));
+  snapshot.height=3000;
+  auto bad_profile=profile; bad_profile.min_quorum_stake=MAX_MONEY+SATOSHI;
+  bool invalid_constructor=false; try { Quorum invalid(bad_profile); } catch(const std::invalid_argument &) { invalid_constructor=true; } CHECK(invalid_constructor);
+  auto delegation=::avalanche::DelegationBuilder(*envelope.proof).build();
+  ConnectionTranscript transcript{1,2,3,4}; SchnorrSig hello;
+  CHECK(key.SignSchnorr(HelloDigest(delegation,transcript),hello));
+  for(int i=0;i<8;++i) { CHECK(quorum.Bind(i,delegation,hello,transcript,16,error)); quorum.SentProofInventory(i,snapshot); }
+  CHECK(quorum.Established(snapshot));
+  PollItem block{ItemKind::Block,{}}; block.id[0]=42;
+  PollItem proof{ItemKind::Proof,{}}; std::copy(envelope.proof->getId().begin(),envelope.proof->getId().end(),proof.id.begin());
+  CHECK(engine.Reconcile(block,true,error)); CHECK(engine.Reconcile(proof,true,error));
+  OutgoingPoll poll; CHECK(engine.Next(quorum,snapshot,0,poll,error)); CHECK(poll.items.size()==2);
+  SignedResponse response;
+  ObserveBlock observe=[](const lotus::v2::Hash &,BlockObservation &state,std::string &){state.known=true;state.valid=true;state.active=true;return true;};
+  CHECK(engine.Respond(poll,observe,quorum,key,response,error));
+  auto bad=response; bad.signature[0]^=1;
+  ApplyBlockUpdates apply=[&](const std::vector<BlockUpdate> &updates,std::string &){ for(const auto &update:updates) if(update.expected_tip!=snapshot.tip || update.expected_generation!=snapshot.generation) return false; return true; };
+  CHECK(!engine.Receive(quorum,poll.node,bad,snapshot,1,wall_seconds,apply,error));
+  CHECK(engine.Receive(quorum,poll.node,response,snapshot,1,wall_seconds,apply,error));
+  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,2,wall_seconds,apply,error));
+  // A signed malformed response consumes the query and releases every slot.
+  CHECK(engine.Next(quorum,snapshot,102,poll,error));
+  response.response=::avalanche::Response(poll.round,100,{}); CHECK(key.SignSchnorr(ResponseDigest(response.response),response.signature));
+  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,103,wall_seconds,apply,error)); CHECK(error=="invalid-ava-response-size");
+  CHECK(!engine.Receive(quorum,poll.node,response,snapshot,104,wall_seconds,apply,error)); CHECK(error=="unexpected-ava-response");
+  // A real query expiry followed by a valid signed late response must not
+  // disconnect its healthy node or advance the native vote confidence.
+  PollEngine delayed(profile);CHECK(delayed.Reconcile(block,true,error));
+  OutgoingPoll expired;CHECK(delayed.Next(quorum,snapshot,300,expired,error));
+  SignedResponse late;CHECK(delayed.Respond(expired,observe,quorum,key,late,error));
+  const auto confidence_before=delayed.Confidence(block);CHECK(confidence_before && *confidence_before==0);
+  OutgoingPoll current;CHECK(delayed.Next(quorum,snapshot,10301,current,error));
+  size_t late_applies=0;ApplyBlockUpdates late_apply=[&](const auto &,std::string &){++late_applies;return true;};
+  CHECK(delayed.ReceiveResponse(quorum,expired.node,late,snapshot,10302,wall_seconds,late_apply,error)==PollReceiveResult::Ignored);
+  CHECK(error=="unexpected-ava-response" && !late_applies && delayed.Confidence(block)==confidence_before && quorum.Node(expired.node));
+  CHECK(delayed.ReceiveResponse(quorum,expired.node,late,snapshot,10303,wall_seconds,late_apply,error)==PollReceiveResult::Ignored);
+  auto forged_late=late;forged_late.signature[0]^=1;
+  CHECK(delayed.ReceiveResponse(quorum,expired.node,forged_late,snapshot,10304,wall_seconds,late_apply,error)==PollReceiveResult::Rejected);
+  CHECK(delayed.Confidence(block)==confidence_before);
+  SignedResponse mismatch_response;CHECK(delayed.Respond(current,observe,quorum,key,mismatch_response,error));
+  auto wrong_votes=mismatch_response.response.GetVotes();wrong_votes[0]=::avalanche::Vote(0,uint256::ONE);
+  mismatch_response.response=::avalanche::Response(current.round,100,std::move(wrong_votes));CHECK(key.SignSchnorr(ResponseDigest(mismatch_response.response),mismatch_response.signature));
+  CHECK(delayed.ReceiveResponse(quorum,current.node,mismatch_response,snapshot,10305,wall_seconds,late_apply,error)==PollReceiveResult::Rejected);
+  CHECK(error=="invalid-ava-response-content" && !late_applies && delayed.Confidence(block)==confidence_before);
+  const auto delayed_stats=delayed.Diagnostics();
+  CHECK(delayed_stats.queries_created==2 && delayed_stats.queries_expired==1 && delayed_stats.responses_matched==1);
+  CHECK(delayed_stats.responses_applied==0 && delayed_stats.responses_ignored==2 && delayed_stats.responses_rejected==2 && delayed_stats.responses_local_failure==0);
+  CHECK(delayed_stats.live_queries==0 && delayed_stats.live_records==1 && delayed.Diagnostics()==delayed_stats && delayed.Confidence(block)==confidence_before);
+  CHECK(quorum.Node(expired.node) && delayed.Next(quorum,snapshot,10406,current,error));
+  const auto queued_stats=delayed.Diagnostics();CHECK(queued_stats.queries_created==3 && queued_stats.live_queries==1);
+  delayed.Disconnect(current.node);const auto cancelled_stats=delayed.Diagnostics();CHECK(cancelled_stats.queries_cancelled==1 && cancelled_stats.live_queries==0);
+  CHECK(cancelled_stats.queries_created==cancelled_stats.responses_matched+cancelled_stats.queries_expired+cancelled_stats.queries_cancelled+cancelled_stats.live_queries);
+  // Real upstream VoteRecord must finalize only after sustained diverse votes.
+  size_t finalized=0;
+  ApplyBlockUpdates finalize=[&](const std::vector<BlockUpdate> &updates,std::string &){
+   for(const auto &update:updates) {
+   CHECK(update.expected_tip==snapshot.tip); CHECK(update.expected_generation==snapshot.generation);
+   if(update.status==Status::Finalized) ++finalized; } return true;
+  };
+  for(int64_t now=1000;now<1000000 && (finalized==0 || !quorum.ExportPeers().front().finalized);now+=101) {
+   engine.PruneProofs(quorum); // Repeated proof cleanup preserves the block confidence.
+   if(!engine.Next(quorum,snapshot,now,poll,error)) continue;
+   CHECK(engine.Respond(poll,observe,quorum,key,response,error));
+   CHECK(engine.Receive(quorum,poll.node,response,snapshot,now+1,wall_seconds,finalize,error));
+  }
+  CHECK(finalized==1); CHECK(!engine.Reconcile(block,true,error));
+  auto finalized_peers=quorum.ExportPeers(); CHECK(finalized_peers.size()==1); CHECK(finalized_peers.front().finalized);
+  // Query clocks near zero must never become proof replacement wall times.
+  CHECK(finalized_peers.front().next_conflict_time==wall_seconds+int64_t(profile.peer_replacement_cooldown_seconds));
+  PollEngine transactional(profile); PollItem second=block; second.id[0]++;
+  CHECK(transactional.Reconcile(block,true,error)); CHECK(transactional.Reconcile(second,true,error));
+  bool rejected_final=false; size_t batch_finalized=0;
+  ApplyBlockUpdates atomic=[&](const std::vector<BlockUpdate> &updates,std::string &){
+   size_t finals=0; for(const auto &update:updates) { CHECK(update.expected_tip==snapshot.tip); CHECK(update.expected_generation==snapshot.generation); finals+=update.status==Status::Finalized; }
+   if(finals && !rejected_final) { rejected_final=true; return false; }
+   batch_finalized+=finals; return true;
+  };
+  for(int64_t now=1000000;now<2000000 && batch_finalized<2;now+=101) {
+   if(!transactional.Next(quorum,snapshot,now,poll,error)) continue;
+   CHECK(transactional.Respond(poll,observe,quorum,key,response,error));
+   const auto result=transactional.ReceiveResponse(quorum,poll.node,response,snapshot,now+1,wall_seconds,atomic,error);
+   CHECK(result==PollReceiveResult::Applied || (result==PollReceiveResult::LocalFailure && rejected_final));
+  }
+  CHECK(rejected_final); CHECK(batch_finalized==2); CHECK(transactional.Diagnostics().responses_local_failure==1 && transactional.Diagnostics().responses_applied>0);
+  // Ten inflight polls per inventory item, independently of peer capacity.
+  for(int i=8;i<20;++i) { CHECK(quorum.Bind(i,delegation,hello,transcript,16,error)); }
+  PollEngine bounded(profile); CHECK(bounded.Reconcile(block,true,error));
+  for(int i=0;i<10;++i) CHECK(bounded.Next(quorum,snapshot,2000000,poll,error));
+  CHECK(!bounded.Next(quorum,snapshot,2000000,poll,error));
+  CHECK(bounded.Next(quorum,snapshot,2010001,poll,error));
+  for(int i=7;i<20;++i) quorum.Disconnect(i);
+  CHECK(!quorum.Established(snapshot));
+  CHECK(engine.Respond(poll,observe,quorum,key,response,error));
+  for(const auto &vote:response.response.GetVotes()) CHECK(vote.GetError()==uint32_t(-1));
+  coin.output.value--; CHECK(quorum.Revalidate(snapshot,lookup,0,read,error)); CHECK(!quorum.Select(1000));
+  std::cout<<"native Avalanche admission, quorum, typed polls, authentication and release checks passed\n";
+ } catch(const std::exception &e) { std::cerr<<e.what()<<'\n'; ECC_Stop(); return 1; }
+ ECC_Stop(); return 0;
+}
diff --git a/src/lotus_v2/test_block.cpp b/src/lotus_v2/test_block.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..25614cb8db2ee21f89cfefe6a2643abff04f43d7
--- /dev/null
+++ b/src/lotus_v2/test_block.cpp
@@ -0,0 +1,453 @@
+// Copyright (c) 2026 The Lotus developers
+// Standalone ordinary-block model. This does not connect a block in lotusd.
+#include "block.h"
+
+#include "commitment.h"
+#include "signing.h"
+
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+std::string Hex(const uint8_t *data, size_t size) {
+    static const char *digits = "0123456789abcdef";
+    std::string out(size * 2, '0');
+    for (size_t i = 0; i < size; ++i) {
+        out[2 * i] = digits[data[i] >> 4];
+        out[2 * i + 1] = digits[data[i] & 0xf];
+    }
+    return out;
+}
+std::string HexHash(const Hash &hash) { return Hex(hash.data(), hash.size()); }
+
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+const MonetaryProfile kMonetary{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000, 200, Hash{9}};
+
+OrdinaryCandidateProfile MakeProfile(VmCostUnits block_cap) {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, 100, 50000, 2, 3, block_cap};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+Hash Chain() {
+    Hash chain{};
+    for (size_t i = 0; i < chain.size(); ++i) chain[i] = static_cast<uint8_t>(i);
+    return chain;
+}
+
+MonetaryState InitialMoney() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Coin MakeFunding(uint8_t tag, uint32_t index, uint64_t value, const Hash &branch) {
+    Coin coin;
+    coin.outpoint.tx_id[0] = tag;
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = value;
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = 90;
+    coin.creation_parent_mtp = 49000;
+    coin.coinbase = false;
+    return coin;
+}
+
+Transaction Payment(const Outpoint &spent, uint64_t value) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{TRUE_SCRIPT, {}, {}}};
+    tx.inputs.push_back(input);
+    Output output;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    tx.outputs.push_back(output);
+    return tx;
+}
+
+struct World {
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary = InitialMoney();
+    OrdinaryParentContext parent;
+    Hash branch = BranchLeaf(TRUE_SCRIPT);
+    Coin funding;
+    Coin other;
+    World() : funding(MakeFunding(0x71, 3, 20000, branch)),
+              other(MakeFunding(0x72, 1, 8000, branch)) {
+        Check(view.emplace(funding.outpoint, funding).second &&
+                  view.emplace(other.outpoint, other).second &&
+                  utxo.Insert(funding) && utxo.Insert(other),
+              "parent coins");
+        parent.chain_id = Chain();
+        parent.monetary = monetary;
+        parent.header.height = 99;
+        parent.header.time = 50000;
+        parent.header.version = 1;
+        parent.header.size = HEADER_SIZE;
+        parent.header.state_root =
+            StateRoot(parent.chain_id, parent.header.height, utxo.Root(), monetary);
+    }
+};
+
+struct Built {
+    Transaction first;
+    Transaction second;
+    Transaction third;
+    VmCostUnits one_cost{};
+    OrdinaryCandidateProfile profile;
+};
+
+Built BuildPayments(World &world) {
+    Built built;
+    built.first = Payment(world.funding.outpoint, 15000);
+    auto wide = MakeProfile(1000000);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(built.first, wide, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure first payment: " + error);
+    // OP_1 charges a 16-byte numeric result plus one structural byte.
+    Check(effects.invocation_cost == 18 && effects.native_fee == 5000,
+          "unexpected first payment cost or fee");
+    built.one_cost = effects.invocation_cost;
+    built.profile = MakeProfile(built.one_cost * 2);
+    IdentityDigests first_id;
+    Check(ComputeIdentities(built.first, built.profile.transaction,
+                            world.parent.chain_id, first_id, error),
+          "first identity");
+    built.second = Payment(Outpoint{first_id.txid, 0}, 10000);
+    Check(CheckOrdinaryCandidate(built.second, wide, world.parent.chain_id,
+                                 world.view, effects, error) == false,
+          "second must be unspendable until the first is connected");
+    IdentityDigests second_id;
+    // The second identity does not depend on the parent view.
+    Check(ComputeIdentities(built.second, built.profile.transaction,
+                            world.parent.chain_id, second_id, error),
+          "second identity");
+    built.third = Payment(Outpoint{second_id.txid, 0}, 5000);
+    return built;
+}
+
+struct Report {
+    OrdinaryBlockConnected connected;
+    Hash parent_utxo{};
+    Hash parent_state{};
+    std::array<uint8_t, 56> parent_monetary{};
+    Hash undo_utxo{};
+    Hash undo_state{};
+    std::array<uint8_t, 56> undo_monetary{};
+    Hash snapshot_utxo{};
+    Hash snapshot_state{};
+    Hash over_cap_utxo{};
+    std::array<uint8_t, 56> over_cap_monetary{};
+    std::string over_cap;
+    std::string coinbase;
+    std::string mint;
+    std::string bad_second;
+    Hash bad_second_utxo{};
+    Hash txid1{};
+    Hash txid2{};
+    std::vector<uint8_t> tx1_core;
+    std::vector<uint8_t> tx1_output;
+};
+
+Report Run() {
+    Report report;
+    World world;
+    report.parent_utxo = world.utxo.Root();
+    report.parent_state = world.parent.header.state_root;
+    report.parent_monetary = EncodeMonetaryState(world.monetary);
+    Built built = BuildPayments(world);
+    std::string error;
+    Check(ConnectOrdinaryBlock({built.first, built.second}, world.parent,
+                               built.profile, kMonetary, world.view, world.utxo,
+                               world.monetary, report.connected, error),
+          "connect two dependent payments: " + error);
+    Check(report.connected.invocation_cost == built.one_cost * 2, "block cost");
+    Check(report.connected.monetary.total_fees == 10000 &&
+              report.connected.monetary.token_burn == 0 &&
+              report.connected.monetary.burned_fees == 5000 &&
+              report.connected.monetary.required_underclaim == 138 &&
+              report.connected.monetary.actual_underclaim == 5202 &&
+              report.connected.monetary.spendable_supply_delta == -10000 &&
+              report.connected.monetary.subsidy == 202 &&
+              report.connected.monetary.bootstrap_issued == 2 &&
+              report.connected.monetary.state.bootstrap_reserve == 7 &&
+              report.connected.monetary.state.tail_subsidy == 200 &&
+              report.connected.monetary.state.ema_block_cost == 12 &&
+              report.connected.monetary.state.prev_work[0] == 9,
+          "monetary delta");
+    Check(report.connected.utxo_root == world.utxo.Root() &&
+              report.connected.state_root ==
+                  StateRoot(world.parent.chain_id, 100, world.utxo.Root(),
+                            world.monetary) &&
+              report.connected.state_root != report.parent_state &&
+              world.view.count(world.funding.outpoint) == 0 &&
+              world.view.count(world.other.outpoint) == 1 &&
+              world.view.size() == 2,
+          "connected view");
+    const Outpoint second_out{[&] {
+        IdentityDigests ids;
+        Check(ComputeIdentities(built.second, built.profile.transaction,
+                                world.parent.chain_id, ids, error),
+              "connected second id");
+        report.txid2 = ids.txid;
+        return Outpoint{ids.txid, 0};
+    }()};
+    Check(world.view.count(second_out) == 1, "second payment output is live");
+    IdentityDigests first_id;
+    Check(ComputeIdentities(built.first, built.profile.transaction,
+                            world.parent.chain_id, first_id, error),
+          "report first id");
+    report.txid1 = first_id.txid;
+    Check(EncodeInputCore(built.first.inputs[0], built.profile.transaction,
+                          report.tx1_core, error) &&
+              EncodeOutput(built.first.outputs[0], report.tx1_output, error),
+          "report wires");
+
+    std::vector<uint8_t> image;
+    Check(WriteInMemorySnapshot(world.view, world.monetary, image, error),
+          "write snapshot");
+    Check(DisconnectOrdinaryBlock(report.connected.undo, world.view, world.utxo,
+                                  world.monetary, error),
+          "disconnect: " + error);
+    report.undo_utxo = world.utxo.Root();
+    report.undo_monetary = EncodeMonetaryState(world.monetary);
+    report.undo_state = StateRoot(world.parent.chain_id, 99, report.undo_utxo,
+                                  world.monetary);
+    Check(report.undo_utxo == report.parent_utxo &&
+              report.undo_monetary == report.parent_monetary &&
+              report.undo_state == report.parent_state,
+          "disconnect did not restore parent roots byte for byte");
+
+    DevelopmentUtxoView reloaded_view;
+    IncrementalUtxoSet reloaded_utxo;
+    MonetaryState reloaded_money;
+    Check(LoadInMemorySnapshot(image, reloaded_view, reloaded_utxo,
+                               reloaded_money, error),
+          "reload snapshot: " + error);
+    report.snapshot_utxo = reloaded_utxo.Root();
+    report.snapshot_state =
+        StateRoot(world.parent.chain_id, 100, report.snapshot_utxo, reloaded_money);
+    Check(report.snapshot_utxo == report.connected.utxo_root &&
+              report.snapshot_state == report.connected.state_root &&
+              EncodeMonetaryState(reloaded_money) ==
+                  report.connected.monetary_bytes,
+          "reloaded snapshot root mismatch");
+    Check(DisconnectOrdinaryBlock(report.connected.undo, reloaded_view,
+                                  reloaded_utxo, reloaded_money, error) &&
+              reloaded_utxo.Root() == report.parent_utxo,
+          "undo after reload");
+
+    World over;
+    Built over_built = BuildPayments(over);
+    OrdinaryBlockConnected discarded;
+    std::string over_error;
+    Check(!ConnectOrdinaryBlock(
+              {over_built.first, over_built.second, over_built.third},
+              over.parent, over_built.profile, kMonetary, over.view, over.utxo,
+              over.monetary, discarded, over_error),
+          "over-cap block was accepted");
+    report.over_cap = over_error;
+    report.over_cap_utxo = over.utxo.Root();
+    report.over_cap_monetary = EncodeMonetaryState(over.monetary);
+    Check(report.over_cap == "block invocation cost over cap" &&
+              report.over_cap_utxo == report.parent_utxo &&
+              report.over_cap_monetary == report.parent_monetary &&
+              over.view.count(over.funding.outpoint) == 1 &&
+              StateRoot(over.parent.chain_id, over.parent.header.height,
+                        over.utxo.Root(), over.monetary) == report.parent_state,
+          "over-cap block left partial state");
+
+    World coinbase_world;
+    Built coinbase_profile = BuildPayments(coinbase_world);
+    Transaction coinbase;
+    Input coinbase_input;
+    coinbase_input.sequence = UINT32_MAX;
+    coinbase_input.flags = 2;
+    coinbase.inputs.push_back(coinbase_input);
+    coinbase.outputs.push_back(coinbase_profile.first.outputs[0]);
+    std::string coinbase_error;
+    OrdinaryBlockConnected unused;
+    Check(!ConnectOrdinaryBlock({coinbase}, coinbase_world.parent,
+                                coinbase_profile.profile, kMonetary,
+                                coinbase_world.view, coinbase_world.utxo,
+                                coinbase_world.monetary, unused, coinbase_error),
+          "coinbase accepted");
+    report.coinbase = coinbase_error;
+    Check(coinbase_world.utxo.Root() == report.parent_utxo &&
+              EncodeMonetaryState(coinbase_world.monetary) ==
+                  report.parent_monetary,
