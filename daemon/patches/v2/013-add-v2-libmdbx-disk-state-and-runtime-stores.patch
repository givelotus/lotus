index 0000000000000000000000000000000000000000..e9c9f3c1d4c18656f15bc0686788751f286047a9
--- /dev/null
+++ b/src/lotus_v2/peer_session_test/README.md
@@ -0,0 +1,135 @@
+# Socket-free V2 handshake/session candidate
+
+This packet adds the bounded inherited ABC version codec and a single-owner
+V2 session state machine on top of `peer_codec`. It opens no sockets, selects no
+network/profile and changes no daemon dispatcher, mainnet parameters or shared
+build files. All identities, magic, transaction profile, receive limits, nonce,
+entropy and monotonic timeout are caller-supplied. Local version service fields
+must all be zero: activation makes no history-serving or validation promise.
+Test network identities/magic are arbitrary literals, not allocations.
+
+## Inherited version behavior
+
+`DecodeVersion` requires version >=70017 and at most the independent pre-handshake
+2 MiB envelope capacity. It reproduces the inspected ABC `net_processing.cpp`
+version parser, rather than imposing an invented exact modern payload size:
+
+| Component | Bytes / behavior |
+| --- | --- |
+| Required prefix | version:i32, services:u64, time:i64, receiver services:u64, raw address[16], port:u16 big-endian: 46 bytes |
+| Optional sender group | sender services:u64, raw address[16], port:u16 big-endian, nonce:u64: 34 bytes |
+| Optional user agent | Shortest CompactSize plus 0..256 raw bytes |
+| Optional starting height | i32 |
+| Optional relay | One byte; any nonzero value means true |
+| Optional extra entropy | u64 |
+| Unknown trailing suffix | Ignored after entropy, bounded by the envelope; only its length is retained |
+
+Each optional group is parsed if bytes remain. A truncated present group rejects;
+ending immediately before a group accepts. Missing sender nonce and entropy
+have accessor defaults 1, starting height -1, relay true and no user agent.
+Negative advertised timestamp normalizes to zero. Fields other than ports are
+little-endian. Version addresses do not have CAddress timestamps. User-agent
+bytes remain untrusted diagnostics; caller sanitizes logging independently.
+
+The complete modern form emitted by a session has 94..352 bytes. This is not a
+new strict receive bound: a peer may send an inherited optional prefix or bounded
+unknown trailing extension. `EncodeVersion` emits known contiguous suffix fields
+only; `ignored_suffix_bytes` is diagnostic, not an encoder extension field. Its
+bool-returning encode/decode functions preserve the result on failure.
+
+Inbound sessions invoke the injected nonce predicate once for the first accepted
+version. As upstream does, an omitted sender/nonce group still passes sentinel 1
+to that predicate. A false result rejects a self connection; an exception is an
+operational local failure. This mechanism does not authenticate peer identity.
+Outbound sessions do not invoke that inbound check. Duplicate version is ignored
+without parsing, replacing state, rechecking nonce or extending a deadline.
+
+## Session API and ownership
+
+Call `OnOpen(monotonic_ms)` once, then pass fragmented/coalesced TCP bytes through
+`Feed(bytes,monotonic_ms,consumed)` and call `OnTimer(monotonic_ms)` independently.
+Time is injected monotonic milliseconds; timeout is explicit and positive.
+Deadline addition is checked for overflow. Backward time is a local failure.
+Handshake expiry is inclusive at the fixed deadline; traffic never extends it.
+An active session no longer has a handshake deadline.
+
+Each call emits at most one `SessionEvent`. `Feed` consumes at most one complete
+envelope, so the caller must re-feed the remaining span. An event carries at
+most two ordered, complete outbound handshake frames. The caller atomically
+queues all outbound frames into its bounded send queue or closes the session;
+returned frames count as queued/sent for choreography. Calls must be serialized.
+The session is not copyable. It owns no output queue or connection.
+
+Both endpoint roles emit complete version first. Receiving the first acceptable
+version emits hello and optionally sendaddrv2. Accepting peer hello emits verack.
+Only receiving peer verack after accepted hello activates the session, after
+both local hello/verack actions have been emitted. Activation switches the
+embedded envelope decoder to min(local,remote) capacity while between messages,
+before any following coalesced application frame is read. Before activation,
+version/hello retain the independent 2 MiB / 118-byte bounds even when advertised
+capacity is 1..117 bytes. Limit changes require a new session/connection.
+
+Duplicate hello, premature verack, pre-version commands and pre-activation
+application commands reject. Duplicate accepted version/verack are ignored as
+upstream does. Sendaddrv2 records support only; it starts no address relay and
+is permitted after version before verack, as the V2 proposal requires.
+
+One existing candidate policy differs from ABC handler permissiveness:
+`peer_codec` requires empty verack/sendaddrv2 payloads, while ABC's handlers
+ignore unused payload bytes. This session inherits that strict empty-control
+codec bound and tests checksum-valid nonempty frames rejecting at their header.
+It does not silently claim legacy parity for those control payloads. Likewise,
+the V2 hello sequence and >=70017 minimum intentionally supersede legacy ABC
+handshake sequencing/minimum. Root protocol review must record these choices.
+
+After activation, only N02/N03/N04 application commands are dispatched as opaque,
+unvalidated messages. Unknown optional commands, feefilter, Bloom/filter,
+Avalanche, snapshots, package and mempool enumeration commands are ignored by
+this layer; it has no inherited handlers for them. Session activation and an
+application event do not validate a transaction/header/body, advertise network
+history, request high-bandwidth compact announcements or mutate chainstate.
+
+`PeerRejected`, `LocalFailure`, `TimedOut` and `Closed` remain distinct outcomes.
+None implies a consensus-invalid block or TxID. `OnClosed` releases partial input
+and peer version state. Allocation failures remain operational exceptions: the
+caller closes/cleans up rather than penalizing consensus objects. The embedded
+decoder can buffer one bounded message; the caller still bounds the number of
+sessions, per-peer/global bytes, event processing, send queues and pending work.
+No transaction/block/address download allocation or parsing occurs here. A
+pre-activation forbidden command's envelope may be buffered up to the explicit
+pre-handshake cap before rejection; global connection budgets remain required.
+
+## Remaining runtime work
+
+The packet has no socket/listener, datadir/profile loader, network adoption,
+address discovery, RPC, validated-body availability index, service upgrade,
+headers synchronization, in-flight downloads, mempool, compact scheduling,
+reconstruction lifecycle/tombstone owner, fallback/retry loop, chain admission,
+fork choice, persistent connection/reorg or public-network claim. The runtime
+must retain and bound per-peer/global compact tombstones until disconnect as
+required by the separate codec packet. A zero-service session is useful for
+isolated handshake tests; it is not a claim of a usable synchronization node.
+
+## Verification
+
+```sh
+cmake -S src/lotus_v2/peer_session_test -B /tmp/v2-peer-session-build -GNinja \
+  -DCMAKE_BUILD_TYPE=Debug \
+  -DLOTUS_SECP_LIBRARY=/absolute/path/to/libsecp256k1.a
+cmake --build /tmp/v2-peer-session-build
+ctest --test-dir /tmp/v2-peer-session-build --output-on-failure
+```
+
+Set `-DLOTUS_SANITIZE=ON` for AddressSanitizer/UndefinedBehaviorSanitizer.
+No synthetic hashing seam or Chronik is enabled. The target reuses native V2
+codec sources and inherited SHA256/SipHash plus an existing ABC secp archive.
+
+Coverage includes a literal independent version byte vector and big-endian
+ports, every truncated optional suffix, 252/253/256 user-agent boundaries,
+noncanonical lengths, relay values, negative time, omitted nonce sentinel,
+unknown suffix up to exact 2 MiB, duplicate version/verack versus hello,
+identity/features/self nonce, local services refusal, deadline/no extension,
+clock overflow/backward movement, premature application messages, split reads,
+limits 1/117/118 with coalesced activation then oversized application rejection,
+asymmetric capacities, unsupported command isolation, empty control records,
+and two socket-free sessions exchanging their actual handshake actions.
diff --git a/src/lotus_v2/peer_tcp.cpp b/src/lotus_v2/peer_tcp.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f9d959bd5a53c4d5210291e46a99b1b2e0f85a0f
--- /dev/null
+++ b/src/lotus_v2/peer_tcp.cpp
@@ -0,0 +1,197 @@
+// Copyright (c) 2026 The Lotus developers
+#include "peer_tcp.h"
+#if !defined(__linux__) && !defined(__APPLE__)
+#error "peer_tcp currently supports POSIX Linux and macOS only"
+#endif
+#include <arpa/inet.h>
+#include <algorithm>
+#include <cerrno>
+#include <climits>
+#include <cstring>
+#include <fcntl.h>
+#include <limits>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <utility>
+namespace lotus::v2::peer {
+namespace {
+void CloseFd(int &fd) noexcept { const int old = std::exchange(fd, -1); if (old >= 0) (void)::close(old); }
+bool Blocked(int error) noexcept { return error == EINTR || error == EAGAIN || error == EWOULDBLOCK; }
+bool Configure(int fd) noexcept {
+    const int flags = fcntl(fd, F_GETFL, 0);
+    if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) return false;
+    const int descriptor = fcntl(fd, F_GETFD, 0);
+    if (descriptor < 0 || fcntl(fd, F_SETFD, descriptor | FD_CLOEXEC) < 0) return false;
+#ifdef __APPLE__
+    const int one = 1;
+    if (setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one)) < 0) return false;
+#endif
+    return true;
+}
+int NewSocket(int family) noexcept {
+#ifdef __linux__
+    int fd = socket(family, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, IPPROTO_TCP);
+#else
+    int fd = socket(family, SOCK_STREAM, IPPROTO_TCP);
+#endif
+    if (fd >= 0 && !Configure(fd)) { const int error = errno; CloseFd(fd); errno = error; }
+    return fd;
+}
+bool Address(const TcpEndpoint &endpoint, sockaddr_storage &storage, socklen_t &length) noexcept {
+    storage = {};
+    if (endpoint.family == TcpFamily::IPv4 && !endpoint.scope_id &&
+        std::all_of(endpoint.address.begin() + 4, endpoint.address.end(), [](uint8_t b) { return b == 0; })) {
+        sockaddr_in address{}; address.sin_family = AF_INET; address.sin_port = htons(endpoint.port);
+        std::memcpy(&address.sin_addr, endpoint.address.data(), 4);
+        std::memcpy(&storage, &address, sizeof(address)); length = sizeof(address); return true;
+    }
+    if (endpoint.family == TcpFamily::IPv6) {
+        sockaddr_in6 address{}; address.sin6_family = AF_INET6; address.sin6_port = htons(endpoint.port);
+        address.sin6_scope_id = endpoint.scope_id;
+        std::memcpy(&address.sin6_addr, endpoint.address.data(), 16);
+        std::memcpy(&storage, &address, sizeof(address)); length = sizeof(address); return true;
+    }
+    return false;
+}
+bool Endpoint(const sockaddr_storage &storage, socklen_t length, TcpEndpoint &out) noexcept {
+    TcpEndpoint endpoint;
+    if (storage.ss_family == AF_INET && length >= sizeof(sockaddr_in)) {
+        sockaddr_in address{}; std::memcpy(&address, &storage, sizeof(address));
+        endpoint.family = TcpFamily::IPv4; endpoint.port = ntohs(address.sin_port);
+        std::memcpy(endpoint.address.data(), &address.sin_addr, 4);
+    } else if (storage.ss_family == AF_INET6 && length >= sizeof(sockaddr_in6)) {
+        sockaddr_in6 address{}; std::memcpy(&address, &storage, sizeof(address));
+        endpoint.family = TcpFamily::IPv6; endpoint.port = ntohs(address.sin6_port); endpoint.scope_id = address.sin6_scope_id;
+        std::memcpy(endpoint.address.data(), &address.sin6_addr, 16);
+    } else return false;
+    out = endpoint; return true;
+}
+TcpReadiness Ready(int fd, bool read, bool write, int &error) noexcept {
+    if (fd < 0 || (!read && !write)) { error = EINVAL; return {StreamStatus::Error}; }
+    pollfd descriptor{fd, short((read ? POLLIN : 0) | (write ? POLLOUT : 0)), 0};
+    const int result = poll(&descriptor, 1, 0);
+    if (result < 0) { error = errno; return {Blocked(error) ? StreamStatus::WouldBlock : StreamStatus::Error}; }
+    if (!result) return {};
+    if (descriptor.revents & POLLNVAL) { error = EBADF; return {StreamStatus::Error}; }
+    return {StreamStatus::Progress, bool(descriptor.revents & (POLLIN | POLLERR | POLLHUP)),
+        bool(descriptor.revents & (POLLOUT | POLLERR | POLLHUP)), bool(descriptor.revents & POLLHUP)};
+}
+} // namespace
+bool ParseNumericEndpoint(std::string_view text, uint16_t port, uint32_t scope, TcpEndpoint &out) noexcept {
+    if (text.empty() || text.size() >= INET6_ADDRSTRLEN || text.find('\0') != std::string_view::npos) return false;
+    char address[INET6_ADDRSTRLEN]{}; std::memcpy(address, text.data(), text.size());
+    TcpEndpoint endpoint; endpoint.port = port; endpoint.scope_id = scope;
+    if (!scope && inet_pton(AF_INET, address, endpoint.address.data()) == 1) endpoint.family = TcpFamily::IPv4;
+    else if (inet_pton(AF_INET6, address, endpoint.address.data()) == 1) endpoint.family = TcpFamily::IPv6;
+    else return false;
+    out = endpoint; return true;
+}
+TcpStream::~TcpStream() { Close(); }
+TcpStream::TcpStream(TcpStream &&other) noexcept { *this = std::move(other); }
+TcpStream &TcpStream::operator=(TcpStream &&other) noexcept {
+    if (this != &other) { Close(); fd_ = std::exchange(other.fd_, -1); error_ = other.error_;
+        connected_ = std::exchange(other.connected_, false); deadline_ = other.deadline_; last_ms_ = other.last_ms_; }
+    return *this;
+}
+void TcpStream::Close() noexcept { CloseFd(fd_); connected_ = false; }
+TcpConnectStatus TcpStream::BeginConnect(const TcpEndpoint &endpoint, uint64_t now, uint64_t timeout) noexcept {
+    if (IsOpen()) { error_ = EALREADY; return TcpConnectStatus::Error; }
+    sockaddr_storage address{}; socklen_t length{};
+    if (!endpoint.port || !timeout || timeout > std::numeric_limits<uint64_t>::max() - now || !Address(endpoint, address, length)) {
+        error_ = EINVAL; return TcpConnectStatus::Error;
+    }
+    fd_ = NewSocket(address.ss_family);
+    if (fd_ < 0) { error_ = errno; return TcpConnectStatus::Error; }
+    deadline_ = now + timeout; last_ms_ = now;
+    if (connect(fd_, reinterpret_cast<const sockaddr *>(&address), length) == 0) {
+        connected_ = true; error_ = 0; return TcpConnectStatus::Connected;
+    }
+    error_ = errno;
+    if (error_ == EINPROGRESS || error_ == EALREADY || error_ == EINTR) return TcpConnectStatus::Pending;
+    Close(); return TcpConnectStatus::Error;
+}
+TcpConnectStatus TcpStream::PollConnect(uint64_t now) noexcept {
+    if (connected_) return TcpConnectStatus::Connected;
+    if (!IsOpen()) { error_ = ENOTCONN; return TcpConnectStatus::Error; }
+    if (now < last_ms_) { error_ = EINVAL; Close(); return TcpConnectStatus::Error; }
+    last_ms_ = now;
+    if (now >= deadline_) { error_ = ETIMEDOUT; Close(); return TcpConnectStatus::TimedOut; }
+    const auto ready = Ready(fd_, false, true, error_);
+    if (ready.status == StreamStatus::Error) { Close(); return TcpConnectStatus::Error; }
+    if (ready.status == StreamStatus::WouldBlock) return TcpConnectStatus::Pending;
+    int result{}; socklen_t length = sizeof(result);
+    if (getsockopt(fd_, SOL_SOCKET, SO_ERROR, &result, &length) < 0) {
+        error_ = errno; if (Blocked(error_)) return TcpConnectStatus::Pending;
+        Close(); return TcpConnectStatus::Error;
+    }
+    if (length != sizeof(result)) result = EIO;
+    if (result) { error_ = result; Close(); return TcpConnectStatus::Error; }
+    connected_ = true; error_ = 0; return TcpConnectStatus::Connected;
+}
+TcpReadiness TcpStream::PollReadiness(bool read, bool write) noexcept { return Ready(fd_, read, write, error_); }
+StreamResult TcpStream::Read(std::span<uint8_t> bytes) {
+    if (!connected_ || bytes.empty()) { error_ = EINVAL; return {StreamStatus::Error}; }
+    const auto n = recv(fd_, bytes.data(), std::min(bytes.size(), size_t(SSIZE_MAX)), 0);
+    if (n > 0) return {StreamStatus::Progress, size_t(n)};
+    if (!n) return {StreamStatus::Eof};
+    error_ = errno; return {Blocked(error_) ? StreamStatus::WouldBlock : StreamStatus::Error};
+}
+StreamResult TcpStream::Write(std::span<const uint8_t> bytes) {
+    if (!connected_ || bytes.empty()) { error_ = EINVAL; return {StreamStatus::Error}; }
+#ifdef __linux__
+    constexpr int flags = MSG_NOSIGNAL;
+#else
+    constexpr int flags = 0; // SO_NOSIGPIPE set before ownership publication.
+#endif
+    const auto n = send(fd_, bytes.data(), std::min(bytes.size(), size_t(SSIZE_MAX)), flags);
+    if (n > 0) return {StreamStatus::Progress, size_t(n)};
+    error_ = n < 0 ? errno : EIO;
+    return {Blocked(error_) ? StreamStatus::WouldBlock : StreamStatus::Error};
+}
+TcpListener::~TcpListener() { Close(); }
+TcpListener::TcpListener(TcpListener &&other) noexcept { *this = std::move(other); }
+TcpListener &TcpListener::operator=(TcpListener &&other) noexcept {
+    if (this != &other) { Close(); fd_ = std::exchange(other.fd_, -1); error_ = other.error_; }
+    return *this;
+}
+void TcpListener::Close() noexcept { CloseFd(fd_); }
+bool TcpListener::Listen(const TcpEndpoint &endpoint, const TcpListenOptions &options) noexcept {
+    if (IsOpen()) { error_ = EALREADY; return false; }
+    sockaddr_storage address{}; socklen_t length{};
+    if (!options.backlog || options.backlog > INT_MAX || !Address(endpoint, address, length) ||
+        (endpoint.family != TcpFamily::IPv6 && options.ipv6_only)) { error_ = EINVAL; return false; }
+    int fd = NewSocket(address.ss_family);
+    if (fd < 0) { error_ = errno; return false; }
+    const int v6_only = options.ipv6_only;
+    if ((endpoint.family == TcpFamily::IPv6 && setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &v6_only, sizeof(v6_only)) < 0) ||
+        bind(fd, reinterpret_cast<const sockaddr *>(&address), length) < 0 || listen(fd, int(options.backlog)) < 0) {
+        error_ = errno; CloseFd(fd); return false;
+    }
+    fd_ = fd; error_ = 0; return true;
+}
+bool TcpListener::BoundEndpoint(TcpEndpoint &out) noexcept {
+    sockaddr_storage address{}; socklen_t length = sizeof(address);
+    if (fd_ < 0 || getsockname(fd_, reinterpret_cast<sockaddr *>(&address), &length) < 0) {
+        error_ = fd_ < 0 ? EBADF : errno; return false;
+    }
+    if (!Endpoint(address, length, out)) { error_ = EAFNOSUPPORT; return false; }
+    return true;
+}
+TcpAcceptStatus TcpListener::Accept(TcpStream &out, TcpEndpoint &remote) noexcept {
+    if (fd_ < 0 || out.IsOpen()) { error_ = fd_ < 0 ? EBADF : EALREADY; return TcpAcceptStatus::Error; }
+    sockaddr_storage address{}; socklen_t length = sizeof(address);
+#ifdef __linux__
+    int fd = accept4(fd_, reinterpret_cast<sockaddr *>(&address), &length, SOCK_NONBLOCK | SOCK_CLOEXEC);
+#else
+    int fd = accept(fd_, reinterpret_cast<sockaddr *>(&address), &length);
+#endif
+    if (fd < 0) { error_ = errno; return Blocked(error_) ? TcpAcceptStatus::WouldBlock : TcpAcceptStatus::Error; }
+    TcpEndpoint endpoint;
+    if (!Configure(fd)) { error_ = errno; CloseFd(fd); return TcpAcceptStatus::Error; }
+    if (!Endpoint(address, length, endpoint)) { error_ = EAFNOSUPPORT; CloseFd(fd); return TcpAcceptStatus::Error; }
+    out.fd_ = fd; out.connected_ = true; out.error_ = 0; remote = endpoint; error_ = 0;
+    return TcpAcceptStatus::Accepted;
+}
+TcpReadiness TcpListener::PollReadiness() noexcept { return Ready(fd_, true, false, error_); }
+} // namespace lotus::v2::peer
