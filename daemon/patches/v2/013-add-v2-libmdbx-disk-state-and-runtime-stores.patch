new file mode 100644
index 0000000000000000000000000000000000000000..6b4886ab160cc3129aa9ad799871e45972a38842
--- /dev/null
+++ b/src/lotus_v2/avalanche_diagnostics.h
@@ -0,0 +1,55 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_DIAGNOSTICS_H
+#define LOTUS_V2_AVALANCHE_DIAGNOSTICS_H
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <limits>
+namespace lotus::v2::ava {
+// Diagnostics never feed protocol decisions. Counters saturate; gauges are
+// current container sizes and are named live_* to distinguish them.
+inline void IncrementDiagnostic(uint64_t &counter) {
+    if(counter!=std::numeric_limits<uint64_t>::max()) ++counter;
+}
+struct PollDiagnostics {
+    uint64_t queries_created{}, queries_expired{}, queries_cancelled{}, responses_matched{};
+    // Applied means a matched response was processed, including duplicate or
+    // inconclusive votes; it does not promise a confidence increase.
+    uint64_t responses_applied{}, responses_ignored{}, responses_rejected{}, responses_local_failure{};
+    uint64_t live_queries{}, live_records{};
+    bool operator==(const PollDiagnostics &) const = default;
+};
+enum class PeerRejection {
+    Signature, Framing, Content, LateResponseAbuse, DiscoveryCooldown,
+    ProofCooldown, NegotiatedCapacity, PayloadCapacity, Other, Count
+};
+struct PeerDiagnostics {
+    // These four count only response handler outcomes. The
+    // rejection categories below cover all application commands, so response
+    // rejections are also included there. Each rejection gets one category.
+    uint64_t responses_applied{}, responses_ignored{}, responses_rejected{}, responses_local_failure{};
+    uint64_t dead_applications{};
+    std::array<uint64_t,static_cast<size_t>(PeerRejection::Count)> application_rejections{};
+    bool operator==(const PeerDiagnostics &) const = default;
+};
+enum class DisconnectCause {
+    Unknown, ApplicationRejected, DeadTarget, NegotiatedCapacity,
+    TransportRequested, TransportEndOfStream, TransportStreamError,
+    TransportStreamContract, TransportPeerRejected, TransportLocalFailure,
+    TransportCapacity, TransportTimedOut, Count
+};
+struct DriverDiagnostics {
+    // Queued means accepted into the adapter action queue, not socket-written.
+    // Backpressure counts attempts, including retries of the same pending poll.
+    uint64_t poll_actions_queued{}, poll_backpressure{}, poll_dead_targets{}, poll_capacity_rejected{};
+    uint64_t discovery_dead_targets{}, discovery_capacity_rejected{}, dispatch_dead_targets{}, dispatch_local_failures{};
+    // Public driver Handle outcomes count attempts; retained notices can retry.
+    uint64_t dead_applications{}, applications_local_failure{};
+    uint64_t disconnects{};
+    // Exactly one cause per tracked connection removed. Unknown is explicit;
+    // no external reason is inferred by subtracting overlapping counters.
+    std::array<uint64_t,static_cast<size_t>(DisconnectCause::Count)> disconnect_causes{};
+    bool operator==(const DriverDiagnostics &) const = default;
+};
+}
+#endif
diff --git a/src/lotus_v2/avalanche_driver.cpp b/src/lotus_v2/avalanche_driver.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c07632377ae85b3ec517d765e515b071fb3a01d1
--- /dev/null
+++ b/src/lotus_v2/avalanche_driver.cpp
@@ -0,0 +1,301 @@
+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_driver.h"
+#include <random.h>
+#include <avalanche/validation.h>
+#include <algorithm>
+#include <limits>
+namespace lotus::v2::ava {
+namespace {
+bool Fail(std::string &e, const char *s) { e=s; return false; }
+DriverResult Error(DriverCode c, std::string e) { return {c, PeerStoreCode::Ok, std::move(e)}; }
+RuntimeBlockStatus Map(Status s) {
+    switch(s) {
+    case Status::Accepted: return RuntimeBlockStatus::Accepted;
+    case Status::Rejected: return RuntimeBlockStatus::Rejected;
+    case Status::Finalized: return RuntimeBlockStatus::Finalized;
+    case Status::Invalid: return RuntimeBlockStatus::Invalid;
+    case Status::Stale: return RuntimeBlockStatus::Stale;
+    }
+    throw std::logic_error("unknown Avalanche status");
+}
+}
+AvalancheDriver::AvalancheDriver(DevelopmentRuntime &r, peer::PeerDispatcher &d, DriverConfig c)
+    : runtime_(r), config_(std::move(c)), quorum_(config_.profile), polls_(config_.profile),
+      store_(config_.peer_file, config_.profile), peer_(d, config_.limits, Callbacks()) {}
+DriverStatus AvalancheDriver::Status() const {
+    const auto quorum=quorum_.Status();
+    const auto native=runtime_.Snapshot();
+    const bool current=validated_ && native.chain && !native.reopen_required &&
+        !native.execution_paused && !native.chain->pending_journal &&
+        !native.chain->pending_receipt && !native.chain->pending_propagation &&
+        validated_->tip==native.chain->stable_tip &&
+        validated_->generation==native.context_generation;
+    return {started_,failed_,initial_download_,
+        Ready() && !initial_download_ && current && quorum.ready,
+        quorum.established,quorum.proof_count,quorum.authenticated_peer_count,
+        quorum.eligible_peer_count,quorum.active_stake_score,quorum.connected_stake_score,
+        polls_.Diagnostics(),peer_.Diagnostics(),diagnostics_,
+        current?polls_.Confidence({ItemKind::Block,native.chain->stable_tip}):std::nullopt};
+}
+bool AvalancheDriver::Snapshot(ChainSnapshot &out, std::string &e) {
+    auto before=runtime_.Snapshot();
+    if(!before.chain || before.reopen_required || before.execution_paused || before.chain->pending_journal || before.chain->pending_receipt || before.chain->pending_propagation)
+        return Fail(e,"runtime-not-authoritative");
+    ChainSnapshot s; s.tip=before.chain->stable_tip; s.generation=before.context_generation; s.initial_download=initial_download_;
+    if(snapshot_cache_ && snapshot_cache_->tip==s.tip &&
+       snapshot_cache_->revision==before.chain->revision &&
+       snapshot_cache_->generation==s.generation) {
+        s.height=snapshot_cache_->height;
+        s.median_time_past=snapshot_cache_->median_time_past;
+        out=s; return true;
+    }
+    Hash id=s.tip; std::vector<uint64_t> times;
+    for(size_t i=0;i<11;++i) {
+        std::optional<IndexedHeader> h;
+        if(runtime_.ReadHeader(id,h,e)!=DevelopmentRuntimeResult::Progress || !h) return Fail(e,"runtime-header-unavailable");
+        if(i==0) s.height=h->header.height;
+        times.push_back(h->header.time);
+        if(h->header.height==0) break;
+        id=h->header.prev_id;
+    }
+    std::sort(times.begin(),times.end()); s.median_time_past=times[times.size()/2];
+    auto after=runtime_.Snapshot();
+    if(!after.chain || after.reopen_required || after.execution_paused || after.context_generation!=before.context_generation || after.chain->stable_tip!=s.tip || after.chain->revision!=before.chain->revision)
+        return Fail(e,"runtime-snapshot-changed");
+    snapshot_cache_=SnapshotCache{s.tip,after.chain->revision,s.generation,s.height,s.median_time_past};
+    out=s; return true;
+}
+bool AvalancheDriver::Refresh(ChainSnapshot &s,std::string &e) {
+    if(!Snapshot(s,e))return false;
+    if(!validated_ || validated_->tip!=s.tip || validated_->generation!=s.generation) {
+        CoinLookup lookup=[this](const Outpoint &o,std::optional<Coin> &c,std::string &err){return runtime_.ReadCoin(o,c,err)==DevelopmentRuntimeResult::Progress;};
+        if(!quorum_.Revalidate(s,lookup,wall_seconds_,[this]{return ReadSnapshot();},e))return false;
+        if(!ReconcileProofs(e))return false;
+        validated_=s;
+        for(auto it=envelopes_.begin();it!=envelopes_.end();)if(!quorum_.Known(it->first))it=envelopes_.erase(it);else ++it;
+    }
+    return true;
+}
+ChainSnapshot AvalancheDriver::ReadSnapshot() {
+    ChainSnapshot s; std::string e;
+    if(!Snapshot(s,e)) { s.initial_download=true; s.generation=std::numeric_limits<uint64_t>::max(); }
+    return s;
+}
+std::optional<ProofEnvelope> AvalancheDriver::Proof(const ::avalanche::ProofId &id) const {
+    if(!quorum_.Known(id)) return {};
+    auto it=envelopes_.find(id); return it==envelopes_.end()?std::nullopt:std::optional(it->second);
+}
+bool AvalancheDriver::Register(const ProofEnvelope &p, std::string &e) {
+    if(failed_ || !p.proof) return Fail(e,"driver-unavailable");
+    ChainSnapshot s; if(!Snapshot(s,e)) return false;
+    const auto id=p.proof->getId();
+    auto existing=envelopes_.find(id);
+    if(existing!=envelopes_.end() && quorum_.Known(id)) {
+        peer::Bytes a,b; std::string err;
+        if(!EncodeProofEnvelope(existing->second,config_.limits,a,err) || !EncodeProofEnvelope(p,config_.limits,b,err) || a!=b) return Fail(e,"proof-envelope-mismatch");
+        if(validated_ && validated_->tip==s.tip && validated_->generation==s.generation && !quorum_.Immature(id)) {
+            if(proof_reconcile_pending_ && !ReconcileProofs(e)){failed_=true;return false;}
+            e.clear(); return true;
+        }
+    }
+    CoinLookup lookup=[this](const Outpoint &o,std::optional<Coin> &c,std::string &err) { return runtime_.ReadCoin(o,c,err)==DevelopmentRuntimeResult::Progress; };
+    bool ok=quorum_.Register(p,s,lookup,wall_seconds_,[this]{return ReadSnapshot();},e);
+    if(!ok && e!="proof-already-registered" && e!="immature-utxo" && e!="conflicting-utxos") return false;
+    if(!quorum_.Known(id)) return false;
+    auto it=envelopes_.find(id);
+    if(it!=envelopes_.end()) {
+        peer::Bytes a,b; std::string err;
+        if(!EncodeProofEnvelope(it->second,config_.limits,a,err) || !EncodeProofEnvelope(p,config_.limits,b,err) || a!=b) return Fail(e,"proof-envelope-mismatch");
+    }
+    for(auto old=envelopes_.begin();old!=envelopes_.end();)if(!quorum_.Known(old->first))old=envelopes_.erase(old);else ++old;
+    envelopes_.insert_or_assign(id,p);
+    if(!ReconcileProofs(e)){failed_=true;return false;}
+    e.clear(); return true;
+}
+bool AvalancheDriver::ReconcileProofs(std::string &e) {
+    // Evicted/revalidated proofs must release their vote-record capacity before
+    // enrolling replacements. Pruning preserves retained records' confidence.
+    polls_.PruneProofs(quorum_);
+    proof_reconcile_pending_=false;
+    for(const auto &id:quorum_.Proofs()) {
+        if(!quorum_.Pollable(id))continue;
+        Hash hash{};std::copy(id.begin(),id.end(),hash.begin());
+        if(!polls_.Reconcile({ItemKind::Proof,hash},quorum_.Vote(id)==0,e)) {
+            if(e!="vote-record-capacity")return false;
+            // Admission remains valid. Existing votes must continue to drain,
+            // and the bounded quorum itself retains the pending proof ids.
+            proof_reconcile_pending_=true;e.clear();return true;
+        }
+    }
+    return true;
+}
+bool AvalancheDriver::Apply(const std::vector<BlockUpdate> &updates,std::string &e) {
+    std::vector<RuntimeBlockUpdate> mapped; mapped.reserve(updates.size());
+    for(const auto &u:updates) mapped.push_back({u.block,Map(u.status),u.expected_tip,u.expected_generation});
+    return runtime_.ApplyAvalancheUpdates(mapped,e);
+}
+PeerCallbacks AvalancheDriver::Callbacks() {
+    PeerCallbacks c; if(config_.session_key.IsValid())c.local_session_key=config_.session_key.GetPubKey();
+    c.register_proof=[this](const auto &p,auto &e){return Register(p,e);};
+    c.bind=[this](auto n,const auto &d,const auto &sig,const auto &t,auto max,auto &e){return Ready() && quorum_.Bind(n,d,sig,t,max,e);};
+    c.disconnect=[this](auto n){polls_.Disconnect(n); quorum_.Disconnect(n); if(pending_poll_ && pending_poll_->node==n) pending_poll_.reset();};
+    c.sent_proof_inventory=[this](auto n){ChainSnapshot s;std::string e;if(Snapshot(s,e))quorum_.SentProofInventory(n,s);};
+    c.respond=[this](const auto &p,auto &out,auto &e){
+        ChainSnapshot s;if(!Ready() || !Snapshot(s,e))return false;
+        ObserveBlock observe=[this,s](const Hash &id,BlockObservation &o,std::string &err){
+            if(ReadSnapshot()!=s)return Fail(err,"stale-block-observation");
+            RuntimeBlockObservation r;if(!runtime_.ObserveAvalancheBlock(id,r,err))return false;
+            if(ReadSnapshot()!=s)return Fail(err,"stale-block-observation");
+            o={r.known,r.valid,r.active,r.parked,r.finalized,r.conflicting_finalized,r.forks_active,r.has_data};return true;};
+        return polls_.Respond(p,observe,quorum_,config_.session_key,out,e);};
+    c.receive=[this](auto n,const auto &r,auto &e){ChainSnapshot s;if(!Ready() || !Snapshot(s,e))return PollReceiveResult::LocalFailure;return polls_.ReceiveResponse(quorum_,n,r,s,now_ms_,wall_seconds_,[this](const auto &u,auto &err){return Apply(u,err);},e);};
+    c.proof=[this](const auto &id){return Proof(id);}; c.proofs=[this]{return quorum_.Proofs();};
+    c.discovery_keys=[](uint64_t &a,uint64_t &b){FastRandomContext rng; a=rng.rand64();b=rng.rand64();return true;};
+    c.sign_hello=[this](const uint256 &h,SchnorrSig &s){return config_.session_key.SignSchnorr(h,s);};return c;
+}
+DriverResult AvalancheDriver::Start(bool ibd,int64_t wall) {
+    if(started_ || failed_)return Error(DriverCode::InvalidConfiguration,"driver-already-started");
+    initial_download_=ibd;wall_seconds_=wall;
+    const Profile defaults;
+    const auto &p=config_.profile;
+    CPubKey delegated; ::avalanche::DelegationState delegation_state;
+    if(wall<0 || !config_.session_key.IsValid() || (config_.local_proof.proof && (!config_.delegation.verify(delegation_state,delegated) || delegated!=config_.session_key.GetPubKey() || config_.delegation.getProofId()!=config_.local_proof.proof->getId())) ||
+       p.stake_dust!=defaults.stake_dust || p.stake_confirmations!=defaults.stake_confirmations || p.min_quorum_stake!=defaults.min_quorum_stake || p.min_connected_ratio!=defaults.min_connected_ratio || p.min_avaproofs_nodes!=defaults.min_avaproofs_nodes || p.conflicting_proof_cooldown_seconds!=defaults.conflicting_proof_cooldown_seconds || p.peer_replacement_cooldown_seconds!=defaults.peer_replacement_cooldown_seconds || p.stale_vote_threshold!=defaults.stale_vote_threshold || p.stale_vote_factor!=defaults.stale_vote_factor || p.query_timeout_ms!=defaults.query_timeout_ms || p.max_element_poll!=defaults.max_element_poll || config_.limits.poll_cooldown_ms!=AVALANCHE_DEFAULT_COOLDOWN || config_.limits.max_elements!=p.max_element_poll)
+        return Error(DriverCode::InvalidConfiguration,"invalid-session-or-nondefault-voting-policy");
+    ChainSnapshot s;std::string e;if(!Snapshot(s,e))return Error(DriverCode::NotReady,e);
+    auto native=runtime_.Snapshot(); std::optional<IndexedHeader> genesis; Hash genesis_id;
+    if(!native.chain || native.chain->profile_digest!=p.validation_digest || runtime_.ReadHeader(p.genesis_id,genesis,e)!=DevelopmentRuntimeResult::Progress || !genesis || genesis->header.height!=0 || !BlockId(p.chain_id,genesis->header,genesis_id) || genesis_id!=p.genesis_id)
+        return Error(DriverCode::InvalidConfiguration,"runtime-profile-mismatch");
+    CoinLookup lookup=[this](const Outpoint &o,std::optional<Coin> &c,std::string &err){return runtime_.ReadCoin(o,c,err)==DevelopmentRuntimeResult::Progress;};
+    if(p.persist_peers) {
+        std::vector<PersistedPeer> loaded;
+        auto result=store_.Load(loaded);
+        if(!result && result.code!=PeerStoreCode::Missing) {failed_=true;return {DriverCode::StoreFailure,result.code,result.message};}
+        Quorum screened(p);std::vector<PersistedPeer> valid;
+        for(const auto &entry:loaded) {
+            if(screened.Register(entry.envelope,s,lookup,entry.registration_time,[this]{return ReadSnapshot();},e))valid.push_back(entry);
+            if(ReadSnapshot()!=s)return Error(DriverCode::NotReady,"restore-snapshot-changed");
+        }
+        // RestorePeers independently validates each retained record again and
+        // restores ABC's registration/conflict/finalization metadata atomically.
+        if(!quorum_.RestorePeers(valid,s,lookup,[this]{return ReadSnapshot();},e))return Error(DriverCode::ProtocolFailure,e);
+        for(const auto &entry:valid)envelopes_.insert_or_assign(entry.envelope.proof->getId(),entry.envelope);
+    }
+    if(config_.local_proof.proof && !Register(config_.local_proof,e)){failed_=true;return Error(DriverCode::InvalidConfiguration,e);}
+    if(!ReconcileProofs(e)){failed_=true;return Error(DriverCode::ProtocolFailure,e);}
+    validated_=s;started_=true;return {};
+}
+DriverResult AvalancheDriver::ClosePeer(peer::ConnectionId id,DisconnectCause cause) {
+    Disconnect(id,cause);DriverResult result;result.disconnected_peer=id;return result;
+}
+DriverResult AvalancheDriver::Pump(uint64_t now) {
+    while(peer_.PendingActions()) {
+        const auto result=peer_.Pump(now);
+        if(result==peer::DispatcherResult::Queued) continue;
+        if(result==peer::DispatcherResult::Busy || result==peer::DispatcherResult::Progress) break;
+        const auto id=peer_.PendingConnection();
+        if(result==peer::DispatcherResult::UnknownPeer || result==peer::DispatcherResult::Closed ||
+           (result==peer::DispatcherResult::CapacityRefused && id && !peer_.Active(*id))) {
+            if(id) {IncrementDiagnostic(diagnostics_.dispatch_dead_targets);return ClosePeer(*id,DisconnectCause::DeadTarget);}
+            return Error(DriverCode::ProtocolFailure,"missing-terminal-action-target");
+        }
+        if(result==peer::DispatcherResult::CapacityRefused) {
+            IncrementDiagnostic(diagnostics_.dispatch_local_failures);
+            return Error(DriverCode::ProtocolFailure,"avalanche-local-dispatch-capacity");
+        }
+        if(result==peer::DispatcherResult::InvalidConfiguration || result==peer::DispatcherResult::OperationalFailure) {
+            IncrementDiagnostic(diagnostics_.dispatch_local_failures);
+            return Error(DriverCode::ProtocolFailure,"avalanche-local-dispatch-failure");
+        }
+        break;
+    }
+    return {};
+}
+DriverResult AvalancheDriver::Tick(bool ibd,int64_t ms,int64_t wall) {
+    if(!Ready())return Error(DriverCode::NotReady,"driver-not-started");
+    if(ms<now_ms_ || ms<0 || wall<0)return Error(DriverCode::InvalidConfiguration,"invalid-clock");
+    now_ms_=ms;wall_seconds_=wall;initial_download_=ibd;
+    ChainSnapshot s;std::string e;if(!Snapshot(s,e))return Error(DriverCode::NotReady,e);
+    if(!Refresh(s,e))return Error(DriverCode::NotReady,e);
+    if(!ReconcileProofs(e))return Error(DriverCode::ProtocolFailure,e);
+    for(auto &[id,due]:discovery_due_) {
+        const auto now=static_cast<uint64_t>(ms);
+        if(now<due)continue;
+        auto r=peer_.Discover(id,now,e);
+        if(r==PeerResult::Accepted) {
+            const auto interval=std::max<uint64_t>(60000,config_.limits.discovery_interval_ms);
+            due=interval>std::numeric_limits<uint64_t>::max()-now?std::numeric_limits<uint64_t>::max():now+interval;
+        }
+        if(r==PeerResult::UnknownPeer) {IncrementDiagnostic(diagnostics_.discovery_dead_targets);return ClosePeer(id,DisconnectCause::DeadTarget);}
+        if(r==PeerResult::Rejected) {IncrementDiagnostic(diagnostics_.discovery_capacity_rejected);return ClosePeer(id,DisconnectCause::NegotiatedCapacity);}
+        if(r==PeerResult::LocalFailure)return Error(DriverCode::ProtocolFailure,e);
+    }
+    peer_.Tick(static_cast<uint64_t>(ms));
+    auto pumped=Pump(static_cast<uint64_t>(ms));if(!pumped || pumped.disconnected_peer)return pumped;
+    if(s.initial_download)return proof_reconcile_pending_?Error(DriverCode::Backpressure,"proof-vote-record-capacity"):DriverResult{};
+    if(!pending_poll_) {OutgoingPoll p;if(polls_.Next(quorum_,s,ms,p,e))pending_poll_=std::move(p);}
+    if(pending_poll_) {
+        auto r=peer_.Poll(*pending_poll_,e);
+        if(r==PeerResult::Backpressure) {IncrementDiagnostic(diagnostics_.poll_backpressure);return Error(DriverCode::Backpressure,e);}
+        if(r==PeerResult::UnknownPeer || r==PeerResult::Rejected) {
+            const auto cause=r==PeerResult::UnknownPeer?DisconnectCause::DeadTarget:DisconnectCause::NegotiatedCapacity;
+            if(r==PeerResult::UnknownPeer) IncrementDiagnostic(diagnostics_.poll_dead_targets);
+            else IncrementDiagnostic(diagnostics_.poll_capacity_rejected);
+            const auto node=pending_poll_->node;
+            if(const auto id=peer_.Connection(node))return ClosePeer(*id,cause);
+            polls_.Disconnect(node);quorum_.Disconnect(node);pending_poll_.reset();return {};
+        }
+        if(r!=PeerResult::Accepted)return Error(DriverCode::ProtocolFailure,e);
+        IncrementDiagnostic(diagnostics_.poll_actions_queued);
+        pending_poll_.reset();
+    }
+    pumped=Pump(static_cast<uint64_t>(ms));if(!pumped || pumped.disconnected_peer)return pumped;return proof_reconcile_pending_?Error(DriverCode::Backpressure,"proof-vote-record-capacity"):DriverResult{};
+}
+PeerResult AvalancheDriver::Activate(peer::ConnectionId id,std::string &e) {
+    if(!Ready()){e="driver-not-started";return PeerResult::LocalFailure;}
+    auto r=peer_.Activate(id,e);if(r!=PeerResult::Accepted)return r;
+    discovery_due_.try_emplace(id,0);
+    return config_.local_proof.proof ? peer_.Hello(id,config_.delegation,e) : PeerResult::Accepted;
+}
+PeerResult AvalancheDriver::Handle(const peer::DispatcherNotice &n,uint64_t ms,std::string &e) {
+    const auto result=HandleImpl(n,ms,e);
+    if(result==PeerResult::UnknownPeer) IncrementDiagnostic(diagnostics_.dead_applications);
+    if(result==PeerResult::LocalFailure) IncrementDiagnostic(diagnostics_.applications_local_failure);
+    return result;
+}
+PeerResult AvalancheDriver::HandleImpl(const peer::DispatcherNotice &n,uint64_t ms,std::string &e) {
+    if(!Ready() || ms>uint64_t(std::numeric_limits<int64_t>::max()) || ms<uint64_t(now_ms_)){e="driver-unavailable-or-invalid-clock";return PeerResult::LocalFailure;}
+    if(!peer_.Active(n.connection)) {e="avalanche-inactive-peer";return PeerResult::UnknownPeer;}
+    now_ms_=static_cast<int64_t>(ms);ChainSnapshot s;if(!Refresh(s,e))return PeerResult::LocalFailure;
+    const auto result=peer_.Handle(n,ms,e);
+    // Anchor successful discovery cooldown after the remote processed our
+    // request, so differing transport delays cannot race its receive-side gate.
+    if(result==PeerResult::Accepted && n.application && n.application->command=="avaproofs") {
+        auto it=discovery_due_.find(n.connection);
+        if(it!=discovery_due_.end()) {
+            const auto interval=std::max<uint64_t>(60000,config_.limits.discovery_interval_ms);
+            it->second=interval>std::numeric_limits<uint64_t>::max()-ms?std::numeric_limits<uint64_t>::max():ms+interval;
+        }
+    }
+    return result;
+}
+void AvalancheDriver::Disconnect(peer::ConnectionId id,DisconnectCause cause) {
+    if(discovery_due_.erase(id)) {
+        IncrementDiagnostic(diagnostics_.disconnects);
+        const auto category=static_cast<size_t>(cause)<static_cast<size_t>(DisconnectCause::Count)?cause:DisconnectCause::Unknown;
+        IncrementDiagnostic(diagnostics_.disconnect_causes[static_cast<size_t>(category)]);
+    }
+    peer_.Disconnect(id);
+}
+bool AvalancheDriver::Reconcile(const PollItem &p,bool accepted,std::string &e) {return Ready() && polls_.Reconcile(p,accepted,e);}
+DriverResult AvalancheDriver::Save() {
+    if(!Ready())return Error(DriverCode::NotReady,"driver-not-started");
+    if(!config_.profile.persist_peers)return {};
+    // Persistence is a public cache of previously admitted records, not a
+    // statement about current eligibility. A durable block journal can make
+    // chain authority temporarily unavailable during an orderly stop. Preserve
+    // the last active admitted public records now; Start individually validates them against the
+    // recovered authoritative chain before restoring quorum state.
+    auto r=store_.Save(quorum_.ExportPeers());if(!r){failed_=true;return {DriverCode::StoreFailure,r.code,r.message};}return {};
+}
+}
