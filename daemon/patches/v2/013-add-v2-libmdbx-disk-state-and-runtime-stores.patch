+// Copyright (c) 2026 The Lotus developers
+#include "development_node_command.h"
+#include "block_template.h"
+#include "avalanche_driver.h"
+#include <streams.h>
+#include <support/cleanse.h>
+#include <sys/stat.h>
+#include "development_command.h"
+#include "development_runtime.h"
+#include "peer_dispatcher.h"
+#include "peer_tcp.h"
+#include "pool_coordinator.h"
+#include "transaction_relay.h"
+#ifdef LOTUS_V2_CHRONIK_CXX
+#include "chronik_sync.h"
+#include <filesystem>
+#endif
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <deque>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <utility>
+#include <univalue.h>
+#if defined(__linux__) || defined(__APPLE__)
+#include <arpa/inet.h>
+#include <cerrno>
+#include <cstdlib>
+#if defined(__linux__)
+#include <sys/random.h>
+#endif
+#include <csignal>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#endif
+namespace lotus::v2 {
+#if defined(__linux__) || defined(__APPLE__)
+namespace {
+    using namespace peer;
+    using Result = DevelopmentRuntimeResult;
+    constexpr uint64_t MiB = uint64_t{1} << 20;
+    constexpr size_t MaxPeers = 8, MaxTransactions = 65536, OutputCap = 8 * MiB;
+    void Require(bool ok, const std::string &why) {
+        if (!ok) throw std::runtime_error(why);
+    }
+    uint64_t Monotonic() {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    }
+    uint64_t Utc() {
+        const auto n = std::chrono::duration_cast<std::chrono::seconds>(
+                           std::chrono::system_clock::now().time_since_epoch())
+                           .count();
+        Require(n >= 0, "UTC clock unavailable");
+        return n;
+    }
+    void Count(uint64_t &v, uint64_t n = 1) {
+        v = n > UINT64_MAX - v ? UINT64_MAX : v + n;
+    }
+    void Keys(const UniValue &v, const std::set<std::string> &keys) {
+        Require(v.isObject() && v.getKeys().size() == keys.size() &&
+                    std::set<std::string>(v.getKeys().begin(),
+                                          v.getKeys().end()) == keys,
+                "unknown, duplicate or missing object field");
+    }
+    uint64_t Number(const UniValue &v, uint64_t max) {
+        Require(v.isNum(), "expected unsigned JSON integer");
+        const auto &s = v.getValStr();
+        Require(!s.empty() && (s.size() == 1 || s.front() != '0'),
+                "noncanonical integer");
+        uint64_t n = 0;
+        for (char c : s) {
+            Require(c >= '0' && c <= '9' && uint64_t(c - '0') <= max &&
+                        n <= (max - (c - '0')) / 10,
+                    "integer outside limit");
+            n = n * 10 + (c - '0');
+        }
+        return n;
+    }
+    std::vector<uint8_t> Unhex(const UniValue &v, size_t cap) {
+        Require(v.isStr(), "expected lowercase hex string");
+        const auto &s = v.get_str();
+        Require(s.size() % 2 == 0 && s.size() / 2 <= cap,
+                "hex exceeds local capacity");
+        auto digit = [](char c) -> unsigned {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            throw std::runtime_error("expected lowercase hex");
+        };
+        std::vector<uint8_t> out;
+        out.reserve(s.size() / 2);
+        for (size_t i = 0; i < s.size(); i += 2)
+            out.push_back((digit(s[i]) << 4) | digit(s[i + 1]));
+        return out;
+    }
+    uint64_t DecimalU64(const UniValue &v) {
+        Require(v.isStr(), "expected canonical decimal u64 string");
+        const auto &s = v.get_str();
+        Require(!s.empty() && s.size() <= 20 &&
+                    (s.size() == 1 || s.front() != '0'),
+                "noncanonical decimal u64 string");
+        uint64_t n = 0;
+        for (char c : s) {
+            Require(c >= '0' && c <= '9' &&
+                        n <= (UINT64_MAX - uint64_t(c - '0')) / 10,
+                    "decimal u64 outside range");
+            n = n * 10 + uint64_t(c - '0');
+        }
+        return n;
+    }
+    struct ProducerFailure : std::runtime_error {
+        std::string result;
+        ProducerFailure(std::string category, const std::string &message)
+            : std::runtime_error(message), result(std::move(category)) {}
+    };
+    size_t HexSize(const UniValue &v, uint64_t cap) {
+        Require(v.isStr(), "expected lowercase hex string");
+        const auto &s = v.get_str();
+        Require(s.size() % 2 == 0, "hex length must be even");
+        for (char c : s)
+            Require((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'),
+                    "expected lowercase hex");
+        if (s.size() / 2 > cap)
+            throw ProducerFailure("capacity_refused",
+                                  "hex exceeds local aggregate capacity");
+        return s.size() / 2;
+    }
+    std::string RuntimeFailure(Result result) {
+        switch (result) {
+            case Result::Busy:
+                return "busy";
+            case Result::CapacityRefused:
+                return "capacity_refused";
+            case Result::ReopenRequired:
+                return "reopen_required";
+            case Result::StorageError:
+                return "storage_error";
+            default:
+                return "inconclusive";
+        }
+    }
+    Hash HashOf(const UniValue &v) {
+        const auto b = Unhex(v, 32);
+        Require(b.size() == 32, "expected32-byte hash");
+        Hash h;
+        std::copy(b.begin(), b.end(), h.begin());
+        return h;
+    }
+    std::string Hex(std::span<const uint8_t> bytes) {
+        static constexpr char d[] = "0123456789abcdef";
+        std::string s;
+        s.reserve(bytes.size() * 2);
+        for (auto b : bytes) {
+            s += d[b >> 4];
+            s += d[b & 15];
+        }
+        return s;
+    }
+    // Passive observations retain their separate poll, peer and driver scopes.
+    // Counters can overlap across layers; serialization never sums them.
+    UniValue AvalancheDiagnosticsJson(const ava::PollDiagnostics &polls,
+                                     const ava::PeerDiagnostics &peer,
+                                     const ava::DriverDiagnostics &driver,
+                                     const std::optional<uint16_t> &confidence) {
+        UniValue out(UniValue::VOBJ), poll(UniValue::VOBJ),
+            responses(UniValue::VOBJ), actions(UniValue::VOBJ);
+        poll.pushKV("queries_created", polls.queries_created);
+        poll.pushKV("queries_expired", polls.queries_expired);
+        poll.pushKV("queries_cancelled", polls.queries_cancelled);
+        poll.pushKV("responses_matched", polls.responses_matched);
+        poll.pushKV("responses_applied", polls.responses_applied);
+        poll.pushKV("responses_ignored", polls.responses_ignored);
+        poll.pushKV("responses_rejected", polls.responses_rejected);
+        poll.pushKV("responses_local_failure", polls.responses_local_failure);
+        poll.pushKV("live_queries", polls.live_queries);
+        poll.pushKV("live_records", polls.live_records);
+        responses.pushKV("responses_applied", peer.responses_applied);
+        responses.pushKV("responses_ignored", peer.responses_ignored);
+        responses.pushKV("responses_rejected", peer.responses_rejected);
+        responses.pushKV("responses_local_failure", peer.responses_local_failure);
+        responses.pushKV("dead_applications", peer.dead_applications);
+        constexpr std::array rejection_names{
+            "signature", "framing", "content",
+            "late_response_abuse", "discovery_cooldown", "proof_cooldown",
+            "negotiated_capacity", "payload_capacity", "other"};
+        static_assert(rejection_names.size() == static_cast<size_t>(ava::PeerRejection::Count));
+        UniValue rejected(UniValue::VOBJ);
+        for (size_t i = 0; i < rejection_names.size(); ++i)
+            rejected.pushKV(rejection_names[i], peer.application_rejections[i]);
+        responses.pushKV("application_rejections", rejected);
+        actions.pushKV("poll_actions_queued", driver.poll_actions_queued);
+        actions.pushKV("poll_backpressure", driver.poll_backpressure);
+        actions.pushKV("poll_dead_targets", driver.poll_dead_targets);
+        actions.pushKV("poll_capacity_rejected", driver.poll_capacity_rejected);
+        actions.pushKV("discovery_dead_targets", driver.discovery_dead_targets);
+        actions.pushKV("discovery_capacity_rejected", driver.discovery_capacity_rejected);
+        actions.pushKV("dispatch_dead_targets", driver.dispatch_dead_targets);
+        actions.pushKV("dispatch_local_failures", driver.dispatch_local_failures);
+        actions.pushKV("dead_applications", driver.dead_applications);
+        actions.pushKV("applications_local_failure", driver.applications_local_failure);
+        actions.pushKV("disconnects", driver.disconnects);
+        constexpr std::array cause_names{
+            "unknown", "application_rejected", "dead_target",
+            "negotiated_capacity", "transport_requested", "transport_end_of_stream",
+            "transport_stream_error", "transport_stream_contract", "transport_peer_rejected",
+            "transport_local_failure", "transport_capacity", "transport_timed_out"};
+        static_assert(cause_names.size() == static_cast<size_t>(ava::DisconnectCause::Count));
+        UniValue closed(UniValue::VOBJ);
+        for (size_t i = 0; i < cause_names.size(); ++i)
+            closed.pushKV(cause_names[i], driver.disconnect_causes[i]);
+        actions.pushKV("disconnect_causes", closed);
+        out.pushKV("polls", poll);
+        out.pushKV("peer", responses);
+        out.pushKV("diagnostics", actions);
+        if (confidence) out.pushKV("tip_confidence", uint64_t(*confidence));
+        else out.pushKV("tip_confidence", UniValue());
+        return out;
+    }
+    ava::DisconnectCause TransportDisconnectCause(TransportClose reason) {
+        switch (reason) {
+            case TransportClose::None: return ava::DisconnectCause::Unknown;
+            case TransportClose::Requested: return ava::DisconnectCause::TransportRequested;
+            case TransportClose::EndOfStream: return ava::DisconnectCause::TransportEndOfStream;
+            case TransportClose::StreamError: return ava::DisconnectCause::TransportStreamError;
+            case TransportClose::StreamContract: return ava::DisconnectCause::TransportStreamContract;
+            case TransportClose::PeerRejected: return ava::DisconnectCause::TransportPeerRejected;
+            case TransportClose::LocalFailure: return ava::DisconnectCause::TransportLocalFailure;
+            case TransportClose::Capacity: return ava::DisconnectCause::TransportCapacity;
+            case TransportClose::TimedOut: return ava::DisconnectCause::TransportTimedOut;
+        }
+        return ava::DisconnectCause::Unknown;
+    }
+    UniValue ReadJson(const std::string &path) {
+        std::ifstream f(path, std::ios::binary | std::ios::ate);
+        Require(bool(f), "cannot open network file");
+        const auto n = f.tellg();
+        Require(n >= 0 && n <= 65536, "network file exceeds64KiB");
+        std::string s(size_t(n), '\0');
+        f.seekg(0);
+        if (n) f.read(s.data(), s.size());
+        Require(bool(f), "network read failure");
+        UniValue v;
+        Require(v.read(s), "invalid network JSON");
+        return v;
+    }
+    struct AvalancheConfig {
+        std::optional<std::string> credentials;
+        uint32_t minimum_height{}, maximum_tip_age_seconds{};
+    };
+    struct NetworkConfig {
+        NetworkProfile profile;
+        TcpEndpoint listen;
+        std::vector<TcpEndpoint> connect;
+        std::optional<std::string> chronik_bind;
+        std::optional<AvalancheConfig> avalanche;
+    };
+    TcpEndpoint Endpoint(const UniValue &v, bool listening) {
+        Keys(v, {"address", "port"});
+        Require(v["address"].isStr(), "numeric address required");
+        TcpEndpoint out;
+        const auto port = Number(v["port"], 65535);
+        Require((listening || port > 0) &&
+                    ParseNumericEndpoint(v["address"].get_str(), uint16_t(port),
+                                         0, out),
+                "invalid explicit numeric endpoint");
+        return out;
+    }
+    NetworkConfig Network(const std::string &path,
+                          const DevelopmentManifest &m) {
+        const auto v = ReadJson(path);
+        std::set<std::string> fields{"schema", "magic", "listen", "connect", "receive_limit", "local_policy"};
+        if (!v["chronik_bind"].isNull()) fields.insert("chronik_bind");
+        if (!v["avalanche"].isNull()) fields.insert("avalanche");
+        Keys(v, fields);
+        Require(Number(v["schema"], 1) == 1, "network schema must be1");
+        Require(v["local_policy"].isStr() &&
+                    v["local_policy"].get_str() == "bounded-local-v1",
+                "explicit bounded-local-v1 policy required");
+        NetworkConfig c{};
+        if (!v["avalanche"].isNull()) {
+            const auto &a = v["avalanche"];
+            Keys(a, {"credentials", "initial_download"});
+            AvalancheConfig config;
+            if (!a["credentials"].isNull()) {
+                Require(a["credentials"].isStr() && !a["credentials"].get_str().empty() &&
+                        a["credentials"].get_str().front() == '/', "credentials requires an absolute local file path");
+                config.credentials = a["credentials"].get_str();
+            }
+            Keys(a["initial_download"], {"minimum_height", "maximum_tip_age_seconds"});
+            config.minimum_height = Number(a["initial_download"]["minimum_height"], UINT32_MAX);
+            config.maximum_tip_age_seconds = Number(a["initial_download"]["maximum_tip_age_seconds"], UINT32_MAX);
+            Require(config.maximum_tip_age_seconds > 0, "maximum tip age must be positive");
+            c.avalanche = config;
+        }
+        if (!v["chronik_bind"].isNull()) {
+            Require(v["chronik_bind"].isStr(), "chronik_bind must be an explicit numeric socket address");
+            c.chronik_bind = v["chronik_bind"].get_str();
+#ifndef LOTUS_V2_CHRONIK_CXX
+            throw std::runtime_error("V2 Chronik requires a Chronik-enabled build");
+#endif
+        }
+        const auto magic = Unhex(v["magic"], 4);
+        Require(magic.size() == 4, "explicit4-byte magic required");
+        std::copy(magic.begin(), magic.end(), c.profile.magic.begin());
+        c.listen = Endpoint(v["listen"], true);
+        Require(v["connect"].isArray() && v["connect"].size() <= MaxPeers,
+                "connect list exceeds8targets");
+        for (const auto &value : v["connect"].getValues()) {
+            const auto ep = Endpoint(value, false);
+            Require(std::find(c.connect.begin(), c.connect.end(), ep) ==
+                        c.connect.end(),
+                    "duplicate connect endpoint");
+            c.connect.push_back(ep);
+        }
+        c.profile.receive_limit = Number(v["receive_limit"], MAX_RECEIVE_LIMIT);
+        Require(m.block_read_limit >= HEADER_SIZE + 4 + 17 &&
+                    m.block_read_limit <= c.profile.receive_limit,
+                "manifest body capacity must fit explicit receive limit");
+        c.profile.chain_id = m.hp.chain_id;
+        c.profile.genesis_id = m.hp.genesis_id;
+        c.profile.profile_digest =
+            BlockValidationProfileDigest(m.hp, m.op, m.mp, m.cp);
+        c.profile.transaction = m.op.transaction;
+        c.profile.max_reconstruction_transactions = MaxTransactions;
+        c.profile.max_reconstruction_bytes = m.block_read_limit;
+        return c;
+    }
+    ava::DriverConfig AvalancheSettings(const NetworkConfig &network, const std::string &directory) {
+        ava::DriverConfig c;
+        c.profile.chain_id = network.profile.chain_id;
+        c.profile.genesis_id = network.profile.genesis_id;
+        c.profile.validation_digest = network.profile.profile_digest;
+        c.peer_file = directory + "/avalanche-peers.dat";
+        c.limits.max_peers = MaxPeers;
+        if (!network.avalanche->credentials) {
+            c.session_key.MakeNewKey(true);
+            return c;
+        }
+        // Open without following symlinks; validate the opened object, avoiding
+        // a stat/open race and preventing a device/FIFO read from blocking.
+        const int fd = open(network.avalanche->credentials->c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+        Require(fd >= 0, "cannot open private Avalanche credentials");
+        struct Close { int fd; ~Close() { close(fd); } } close_file{fd};
+        struct stat st{};
+        Require(fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == geteuid() &&
+                (st.st_mode & 077) == 0 && st.st_size > 0 && st.st_size <= 1024 * 1024,
+                "Avalanche credentials must be a private owned regular file <=1MiB");
+        std::string text(size_t(st.st_size), '\0');
+        struct Wipe { std::string &text; ~Wipe() { memory_cleanse(text.data(), text.size()); } } wipe{text};
+        size_t offset = 0;
+        while (offset < text.size()) {
+            const auto n = read(fd, text.data() + offset, text.size() - offset);
+            if (n < 0 && errno == EINTR) continue;
+            Require(n > 0, "Avalanche credential read failed");
+            offset += size_t(n);
+        }
+        char extra;
+        Require(read(fd, &extra, 1) == 0, "Avalanche credential file changed while reading");
+        UniValue v;
+        Require(v.read(text), "invalid Avalanche credential JSON");
+        Keys(v, {"schema", "session_key", "proof", "delegation"});
+        Require(Number(v["schema"], 1) == 1, "Avalanche credential schema must be1");
+        auto key = Unhex(v["session_key"], 32);
+        Require(key.size() == 32, "Avalanche session key must be32bytes");
+        c.session_key.Set(key.begin(), key.end(), true);
+        memory_cleanse(key.data(), key.size());
+        // UniValue exposes the parsed string by reference; erase the secret
+        // copy before decoding any public data or propagating validation errors.
+        auto &key_text = const_cast<std::string &>(v["session_key"].get_str());
+        memory_cleanse(key_text.data(), key_text.size());
+        Require(c.session_key.IsValid(), "invalid Avalanche session key");
+        const auto proof = Unhex(v["proof"], c.limits.max_payload);
+        std::string error;
+        Require(ava::DecodeProofEnvelope(proof, c.limits, c.local_proof, error), "invalid Avalanche proof envelope");
+        const auto delegation = Unhex(v["delegation"], 4096);
+        try {
+            DataStream input{Span<const uint8_t>{delegation.data(), delegation.size()}};
+            // Delegation's generic decoder has vectors: scan both their lengths
+            // and level count first, so malformed local bytes cannot allocate.
+            DataStream scan{Span<const uint8_t>{delegation.data(), delegation.size()}};
+            scan.ignore(32);
+            auto skip_key = [&] { const auto n = ReadCompactSize(scan); Require(n <= 65, "invalid delegation key size"); scan.ignore(n); };
+            skip_key();
+            const auto levels = ReadCompactSize(scan);
+            Require(levels <= ::avalanche::MAX_DELEGATION_LEVELS, "delegation level limit");
+            for (uint64_t i = 0; i < levels; ++i) { skip_key(); scan.ignore(64); }
+            Require(scan.empty(), "delegation trailing bytes");
+            input >> c.delegation;
+            Require(input.empty(), "delegation trailing bytes");
+        } catch (const std::ios_base::failure &) { throw std::runtime_error("invalid Avalanche delegation"); }
+        return c;
+    }
+    std::string Address(const TcpEndpoint &e) {
+        char text[INET6_ADDRSTRLEN]{};
+        Require(inet_ntop(e.family == TcpFamily::IPv4 ? AF_INET : AF_INET6,
+                          e.address.data(), text, sizeof(text)),
+                "endpoint formatting failed");
+        return text;
+    }
+    bool Entropy(uint64_t &out) {
+        for (unsigned i = 0; i < 8; ++i) {
+            uint64_t n;
+#if defined(__APPLE__)
+            arc4random_buf(&n, sizeof(n));
+#else
+            if (getrandom(&n, sizeof(n), 0) != sizeof(n)) return false;
+#endif
+            if (n > 1) {
+                out = n;
+                return true;
+            }
+        }
+        return false;
+    }
+    struct Nonblocking {
+        int fd, flags;
+        explicit Nonblocking(int f) : fd(f), flags(fcntl(f, F_GETFL)) {
+            Require(flags >= 0 && fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0,
+                    "cannot set command pipe nonblocking");
