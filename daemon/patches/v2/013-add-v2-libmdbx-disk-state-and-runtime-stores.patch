+void CompleteChecks() {
+    // A synthetic parent owns a large coin solely to isolate complete-block
+    // validation; no fixture claims this coin arose from development genesis.
+    Coin funding;
+    funding.outpoint.tx_id[0] = 7;
+    funding.output = Native(1000000000000000000ULL);
+    funding.creation_height = 0;
+    funding.creation_parent_mtp = 1000;
+    DevelopmentUtxoView view{{funding.outpoint, funding}};
+    IncrementalUtxoSet utxo;
+    Check(utxo.Insert(funding), "funding");
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 94; // AbsoluteTail(DevelopmentGenesis, 2) for synthetic parent.
+    money.prev_work[0] = 2;
+    money.ema_block_cost = 4;
+    Header genesis;
+    genesis.version = 2;
+    genesis.bits = 0x207fffff;
+    genesis.time = 1000;
+    genesis.size = 134;
+    OrdinaryParentContext parent;
+    parent.header = genesis;
+    parent.header.height = 1;
+    parent.header.time = 1120;
+    parent.monetary = money;
+    Check(BlockId({}, genesis, parent.header.prev_id), "genesis id");
+    parent.header.state_root = StateRoot({}, 1, utxo.Root(), money);
+    Hash limit;
+    limit.fill(255);
+    const HeaderChainProfile hp{{}, 2, 1000, 0x207fffff, limit, 172800, 120};
+    OrdinaryCandidateProfile profile{
+        TX,
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 1000000},
+        VmCostProfile{},
+        2,
+        1120,
+        2,
+        3,
+        1000000};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &op : profile.vm_cost.opcode)
+        op = {1, 1, 1};
+    Hash parent_id;
+    Check(BlockId({}, parent.header, parent_id), "parent id");
+    Transaction cb = Coinbase(parent_id, 2), spend = Payment(funding.outpoint);
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(spend, profile, {}, view, effects, error),
+          error);
+    const auto c =
+        AuthenticatedTransactionCosts(cb, TX, view, 2, 1120, 0, COST);
+    const auto s = AuthenticatedTransactionCosts(spend, TX, view, 2, 1120,
+                                                 effects.invocation_cost, COST);
+    const auto resolved_cost = AuthenticatedTransactionCostsResolved(
+        spend, TX, {funding}, 2, 1120, effects.invocation_cost, COST);
+    Check(resolved_cost.account_linear == s.account_linear &&
+              resolved_cost.enforce_linear == s.enforce_linear,
+          "resolved cost matches map oracle");
+    const auto cb_cost = AuthenticatedTransactionCostsResolved(
+        cb, TX, {}, 2, 1120, 0, COST);
+    Check(cb_cost.account_linear == c.account_linear,
+          "coinbase needs no resolved spends");
+    Coin wrong = funding;
+    ++wrong.outpoint.index;
+    for (const auto &coins : std::vector<std::vector<Coin>>{
+             {}, {wrong}, {funding, funding}}) {
+        bool rejected = false;
+        try {
+            AuthenticatedTransactionCostsResolved(
+                spend, TX, coins, 2, 1120, effects.invocation_cost, COST);
+        } catch (const std::invalid_argument &) { rejected = true; }
+        Check(rejected, "reject missing mismatched or surplus cost coins");
+    }
+    std::vector<uint8_t> cbraw, spraw;
+    Check(EncodeTransaction(cb, TX, cbraw, error) &&
+              EncodeTransaction(spend, TX, spraw, error),
+          error);
+    const uint64_t frames =
+        CompactSizeWidth(cbraw.size()) + CompactSizeWidth(spraw.size());
+    const auto cost = BlockEffectiveCost(
+        AuthenticatedEnvelopeCost(frames, 2, COST),
+        {c.account_linear, s.account_linear}, DevelopmentGenesis);
+    const auto record =
+        AccountValidatedOrdinary(spend, effects, TX, DevelopmentGenesis);
+    const auto transition =
+        AdvanceMonetary(DevelopmentGenesis, money, 2, {record}, 0, 0,
+                        cbraw.size(), frames, cost, cost);
+    IncrementalUtxoSet expected;
+    for (const auto &coin : effects.created)
+        Check(expected.Insert(coin), "expected coin");
+    Header child;
+    child.version = 2;
+    child.bits = 0x207fffff;
+    child.height = 2;
+    child.time = 1121;
+    child.prev_id = parent_id;
+    child.state_root = StateRoot({}, 2, expected.Root(), transition.state);
+    auto wire = Wire(child, {cb, spend});
+    Hash target, id;
+    Check(DecodeTarget(child.bits, limit, target), "target");
+    for (;; ++child.nonce) {
+        Check(BlockId({}, child, id), "child id");
+        if (MeetsTarget(id, target)) break;
+    }
+    wire = Wire(child, {cb, spend});
+    TestState stored(view);
+    StagedBlockTransition disk_result;
+    Check(StageCompleteBlock(wire, parent, {parent.header, genesis}, hp, profile,
+                             DevelopmentGenesis, COST, stored, disk_result, error)
+              == CandidateCheckResult::Accepted, error);
+    Check(!stored.aborted && disk_result.utxo_root == expected.Root() &&
+              disk_result.state_root == child.state_root &&
+              EncodeMonetaryState(disk_result.monetary.state) ==
+                  EncodeMonetaryState(transition.state) &&
+              disk_result.invocation_cost == effects.invocation_cost,
+          "storage transition matches oracle roots money and costs");
+    // Header-invalid persistence requires an opaque, exact-body/parent proof.
+    // Reuse the proof output to prove every inconclusive path clears stale
+    // facts.
+    DeterministicBlockFailure proof;
+    auto classified = [&](Header header, std::vector<Transaction> txs,
+                          const OrdinaryCandidateProfile &local,
+                          CandidateCheckResult expected_result,
+                          bool expected_proof) {
+        auto bytes = Wire(header, txs);
+        Hash candidate_target{}, candidate_id{};
+        Check(DecodeTarget(header.bits, limit, candidate_target),
+              "typed target");
+        while (true) {
+            Check(BlockId({}, header, candidate_id), "typed id");
+            if (MeetsTarget(candidate_id, candidate_target)) break;
+            ++header.nonce;
+        }
+        bytes = Wire(header, txs);
+        TestState state(view);
+        StagedBlockTransition untouched;
+        Check(StageCompleteBlock(bytes, parent, {parent.header, genesis}, hp,
+                                 local, DevelopmentGenesis, COST, state,
+                                 untouched, error, &proof) == expected_result,
+              "typed classification: " + error);
+        Check(proof.Valid() == expected_proof, "typed invalid proof presence");
+        if (expected_proof)
+            Check(proof.BlockId() == candidate_id &&
+                      proof.ParentId() == parent_id &&
+                      proof.ParentRoot() == utxo.Root() &&
+                      proof.ProfileDigest() ==
+                          BlockValidationProfileDigest(
+                              hp, local, DevelopmentGenesis, COST),
+                  "typed invalid proof binds exact identity/profile/parent "
+                  "state");
+    };
+    auto overclaim = cb;
+    overclaim.outputs[0].value = UINT64_MAX;
+    classified(child, {overclaim, spend}, profile,
+               CandidateCheckResult::Invalid, true);
+    auto wrong_witness = spend;
+    wrong_witness.inputs[0].witnesses[0].script = {0x66};
+    classified(child, {cb, wrong_witness}, profile,
+               CandidateCheckResult::Invalid, true);
+    auto local_configuration = profile;
+    local_configuration.vm_cost.field_sizes = {{0xe7, {1}}};
+    classified(child, {cb, spend}, local_configuration,
+               CandidateCheckResult::Inconclusive, false);
+    {
+        auto tampered = wire;
+        tampered.back() ^= 0xff;
+        TestState state(view);
+        StagedBlockTransition untouched;
+        Check(StageCompleteBlock(tampered, parent, {parent.header, genesis}, hp,
+                                 profile, DevelopmentGenesis, COST, state,
+                                 untouched, error,
+                                 &proof) == CandidateCheckResult::Invalid &&
+                  !proof.Valid(),
+              "unbound supplied body cannot certify header invalidity");
+    }
+    for (bool write_failure : {false, true}) {
+        TestState failed(view);
+        failed.fail_reads = !write_failure;
+        failed.fail_writes = write_failure;
+        StagedBlockTransition untouched;
+        untouched.block_id[0] = 123;
+        Check(StageCompleteBlock(wire, parent, {parent.header, genesis}, hp, profile,
+                                 DevelopmentGenesis, COST, failed, untouched, error)
+                  == CandidateCheckResult::StorageError,
+              "backend failure is operational");
+        Check(failed.aborted && untouched.block_id[0] == 123,
+              "failed staging aborts without publishing result");
+    }
+    TestState bad_context(view);
+    auto wrong_context = profile;
+    ++wrong_context.parent_mtp;
+    StagedBlockTransition no_context;
+    Check(StageCompleteBlock(wire, parent, {parent.header, genesis}, hp,
+                             wrong_context, DevelopmentGenesis, COST, bad_context,
+                             no_context, error) == CandidateCheckResult::StorageError &&
+              bad_context.aborted, "bad local context is operational");
+    TestState throwing(view);
+    throwing.throw_writes = true;
+    StagedBlockTransition untouched_throw;
+    Check(StageCompleteBlock(wire, parent, {parent.header, genesis}, hp, profile,
+                             DevelopmentGenesis, COST, throwing, untouched_throw, error)
+              == CandidateCheckResult::StorageError && throwing.aborted &&
+              throwing.coins.empty() && throwing.writes == 2,
+          "backend exception after mutation aborts as operational failure");
+#ifdef LOTUS_V2_TEST_DISK
+    char directory[] = "/private/tmp/lotus-v2-disk-block-XXXXXX";
+    Check(mkdtemp(directory) != nullptr, "disk test directory");
+    {
+        DiskStateOptions options;
+        options.cache_bytes = 1024;
+        options.write_buffer_bytes = 64 << 10;
+        options.identity = hp.chain_id;
+        options.profile_digest = BlockValidationProfileDigest(hp, profile, DevelopmentGenesis, COST);
+        DiskStateStore db;
+        DiskStateError failure;
+        Check(DiskStateStore::Open(directory, options, {}, db, failure), failure.message);
+        DiskStateMetadata parent_meta;
+        Check(BlockId({}, parent.header, parent_meta.tip), "stored parent id");
+        std::array<uint8_t, HEADER_SIZE> header_bytes;
+        Check(SerializeHeader(parent.header, header_bytes), "stored parent header");
+        parent_meta.header.assign(header_bytes.begin(), header_bytes.end());
+        const auto monetary_bytes = EncodeMonetaryState(parent.monetary);
+        parent_meta.monetary.assign(monetary_bytes.begin(), monetary_bytes.end());
+        parent_meta.auxiliary = EncodeDiskChainContext({parent.header, genesis}, {});
+        std::vector<Header> recovered;
+        std::vector<uint8_t> recovered_wire;
+        Check(ReadDiskChainContext(parent_meta, hp, recovered, recovered_wire, error) &&
+                  recovered.size() == 2 && recovered_wire.empty(), "initial history recovery");
+        auto corrupt_meta = parent_meta;
+        corrupt_meta.auxiliary[6 + HEADER_SIZE + 4] ^= 1;
+        Check(!ReadDiskChainContext(corrupt_meta, hp, recovered, recovered_wire, error),
+              "corrupted ancestor history rejected");
+        corrupt_meta = parent_meta;
+        corrupt_meta.auxiliary[5] = 12;
+        Check(!ReadDiskChainContext(corrupt_meta, hp, recovered, recovered_wire, error),
+              "oversized history rejected before allocation");
+        corrupt_meta = parent_meta;
+        corrupt_meta.auxiliary.pop_back();
+        Check(!ReadDiskChainContext(corrupt_meta, hp, recovered, recovered_wire, error),
+              "truncated history rejected");
+        {
+            DiskStateTransaction seed;
+            Check(db.Begin(seed, failure) && seed.Insert(funding, failure) &&
+                      seed.Commit(parent_meta, failure), failure.message);
+        }
+        // The stored-context path derives these values; caller leftovers must
+        // neither select another spend clock nor prevent restart validation.
+        auto stale_context = profile;
+        stale_context.candidate_height = 999;
+        stale_context.parent_mtp = 999;
+        StagedBlockTransition durable;
+        auto different_genesis = hp;
+        different_genesis.genesis_id[0] ^= 1;
+        Check(BlockValidationProfileDigest(different_genesis, profile, DevelopmentGenesis, COST) !=
+                  options.profile_digest, "exact genesis participates in storage profile");
+        Check(!db.MatchesProfile(hp.chain_id, BlockValidationProfileDigest(
+                  different_genesis, profile, DevelopmentGenesis, COST)),
+              "stored profile rejects another genesis independently of history");
+        Check(ConnectStoredDiskBlock(wire, different_genesis, profile,
+                  DevelopmentGenesis, COST, db, durable, error) == CandidateCheckResult::StorageError &&
+                  db.Metadata() == parent_meta, "another genesis cannot reuse existing validator state");
+        auto wrong_cost = COST;
+        ++wrong_cost.hash_byte;
+        Check(ConnectDiskBlock(wire, {parent.header, genesis}, hp, profile,
+                               DevelopmentGenesis, wrong_cost, db, durable, error)
+                  == CandidateCheckResult::StorageError && db.Metadata() == parent_meta,
+              "changed validator schedule cannot reuse stored profile");
+        durable.block_id[0] = 77;
+        Check(ConnectEligibleDiskBlock(wire, child.time - 11, 10, hp,
+                                       stale_context, DevelopmentGenesis, COST,
+                                       db, durable,
+                                       error) == DiskBlockAdmission::Deferred,
+              "future admission is deferred, not permanently invalid");
+        Check(db.Metadata() == parent_meta && db.Root() == utxo.Root() &&
+                  durable.block_id[0] == 77,
+              "future deferral leaves exact stored tuple and result unchanged");
+        // Advancing the caller's clock by one second admits the identical bytes
+        // exactly at the explicitly supplied eligibility boundary.
+        Check(ConnectEligibleDiskBlock(wire, child.time - 10, 10, hp,
+                                       stale_context, DevelopmentGenesis, COST,
+                                       db, durable,
+                                       error) == DiskBlockAdmission::Accepted,
+              error);
+        Check(db.Root() == expected.Root() && db.Metadata().tip == durable.block_id &&
+                  ReadDiskChainContext(db.Metadata(), hp, recovered, recovered_wire, error) &&
+                  recovered_wire == wire && recovered.size() == 3,
+              "atomic block bytes, history and tip");
+        db = DiskStateStore{};
+        Check(DiskStateStore::Open(directory, options, {}, db, failure), failure.message);
+        Check(db.Root() == expected.Root() && db.Metadata().tip == durable.block_id,
+              "reopened complete state");
+        Check(ReadDiskChainContext(db.Metadata(), hp, recovered, recovered_wire, error) &&
+                  recovered_wire == wire && recovered.size() == 3,
+              "reopened authenticated history and exact block bytes");
+        Check(db.Disconnect(durable.block_id, failure), failure.message);
+        Check(db.Root() == utxo.Root() && db.Metadata() == parent_meta,
+              "durable disconnect restores exact parent tuple");
+        durable.block_id[0] = 78;
+        Check(ConnectEligibleDiskBlock(wire, child.time - 11, 10, hp,
+                                       stale_context, DevelopmentGenesis, COST,
+                                       db, durable,
+                                       error) == DiskBlockAdmission::Deferred &&
+                  db.Metadata() == parent_meta && db.Root() == utxo.Root() &&
+                  durable.block_id[0] == 78,
+              "backward clock after disconnect defers without state mutation");
+        for (const auto &[now, window] :
+             std::vector<std::pair<uint64_t, uint64_t>>{
+                 {UINT64_MAX, 0}, {UINT64_MAX, UINT64_MAX}, {0, UINT64_MAX}}) {
+            Check(ConnectEligibleDiskBlock(
+                      wire, now, window, hp, stale_context, DevelopmentGenesis,
+                      COST, db, durable, error) == DiskBlockAdmission::Accepted,
+                  "large now/window admission must not overflow");
+            Check(db.Disconnect(durable.block_id, failure) &&
+                      db.Metadata() == parent_meta && db.Root() == utxo.Root(),
+                  "large-clock test restores exact parent tuple");
+        }
+        Check(ConnectEligibleDiskBlock({}, UINT64_MAX, UINT64_MAX, hp,
+                                       stale_context, DevelopmentGenesis, COST,
+                                       db, durable,
+                                       error) == DiskBlockAdmission::Invalid &&
+                  db.Metadata() == parent_meta && db.Root() == utxo.Root(),
+              "malformed wire remains invalid rather than deferred");
+        const std::vector<uint8_t> truncated_header(wire.begin(), wire.begin() + HEADER_SIZE - 1);
+        auto truncated_body = wire;
+        truncated_body.pop_back();
+        for (const auto &invalid_wire : {truncated_header, truncated_body}) {
+            Check(ConnectEligibleDiskBlock(invalid_wire, UINT64_MAX, 0, hp,
+                                           stale_context, DevelopmentGenesis,
+                                           COST, db, durable, error) ==
+                      DiskBlockAdmission::Invalid &&
+                      db.Metadata() == parent_meta && db.Root() == utxo.Root(),
+                  "eligible truncated header/body is invalid without mutation");
+        }
+        auto incompatible_profile = stale_context;
+        ++incompatible_profile.vm.max_steps;
+        Check(ConnectEligibleDiskBlock(wire, UINT64_MAX, 0, hp,
+                                       incompatible_profile, DevelopmentGenesis,
+                                       COST, db, durable, error) ==
+                  DiskBlockAdmission::StorageError &&
+                  db.Metadata() == parent_meta && db.Root() == utxo.Root(),
+              "eligible block with stored profile mismatch is storage error");
+        db = DiskStateStore{};
+        Check(DiskStateStore::Open(directory, options, {}, db, failure), failure.message);
+        Check(db.Metadata() == parent_meta && db.Root() == utxo.Root(),
+              "reopened disconnected parent");
+        Check(ConnectStoredDiskBlock(wire, hp, stale_context,
+                               DevelopmentGenesis, COST, db, durable, error)
+                  == CandidateCheckResult::Accepted, error);
+    }
+    std::filesystem::remove_all(directory);
+#endif
+    const auto before_root = utxo.Root();
+    const auto before_money = EncodeMonetaryState(money);
+    // Invalid absolute anchors are reported through the bool/error API and
+    // must preserve both caller state and the output record.
+    auto invalid_anchor = DevelopmentGenesis;
+    invalid_anchor.genesis_work = {};
+    OrdinaryBlockConnected anchor_rejected;
+    anchor_rejected.state_root[0] = 123;
+    Check(!ConnectCompleteBlock(wire, parent, {parent.header, genesis}, hp,
+                                profile, invalid_anchor, COST, view, utxo,
+                                money, anchor_rejected, error) &&
+              error == "zero genesis work anchor",
+          "invalid anchor returns failure without throwing");
+    Check(utxo.Root() == before_root &&
+              EncodeMonetaryState(money) == before_money && view.size() == 1 &&
+              anchor_rejected.state_root[0] == 123,
+          "invalid anchor preserves caller state and output");
+    // Invalid PoW wins over malformed transaction bytes: no body hashing/VM
+    // or state copying happens before the cheap contextual header gate.
+    Header bad_pow = child;
+    for (;; ++bad_pow.nonce) {
+        Check(BlockId({}, bad_pow, id), "bad pow id");
+        if (!MeetsTarget(id, target)) break;
+    }
+    auto bad_pow_wire = Wire(bad_pow, {cb, spend});
+    bad_pow_wire[139] = 8;
+    OrdinaryBlockConnected pow_rejected;
+    Check(!ConnectCompleteBlock(bad_pow_wire, parent, {parent.header, genesis},
+                                hp, profile, DevelopmentGenesis, COST, view,
+                                utxo, money, pow_rejected, error) &&
+              error == "proof of work",
+          "header gate precedes body decoding");
+    auto reject = [&](Header h, std::vector<Transaction> txs,
+                      const std::string &why) {
+        auto mutated = Wire(h, txs);
+        Hash mutation_target, mutation_id;
+        Check(DecodeTarget(h.bits, limit, mutation_target), "mutation target");
+        for (;; ++h.nonce) {
+            Check(BlockId({}, h, mutation_id), "mutation id");
+            if (MeetsTarget(mutation_id, mutation_target)) break;
+        }
+        mutated = Wire(h, txs);
+        TestState failed(view);
+        StagedBlockTransition untouched;
+        untouched.block_id[0] = 123;
+        Check(StageCompleteBlock(mutated, parent, {parent.header, genesis}, hp,
+                                 profile, DevelopmentGenesis, COST, failed,
+                                 untouched, error) == CandidateCheckResult::Invalid,
+              "storage path rejects same invalid block: " + why);
+        Check(failed.aborted && failed.coins.empty() && untouched.block_id[0] == 123,
+              "invalid staged block discarded");
+        OrdinaryBlockConnected rejected;
+        Check(!ConnectCompleteBlock(mutated, parent, {parent.header, genesis},
+                                    hp, profile, DevelopmentGenesis, COST, view,
+                                    utxo, money, rejected, error),
+              why);
+        Check(utxo.Root() == before_root &&
+                  EncodeMonetaryState(money) == before_money &&
+                  view.size() == 1,
+              "atomic complete rejection");
+    };
+    auto h = child;
+    h.state_root[0] ^= 1;
+    reject(h, {cb, spend}, "state mutation");
+    h = child;
+    h.prev_id[0] ^= 1;
+    reject(h, {cb, spend}, "parent mutation");
+    h = child;
+    h.bits = 0x207ffffe;
+    reject(h, {cb, spend}, "required target mutation");
+    h = child;
+    h.version++;
+    reject(h, {cb, spend}, "version mutation");
+    auto invalidcb = cb;
+    invalidcb.inputs[0].prev_txid[0] ^= 1;
+    reject(child, {invalidcb, spend}, "coinbase parent mutation");
+    invalidcb = cb;
+    invalidcb.inputs[0].prev_index++;
+    reject(child, {invalidcb, spend}, "coinbase height mutation");
+    auto invalidspend = spend;
+    invalidspend.inputs[0].witnesses[0].script = {0x4d};
+    reject(child, {cb, invalidspend}, "script mutation");
+    OrdinaryBlockConnected connected;
+    Check(ConnectCompleteBlock(wire, parent, {parent.header, genesis}, hp,
+                               profile, DevelopmentGenesis, COST, view, utxo,
+                               money, connected, error),
+          error);
+    Check(connected.state_root == child.state_root &&
+              connected.monetary_bytes == EncodeMonetaryState(transition.state),
+          "complete roots and EMA");
+    Check(connected.monetary.total_fees ==
+                  record.native_inputs - record.native_outputs &&
+              connected.monetary.required_underclaim >= 240,
+          "complete fees and coinbase charge");
+    Check(DisconnectOrdinaryBlock(connected.undo, view, utxo, money, error),
+          error);
+    Check(utxo.Root() == before_root &&
+              EncodeMonetaryState(money) == before_money,
+          "full undo");
+    std::cout << "synthetic complete costs " << c.account_linear << " "
+              << s.account_linear << " " << cost << "\n";
+}
+} // namespace
+int main() {
+    try {
+        WireChecks();
+        CompleteChecks();
+#ifdef LOTUS_V2_TEST_DISK
+        DiskHistoryRolloverChecks();
+#endif
+        std::cout << "complete block checks passed\n";
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << "\n";
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_block_dev_coinbase.cpp b/src/lotus_v2/test_block_dev_coinbase.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bb0bb635d95229fb5ddf5beb8b47464e0588ee0f
--- /dev/null
+++ b/src/lotus_v2/test_block_dev_coinbase.cpp
@@ -0,0 +1,497 @@
+// Copyright (c) 2026 The Lotus developers
+// Development-profile coinbase candidate. Not lotusd ConnectTip and not a
+// frozen mainnet entitlement. Nonce stays 0. This file does not mine.
+#include "block.h"
+
+#include "dev_genesis.h"
+#include "header.h"
+#include "signing.h"
+
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+constexpr uint64_t kBurnValue = 10;
+constexpr uint64_t kFundingValue = 50000;
+constexpr uint64_t kPaymentValue = 1000;
+
+MonetaryInteger WorkOf(const Hash &work) {
+    MonetaryInteger value = 0;
+    for (size_t i = work.size(); i > 0; --i) {
+        value <<= 8;
+        value += work[i - 1];
+    }
+    return value;
+}
+
+bool SameTransition(const MonetaryTransition &a, const MonetaryTransition &b) {
+    return a.bootstrap_issued == b.bootstrap_issued && a.subsidy == b.subsidy &&
+           a.total_fees == b.total_fees && a.token_burn == b.token_burn &&
+           a.burned_fees == b.burned_fees &&
+           a.required_underclaim == b.required_underclaim &&
+           a.actual_underclaim == b.actual_underclaim &&
+           a.spendable_supply_delta == b.spendable_supply_delta &&
+           a.state.bootstrap_reserve == b.state.bootstrap_reserve &&
+           a.state.tail_subsidy == b.state.tail_subsidy &&
+           a.state.prev_work == b.state.prev_work &&
+           a.state.ema_block_cost == b.state.ema_block_cost;
+}
+
+Output Native(uint64_t value) {
+    Output output;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    return output;
+}
+
+Output Burn(uint64_t value) {
+    Output output;
+    output.flags = 2;
+    output.value = value;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    return output;
+}
+
+Transaction MakeCoinbase(uint64_t pay, uint64_t burn, const Hash &parent_id,
+                         uint64_t height) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = parent_id;
+    Check(height <= std::numeric_limits<uint32_t>::max(), "coinbase height width");
+    input.prev_index = static_cast<uint32_t>(height);
+    input.sequence = UINT32_MAX;
+    input.flags = 2;
+    tx.inputs.push_back(input);
+    tx.outputs.push_back(Native(pay));
+    tx.outputs.push_back(Burn(burn));
+    return tx;
+}
+
+Transaction Payment(const Outpoint &spent, uint64_t value) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{TRUE_SCRIPT, {}, {}}};
+    tx.inputs.push_back(input);
+    tx.outputs.push_back(Native(value));
+    return tx;
+}
+
+OrdinaryCandidateProfile MakeProfile(const Header &parent) {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, parent.height + 1, parent.time, 2, 3, 1000000};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+struct World {
+    DevelopmentGenesisFixture genesis;
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary;
+    OrdinaryParentContext parent;
+    std::array<uint8_t, 56> monetary_bytes{};
+    Hash utxo_root{};
+    Coin funding{};
+    bool funded = false;
+};
+
+World MakeEmpty() {
+    World world;
+    Check(MakeDevelopmentGenesis({}, 0, world.genesis), "development genesis");
+    world.monetary = world.genesis.state;
+    world.parent.header = world.genesis.header;
+    world.parent.chain_id = kDevelopmentChainId;
+    world.parent.monetary = world.monetary;
+    world.monetary_bytes = EncodeMonetaryState(world.monetary);
+    world.utxo_root = world.utxo.Root();
+    Check(world.parent.header.nonce == 0 && world.parent.header.height == 0,
+          "genesis header nonce or height");
+    Check(world.utxo_root == EmptyUtxoRoot(), "genesis utxo root is not empty");
+    Check(world.parent.header.state_root ==
+              StateRoot(kDevelopmentChainId, 0, world.utxo_root, world.monetary),
+          "genesis state root");
+    Check(world.monetary_bytes == EncodeMonetaryState(world.genesis.state),
+          "genesis monetary bytes");
+    return world;
+}
+
+World MakeFunded() {
+    World world = MakeEmpty();
+    world.funding.outpoint.tx_id[0] = 0x71;
+    world.funding.outpoint.index = 3;
+    world.funding.output = Native(kFundingValue);
+    world.funding.creation_height = 0;
+    world.funding.creation_parent_mtp = world.parent.header.time;
+    world.funding.coinbase = false;
+    Check(world.view.emplace(world.funding.outpoint, world.funding).second &&
+              world.utxo.Insert(world.funding),
+          "funding coin");
+    world.parent.header.state_root =
+        StateRoot(world.parent.chain_id, world.parent.header.height,
+                  world.utxo.Root(), world.monetary);
+    world.utxo_root = world.utxo.Root();
+    world.funded = true;
+    Check(world.utxo_root != EmptyUtxoRoot(), "funded root is empty");
+    Check(EncodeMonetaryState(world.monetary) ==
+              EncodeMonetaryState(world.genesis.state),
+          "funding changed genesis monetary bytes");
+    return world;
+}
+
+void ExpectParent(const World &world) {
+    Check(world.utxo.Root() == world.utxo_root, "parent utxo root changed");
+    Check(EncodeMonetaryState(world.monetary) == world.monetary_bytes,
+          "parent monetary bytes changed");
+    if (!world.funded) {
+        Check(world.view.empty() && world.utxo_root == EmptyUtxoRoot(),
+              "empty utxo root changed");
+    } else {
+        Check(world.view.size() == 1 &&
+                  world.view.count(world.funding.outpoint) == 1 &&
+                  !world.view.begin()->second.coinbase,
+              "funded parent view changed");
+    }
+}
+
+struct MeasuredPayment {
+    Transaction tx;
+    MonetaryOrdinaryTx accounted;
+    uint64_t cost = 0;
+};
+
+MeasuredPayment MeasurePayment(const World &world,
+                               const OrdinaryCandidateProfile &profile) {
+    MeasuredPayment measured;
+    measured.tx = Payment(world.funding.outpoint, kPaymentValue);
+    Check(measured.tx.inputs.size() == 1 &&
+              measured.tx.inputs[0].witnesses.size() == 1 &&
+              measured.tx.inputs[0].witnesses[0].script == TRUE_SCRIPT &&
+              TRUE_SCRIPT.size() == 1 && TRUE_SCRIPT[0] == 0x4e,
+          "ordinary payment is not OP_TRUE");
+    OrdinaryCandidateEffects effects;
+    std::string error;
+    Check(CheckOrdinaryCandidate(measured.tx, profile, world.parent.chain_id,
+                                 world.view, effects, error),
+          "measure payment: " + error);
+    Check(effects.invocation_cost <= std::numeric_limits<uint64_t>::max(),
+          "payment cost width");
+    measured.cost = static_cast<uint64_t>(effects.invocation_cost);
+    measured.accounted = AccountValidatedOrdinary(
+        measured.tx, effects, profile.transaction, DevelopmentGenesis);
+    return measured;
+}
+
+uint64_t EncodedSize(const Transaction &tx, const TxProfile &profile) {
+    std::vector<uint8_t> wire;
+    std::string error;
+    Check(EncodeTransaction(tx, profile, wire, error), "encode coinbase: " + error);
+    return static_cast<uint64_t>(wire.size());
+}
+
+std::optional<uint64_t> PayableOutput(const MonetaryState &parent,
+                                      const std::vector<MonetaryOrdinaryTx> &txs,
+                                      uint64_t coinbase_bytes, uint64_t cost) {
+    try {
+        const MonetaryTransition probe = AdvanceMonetary(
+            DevelopmentGenesis, parent, WorkOf(parent.prev_work), txs, 0, 0,
+            coinbase_bytes, 0, cost, cost);
+        const MonetaryInteger allowed =
+            probe.actual_underclaim - probe.required_underclaim;
+        if (allowed <= kBurnValue ||
+            allowed - kBurnValue > std::numeric_limits<uint64_t>::max())
+            return std::nullopt;
+        return (allowed - kBurnValue).convert_to<uint64_t>();
+    } catch (const std::invalid_argument &) {
+        return std::nullopt;
+    }
+}
+
+struct CoinbasePlan {
+    Transaction tx;
+    uint64_t bytes = 0;
+    uint64_t pay = 0;
+    MonetaryTransition expected;
+    Outpoint coin{};
+    Outpoint burn{};
+};
+
+Hash ParentBlockId(const ChainId &chain, const Header &header) {
+    Hash id{};
+    Check(BlockId(chain, header, id), "parent block id");
+    return id;
+}
+
+CoinbasePlan PlanCoinbase(const MonetaryState &parent, const TxProfile &tx_profile,
+                          const ChainId &chain, const Header &header,
+                          const std::vector<MonetaryOrdinaryTx> &txs,
+                          uint64_t cost, uint64_t pay) {
+    CoinbasePlan plan;
+    plan.tx = MakeCoinbase(pay, kBurnValue, ParentBlockId(chain, header),
+                           header.height + 1);
+    plan.bytes = EncodedSize(plan.tx, tx_profile);
+    Check(EncodedSize(MakeCoinbase(pay + 1, kBurnValue, plan.tx.inputs[0].prev_txid,
+                                   plan.tx.inputs[0].prev_index),
+                      tx_profile) == plan.bytes,
+          "coinbase value changed the wire size");
+    plan.pay = pay;
+    plan.expected = AdvanceMonetary(
+        DevelopmentGenesis, parent, WorkOf(parent.prev_work), txs,
+        MonetaryInteger{pay} + kBurnValue, kBurnValue, plan.bytes, 0, cost, cost);
+    std::string error;
+    IdentityDigests ids;
+    Check(ComputeIdentities(plan.tx, tx_profile, chain, ids, error),
+          "coinbase identity: " + error);
+    plan.coin = Outpoint{ids.txid, 0};
+    plan.burn = Outpoint{ids.txid, 1};
+    return plan;
+}
+
+bool Connect(World &world, const std::vector<Transaction> &txs,
+             const OrdinaryCandidateProfile &profile,
+             OrdinaryBlockConnected &connected, std::string &error) {
+    return ConnectOrdinaryBlock(txs, world.parent, profile, DevelopmentGenesis,
+                                world.view, world.utxo, world.monetary, connected,
+                                error);
+}
+
+void ExpectCoinbaseCoin(const World &world, const OrdinaryCandidateProfile &profile,
+                        const CoinbasePlan &plan) {
+    const auto found = world.view.find(plan.coin);
+    Check(found != world.view.end(), "coinbase coin was not created");
+    const Coin &coin = found->second;
+    Check(coin.coinbase && coin.creation_height == profile.candidate_height &&
+              coin.creation_parent_mtp == profile.parent_mtp &&
+              coin.output.value == plan.pay &&
+              coin.output.branches == plan.tx.outputs[0].branches &&
+              coin.output.paths == plan.tx.outputs[0].paths &&
+              !coin.output.IsBurn(),
+          "coinbase coin fields");
+    Check(world.view.find(plan.burn) == world.view.end(),
+          "burn output was inserted");
+}
+
+void AcceptCoinbase(World &world, const OrdinaryCandidateProfile &profile,
+                    const std::vector<Transaction> &txs, const CoinbasePlan &plan) {
+    OrdinaryBlockConnected connected;
+    std::string error;
+    Check(Connect(world, txs, profile, connected, error),
+          "payable coinbase rejected: " + error);
+    ExpectCoinbaseCoin(world, profile, plan);
+    Check(SameTransition(connected.monetary, plan.expected),
+          "coinbase transition does not match AdvanceMonetary");
+    Check(connected.monetary_bytes == EncodeMonetaryState(plan.expected.state) &&
+              connected.monetary_bytes == EncodeMonetaryState(world.monetary),
+          "coinbase monetary bytes");
+    Check(DisconnectOrdinaryBlock(connected.undo, world.view, world.utxo,
+                                  world.monetary, error),
+          "disconnect coinbase: " + error);
+    Check(world.view.find(plan.coin) == world.view.end(),
+          "disconnect left the coinbase coin");
+    ExpectParent(world);
+    Check(EncodeMonetaryState(world.monetary) ==
+              EncodeMonetaryState(world.genesis.state),
+          "disconnect did not restore genesis monetary bytes");
+}
+
+void RejectOverclaim(World world, const OrdinaryCandidateProfile &profile,
+                     const std::vector<Transaction> &txs) {
+    OrdinaryBlockConnected discarded;
+    std::string error;
+    Check(!Connect(world, txs, profile, discarded, error),
+          "overclaim coinbase was accepted");
+    Check(error == "coinbase overclaim", "overclaim error: " + error);
+    ExpectParent(world);
+}
+
+void RejectPosition(World world, const std::vector<Transaction> &txs) {
+    const OrdinaryCandidateProfile profile = MakeProfile(world.parent.header);
+    OrdinaryBlockConnected discarded;
+    std::string error;
+    Check(!Connect(world, txs, profile, discarded, error),
+          "misplaced coinbase was accepted");
+    Check(error == "coinbase position", "position error: " + error);
+    ExpectParent(world);
+}
+
+void SameBlockSpendRollsBack() {
+    World world = MakeEmpty();
+    const OrdinaryCandidateProfile profile = MakeProfile(world.parent.header);
+    Transaction coinbase = MakeCoinbase(
+        5000, kBurnValue, ParentBlockId(world.parent.chain_id, world.parent.header),
+        profile.candidate_height);
+    std::string error;
+    IdentityDigests ids;
+    Check(ComputeIdentities(coinbase, profile.transaction, world.parent.chain_id,
+                            ids, error),
+          "same-block identity: " + error);
+    const Transaction spend = Payment(Outpoint{ids.txid, 0}, 1000);
+    OrdinaryBlockConnected discarded;
+    Check(!Connect(world, {coinbase, spend}, profile, discarded, error),
+          "same-block coinbase spend was accepted");
+    Check(error == "coinbase maturity or future coin",
+          "same-block spend error: " + error);
+    ExpectParent(world);
+}
+
+void OrdinaryZeros() {
+    World world = MakeFunded();
+    const OrdinaryCandidateProfile profile = MakeProfile(world.parent.header);
+    const MeasuredPayment payment = MeasurePayment(world, profile);
+    const MonetaryState parent = world.monetary;
+    const MonetaryTransition full_entitlement = AdvanceMonetary(
+        DevelopmentGenesis, parent, WorkOf(parent.prev_work), {payment.accounted},
+        0, 0, 0, 0, payment.cost, payment.cost);
+    OrdinaryBlockConnected connected;
+    std::string error;
+    Check(Connect(world, {payment.tx}, profile, connected, error),
+          "ordinary payment rejected: " + error);
+    Check(connected.monetary.actual_underclaim == full_entitlement.actual_underclaim,
+          "ordinary actual_underclaim is not the full entitlement");
+    Check(connected.monetary.required_underclaim ==
+              full_entitlement.required_underclaim,
+          "ordinary block did not pass zero coinbase fields");
+    Check(SameTransition(connected.monetary, full_entitlement),
+          "ordinary transition");
+    Check(world.view.count(world.funding.outpoint) == 0, "payment did not spend");
+}
+
+void RunPayable(bool bare) {
+    World world = bare ? MakeEmpty() : MakeFunded();
+    const OrdinaryCandidateProfile profile = MakeProfile(world.parent.header);
+    std::vector<MonetaryOrdinaryTx> txs;
+    std::vector<Transaction> block;
+    uint64_t cost = 0;
+    std::optional<MeasuredPayment> payment;
+    if (!bare) {
+        payment = MeasurePayment(world, profile);
+        txs.push_back(payment->accounted);
+        cost = payment->cost;
+    }
+    const uint64_t bytes = EncodedSize(
+        MakeCoinbase(1, kBurnValue,
+                     ParentBlockId(world.parent.chain_id, world.parent.header),
+                     profile.candidate_height),
+        profile.transaction);
+    const std::optional<uint64_t> pay =
+        PayableOutput(world.monetary, txs, bytes, cost);
+    Check(pay.has_value(), bare ? "bare coinbase is not payable"
+                                : "fee-funded coinbase is not payable");
+    const CoinbasePlan plan =
+        PlanCoinbase(world.monetary, profile.transaction, world.parent.chain_id,
+                     world.parent.header, txs, cost, *pay);
+    Check(plan.bytes == bytes, "planned coinbase bytes drifted");
+    block.push_back(plan.tx);
+    if (payment) block.push_back(payment->tx);
+    AcceptCoinbase(world, profile, block, plan);
+
+    World rejected = bare ? MakeEmpty() : MakeFunded();
+    Transaction too_much = plan.tx;
+    too_much.outputs[0].value = *pay + 1;
+    std::vector<Transaction> over{too_much};
+    if (payment) over.push_back(payment->tx);
+    RejectOverclaim(std::move(rejected), profile, over);
+}
+
+void EmptyRejections() {
+    World not_first = MakeEmpty();
+    const OrdinaryCandidateProfile profile = MakeProfile(not_first.parent.header);
+    Transaction ordinary = Payment(Outpoint{}, 1);
+    ordinary.inputs[0].prev_txid[0] = 0x44;
+    const Hash parent_id =
+        ParentBlockId(not_first.parent.chain_id, not_first.parent.header);
+    RejectPosition(std::move(not_first),
+                   {ordinary, MakeCoinbase(1, kBurnValue, parent_id, profile.candidate_height)});
+    World second = MakeEmpty();
+    const Hash second_id = ParentBlockId(second.parent.chain_id, second.parent.header);
+    RejectPosition(std::move(second),
+                   {MakeCoinbase(1, kBurnValue, second_id, profile.candidate_height),
+                    MakeCoinbase(1, kBurnValue, second_id, profile.candidate_height)});
+
+    World funded = MakeFunded();
+    const MeasuredPayment payment = MeasurePayment(funded, profile);
+    const uint64_t bytes = EncodedSize(
+        MakeCoinbase(1, kBurnValue,
+                     ParentBlockId(funded.parent.chain_id, funded.parent.header),
+                     profile.candidate_height),
+        profile.transaction);
+    const std::optional<uint64_t> pay = PayableOutput(
+        funded.monetary, {payment.accounted}, bytes, payment.cost);
+    Check(pay.has_value(), "position fixture is not payable");
+    const CoinbasePlan plan = PlanCoinbase(
+        funded.monetary, profile.transaction, funded.parent.chain_id,
+        funded.parent.header, {payment.accounted}, payment.cost, *pay);
+    RejectPosition(std::move(funded), {payment.tx, plan.tx});
+}
+} // namespace
+
+int main() {
+    try {
+        World probe = MakeEmpty();
+        const OrdinaryCandidateProfile profile = MakeProfile(probe.parent.header);
+        const uint64_t bytes = EncodedSize(
+            MakeCoinbase(1, kBurnValue,
+                         ParentBlockId(probe.parent.chain_id, probe.parent.header),
+                         profile.candidate_height),
+            profile.transaction);
+        const bool bare =
+            PayableOutput(probe.monetary, {}, bytes, 0).has_value();
+        RunPayable(bare);
+        if (!bare) {
+            World empty = MakeEmpty();
+            Transaction coinbase = MakeCoinbase(
+                1, kBurnValue, ParentBlockId(empty.parent.chain_id, empty.parent.header),
+                profile.candidate_height);
+            OrdinaryBlockConnected discarded;
+            std::string error;
+            Check(!Connect(empty, {coinbase}, profile, discarded, error),
+                  "unpayable bare coinbase was accepted");
+            ExpectParent(empty);
+        }
+        EmptyRejections();
+        SameBlockSpendRollsBack();
+        OrdinaryZeros();
+        World unbound = MakeEmpty();
+        Transaction wrong_parent = MakeCoinbase(
+            1, kBurnValue, Hash{}, profile.candidate_height);
+        OrdinaryBlockConnected discarded;
+        std::string error;
+        Check(!Connect(unbound, {wrong_parent}, profile, discarded, error),
+              "zero parent id was accepted");
+        Check(error == "coinbase parent/height", "parent id error: " + error);
+        ExpectParent(unbound);
+        Transaction wrong_height = MakeCoinbase(
+            1, kBurnValue, ParentBlockId(unbound.parent.chain_id, unbound.parent.header),
+            unbound.parent.header.height);
+        Check(!Connect(unbound, {wrong_height}, profile, discarded, error),
+              "parent height was accepted as the candidate height");
+        Check(error == "coinbase parent/height", "height error: " + error);
+        ExpectParent(unbound);
+        std::cout << "development coinbase candidate checks passed\n";
+        return 0;
+    } catch (const std::exception &failure) {
+        std::cerr << failure.what() << '\n';
+        return 1;
+    }
+}
