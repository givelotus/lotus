+Output Pay() {
+    Output o;
+    o.value = UINT64_MAX;
+    for (uint8_t n = 1; n <= 16; ++n) o.branches.push_back(H(n));
+    for (uint8_t n = 0; n < 16; ++n) o.paths.push_back({n});
+    return o;
+}
+Transaction Coinbase(bool present) {
+    Transaction tx;
+    Input i;
+    i.flags = 2;
+    i.prev_index = UINT32_MAX;
+    i.sequence = UINT32_MAX;
+    i.has_coinbase_data = present;
+    if (present) i.coinbase_data.assign(8192, 0xab);
+    tx.inputs.push_back(i);
+    tx.outputs.push_back(Pay());
+    return tx;
+}
+ChronikBlock Convert(std::vector<Transaction> txs, const TxProfile &profile,
+                     const ChainId &chain, std::vector<uint8_t> &wire,
+                     Header &header) {
+    std::string error;
+    Check(CompleteTransactionRoot(txs, profile, chain, header.tx_root, error), error);
+    header.size = HEADER_SIZE + 4;
+    for (const auto &tx : txs) {
+        std::vector<uint8_t> encoded;
+        Check(EncodeTransaction(tx, profile, encoded, error), error);
+        header.size += CompactSizeWidth(encoded.size()) + encoded.size();
+    }
+    Check(EncodeBlockWire(header, txs, profile, wire, error), error);
+    ChronikAnchor anchor{{}, header.height};
+    Check(BlockId(chain, header, anchor.block_id), "native block id");
+    ChronikBlock converted;
+    Check(MakeChronikBlock(wire, chain, profile, anchor, converted, error), error);
+    Check(std::equal(converted.header_wire.begin(), converted.header_wire.end(),
+                     wire.begin()), "exact 134-byte source header");
+    Header parsed;
+    Check(ParseHeader(converted.header_wire.data(), 134, parsed), "header parse");
+    Check(parsed.tx_root == header.tx_root && parsed.height == header.height &&
+              parsed.prev_id == header.prev_id && parsed.size == wire.size() &&
+              parsed.time == header.time && parsed.bits == header.bits &&
+              parsed.nonce == header.nonce && parsed.version == header.version &&
+              parsed.state_root == header.state_root, "all exact header fields");
+    std::vector<TxIdentityPair> pairs;
+    for (size_t n = 0; n < txs.size(); ++n) {
+        const auto &record = converted.transactions[n];
+        std::vector<uint8_t> encoded;
+        Check(EncodeTransaction(txs[n], profile, encoded, error), error);
+        Check(record.wire == encoded && record.index == n &&
+                  record.lock == txs[n].lock, "exact complete frame/ordinal/lock");
+        IdentityDigests identity;
+        Check(ComputeIdentities(txs[n], profile, chain, identity, error), error);
+        Check(record.txid == identity.txid && record.txhash == identity.txhash &&
+                  record.txid != record.txhash, "distinct native identities");
+        pairs.push_back({record.txhash, record.txid});
+        for (size_t out = 0; out < txs[n].outputs.size(); ++out) {
+            Output o;
+            Check(DecodeOutput(record.outputs[out], o, error), error);
+            Check(o.branches == txs[n].outputs[out].branches &&
+                      o.paths == txs[n].outputs[out].paths &&
+                      o.value == txs[n].outputs[out].value &&
+                      o.flags == txs[n].outputs[out].flags &&
+                      (!o.HasToken() || o.token_id == txs[n].outputs[out].token_id),
+                  "all ordered branches/paths and output fields");
+        }
+    }
+    Hash root;
+    Check(TransactionRoot(pairs, root) && root == header.tx_root,
+          "ordered native transaction root parity");
+    if (pairs.size() > 1) {
+        std::reverse(pairs.begin(), pairs.end());
+        Check(TransactionRoot(pairs, root) && root != header.tx_root,
+              "transaction order bound by root");
+    }
+    auto sentinel = converted;
+    auto changed = wire;
+    changed.back() ^= 1;
+    Check(!MakeChronikBlock(changed, chain, profile, anchor, converted, error) &&
+              converted.header_wire == sentinel.header_wire &&
+              converted.transactions.back().wire == sentinel.transactions.back().wire,
+          "changed authenticated frame rejected atomically");
+    ++anchor.height;
+    Check(!MakeChronikBlock(wire, chain, profile, anchor, converted, error),
+          "anchor height authenticated");
+    return sentinel;
+}
+} // namespace
+int main() {
+    try {
+        const TxProfile profile{65535, 65535, 65535, 65536, 65535, 8192, 64};
+        const ChainId chain = H(0x55);
+        Header h;
+        h.bits = 0x207fffff;
+        h.time = MAX_TIME;
+        h.nonce = UINT64_MAX;
+        h.version = UINT32_MAX;
+        h.state_root = H(0x99);
+        std::vector<uint8_t> block_wire;
+        for (const bool present : {false, true}) {
+            const auto block = Convert({Coinbase(present)}, profile, chain, block_wire, h);
+            Check(block.parent.block_id == Hash{} && block.parent.height == 0,
+                  "native genesis retains zero predecessor");
+            const auto &tx = block.transactions.front();
+            const auto &input = tx.full_inputs.front();
+            Check(input.flags == 2 && input.prev_index == UINT32_MAX &&
+                      input.sequence == UINT32_MAX && input.path_index == 0 &&
+                      input.has_coinbase_data == present && input.witnesses.empty(),
+                  "coinbase core selectors");
+            Check(present ? input.coinbase_data == ChronikWireRange{61, 8192}
+                          : input.coinbase_data == ChronikWireRange{},
+                  "coinbase exact payload offset and absence");
+            if (present) Check(Slice(tx.wire, input.coinbase_data) ==
+                                   std::vector<uint8_t>(8192, 0xab), "coinbase bytes");
+        }
+        Transaction tx;
+        tx.lock = (UINT64_MAX & ~uint64_t{255}) | 2;
+        Input mint;
+        mint.flags = 3;
+        mint.prev_txid = H(0xa1);
+        mint.sequence = UINT32_MAX;
+        BranchWitness m;
+        m.script = {0x11};
+        m.siblings = {H(0xa2)};
+        m.arguments = {{0x12}, {}};
+        mint.witnesses = {m};
+        Input spend;
+        spend.flags = 1;
+        spend.prev_txid = H(0xb1);
+        spend.prev_index = UINT32_MAX;
+        spend.sequence = UINT32_MAX;
+        spend.path_index = 15;
+        BranchWitness w;
+        w.script.assign(32768, 0x22);
+        w.siblings.assign(64, H(0xb2));
+        w.arguments.assign(253, std::vector<uint8_t>(253, 0x33));
+        spend.witnesses = {w, BranchWitness{}};
+        tx.inputs = {mint, spend};
+        tx.outputs = {Pay()};
+        auto token = Pay();
+        token.flags = 1;
+        token.token_id = mint.prev_txid;
+        tx.outputs.push_back(token);
+        Output burn;
+        burn.flags = 3;
+        burn.value = 7;
+        burn.token_id = mint.prev_txid;
+        burn.branches = {H(0xdd)};
+        tx.outputs.push_back(burn);
+        h.prev_id = H(0xcc);
+        h.height = UINT64_MAX;
+        const auto block = Convert({Coinbase(false), tx}, profile, chain, block_wire, h);
+        Check(block.parent.height == UINT64_MAX - 1 &&
+                  block.parent.block_id == h.prev_id, "maximum parent height");
+        const auto &record = block.transactions[1];
+        Check(record.inputs.size() == 1 && record.inputs[0].input_index == 1 &&
+                  record.full_inputs.size() == 2 && record.full_inputs[0].flags == 3 &&
+                  record.full_inputs[1].flags == 1 &&
+                  record.full_inputs[1].path_index == 15 &&
+                  record.full_inputs[1].prev_index == UINT32_MAX,
+              "mint selector plus nonzero spend ordinal");
+        const auto &mw = record.full_inputs[0].witnesses[0];
+        Check(mw.script == ChronikWireRange{58, 1} &&
+                  mw.siblings_table == ChronikWireRange{59, 33} &&
+                  mw.arguments_table == ChronikWireRange{92, 4} &&
+                  mw.siblings_count == 1 && mw.arguments_count == 2,
+              "exact mint witness table framing offsets");
+        Check(Slice(record.wire, mw.arguments_table) ==
+                  std::vector<uint8_t>({2, 1, 0x12, 0}), "mint arguments bytes");
+        const auto &sw = record.full_inputs[1].witnesses[0];
+        Check(sw.script == ChronikWireRange{142, 32768} &&
+                  sw.siblings_table == ChronikWireRange{32910, 2049} &&
+                  sw.arguments_table == ChronikWireRange{34959, 64771} &&
+                  sw.siblings_count == 64 && sw.arguments_count == 253,
+              "chunk crossing payload and multi-byte argument framing");
+        Check(Slice(record.wire, sw.script) == w.script, "full script byte parity");
+        const auto siblings = Slice(record.wire, sw.siblings_table);
+        Check(siblings.front() == 64 && siblings.size() == 2049 &&
+                  std::all_of(siblings.begin() + 1, siblings.end(),
+                              [](uint8_t b) { return b == 0xb2; }), "proof table bytes");
+        const auto args = Slice(record.wire, sw.arguments_table);
+        Check(args[0] == 253 && args[1] == 253 && args[2] == 0 &&
+                  args[3] == 253 && args[4] == 253 && args[5] == 0,
+              "canonical arguments count/element prefixes");
+        const auto &empty = record.full_inputs[1].witnesses[1];
+        Check(empty.script.length == 0 && empty.script.offset == 99731 &&
+                  empty.siblings_table == ChronikWireRange{99731, 1} &&
+                  empty.arguments_table == ChronikWireRange{99732, 1},
+              "empty script preserves offset and empty tables preserve framing");
+        std::string error;
+        std::vector<uint8_t> kept{0xee};
+        std::vector<ChronikFullInput> facts(1);
+        for (size_t cut : {size_t(0), size_t(16), record.wire.size() - 1}) {
+            Check(!MakeChronikExplorerFacts(tx, profile,
+                    std::span<const uint8_t>(record.wire).first(cut), kept, facts, error) &&
+                      kept == std::vector<uint8_t>{0xee} && facts.size() == 1,
+                  "short exact frame refuses partial facts");
+        }
+        auto strict = profile;
+        strict.max_arguments = 252;
+        Check(!MakeChronikExplorerFacts(tx, strict, record.wire, kept, facts, error),
+              "profile count cap before descriptor vectors");
+        auto malformed = record.wire;
+        malformed.push_back(0);
+        Check(!MakeChronikExplorerFacts(tx, profile, malformed, kept, facts, error),
+              "extra source bytes refused");
+        std::cout << "chronik explorer producer checks passed\n";
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_chronik_sync.cpp b/src/lotus_v2/test_chronik_sync.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3c3fa29cadea0b68eb3b779806fb438734d57fc8
--- /dev/null
+++ b/src/lotus_v2/test_chronik_sync.cpp
@@ -0,0 +1,162 @@
+// Copyright (c) 2026 The Lotus developers
+#include "chronik_sync.h"
+#include "development_runtime_test/fixtures.h"
+#include <iostream>
+using namespace lotus::v2;
+using namespace runtime_fixture;
+DevelopmentRuntimeConfig Config(Home &home) {
+    DevelopmentRuntimeConfig config;
+    config.directory = home.path;
+    config.genesis_wire = Bytes(genesis_wire);
+    config.profiles = home.p;
+    config.initial_money = DecodeMonetaryState(Bytes(initial_money));
+    config.storage.cache_bytes = 1024;
+    config.storage.write_buffer_bytes = 64 << 10;
+    config.storage.recovery = DiskRecoveryOptions{32 << 20, 4 << 20};
+    config.storage.candidates = CandidateStoreOptions{64, 64, 8};
+    config.storage.env = home.env;
+    config.bodies = {3, 1 << 20, 3 << 20, 3, 3 << 20, 64};
+    config.initial_body_epoch = 1;
+    config.initial_context_generation = 1;
+    return config;
+}
+
+struct Sink : ChronikSink {
+    std::vector<ChronikBlock> chain;
+    size_t disconnects{};
+    bool fail{};
+    std::optional<ChronikAnchor> Checkpoint() override {
+        if (fail) throw std::runtime_error("sink failure");
+        return chain.empty() ? std::nullopt
+                             : std::optional(chain.back().anchor);
+    }
+    void Initialize(const ChronikBlock &b) override {
+        Check(chain.empty() && b.anchor.height == 0, "genesis");
+        chain.push_back(b);
+    }
+    void Connect(const ChronikBlock &b) override {
+        Check(!chain.empty() && b.parent == chain.back().anchor,
+              "parent exact");
+        chain.push_back(b);
+    }
+    void Disconnect(const ChronikAnchor &a) override {
+        Check(chain.back().anchor == a && a.height > 0, "disconnect exact");
+        chain.pop_back();
+        ++disconnects;
+    }
+};
+size_t Run(Home &home, Sink &sink) {
+    home.store = {};
+    std::unique_ptr<DevelopmentRuntime> runtime;
+    std::string error;
+    Check(DevelopmentRuntime::Open(Config(home), runtime, error), error);
+    ChronikSync sync(*runtime, sink, home.p.header.chain_id,
+                     home.p.ordinary.transaction, 1 << 20);
+    size_t count{};
+    for (;;) {
+        const auto result = sync.Step(error);
+        Check(result == ChronikSyncResult::Progress ||
+                  result == ChronikSyncResult::Ready,
+              error);
+        Check(++count < 100, "bounded progress");
+        if (result == ChronikSyncResult::Ready) break;
+    }
+    const auto original = runtime->Snapshot();
+    sink.fail = true;
+    Check(sync.Step(error) == ChronikSyncResult::Error,
+          "index error unavailable");
+    Check(runtime->Snapshot().chain->stable_tip == original.chain->stable_tip,
+          "consensus untouched");
+    sink.fail = false;
+    return count;
+}
+int main() {
+    try {
+        Sink sink;
+        Home source;
+        for (size_t n : {0, 1, 2, 3}) {
+            source.Connect(n);
+            source.Open();
+        }
+        Check(Run(source, sink) == 6,
+              "linear initial catchup: 5 indexed blocks plus readiness");
+        Check(sink.chain.size() == 5, "full genesis catchup");
+        bool burn{};
+        for (const auto &tx : sink.chain.front().transactions)
+            for (const auto &wire : tx.outputs) {
+                Output output;
+                std::string error;
+                Check(DecodeOutput(wire, output, error), error);
+                burn |= output.IsBurn();
+            }
+        Check(burn, "genesis burn indexed");
+        Check(Run(source, sink) == 1,
+              "restart checkpoint requires one readiness step");
+        Home target;
+        for (size_t n : {0, 1, 4, 5, 6}) {
+            target.Connect(n);
+            target.Open();
+        }
+        Check(Run(target, sink) == 6,
+              "linear reorg: 2 disconnects plus 3 connects plus readiness");
+        Check(sink.disconnects == 2 && sink.chain.size() == 6 &&
+                  sink.chain.back().anchor.block_id == H(V(6).id),
+              "actual ancestry reorg");
+        const auto &spend = sink.chain[3].transactions.back();
+        Check(!spend.inputs.empty() && spend.inputs.front().input_index == 0,
+              "actual spend ordinal");
+        Home genesis_only;
+        Check(Run(genesis_only, sink) == 6,
+              "deep reorg: 5 disconnects plus readiness");
+        Check(sink.chain.size() == 1 && sink.disconnects == 7,
+              "deep reorg retains genesis");
+        Check(Run(target, sink) == 6, "linear catchup after deep reorg");
+        // A codec-authenticated mixed mint/spend frame preserves input slot 1.
+        FramedBlock framed;
+        std::string error;
+        const auto profile = target.p.ordinary.transaction;
+        Check(DecodeBlockWire(Bytes(V(4).wire), profile,
+                              target.p.header.chain_id, framed, error),
+              error);
+        auto &tx = framed.transactions.back();
+        auto mint = tx.inputs.front();
+        mint.flags = 3;
+        mint.prev_txid[0] ^= 1;
+        mint.prev_index = 0;
+        mint.sequence = UINT32_MAX;
+        tx.inputs.insert(tx.inputs.begin(), mint);
+        Check(CompleteTransactionRoot(framed.transactions, profile,
+                                      target.p.header.chain_id,
+                                      framed.header.tx_root, error),
+              error);
+        std::vector<uint8_t> wire;
+        framed.header.size = HEADER_SIZE + 4;
+        for (const auto &transaction : framed.transactions) {
+            std::vector<uint8_t> frame;
+            Check(EncodeTransaction(transaction, profile, frame, error), error);
+            framed.header.size += CompactSizeWidth(frame.size()) + frame.size();
+        }
+        Check(EncodeBlockWire(framed.header, framed.transactions, profile, wire,
+                              error),
+              error);
+        ChronikAnchor anchor;
+        anchor.height = framed.header.height;
+        Check(BlockId(target.p.header.chain_id, framed.header, anchor.block_id),
+              "mixed block id");
+        ChronikBlock converted;
+        Check(MakeChronikBlock(wire, target.p.header.chain_id, profile, anchor,
+                               converted, error),
+              error);
+        Check(converted.transactions.back().inputs.size() == 1 &&
+                  converted.transactions.back().inputs.front().input_index == 1,
+              "nonzero native input ordinal");
+        wire.back() ^= 1;
+        Check(!MakeChronikBlock(wire, target.p.header.chain_id, profile, anchor,
+                                converted, error),
+              "changed body rejected");
+        std::cout << "chronik sync checks passed\n";
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_dev_genesis.cpp b/src/lotus_v2/test_dev_genesis.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c76d8d38c52a79523f4c35d2b12e9377035bbf93
--- /dev/null
+++ b/src/lotus_v2/test_dev_genesis.cpp
@@ -0,0 +1,164 @@
+// Copyright (c) 2026 The Lotus developers
+#include "dev_genesis.h"
+
+#include "commitment.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const char *message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+std::string Hex(const Hash &hash) {
+    constexpr char chars[] = "0123456789abcdef";
+    std::string result;
+    for (uint8_t byte : hash) {
+        result.push_back(chars[byte >> 4]);
+        result.push_back(chars[byte & 15]);
+    }
+    return result;
+}
+
+bool SameHeader(const Header &a, const Header &b) {
+    return a.prev_id == b.prev_id && a.bits == b.bits && a.time == b.time &&
+           a.nonce == b.nonce && a.version == b.version && a.size == b.size &&
+           a.height == b.height && a.tx_root == b.tx_root &&
+           a.state_root == b.state_root;
+}
+
+bool ZeroHash(const Hash &hash) {
+    for (uint8_t byte : hash) {
+        if (byte != 0) return false;
+    }
+    return true;
+}
+
+void RejectUnchanged(const Hash &prev_id, uint64_t height) {
+    DevelopmentGenesisFixture rejected;
+    rejected.header.version = 0xdeadbeef;
+    rejected.header.nonce = 7;
+    rejected.header.height = 99;
+    rejected.state.bootstrap_reserve = 123;
+    Check(!MakeDevelopmentGenesis(prev_id, height, rejected),
+          "nonzero previous id or height must be rejected");
+    Check(rejected.header.version == 0xdeadbeef && rejected.header.nonce == 7 &&
+              rejected.header.height == 99 &&
+              rejected.state.bootstrap_reserve == 123,
+          "rejected construction leaves the fixture unchanged");
+}
+} // namespace
+
+int main() {
+    try {
+        Check(HEADER_SIZE == 134, "header encoding is 134 bytes");
+        DevelopmentGenesisFixture fixture;
+        fixture.header.version = 1;
+        Check(MakeDevelopmentGenesis({}, 0, fixture), "construct height 0");
+        Check(fixture.chain_id == kDevelopmentChainId &&
+                  ZeroHash(fixture.chain_id),
+              "development chain id is all zeros");
+        const Header &header = fixture.header;
+        Check(ZeroHash(header.prev_id) && header.nonce == 0 &&
+                  header.version == 2 && header.height == 0 &&
+                  header.time <= MAX_TIME && header.bits == 0x1d00ffff &&
+                  header.size == HEADER_SIZE,
+              "height-0 header fields");
+        Hash pow_limit{};
+        pow_limit[31] = 0xff;
+        Hash target{};
+        Check(DecodeTarget(header.bits, pow_limit, target),
+              "bits stay the header test canonical target");
+
+        // Empty transaction root already pinned by test_commitment.cpp.
+        Hash tx_root{};
+        Check(TransactionRoot({}, tx_root) && header.tx_root == tx_root &&
+                  Hex(header.tx_root) ==
+                      "eebdd2bf2b0f92f1764c36eaef67a3ba72195a4206f2ea225db80605833beadb",
+              "tx root is the existing empty commitment");
+
+        Check(fixture.state.bootstrap_reserve == 9 &&
+                  fixture.state.tail_subsidy == 200 &&
+                  fixture.state.prev_work[0] == 9 &&
+                  fixture.state.ema_block_cost == 4,
+              "genesis state is the existing monetary test state");
+        const Hash utxo = EmptyUtxoRoot();
+        const Hash state_root =
+            StateRoot(fixture.chain_id, 0, utxo, fixture.state);
+        const Hash state_root_again =
+            StateRoot(fixture.chain_id, 0, utxo, fixture.state);
+        Check(header.state_root == state_root && state_root == state_root_again,
+              "state root matches two StateRoot calls");
+        Check(Hex(state_root) ==
+                  "3ecef0a5a8524cde7fa2921c52256c5a4306783c6d24e8604ec2b6288ec39acf",
+              "development genesis state root matches the Python fixture");
+
+        std::array<uint8_t, HEADER_SIZE> bytes{};
+        Check(SerializeHeader(header, bytes), "serialize development header");
+        Check(bytes.size() == 134, "serialized header is exactly 134 bytes");
+        Header parsed;
+        parsed.version = 0x11111111;
+        Check(ParseHeader(bytes.data(), bytes.size(), parsed), "parse header");
+        Check(SameHeader(parsed, header), "parse restores the same fields");
+        std::array<uint8_t, HEADER_SIZE> repeated{};
+        Check(SerializeHeader(parsed, repeated) && repeated == bytes,
+              "serialize parsed header");
+
+        DevelopmentGenesisFixture again;
+        Check(MakeDevelopmentGenesis({}, 0, again) &&
+                  SameHeader(again.header, header) &&
+                  again.state.bootstrap_reserve ==
+                      fixture.state.bootstrap_reserve &&
+                  again.state.tail_subsidy == fixture.state.tail_subsidy &&
+                  again.state.prev_work == fixture.state.prev_work &&
+                  again.state.ema_block_cost == fixture.state.ema_block_cost,
+              "fixture construction is deterministic");
+
+        Hash nonzero{};
+        nonzero[0] = 1;
+        RejectUnchanged(nonzero, 0);
+        nonzero[0] = 0;
+        nonzero[31] = 1;
+        RejectUnchanged(nonzero, 0);
+        RejectUnchanged({}, 1);
+        RejectUnchanged({}, UINT64_MAX);
+        nonzero[0] = 1;
+        RejectUnchanged(nonzero, 1);
+
+        // Same AdvanceMonetary arguments as test_monetary.cpp Step(state).
+        // Subsidy 202 is that test's expected integer. The monetary tests do
+        // not pin a state-root integer, so only two calls are compared.
+        // No new economic vector was added.
+        const MonetaryTransition first = AdvanceMonetary(
+            DevelopmentGenesis, fixture.state, 9, {}, 0, 0, 1, 1, 4, 4);
+        const MonetaryTransition second = AdvanceMonetary(
+            DevelopmentGenesis, fixture.state, 9, {}, 0, 0, 1, 1, 4, 4);
+        Check(first.subsidy == 202 && second.subsidy == 202 &&
+                  first.bootstrap_issued == 2 && second.bootstrap_issued == 2 &&
+                  first.state.bootstrap_reserve == 7 &&
+                  second.state.bootstrap_reserve == 7 &&
+                  first.state.tail_subsidy == 200 &&
+                  second.state.tail_subsidy == 200,
+              "existing height-one subsidy");
+        const Hash transition_root =
+            StateRoot(fixture.chain_id, 1, utxo, first.state);
+        const Hash transition_root_again =
+            StateRoot(fixture.chain_id, 1, utxo, second.state);
+        Check(transition_root == transition_root_again,
+              "transition state root is deterministic");
+        Check(transition_root != header.state_root,
+              "issuance step is not the recorded genesis root");
+        std::cout << "development genesis fixture checks passed\n"
+                  << "subsidy 202 matches the existing monetary test; "
+                  << "genesis state root matches the recorded Python digest; "
+                  << "no new economic vector\n";
+    } catch (const std::exception &error) {
+        std::cerr << "development genesis: " << error.what() << '\n';
+        return EXIT_FAILURE;
+    }
+}
