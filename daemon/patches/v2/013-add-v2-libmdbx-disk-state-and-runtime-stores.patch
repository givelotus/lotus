+bool AvalanchePeer::Room(uint32_t n, uint64_t bytes) const {
+    return n <= limits_.max_actions - actions_.size() && bytes <= limits_.max_action_bytes - action_bytes_;
+}
+bool AvalanchePeer::Active(peer::ConnectionId id) const {
+    const auto features=dispatcher_.ActiveFeatures(id);const auto limit=dispatcher_.ActiveLimit(id);
+    return peers_.contains(id) && features && (*features&REQUIRED_CAPABILITY) && limit && *limit && dispatcher_.Transcript(id);
+}
+std::optional<peer::ConnectionId> AvalanchePeer::Connection(NodeId node) const {
+    for(const auto &[id,state]:peers_) if(state.node==node)return id;
+    return {};
+}
+std::optional<peer::ConnectionId> AvalanchePeer::PendingConnection() const {
+    return actions_.empty()?std::nullopt:std::optional(actions_.front().connection);
+}
+PeerResult AvalanchePeer::QueueBatch(peer::ConnectionId id, std::vector<peer::Message> messages, std::string &e) {
+    if(!Active(id)) {e="avalanche-inactive-peer";return PeerResult::UnknownPeer;}
+    if(messages.size()>limits_.max_actions) {e="avalanche-action-backpressure";return PeerResult::Backpressure;}
+    const auto limit=*dispatcher_.ActiveLimit(id); uint64_t bytes=0;
+    for(const auto &m:messages) {
+        if(m.payload.size()>limits_.max_payload) {e="avalanche-local-payload-capacity";return PeerResult::LocalFailure;}
+        if(m.payload.size()>limit) {e="avalanche-negotiated-capacity";return PeerResult::Rejected;}
+        bytes+=m.payload.size();
+    }
+    if(messages.size()>limits_.max_actions || !Room(uint32_t(messages.size()),bytes)) {e="avalanche-action-backpressure";return PeerResult::Backpressure;}
+    for(auto &m:messages) {action_bytes_+=m.payload.size();actions_.push_back({id,std::move(m)});}
+    e.clear();return PeerResult::Accepted;
+}
+PeerResult AvalanchePeer::Queue(peer::ConnectionId id, peer::Message m, std::string &e) {
+    std::vector<peer::Message> messages;messages.push_back(std::move(m));return QueueBatch(id,std::move(messages),e);
+}
+PeerResult AvalanchePeer::Activate(peer::ConnectionId id, std::string &e) {
+    auto f = dispatcher_.ActiveFeatures(id); auto t = dispatcher_.Transcript(id);
+    const auto limit=dispatcher_.ActiveLimit(id);
+    if (!f || !(*f & REQUIRED_CAPABILITY) || !t || !limit || !*limit) { e = "avalanche-not-negotiated"; return PeerResult::UnknownPeer; }
+    if(peers_.contains(id)) return PeerResult::Accepted;
+    if (peers_.size() >= limits_.max_peers || next_node_ == std::numeric_limits<NodeId>::max()) return PeerResult::Backpressure;
+    State state; state.node = next_node_++;
+    state.incoming = {t->remote_nonce, t->local_nonce, t->remote_entropy, t->local_entropy};
+    peers_.emplace(id, std::move(state)); e.clear(); return PeerResult::Accepted;
+}
+PeerResult AvalanchePeer::Hello(peer::ConnectionId id, const ::avalanche::Delegation &delegation, std::string &e) {
+    if (!Active(id)) return PeerResult::UnknownPeer;
+    if (!Room(1, limits_.max_payload)) return PeerResult::Backpressure;
+    auto t = dispatcher_.Transcript(id); if (!t) return PeerResult::UnknownPeer;
+    SchnorrSig sig;
+    if (!callbacks_.sign_hello(HelloDigest(delegation, {t->local_nonce, t->remote_nonce, t->local_entropy, t->remote_entropy}), sig))
+        return PeerResult::LocalFailure;
+    AuthenticatedHello checked;
+    if (!AuthenticateHello(delegation, sig, {t->local_nonce, t->remote_nonce, t->local_entropy, t->remote_entropy}, limits_.max_elements, checked, e))
+        return PeerResult::LocalFailure;
+    if (checked.session_key != callbacks_.local_session_key) { e = "local-session-key-mismatch"; return PeerResult::LocalFailure; }
+    auto b = WireBytes(delegation, sig, limits_.max_elements);
