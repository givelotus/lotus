+    cache = {b.transactions[1], b.transactions[1], b.transactions[2]};
+    CompactReconstruction duplicates(p, SyntheticCollision);
+    CHECK(duplicates.Start(compact, cache, e) ==
+          ReconstructionStatus::CompleteUnvalidated);
+    CHECK(duplicates.TakeComplete(complete));
+    // A unique colliding witness variant still fails the real ordered root
+    // and requests a full block without any consensus-invalid verdict.
+    cache = {variant, b.transactions[2]};
+    CompactReconstruction wrong_variant(p, SyntheticCollision);
+    CHECK(wrong_variant.Start(compact, cache, e) ==
+          ReconstructionStatus::NeedFullBlock);
+}
