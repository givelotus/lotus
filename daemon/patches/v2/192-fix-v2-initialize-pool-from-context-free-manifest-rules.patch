From 7232f91c3c89bee203f72ecd8bc19c5f95bedb3b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:24:10 -0700
Subject: [PATCH] fix(v2): initialize pool from context-free manifest rules

Maintenance explanation added during mailbox export:
Validate manifest ordinary rules with a temporary structural height when opening the coordinator, then derive real candidate height and MTP from the authenticated runtime. This fixes manifest profiles whose context-free candidate height is zero; earlier local two- and three-node wallet relay checks exercised the integrated transaction path at this revision.

---
 src/lotus_v2/pool_coordinator.cpp      | 6 +++++-
 src/lotus_v2/test_pool_coordinator.cpp | 2 ++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/pool_coordinator.cpp b/src/lotus_v2/pool_coordinator.cpp
index cdecaded86318ca34bb8750305e794ae21094342..dc9ae390a48dc8f86483dc5d7ad6f06f22fef87b 100644
--- a/src/lotus_v2/pool_coordinator.cpp
+++ b/src/lotus_v2/pool_coordinator.cpp
@@ -66,7 +66,11 @@ struct PoolCoordinator::Impl {
 PoolCoordinator::PoolCoordinator(std::unique_ptr<Impl> p):impl_(std::move(p)) {}
 PoolCoordinator::~PoolCoordinator()=default;
 bool PoolCoordinator::Open(DevelopmentRuntime &r,PoolCoordinatorConfig c,std::unique_ptr<PoolCoordinator> &out,std::string &error) {
-    if(!c.max_path || !c.max_detached_transactions || !c.max_detached_bytes || !c.max_block_bytes || !ValidateOrdinaryProfile(c.ordinary,error)) { if(error.empty()) error="invalid pool coordinator limits"; return false; }
+    // The manifest supplies rules, not a candidate context. Context() derives
+    // the actual height and MTP from the authenticated runtime before admission.
+    auto structural = c.ordinary;
+    structural.candidate_height = 1;
+    if(!c.max_path || !c.max_detached_transactions || !c.max_detached_bytes || !c.max_block_bytes || !ValidateOrdinaryProfile(structural,error)) { if(error.empty()) error="invalid pool coordinator limits"; return false; }
     auto p=std::make_unique<Impl>(r,std::move(c));
     auto s=r.Snapshot(); if(!s.chain || s.chain->identity!=p->config.identity || s.chain->profile_digest!=p->config.profile_digest) { error="pool coordinator runtime identity/profile mismatch"; return false; }
     if(!TransactionHistory::Open(p->config.directory,p->config.identity,p->config.profile_digest,p->config.history,p->history,error,p->config.history_env)) return false;
diff --git a/src/lotus_v2/test_pool_coordinator.cpp b/src/lotus_v2/test_pool_coordinator.cpp
index d6fc6e2eaee122811bcde98a5b9ebfd16f9ba525..5fb52d993e34ace5bbc8bf30c062d8627b42ee62 100644
--- a/src/lotus_v2/test_pool_coordinator.cpp
+++ b/src/lotus_v2/test_pool_coordinator.cpp
@@ -138,6 +138,8 @@ PoolCoordinatorConfig PoolConfig(DevelopmentRuntime &runtime, Home &home) {
     c.directory=home.path+"/chainstate-v2/transaction-index";
     c.identity=s.chain->identity; c.profile_digest=s.chain->profile_digest;
     c.headers=home.p.header; c.ordinary=home.p.ordinary; c.cost=home.p.cost;
+    // Match manifest-loaded rules: the coordinator must supply the context.
+    c.ordinary.candidate_height=0;
     return c;
 }
 std::unique_ptr<PoolCoordinator> Coordinator(DevelopmentRuntime &runtime,PoolCoordinatorConfig c) {
-- 
