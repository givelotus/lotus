From 28ae726e50123d5607aabe66fc2c75c966462393 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 18:54:04 -0700
Subject: [PATCH] fix(v2): keep prepared VM snapshots at stable addresses

Invocation contexts borrow the prepared object and its direct-owned transaction, profile, chain and resolved coins. Disallow copying, moving and assignment so relocating or replacing a snapshot cannot silently invalidate those references. Document that preparation and destruction invalidate borrowed contexts.

Current production callers prepare a local snapshot in place. The focused VM suite passes, including compile-time lifetime contract assertions and existing ownership/authentication coverage.
---
 src/lotus_v2/test_vm.cpp | 5 +++++
 src/lotus_v2/vm.h        | 9 +++++++++
 2 files changed, 14 insertions(+)

diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index f4d0ddf3e3c175ce729c13da67133c179b8fe78c..02dd7f3e1fd5dfe3cde7f5b071295b81ce68b0cb 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -6,6 +6,7 @@
 #include <iostream>
 #include <stdexcept>
 #include <string>
+#include <type_traits>
 
 using namespace lotus::v2;
 
@@ -810,6 +811,10 @@ void PreparedTransactionOwnership() {
         tx.outputs[0].branches.push_back(branch);
     }
     auto cost = IllustrativeCost();
+    static_assert(!std::is_copy_constructible_v<PreparedVmTransaction>);
+    static_assert(!std::is_copy_assignable_v<PreparedVmTransaction>);
+    static_assert(!std::is_move_constructible_v<PreparedVmTransaction>);
+    static_assert(!std::is_move_assignable_v<PreparedVmTransaction>);
     PreparedVmTransaction prepared;
     std::string error;
 #ifdef LOTUS_V2_VM_TEST_INSTRUMENTATION
diff --git a/src/lotus_v2/vm.h b/src/lotus_v2/vm.h
index 6fa23aec6ea88ee4fb464ad8f65a2f3fcd8bf062..bcdc672a800ce25839981ddf23eccf52e9ccd9af 100644
--- a/src/lotus_v2/vm.h
+++ b/src/lotus_v2/vm.h
@@ -96,11 +96,20 @@ VmPreparationCounts VmPreparationWorkCounts();
 
 class PreparedVmTransaction {
 public:
+    PreparedVmTransaction() = default;
+    // Invocation contexts borrow these members and this object. Keep their
+    // addresses stable for the complete lifetime of every borrowed context.
+    PreparedVmTransaction(const PreparedVmTransaction &) = delete;
+    PreparedVmTransaction &operator=(const PreparedVmTransaction &) = delete;
+    PreparedVmTransaction(PreparedVmTransaction &&) = delete;
+    PreparedVmTransaction &operator=(PreparedVmTransaction &&) = delete;
     SigningPreparationStatus
     PrepareChecked(const Transaction &, const TxProfile &, const ChainId &,
                    const ResolvedCoins &, const VmCostProfile &, std::string &);
     bool Prepare(const Transaction &, const TxProfile &, const ChainId &,
                  const ResolvedCoins &, const VmCostProfile &, std::string &);
+    // Borrowed contexts are valid until this object is prepared again or
+    // destroyed; callers must finish all invocations before either event.
     VmExecutionContext Invocation(size_t input, size_t witness,
         std::optional<PositiveDelta> delta = std::nullopt) const {
         return {tx_, profile_, chain_, coins_, input, witness, delta, this};
