From 9345b70ec2f57f6b43b9461793b53c34f1e3dfae Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 12:40:42 -0700
Subject: [PATCH] Register development runtime and real fork recovery checks

Link the explicit V4 runtime to the existing candidate selector, body pool and recovery coordinator. Add its real-fork, receipt, invalidation, bounded-scan and authoritative-reopen tests to the full build. The runtime has no networking defaults or implicit chain activation.
---
 src/lotus_v2/CMakeLists.txt | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 3e15b8bbf456bae5820ce9522c2bacda709b28f9..30cd2872495468a17976c829c1bf67e21fe7ddfd 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -1,4 +1,5 @@
-# Isolated candidate primitives. No production target links this library yet.
+# V2 candidate components; the explicit development command links validation.
+# These targets do not activate a network or change the mainnet chain path.
 add_library(lotus_v2_blake3 STATIC
     vendor/blake3/blake3.c
     vendor/blake3/blake3_dispatch.c
@@ -85,6 +86,7 @@ if(NOT TARGET Boost::headers)
     endif()
     find_package(Boost 1.64 REQUIRED)
 endif()
+
 add_executable(test_lotus_v2_dev_genesis
     test_dev_genesis.cpp dev_genesis.cpp monetary.cpp transaction.cpp)
 target_link_libraries(test_lotus_v2_dev_genesis
@@ -257,3 +259,13 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
         COMMAND $<TARGET_FILE:test_lotus_v2_peer_tcp>
         DEPENDS test_lotus_v2_peer_tcp)
 endif()
+
+# Single-owner V4 chain coordination, with no socket or profile defaults.
+add_library(lotus_v2_development_runtime STATIC development_runtime.cpp)
+target_link_libraries(lotus_v2_development_runtime PUBLIC
+    lotus_v2_reorg_recovery lotus_v2_candidate_selection lotus_v2_candidate_body_pool)
+add_executable(test_lotus_v2_development_runtime test_development_runtime.cpp)
+target_link_libraries(test_lotus_v2_development_runtime PRIVATE lotus_v2_development_runtime)
+add_custom_target(check-lotus-v2-development-runtime
+    COMMAND $<TARGET_FILE:test_lotus_v2_development_runtime>
+    DEPENDS test_lotus_v2_development_runtime)
-- 
