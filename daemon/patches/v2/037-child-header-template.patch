From 4d17fb894d95487921b834301ea179addd9472ea Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 22:50:15 -0700
Subject: [PATCH] Add a local V2 child-header template

BuildChildHeader returns a 134-byte child at parent.height + 1 with the
parent block id, nonce 0, and the supplied roots. It rejects a timestamp
above MAX_TIME, compact bits DecodeTarget rejects, and a height that
would overflow. The test checks BlockId and MeetsTarget with at most
eight local nonce increments. It does not open a socket or submit work.
---
 src/lotus_v2/CMakeLists.txt          |   9 ++
 src/lotus_v2/block_template.cpp      |  43 ++++++++
 src/lotus_v2/block_template.h        |  26 +++++
 src/lotus_v2/test_block_template.cpp | 154 +++++++++++++++++++++++++++
 4 files changed, 232 insertions(+)
 create mode 100644 src/lotus_v2/block_template.cpp
 create mode 100644 src/lotus_v2/block_template.h
 create mode 100644 src/lotus_v2/test_block_template.cpp

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 23becdfab..0fb05c322 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -54,6 +54,15 @@ add_custom_target(check-lotus-v2-incremental-utxo
     DEPENDS test_lotus_v2_incremental_utxo
 )
 
+add_library(lotus_v2_block_template STATIC block_template.cpp)
+target_link_libraries(lotus_v2_block_template PUBLIC lotus_v2_header)
+add_executable(test_lotus_v2_block_template test_block_template.cpp)
