+namespace lotus::v2 {
+#if defined(__linux__) || defined(__APPLE__)
+namespace {
+    using namespace peer;
+    using Result = DevelopmentRuntimeResult;
+    constexpr uint64_t MiB = uint64_t{1} << 20;
+    constexpr size_t MaxPeers = 8, MaxTransactions = 65536, OutputCap = 8 * MiB;
+    void Require(bool ok, const std::string &why) {
+        if (!ok) throw std::runtime_error(why);
+    }
+    uint64_t Monotonic() {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    }
+    uint64_t Utc() {
+        const auto n = std::chrono::duration_cast<std::chrono::seconds>(
+                           std::chrono::system_clock::now().time_since_epoch())
+                           .count();
+        Require(n >= 0, "UTC clock unavailable");
+        return n;
+    }
+    void Count(uint64_t &v, uint64_t n = 1) {
+        v = n > UINT64_MAX - v ? UINT64_MAX : v + n;
+    }
+    void Keys(const UniValue &v, const std::set<std::string> &keys) {
+        Require(v.isObject() && v.getKeys().size() == keys.size() &&
+                    std::set<std::string>(v.getKeys().begin(),
+                                          v.getKeys().end()) == keys,
+                "unknown, duplicate or missing object field");
+    }
+    uint64_t Number(const UniValue &v, uint64_t max) {
+        Require(v.isNum(), "expected unsigned JSON integer");
+        const auto &s = v.getValStr();
+        Require(!s.empty() && (s.size() == 1 || s.front() != '0'),
+                "noncanonical integer");
+        uint64_t n = 0;
+        for (char c : s) {
+            Require(c >= '0' && c <= '9' && uint64_t(c - '0') <= max &&
+                        n <= (max - (c - '0')) / 10,
+                    "integer outside limit");
+            n = n * 10 + (c - '0');
+        }
+        return n;
+    }
+    std::vector<uint8_t> Unhex(const UniValue &v, size_t cap) {
+        Require(v.isStr(), "expected lowercase hex string");
+        const auto &s = v.get_str();
+        Require(s.size() % 2 == 0 && s.size() / 2 <= cap,
+                "hex exceeds local capacity");
+        auto digit = [](char c) -> unsigned {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            throw std::runtime_error("expected lowercase hex");
+        };
+        std::vector<uint8_t> out;
+        out.reserve(s.size() / 2);
+        for (size_t i = 0; i < s.size(); i += 2)
+            out.push_back((digit(s[i]) << 4) | digit(s[i + 1]));
+        return out;
+    }
+    Hash HashOf(const UniValue &v) {
+        const auto b = Unhex(v, 32);
+        Require(b.size() == 32, "expected32-byte hash");
+        Hash h;
+        std::copy(b.begin(), b.end(), h.begin());
+        return h;
+    }
+    std::string Hex(std::span<const uint8_t> bytes) {
+        static constexpr char d[] = "0123456789abcdef";
+        std::string s;
+        s.reserve(bytes.size() * 2);
+        for (auto b : bytes) {
+            s += d[b >> 4];
+            s += d[b & 15];
+        }
+        return s;
+    }
+    UniValue ReadJson(const std::string &path) {
+        std::ifstream f(path, std::ios::binary | std::ios::ate);
+        Require(bool(f), "cannot open network file");
+        const auto n = f.tellg();
+        Require(n >= 0 && n <= 65536, "network file exceeds64KiB");
+        std::string s(size_t(n), '\0');
+        f.seekg(0);
+        if (n) f.read(s.data(), s.size());
+        Require(bool(f), "network read failure");
+        UniValue v;
+        Require(v.read(s), "invalid network JSON");
+        return v;
+    }
+    struct NetworkConfig {
+        NetworkProfile profile;
+        TcpEndpoint listen;
+        std::vector<TcpEndpoint> connect;
+    };
+    TcpEndpoint Endpoint(const UniValue &v, bool listening) {
+        Keys(v, {"address", "port"});
+        Require(v["address"].isStr(), "numeric address required");
+        TcpEndpoint out;
+        const auto port = Number(v["port"], 65535);
+        Require((listening || port > 0) &&
+                    ParseNumericEndpoint(v["address"].get_str(), uint16_t(port),
+                                         0, out),
+                "invalid explicit numeric endpoint");
+        return out;
+    }
+    NetworkConfig Network(const std::string &path,
+                          const DevelopmentManifest &m) {
+        const auto v = ReadJson(path);
+        Keys(v, {"schema", "magic", "listen", "connect", "receive_limit",
+                 "local_policy"});
+        Require(Number(v["schema"], 1) == 1, "network schema must be1");
+        Require(v["local_policy"].isStr() &&
+                    v["local_policy"].get_str() == "bounded-local-v1",
+                "explicit bounded-local-v1 policy required");
+        NetworkConfig c{};
+        const auto magic = Unhex(v["magic"], 4);
+        Require(magic.size() == 4, "explicit4-byte magic required");
+        std::copy(magic.begin(), magic.end(), c.profile.magic.begin());
+        c.listen = Endpoint(v["listen"], true);
+        Require(v["connect"].isArray() && v["connect"].size() <= MaxPeers,
+                "connect list exceeds8targets");
+        for (const auto &value : v["connect"].getValues()) {
+            const auto ep = Endpoint(value, false);
+            Require(std::find(c.connect.begin(), c.connect.end(), ep) ==
+                        c.connect.end(),
+                    "duplicate connect endpoint");
+            c.connect.push_back(ep);
+        }
+        c.profile.receive_limit = Number(v["receive_limit"], MAX_RECEIVE_LIMIT);
+        Require(m.block_read_limit >= HEADER_SIZE + 4 + 17 &&
+                    m.block_read_limit <= c.profile.receive_limit,
+                "manifest body capacity must fit explicit receive limit");
+        c.profile.chain_id = m.hp.chain_id;
+        c.profile.genesis_id = m.hp.genesis_id;
+        c.profile.profile_digest =
+            BlockValidationProfileDigest(m.hp, m.op, m.mp, m.cp);
+        c.profile.transaction = m.op.transaction;
+        c.profile.max_reconstruction_transactions = MaxTransactions;
+        c.profile.max_reconstruction_bytes = m.block_read_limit;
+        return c;
+    }
+    std::string Address(const TcpEndpoint &e) {
+        char text[INET6_ADDRSTRLEN]{};
+        Require(inet_ntop(e.family == TcpFamily::IPv4 ? AF_INET : AF_INET6,
+                          e.address.data(), text, sizeof(text)),
+                "endpoint formatting failed");
+        return text;
+    }
+    bool Entropy(uint64_t &out) {
+        for (unsigned i = 0; i < 8; ++i) {
+            uint64_t n;
+#if defined(__APPLE__)
+            arc4random_buf(&n, sizeof(n));
+#else
+            if (getrandom(&n, sizeof(n), 0) != sizeof(n)) return false;
+#endif
+            if (n > 1) {
+                out = n;
+                return true;
+            }
+        }
+        return false;
+    }
+    struct Nonblocking {
+        int fd, flags;
+        explicit Nonblocking(int f) : fd(f), flags(fcntl(f, F_GETFL)) {
+            Require(flags >= 0 && fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0,
+                    "cannot set command pipe nonblocking");
+        }
+        ~Nonblocking() {
+            if (flags >= 0) fcntl(fd, F_SETFL, flags);
+        }
+    };
+    struct IgnorePipe {
+        struct sigaction old{};
+        bool installed{};
+        IgnorePipe() {
+            struct sigaction action{};
+            action.sa_handler = SIG_IGN;
+            sigemptyset(&action.sa_mask);
+            Require(sigaction(SIGPIPE, &action, &old) == 0,
+                    "cannot protect broken output pipe");
+            installed = true;
+        }
+        ~IgnorePipe() {
+            if (installed) sigaction(SIGPIPE, &old, nullptr);
+        }
+    };
+    struct Allowance {
+        uint64_t bytes{}, cap;
+        uint32_t slots{}, slot_cap;
+        struct Lease final : DownloadReservation {
+            Allowance &owner;
+            ResourceNeed need;
+            Lease(Allowance &o, ResourceNeed n) : owner(o), need(n) {}
+            ~Lease() {
+                owner.bytes -= need.staging_bytes;
+                owner.slots -= need.transaction_slots;
+            }
+        };
+        ReservationResult Reserve(const ResourceNeed &n) {
+            if (n.staging_bytes > cap - bytes ||
+                n.transaction_slots > slot_cap - slots)
+                return {ReservationDisposition::CapacityRefused,
+                        {},
+                        "local staging quota"};
+            auto lease = std::make_unique<Lease>(*this, n);
+            bytes += n.staging_bytes;
+            slots += n.transaction_slots;
+            return {ReservationDisposition::Granted, std::move(lease), {}};
+        }
+    };
+    DevelopmentTickLimits TickLimits(uint64_t body) {
+        DevelopmentTickLimits l{};
+        l.selection.query = {128, 20000, 20000, 2 * MiB};
+        l.selection.fork = {16, 16, 10000};
+        l.selection.max_probe_calls = 128;
+        l.selection.max_probe_bytes = body;
+        l.selection.max_missing_bodies = 16;
+        l.selection.max_resident_bytes = 2 * MiB;
+        l.recovery = {{16, 16, 10000}, body,     64 * MiB,
+                      128 * MiB,       16 * MiB, 64 * MiB};
+        l.propagation = {16, 10000, 10000, 2 * MiB};
+        return l;
+    }
+    DevelopmentRuntimeConfig RuntimeConfig(const DevelopmentManifest &m,
+                                           const std::string &directory) {
+        DevelopmentRuntimeConfig c{};
+        c.directory = directory;
+        c.genesis_wire = m.genesis;
+        c.profiles = {m.hp, m.op, m.mp, m.cp};
+        c.initial_money = m.initial;
+        c.storage.recovery = DiskRecoveryOptions{128 * MiB, 16 * MiB};
+        c.storage.candidates = CandidateStoreOptions{4096, 4096, 128};
+        c.storage.max_metadata_bytes = 16 * MiB;
+        c.storage.max_pending_bytes = 64 * MiB;
+        c.bodies = {32, m.block_read_limit, 64 * MiB,
+                    32, 64 * MiB,           MaxTransactions};
+        c.initial_body_epoch = 1;
+        c.initial_context_generation = 1;
+        return c;
+    }
+    DownloadConfig DownloadSettings(const NetworkProfile &n) {
+        DownloadConfig c{};
+        c.network = n;
+        c.context_generation = 1;
+        auto &l = c.limits;
+        l.peers = MaxPeers;
+        l.jobs_per_peer = 2;
+        l.jobs_global = 8;
+        l.tombstones_per_peer = 64;
+        l.tombstones_global = 512;
+        l.deferred_jobs_global = 8;
+        l.cache_candidates = MaxTransactions;
+        l.cache_bytes = MiB;
+        l.staging_bytes_per_peer = 128 * MiB;
+        l.staging_bytes_global = 256 * MiB;
+        l.transaction_slots_per_peer = 4000000;
+        l.transaction_slots_global = 8000000;
+        l.request_timeout_ms = 10000;
+        l.deferred_timeout_ms = 30000;
+        l.retry_interval_ms = 1000;
+        l.lifecycle_timeout_ms = 60000;
+        return c;
+    }
+    DispatcherConfig DispatcherSettings(const NetworkProfile &n,
+                                        uint64_t body) {
+        DispatcherConfig c{};
+        c.network = n;
+        c.initial_fetch_epoch = 1;
+        c.auto_start_headers = true;
+        auto &l = c.limits;
+        l.max_peers = MaxPeers;
+        l.max_notices = 256;
+        l.max_inventory_items = 128;
+        l.max_header_items = 128;
+        l.max_payload_bytes = n.receive_limit;
+        l.max_pending_message_bytes = n.receive_limit;
+        l.max_serving_transactions = MaxTransactions;
+        l.max_compact_guards_per_peer = 64;
+        l.max_serving_body_bytes = body;
+        l.compact_near_tip_depth = 2;
+        l.header_timeout_ms = 10000;
+        l.output_timeout_ms = 10000;
+        l.serving_timeout_ms = 10000;
+        l.serving_window_ms = 1000;
+        l.serving_requests_per_window = 128;
+        l.serving_bytes_per_window = 64 * MiB;
+        return c;
+    }
+    struct Connection {
+        TcpStream stream;
+        std::unique_ptr<Transport> transport;
+        ConnectionId id{};
+        uint64_t nonce{};
+        uint64_t refresh{};
+        bool inbound{};
+        std::optional<size_t> target;
+        std::optional<Hash> requested;
+        bool requested_compact{}, requested_fallback{};
+        uint32_t issued_requests{};
+    };
+    class Node {
+    public:
+        Node(DevelopmentManifest m, NetworkConfig n,
+             std::unique_ptr<DevelopmentRuntime> r)
+            : manifest(std::move(m)), network(std::move(n)),
+              runtime(std::move(r)) {
+            manager = std::make_unique<DownloadManager>(
+                DownloadSettings(network.profile), Callbacks());
+            dispatcher = std::make_unique<PeerDispatcher>(
+                *runtime, *manager,
+                DispatcherSettings(network.profile, manifest.block_read_limit),
+                DispatcherCallbacks{
+                    [this](PeerHandle, const ResourceNeed &need) {
+                        return serving.Reserve(need);
+                    },
+                    [](uint64_t &nonce) { return Entropy(nonce); }});
+            retry.resize(network.connect.size());
+            connections.reserve(MaxPeers);
+            tracked_bodies.reserve(32);
+            Require(listener.Listen(network.listen, {8, network.listen.family ==
+                                                            TcpFamily::IPv6}) &&
+                        listener.BoundEndpoint(bound),
+                    "cannot listen on explicit endpoint");
+        }
+        ~Node() {
+            dispatcher.reset();
+            connections.clear();
+            manager.reset();
+        }
+        void Run();
+
+    private:
+        DevelopmentManifest manifest;
+        NetworkConfig network;
+        std::unique_ptr<DevelopmentRuntime> runtime;
+        Allowance staging{0, 256 * MiB, 0, 8000000},
+            serving{0, 96 * MiB, 0, 4000000};
+        std::unique_ptr<DownloadManager> manager;
+        std::unique_ptr<PeerDispatcher> dispatcher;
+        TcpListener listener;
+        TcpEndpoint bound;
+        std::vector<std::unique_ptr<Connection>> connections;
+        std::vector<uint64_t> retry;
+        std::set<uint64_t> outbound_nonces;
+        std::deque<std::string> output;
+        size_t output_bytes{}, output_offset{};
+        std::string input;
+        bool stopping{}, eof{};
+        uint64_t full_requests{}, compact_requests{}, retained{},
+            full_retained{}, compact_retained{}, fallbacks{}, served_bytes{},
+            tip_changes{}, active_events{}, observed_fetch_epoch{1};
+        Hash last_tip{};
+        std::optional<CandidateChoices> choices;
+        size_t target_cursor{}, request_cursor{}, body_cursor{};
+        std::vector<Hash> tracked_bodies;
+        DownloadCallbacks Callbacks();
+        HeaderDecision CheckHeader(const Header &, uint64_t);
+        void Queue(UniValue);
+        void Flush();
+        void ReadCommands();
+        void Command(const std::string &);
+        UniValue Status();
+        void Track(const Hash &);
+        void CleanupBodies();
+        void Drain();
+        void Connections(uint64_t);
+        void Attach(Connection &, uint64_t);
+        void Headers(uint64_t, bool);
+        void Schedule(uint64_t);
+    };
+    HeaderDecision Node::CheckHeader(const Header &h, uint64_t epoch) {
+        const auto snap = runtime->Snapshot();
+        const auto clock =
+            dispatcher ? dispatcher->HeaderClock() : std::nullopt;
+        if (!snap.chain || snap.reopen_required ||
+            snap.chain->profile_digest != network.profile.profile_digest ||
+            !dispatcher || epoch != dispatcher->FetchEpoch() || !clock)
+            return {HeaderDisposition::OperationalError,
+                    {},
+                    "runtime authority/fetch epoch unavailable"};
+        Hash id;
+        std::string error;
+        std::optional<IndexedHeader> indexed;
+        std::optional<Hash> invalid;
+        if (h.size > manifest.block_read_limit)
+            return {HeaderDisposition::Unsupported,
+                    {},
+                    "header body exceeds selected local policy capacity"};
+        if (!BlockId(network.profile.chain_id, h, id))
+            return {HeaderDisposition::Unsupported, {}, "unencodable header"};
+        if (runtime->ReadHeader(id, indexed, error) != Result::Progress ||
+            runtime->ReadInvalidity(id, invalid, error) != Result::Progress)
+            return {HeaderDisposition::OperationalError, {}, error};
+        if (invalid)
+            return {HeaderDisposition::ConsensusInvalid,
+                    {},
+                    "durable invalidity root"};
+        if (!indexed)
+            return {HeaderDisposition::MissingParent, h.prev_id,
+                    "header not indexed"};
+        std::array<uint8_t, HEADER_SIZE> a{}, b{};
+        if (!SerializeHeader(h, a) || !SerializeHeader(indexed->header, b) ||
+            a != b)
+            return {HeaderDisposition::OperationalError,
+                    {},
+                    "indexed header mismatch"};
+        if (indexed->max_ancestor_time > clock->wall_seconds &&
+            indexed->max_ancestor_time - clock->wall_seconds >
+                clock->future_window)
+            return {HeaderDisposition::Deferred,
+                    {},
+                    "authenticated ancestor temporarily future"};
+        return {HeaderDisposition::Eligible, {}, {}};
+    }
+    DownloadCallbacks Node::Callbacks() {
+        return {[this](const Header &h, uint64_t epoch) {
+                    return CheckHeader(h, epoch);
+                },
+                [this](PeerHandle, const ResourceNeed &n) {
+                    return staging.Reserve(n);
+                },
+                [](const Header &) { return CachedTransactions{{}, 0}; },
+                [this](std::span<const uint8_t> bytes, uint64_t epoch) {
+                    if (bytes.size() > manifest.block_read_limit)
+                        return BodyDecision{BodyDisposition::CapacityRefused,
+                                            {},
+                                            "local body capacity"};
+                    Header h;
+                    if (!ParseHeader(bytes.data(),
+                                     std::min(bytes.size(), HEADER_SIZE), h))
+                        return BodyDecision{BodyDisposition::MalformedBody,
+                                            {},
+                                            "body header framing"};
+                    const auto decision = CheckHeader(h, epoch);
+                    if (decision.disposition != HeaderDisposition::Eligible) {
+                        const auto d =
+                            decision.disposition ==
+                                    HeaderDisposition::ConsensusInvalid
+                                ? BodyDisposition::ConsensusInvalid
+                            : decision.disposition ==
+                                    HeaderDisposition::Deferred
+                                ? BodyDisposition::Deferred
+                            : decision.disposition ==
+                                    HeaderDisposition::MissingParent
+                                ? BodyDisposition::MissingParent
+                                : BodyDisposition::ContextChanged;
+                        return BodyDecision{d, decision.missing_parent,
+                                            decision.diagnostic};
+                    }
+                    Hash id;
+                    BlockId(network.profile.chain_id, h, id);
+                    CandidateBodyStatus status{};
+                    std::string error;
+                    const auto result = runtime->RetainBody(
+                        id, std::vector<uint8_t>(bytes.begin(), bytes.end()),
+                        status, error);
+                    if (result == Result::Progress &&
+                        (status == CandidateBodyStatus::RetainedAuthenticated ||
+                         status == CandidateBodyStatus::Duplicate)) {
+                        Track(id);
+                        return BodyDecision{
+                            BodyDisposition::RetainedAuthenticated, {}, {}};
+                    }
+                    return BodyDecision{result == Result::CapacityRefused
+                                            ? BodyDisposition::CapacityRefused
+                                        : result == Result::MalformedBody
+                                            ? BodyDisposition::MalformedBody
+                                            : BodyDisposition::StorageError,
+                                        {},
+                                        error};
+                }};
+    }
+    void Node::Queue(UniValue value) {
+        auto line = value.write() + "\n";
+        Require(line.size() <= OutputCap - output_bytes,
+                "local output backpressure capacity exhausted");
+        output_bytes += line.size();
+        output.push_back(std::move(line));
+    }
+    void Node::Flush() {
+        size_t budget = 65536;
+        while (!output.empty() && budget) {
+            auto &s = output.front();
+            const auto n = write(STDOUT_FILENO, s.data() + output_offset,
+                                 std::min(budget, s.size() - output_offset));
+            if (n < 0 &&
+                (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
+                return;
+            Require(n > 0, "local output pipe unavailable");
+            budget -= n;
+            output_bytes -= n;
+            output_offset += n;
+            if (output_offset == s.size()) {
+                output.pop_front();
+                output_offset = 0;
+            }
+        }
+    }
+    UniValue Node::Status() {
+        UniValue v(UniValue::VOBJ);
+        const auto snap = runtime->Snapshot();
+        v.pushKV("tip_known", bool(snap.chain) && !snap.reopen_required);
+        v.pushKV("reopen_required", snap.reopen_required);
+        v.pushKV("execution_paused", snap.execution_paused);
+        if (snap.chain && !snap.reopen_required) {
+            DiskStateMetadata metadata;
+            Hash root;
+            std::string error;
+            Require(runtime->ReadMetadata(16 * MiB, metadata, root, error) ==
+                        Result::Progress,
+                    error);
+            Header h;
+            Require(
+                ParseHeader(metadata.header.data(), metadata.header.size(), h),
+                "authoritative header unavailable");
+            v.pushKV("tip", Hex(metadata.tip));
+            v.pushKV("height", h.height);
+            v.pushKV("utxo_root", Hex(root));
+            v.pushKV("state_root", Hex(h.state_root));
+            v.pushKV("monetary_bytes", Hex(metadata.monetary));
+            v.pushKV("pending_journal", snap.chain->pending_journal);
+            v.pushKV("pending_receipt", snap.chain->pending_receipt);
+            v.pushKV("pending_propagation", snap.chain->pending_propagation);
+            v.pushKV("invalid_roots", snap.chain->invalid_root_count);
+        }
+        v.pushKV("chain_id", Hex(network.profile.chain_id));
+        v.pushKV("genesis_id", Hex(network.profile.genesis_id));
+        v.pushKV("profile_digest", Hex(network.profile.profile_digest));
+        uint64_t active = 0;
+        for (const auto &c : connections)
+            if (c->transport && c->transport->State() == SessionState::Active)
+                ++active;
+        v.pushKV("peer_connections", uint64_t(connections.size()));
+        v.pushKV("peer_active", active);
+        v.pushKV("peer_activations", active_events);
+        v.pushKV("download_full_requests", full_requests);
+        v.pushKV("download_compact_requests", compact_requests);
+        v.pushKV("download_retained", retained);
+        v.pushKV("download_full_retained", full_retained);
+        v.pushKV("download_compact_retained", compact_retained);
+        v.pushKV("download_fallbacks", fallbacks);
+        v.pushKV("serving_bytes", served_bytes);
+        v.pushKV("accepted_tip_changes", tip_changes);
+        const auto stats = manager->Stats();
+        v.pushKV("download_jobs", uint64_t(stats.jobs));
+        v.pushKV("fetch_epoch", dispatcher->FetchEpoch());
+        return v;
+    }
+    void Node::Command(const std::string &line) {
+        UniValue request, answer(UniValue::VOBJ);
+        std::string id;
+        try {
+            Require(request.read(line) && request.isObject(),
+                    "invalid command JSON");
+            Require(request["id"].isStr(), "command id required");
+            id = request["id"].get_str();
+            Require(!id.empty() && id.size() <= 64, "command id bound");
+            Require(request["command"].isStr(), "command name required");
+            const auto name = request["command"].get_str();
+            if (name == "status" || name == "stop") {
+                Keys(request, {"id", "command"});
+                answer = Status();
+                if (name == "stop") stopping = true;
+            } else if (name == "submitblock") {
+                Keys(request, {"id", "command", "block"});
+                const auto wire =
+                    Unhex(request["block"], manifest.block_read_limit);
+                Header h;
+                Hash block;
+                Require(ParseHeader(wire.data(),
+                                    std::min(wire.size(), HEADER_SIZE), h) &&
+                            BlockId(network.profile.chain_id, h, block),
+                        "invalid block header framing");
+                HeaderAdmission header;
+                std::string error;
+                const auto admitted = runtime->AdmitHeader(h, header, error);
+                Require(admitted == Result::Progress &&
+                            (header == HeaderAdmission::Stored ||
+                             header == HeaderAdmission::Known),
+                        "header admission: " + error);
+                std::optional<Hash> invalid;
+                Require(runtime->ReadInvalidity(block, invalid, error) ==
+                            Result::Progress,
+                        error);
+                Require(!invalid, "block has a durable invalidity root");
+                CandidateBodyStatus status;
+                Require(
+                    runtime->RetainBody(block, wire, status, error) ==
+                            Result::Progress &&
+                        (status == CandidateBodyStatus::RetainedAuthenticated ||
+                         status == CandidateBodyStatus::Duplicate),
+                    "body retention: " + error);
+                Track(block);
+                choices.reset();
+                answer = Status();
+                answer.pushKV("block_id", Hex(block));
+                answer.pushKV("retained_authenticated", true);
+                answer.pushKV("accepted", false);
+                answer.pushKV("pending_validation", true);
+            } else if (name == "blockstatus") {
+                Keys(request, {"id", "command", "block_id"});
+                const auto block = HashOf(request["block_id"]);
+                std::optional<Hash> invalid;
+                std::optional<IndexedHeader> header;
+                std::string error;
+                Require(runtime->ReadInvalidity(block, invalid, error) ==
+                                Result::Progress &&
+                            runtime->ReadHeader(block, header, error) ==
+                                Result::Progress,
+                        error);
+                answer = Status();
+                answer.pushKV("known_header", bool(header));
+                answer.pushKV("deterministic_invalid", bool(invalid));
+                answer.pushKV("invalid_root",
+                              invalid ? UniValue(Hex(*invalid)) : UniValue());
+                const auto snap = runtime->Snapshot();
+                answer.pushKV("is_active_tip",
+                              snap.chain && !snap.reopen_required &&
+                                  snap.chain->stable_tip == block);
+                answer.pushKV("ever_connected",
+                              header &&
+                                  header->stage == HeaderStage::Connected);
+            } else if (name == "coin" || name == "proof") {
+                Keys(request, {"id", "command", "txid", "index"});
+                Outpoint key{HashOf(request["txid"]),
+                             uint32_t(Number(request["index"], UINT32_MAX))};
+                std::string error;
+                answer = Status();
+                Require(answer["tip_known"].get_bool(),
+                        "coin authority unavailable");
+                auto coinHex = [](const std::optional<Coin> &coin) {
+                    if (!coin) return UniValue();
+                    std::vector<uint8_t> wire;
+                    Require(EncodeCoin(*coin, wire), "coin encoding failure");
+                    return UniValue(Hex(wire));
+                };
+                if (name == "coin") {
+                    std::optional<Coin> coin;
+                    Require(runtime->ReadCoin(key, coin, error) ==
+                                Result::Progress,
+                            error);
+                    answer.pushKV("coin", coinHex(coin));
+                } else {
+                    CoinProof proof;
+                    Require(runtime->ProveCoin(key, proof, error) ==
+                                Result::Progress,
+                            error);
+                    Require(VerifyCoinProof(key, proof,
+                                            HashOf(answer["utxo_root"])),
+                            "proof/root mismatch");
+                    UniValue p(UniValue::VOBJ), siblings(UniValue::VARR);
+                    p.pushKV("presence", uint64_t(proof.presence));
+                    p.pushKV("coin", coinHex(proof.coin));
+                    p.pushKV("bitmap", Hex(proof.bitmap));
+                    for (const auto &h : proof.siblings)
+                        siblings.push_back(Hex(h));
+                    p.pushKV("siblings", siblings);
+                    answer.pushKV("proof", p);
+                }
+            } else
+                throw std::runtime_error(
+                    "unsupported local command; mining and transaction "
+                    "submission are not implemented");
+            answer.pushKV("ok", true);
+        } catch (const std::exception &e) {
+            answer = UniValue(UniValue::VOBJ);
+            answer.pushKV("ok", false);
+            answer.pushKV("error", std::string(e.what()).substr(0, 1024));
+        }
+        answer.pushKV("id", id);
+        Queue(std::move(answer));
+    }
+    void Node::ReadCommands() {
+        const size_t cap = 2 * manifest.block_read_limit + 1024;
+        std::array<char, 8192> buf{};
+        // At most eight reads/64KiB and eight commands per loop, separate from
+        // sockets.
+        for (unsigned reads = 0; reads < 8 && !eof && input.size() < cap;
+             ++reads) {
+            const auto n = read(STDIN_FILENO, buf.data(),
+                                std::min(buf.size(), cap - input.size()));
+            if (n > 0)
+                input.append(buf.data(), n);
+            else if (n == 0)
+                eof = true;
+            else {
+                Require(errno == EAGAIN || errno == EWOULDBLOCK ||
+                            errno == EINTR,
+                        "local command input failure");
+                break;
+            }
+        }
+        unsigned processed = 0;
+        while (processed++ < 8) {
+            const auto end = input.find('\n');
+            if (end == std::string::npos) break;
+            Command(input.substr(0, end));
+            input.erase(0, end + 1);
+            if (stopping) break;
+        }
+        Require(input.size() < cap, "local command line capacity exceeded");
+        if (eof && input.empty()) stopping = true;
+        if (eof && !input.empty() && input.find('\n') == std::string::npos) {
+            Command(input);
+            input.clear();
+            stopping = true;
+        }
+    }
+    void Node::Attach(Connection &c, uint64_t now) {
+        Require(Entropy(c.nonce), "version entropy unavailable");
+        uint64_t extra;
+        Require(Entropy(extra), "version extra entropy unavailable");
+        SessionConfig s{};
+        s.network = network.profile;
+        s.inbound = c.inbound;
+        s.handshake_timeout_ms = 10000;
+        s.incoming_nonce_allowed = [this](uint64_t nonce) {
+            return !outbound_nonces.contains(nonce);
+        };
+        s.local_version.timestamp = int64_t(Utc());
+        s.local_version.sender = VersionSender{VersionAddress{}, c.nonce};
+        s.local_version.user_agent =
+            Bytes{'l', 'o', 't', 'u', 's', '-', 'v', '2', '-', 'd', 'e', 'v'};
+        const auto snap = runtime->Snapshot();
+        std::optional<IndexedHeader> tip;
+        std::string error;
+        if (snap.chain) runtime->ReadHeader(snap.chain->stable_tip, tip, error);
+        s.local_version.starting_height =
+            tip ? int32_t(std::min<uint64_t>(tip->header.height, INT32_MAX))
+                : 0;
+        s.local_version.relay = true;
+        s.local_version.extra_entropy = extra;
+        c.transport = std::make_unique<Transport>(
+            c.stream, s,
+            TransportLimits{8192, size_t(network.profile.receive_limit) + 4096,
+                            16, 10000, 10000});
+        if (!c.inbound) outbound_nonces.insert(c.nonce);
+        if (dispatcher->Attach(*c.transport, c.id) !=
+            DispatcherResult::Queued) {
+            outbound_nonces.erase(c.nonce);
+            throw std::runtime_error("dispatcher attach refused");
+        }
+        if (dispatcher->Open(c.id, now) != DispatcherResult::Queued) {
+            dispatcher->Remove(c.id);
+            outbound_nonces.erase(c.nonce);
+            c.transport.reset();
+            throw std::runtime_error("dispatcher open refused");
+        }
+        c.refresh = now + 1000;
+    }
+    void Node::Connections(uint64_t now) {
+        for (auto i = connections.begin(); i != connections.end();) {
+            auto &c = **i;
+            if (!c.transport) {
+                const auto state = c.stream.PollConnect(now);
+                if (state == TcpConnectStatus::Connected)
+                    Attach(c, now);
+                else if (state != TcpConnectStatus::Pending)
+                    c.stream.Close();
+            }
+            if (!c.stream.IsOpen() ||
+                (c.transport && c.transport->State() == SessionState::Closed)) {
+                if (c.transport) dispatcher->Remove(c.id);
+                outbound_nonces.erase(c.nonce);
+                if (c.target) retry[*c.target] = now + 1000;
+                i = connections.erase(i);
+            } else
+                ++i;
+        }
+        for (unsigned i = 0; i < 2 && connections.size() < MaxPeers; ++i) {
+            auto c = std::make_unique<Connection>();
+            TcpEndpoint remote;
+            const auto result = listener.Accept(c->stream, remote);
+            if (result == TcpAcceptStatus::WouldBlock) break;
+            Require(result == TcpAcceptStatus::Accepted,
+                    "listener accept failure");
+            c->inbound = true;
+            connections.push_back(std::move(c));
+            Attach(*connections.back(), now);
+        }
+        if (connections.size() >= MaxPeers || network.connect.empty()) return;
+        const size_t target = target_cursor++ % network.connect.size();
+        if (now < retry[target]) return;
+        for (const auto &c : connections)
+            if (c->target == target) return;
+        auto c = std::make_unique<Connection>();
+        c->target = target;
+        const auto result =
+            c->stream.BeginConnect(network.connect[target], now, 5000);
+        if (result != TcpConnectStatus::Connected &&
+            result != TcpConnectStatus::Pending) {
+            retry[target] = now + 1000;
+            return;
+        }
+        connections.push_back(std::move(c));
+        if (result == TcpConnectStatus::Connected)
+            Attach(*connections.back(), now);
+    }
+    void Node::Track(const Hash &id) {
+        if (std::find(tracked_bodies.begin(), tracked_bodies.end(), id) ==
+            tracked_bodies.end()) {
+            Require(tracked_bodies.size() < 32, "local body tracking capacity");
+            tracked_bodies.push_back(id);
+        }
+    }
+    void Node::CleanupBodies() {
+        // Four body entries/eight fixed-size queries per turn; only durable
+        // connected or invalid bodies can leave the volatile pool.
+        // Pinned/recovery bodies retain their leases.
+        for (unsigned n = 0; n < 4 && !tracked_bodies.empty(); ++n) {
+            body_cursor %= tracked_bodies.size();
+            const auto id = tracked_bodies[body_cursor];
+            std::optional<IndexedHeader> h;
+            std::optional<Hash> invalid;
+            std::string error;
+            const auto a = runtime->ReadHeader(id, h, error),
+                       b = runtime->ReadInvalidity(id, invalid, error);
+            if (a == Result::Progress && b == Result::Progress &&
+                (invalid || (h && h->stage == HeaderStage::Connected))) {
+                CandidateBodyStatus status =
+                    CandidateBodyStatus::OperationalError;
+                if (runtime->EvictBody(id, status, error) == Result::Progress ||
+                    status == CandidateBodyStatus::Missing) {
+                    tracked_bodies.erase(tracked_bodies.begin() + body_cursor);
+                    continue;
+                }
+            }
+            ++body_cursor;
+        }
+    }
+    void Node::Drain() {
+        if (observed_fetch_epoch != dispatcher->FetchEpoch()) {
+            observed_fetch_epoch = dispatcher->FetchEpoch();
+            for (auto &c : connections)
+                c->requested.reset();
+        }
+        for (size_t n = 0; n < 256; ++n) {
+            auto notice = dispatcher->TakeNotice();
+            if (!notice) break;
+            if (notice->kind == DispatcherNoticeKind::Activated)
+                Count(active_events);
+            if (notice->kind == DispatcherNoticeKind::Download &&
+                notice->download) {
+                const auto &e = *notice->download;
+                // Ignored/Busy are observations about an unsolicited or
+                // repeated message, not completion of an existing full fallback
+                // job.
+                const bool terminal = [&]() {
+                    switch (e.result) {
+                        case DownloadResult::Accepted:
+                        case DownloadResult::ConsensusRejected:
+                        case DownloadResult::PeerMessageInvalid:
+                        case DownloadResult::CapacityRefused:
+                        case DownloadResult::Unsupported:
+                        case DownloadResult::OperationalFailure:
+                        case DownloadResult::RetryElsewhere:
+                        case DownloadResult::Cancelled:
+                        case DownloadResult::RetainedAuthenticated:
+                            return true;
+                        default:
+                            return false;
+                    }
+                }();
+                if (terminal)
+                    for (auto &c : connections)
+                        if (c->id == notice->connection &&
+                            c->requested == e.block_id)
+                            c->requested.reset();
+                if (e.result == DownloadResult::RetryElsewhere)
+                    for (auto &c : connections)
+                        if (c->id == notice->connection && c->transport)
+                            c->transport->Close();
+                if (e.fallback)
+                    for (auto &c : connections)
+                        if (c->id == notice->connection)
+                            c->requested_fallback = true;
+                if (e.result == DownloadResult::RetainedAuthenticated) {
+                    for (const auto &c : connections)
+                        if (c->id == notice->connection) {
+                            if (c->requested_compact && !c->requested_fallback)
+                                Count(compact_retained);
+                            else
+                                Count(full_retained);
+                        }
+                    Count(retained);
+                    choices.reset();
+                }
+                if (e.fallback) Count(fallbacks);
+            }
+            // Generic capacity notices can be transient output/notice/staging
+            // backpressure; they never justify aborting an unrelated live job.
+            if (notice->kind == DispatcherNoticeKind::HeaderAvailable)
+                choices.reset();
+        }
+    }
+    void Node::Headers(uint64_t now, bool changed) {
+        for (auto &c : connections)
+            if (c->transport && c->transport->State() == SessionState::Active &&
+                (changed || now >= c->refresh)) {
+                dispatcher->StartHeaders(c->id, Hash{}, now);
+                c->refresh = now + 1000;
+            }
+    }
+    void Node::Schedule(uint64_t now) {
+        if (!choices || !choices->best_fetch || connections.empty()) return;
+        const auto snap = runtime->Snapshot();
+        if (!snap.chain || snap.reopen_required || snap.execution_paused ||
+            snap.chain->pending_journal || snap.chain->pending_receipt)
+            return;
+        if (choices->view.stable_tip != snap.chain->stable_tip ||
+            choices->body_epoch != snap.body_epoch) {
+            choices.reset();
+            return;
+        }
+        // One request per loop. Manager tombstones suppress duplicates until a
+        // bounded connection rotation releases that physical session's guards.
+        for (const auto &need : choices->best_fetch->missing) {
+            bool inflight = false;
+            for (const auto &c : connections)
+                if (c->requested == need.id) inflight = true;
+            if (inflight) continue;
+            std::optional<IndexedHeader> tip;
+            std::string error;
+            runtime->ReadHeader(snap.chain->stable_tip, tip, error);
+            const auto mode =
+                tip && (choices->best_fetch->indexed.header.height <=
+                            tip->header.height ||
+                        choices->best_fetch->indexed.header.height -
+                                tip->header.height <=
+                            1)
+                    ? DownloadMode::Compact
+                    : DownloadMode::Full;
+            for (size_t k = 0; k < connections.size(); ++k) {
+                auto &c =
+                    *connections[(request_cursor + k) % connections.size()];
+                if (!c.transport ||
+                    c.transport->State() != SessionState::Active || c.requested)
+                    continue;
+                if (c.issued_requests >= 64) {
+                    c.transport->Close();
+                    return;
+                }
+                const auto result =
+                    dispatcher->RequestBlock(c.id, need.header, mode, now);
+                if (result == DispatcherResult::Queued) {
+                    ++c.issued_requests;
+                    c.requested = need.id;
+                    c.requested_compact = mode == DownloadMode::Compact;
+                    c.requested_fallback = false;
+                    if (mode == DownloadMode::Full)
+                        Count(full_requests);
+                    else
+                        Count(compact_requests);
+                    ++request_cursor;
+                    return;
+                }
+                if (result == DispatcherResult::CapacityRefused) return;
+            }
+        }
+    }
+    void Node::Run() {
+        Nonblocking in(STDIN_FILENO), out(STDOUT_FILENO);
+        IgnorePipe pipe;
+        auto ready = Status();
+        UniValue endpoint(UniValue::VOBJ);
+        endpoint.pushKV("address", Address(bound));
+        endpoint.pushKV("port", uint64_t(bound.port));
+        ready.pushKV("listen", endpoint);
+        ready.pushKV("event", "ready");
+        Queue(ready);
+        auto snap = runtime->Snapshot();
+        if (snap.chain) last_tip = snap.chain->stable_tip;
+        const DispatcherBudget budget{64,
+                                      {128, 256 * 1024, 256 * 1024},
+                                      64,
+                                      16,
+                                      size_t(manifest.block_read_limit)};
+        const auto limits = TickLimits(manifest.block_read_limit);
+        while (!stopping) {
+            const auto now = Monotonic();
+            Drain();
+            Connections(now);
+            const auto usage =
+                dispatcher->Tick(now, Utc(), manifest.future_window, budget);
+            Count(served_bytes, usage.served_bytes);
+            Drain();
+            auto tick = runtime->Tick(Utc(), manifest.future_window, limits);
+            if (tick.choices) choices = std::move(tick.choices);
+            bool changed = false;
+            const auto current = runtime->Snapshot();
+            if (current.chain && !current.reopen_required &&
+                !current.chain->pending_receipt &&
+                !current.chain->pending_journal &&
+                current.chain->stable_tip != last_tip) {
+                last_tip = current.chain->stable_tip;
+                Count(tip_changes);
+                changed = true;
+                auto event = Status();
+                event.pushKV("event", "tip");
+                Queue(event);
+            }
+            CleanupBodies();
+            Headers(now, changed);
+            Schedule(now);
+            Drain();
+            ReadCommands();
+            Flush();
+            std::array<pollfd, MaxPeers + 3> fds{};
+            size_t count = 0;
+            fds[count++] = {STDIN_FILENO, POLLIN, 0};
+            if (!output.empty()) fds[count++] = {STDOUT_FILENO, POLLOUT, 0};
+            fds[count++] = {listener.NativeHandle(), POLLIN, 0};
+            for (const auto &c : connections)
+                fds[count++] = {
+                    c->stream.NativeHandle(),
+                    short(POLLIN |
+                          (c->transport && c->transport->QueuedBytes() ? POLLOUT
+                                                                       : 0)),
+                    0};
+            const int result = poll(fds.data(), count, 10);
+            Require(result >= 0 || errno == EINTR, "local event poll failure");
+        }
+        const auto deadline = Monotonic() + 2000;
+        while (!output.empty() && Monotonic() < deadline) {
+            Flush();
+            if (!output.empty()) {
+                pollfd fd{STDOUT_FILENO, POLLOUT, 0};
+                poll(&fd, 1, 10);
+            }
+        }
+    }
+} // namespace
+#endif
+int RunDevelopmentNodeCommand(int argc, char *argv[]) {
+#if defined(__linux__) || defined(__APPLE__)
+    try {
+        Require(argc == 5,
+                "usage: lotusd -lotusv2node MANIFEST DATADIR NETWORK.json");
+        DevelopmentManifest manifest;
+        std::string error;
+        Require(LoadDevelopmentManifest(argv[2], manifest, error), error);
+        const auto network = Network(argv[4], manifest);
+        std::string directory;
+        Require(PrepareDevelopmentHomeDirectory(manifest, argv[3], directory,
+                                                error),
+                error);
+        std::unique_ptr<DevelopmentRuntime> runtime;
+        Require(DevelopmentRuntime::Open(RuntimeConfig(manifest, directory),
+                                         runtime, error),
+                error);
+        Node node(std::move(manifest), network, std::move(runtime));
+        node.Run();
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << "V2 development node: " << e.what() << '\n';
+        return 1;
+    }
+#else
+    (void)argc;
+    (void)argv;
+    std::cerr << "V2 development node requires Linux or macOS\n";
+    return 1;
+#endif
+}
+} // namespace lotus::v2
