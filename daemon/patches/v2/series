20-qt-gui.patch
# CMake 4.x + Boost 1.90 fixes (macOS arm64)
21-build-compat.patch
# Boot subsidy: height-based step-halvings (10M XPI → 260 XPI floor, ~73-day half-life)
22-boot-subsidy.patch
# Tail emission: sqrt-adaptive stateful emission via nTailSubsidy consensus variable
23-tail-subsidy.patch
# IFP disabled: enableMinerFund=false, coinbasePayoutAddresses cleared; mechanism preserved
24-ifp-removal.patch
# OP_LOG (0xbd) and OP_SQRT (0xbe): consensus integer math opcodes with full test suite
25-26-op-log-op-sqrt.patch
# OP_MUL (0x95) re-enabled: 63-bit signed multiply with overflow detection
27-op-mul.patch
# Big-integer opcodes (0xbf–0xc4): BIGADD/BIGSUB/BIGMUL/BIGMOD/BIGDIVMOD/BIGMULMOD
# Up to 256-bit sign-magnitude operands; BIGMULMOD is the key crypto primitive
28-bigint-ops.patch
# O(n log n) block construction: addPackageTxs no longer reads mapTx CPFP fields
# Step 1 of 3 (step 2=remove mempool accounting, step 3=cleanup)
# Ported from github.com/schancel/bitcoin-abc:simple-mining (D2866)
29-nlogn-block-construction.patch
# Chain tx limit removed: mining no longer requires mempool package accounting (patch 29)
30-remove-chaintx-limit.patch
# Delete the 8 CTxMemPoolEntry accounting fields and O(n²) maintenance.
# TrimToSize now uses LowestPackageFeeRateEntry (O(n) forward scan).
# RPC loses ancestorcount/descendantcount fields; GetTransactionAncestry uses BFS.
