 src/lotus_v2/avalanche_driver.h        | 10 ++++
 src/lotus_v2/avalanche_quorum.cpp      | 23 ++++++++-
 src/lotus_v2/avalanche_quorum.h        | 13 +++++-
 src/lotus_v2/test_avalanche_driver.cpp | 65 ++++++++++++++++++++++++++
 5 files changed, 120 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/avalanche_driver.cpp b/src/lotus_v2/avalanche_driver.cpp
index a72d8d36e84eaf7f4f4d0b12a001e6154b734f5d..1b433828ffeaaf7a4f334c6a6e3223bf5d2d35bc 100644
--- a/src/lotus_v2/avalanche_driver.cpp
+++ b/src/lotus_v2/avalanche_driver.cpp
@@ -22,6 +22,19 @@ RuntimeBlockStatus Map(Status s) {
 AvalancheDriver::AvalancheDriver(DevelopmentRuntime &r, peer::PeerDispatcher &d, DriverConfig c)
     : runtime_(r), config_(std::move(c)), quorum_(config_.profile), polls_(config_.profile),
       store_(config_.peer_file, config_.profile), peer_(d, config_.limits, Callbacks()) {}
+DriverStatus AvalancheDriver::Status() const {
+    const auto quorum=quorum_.Status();
+    const auto native=runtime_.Snapshot();
+    const bool current=validated_ && native.chain && !native.reopen_required &&
+        !native.execution_paused && !native.chain->pending_journal &&
+        !native.chain->pending_receipt && !native.chain->pending_propagation &&
+        validated_->tip==native.chain->stable_tip &&
+        validated_->generation==native.context_generation;
+    return {started_,failed_,initial_download_,
+        Ready() && !initial_download_ && current && quorum.ready,
+        quorum.established,quorum.proof_count,quorum.authenticated_peer_count,
+        quorum.eligible_peer_count,quorum.active_stake_score,quorum.connected_stake_score};
+}
 bool AvalancheDriver::Snapshot(ChainSnapshot &out, std::string &e) {
     auto before=runtime_.Snapshot();
     if(!before.chain || before.reopen_required || before.execution_paused || before.chain->pending_journal || before.chain->pending_receipt || before.chain->pending_propagation)
diff --git a/src/lotus_v2/avalanche_driver.h b/src/lotus_v2/avalanche_driver.h
index e7c3e4f798852ae7ee42c68c68d2d5b0f5d07c9b..83796780dae9a16da3262e6ea93fbfdb20a70d14 100644
--- a/src/lotus_v2/avalanche_driver.h
+++ b/src/lotus_v2/avalanche_driver.h
@@ -20,6 +20,15 @@ struct DriverResult {
     std::string message;
     explicit operator bool() const { return code == DriverCode::Ok; }
 };
+// Read-only observation. Quorum readiness also requires completed IBD and a
+// current authoritative runtime snapshot matching the last proof validation.
+// Establishment is the actual quorum latch, independent of current readiness.
+struct DriverStatus {
+    bool started{}, failed{}, initial_download{true};
+    bool quorum_ready{}, quorum_established{};
+    uint64_t proof_count{}, authenticated_peer_count{}, eligible_peer_count{};
+    uint64_t active_stake_score{}, connected_stake_score{};
+};
 // Single owner. Application inv/getdata notices must contain proof inventory
 // only: the node demultiplexes transaction inventory before calling Handle.
 // Caller retains notices on Backpressure. IBD is explicit; clocks are supplied
@@ -35,6 +44,7 @@ public:
     DriverResult Save();
     bool Reconcile(const PollItem &, bool, std::string &);
     bool Ready() const { return started_ && !failed_; }
+    DriverStatus Status() const;
 private:
     bool Snapshot(ChainSnapshot &, std::string &);
     bool Refresh(ChainSnapshot &, std::string &);
diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index b64840fcb236a42f4cb4ede234b632c24a86ac00..8cf54684a25534cae4245c2cc93dcace1339626d 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -133,6 +133,25 @@ bool Quorum::Ready() const {
     for(const auto &[id,node]:impl_->nodes) if(impl_->active.getProof(node.hello.proof_id)) ++count;
     return count>=8;
 }
+QuorumStatus Quorum::Status() const {
+    QuorumStatus status;
+    status.established=impl_->established;
+    status.proof_count=impl_->entries.size();
+    status.authenticated_peer_count=impl_->nodes.size();
+    std::set<::avalanche::ProofId> connected;
+    for(const auto &[id,node]:impl_->nodes) {
+        if(impl_->active.getProof(node.hello.proof_id)) {
+            ++status.eligible_peer_count;
+            connected.insert(node.hello.proof_id);
+        }
+    }
+    impl_->active.forEachProof([&](const auto &proof) {
+        status.active_stake_score+=proof->getScore();
+        if(connected.contains(proof->getId())) status.connected_stake_score+=proof->getScore();
+    });
+    status.ready=status.established && status.eligible_peer_count>=8;
+    return status;
+}
 std::optional<NodeId> Quorum::Select(int64_t now) {
     std::vector<std::pair<::avalanche::ProofId,uint32_t>> slots;
     uint64_t total=0;
@@ -191,7 +210,7 @@ bool Quorum::Revalidate(const ChainSnapshot &snapshot,const CoinLookup &lookup,i
     error.clear();
     return true;
 }
-bool Quorum::ApplyProofVote(const ::avalanche::ProofId &id,Status status,int64_t now,std::string &error) {
+bool Quorum::ApplyProofVote(const ::avalanche::ProofId &id,::lotus::v2::ava::Status status,int64_t now,std::string &error) {
     auto it=impl_->entries.find(id); if(it==impl_->entries.end()) return Fail(error,"unknown-proof");
     auto proof=it->second.envelope.proof;
     if(it->second.immature) return Fail(error,"immature-proof-vote");
@@ -208,7 +227,7 @@ bool Quorum::ApplyProofVote(const ::avalanche::ProofId &id,Status status,int64_t
     if(status==Status::Finalized) { it->second.finalized=true; impl_->finalized.insert(id); }
     return true;
 }
-bool Quorum::ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,Status>> &votes,
+bool Quorum::ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,::lotus::v2::ava::Status>> &votes,
     int64_t now,const std::function<bool(std::string &)> &commit_blocks,std::string &error) {
     if(votes.empty()) return commit_blocks && commit_blocks(error);
     Quorum staged(impl_->profile); staged.impl_=std::make_unique<Impl>(*impl_);
diff --git a/src/lotus_v2/avalanche_quorum.h b/src/lotus_v2/avalanche_quorum.h
index 0c9dec9bd34a513421c5dd649ebd150a5b45d753..c40b8a621c0c52b1c11af687a68cb1cb4025cb52 100644
--- a/src/lotus_v2/avalanche_quorum.h
+++ b/src/lotus_v2/avalanche_quorum.h
@@ -10,6 +10,14 @@ struct PersistedPeer {
     bool finalized{};
     int64_t registration_time{}, next_conflict_time{};
 };
+// Counts describe current proof membership and authenticated bindings. Eligible
+// peers have an active proof; cooldown does not change eligibility. Connected
+// stake counts each active proof once, even when multiple peers bind it.
+struct QuorumStatus {
+    bool ready{}, established{};
+    uint64_t proof_count{}, authenticated_peer_count{}, eligible_peer_count{};
+    uint64_t active_stake_score{}, connected_stake_score{};
+};
 class Quorum {
 public:
     explicit Quorum(Profile);
@@ -22,13 +30,14 @@ public:
     void SentProofInventory(NodeId, const ChainSnapshot &);
     bool Established(const ChainSnapshot &);
     bool Ready() const;
+    QuorumStatus Status() const;
     std::optional<NodeId> Select(int64_t now_milliseconds);
     std::optional<AuthenticatedHello> Node(NodeId) const;
     void Cooldown(NodeId, int64_t until_milliseconds);
     bool Revalidate(const ChainSnapshot &, const CoinLookup &, int64_t now_seconds, const SnapshotReader &, std::string &);
-    bool ApplyProofVote(const ::avalanche::ProofId &, Status, int64_t now_seconds,
+    bool ApplyProofVote(const ::avalanche::ProofId &, ::lotus::v2::ava::Status, int64_t now_seconds,
                         std::string &);
-    bool ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,Status>> &,
+    bool ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,::lotus::v2::ava::Status>> &,
                          int64_t now_seconds,
                          const std::function<bool(std::string &)> &commit_blocks,
                          std::string &);
diff --git a/src/lotus_v2/test_avalanche_driver.cpp b/src/lotus_v2/test_avalanche_driver.cpp
index d524fe05bbdef8ed472a877eb7926248252394ef..55b3d91e077ae7f04ff7ab41ff84771ac0c0fd64 100644
--- a/src/lotus_v2/test_avalanche_driver.cpp
+++ b/src/lotus_v2/test_avalanche_driver.cpp
@@ -1,5 +1,6 @@
 // Copyright (c) 2026 The Lotus developers
 #include "avalanche_driver.h"
+#include "commitment.h"
 #include "avalanche_peer_test/fixtures.h"
 #include <avalanche/proofbuilder.h>
 #include <avalanche/delegationbuilder.h>
@@ -21,18 +22,78 @@ ProofEnvelope AbsentProof(const CKey &key) {
     Check(b.addUTXO(COutPoint(TxId(uint256::ONE),0),int64_t(1000000000000ULL)*SATOSHI,0,false,key),"signed absent proof");
     return {b.build(),{lock}};
 }
+void QuorumStatusChecks() {
+    Profile profile; profile.chain_id[0]=1;profile.genesis_id[0]=2;profile.validation_digest[0]=3;
+    ChainSnapshot snapshot;snapshot.tip[0]=4;snapshot.height=3000;snapshot.initial_download=false;
+    CKey key;key.MakeNewKey(true);auto pub=key.GetPubKey();
+    std::vector<uint8_t> lock{32};lock.insert(lock.end(),pub.begin()+1,pub.end());lock.insert(lock.end(),{0xbc,0x4e});
+    Coin coin;coin.outpoint.tx_id[0]=9;coin.creation_height=1;
+    coin.output.value=1000000000000ULL;coin.output.branches={BranchLeaf(lock)};coin.output.paths={{0}};
+    uint256 tx;std::copy(coin.outpoint.tx_id.begin(),coin.outpoint.tx_id.end(),tx.begin());
+    ::avalanche::ProofBuilder builder(1,0,key,CScript{} << OP_DUP << OP_HASH160 << std::vector<uint8_t>(20,1) << OP_EQUALVERIFY << OP_CHECKSIG);
+    Check(builder.addUTXO(COutPoint(TxId(tx),0),int64_t(coin.output.value)*SATOSHI,1,false,key),"signed mature proof");
+    ProofEnvelope envelope{builder.build(),{lock}};
+    lotus::v2::ava::CoinLookup lookup=[&](const Outpoint &o,std::optional<Coin> &out,std::string &){out=o==coin.outpoint?std::optional<Coin>(coin):std::nullopt;return true;};
+    auto reader=[&]{return snapshot;};std::string e;Quorum quorum(profile);
+    Check(quorum.Register(envelope,snapshot,lookup,0,reader,e),"default-policy mature proof admission: "+e);
+    auto delegation=::avalanche::DelegationBuilder(*envelope.proof).build();
+    ConnectionTranscript transcript{1,2,3,4};SchnorrSig signature;
+    Check(key.SignSchnorr(HelloDigest(delegation,transcript),signature),"signed quorum hello");
+    for(int i=0;i<8;++i) {
+        Check(quorum.Bind(i,delegation,signature,transcript,16,e),"authenticated quorum binding");
+        quorum.SentProofInventory(i,snapshot);
+    }
+    const auto score=envelope.proof->getScore();
+    const auto before=quorum.Status();
+    Check(!before.established && !before.ready && before.proof_count==1 &&
+        before.authenticated_peer_count==8 && before.eligible_peer_count==8 &&
+        before.active_stake_score==score && before.connected_stake_score==score,
+        "status observes threshold eligibility without setting establishment latch or multiplying stake");
+    Check(!quorum.Status().established && !quorum.Ready(),"repeated status never establishes quorum");
+    snapshot.initial_download=true;
+    Check(!quorum.Established(snapshot) && !quorum.Status().established,"IBD prevents actual quorum establishment");
+    snapshot.initial_download=false;
+    Check(quorum.Established(snapshot),"normal operational establishment meets unchanged default policy");
+    Check(quorum.Status().established && quorum.Status().ready,"status sees operational establishment latch");
+    quorum.Cooldown(0,1000000);
+    Check(quorum.Status().eligible_peer_count==8,"selection cooldown preserves active-proof eligibility");
+    quorum.Disconnect(0);
+    Check(quorum.Status().established && !quorum.Status().ready &&
+        quorum.Status().authenticated_peer_count==7 && quorum.Status().eligible_peer_count==7 &&
+        quorum.Status().connected_stake_score==score,"disconnect revokes readiness while preserving latch");
+    Check(quorum.ApplyProofVote(envelope.proof->getId(),Status::Rejected,1,e),"reject active proof");
+    Check(quorum.Status().proof_count==1 && quorum.Status().authenticated_peer_count==7 &&
+        quorum.Status().eligible_peer_count==0 && quorum.Status().active_stake_score==0 &&
+        quorum.Status().connected_stake_score==0,"conflicting proof retains storage but loses voting eligibility");
+    Check(quorum.ApplyProofVote(envelope.proof->getId(),Status::Invalid,2,e),"invalidate stored proof");
+    Check(quorum.Status().proof_count==0 && quorum.Status().established,"proof removal preserves actual latch");
+}
+
 }
 int main() {
     ECC_Start();
     try {
+        QuorumStatusChecks();
         Pair pair;std::string e;
         auto config=Configuration(pair.a);
         AvalancheDriver observer(*pair.a.runtime,*pair.a.dispatcher,config);
+        const auto unstarted=observer.Status();
+        Check(!unstarted.started && !unstarted.failed && unstarted.initial_download &&
+            !unstarted.quorum_ready && !unstarted.quorum_established && unstarted.proof_count==0,
+            "unstarted driver status is passive and empty");
         Check(bool(observer.Start(true,1700000000)),"observer starts with exact default policy and native runtime");
         Check(observer.Ready(),"observer ready without invented stake");
+        const auto started=observer.Status();
+        Check(started.started && !started.failed && started.initial_download &&
+            !started.quorum_ready && !started.quorum_established,
+            "driver startup readiness is distinct from IBD quorum readiness");
         Check(observer.Activate(pair.a.connection,e)==PeerResult::Accepted,"real negotiated activation");
         Check(bool(observer.Tick(true,100,1700000000)),"IBD tick cannot establish voting quorum");
         Check(bool(observer.Tick(false,101,1700000001)),"explicit IBD completion with no stake");
+        const auto idle=observer.Status();
+        Check(idle.started && !idle.initial_download && !idle.quorum_ready && !idle.quorum_established &&
+            idle.authenticated_peer_count==0 && idle.eligible_peer_count==0 && idle.active_stake_score==0 &&
+            idle.connected_stake_score==0,"observer IBD completion invents no authenticated peers or quorum");
         Check(observer.Tick(false,100,1700000002).code==DriverCode::InvalidConfiguration,"monotonic time regression refused");
         Check(observer.Reconcile({ItemKind::Block,config.profile.genesis_id},true,e),"real indexed genesis reconciliation");
         Check(bool(observer.Save()),"real public peer store saved");
@@ -73,6 +134,8 @@ int main() {
         Check(requests==2,"exactly one new request after cooldown expires");
         remote.Disconnect(pair.b.connection);
         observer.Disconnect(pair.a.connection);
+        Check(observer.Status().authenticated_peer_count==0 && !observer.Status().quorum_ready,
+            "observer status after actual transport disconnect");
         auto lowered=Configuration(pair.b);lowered.profile.stake_confirmations=1;
         AvalancheDriver bad(*pair.b.runtime,*pair.b.dispatcher,lowered);
         Check(bad.Start(false,1700000000).code==DriverCode::InvalidConfiguration,"lowered maturity rejected");
@@ -91,6 +154,8 @@ int main() {
         AvalancheDriver failed(*pair.b.runtime,*pair.b.dispatcher,corrupt);
         auto result=failed.Start(false,1700000000);
         Check(result.code==DriverCode::StoreFailure && result.store_code==PeerStoreCode::Resource && !failed.Ready(),"typed corrupt store fails closed: "+std::to_string(int(result.code))+"/"+std::to_string(int(result.store_code))+" "+result.message);
+        Check(failed.Status().failed && !failed.Status().started && !failed.Status().quorum_ready,
+            "typed store failure is visible through passive status");
         auto missing=Configuration(pair.b);missing.local_proof=proof;
         ::avalanche::DelegationBuilder delegation(*proof.proof);missing.delegation=delegation.build();
         AvalancheDriver unavailable(*pair.b.runtime,*pair.b.dispatcher,missing);
