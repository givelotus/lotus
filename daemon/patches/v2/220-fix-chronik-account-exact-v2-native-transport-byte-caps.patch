From b7655b9202386e0807cc122199f695ac149a153d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:42:55 -0700
Subject: [PATCH] fix(chronik): account exact V2 native transport byte caps

---
 chronik/chronik-lib/src/v2.rs            | 14 +++--
 chronik/chronik-lib/src/v2tests/tests.rs | 65 ++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 5 deletions(-)

diff --git a/chronik/chronik-lib/src/v2.rs b/chronik/chronik-lib/src/v2.rs
index 09d59066fef27d572768fb205e6ff4cc15b29bf1..5066a403732d1fdcbd0756a017ced39e2bdea78f 100644
--- a/chronik/chronik-lib/src/v2.rs
+++ b/chronik/chronik-lib/src/v2.rs
@@ -10,6 +10,8 @@
 //!
 //! Native callers authenticate consensus, canonical IDs and committed ordering.
 //! This service checks bindings and model shape, and never advances node state.
+//! CXX caller vectors already exist when entering Rust. Caps reject them before
+//! allocating model copies; native callers must also bound their construction.
 //! Readiness is only the equality of separately supplied node/index checkpoints.
 use std::{path::Path, sync::{Arc, Mutex, MutexGuard}};
 use bitcoinsuite_core::lotus_v2::{Hash32, OutPoint, Output, OutputRecord, TxId, TxHash, TxLocation, MAX_OUTPUT_BYTES};
@@ -44,7 +46,8 @@ impl V2Service {
     fn lock(&self)->Result<MutexGuard<'_,V2Db>> {self.db.lock().map_err(|_|"V2 DB lock poisoned".into())}
     fn block(&self,block:f::NativeBlock)->Result<db::CommittedBlock> {
         if block.transactions.len()>self.limits.transactions as usize {return Err("transaction bound".into());}
-        let mut bytes=80usize; let mut changes=0usize;
+        let mut bytes=84usize; let mut changes=0usize;
+        if bytes > self.limits.block_bytes as usize {return Err("block bytes bound".into());}
         for tx in &block.transactions {
             changes=changes.checked_add(tx.inputs.len()).and_then(|n|n.checked_add(tx.outputs.len())).ok_or("change overflow")?;
             bytes=bytes.checked_add(76).and_then(|n|tx.inputs.len().checked_mul(40).and_then(|k|n.checked_add(k))).ok_or("block overflow")?;
@@ -78,6 +81,7 @@ impl V2Service {
     }
     /// Query confirmed branch records or UTXOs on one stable bounded snapshot.
     pub fn query_branches(&self,request:f::BranchRequest)->Result<f::BranchPage> {
+        if request.positions.len()>self.limits.clauses as usize || request.any_branch.len()>self.limits.roots as usize {return Err("query input bound".into());}
         let total=request.positions.iter().try_fold(request.any_branch.len(),|n,p|n.checked_add(p.roots.len())).ok_or("root overflow")?;
         if total>self.limits.roots as usize || request.positions.len()>self.limits.clauses as usize {return Err("query input bound".into());}
         let filter=q::BranchFilter {any_branch:request.any_branch.into_iter().map(|r|Hash32(r.bytes)).collect(),positions:request.positions.into_iter().map(|p|q::PositionClause {position:p.position,roots:p.roots.into_iter().map(|r|Hash32(r.bytes)).collect()}).collect()};
@@ -87,16 +91,16 @@ impl V2Service {
         let source=Source(database.snapshot().map_err(|e|e.to_string())?);
         // Fixed-width transport includes absent spend slots. This conservative
         // budget covers vector framing and all optional cursor/record fields.
-        let envelope=240usize;
+        let envelope=307usize;
         let room=self.limits.response_bytes as usize-envelope;
-        let page_cap=(self.limits.page_size as usize).min(room/240).max(1);
-        let limits=q::Limits {roots:self.limits.roots as usize,clauses:self.limits.clauses as usize,page_size:page_cap,posting_reads:self.limits.posting_reads as usize,work:self.limits.work as usize,result_bytes:room.saturating_sub(page_cap*111)};
+        let page_cap=(self.limits.page_size as usize).min(room/300).max(1);
+        let limits=q::Limits {roots:self.limits.roots as usize,clauses:self.limits.clauses as usize,page_size:page_cap,posting_reads:self.limits.posting_reads as usize,work:self.limits.work as usize,result_bytes:room.saturating_sub(page_cap*119)};
         let page=q::query(&source,&filter,if request.utxos {q::QueryKind::Utxos} else {q::QueryKind::History {include_burn:request.include_burn}},limits,cursor).map_err(|e|format!("V2 query: {e:?}"))?;
         let matches=page.matches.into_iter().map(|m| {
             let spend=m.record.spend;
             Ok(f::OutputMatch {txid:m.record.outpoint.txid.0.0,out_idx:m.record.outpoint.out_idx,wire:m.record.output.encode().map_err(|e|e.to_string())?,creation:location(m.record.creation),spent:spend.is_some(),spend:spend.map(|s|location(s.transaction)).unwrap_or_else(empty_location),input_index:spend.map_or(0,|s|s.input_index),matching_positions:m.matching_positions})
         }).collect::<Result<Vec<_>>>()?;
-        let encoded_bytes=page.result_bytes+envelope+matches.len()*111;
+        let encoded_bytes=envelope + matches.iter().map(|m|265 + m.wire.len() + m.matching_positions.len()).sum::<usize>();
         if encoded_bytes>self.limits.response_bytes as usize {return Err("response bytes bound".into());}
         Ok(f::BranchPage {anchor:f::Anchor {block_id:page.snapshot.tip.0,height:page.snapshot.height},chain_id:page.snapshot.chain_id.0,profile:page.snapshot.profile_id.0,matches,cursor:continuation(page.continuation),posting_reads:page.posting_reads as u64,work:page.work as u64,encoded_bytes:encoded_bytes as u64})
     }
diff --git a/chronik/chronik-lib/src/v2tests/tests.rs b/chronik/chronik-lib/src/v2tests/tests.rs
index fb6f18ce8e411fb63daade8d5efe1757c3342df1..b03cfe6efd862af80cbbdfa25482bfd6f685e52d 100644
--- a/chronik/chronik-lib/src/v2tests/tests.rs
+++ b/chronik/chronik-lib/src/v2tests/tests.rs
@@ -39,6 +39,7 @@ fn explicit_genesis_complete_spend_disconnect_reopen() {
     let mut stale=request(true);stale.cursor=cursor;
     assert!(service.query_branches(stale).is_err());
     let history=service.query_branches(request(false)).unwrap();
+    assert_eq!(history.encoded_bytes as usize, encoded_page(&history).len());
     assert!(history.matches[0].spent);
     assert_eq!(history.matches[0].input_index,3);
     assert_eq!(service.query_branches(request(true)).unwrap().matches[0].txid,[12;32]);
@@ -78,3 +79,67 @@ fn input_and_response_caps_preserve_checkpoint() {
     let service=open_service(path.path(),binding(),false,caps).unwrap();
     assert!(service.query_branches(request(true)).is_err());
 }
+
+// Independent canonical transport encoder: exercise each actual field, rather
+// than duplicating the service's fixed-overhead accounting constants.
+fn encoded_page(page: &f::BranchPage) -> Vec<u8> {
+    fn a(out: &mut Vec<u8>, a: &f::Anchor) {
+        out.extend(a.block_id); out.extend(a.height.to_le_bytes());
+    }
+    fn loc(out: &mut Vec<u8>, l: &f::Location) {
+        a(out,&l.anchor); out.extend(l.tx_index.to_le_bytes());
+        out.extend(l.txid); out.extend(l.txhash);
+    }
+    fn vec(out: &mut Vec<u8>, b: &[u8]) {
+        out.extend((b.len() as u32).to_le_bytes()); out.extend(b);
+    }
+    let mut out=Vec::new();
+    a(&mut out,&page.anchor); out.extend(page.chain_id); out.extend(page.profile);
+    out.extend((page.matches.len() as u32).to_le_bytes());
+    for m in &page.matches {
+        out.extend(m.txid); out.extend(m.out_idx.to_le_bytes()); vec(&mut out,&m.wire);
+        loc(&mut out,&m.creation); out.push(u8::from(m.spent)); loc(&mut out,&m.spend);
+        out.extend(m.input_index.to_le_bytes()); vec(&mut out,&m.matching_positions);
+    }
+    let c=&page.cursor;
+    out.push(u8::from(c.present)); out.push(c.version); out.extend(c.chain_id);
+    out.extend(c.profile); a(&mut out,&c.anchor); out.extend(c.filter_digest);
+    out.push(u8::from(c.has_last)); out.extend(c.last_txid); out.extend(c.last_out_idx.to_le_bytes());
+    out.extend(page.posting_reads.to_le_bytes()); out.extend(page.work.to_le_bytes());
+    out.extend(page.encoded_bytes.to_le_bytes()); out
+}
+#[test]
+fn exact_transport_response_and_block_boundaries() {
+    let path=Temp::new();
+    let service=open_service(path.path(),binding(),true,limits()).unwrap();
+    let genesis=block(2,0,2,10,vec![]);
+    assert_eq!(genesis.transactions[0].outputs[0].wire.len(),45);
+    service.initialize_genesis(genesis).unwrap();
+    let page=service.query_branches(request(true)).unwrap();
+    let encoded=encoded_page(&page);
+    assert_eq!(encoded.len(),618);
+    assert_eq!(page.encoded_bytes as usize,encoded.len());
+    drop(service);
+    for (cap,ok) in [(600,false),(617,false),(618,true),(619,true)] {
+        let mut caps=limits();caps.response_bytes=cap;
+        let service=open_service(path.path(),binding(),false,caps).unwrap();
+        let result=service.query_branches(request(true));
+        assert_eq!(result.is_ok(),ok,"cap {cap}");
+        if let Ok(page)=result {
+            let bytes=encoded_page(&page);
+            assert_eq!(page.encoded_bytes as usize,bytes.len());
+            assert!(bytes.len()<=cap as usize);
+        }
+    }
+    let mut caps=limits();caps.block_bytes=83;
+    let other=Temp::new();
+    let service=open_service(other.path(),binding(),true,caps).unwrap();
+    let empty=f::NativeBlock {anchor:tip(2,0),parent:tip(2,0),transactions:vec![]};
+    assert!(service.initialize_genesis(empty.clone()).is_err());
+    assert!(!service.status(tip(2,0)).unwrap().initialized);
+    drop(service);
+    let mut caps=limits();caps.block_bytes=84;
+    let service=open_service(other.path(),binding(),false,caps).unwrap();
+    service.initialize_genesis(empty).unwrap();
+    assert!(service.status(tip(2,0)).unwrap().ready);
+}
