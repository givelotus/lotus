+ProofEnvelope AbsentProof(const CKey &key) {
+    auto pub=key.GetPubKey();std::vector<uint8_t> lock{32};
+    lock.insert(lock.end(),pub.begin()+1,pub.end());lock.insert(lock.end(),{0xbc,0x4e});
+    ::avalanche::ProofBuilder b(1,0,key,CScript{} << OP_TRUE);
+    Check(b.addUTXO(COutPoint(TxId(uint256::ONE),0),int64_t(1000000000000ULL)*SATOSHI,0,false,key),"signed absent proof");
+    return {b.build(),{lock}};
+}
+}
