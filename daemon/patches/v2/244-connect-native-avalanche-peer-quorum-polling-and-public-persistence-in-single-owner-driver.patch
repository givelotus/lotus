+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_driver.h"
+#include <random.h>
+#include <avalanche/validation.h>
+#include <algorithm>
+#include <limits>
+namespace lotus::v2::ava {
+namespace {
+bool Fail(std::string &e, const char *s) { e=s; return false; }
+DriverResult Error(DriverCode c, std::string e) { return {c, PeerStoreCode::Ok, std::move(e)}; }
+RuntimeBlockStatus Map(Status s) {
+    switch(s) {
+    case Status::Accepted: return RuntimeBlockStatus::Accepted;
+    case Status::Rejected: return RuntimeBlockStatus::Rejected;
+    case Status::Finalized: return RuntimeBlockStatus::Finalized;
+    case Status::Invalid: return RuntimeBlockStatus::Invalid;
+    case Status::Stale: return RuntimeBlockStatus::Stale;
+    }
+    throw std::logic_error("unknown Avalanche status");
+}
+}
+AvalancheDriver::AvalancheDriver(DevelopmentRuntime &r, peer::PeerDispatcher &d, DriverConfig c)
+    : runtime_(r), config_(std::move(c)), quorum_(config_.profile), polls_(config_.profile),
+      store_(config_.peer_file, config_.profile), peer_(d, config_.limits, Callbacks()) {}
+bool AvalancheDriver::Snapshot(ChainSnapshot &out, std::string &e) {
+    auto before=runtime_.Snapshot();
+    if(!before.chain || before.reopen_required || before.execution_paused || before.chain->pending_journal || before.chain->pending_receipt || before.chain->pending_propagation)
+        return Fail(e,"runtime-not-authoritative");
+    ChainSnapshot s; s.tip=before.chain->stable_tip; s.generation=before.context_generation; s.initial_download=initial_download_;
+    Hash id=s.tip; std::vector<uint64_t> times;
+    for(size_t i=0;i<11;++i) {
+        std::optional<IndexedHeader> h;
+        if(runtime_.ReadHeader(id,h,e)!=DevelopmentRuntimeResult::Progress || !h) return Fail(e,"runtime-header-unavailable");
+        if(i==0) s.height=h->header.height;
+        times.push_back(h->header.time);
+        if(h->header.height==0) break;
+        id=h->header.prev_id;
+    }
+    std::sort(times.begin(),times.end()); s.median_time_past=times[times.size()/2];
+    auto after=runtime_.Snapshot();
+    if(!after.chain || after.reopen_required || after.execution_paused || after.context_generation!=before.context_generation || after.chain->stable_tip!=s.tip || after.chain->revision!=before.chain->revision)
+        return Fail(e,"runtime-snapshot-changed");
+    out=s; return true;
+}
+bool AvalancheDriver::Refresh(ChainSnapshot &s,std::string &e) {
+    if(!Snapshot(s,e))return false;
+    if(!validated_ || validated_->tip!=s.tip || validated_->generation!=s.generation) {
+        CoinLookup lookup=[this](const Outpoint &o,std::optional<Coin> &c,std::string &err){return runtime_.ReadCoin(o,c,err)==DevelopmentRuntimeResult::Progress;};
+        if(!quorum_.Revalidate(s,lookup,wall_seconds_,[this]{return ReadSnapshot();},e))return false;
+        validated_=s;
+        for(auto it=envelopes_.begin();it!=envelopes_.end();)if(!quorum_.Known(it->first))it=envelopes_.erase(it);else ++it;
+    }
+    return true;
+}
+ChainSnapshot AvalancheDriver::ReadSnapshot() {
+    ChainSnapshot s; std::string e;
+    if(!Snapshot(s,e)) { s.initial_download=true; s.generation=std::numeric_limits<uint64_t>::max(); }
+    return s;
+}
+std::optional<ProofEnvelope> AvalancheDriver::Proof(const ::avalanche::ProofId &id) const {
+    if(!quorum_.Known(id)) return {};
+    auto it=envelopes_.find(id); return it==envelopes_.end()?std::nullopt:std::optional(it->second);
+}
+bool AvalancheDriver::Register(const ProofEnvelope &p, std::string &e) {
+    if(failed_ || !p.proof) return Fail(e,"driver-unavailable");
+    ChainSnapshot s; if(!Snapshot(s,e)) return false;
+    CoinLookup lookup=[this](const Outpoint &o,std::optional<Coin> &c,std::string &err) { return runtime_.ReadCoin(o,c,err)==DevelopmentRuntimeResult::Progress; };
+    bool ok=quorum_.Register(p,s,lookup,wall_seconds_,[this]{return ReadSnapshot();},e);
+    if(!ok && e!="proof-already-registered" && e!="immature-utxo" && e!="conflicting-utxos") return false;
+    if(!quorum_.Known(p.proof->getId())) return false;
+    auto it=envelopes_.find(p.proof->getId());
+    if(it!=envelopes_.end()) {
+        peer::Bytes a,b; std::string err;
+        if(!EncodeProofEnvelope(it->second,config_.limits,a,err) || !EncodeProofEnvelope(p,config_.limits,b,err) || a!=b) return Fail(e,"proof-envelope-mismatch");
+    }
+    for(auto old=envelopes_.begin();old!=envelopes_.end();)if(!quorum_.Known(old->first))old=envelopes_.erase(old);else ++old;
+    envelopes_.insert_or_assign(p.proof->getId(),p); e.clear(); return true;
+}
+bool AvalancheDriver::Apply(const std::vector<BlockUpdate> &updates,std::string &e) {
+    std::vector<RuntimeBlockUpdate> mapped; mapped.reserve(updates.size());
+    for(const auto &u:updates) mapped.push_back({u.block,Map(u.status),u.expected_tip,u.expected_generation});
+    return runtime_.ApplyAvalancheUpdates(mapped,e);
+}
+PeerCallbacks AvalancheDriver::Callbacks() {
+    PeerCallbacks c; if(config_.session_key.IsValid())c.local_session_key=config_.session_key.GetPubKey();
+    c.register_proof=[this](const auto &p,auto &e){return Register(p,e);};
+    c.bind=[this](auto n,const auto &d,const auto &sig,const auto &t,auto max,auto &e){return Ready() && quorum_.Bind(n,d,sig,t,max,e);};
+    c.disconnect=[this](auto n){polls_.Disconnect(n); quorum_.Disconnect(n); if(pending_poll_ && pending_poll_->node==n) pending_poll_.reset();};
+    c.sent_proof_inventory=[this](auto n){ChainSnapshot s;std::string e;if(Snapshot(s,e))quorum_.SentProofInventory(n,s);};
+    c.respond=[this](const auto &p,auto &out,auto &e){
+        ChainSnapshot s;if(!Ready() || !Snapshot(s,e))return false;
+        ObserveBlock observe=[this,s](const Hash &id,BlockObservation &o,std::string &err){
+            if(ReadSnapshot()!=s)return Fail(err,"stale-block-observation");
+            RuntimeBlockObservation r;if(!runtime_.ObserveAvalancheBlock(id,r,err))return false;
+            if(ReadSnapshot()!=s)return Fail(err,"stale-block-observation");
+            o={r.known,r.valid,r.active,r.parked,r.finalized,r.conflicting_finalized,r.forks_active,r.has_data};return true;};
+        return polls_.Respond(p,observe,quorum_,config_.session_key,out,e);};
+    c.receive=[this](auto n,const auto &r,auto &e){ChainSnapshot s;if(!Ready() || !Snapshot(s,e))return false;return polls_.Receive(quorum_,n,r,s,now_ms_,wall_seconds_,[this](const auto &u,auto &err){return Apply(u,err);},e);};
+    c.proof=[this](const auto &id){return Proof(id);}; c.proofs=[this]{return quorum_.Proofs();};
+    c.discovery_keys=[](uint64_t &a,uint64_t &b){FastRandomContext rng; a=rng.rand64();b=rng.rand64();return true;};
+    c.sign_hello=[this](const uint256 &h,SchnorrSig &s){return config_.session_key.SignSchnorr(h,s);};return c;
+}
+DriverResult AvalancheDriver::Start(bool ibd,int64_t wall) {
+    if(started_ || failed_)return Error(DriverCode::InvalidConfiguration,"driver-already-started");
+    initial_download_=ibd;wall_seconds_=wall;
+    const Profile defaults;
+    const auto &p=config_.profile;
+    CPubKey delegated; ::avalanche::DelegationState delegation_state;
+    if(wall<0 || !config_.session_key.IsValid() || (config_.local_proof.proof && (!config_.delegation.verify(delegation_state,delegated) || delegated!=config_.session_key.GetPubKey() || config_.delegation.getProofId()!=config_.local_proof.proof->getId())) ||
+       p.stake_dust!=defaults.stake_dust || p.stake_confirmations!=defaults.stake_confirmations || p.min_quorum_stake!=defaults.min_quorum_stake || p.min_connected_ratio!=defaults.min_connected_ratio || p.min_avaproofs_nodes!=defaults.min_avaproofs_nodes || p.conflicting_proof_cooldown_seconds!=defaults.conflicting_proof_cooldown_seconds || p.peer_replacement_cooldown_seconds!=defaults.peer_replacement_cooldown_seconds || p.stale_vote_threshold!=defaults.stale_vote_threshold || p.stale_vote_factor!=defaults.stale_vote_factor || p.query_timeout_ms!=defaults.query_timeout_ms || p.max_element_poll!=defaults.max_element_poll || config_.limits.poll_cooldown_ms!=AVALANCHE_DEFAULT_COOLDOWN || config_.limits.max_elements!=p.max_element_poll)
+        return Error(DriverCode::InvalidConfiguration,"invalid-session-or-nondefault-voting-policy");
+    ChainSnapshot s;std::string e;if(!Snapshot(s,e))return Error(DriverCode::NotReady,e);
+    auto native=runtime_.Snapshot(); std::optional<IndexedHeader> genesis; Hash genesis_id;
+    if(!native.chain || native.chain->profile_digest!=p.validation_digest || runtime_.ReadHeader(p.genesis_id,genesis,e)!=DevelopmentRuntimeResult::Progress || !genesis || genesis->header.height!=0 || !BlockId(p.chain_id,genesis->header,genesis_id) || genesis_id!=p.genesis_id)
+        return Error(DriverCode::InvalidConfiguration,"runtime-profile-mismatch");
+    CoinLookup lookup=[this](const Outpoint &o,std::optional<Coin> &c,std::string &err){return runtime_.ReadCoin(o,c,err)==DevelopmentRuntimeResult::Progress;};
+    if(p.persist_peers) {
+        std::vector<PersistedPeer> loaded;
+        auto result=store_.Load(loaded);
+        if(!result && result.code!=PeerStoreCode::Missing) {failed_=true;return {DriverCode::StoreFailure,result.code,result.message};}
+        Quorum screened(p);std::vector<PersistedPeer> valid;
+        for(const auto &entry:loaded) {
+            if(screened.Register(entry.envelope,s,lookup,entry.registration_time,[this]{return ReadSnapshot();},e))valid.push_back(entry);
+            if(ReadSnapshot()!=s)return Error(DriverCode::NotReady,"restore-snapshot-changed");
+        }
+        // RestorePeers independently validates each retained record again and
+        // restores ABC's registration/conflict/finalization metadata atomically.
+        if(!quorum_.RestorePeers(valid,s,lookup,[this]{return ReadSnapshot();},e))return Error(DriverCode::ProtocolFailure,e);
+        for(const auto &entry:valid)envelopes_.insert_or_assign(entry.envelope.proof->getId(),entry.envelope);
+    }
+    if(config_.local_proof.proof && !Register(config_.local_proof,e)){failed_=true;return Error(DriverCode::InvalidConfiguration,e);}
+    validated_=s;started_=true;return {};
+}
+DriverResult AvalancheDriver::Tick(bool ibd,int64_t ms,int64_t wall) {
+    if(!Ready())return Error(DriverCode::NotReady,"driver-not-started");
+    if(ms<now_ms_ || ms<0 || wall<0)return Error(DriverCode::InvalidConfiguration,"invalid-clock");
+    now_ms_=ms;wall_seconds_=wall;initial_download_=ibd;
+    ChainSnapshot s;std::string e;if(!Snapshot(s,e))return Error(DriverCode::NotReady,e);
+    if(!Refresh(s,e))return Error(DriverCode::NotReady,e);
+    for(auto id:connections_) {
+        auto r=peer_.Discover(id,static_cast<uint64_t>(ms),e);
+        if(r==PeerResult::LocalFailure || r==PeerResult::Rejected)return Error(DriverCode::ProtocolFailure,e);
+    }
+    peer_.Tick(static_cast<uint64_t>(ms));peer_.Pump(static_cast<uint64_t>(ms));
+    if(s.initial_download)return {};
+    if(!pending_poll_) {OutgoingPoll p;if(polls_.Next(quorum_,s,ms,p,e))pending_poll_=std::move(p);}
+    if(pending_poll_) {
+        auto r=peer_.Poll(*pending_poll_,e);
+        if(r==PeerResult::Backpressure)return Error(DriverCode::Backpressure,e);
+        if(r!=PeerResult::Accepted)return Error(DriverCode::ProtocolFailure,e);
+        pending_poll_.reset();
+    }
+    peer_.Pump(static_cast<uint64_t>(ms));return {};
+}
+PeerResult AvalancheDriver::Activate(peer::ConnectionId id,std::string &e) {
+    if(!Ready()){e="driver-not-started";return PeerResult::LocalFailure;}
+    auto r=peer_.Activate(id,e);if(r!=PeerResult::Accepted)return r;
+    connections_.insert(id);
+    return config_.local_proof.proof ? peer_.Hello(id,config_.delegation,e) : PeerResult::Accepted;
+}
+PeerResult AvalancheDriver::Handle(const peer::DispatcherNotice &n,uint64_t ms,std::string &e) {
+    if(!Ready() || ms>uint64_t(std::numeric_limits<int64_t>::max()) || ms<uint64_t(now_ms_)){e="driver-unavailable-or-invalid-clock";return PeerResult::LocalFailure;}
+    now_ms_=static_cast<int64_t>(ms);ChainSnapshot s;if(!Refresh(s,e))return PeerResult::LocalFailure;return peer_.Handle(n,ms,e);
+}
+void AvalancheDriver::Disconnect(peer::ConnectionId id) {connections_.erase(id);peer_.Disconnect(id);}
+bool AvalancheDriver::Reconcile(const PollItem &p,bool accepted,std::string &e) {return Ready() && polls_.Reconcile(p,accepted,e);}
+DriverResult AvalancheDriver::Save() {
+    if(!Ready())return Error(DriverCode::NotReady,"driver-not-started");
+    if(!config_.profile.persist_peers)return {};
+    ChainSnapshot s;std::string e;if(!Refresh(s,e))return Error(DriverCode::NotReady,e);
+    auto r=store_.Save(quorum_.ExportPeers());if(!r){failed_=true;return {DriverCode::StoreFailure,r.code,r.message};}return {};
+}
+}
