@@ -0,0 +1,60 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_DRIVER_H
+#define LOTUS_V2_AVALANCHE_DRIVER_H
+#include "avalanche_peer.h"
+#include "avalanche_peer_store.h"
+#include "development_runtime.h"
+namespace lotus::v2::ava {
+struct DriverConfig {
+    Profile profile;
+    PeerLimits limits;
+    CKey session_key;
+    ::avalanche::Delegation delegation;
+    ProofEnvelope local_proof;
+    std::filesystem::path peer_file;
+};
+enum class DriverCode { Ok, NotReady, InvalidConfiguration, StoreFailure, ProtocolFailure, Backpressure };
+struct DriverResult {
+    DriverCode code{DriverCode::Ok};
+    PeerStoreCode store_code{PeerStoreCode::Ok};
+    std::string message;
+    explicit operator bool() const { return code == DriverCode::Ok; }
+};
+// Single owner. Application inv/getdata notices must contain proof inventory
+// only: the node demultiplexes transaction inventory before calling Handle.
+// Caller retains notices on Backpressure. IBD is explicit; clocks are supplied
+// separately (monotonic milliseconds and Unix seconds). Never reenter callbacks.
+class AvalancheDriver {
+public:
+    AvalancheDriver(DevelopmentRuntime &, peer::PeerDispatcher &, DriverConfig);
+    DriverResult Start(bool initial_download, int64_t wall_seconds);
+    DriverResult Tick(bool initial_download, int64_t monotonic_ms, int64_t wall_seconds);
+    PeerResult Activate(peer::ConnectionId, std::string &);
+    PeerResult Handle(const peer::DispatcherNotice &, uint64_t monotonic_ms, std::string &);
+    void Disconnect(peer::ConnectionId);
+    DriverResult Save();
+    bool Reconcile(const PollItem &, bool, std::string &);
+    bool Ready() const { return started_ && !failed_; }
+private:
+    bool Snapshot(ChainSnapshot &, std::string &);
+    bool Refresh(ChainSnapshot &, std::string &);
+    ChainSnapshot ReadSnapshot();
+    bool Register(const ProofEnvelope &, std::string &);
+    std::optional<ProofEnvelope> Proof(const ::avalanche::ProofId &) const;
+    bool Apply(const std::vector<BlockUpdate> &, std::string &);
+    PeerCallbacks Callbacks();
+    DevelopmentRuntime &runtime_;
+    DriverConfig config_;
+    Quorum quorum_;
+    PollEngine polls_;
+    PeerStore store_;
+    AvalanchePeer peer_;
+    bool initial_download_{true}, started_{}, failed_{};
+    int64_t now_ms_{}, wall_seconds_{};
+    std::optional<ChainSnapshot> validated_;
+    std::optional<OutgoingPoll> pending_poll_;
+    std::set<peer::ConnectionId> connections_;
+    std::map<::avalanche::ProofId, ProofEnvelope> envelopes_;
+};
+}
+#endif
