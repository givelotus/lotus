diff --git a/src/lotus_v2/header_context.cpp b/src/lotus_v2/header_context.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3a00a49c965073f3ee14c167eb3bd6ec8939d00d
--- /dev/null
+++ b/src/lotus_v2/header_context.cpp
@@ -0,0 +1,58 @@
+#include "header_context.h"
+#include "asert_candidate.h"
+#include <algorithm>
+#include <limits>
+namespace lotus::v2 {
+namespace {
+AsertInteger Integer(const Hash &h) {
+    AsertInteger n = 0;
+    for (auto i = h.rbegin(); i != h.rend(); ++i) { n <<= 8; n += *i; }
+    return n;
+}
+bool Same(const Header &a, const Header &b) {
+    std::array<uint8_t, HEADER_SIZE> x{}, y{};
+    return SerializeHeader(a,x) && SerializeHeader(b,y) && x==y;
+}
+}
+std::optional<uint64_t> ParentMedianTime(const HeaderChainProfile &p,
+    const Header &parent, const std::vector<Header> &history) {
+    const size_t count = parent.height >= 10 ? 11 : size_t(parent.height)+1;
+    if (history.size()!=count || !Same(history.front(),parent)) return std::nullopt;
+    std::vector<uint64_t> times;
+    for (size_t i=0;i<count;++i) {
+        const auto &h=history[i];
+        std::array<uint8_t,HEADER_SIZE> bytes{};
+        if (h.height!=parent.height-i || h.version!=p.version ||
+            !SerializeHeader(h,bytes)) return std::nullopt;
+        if (i+1<count) {
+            Hash id{};
+            if (!BlockId(p.chain_id,history[i+1],id) || h.prev_id!=id) return std::nullopt;
+        }
+        if (h.height==0 && (h.time!=p.genesis_time || h.bits!=p.genesis_bits || h.prev_id!=Hash{})) return std::nullopt;
+        times.push_back(h.time);
+    }
+    std::sort(times.begin(),times.end());
+    return times[times.size()/2];
+}
+bool ValidateChildHeader(const HeaderChainProfile &p, const Header &parent,
+    const std::vector<Header> &history, const Header &child,
+    const Hash &tx, const Hash &state, uint64_t size, std::string &error) {
+    auto fail=[&](const char *why){error=why;return false;};
+    const auto mtp=ParentMedianTime(p,parent,history);
+    if (!mtp) return fail("authenticated parent history");
+    const auto limit=Integer(p.pow_limit);
+    const auto genesis=DecodeCompactTarget(p.genesis_bits,limit);
+    if (!genesis || p.half_life_seconds<=0 || p.spacing_seconds<=0 || p.genesis_time>MAX_TIME) return fail("chain profile");
+    if (parent.height==std::numeric_limits<uint64_t>::max() || child.height!=parent.height+1) return fail("child height");
+    Hash parent_id{};
+    if (!BlockId(p.chain_id,parent,parent_id) || child.prev_id!=parent_id) return fail("child parent");
+    if (child.version!=p.version) return fail("child version");
+    if (child.time>MAX_TIME || child.time<=*mtp) return fail("child median time");
+    if (child.tx_root!=tx || child.state_root!=state || child.size!=size) return fail("child commitments");
+    const auto required=RequiredAsertCandidateBits(p.half_life_seconds,p.spacing_seconds,*genesis,p.genesis_time,limit,{parent.time,parent.height});
+    Hash target{}, id{};
+    if (!required || child.bits!=required->bits || !DecodeTarget(child.bits,p.pow_limit,target)) return fail("required target");
+    if (!BlockId(p.chain_id,child,id) || !MeetsTarget(id,target)) return fail("proof of work");
+    error.clear(); return true;
+}
+}
diff --git a/src/lotus_v2/header_context.h b/src/lotus_v2/header_context.h
new file mode 100644
index 0000000000000000000000000000000000000000..ad5824c686e3486437491cd4c8a4ae624ad02fc5
--- /dev/null
+++ b/src/lotus_v2/header_context.h
@@ -0,0 +1,30 @@
+// Deterministic P04 candidate validation; no wall-clock eligibility policy.
+#ifndef LOTUS_V2_HEADER_CONTEXT_H
+#define LOTUS_V2_HEADER_CONTEXT_H
+#include "header.h"
+#include <optional>
+#include <string>
+#include <vector>
+namespace lotus::v2 {
+struct HeaderChainProfile {
+    ChainId chain_id{};
+    uint32_t version{};
+    uint64_t genesis_time{};
+    uint32_t genesis_bits{};
+    Hash pow_limit{};
+    int64_t half_life_seconds{};
+    int64_t spacing_seconds{};
+};
+// Authenticated history is newest first, includes parent, and contains exactly
+// min(parent.height+1,11) headers. Caller authenticates its oldest entry against
+// chain state; links within this window are checked here.
+std::optional<uint64_t> ParentMedianTime(const HeaderChainProfile &profile,
+    const Header &parent, const std::vector<Header> &history);
+// Roots and size must be independently derived by the complete-block caller.
+// Failure does not mutate any chain state. Future eligibility remains separate.
+bool ValidateChildHeader(const HeaderChainProfile &profile, const Header &parent,
+    const std::vector<Header> &history, const Header &child,
+    const Hash &expected_tx_root, const Hash &expected_state_root,
+    uint64_t expected_size, std::string &error);
+}
+#endif
