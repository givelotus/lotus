From 69c9cb4f0fce3b2d3747b87a55d51e64ac0e4024 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:12:33 -0700
Subject: [PATCH] Match upstream sent inventory quorum latch lifecycle

Maintenance explanation added during mailbox export:
Align the native quorum sent-inventory latch with the pinned upstream lifecycle. Adjust its regression so readiness changes occur at the intended lifecycle boundary instead of prematurely changing quorum state.

---
 src/lotus_v2/avalanche_quorum.cpp  | 15 ++++++++++-----
 src/lotus_v2/avalanche_quorum.h    |  2 +-
 src/lotus_v2/test_avalanche_v2.cpp |  2 +-
 3 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index dab3c3965f57eee027f87d6a0edcda5024ec8214..472e267b7ce187129e7705303b7fa967af032409 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -19,12 +19,12 @@ int64_t AddTime(int64_t now, uint64_t delta) {
 struct Quorum::Impl {
     Profile profile;
     struct Entry { ProofEnvelope envelope; int64_t conflict_after{}; bool finalized{}; };
-    struct Peer { AuthenticatedHello hello; int64_t next{}; };
+    struct Peer { AuthenticatedHello hello; int64_t next{}; bool inventory_sent{}; };
     std::map<::avalanche::ProofId,Entry> entries;
     ::avalanche::ProofPool active, conflicting;
     std::map<NodeId,Peer> nodes;
     std::set<::avalanche::ProofId> invalid;
-    std::set<NodeId> inventories;
+    uint64_t inventories{};
     bool established{};
     explicit Impl(Profile p):profile(std::move(p)) {}
     void Remove(const ::avalanche::ProofId &id) {
@@ -74,15 +74,20 @@ bool Quorum::Bind(NodeId id,const ::avalanche::Delegation &delegation,const Schn
     // Unknown proofs remain pending and have no voting weight.
     impl_->nodes.emplace(id,Impl::Peer{hello,0}); return true;
 }
-void Quorum::Disconnect(NodeId id) { impl_->nodes.erase(id); impl_->inventories.erase(id); }
-void Quorum::ReceivedProofInventory(NodeId id) { if(impl_->nodes.contains(id)) impl_->inventories.insert(id); }
+void Quorum::Disconnect(NodeId id) { impl_->nodes.erase(id); }
+void Quorum::SentProofInventory(NodeId id,const ChainSnapshot &snapshot) {
+    auto it=impl_->nodes.find(id);
+    if(snapshot.initial_download || it==impl_->nodes.end() || it->second.inventory_sent) return;
+    it->second.inventory_sent=true;
+    if(impl_->inventories<impl_->profile.min_avaproofs_nodes) ++impl_->inventories;
+}
 bool Quorum::Established(const ChainSnapshot &snapshot) {
     size_t count=0; uint64_t total=0,connected=0;
     std::set<::avalanche::ProofId> connected_ids;
     for(const auto &[id,node]:impl_->nodes) if(impl_->active.getProof(node.hello.proof_id)) { ++count; connected_ids.insert(node.hello.proof_id); }
     if(count<8) return false;
     if(impl_->established) return true;
-    if(snapshot.initial_download || impl_->inventories.size()<impl_->profile.min_avaproofs_nodes) return false;
+    if(snapshot.initial_download || impl_->inventories<impl_->profile.min_avaproofs_nodes) return false;
     impl_->active.forEachProof([&](const auto &proof) { total+=proof->getScore(); if(connected_ids.contains(proof->getId())) connected+=proof->getScore(); });
     // ABC public totals are uint32; fail closed instead of overflowing an
     // aggregate whose semantic score cannot be represented at the pin.
diff --git a/src/lotus_v2/avalanche_quorum.h b/src/lotus_v2/avalanche_quorum.h
index f482ae7eaacaf5ba101c1e819d91a32a51661ab5..14b53b6de74765559fa5ede43fbced26ae275b28 100644
--- a/src/lotus_v2/avalanche_quorum.h
+++ b/src/lotus_v2/avalanche_quorum.h
@@ -14,7 +14,7 @@ public:
     bool Bind(NodeId, const ::avalanche::Delegation &, const SchnorrSig &,
               const ConnectionTranscript &, uint32_t max_elements, std::string &);
     void Disconnect(NodeId);
-    void ReceivedProofInventory(NodeId);
+    void SentProofInventory(NodeId, const ChainSnapshot &);
     bool Established(const ChainSnapshot &);
     bool Ready() const;
     std::optional<NodeId> Select(int64_t now_milliseconds);
diff --git a/src/lotus_v2/test_avalanche_v2.cpp b/src/lotus_v2/test_avalanche_v2.cpp
index e7218cb0a2e61eb7e46d97c8a21e54c1f82322d9..4d197954610321079ad257ac9caf4cd0a42cb7df 100644
--- a/src/lotus_v2/test_avalanche_v2.cpp
+++ b/src/lotus_v2/test_avalanche_v2.cpp
@@ -30,7 +30,7 @@ int main() {
   auto delegation=::avalanche::DelegationBuilder(*envelope.proof).build();
   ConnectionTranscript transcript{1,2,3,4}; SchnorrSig hello;
   CHECK(key.SignSchnorr(HelloDigest(delegation,transcript),hello));
-  for(int i=0;i<8;++i) { CHECK(quorum.Bind(i,delegation,hello,transcript,16,error)); quorum.ReceivedProofInventory(i); }
+  for(int i=0;i<8;++i) { CHECK(quorum.Bind(i,delegation,hello,transcript,16,error)); quorum.SentProofInventory(i,snapshot); }
   CHECK(quorum.Established(snapshot));
   PollItem block{ItemKind::Block,{}}; block.id[0]=42;
   PollItem proof{ItemKind::Proof,{}}; std::copy(envelope.proof->getId().begin(),envelope.proof->getId().end(),proof.id.begin());
