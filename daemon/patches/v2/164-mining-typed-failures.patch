From 3a8b8dcaaa68b095ec2b22611f82e2f4bf29ea37 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 13:22:23 -0700
Subject: [PATCH] Preserve mining resource and runtime failure categories

---
 src/lotus_v2/development_node_command.cpp | 52 ++++++++++++++---------
 1 file changed, 31 insertions(+), 21 deletions(-)

diff --git a/src/lotus_v2/development_node_command.cpp b/src/lotus_v2/development_node_command.cpp
index 64666681c970425ce34ff0b1d75257a70717cb35..4d72f66acfc50b3dae71e8fa74b450fcde6c9beb 100644
--- a/src/lotus_v2/development_node_command.cpp
+++ b/src/lotus_v2/development_node_command.cpp
@@ -104,21 +104,23 @@ namespace {
         }
         return n;
     }
+    struct ProducerFailure : std::runtime_error {
+        std::string result;
+        ProducerFailure(std::string category, const std::string &message)
+            : std::runtime_error(message), result(std::move(category)) {}
+    };
     size_t HexSize(const UniValue &v, uint64_t cap) {
         Require(v.isStr(), "expected lowercase hex string");
         const auto &s = v.get_str();
-        Require(s.size() % 2 == 0 && s.size() / 2 <= cap,
-                "hex exceeds local aggregate capacity");
+        Require(s.size() % 2 == 0, "hex length must be even");
         for (char c : s)
             Require((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'),
                     "expected lowercase hex");
+        if (s.size() / 2 > cap)
+            throw ProducerFailure("capacity_refused",
+                                  "hex exceeds local aggregate capacity");
         return s.size() / 2;
     }
-    struct ProducerFailure : std::runtime_error {
-        std::string result;
-        ProducerFailure(std::string category, const std::string &message)
-            : std::runtime_error(message), result(std::move(category)) {}
-    };
     std::string RuntimeFailure(Result result) {
         switch (result) {
             case Result::Busy:
@@ -639,20 +641,24 @@ namespace {
         HeaderAdmission header;
         std::string error;
         const auto admitted = runtime->AdmitHeader(h, header, error);
-        Require(admitted == Result::Progress &&
-                    (header == HeaderAdmission::Stored ||
-                     header == HeaderAdmission::Known),
+        if (admitted != Result::Progress)
+            throw ProducerFailure(RuntimeFailure(admitted),
+                                  "header admission: " + error);
+        Require(header == HeaderAdmission::Stored ||
+                    header == HeaderAdmission::Known,
                 "header admission: " + error);
         std::optional<Hash> invalid;
-        Require(runtime->ReadInvalidity(block, invalid, error) ==
-                    Result::Progress,
-                error);
+        const auto invalidity = runtime->ReadInvalidity(block, invalid, error);
+        if (invalidity != Result::Progress)
+            throw ProducerFailure(RuntimeFailure(invalidity), error);
         Require(!invalid, "block has a durable invalidity root");
         CandidateBodyStatus status;
-        Require(runtime->RetainBody(block, wire, status, error) ==
-                        Result::Progress &&
-                    (status == CandidateBodyStatus::RetainedAuthenticated ||
-                     status == CandidateBodyStatus::Duplicate),
+        const auto body = runtime->RetainBody(block, wire, status, error);
+        if (body != Result::Progress)
+            throw ProducerFailure(RuntimeFailure(body),
+                                  "body retention: " + error);
+        Require(status == CandidateBodyStatus::RetainedAuthenticated ||
+                    status == CandidateBodyStatus::Duplicate,
                 "body retention: " + error);
         if (retained) *retained = true;
         Track(block);
@@ -694,8 +700,11 @@ namespace {
             const auto start = DecimalU64(request["start_nonce"]);
             const auto attempts =
                 Number(request["max_attempts"], MAX_NONCE_ATTEMPTS);
-            Require(request["transactions"].isArray() &&
-                        request["transactions"].size() <= MaxTransactions - 1,
+            Require(request["transactions"].isArray(),
+                    "ordinary transactions must be an array");
+            if (request["transactions"].size() > MaxTransactions - 1)
+                throw ProducerFailure(
+                    "capacity_refused",
                     "ordinary transaction count exceeds local capacity");
             // Validate ALL aggregate byte/count bounds before copying hex or
             // reserving the decoded transaction array. JSON parse/input storage
@@ -703,8 +712,9 @@ namespace {
             uint64_t remaining = manifest.block_read_limit;
             const auto destination_size =
                 HexSize(request["coinbase_output"], remaining);
-            Require(destination_size <= MAX_OUTPUT_BYTES,
-                    "coinbase output exceeds codec capacity");
+            if (destination_size > MAX_OUTPUT_BYTES)
+                throw ProducerFailure("capacity_refused",
+                                      "coinbase output exceeds codec capacity");
             remaining -= destination_size;
             if (!request["coinbase_data"].isNull()) {
                 const auto size = HexSize(request["coinbase_data"],
-- 
