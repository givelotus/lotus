From 24308b064dfc3bc332f963d4d1f0951c7e365623 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 09:03:04 -0700
Subject: [PATCH] Remove obsolete Berkeley DB selection from V2 dependency
 plumbing

The V2 wallet has only SQLite storage. Remove the unused NO_BDB/bdb_packages selector; depends reports wallet_packages_ as sqlite.
---
 depends/Makefile | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/depends/Makefile b/depends/Makefile
index 2de8c58c41e7791711f1a340e481b90d3ced91ee..451d8d52e9acd096341349c7a006c13730ce7adf 100644
--- a/depends/Makefile
+++ b/depends/Makefile
@@ -140,9 +140,8 @@ qrencode_packages_$(NO_QR) = $(qrencode_packages)
 
 qt_packages_$(NO_QT) = $(qt_packages) $(qt_$(host_os)_packages) $(qt_$(host_arch)_$(host_os)_packages) $(qrencode_packages_)
 
-bdb_packages_$(NO_BDB) = $(bdb_packages)
 sqlite_packages_$(NO_SQLITE) = $(sqlite_packages)
-wallet_packages_$(NO_WALLET) = $(bdb_packages_) $(sqlite_packages_)
+wallet_packages_$(NO_WALLET) = $(sqlite_packages_)
 
 zmq_packages_$(NO_ZMQ) = $(zmq_packages)
 
-- 
