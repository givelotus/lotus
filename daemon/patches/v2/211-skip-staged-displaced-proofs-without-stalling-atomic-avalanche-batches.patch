From 5c2c0156ecc8f761ea146023c2780ceb6db54b94 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:26:37 -0700
Subject: [PATCH] Skip staged displaced proofs without stalling atomic
 Avalanche batches

Maintenance explanation added during mailbox export:
Skip proofs displaced within a staged batch rather than treating their absence as a batch-stalling error. Add a regression demonstrating that preference replacement still permits atomic batch completion.

---
 src/lotus_v2/avalanche_quorum.cpp  | 8 +++++++-
 src/lotus_v2/test_avalanche_v2.cpp | 9 +++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/avalanche_quorum.cpp b/src/lotus_v2/avalanche_quorum.cpp
index 28426c0c40c015107ac0d050a81fe570ade226f2..b64840fcb236a42f4cb4ede234b632c24a86ac00 100644
--- a/src/lotus_v2/avalanche_quorum.cpp
+++ b/src/lotus_v2/avalanche_quorum.cpp
@@ -212,7 +212,13 @@ bool Quorum::ApplyProofVotes(const std::vector<std::pair<::avalanche::ProofId,St
     int64_t now,const std::function<bool(std::string &)> &commit_blocks,std::string &error) {
     if(votes.empty()) return commit_blocks && commit_blocks(error);
     Quorum staged(impl_->profile); staged.impl_=std::make_unique<Impl>(*impl_);
-    for(const auto &[id,status]:votes) if(!staged.ApplyProofVote(id,status,now,error)) return false;
+    // Reject a forged/unknown batch at admission. A proof which was known
+    // here can legitimately disappear after an earlier conflicting update.
+    for(const auto &[id,status]:votes) if(!impl_->entries.contains(id)) return Fail(error,"unknown-proof");
+    for(const auto &[id,status]:votes) {
+        if(!staged.impl_->entries.contains(id)) continue;
+        if(!staged.ApplyProofVote(id,status,now,error)) return false;
+    }
     if(!commit_blocks || !commit_blocks(error)) return false;
     impl_.swap(staged.impl_); return true;
 }
diff --git a/src/lotus_v2/test_avalanche_v2.cpp b/src/lotus_v2/test_avalanche_v2.cpp
index 11c3464da6840d23252b2f469e341a6376aac8fa..2d8775e23e1036c06d680354c3143c33a0aa72cd 100644
--- a/src/lotus_v2/test_avalanche_v2.cpp
+++ b/src/lotus_v2/test_avalanche_v2.cpp
@@ -67,6 +67,15 @@ int main() {
   CHECK(cooldown.Vote(envelope.proof->getId())==0); CHECK(cooldown.Vote(replacement.proof->getId())==uint32_t(-1));
   CHECK(cooldown.Register(replacement,snapshot,mixed,101+int64_t(profile.peer_replacement_cooldown_seconds),read,error));
   CHECK(cooldown.Vote(replacement.proof->getId())==0); CHECK(cooldown.Vote(envelope.proof->getId())==3);
+  // Rejecting the preferred active proof evicts its older conflicting proof.
+  // The later update for that initially known, now absent proof is skipped;
+  // unrelated block work in the same atomic callback must still commit.
+  std::vector<std::pair<::avalanche::ProofId,Status>> conflicting_batch{
+   {replacement.proof->getId(),Status::Rejected},{envelope.proof->getId(),Status::Accepted}};
+  size_t block_batch_commits=0;
+  CHECK(cooldown.ApplyProofVotes(conflicting_batch,100000,[&](std::string &){++block_batch_commits;return true;},error));
+  CHECK(block_batch_commits==1); CHECK(cooldown.Vote(replacement.proof->getId())==3);
+  CHECK(cooldown.Vote(envelope.proof->getId())==uint32_t(-1));
   snapshot.height=3000;
   auto bad_profile=profile; bad_profile.min_quorum_stake=MAX_MONEY+SATOSHI;
   bool invalid_constructor=false; try { Quorum invalid(bad_profile); } catch(const std::invalid_argument &) { invalid_constructor=true; } CHECK(invalid_constructor);
