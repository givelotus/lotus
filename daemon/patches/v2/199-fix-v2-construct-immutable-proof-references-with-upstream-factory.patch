From b5cc569124434afaa91b05d66cd976af7a5e2195 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 15 Oct 2026 15:02:36 -0700
Subject: [PATCH] fix(v2): construct immutable proof references with upstream
 factory

Maintenance explanation added during mailbox export:
Construct immutable proof references in tests through the pinned upstream factory. This repairs compatibility with the actual proof reference API without changing proof authentication semantics.

---
 src/lotus_v2/test_avalanche_proof.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/lotus_v2/test_avalanche_proof.cpp b/src/lotus_v2/test_avalanche_proof.cpp
index ca7f0cc19c136daf4d07a5295e84b73944447f4b..2c52c44575afb263d9a140eb5a92f1836a0ed690 100644
--- a/src/lotus_v2/test_avalanche_proof.cpp
+++ b/src/lotus_v2/test_avalanche_proof.cpp
@@ -45,15 +45,15 @@ BOOST_AUTO_TEST_CASE(native_coin_and_epoch_binding) {
     auto signed_stakes=valid_proof->getStakes();
     auto bad_signature=signed_stakes[0].getSignature(); bad_signature[0]^=1;
     signed_stakes[0]=::avalanche::SignedStake(signed_stakes[0].getStake(),bad_signature);
-    env.proof=::avalanche::ProofRef(new ::avalanche::Proof(valid_proof->getSequence(),
+    env.proof=::avalanche::ProofRef::make(valid_proof->getSequence(),
         valid_proof->getExpirationTime(),valid_proof->getMaster(),signed_stakes,
-        valid_proof->getPayoutScript(),valid_proof->getSignature()));
+        valid_proof->getPayoutScript(),valid_proof->getSignature());
     BOOST_CHECK(!admit()); BOOST_CHECK_EQUAL(error,"invalid-stake-signature");
     env.proof=valid_proof;
     auto bad_master_signature=valid_proof->getSignature(); bad_master_signature[0]^=1;
-    env.proof=::avalanche::ProofRef(new ::avalanche::Proof(valid_proof->getSequence(),
+    env.proof=::avalanche::ProofRef::make(valid_proof->getSequence(),
         valid_proof->getExpirationTime(),valid_proof->getMaster(),valid_proof->getStakes(),
-        valid_proof->getPayoutScript(),bad_master_signature));
+        valid_proof->getPayoutScript(),bad_master_signature);
     BOOST_CHECK(!admit()); BOOST_CHECK_EQUAL(error,"invalid-proof-signature");
     env.proof=valid_proof;
     auto saved=coin;
-- 
