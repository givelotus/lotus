From 2a1e185452220a7d6dd5c65e9e4b58332c1c5f7d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 09:35:34 -0700
Subject: [PATCH] bchn: add unchecked long-chain mempool container fixture

Insert a linear chain of 100 transactions with addUnchecked and assert the
container size. This records the historical fixture without claiming that
normal mempool admission accepts the chain. It bypasses admission checks and
does not remove ancestor/descendant limits or change consensus or fee policy.

The historical filename overstates the implemented change. The ABC fixture
uses the unavailable SigOpCount helper and fails compilation on the pinned
base. Keep it outside the default series until corrected and tested through
the intended admission API. BCHN application/build remain separate checks.

Metadata-backfill: This explanation and envelope are newly written; they do
not claim recovery of a lost per-patch message or its original author/date.
The source diff bytes are unchanged. Recorded port/import commit:
578bbcddd210de1601b280967700e07420f23782 (Lotus monorepo).

Validation: exact raw-diff and mailbox replays produce the same source tree.
See daemon/docs/ecash-block-assembly-review.md and support-matrix.md for
behavioral evidence and applicability limits; no new build is asserted here.

diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index e4f108e..dabfdac 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -840,4 +840,34 @@ BOOST_AUTO_TEST_CASE(SanityCheckGetterAndSetter) {
     BOOST_CHECK_EQUAL(int(pool.getSanityCheck() * 1000.0), 1000);
 }
 
+BOOST_AUTO_TEST_CASE(long_chain_accepted) {
+    // Verify that chains longer than the old 50-tx ancestor/descendant limit
+    // are accepted into the mempool.  The O(n log n) mining algorithm (patch 29)
+    // reads no pre-computed CPFP fields, so there is no O(n²) DoS justification
+    // for a chain-length cap.  Build a strictly linear chain of 100 transactions
+    // each spending the single output of the previous one and verify all land
+    // in the mempool.
+    CTxMemPool testPool;
+    LOCK2(cs_main, testPool.cs);
+    TestMemPoolEntryHelper entry;
+
+    CMutableTransaction first;
+    first.vin.resize(1);
+    first.vin[0].scriptSig = CScript();
+    first.vout.emplace_back(10000 * SATOSHI, CScript() << OP_TRUE);
+    testPool.addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(first));
+
+    TxId prevId = first.GetId();
+    for (int i = 1; i < 100; i++) {
+        CMutableTransaction tx;
+        tx.vin.resize(1);
+        tx.vin[0].prevout = COutPoint(prevId, 0);
+        tx.vout.emplace_back(9000 * SATOSHI, CScript() << OP_TRUE);
+        testPool.addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(tx));
+        prevId = tx.GetId();
+    }
+
+    BOOST_CHECK_EQUAL(testPool.size(), 100UL);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
