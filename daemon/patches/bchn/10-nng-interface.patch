+++ b/test/functional/interface_nng_legacy_rpc.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Run Tobias's original unchanged RPC tests against the explicit legacy endpoint.
+
+The reference file is kept byte-identical; the subclass adapts only current test
+framework setup. Legacy pub/sub is a different dialect and is not enabled here.
+"""
+import asyncio
+import importlib.machinery
+import importlib.util
+from pathlib import Path
+import sys
+
+from test_framework.test_framework import SkipTest
+from test_framework.util import assert_equal, p2p_port
+
+# Load the foreign fixture byte-for-byte, without subjecting historical source
+# to modern style rewriting. Its SHA and syntax are independently checked.
+reference_file = Path(__file__).resolve().parent / "data/nng-2021/interface_plugin_nng.py.fixture"
+loader = importlib.machinery.SourceFileLoader("tobias_nng_rpc_reference", str(reference_file))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+assert spec is not None
+reference = importlib.util.module_from_spec(spec)
+loader.exec_module(reference)
+
+
+class LegacyNngRpcTest(reference.PluginGRPCTest):  # type: ignore[name-defined]
+    def set_test_params(self):
+        super().set_test_params()
+        self.extra_args = None
+
+    def skip_test_if_missing_module(self):
+        if not self.config["components"].getboolean("ENABLE_NNG", fallback=False):
+            raise SkipTest("NNG was not compiled")
+        try:
+            import pynng  # noqa: F401
+            import flatbuffers  # noqa: F401
+        except ImportError:
+            raise SkipTest("Install optional pinned pynng/FlatBuffers test requirements; see doc/nng.md")
+        sys.path.insert(0, str(Path(self.config["environment"]["BUILDDIR"]) / "src/nng_interface"))
+
+    def setup_network(self):
+        self.rpc_url = "tcp://127.0.0.1:" + str(p2p_port(3))
+        reference.RPC_URL = self.rpc_url
+        self.add_nodes(1, [["-nnglegacyrpc=" + self.rpc_url]])
+        self.start_nodes()
+
+    def run_test(self):
+        self.burn_addr = self.nodes[0].decodescript("00")["p2sh"]
+        self.anyone_addr = self.nodes[0].decodescript("51")["p2sh"]
+        asyncio.run(self.rpc_tests())
+
+    async def _test_get_block_range(self, node, rpc):
+        from PluginInterface import GetBlockRangeResponse
+        # The unchanged 2021 fixture miscounts inclusive heights 100..111 as
+        # eleven. Preserve its wire builders and checks, deriving the final
+        # count from the current chain rather than reviving that assertion bug.
+        for start, count in [(0, 10), (10, 30), (100, 5), (-1, 4), (100, 30)]:
+            await self._send_request(rpc, self._make_get_block_range_request_fbb(start, count))
+            data = await self._recv_response(rpc)
+            response = GetBlockRangeResponse.GetBlockRangeResponse.GetRootAs(data, 0)
+            expected = 0 if start < 0 else min(count, max(0, node.getblockcount()-start+1))
+            assert_equal(response.BlocksLength(), expected)
+            for offset in range(expected):
+                actual = reference.get_fb_bytes(response.Blocks(offset).Header().Hash(), "Hash")[::-1].hex()
+                assert_equal(actual, node.getblockhash(start+offset))
+
+    async def rpc_tests(self):
+        import pynng
+        node = self.nodes[0]
+        with pynng.Req0() as rpc:
+            rpc.dial(self.rpc_url)
+            await self._tests_genesis(node, rpc)
+            await self._tests_get_block_errors(rpc)
+            await self._tests_get_block_undo_data_errors(rpc)
+            await self._tests_blockchain_info(node, rpc)
+            await self._tests_send_tx(node, rpc)
+            await self._test_get_block_range(node, rpc)
+            await self._test_submit_block(node, rpc)
+            await self._test_submit_tx(node, rpc)
+            await self._send_request(rpc, bytes([0, 1, 2, 3]))
+            await self._recv_response(rpc, expect_error="Invalid flatbuffer encoding")
+
+
+if __name__ == "__main__":
+    LegacyNngRpcTest().main()
