+"""Exercise the Lotus-compatible FlatBuffers service with an existing Rust client."""
+import json
+from pathlib import Path
+import subprocess
+import queue
+import threading
+import time
+from test_framework.address import byte_to_base58
+from test_framework.messages import CTransaction, CTxIn, CTxOut, COutPoint, CBlock, TokenOutputData, token
+from test_framework.script import CScript, OP_TRUE, OP_RETURN
+from test_framework.script import hash160
+from test_framework.test_framework import BitcoinTestFramework, SkipTest
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, p2p_port
+
+
+class NngCompatTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+
+    def add_options(self, parser):
+        parser.add_argument("--consumer-probe", default=str(Path(__file__).resolve().parents[1] / "nng_compat_client/target/debug/bchn-nng-existing-consumer-probe"),
+                            help="Probe linked against unmodified bitcoinsuite-bitcoind-nng")
+
+    def skip_test_if_missing_module(self):
+        if not self.config["components"].getboolean("ENABLE_NNG", fallback=False):
+            raise SkipTest("NNG was not compiled")
+        if not Path(self.options.consumer_probe).is_file():
+            raise SkipTest("Build test/nng_compat_client first; see doc/nng.md")
+
+    def setup_network(self):
+        self.rpc_url = "tcp://127.0.0.1:" + str(p2p_port(1))
+        self.pub_url = "tcp://127.0.0.1:" + str(p2p_port(2))
+        self.legacy_rpc_url = "tcp://127.0.0.1:" + str(p2p_port(3))
+        self.args = ["-nngrpc=" + self.rpc_url, "-nngpub=" + self.pub_url, "-nnglegacyrpc=" + self.legacy_rpc_url] + [
+            "-nngpubmsg=" + t for t in ("updateblktip", "mempooltxadd", "mempooltxrem",
+                                       "blkconnected", "blkdisconctd", "chainstflush", "miningwrkchg")]
+        self.add_nodes(1, [self.args])
+        self.start_nodes()
+
+    def probe(self, command, *args, fails=False, legacy=False):
+        result = subprocess.run([self.options.consumer_probe, command, self.legacy_rpc_url if legacy else self.rpc_url] + list(map(str, args)),
+                                text=True, capture_output=True, timeout=20)
+        if fails:
+            assert result.returncode != 0, result.stdout
+            return
+        assert_equal(result.returncode, 0)
+        return json.loads(result.stdout)
+
+    def run_test(self):
+        node = self.nodes[0]
+        genesis = self.probe("block", 0)
+        assert_equal(genesis["header"], node.getblockheader(node.getblockhash(0), False))
+        assert_equal(len(bytes.fromhex(genesis["header"])), 80)
+        assert_equal(len(self.probe("range", 0, 4294967295)), 1)
+        assert_equal(self.probe("range", -1, 1), [])
+        assert_equal(self.probe("range", 0, 0), [])
+        assert_equal(self.probe("range", 1, 10), [])
+        self.probe("slice", 0, 0, 33554433, fails=True)
+        self.probe("block", 9999, fails=True)
+        assert self.probe("invalid")["invalid_encoding"]
+        assert_equal(self.probe("status")["height"], 0)
+        assert_equal(self.probe("status")["network"], "regtest")
+        assert_equal(self.probe("mempool"), [])
+        redeem = CScript([OP_TRUE])
+        destination = byte_to_base58(hash160(redeem), 196)
+        matured = node.generatetoaddress(101, destination)
+        coinbase = node.getblock(matured[0], 2)["tx"][0]
+        subscriber = subprocess.Popen([self.options.consumer_probe, "subscribe", self.pub_url, "10000"],
+                                      text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        messages = queue.Queue()
+
+        def read_events():
+            for line in subscriber.stdout:
+                messages.put(line)
+            messages.put(None)
+        reader = threading.Thread(target=read_events, daemon=True)
+        reader.start()
+        assert_equal(messages.get(timeout=20).strip(), "ready")
+        events = []
+
+        def until(topic):
+            for _ in range(20):
+                line = messages.get(timeout=20)
+                assert line is not None, "Existing consumer exited before expected event"
+                event = json.loads(line)
+                events.append(event)
+                if event["topic"] == topic:
+                    return event
+            raise AssertionError("Missing event " + topic)
+        try:
+            time.sleep(0.3)
+            tx = CTransaction()
+            tx.vin = [CTxIn(COutPoint(int(coinbase["txid"], 16), 0), CScript([redeem]))]
+            amount = int(coinbase["vout"][0]["value"] * 100000000)
+            tx.vout = [CTxOut(amount - 1000, CScript([OP_TRUE]), TokenOutputData(id=int(coinbase["txid"], 16), amount=1)), CTxOut(0, CScript([OP_RETURN, bytes(60)]))]
+            raw = tx.serialize().hex()
+            txid = node.sendrawtransaction(raw)
+            admission = until("mempooltxadd")
+            assert_equal(admission["raw"], raw)
+            assert_equal(admission["coins"][0]["amount"], amount)
+            assert_equal(admission["coins"][0]["height"], 1)
+            assert admission["coins"][0]["coinbase"]
+            assert_equal(self.probe("status")["mempool"], 1)
+            snapshot = self.probe("mempool")
+            assert_equal(snapshot[0]["txid"], txid)
+            assert_equal(snapshot[0]["coins"], admission["coins"])
+            assert snapshot[0]["time"] > 0
+            template = self.probe("mining")
+            assert_equal(template["height"], 102)
+            assert_equal(len(bytes.fromhex(template["header"])), 80)
+            assert_equal(template["coinbase1"] + "00" * 8 + template["coinbase2"], template["coinbase"])
+            assert_equal(len(template["ntime"]), 8)
+            assert_equal(template["fees"], [1000])
+            from io import BytesIO
+            block = CBlock()
+            block.deserialize(BytesIO(bytes.fromhex(template["block"])))
+            block.solve()
+            submitted = self.probe("legacy_submitblock", block.serialize().hex(), legacy=True)
+            assert_equal(submitted, {"accepted": True, "state": "valid", "reason": ""})
+            connected = until("blkconnected")["block"]
+            mined = node.getbestblockhash()
+            assert_equal(connected["hash"], mined)
+            assert_equal(connected["txs"][1]["coins"], admission["coins"])
+            historical = self.probe("block", 102)
+            assert_equal(historical, connected)
+            assert_equal(self.probe("range", 101, 2)[1], connected)
+            for t in historical["txs"]:
+                assert_equal(self.probe("slice", historical["file"], t["pos"], len(bytes.fromhex(t["raw"]))), t["raw"])
+                if t["undo_size"]:
+                    undo = self.probe("undo", historical["file"], t["undo"], t["undo_size"])
+                    assert_equal(len(bytes.fromhex(undo)), t["undo_size"])
+                    assert_equal(self.probe("undo_coins", historical["file"], t["undo"], t["undo_size"]), t["coins"])
+            assert_equal(self.probe("mempool"), [])
+            node.invalidateblock(mined)
+            disconnected = until("blkdisconctd")["block"]
+            assert_equal(disconnected, historical)
+            assert_equal(node.getblockcount(), 101)
+            assert_equal(self.probe("mempool")[0]["txid"], txid)
+            # A replacement block evicts a conflicting mempool transaction.
+            alternative = CBlock()
+            alternative.deserialize(BytesIO(bytes.fromhex(template["block"])))
+            alt_tx = CTransaction(tx)
+            alt_tx.vout[1].scriptPubKey = CScript([OP_RETURN, bytes([1]) + bytes(59)])
+            alt_tx.rehash()
+            alternative.vtx[1] = alt_tx
+            alternative.hashMerkleRoot = alternative.calc_merkle_root()
+            alternative.solve()
+            assert_equal(node.submitblock(alternative.serialize().hex()), None)
+            assert_equal(until("mempooltxrem")["txid"], txid)
+            assert_equal(until("blkconnected")["block"]["hash"], node.getbestblockhash())
+            assert_equal(self.probe("mempool"), [])
+            node.invalidateblock(node.getbestblockhash())
+            until("blkdisconctd")
+            node.reconsiderblock(mined)
+            assert_equal(until("blkconnected")["block"], historical)
+            assert_equal(self.probe("mempool"), [])
+            # CashTokens output data is part of the serialized locking script
+            # bytes. Losing it would make the existing external indexer lie.
+            child = CTransaction()
+            child.vin = [CTxIn(COutPoint(int(txid, 16), 0), CScript())]
+            child.vout = [CTxOut(amount - 2000, CScript([OP_TRUE]), tx.vout[0].tokenData),
+                          CTxOut(0, CScript([OP_RETURN, bytes(60)]))]
+            child_raw = child.serialize().hex()
+            child_id = node.sendrawtransaction(child_raw)
+            child_admission = until("mempooltxadd")
+            while child_admission["raw"] != child_raw:
+                child_admission = until("mempooltxadd")
+            expected_script = token.wrap_spk(tx.vout[0].tokenData, tx.vout[0].scriptPubKey).hex()
+            assert expected_script.startswith("ef")
+            assert_equal(child_admission["coins"][0]["script"], expected_script)
+            assert_equal(self.probe("mempool")[0]["coins"], child_admission["coins"])
+            grandchild = CTransaction()
+            grandchild.vin = [CTxIn(COutPoint(int(child_id, 16), 0), CScript())]
+            grandchild.vout = [CTxOut(amount - 3000, CScript([OP_TRUE]), tx.vout[0].tokenData),
+                               CTxOut(0, CScript([OP_RETURN, bytes(60)]))]
+            grandchild_raw = grandchild.serialize().hex()
+            grandchild_id = node.sendrawtransaction(grandchild_raw)
+            grandchild_admission = until("mempooltxadd")
+            assert_equal(grandchild_admission["raw"], grandchild_raw)
+            assert_equal(grandchild_admission["coins"][0]["height"], None)
+            assert_equal(grandchild_admission["coins"][0]["coinbase"], False)
+            assert_equal(grandchild_admission["coins"][0]["script"], expected_script)
+            pool = {t["txid"]: t for t in self.probe("mempool")}
+            assert_equal(pool[grandchild_id]["coins"], grandchild_admission["coins"])
+            final_mined, = node.generatetoaddress(1, destination)
+            until("blkconnected")
+            child_block = self.probe("block", 103)
+            child_record = next(t for t in child_block["txs"] if t["txid"] == child_id)
+            grandchild_record = next(t for t in child_block["txs"] if t["txid"] == grandchild_id)
+            assert_equal(child_record["coins"], child_admission["coins"])
+            assert_equal(grandchild_record["coins"][0]["height"], 103)
+            assert_equal(grandchild_record["coins"][0]["script"], expected_script)
+            assert_equal(self.probe("slice", child_block["file"], child_record["pos"], len(bytes.fromhex(child_raw))), child_raw)
+            for record in (child_record, grandchild_record):
+                assert_equal(self.probe("undo_coins", child_block["file"], record["undo"], record["undo_size"]), record["coins"])
+            node.gettxoutsetinfo()  # Forces a durable chainstate flush.
+            flushed = until("chainstflush")
+            while flushed["hash"] != final_mined:
+                flushed = until("chainstflush")
+            assert_equal(flushed["hash"], final_mined)
+            epochs = [e["epoch"] for e in events if e["topic"] == "miningwrkchg"]
+            assert epochs and epochs == sorted(set(epochs))
+        finally:
+            subscriber.terminate()
+            subscriber.wait(timeout=10)
+            reader.join(timeout=10)
+            subscriber.stdout.close()
+            subscriber.stderr.close()
+        self.stop_node(0)
+        node.assert_start_raises_init_error(extra_args=["-nngrpc=invalid://endpoint"], expected_msg="Failed listening on NNG RPC endpoint", match=ErrorMatch.PARTIAL_REGEX)
+        node.assert_start_raises_init_error(extra_args=["-nngrpc=" + self.rpc_url, "-nngpub=invalid://endpoint"], expected_msg="Failed listening on -nngpub", match=ErrorMatch.PARTIAL_REGEX)
+        self.start_node(0, self.args)
+        assert_equal(self.probe("block", 103)["hash"], final_mined)
+        assert_equal(self.probe("mempool"), [])
+
+
+if __name__ == '__main__':
+    NngCompatTest().main()
