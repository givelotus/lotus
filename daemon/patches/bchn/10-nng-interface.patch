@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+#
+# Copyright (c) 2026 The Bitcoin Cash Node developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#
+# Exercise the actual C++ linter against tracked files in an isolated repository.
+
+export LC_ALL=C
+set -euo pipefail
+
+LINTER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lint-cpp.sh"
+TEST_REPO=$(mktemp -d)
+trap 'rm -rf "$TEST_REPO"' EXIT
+
+git -C "$TEST_REPO" init -q
+mkdir -p "$TEST_REPO/src"
+
+for API in strerror std::strerror strerror_r _strerror _strerror_s boost::bind std::filesystem nng_strerror foo_strerror; do
+    printf 'void probe() { %s(0); }\n' "$API" > "$TEST_REPO/src/probe.cpp"
+    git -C "$TEST_REPO" add src/probe.cpp
+    if (cd "$TEST_REPO" && bash "$LINTER") > "$TEST_REPO/output" 2>&1; then
+        RESULT=0
+    else
+        RESULT=$?
+    fi
+    case "$API" in
+        nng_strerror|foo_strerror) EXPECTED=0 ;;
+        *) EXPECTED=1 ;;
+    esac
+    if [[ "$RESULT" != "$EXPECTED" ]]; then
+        echo "Unexpected C++ lint result for $API: $RESULT (expected $EXPECTED)"
+        cat "$TEST_REPO/output"
+        exit 1
+    fi
+done
