diff --git a/test/nng_compat_client/src/main.rs b/test/nng_compat_client/src/main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a9554f9ce61957f4d0edad9484901963ef1c02b3
--- /dev/null
+++ b/test/nng_compat_client/src/main.rs
@@ -0,0 +1,109 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// The public client models the mining template but its checked-in generated
+// bindings omit the schema's status extension. Test only that extension using
+// standard bindings; all other RPC/event tests use the unchanged public client.
+#[allow(warnings)]
+mod schema_extension {
+    include!(concat!(env!("OUT_DIR"), "/nng_interface_generated.rs"));
+}
+use bitcoinsuite_bitcoind_nng::{Block, BlockIdentifier, Message, PubInterface, RpcInterface};
+use bitcoinsuite_core::{
+    compression::read_undo_coin, ecc::DummyEcc, encoding::read_compact_size, Bytes, Coin, Hashed,
+};
+use schema_extension::nng_interface as fbs;
+#[allow(warnings)]
+mod legacy_schema {
+    include!(concat!(env!("OUT_DIR"), "/plugin_interface_generated.rs"));
+}
+use legacy_schema::plugin_interface as old;
+use serde_json::{json, Value};
+fn coins(c: &Option<Vec<Coin>>) -> Value {
+    match c { None => Value::Null, Some(c) => json!(c.iter().map(|c| json!({"amount": c.tx_output.value, "script":hex::encode(c.tx_output.script.bytecode()),"height":c.height,"coinbase":c.is_coinbase})).collect::<Vec<_>>()) }
+}
+fn block(b: Block) -> Value {
+    json!({"hash":b.header.hash.to_hex_be(),"header":hex::encode(b.header.raw),"file":b.file_num,"pos":b.data_pos,"undo":b.undo_pos,"txs":b.txs.iter().map(|t|json!({"txid":t.tx.txid.to_hex_be(),"raw":hex::encode(&t.tx.raw),"pos":t.data_pos,"undo":t.undo_pos,"undo_size":t.undo_size,"coins":coins(&t.tx.spent_coins)})).collect::<Vec<_>>()})
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let a: Vec<String> = std::env::args().collect();
+    if a[1] == "subscribe" {
+        let p = PubInterface::open(&a[2])?;
+        p.subscribe("")?;
+        println!("ready");
+        for _ in 0..a[3].parse::<usize>()? {
+            let m = p.recv()?;
+            let v = match m {
+                Message::UpdatedBlockTip(m) => {
+                    json!({"topic":"updateblktip","hash":m.block_hash.to_hex_be()})
+                }
+                Message::BlockConnected(m) => {
+                    json!({"topic":"blkconnected","block":block(m.block)})
+                }
+                Message::BlockDisconnected(m) => {
+                    json!({"topic":"blkdisconctd","block":block(m.block)})
+                }
+                Message::TransactionAddedToMempool(m) => {
+                    json!({"topic":"mempooltxadd","raw":hex::encode(m.mempool_tx.tx.raw),"coins":coins(&m.mempool_tx.tx.spent_coins)})
+                }
+                Message::TransactionRemovedFromMempool(m) => {
+                    json!({"topic":"mempooltxrem","txid":m.txid.to_hex_be()})
+                }
+                Message::ChainStateFlushed(m) => {
+                    json!({"topic":"chainstflush","hash":m.block_hash.to_hex_be()})
+                }
+                Message::MiningWorkChanged(m) => {
+                    json!({"topic":"miningwrkchg","height":m.height,"epoch":m.template_epoch,"reason":format!("{:?}",m.reason)})
+                }
+            };
+            println!("{}", v);
+        }
+        return Ok(());
+    }
+    let r = RpcInterface::open(&a[2])?;
+    let v=match a[1].as_str() {
+ "invalid" => {
+    let error = r.call_raw(&[0, 1, 2, 3, 4]).unwrap_err();
+    assert!(error.to_string().contains("RPC error (2)"));
+    let error = r.get_mining_template(None, None, 33, 0, true).unwrap_err();
+    assert!(error.to_string().contains("RPC error (8)"));
+    json!({"invalid_encoding": true, "extranonce_bounds": true})
+ },
+ "legacy_submitblock" => {
+    let mut builder = flatbuffers::FlatBufferBuilder::new();
+    let raw = builder.create_vector(&hex::decode(&a[3])?);
+    let request = old::SubmitBlockRequest::create(&mut builder, &old::SubmitBlockRequestArgs { raw_block: Some(raw) });
+    let call = old::RpcCall::create(&mut builder, &old::RpcCallArgs { rpc_type: old::RpcCallType::SubmitBlockRequest, rpc: Some(request.as_union_value()) });
+    builder.finish(call, None);
+    let data = r.call_raw(builder.finished_data())?;
+    let result = flatbuffers::root::<old::SubmitBlockResponse>(&data)?;
+    json!({"accepted":result.is_accepted(),"state":result.state(),"reason":result.reject_reason()})
+ },
+ "status" => {
+    let mut builder = flatbuffers::FlatBufferBuilder::new();
+    let request = fbs::GetMiningStatusRequest::create(&mut builder, &fbs::GetMiningStatusRequestArgs {});
+    let call = fbs::RpcCall::create(&mut builder, &fbs::RpcCallArgs {rpc_type: fbs::RpcRequest::GetMiningStatusRequest, rpc: Some(request.as_union_value())});
+    builder.finish(call, None);
+    let data = r.call_raw(builder.finished_data())?;
+    let status = flatbuffers::root::<fbs::GetMiningStatusResponse>(&data)?;
+    json!({"height":status.tip_height(),"network":status.network(),"mempool":status.mempool_tx_count(),"peers":status.connected_peers(),"node_time":status.node_time()})
+ },
+ "block"=>block(r.get_block(BlockIdentifier::Height(a[3].parse()?))?),
+ "range"=>json!(r.get_block_range(a[3].parse()?,a[4].parse()?)?.into_iter().map(block).collect::<Vec<_>>()),
+ "slice"=>json!(hex::encode(r.get_block_slice(a[3].parse()?,a[4].parse()?,a[5].parse()?)?)),
+ "undo_coins" => {
+    let mut data: Bytes = r.get_undo_slice(a[3].parse()?, a[4].parse()?, a[5].parse()?)?.into();
+    let count = read_compact_size(&mut data)?;
+    let mut decoded = Vec::new();
+    for _ in 0..count { decoded.push(read_undo_coin(&DummyEcc, &mut data)?); }
+    assert!(data.is_empty(), "Undo position and length must cover exactly one transaction undo");
+    coins(&Some(decoded))
+ },
+ "undo"=>json!(hex::encode(r.get_undo_slice(a[3].parse()?,a[4].parse()?,a[5].parse()?)?)),
+ "mempool"=>json!(r.get_mempool()?.iter().map(|m|json!({"txid":m.tx.txid.to_hex_be(),"raw":hex::encode(&m.tx.raw),"coins":coins(&m.tx.spent_coins),"time":m.time})).collect::<Vec<_>>()),
+ "mining"=>{ let m=r.get_mining_template(Some(&[0x51]),Some(b"existing-consumer"),4,4,true)?;json!({"height":m.height,"block":hex::encode(m.block),"header":hex::encode(m.header),"coinbase":hex::encode(m.coinbase_tx),"coinbase1":m.coinbase1,"coinbase2":m.coinbase2,"branches":m.merkle_branches,"ntime":m.ntime_stratum,"nbits":m.nbits_stratum,"fees":m.transactions.iter().map(|t|t.fee).collect::<Vec<_>>()}) },
+ _=>panic!("unknown command") };
+    println!("{}", v);
+    Ok(())
+}
