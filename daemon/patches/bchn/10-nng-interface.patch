diff --git a/test/functional/interface_nng.py b/test/functional/interface_nng.py
new file mode 100644
index 000000000..5003d1b2f
--- /dev/null
+++ b/test/functional/interface_nng.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Verify optional NNG framing, raw block/hash parity, reorgs and bind failure.
+
+Uses the installed NNG C library through ctypes; no Python NNG binding needed.
+"""
+import ctypes
+import ctypes.util
+import struct
+import time
+
+from test_framework.address import byte_to_base58
+from test_framework.messages import CTransaction, COutPoint, CTxIn, CTxOut
+from test_framework.script import CScript, OP_TRUE, OP_RETURN, hash160
+from test_framework.test_framework import BitcoinTestFramework, SkipTest
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, p2p_port
+
+
+class Subscriber:
+    def __init__(self, address, library):
+        if not library:
+            raise SkipTest("NNG shared library unavailable for subscriber")
+        self.lib = ctypes.CDLL(library)
+        self.lib.nng_sub0_open.argtypes = [ctypes.POINTER(ctypes.c_uint32)]
+        self.lib.nng_socket_set.argtypes = [ctypes.c_uint32, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t]
+        self.lib.nng_socket_set_ms.argtypes = [ctypes.c_uint32, ctypes.c_char_p, ctypes.c_int]
+        self.lib.nng_dial.argtypes = [ctypes.c_uint32, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_int]
+        self.lib.nng_recv.argtypes = [ctypes.c_uint32, ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t), ctypes.c_int]
+        self.lib.nng_free.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
+        self.lib.nng_close.argtypes = [ctypes.c_uint32]
+        self.socket = ctypes.c_uint32()
+        self.check(self.lib.nng_sub0_open(ctypes.byref(self.socket)))
+        self.check(self.lib.nng_socket_set(self.socket, b"sub:subscribe", None, 0))
+        self.check(self.lib.nng_socket_set_ms(self.socket, b"recv-timeout", 10000))
+        self.check(self.lib.nng_dial(self.socket, address.encode(), None, 0))
+        self.sequence = None
+
+    @staticmethod
+    def check(result):
+        assert_equal(result, 0)
+
+    def receive(self):
+        buffer = ctypes.c_void_p()
+        size = ctypes.c_size_t()
+        self.check(self.lib.nng_recv(self.socket, ctypes.byref(buffer), ctypes.byref(size), 1))  # NNG_FLAG_ALLOC
+        try:
+            data = ctypes.string_at(buffer, size.value)
+        finally:
+            self.lib.nng_free(buffer, size)
+        assert len(data) >= 20
+        topic = data[:12].rstrip(b"\x00").decode()
+        sequence, = struct.unpack("<Q", data[12:20])
+        if self.sequence is not None:
+            assert_equal(sequence, self.sequence + 1)
+        self.sequence = sequence
+        return topic, data[20:]
+
+    def until(self, wanted):
+        for _ in range(20):
+            topic, payload = self.receive()
+            if topic == wanted:
+                return payload
+        raise AssertionError("Missing topic " + wanted)
+
+    def close(self):
+        self.check(self.lib.nng_close(self.socket))
+
+
+class NngTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+
+    def add_options(self, parser):
+        parser.add_argument("--nng-library", default=ctypes.util.find_library("nng"), help="NNG shared library for ctypes subscriber")
+
+    def skip_test_if_missing_module(self):
+        if not self.config["components"].getboolean("ENABLE_NNG", fallback=False):
+            raise SkipTest("NNG was not compiled")
+        if not self.options.nng_library:
+            raise SkipTest("NNG test shared library unavailable; provide --nng-library")
+
+    def setup_network(self):
+        self.address = "tcp://127.0.0.1:" + str(p2p_port(1))
+        self.add_nodes(1, [["-nngpub=" + self.address]])
+        self.start_nodes()
+
+    def run_test(self):
+        node = self.nodes[0]
+        redeem = CScript([OP_TRUE])
+        destination = byte_to_base58(hash160(redeem), 196)
+        matured = node.generatetoaddress(101, destination)
+        coinbase = node.getblock(matured[0], 2)["tx"][0]
+        subscriber = Subscriber(self.address, self.options.nng_library)
+        try:
+            time.sleep(0.2)  # Allow the subscription handshake before generating events.
+            blockhash, = node.generatetoaddress(1, byte_to_base58(bytes(20), 111))
+            assert_equal(subscriber.until("blkconnected").hex(), node.getblock(blockhash, 0))
+            assert_equal(subscriber.until("updateblktip")[::-1].hex(), blockhash)
+            node.invalidateblock(blockhash)
+            assert_equal(subscriber.until("blkdisconctd").hex(), node.getblock(blockhash, 0))
+            # BCHN does not emit UpdatedBlockTip for a pure invalidation.
+            assert_equal(node.getblockcount(), 101)
+            tx = CTransaction()
+            tx.vin = [CTxIn(COutPoint(int(coinbase["txid"], 16), 0), CScript([redeem]))]
+            tx.vout = [CTxOut(int(coinbase["vout"][0]["value"] * 100000000) - 1000, CScript([OP_TRUE])),
+                       CTxOut(0, CScript([OP_RETURN, bytes(60)]))]
+            rawtx = tx.serialize().hex()
+            txid = node.sendrawtransaction(rawtx)
+            assert_equal(subscriber.until("mempooltxadd").hex(), rawtx)
+            mined, = node.generatetoaddress(1, destination)
+            assert_equal(subscriber.until("blkconnected").hex(), node.getblock(mined, 0))
+            assert_equal(subscriber.until("updateblktip")[::-1].hex(), mined)
+            assert txid in node.getblock(mined)["tx"]
+        finally:
+            subscriber.close()
+        self.stop_node(0)
+        node.assert_start_raises_init_error(extra_args=["-nngpub=invalid://endpoint"], expected_msg="Cannot start NNG publisher", match=ErrorMatch.PARTIAL_REGEX)
+        self.start_node(0)  # A failed bind must not leave a registered/dangling subscriber.
+        assert_equal(node.getblockcount(), 102)
+
+
+if __name__ == '__main__':
+    NngTest().main()
