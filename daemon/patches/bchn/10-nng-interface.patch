index 000000000..aacb85419
--- /dev/null
+++ b/src/nng/notificationinterface.cpp
@@ -0,0 +1,108 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <nng/notificationinterface.h>
+
+#include <chain.h>
+#include <logging.h>
+#include <primitives/block.h>
+#include <streams.h>
+#include <ui_interface.h>
+#include <util/system.h>
+#include <validationinterface.h>
+#include <version.h>
+
+#include <nng/nng.h>
+#include <nng/protocol/pubsub0/pub.h>
+
+#include <cstring>
+#include <memory>
+
+namespace {
+class NngNotifications final : public CValidationInterface {
+    nng_socket m_socket = NNG_SOCKET_INITIALIZER;
+    // Validation callbacks for a subscriber run serially. Sequence advances on
+    // every attempted send, so clients can detect local send failures too.
+    uint64_t m_sequence = 0;
+
+    void Send(const char *topic, const unsigned char *payload, size_t size) {
+        constexpr size_t HEADER_SIZE = 20;
+        nng_msg *msg = nullptr;
+        int result = nng_msg_alloc(&msg, HEADER_SIZE + size);
+        if (result != 0) {
+            ++m_sequence;
+            LogPrintf("NNG allocation failed: %s\n", nng_strerror(result));
+            return;
+        }
+        auto *data = static_cast<unsigned char *>(nng_msg_body(msg));
+        std::memset(data, 0, HEADER_SIZE);
+        std::memcpy(data, topic, std::strlen(topic));
+        for (size_t i = 0; i < 8; ++i) {
+            data[12 + i] = static_cast<unsigned char>(m_sequence >> (i * 8));
+        }
+        ++m_sequence;
+        std::memcpy(data + HEADER_SIZE, payload, size);
+        // Never block validation on slow consumers. NNG PUB delivery is lossy.
+        result = nng_sendmsg(m_socket, msg, NNG_FLAG_NONBLOCK);
+        if (result != 0) {
+            nng_msg_free(msg); // send takes ownership only on success
+            LogPrintf("NNG notification dropped: %s\n", nng_strerror(result));
+        }
+    }
+
+    template <typename T>
+    void SendObject(const char *topic, const T &object) {
+        CDataStream stream(SER_NETWORK, PROTOCOL_VERSION);
+        stream << object;
+        Send(topic, reinterpret_cast<const unsigned char *>(stream.data()), stream.size());
+    }
+
+    void UpdatedBlockTip(const CBlockIndex *tip, const CBlockIndex *, bool) override {
+        if (tip) SendObject("updateblktip", tip->GetBlockHash());
+    }
+    void TransactionAddedToMempool(const CTransactionRef &tx) override { SendObject("mempooltxadd", *tx); }
+    void TransactionRemovedFromMempool(const CTransactionRef &tx) override { SendObject("mempooltxrem", tx->GetId()); }
+    void BlockConnected(const std::shared_ptr<const CBlock> &block, const CBlockIndex *,
+                        const std::vector<CTransactionRef> &conflicted) override {
+        // BCHN reports conflicts here, rather than through removal callbacks.
+        for (const auto &tx : conflicted)
+            SendObject("mempooltxrem", tx->GetId());
+        SendObject("blkconnected", *block);
+    }
+    void BlockDisconnected(const std::shared_ptr<const CBlock> &block) override { SendObject("blkdisconctd", *block); }
+    void ChainStateFlushed(const CBlockLocator &locator) override {
+        if (!locator.vHave.empty()) SendObject("chainstflush", locator.vHave.front());
+    }
+
+public:
+    ~NngNotifications() { nng_close(m_socket); }
+    bool Listen(const std::string &address) {
+        int result = nng_pub0_open(&m_socket);
+        if (result == 0) result = nng_socket_set_int(m_socket, NNG_OPT_SENDBUF, 4);
+        if (result == 0) result = nng_listen(m_socket, address.c_str(), nullptr, 0);
+        if (result != 0) {
+            return InitError(strprintf(_("Cannot start NNG publisher: %s"), nng_strerror(result)));
+        }
+        LogPrintf("NNG publisher listening at %s\n", address);
+        return true;
+    }
+};
+std::unique_ptr<NngNotifications> g_notifications;
+} // namespace
+
+bool StartNngNotifications() {
+    if (!gArgs.IsArgSet("-nngpub")) return true;
+    auto notifications = std::make_unique<NngNotifications>();
+    if (!notifications->Listen(gArgs.GetArg("-nngpub", ""))) return false;
+    RegisterValidationInterface(notifications.get());
+    g_notifications = std::move(notifications);
+    return true;
+}
+
+void StopNngNotifications() {
+    if (g_notifications) {
+        UnregisterValidationInterface(g_notifications.get());
+        g_notifications.reset();
+    }
+}
