+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+use std::{env, path::PathBuf, process::Command};
+fn main() {
+    let schema = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap())
+        .join("../../src/nng_interface/nng_interface.fbs");
+    println!("cargo:rerun-if-changed={}", schema.display());
+    let legacy = schema.with_file_name("plugin_interface.fbs");
+    println!("cargo:rerun-if-changed={}", legacy.display());
+    assert!(Command::new("flatc")
+        .args(["--rust", "-o", &env::var("OUT_DIR").unwrap()])
+        .arg(schema)
+        .arg(legacy)
+        .status()
+        .expect("flatc is required for the schema-only mining status test")
+        .success());
+}
diff --git a/test/nng_compat_client/check_schema.py b/test/nng_compat_client/check_schema.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8f75d1530b060c2121e9c55bc6a08dd313eb1bc
--- /dev/null
+++ b/test/nng_compat_client/check_schema.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Compare the unchanged public consumer schema and repeat FlatBuffers generation."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+SCHEMA = HERE.parents[1] / "src/nng_interface/nng_interface.fbs"
+EXPECTED_SCHEMA = "c39da0022720daae60aad3f900a6ab51487476ef316744374ba677d0402785df"
+
+
+def normalized(data):
+    return data.rstrip() + b"\n"
+
+
+def main():
+    metadata = json.loads(subprocess.check_output([
+        "cargo", "+1.93.0", "metadata", "--locked", "--format-version=1",
+        "--manifest-path", str(HERE / "Cargo.toml")]))
+    package = next(p for p in metadata["packages"] if p["name"] == "bitcoinsuite-bitcoind-nng")
+    assert package["source"].endswith("#d425f277debbddfb0b9ebdc7e737c1c0c56c6dac"), package["source"]
+    reference = Path(package["manifest_path"]).parent / "flatbuffers/nng_interface.fbs"
+    assert normalized(SCHEMA.read_bytes()) == normalized(reference.read_bytes())
+    assert hashlib.sha256(normalized(SCHEMA.read_bytes())).hexdigest() == EXPECTED_SCHEMA
+    provenance = json.loads((HERE / "reference-provenance.json").read_text())
+    legacy = SCHEMA.with_name("plugin_interface.fbs")
+    fixture = HERE.parent / "functional/data/nng-2021/interface_plugin_nng.py.fixture"
+    assert hashlib.sha256(legacy.read_bytes()).hexdigest() == provenance["legacy"]["schema_sha256"]
+    assert hashlib.sha256(fixture.read_bytes()).hexdigest() == provenance["legacy"]["reference_test_sha256"]
+    compile(fixture.read_text(), str(fixture), "exec")
+    outputs = []
+    with tempfile.TemporaryDirectory(prefix="nng-flatc-conformance-") as tmp:
+        for name in ("first", "second"):
+            out = Path(tmp) / name
+            out.mkdir()
+            subprocess.run(["flatc", "--conform", str(reference), "--cpp", "--python", "-o", str(out), str(SCHEMA)], check=True)
+            subprocess.run(["flatc", "--cpp", "--python", "-o", str(out), str(legacy)], check=True)
+            outputs.append({str(p.relative_to(out)): hashlib.sha256(p.read_bytes()).hexdigest()
+                            for p in sorted(out.rglob("*")) if p.is_file()})
+    assert outputs[0] == outputs[1]
+    print(json.dumps({"schema_sha256": EXPECTED_SCHEMA,
+                      "consumer_revision": "d425f277debbddfb0b9ebdc7e737c1c0c56c6dac",
+                      "flatc": subprocess.check_output(["flatc", "--version"], text=True).strip(),
+                      "repeated_generated_files": len(outputs[0])}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
