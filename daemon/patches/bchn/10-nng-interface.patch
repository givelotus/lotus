+
+    def _make_get_mempool_request_fbs(self):
+        from PluginInterface import (
+            RpcCall,
+            RpcCallType,
+            GetMempoolRequest,
+        )
+        import flatbuffers
+        fbb = flatbuffers.Builder()
+        GetMempoolRequest.GetMempoolRequestStart(fbb)
