From 448fc5ba5a5fb27dbf3a080a10850df551a01fa0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 07:42:56 -0700
Subject: [PATCH] chronik: verify AuxPoW headers and transaction disk offsets
 on regtest

Exercise the existing Dogecoin AuxPoW acceptance/rejection scenarios with Chronik enabled and Avalanche disabled. For both accepted AuxPoW blocks, compare complete serialized headers, transaction IDs, and raw transaction bytes with independently decoded RPC blocks. The fixtures use different parent/chain Merkle branch shapes, covering variable header sizes. This adds indexer regression coverage without requiring Chronik for the standalone consensus test.
---
 test/functional/chronik_dogecoin_auxpow.py | 43 ++++++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 test/functional/chronik_dogecoin_auxpow.py

diff --git a/test/functional/chronik_dogecoin_auxpow.py b/test/functional/chronik_dogecoin_auxpow.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9da4cbe508184e60c90cd7e86b6111ca9ada976
--- /dev/null
+++ b/test/functional/chronik_dogecoin_auxpow.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Check Chronik header serialization and disk transaction offsets for AuxPoW."""
+
+import io
+
+from dogecoin_auxpow import DogecoinAuxpowTest
+from test_framework.messages import CBlock, CBlockHeader
+from test_framework.util import assert_equal
+
+
+class ChronikDogecoinAuxpowTest(DogecoinAuxpowTest):
+    def set_test_params(self):
+        super().set_test_params()
+        self.extra_args = [["-chronik", "-avalanche=0"]]
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_chronik()
+
+    def run_test(self):
+        super().run_test()
+        node = self.nodes[0]
+        chronik = node.get_chronik_client()
+        node.syncwithvalidationinterfacequeue()
+        for height in (1, 2):
+            block_hash = node.getblockhash(height)
+            raw_block = bytes.fromhex(node.getblock(block_hash, 0))
+            block = CBlock()
+            block.deserialize(io.BytesIO(raw_block))
+            header = CBlockHeader(block).serialize()
+            assert len(header) > 80, "Fixture must contain serialized AuxPoW"
+            assert_equal(chronik.block_header(height).ok().raw_header, header)
+            indexed = chronik.block_txs(height).ok().txs
+            assert_equal(len(indexed), len(block.vtx))
+            for tx, actual in zip(block.vtx, indexed):
+                assert_equal(actual.txid, bytes.fromhex(tx.txid_hex)[::-1])
+                assert_equal(chronik.raw_tx(tx.txid_hex).ok().raw_tx, tx.serialize())
+
+
+if __name__ == "__main__":
+    ChronikDogecoinAuxpowTest().main()
