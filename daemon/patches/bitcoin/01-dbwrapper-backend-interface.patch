+        if (!status.ok()) {
+            if (status.IsNotFound())
+                return false;
+            LogError("LevelDB read failure: %s", status.ToString());
+            HandleError(status);
+        }
+        return true;
     }
-    if (!params.memory_only) {
-        if (params.wipe_data) {
