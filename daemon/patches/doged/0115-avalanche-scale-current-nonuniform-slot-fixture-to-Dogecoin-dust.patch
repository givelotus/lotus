From 7d5bd114e71e4f5c60df011f587ec67fd1fd00fb Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:11 -0700
Subject: [PATCH] avalanche: scale current nonuniform slot fixture to Dogecoin
 dust

The newer upstream compaction regression hardcodes 100-DOGE proof weights below the retained 10,000-DOGE threshold. Express scores and expected ranges in MIN_VALID_PROOF_SCORE units while preserving exhaustive per-slot selection and exact fragmentation assertions.

diff --git a/src/avalanche/test/peermanager_tests.cpp b/src/avalanche/test/peermanager_tests.cpp
index 1d245436871e268ecd083c92b0ba682c00ca1897..9244e75a071dbc98203b8fb4fa9488a25cbb884b 100644
--- a/src/avalanche/test/peermanager_tests.cpp
+++ b/src/avalanche/test/peermanager_tests.cpp
@@ -532,7 +532,8 @@ BOOST_AUTO_TEST_CASE(compact_slots_non_uniform_scores) {
     avalanche::PeerManager pm(PROOF_DUST_THRESHOLD, chainman);
 
     // Add 4 peers with distinct scores
-    const std::array<Score, 4> scores{{10000, 20000, 30000, 40000}};
+    constexpr Score unit = MIN_VALID_PROOF_SCORE;
+    const std::array<Score, 4> scores{{unit, 2 * unit, 3 * unit, 4 * unit}};
     std::array<PeerId, 4> peerids;
     for (int i = 0; i < 4; i++) {
         auto p = buildRandomProof(chainman.ActiveChainstate(), scores[i]);
@@ -541,30 +542,30 @@ BOOST_AUTO_TEST_CASE(compact_slots_non_uniform_scores) {
                                DEFAULT_AVALANCHE_MAX_ELEMENT_POLL));
     }
 
-    BOOST_CHECK_EQUAL(pm.getSlotCount(), 100000);
+    BOOST_CHECK_EQUAL(pm.getSlotCount(), 10 * unit);
     BOOST_CHECK_EQUAL(pm.getFragmentation(), 0);
 
     // Remove a peer in a middle slot, leaving a dead slot behind
     BOOST_CHECK(pm.removePeer(peerids[1]));
-    BOOST_CHECK_EQUAL(pm.getSlotCount(), 100000);
-    BOOST_CHECK_EQUAL(pm.getFragmentation(), 20000);
+    BOOST_CHECK_EQUAL(pm.getSlotCount(), 10 * unit);
+    BOOST_CHECK_EQUAL(pm.getFragmentation(), 2 * unit);
 
     // Compaction reclaims exactly the fragmented slot space
-    BOOST_CHECK_EQUAL(pm.compact(), 20000);
+    BOOST_CHECK_EQUAL(pm.compact(), 2 * unit);
     BOOST_CHECK(pm.verify());
 
     // After compaction, the slot space must cover exactly the sum of the
     // remaining peers' scores.
-    BOOST_CHECK_EQUAL(pm.getSlotCount(), 80000);
+    BOOST_CHECK_EQUAL(pm.getSlotCount(), 8 * unit);
     BOOST_CHECK_EQUAL(pm.getFragmentation(), 0);
 
     // Every value of the slot space must select one of the remaining peers
     // (not NO_PEER), and each remaining peer must be selected over its range.
     for (uint64_t slot = 0; slot < pm.getSlotCount(); slot++) {
         PeerId p = TestPeerManager::selectPeerFromSlot(pm, slot);
-        if (slot < 10000) {
+        if (slot < unit) {
             BOOST_CHECK_EQUAL(p, peerids[0]);
-        } else if (slot < 40000) {
+        } else if (slot < 4 * unit) {
             BOOST_CHECK_EQUAL(p, peerids[2]);
         } else {
             BOOST_CHECK_EQUAL(p, peerids[3]);
