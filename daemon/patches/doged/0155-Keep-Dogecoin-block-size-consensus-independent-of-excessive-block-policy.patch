From 6ed352d9c852c2c9d18e152f0eed1443e2c268e1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:51:11 -0700
Subject: [PATCH] Keep Dogecoin block-size consensus independent of
 excessive-block policy

Dogecoin Core47a303a449999314abcf83bd1fc7e77dd4540fcd src/validation.cpp CheckBlock enforces MAX_BLOCK_BASE_SIZE regardless of node policy. The inherited Doged default1MB was configurable upwards. Cap legacy-network validation at1MB, retaining explicit nonlegacy compatibility mode and configurable lower policy limits. Regression checks exact1MB acceptance and1MB+1 rejection with a2MB configured policy.

diff --git a/src/test/validation_tests.cpp b/src/test/validation_tests.cpp
index 8d45f38f0342bb03e70bec8e4a44eec946ce2cde..e43e8405ee6706535d898c7a9796b39ebe675ef2 100644
--- a/src/test/validation_tests.cpp
+++ b/src/test/validation_tests.cpp
@@ -501,4 +501,39 @@ BOOST_AUTO_TEST_CASE(block_malleation) {
     }
 }
 
+
+BOOST_AUTO_TEST_CASE(dogecoin_fixed_block_size_limit) {
+    const auto params = CreateChainParams(*m_node.args, ChainType::MAIN);
+    CMutableTransaction coinbase;
+    coinbase.vin.resize(1);
+    coinbase.vin[0].scriptSig = CScript() << OP_0 << OP_0;
+    coinbase.vout.resize(1);
+    coinbase.vout[0].nValue = Amount::zero();
+    coinbase.vout[0].scriptPubKey.resize(ONE_MEGABYTE);
+    CBlock block;
+    block.vtx = {MakeTransactionRef(coinbase)};
+    coinbase.vout[0].scriptPubKey.resize(
+        ONE_MEGABYTE - (GetSerializeSize(block) - ONE_MEGABYTE));
+    block.vtx = {MakeTransactionRef(coinbase)};
+    BOOST_REQUIRE_EQUAL(GetSerializeSize(block), ONE_MEGABYTE);
+    const BlockValidationOptions options(2 * ONE_MEGABYTE, false, false);
+    gArgs.ForceSetArg("-legacyscriptrules", "1");
+    {
+        BlockValidationState state;
+        BOOST_CHECK(CheckBlock(block, state, params->GetConsensus(), options));
+    }
+    coinbase.vout[0].scriptPubKey.push_back(OP_0);
+    block.vtx = {MakeTransactionRef(coinbase)};
+    BOOST_REQUIRE_EQUAL(GetSerializeSize(block), ONE_MEGABYTE + 1);
+    {
+        BlockValidationState state;
+        BOOST_CHECK(!CheckBlock(block, state, params->GetConsensus(), options));
+        BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-blk-length");
+    }
+    // Explicit nonlegacy test mode retains current ABC configurable semantics.
+    gArgs.ForceSetArg("-legacyscriptrules", "0");
+    BlockValidationState state;
+    BOOST_CHECK(CheckBlock(block, state, params->GetConsensus(), options));
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/validation.cpp b/src/validation.cpp
index 00de96785d82c1d966fac6003f27add788d29f32..951f7b3221215b65156b0d789416778aeebdebf8 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4457,6 +4457,11 @@ bool CheckBlock(const CBlock &block, BlockValidationState &state,
 
     // Size limits.
     auto nMaxBlockSize = validationOptions.getExcessiveBlockSize();
+    if (IsLegacyScriptRulesEnabled(consensusParams)) {
+        // Dogecoin has a fixed consensus block-size limit. The configurable
+        // eCash excessive-block policy must not relax it.
+        nMaxBlockSize = std::min(nMaxBlockSize, LEGACY_MAX_BLOCK_SIZE);
+    }
 
     // Bail early if there is no way this block is of reasonable size.
     if ((block.vtx.size() * MIN_TRANSACTION_SIZE) > nMaxBlockSize) {
