From d4964af3b8fd69ea3c54a11a252b31da832bd87d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:00:39 -0700
Subject: [PATCH] Keep the coinbase subsidy limit covered with zero block fees

Extend the aggregate-fee regression with a no-fee block and a coinbase claiming one satoshi above subsidy. Full native TestBlockValidity still rejects bad-cb-amount after saturating accounting, independently from the per-transaction MAX_MONEY cap.

diff --git a/src/test/validation_tests.cpp b/src/test/validation_tests.cpp
index db6e64fcc256be4fe0557f2d21eee2b688e7d7e5..919c225a12975b09ed634c829bf5a7ad86c4e5cc 100644
--- a/src/test/validation_tests.cpp
+++ b/src/test/validation_tests.cpp
@@ -544,7 +544,7 @@ BOOST_AUTO_TEST_CASE(dogecoin_fixed_block_size_limit) {
 BOOST_FIXTURE_TEST_CASE(dogecoin_large_block_fees, TestChain100Setup) {
     LOCK(cs_main);
     auto &chainstate = m_node.chainman->ActiveChainstate();
-    for (const size_t count : {size_t{2}, size_t{16}}) {
+    for (const size_t count : {size_t{0}, size_t{2}, size_t{16}}) {
         std::vector<CMutableTransaction> spends;
         for (size_t i = 0; i < count; ++i) {
             CMutableTransaction funding;
@@ -573,7 +573,9 @@ BOOST_FIXTURE_TEST_CASE(dogecoin_large_block_fees, TestChain100Setup) {
 
         auto excessive = block;
         auto coinbase = CMutableTransaction(*excessive.vtx[0]);
-        coinbase.vout[0].nValue = MAX_MONEY + SATOSHI;
+        coinbase.vout[0].nValue = count == 0
+                                    ? coinbase.vout[0].nValue + SATOSHI
+                                    : MAX_MONEY + SATOSHI;
         excessive.vtx[0] = MakeTransactionRef(coinbase);
         excessive.hashMerkleRoot = BlockMerkleRoot(excessive);
         excessive.fChecked = false;
@@ -585,7 +587,8 @@ BOOST_FIXTURE_TEST_CASE(dogecoin_large_block_fees, TestChain100Setup) {
             [] { return NodeClock::now(); },
             BlockValidationOptions(GetConfig()).withCheckPoW(false)));
         BOOST_CHECK_EQUAL(excessive_state.GetRejectReason(),
-                          "bad-txns-vout-toolarge");
+                          count == 0 ? "bad-cb-amount"
+                                     : "bad-txns-vout-toolarge");
     }
 }
 
