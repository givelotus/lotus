From cfbdcd2fa8e824cf053268f8bfb37c3b71195697 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:55:28 -0700
Subject: [PATCH] Validate Dogecoin block transactions in dependency order

The inherited ABC connect path inserts every output before checking inputs to support canonical transaction ordering. With CTOR disabled this incorrectly accepts a child before its parent, contrary to Dogecoin Core sequential UpdateCoins semantics. Only prepopulate outputs for the retained optional CTOR path; otherwise add each output after its transaction passes validation and spends its inputs. Count P2SH sigops only after confirming inputs exist.

Reference: dogecoin/dogecoin 47a303a449999314abcf83bd1fc7e77dd4540fcd src/validation.cpp UpdateCoins call in ConnectBlock. This corrects inherited Doged behavior rather than silently attributing it to the original lineage.

diff --git a/src/validation.cpp b/src/validation.cpp
index dd1ff8c1a8dd009aedb98a02d054519127d1af45..96f5d83695b93b6a93cd478a31612f692affbdad 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -2386,10 +2386,15 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         control.emplace(m_chainman.GetCheckQueue());
     }
 
-    // Add all outputs
+    // CTOR permits parents after children. Dogecoin instead makes outputs
+    // available only after their transaction has been validated.
+    const bool canonicalOrdering =
+        IsMagneticAnomalyEnabled(consensusParams, pindex->pprev);
     try {
-        for (const auto &ptx : block.vtx) {
-            AddCoins(view, *ptx, pindex->nHeight);
+        if (canonicalOrdering) {
+            for (const auto &ptx : block.vtx) {
+                AddCoins(view, *ptx, pindex->nHeight);
+            }
         }
     } catch (const std::logic_error &e) {
         // This error will be thrown from AddCoin if we try to connect a block
@@ -2414,18 +2419,6 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         const bool isCoinBase = tx.IsCoinBase();
         nInputs += tx.vin.size();
 
-        // CountTxSigOps counts 2 types of sigops:
-        // * legacy (always)
-        // * p2sh (when P2SH enabled in flags and excludes coinbase)
-        nSigOps += CountTxSigOps(tx, view);
-
-        if (nSigOps > MAX_BLOCK_SIGOPS) {
-            state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
-                          "bad-blk-sigops",
-                          strprintf("%s: too many sigops", __func__));
-            return false;
-        }
-
         {
             Amount txfee = Amount::zero();
             TxValidationState tx_state;
@@ -2443,6 +2436,18 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
             nFees += txfee;
         }
 
+        // CountTxSigOps counts 2 types of sigops:
+        // * legacy (always)
+        // * p2sh (when P2SH enabled in flags and excludes coinbase)
+        nSigOps += CountTxSigOps(tx, view);
+
+        if (nSigOps > MAX_BLOCK_SIGOPS) {
+            state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                          "bad-blk-sigops",
+                          strprintf("%s: too many sigops", __func__));
+            return false;
+        }
+
         if (!MoneyRange(nFees)) {
             state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
                           "bad-txns-accumulated-fee-outofrange",
@@ -2452,6 +2457,9 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
 
         // The following checks do not apply to the coinbase.
         if (isCoinBase) {
+            if (!canonicalOrdering) {
+                AddCoins(view, tx, pindex->nHeight);
+            }
             continue;
         }
 
@@ -2509,6 +2517,9 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         // inputs in the same transaction (cf. CVE-2018-17144) -- that check is
         // done in CheckBlock (CheckRegularTransaction).
         SpendCoins(view, tx, blockundo.vtxundo.at(txIndex), pindex->nHeight);
+        if (!canonicalOrdering) {
+            AddCoins(view, tx, pindex->nHeight);
+        }
         txIndex++;
     }
     const auto time_3{SteadyClock::now()};
