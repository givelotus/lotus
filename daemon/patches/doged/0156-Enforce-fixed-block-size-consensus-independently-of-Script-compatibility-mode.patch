From e2ca0e4f89210b804505dce4560cf61f9b374e68 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:51:22 -0700
Subject: [PATCH] Enforce fixed block-size consensus independently of Script
 compatibility mode

Apply the Dogecoin1MB cap unconditionally on all supported networks. An explicit legacy Script override remains independent and cannot loosen block-size consensus; update the regression to verify this separation.

diff --git a/src/test/validation_tests.cpp b/src/test/validation_tests.cpp
index e43e8405ee6706535d898c7a9796b39ebe675ef2..07766920871693c1fd0e42de47bffc56ad8e92bb 100644
--- a/src/test/validation_tests.cpp
+++ b/src/test/validation_tests.cpp
@@ -530,10 +530,11 @@ BOOST_AUTO_TEST_CASE(dogecoin_fixed_block_size_limit) {
         BOOST_CHECK(!CheckBlock(block, state, params->GetConsensus(), options));
         BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-blk-length");
     }
-    // Explicit nonlegacy test mode retains current ABC configurable semantics.
+    // Script compatibility switches must not relax block-size consensus.
     gArgs.ForceSetArg("-legacyscriptrules", "0");
     BlockValidationState state;
-    BOOST_CHECK(CheckBlock(block, state, params->GetConsensus(), options));
+    BOOST_CHECK(!CheckBlock(block, state, params->GetConsensus(), options));
+    BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-blk-length");
 }
 
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/validation.cpp b/src/validation.cpp
index 951f7b3221215b65156b0d789416778aeebdebf8..dd1ff8c1a8dd009aedb98a02d054519127d1af45 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4457,11 +4457,9 @@ bool CheckBlock(const CBlock &block, BlockValidationState &state,
 
     // Size limits.
     auto nMaxBlockSize = validationOptions.getExcessiveBlockSize();
-    if (IsLegacyScriptRulesEnabled(consensusParams)) {
-        // Dogecoin has a fixed consensus block-size limit. The configurable
-        // eCash excessive-block policy must not relax it.
-        nMaxBlockSize = std::min(nMaxBlockSize, LEGACY_MAX_BLOCK_SIZE);
-    }
+    // Dogecoin has a fixed consensus block-size limit on every network.
+    // The configurable excessive-block policy must not relax consensus.
+    nMaxBlockSize = std::min(nMaxBlockSize, LEGACY_MAX_BLOCK_SIZE);
 
     // Bail early if there is no way this block is of reasonable size.
     if ((block.vtx.size() * MIN_TRANSACTION_SIZE) > nMaxBlockSize) {
