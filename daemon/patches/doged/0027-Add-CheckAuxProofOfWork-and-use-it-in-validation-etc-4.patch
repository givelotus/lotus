diff --git a/src/pow/auxpow.cpp b/src/pow/auxpow.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1f6fc78877162f544c61639d8fc7025bf341f168
--- /dev/null
+++ b/src/pow/auxpow.cpp
@@ -0,0 +1,17 @@
+// Copyright (c) 2024 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <consensus/params.h>
+#include <logging.h>
+#include <pow/pow.h>
+#include <primitives/block.h>
+
+bool CheckAuxProofOfWork(const CBlockHeader &block,
+                         const Consensus::Params &params) {
+    if (!CheckProofOfWork(block.GetPowHash(), block.nBits, params)) {
+        return error("%s : non-AUX proof of work failed", __func__);
+    }
+
+    return true;
+}
