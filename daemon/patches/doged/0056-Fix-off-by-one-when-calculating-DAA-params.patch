From df3739ed239cc5ae026e57778a6e9271fbd239ef Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Wed, 3 Sep 2025 20:41:44 +0000
Subject: [PATCH] Fix off-by-one when calculating DAA params

(cherry picked from commit d11aeb92163ab317711ec718aa7408f7687a856b)

Maintenance rationale (2026-10-14):
Select the historical difficulty-rule parameters at the correct next-block height, preserving the boundary transition.

diff --git a/src/pow/pow.cpp b/src/pow/pow.cpp
index 58ed1f5b250aa9cefd5895543609f8eba5bbfdb0..41f79bba9a78db500c1e7b3f1b3cffe4e732375e 100644
--- a/src/pow/pow.cpp
+++ b/src/pow/pow.cpp
@@ -47,7 +47,7 @@ uint32_t GetNextWorkRequired(const CBlockIndex *pindexPrev,
         UintToArith256(params.powLimit).GetCompact();
 
     const int32_t nHeight = pindexPrev->nHeight;
-    const Consensus::DaaParams daaParams = params.DaaParamsAtHeight(nHeight);
+    const Consensus::DaaParams daaParams = params.DaaParamsAtHeight(nHeight + 1);
 
     // Dogecoin: Special rules for minimum difficulty blocks with Digishield
     if (AllowDigishieldMinDifficultyForBlock(pindexPrev, pblock, params,
