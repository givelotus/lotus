From 3a7a1a92fef0577d0dd8f382c2699fd47c96ae5d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:31:31 -0700
Subject: [PATCH] Preserve Doged optional address-type RPC arguments

Current ABC removed deprecated address_type descriptors while the Doged reference still accepts legacy in getnewaddress and getrawchangeaddress. Retain this consumer contract and reject unknown values. The original 972f34994068db28b09ff7e28df3cf2abaa755a4 refactor also preserves the output_type selection. Extend the legacy signing functional test with argument compatibility checks.

diff --git a/src/wallet/rpcwallet.cpp b/src/wallet/rpcwallet.cpp
index ad560e0ab862a7e76a3d09a1d8aab6d2d5a683c1..f12774428a6f8ec791064e42bb74369bfb50543d 100644
--- a/src/wallet/rpcwallet.cpp
+++ b/src/wallet/rpcwallet.cpp
@@ -107,6 +107,9 @@ static RPCHelpMan getnewaddress() {
              "string \"\" to represent the default label. The label does not "
              "need to exist, it will be created if there is no label by the "
              "given name."},
+            {"address_type", RPCArg::Type::STR, RPCArg::Optional::OMITTED,
+             "The address type. Only \"legacy\" is supported; retained for "
+             "compatibility with existing Dogecoin clients."},
         },
         RPCResult{RPCResult::Type::STR, "address", "The new eCash address"},
         RPCExamples{HelpExampleCli("getnewaddress", "") +
@@ -133,8 +136,14 @@ static RPCHelpMan getnewaddress() {
                 label = LabelFromValue(request.params[0]);
             }
 
-            auto op_dest =
-                pwallet->GetNewDestination(OutputType::LEGACY, label);
+            OutputType output_type = pwallet->m_default_address_type;
+            if (!request.params[1].isNull() &&
+                !ParseOutputType(request.params[1].get_str(), output_type)) {
+                throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY,
+                                   strprintf("Unknown address type '%s'",
+                                             request.params[1].get_str()));
+            }
+            auto op_dest = pwallet->GetNewDestination(output_type, label);
             if (!op_dest) {
                 throw JSONRPCError(RPC_WALLET_KEYPOOL_RAN_OUT,
                                    util::ErrorString(op_dest).original);
@@ -150,7 +159,9 @@ static RPCHelpMan getrawchangeaddress() {
         "getrawchangeaddress",
         "Returns a new Bitcoin address, for receiving change.\n"
         "This is for use with raw transactions, NOT normal use.\n",
-        {},
+        {{"address_type", RPCArg::Type::STR, RPCArg::Optional::OMITTED,
+          "The address type. Only \"legacy\" is supported; retained for "
+          "compatibility with existing Dogecoin clients."}},
         RPCResult{RPCResult::Type::STR, "address", "The address"},
         RPCExamples{HelpExampleCli("getrawchangeaddress", "") +
                     HelpExampleRpc("getrawchangeaddress", "")},
diff --git a/test/functional/feature_legacy_signrawtransaction.py b/test/functional/feature_legacy_signrawtransaction.py
index 7da9f139837703228a61bb16a66948dfe872167b..8b085276ebd8f5e27b6b087120b3d8d520c402c3 100644
--- a/test/functional/feature_legacy_signrawtransaction.py
+++ b/test/functional/feature_legacy_signrawtransaction.py
@@ -33,6 +33,12 @@ class LegacyScriptSignrawtransactionTest(BitcoinTestFramework):
         node = self.nodes[0]
         nonlegacy_node = self.nodes[1]
 
+        # Preserve the pinned Doged optional address-type RPC contract.
+        assert node.validateaddress(node.getnewaddress("", "legacy"))["isvalid"]
+        assert node.validateaddress(node.getrawchangeaddress("legacy"))["isvalid"]
+        assert_raises_rpc_error(-5, "Unknown address type", node.getnewaddress, "", "invalid")
+        assert_raises_rpc_error(-5, "Unknown address type", node.getrawchangeaddress, "invalid")
+
         def check_signed_result(node, result):
             assert result["complete"], f"Signing failed: {result}"
             accept_result = node.testmempoolaccept([result["hex"]])[0]
