From 2414b78c0e71f021833dab78713758400a8c185c Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Tue, 11 Jun 2024 16:46:51 +0000
Subject: [PATCH] Replace seeders

Maintenance explanation (added 2026-10-14; not original author text):
Replace ABC DNS discovery with Dogecoin seeders so initial peers belong to
the intended network. This incomplete port is not synchronization evidence.

The original subject, author and author date are preserved. Only message
metadata changes; exact source diff bytes and intermediate trees are retained.

diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 7be70c7258619ef622ad01e715c436ec7bfe1f5d..19ec5cb4ced914cff2770338b13a751c47c077cf 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -188,12 +188,8 @@ public:
         // the service bits we want, but we should get them updated to support
         // all service bits wanted by any release ASAP to avoid it where
         // possible.
-        // Bitcoin ABC seeder
-        vSeeds.emplace_back("seed.bitcoinabc.org");
-        // Fabien
-        vSeeds.emplace_back("seeder.fabien.cash");
-        // status.cash
-        vSeeds.emplace_back("seeder.status.cash");
+        vSeeds.emplace_back("seed.multidoge.org");
+        vSeeds.emplace_back("seed2.multidoge.org");
 
         base58Prefixes[PUBKEY_ADDRESS] = std::vector<uint8_t>(1, 0);
         base58Prefixes[SCRIPT_ADDRESS] = std::vector<uint8_t>(1, 5);
@@ -351,12 +347,7 @@ public:
         vFixedSeeds.clear();
         vSeeds.clear();
         // nodes with support for servicebits filtering should be at the top
-        // Bitcoin ABC seeder
-        vSeeds.emplace_back("testnet-seed.bitcoinabc.org");
-        // Fabien
-        vSeeds.emplace_back("testnet-seeder.fabien.cash");
-        // status.cash
-        vSeeds.emplace_back("testnet-seeder.status.cash");
+        vSeeds.emplace_back("testseed.jrn.me.uk");
 
         base58Prefixes[PUBKEY_ADDRESS] = std::vector<uint8_t>(1, 111);
         base58Prefixes[SCRIPT_ADDRESS] = std::vector<uint8_t>(1, 196);
