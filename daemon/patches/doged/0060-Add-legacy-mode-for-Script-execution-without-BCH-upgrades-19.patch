@@ -91,6 +91,17 @@ static bool IsOpcodeDisabled(opcodetype opcode, uint32_t flags) {
             // Disabled opcodes.
             return true;
 
+        case OP_CAT:
+        case OP_SPLIT:
+        case OP_NUM2BIN:
+        case OP_BIN2NUM:
+        case OP_AND:
+        case OP_OR:
+        case OP_XOR:
+        case OP_DIV:
+        case OP_MOD:
+            return (flags & SCRIPT_VERIFY_LEGACY_RULES) != 0;
+
         default:
             break;
     }
@@ -965,6 +976,9 @@ bool ScriptInterpreter::RunNextOpInner() {
 
             case OP_CHECKDATASIG:
             case OP_CHECKDATASIGVERIFY: {
+                if (flags & SCRIPT_VERIFY_LEGACY_RULES) {
+                    return set_error(serror, ScriptError::BAD_OPCODE);
+                }
                 // (sig message pubkey -- bool)
                 if (stack.size() < 3) {
                     return set_error(serror,
@@ -988,7 +1002,7 @@ bool ScriptInterpreter::RunNextOpInner() {
