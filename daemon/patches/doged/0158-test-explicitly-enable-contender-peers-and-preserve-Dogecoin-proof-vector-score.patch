From ae6b44a6f64c92b6e5bd824de06dd98d04d1914d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:51:06 -0700
Subject: [PATCH] test: explicitly enable contender peers and preserve Dogecoin
 proof vector score

Full144-case optional suite exposed two contender fixtures relying on the upstream default-enabled PeerManager configuration while only toggling the Processor flag, and one upstream serialized duplicate-stake vector whose score saturates at eCash MAX_MONEY but not Dogecoin. Construct fixture peers with explicit staking preconsensus opt-in while retaining per-test Processor toggles and historical activation tests. Restore the fixed vector hundredth-coin sum; keep duplicate rejection and independent real MAX_MONEY saturation regressions.

diff --git a/src/avalanche/test/processor_tests.cpp b/src/avalanche/test/processor_tests.cpp
index de4b8e474e0052db3fa8d802991f45f862770a89..f3ccbdb4554a1b0d29183a597f50947a09f5116f 100644
--- a/src/avalanche/test/processor_tests.cpp
+++ b/src/avalanche/test/processor_tests.cpp
@@ -138,7 +138,8 @@ CService ip(uint32_t i) {
 struct AvalancheProcessorTestingSetup : public AvalancheTestChain100Setup {
     AvalancheProcessorTestingSetup()
         : AvalancheTestChain100Setup(ChainType::REGTEST,
-                                     {"-blockmintxfee=0.00001000"}) {
+                                     {"-blockmintxfee=0.00001000",
+                                      "-avalanchestakingpreconsensus=1"}) {
         setArg("-shibusawaactivationtime", "0");
         AvalancheTest::setStakingPreconsensus(*m_node.avalanche, false);
     }
diff --git a/src/avalanche/test/proof_tests.cpp b/src/avalanche/test/proof_tests.cpp
index f99cb54912be16e0d1d3c5831ae68a2ba37316ec..1a2522effd001c44b3096eea34d9af945b88274c 100644
--- a/src/avalanche/test/proof_tests.cpp
+++ b/src/avalanche/test/proof_tests.cpp
@@ -210,8 +210,9 @@ BOOST_AUTO_TEST_CASE(deserialization) {
          "ad8450ba57e11dfb61b1f5a7325094d5ffda1f5830e0990dcc2ebb9be8",
          ProofId::fromHex("5d4919b43a1afb6acdeddaf1678397eaa10562125db6b911ec4e"
                           "35fd8598ad73"),
-         // Stake amounts sum above MAX_MONEY (3280755132); score is saturated.
-         Proof::amountToScore(MAX_MONEY),
+         // These fixed stakes exceed the eCash limit, but remain below
+         // Dogecoin MAX_MONEY; retain their unsaturated hundredth-coin sum.
+         Score{3280755132},
          ProofValidationResult::DUPLICATE_STAKE},
         {"Properly signed 3 UTXO proof",
          "c964aa6fde575e4ce8404581c7be874e21023beefdde700a6bc02036335b4df141c8b"
