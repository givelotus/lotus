From b84cbf40b441f21ef1c2abfa67fdf64f905d7ab2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:53:39 -0700
Subject: [PATCH] tests: cover Dogecoin mining size cap under permissive local
 policy

Keep all smaller block-size boundary checks. A configured excessive-block limit above one megabyte must not let the assembler exceed fixed Dogecoin consensus, so the one-byte-over-policy cases now retain the consensus reserve. Add explicit 32MB policy cases covering both small requested blocks and oversized requests.

diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index d2f79283f484a031c855da07496f938f4e5882e7..0d8f5ca906bc712064c11cb079ac6441173648bb 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -911,9 +911,18 @@ BOOST_AUTO_TEST_CASE(BlockAssembler_construction) {
     CheckBlockMaxSize(config, mempool, active_chainstate, ONE_MEGABYTE - 1000,
                       ONE_MEGABYTE - 1000);
     CheckBlockMaxSize(config, mempool, active_chainstate, ONE_MEGABYTE - 999,
-                      ONE_MEGABYTE - 999);
+                      ONE_MEGABYTE - 1000);
     CheckBlockMaxSize(config, mempool, active_chainstate, ONE_MEGABYTE,
-                      ONE_MEGABYTE - 999);
+                      ONE_MEGABYTE - 1000);
+
+    // A permissive local excessive-block setting cannot raise Dogecoin's
+    // consensus limit. Small explicitly configured mining sizes still work.
+    config.SetMaxBlockSize(32 * ONE_MEGABYTE);
+    CheckBlockMaxSize(config, mempool, active_chainstate, 12345, 12345);
+    CheckBlockMaxSize(config, mempool, active_chainstate, ONE_MEGABYTE,
+                      ONE_MEGABYTE - 1000);
+    CheckBlockMaxSize(config, mempool, active_chainstate, 32 * ONE_MEGABYTE,
+                      ONE_MEGABYTE - 1000);
 
     // Test around default cap
     config.SetMaxBlockSize(DEFAULT_MAX_BLOCK_SIZE);
