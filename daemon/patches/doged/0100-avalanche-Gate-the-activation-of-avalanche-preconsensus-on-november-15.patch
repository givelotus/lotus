From 9d1f70d7f0680009cb56ecce04f7d52d8cbd18d2 Mon Sep 17 00:00:00 2001
From: Fabien <fabcien@gmail.com>
Date: Thu, 25 Sep 2025 14:26:23 +0200
Subject: [PATCH] [avalanche] Gate the activation of avalanche preconsensus on
 november 15

This will only activate if enabled and if the upgrade is activated. The same applies to mining with avalanche preconsensus which has its own flag.

Adapted from b558e165f24712be9a95503dd71b9bedee2c6fee (D18701). Preserve Doged false defaults and historical Shibusawa timing/override as optional coordination policy, using a purpose-named parameter rather than reintroducing eCash consensus upgrades. Retain current upstream finalized-UTXO safety requirement as an additional condition. Add explicit staking preconsensus boundary, disabled and null-tip checks.

diff --git a/src/avalanche/avalanche.h b/src/avalanche/avalanche.h
index b3ddb83246ff5d411711436c7ef41cc9439b04ec..5fd86db8b9bb1172f771ec50adb9aebaf99fb1f6 100644
--- a/src/avalanche/avalanche.h
+++ b/src/avalanche/avalanche.h
@@ -56,12 +56,12 @@ static constexpr double AVALANCHE_DEFAULT_MIN_AVAPROOFS_NODE_COUNT = 8;
 static constexpr bool DEFAULT_PERSIST_AVAPEERS{true};
 
 /** Default for -avalanchepreconsensus */
-static constexpr bool DEFAULT_AVALANCHE_PRECONSENSUS{true};
+static constexpr bool DEFAULT_AVALANCHE_PRECONSENSUS{false};
 
 /** Default for -avalanchestakingpreconsensus */
-static constexpr bool DEFAULT_AVALANCHE_STAKING_PRECONSENSUS{true};
+static constexpr bool DEFAULT_AVALANCHE_STAKING_PRECONSENSUS{false};
 
 /** Default for -avalanchepreconsensusmining */
-static constexpr bool DEFAULT_AVALANCHE_MINING_PRECONSENSUS{true};
+static constexpr bool DEFAULT_AVALANCHE_MINING_PRECONSENSUS{false};
 
 #endif // BITCOIN_AVALANCHE_AVALANCHE_H
diff --git a/src/avalanche/processor.cpp b/src/avalanche/processor.cpp
index 03086aaad4b39962253cdd802e5d9806566e9f8b..ad8ee28bfdd9bf3ee41bc390bc4a89595d16f8bb 100644
--- a/src/avalanche/processor.cpp
+++ b/src/avalanche/processor.cpp
@@ -1563,11 +1563,17 @@ bool Processor::GetLocalAcceptance::operator()(
 bool Processor::isPreconsensusActivated(const CBlockIndex *pprev) const {
     // Require at least one avalanche-finalized block so we rely on a finalized
     // utxo set.
-    return m_preConsensus && hasFinalizedTip();
+    return m_preConsensus && hasFinalizedTip() && pprev &&
+           pprev->GetMedianTimePast() >=
+               gArgs.GetIntArg("-shibusawaactivationtime",
+                   chainman.GetConsensus().avalanchePreconsensusActivationTime);
 }
 
 bool Processor::isStakingPreconsensusActivated(const CBlockIndex *pprev) const {
-    return m_stakingPreConsensus;
+    return m_stakingPreConsensus && pprev &&
+           pprev->GetMedianTimePast() >=
+               gArgs.GetIntArg("-shibusawaactivationtime",
+                   chainman.GetConsensus().avalanchePreconsensusActivationTime);
 }
 
 } // namespace avalanche
diff --git a/src/avalanche/test/processor_tests.cpp b/src/avalanche/test/processor_tests.cpp
index 5caefcefba6b496ae3ce1b48ebafcdf5453b6f54..33137a4ecc976cb55db2effa35b5723c3e868952 100644
--- a/src/avalanche/test/processor_tests.cpp
+++ b/src/avalanche/test/processor_tests.cpp
@@ -508,6 +508,21 @@ struct TxProvider {
 
 BOOST_FIXTURE_TEST_SUITE(processor_tests, AvalancheProcessorTestingSetup)
 
+BOOST_AUTO_TEST_CASE(dogecoin_optional_preconsensus_activation) {
+    CBlockIndex previous;
+    previous.nTime = 99;
+    gArgs.ForceSetArg("-shibusawaactivationtime", "100");
+    AvalancheTest::setStakingPreconsensus(*m_node.avalanche, true);
+    BOOST_CHECK(!m_node.avalanche->isStakingPreconsensusActivated(&previous));
+    previous.nTime = 100;
+    BOOST_CHECK(m_node.avalanche->isStakingPreconsensusActivated(&previous));
+    BOOST_CHECK(!m_node.avalanche->isStakingPreconsensusActivated(nullptr));
+    AvalancheTest::setStakingPreconsensus(*m_node.avalanche, false);
+    BOOST_CHECK(!m_node.avalanche->isStakingPreconsensusActivated(&previous));
+    gArgs.ClearForcedArg("-shibusawaactivationtime");
+}
+
+
 // FIXME A std::tuple can be used instead of boost::mpl::list after boost 1.67
 using VoteItemProviders = boost::mpl::list<BlockProvider, ProofProvider,
                                            StakeContenderProvider, TxProvider>;
