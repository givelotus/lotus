From dae5fa49511b26c582bcd7c92f63c7d508d1fa70 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:44:49 -0700
Subject: [PATCH] tests: keep mining scenario fee thresholds explicit

Maintenance rationale (2026-10-14):
Use the mining fee threshold assumed by the synthetic transaction fixture instead of inheriting the different production Dogecoin policy default. Preserve every inclusion and ordering assertion.

diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 4bf1376ef6469d63dba5a0089ddecbbf505a87fb..6e5f77366c581ef7667ad42db2201dbfaca15892 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -147,7 +147,9 @@ struct PreconsensusMinerTestingSetupNoCheckpoints
 
 BOOST_FIXTURE_TEST_SUITE(miner_tests, MinerTestingSetup)
 
-static CFeeRate blockMinFeeRate = CFeeRate(DEFAULT_BLOCK_MIN_TX_FEE_PER_KB);
+// The validity scenarios use explicit satoshi-scale fees. Keep their fee
+// boundary independent of Dogecoin's higher default mining fee policy.
+static CFeeRate blockMinFeeRate = CFeeRate(1000 * SATOSHI);
 
 BlockAssembler MinerTestingSetup::AssemblerForTest(const CChainParams &params) {
     BlockFitter::Options fitter_options;
