From 4d2019dc75f3d1bfbc5633a4b87922636fe9374d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:42 -0700
Subject: [PATCH] chronik: declare timer feature for standalone indexer tests

Current broadcast.rs imports tokio::time::timeout but the crate omits the time feature, relying on workspace feature unification. Declare its direct requirement so isolated indexer migration tests compile without unrelated HTTP crates.

diff --git a/chronik/chronik-indexer/Cargo.toml b/chronik/chronik-indexer/Cargo.toml
index 01de0747234a9347f242087c0e1772f58ca2c2fe..bf58273d4730f9488024e056478ceae057543434 100644
--- a/chronik/chronik-indexer/Cargo.toml
+++ b/chronik/chronik-indexer/Cargo.toml
@@ -48,7 +48,7 @@ hex-literal = "0.3"
 # Async runtime
 [dependencies.tokio]
 version = "1.25"
-features = ["sync", "rt", "rt-multi-thread", "macros"]
+features = ["sync", "rt", "rt-multi-thread", "macros", "time"]
 
 [dev-dependencies]
 # Colorful diffs for assertions
