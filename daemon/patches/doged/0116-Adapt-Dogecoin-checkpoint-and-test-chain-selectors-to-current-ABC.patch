From 42a38465a9f6a11f4ba86ef1eb095a9da16ca931 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:47 -0700
Subject: [PATCH] Adapt Dogecoin checkpoint and test chain selectors to current
 ABC

Use ChainType selectors and current logging semantics after replaying original network and SigOps changes; preserve checkpoint hashes and rejection codes.

diff --git a/src/networks/abc/checkpoints.cpp b/src/networks/abc/checkpoints.cpp
index 461e476c1b95778d2e7f09dd50df7c1e7cba83a2..1f65b8f30ea156e421b2039b0acfdd2e30982ecd 100644
--- a/src/networks/abc/checkpoints.cpp
+++ b/src/networks/abc/checkpoints.cpp
@@ -85,17 +85,17 @@ static CCheckpointData regTestCheckpointData = {
                                "36012afca590b1a11466e2206")},
     }};
 
-const CCheckpointData &CheckpointData(const std::string &chain) {
+const CCheckpointData &CheckpointData(const ChainType chain) {
     if (chain == ChainType::MAIN) {
         return mainNetCheckpointData;
     }
     if (chain == ChainType::TESTNET) {
         return testNetCheckpointData;
     }
-    if (chain == CBaseChainParams::REGTEST) {
+    if (chain == ChainType::REGTEST) {
         return regTestCheckpointData;
     }
 
     throw std::runtime_error(
-        strprintf("%s: Unknown chain %s.", __func__, chain));
+        strprintf("%s: Unknown chain %s.", __func__, ChainTypeToString(chain)));
 }
