From 3bd11ae32a49158acfbb337e0c81a5e88c4b89c4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:29:42 -0700
Subject: [PATCH] Preserve signed Dogecoin transaction versions and BIP68
 interpretation

Current ABC stores transaction versions unsigned after its version-range consensus rule. Dogecoin retains the signed legacy transaction and RPC/Chronik representation, including negative historical versions. Keep all four wire bytes unchanged and retain unsigned BIP68 comparisons, as Tobias original implementation does. Chronik bridge/protobuf adaptation is maintained separately.

diff --git a/src/consensus/tx_verify.cpp b/src/consensus/tx_verify.cpp
index e9d7f6510cecb81f668b494fc44563816a7d5919..076cdd151b7e5b565b57bfb6101b4299a129c274 100644
--- a/src/consensus/tx_verify.cpp
+++ b/src/consensus/tx_verify.cpp
@@ -115,7 +115,8 @@ std::pair<int, int64_t> CalculateSequenceLocks(const CTransaction &tx,
     int nMinHeight = -1;
     int64_t nMinTime = -1;
 
-    bool fEnforceBIP68 = tx.nVersion >= 2 && flags & LOCKTIME_VERIFY_SEQUENCE;
+    bool fEnforceBIP68 = static_cast<uint32_t>(tx.nVersion) >= 2 &&
+                         flags & LOCKTIME_VERIFY_SEQUENCE;
 
     // Do not enforce sequence numbers as a relative lock time
     // unless we have been instructed to
diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index 8da61fc4b92f386916f63ed7c9e57307e75cfed4..70d53060461325f734f550d367538a42dffa6f95 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -95,7 +95,7 @@ unsigned int CTransaction::GetTotalSize() const {
 
 std::string CTransaction::ToString() const {
     std::string str;
-    str += strprintf("CTransaction(txid=%s, ver=%u, vin.size=%u, vout.size=%u, "
+    str += strprintf("CTransaction(txid=%s, ver=%d, vin.size=%u, vout.size=%u, "
                      "nLockTime=%u)\n",
                      GetId().ToString().substr(0, 10), nVersion, vin.size(),
                      vout.size(), nLockTime);
diff --git a/src/primitives/transaction.h b/src/primitives/transaction.h
index 68d967f384d50bea94f29aaef20a8ff2387a9310..f05717d7af505a8137f6a554ae1219032b59637a 100644
--- a/src/primitives/transaction.h
+++ b/src/primitives/transaction.h
@@ -159,7 +159,7 @@ class CMutableTransaction;
 
 /**
  * Basic transaction serialization format:
- * - uint32_t nVersion
+ * - int32_t nVersion
  * - std::vector<CTxIn> vin
  * - std::vector<CTxOut> vout
  * - uint32_t nLockTime
@@ -192,11 +192,11 @@ inline void SerializeTransaction(const TxType &tx, Stream &s) {
 class CTransaction {
 public:
     // Default transaction version.
-    static constexpr uint32_t CURRENT_VERSION{2};
+    static constexpr int32_t CURRENT_VERSION{2};
 
     // Consensus: Valid min/max for nVersion, enforced as a consensus rule after
     // Wellington.
-    static constexpr uint32_t MIN_VERSION = 1, MAX_VERSION = 2;
+    static constexpr int32_t MIN_VERSION = 1, MAX_VERSION = 2;
 
     // The local variables are made const to prevent unintended modification
     // without updating the cached hash value. However, CTransaction is not
@@ -205,7 +205,7 @@ public:
     // structure, including the hash.
     const std::vector<CTxIn> vin;
     const std::vector<CTxOut> vout;
-    const uint32_t nVersion;
+    const int32_t nVersion;
     const uint32_t nLockTime;
 
 private:
@@ -275,7 +275,7 @@ class CMutableTransaction {
 public:
     std::vector<CTxIn> vin;
     std::vector<CTxOut> vout;
-    uint32_t nVersion;
+    int32_t nVersion;
     uint32_t nLockTime;
 
     CMutableTransaction();
diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index 6d243d5a02d5f9f8eccfbd41bba72d082f4f9cef..cf00bf5faf8a9ea1d293468197801b44f10e38fc 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -1759,7 +1759,7 @@ bool GenericTransactionSignatureChecker<T>::CheckSequence(
 
     // Fail if the transaction's version number is not set high enough to
     // trigger BIP 68 rules.
-    if (txTo->nVersion < 2) {
+    if (static_cast<uint32_t>(txTo->nVersion) < 2) {
         return false;
     }
 
