Maintenance rationale (2026-10-14):
Keep the upstream source-file exclusion pointing at the actual Qt project filename after renaming the executable; branding must not change which files are compiled.

diff --git a/contrib/CMakeLists.txt b/contrib/CMakeLists.txt
index 7621956ac8f6e08e956aca55e7cd525d9b636191..9ee8d5d3e1f1c5c01c619ae793d13fff67c5b7b5 100644
--- a/contrib/CMakeLists.txt
+++ b/contrib/CMakeLists.txt
@@ -20,7 +20,7 @@ exclude_from_source_package(
 	"zmq/"
 
 	# Files
-	"doge-qt.pro"
+	"bitcoin-qt.pro"
 	"README.md"
 	"valgrind.supp"
 )
