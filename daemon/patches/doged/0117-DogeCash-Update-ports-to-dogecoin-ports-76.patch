From 474285306d3f08ce1ed8d48eb7ddfcd378fed50d Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Fri, 22 Nov 2024 19:03:54 +0100
Subject: [PATCH] [DogeCash] Update ports to dogecoin ports (#76)

Use the RPC ports used by dogecoind, and also adjust the other ports (tor, chronik) to be adjacent.

dogecoind seems to have Tor support, but I wasn't able to figure out which port they use, so I just incremented the other highest port number.

Current-ABC adaptation (2026-10-14): Apply exact reference RPC, onion and Chronik HTTP ports to current ChainType switch; retain all upstream constructor fields and regtest ports. Configuration remains independently overridable.

Original-Commit: 2646a528303b58cd95d2ece97922b96d60e3ff59

diff --git a/src/chainparamsbase.cpp b/src/chainparamsbase.cpp
index 75412a45d20d1c8e08afee409ff931a1c94e0c5e..c553821f3b44f091fc8fbd95e542e289d8aa4344 100644
--- a/src/chainparamsbase.cpp
+++ b/src/chainparamsbase.cpp
@@ -36,21 +36,21 @@ const CBaseChainParams &BaseParams() {
 }
 
 /**
- * Port numbers for incoming Tor connections (8334, 18334, 38334, 18445) have
+ * Port numbers for incoming Tor connections (22557, 44557, 38334, 18445) have
  * been chosen arbitrarily to keep ranges of used ports tight.
  */
 std::unique_ptr<CBaseChainParams> CreateBaseChainParams(const ChainType chain) {
     switch (chain) {
         case ChainType::MAIN:
             return std::make_unique<CBaseChainParams>(
-                "", /*rpc_port=*/8332, 8334,
-                /*chronik_port=*/8331,
+                "", /*rpc_port=*/22555, 22557,
+                /*chronik_port=*/22554,
                 /*chronik_electrum_port=*/50002);
         case ChainType::TESTNET:
             return std::make_unique<CBaseChainParams>(
                 "testnet3",
-                /*rpc_port=*/18332, 18334,
-                /*chronik_port=*/18331,
+                /*rpc_port=*/44555, 44557,
+                /*chronik_port=*/44554,
                 /*chronik_electrum_port=*/60002);
         case ChainType::REGTEST:
             return std::make_unique<CBaseChainParams>(
