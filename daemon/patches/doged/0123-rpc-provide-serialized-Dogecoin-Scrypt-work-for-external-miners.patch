From 7eb993a541a24db23cce118c6fedc02b64cbcff1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:35:33 -0700
Subject: [PATCH] rpc: provide serialized Dogecoin Scrypt work for external
 miners

Adapt the Lotus getrawunsolvedblock payout-address interface without changing its blockhex and target result fields. Construct work with the Dogecoin assembler, modern chain ID and ordinary Scrypt proof of work; submitblock remains the existing full-block submission API. AuxPoW merged-mining work is a separate capability.

Allow disconnected regtest work, retaining connection and initial-download guards on public networks. Add a CPU Scrypt functional round trip covering payout, target, duplicate and invalid submissions and accepted stale side-chain work.

Provenance: interface adapted from Lotus patch 115; new Dogecoin integration and tests authored during the current-ABC port. Functional execution pending the integrated native build.

diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index c23cfbb3fc9e0914e6b0db9e8dc6cd9b0d68ea62..db9608a1a8fb89c2660ab093915a3bd089ed9868 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -1280,6 +1280,102 @@ static RPCHelpMan getblocktemplate() {
     };
 }
 
+static RPCHelpMan getrawunsolvedblock() {
+    return RPCHelpMan{
+        "getrawunsolvedblock",
+        "Get a serialized block candidate with coinbase sending to the "
+        "specified address. Solve the Scrypt proof of work and submit the complete "
+        "block with submitblock. This RPC produces ordinary Dogecoin proof of "
+        "work, not an AuxPoW merged-mining template.",
+        {
+            {"address", RPCArg::Type::STR, RPCArg::Optional::NO,
+             "The address to send the newly generated coins to."},
+        },
+        RPCResult{
+            RPCResult::Type::OBJ,
+            "",
+            "",
+            {
+                {RPCResult::Type::STR_HEX, "blockhex",
+                 "Serialized Dogecoin block, with an 80-byte Scrypt header."},
+                {RPCResult::Type::STR_HEX, "target", "The difficulty target."},
+            },
+        },
+        RPCExamples{"\nCreate an unsolved block to myaddress\n" +
+                    HelpExampleCli("getrawunsolvedblock", "\"myaddress\"") +
+                    "If you are running the Dogecoin wallet, you can get a new "
+                    "address to send the newly generated coins to with:\n" +
+                    HelpExampleCli("getnewaddress", "")},
+        [&](const RPCHelpMan &self, const Config &config,
+            const JSONRPCRequest &request) -> UniValue {
+            CTxDestination destination = DecodeDestination(
+                request.params[0].get_str(), config.GetChainParams());
+            if (!IsValidDestination(destination)) {
+                throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY,
+                                   "Error: Invalid address");
+            }
+
+            const CChainParams &chainparams = config.GetChainParams();
+
+            NodeContext &node = EnsureAnyNodeContext(request.context);
+            const CConnman &connman = EnsureConnman(node);
+            if (!chainparams.MineBlocksOnDemand() &&
+                connman.GetNodeCount(ConnectionDirection::Both) == 0) {
+                throw JSONRPCError(RPC_CLIENT_NOT_CONNECTED,
+                                   "Node is not connected!");
+            }
+
+            ChainstateManager &chainman = EnsureChainman(node);
+            if (!chainparams.MineBlocksOnDemand() &&
+                chainman.IsInitialBlockDownload()) {
+                throw JSONRPCError(
+                    RPC_CLIENT_IN_INITIAL_DOWNLOAD, PACKAGE_NAME
+                    " is in initial sync and waiting for blocks...");
+            }
+
+            LOCK(cs_main);
+            const CTxMemPool &mempool = EnsureMemPool(node);
+            Chainstate &active_chainstate = chainman.ActiveChainstate();
+            CChain &active_chain = active_chainstate.m_chain;
+
+            // Store the pindexBest used before CreateNewBlock, to avoid races
+            CBlockIndex *pindexPrevNew = active_chain.Tip();
+
+            // Create new block with provided coinbase output script.
+            CScript coinbase_script = GetScriptForDestination(destination);
+            std::unique_ptr<CBlockTemplate> pblocktemplate =
+                BlockAssembler{config, active_chainstate, &mempool,
+                               node.avalanche.get()}
+                    .CreateNewBlock(coinbase_script);
+            if (!pblocktemplate) {
+                throw JSONRPCError(RPC_OUT_OF_MEMORY, "Out of memory");
+            }
+
+            // Need to update only after we know CreateNewBlock succeeded
+            CHECK_NONFATAL(pindexPrevNew);
+
+            // pointer for convenience
+            CBlock *pblock = &pblocktemplate->block;
+            // Update nTime (can update nBits on testnet)
+            int64_t adjustedTime =
+                TicksSinceEpoch<std::chrono::seconds>(GetAdjustedTime());
+            UpdateTime(pblock, chainparams, pindexPrevNew, adjustedTime);
+            pblock->nNonce = 0;
+            // Update merkle root so mining software need not touch it.
+            pblock->hashMerkleRoot = BlockMerkleRoot(*pblock);
+
+            DataStream ssBlock{};
+            ssBlock << *pblock;
+            arith_uint256 hashTarget =
+                arith_uint256().SetCompact(pblock->nBits);
+            UniValue result(UniValue::VOBJ);
+            result.pushKV("blockhex", HexStr(ssBlock));
+            result.pushKV("target", hashTarget.GetHex());
+            return result;
+        },
+    };
+}
+
 class submitblock_StateCatcher final : public CValidationInterface {
 public:
     uint256 hash;
@@ -1451,6 +1547,7 @@ void RegisterMiningRPCCommands(CRPCTable &t) {
         {"mining",      getmininginfo,         },
         {"mining",      prioritisetransaction, },
         {"mining",      getblocktemplate,      },
+        {"mining",      getrawunsolvedblock,   },
         {"mining",      submitblock,           },
         {"mining",      submitheader,          },
 
diff --git a/test/functional/dogecoin_raw_mining.py b/test/functional/dogecoin_raw_mining.py
new file mode 100644
index 0000000000000000000000000000000000000000..3928e785431eced05ef9b6e225bed8bf53eeb04a
--- /dev/null
+++ b/test/functional/dogecoin_raw_mining.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Exercise the raw work RPC with ordinary Scrypt Dogecoin proof of work."""
+
+from copy import deepcopy
+from io import BytesIO
+
+from test_framework.address import byte_to_base58
+from test_framework.messages import CBlock, VERSION_AUXPOW_BIT, uint256_from_compact
+from test_framework.script import CScript, OP_CHECKSIG, OP_DUP, OP_EQUALVERIFY, OP_HASH160
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error
+
+
+class DogecoinRawMiningTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.setup_clean_chain = True
+        self.num_nodes = 1
+        self.extra_args = [["-avalanche=0"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        pubkey_hash = bytes.fromhex("1234567890abcdef1234567890abcdef12345678")
+        address = byte_to_base58(pubkey_hash, 111)
+        payout = CScript([OP_DUP, OP_HASH160, pubkey_hash, OP_EQUALVERIFY, OP_CHECKSIG])
+        assert_raises_rpc_error(-5, "Invalid address", node.getrawunsolvedblock, "invalid")
+
+        def work():
+            response = node.getrawunsolvedblock(address)
+            assert_equal(set(response), {"blockhex", "target"})
+            block = CBlock()
+            block.deserialize(BytesIO(bytes.fromhex(response["blockhex"])))
+            assert_equal(block.serialize().hex(), response["blockhex"])
+            assert_equal(int(response["target"], 16), uint256_from_compact(block.nBits))
+            assert_equal(block.nVersion >> 16, 0x62)
+            assert_equal(block.nVersion & VERSION_AUXPOW_BIT, 0)
+            assert_equal(block.auxpow, None)
+            assert_equal(block.hashMerkleRoot, block.calc_merkle_root())
+            assert_equal(block.vtx[0].vout[0].scriptPubKey, payout)
+            return block
+
+        block = work()
+        invalid = deepcopy(block)
+        target = uint256_from_compact(invalid.nBits)
+        invalid.rehashPow()
+        while invalid.powHash <= target:
+            invalid.nNonce += 1
+            invalid.rehashPow()
+        assert_equal(node.submitblock(invalid.serialize().hex()), "high-hash")
+        assert_equal(node.getblockcount(), 0)
+
+        # Save a competing height-one block. submitblock accepts valid side-chain
+        # work; it does not promise every accepted solution becomes the best tip.
+        stale = deepcopy(block)
+        stale.nTime += 1
+        stale.solve()
+        block.solve()
+        assert_equal(node.submitblock(block.serialize().hex()), None)
+        block.rehash()
+        assert_equal(node.getbestblockhash(), block.hash)
+        assert_equal(node.getblockcount(), 1)
+        assert_equal(node.submitblock(block.serialize().hex()), "duplicate")
+        next_block = work()
+        assert_equal(next_block.hashPrevBlock, int(block.hash, 16))
+        next_block.solve()
+        assert_equal(node.submitblock(next_block.serialize().hex()), None)
+        tip = node.getbestblockhash()
+        assert_equal(node.submitblock(stale.serialize().hex()), None)
+        assert_equal(node.getbestblockhash(), tip)
+        assert_equal(node.getblockcount(), 2)
+        decoded = node.getblock(block.hash, 2)
+        assert_equal(decoded["height"], 1)
+        assert_equal(decoded["tx"][0]["vout"][0]["scriptPubKey"]["hex"], payout.hex())
+
+
+if __name__ == "__main__":
+    DogecoinRawMiningTest().main()
