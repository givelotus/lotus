From 44c65e537da4c9bf739773c9da5e7917e21db02c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:48:18 -0700
Subject: [PATCH] test: exercise Dogecoin AuxPoW activation through header and
 block RPCs

Reject valid early AuxPoW at regtest height 19 and legacy versions 1/2 at height 20. Accept legacy version 2 before activation, valid AuxPoW at activation and ordinary modern Scrypt afterward through both submitheader and submitblock.

Correct raw mining stale-side-branch expectation to the standard inconclusive submitblock response and verify the stored side-chain block. Both functional scripts pass against the integrated Chronik-enabled native doged build on 2026-10-14.

diff --git a/test/functional/dogecoin_activation.py b/test/functional/dogecoin_activation.py
new file mode 100644
index 0000000000000000000000000000000000000000..1cf88cedff98a528d8a7847244de9b9309afbfeb
--- /dev/null
+++ b/test/functional/dogecoin_activation.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Check full-block and header AuxPoW activation boundaries on regtest."""
+from copy import deepcopy
+from io import BytesIO
+
+from test_framework.address import byte_to_base58
+from test_framework.messages import (
+    CAuxPow, CBlock, CBlockHeader, COutPoint, CTxIn, MERGE_MINE_PREFIX,
+    VERSION_AUXPOW_BIT,
+)
+from test_framework.script import CScript
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error
+
+
+class DogecoinActivationTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.setup_clean_chain = True
+        self.num_nodes = 1
+        self.extra_args = [["-avalanche=0"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        address = byte_to_base58(bytes(20), 111)
+
+        def work():
+            block = CBlock()
+            block.deserialize(BytesIO(bytes.fromhex(node.getrawunsolvedblock(address)["blockhex"])))
+            return block
+
+        def auxpow(block):
+            block.nVersion |= VERSION_AUXPOW_BIT
+            block.auxpow = CAuxPow()
+            script = CScript(MERGE_MINE_PREFIX + bytes.fromhex(block.hash_hex) + b"\x01\0\0\0\0\0\0\0")
+            block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), script)]
+            block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
+            block.solve()
+            return block
+
+        def accept(block):
+            block.solve()
+            assert_equal(node.submitheader(CBlockHeader(block).serialize().hex()), None)
+            assert_equal(node.submitblock(block.serialize().hex()), None)
+            assert_equal(node.getbestblockhash(), block.hash_hex)
+
+        def reject(block, reason):
+            block.solve()
+            assert_raises_rpc_error(-25, reason, node.submitheader, CBlockHeader(block).serialize().hex())
+            assert_equal(node.submitblock(block.serialize().hex()), reason)
+
+        while node.getblockcount() < 18:
+            accept(work())
+
+        # Height 19 is the final pre-activation height. An otherwise valid
+        # merged-mined block is rejected, and legacy version 2 still works.
+        candidate = work()
+        reject(auxpow(deepcopy(candidate)), "early-auxpow-block")
+        candidate.nVersion = 2
+        accept(candidate)
+        assert_equal(node.getblockcount(), 19)
+
+        # Height 20 rejects both legacy versions, accepts a valid AuxPoW,
+        # and height 21 continues accepting ordinary modern Scrypt work.
+        candidate = work()
+        for version in (1, 2):
+            legacy = deepcopy(candidate)
+            legacy.nVersion = version
+            reject(legacy, "late-legacy-block")
+        accept(auxpow(candidate))
+        accept(work())
+        assert_equal(node.getblockcount(), 21)
+
+
+if __name__ == "__main__":
+    DogecoinActivationTest().main()
