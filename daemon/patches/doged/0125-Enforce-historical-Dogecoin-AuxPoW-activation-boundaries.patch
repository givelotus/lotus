index a7cc49143d4a7977a0d33c1a5295b787da39a1ac..67eb55ae5e0fd8b1402c71572538f37b8d11fe56 100644
--- a/src/pow/auxpow.cpp
+++ b/src/pow/auxpow.cpp
@@ -3,6 +3,7 @@
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
 #include <consensus/params.h>
+#include <consensus/validation.h>
 #include <logging.h>
 #include <pow/pow.h>
 #include <primitives/auxpow.h>
@@ -60,3 +61,19 @@ bool CheckAuxProofOfWork(const CBlockHeader &block,
 
     return true;
 }
+
+// Dogecoin Core rejects early AuxPoW and late legacy version 1/2 headers.
+// Modern chain-ID Scrypt-only headers remain valid on both sides of activation.
+bool CheckAuxPowActivation(const CBlockHeader &block, int height,
+                           const Consensus::Params &params,
+                           BlockValidationState &state) {
+    if (height >= params.auxpowStartHeight && VersionIsLegacy(block.nVersion)) {
+        return state.Invalid(BlockValidationResult::BLOCK_INVALID_HEADER,
+                             "late-legacy-block", "legacy block after AuxPoW activation");
+    }
+    if (height < params.auxpowStartHeight && VersionHasAuxPow(block.nVersion)) {
+        return state.Invalid(BlockValidationResult::BLOCK_INVALID_HEADER,
+                             "early-auxpow-block", "AuxPoW block before activation");
+    }
+    return true;
+}
