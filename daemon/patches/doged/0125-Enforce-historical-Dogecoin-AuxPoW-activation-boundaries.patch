diff --git a/src/test/dogecoin_block_version_tests.cpp b/src/test/dogecoin_block_version_tests.cpp
index 578e4c25103b73952b6b74980a3075fdf972b6b0..114c2fade5dbc589b9413f61716f59cd2385d4eb 100644
--- a/src/test/dogecoin_block_version_tests.cpp
+++ b/src/test/dogecoin_block_version_tests.cpp
@@ -3,6 +3,7 @@
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
 #include <pow/auxpow.h>
+#include <consensus/validation.h>
 #include <pow/pow.h>
 #include <primitives/auxpow.h>
 
@@ -170,4 +171,29 @@ BOOST_AUTO_TEST_CASE(CheckAuxProofOfWork_nVersion_test) {
     }
 }
 
+
+BOOST_AUTO_TEST_CASE(auxpow_activation_boundaries) {
+    for (const auto chain : {ChainType::MAIN, ChainType::TESTNET, ChainType::REGTEST}) {
+        const auto params = CreateChainParams(*m_node.args, chain);
+        const auto &consensus = params->GetConsensus();
+        const int activation = consensus.auxpowStartHeight;
+        BOOST_CHECK_EQUAL(activation, chain == ChainType::MAIN ? 371337 :
+                                     chain == ChainType::TESTNET ? 158100 : 20);
+        for (const int height : {activation - 1, activation, activation + 1}) {
+            for (const int version : {1, 2, 0x620003, 0x620103}) {
+                CBlockHeader header;
+                header.nVersion = version;
+                BlockValidationState state;
+                const bool expected = version == 0x620003 ||
+                    (version == 0x620103 ? height >= activation : height < activation);
+                BOOST_CHECK_EQUAL(CheckAuxPowActivation(header, height, consensus, state), expected);
+                if (!expected) {
+                    BOOST_CHECK_EQUAL(state.GetRejectReason(), version == 0x620103 ?
+                                      "early-auxpow-block" : "late-legacy-block");
+                }
+            }
+        }
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
