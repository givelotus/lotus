From f535bcbfba95b4e4f7292d0afd0f2b42a87a8831 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:36:56 -0700
Subject: [PATCH] Enforce historical Dogecoin AuxPoW activation boundaries

Repair an inherited pinned-Doged omission: CheckAuxProofOfWork claimed contextual validation rejected late legacy headers, but no activation check existed. Match Dogecoin Core 47a303a449999314abcf83bd1fc7e77dd4540fcd src/chainparams.cpp and src/validation.cpp: mainnet 371337, testnet 158100, regtest 20. Reject early AuxPoW and late version 1/2 while retaining ordinary modern chain-ID Scrypt mining. Boundary tests cover all networks and versions before/at/after activation. Source: https://github.com/dogecoin/dogecoin/tree/47a303a449999314abcf83bd1fc7e77dd4540fcd/src

diff --git a/src/consensus/params.h b/src/consensus/params.h
index 9cae60a85ba8fd0f57ae948e9d90338562839ee5..11f3c1eb4d14d12b498432f018a0d6fda3454e96 100644
--- a/src/consensus/params.h
+++ b/src/consensus/params.h
@@ -101,6 +101,8 @@ struct Params {
 
     /** Enforce Dogecoin chain ID for AuxPoW headers. */
     bool enforceStrictAuxPowChainId;
+    /** Height at which AuxPoW becomes permitted and legacy versions forbidden. */
+    int32_t auxpowStartHeight;
     /** Whether to enforce the old legacy Script rules. */
     bool enforceLegacyScriptRules;
 
diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 64714d1185b987808c39ab423122b1bca3e664a4..74e900f47c2fc4c1b24015bb79fa13e9562d0638 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -104,6 +104,7 @@ public:
 
         // Enforce strict chain ID on mainnet
         consensus.enforceStrictAuxPowChainId = true;
+        consensus.auxpowStartHeight = 371337;
 
         // The miner fund is disabled by default on Dogecoin mainnet.
         consensus.enableMinerFund = false;
@@ -247,6 +248,7 @@ public:
 
         // Testnet has no strict chain ID
         consensus.enforceStrictAuxPowChainId = false;
+        consensus.auxpowStartHeight = 158100;
 
         // The miner fund is disabled by default on testnet.
         consensus.enableMinerFund = false;
@@ -372,6 +374,7 @@ public:
 
         // Enforce strict chain ID on regtest
         consensus.enforceStrictAuxPowChainId = true;
+        consensus.auxpowStartHeight = 20;
 
         // The miner fund is disabled by default on regtest.
         consensus.enableMinerFund = false;
