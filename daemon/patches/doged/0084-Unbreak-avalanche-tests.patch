index b788c7748e34c28e53cf2c9941808a6e0b565482..9a2b07aed631b318ce440d51043935fc5b90a1a0 100644
--- a/src/avalanche/proof.cpp
+++ b/src/avalanche/proof.cpp
@@ -94,15 +94,13 @@ void Proof::computeScore() {
     score = amountToScore(getStakedAmount());
 }
 
-uint32_t Proof::amountToScore(Amount amount) {
+Score Proof::amountToScore(Amount amount) {
     amount = MoneyClamp(amount);
-    // After clamping, (100 * amount) is guaranteed not to overflow int64_t,
-    // and the resulting score fits in uint32_t.
-    static_assert(MAX_MONEY <=
-                  (std::numeric_limits<int64_t>::max() / 100) * SATOSHI);
-    static_assert((100 * MAX_MONEY) / COIN <=
-                  std::numeric_limits<uint32_t>::max());
-    return (100 * amount) / COIN;
+    // One score unit is exactly one hundredth of a coin. Multiplication
+    // before division can overflow even uint64_t for valid Dogecoin amounts.
+    static_assert((COIN / SATOSHI) % 100 == 0);
+    static_assert(MAX_MONEY / (COIN / 100) <= std::numeric_limits<Score>::max());
+    return amount / (COIN / 100);
 }
 
 Amount Proof::getStakedAmount() const {
