From e1f17048024f207bccd4c9c1f9760c6cd142b9f0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] net: add NODE_UTXO_SHARD capability, 50-block undo horizon,
 forward peel script verification, and batch shorttx relay

Add NODE_UTXO_SHARD service bit routing, enforce a 50-block finality undo horizon,
verify scripts during forward peel validation, and batch shorttx P2P relay.

diff --git a/src/node/snapshot.cpp b/src/node/snapshot.cpp
index c575ec06299c59bba1a2c10d00cb858fcc6b3993..5cfcbd2d4a561b761711bd545877e720fcd9c3d2 100644
--- a/src/node/snapshot.cpp
+++ b/src/node/snapshot.cpp
@@ -326,30 +326,7 @@ void PopulateMempoolVectorsLocked(ChainAndMempoolSnapshot &snap,
             }
         }
 
-        MempoolEntrySnapshot entry_snap{};
-        entry_snap.txid = txid;
-        entry_snap.tx = e->GetSharedTx();
-        entry_snap.fee = e->GetFee();
-        entry_snap.modified_fee = e->GetModifiedFee();
-        entry_snap.tx_size = e->GetTxSize();
-        entry_snap.time = count_seconds(e->GetTime());
-        entry_snap.height = static_cast<int>(e->GetHeight());
-
-        if (!parents.empty()) {
-            std::set<std::string> set_depends;
-            for (const auto &parent : parents) {
-                set_depends.insert(parent.get()->GetTx().GetId().ToString());
-            }
-            entry_snap.depends.assign(set_depends.begin(), set_depends.end());
-        }
-
-        entry_snap.spentby.reserve(children.size());
-        for (const auto &child : children) {
-            entry_snap.spentby.push_back(
-                child.get()->GetTx().GetId().ToString());
-        }
-        entry_snap.unbroadcast = mempool.IsUnbroadcastTx(entry_snap.txid);
-        snap.mempool_entries.push_back(std::move(entry_snap));
+        snap.mempool_entries.push_back(MakeMempoolEntrySnapshot(*e, mempool));
     }
     std::sort(snap.mempool_entries.begin(), snap.mempool_entries.end(),
               [](const MempoolEntrySnapshot &a,
@@ -843,8 +820,7 @@ void PublishChainTipSnapshot(ChainstateManager &chainman,
     AssertLockHeld(::cs_main);
     SnapshotPublisher &publisher = GetGlobalSnapshotPublisher();
     auto prev = publisher.Load();
-    auto next = prev ? std::make_shared<ChainAndMempoolSnapshot>(*prev)
-                     : std::make_shared<ChainAndMempoolSnapshot>();
+    auto next = CloneChainStateOnly(prev.get());
 
     Chainstate &active_chainstate = chainman.ActiveChainstate();
     const CBlockIndex *tip = active_chainstate.m_chain.Tip();
@@ -970,8 +946,7 @@ void PublishMempoolSnapshot(const CTxMemPool &mempool)
     }
     SnapshotPublisher &publisher = GetGlobalSnapshotPublisher();
     auto prev = publisher.Load();
-    auto next = prev ? std::make_shared<ChainAndMempoolSnapshot>(*prev)
-                     : std::make_shared<ChainAndMempoolSnapshot>();
+    auto next = CloneChainStateOnly(prev.get());
 
     PopulateMempoolScalarsLocked(*next, mempool);
     next->mempool_vectors_ready = false;
