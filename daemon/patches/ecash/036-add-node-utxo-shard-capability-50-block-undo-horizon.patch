             m_pool.m_snapshot_dirty = false;
             if (m_flush_on_exit) {
@@ -964,6 +965,7 @@ void CTxMemPool::PrioritiseTransaction(const TxId &txid,
             });
             ++nTransactionsUpdated;
         }
+        ++m_snapshot_reset_seq;
         node::PublishMempoolSnapshot(*this);
     }
     LogPrintf("PrioritiseTransaction: %s fee += %s\n", txid.ToString(),
@@ -983,6 +985,7 @@ void CTxMemPool::ApplyDelta(const TxId &txid, Amount &nFeeDelta) const {
 void CTxMemPool::ClearPrioritisation(const TxId &txid) {
     AssertLockHeld(cs);
     if (mapDeltas.erase(txid) > 0) {
+        ++m_snapshot_reset_seq;
         node::PublishMempoolSnapshot(*this);
     }
 }
