From 5f173e591857e7361408d7b016951dfaf3b5a51e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 11:41:14 -0700
Subject: [PATCH] [test] Verify unchecked long-chain mempool graph bookkeeping

Repair the unavailable SigOpCount helper call with SigChecks and describe the actual API scope. Insert a 100-transaction chain directly through addUnchecked; assert parent/child links, parent-before-child entry IDs, complete ancestor/descendant traversal, and recursive midpoint removal without damaging the retained prefix.

The fixture bypasses admission and changes no policy or consensus code. It is not removal of ancestor/descendant limits and does not prove relay or mining acceptance. Keep the historical filename for repository continuity, with an accurate subject and explanation.

Place the test next to existing finalized-container tests rather than appending at end of file, so the independent finalized-ancestor optimization can apply before or after this patch without a textual conflict. Test with native mempool_tests alone and with the independent mining/finalization candidates.
---
 src/test/mempool_tests.cpp | 64 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index 8c7f094d90..90e8a6b2ab 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -583,6 +583,70 @@ BOOST_AUTO_TEST_CASE(CompareTxMemPoolEntryByModifiedFeeRateTest) {
     checkOrdering(entryB, entryA);
 }
 
+BOOST_AUTO_TEST_CASE(unchecked_long_chain_parent_graph) {
+    // This exercises the unchecked container API and graph bookkeeping only.
+    // It does not exercise admission, relay, consensus, or chain-limit policy.
+    CTxMemPool &pool = *Assert(m_node.mempool);
+    TestMemPoolEntryHelper helper;
+    LOCK2(cs_main, pool.cs);
+
+    std::vector<CTxMemPoolEntryRef> chain;
+    TxId prevId{FastRandomContext().rand256()};
+    for (int64_t i = 0; i < 100; ++i) {
+        CMutableTransaction tx;
+        tx.vin.emplace_back(COutPoint(prevId, 0), CScript());
+        tx.vout.emplace_back((199000 - i * 1000) * SATOSHI,
+                             CScript() << OP_TRUE);
+        auto entry = helper.Fee(1000 * SATOSHI).SigChecks(0).FromTx(tx);
+        pool.addUnchecked(entry);
+        BOOST_REQUIRE(pool.exists(tx.GetId()));
+        const auto &parents = entry->GetMemPoolParentsConst();
+        if (chain.empty()) {
+            BOOST_CHECK(parents.empty());
+        } else {
+            BOOST_REQUIRE_EQUAL(parents.size(), 1U);
+            BOOST_CHECK(parents.begin()->get() == chain.back().get());
+            BOOST_CHECK_LT(chain.back()->GetEntryId(), entry->GetEntryId());
+        }
+        prevId = tx.GetId();
+        chain.push_back(entry);
+    }
+    BOOST_CHECK_EQUAL(pool.size(), chain.size());
+    for (size_t i = 0; i < chain.size(); ++i) {
+        const auto &children = chain[i]->GetMemPoolChildrenConst();
+        if (i + 1 == chain.size()) {
+            BOOST_CHECK(children.empty());
+        } else {
+            BOOST_REQUIRE_EQUAL(children.size(), 1U);
+            BOOST_CHECK(children.begin()->get() == chain[i + 1].get());
+        }
+    }
+
+    CTxMemPool::setEntries ancestors;
+    pool.CalculateMemPoolAncestors(chain.back(), ancestors,
+                                   /*fSearchForParents=*/false);
+    BOOST_CHECK_EQUAL(ancestors.size(), 99U);
+    for (size_t i = 0; i + 1 < chain.size(); ++i) {
+        BOOST_CHECK(ancestors.count(*Assert(pool.GetIter(chain[i]->GetTx().GetId()))));
+    }
+    CTxMemPool::setEntries descendants;
+    pool.CalculateDescendants(*Assert(pool.GetIter(chain.front()->GetTx().GetId())),
+                               descendants);
+    BOOST_CHECK_EQUAL(descendants.size(), 100U);
+    for (const auto &entry : chain) {
+        BOOST_CHECK(descendants.count(*Assert(pool.GetIter(entry->GetTx().GetId()))));
+    }
+
+    // Removing the midpoint must remove all of its descendants, repair the
+    // retained parent's links, and keep the unrelated prefix intact.
+    pool.removeRecursive(chain[49]->GetTx(), MemPoolRemovalReason::EXPIRY);
+    BOOST_CHECK_EQUAL(pool.size(), 49U);
+    BOOST_CHECK(chain[48]->GetMemPoolChildrenConst().empty());
+    for (size_t i = 0; i < chain.size(); ++i) {
+        BOOST_CHECK_EQUAL(pool.exists(chain[i]->GetTx().GetId()), i < 49);
+    }
+}
+
