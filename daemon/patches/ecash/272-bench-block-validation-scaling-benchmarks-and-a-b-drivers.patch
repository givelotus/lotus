@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Interleaved A/B runs of bench_bitcoin microbenchmarks.
+
+Each round runs every arm once, in order (A B A B ...), with the same
+filter, and records each benchmark's median time per unit (ns) from
+nanobench's JSON output. The table gives, per benchmark and arm, the
+median over rounds and the range [min-max] of the rounds' values, plus
+the ratio of each arm's median to the first arm's.
+
+Example:
+  ab_microbench.py --arm base=../base/build --arm patched=build \\
+      --filter 'BlockMerkleRoot_.*' --rounds 7 --out merkle.json
+"""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import abstats  # noqa: E402
+
+BENCH_CANDIDATES = [
+    "src/bench/bitcoin-bench",
+    "src/bench/bench_bitcoin",
+    "bin/bench_bitcoin",
+]
+
+
+def run_once(binary, extra, filt, min_time):
+    with tempfile.TemporaryDirectory() as tmp:
+        out = os.path.join(tmp, "out.json")
+        cmd = [
+            binary,
+            f"-filter={filt}",
+            f"-min_time={min_time}",
+            f"-output_json={out}",
+        ] + extra
+        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
+        with open(out, encoding="utf8") as f:
+            data = json.load(f)
+    res = {}
+    for r in data["results"]:
+        batch = r.get("batch", 1) or 1
+        res[r["name"]] = r["median(elapsed)"] / batch * 1e9
+    return res
+
+
+def main():
+    p = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    p.add_argument(
+        "--arm",
+        action="append",
+        required=True,
+        help="NAME=BUILD_DIR_OR_BINARY [extra bench args]; "
+        "the first arm is the baseline",
+    )
+    p.add_argument("--filter", required=True, help="bench_bitcoin -filter regex")
+    p.add_argument("--rounds", type=int, default=5)
+    p.add_argument(
+        "--min-time",
+        type=int,
+        default=200,
+        help="bench_bitcoin -min_time per benchmark (ms)",
+    )
+    p.add_argument("--out", help="write raw samples and summary as JSON")
+    args = p.parse_args()
+
+    arms = []
+    for spec in args.arm:
+        name, path, extra = abstats.parse_arm(spec)
+        arms.append((name, abstats.find_binary(path, BENCH_CANDIDATES), extra))
+
+    samples = {}
+    for rnd in range(args.rounds):
+        for name, binary, extra in arms:
+            res = run_once(binary, extra, args.filter, args.min_time)
+            for bench, ns in res.items():
+                samples.setdefault(bench, {a[0]: [] for a in arms})[name].append(ns)
+            print(
+                f"round {rnd + 1}/{args.rounds} {name}: "
+                + ", ".join(f"{k}={v:.1f}" for k, v in sorted(res.items())),
+                file=sys.stderr,
+            )
+
+    rows = abstats.summarize(samples)
+    names = [a[0] for a in arms]
+    print(abstats.render_table(rows, names, "ns/unit"))
+    if args.out:
+        abstats.write_results(
+            args.out,
+            {
+                "arms": [{"name": n, "binary": b, "args": e} for n, b, e in arms],
+                "filter": args.filter,
+                "rounds": args.rounds,
+                "min_time_ms": args.min_time,
+                "unit": "ns per unit",
+                "rows": rows,
+            },
+        )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/contrib/bench/block-validation/abstats.py b/contrib/bench/block-validation/abstats.py
new file mode 100755
index 0000000000000000000000000000000000000000..4fb6b9a6fdb752fdee6ce5138e4bb421d258b3c2
--- /dev/null
+++ b/contrib/bench/block-validation/abstats.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Shared helpers for the interleaved A/B drivers in this directory."""
+
+import json
+import os
+import statistics
+
+
+def find_binary(path, candidates):
+    """path is a binary, or a build directory searched for candidates."""
+    if os.path.isfile(path) and os.access(path, os.X_OK):
+        return os.path.abspath(path)
+    for rel in candidates:
+        p = os.path.join(path, rel)
+        if os.path.isfile(p) and os.access(p, os.X_OK):
+            return os.path.abspath(p)
+    raise SystemExit(f"no executable found at {path} (tried {candidates})")
+
+
+def parse_arm(spec):
+    """NAME=PATH [extra args...] -> (name, path, [args])"""
+    if "=" not in spec:
+        raise SystemExit(f"--arm wants NAME=PATH [args], got {spec!r}")
+    name, rest = spec.split("=", 1)
+    parts = rest.split()
+    return name, parts[0], parts[1:]
+
+
+def summarize(samples):
+    """samples: {metric: {arm: [values per round]}} -> rows"""
+    rows = []
+    for metric in sorted(samples):
+        by_arm = samples[metric]
+        row = {"metric": metric, "arms": {}}
+        for arm, values in by_arm.items():
+            if not values:
+                continue
+            row["arms"][arm] = {
+                "n": len(values),
+                "median": statistics.median(values),
+                "min": min(values),
+                "max": max(values),
+                "values": values,
+            }
+        rows.append(row)
+    return rows
+
+
+def render_table(rows, arms, unit, baseline=None):
+    """Markdown table: median [min-max] per arm, and median ratio to the
+    baseline arm (the first arm unless given)."""
+    baseline = baseline or arms[0]
+    head = ["metric"] + [f"{a} median [min-max] ({unit})" for a in arms]
+    head += [f"{a}/{baseline}" for a in arms if a != baseline]
+    out = ["| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
+    for row in rows:
+        cells = [row["metric"]]
+        for a in arms:
+            s = row["arms"].get(a)
+            cells.append(
+                "-"
+                if s is None
+                else f"{s['median']:.4g} [{s['min']:.4g}-{s['max']:.4g}] n={s['n']}"
+            )
+        base = row["arms"].get(baseline)
+        for a in arms:
+            if a == baseline:
+                continue
+            s = row["arms"].get(a)
+            if s is None or base is None or base["median"] == 0:
+                cells.append("-")
+            else:
+                cells.append(f"{s['median'] / base['median']:.3f}")
+        out.append("| " + " | ".join(cells) + " |")
+    return "\n".join(out)
+
+
+def write_results(path, payload):
+    with open(path, "w", encoding="utf8") as f:
+        json.dump(payload, f, indent=1, sort_keys=True)
+        f.write("\n")
