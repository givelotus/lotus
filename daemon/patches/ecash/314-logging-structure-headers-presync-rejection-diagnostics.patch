 #include <index/blockfilterindex.h>
 #include <interfaces/chain.h>
 #include <logging.h>
@@ -15,9 +16,11 @@
 #include <node/ui_interface.h>
 #include <node/utxo_snapshot.h>
 #include <noui.h>
+#include <pow/pow.h>
 #include <primitives/transaction.h>
 #include <streams.h>
