From 023def066960ca30043d78781f968650da64640d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:05:45 -0700
Subject: [PATCH] logging: structure headers presync rejection diagnostics

Keep the existing Info messages, peer IDs, next heights and failure paths
for invalid target transitions and exceeded commitment bounds. Reuse the
signed peer/height registry fields; no protocol or consensus change.

A native test invokes actual HeadersSyncState rejection paths and checks
terminal state, typed numeric fields, Info severity and exact old readable
text. The bounded-commitment case uses at most610 synthetic headers and
an artificial starting tip at the future-time bound, independent of the
random commitment offset. This is not consensus-valid PoW test data.

Scripted diff (ast-grep-py==0.51.0; from the commit's parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/headers-presync-rejections.json --apply

git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/headerssync.cpp src/test/logging_event_tests.cpp

Handwritten: focused native rejection fixture and its explicit includes.
---
 .../rules/headers-presync-rejections.json     | 50 +++++++++++++
 src/headerssync.cpp                           | 16 ++--
 src/test/logging_event_tests.cpp              | 74 +++++++++++++++++++
 3 files changed, 134 insertions(+), 6 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/headers-presync-rejections.json

diff --git a/contrib/logging/conversion/rules/headers-presync-rejections.json b/contrib/logging/conversion/rules/headers-presync-rejections.json
new file mode 100644
index 0000000000000000000000000000000000000000..f3383b3013cb0cfd805f0624a1156b6bc7bc5427
--- /dev/null
+++ b/contrib/logging/conversion/rules/headers-presync-rejections.json
@@ -0,0 +1,50 @@
+{
+  "schema": 1,
+  "batch": "headers-presync-rejections",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/headerssync.cpp",
+      "rules": [
+        {
+          "id": "headers_presync_difficulty_invalid",
+          "old": "LogPrintf(\"Initial headers sync aborted with peer=%d: invalid \"\n                  \"difficulty transition at height=%i (presync phase)\\n\",\n                  m_id, next_height)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"headers_presync_difficulty_invalid\", \"Initial headers sync aborted with peer={peer_id}: invalid difficulty transition at height={height} (presync phase)\").Field(BCLog::LogField::PeerId, m_id).Field(BCLog::LogField::Height, next_height)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Initial headers sync aborted with peer=%d: invalid difficulty transition at height=%i (presync phase)\n",
+            "specifiers": [
+              "%d",
+              "%i"
+            ],
+            "arguments": [
+              "m_id",
+              "next_height"
+            ]
+          },
+          "review_note": "Preserve Info despite abnormal peer behavior; exact peer signed ID and next height, no classification, protocol, commitment bounds, failure returns or control flow changes."
+        },
+        {
+          "id": "headers_presync_commitments_exceeded",
+          "old": "LogPrintf(\"Initial headers sync aborted with peer=%d: exceeded max \"\n                      \"commitments at height=%i (presync phase)\\n\",\n                      m_id, next_height)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"headers_presync_commitments_exceeded\", \"Initial headers sync aborted with peer={peer_id}: exceeded max commitments at height={height} (presync phase)\").Field(BCLog::LogField::PeerId, m_id).Field(BCLog::LogField::Height, next_height)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Initial headers sync aborted with peer=%d: exceeded max commitments at height=%i (presync phase)\n",
+            "specifiers": [
+              "%d",
+              "%i"
+            ],
+            "arguments": [
+              "m_id",
+              "next_height"
+            ]
+          },
+          "review_note": "Preserve Info despite abnormal peer behavior; exact peer signed ID and next height, no classification, protocol, commitment bounds, failure returns or control flow changes."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/headerssync.cpp b/src/headerssync.cpp
index d0d24f8db20e7b43c15b7bdf787ddb95c6addb6b..e60fb533b088be61eaaa86907f9accdf6a08de4f 100644
--- a/src/headerssync.cpp
+++ b/src/headerssync.cpp
@@ -237,9 +237,11 @@ bool HeadersSyncState::ValidateAndProcessSingleHeader(
     if (!PermittedDifficultyTransition(m_consensus_params, next_height,
                                        m_last_header_received.nBits,
                                        current.nBits)) {
-        LogPrintf("Initial headers sync aborted with peer=%d: invalid "
-                  "difficulty transition at height=%i (presync phase)\n",
-                  m_id, next_height);
+        LogInfoEvent(
+            BCLog::ALL, "headers_presync_difficulty_invalid",
+            "Initial headers sync aborted with peer={peer_id}: invalid difficulty transition at height={height} (presync phase)")
+            .Field(BCLog::LogField::PeerId, m_id)
+            .Field(BCLog::LogField::Height, next_height);
         return false;
     }
 
@@ -251,9 +253,11 @@ bool HeadersSyncState::ValidateAndProcessSingleHeader(
             // It's possible the chain grew since we started the sync; so
             // potentially we could succeed in syncing the peer's chain if we
             // try again later.
-            LogPrintf("Initial headers sync aborted with peer=%d: exceeded max "
-                      "commitments at height=%i (presync phase)\n",
-                      m_id, next_height);
+            LogInfoEvent(
+                BCLog::ALL, "headers_presync_commitments_exceeded",
+                "Initial headers sync aborted with peer={peer_id}: exceeded max commitments at height={height} (presync phase)")
+                .Field(BCLog::LogField::PeerId, m_id)
+                .Field(BCLog::LogField::Height, next_height);
             return false;
         }
     }
