-        LogPrintf("tor: Thread interrupt\n");
+        LogInfoEvent(BCLog::ALL, "tor_control_thread_interrupted",
+                     "tor: Thread interrupt");
         // Thread-safe; if the loop has not started yet, run() returns at once.
         g_tor_io->stop();
     }
