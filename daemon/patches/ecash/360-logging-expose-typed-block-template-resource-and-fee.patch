From cb7acfe0b5c525fba186302b857e6d71aff8ec60 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 16:07:43 -0700
Subject: [PATCH] logging: expose typed block-template resource and fee
 counters

Keep exact CreateNewBlock summary text while retaining unsigned byte, tx and
sigcheck counters and signed integer fees in base units. Amount ostream prints
its underlying integer, so dividing by SATOSHI preserves that exact value.
The real walletless one-block fixture checks serialized bytes against RPC,
empty transaction count, zero fees and the coinbase sigcheck reservation.
No block assembly, limits, transaction selection or consensus behavior changes.
Native validation is pending; this is not a throughput benchmark.

Scripted diff (ast-grep-py0.51.0; single reviewed site):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/miner-template-summary.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/miner364-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/node/miner.cpp

diff --git a/contrib/logging/conversion/rules/miner-template-summary.json b/contrib/logging/conversion/rules/miner-template-summary.json
new file mode 100644
index 0000000000000000000000000000000000000000..2e9e703cd4d306efa2c30cf719993daf2442e291
--- /dev/null
+++ b/contrib/logging/conversion/rules/miner-template-summary.json
@@ -0,0 +1,46 @@
+{
+  "schema": 1,
+  "batch": "miner-template-summary",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/node/miner.cpp",
+      "rules": [
+        {
+          "id": "block_template_created",
+          "old": "LogPrintf(\n        \"CreateNewBlock(): total size: %u txs: %u fees: %ld sigChecks %d\\n\",\n        nSerializeSize, blockFitter.nBlockTx, blockFitter.nFees,\n        blockFitter.nBlockSigChecks)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_template_created\", \"CreateNewBlock(): total size: {bytes} txs: {count} fees: {amount_sats} sigChecks {sig_checks}\").Field(BCLog::LogField::Bytes, nSerializeSize).Field(BCLog::LogField::Count, blockFitter.nBlockTx).Field(BCLog::LogField::AmountSats, blockFitter.nFees / SATOSHI).Field(BCLog::LogField::SigChecks, blockFitter.nBlockSigChecks)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "CreateNewBlock(): total size: %u txs: %u fees: %ld sigChecks %d\n",
+            "specifiers": [
+              "%u",
+              "%u",
+              "%ld",
+              "%d"
+            ],
+            "arguments": [
+              "nSerializeSize",
+              "blockFitter.nBlockTx",
+              "blockFitter.nFees",
+              "blockFitter.nBlockSigChecks"
+            ]
+          },
+          "review_note": "Preserve Info, exact human summary, unsigned serialized-byte/transaction/sigcheck counters and signed integer base-unit fees. Amount ostream emits its stored int64 units, so /SATOSHI exposes exactly the old number without coin conversion. Preserve all blockfitter/reserved-resource/coinbase/merklix decisions and evaluation order. Signature-check count is uint64 despite old %d; never narrow."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Append unsigned signature-check count, matching BlockFitter uint64_t rather than legacy format spelling.",
+          "old": "    X(ClientVersion, client_version, STRING, \"\", \"\")\n",
+          "new": "    X(ClientVersion, client_version, STRING, \"\", \"\") \\\n    X(SigChecks, sig_checks, UINT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/logging/fields.h b/src/logging/fields.h
index bacedc859756ef27d27f0addfd9139e3b7fdd49f..99b8e0bd447c2dc73b56bcf8df2d3d8e0982daea 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -203,7 +203,8 @@
     X(ImportedBlockCount, imported_block_count, INT, "", "") \
     X(ElapsedMilliseconds, elapsed_milliseconds, INT, "", "") \
     X(ClientName, client_name, STRING, "", "") \
-    X(ClientVersion, client_version, STRING, "", "")
+    X(ClientVersion, client_version, STRING, "", "") \
+    X(SigChecks, sig_checks, UINT, "", "")
 
 namespace BCLog {
 
diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index a6d91b06e509051558e518042ab5fe2582cc72e6..7eb05bcea0edc96afae6826cc392d3f8e91b2cbd 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -272,10 +272,13 @@ BlockAssembler::CreateNewBlock(const CScript &scriptPubKeyIn) {
         pblock->vtx[0]->GetTotalSize() +
         (blockFitter.nBlockSize - BlockFitter::COINBASE_RESERVED_SIZE);
 
-    LogPrintf(
-        "CreateNewBlock(): total size: %u txs: %u fees: %ld sigChecks %d\n",
-        nSerializeSize, blockFitter.nBlockTx, blockFitter.nFees,
-        blockFitter.nBlockSigChecks);
+    LogInfoEvent(
+        BCLog::ALL, "block_template_created",
+        "CreateNewBlock(): total size: {bytes} txs: {count} fees: {amount_sats} sigChecks {sig_checks}")
+        .Field(BCLog::LogField::Bytes, nSerializeSize)
+        .Field(BCLog::LogField::Count, blockFitter.nBlockTx)
+        .Field(BCLog::LogField::AmountSats, blockFitter.nFees / SATOSHI)
+        .Field(BCLog::LogField::SigChecks, blockFitter.nBlockSigChecks);
 
     // Fill in header.
     pblock->hashPrevBlock = pindexPrev->GetBlockHash();
diff --git a/test/functional/feature_logging_miner_template.py b/test/functional/feature_logging_miner_template.py
new file mode 100644
index 0000000000000000000000000000000000000000..a141339ce49a016b42341e386a52c79968f50e53
--- /dev/null
+++ b/test/functional/feature_logging_miner_template.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""A real empty regtest block retains exact typed mining summary units."""
+
+import json
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+
+class MinerTemplateLoggingTest(BitcoinTestFramework):
+    num_nodes = 1
+    setup_clean_chain = True
+    wallet_names = []
+    extra_args = [["-logformat=json"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        blockhash = self.generatetoaddress(
+            node, 1, node.get_deterministic_priv_key().address
+        )[0]
+        serialized_bytes = len(node.getblock(blockhash, 0)) // 2
+        assert_equal(node.getblockcount(), 1)
+        self.stop_node(0)
+        rows = [
+            json.loads(line)
+            for line in node.debug_log_path.read_text().splitlines()
+            if line.strip()
+        ]
+        row = {r.get("event"): r for r in rows}["block_template_created"]
+        for field in ("bytes", "count", "amount_sats", "sig_checks"):
+            assert type(row[field]) is int
+        assert_equal(row["bytes"], serialized_bytes)
+        assert_equal(row["count"], 0)
+        assert_equal(row["amount_sats"], 0)
+        assert_equal(row["sig_checks"], 100)  # Coinbase resource reservation.
+        assert_equal(
+            row["message"],
+            f"CreateNewBlock(): total size: {serialized_bytes} txs: 0 fees: 0 sigChecks 100",
+        )
+        assert_equal(row["level"], "info")
+        assert "fields_truncated" not in row
+
+
+if __name__ == "__main__":
+    MinerTemplateLoggingTest().main()
