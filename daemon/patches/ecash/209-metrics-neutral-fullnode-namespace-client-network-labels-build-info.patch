+
+bool IsValidMetricName(std::string_view s) {
+    if (s.empty()) {
+        return false;
+    }
+    for (size_t i = 0; i < s.size(); ++i) {
+        if (!IsNameChar(s[i], i == 0, /*colon=*/true)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool IsValidLabelName(std::string_view s) {
+    if (s.empty() || s.starts_with("__")) {
+        return false;
+    }
+    for (size_t i = 0; i < s.size(); ++i) {
+        if (!IsNameChar(s[i], i == 0, /*colon=*/false)) {
+            return false;
+        }
+    }
