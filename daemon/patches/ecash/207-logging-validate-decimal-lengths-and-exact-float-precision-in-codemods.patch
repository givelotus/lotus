From 90cfed9c5bfe74feddfbecdfc9e6c846e6e4a41f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:26:24 -0700
Subject: [PATCH] logging: validate decimal lengths and exact float precision
 in codemods

Extend reviewed AST call mappings to canonical decimal integer length modifiers and bounded FLOAT message precision supported by the preceding consumer API feature. Require identical placeholder precision, preserve exact wording and severity/category, and continue rejecting widths/sign flags/dynamic precision/unsupported types. Actual typed fields remain explicitly reviewed, never inferred from labels. Add exact success/rejection fixtures and run every existing catalog fixture/idempotence test: 14 test methods pass. Manually authored tool capability, no production call conversion and no additional daemon functional claim.

Coordinator integration provenance (canonical283 to ordered301):
The scripted commands, tool/rule hashes and historical validation receipts above are original-author provenance for the authored parent. They were not rerun on this composed parent and do not claim byte-for-byte regeneration or validation of it.
Application: git am -3 --keep-cr --keep-non-patch of the exact sealed original mailbox; no new conversion rollout.
Original mailbox applied without source-semantic adaptation at the shared insertion boundary; later explicit native removals are preserved separately.
Composed compile/runtime: pending; no suites or benchmarks run during integration.
---
 contrib/logging/conversion/README.md       |  5 +++++
 contrib/logging/conversion/convert.py      | 24 +++++++++++++++++-----
 contrib/logging/conversion/test_convert.py | 22 ++++++++++++++++++++
 3 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/contrib/logging/conversion/README.md b/contrib/logging/conversion/README.md
index 83d2bf095c1091e2c973fcab41c9609df084e1ca..dce3fbc62acee0cc7231719a3b5d54b83bbf9e54 100644
--- a/contrib/logging/conversion/README.md
+++ b/contrib/logging/conversion/README.md
@@ -12,6 +12,11 @@ the official 1.8.1 release provided Linux x86_64 assets only. The available
 ast-grep Python wheel correctly parsed the representative nested-template
 argument fixture. No claim that Comby could not implement these rules is made.
 
+Reviewed mappings support plain decimal integer length modifiers and explicit
+FLOAT `f`/`g` precision 0..18. A floating placeholder must preserve the original
+printf precision exactly. Other width/sign/type formatting remains rejected;
+this capability does not infer a field type or domain from its label.
+
 The checked-in JSON rules are reviewed semantic mappings, not inferred schemas.
 They specify exact input ASTs, expected counts, event expressions, and review
 notes. Whitespace may differ in input; argument tokens may not. Missing,
diff --git a/contrib/logging/conversion/convert.py b/contrib/logging/conversion/convert.py
index f8b92ad06a9589dafce1a1e0856af3b697e173e7..7894e038e6f51cf6b45841bfbe878d8fedc1c387 100755
--- a/contrib/logging/conversion/convert.py
+++ b/contrib/logging/conversion/convert.py
@@ -139,10 +139,17 @@ def outer_event(node):
 
 def validate_mapping(old, event):
     description = describe(old)
-    # The event renderer has no printf width/precision language. Keep those
-    # calls legacy until an explicit rendering feature and regression exist.
-    if any(s not in {"%s", "%d", "%u"} for s in description["specifiers"]):
+    # Decimal integer length modifiers preserve decimal text. Explicit float
+    # precision uses the separately tested consumer rendering contract.
+    def rendering(spec):
+        if spec == "%s" or re.fullmatch(r"%(?:ll|l|z|t|j)?[diu]", spec):
+            return None
+        if re.fullmatch(r"%(?:\.(?:[0-9]|1[0-8]))?[fg]", spec):
+            return spec[1:]
         raise ValueError("format width/precision/type needs manual rendering support")
+
+    for spec in description["specifiers"]:
+        rendering(spec)
     oldargs, newargs = args(old), args(event)
     macro = description["macro"]
     category = (
@@ -171,7 +178,7 @@ def validate_mapping(old, event):
         raise ValueError("severity/category changed")
     message = literal(newargs[2])
     # Regex only examines captured literal bodies, never source boundaries.
-    placeholders = re.findall(r"\{[a-z][a-z0-9_]*\}", message)
+    placeholders = re.findall(r"\{[a-z][a-z0-9_]*(?::[^}]*)?\}", message)
     parts = format_parts(description["format"])
     rebuilt = ""
     cursor = 0
@@ -182,7 +189,14 @@ def validate_mapping(old, event):
         elif spec:
             if cursor >= len(placeholders):
                 raise ValueError("missing message placeholder")
-            rebuilt += placeholders[cursor]
+            placeholder = placeholders[cursor]
+            format_spec = rendering(spec)
+            suffix = ":" + format_spec + "}" if format_spec is not None else None
+            if (suffix is not None and not placeholder.endswith(suffix)) or (
+                suffix is None and ":" in placeholder
+            ):
+                raise ValueError("message float precision changed")
+            rebuilt += placeholder
             cursor += 1
     if rebuilt.endswith("\n"):
         rebuilt = rebuilt[:-1]
diff --git a/contrib/logging/conversion/test_convert.py b/contrib/logging/conversion/test_convert.py
index 0a7da0dc3e2dfb306e2ec939c5c87de7c85642b2..27dbe23d4f53fdf63517de4383334fbbb6877099 100755
--- a/contrib/logging/conversion/test_convert.py
+++ b/contrib/logging/conversion/test_convert.py
@@ -105,6 +105,28 @@ class ConversionTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             convert.convert(old, [rule(old, new)])
 
+    def test_decimal_integer_lengths(self):
+        for spec in ["%i", "%ld", "%lu", "%lld", "%llu", "%zu", "%td", "%ju"]:
+            old = 'LogPrintf("value=' + spec + '", x)'
+            new = 'LogInfoEvent(BCLog::ALL,"value","value={count}").Field(BCLog::LogField::Count,x)'
+            self.assertEqual(convert.convert(old, [rule(old, new)])[0], new)
+
+    def test_float_precision_is_exact(self):
+        for spec in ["%f", "%g", "%.0f", "%.2f", "%.18g"]:
+            old = 'LogPrintf("elapsed=' + spec + '", x)'
+            new = ('LogInfoEvent(BCLog::ALL,"elapsed","elapsed={elapsed_ms:'
+                   + spec[1:] + '}").Field(BCLog::LogField::ElapsedMs,x)')
+            self.assertEqual(convert.convert(old, [rule(old, new)])[0], new)
+            for changed in [new.replace(spec[1:] + '}', '.1f}'),
+                            new.replace(':' + spec[1:], '')]:
+                with self.assertRaises(ValueError):
+                    convert.convert(old, [rule(old, changed)])
+        for spec in ["%.19f", "%08.2f", "%+f", "%e"]:
+            old = 'LogPrintf("elapsed=' + spec + '", x)'
+            new = 'LogInfoEvent(BCLog::ALL,"elapsed","elapsed={elapsed_ms:f}").Field(BCLog::LogField::ElapsedMs,x)'
+            with self.assertRaises(ValueError):
+                convert.convert(old, [rule(old, new)])
+
     def test_all_catalog_rules_and_idempotence(self):
         for path in sorted((Path(__file__).parent / "rules").glob("*.json")):
             catalog = json.loads(path.read_text())
