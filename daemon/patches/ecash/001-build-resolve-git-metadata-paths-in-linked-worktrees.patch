From 5e19ab4e564f5d886d9a929249acbdc1e84a88c6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Thu, 22 Oct 2026 19:57:38 -0700
Subject: [PATCH] build: resolve Git metadata paths in linked worktrees

Extract the existing linked-worktree compatibility hunk from the adaptive capacity owner; no policy logic changes.

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 5215fe4e6b33c350dfbfe1672dbde81b1af5d3d2..bbff7ada904cede6be788ddcc4fb2c7c766cb003 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -346,18 +346,18 @@ function(find_git_head_logs_file RESULT)
 	find_package(Git)
 	if(GIT_FOUND)
 		execute_process(
-			COMMAND "${GIT_EXECUTABLE}" "rev-parse" "--show-toplevel"
+			COMMAND "${GIT_EXECUTABLE}" "rev-parse" "--absolute-git-dir"
 			WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
-			OUTPUT_VARIABLE GIT_ROOT
+			OUTPUT_VARIABLE GIT_DIR
 			RESULT_VARIABLE GIT_RESULT
 			OUTPUT_STRIP_TRAILING_WHITESPACE
 			ERROR_QUIET
 		)
 
 		if(GIT_RESULT EQUAL 0)
-			set(GIT_LOGS_DIR "${GIT_ROOT}/.git/logs")
+			set(GIT_LOGS_DIR "${GIT_DIR}/logs")
 			set(GIT_HEAD_LOGS_FILE "${GIT_LOGS_DIR}/HEAD")
-			# If the .git/logs/HEAD does not exist, create it
+			# If the logs/HEAD does not exist, create it
 			if(NOT EXISTS "${GIT_HEAD_LOGS_FILE}")
 				file(MAKE_DIRECTORY "${GIT_LOGS_DIR}")
 				file(TOUCH "${GIT_HEAD_LOGS_FILE}")
