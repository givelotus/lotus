From 6afcefcf8f56eaff7d9382b6975f92d12a38f356 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:52:11 -0700
Subject: [PATCH] logging: structure the additional script verification worker
 count

Record the constructor's original signed additional-worker count while
preserving Info text, clamping, thread creation and all queue behavior.
A native fixture constructs an actual zero-worker check queue and checks
the numeric field and readable message. The startup fixture uses -par=1
to verify the same zero-additional-worker case through the real daemon.
Tier: shared eCash, inherited unchanged by V2.

Scripted diff (ast-grep-py==0.51.0; from the commit's parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/script-worker-startup.json --apply

git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/checkqueue.h src/test/logging_event_tests.cpp

Handwritten: actual-constructor native fixture, explicit includes and
functional assertions. Registry append is an explicit support adjustment.

diff --git a/contrib/logging/conversion/rules/script-worker-startup.json b/contrib/logging/conversion/rules/script-worker-startup.json
new file mode 100644
index 0000000000000000000000000000000000000000..1adb69d9f9d303c113c7d4f0ce1eb16c956f87f1
--- /dev/null
+++ b/contrib/logging/conversion/rules/script-worker-startup.json
@@ -0,0 +1,40 @@
+{
+  "schema": 1,
+  "batch": "script-worker-startup",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/checkqueue.h",
+      "rules": [
+        {
+          "id": "script_verification_workers",
+          "old": "LogInfo(\"Script verification uses %d additional threads\\n\",\n                worker_threads_num)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"script_verification_workers\", \"Script verification uses {script_worker_threads} additional threads\").Field(BCLog::LogField::ScriptWorkerThreads, worker_threads_num)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogInfo",
+            "format": "Script verification uses %d additional threads\n",
+            "specifiers": [
+              "%d"
+            ],
+            "arguments": [
+              "worker_threads_num"
+            ]
+          },
+          "review_note": "Original signed additional-worker count and Info/readable text. Do not change clamping, thread creation, condition variables, checks or queue behavior."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Actual additional script worker count retains signed int semantics.",
+          "old": "    X(SHA256Implementation, sha256_implementation, STRING, \"\", \"\")\n",
+          "new": "    X(SHA256Implementation, sha256_implementation, STRING, \"\", \"\") \\\n    X(ScriptWorkerThreads, script_worker_threads, INT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/checkqueue.h b/src/checkqueue.h
index e9ff5126a8336548b81731fa21137db758160488..5f8f9c6e64107ce41235b39493dea549d44731ab 100644
