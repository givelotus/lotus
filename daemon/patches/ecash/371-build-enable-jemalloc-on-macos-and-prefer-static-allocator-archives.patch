From 8eb3077ad92113ecb873eb68d629a95ef7c993f9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 13:23:01 -0700
Subject: [PATCH] build: enable jemalloc on macOS and prefer static allocator
 archives

Keep explicit USE_JEMALLOC=OFF and libc-jemalloc platforms unchanged. Prefer PIC static archives without requiring fully static system binaries; retain dynamic fallback for installations that only provide shared libraries. Check the allocator-specific mallctl/mallocx APIs at link time so libc malloc cannot hide a broken jemalloc dependency. Depends already pins static-only jemalloc 5.3.0; no source-package Guix override needs changing.

Coordinator context adaptation: append the supplied allocator documentation after each existing macOS guide, preserving shared Notes until its original native removal. Executable-only linking, Darwin force-load, libc++ support and QEMU include propagation are exact003a8f125d bytes; no allocator tuning. Actual daemon native-wallet101block/verifychain/shutdown and static allocator activity passed; Guix not run.
---
 cmake/modules/FindJemalloc.cmake  | 35 ++++++++++++++++++++++++++++---
 cmake/utils/CheckJemallocBuilds.c | 12 +++++++----
 depends/packages/jemalloc.mk      |  3 +++
 doc/build-osx.md                  |  9 ++++++++
 src/CMakeLists.txt                | 14 ++++++-------
 src/jemalloc_message.cpp          |  2 +-
 6 files changed, 59 insertions(+), 16 deletions(-)

diff --git a/cmake/modules/FindJemalloc.cmake b/cmake/modules/FindJemalloc.cmake
index 9436c646725779d9f00aa9537f000a88fbd44629..b459decfe7dfd8a70a4a4ab9b683e7dc8569bea4 100644
--- a/cmake/modules/FindJemalloc.cmake
+++ b/cmake/modules/FindJemalloc.cmake
@@ -20,7 +20,12 @@
 #   Jemalloc::jemalloc
 
 find_package(PkgConfig)
-pkg_check_modules(PC_Jemalloc QUIET libjemalloc)
+pkg_check_modules(PC_Jemalloc QUIET jemalloc)
+if(NOT PC_Jemalloc_FOUND)
+	pkg_check_modules(PC_Jemalloc QUIET libjemalloc)
+endif()
+
+option(Jemalloc_USE_STATIC_LIBS "Prefer a static jemalloc archive" ON)
 
 include(BrewHelper)
 find_brew_prefix(_Jemalloc_BREW_HINT jemalloc)
@@ -64,17 +69,41 @@ if(Jemalloc_INCLUDE_DIR)
 	set(THREADS_PREFER_PTHREAD_FLAG ON)
 	find_package(Threads REQUIRED)
 
+	# Prefer the PIC archive for shared-library consumers as well as executables.
+	# A system installation without static archives can still use the shared library.
+	set(_Jemalloc_LIBRARY_SUFFIXES ${CMAKE_FIND_LIBRARY_SUFFIXES})
+	set(_Jemalloc_LIBRARY_NAMES jemalloc)
+	if(Jemalloc_USE_STATIC_LIBS)
+		list(PREPEND CMAKE_FIND_LIBRARY_SUFFIXES ".a")
+		list(PREPEND _Jemalloc_LIBRARY_NAMES jemalloc_pic)
+		list(REMOVE_DUPLICATES CMAKE_FIND_LIBRARY_SUFFIXES)
+	endif()
+
 	find_component(Jemalloc jemalloc
-		NAMES jemalloc_pic jemalloc
+		NAMES ${_Jemalloc_LIBRARY_NAMES}
 		HINTS "${_Jemalloc_BREW_HINT}"
 		INCLUDE_DIRS ${Jemalloc_INCLUDE_DIRS}
 		PATHS ${PC_Jemalloc_LIBRARY_DIRS}
 		INTERFACE_LINK_LIBRARIES "$<$<NOT:$<PLATFORM_ID:Windows>>:m>" Threads::Threads
 	)
 
+	set(CMAKE_FIND_LIBRARY_SUFFIXES ${_Jemalloc_LIBRARY_SUFFIXES})
+
 	# jemalloc might be built with or without libdl support. Check if the link
 	# succeeds without -ldl, and add the flag otherwise.
 	if(TARGET Jemalloc::jemalloc)
+		if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND Jemalloc_jemalloc_LIBRARY MATCHES "\\.a$")
+			# The archive's otherwise-unreferenced zone constructor must run so
+			# allocations crossing dylib/libc++ boundaries use the same allocator.
+			# Merely resolving malloc from the archive leaves libSystem's default
+			# zone active and can crash when the other allocator frees a pointer.
+			set_property(TARGET Jemalloc::jemalloc APPEND PROPERTY
+				INTERFACE_LINK_OPTIONS "LINKER:-force_load,${Jemalloc_jemalloc_LIBRARY}")
+			# Whole-archive linking also retains the C++ new/delete overrides.
+			set_property(TARGET Jemalloc::jemalloc APPEND PROPERTY
+				INTERFACE_LINK_LIBRARIES c++)
+		endif()
+
 		try_compile(_Jemalloc_BUILD_WITHOUT_DL
 			${CMAKE_BINARY_DIR}
 			"${CMAKE_SOURCE_DIR}/cmake/utils/CheckJemallocBuilds.c"
@@ -109,7 +138,7 @@ endif()
 
 include(FindPackageHandleStandardArgs)
 find_package_handle_standard_args(Jemalloc
-	REQUIRED_VARS Jemalloc_INCLUDE_DIR
+	REQUIRED_VARS Jemalloc_INCLUDE_DIR Jemalloc_jemalloc_LIBRARY
 	VERSION_VAR Jemalloc_VERSION
 	REASON_FAILURE_MESSAGE "this is an optional dependency that can be disabled by passing -DUSE_JEMALLOC=OFF to the cmake command line"
 	HANDLE_COMPONENTS
diff --git a/cmake/utils/CheckJemallocBuilds.c b/cmake/utils/CheckJemallocBuilds.c
index ba4f1ef1d51f645c8d7be530cb8b4b7f98e4d2c8..152bd4ff1df60f375e4ea8ee6a1132a6f2d71f70 100644
--- a/cmake/utils/CheckJemallocBuilds.c
+++ b/cmake/utils/CheckJemallocBuilds.c
@@ -1,7 +1,11 @@
 #include <jemalloc.h>
 
-int main(int argc, char** argv) {
-    void *volatile dummyPtr = malloc(42);
-    (void)argv;
-    return argc;
+int main(void) {
+    /* malloc alone can link against libc even when jemalloc is unusable. */
+    const char *version = 0;
+    size_t size = sizeof(version);
+    void *ptr = mallocx(42, 0);
+    int result = mallctl("version", &version, &size, 0, 0);
+    dallocx(ptr, 0);
+    return result;
 }
diff --git a/depends/packages/jemalloc.mk b/depends/packages/jemalloc.mk
index d52dc30256f051d012f336138868605aa7eba7cd..d1694674868279760b92e2b4f4d2ebc3eccb035c 100644
--- a/depends/packages/jemalloc.mk
+++ b/depends/packages/jemalloc.mk
@@ -6,6 +6,9 @@ $(package)_sha256_hash=ef6f74fd45e95ee4ef7f9e19ebe5b075ca6b7fbe0140612b2a161abaf
 
 define $(package)_set_vars
 $(package)_config_opts=--disable-libdl --disable-shared --enable-cxx --enable-option-checking
+# Darwin otherwise defaults to je_-prefixed APIs. A static archive then does
+# not replace ordinary malloc/free calls from the daemon.
+$(package)_config_opts_darwin=--with-jemalloc-prefix=
 # Override jemalloc's forced -g3 (see configure.ac JE_*FLAGS_ADD([-g3]))
 $(package)_cflags+=-g0
 $(package)_cxxflags+=-g0
diff --git a/doc/build-osx.md b/doc/build-osx.md
index f4461cdbc1d7d4e1d6d5c5632becf9edf295b8fb..997c0b114ee16ae206fa9fee59ef3764b327dc8f 100644
--- a/doc/build-osx.md
+++ b/doc/build-osx.md
@@ -94,3 +94,12 @@ Notes
 -----
 
 * Building with downloaded Qt binaries is not officially supported. See the notes in [#7714](https://github.com/bitcoin/bitcoin/issues/7714)
+
+### Memory allocator
+
+Jemalloc is enabled by default, including native macOS builds. CMake prefers
+`libjemalloc_pic.a` or `libjemalloc.a` when installed; macOS system libraries
+remain dynamically linked. Set `-DJemalloc_USE_STATIC_LIBS=OFF` to prefer the
+platform's normal library search order, or `-DUSE_JEMALLOC=OFF` to use the
+system allocator. Sanitizer builds use the system allocator automatically.
+The depends build already provides pinned, static-only jemalloc archives.
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index a8d4e34c6762526d3a1a154ef4e30ec51982e1a9..0f14759ff681f076dfd60f580b236ab5c49469f9 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -53,13 +53,9 @@ set(OS_WITH_JEMALLOC_AS_SYSTEM_DEFAULT
 	"FreeBSD"
 	"NetBSD"
 )
-if(NOT CMAKE_SYSTEM_NAME IN_LIST OS_WITH_JEMALLOC_AS_SYSTEM_DEFAULT)
-	set(USE_JEMALLOC_DEFAULT ON)
-endif()
-
-# FIXME: Building against jemalloc causes the software to segfault on OSX.
-# See https://github.com/Bitcoin-ABC/bitcoin-abc/issues/401
-if(${CMAKE_SYSTEM_NAME} MATCHES "Darwin" AND NOT CMAKE_CROSSCOMPILING)
+set(USE_JEMALLOC_DEFAULT ON)
+if(CMAKE_SYSTEM_NAME IN_LIST OS_WITH_JEMALLOC_AS_SYSTEM_DEFAULT)
+	# These systems already provide jemalloc through libc.
 	set(USE_JEMALLOC_DEFAULT OFF)
 endif()
 
@@ -324,7 +320,8 @@ if(USE_JEMALLOC)
 		message(WARNING "Jemalloc is incompatible with the sanitizers and has been disabled.")
 	else()
 		find_package(Jemalloc 3.6.0 REQUIRED)
-		link_libraries(Jemalloc::jemalloc)
+		# Install the allocator into executables, not embeddable shared libraries.
+		link_libraries("$<$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>:Jemalloc::jemalloc>")
 	endif()
 endif()
 
@@ -473,6 +470,7 @@ target_include_directories(util
 if(CMAKE_CROSSCOMPILING AND USE_JEMALLOC AND CMAKE_CROSSCOMPILING_EMULATOR MATCHES "qemu-.+")
 	message(WARNING "Overriding Jemalloc malloc_message() function for use with QEMU.")
 	target_sources(util PRIVATE jemalloc_message.cpp)
+	target_include_directories(util PRIVATE ${Jemalloc_INCLUDE_DIRS})
 endif()
 
 set(Boost_USE_STATIC_LIBS ON)
diff --git a/src/jemalloc_message.cpp b/src/jemalloc_message.cpp
index 2bd42f2689499076e22745a62797da45e4e3ead1..4e0ae4ea24a4ae084e444afccbae52f7e5e0a0bb 100644
--- a/src/jemalloc_message.cpp
+++ b/src/jemalloc_message.cpp
@@ -2,7 +2,7 @@
 // Distributed under the MIT software license, see the accompanying
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
-#include <jemalloc/jemalloc.h>
+#include <jemalloc.h>
 
 /**
  * Using the signature of jemalloc's malloc_message(), drop the string entirely.
-- 
