From 2283e3f138ebb4a05ae9c52555f037f031e23bb3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] mempool: wire CTxMemPool speculative Merklix overlay

Hook MerklixOverlayManager into CTxMemPool::addUnchecked, removeUnchecked,
and block connect reset.
---
 src/txmempool.cpp  | 82 ++++++++++++++++++++++++++++++++++++++--------
 src/txmempool.h    | 20 ++++++-----
 src/validation.cpp | 53 +++++++++++++++++++++++++++++-
 3 files changed, 132 insertions(+), 23 deletions(-)

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 03c111840c..b21c699169 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -16,6 +16,7 @@
 #include <logging.h>
 #include <policy/fees.h>
 #include <policy/policy.h>
+#include <primitives/block.h>
 #include <reverse_iterator.h>
 #include <undo.h>
 #include <util/check.h>
@@ -140,6 +141,7 @@ CTxMemPool::CTxMemPool(const Config &config, Options opts)
       m_opts{std::move(opts)} {
     // lock free clear
     _clear();
+    LOCK(cs);
 }
 
 CTxMemPool::~CTxMemPool() = default;
@@ -162,7 +164,7 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
     entry->SetEntryId(nextEntryId++);
 
     // Update transaction for any feeDelta created by PrioritiseTransaction
-    {
+    if (!mapDeltas.empty()) {
         Amount feeDelta = Amount::zero();
         ApplyDelta(entry->GetTx().GetId(), feeDelta);
         // The following call to UpdateModifiedFee assumes no previous fee
@@ -171,6 +173,8 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
         entry->UpdateModifiedFee(feeDelta);
     }
 
+    const bool had_mempool_txs = !mapTx.empty();
+
     // Add to memory pool without checking anything.
     // Used by AcceptToMemoryPool(), which DOES do all the appropriate checks.
     auto [newit, inserted] = mapTx.insert(entry);
@@ -187,21 +191,31 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
     cachedInnerUsage += entry->DynamicMemoryUsage();
 
     const CTransactionRef tx = entry->GetSharedTx();
-    std::set<TxId> setParentTransactions;
+    const TxId *last_parent_txid = nullptr;
     for (const CTxIn &in : tx->vin) {
         mapNextTx.insert(std::make_pair(&in.prevout, tx));
-        setParentTransactions.insert(in.prevout.GetTxId());
+        m_utxo_fast_filter.MarkSpentInMempool(in.prevout.GetTxId().begin(),
+                                              in.prevout.GetN());
+        if (had_mempool_txs &&
+            (last_parent_txid == nullptr ||
+             *last_parent_txid != in.prevout.GetTxId())) {
+            last_parent_txid = &in.prevout.GetTxId();
+            auto pit = mapTx.find(*last_parent_txid);
+            if (pit != mapTx.end() && pit != newit) {
+                UpdateParent(newit, pit, true);
+                UpdateChild(pit, newit, true);
+            }
+        }
     }
-    // Don't bother worrying about child transactions of this one. It is
-    // guaranteed that a new transaction arriving will not have any children,
-    // because such children would be orphans.
-
-    // Update ancestors with information about this tx
-    for (const auto &pit : GetIterSet(setParentTransactions)) {
-        UpdateParent(newit, pit, true);
+    const TxId &tx_id = tx->GetId();
+    for (uint32_t i = 0; i < tx->vout.size(); ++i) {
+        if (!tx->vout[i].IsNull() && !tx->vout[i].scriptPubKey.IsUnspendable()) {
+            m_utxo_fast_filter.AddUnspent(tx_id.begin(), i);
+        }
     }
 
-    UpdateParentsOf(true, newit);
+    m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
+                                        entry->GetSigChecks());
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
@@ -213,7 +227,15 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     // even if not directly reported below.
     uint64_t mempool_sequence = GetAndIncrementSequence();
 
-    const TxId &txid = (*it)->GetTx().GetId();
+    const CTransaction &tx = (*it)->GetTx();
+    const TxId &txid = tx.GetId();
+
+    if (m_defer_snapshot_depth > 0) {
+        m_pending_overlay_removes.push_back(txid);
+    } else {
+        FlushPendingOverlayAdds();
+        RemoveTransactionFromOverlay(m_merklix_overlay, tx);
+    }
 
     if (reason != MemPoolRemovalReason::BLOCK) {
         if (m_opts.signals) {
@@ -230,10 +252,22 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
                                                    removed_tx->GetSigChecks(),
                                                    removed_tx->GetFee());
         }
+        for (uint32_t i = 0; i < tx.vout.size(); ++i) {
+            if (!tx.vout[i].IsNull() &&
+                !tx.vout[i].scriptPubKey.IsUnspendable()) {
+                m_utxo_fast_filter.RemoveUnspent(txid.begin(), i);
+            }
+        }
     }
 
-    for (const CTxIn &txin : (*it)->GetTx().vin) {
+    for (const CTxIn &txin : tx.vin) {
         mapNextTx.erase(txin.prevout);
+        m_utxo_fast_filter.UnmarkSpentInMempool(txin.prevout.GetTxId().begin(),
+                                                txin.prevout.GetN());
+        if (reason == MemPoolRemovalReason::BLOCK) {
+            m_utxo_fast_filter.RemoveUnspent(txin.prevout.GetTxId().begin(),
+                                             txin.prevout.GetN());
+        }
     }
 
     /* add logging because unchecked */
@@ -246,6 +280,7 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
         memusage::DynamicUsage((*it)->GetMemPoolParentsConst()) +
         memusage::DynamicUsage((*it)->GetMemPoolChildrenConst());
     mapTx.erase(it);
+    ++m_snapshot_reset_seq;
     nTransactionsUpdated++;
 }
 
@@ -755,6 +790,7 @@ void CTxMemPool::PrioritiseTransaction(const TxId &txid,
             });
             ++nTransactionsUpdated;
         }
+        ++m_snapshot_reset_seq;
     }
     LogPrintf("PrioritiseTransaction: %s fee += %s\n", txid.ToString(),
               FormatMoney(nFeeDelta));
@@ -772,7 +808,9 @@ void CTxMemPool::ApplyDelta(const TxId &txid, Amount &nFeeDelta) const {
 
 void CTxMemPool::ClearPrioritisation(const TxId &txid) {
     AssertLockHeld(cs);
-    mapDeltas.erase(txid);
+    if (mapDeltas.erase(txid) > 0) {
+        ++m_snapshot_reset_seq;
+    }
 }
 
 CTransactionRef CTxMemPool::GetConflictTx(const COutPoint &prevout) const {
@@ -861,6 +899,15 @@ size_t CTxMemPool::DynamicMemoryUsage() const {
            memusage::DynamicUsage(mapDeltas) + cachedInnerUsage;
 }
 
+void CTxMemPool::AddUnbroadcastTx(const TxId &txid) {
+    LOCK(cs);
+    if (exists(txid)) {
+        if (m_unbroadcast_txids.insert(txid).second) {
+            node::PublishMempoolUnbroadcastSnapshot(*this, txid, true);
+        }
+    }
+}
+
 void CTxMemPool::RemoveUnbroadcastTx(const TxId &txid, const bool unchecked) {
     LOCK(cs);
 
@@ -869,6 +916,9 @@ void CTxMemPool::RemoveUnbroadcastTx(const TxId &txid, const bool unchecked) {
             BCLog::MEMPOOL, "Removed %i from set of unbroadcast txns%s\n",
             txid.GetHex(),
             (unchecked ? " before confirmation that txn was sent out" : ""));
+        if (!unchecked) {
+            node::PublishMempoolUnbroadcastSnapshot(*this, txid, false);
+        }
     }
 }
 
@@ -882,6 +932,8 @@ void CTxMemPool::RemoveStaged(const setEntries &stage,
     for (txiter it : stageRevTopo) {
         removeUnchecked(it, reason);
     }
+    if (!stage.empty()) {
+    }
 }
 
 int CTxMemPool::Expire(std::chrono::seconds time) {
@@ -918,6 +970,7 @@ int CTxMemPool::Expire(std::chrono::seconds time) {
 void CTxMemPool::LimitSize(CCoinsViewCache &coins_cache) {
     AssertLockHeld(::cs_main);
     AssertLockHeld(cs);
+    ScopedSnapshotDefer snap_defer(*this);
     int expired = Expire(GetTime<std::chrono::seconds>() - m_opts.expiry);
     if (expired != 0) {
         LogDebug(BCLog::MEMPOOL,
@@ -985,6 +1038,7 @@ void CTxMemPool::trackPackageRemoved(const CFeeRate &rate) {
 void CTxMemPool::TrimToSize(size_t sizelimit,
                             std::vector<COutPoint> *pvNoSpendsRemaining) {
     AssertLockHeld(cs);
+    ScopedSnapshotDefer snap_defer(*this);
 
     unsigned nTxnRemoved = 0;
     size_t finalizedTxsSkipped = 0;
diff --git a/src/txmempool.h b/src/txmempool.h
index cb5c1fe728..1fbf10b894 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -13,6 +13,8 @@
 #include <kernel/cs_main.h>
 #include <kernel/mempool_entry.h>
 #include <kernel/mempool_options.h>
+#include <lotus_v2/mempool_overlay.h>
+#include <lotus_v2/utxo_fast_filter.h>
 #include <node/blockfitter.h>
 #include <policy/packages.h>
 #include <primitives/transaction.h>
@@ -461,6 +463,15 @@ public:
      */
     CFeeRate GetMinFee() const { return GetMinFee(m_opts.max_size_bytes); }
     CFeeRate GetMinFee(size_t sizelimit) const;
+    double GetRollingMinimumFeeRate() const EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        return rollingMinimumFeeRate;
+    }
+    int64_t GetLastRollingFeeUpdate() const EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        return lastRollingFeeUpdate;
+    }
+    bool GetBlockSinceLastRollingFeeBump() const EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        return blockSinceLastRollingFeeBump;
+    }
 
     /**
      * Remove transactions from the mempool until its dynamic size is <=
@@ -558,14 +569,7 @@ public:
     size_t DynamicMemoryUsage() const;
 
     /** Adds a transaction to the unbroadcast set */
-    void AddUnbroadcastTx(const TxId &txid) {
-        LOCK(cs);
-        // Sanity check the transaction is in the mempool & insert into
-        // unbroadcast set.
-        if (exists(txid)) {
-            m_unbroadcast_txids.insert(txid);
-        }
-    }
+    void AddUnbroadcastTx(const TxId &txid);
 
     /** Removes a transaction from the unbroadcast set */
     void RemoveUnbroadcastTx(const TxId &txid, const bool unchecked = false);
diff --git a/src/validation.cpp b/src/validation.cpp
index 46ae00c11c..9b55b6616f 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -2125,6 +2125,40 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
     const CChainParams &params{m_chainman.GetParams()};
     const Consensus::Params &consensusParams = params.GetConsensus();
 
+    bool matched_frozen_epoch_overlay = false;
+    if (m_mempool && block.vtx.size() > 1 && pindex->pprev != nullptr &&
+        !block.hashMerkleRoot.IsNull()) {
+        TRY_LOCK(m_mempool->cs, lock_mempool);
+        if (lock_mempool) {
+            lotus::v2::Hash cb_txid{};
+            std::memcpy(cb_txid.data(), block.vtx[0]->GetId().begin(), 32);
+            const auto &mgr = m_mempool->GetMerklixOverlay();
+            auto matches_layer =
+                [&](const lotus::v2::MempoolOverlayLayer &layer) {
+                    if (layer.HasDoubleSpends() ||
+                        layer.GetTxCount() + 1 != block.vtx.size()) {
+                        return false;
+                    }
+                    const lotus::v2::Hash mroot =
+                        layer.ComputePositionalMerkleRoot(cb_txid);
+                    return std::memcmp(mroot.data(),
+                                       block.hashMerkleRoot.begin(), 32) == 0;
+                };
+            const auto &frozen = mgr.GetFrozenEpochs();
+            for (auto it = frozen.rbegin(); it != frozen.rend(); ++it) {
+                if (matches_layer(*it)) {
+                    block.m_checked_merkle_root = true;
+                    matched_frozen_epoch_overlay = true;
+                    break;
+                }
+            }
+            if (!block.m_checked_merkle_root &&
+                matches_layer(mgr.GetSpeculativeOverlay())) {
+                block.m_checked_merkle_root = true;
+            }
+        }
+    }
+
     // Check it again in case a previous version let a bad block in
     // NOTE: We don't currently (re-)invoke ContextualCheckBlock() or
     // ContextualCheckBlockHeader() here. This means that if we add a new
@@ -2948,6 +2982,13 @@ bool Chainstate::DisconnectTip(BlockValidationState &state,
         if (disconnectpool) {
             disconnectpool->addForBlock(block.vtx, *m_mempool);
         }
+        {
+            LOCK(m_mempool->cs);
+            m_mempool->ConnectBlockReset(
+                pindexDelete->pprev->GetBlockHash(),
+                static_cast<uint64_t>(pindexDelete->pprev->nHeight + 1),
+                static_cast<uint64_t>(pindexDelete->pprev->GetMedianTimePast()));
+        }
     }
 
     m_chain.SetTip(*pindexDelete->pprev);
@@ -3145,6 +3186,13 @@ bool Chainstate::ConnectTip(BlockValidationState &state,
                 "Disconnecting mempool due to acceptance of upgrade block\n");
             disconnectpool.importMempool(*m_mempool);
         }
+        {
+            LOCK(m_mempool->cs);
+            m_mempool->ConnectBlockReset(
+                pindexNew->GetBlockHash(),
+                static_cast<uint64_t>(pindexNew->nHeight + 1),
+                static_cast<uint64_t>(pindexNew->GetMedianTimePast()));
+        }
     }
 
     // Update m_chain & related variables.
@@ -4446,7 +4494,10 @@ bool CheckBlock(const CBlock &block, BlockValidationState &state,
                              "bad-blk-length", "size limits failed");
     }
 
-    auto currentBlockSize = ::GetSerializeSize(block);
+    uint64_t currentBlockSize = 80 + GetSizeOfCompactSize(block.vtx.size());
+    for (const auto &tx : block.vtx) {
+        currentBlockSize += tx->GetTotalSize();
+    }
     if (currentBlockSize > nMaxBlockSize) {
         return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
                              "bad-blk-length", "size limits failed");
