+BOOST_AUTO_TEST_CASE(ossl_stream_reads_gathers_and_retries) {
+    namespace asio = boost::asio;
+    using tcp = asio::ip::tcp;
+    const auto pem{tls::GenerateSelfSigned("t", {"localhost"}, {},
+                                           std::chrono::hours{1})};
