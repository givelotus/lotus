From 6a8c5819b7e5bc5d6d3eec625ac0479626a2a920 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 14:45:50 -0700
Subject: [PATCH] logging: identify shutdown interrupt-token failures as
 structured events

Keep both historical Info messages byte-identical and preserve the exception
handlers, assertion and interrupt-token operations. Give sending and reading
failures distinct event identities without new fields or state changes.
These rare exception paths are not injected; the focused node fixture exercises
normal clean shutdown, not failure-path behavior.

Scripted diff (ast-grep-py 0.51.0):
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/shutdown-token-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/shutdown309-conversion.json --apply
  git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/shutdown.cpp

Source-only checkpoint pending combined native gate. Shared eCash owner;
no shutdown behavior changes. Preserve immutable native294 proof separately.
---
 .../rules/shutdown-token-diagnostics.json     | 38 +++++++++++++++++++
 src/shutdown.cpp                              |  6 ++-
 2 files changed, 42 insertions(+), 2 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/shutdown-token-diagnostics.json

diff --git a/contrib/logging/conversion/rules/shutdown-token-diagnostics.json b/contrib/logging/conversion/rules/shutdown-token-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..d5c5a524da4fb1df389220efbe9918835a43c0de
--- /dev/null
+++ b/contrib/logging/conversion/rules/shutdown-token-diagnostics.json
@@ -0,0 +1,38 @@
+{
+  "schema": 1,
+  "batch": "shutdown-token-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/shutdown.cpp",
+      "rules": [
+        {
+          "id": "shutdown_token_send_failed",
+          "old": "LogPrintf(\"Sending shutdown token failed\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"shutdown_token_send_failed\", \"Sending shutdown token failed\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Sending shutdown token failed\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve existing Info, exact static failure text, exception catches, assertion and interrupt-token semantics. No failure injection; rare error paths remain explicitly unforced."
+        },
+        {
+          "id": "shutdown_token_read_failed",
+          "old": "LogPrintf(\"Reading shutdown token failed\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"shutdown_token_read_failed\", \"Reading shutdown token failed\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Reading shutdown token failed\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve existing Info, exact static failure text, exception catches, assertion and interrupt-token semantics. No failure injection; rare error paths remain explicitly unforced."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/shutdown.cpp b/src/shutdown.cpp
index 0238929b8de9ddf763367f7d7a09570450e32936..15e00f441849ed80c69d4e002bba0ab44053741c 100644
--- a/src/shutdown.cpp
+++ b/src/shutdown.cpp
@@ -17,7 +17,8 @@ void StartShutdown() {
     try {
         Assert(kernel::g_context)->interrupt();
     } catch (const std::system_error &) {
-        LogPrintf("Sending shutdown token failed\n");
+        LogInfoEvent(BCLog::ALL, "shutdown_token_send_failed",
+                     "Sending shutdown token failed");
         assert(0);
     }
 }
@@ -34,7 +35,8 @@ void WaitForShutdown() {
     try {
         Assert(kernel::g_context)->interrupt.wait();
     } catch (const std::system_error &) {
-        LogPrintf("Reading shutdown token failed\n");
+        LogInfoEvent(BCLog::ALL, "shutdown_token_read_failed",
+                     "Reading shutdown token failed");
         assert(0);
     }
 }
-- 
