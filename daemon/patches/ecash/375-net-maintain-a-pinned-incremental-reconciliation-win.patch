+namespace {
+std::vector<TxId>
+PinnedWindowIds(const txrelay::TxRelayIndex::WindowTree &tree) {
+    std::vector<TxId> ids;
+    tree.forEachLeaf([&](const auto &entry) {
+        ids.push_back(entry->txid);
+        return true;
+    });
+    return ids;
+}
