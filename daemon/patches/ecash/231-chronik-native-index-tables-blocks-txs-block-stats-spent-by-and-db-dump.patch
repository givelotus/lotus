+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_BLOCK_STATS_H
+#define CHRONIK_NATIVE_INDEX_BLOCK_STATS_H
+
+#include <chronik/native/index/blocks.h>
+#include <chronik/native/index/index_tx.h>
+#include <chronik/native/store.h>
+
+#include <cstdint>
+#include <optional>
+#include <span>
+
+/** Port of chronik-db io/block_stats.rs: the `blk_stats` table. */
+namespace chronik::native::index {
+
+/** Statistics about a block, like num txs, block size, etc. */
+struct BlockStats {
+    /** Block size of this block in bytes (including headers etc.) */
+    uint64_t block_size{};
+    /** Number of txs in this block */
+    uint64_t num_txs{};
+    /** Total number of tx inputs in block (including coinbase) */
+    uint64_t num_inputs{};
+    /** Total number of tx output in block (including coinbase) */
+    uint64_t num_outputs{};
+    /** Total number of satoshis spent by tx inputs */
+    int64_t sum_input_sats{};
+    /** Block reward for this block */
+    int64_t sum_coinbase_output_sats{};
+    /** Total number of satoshis in non-coinbase tx outputs */
+    int64_t sum_normal_output_sats{};
+    /** Total number of satoshis burned using OP_RETURN */
+    int64_t sum_burned_sats{};
+
+    bool operator==(const BlockStats &) const = default;
+};
+
+inline constexpr std::string_view kBlockStatsTypeName =
+    "chronik_db::io::block_stats::BlockStats";
+
+Bytes SerializeBlockStats(const BlockStats &stats);
+BlockStats DeserializeBlockStats(ByteView bytes);
+
+/** Write [`BlockStats`] to the DB. */
+class BlockStatsWriter {
+public:
+    explicit BlockStatsWriter(const KvStore &store);
+
+    /**
+     * Measure the [`BlockStats`] of the block with the given the block txs
+     * and add them to the txn.
+     */
+    void Insert(WriteTxn &txn, BlockHeight block_height, uint64_t block_size,
+                std::span<const IndexTx> txs) const;
+    /** Delete the block stats for the block with the given height. */
+    void Delete(WriteTxn &txn, BlockHeight block_height) const;
+
+private:
+    TableId m_cf;
+};
+
+/** Read [`BlockStats`] from the DB. */
+class BlockStatsReader {
+public:
+    BlockStatsReader(const KvStore &store, const ReadTxn &txn);
+
+    /** The [`BlockStats`], or nullopt if the block doesn't exist. */
+    std::optional<BlockStats> ByHeight(BlockHeight block_height) const;
+
+private:
+    const ReadTxn &m_txn;
+    TableId m_cf;
+};
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_BLOCK_STATS_H
diff --git a/chronik/native/include/chronik/native/index/blocks.h b/chronik/native/include/chronik/native/index/blocks.h
new file mode 100644
index 0000000000000000000000000000000000000000..634a06189c65b63b94ff78b418ccd7d284e3ed40
--- /dev/null
+++ b/chronik/native/include/chronik/native/index/blocks.h
@@ -0,0 +1,133 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_BLOCKS_H
+#define CHRONIK_NATIVE_INDEX_BLOCKS_H
+
+#include <chronik/native/store.h>
+#include <chronik/native/types.h>
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+/**
+ * Port of chronik-db io/blocks.rs: the `blk` table (height BE4 -> postcard
+ * SerBlock) and its `lookup_blk_by_hash` reverse index.
+ *
+ * Writers write into a WriteTxn (the Rust WriteBatch). Readers read through
+ * any ReadTxn, including a WriteTxn (which observes its own writes).
+ */
+namespace chronik::native::index {
+
+/**
+ * Height of a block in the chain. Genesis block has height 0.
+ * -1 indicates "not part of the chain".
+ */
+using BlockHeight = int32_t;
+
+/** Block data to/from the database. */
+struct DbBlock {
+    /** Hash of the block. */
+    BlockHash hash;
+    /** Hash of the previous block of the block. */
+    BlockHash prev_hash;
+    /** Height of the block in the chain. */
+    BlockHeight height{};
+    /** `nBits` field of the block; encodes the target compactly. */
+    uint32_t n_bits{};
+    /** Timestamp field of the block. */
+    int64_t timestamp{};
+    /** Number of the node's blk?????.dat flat file where the block is stored. */
+    uint32_t file_num{};
+    /**
+     * Location in the flat file where the first byte of the block is stored,
+     * starting at the header.
+     */
+    uint32_t data_pos{};
+
+    bool operator==(const DbBlock &) const = default;
+};
+
+/** Serialized form of a block in `blk` (Rust `SerBlock`). */
+struct SerBlock {
+    std::array<uint8_t, 32> hash{};
+    uint32_t n_bits{};
+    int64_t timestamp{};
+    uint32_t file_num{};
+    uint32_t data_pos{};
+
+    bool operator==(const SerBlock &) const = default;
+};
+
+inline constexpr std::string_view kSerBlockTypeName =
+    "chronik_db::io::blocks::SerBlock";
+
+Bytes SerializeSerBlock(const SerBlock &block);
+SerBlock DeserializeSerBlock(ByteView bytes);
+
+/**
+ * Serialize block height for using it as keys in the DB.
+ * Big-endian, so blocks are sorted ascendingly.
+ */
+std::array<uint8_t, 4> BhToBytes(BlockHeight height);
+/** Deserialize block height from bytes. */
+BlockHeight BytesToBh(ByteView bytes);
+
+/** Writes block data to the database. */
+class BlockWriter {
+public:
+    /** Throws if the tables don't exist. */
+    explicit BlockWriter(const KvStore &store);
+
+    /** Add a new block to the database. */
+    void Insert(WriteTxn &txn, const DbBlock &block) const;
+    /** Remove a block by height from the database. */
+    void Delete(WriteTxn &txn, const DbBlock &block) const;
+
+private:
+    TableId m_blk;
+    TableId m_lookup;
+};
+
+/** Reads block data ([`DbBlock`]) from the database. */
+class BlockReader {
+public:
+    BlockReader(const KvStore &store, const ReadTxn &txn);
+
+    /**
+     * The height of the most-work fully-validated chain. The genesis block has
+     * height 0
+     */
+    BlockHeight Height() const;
+    /**
+     * Tip of the chain: the most recently added block.
+     * nullopt if chain is empty (not even the genesis block).
+     */
+    std::optional<DbBlock> Tip() const;
+    /** [`DbBlock`] by height. The genesis block has height 0. */
+    std::optional<DbBlock> ByHeight(BlockHeight height) const;
+    /**
+     * Block hashes for a contiguous height range, starting at `start_height`.
+     * Returns at most `count` hashes, truncated at the first gap.
+     */
+    std::vector<std::array<uint8_t, 32>>
+    HashesByRange(BlockHeight start_height, size_t count) const;
+    /** [`DbBlock`] by hash. */
+    std::optional<DbBlock> ByHash(const BlockHash &hash) const;
+
+private:
+    std::array<uint8_t, 32> GetPrevHash(BlockHeight height) const;
+    std::optional<SerBlock> GetBlock(BlockHeight height) const;
+    DbBlock MakeDbBlock(BlockHeight height, const SerBlock &ser) const;
+
+    const ReadTxn &m_txn;
+    TableId m_blk;
+    TableId m_lookup;
+};
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_BLOCKS_H
