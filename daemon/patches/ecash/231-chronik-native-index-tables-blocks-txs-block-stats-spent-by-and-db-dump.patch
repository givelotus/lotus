diff --git a/chronik/native/core/index/spent_by.cpp b/chronik/native/core/index/spent_by.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3afc024453ac714c9fdcc8a4ab74cf61534c4932
--- /dev/null
+++ b/chronik/native/core/index/spent_by.cpp
@@ -0,0 +1,220 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/index/spent_by.h>
+
+#include <chronik/native/codec/postcard.h>
+#include <chronik/native/error.h>
+#include <chronik/native/index/merge.h>
+#include <chronik/native/schema.h>
+
+#include <algorithm>
+#include <chrono>
+#include <unordered_map>
+
+namespace chronik::native::index {
+
+namespace {
+
+double SecondsSince(std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                         start)
+        .count();
+}
+
+Bytes SerTxNum(TxNum tx_num) {
+    Bytes out;
+    postcard::Writer(out).U64(tx_num);
+    return out;
+}
+
+TxNum DeserTxNum(ByteView bytes) {
+    return postcard::DbDeserialize(
+        bytes, "u64", [](postcard::Reader &r) { return r.U64(); });
+}
+
+/** Binary search by out_idx: (found, index) like Rust binary_search_by_key. */
+std::pair<bool, size_t> SearchOutIdx(const std::vector<SpentByEntry> &entries,
+                                     uint32_t out_idx) {
+    auto it = std::lower_bound(entries.begin(), entries.end(), out_idx,
+                               [](const SpentByEntry &entry, uint32_t idx) {
+                                   return entry.out_idx < idx;
+                               });
+    const size_t pos = size_t(it - entries.begin());
+    return {it != entries.end() && it->out_idx == out_idx, pos};
+}
+
+} // namespace
+
+std::string DebugSpentByEntry(const SpentByEntry &entry) {
+    return "SpentByEntry { out_idx: " + std::to_string(entry.out_idx) +
+           ", tx_num: " + std::to_string(entry.tx_num) +
+           ", input_idx: " + std::to_string(entry.input_idx) + " }";
+}
+
+Bytes SerializeSpentByEntries(std::span<const SpentByEntry> entries) {
+    Bytes out;
+    postcard::Writer w(out);
+    for (const SpentByEntry &entry : entries) {
+        w.U32(entry.out_idx);
+        w.U64(entry.tx_num);
+        w.U32(entry.input_idx);
+    }
+    return out;
+}
+
+std::vector<SpentByEntry> DeserializeSpentByEntries(ByteView bytes) {
+    return postcard::DbDeserializeVec(
+        bytes, kSpentByEntryTypeName, [](postcard::Reader &r) {
+            SpentByEntry entry;
+            entry.out_idx = r.U32();
+            entry.tx_num = r.U64();
+            entry.input_idx = r.U32();
+            return entry;
+        });
+}
+
+SpentByWriter::SpentByWriter(const KvStore &store)
+    : m_cf(store.Table(schema::kSpentBy)) {}
+
+void SpentByWriter::Insert(WriteTxn &txn, std::span<const IndexTx> txs,
+                           SpentByMemData &mem_data) const {
+    SpentByStats &stats = mem_data.stats;
+    const auto t_start = std::chrono::steady_clock::now();
+    stats.n_total += txs.size();
+    std::unordered_map<TxNum, std::vector<SpentByEntry>> spent_by_map;
+    for (const IndexTx &tx : txs) {
+        if (tx.is_coinbase) {
+            // a coinbase doesn't spend anything
+            continue;
+        }
+        const size_t n = std::min(tx.tx->inputs.size(), tx.input_nums.size());
+        for (size_t input_idx = 0; input_idx < n; ++input_idx) {
+            const SpentByEntry spent_by{
+                tx.tx->inputs[input_idx].prev_out.out_idx,
+                tx.tx_num,
+                uint32_t(input_idx),
+            };
+            spent_by_map[tx.input_nums[input_idx]].push_back(spent_by);
+        }
+    }
+    for (const auto &[tx_num, entries] : spent_by_map) {
+        const Bytes operand = SerializeSpentByEntries(entries);
+        merge::CatchMergeErrors(
+            txn, m_cf, SerTxNum(tx_num), std::span<const Bytes>(&operand, 1),
+            // init_merge_spent_by
+            [](ByteView, std::optional<ByteView> existing, size_t) {
+                return existing ? DeserializeSpentByEntries(*existing)
+                                : std::vector<SpentByEntry>{};
+            },
+            // apply_merge_spent_by
+            [](ByteView key, std::vector<SpentByEntry> &entries,
+               ByteView operand) {
+                const std::vector<SpentByEntry> extra_entries =
+                    DeserializeSpentByEntries(operand);
+                entries.reserve(entries.size() + extra_entries.size());
+                for (const SpentByEntry &spent_by : extra_entries) {
+                    const auto [found, idx] =
+                        SearchOutIdx(entries, spent_by.out_idx);
+                    if (found) {
+                        const TxNum input_tx_num = DeserTxNum(key);
+                        // Output already spent by another tx -> corrupted DB?
+                        throw ChronikError(
+                            "Inconsistent DB: Duplicate spend by entry for "
+                            "tx_num = " +
+                            std::to_string(input_tx_num) + ": " +
+                            DebugSpentByEntry(entries[idx]) +
+                            " already exists, but tried to add " +
+                            DebugSpentByEntry(spent_by));
+                    }
+                    // No entry found -> insert it
+                    entries.insert(entries.begin() + idx, spent_by);
+                }
+            },
+            // ser_merge_spent_by
+            [](ByteView, std::vector<SpentByEntry> &&entries) {
+                return SerializeSpentByEntries(entries);
+            });
+    }
+    stats.t_total += SecondsSince(t_start);
+}
+
+void SpentByWriter::Delete(WriteTxn &txn, std::span<const IndexTx> txs,
+                           SpentByMemData &mem_data) const {
+    SpentByStats &stats = mem_data.stats;
+    const auto t_start = std::chrono::steady_clock::now();
+    stats.n_total += txs.size();
+    std::unordered_map<TxNum, std::vector<SpentByEntry>> spent_by_map;
+    for (const IndexTx &tx : txs) {
+        if (tx.is_coinbase) {
+            // a coinbase doesn't spend anything
+            continue;
+        }
+        const size_t n = std::min(tx.tx->inputs.size(), tx.input_nums.size());
+        for (size_t input_idx = 0; input_idx < n; ++input_idx) {
+            const TxNum input_tx_num = tx.input_nums[input_idx];
+            const SpentByEntry spent_by{
+                tx.tx->inputs[input_idx].prev_out.out_idx,
+                tx.tx_num,
+                uint32_t(input_idx),
+            };
+            const auto t_fetch = std::chrono::steady_clock::now();
+            auto it = spent_by_map.find(input_tx_num);
+            if (it == spent_by_map.end()) {
+                std::vector<SpentByEntry> db_entries;
+                if (const std::optional<ByteView> data =
+                        txn.Get(m_cf, SerTxNum(input_tx_num))) {
+                    db_entries = DeserializeSpentByEntries(*data);
+                }
+                it = spent_by_map.emplace(input_tx_num, std::move(db_entries))
+                         .first;
+            }
+            stats.t_fetch += SecondsSince(t_fetch);
+            std::vector<SpentByEntry> &spent_by_entries = it->second;
+            const auto [found, idx] =
+                SearchOutIdx(spent_by_entries, spent_by.out_idx);
+            if (!found) {
+                // Spent-by entry not found, but should be there.
+                throw ChronikError(
+                    "Inconsistent DB: Missing spend by entry for tx_num = " +
+                    std::to_string(input_tx_num) + ": Expected " +
+                    DebugSpentByEntry(spent_by) +
+                    " to be present, but none found");
+            }
+            // Found the spent-by entry -> remove it.
+            if (spent_by_entries[idx] != spent_by) {
+                // Existing entry doesn't match what's in the DB.
+                throw ChronikError(
+                    "Inconsistent DB: Mismatched spend by entry for tx_num = " +
+                    std::to_string(input_tx_num) + ": Expected " +
+                    DebugSpentByEntry(spent_by) + " to be present, but got " +
+                    DebugSpentByEntry(spent_by_entries[idx]));
+            }
+            spent_by_entries.erase(spent_by_entries.begin() + idx);
+        }
+    }
+    for (const auto &[tx_num, entries] : spent_by_map) {
+        const Bytes ser_num = SerTxNum(tx_num);
+        if (entries.empty()) {
+            txn.Del(m_cf, ser_num);
+        } else {
+            txn.Put(m_cf, ser_num, SerializeSpentByEntries(entries));
+        }
+    }
+    stats.t_total += SecondsSince(t_start);
+}
+
+SpentByReader::SpentByReader(const KvStore &store, const ReadTxn &txn)
+    : m_txn(txn), m_cf(store.Table(schema::kSpentBy)) {}
+
+std::optional<std::vector<SpentByEntry>>
+SpentByReader::ByTxNum(TxNum tx_num) const {
+    const std::optional<ByteView> data = m_txn.Get(m_cf, SerTxNum(tx_num));
+    if (!data) {
+        return std::nullopt;
+    }
+    return DeserializeSpentByEntries(*data);
+}
+
+} // namespace chronik::native::index
diff --git a/chronik/native/core/index/txs.cpp b/chronik/native/core/index/txs.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..325df8771f9d02deee0e7f0fe98474249a37c8d1
--- /dev/null
+++ b/chronik/native/core/index/txs.cpp
@@ -0,0 +1,320 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/index/txs.h>
+
+#include <chronik/native/codec/bytes.h>
+#include <chronik/native/codec/postcard.h>
+#include <chronik/native/codec/seahash.h>
+#include <chronik/native/error.h>
+#include <chronik/native/index/debug_fmt.h>
+#include <chronik/native/index/reverse_lookup.h>
+#include <chronik/native/schema.h>
+
+#include <chrono>
+
+namespace chronik::native::index {
+
+namespace {
+
+double SecondsSince(std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                         start)
+        .count();
+}
+
+/** LookupColumn for txs (Rust `TxColumn`). */
+struct TxColumn {
+    using SerialNum = TxNum;
+    using Data = SerTx;
+    static constexpr std::string_view kCfData = schema::kTx;
+    static constexpr std::string_view kCfIndex = schema::kLookupTxByHash;
+    static constexpr std::string_view kSerialTypeName = "u64";
+    static constexpr std::string_view kSerialVecTypeName =
+        "alloc::vec::Vec<u64>";
+
+    const ReadTxn &txn;
+    TableId tx;
+    TableId lookup;
+
+    static Bytes CheapHash(const Key32 &key) {
+        const auto be = ToBe<uint64_t>(SeaHash(AsView(key)));
+        return Bytes(be.begin(), be.end());
+    }
+    static const Key32 &DataKey(const SerTx &data) { return data.txid; }
+    static void SerSerial(postcard::Writer &w, TxNum tx_num) { w.U64(tx_num); }
+    static TxNum DeserSerial(postcard::Reader &r) { return r.U64(); }
+    TableId IndexTable() const { return lookup; }
+
+    std::optional<SerTx> GetData(TxNum tx_num) const {
+        const std::optional<ByteView> bytes = txn.Get(tx, TxNumToBytes(tx_num));
+        if (!bytes) {
+            return std::nullopt;
+        }
+        return DeserializeSerTx(*bytes);
+    }
+    std::vector<std::optional<SerTx>>
+    GetDataMulti(const std::vector<TxNum> &tx_nums) const {
+        std::vector<std::optional<SerTx>> out;
+        out.reserve(tx_nums.size());
+        for (const TxNum tx_num : tx_nums) {
+            out.push_back(GetData(tx_num));
+        }
+        return out;
+    }
+};
+
+using LookupByHash = ReverseLookup<TxColumn>;
+
+} // namespace
+
+Bytes SerializeSerTx(const SerTx &tx) {
+    Bytes out;
+    postcard::Writer w(out);
+    w.Raw(tx.txid);
+    w.U32(tx.data_pos);
+    w.U32(tx.undo_pos);
+    w.I64(tx.time_first_seen);
+    return out;
+}
+
+SerTx DeserializeSerTx(ByteView bytes) {
+    return postcard::DbDeserialize(bytes, kSerTxTypeName,
+                                   [](postcard::Reader &r) {
+                                       SerTx tx;
+                                       tx.txid = r.Array<32>();
+                                       tx.data_pos = r.U32();
+                                       tx.undo_pos = r.U32();
+                                       tx.time_first_seen = r.I64();
+                                       return tx;
+                                   });
+}
+
+SerTx ToSerTx(const TxEntry &entry) {
+    return SerTx{entry.txid.b, entry.data_pos, entry.undo_pos,
+                 entry.time_first_seen};
+}
+
+TxEntry FromSerTx(const SerTx &ser) {
+    TxEntry entry;
+    entry.txid.b = ser.txid;
+    entry.data_pos = ser.data_pos;
+    entry.undo_pos = ser.undo_pos;
+    entry.time_first_seen = ser.time_first_seen;
+    entry.is_coinbase = ser.undo_pos == 0;
+    return entry;
+}
+
+std::array<uint8_t, 8> TxNumToBytes(TxNum tx_num) {
+    return ToBe<uint64_t>(tx_num);
+}
+
+TxNum BytesToTxNum(ByteView bytes) {
+    if (bytes.size() != 8) {
+        throw ChronikError("Inconsistent DB: Invalid tx_num bytes: " +
+                           DebugByteVec(bytes));
+    }
+    return FromBe<uint64_t>(bytes);
+}
+
+TxWriter::TxWriter(const KvStore &store)
+    : m_tx(store.Table(schema::kTx)),
+      m_blk_by_first_tx(store.Table(schema::kBlkByFirstTx)),
+      m_first_tx_by_blk(store.Table(schema::kFirstTxByBlk)),
+      m_lookup(store.Table(schema::kLookupTxByHash)) {}
+
+TxNum TxWriter::Insert(WriteTxn &txn, const BlockTxs &block_txs,
+                       TxsMemData &mem_data) const {
+    TxsStats &stats = mem_data.stats;
+    const auto t_start = std::chrono::steady_clock::now();
+    stats.n_total += block_txs.txs.size();
+    TxNum first_new_tx = 0;
+    {
+        const std::unique_ptr<Cursor> cursor = txn.OpenCursor(m_tx);
+        if (cursor->SeekLast()) {
+            first_new_tx = BytesToTxNum(cursor->Key()) + 1;
+        }
+    }
+    txn.Put(m_blk_by_first_tx, TxNumToBytes(first_new_tx),
+            BhToBytes(block_txs.block_height));
+    txn.Put(m_first_tx_by_blk, BhToBytes(block_txs.block_height),
+            TxNumToBytes(first_new_tx));
+    std::vector<std::pair<TxNum, Key32>> index_pairs;
+    index_pairs.reserve(block_txs.txs.size());
+    TxNum next_tx_num = first_new_tx;
+    for (const TxEntry &tx : block_txs.txs) {
+        txn.Put(m_tx, TxNumToBytes(next_tx_num),
+                SerializeSerTx(ToSerTx(tx)));
+        index_pairs.emplace_back(next_tx_num, tx.txid.b);
+        ++next_tx_num;
+    }
+    const auto t_index = std::chrono::steady_clock::now();
+    LookupByHash::InsertPairs(TxColumn{txn, m_tx, m_lookup}, txn, index_pairs);
+    stats.t_index += SecondsSince(t_index);
+    stats.t_total += SecondsSince(t_start);
+    return first_new_tx;
+}
+
+TxNum TxWriter::Delete(WriteTxn &txn, const BlockTxs &block_txs,
+                       TxsMemData &mem_data) const {
+    TxsStats &stats = mem_data.stats;
+    const auto t_start = std::chrono::steady_clock::now();
+    stats.n_total += block_txs.txs.size();
+    const std::optional<ByteView> first_tx_num_bytes =
+        txn.Get(m_first_tx_by_blk, BhToBytes(block_txs.block_height));
+    if (!first_tx_num_bytes) {
+        throw ChronikError("Inconsistent DB: Txs for block " +
+                           std::to_string(block_txs.block_height) +
+                           " not found");
+    }
+    const TxNum first_tx_num = BytesToTxNum(*first_tx_num_bytes);
+    TxNum next_tx_num = first_tx_num;
+    std::vector<std::pair<TxNum, Key32>> index_pairs;
+    index_pairs.reserve(block_txs.txs.size());
+    for (const TxEntry &tx : block_txs.txs) {
+        txn.Del(m_tx, TxNumToBytes(next_tx_num));
+        index_pairs.emplace_back(next_tx_num, tx.txid.b);
+        ++next_tx_num;
+    }
+    txn.Del(m_blk_by_first_tx, TxNumToBytes(first_tx_num));
+    txn.Del(m_first_tx_by_blk, BhToBytes(block_txs.block_height));
+    const auto t_index = std::chrono::steady_clock::now();
+    LookupByHash::DeletePairs(TxColumn{txn, m_tx, m_lookup}, txn, index_pairs);
+    stats.t_index += SecondsSince(t_index);
+    stats.t_total += SecondsSince(t_start);
+    return first_tx_num;
+}
+
+TxReader::TxReader(const KvStore &store, const ReadTxn &txn)
+    : m_txn(txn), m_tx(store.Table(schema::kTx)),
+      m_blk_by_first_tx(store.Table(schema::kBlkByFirstTx)),
+      m_first_tx_by_blk(store.Table(schema::kFirstTxByBlk)),
+      m_lookup(store.Table(schema::kLookupTxByHash)) {}
+
+std::optional<SerTx> TxReader::GetTx(TxNum tx_num) const {
+    return TxColumn{m_txn, m_tx, m_lookup}.GetData(tx_num);
+}
+
+std::optional<BlockTx> TxReader::TxByTxid(const TxId &txid) const {
+    std::optional<std::pair<TxNum, BlockTx>> found = TxAndNumByTxid(txid);
+    if (!found) {
+        return std::nullopt;
+    }
+    return std::move(found->second);
+}
+
+std::optional<std::pair<TxNum, BlockTx>>
+TxReader::TxAndNumByTxid(const TxId &txid) const {
+    const std::optional<std::pair<TxNum, SerTx>> found =
+        LookupByHash::Get(TxColumn{m_txn, m_tx, m_lookup}, m_txn, txid.b);
+    if (!found) {
+        return std::nullopt;
+    }
+    const BlockHeight block_height = BlockHeightByTxNum(found->first);
+    return std::make_pair(found->first,
+                          BlockTx{FromSerTx(found->second), block_height});
+}
+
+std::optional<TxNum> TxReader::TxNumByTxid(const TxId &txid) const {
+    const std::optional<std::pair<TxNum, SerTx>> found =
+        LookupByHash::Get(TxColumn{m_txn, m_tx, m_lookup}, m_txn, txid.b);
+    if (!found) {
+        return std::nullopt;
+    }
+    return found->first;
+}
+
+std::vector<std::optional<TxNum>>
+TxReader::TxNumsByTxids(const std::vector<TxId> &txids) const {
+    std::vector<Key32> keys;
+    keys.reserve(txids.size());
+    for (const TxId &txid : txids) {
+        keys.push_back(txid.b);
+    }
+    const auto data =
+        LookupByHash::GetMulti(TxColumn{m_txn, m_tx, m_lookup}, m_txn, keys);
+    std::vector<std::optional<TxNum>> out;
+    out.reserve(data.size());
+    for (const auto &entry : data) {
+        out.push_back(entry ? std::optional<TxNum>(entry->first)
+                            : std::nullopt);
+    }
+    return out;
+}
+
+std::optional<BlockTx> TxReader::TxByTxNum(TxNum tx_num) const {
+    const std::optional<SerTx> ser_tx = GetTx(tx_num);
+    if (!ser_tx) {
+        return std::nullopt;
+    }
+    const BlockHeight block_height = BlockHeightByTxNum(tx_num);
+    return BlockTx{FromSerTx(*ser_tx), block_height};
+}
+
+std::optional<TxId> TxReader::TxidByTxNum(TxNum tx_num) const {
+    const std::optional<SerTx> ser_tx = GetTx(tx_num);
+    if (!ser_tx) {
+        return std::nullopt;
+    }
+    TxId txid;
+    txid.b = ser_tx->txid;
+    return txid;
+}
+
+std::vector<std::optional<TxId>>
+TxReader::TxidsByTxNums(const std::vector<TxNum> &tx_nums) const {
+    std::vector<std::optional<TxId>> out;
+    out.reserve(tx_nums.size());
+    for (const TxNum tx_num : tx_nums) {
+        out.push_back(TxidByTxNum(tx_num));
+    }
+    return out;
+}
+
+std::optional<TxNum>
+TxReader::FirstTxNumByBlock(BlockHeight block_height) const {
+    const std::optional<ByteView> bytes =
+        m_txn.Get(m_first_tx_by_blk, BhToBytes(block_height));
+    if (!bytes) {
+        return std::nullopt;
+    }
+    return BytesToTxNum(*bytes);
+}
+
+std::optional<std::pair<TxNum, TxNum>>
+TxReader::BlockTxNumRange(BlockHeight block_height) const {
+    const std::optional<TxNum> tx_num_start = FirstTxNumByBlock(block_height);
+    if (!tx_num_start) {
+        return std::nullopt;
+    }
+    TxNum tx_num_end;
+    if (const std::optional<TxNum> next = FirstTxNumByBlock(block_height + 1)) {
+        tx_num_end = *next;
+    } else if (const std::optional<TxNum> last = LastTxNum()) {
+        tx_num_end = *last + 1;
+    } else {
+        throw ChronikError("Inconsistent DB: Txs for block " +
+                           std::to_string(block_height) + " not found");
+    }
+    return std::make_pair(*tx_num_start, tx_num_end);
+}
+
+std::optional<TxNum> TxReader::LastTxNum() const {
+    const std::unique_ptr<Cursor> cursor = m_txn.OpenCursor(m_tx);
+    if (!cursor->SeekLast()) {
+        return std::nullopt;
+    }
+    return BytesToTxNum(cursor->Key());
+}
+
+BlockHeight TxReader::BlockHeightByTxNum(TxNum tx_num) const {
+    const std::unique_ptr<Cursor> cursor = m_txn.OpenCursor(m_blk_by_first_tx);
+    if (!cursor->SeekLe(TxNumToBytes(tx_num))) {
+        throw ChronikError("Inconsistent DB: Block for tx " +
+                           std::to_string(tx_num) + " not found");
+    }
+    return BytesToBh(cursor->Value());
+}
+
+} // namespace chronik::native::index
diff --git a/chronik/native/include/chronik/native/index/block_stats.h b/chronik/native/include/chronik/native/index/block_stats.h
