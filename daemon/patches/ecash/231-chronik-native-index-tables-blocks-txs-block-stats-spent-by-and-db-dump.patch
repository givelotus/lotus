@@ -0,0 +1,45 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_DEBUG_FMT_H
+#define CHRONIK_NATIVE_INDEX_DEBUG_FMT_H
+
+#include <chronik/native/codec/hex.h>
+#include <chronik/native/types.h>
+
+#include <string>
+
+/**
+ * Rust `{:?}` (Debug) renderings used inside the index error messages, so the
+ * texts match the Rust Chronik byte-for-byte.
+ */
+namespace chronik::native::index {
+
+/** Debug of a Vec<u8>, e.g. "[0, 0, 255]". */
+inline std::string DebugByteVec(ByteView bytes) {
+    std::string out = "[";
+    for (size_t i = 0; i < bytes.size(); ++i) {
+        if (i > 0) {
+            out += ", ";
+        }
+        out += std::to_string(bytes[i]);
+    }
+    out += "]";
+    return out;
+}
+
+/** Debug of a bitcoinsuite TxId: "TxId(<display hex>)". */
+inline std::string DebugTxId(const TxId &txid) {
+    return "TxId(" + HashToHex(txid) + ")";
+}
+
+/** Debug of a bitcoinsuite OutPoint. */
+inline std::string DebugOutPoint(const OutPoint &outpoint) {
+    return "OutPoint { txid: " + DebugTxId(outpoint.txid) +
+           ", out_idx: " + std::to_string(outpoint.out_idx) + " }";
+}
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_DEBUG_FMT_H
diff --git a/chronik/native/include/chronik/native/index/index_tx.h b/chronik/native/include/chronik/native/index/index_tx.h
new file mode 100644
index 0000000000000000000000000000000000000000..2cbc150501acb7a8dcfc4f67f90759df29c1f297
--- /dev/null
+++ b/chronik/native/include/chronik/native/index/index_tx.h
@@ -0,0 +1,132 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_INDEX_TX_H
+#define CHRONIK_NATIVE_INDEX_INDEX_TX_H
+
+#include <chronik/native/index/data.h>
+#include <chronik/native/store.h>
+#include <chronik/native/types.h>
+
+#include <cstddef>
+#include <deque>
+#include <optional>
+#include <span>
+#include <unordered_map>
+#include <vector>
+
+/** Port of chronik-db index_tx.rs: [`IndexTx`] and [`PrepareIndexedTxs`]. */
+namespace chronik::native::index {
+
+/**
+ * Tx in a block to be added to the index, with prepared data to guide
+ * indexing.
+ */
+struct IndexTx {
+    /** Tx from the node to be indexed. */
+    const Tx *tx = nullptr;
+    /** [`TxNum`] of this tx. */
+    TxNum tx_num{};
+    /** Whether this tx is a coinbase tx. */
+    bool is_coinbase{};
+    /**
+     * [`TxNum`]s of the inputs of the tx. Either references tx from the DB or
+     * other txs within the new block. Empty for coinbase txs.
+     */
+    std::vector<TxNum> input_nums;
+
+    bool operator==(const IndexTx &other) const {
+        return tx == other.tx && tx_num == other.tx_num &&
+               is_coinbase == other.is_coinbase &&
+               input_nums == other.input_nums;
+    }
+};
+
+/** Params for tuning the TxNumCache. */
+struct TxNumCacheSettings {
+    /** How many buckets are on the belt */
+    size_t num_buckets = 0;
+    /** How many txs are cached in each bucket */
+    size_t bucket_size = 0;
+};
+
+/**
+ * Cache for tx nums to speed up PrepareIndexedTxsCached.
+ *
+ * It works by having an internal "conveyor belt" of buckets, and each block
+ * puts all their TxId -> TxNum tuples into the bucket at the front of the
+ * belt, one-by-one. If this bucket is full, the bucket at the end of the belt
+ * is "dropped off", emptied and moved to the front, moving all other buckets
+ * one step back. Then the new empty bucket will be filled, until it is full,
+ * etc.
+ *
+ * When querying the cache, buckets are looked into one-by-one in the order on
+ * the belt.
+ *
+ * On a reorg, all buckets are simply cleared, as the goal is to speed up
+ * initial sync.
+ */
+class TxNumCache {
+public:
+    using Bucket = std::unordered_map<TxId, TxNum, Hash32Hasher>;
+
+    TxNumCache() = default;
+    /** Will allocate all the needed memory up-front. */
+    explicit TxNumCache(TxNumCacheSettings settings);
+
+    void AddToCache(std::span<const IndexTx> index_txs);
+    void Clear();
+    std::optional<TxNum> Get(const TxId &txid) const;
+
+    /** The buckets, front of the belt first (for tests). */
+    const std::deque<Bucket> &Buckets() const { return m_buckets; }
+
+private:
+    size_t m_num_buckets = 0;
+    size_t m_bucket_size = 0;
+    std::deque<Bucket> m_buckets;
+};
+
+/**
+ * Update mode of [`PrepareIndexedTxsCached`], to ensure the cache is updated
+ * correctly.
+ */
+enum class PrepareUpdateMode {
+    /** Txs are being added to the DB, will add them to the cache */
+    Add,
+    /** Txs are being removed from the DB, will clear the cache */
+    Delete,
+    /** Txs are only read from the DB, won't update the cache */
+    Read,
+};
+
+/**
+ * Prepare txs of a block which is about to be added/removed from the DB with
+ * some additional data, either coming from the DB (through `txn`) or from
+ * within the block. Uses the provided [`TxNumCache`], and puts the new TxNums
+ * into it.
+ *
+ * Throws "Unknown input spent: <OutPoint Debug>" if an input references a
+ * txid which can neither be found in the DB nor within the new block.
+ */
+std::vector<IndexTx> PrepareIndexedTxsCached(const KvStore &store,
+                                             const ReadTxn &txn,
+                                             TxNum first_tx_num,
+                                             std::span<const Tx *const> txs,
+                                             TxNumCache &cache,
+                                             PrepareUpdateMode update_mode);
+
+/** Like [`PrepareIndexedTxsCached`], but with the cache disabled. */
+std::vector<IndexTx> PrepareIndexedTxs(const KvStore &store,
+                                       const ReadTxn &txn, TxNum first_tx_num,
+                                       std::span<const Tx *const> txs);
+
+/** Convenience overload for a vector of txs (tests). */
+std::vector<IndexTx> PrepareIndexedTxs(const KvStore &store,
+                                       const ReadTxn &txn, TxNum first_tx_num,
+                                       const std::vector<Tx> &txs);
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_INDEX_TX_H
diff --git a/chronik/native/include/chronik/native/index/merge.h b/chronik/native/include/chronik/native/index/merge.h
new file mode 100644
index 0000000000000000000000000000000000000000..d4cd597cb741dda1df43f7f4e1828989bd87e2bd
--- /dev/null
+++ b/chronik/native/include/chronik/native/index/merge.h
@@ -0,0 +1,108 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_MERGE_H
+#define CHRONIK_NATIVE_INDEX_MERGE_H
+
+#include <chronik/native/store.h>
+#include <chronik/native/types.h>
+
+#include <exception>
+#include <functional>
+#include <optional>
+#include <span>
+#include <string>
+#include <utility>
+
+/**
+ * Port of chronik-db io/merge.rs.
+ *
+ * The Rust Chronik uses merge operators (RocksDB-style, emulated by its MDBX
+ * `Db` at write_batch time). Here each merge is an explicit read-modify-write
+ * inside the WriteTxn, applying all operands queued for one key in one call,
+ * so the stored bytes are exactly the ones the Rust merge produces, including
+ * its error handling (`catch_merge_errors`):
+ *  - init fails: the existing value is kept (or "" is inserted if none);
+ *  - an operand fails: the operands applied so far are kept, the rest is
+ *    dropped;
+ *  - serialization fails: like init failing.
+ * The error is not thrown but stored, and reported by CheckForErrors(), which
+ * the indexer calls after every block (Rust `merge::check_for_errors`).
+ */
+namespace chronik::native::index::merge {
+
+/** Throws (and clears) the error of a previously failed merge, if any. */
+void CheckForErrors();
+
+/** Record a failed merge (Rust `handle_err`). */
+void HandleErr(const std::string &msg);
+
+/**
+ * Optional logger for failed merges (Rust logs "MERGE ERROR: <msg>\n").
+ * Process-wide, like the stored error.
+ */
+void SetErrorLogger(std::function<void(const std::string &)> logger);
+
+/**
+ * Apply `operands` to the value at `key`, the way `catch_merge_errors`
+ * wraps a full merge.
+ *  - f_init(key, existing, num_operands) -> T
+ *  - f_apply(key, T &, operand)
+ *  - f_ser(key, T &&) -> Bytes
+ * Each may throw to signal an error.
+ */
+template <typename Init, typename Apply, typename Ser>
+void CatchMergeErrors(WriteTxn &txn, TableId table, ByteView key,
+                      std::span<const Bytes> operands, Init &&f_init,
+                      Apply &&f_apply, Ser &&f_ser) {
+    std::optional<Bytes> existing;
+    if (const std::optional<ByteView> value = txn.Get(table, key)) {
+        existing.emplace(value->begin(), value->end());
+    }
+    const std::optional<ByteView> existing_view =
+        existing ? std::optional<ByteView>(ByteView(*existing)) : std::nullopt;
+    auto put_fallback = [&] {
+        const Bytes fallback = existing ? *existing : Bytes{};
+        txn.Put(table, key, fallback);
+    };
+
+    using T = decltype(f_init(key, existing_view, operands.size()));
+    std::optional<T> value;
+    try {
+        value.emplace(f_init(key, existing_view, operands.size()));
+    } catch (const std::exception &err) {
+        HandleErr(err.what());
+        put_fallback();
+        return;
+    }
+
+    auto handle_ser = [&] {
+        Bytes ser;
+        try {
+            ser = f_ser(key, std::move(*value));
+        } catch (const std::exception &err) {
+            HandleErr(err.what());
+            put_fallback();
+            return;
+        }
+        txn.Put(table, key, ser);
+    };
+
+    for (const Bytes &operand : operands) {
+        try {
+            f_apply(key, *value, ByteView(operand));
+        } catch (const std::exception &err) {
+            // Turn failed merge op into a no-op (returns the serialized
+            // existing value)
+            HandleErr(err.what());
+            handle_ser();
+            return;
+        }
+    }
+    handle_ser();
+}
+
+} // namespace chronik::native::index::merge
+
+#endif // CHRONIK_NATIVE_INDEX_MERGE_H
diff --git a/chronik/native/include/chronik/native/index/reverse_lookup.h b/chronik/native/include/chronik/native/index/reverse_lookup.h
new file mode 100644
index 0000000000000000000000000000000000000000..d1893421c4316c7c163d12dfc538acc052c642da
--- /dev/null
+++ b/chronik/native/include/chronik/native/index/reverse_lookup.h
@@ -0,0 +1,250 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_REVERSE_LOOKUP_H
+#define CHRONIK_NATIVE_INDEX_REVERSE_LOOKUP_H
+
+#include <chronik/native/codec/postcard.h>
+#include <chronik/native/error.h>
+#include <chronik/native/index/merge.h>
+#include <chronik/native/store.h>
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+/**
+ * Port of chronik-db reverse_lookup.rs.
+ *
+ * Allows reverse-looking up data that has been indexed using a serial number
+ * (`SerialNum -> Data`, e.g. `BlockHeight -> SerBlock`), by a 32-byte key
+ * contained in the data, with the index `CheapHash -> [SerialNum]`. CheapHash
+ * is a short hash, so collisions are kept in a sorted list.
+ *
+ * `L` is the LookupColumn:
+ *   using SerialNum, Data;
+ *   static constexpr std::string_view kCfData, kCfIndex;
+ *   static constexpr std::string_view kSerialTypeName;    // e.g. "u64"
+ *   static constexpr std::string_view kSerialVecTypeName; // "alloc::vec::Vec<u64>"
+ *   static Bytes CheapHash(const std::array<uint8_t, 32> &key);
+ *   static const std::array<uint8_t, 32> &DataKey(const Data &);
+ *   static void SerSerial(postcard::Writer &, SerialNum);
+ *   static SerialNum DeserSerial(postcard::Reader &);
+ *   TableId IndexTable() const;
+ *   std::optional<Data> GetData(SerialNum) const;
+ *   std::vector<std::optional<Data>>
+ *       GetDataMulti(const std::vector<SerialNum> &) const;
+ */
+namespace chronik::native::index {
+
+using Key32 = std::array<uint8_t, 32>;
+
+template <typename L> class ReverseLookup {
+public:
+    using SerialNum = typename L::SerialNum;
+    using Data = typename L::Data;
+
+    /** Read by key from the DB using the index. */
+    static std::optional<std::pair<SerialNum, Data>>
+    Get(const L &col, const ReadTxn &txn, const Key32 &key) {
+        const Bytes cheap_hash = L::CheapHash(key);
+        // Lookup CheapHash -> [SerialNum]
+        const std::optional<ByteView> serials =
+            txn.Get(col.IndexTable(), cheap_hash);
+        if (!serials) {
+            return std::nullopt;
+        }
+        // Iterate serials, read each's data, find the one with the given key.
+        for (const SerialNum serial : DeserSerials(*serials)) {
+            std::optional<Data> value = col.GetData(serial);
+            if (!value) {
+                ThrowNotInDataColumn(serial);
+            }
+            if (L::DataKey(*value) == key) {
+                return std::make_pair(serial, std::move(*value));
+            }
+        }
+        // We have a key that collides with others but no actual match
+        return std::nullopt;
+    }
+
+    static std::vector<std::optional<std::pair<SerialNum, Data>>>
+    GetMulti(const L &col, const ReadTxn &txn, const std::vector<Key32> &keys) {
+        std::vector<std::vector<SerialNum>> serial_lists;
+        serial_lists.reserve(keys.size());
+        for (const Key32 &key : keys) {
+            const std::optional<ByteView> serials =
+                txn.Get(col.IndexTable(), L::CheapHash(key));
+            serial_lists.push_back(serials ? DeserSerials(*serials)
+                                           : std::vector<SerialNum>{});
+        }
+        std::vector<SerialNum> all_serials;
+        for (const auto &list : serial_lists) {
+            all_serials.insert(all_serials.end(), list.begin(), list.end());
+        }
+        std::vector<std::optional<Data>> data_lists =
+            col.GetDataMulti(all_serials);
+        size_t data_idx = 0;
+        std::vector<std::optional<std::pair<SerialNum, Data>>> result;
+        result.reserve(serial_lists.size());
+        for (size_t i = 0; i < serial_lists.size(); ++i) {
+            bool has_found = false;
+            for (const SerialNum serial : serial_lists[i]) {
+                if (!has_found) {
+                    std::optional<Data> &data = data_lists[data_idx];
+                    if (data && L::DataKey(*data) == keys[i]) {
+                        result.emplace_back(
+                            std::make_pair(serial, std::move(*data)));
+                        has_found = true;
+                    }
+                }
+                ++data_idx;
+            }
+            if (!has_found) {
+                result.emplace_back(std::nullopt);
+            }
+        }
+        return result;
+    }
+
+    /** Insert into the index (Rust: one merge_cf per pair). */
+    static void
+    InsertPairs(const L &col, WriteTxn &txn,
+                const std::vector<std::pair<SerialNum, Key32>> &pairs) {
+        // Operands queued on the same cheap hash within one batch are merged
+        // together, in order, like Rust's merge at write_batch time.
+        std::vector<std::pair<Bytes, std::vector<Bytes>>> by_hash;
+        std::map<Bytes, size_t> hash_idx;
+        for (const auto &[serial, key] : pairs) {
+            Bytes cheap_hash = L::CheapHash(key);
+            auto [it, inserted] = hash_idx.emplace(cheap_hash, by_hash.size());
+            if (inserted) {
+                by_hash.emplace_back(std::move(cheap_hash),
+                                     std::vector<Bytes>{});
+            }
+            Bytes operand;
+            postcard::Writer w(operand);
+            L::SerSerial(w, serial);
+            by_hash[it->second].second.push_back(std::move(operand));
+        }
+        for (const auto &[cheap_hash, operands] : by_hash) {
+            merge::CatchMergeErrors(
+                txn, col.IndexTable(), cheap_hash, operands,
+                // init_ordered_list
+                [](ByteView, std::optional<ByteView> existing, size_t n) {
+                    std::vector<SerialNum> nums;
+                    if (existing) {
+                        nums = DeserSerials(*existing);
+                    }
+                    nums.reserve(nums.size() + n);
+                    return nums;
+                },
+                // apply_ordered_list
+                [](ByteView, std::vector<SerialNum> &nums, ByteView operand) {
+                    const SerialNum num = postcard::DbDeserialize(
+                        operand, L::kSerialTypeName,
+                        [](postcard::Reader &r) { return L::DeserSerial(r); });
+                    auto it = std::lower_bound(nums.begin(), nums.end(), num);
+                    if (it != nums.end() && *it == num) {
+                        throw ChronikError(
+                            "Inconsistent DB: Tried inserting " +
+                            std::to_string(num) + " into " +
+                            std::string(L::kCfIndex) +
+                            ", but value already exists");
+                    }
+                    nums.insert(it, num);
+                },
+                // ser_ordered_list
+                [](ByteView, std::vector<SerialNum> &&nums) {
+                    return SerSerials(nums);
+                });
+        }
+    }
+
+    /** Delete from the index. */
+    static void
+    DeletePairs(const L &col, WriteTxn &txn,
+                const std::vector<std::pair<SerialNum, Key32>> &pairs) {
+        std::map<Bytes, std::set<SerialNum>> new_entries;
+        for (const auto &[serial, key] : pairs) {
+            std::set<SerialNum> &serials =
+                GetOrFetch(col, txn, new_entries, key);
+            if (serials.erase(serial) == 0) {
+                ThrowNotInDataColumn(serial);
+            }
+        }
+        for (const auto &[key, serials] : new_entries) {
+            if (serials.empty()) {
+                // Delete the entry from the DB if it doesn't contain any
+                // serials anymore
+                txn.Del(col.IndexTable(), key);
+            } else {
+                // Otherwise, override entry with only the remaining serials
+                txn.Put(col.IndexTable(), key,
+                        SerSerials(std::vector<SerialNum>(serials.begin(),
+                                                          serials.end())));
+            }
+        }
+    }
+
+    static std::vector<SerialNum> DeserSerials(ByteView bytes) {
+        return postcard::DbDeserialize(
+            bytes, L::kSerialVecTypeName, [](postcard::Reader &r) {
+                const uint64_t len = r.SeqLen();
+                std::vector<SerialNum> nums;
+                for (uint64_t i = 0; i < len; ++i) {
+                    nums.push_back(L::DeserSerial(r));
+                }
+                return nums;
+            });
+    }
+
+    static Bytes SerSerials(const std::vector<SerialNum> &nums) {
+        Bytes out;
+        postcard::Writer w(out);
+        w.SeqLen(nums.size());
+        for (const SerialNum num : nums) {
+            L::SerSerial(w, num);
+        }
+        return out;
+    }
+
+private:
+    [[noreturn]] static void ThrowNotInDataColumn(SerialNum serial) {
+        throw ChronikError("Inconsistent DB: Lookup index " +
+                           std::string(L::kCfData) + " contains " +
+                           std::to_string(serial) + ", but value column " +
+                           std::string(L::kCfIndex) + " doesn't");
+    }
+
+    /** Query from `new_entries`, or from DB and then store in `new_entries`. */
+    static std::set<SerialNum> &
+    GetOrFetch(const L &col, const ReadTxn &txn,
+               std::map<Bytes, std::set<SerialNum>> &new_entries,
+               const Key32 &key) {
+        Bytes cheap_hash = L::CheapHash(key);
+        auto it = new_entries.find(cheap_hash);
+        if (it != new_entries.end()) {
+            return it->second;
+        }
+        std::set<SerialNum> serials;
+        if (const std::optional<ByteView> bytes =
+                txn.Get(col.IndexTable(), cheap_hash)) {
+            for (const SerialNum num : DeserSerials(*bytes)) {
+                serials.insert(num);
+            }
+        }
+        return new_entries.emplace(std::move(cheap_hash), std::move(serials))
+            .first->second;
+    }
+};
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_REVERSE_LOOKUP_H
