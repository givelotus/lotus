From 79f56986279e1a26f6f5511b48bdc9179ca9e658 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 10:50:31 -0700
Subject: [PATCH] avalanche: avoid an unrelated chain lock in transaction
 notifications

The pinned ABC activation predicate does not read its block-index parameter: it checks the immutable preconsensus option and the separately synchronized finalized-tip state. Passing ActiveTip under cs_main needlessly stalls the serial validation-notification queue and RPC barrier behind ongoing validation. Use the existing nullptr-supported predicate call; preserve activation and poll registration.

Current native511 profile shows scheduler blocked here and HTTP writers waiting for notification completion. This is an inherited independent optimization, not a fixup attributed to a native patch. The regression covers both option states and both finalized-tip states, proves callback completion while cs_main remains held, and retains expected voting registration. No validation, signature, consensus or notification ordering bypass.
---
 src/avalanche/processor.cpp            |  5 ++-
 src/avalanche/test/processor_tests.cpp | 52 ++++++++++++++++++++++++++
 2 files changed, 55 insertions(+), 2 deletions(-)

diff --git a/src/avalanche/processor.cpp b/src/avalanche/processor.cpp
index c75cf98ea3987722a22f2900efd0b59444daef27..7fd4b9488323468609c8a71bacde65da2a375d66 100644
--- a/src/avalanche/processor.cpp
+++ b/src/avalanche/processor.cpp
@@ -2042,8 +2042,9 @@ void Processor::updatedBlockTip() {
 }
 
 void Processor::transactionAddedToMempool(const CTransactionRef &tx) {
-    if (isPreconsensusActivated(
-            WITH_LOCK(cs_main, return chainman.ActiveTip()))) {
+    // Activation depends on the configured gate and finalized tip, not the
+    // active chain tip. Do not serialize notifications behind chain validation.
+    if (isPreconsensusActivated(nullptr)) {
         addToReconcile(tx);
     }
 }
diff --git a/src/avalanche/test/processor_tests.cpp b/src/avalanche/test/processor_tests.cpp
index 542e7928acc572525a4e347ec3051dec32c96dd4..666c5d22db6e89bd5def3a4d513fc94f3fa773bb 100644
--- a/src/avalanche/test/processor_tests.cpp
+++ b/src/avalanche/test/processor_tests.cpp
@@ -32,6 +32,8 @@
 #include <boost/mpl/size.hpp>
 #include <boost/test/unit_test.hpp>
 
+#include <chrono>
+#include <future>
 #include <functional>
 #include <limits>
 #include <type_traits>
@@ -111,6 +113,17 @@ namespace {
 
         static void updatedBlockTip(Processor &p) { p.updatedBlockTip(); }
 
+        static void transactionAddedToMempool(Processor &p,
+                                               const CTransactionRef &tx) {
+            p.transactionAddedToMempool(tx);
+        }
+
+        static bool transactionIsRegistered(const Processor &p,
+                                              const CTransactionRef &tx) {
+            auto records = p.voteRecords.getReadView();
+            return records->find(AnyVoteItem(tx)) != records->end();
+        }
+
         static void addProofToRecentfinalized(Processor &p,
                                               const ProofId &proofid) {
             WITH_LOCK(p.cs_finalizedItems,
@@ -538,6 +551,45 @@ static_assert(boost::mpl::size<VoteItemProviders>::value ==
               boost::mpl::size<NullableVoteItemProviders>::value +
                   boost::mpl::size<Uint256VoteItemProviders>::value);
 
+BOOST_AUTO_TEST_CASE(transaction_notification_does_not_wait_for_chain_lock) {
+    auto &chainman = *m_node.chainman;
+    // This is the existing voting-only TxProvider fixture. Notification tests
+    // exercise poll registration, not chain admission or script validity.
+    TxProvider provider(this);
+    const CTransactionRef tx = provider.buildVoteItem();
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
+    const auto *tip = WITH_LOCK(cs_main, return chainman.ActiveTip());
+    BOOST_REQUIRE(tip);
+    for (const bool enabled : {false, true}) {
+        setArg("-avalanchepreconsensus", enabled ? "1" : "0");
+        for (const bool finalized : {false, true}) {
+            bilingual_str error;
+            auto processor = Processor::MakeProcessor(
+                *m_node.args, *m_node.chain, m_node.connman.get(), chainman,
+                m_node.mempool.get(), *m_node.scheduler, error);
+            BOOST_REQUIRE_MESSAGE(processor, error.original);
+            AvalancheTest::setFinalizationTip(*processor, finalized ? tip : nullptr);
+            const bool expected = enabled && finalized;
+            BOOST_CHECK_EQUAL(processor->isPreconsensusActivated(nullptr), expected);
+            BOOST_CHECK(!AvalancheTest::transactionIsRegistered(*processor, tx));
+            std::future<void> callback;
+            std::future_status status;
+            {
+                LOCK(cs_main);
+                callback = std::async(std::launch::async, [&] {
+                    AvalancheTest::transactionAddedToMempool(*processor, tx);
+                });
+                // Release the lock before joining even on a failure, so the
+                // old implementation fails this bounded check without hanging.
+                status = callback.wait_for(std::chrono::seconds(2));
+            }
+            callback.get();
+            BOOST_CHECK(status == std::future_status::ready);
+            BOOST_CHECK_EQUAL(AvalancheTest::transactionIsRegistered(*processor, tx), expected);
+        }
+    }
+}
+
 BOOST_AUTO_TEST_CASE(private_batch_polls_require_epoch_capability) {
     auto &processor = *m_node.avalanche;
     const NodeId capable = 8801, stock = 8802, shard_only = 8803;
