 contrib/logging/conversion/convert.py      | 16 +++++++--
 contrib/logging/conversion/test_convert.py | 13 +++++++
 src/logging/event.cpp                      | 21 +++++++++++
 src/logging/event.h                        | 13 ++++++-
 src/test/logging_event_tests.cpp           | 42 ++++++++++++++++++++++
 test/lint/lint-log-events.py               | 22 +++++++++---
 7 files changed, 130 insertions(+), 15 deletions(-)

