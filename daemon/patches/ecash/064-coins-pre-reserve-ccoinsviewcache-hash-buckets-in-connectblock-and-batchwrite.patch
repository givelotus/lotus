 void CCoinsViewCache::BatchWrite(CoinsViewCacheCursor &cursor,
                                  const BlockHash &hashBlockIn) {
+    const size_t target = cacheCoins.size() + (cursor.GetDirtyCount() + 1) / 2;
+    // reserve() may shrink an unordered_map. Do not rehash an already-large
+    // CoinsTip merely to merge a small child cache.
+    if (target > cacheCoins.bucket_count() * cacheCoins.max_load_factor()) {
+        cacheCoins.reserve(target);
+    }
     for (auto it{cursor.Begin()}; it != cursor.End();
          it = cursor.NextAndMaybeErase(*it)) {
         if (!it->second.IsDirty()) {
diff --git a/src/coins.h b/src/coins.h
index f63513a6cf4f48455393ebb61e1f3af38d56c0eb..92ace7b647f643808d42d9baa04a42089bdea4cb 100644
--- a/src/coins.h
+++ b/src/coins.h
@@ -506,6 +506,9 @@ public:
     //! https://stackoverflow.com/questions/42114044/how-to-release-unordered-map-memory
     void ReallocateCache();
 
+    //! Pre-allocate hash table buckets to avoid rehashes during bulk operations.
+    void Reserve(size_t count) { cacheCoins.reserve(count); }
+
     //! Run an internal sanity check on the cache data structure.
     void SanityCheck() const;
 
diff --git a/src/test/coins_tests.cpp b/src/test/coins_tests.cpp
index 296855e036012a7a0543575757c97f497f1f12b9..c35f6745e7ff4950785fd72cf959c20dff0fb7aa 100644
--- a/src/test/coins_tests.cpp
+++ b/src/test/coins_tests.cpp
@@ -103,6 +103,23 @@ public:
 
 BOOST_FIXTURE_TEST_SUITE(coins_tests, BasicTestingSetup)
 
+BOOST_AUTO_TEST_CASE(batchwrite_preserves_available_bucket_capacity) {
+    CCoinsView base;
+    CCoinsViewCacheTest parent{&base};
+    parent.Reserve(40000);
+    for (uint32_t i = 0; i < 20000; ++i) {
+        parent.map().try_emplace(COutPoint{TxId{}, i});
+    }
+    const size_t buckets = parent.map().bucket_count();
+    CCoinsViewCacheTest child{&parent};
+    CoinsViewCacheCursor cursor{child.dirty(), child.sentinel(), child.map(),
+                               /*will_erase=*/true};
+    parent.BatchWrite(cursor, BlockHash{});
+    // reserve(size + dirty/2) can shrink a large cache, needlessly walking
+    // every entry even when this child has no dirty coins at all.
+    BOOST_CHECK_EQUAL(parent.map().bucket_count(), buckets);
+}
+
 static const unsigned int NUM_SIMULATION_ITERATIONS = 40000;
 
 struct CacheTest : BasicTestingSetup {
