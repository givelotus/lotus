From 399c3d5cf2aa9602aff967024c7f4053b06d206c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] rpc: add lock-free RCU ChainAndMempoolSnapshot and O(1)
 getblocktemplate / submitminedheader

Add SnapshotPublisher RCU snapshots for lock-free read RPCs and O(1)
getblocktemplate / submitminedheader.

diff --git a/src/bench/rpc_mempool.cpp b/src/bench/rpc_mempool.cpp
index c6da10f82c45d5da17704d738dfdc53b57e80e58..00cd5182938b619d4988fcaff0fb002cafe78caf 100644
--- a/src/bench/rpc_mempool.cpp
+++ b/src/bench/rpc_mempool.cpp
@@ -47,4 +47,35 @@ static void RpcMempool(benchmark::Bench &bench) {
     bench.run([&] { (void)MempoolToJSON(pool, /*verbose*/ true); });
 }
 
+static void RpcMempoolInfo(benchmark::Bench &bench) {
+    const TestingSetup test_setup{
+        ChainType::MAIN,
+        /* extra_args */
+        {
+            "-nodebuglogfile",
+            "-nodebug",
+        },
+    };
+    CTxMemPool &pool = *Assert(test_setup.m_node.mempool);
+    {
+        LOCK2(cs_main, pool.cs);
+        for (int i = 0; i < 1000; ++i) {
+            CMutableTransaction tx = CMutableTransaction();
+            tx.vin.resize(1);
+            tx.vin[0].scriptSig = CScript() << OP_1;
+            tx.vout.resize(1);
+            tx.vout[0].scriptPubKey = CScript() << OP_1 << OP_EQUAL;
+            tx.vout[0].nValue = i * COIN;
+            const CTransactionRef tx_r{MakeTransactionRef(tx)};
+            AddTx(tx_r, /* fee */ i * COIN, pool);
+        }
+    }
+
+    bench.run([&] {
+        auto info = MempoolInfoToJSON(pool);
+        ankerl::nanobench::doNotOptimizeAway(info);
+    });
+}
+
 BENCHMARK(RpcMempool);
+BENCHMARK(RpcMempoolInfo);
