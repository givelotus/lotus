+class MdbxBackend final : public IDBBackend {
+    friend class MdbxIterator;
+
+private:
+    MDBX_env *m_env{nullptr};
+    MDBX_dbi m_dbi{0};
+    mutable std::mutex m_read_txn_mutex;
+    mutable std::vector<MDBX_txn *> m_read_txn_pool;
+    mutable std::vector<MDBX_cursor *> m_read_cursor_pool;
+    fs::path m_active_path;
+    bool m_is_memory{false};
+
+    MDBX_txn *AcquireReadTxn() const {
+        {
+            std::lock_guard<std::mutex> lock(m_read_txn_mutex);
+            if (!m_read_txn_pool.empty()) {
+                MDBX_txn *txn = m_read_txn_pool.back();
+                m_read_txn_pool.pop_back();
+                int rc = mdbx_txn_renew(txn);
+                if (rc == MDBX_SUCCESS) {
+                    return txn;
+                }
+                mdbx_txn_abort(txn);
+                HandleMdbxError(rc, "mdbx_txn_renew(read)");
+            }
+        }
+        MDBX_txn *txn = nullptr;
+        int rc = mdbx_txn_begin(m_env, nullptr, MDBX_TXN_RDONLY, &txn);
+        HandleMdbxError(rc, "mdbx_txn_begin(read)");
+        return txn;
+    }
+
+    void ReleaseReadTxn(MDBX_txn *txn) const noexcept {
+        if (!txn) {
+            return;
+        }
+        if (mdbx_txn_reset(txn) != MDBX_SUCCESS) {
+            mdbx_txn_abort(txn);
+            return;
+        }
+        std::lock_guard<std::mutex> lock(m_read_txn_mutex);
+        if (m_read_txn_pool.size() < 64) {
+            m_read_txn_pool.push_back(txn);
+        } else {
+            mdbx_txn_abort(txn);
+        }
+    }
+
+    MDBX_cursor *AcquireReadCursor(MDBX_txn *txn) const {
+        MDBX_cursor *cursor = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(m_read_txn_mutex);
+            if (!m_read_cursor_pool.empty()) {
+                cursor = m_read_cursor_pool.back();
+                m_read_cursor_pool.pop_back();
+            }
+        }
+        if (!cursor) {
+            cursor = mdbx_cursor_create(nullptr);
+            if (!cursor) {
+                HandleMdbxError(MDBX_ENOMEM, "mdbx_cursor_create");
+            }
+        }
+        int rc = mdbx_cursor_bind(txn, cursor, m_dbi);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_cursor_close(cursor);
+            HandleMdbxError(rc, "mdbx_cursor_bind");
+        }
+        return cursor;
+    }
+
+    void ReleaseReadCursor(MDBX_cursor *cursor) const noexcept {
+        if (!cursor) {
+            return;
+        }
+        if (mdbx_cursor_unbind(cursor) != MDBX_SUCCESS) {
+            mdbx_cursor_close(cursor);
+            return;
+        }
+        std::lock_guard<std::mutex> lock(m_read_txn_mutex);
+        if (m_read_cursor_pool.size() < 64) {
+            m_read_cursor_pool.push_back(cursor);
+        } else {
+            mdbx_cursor_close(cursor);
+        }
+    }
+
+    void Sync() {
+        if (!m_is_memory && m_env) {
+            int rc = mdbx_env_sync_ex(m_env, true, false);
+            if (rc != MDBX_SUCCESS && rc != MDBX_RESULT_TRUE) {
+                HandleMdbxError(rc, "mdbx_env_sync_ex");
+            }
+        }
+    }
+
+    void MigrateFromLevelDBIfPresent(const fs::path &dir, size_t cache_bytes) {
+        std::error_code ec;
+        if (!std::filesystem::exists(dir / "CURRENT", ec)) {
+            return;
+        }
+        LogPrintf("Migrating LevelDB database in %s to libmdbx...\n",
+                  fs::PathToString(dir));
+
+        leveldb::Options ldb_opts = GetLevelDBOptions(cache_bytes);
+        ldb_opts.create_if_missing = false;
+        leveldb::DB *ldb = nullptr;
+        leveldb::Status status =
+            leveldb::DB::Open(ldb_opts, fs::PathToString(dir), &ldb);
+        auto cleanup_ldb = [&]() {
+            delete ldb;
+            ldb = nullptr;
+            delete ldb_opts.filter_policy;
+            ldb_opts.filter_policy = nullptr;
+            delete ldb_opts.info_log;
+            ldb_opts.info_log = nullptr;
+            delete ldb_opts.block_cache;
+            ldb_opts.block_cache = nullptr;
+        };
+        if (!status.ok()) {
+            cleanup_ldb();
+            HandleLevelDBError(status);
+        }
+
+        leveldb::ReadOptions iter_opts;
+        iter_opts.verify_checksums = true;
+        iter_opts.fill_cache = false;
+        std::unique_ptr<leveldb::Iterator> it(ldb->NewIterator(iter_opts));
+
+        MDBX_txn *txn = nullptr;
+        int rc = mdbx_txn_begin(m_env, nullptr, MDBX_TXN_READWRITE, &txn);
+        if (rc != MDBX_SUCCESS) {
+            it.reset();
+            cleanup_ldb();
+            HandleMdbxError(rc, "mdbx_txn_begin(migrate)");
+        }
+
+        MDBX_cursor *cursor = nullptr;
+        rc = mdbx_cursor_open(txn, m_dbi, &cursor);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_txn_abort(txn);
+            it.reset();
+            cleanup_ldb();
+            HandleMdbxError(rc, "mdbx_cursor_open(migrate)");
+        }
+
+        size_t total_keys = 0;
+        size_t chunk_bytes = 0;
+        for (it->SeekToFirst(); it->Valid(); it->Next()) {
+            const leveldb::Slice slKey = it->key();
+            const leveldb::Slice slVal = it->value();
+            MDBX_val k{const_cast<char *>(slKey.data()), slKey.size()};
+            MDBX_val v{const_cast<char *>(slVal.data()), slVal.size()};
+            // LevelDB iterates in strict memcmp order, allowing MDBX_APPEND for
+            // bottom-up B+Tree construction without page splits.
+            rc = mdbx_cursor_put(cursor, &k, &v, MDBX_APPEND);
+            if (rc != MDBX_SUCCESS) {
+                rc = mdbx_cursor_put(cursor, &k, &v, MDBX_UPSERT);
+            }
+            if (rc != MDBX_SUCCESS) {
+                mdbx_cursor_close(cursor);
+                mdbx_txn_abort(txn);
+                it.reset();
+                cleanup_ldb();
+                HandleMdbxError(rc, "mdbx_cursor_put(migrate)");
+            }
+            ++total_keys;
+            chunk_bytes += slKey.size() + slVal.size();
+            if (chunk_bytes >= (32 << 20)) {
+                mdbx_cursor_close(cursor);
+                cursor = nullptr;
+                rc = mdbx_txn_commit(txn);
+                txn = nullptr;
+                if (rc != MDBX_SUCCESS) {
+                    it.reset();
+                    cleanup_ldb();
+                    HandleMdbxError(rc, "mdbx_txn_commit(migrate)");
+                }
+                rc = mdbx_txn_begin(m_env, nullptr, MDBX_TXN_READWRITE, &txn);
+                if (rc != MDBX_SUCCESS) {
+                    it.reset();
+                    cleanup_ldb();
+                    HandleMdbxError(rc, "mdbx_txn_begin(migrate)");
+                }
+                rc = mdbx_cursor_open(txn, m_dbi, &cursor);
+                if (rc != MDBX_SUCCESS) {
+                    mdbx_txn_abort(txn);
+                    it.reset();
+                    cleanup_ldb();
+                    HandleMdbxError(rc, "mdbx_cursor_open(migrate)");
+                }
+                chunk_bytes = 0;
+            }
+        }
+
+        const leveldb::Status iter_status = it->status();
+        it.reset();
+        mdbx_cursor_close(cursor);
+        if (!iter_status.ok()) {
+            mdbx_txn_abort(txn);
+            cleanup_ldb();
+            HandleLevelDBError(iter_status);
+        }
+        rc = mdbx_txn_commit(txn);
+        cleanup_ldb();
+        HandleMdbxError(rc, "mdbx_txn_commit(migrate)");
+
+        // Move legacy LevelDB files to leveldb.bak now that migration is committed.
+        MoveLevelDBFilesToBackup(dir);
+        {
+            std::ofstream lock_marker(dir / "LOCK",
+                                      std::ios::out | std::ios::trunc);
+        }
+        LogPrintf("Migrated %zu keys from LevelDB to libmdbx in %s (backed up LevelDB to leveldb.bak)\n",
+                  total_keys, fs::PathToString(dir));
+    }
+
+public:
+    explicit MdbxBackend(const DBParams &params)
+        : m_is_memory{params.memory_only} {
+        if (m_is_memory) {
+            const uint64_t id = ++g_mem_db_counter;
+            m_active_path =
+                fs::temp_directory_path() /
+                fs::PathFromString(
+                    strprintf("lotus_mdbx_mem_%d_%llu",
+                              static_cast<int>(getpid()),
+                              static_cast<unsigned long long>(id)));
+            std::error_code ec;
+            fs::remove_all(m_active_path, ec);
+            TryCreateDirectories(m_active_path);
+        } else {
+            m_active_path = params.path;
+            if (params.wipe_data) {
+                LogPrintf("Wiping libmdbx in %s\n",
+                          fs::PathToString(m_active_path));
+                WipeAllDbFilesInDir(m_active_path);
+            }
+            TryCreateDirectories(m_active_path);
+            LogPrintf("Opening libmdbx in %s\n",
+                      fs::PathToString(m_active_path));
+        }
+
+        int rc = mdbx_env_create(&m_env);
+        HandleMdbxError(rc, "mdbx_env_create");
+
+        rc = mdbx_env_set_maxreaders(m_env, 256);
+        HandleMdbxError(rc, "mdbx_env_set_maxreaders");
+
+        rc = mdbx_env_set_maxdbs(m_env, 4);
+        HandleMdbxError(rc, "mdbx_env_set_maxdbs");
+
+        const intptr_t size_lower = 1LL << 20; // 1 MiB
+        const intptr_t size_now =
+            m_is_memory ? (4LL << 20) : (16LL << 20); // 4 MiB or 16 MiB
+        const intptr_t size_upper =
+            m_is_memory ? (4LL << 30) : (256LL << 30); // 4 GiB or 256 GiB
+        const intptr_t growth_step =
+            m_is_memory ? (16LL << 20) : (64LL << 20); // 16 MiB or 64 MiB
+        const intptr_t shrink_threshold =
+            m_is_memory ? (32LL << 20) : (128LL << 20); // 32 MiB or 128 MiB
+        const intptr_t pagesize = 8192;
+
+        rc = mdbx_env_set_geometry(m_env, size_lower, size_now, size_upper,
+                                   growth_step, shrink_threshold, pagesize);
+        HandleMdbxError(rc, "mdbx_env_set_geometry");
+
+        const MDBX_env_flags_t env_flags = static_cast<MDBX_env_flags_t>(
+            MDBX_WRITEMAP | MDBX_UTTERLY_NOSYNC | MDBX_NOMETASYNC |
+            MDBX_LIFORECLAIM | MDBX_NOSTICKYTHREADS | MDBX_NOMEMINIT);
+
+        rc = mdbx_env_open(m_env, fs::PathToString(m_active_path).c_str(),
+                           env_flags, 0600);
+        HandleMdbxError(rc, "mdbx_env_open");
+
+        {
+            MDBX_txn *txn = nullptr;
+            rc = mdbx_txn_begin(m_env, nullptr, MDBX_TXN_READWRITE, &txn);
+            HandleMdbxError(rc, "mdbx_txn_begin(init)");
+            rc = mdbx_dbi_open(txn, nullptr, MDBX_CREATE, &m_dbi);
+            if (rc != MDBX_SUCCESS) {
+                mdbx_txn_abort(txn);
+                HandleMdbxError(rc, "mdbx_dbi_open");
+            }
+            rc = mdbx_txn_commit(txn);
+            HandleMdbxError(rc, "mdbx_txn_commit(init)");
+        }
+
+        if (!m_is_memory) {
+            if (!params.wipe_data) {
+                MigrateFromLevelDBIfPresent(m_active_path, params.cache_bytes);
+            }
+            {
+                std::ofstream lock_marker(m_active_path / "LOCK",
+                                          std::ios::out | std::ios::trunc);
+            }
+            LogPrintf("Opened libmdbx successfully\n");
+        }
+    }
+
+    ~MdbxBackend() override {
+        {
+            std::lock_guard<std::mutex> lock(m_read_txn_mutex);
+            for (MDBX_cursor *cursor : m_read_cursor_pool) {
+                if (cursor) {
+                    mdbx_cursor_close(cursor);
+                }
+            }
+            m_read_cursor_pool.clear();
+            for (MDBX_txn *txn : m_read_txn_pool) {
+                if (txn) {
+                    mdbx_txn_abort(txn);
+                }
+            }
+            m_read_txn_pool.clear();
+        }
+        if (m_env) {
+            mdbx_env_close_ex(m_env, m_is_memory);
+            m_env = nullptr;
+        }
+        if (m_is_memory && !m_active_path.empty()) {
+            std::error_code ec;
+            fs::remove_all(m_active_path, ec);
+        }
+    }
+
+    bool Read(Span<const uint8_t> key,
+              std::vector<uint8_t> &value) const override {
+        MDBX_val k{const_cast<uint8_t *>(key.data()), key.size()};
+        MDBX_val v{nullptr, 0};
+
+        MDBX_txn *txn = AcquireReadTxn();
+        int rc = mdbx_get(txn, m_dbi, &k, &v);
+        if (rc == MDBX_SUCCESS) {
+            const auto *ptr = static_cast<const uint8_t *>(v.iov_base);
+            value.assign(ptr, ptr + v.iov_len);
+            ReleaseReadTxn(txn);
+            return true;
+        }
+        ReleaseReadTxn(txn);
+        if (rc == MDBX_NOTFOUND) {
+            return false;
+        }
+        HandleMdbxError(rc, "mdbx_get");
+        return false;
+    }
+
+    bool Exists(Span<const uint8_t> key) const override {
+        MDBX_val k{const_cast<uint8_t *>(key.data()), key.size()};
+        MDBX_val v{nullptr, 0};
+
+        MDBX_txn *txn = AcquireReadTxn();
+        int rc = mdbx_get(txn, m_dbi, &k, &v);
+        ReleaseReadTxn(txn);
+        if (rc == MDBX_SUCCESS) {
+            return true;
+        }
+        if (rc == MDBX_NOTFOUND) {
+            return false;
+        }
+        HandleMdbxError(rc, "mdbx_get(exists)");
+        return false;
+    }
+
+    void WriteBatch(IDBBatch &batch, bool fSync) override {
+        auto &mdbx_batch = static_cast<MdbxBatch &>(batch);
+        if (mdbx_batch.m_ops.empty()) {
+            if (fSync) {
+                Sync();
+            }
+            return;
+        }
+
+        if (mdbx_batch.m_ops.size() > 1) {
+            std::stable_sort(mdbx_batch.m_ops.begin(), mdbx_batch.m_ops.end(),
+                             [](const MdbxBatch::BatchOp &a,
+                                const MdbxBatch::BatchOp &b) {
+                                 return a.key < b.key;
+                             });
+        }
+
+        MDBX_txn *txn = nullptr;
+        int rc = mdbx_txn_begin(m_env, nullptr, MDBX_TXN_READWRITE, &txn);
+        HandleMdbxError(rc, "mdbx_txn_begin(write)");
+
+        MDBX_cursor *cursor = nullptr;
+        rc = mdbx_cursor_open(txn, m_dbi, &cursor);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_txn_abort(txn);
+            HandleMdbxError(rc, "mdbx_cursor_open(write)");
+        }
+
+        const size_t n = mdbx_batch.m_ops.size();
+        for (size_t i = 0; i < n; ++i) {
+            if (i + 1 < n &&
+                mdbx_batch.m_ops[i].key == mdbx_batch.m_ops[i + 1].key) {
+                continue;
+            }
+            const auto &op = mdbx_batch.m_ops[i];
+            MDBX_val k{const_cast<uint8_t *>(op.key.data()), op.key.size()};
+            if (op.is_delete) {
+                rc = mdbx_del(txn, m_dbi, &k, nullptr);
+                if (rc != MDBX_SUCCESS && rc != MDBX_NOTFOUND) {
+                    mdbx_cursor_close(cursor);
+                    mdbx_txn_abort(txn);
+                    HandleMdbxError(rc, "mdbx_del");
+                }
+            } else {
+                MDBX_val v{const_cast<uint8_t *>(op.value.data()),
+                           op.value.size()};
+                rc = mdbx_cursor_put(cursor, &k, &v, MDBX_UPSERT);
+                if (rc != MDBX_SUCCESS) {
+                    mdbx_cursor_close(cursor);
+                    mdbx_txn_abort(txn);
+                    HandleMdbxError(rc, "mdbx_cursor_put");
+                }
+            }
+        }
+
+        mdbx_cursor_close(cursor);
+        rc = mdbx_txn_commit(txn);
+        HandleMdbxError(rc, "mdbx_txn_commit(write)");
+
+        if (fSync) {
+            Sync();
+        }
+    }
+
+    size_t DynamicMemoryUsage() const override { return sizeof(*this); }
+
+    std::unique_ptr<IDBIterator> NewIterator() const override {
+        return std::make_unique<MdbxIterator>(*this);
+    }
+
+    std::unique_ptr<IDBBatch> NewBatch() const override {
+        return std::make_unique<MdbxBatch>();
+    }
+
+    size_t EstimateSize(Span<const uint8_t> key_begin,
+                        Span<const uint8_t> key_end) const override {
+        MDBX_txn *txn = AcquireReadTxn();
+        MDBX_stat stat{};
+        int rc = mdbx_dbi_stat(txn, m_dbi, &stat, sizeof(stat));
+        if (rc != MDBX_SUCCESS || stat.ms_entries == 0) {
+            ReleaseReadTxn(txn);
+            return 0;
+        }
+        const size_t total_bytes = (stat.ms_branch_pages + stat.ms_leaf_pages +
+                                    stat.ms_overflow_pages) *
+                                   stat.ms_psize;
+        MDBX_val k1{const_cast<uint8_t *>(key_begin.data()), key_begin.size()};
+        MDBX_val k2{const_cast<uint8_t *>(key_end.data()), key_end.size()};
+        ptrdiff_t dist = 0;
+        rc = mdbx_estimate_range(txn, m_dbi, &k1, nullptr, &k2, nullptr, &dist);
+        ReleaseReadTxn(txn);
+        if (rc == MDBX_SUCCESS && dist > 0) {
+            const double frac = std::min(1.0, static_cast<double>(dist) /
+                                                  static_cast<double>(
+                                                      stat.ms_entries));
+            return static_cast<size_t>(total_bytes * frac);
+        }
+        return total_bytes;
+    }
+
+    void CompactRange(Span<const uint8_t> key_begin,
+                      Span<const uint8_t> key_end) const override {
+        (void)key_begin;
+        (void)key_end;
+    }
+};
