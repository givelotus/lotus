+class LevelDBBatch final : public IDBBatch {
+public:
+    leveldb::WriteBatch batch;
+
+    void Clear() override { batch.Clear(); }
+
+    void Write(Span<const uint8_t> key, Span<const uint8_t> value) override {
+        leveldb::Slice slKey(reinterpret_cast<const char *>(key.data()),
+                             key.size());
+        leveldb::Slice slValue(reinterpret_cast<const char *>(value.data()),
+                               value.size());
+        batch.Put(slKey, slValue);
+    }
+
+    void Erase(Span<const uint8_t> key) override {
+        leveldb::Slice slKey(reinterpret_cast<const char *>(key.data()),
+                             key.size());
+        batch.Delete(slKey);
+    }
+};
