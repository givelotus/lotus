+/* Copyright (c) 2026 The Lotus developers
+ * Distributed under the MIT software license, see the accompanying
+ * file COPYING or http://www.opensource.org/licenses/mit-license.php. */
+
+#ifndef LOTUS_LIBMDBX_MDBX_BATCH_H
+#define LOTUS_LIBMDBX_MDBX_BATCH_H
+
+#include "mdbx.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** \brief Batch key-value operation descriptor for mdbx_batch_kv_apply(). */
+typedef struct MDBX_batch_kv_op {
+  const void *key_ptr;
+  size_t key_len;
+  const void *val_ptr;
+  size_t val_len;
+  uint32_t is_delete;
+} MDBX_batch_kv_op;
+
+/** \brief Batch DUPSORT operation descriptor for mdbx_batch_dup_apply(). */
+typedef struct MDBX_batch_dup_op {
+  const void *key_ptr;
+  size_t key_len;
+  const void *val_ptr;
+  size_t val_len;
+  /** 0 = put, 1 = delete exact (key + val), 2 = delete by 12-byte prefix */
+  uint32_t op_kind;
+} MDBX_batch_dup_op;
+
+/** \brief Apply a batch of sorted put/delete operations using a single bound cursor. */
+LIBMDBX_API int mdbx_batch_kv_apply(MDBX_txn *txn, MDBX_dbi dbi,
+                                    const MDBX_batch_kv_op *ops, size_t n_ops);
+
+/** \brief Apply a batch of sorted DUPSORT put/delete operations using a single bound cursor. */
+LIBMDBX_API int mdbx_batch_dup_apply(MDBX_txn *txn, MDBX_dbi dbi,
+                                     const MDBX_batch_dup_op *ops, size_t n_ops);
+
+/** \brief Execute a batch of point lookups in a single call. */
+LIBMDBX_API int mdbx_batch_multi_get(MDBX_txn *txn, MDBX_dbi dbi,
+                                     const MDBX_val *keys, MDBX_val *vals_out,
+                                     int *rcs_out, size_t n_keys);
+
+/** \brief Fetch contiguous MDBX_DUPFIXED pages for a key in a single call. */
+LIBMDBX_API int mdbx_dupfixed_get_pages(MDBX_cursor *cursor,
+                                        const MDBX_val *key, size_t elem_size,
+                                        MDBX_val *pages_out, size_t max_pages,
+                                        size_t *n_pages_out);
+
+/** \brief Fetch contiguous MDBX_DUPFIXED pages at current cursor position. */
+LIBMDBX_API int mdbx_dupfixed_get_current_pages(MDBX_cursor *cursor,
+                                                size_t elem_size,
+                                                MDBX_val *pages_out,
+                                                size_t max_pages,
+                                                size_t *n_pages_out);
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+
+#endif /* LOTUS_LIBMDBX_MDBX_BATCH_H */
diff --git a/src/test/dbwrapper_tests.cpp b/src/test/dbwrapper_tests.cpp
index a6b5b3f8fa..7aea33a0cc 100644
--- a/src/test/dbwrapper_tests.cpp
+++ b/src/test/dbwrapper_tests.cpp
@@ -474,4 +474,110 @@ BOOST_AUTO_TEST_CASE(unicodepath) {
     BOOST_CHECK(fs::exists(lockPath));
 }
 
+BOOST_AUTO_TEST_CASE(mdbx_backend_and_migration) {
+    // 1. Test explicit DBBackend::MDBX operations (write, batch, iterator, obfuscation).
+    for (const bool obfuscate : {false, true}) {
+        fs::path ph = m_args.GetDataDirBase() /
+                      (obfuscate ? "mdbx_explicit_obf_true"
+                                 : "mdbx_explicit_obf_false");
+        CDBWrapper dbw({.path = ph,
+                        .cache_bytes = 1 << 20,
+                        .memory_only = false,
+                        .wipe_data = true,
+                        .obfuscate = obfuscate,
+                        .backend = DBBackend::MDBX});
+        BOOST_CHECK(fs::exists(ph / "mdbx.dat"));
+
+        uint8_t k1{'a'};
+        uint256 v1 = m_rng.rand256();
+        uint8_t k2{'b'};
+        uint256 v2 = m_rng.rand256();
+        uint8_t k3{'c'};
+        uint256 v3 = m_rng.rand256();
+
+        CDBBatch batch(dbw);
+        batch.Write(k1, v1);
+        batch.Write(k2, v2);
+        batch.Write(k3, v3);
+        batch.Erase(k3);
+        dbw.WriteBatch(batch);
+
+        uint256 res;
+        BOOST_CHECK(dbw.Read(k1, res));
+        BOOST_CHECK_EQUAL(res, v1);
+        BOOST_CHECK(dbw.Read(k2, res));
+        BOOST_CHECK_EQUAL(res, v2);
+        BOOST_CHECK(!dbw.Read(k3, res));
+
+        std::unique_ptr<CDBIterator> it(dbw.NewIterator());
+        it->Seek(k1);
+        BOOST_REQUIRE(it->Valid());
+        uint8_t ikey{0};
+        uint256 ival;
+        BOOST_CHECK(it->GetKey(ikey));
+        BOOST_CHECK_EQUAL(ikey, k1);
+        BOOST_CHECK(it->GetValue(ival));
+        BOOST_CHECK_EQUAL(ival, v1);
+        it->Next();
+        BOOST_REQUIRE(it->Valid());
+        BOOST_CHECK(it->GetKey(ikey));
+        BOOST_CHECK_EQUAL(ikey, k2);
+        it->Next();
+        BOOST_CHECK(!it->Valid());
+    }
+
+    // 2. Test automatic migration: LevelDB -> MDBX -> LevelDB on the same directory.
+    fs::path mig_path = m_args.GetDataDirBase() / "dbwrapper_backend_migration";
+    uint256 expected_a = m_rng.rand256();
+    uint256 expected_b = m_rng.rand256();
+    {
+        CDBWrapper ldb({.path = mig_path,
+                        .cache_bytes = 1 << 20,
+                        .memory_only = false,
+                        .wipe_data = true,
+                        .obfuscate = true,
+                        .backend = DBBackend::LEVELDB});
+        ldb.Write(std::string("key_a"), expected_a);
+        ldb.Write(std::string("key_b"), expected_b);
+        BOOST_CHECK(fs::exists(mig_path / "CURRENT"));
+        BOOST_CHECK(!fs::exists(mig_path / "mdbx.dat"));
+    }
+    {
+        // Reopening with DBBackend::MDBX automatically migrates LevelDB -> libmdbx
+        // and moves the original LevelDB files to leveldb.bak/.
+        CDBWrapper mdb({.path = mig_path,
+                        .cache_bytes = 1 << 20,
+                        .memory_only = false,
+                        .wipe_data = false,
+                        .obfuscate = true,
+                        .backend = DBBackend::MDBX});
+        BOOST_CHECK(fs::exists(mig_path / "mdbx.dat"));
+        BOOST_CHECK(!fs::exists(mig_path / "CURRENT"));
+        BOOST_CHECK(fs::exists(mig_path / "leveldb.bak" / "CURRENT"));
+        uint256 got_a, got_b;
+        BOOST_CHECK(mdb.Read(std::string("key_a"), got_a));
+        BOOST_CHECK_EQUAL(got_a, expected_a);
+        BOOST_CHECK(mdb.Read(std::string("key_b"), got_b));
+        BOOST_CHECK_EQUAL(got_b, expected_b);
+    }
+    {
+        // Reopening with DBBackend::LEVELDB automatically migrates libmdbx -> LevelDB
+        // and moves the mdbx files to mdbx.bak/.
+        CDBWrapper ldb2({.path = mig_path,
+                         .cache_bytes = 1 << 20,
+                         .memory_only = false,
+                         .wipe_data = false,
+                         .obfuscate = true,
+                         .backend = DBBackend::LEVELDB});
+        BOOST_CHECK(fs::exists(mig_path / "CURRENT"));
+        BOOST_CHECK(!fs::exists(mig_path / "mdbx.dat"));
+        BOOST_CHECK(fs::exists(mig_path / "mdbx.bak" / "mdbx.dat"));
+        uint256 got_a, got_b;
+        BOOST_CHECK(ldb2.Read(std::string("key_a"), got_a));
+        BOOST_CHECK_EQUAL(got_a, expected_a);
+        BOOST_CHECK(ldb2.Read(std::string("key_b"), got_b));
+        BOOST_CHECK_EQUAL(got_b, expected_b);
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
