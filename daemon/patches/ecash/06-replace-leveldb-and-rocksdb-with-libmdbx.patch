+                                                "mdbx_put(merge)",
+                                            )
+                                            .into());
+                                        }
+                                    }
+                                }
+                                None => {
+                                    rc = ffi::mdbx_del(
+                                        txn,
+                                        dbi,
+                                        &k,
+                                        ptr::null(),
+                                    );
+                                    if rc != ffi::MDBX_SUCCESS
+                                        && rc != ffi::MDBX_NOTFOUND
