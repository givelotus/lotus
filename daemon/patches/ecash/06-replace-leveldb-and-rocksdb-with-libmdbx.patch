+class LevelDBBackend final : public IDBBackend {
+private:
+    leveldb::Env *penv{nullptr};
+    leveldb::Options options;
+    leveldb::ReadOptions readoptions;
+    leveldb::ReadOptions iteroptions;
+    leveldb::WriteOptions writeoptions;
+    leveldb::WriteOptions syncoptions;
+    leveldb::DB *pdb{nullptr};
+    std::string m_name;
+
+    void MigrateFromMdbxIfPresent(const fs::path &dir) {
+        std::error_code ec;
+        if (!std::filesystem::exists(dir / "mdbx.dat", ec)) {
+            return;
+        }
+        LogPrintf("Migrating libmdbx database in %s to LevelDB...\n",
+                  fs::PathToString(dir));
+
+        MDBX_env *env = nullptr;
+        int rc = mdbx_env_create(&env);
+        HandleMdbxError(rc, "mdbx_env_create(migrate)");
+        rc = mdbx_env_set_maxdbs(env, 4);
+        HandleMdbxError(rc, "mdbx_env_set_maxdbs(migrate)");
+        rc = mdbx_env_open(
+            env, fs::PathToString(dir).c_str(),
+            static_cast<MDBX_env_flags_t>(MDBX_RDONLY | MDBX_NOSTICKYTHREADS),
+            0600);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_env_close_ex(env, true);
+            HandleMdbxError(rc, "mdbx_env_open(migrate)");
+        }
+
+        MDBX_txn *txn = nullptr;
+        rc = mdbx_txn_begin(env, nullptr, MDBX_TXN_RDONLY, &txn);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_env_close_ex(env, true);
+            HandleMdbxError(rc, "mdbx_txn_begin(migrate)");
+        }
+
+        MDBX_dbi dbi = 0;
+        rc = mdbx_dbi_open(txn, nullptr, MDBX_DB_DEFAULTS, &dbi);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_txn_abort(txn);
+            mdbx_env_close_ex(env, true);
+            HandleMdbxError(rc, "mdbx_dbi_open(migrate)");
+        }
+
+        MDBX_cursor *cursor = nullptr;
+        rc = mdbx_cursor_open(txn, dbi, &cursor);
+        if (rc != MDBX_SUCCESS) {
+            mdbx_txn_abort(txn);
+            mdbx_env_close_ex(env, true);
+            HandleMdbxError(rc, "mdbx_cursor_open(migrate)");
+        }
+
+        leveldb::WriteBatch batch;
+        size_t batch_bytes = 0;
+        size_t total_keys = 0;
+        MDBX_val k{nullptr, 0};
+        MDBX_val v{nullptr, 0};
+        rc = mdbx_cursor_get(cursor, &k, &v, MDBX_FIRST);
+        while (rc == MDBX_SUCCESS) {
+            batch.Put(leveldb::Slice(static_cast<const char *>(k.iov_base),
+                                     k.iov_len),
+                      leveldb::Slice(static_cast<const char *>(v.iov_base),
+                                     v.iov_len));
+            batch_bytes += k.iov_len + v.iov_len;
+            ++total_keys;
+            if (batch_bytes >= (4 << 20)) {
+                leveldb::Status status = pdb->Write(writeoptions, &batch);
+                if (!status.ok()) {
+                    mdbx_cursor_close(cursor);
+                    mdbx_txn_abort(txn);
+                    mdbx_env_close_ex(env, true);
+                    HandleLevelDBError(status);
+                }
+                batch.Clear();
+                batch_bytes = 0;
+            }
+            rc = mdbx_cursor_get(cursor, &k, &v, MDBX_NEXT);
+        }
+        mdbx_cursor_close(cursor);
+        mdbx_txn_abort(txn);
+        mdbx_env_close_ex(env, true);
+
+        if (rc != MDBX_NOTFOUND) {
+            HandleMdbxError(rc, "mdbx_cursor_get(migrate)");
+        }
+
+        if (batch_bytes > 0 || total_keys > 0) {
+            leveldb::Status status = pdb->Write(syncoptions, &batch);
+            HandleLevelDBError(status);
+        }
+
+        MoveMdbxFilesToBackup(dir);
+        LogPrintf("Migrated %zu keys from libmdbx to LevelDB in %s (backed up mdbx to mdbx.bak)\n",
+                  total_keys, fs::PathToString(dir));
+    }
+
+public:
+    explicit LevelDBBackend(const DBParams &params)
+        : m_name{fs::PathToString(params.path.stem())} {
+        readoptions.verify_checksums = true;
+        iteroptions.verify_checksums = true;
+        iteroptions.fill_cache = false;
+        syncoptions.sync = true;
+        options = GetLevelDBOptions(params.cache_bytes);
+        options.create_if_missing = true;
+        if (params.memory_only) {
+            penv = leveldb::NewMemEnv(leveldb::Env::Default());
+            options.env = penv;
+        } else {
+            if (params.wipe_data) {
+                LogPrintf("Wiping LevelDB in %s\n",
+                          fs::PathToString(params.path));
+                WipeMdbxFilesInDir(params.path);
+                leveldb::Status result =
+                    leveldb::DestroyDB(fs::PathToString(params.path), options);
+                HandleLevelDBError(result);
+            } else {
+                std::error_code ec;
+                if (std::filesystem::exists(params.path / "mdbx.dat", ec) &&
+                    std::filesystem::exists(params.path / "CURRENT", ec)) {
+                    MoveLevelDBFilesToBackup(params.path);
+                }
+            }
+            TryCreateDirectories(params.path);
+            LogPrintf("Opening LevelDB in %s\n", fs::PathToString(params.path));
+        }
+
+        leveldb::Status status =
+            leveldb::DB::Open(options, fs::PathToString(params.path), &pdb);
+        HandleLevelDBError(status);
+        LogPrintf("Opened LevelDB successfully\n");
+
+        if (!params.memory_only && !params.wipe_data) {
+            MigrateFromMdbxIfPresent(params.path);
+        }
+
+        if (params.options.force_compact) {
+            LogPrintf("Starting database compaction of %s\n",
+                      fs::PathToString(params.path));
+            pdb->CompactRange(nullptr, nullptr);
+            LogPrintf("Finished database compaction of %s\n",
+                      fs::PathToString(params.path));
+        }
+    }
+
+    ~LevelDBBackend() override {
+        delete pdb;
+        pdb = nullptr;
+        delete options.filter_policy;
+        options.filter_policy = nullptr;
+        delete options.info_log;
+        options.info_log = nullptr;
+        delete options.block_cache;
+        options.block_cache = nullptr;
+        delete penv;
+        options.env = nullptr;
+    }
+
+    bool Read(Span<const uint8_t> key,
+              std::vector<uint8_t> &value) const override {
+        leveldb::Slice slKey(reinterpret_cast<const char *>(key.data()),
+                             key.size());
+        std::string strValue;
+        leveldb::Status status = pdb->Get(readoptions, slKey, &strValue);
+        if (!status.ok()) {
+            if (status.IsNotFound()) {
+                return false;
+            }
+            LogPrintf("LevelDB read failure: %s\n", status.ToString());
+            HandleLevelDBError(status);
+        }
+        value.assign(reinterpret_cast<const uint8_t *>(strValue.data()),
+                     reinterpret_cast<const uint8_t *>(strValue.data()) +
+                         strValue.size());
+        return true;
+    }
+
+    bool Exists(Span<const uint8_t> key) const override {
+        leveldb::Slice slKey(reinterpret_cast<const char *>(key.data()),
+                             key.size());
+        std::string strValue;
+        leveldb::Status status = pdb->Get(readoptions, slKey, &strValue);
+        if (!status.ok()) {
+            if (status.IsNotFound()) {
+                return false;
+            }
+            LogPrintf("LevelDB read failure: %s\n", status.ToString());
+            HandleLevelDBError(status);
+        }
+        return true;
+    }
+
+    void WriteBatch(IDBBatch &batch, bool fSync) override {
+        auto &ldb_batch = static_cast<LevelDBBatch &>(batch);
+        const bool log_memory =
+            LogAcceptCategory(BCLog::LEVELDB, BCLog::Level::Debug);
+        double mem_before = 0;
+        if (log_memory) {
+            mem_before = DynamicMemoryUsage() / 1024.0 / 1024;
+        }
+        leveldb::Status status =
+            pdb->Write(fSync ? syncoptions : writeoptions, &ldb_batch.batch);
+        HandleLevelDBError(status);
+        if (log_memory) {
+            double mem_after = DynamicMemoryUsage() / 1024.0 / 1024;
+            LogDebug(BCLog::LEVELDB,
+                     "WriteBatch memory usage: db=%s, before=%.1fMiB, "
+                     "after=%.1fMiB\n",
+                     m_name, mem_before, mem_after);
+        }
+    }
+
+    size_t DynamicMemoryUsage() const override {
+        std::string memory;
+        if (!pdb->GetProperty("leveldb.approximate-memory-usage", &memory)) {
+            LogDebug(BCLog::LEVELDB,
+                     "Failed to get approximate-memory-usage property\n");
+            return 0;
+        }
+        return stoul(memory);
+    }
+
+    std::unique_ptr<IDBIterator> NewIterator() const override {
+        return std::make_unique<LevelDBIterator>(pdb->NewIterator(iteroptions));
+    }
+
+    std::unique_ptr<IDBBatch> NewBatch() const override {
+        return std::make_unique<LevelDBBatch>();
+    }
+
+    size_t EstimateSize(Span<const uint8_t> key_begin,
+                        Span<const uint8_t> key_end) const override {
+        leveldb::Slice slKey1(reinterpret_cast<const char *>(key_begin.data()),
+                              key_begin.size());
+        leveldb::Slice slKey2(reinterpret_cast<const char *>(key_end.data()),
+                              key_end.size());
+        uint64_t size = 0;
+        leveldb::Range range(slKey1, slKey2);
+        pdb->GetApproximateSizes(&range, 1, &size);
+        return size;
+    }
+
+    void CompactRange(Span<const uint8_t> key_begin,
+                      Span<const uint8_t> key_end) const override {
+        leveldb::Slice slKey1(reinterpret_cast<const char *>(key_begin.data()),
+                              key_begin.size());
+        leveldb::Slice slKey2(reinterpret_cast<const char *>(key_end.data()),
+                              key_end.size());
+        pdb->CompactRange(&slKey1, &slKey2);
+    }
+};
