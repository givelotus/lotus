+                                    });
+                                }
+                                DupOp::Put(val) => {
+                                    dup_batch_ops.push(ffi::MDBX_batch_dup_op {
+                                        key_ptr,
+                                        key_len,
+                                        val_ptr: val.as_ptr() as *const c_void,
+                                        val_len: val.len(),
+                                        op_kind: 0,
+                                    });
+                                }
+                                DupOp::Delete { fixed_dup_size } => {
+                                    let (val_len, op_kind) =
+                                        if *fixed_dup_size == Some(12) {
