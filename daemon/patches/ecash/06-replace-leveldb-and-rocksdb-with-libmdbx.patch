+type FullMergeFn = Arc<
+    dyn Fn(&[u8], Option<&[u8]>, &MergeOperands) -> Option<Vec<u8>>
+        + Send
+        + Sync,
+>;
+type CompactionFilterFn =
+    Arc<dyn Fn(u32, &[u8], &[u8]) -> compaction_filter::Decision + Send + Sync>;
+
+/// Column family configuration options supporting both RocksDB and `libmdbx`.
+#[derive(Default)]
+pub struct Options {
+    rocks_options: rocksdb::Options,
+    full_merge: Option<FullMergeFn>,
+    compaction_filter: Option<CompactionFilterFn>,
+    dupsort: bool,
+    dupfixed: bool,
+}
+
+impl std::fmt::Debug for Options {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Options")
+            .field("has_merge", &self.full_merge.is_some())
+            .field("has_compaction_filter", &self.compaction_filter.is_some())
+            .field("dupsort", &self.dupsort)
+            .field("dupfixed", &self.dupfixed)
+            .finish()
+    }
+}
+
+impl Options {
+    /// Configure this column family to use native `MDBX_DUPSORT` (and optionally
+    /// `MDBX_DUPFIXED` when duplicate values have a constant byte size) when
+    /// running under the `libmdbx` backend.
+    pub fn set_dupsort(&mut self, dupfixed: bool) {
+        self.dupsort = true;
+        self.dupfixed = dupfixed;
+    }
+
+    /// Register a merge operator for this column family.
+    pub fn set_merge_operator<F, P>(
+        &mut self,
+        name: &str,
+        full_merge_fn: F,
+        partial_merge_fn: P,
+    ) where
+        F: Fn(&[u8], Option<&[u8]>, &MergeOperands) -> Option<Vec<u8>>
+            + Send
+            + Sync
+            + 'static,
+        P: Fn(&[u8], Option<&[u8]>, &MergeOperands) -> Option<Vec<u8>>
+            + Send
+            + Sync
+            + 'static,
+    {
+        let full_arc: FullMergeFn = Arc::new(full_merge_fn);
+        let full_for_rocks = Arc::clone(&full_arc);
+        let partial_arc = Arc::new(partial_merge_fn);
+        self.rocks_options.set_merge_operator(
+            name,
+            move |key, existing, operands| {
+                let ops = MergeOperands {
+                    operands: operands.iter().map(|op| op.to_vec()).collect(),
+                };
+                full_for_rocks(key, existing, &ops)
+            },
+            move |key, existing, operands| {
+                let ops = MergeOperands {
+                    operands: operands.iter().map(|op| op.to_vec()).collect(),
+                };
+                partial_arc(key, existing, &ops)
+            },
+        );
+        self.full_merge = Some(full_arc);
+    }
+
+    /// Register a compaction filter for this column family.
+    pub fn set_compaction_filter<F>(&mut self, name: &str, filter_fn: F)
+    where
+        F: Fn(u32, &[u8], &[u8]) -> compaction_filter::Decision
+            + Send
+            + Sync
+            + 'static,
+    {
+        let filter_arc: CompactionFilterFn = Arc::new(filter_fn);
+        let filter_for_rocks = Arc::clone(&filter_arc);
+        self.rocks_options.set_compaction_filter(
+            name,
+            move |level, key, value| match filter_for_rocks(level, key, value) {
+                compaction_filter::Decision::Keep => {
+                    rocksdb::compaction_filter::Decision::Keep
+                }
+                compaction_filter::Decision::Remove => {
+                    rocksdb::compaction_filter::Decision::Remove
+                }
+            },
+        );
+        self.compaction_filter = Some(filter_arc);
+    }
+}
