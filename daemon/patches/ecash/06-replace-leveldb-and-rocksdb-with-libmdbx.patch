+                                kv_batch_ops.push(ffi::MDBX_batch_kv_op {
+                                    key_ptr: key.as_ptr() as *const c_void,
+                                    key_len: key.len(),
+                                    val_ptr: val.as_ptr() as *const c_void,
+                                    val_len: val.len(),
+                                    is_delete: 0,
+                                });
+                            }
+                            KeyOp::Delete => {
+                                kv_batch_ops.push(ffi::MDBX_batch_kv_op {
+                                    key_ptr: key.as_ptr() as *const c_void,
