+enum DbIter<'a> {
+    Rocks(rocksdb::DBIteratorWithThreadMode<'a, rocksdb::DB>),
+    Mdbx(MdbxIter<'a>),
+}
+
+impl Iterator for DbIter<'_> {
+    type Item = DbIterItem;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            DbIter::Rocks(iter) => {
+                iter.next().map(|res| res.map_err(|e| rocks_err(e).into()))
+            }
+            DbIter::Mdbx(iter) => iter.next(),
+        }
+    }
+}
