+/// Storage engine backend used when opening a Chronik [`Db`].
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DbBackend {
+    /// Default RocksDB storage backend.
+    RocksDb = 0,
+    /// Memory-mapped B+Tree `libmdbx` storage backend.
+    Mdbx = 1,
+}
+
+static DEFAULT_DB_BACKEND: AtomicU8 = AtomicU8::new(DbBackend::RocksDb as u8);
+
+/// Configure the default Chronik database backend (called once at startup).
+pub fn set_default_db_backend(backend: DbBackend) {
+    DEFAULT_DB_BACKEND.store(backend as u8, Ordering::Relaxed);
+}
+
+/// Query the configured default Chronik database backend.
+pub fn default_db_backend() -> DbBackend {
+    if DEFAULT_DB_BACKEND.load(Ordering::Relaxed) == DbBackend::Mdbx as u8 {
+        DbBackend::Mdbx
+    } else {
+        DbBackend::RocksDb
+    }
+}
