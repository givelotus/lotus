+        MDBX_val v{nullptr, 0};
+        int rc = mdbx_cursor_get(m_cursor, &k, &v, MDBX_FIRST);
+        if (rc == MDBX_SUCCESS) {
+            m_key_ptr = static_cast<const uint8_t *>(k.iov_base);
+            m_key_len = k.iov_len;
+            m_val_ptr = static_cast<const uint8_t *>(v.iov_base);
+            m_val_len = v.iov_len;
+            m_valid = true;
+        } else {
+            m_valid = false;
+        }
+    }
+
+    void Seek(Span<const uint8_t> key) override {
+        MDBX_val k{const_cast<uint8_t *>(key.data()), key.size()};
+        MDBX_val v{nullptr, 0};
+        int rc = mdbx_cursor_get(m_cursor, &k, &v, MDBX_SET_RANGE);
+        if (rc == MDBX_SUCCESS) {
+            m_key_ptr = static_cast<const uint8_t *>(k.iov_base);
+            m_key_len = k.iov_len;
+            m_val_ptr = static_cast<const uint8_t *>(v.iov_base);
+            m_val_len = v.iov_len;
+            m_valid = true;
+        } else {
+            m_valid = false;
+        }
+    }
+
+    void Next() override {
+        if (!m_valid) {
+            return;
+        }
+        MDBX_val k{nullptr, 0};
+        MDBX_val v{nullptr, 0};
+        int rc = mdbx_cursor_get(m_cursor, &k, &v, MDBX_NEXT);
+        if (rc == MDBX_SUCCESS) {
+            m_key_ptr = static_cast<const uint8_t *>(k.iov_base);
+            m_key_len = k.iov_len;
+            m_val_ptr = static_cast<const uint8_t *>(v.iov_base);
+            m_val_len = v.iov_len;
+            m_valid = true;
+        } else {
+            m_valid = false;
+        }
+    }
+
+    Span<const uint8_t> GetKey() const override {
+        return Span<const uint8_t>(m_key_ptr, m_key_len);
+    }
+
+    Span<const uint8_t> GetValue() const override {
+        return Span<const uint8_t>(m_val_ptr, m_val_len);
+    }
