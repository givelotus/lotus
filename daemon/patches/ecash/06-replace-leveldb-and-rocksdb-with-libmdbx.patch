+
+            let mut k = ffi::MDBX_val {
+                iov_base: ptr::null_mut(),
+                iov_len: 0,
+            };
+            let mut v = ffi::MDBX_val {
+                iov_base: ptr::null_mut(),
+                iov_len: 0,
+            };
+
+            let (rc, next_op) = match mode {
+                IteratorMode::Start => (
+                    ffi::mdbx_cursor_get(
+                        cursor,
+                        &mut k,
+                        &mut v,
+                        ffi::MDBX_FIRST,
+                    ),
+                    ffi::MDBX_NEXT,
+                ),
+                IteratorMode::End => (
+                    ffi::mdbx_cursor_get(
+                        cursor,
+                        &mut k,
+                        &mut v,
+                        ffi::MDBX_LAST,
+                    ),
+                    ffi::MDBX_PREV,
+                ),
+                IteratorMode::From(start, Direction::Forward) => {
+                    if start.is_empty() {
+                        (
+                            ffi::mdbx_cursor_get(
+                                cursor,
+                                &mut k,
+                                &mut v,
+                                ffi::MDBX_FIRST,
+                            ),
+                            ffi::MDBX_NEXT,
+                        )
+                    } else {
+                        let norm = normalize_key(start);
+                        k.iov_base = norm.as_ptr() as *mut c_void;
+                        k.iov_len = norm.len();
+                        (
+                            ffi::mdbx_cursor_get(
+                                cursor,
+                                &mut k,
+                                &mut v,
+                                ffi::MDBX_SET_RANGE,
+                            ),
+                            ffi::MDBX_NEXT,
+                        )
+                    }
+                }
+                IteratorMode::From(start, Direction::Reverse) => {
+                    let norm = normalize_key(start);
+                    k.iov_base = norm.as_ptr() as *mut c_void;
+                    k.iov_len = norm.len();
+                    (
+                        ffi::mdbx_cursor_get(
+                            cursor,
+                            &mut k,
+                            &mut v,
+                            ffi::MDBX_TO_KEY_LESSER_OR_EQUAL,
+                        ),
+                        ffi::MDBX_PREV,
+                    )
+                }
+            };
+
+            if rc == ffi::MDBX_SUCCESS || rc == ffi::MDBX_RESULT_TRUE {
+                let item = Self::extract_kv(k, v);
+                MdbxIter {
+                    mdbx,
+                    txn,
+                    cursor,
+                    next_op,
+                    first_item: Some(Ok(item)),
+                    done: false,
+                }
+            } else {
+                mdbx.release_read_cursor(cursor);
+                mdbx.release_read_txn(txn);
+                let first_item =
+                    if rc != ffi::MDBX_NOTFOUND && rc != ffi::MDBX_ENODATA {
+                        Some(Err(mdbx_err(rc, "mdbx_cursor_get").into()))
+                    } else {
+                        None
+                    };
+                MdbxIter {
+                    mdbx,
+                    txn: ptr::null_mut(),
+                    cursor: ptr::null_mut(),
+                    next_op,
+                    first_item,
+                    done: true,
+                }
+            }
+        }
+    }
+
+    #[inline]
+    unsafe fn extract_kv(
+        k: ffi::MDBX_val,
+        v: ffi::MDBX_val,
+    ) -> (Box<[u8]>, Box<[u8]>) {
+        let k_slice = if k.iov_len == 0 {
+            &[]
+        } else {
+            slice::from_raw_parts(k.iov_base as *const u8, k.iov_len)
+        };
+        let v_slice = if v.iov_len == 0 {
+            &[]
+        } else {
+            slice::from_raw_parts(v.iov_base as *const u8, v.iov_len)
+        };
+        (Box::from(k_slice), Box::from(v_slice))
+    }
+
+    unsafe fn close_handles(&mut self) {
+        if !self.cursor.is_null() {
+            self.mdbx.release_read_cursor(self.cursor);
+            self.cursor = ptr::null_mut();
+        }
+        if !self.txn.is_null() {
+            self.mdbx.release_read_txn(self.txn);
+            self.txn = ptr::null_mut();
+        }
+    }
+}
