+class MdbxBatch final : public IDBBatch {
+public:
+    struct BatchOp {
+        std::vector<uint8_t> key;
+        std::vector<uint8_t> value;
+        bool is_delete{false};
+    };
+
+    std::vector<BatchOp> m_ops;
+
+    void Clear() override { m_ops.clear(); }
+
+    void Write(Span<const uint8_t> key, Span<const uint8_t> value) override {
+        BatchOp op;
+        op.key.assign(key.begin(), key.end());
+        op.value.assign(value.begin(), value.end());
+        op.is_delete = false;
+        m_ops.push_back(std::move(op));
+    }
+
+    void Erase(Span<const uint8_t> key) override {
+        BatchOp op;
+        op.key.assign(key.begin(), key.end());
+        op.is_delete = true;
+        m_ops.push_back(std::move(op));
+    }
+};
