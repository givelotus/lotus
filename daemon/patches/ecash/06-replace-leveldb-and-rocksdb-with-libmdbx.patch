+MdbxIterator::MdbxIterator(const MdbxBackend &backend) : m_backend(backend) {
+    m_txn = m_backend.AcquireReadTxn();
+    try {
+        m_cursor = m_backend.AcquireReadCursor(m_txn);
+    } catch (...) {
+        m_backend.ReleaseReadTxn(m_txn);
+        m_txn = nullptr;
+        throw;
+    }
+}
+
+MdbxIterator::~MdbxIterator() {
+    if (m_cursor) {
+        m_backend.ReleaseReadCursor(m_cursor);
+        m_cursor = nullptr;
+    }
+    if (m_txn) {
+        m_backend.ReleaseReadTxn(m_txn);
+        m_txn = nullptr;
+    }
+}
