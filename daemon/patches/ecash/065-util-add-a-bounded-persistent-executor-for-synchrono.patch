From 8710cb0736d4a1adcf05e3b6c4feff692d6098ab Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 06:17:53 -0700
Subject: [PATCH] util: add a bounded persistent executor for synchronous range
 work

Keep one active job and no task queue. Concurrent submissions execute on their own caller, avoiding RPC worker waits behind another batch. Recursive submissions run inline, including recursion through another executor. Drain every worker before propagating callback exceptions and join workers at executor destruction.

Prerequisite for recovering shared RPC batch decoding worker reuse from original 5a626227c2 without depending on native signing machinery or the later staged admission API. Utility tests cover worker reuse through TLS lifetime, contention, recursion and exception recovery. Tests are prepared; execution awaits the coordinated build grant.

Coordinator historical decoder recovery (2026-10-21):
Separate host-neutral prerequisite for the recovered owner70 decoder. One active job, no task queue, bounded persistent workers, caller fallback for contention/recursion, drained exception propagation and joined lifetime. No alias, RPC dispatcher dependency or future native signer API. This utility is a distinct purpose, not hidden inside a codec repair.

diff --git a/src/test/util_tests.cpp b/src/test/util_tests.cpp
index ab282195535cebf5b4266145c61b26b022fbfaf3..bab68db0ab2239da25e04d5e273fbbdcc4cc87da 100644
--- a/src/test/util_tests.cpp
+++ b/src/test/util_tests.cpp
@@ -20,6 +20,11 @@
 #include <util/fs_helpers.h>
 #include <util/moneystr.h>
 #include <util/overflow.h>
+#include <util/parallel_range.h>
+
+#include <atomic>
+#include <future>
+#include <stdexcept>
 #include <util/strencodings.h>
 #include <util/string.h>
 #include <util/time.h>
@@ -3290,4 +3295,61 @@ BOOST_AUTO_TEST_CASE(mib_string_literal_test) {
         HasReason("MiB value too large for size_t byte conversion"));
 }
 
+BOOST_AUTO_TEST_CASE(parallel_range_reuses_workers_and_drains_errors) {
+    util::ParallelRangeExecutor executor(2);
+    std::atomic<size_t> visits{0};
+    std::atomic<size_t> new_threads{0};
+    for (size_t pass = 0; pass < 4; ++pass) {
+        executor.Run(64, 8, [&](size_t begin, size_t end) {
+            // A new thread has fresh TLS even when its OS thread ID is reused.
+            thread_local const void *seen = nullptr;
+            if (seen != &executor) {
+                seen = &executor;
+                ++new_threads;
+            }
+            visits += end - begin;
+        });
+    }
+    BOOST_CHECK_EQUAL(visits.load(), 256);
+    BOOST_CHECK_EQUAL(new_threads.load(),
+                      std::min<size_t>(2, std::max<size_t>(1,
+                          std::thread::hardware_concurrency())));
+    BOOST_CHECK_THROW(executor.Run(64, 8, [](size_t begin, size_t) {
+        if (begin != 0) throw std::runtime_error("worker failure");
+        throw std::runtime_error("caller failure");
+    }), std::runtime_error);
+    visits = 0;
+    std::atomic<size_t> bad_nested_ranges{0};
+    executor.Run(65, 8, [&](size_t begin, size_t end) {
+        visits += end - begin;
+        executor.Run(3, 1, [&](size_t nested_begin, size_t nested_end) {
+            if (nested_begin != 0 || nested_end != 3) ++bad_nested_ranges;
+        });
+    });
+    BOOST_CHECK_EQUAL(visits.load(), 65);
+    BOOST_CHECK_EQUAL(bad_nested_ranges.load(), 0);
+}
+
+BOOST_AUTO_TEST_CASE(parallel_range_contended_submission_runs_on_caller) {
+    util::ParallelRangeExecutor executor(2);
+    std::promise<void> started, release;
+    auto released = release.get_future().share();
+    std::thread first([&] {
+        executor.Run(64, 8, [&](size_t begin, size_t) {
+            if (begin == 0) started.set_value();
+            released.wait();
+        });
+    });
+    started.get_future().wait();
+    const auto caller = std::this_thread::get_id();
+    size_t visits = 0;
+    executor.Run(64, 8, [&](size_t begin, size_t end) {
+        BOOST_CHECK(std::this_thread::get_id() == caller);
+        visits += end - begin;
+    });
+    release.set_value();
+    first.join();
+    BOOST_CHECK_EQUAL(visits, 64);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/util/parallel_range.h b/src/util/parallel_range.h
new file mode 100644
index 0000000000000000000000000000000000000000..ddad285b0d339b52347e95c9482a9832664586c4
--- /dev/null
+++ b/src/util/parallel_range.h
@@ -0,0 +1,134 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#ifndef BITCOIN_UTIL_PARALLEL_RANGE_H
+#define BITCOIN_UTIL_PARALLEL_RANGE_H
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstddef>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace util {
+
+/** Synchronous range work with persistent, bounded workers and no task queue.
+ * Concurrent or recursive submissions run on their caller instead of waiting
+ * for the executor. Callers must finish before destroying the executor.
+ */
+class ParallelRangeExecutor {
+    using Work = std::function<void(size_t, size_t)>;
+    std::mutex m_dispatch, m_mutex;
+    std::condition_variable m_start, m_done;
+    std::vector<std::thread> m_workers;
+    const Work *m_work{nullptr};
+    size_t m_count{0}, m_participants{0}, m_remaining{0}, m_generation{0};
+    std::exception_ptr m_error;
+    bool m_stop{false};
+    struct Activation {
+        const ParallelRangeExecutor *executor;
+        const Activation *previous;
+    };
+    inline static thread_local const Activation *s_active{nullptr};
+
+    void Execute(size_t worker) noexcept {
+        const Activation activation{this, s_active};
+        s_active = &activation;
+        try {
+            const size_t chunk = m_count / m_participants;
+            const size_t remainder = m_count % m_participants;
+            const size_t begin = worker * chunk + std::min(worker, remainder);
+            const size_t end = begin + chunk + (worker < remainder);
+            (*m_work)(begin, end);
+        } catch (...) {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (!m_error) m_error = std::current_exception();
+        }
+        s_active = activation.previous;
+    }
+
+    void Worker(size_t worker) {
+        size_t generation = 0;
+        for (;;) {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_start.wait(lock, [&] { return m_stop || generation != m_generation; });
+            if (m_stop) return;
+            generation = m_generation;
+            if (worker >= m_participants) continue;
+            lock.unlock();
+            Execute(worker);
+            lock.lock();
+            if (--m_remaining == 0) m_done.notify_one();
+        }
+    }
+
+    void Stop() noexcept {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stop = true;
+        }
+        m_start.notify_all();
+        for (auto &worker : m_workers) worker.join();
+    }
+
+public:
+    explicit ParallelRangeExecutor(size_t max_participants = 8) {
+        const size_t participants = std::min(
+            std::max<size_t>(max_participants, 1),
+            std::max<size_t>(std::thread::hardware_concurrency(), 1));
+        m_workers.reserve(participants - 1);
+        try {
+            for (size_t i = 1; i < participants; ++i) {
+                m_workers.emplace_back([this, i] { Worker(i); });
+            }
+        } catch (...) {
+            Stop();
+            throw;
+        }
+    }
+
+    ~ParallelRangeExecutor() { Stop(); }
+
+    template <typename Fn> void Run(size_t count, size_t grain, Fn &&fn) {
+        if (count == 0) return;
+        grain = std::max<size_t>(grain, 1);
+        const size_t participants = std::min(
+            m_workers.size() + 1, count / grain + (count % grain != 0));
+        bool recursive = false;
+        for (const auto *active = s_active; active; active = active->previous) {
+            recursive |= active->executor == this;
+        }
+        if (participants <= 1 || recursive) {
+            fn(0, count);
+            return;
+        }
+        std::unique_lock<std::mutex> dispatch(m_dispatch, std::try_to_lock);
+        if (!dispatch.owns_lock()) {
+            fn(0, count);
+            return;
+        }
+        const Work work(std::forward<Fn>(fn));
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_work = &work;
+            m_count = count;
+            m_participants = participants;
+            m_remaining = participants - 1;
+            m_error = nullptr;
+            ++m_generation;
+        }
+        m_start.notify_all();
+        Execute(0);
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_done.wait(lock, [&] { return m_remaining == 0; });
+        m_work = nullptr;
+        if (m_error) std::rethrow_exception(m_error);
+    }
+};
+
+} // namespace util
+#endif // BITCOIN_UTIL_PARALLEL_RANGE_H
