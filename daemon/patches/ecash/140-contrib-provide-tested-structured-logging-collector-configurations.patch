diff --git a/contrib/logging/fluent-bit.conf b/contrib/logging/fluent-bit.conf
new file mode 100644
index 0000000000000000000000000000000000000000..843d362b356a27993c037d59f7486d995e3f0246
--- /dev/null
+++ b/contrib/logging/fluent-bit.conf
@@ -0,0 +1,17 @@
+# lotusd: -logformat=json -debuglogfile=/var/log/lotus/debug.jsonl
+[SERVICE]
+    Flush        1
+    Parsers_File /etc/lotus-logging/fluent-bit-parsers.conf
+[INPUT]
+    Name         tail
+    Path         /var/log/lotus/debug.jsonl
+    Tag          lotus
+    Parser       lotus_json
+    Read_from_Head On
+    DB           /var/lib/fluent-bit/lotus.db
+    Buffer_Chunk_Size 64K
+    Buffer_Max_Size 1M
+[OUTPUT]
+    Name         stdout
+    Match        lotus
+    Format       json_lines
diff --git a/contrib/logging/promtail.yaml b/contrib/logging/promtail.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..0ed4b045fbca4d851aeae85613bec9a49e1f6a45
--- /dev/null
+++ b/contrib/logging/promtail.yaml
@@ -0,0 +1,27 @@
+# lotusd: -logformat=json -debuglogfile=/var/log/lotus/debug.jsonl
+server:
+  http_listen_port: 9080
+  grpc_listen_port: 0
+positions:
+  filename: /var/lib/promtail/positions.yaml
+clients:
+  - url: http://127.0.0.1:3100/loki/api/v1/push
+scrape_configs:
+  - job_name: lotus
+    static_configs:
+      - targets: [localhost]
+        labels:
+          job: lotus
+          __path__: /var/log/lotus/debug.jsonl
+    pipeline_stages:
+      - json:
+          expressions:
+            level: level
+            category: category
+            time: time
+      - labels:
+          level:
+          category:
+      - timestamp:
+          source: time
+          format: RFC3339Nano
diff --git a/contrib/logging/rsyslog.conf b/contrib/logging/rsyslog.conf
new file mode 100644
index 0000000000000000000000000000000000000000..a28f6a703ba8c5929b1e4f5644572db3c95cd545
--- /dev/null
+++ b/contrib/logging/rsyslog.conf
@@ -0,0 +1,16 @@
+# lotusd: -logformat=json -debuglogfile=/var/log/lotus/debug.jsonl
+module(load="imfile")
+module(load="mmjsonparse")
+global(workDirectory="/var/lib/rsyslog")
+template(name="LotusJSON" type="string" string="%$!all-json%\n")
+ruleset(name="lotus") {
+    action(type="mmjsonparse" cookie="")
+    if $parsesuccess == "OK" then {
+        action(type="omfile" file="/var/log/lotus/collected.jsonl"
+               template="LotusJSON")
+    }
+    stop
+}
+input(type="imfile" File="/var/log/lotus/debug.jsonl"
+      Tag="lotus" Severity="info" Facility="daemon" Ruleset="lotus"
+      PersistStateInterval="100")
diff --git a/contrib/logging/vector.toml b/contrib/logging/vector.toml
new file mode 100644
index 0000000000000000000000000000000000000000..e8e0b6dd03fb09785ec920c63aaa1b20b79adbd2
--- /dev/null
+++ b/contrib/logging/vector.toml
@@ -0,0 +1,19 @@
+# lotusd: -logformat=json -debuglogfile=/var/log/lotus/debug.jsonl
+[sources.lotus]
+type = "file"
+include = ["/var/log/lotus/debug.jsonl"]
+read_from = "beginning"
+
+[transforms.lotus_json]
+type = "remap"
+inputs = ["lotus"]
+source = '''
+. = parse_json!(.message)
+.timestamp = parse_timestamp!(.time, format: "%+")
+'''
+
+# Replace/add your normal backend sink. Console is runnable for inspection.
+[sinks.console]
+type = "console"
+inputs = ["lotus_json"]
+encoding.codec = "json"
