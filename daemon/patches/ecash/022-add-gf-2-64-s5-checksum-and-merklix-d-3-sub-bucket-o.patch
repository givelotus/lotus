+    }
+    const uint8_t parent_bits = static_cast<uint8_t>(depth_bits - 4);
+    const uint16_t prefix_mask =
+        static_cast<uint16_t>((1U << parent_bits) - 1U);
+    const uint16_t masked_prefix = parent_prefix & prefix_mask;
