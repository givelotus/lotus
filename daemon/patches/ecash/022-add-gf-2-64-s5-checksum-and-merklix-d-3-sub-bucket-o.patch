+
     MerklixSubBucketSummary sub;
     sub.scope = static_cast<uint8_t>(scope);
     sub.context_id = context_id;
     sub.salt_k0 = salt_k0;
     sub.salt_k1 = salt_k1;
-    sub.parent_bucket = parent_bucket & 0x0f;
+    sub.depth_bits = depth_bits;
+    sub.parent_prefix = masked_prefix;
