From 0c506a0c6c6086f9a194e0e85ab5b794d803e603 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] net: add GF(2^64) s5 checksum and Merklix d>=3 sub-bucket
 overflow bisection

Add the degree-5 GF(2^64) s5 syndrome checksum to eliminate false-positive
degree-2 Berlekamp-Massey root decodes and bisect overflowing Merklix
sub-buckets to depth 12 and 16.

diff --git a/src/lotus_v2/set_reconciliation.h b/src/lotus_v2/set_reconciliation.h
index 8e82307e4861fe89a164ba4392387fd97b36138e..d58a693e45e2b1ef4ea4631ee9da180e07d35c74 100644
--- a/src/lotus_v2/set_reconciliation.h
+++ b/src/lotus_v2/set_reconciliation.h
@@ -47,6 +47,7 @@ inline constexpr uint64_t GF64Add(uint64_t a, uint64_t b) noexcept {
 uint64_t GF64Mul(uint64_t a, uint64_t b) noexcept;
 uint64_t GF64Sqr(uint64_t a) noexcept;
 uint64_t GF64Cube(uint64_t a) noexcept;
+uint64_t GF64Pow5(uint64_t a) noexcept;
 uint64_t GF64Inv(uint64_t a) noexcept;
 uint64_t GF64Trace(uint64_t a) noexcept;
 
@@ -57,18 +58,19 @@ uint64_t GF64Trace(uint64_t a) noexcept;
 bool GF64SolveQuadratic(uint64_t c, uint64_t &y_out) noexcept;
 
 // ============================================================================
-// Degree-2 BCH Bucket Syndrome over GF(2^64)
+// Degree-2 BCH Bucket Syndrome with s5 Checksum over GF(2^64)
 // ============================================================================
 
 enum class ReconcileStatus {
     Identical, // d = 0 differences
-    Decoded,   // d = 1 or d = 2 differences recovered exactly
+    Decoded,   // d = 1 or d = 2 differences recovered and s5-verified
     Overflow,  // d >= 3 differences in bucket (requires fallback/subdivision)
 };
 
 struct BucketSyndrome {
     uint64_t s1{0}; // XOR sum of x
     uint64_t s3{0}; // XOR sum of x^3
+    uint64_t s5{0}; // XOR sum of x^5
 
     void Add(uint64_t short_id) noexcept {
         if (short_id == 0) {
@@ -76,6 +78,7 @@ struct BucketSyndrome {
         }
         s1 ^= short_id;
         s3 ^= GF64Cube(short_id);
+        s5 ^= GF64Pow5(short_id);
     }
 
     void Remove(uint64_t short_id) noexcept {
@@ -83,10 +86,10 @@ struct BucketSyndrome {
     }
 
     BucketSyndrome SymmetricDifference(const BucketSyndrome &other) const noexcept {
-        return BucketSyndrome{s1 ^ other.s1, s3 ^ other.s3};
+        return BucketSyndrome{s1 ^ other.s1, s3 ^ other.s3, s5 ^ other.s5};
     }
 
-    bool IsZero() const noexcept { return s1 == 0 && s3 == 0; }
+    bool IsZero() const noexcept { return s1 == 0 && s3 == 0 && s5 == 0; }
 };
 
 struct BucketDecodeResult {
@@ -95,10 +98,10 @@ struct BucketDecodeResult {
 };
 
 /**
- * Decode a symmetric-difference BucketSyndrome (delta_s1, delta_s3):
+ * Decode a symmetric-difference BucketSyndrome (delta_s1, delta_s3, delta_s5):
  *   - d = 0: status = Identical, roots = {}
- *   - d = 1: status = Decoded,   roots = {x1}
- *   - d = 2: status = Decoded,   roots = {x1, x2} (sorted)
+ *   - d = 1: status = Decoded,   roots = {x1} (verified against delta_s5)
+ *   - d = 2: status = Decoded,   roots = {x1, x2} (sorted, verified against delta_s5)
  *   - d >= 3: status = Overflow, roots = {}
  */
 BucketDecodeResult DecodeBucketSyndrome(const BucketSyndrome &delta);
diff --git a/src/net/v2_protocol_handler.cpp b/src/net/v2_protocol_handler.cpp
index 0e5cfabd88c5620ef15e1d1cb030aa9056829b51..70a0e6d199ada76742c69204d8219f85c745a428 100644
