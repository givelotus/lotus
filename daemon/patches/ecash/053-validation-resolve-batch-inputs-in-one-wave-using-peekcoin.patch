+const Coin *CCoinsViewCache::PeekCoin(const COutPoint &outpoint) const {
+    const auto it = cacheCoins.find(outpoint);
+    return it != cacheCoins.end() && !it->second.coin.IsSpent()
+        ? &it->second.coin : nullptr;
+}
