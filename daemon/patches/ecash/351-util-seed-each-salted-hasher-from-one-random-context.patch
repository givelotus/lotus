From 9e6f7adc97c730b980ecf53d5d48988b0ae87da9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@gmail.com>
Date: Mon, 19 Oct 2026 20:59:14 -0700
Subject: [PATCH] util: seed each salted hasher from one random context

The admission profile attributed 6-17% of its serial commit phase to
MemPoolAccept construction. Coins views and mempool admission construct
salted hashers, whose two key words each seeded a separate RNG context.

Draw both words from one freshly seeded FastRandomContext per hasher.
The salt remains 128 bits, independently seeded for every new hasher;
deterministic outpoint hashing retains exactly its existing constants.
Public constructors, hashing functions and object layout are unchanged.

The series includes a construction benchmark and a two-context reference
that performs the same outpoint hash. These isolate seeding cost; they do
not stand in for end-to-end admission measurements. Release benchmark
admission checks remain enabled, so rejected work cannot inflate a result.

Validation on the assembled candidate: hash_tests, coins_tests,
mempool_admission_tests, txadmission_queue_tests, validationinterface_tests,
mempool_overlay_tests, txvalidation_tests and txvalidationcache_tests:
62 cases pass. Chronik-enabled Release daemon/test/benchmark targets build.
This is final-candidate validation, not a per-intermediate-commit build sweep.

How to reproduce:
    CARGO_BUILD_JOBS=2 ninja -C build -j2 bitcoind test_bitcoin bitcoin-bench
    build/src/test/test_bitcoin --run_test=hash_tests,coins_tests
    build/src/bench/bitcoin-bench \
        -filter='SaltedOutpointHasher(Construct|TwoContexts)'
The benchmark prints nanobench rows in ns/op. The delivery README records
the actual measured runs and shared-host limitations separately.
---
 src/util/hasher.cpp | 25 ++++++++++++++++++++-----
 src/util/hasher.h   | 12 ++++++++++++
 2 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/src/util/hasher.cpp b/src/util/hasher.cpp
index 49d94fb20fba1a4f0ecdfe858b4bc9f7570047e1..976e2b23ae5926d509f5872ccd3255ae1b59b02b 100644
--- a/src/util/hasher.cpp
+++ b/src/util/hasher.cpp
@@ -7,15 +7,30 @@
 
 #include <limits>
 
+namespace {
+/**
+ * Two salt words from one freshly seeded random context. Seeding a context
+ * costs a hash of the RNG state under its mutex, which dominated the cost
+ * of constructing a hasher (and so of every coins view and mempool
+ * admission) when each word had its own context.
+ */
+std::array<uint64_t, 2> RandomSalt() {
+    FastRandomContext rng;
+    const uint64_t k0 = rng.rand64();
+    return {k0, rng.rand64()};
+}
+} // namespace
+
 SaltedUint256Hasher::SaltedUint256Hasher()
-    : k0{FastRandomContext().rand64()}, k1{FastRandomContext().rand64()} {}
+    : SaltedUint256Hasher(RandomSalt()) {}
 
 SaltedOutpointHasher::SaltedOutpointHasher(bool deterministic)
-    : k0{deterministic ? 0x8e819f2607a18de6 : FastRandomContext().rand64()},
-      k1{deterministic ? 0xf4020d2e3983b0eb : FastRandomContext().rand64()} {}
+    : SaltedOutpointHasher(
+          deterministic
+              ? std::array<uint64_t, 2>{0x8e819f2607a18de6, 0xf4020d2e3983b0eb}
+              : RandomSalt()) {}
 
-SaltedSipHasher::SaltedSipHasher()
-    : m_k0{FastRandomContext().rand64()}, m_k1{FastRandomContext().rand64()} {}
+SaltedSipHasher::SaltedSipHasher() : SaltedSipHasher(RandomSalt()) {}
 
 size_t SaltedSipHasher::operator()(const Span<const uint8_t> &script) const {
     return CSipHasher(m_k0, m_k1).Write(script).Finalize();
diff --git a/src/util/hasher.h b/src/util/hasher.h
index 95c4861bbd99ccdd1136769ba45f2037b4316c86..5e022bf64879c0f9ab9a6e763b18cc9b7da72a01 100644
--- a/src/util/hasher.h
+++ b/src/util/hasher.h
@@ -12,11 +12,17 @@
 #include <script/standard.h>
 #include <uint256.h>
 
+#include <array>
+#include <cstdint>
+
 class SaltedUint256Hasher {
 private:
     /** Salt */
     const uint64_t k0, k1;
 
+    explicit SaltedUint256Hasher(std::array<uint64_t, 2> salt)
+        : k0{salt[0]}, k1{salt[1]} {}
+
 public:
     SaltedUint256Hasher();
 
@@ -45,6 +51,9 @@ private:
     /** Salt */
     const uint64_t k0, k1;
 
+    explicit SaltedOutpointHasher(std::array<uint64_t, 2> salt)
+        : k0{salt[0]}, k1{salt[1]} {}
+
 public:
     SaltedOutpointHasher(bool deterministic = false);
 
@@ -106,6 +115,9 @@ private:
     /** Salt */
     const uint64_t m_k0, m_k1;
 
+    explicit SaltedSipHasher(std::array<uint64_t, 2> salt)
+        : m_k0{salt[0]}, m_k1{salt[1]} {}
+
 public:
     SaltedSipHasher();
 
