-            for i in range(len(extra_args)):
-                extra_args[i] = extra_args[i] + ["-whitelist=noban,in,out@127.0.0.1"]
+        extra_confs = [
+            ["bind=127.0.0.1"] if self.bind_to_localhost_only else []
+            for _ in range(num_nodes)
