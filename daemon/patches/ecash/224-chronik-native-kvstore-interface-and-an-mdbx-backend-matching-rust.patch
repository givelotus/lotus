+                auto txn = store->BeginWrite();
+                txn->Put(store->Table("plain"), S("k"), S("v"));
+                txn->PutDup(store->Table("dup_fixed"), S("m"), Dup20(1, 2, 3));
+                txn->Commit();
+                store->Sync(true);
