+BOOST_AUTO_TEST_CASE(reopen_persistence_and_destroy) {
+    for (StoreBackend backend : Backends()) {
+        BOOST_TEST_CONTEXT("backend " << StoreBackendName(backend)) {
+            TempDir dir("reopen");
