diff --git a/chronik/native/core/db/store_registry.cpp b/chronik/native/core/db/store_registry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0aecea79b71e5e8577694eb2580fad320b0af5d2
--- /dev/null
+++ b/chronik/native/core/db/store_registry.cpp
@@ -0,0 +1,73 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/error.h>
+#include <chronik/native/store.h>
+
+#include <map>
+#include <mutex>
+
+namespace chronik::native {
+
+namespace {
+struct Backend {
+    StoreOpenFn open;
+    StoreDestroyFn destroy;
+};
+
+std::mutex &RegistryMutex() {
+    static std::mutex mutex;
+    return mutex;
+}
+
+std::map<StoreBackend, Backend> &Registry() {
+    static std::map<StoreBackend, Backend> registry;
+    return registry;
+}
+
+Backend GetBackend(StoreBackend backend) {
+    std::lock_guard<std::mutex> lock(RegistryMutex());
+    auto it = Registry().find(backend);
+    if (it == Registry().end()) {
+        throw ChronikError("Chronik storage backend " +
+                           std::string(StoreBackendName(backend)) +
+                           " is not available in this build");
+    }
+    return it->second;
+}
+} // namespace
+
+std::string_view StoreBackendName(StoreBackend backend) {
+    switch (backend) {
+        case StoreBackend::Mdbx:
+            return "mdbx";
+        case StoreBackend::LevelDb:
+            return "leveldb";
+    }
+    return "unknown";
+}
+
+void RegisterStoreBackend(StoreBackend backend, StoreOpenFn open,
+                          StoreDestroyFn destroy) {
+    std::lock_guard<std::mutex> lock(RegistryMutex());
+    Registry()[backend] = Backend{std::move(open), std::move(destroy)};
+}
+
+bool HasStoreBackend(StoreBackend backend) {
+    std::lock_guard<std::mutex> lock(RegistryMutex());
+    return Registry().count(backend) > 0;
+}
+
+std::unique_ptr<KvStore> OpenStore(StoreBackend backend,
+                                   const std::filesystem::path &dir,
+                                   std::span<const TableSpec> tables,
+                                   const StoreOptions &opts) {
+    return GetBackend(backend).open(dir, tables, opts);
+}
+
+void DestroyStore(StoreBackend backend, const std::filesystem::path &dir) {
+    GetBackend(backend).destroy(dir);
+}
+
+} // namespace chronik::native
diff --git a/chronik/native/include/chronik/native/mdbx_store.h b/chronik/native/include/chronik/native/mdbx_store.h
new file mode 100644
index 0000000000000000000000000000000000000000..44bd34f9a58521b34c31fde282d6f346561c54e3
--- /dev/null
+++ b/chronik/native/include/chronik/native/mdbx_store.h
@@ -0,0 +1,93 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_MDBX_STORE_H
+#define CHRONIK_NATIVE_MDBX_STORE_H
+
+#include <chronik/native/store.h>
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <optional>
+#include <span>
+
+/**
+ * MDBX storage backend (library chronik_native_store_mdbx). Only this library
+ * includes mdbx.h; the core reaches it only through the KvStore interface.
+ */
+namespace chronik::native {
+
+/**
+ * Environment profile. The default (ChronikIndexProfile) reproduces the Rust
+ * Chronik index env of chronik-db/src/db.rs `Db::open_with_cfs` exactly; tier
+ * extensions (e.g. the Lotus V2 v2_index env) define their own.
+ */
+struct MdbxEnvProfile {
+    int64_t size_lower = 1 << 20;             // 1 MiB
+    int64_t size_now = 16 << 20;              // 16 MiB
+    int64_t size_upper = int64_t(256) << 30;  // 256 GiB
+    int64_t growth_step = 64 << 20;           // 64 MiB
+    int64_t shrink_threshold = 128 << 20;     // 128 MiB
+    int64_t pagesize = 16384;                 // 16 KiB
+    // Env flags
+    bool safe_nosync = true;
+    bool nometasync = true;
+    bool liforeclaim = true;
+    bool nostickythreads = true;
+    bool nomeminit = true;
+    uint32_t mode = 0600;
+    uint32_t max_readers = 256;
+    /** 0 => max(n_tables + 16, 64), like Rust. */
+    uint32_t max_dbs = 0;
+    /** MDBX_OPT_SYNC_BYTES / MDBX_OPT_SYNC_PERIOD, if set */
+    std::optional<uint64_t> sync_bytes = uint64_t(16) << 20;
+    std::optional<uint64_t> sync_period = uint64_t(1) << 16;
+    /** Keys longer than this are stored as "MDBX_SHA256_KEY:" || sha256. */
+    size_t max_inline_key_len = 7500;
+    /** Durable env sync right after creating the DBIs (Rust does this). */
+    bool sync_after_open = true;
+};
+
+/** The Rust Chronik index env (indexes/chronik). */
+MdbxEnvProfile ChronikIndexProfile();
+
+/** Registers StoreBackend::Mdbx (with ChronikIndexProfile) in the registry. */
+void RegisterMdbxStore();
+
+std::unique_ptr<KvStore> OpenMdbxStore(const std::filesystem::path &dir,
+                                       std::span<const TableSpec> tables,
+                                       const StoreOptions &opts,
+                                       const MdbxEnvProfile &profile);
+
+/** Deletes the env files, like Rust Db::destroy (incl. RocksDB leftovers). */
+void DestroyMdbxStore(const std::filesystem::path &dir);
+
+/** Diagnostics of an open MDBX store (tests, dump tool). */
+struct MdbxStoreInfo {
+    uint64_t geo_lower{}, geo_upper{}, geo_current{}, geo_grow{}, geo_shrink{};
+    uint32_t pagesize{};
+    uint32_t env_flags{};
+    uint32_t max_readers{};
+    uint64_t sync_bytes{}, sync_period{};
+    /** Per-table DBI flags (MDBX_DUPSORT etc.), in TableNames() order. */
+    std::vector<uint32_t> dbi_flags;
+};
+/** Throws if store is not an MDBX store. */
+MdbxStoreInfo GetMdbxStoreInfo(const KvStore &store);
+
+/** Flag values (as in mdbx.h), for interpreting MdbxStoreInfo. */
+namespace mdbx_flags {
+inline constexpr uint32_t kSafeNoSync = 0x10000;
+inline constexpr uint32_t kNoMetaSync = 0x40000;
+inline constexpr uint32_t kNoStickyThreads = 0x200000;
+inline constexpr uint32_t kNoMemInit = 0x1000000;
+inline constexpr uint32_t kLifoReclaim = 0x4000000;
+inline constexpr uint32_t kDupSort = 0x04;
+inline constexpr uint32_t kDupFixed = 0x10;
+} // namespace mdbx_flags
+
+} // namespace chronik::native
+
+#endif // CHRONIK_NATIVE_MDBX_STORE_H
diff --git a/chronik/native/include/chronik/native/schema.h b/chronik/native/include/chronik/native/schema.h
new file mode 100644
index 0000000000000000000000000000000000000000..9ef3228952451d19a5452c0f61ef6bab25b05ea6
--- /dev/null
+++ b/chronik/native/include/chronik/native/schema.h
@@ -0,0 +1,83 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_SCHEMA_H
+#define CHRONIK_NATIVE_SCHEMA_H
+
+#include <chronik/native/store.h>
+
+#include <span>
+#include <string_view>
+#include <vector>
+
+/**
+ * The Chronik index tables (Rust column families) of the eCash tier, exactly
+ * as chronik-db `Db::open` registers them (build/ecash-src
+ * chronik/chronik-db/src/db.rs). Tier extensions (e.g. Lotus V2) append their
+ * own tables to a Schema; the eCash-tier core never opens them.
+ */
+namespace chronik::native::schema {
+
+inline constexpr uint64_t kCurrentIndexerVersion = 13;
+
+inline constexpr std::string_view kBlk = "blk";
+inline constexpr std::string_view kBlkByFirstTx = "blk_by_first_tx";
+inline constexpr std::string_view kBlkStats = "blk_stats";
+inline constexpr std::string_view kFirstTxByBlk = "first_tx_by_blk";
+inline constexpr std::string_view kLokadIdHistory = "lokad_id_history";
+inline constexpr std::string_view kLokadIdHistoryNumTxs =
+    "lokad_id_history_num_txs";
+inline constexpr std::string_view kLookupBlkByHash = "lookup_blk_by_hash";
+inline constexpr std::string_view kLookupTxByHash = "lookup_tx_by_hash";
+inline constexpr std::string_view kMeta = "meta";
+inline constexpr std::string_view kPluginGroupUtxos = "plugin_utxos";
+inline constexpr std::string_view kPluginHistory = "plugin_history";
+inline constexpr std::string_view kPluginHistoryNumTxs =
+    "plugin_history_num_txs";
+inline constexpr std::string_view kPluginMeta = "plugin_meta";
+inline constexpr std::string_view kPluginOutputs = "plugin_outputs";
+inline constexpr std::string_view kScripthash = "scripthash";
+inline constexpr std::string_view kScriptHistory = "script_history";
+inline constexpr std::string_view kScriptHistoryNumTxs =
+    "script_history_num_txs";
+inline constexpr std::string_view kScriptUtxo = "script_utxo";
+inline constexpr std::string_view kTokenIdHistory = "token_id_history";
+inline constexpr std::string_view kTokenIdHistoryNumTxs =
+    "token_id_history_num_txs";
+inline constexpr std::string_view kTokenIdUtxo = "token_id_utxo";
+inline constexpr std::string_view kSpentBy = "spent_by";
+inline constexpr std::string_view kTokenGenesisInfo = "token_genesis_info";
+inline constexpr std::string_view kTokenMeta = "token_meta";
+inline constexpr std::string_view kTokenTx = "token_tx";
+inline constexpr std::string_view kTx = "tx";
+
+/** 12-byte big-endian (tx_num, out_idx) prefix of every UTXO dup value. */
+inline constexpr uint32_t kUtxoOutpointSize = 12;
+/**
+ * Dup size of "value" UTXO groups (UtxoDataValue = sats): outpoint || sats
+ * as little-endian i64. Those tables are MDBX_DUPSORT | MDBX_DUPFIXED.
+ * "Output" groups (UtxoDataOutput) store outpoint || sats LE8 || raw script,
+ * variable length, MDBX_DUPSORT only.
+ */
+inline constexpr uint32_t kUtxoValueDupSize = 20;
+
+/** The 26 eCash-tier tables, in Rust registration order. */
+std::span<const TableSpec> EcashTables();
+
+/** A table set: the eCash-tier tables plus any tier-extension tables. */
+class Schema {
+public:
+    /** Starts with EcashTables(). */
+    Schema();
+    /** Append an extension table; throws if the name is already present. */
+    void Add(TableSpec spec);
+    std::span<const TableSpec> Tables() const { return m_tables; }
+
+private:
+    std::vector<TableSpec> m_tables;
+};
+
+} // namespace chronik::native::schema
+
+#endif // CHRONIK_NATIVE_SCHEMA_H
diff --git a/chronik/native/include/chronik/native/store.h b/chronik/native/include/chronik/native/store.h
new file mode 100644
index 0000000000000000000000000000000000000000..d5a87c3c824972b52d7c07c1be2a60d7bf8aea89
--- /dev/null
+++ b/chronik/native/include/chronik/native/store.h
@@ -0,0 +1,151 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_STORE_H
+#define CHRONIK_NATIVE_STORE_H
+
+#include <chronik/native/types.h>
+
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/**
+ * Ordered key-value storage interface. This is the ONLY path from the native
+ * Chronik core to storage: the core never includes a database header. Each
+ * backend (MDBX, LevelDB) is a separate library implementing this interface,
+ * so a host can link exactly the backends it wants.
+ */
+namespace chronik::native {
+
+enum class StoreBackend { Mdbx, LevelDb };
+
+struct TableSpec {
+    /** Exact Rust CF name, e.g. "script_utxo" */
+    std::string_view name;
+    enum class Kind { Plain, Dup } kind = Kind::Plain;
+    /** Dup only; MDBX_DUPFIXED when set */
+    std::optional<uint32_t> dup_fixed_size;
+};
+using TableId = uint16_t;
+
+/** Ordered iteration over one table (plain tables). */
+class Cursor {
+public:
+    virtual ~Cursor() = default;
+    virtual bool SeekFirst() = 0;
+    virtual bool SeekLast() = 0;
+    /** First key >= key (MDBX_SET_RANGE) */
+    virtual bool SeekGe(ByteView key) = 0;
+    /** Last key <= key (MDBX_TO_KEY_LESSER_OR_EQUAL) */
+    virtual bool SeekLe(ByteView key) = 0;
+    virtual bool Next() = 0;
+    virtual bool Prev() = 0;
+    virtual bool Valid() const = 0;
+    /** Views valid until the cursor moves or the txn ends. */
+    virtual ByteView Key() const = 0;
+    virtual ByteView Value() const = 0;
+};
+
+/** The duplicate values of one key, ascending (dup tables). */
+class DupCursor {
+public:
+    virtual ~DupCursor() = default;
+    /** Position at the first dup of key; false if the key has no dups. */
+    virtual bool Seek(ByteView key) = 0;
+    /** First dup of key with value >= value_prefix (GET_BOTH_RANGE). */
+    virtual bool SeekValueGe(ByteView key, ByteView value_prefix) = 0;
+    /** Next dup of the same key; false at the end. */
+    virtual bool Next() = 0;
+    virtual bool Valid() const = 0;
+    virtual ByteView Value() const = 0;
+    /** Number of dups from the current position to the end of the key. */
+    virtual size_t CountRemaining() = 0;
+};
+
+class ReadTxn {
+public:
+    virtual ~ReadTxn() = default;
+    /** View valid until the txn ends or (write txn) the next write. */
+    virtual std::optional<ByteView> Get(TableId, ByteView key) const = 0;
+    virtual std::unique_ptr<Cursor> OpenCursor(TableId) const = 0;
+    virtual std::unique_ptr<DupCursor> OpenDupCursor(TableId) const = 0;
+    virtual uint64_t EstimateEntries(TableId) const = 0;
+};
+
+/** Reads observe this txn's own writes. */
+class WriteTxn : public ReadTxn {
+public:
+    virtual void Put(TableId, ByteView key, ByteView value) = 0;
+    virtual void Del(TableId, ByteView key) = 0;
+    /** Idempotent */
+    virtual void PutDup(TableId, ByteView key, ByteView value) = 0;
+    /** Exact match */
+    virtual void DelDup(TableId, ByteView key, ByteView value) = 0;
+    /** Delete the first dup of key starting with value_prefix (if any). */
+    virtual void DelDupByPrefix(TableId, ByteView key,
+                                ByteView value_prefix) = 0;
+    /** Remove every entry of the table (mdbx_drop(..., false)) */
+    virtual void Clear(TableId) = 0;
+    /** Throws on failure; txn unusable after. */
+    virtual void Commit() = 0;
+};
+
+class KvStore {
+public:
+    virtual ~KvStore() = default;
+    /** Throws ChronikError "Column family <name> doesn't exist" if unknown. */
+    virtual TableId Table(std::string_view name) const = 0;
+    /** Names of all tables, in the order they were opened. */
+    virtual std::vector<std::string> TableNames() const = 0;
+    /** Any thread, concurrent */
+    virtual std::unique_ptr<ReadTxn> BeginRead() const = 0;
+    /** Writer thread only */
+    virtual std::unique_ptr<WriteTxn> BeginWrite() = 0;
+    /** Durability checkpoint (force = full fsync). */
+    virtual void Sync(bool force) = 0;
+};
+
+/**
+ * Lifetime rule: every ReadTxn/WriteTxn (and their cursors) must be destroyed
+ * before the KvStore that created them. A ReadTxn may be used from any thread,
+ * but by one thread at a time.
+ */
+
+/** Hook used by backends needing SHA-256 (MDBX long-key hashing). */
+using Sha256Fn = std::function<void(ByteView data, uint8_t out[32])>;
+
+struct StoreOptions {
+    Sha256Fn sha256;
+};
+
+/**
+ * Backend registry. Each backend library exposes an explicit registration
+ * function (e.g. RegisterMdbxStore() in chronik/native/mdbx_store.h), which the
+ * host adapter calls for the backends it links. Opening an unregistered
+ * backend throws.
+ */
+using StoreOpenFn = std::function<std::unique_ptr<KvStore>(
+    const std::filesystem::path &dir, std::span<const TableSpec> tables,
+    const StoreOptions &opts)>;
+using StoreDestroyFn = std::function<void(const std::filesystem::path &dir)>;
+
+void RegisterStoreBackend(StoreBackend, StoreOpenFn, StoreDestroyFn);
+bool HasStoreBackend(StoreBackend);
+std::unique_ptr<KvStore> OpenStore(StoreBackend,
+                                   const std::filesystem::path &dir,
+                                   std::span<const TableSpec> tables,
+                                   const StoreOptions &opts);
+void DestroyStore(StoreBackend, const std::filesystem::path &dir);
+std::string_view StoreBackendName(StoreBackend);
+
+} // namespace chronik::native
