+        ngtcp2_conn_get_conn_info2(session.Conn()->Conn(), &ci);
+        m_info->rtt_us = ci.smoothed_rtt / NGTCP2_MICROSECONDS;
+        m_info->min_rtt_us = ci.min_rtt / NGTCP2_MICROSECONDS;
+        m_info->cwnd = ci.cwnd;
