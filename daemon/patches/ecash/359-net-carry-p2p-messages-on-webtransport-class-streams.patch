+    std::array<std::unique_ptr<P2PZstdSession>, NUM_STREAM_CLASSES> &set,
+    StreamClass cls) {
+    auto &slot{set[StreamClassIndex(cls)]};
+    if (!slot) {
+        slot = std::make_unique<P2PZstdSession>(/*use_dict=*/true);
+    }
