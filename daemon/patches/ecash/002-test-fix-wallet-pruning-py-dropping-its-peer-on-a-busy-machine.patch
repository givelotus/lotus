From 44397b4e9001c99463aa6f772f5e8d9dc09513ce Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 11:39:34 -0700
Subject: [PATCH] test: fix wallet_pruning.py dropping its peer on a busy
 machine

mine_large_blocks() moved every node's mock time forward 10 minutes per
1 MB block. A node times out a block download by its own clock (15
minutes with one peer), so when the pruning node was still downloading a
block across two of those jumps, it disconnected its only peer and the
test failed in sync_blocks ("Timeout downloading block ... disconnecting"
in node1's debug.log). Seen once in a parallel run with other heavy tests.

Blocks still advance 10 minutes each, but the nodes' clocks now move once
per 6 blocks (nodes accept blocks up to 2 hours ahead), after the nodes
have synced, so no download is in flight when a clock moves.
---
 test/functional/wallet_pruning.py | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/test/functional/wallet_pruning.py b/test/functional/wallet_pruning.py
index f51227767283fd29af7e29ff8e128218b5dc22d4..926a5e60b7a92179f9a84dec37b42d1b487ae05a 100644
--- a/test/functional/wallet_pruning.py
+++ b/test/functional/wallet_pruning.py
@@ -52,12 +52,23 @@ class WalletPruningTest(BitcoinTestFramework):
             # Simulate 10 minutes of work time per block
             # Important for matching a timestamp with a block +- some window
             self.nTime += 600
-            for n in self.nodes:
-                if n.running:
-                    # Update node's time to accept future blocks
-                    n.setmocktime(self.nTime)
+            # Move the nodes' clocks only every hour of blocks (they accept
+            # blocks up to 2 hours ahead), and only once the other nodes have
+            # every block: a node times out a block download by its own clock,
+            # so moving it while a block is in flight can make the pruning
+            # node drop its only peer on a busy machine.
+            if height % 6 == 0:
+                self.set_running_nodes_time()
+        self.set_running_nodes_time()
         self.sync_all()
 
+    def set_running_nodes_time(self):
+        running = [n for n in self.nodes if n.running]
+        self.sync_blocks(running, wait=0.1)
+        for n in running:
+            # Update node's time to accept future blocks
+            n.setmocktime(self.nTime)
+
     def test_wallet_import_pruned(self, wallet_name):
         self.log.info(
             "Make sure we can import wallet when pruned and required blocks are still available"
