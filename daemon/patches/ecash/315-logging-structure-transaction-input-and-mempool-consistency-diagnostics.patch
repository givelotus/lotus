From bdbfe7d625bbff1f29b875cb0666bde0bea70a21 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:25:26 -0700
Subject: [PATCH] logging: structure transaction input and mempool consistency
 diagnostics

Preserve input lookup and mempool rejection behavior and Info severity.
Missing-input diagnostics use a serialization TxHash, not Lotus V2's
transaction identifier; copy its raw bytes and render hex on the consumer.
The mempool diagnostic retains its actual TxId. Keep the unsigned input
index and original function/error/BUG text without logging new payloads.

A native fixture invokes CalculateLockPointsAtTip with a legacy version2
transaction and empty coin view. It verifies unchanged nullopt and actual
hash, unsigned index, missing txid field, severity and exact readable text.
The mempool child-before-parent branch is mechanically preserved, not
newly forced by that fixture. Tier: shared eCash, inherited by V2.

Scripted diff (ast-grep-py==0.51.0, from the commit's parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/transaction-validation-diagnostics.json --apply

git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/validation.cpp src/test/logging_event_tests.cpp

Handwritten: focused native fixture and explicit includes. Registry append
is an explicit reviewed support adjustment; old fields are not renumbered.
---
 .../transaction-validation-diagnostics.json   | 63 +++++++++++++++++++
 src/logging/fields.h                          |  4 +-
 src/test/logging_event_tests.cpp              | 28 +++++++++
 src/validation.cpp                            | 17 +++--
 4 files changed, 105 insertions(+), 7 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/transaction-validation-diagnostics.json

diff --git a/contrib/logging/conversion/rules/transaction-validation-diagnostics.json b/contrib/logging/conversion/rules/transaction-validation-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..599a28f114e7e8ef6c95c56b2a61dda312d2016d
--- /dev/null
+++ b/contrib/logging/conversion/rules/transaction-validation-diagnostics.json
@@ -0,0 +1,63 @@
+{
+  "schema": 1,
+  "batch": "transaction-validation-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "transaction_input_missing",
+          "old": "LogPrintf(\"ERROR: %s: Missing input %d in transaction \\'%s\\'\\n\",\n                      __func__, i, tx.GetHash().GetHex())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"transaction_input_missing\", \"ERROR: {source_function}: Missing input {input_index} in transaction '{tx_hash}'\").Field(BCLog::LogField::SourceFunction, __func__).Field(BCLog::LogField::InputIndex, i).Field(BCLog::LogField::TxHash, tx.GetHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "ERROR: %s: Missing input %d in transaction '%s'\n",
+            "specifiers": [
+              "%s",
+              "%d",
+              "%s"
+            ],
+            "arguments": [
+              "__func__",
+              "i",
+              "tx.GetHash().GetHex()"
+            ]
+          },
+          "review_note": "Keep original Info level, exact error/BUG wording, indices, guards, return/state decisions. Input index is actual size_t UINT. Missing-input transaction serialization GetHash is TxHash (not V2 GetId); mempool identifier remains actual TxId. Hashes copied raw and hex rendered on consumer. No new payloads or consensus behavior."
+        },
+        {
+          "id": "mempool_child_before_parent",
+          "old": "LogPrintf(\"%s: BUG! PLEASE REPORT THIS! Attempt to add txid %s, but \"\n                  \"its outputs are already spent in the \"\n                  \"mempool\\n\",\n                  __func__, txid.ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"mempool_child_before_parent\", \"{source_function}: BUG! PLEASE REPORT THIS! Attempt to add txid {txid}, but its outputs are already spent in the mempool\").Field(BCLog::LogField::SourceFunction, __func__).Field(BCLog::LogField::TxId, txid)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "%s: BUG! PLEASE REPORT THIS! Attempt to add txid %s, but its outputs are already spent in the mempool\n",
+            "specifiers": [
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "__func__",
+              "txid.ToString()"
+            ]
+          },
+          "review_note": "Keep original Info level, exact error/BUG wording, indices, guards, return/state decisions. Input index is actual size_t UINT. Missing-input transaction serialization GetHash is TxHash (not V2 GetId); mempool identifier remains actual TxId. Hashes copied raw and hex rendered on consumer. No new payloads or consensus behavior."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Distinguish serialization TxHash from V2 transaction identifier; preserve unsigned input index.",
+          "old": "    X(DataDirectoryArgument, data_directory_argument, STRING, \"\", \"\")\n",
+          "new": "    X(DataDirectoryArgument, data_directory_argument, STRING, \"\", \"\") \\\n    X(InputIndex, input_index, UINT, \"\", \"\") \\\n    X(TxHash, tx_hash, HASH, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
