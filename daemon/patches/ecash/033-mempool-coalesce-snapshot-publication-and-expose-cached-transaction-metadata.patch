+
+        CTxMemPool::setEntries allAncestors;
+        pool.CalculateMemPoolAncestors(entries[52], allAncestors,
+                                       fSearchForParents,
+                                       /*fSearchFinalized=*/true);
+        BOOST_CHECK_EQUAL(allAncestors.size(), 52U);
