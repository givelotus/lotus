From 4b11541fd3f1960bd27b744d4a6e6ff0676fcddf Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 15:35:28 -0700
Subject: [PATCH] logging: structure snapshot cache sizes and coin-load
 progress

Complete the four cache/progress sites deferred by the preceding snapshot
lifecycle owner. Keep integer decimal megabytes (bytes divided by1000000)
as unsigned integers, distinct from binary MiB. The consumer reproduces
legacy %.2f on integral operands without inventing decimals; the percentage
keeps its original float calculation and two-digit rendering. Copy the base
block hash directly. Snapshot state, cache sizing and validation are unchanged.
The known long fatal paragraph remains plain logging with its full message.

Scripted diff (ast-grep-py0.51.0; manually reviewed mappings):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/snapshot-cache-progress.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/snapshot-memory339-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/validation.cpp

The actual renderer's15 old-tinyformat/raw-integer controls pass. Native
Logger and producer-path validation remain pending the combined batch gate;
this does not claim a complete valid snapshot activation was newly exercised.
---
 .../rules/snapshot-cache-progress.json        | 101 ++++++++++++++++++
 src/logging/fields.h                          |   4 +-
 src/validation.cpp                            |  40 ++++---
 3 files changed, 131 insertions(+), 14 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/snapshot-cache-progress.json

diff --git a/contrib/logging/conversion/rules/snapshot-cache-progress.json b/contrib/logging/conversion/rules/snapshot-cache-progress.json
new file mode 100644
index 0000000000000000000000000000000000000000..25ba5b5aa56785509557f70d2bfbaa6ee7fe32d2
--- /dev/null
+++ b/contrib/logging/conversion/rules/snapshot-cache-progress.json
@@ -0,0 +1,101 @@
+{
+  "schema": 1,
+  "batch": "snapshot-cache-progress",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "requires": "logging: retain integral values in bounded numeric message formats",
+  "resolves_prior_deferral": "Four memory sites in snapshot-chainstate-lifecycle. Known long fatal paragraph remains plain and deferred.",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "snapshot_activated_cache",
+          "old": "LogPrintf(\"[snapshot] (%.2f MB)\\n\",\n              m_snapshot_chainstate->CoinsTip().DynamicMemoryUsage() /\n                  (1000 * 1000))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"snapshot_activated_cache\", \"[snapshot] ({snapshot_cache_mb:.2f} MB)\").Field(BCLog::LogField::SnapshotCacheMB, m_snapshot_chainstate->CoinsTip().DynamicMemoryUsage() /\n                  (1000 * 1000))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "[snapshot] (%.2f MB)\n",
+            "specifiers": [
+              "%.2f"
+            ],
+            "arguments": [
+              "m_snapshot_chainstate->CoinsTip().DynamicMemoryUsage() /\n                  (1000 * 1000)"
+            ]
+          },
+          "review_note": "Preserve Info, exact old tinyformat text, evaluation order and integer decimal-MB division. Memory stays UINT; no float coercion or invented fractional part. The percentage keeps the original float calculation and consumer .2f precision. Component controls compare actual old/new renderer and UINT64MAX/INT64MIN exactly; native/valid-snapshot producer-path coverage remains separately recorded. No snapshot consensus/cache/coin state changes."
+        },
+        {
+          "id": "snapshot_coins_load_progress",
+          "old": "LogPrintf(\"[snapshot] %d coins loaded (%.2f%%, %.2f MB)\\n\",\n                              coins_processed,\n                              static_cast<float>(coins_processed) * 100 /\n                                  static_cast<float>(coins_count),\n                              coins_cache.DynamicMemoryUsage() / (1000 * 1000))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"snapshot_coins_load_progress\", \"[snapshot] {snapshot_coins_processed} coins loaded ({snapshot_progress_percent:.2f}%, {snapshot_cache_mb:.2f} MB)\").Field(BCLog::LogField::SnapshotCoinsProcessed, coins_processed).Field(BCLog::LogField::SnapshotProgressPercent, static_cast<float>(coins_processed) * 100 /\n                                  static_cast<float>(coins_count)).Field(BCLog::LogField::SnapshotCacheMB, coins_cache.DynamicMemoryUsage() / (1000 * 1000))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "[snapshot] %d coins loaded (%.2f%%, %.2f MB)\n",
+            "specifiers": [
+              "%d",
+              "%.2f",
+              "%.2f"
+            ],
+            "arguments": [
+              "coins_processed",
+              "static_cast<float>(coins_processed) * 100 /\n                                  static_cast<float>(coins_count)",
+              "coins_cache.DynamicMemoryUsage() / (1000 * 1000)"
+            ]
+          },
+          "review_note": "Preserve Info, exact old tinyformat text, evaluation order and integer decimal-MB division. Memory stays UINT; no float coercion or invented fractional part. The percentage keeps the original float calculation and consumer .2f precision. Component controls compare actual old/new renderer and UINT64MAX/INT64MIN exactly; native/valid-snapshot producer-path coverage remains separately recorded. No snapshot consensus/cache/coin state changes."
+        },
+        {
+          "id": "snapshot_coins_loaded",
+          "old": "LogPrintf(\"[snapshot] loaded %d (%.2f MB) coins from snapshot %s\\n\",\n              coins_count, coins_cache.DynamicMemoryUsage() / (1000 * 1000),\n              base_blockhash.ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"snapshot_coins_loaded\", \"[snapshot] loaded {count} ({snapshot_cache_mb:.2f} MB) coins from snapshot {block_hash}\").Field(BCLog::LogField::Count, coins_count).Field(BCLog::LogField::SnapshotCacheMB, coins_cache.DynamicMemoryUsage() / (1000 * 1000)).Field(BCLog::LogField::BlockHash, base_blockhash)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "[snapshot] loaded %d (%.2f MB) coins from snapshot %s\n",
+            "specifiers": [
+              "%d",
+              "%.2f",
+              "%s"
+            ],
+            "arguments": [
+              "coins_count",
+              "coins_cache.DynamicMemoryUsage() / (1000 * 1000)",
+              "base_blockhash.ToString()"
+            ]
+          },
+          "review_note": "Preserve Info, exact old tinyformat text, evaluation order and integer decimal-MB division. Memory stays UINT; no float coercion or invented fractional part. The percentage keeps the original float calculation and consumer .2f precision. Component controls compare actual old/new renderer and UINT64MAX/INT64MIN exactly; native/valid-snapshot producer-path coverage remains separately recorded. No snapshot consensus/cache/coin state changes."
+        },
+        {
+          "id": "snapshot_cache_validated",
+          "old": "LogPrintf(\"[snapshot] validated snapshot (%.2f MB)\\n\",\n              coins_cache.DynamicMemoryUsage() / (1000 * 1000))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"snapshot_cache_validated\", \"[snapshot] validated snapshot ({snapshot_cache_mb:.2f} MB)\").Field(BCLog::LogField::SnapshotCacheMB, coins_cache.DynamicMemoryUsage() / (1000 * 1000))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "[snapshot] validated snapshot (%.2f MB)\n",
+            "specifiers": [
+              "%.2f"
+            ],
+            "arguments": [
+              "coins_cache.DynamicMemoryUsage() / (1000 * 1000)"
+            ]
+          },
+          "review_note": "Preserve Info, exact old tinyformat text, evaluation order and integer decimal-MB division. Memory stays UINT; no float coercion or invented fractional part. The percentage keeps the original float calculation and consumer .2f precision. Component controls compare actual old/new renderer and UINT64MAX/INT64MIN exactly; native/valid-snapshot producer-path coverage remains separately recorded. No snapshot consensus/cache/coin state changes."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Distinguish integer decimal megabytes (1000000 bytes) from binary MiB and preserve original floating percentage calculation. Append IDs only.",
+          "old": "    X(BlockIndexDescription, block_index_description, STRING, \"\", \"\")\n",
+          "new": "    X(BlockIndexDescription, block_index_description, STRING, \"\", \"\") \\\n    X(SnapshotCacheMB, snapshot_cache_mb, UINT, \"\", \"\") \\\n    X(SnapshotProgressPercent, snapshot_progress_percent, FLOAT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/logging/fields.h b/src/logging/fields.h
index ecff82d6eaac5664be1a799803d350bb5d515f30..c8a5d07bb825eb8348c69506ebf366c645ef9b0a 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -197,7 +197,9 @@
     X(SnapshotCoinsProcessed, snapshot_coins_processed, INT, "", "") \
     X(ExpectedSnapshotHash, expected_snapshot_hash, HASH, "", "") \
     X(SnapshotHash, snapshot_hash, HASH, "", "") \
-    X(BlockIndexDescription, block_index_description, STRING, "", "")
+    X(BlockIndexDescription, block_index_description, STRING, "", "") \
+    X(SnapshotCacheMB, snapshot_cache_mb, UINT, "", "") \
+    X(SnapshotProgressPercent, snapshot_progress_percent, FLOAT, "", "")
 
 namespace BCLog {
 
diff --git a/src/validation.cpp b/src/validation.cpp
index 65aa657519f0c5670dc2dc07b823b689352547a6..2e39a5fc9e967802ae0f3da30a20bfc3362abcb5 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -8443,9 +8443,11 @@ util::Result<CBlockIndex *> ChainstateManager::ActivateSnapshot(
     LogInfoEvent(BCLog::ALL, "snapshot_activated",
                  "[snapshot] successfully activated snapshot {block_hash}")
         .Field(BCLog::LogField::BlockHash, base_blockhash);
-    LogPrintf("[snapshot] (%.2f MB)\n",
-              m_snapshot_chainstate->CoinsTip().DynamicMemoryUsage() /
-                  (1000 * 1000));
+    LogInfoEvent(BCLog::ALL, "snapshot_activated_cache",
+                 "[snapshot] ({snapshot_cache_mb:.2f} MB)")
+        .Field(BCLog::LogField::SnapshotCacheMB,
+               m_snapshot_chainstate->CoinsTip().DynamicMemoryUsage() /
+                   (1000 * 1000));
 
     this->MaybeRebalanceCaches();
     // The manager identity is unchanged, but RPC readers must observe the
@@ -8580,11 +8582,17 @@ bool ChainstateManager::PopulateAndValidateSnapshot(
                 ++coins_processed;
 
                 if (coins_processed % 1000000 == 0) {
-                    LogPrintf("[snapshot] %d coins loaded (%.2f%%, %.2f MB)\n",
-                              coins_processed,
-                              static_cast<float>(coins_processed) * 100 /
-                                  static_cast<float>(coins_count),
-                              coins_cache.DynamicMemoryUsage() / (1000 * 1000));
+                    LogInfoEvent(
+                        BCLog::ALL, "snapshot_coins_load_progress",
+                        "[snapshot] {snapshot_coins_processed} coins loaded ({snapshot_progress_percent:.2f}%, {snapshot_cache_mb:.2f} MB)")
+                        .Field(BCLog::LogField::SnapshotCoinsProcessed,
+                               coins_processed)
+                        .Field(BCLog::LogField::SnapshotProgressPercent,
+                               static_cast<float>(coins_processed) * 100 /
+                                   static_cast<float>(coins_count))
+                        .Field(BCLog::LogField::SnapshotCacheMB,
+                               coins_cache.DynamicMemoryUsage() /
+                                   (1000 * 1000));
                 }
 
                 // Batch write and flush (if we need to) every so often.
@@ -8648,9 +8656,13 @@ bool ChainstateManager::PopulateAndValidateSnapshot(
         return false;
     }
 
-    LogPrintf("[snapshot] loaded %d (%.2f MB) coins from snapshot %s\n",
-              coins_count, coins_cache.DynamicMemoryUsage() / (1000 * 1000),
-              base_blockhash.ToString());
+    LogInfoEvent(
+        BCLog::ALL, "snapshot_coins_loaded",
+        "[snapshot] loaded {count} ({snapshot_cache_mb:.2f} MB) coins from snapshot {block_hash}")
+        .Field(BCLog::LogField::Count, coins_count)
+        .Field(BCLog::LogField::SnapshotCacheMB,
+               coins_cache.DynamicMemoryUsage() / (1000 * 1000))
+        .Field(BCLog::LogField::BlockHash, base_blockhash);
 
     // No need to acquire cs_main since this chainstate isn't being used yet.
     FlushSnapshotToDisk(coins_cache, /*snapshot_loaded=*/true);
@@ -8724,8 +8736,10 @@ bool ChainstateManager::PopulateAndValidateSnapshot(
     index->m_chain_tx_count = au_data.m_chain_tx_count;
     snapshot_chainstate.setBlockIndexCandidates.insert(snapshot_start_block);
 
-    LogPrintf("[snapshot] validated snapshot (%.2f MB)\n",
-              coins_cache.DynamicMemoryUsage() / (1000 * 1000));
+    LogInfoEvent(BCLog::ALL, "snapshot_cache_validated",
+                 "[snapshot] validated snapshot ({snapshot_cache_mb:.2f} MB)")
+        .Field(BCLog::LogField::SnapshotCacheMB,
+               coins_cache.DynamicMemoryUsage() / (1000 * 1000));
     return true;
 }
 
