From fd8c2f6a2d1446c2c452c37084c2c8703d9073ba Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 14:43:27 -0700
Subject: [PATCH] logging: structure outbound TLS certificate reload
 diagnostics

Reuse certificate-path/error fields without changing the lock, mtime throttle,
OpenSSL policy or context replacement. Keep Info, exact readable text and
existing argument evaluation inside the logging guard. The event builder
never reads OpenSSL's error queue; no private key or certificate body is logged.

Add an actual ReloadingClientContext regression: load a generated certificate,
replace it with invalid bytes, wait through its real one-second throttle, and
verify that the prior valid SSL_CTX is retained with typed failure diagnostics.
No network sockets are opened by the regression.

Scripted diff (ast-grep-py 0.51.0):
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/tls-client-certificate-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/tls-client305-conversion.json --apply
  git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/tls_util.cpp src/test/logging_event_tests.cpp

Source-only checkpoint pending combined native gate. Shared eCash owner;
no TLS behavior changes. Preserve immutable native294 evidence separately.

diff --git a/contrib/logging/conversion/rules/tls-client-certificate-diagnostics.json b/contrib/logging/conversion/rules/tls-client-certificate-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..62e90e606ee670569df8c5385036fa500c3a5aa1
--- /dev/null
+++ b/contrib/logging/conversion/rules/tls-client-certificate-diagnostics.json
@@ -0,0 +1,48 @@
+{
+  "schema": 1,
+  "batch": "tls-client-certificate-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/tls_util.cpp",
+      "rules": [
+        {
+          "id": "tls_client_certificate_reload_failed",
+          "old": "LogPrintf(\"Not reloading TLS client certificate %s: %s\\n\",\n                  fs::PathToString(*m_cert), ErrorString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"tls_client_certificate_reload_failed\", \"Not reloading TLS client certificate {certificate_path}: {error}\").Field(BCLog::LogField::CertificatePath, fs::PathToString(*m_cert)).Field(BCLog::LogField::Error, ErrorString())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Not reloading TLS client certificate %s: %s\n",
+            "specifiers": [
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "fs::PathToString(*m_cert)",
+              "ErrorString()"
+            ]
+          },
+          "review_note": "Preserve Info, exact public certificate filename/error text, lock scope, one-second mtimecheck, TLS policy and retained prior valid context on failure. Log only existing path/error, never PEM/private-key contents. EventBuilder does not inspect the OpenSSL error queue; ErrorString remains inside the existing Info guard and original relative argument order."
+        },
+        {
+          "id": "tls_client_certificate_loaded",
+          "old": "LogPrintf(\"Loaded TLS client certificate %s\\n\", fs::PathToString(*m_cert))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"tls_client_certificate_loaded\", \"Loaded TLS client certificate {certificate_path}\").Field(BCLog::LogField::CertificatePath, fs::PathToString(*m_cert))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Loaded TLS client certificate %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "fs::PathToString(*m_cert)"
+            ]
+          },
+          "review_note": "Preserve Info, exact public certificate filename/error text, lock scope, one-second mtimecheck, TLS policy and retained prior valid context on failure. Log only existing path/error, never PEM/private-key contents. EventBuilder does not inspect the OpenSSL error queue; ErrorString remains inside the existing Info guard and original relative argument order."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 7ad8262e64bc9fc3fea31ebced4969f02e6e0038..be93a6e0cad78467f33bec6acae4663f91d98ed1 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -23,6 +23,7 @@
 #include <streams.h>
 #include <test/util/setup_common.h>
 #include <timedata.h>
+#include <tls_util.h>
 #include <univalue.h>
 #include <util/asmap.h>
 #include <util/fs.h>
@@ -54,6 +55,7 @@
 #include <optional>
 #include <sstream>
 #include <string>
+#include <thread>
 #include <vector>
 
 using BCLog::LogStatic;
@@ -1683,4 +1685,46 @@ BOOST_AUTO_TEST_CASE(actual_socket_failures_keep_errno_and_connection_levels) {
     BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
+BOOST_AUTO_TEST_CASE(actual_tls_client_reload_keeps_the_last_valid_context) {
+    Format(BCLog::LogFormat::JSON);
+    const auto cert{m_args.GetDataDirBase() / "logging-client-cert.pem"};
+    const auto key{m_args.GetDataDirBase() / "logging-client-key.pem"};
+    const auto pem{tls::GenerateSelfSigned(
+        "logging-client.example.org", {"logging-client.example.org"}, {}, 24h)};
+    BOOST_REQUIRE(pem.has_value());
+    BOOST_REQUIRE(tls::WritePemFiles(*pem, cert, key));
+    tls::ReloadingClientContext context{cert, key};
+    const auto valid{context.Get()};
+    BOOST_REQUIRE(valid);
+    auto row{Json()};
+    BOOST_CHECK_EQUAL(row["event"].get_str(), "tls_client_certificate_loaded");
+    BOOST_CHECK_EQUAL(row["certificate_path"].get_str(),
+                      fs::PathToString(cert));
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      "Loaded TLS client certificate " +
+                          fs::PathToString(cert));
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+    const auto modified{fs::last_write_time(cert)};
+    std::ofstream{cert} << "owned-invalid-certificate";
+    fs::last_write_time(cert, modified + 2s);
+    // Exercise the real one-second reload throttle instead of changing it.
+    std::this_thread::sleep_for(1100ms);
+    BOOST_CHECK(context.Get() == valid);
+    row = Json();
+    BOOST_CHECK_EQUAL(row["event"].get_str(),
+                      "tls_client_certificate_reload_failed");
+    BOOST_CHECK_EQUAL(row["certificate_path"].get_str(),
+                      fs::PathToString(cert));
+    BOOST_CHECK(!row["error"].get_str().empty());
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      "Not reloading TLS client certificate " +
+                          fs::PathToString(cert) + ": " +
+                          row["error"].get_str());
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+    BOOST_CHECK(row.write().find("BEGIN PRIVATE KEY") == std::string::npos);
+    BOOST_CHECK(row.write().find("BEGIN CERTIFICATE") == std::string::npos);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
