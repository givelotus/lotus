From aae6f65e1978e4f0c67325cca6b3d6675ae11870 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:01:48 -0700
Subject: [PATCH] fuzz: select chain parameters for
 snapshotmetadata_deserialize

The target reads the network magic from Params() before deserializing,
but nothing selected a chain, so Params() asserted on every input,
including the empty one. Give the target an initializer that selects
the main chain, as key_io and other Params()-dependent targets do.
Inherited from upstream's network-magic SnapshotMetadata constructor.

Tier: eCash

diff --git a/src/test/fuzz/deserialize.cpp b/src/test/fuzz/deserialize.cpp
index 65ac91d56e51c78fa41d6cbec969f2957cd5b7a6..7ff856104265fd4f03251ed3ef5ef0a09553891d 100644
--- a/src/test/fuzz/deserialize.cpp
+++ b/src/test/fuzz/deserialize.cpp
@@ -9,6 +9,7 @@
 #include <blockfileinfo.h>
 #include <blockfilter.h>
 #include <chain.h>
+#include <chainparams.h>
 #include <coins.h>
 #include <compressor.h>
 #include <consensus/merkle.h>
@@ -321,11 +322,20 @@ FUZZ_TARGET_DESERIALIZE(blocktransactionsrequest_deserialize, {
     BlockTransactionsRequest btr;
     DeserializeFromFuzzingInput(buffer, btr);
 })
-FUZZ_TARGET_DESERIALIZE(snapshotmetadata_deserialize, {
-    auto msg_start = Params().DiskMagic();
-    SnapshotMetadata snapshot_metadata{msg_start};
-    DeserializeFromFuzzingInput(buffer, snapshot_metadata);
-})
+// SnapshotMetadata takes the network magic from Params(), so select a chain
+// first; without one, Params() asserts on every input.
+static void initialize_snapshotmetadata_deserialize() {
+    SelectParams(ChainType::MAIN);
+}
+FUZZ_TARGET_INIT(snapshotmetadata_deserialize,
+                 initialize_snapshotmetadata_deserialize) {
+    try {
+        auto msg_start = Params().DiskMagic();
+        SnapshotMetadata snapshot_metadata{msg_start};
+        DeserializeFromFuzzingInput(buffer, snapshot_metadata);
+    } catch (const invalid_fuzzing_input_exception &) {
+    }
+}
 FUZZ_TARGET_DESERIALIZE(uint160_deserialize, {
     uint160 u160;
     DeserializeFromFuzzingInput(buffer, u160);
