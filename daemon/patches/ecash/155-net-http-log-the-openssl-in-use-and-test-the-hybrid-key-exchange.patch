 src/httpserver.cpp               |  1 +
 src/test/net_websocket_tests.cpp | 12 ++++++++++++
 src/tls_util.cpp                 | 33 +++++++++++++++++++++++++-------
 src/tls_util.h                   |  9 +++++++++
 4 files changed, 48 insertions(+), 7 deletions(-)

diff --git a/src/httpserver.cpp b/src/httpserver.cpp
index 560c548e01a1a130b2deb2ef0bca4385bac4dae7..f09393c761534e8433307000a600957c731f7315 100644
--- a/src/httpserver.cpp
+++ b/src/httpserver.cpp
@@ -2248,6 +2248,7 @@ bool InitHTTPServer(Config &config) {
         return false;
     }
 
+    LogPrintf("Using %s\n", tls::LibraryDescription());
     if (!InitTLS()) {
         return false;
     }
diff --git a/src/test/net_websocket_tests.cpp b/src/test/net_websocket_tests.cpp
index 36beecf8c63a5ed46300b8fe239349897d5e028d..1534e74b333bbd436a3c61a92dade4551994141f 100644
--- a/src/test/net_websocket_tests.cpp
+++ b/src/test/net_websocket_tests.cpp
@@ -11,6 +11,7 @@
 
 #include <random.h>
 #include <util/sock.h>
+#include <util/strencodings.h>
 
 #include <test/util/setup_common.h>
 
@@ -600,6 +601,17 @@ BOOST_AUTO_TEST_CASE(tls_client_profile) {
     TlsPair p{C::NONE};
     BOOST_CHECK_EQUAL(tls::NegotiatedAlpn(p.client_ssl), "http/1.1");
     BOOST_CHECK_EQUAL(tls::NegotiatedAlpn(p.server_ssl), "http/1.1");
+
+    // TLS 1.3 with the post-quantum hybrid key exchange from OpenSSL 3.5
+    // on, and X25519 before.
+    BOOST_CHECK_EQUAL(SSL_version(p.client_ssl), TLS1_3_VERSION);
+    BOOST_CHECK_EQUAL(tls::HasHybridKeyExchange(),
+                      OpenSSL_version_num() >= 0x30500000L);
+#if OPENSSL_VERSION_NUMBER >= 0x30200000L // SSL_get0_group_name
+    BOOST_CHECK_EQUAL(ToLower(SSL_get0_group_name(p.client_ssl)),
+                      tls::HasHybridKeyExchange() ? "x25519mlkem768"
+                                                  : "x25519");
+#endif
 }
 
 BOOST_AUTO_TEST_CASE(tls_spki_fingerprint) {
diff --git a/src/tls_util.cpp b/src/tls_util.cpp
index 7a76904ec12d7c3f45dcc2e346a6ae69ba4d8fa0..83757448fb05dd9bc13e706458c10da93d09cf3d 100644
--- a/src/tls_util.cpp
+++ b/src/tls_util.cpp
@@ -5,11 +5,13 @@
 #include <tls_util.h>
 
 #include <logging.h>
+#include <tinyformat.h>
 #include <util/strencodings.h>
 #include <util/string.h>
 
 #include <openssl/bio.h>
 #include <openssl/bn.h>
+#include <openssl/crypto.h>
 #include <openssl/err.h>
 #include <openssl/evp.h>
 #include <openssl/pem.h>
@@ -65,6 +67,11 @@ namespace {
 //! ALPN protocol list (length-prefixed): HTTP/1.1, which WebSocket uses
 constexpr unsigned char ALPN_HTTP11[]{8, 'h', 't', 't', 'p', '/', '1', '.', '1'};
 
+//! Key exchange groups the client offers, in Chrome's order
+constexpr const char *GROUPS_HYBRID{"X25519MLKEM768:X25519:P-256:P-384"};
+//! The same without the hybrid group, for OpenSSL < 3.5
+constexpr const char *GROUPS_CLASSIC{"X25519:P-256:P-384"};
+
 int SelectAlpn(SSL *, const unsigned char **out, unsigned char *outlen,
                const unsigned char *in, unsigned int inlen, void *) {
     unsigned char *selected{nullptr};
@@ -96,10 +103,9 @@ void ApplyClientProfile(SSL_CTX *ctx) {
              "ECDHE-RSA-AES128-SHA:ECDHE-RSA-AES256-SHA:AES128-GCM-SHA256:"
              "AES256-GCM-SHA384:AES128-SHA:AES256-SHA");
     // The post-quantum hybrid group needs OpenSSL >= 3.5.
-    if (SSL_CTX_set1_groups_list(ctx, "X25519MLKEM768:X25519:P-256:P-384") !=
-        1) {
+    if (SSL_CTX_set1_groups_list(ctx, GROUPS_HYBRID) != 1) {
         ERR_clear_error();
-        SSL_CTX_set1_groups_list(ctx, "X25519:P-256:P-384");
+        SSL_CTX_set1_groups_list(ctx, GROUPS_CLASSIC);
     }
     SSL_CTX_set1_sigalgs_list(
         ctx, "ECDSA+SHA256:rsa_pss_rsae_sha256:RSA+SHA256:ECDSA+SHA384:"
@@ -421,11 +427,24 @@ std::string CertSha256Hex(X509 *cert) {
 }
 
 X509 *PeerCertificate(const SSL *ssl) {
-#if OPENSSL_VERSION_NUMBER >= 0x30000000L
     return SSL_get1_peer_certificate(ssl);
-#else
-    return SSL_get_peer_certificate(ssl);
-#endif
+}
+
+bool HasHybridKeyExchange() {
+    static const bool has{[] {
+        SslCtxPtr ctx{SSL_CTX_new(TLS_client_method())};
+        const bool ok{ctx &&
+                      SSL_CTX_set1_groups_list(ctx.get(), GROUPS_HYBRID) == 1};
+        ERR_clear_error();
+        return ok;
+    }()};
+    return has;
+}
+
+std::string LibraryDescription() {
+    return strprintf("%s (built with %s), TLS client key exchange %s",
+                     OpenSSL_version(OPENSSL_VERSION), OPENSSL_VERSION_TEXT,
+                     HasHybridKeyExchange() ? GROUPS_HYBRID : GROUPS_CLASSIC);
 }
 
 std::string ErrorString() {
diff --git a/src/tls_util.h b/src/tls_util.h
index 4d8433e86f7342ece76298872df99fb7a0c5a7e9..fd8951a219ec7427797fe2a941924bded1f50737 100644
--- a/src/tls_util.h
+++ b/src/tls_util.h
@@ -118,6 +118,15 @@ std::string NegotiatedAlpn(const SSL *ssl);
 /** OpenSSL's queued error strings, for logging */
 std::string ErrorString();
 
+/**
+ * Whether the TLS client offers the X25519MLKEM768 post-quantum hybrid key
+ * exchange (OpenSSL >= 3.5; older versions fall back to X25519)
+ */
+bool HasHybridKeyExchange();
+
+/** The OpenSSL in use, the one built against, and the client's key exchange */
+std::string LibraryDescription();
+
 } // namespace tls
 
 #endif // BITCOIN_TLS_UTIL_H
