From 5975b516a40116d519c104ee862da0c94158bea1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:54:13 -0700
Subject: [PATCH] logging: structure RPC authentication-cookie file lifecycle
 paths

Preserve cookie randomness, contents, permissions, atomic rename, outputs
and return values. Record only the already logged absolute file paths;
use distinct source/destination roles on rename failure. Keep Info level
and exact human diagnostics. No credential data is added to logging.

The isolated startup fixture reads its temporary cookie only in memory,
then checks normal generation and two actual startup failures: missing
parent directory and a nonempty directory blocking rename. It checks
original initialization error behavior, path fields/text and absence of
cookie bytes/password fields from all log records. All files are owned
by the test. Tier: shared eCash, inherited unchanged by V2.

Scripted diff (ast-grep-py==0.51.0; from the commit's parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/rpc-cookie-diagnostics.json --apply

git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/rpc/request.cpp

Handwritten: focused functional lifecycle/failure/privacy assertions.
Registry append is an explicit support adjustment; old IDs unchanged.
---
 .../rules/rpc-cookie-diagnostics.json         | 76 +++++++++++++++++++
 src/logging/fields.h                          |  4 +-
 src/rpc/request.cpp                           | 19 +++--
 .../feature_logging_crypto_startup.py         | 52 +++++++++++--
 4 files changed, 139 insertions(+), 12 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/rpc-cookie-diagnostics.json

diff --git a/contrib/logging/conversion/rules/rpc-cookie-diagnostics.json b/contrib/logging/conversion/rules/rpc-cookie-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..45bebc27f6fc60be1b7ff6e9969feb792d87a7a2
--- /dev/null
+++ b/contrib/logging/conversion/rules/rpc-cookie-diagnostics.json
@@ -0,0 +1,76 @@
+{
+  "schema": 1,
+  "batch": "rpc-cookie-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/rpc/request.cpp",
+      "rules": [
+        {
+          "id": "rpc_cookie_open_failed",
+          "old": "LogPrintf(\"Unable to open cookie authentication file %s for writing\\n\",\n                  fs::PathToString(filepath_tmp))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"rpc_cookie_open_failed\", \"Unable to open cookie authentication file {path} for writing\").Field(BCLog::LogField::Path, fs::PathToString(filepath_tmp))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Unable to open cookie authentication file %s for writing\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "fs::PathToString(filepath_tmp)"
+            ]
+          },
+          "review_note": "Only existing absolute filesystem paths are recorded, never cookie bytes or random password. Preserve Info, exact text, file open/write/close/rename, permissions, outputs and returns. Separate source and destination paths without duplicate file.path mappings."
+        },
+        {
+          "id": "rpc_cookie_rename_failed",
+          "old": "LogPrintf(\"Unable to rename cookie authentication file %s to %s\\n\",\n                  fs::PathToString(filepath_tmp), fs::PathToString(filepath))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"rpc_cookie_rename_failed\", \"Unable to rename cookie authentication file {source_path} to {destination_path}\").Field(BCLog::LogField::SourcePath, fs::PathToString(filepath_tmp)).Field(BCLog::LogField::DestinationPath, fs::PathToString(filepath))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Unable to rename cookie authentication file %s to %s\n",
+            "specifiers": [
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "fs::PathToString(filepath_tmp)",
+              "fs::PathToString(filepath)"
+            ]
+          },
+          "review_note": "Only existing absolute filesystem paths are recorded, never cookie bytes or random password. Preserve Info, exact text, file open/write/close/rename, permissions, outputs and returns. Separate source and destination paths without duplicate file.path mappings."
+        },
+        {
+          "id": "rpc_cookie_generated",
+          "old": "LogPrintf(\"Generated RPC authentication cookie %s\\n\",\n              fs::PathToString(filepath))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"rpc_cookie_generated\", \"Generated RPC authentication cookie {path}\").Field(BCLog::LogField::Path, fs::PathToString(filepath))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Generated RPC authentication cookie %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "fs::PathToString(filepath)"
+            ]
+          },
+          "review_note": "Only existing absolute filesystem paths are recorded, never cookie bytes or random password. Preserve Info, exact text, file open/write/close/rename, permissions, outputs and returns. Separate source and destination paths without duplicate file.path mappings."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Two absolute filesystem path roles must remain distinct; neither carries cookie contents.",
+          "old": "    X(ScriptWorkerThreads, script_worker_threads, INT, \"\", \"\")\n",
+          "new": "    X(ScriptWorkerThreads, script_worker_threads, INT, \"\", \"\") \\\n    X(SourcePath, source_path, STRING, \"\", \"\") \\\n    X(DestinationPath, destination_path, STRING, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/logging/fields.h b/src/logging/fields.h
index 0c3eb7facf85f57d234c2bbfa9e999860471e1f3..e314fb7c6fc5e5dbfefdd0f20ebc994b65f93ab2 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -163,7 +163,9 @@
     X(BugReportURL, bug_report_url, STRING, "", "") \
     X(ExpectedChainTxCount, expected_chain_tx_count, UINT, "", "") \
     X(SHA256Implementation, sha256_implementation, STRING, "", "") \
-    X(ScriptWorkerThreads, script_worker_threads, INT, "", "")
+    X(ScriptWorkerThreads, script_worker_threads, INT, "", "") \
+    X(SourcePath, source_path, STRING, "", "") \
+    X(DestinationPath, destination_path, STRING, "", "")
 
 namespace BCLog {
 
diff --git a/src/rpc/request.cpp b/src/rpc/request.cpp
index 600816408e0b78e5ef63d85c34465c529156b858..e8f61c91428c77afc7d31776deb0c83a61fb7111 100644
--- a/src/rpc/request.cpp
+++ b/src/rpc/request.cpp
@@ -93,8 +93,10 @@ bool GenerateAuthCookie(std::string *cookie_out) {
     fs::path filepath_tmp = GetAuthCookieFile(true);
     file.open(filepath_tmp);
     if (!file.is_open()) {
-        LogPrintf("Unable to open cookie authentication file %s for writing\n",
-                  fs::PathToString(filepath_tmp));
+        LogInfoEvent(
+            BCLog::ALL, "rpc_cookie_open_failed",
+            "Unable to open cookie authentication file {path} for writing")
+            .Field(BCLog::LogField::Path, fs::PathToString(filepath_tmp));
         return false;
     }
     file << cookie;
@@ -102,12 +104,17 @@ bool GenerateAuthCookie(std::string *cookie_out) {
 
     fs::path filepath = GetAuthCookieFile(false);
     if (!RenameOver(filepath_tmp, filepath)) {
-        LogPrintf("Unable to rename cookie authentication file %s to %s\n",
-                  fs::PathToString(filepath_tmp), fs::PathToString(filepath));
+        LogInfoEvent(
+            BCLog::ALL, "rpc_cookie_rename_failed",
+            "Unable to rename cookie authentication file {source_path} to {destination_path}")
+            .Field(BCLog::LogField::SourcePath, fs::PathToString(filepath_tmp))
+            .Field(BCLog::LogField::DestinationPath,
+                   fs::PathToString(filepath));
         return false;
     }
-    LogPrintf("Generated RPC authentication cookie %s\n",
-              fs::PathToString(filepath));
+    LogInfoEvent(BCLog::ALL, "rpc_cookie_generated",
+                 "Generated RPC authentication cookie {path}")
+        .Field(BCLog::LogField::Path, fs::PathToString(filepath));
 
     if (cookie_out) {
         *cookie_out = cookie;
diff --git a/test/functional/feature_logging_crypto_startup.py b/test/functional/feature_logging_crypto_startup.py
index a4cb1526e473dbb54eab4223899732615d32c384..a81cca6f4c875090c40cb222c2a72e524d207e44 100644
--- a/test/functional/feature_logging_crypto_startup.py
+++ b/test/functional/feature_logging_crypto_startup.py
@@ -19,13 +19,55 @@ class CryptoStartupLoggingTest(BitcoinTestFramework):
     def run_test(self):
         node = self.nodes[0]
         assert_equal(node.getblockcount(), 0)
+        cookie_path = node.chain_path / ".cookie"
+        cookie = cookie_path.read_text()
+        assert cookie.startswith("__cookie__:")
         self.stop_node(0)
-        rows = [
-            json.loads(line)
-            for line in node.debug_log_path.read_text().splitlines()
-            if line.strip()
-        ]
+        # These paths and marker belong only to this isolated test datadir.
+        missing_cookie = node.chain_path / "missing-cookie-parent" / "auth"
+        init_error = "Error: Unable to start HTTP server. See debug log for details."
+        node.assert_start_raises_init_error(
+            extra_args=[*self.extra_args[0], f"-rpccookiefile={missing_cookie}"],
+            expected_msg=init_error,
+            timeout=5,
+        )
+        blocked_cookie = node.chain_path / "cookie-destination-directory"
+        blocked_cookie.mkdir()
+        (blocked_cookie / "owned-marker").write_text("keep this directory nonempty")
+        node.assert_start_raises_init_error(
+            extra_args=[*self.extra_args[0], f"-rpccookiefile={blocked_cookie}"],
+            expected_msg=init_error,
+            timeout=5,
+        )
+        log = node.debug_log_path.read_text()
+        assert cookie not in log
+        assert "__cookie__:" not in log
+        rows = [json.loads(line) for line in log.splitlines() if line.strip()]
         by_event = {row.get("event"): row for row in rows}
+        generated = by_event["rpc_cookie_generated"]
+        assert_equal(generated["path"], str(cookie_path))
+        assert_equal(
+            generated["message"], f"Generated RPC authentication cookie {cookie_path}"
+        )
+        opened = by_event["rpc_cookie_open_failed"]
+        assert_equal(opened["path"], str(missing_cookie) + ".tmp")
+        assert_equal(
+            opened["message"],
+            f"Unable to open cookie authentication file {missing_cookie}.tmp for writing",
+        )
+        renamed = by_event["rpc_cookie_rename_failed"]
+        assert_equal(renamed["source_path"], str(blocked_cookie) + ".tmp")
+        assert_equal(renamed["destination_path"], str(blocked_cookie))
+        assert "path" not in renamed
+        assert_equal(
+            renamed["message"],
+            f"Unable to rename cookie authentication file {blocked_cookie}.tmp to {blocked_cookie}",
+        )
+        for row in (generated, opened, renamed):
+            assert_equal(row["level"], "info")
+            assert "fields_truncated" not in row
+            assert "cookie" not in row
+            assert "password" not in row
         selected = by_event["sha256_implementation_selected"]
         implementation = selected["sha256_implementation"]
         assert isinstance(implementation, str) and implementation
