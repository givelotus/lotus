From 951756962f8bbeb1b79d8f6006ffe52591e75136 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 16:06:57 -0700
Subject: [PATCH] logging: identify wallet notification worker failures as
 typed events

Expose the three existing Info diagnostics without changing callback catch and
rethrow behavior, queue accounting, failure flags, shutdown or rescan policy.
Keep complete static fatal text; arbitrary exception text retains the typed
API's explicit bounded/truncation-flag contract. This does not repair wallet
serialization or notification logic. Rare actual failures are not newly
injected, and native validation remains pending.

Scripted diff (ast-grep-py0.51.0; three reviewed sites):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/wallet-notification-worker-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/wallet-worker363-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/node/interfaces.cpp
---
 ...allet-notification-worker-diagnostics.json | 55 +++++++++++++++++++
 src/node/interfaces.cpp                       | 18 ++++--
 2 files changed, 68 insertions(+), 5 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/wallet-notification-worker-diagnostics.json

diff --git a/contrib/logging/conversion/rules/wallet-notification-worker-diagnostics.json b/contrib/logging/conversion/rules/wallet-notification-worker-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..9de5d3bc1c2179fce9989a05fd5d2d655da67d80
--- /dev/null
+++ b/contrib/logging/conversion/rules/wallet-notification-worker-diagnostics.json
@@ -0,0 +1,55 @@
+{
+  "schema": 1,
+  "batch": "wallet-notification-worker-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/node/interfaces.cpp",
+      "rules": [
+        {
+          "id": "wallet_notification_worker_failed",
+          "old": "LogPrintf(\"FATAL: wallet notification worker failed; shutting \"\n                      \"down. The wallet rescans from its last flushed best \"\n                      \"block on restart.\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_notification_worker_failed\", \"FATAL: wallet notification worker failed; shutting down. The wallet rescans from its last flushed best block on restart.\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "FATAL: wallet notification worker failed; shutting down. The wallet rescans from its last flushed best block on restart.\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve Info despite FATAL/exception words, callback catch/rethrow behavior, m_failed ordering, shutdown request, queue/flush accounting and rescan promises. No transaction/wallet serialization or worker-recovery fix. Static failure text fits the bounded record; arbitrary exception text uses existing bounded Error contract and truncation flag. Rare actual callback/failure paths not newly injected."
+        },
+        {
+          "id": "wallet_notification_callback_exception",
+          "old": "LogPrintf(\"Wallet notification callback exception: %s\\n\", e.what())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_notification_callback_exception\", \"Wallet notification callback exception: {error}\").Field(BCLog::LogField::Error, e.what())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Wallet notification callback exception: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "e.what()"
+            ]
+          },
+          "review_note": "Preserve Info despite FATAL/exception words, callback catch/rethrow behavior, m_failed ordering, shutdown request, queue/flush accounting and rescan promises. No transaction/wallet serialization or worker-recovery fix. Static failure text fits the bounded record; arbitrary exception text uses existing bounded Error contract and truncation flag. Rare actual callback/failure paths not newly injected."
+        },
+        {
+          "id": "wallet_notification_callback_unknown_exception",
+          "old": "LogPrintf(\"Wallet notification callback exception: unknown exception\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_notification_callback_unknown_exception\", \"Wallet notification callback exception: unknown exception\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Wallet notification callback exception: unknown exception\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve Info despite FATAL/exception words, callback catch/rethrow behavior, m_failed ordering, shutdown request, queue/flush accounting and rescan promises. No transaction/wallet serialization or worker-recovery fix. Static failure text fits the bounded record; arbitrary exception text uses existing bounded Error contract and truncation flag. Rare actual callback/failure paths not newly injected."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/node/interfaces.cpp b/src/node/interfaces.cpp
index ecf19d8ee262dfbb6a03e3f7887ee849623e0e1f..2587a415d604250eb2bbcd92088f0860955ad588 100644
--- a/src/node/interfaces.cpp
+++ b/src/node/interfaces.cpp
@@ -530,9 +530,9 @@ namespace {
 
         void OnWorkerFailure() {
             m_failed = true;
-            LogPrintf("FATAL: wallet notification worker failed; shutting "
-                      "down. The wallet rescans from its last flushed best "
-                      "block on restart.\n");
+            LogInfoEvent(
+                BCLog::ALL, "wallet_notification_worker_failed",
+                "FATAL: wallet notification worker failed; shutting down. The wallet rescans from its last flushed best block on restart.");
             StartShutdown();
         }
 
@@ -549,10 +549,18 @@ namespace {
                                      try {
                                          f();
                                      } catch (const std::exception &e) {
-                                         LogPrintf("Wallet notification callback exception: %s\n", e.what());
+                                         LogInfoEvent(
+                                             BCLog::ALL,
+                                             "wallet_notification_callback_exception",
+                                             "Wallet notification callback exception: {error}")
+                                             .Field(BCLog::LogField::Error,
+                                                    e.what());
                                          throw;
                                      } catch (...) {
-                                         LogPrintf("Wallet notification callback exception: unknown exception\n");
+                                         LogInfoEvent(
+                                             BCLog::ALL,
+                                             "wallet_notification_callback_unknown_exception",
+                                             "Wallet notification callback exception: unknown exception");
                                          throw;
                                      }
                                  }
-- 
2.50.1 (Apple Git-155)

