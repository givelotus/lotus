From 2667b851548cd0bb2c44ed67ca3b8888b22430c4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 12:12:56 -0700
Subject: [PATCH] uint256: compare hashes by words and separate equality from
 ordering

Compare little-endian 64-bit words from the most significant end, with memcpy-based ReadLE64 loads for byte-aligned blobs and the original byte loop for constant evaluation and partial words. Keep numeric ordering unchanged. Equality uses the byte array directly so compilers can select wide loads without computing a three-way numeric comparison.

Add boundary, partial-word and constexpr coverage. An external ASan/UBSan differential check passes 400,000 random, identical and single-byte-difference pairs at widths 8, 40, 160 and 256. Native daemon rebuild and endpoint comparison remain pending; standalone comparator timings do not establish transaction throughput.
---
 src/test/uint256_tests.cpp | 29 +++++++++++++++++++++++++++++
 src/uint256.h              | 25 ++++++++++++++++++++-----
 2 files changed, 49 insertions(+), 5 deletions(-)

diff --git a/src/test/uint256_tests.cpp b/src/test/uint256_tests.cpp
index ed3f664b68b446920a5a30f849015daffb86c569..9948788372a4f36c13cf1b43937f7c23a56c1b30 100644
--- a/src/test/uint256_tests.cpp
+++ b/src/test/uint256_tests.cpp
@@ -176,6 +176,35 @@ BOOST_AUTO_TEST_CASE(comparison) {
                  "001"));
 }
 
+BOOST_AUTO_TEST_CASE(comparison_word_boundaries) {
+    static_assert(uint256{1} < uint256{2});
+    static_assert(uint256{1} == uint256{1});
+    static_assert(uint256{1} != uint256{2});
+
+    // Exercise every possible first differing byte, including partial words.
+    auto check = []<unsigned int BITS>() {
+        base_blob<BITS> a;
+        base_blob<BITS> b;
+        std::fill(a.begin(), a.end(), 0x80);
+        b = a;
+        for (size_t i = 0; i < a.size(); ++i) {
+            b.begin()[i] = 0x81;
+            // Lower bytes must not override the first differing high byte.
+            std::fill(b.begin(), b.begin() + i, 0);
+            BOOST_CHECK(a < b);
+            BOOST_CHECK(b > a);
+            BOOST_CHECK(a != b);
+            b = a;
+        }
+        BOOST_CHECK_EQUAL(a.Compare(b), 0);
+        BOOST_CHECK(a == b);
+    };
+    check.operator()<8>();
+    check.operator()<40>();
+    check.operator()<160>();
+    check.operator()<256>();
+}
+
 // GetHex SetHexDeprecated FromHex begin() end() size() GetLow64
 // GetSerializeSize, Serialize, Unserialize
 BOOST_AUTO_TEST_CASE(methods) {
diff --git a/src/uint256.h b/src/uint256.h
index 80a040cf2c8c072b8ed664ba278c820ad4d8bc8f..34eab7066f85e056627e68811d421553bcd2b54b 100644
--- a/src/uint256.h
+++ b/src/uint256.h
@@ -19,6 +19,7 @@
 #include <optional>
 #include <string>
 #include <string_view>
+#include <type_traits>
 
 /** Template base class for fixed-sized opaque blobs. */
 template <unsigned int BITS> class base_blob {
@@ -49,9 +50,23 @@ public:
     constexpr void SetNull() { std::fill(m_data.begin(), m_data.end(), 0); }
 
     constexpr int Compare(const base_blob &other) const {
-        for (size_t i = 0; i < WIDTH; i++) {
-            uint8_t a = m_data[WIDTH - 1 - i];
-            uint8_t b = other.m_data[WIDTH - 1 - i];
+        size_t i = WIDTH;
+        if (!std::is_constant_evaluated()) {
+            // The highest little-endian word determines numeric ordering.
+            // ReadLE64 uses memcpy, so byte-aligned blobs remain safe to read.
+            while (i >= sizeof(uint64_t)) {
+                i -= sizeof(uint64_t);
+                const uint64_t a = ReadLE64(m_data.data() + i);
+                const uint64_t b = ReadLE64(other.m_data.data() + i);
+                if (a != b) {
+                    return a < b ? -1 : 1;
+                }
+            }
+        }
+        while (i > 0) {
+            --i;
+            uint8_t a = m_data[i];
+            uint8_t b = other.m_data[i];
             if (a > b) {
                 return 1;
             }
@@ -64,10 +79,10 @@ public:
     }
 
     friend constexpr bool operator==(const base_blob &a, const base_blob &b) {
-        return a.Compare(b) == 0;
+        return a.m_data == b.m_data;
     }
     friend constexpr bool operator!=(const base_blob &a, const base_blob &b) {
-        return a.Compare(b) != 0;
+        return !(a == b);
     }
     friend constexpr bool operator<(const base_blob &a, const base_blob &b) {
         return a.Compare(b) < 0;
