From ac7facb69831b1cff56d0a1d4a485749b6a1a7db Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:27:34 -0700
Subject: [PATCH] logging: structure chain parking and work-based unpark
 diagnostics

Preserve all parking/finality/reorg predicates, status mutations, work
thresholds and returns. Keep Info level and existing human messages.
Copy actual block hashes into typed fields; keep the existing policy
state ToString call and snapshot it as a reason string.

Exact AST mappings and range-format replay cover all four sites. They
reuse field kinds already covered by the native Logger suite. This
conversion does not newly force rare parking or finality branches and
must not be described as parking-policy validation. Tier: shared eCash.

Scripted diff (ast-grep-py==0.51.0; from the commit's parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/chain-parking-diagnostics.json --apply

git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/validation.cpp
---
 .../rules/chain-parking-diagnostics.json      | 80 +++++++++++++++++++
 src/validation.cpp                            | 32 +++++---
 2 files changed, 100 insertions(+), 12 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/chain-parking-diagnostics.json

diff --git a/contrib/logging/conversion/rules/chain-parking-diagnostics.json b/contrib/logging/conversion/rules/chain-parking-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..e1d18d3c7786315ccabfc4d8341b8d9d633e5302
--- /dev/null
+++ b/contrib/logging/conversion/rules/chain-parking-diagnostics.json
@@ -0,0 +1,80 @@
+{
+  "schema": 1,
+  "batch": "chain-parking-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "block_parked_policy",
+          "old": "LogPrintf(\n                                             \"Park block because it \"\n                                             \"violated a block policy: %s\\n\",\n                                             blockPolicyState.ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_parked_policy\", \"Park block because it violated a block policy: {reason}\").Field(BCLog::LogField::Reason, blockPolicyState.ToString())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Park block because it violated a block policy: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "blockPolicyState.ToString()"
+            ]
+          },
+          "review_note": "Logging only: preserve Info, policy/finality/work/reorg predicates, status changes, returns and exact readable diagnostics. BlockPolicyValidationState keeps its existing ToString call (no new producer formatting); raw BlockHash snapshot replaces existing hex formatting. No consensus or parking policy change."
+        },
+        {
+          "id": "block_parked_before_finalized_tip",
+          "old": "LogPrintf(\"Park block %s because it forks prior to the \"\n                          \"avalanche finalized chaintip.\\n\",\n                          pindexNew->GetBlockHash().ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_parked_before_finalized_tip\", \"Park block {block_hash} because it forks prior to the avalanche finalized chaintip.\").Field(BCLog::LogField::BlockHash, pindexNew->GetBlockHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Park block %s because it forks prior to the avalanche finalized chaintip.\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "pindexNew->GetBlockHash().ToString()"
+            ]
+          },
+          "review_note": "Logging only: preserve Info, policy/finality/work/reorg predicates, status changes, returns and exact readable diagnostics. BlockPolicyValidationState keeps its existing ToString call (no new producer formatting); raw BlockHash snapshot replaces existing hex formatting. No consensus or parking policy change."
+        },
+        {
+          "id": "chain_unparked_by_work",
+          "old": "LogPrintf(\"Unpark chain up to block %s as it has \"\n                              \"accumulated enough PoW.\\n\",\n                              pindexNew->GetBlockHash().ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"chain_unparked_by_work\", \"Unpark chain up to block {block_hash} as it has accumulated enough PoW.\").Field(BCLog::LogField::BlockHash, pindexNew->GetBlockHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Unpark chain up to block %s as it has accumulated enough PoW.\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "pindexNew->GetBlockHash().ToString()"
+            ]
+          },
+          "review_note": "Logging only: preserve Info, policy/finality/work/reorg predicates, status changes, returns and exact readable diagnostics. BlockPolicyValidationState keeps its existing ToString call (no new producer formatting); raw BlockHash snapshot replaces existing hex formatting. No consensus or parking policy change."
+        },
+        {
+          "id": "block_parked_deep_reorg",
+          "old": "LogPrintf(\"Park block %s as it would cause a deep reorg.\\n\",\n                      pindex->GetBlockHash().ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_parked_deep_reorg\", \"Park block {block_hash} as it would cause a deep reorg.\").Field(BCLog::LogField::BlockHash, pindex->GetBlockHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Park block %s as it would cause a deep reorg.\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "pindex->GetBlockHash().ToString()"
+            ]
+          },
+          "review_note": "Logging only: preserve Info, policy/finality/work/reorg predicates, status changes, returns and exact readable diagnostics. BlockPolicyValidationState keeps its existing ToString call (no new producer formatting); raw BlockHash snapshot replaces existing hex formatting. No consensus or parking policy change."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/validation.cpp b/src/validation.cpp
index 10a6fa11465a2ce70416c08a9c4b5ca441889330..f3b5b08f756a1bc01f1fc7f17cb94c679391d393 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4415,10 +4415,12 @@ bool Chainstate::ConnectTip(BlockValidationState &state,
                                  [&](const auto &policy) {
                                      bool ret = (*policy)(blockPolicyState);
                                      if (!ret) {
-                                         LogPrintf(
-                                             "Park block because it "
-                                             "violated a block policy: %s\n",
-                                             blockPolicyState.ToString());
+                                         LogInfoEvent(
+                                             BCLog::ALL, "block_parked_policy",
+                                             "Park block because it violated a block policy: {reason}")
+                                             .Field(
+                                                 BCLog::LogField::Reason,
+                                                 blockPolicyState.ToString());
                                      }
                                      return ret;
                                  }) != parkingPolicies.end()) {
@@ -4557,9 +4559,11 @@ CBlockIndex *Chainstate::FindMostWorkChain(
             if (m_avalancheFinalizedBlockIndex &&
                 !AreOnTheSameFork(pindexNew, m_avalancheFinalizedBlockIndex)) {
                 conflictsFinalizedAncestry = true;
-                LogPrintf("Park block %s because it forks prior to the "
-                          "avalanche finalized chaintip.\n",
-                          pindexNew->GetBlockHash().ToString());
+                LogInfoEvent(
+                    BCLog::ALL, "block_parked_before_finalized_tip",
+                    "Park block {block_hash} because it forks prior to the avalanche finalized chaintip.")
+                    .Field(BCLog::LogField::BlockHash,
+                           pindexNew->GetBlockHash());
                 node::CountParkedBlock(
                     node::BlockParkReason::FINALIZATION_CONFLICT);
                 pindexNew->nStatus = pindexNew->nStatus.withParked();
@@ -4643,9 +4647,11 @@ CBlockIndex *Chainstate::FindMostWorkChain(
                 }
                 if (pindexNew->nChainWork > requiredWork) {
                     // We have enough, clear the parked state.
-                    LogPrintf("Unpark chain up to block %s as it has "
-                              "accumulated enough PoW.\n",
-                              pindexNew->GetBlockHash().ToString());
+                    LogInfoEvent(
+                        BCLog::ALL, "chain_unparked_by_work",
+                        "Unpark chain up to block {block_hash} as it has accumulated enough PoW.")
+                        .Field(BCLog::LogField::BlockHash,
+                               pindexNew->GetBlockHash());
                     fParkedChain = false;
                     UnparkBlock(pindexTest);
                 }
@@ -6519,8 +6525,10 @@ bool ChainstateManager::AcceptBlock(const std::shared_ptr<const CBlock> &pblock,
         const CBlockIndex *pindexFork = ActiveChain().FindFork(pindex);
         if (!is_background_block && pindexFork &&
             pindexFork->nHeight + 1 < ActiveHeight()) {
-            LogPrintf("Park block %s as it would cause a deep reorg.\n",
-                      pindex->GetBlockHash().ToString());
+            LogInfoEvent(
+                BCLog::ALL, "block_parked_deep_reorg",
+                "Park block {block_hash} as it would cause a deep reorg.")
+                .Field(BCLog::LogField::BlockHash, pindex->GetBlockHash());
             node::CountParkedBlock(node::BlockParkReason::DEEP_REORG);
             pindex->nStatus = pindex->nStatus.withParked();
             m_blockman.m_dirty_blockindex.insert(pindex);
