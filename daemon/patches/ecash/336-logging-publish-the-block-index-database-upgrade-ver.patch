From 6ce6e52c3fe806e62b14bd90f139c733827c99d6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 15:37:50 -0700
Subject: [PATCH] logging: publish the block-index database upgrade version as
 an integer

Give the existing first-start upgrade message a stable event and numeric
CLIENT_VERSION. Keep the original Info text, placement before batch.Write,
version comparisons and database operations. A focused functional test reads
the running node's version, stops cleanly and checks the actual startup event;
no version constant is hardcoded into the fixture. Runtime validation pending.

Scripted diff (ast-grep-py0.51.0; explicit reviewed single-site catalog):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/block-index-database-version.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/blockdb-version340-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/txdb.cpp

diff --git a/contrib/logging/conversion/rules/block-index-database-version.json b/contrib/logging/conversion/rules/block-index-database-version.json
new file mode 100644
index 0000000000000000000000000000000000000000..117aa4270bdea9a8f1e9afbc477d91a56ec214a5
--- /dev/null
+++ b/contrib/logging/conversion/rules/block-index-database-version.json
@@ -0,0 +1,29 @@
+{
+  "schema": 1,
+  "batch": "block-index-database-version",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/txdb.cpp",
+      "rules": [
+        {
+          "id": "block_index_database_upgrading",
+          "old": "LogPrintf(\"Updating the block index database version to %d\\n\",\n              CLIENT_VERSION)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_index_database_upgrading\", \"Updating the block index database version to {version}\").Field(BCLog::LogField::Version, CLIENT_VERSION)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Updating the block index database version to %d\n",
+            "specifiers": [
+              "%d"
+            ],
+            "arguments": [
+              "CLIENT_VERSION"
+            ]
+          },
+          "review_note": "Preserve Info, exact signed CLIENT_VERSION diagnostic and its position before batch.Write. Existing database version comparisons, upgrade/reindex policy and WriteBatch semantics unchanged."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/txdb.cpp b/src/txdb.cpp
index d66ad87f186e6764e3d72881e29809c8783a5310..8a1582be470376786b47dd101154431cde1a644a 100644
--- a/src/txdb.cpp
+++ b/src/txdb.cpp
@@ -487,8 +487,9 @@ bool CBlockTreeDB::Upgrade() {
     // The DB is empty or recent enough.
     // Just write the new version number and consider the upgrade done.
     CDBBatch batch(*this);
-    LogPrintf("Updating the block index database version to %d\n",
-              CLIENT_VERSION);
+    LogInfoEvent(BCLog::ALL, "block_index_database_upgrading",
+                 "Updating the block index database version to {version}")
+        .Field(BCLog::LogField::Version, CLIENT_VERSION);
     batch.Write("version", uint64_t(CLIENT_VERSION));
     WriteBatch(batch);
     return true;
diff --git a/test/functional/feature_logging_block_database_version.py b/test/functional/feature_logging_block_database_version.py
new file mode 100644
index 0000000000000000000000000000000000000000..deb5fc4ac0b553dd0546d7c99182c930f4696ae6
--- /dev/null
+++ b/test/functional/feature_logging_block_database_version.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Real first-start block DB upgrade event agrees with the node's version."""
+
+import json
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+
+class BlockDatabaseVersionLoggingTest(BitcoinTestFramework):
+    num_nodes = 1
+    setup_clean_chain = True
+    wallet_names = []
+    extra_args = [["-logformat=json"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        assert_equal(node.getblockcount(), 0)
+        version = node.getnetworkinfo()["version"]
+        self.stop_node(0)
+        rows = [
+            json.loads(line)
+            for line in node.debug_log_path.read_text().splitlines()
+            if line.strip()
+        ]
+        event = {row.get("event"): row for row in rows}[
+            "block_index_database_upgrading"
+        ]
+        assert_equal(event["version"], version)
+        assert type(event["version"]) is int
+        assert_equal(
+            event["message"],
+            f"Updating the block index database version to {version}",
+        )
+        assert_equal(event["level"], "info")
+        assert "fields_truncated" not in event
+
+
+if __name__ == "__main__":
+    BlockDatabaseVersionLoggingTest().main()
