+++ b/contrib/logging/conversion/README.md
@@ -0,0 +1,62 @@
+# Reviewed structured logging conversions
+
+`convert.py` uses the C++ parser in pinned `ast-grep-py==0.51.0` to find logging
+calls and their arguments, including nested template and lambda expressions.
+It does not rewrite source with regular expressions. A small format parser uses
+regular expressions only on captured literal bodies. It retains the complete
+printf specifier in its inventory and rejects unsupported conversions rather
+than silently losing width, precision or escaping.
+
+Comby was considered first. It was absent on the macOS arm64 development host;
+the official 1.8.1 release provided Linux x86_64 assets only. The available
+ast-grep Python wheel correctly parsed the representative nested-template
+argument fixture. No claim that Comby could not implement these rules is made.
+
+The checked-in JSON rules are reviewed semantic mappings, not inferred schemas.
+They specify exact input ASTs, expected counts, event expressions, and review
+notes. Whitespace may differ in input; argument tokens may not. Missing,
+ambiguous, changed or unsupported mappings fail closed. Severity, category and
+literal message skeletons are checked independently. Adjacent ordinary C++
+string literals are supported. Raw/prefixed/dynamic formats, positional or
+star-width arguments, and formatting requiring unsupported renderer behavior
+remain legacy. General unsupported input appears in the rejection inventory;
+a matched invalid rule aborts without changing any file. C++ macro-related
+parse errors outside matched calls do not prevent conversion; parse errors
+intersecting a logging call abort.
+
+Fields such as `foo=%f` do not establish a domain name or type. New field
+semantics and argument adapters require review, registry checks, compilation
+and behavior tests. The tool never moves evaluation outside a logging macro or
+changes the surrounding control flow. The typed logging macros' disabled-arg
+and allocation contracts are independently covered by native tests and probes.
+
+Non-call changes (field registry entries, includes, functional assertions, and
+local formatting) are explicit `support_adjustments` in the rule catalog.
+Commit messages must identify them separately from call conversions. The rules
+preserve exact source snippets and reject ambiguous support adjustments.
+
+## Reproduce a conversion from its parent
+
+Use a caller-selected virtual environment outside the source tree:
+
+```sh
+python3 -m venv /path/to/logging-conversion-venv
+/path/to/logging-conversion-venv/bin/python -m pip install -r contrib/logging/conversion/requirements.txt
+/path/to/logging-conversion-venv/bin/python contrib/logging/conversion/test_convert.py
+/path/to/logging-conversion-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/rpc-lifecycle.json --report /path/to/rpc-inventory.json
+/path/to/logging-conversion-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/rpc-lifecycle.json --report /path/to/rpc-applied.json --apply
+```
+
+The first invocation prints a unified diff without editing. The report records
+the engine version, script/rules SHA256, input/output hashes, converted calls,
+and rejected calls with reasons. All files are prepared and validated before
+any write. Run against a clean parent checkout and inspect the diff. A second
+application produces an empty diff. No clang-format invocation or temporary
+draft is required to reproduce the checked-in mappings.
+
+Each consumer commit records its exact shell-quoted command, engine version,
+script/rules hashes, input scope, and explicit support adjustments. Earlier
+manual/reviewed conversions are not retroactively described as reproducible
+codemod consumers. Conversion commits still require structured-event lint,
+relevant native tests, and their own unchanged-source full functional gate;
+the script's textual checks do not replace behavioral validation.
diff --git a/contrib/logging/conversion/convert.py b/contrib/logging/conversion/convert.py
new file mode 100755
index 0000000000000000000000000000000000000000..f8b92ad06a9589dafce1a1e0856af3b697e173e7
--- /dev/null
+++ b/contrib/logging/conversion/convert.py
@@ -0,0 +1,323 @@
+#!/usr/bin/env python3
+"""Conservative reviewed C++ logging conversion; AST boundaries, never source regex.
+
+No event names, field semantics, severity or argument types are inferred. A rule
+is an explicitly reviewed old call/new expression pair. The token fingerprint
+includes every argument and format token, so changed inputs fail closed. Use
+--apply only after reviewing the dry-run inventory and diff.
+"""
+import argparse
+import difflib
+import hashlib
+import importlib.metadata
+import json
+from pathlib import Path
+import re
+import sys
+from ast_grep_py import SgRoot
+
+ENGINE = "0.51.0"
+LEGACY = {
+    "LogPrintf",
+    "LogInfo",
+    "LogWarning",
+    "LogError",
+    "LogDebug",
+    "LogTrace",
+    "LogPrint",
+    "LogPrintLevel",
+}
+EVENTS = {
+    "LogInfoEvent",
+    "LogWarningEvent",
+    "LogErrorEvent",
+    "LogEvent",
+    "LogTraceEvent",
+}
+SPEC = re.compile(
+    r"%(?:[-+ #0]*)(?:\d+)?(?:\.\d+)?(?:hh|ll|[hljztL])?[diuoxXfFeEgGaAcsp%]"
+)
+
+
+def parse(source):
+    root = SgRoot(source, "cpp").root()
+    return root
+
+
+def fingerprint(node):
+    if node.is_leaf():
+        return (node.kind(), node.text())
+    return (node.kind(), tuple(fingerprint(c) for c in node.children()))
+
+
+def calls(source, names):
+    result = []
+    for n in parse(source).find_all(kind="call_expression"):
+        fn = n.field("function")
+        if fn and fn.kind() == "identifier" and fn.text() in names:
+            if n.find(kind="ERROR") or any(a.kind() == "ERROR" for a in n.ancestors()):
+                raise ValueError("parse error intersects logging call; no edits made")
+            result.append(n)
+    return result
+
+
+def args(node):
+    return node.field("arguments").named_children()
+
+
+def literal(node):
+    # Parse adjacent ordinary literals through C++ AST children, not source regex.
+    if node.kind() == "concatenated_string":
+        return "".join(literal(c) for c in node.named_children())
+    if node.kind() != "string_literal" or not node.text().startswith('"'):
+        raise ValueError("dynamic, raw, prefixed or concatenated format")
+    # Normalize the one standard C++ escape JSON lacks, tracking pairs so an
+    # escaped backslash before an apostrophe keeps its original meaning.
+    raw = node.text()
+    normalized = []
+    index = 0
+    while index < len(raw):
+        if raw[index] == "\\" and index + 1 < len(raw):
+            following = raw[index + 1]
+            normalized.append("'" if following == "'" else raw[index:index + 2])
+            index += 2
+        else:
+            normalized.append(raw[index])
+            index += 1
+    try:
+        return json.loads("".join(normalized))
+    except (ValueError, TypeError):
+        raise ValueError("unsupported C++ literal escape") from None
+
+
+def format_parts(message):
+    parts = []
+    last = 0
+    for m in re.finditer("%", message):
+        if m.start() < last:
+            continue
+        spec = SPEC.match(message, m.start())
+        if not spec:
+            raise ValueError("unsupported printf specifier at byte " + str(m.start()))
+        parts.append((message[last : m.start()], spec.group()))
+        last = spec.end()
+    parts.append((message[last:], ""))
+    return parts
+
+
+def describe(node):
+    name = node.field("function").text()
+    index = (
+        2
+        if name == "LogPrintLevel"
+        else 1 if name in {"LogPrint", "LogDebug", "LogTrace"} else 0
+    )
+    values = args(node)
+    if index >= len(values):
+        raise ValueError("missing format argument")
+    message = literal(values[index])
+    parts = format_parts(message)
+    count = sum(bool(spec) and spec != "%%" for _, spec in parts)
+    if count != len(values) - index - 1:
+        raise ValueError("specifier/argument count mismatch")
+    return {
+        "macro": name,
+        "format": message,
+        "specifiers": [s for _, s in parts if s and s != "%%"],
+        "arguments": [v.text() for v in values[index + 1 :]],
+    }
+
+
+def outer_event(node):
+    while node.parent() and node.parent().kind() == "field_expression":
+        parent = node.parent().parent()
+        if not parent or parent.kind() != "call_expression":
+            break
+        node = parent
+    return node
+
+
+def validate_mapping(old, event):
+    description = describe(old)
+    # The event renderer has no printf width/precision language. Keep those
+    # calls legacy until an explicit rendering feature and regression exist.
+    if any(s not in {"%s", "%d", "%u"} for s in description["specifiers"]):
+        raise ValueError("format width/precision/type needs manual rendering support")
+    oldargs, newargs = args(old), args(event)
+    macro = description["macro"]
+    category = (
+        oldargs[0].text()
+        if macro in {"LogDebug", "LogTrace", "LogPrint", "LogPrintLevel"}
+        else "BCLog::ALL"
+    )
+    expected = {
+        "LogPrintf": "LogInfoEvent",
+        "LogInfo": "LogInfoEvent",
+        "LogWarning": "LogWarningEvent",
+        "LogError": "LogErrorEvent",
+        "LogDebug": "LogEvent",
+        "LogTrace": "LogTraceEvent",
+        "LogPrint": "LogEvent",
+    }.get(macro)
+    if macro == "LogPrintLevel":
+        expected = {
+            "BCLog::Level::Warning": "LogWarningEvent",
+            "BCLog::Level::Error": "LogErrorEvent",
+            "BCLog::Level::Info": "LogInfoEvent",
+            "BCLog::Level::Debug": "LogEvent",
+            "BCLog::Level::Trace": "LogTraceEvent",
+        }.get(oldargs[1].text())
+    if event.field("function").text() != expected or newargs[0].text() != category:
+        raise ValueError("severity/category changed")
+    message = literal(newargs[2])
+    # Regex only examines captured literal bodies, never source boundaries.
+    placeholders = re.findall(r"\{[a-z][a-z0-9_]*\}", message)
+    parts = format_parts(description["format"])
+    rebuilt = ""
+    cursor = 0
+    for text, spec in parts:
+        rebuilt += text
+        if spec == "%%":
+            rebuilt += "%"
+        elif spec:
+            if cursor >= len(placeholders):
+                raise ValueError("missing message placeholder")
+            rebuilt += placeholders[cursor]
+            cursor += 1
+    if rebuilt.endswith("\n"):
+        rebuilt = rebuilt[:-1]
+    if cursor != len(placeholders) or rebuilt != message:
+        raise ValueError("message wording/escaping changed")
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def convert(source, rules):
+    nodes = calls(source, LEGACY)
+    edits = []
+    report = []
+    seen = {}
+    by_key = {}
+    for rule in rules:
+        old = calls(rule["old"], LEGACY)
+        if len(old) != 1:
+            raise ValueError("rule must contain exactly one legacy call")
+        description = describe(old[0])
+        if description != rule["reviewed_input"]:
+            raise ValueError("reviewed input does not describe rule " + rule["id"])
+        new = calls(rule["replacement"], EVENTS)
+        if len(new) != 1 or outer_event(new[0]).text() != rule["replacement"]:
+            raise ValueError("replacement must be one structured event expression")
+        validate_mapping(old[0], new[0])
+        if not rule.get("review_note"):
+            raise ValueError("missing explicit mapping review")
+        key = fingerprint(old[0])
+        if key in by_key:
+            raise ValueError("duplicate input rule")
+        by_key[key] = rule
+        seen[rule["id"]] = 0
+    for n in nodes:
+        entry = {"line": n.range().start.line + 1, "call": n.text()}
+        try:
+            description = describe(n)
+            rule = by_key.get(fingerprint(n))
+            if not rule:
+                entry.update(
+                    status="rejected",
+                    reason="no reviewed semantic mapping",
+                    input=description,
+                )
+            else:
+                seen[rule["id"]] += 1
+                edits.append(n.replace(rule["replacement"]))
+                entry.update(status="converted", rule=rule["id"], input=description)
+        except ValueError as e:
+            entry.update(status="rejected", reason=str(e))
+        report.append(entry)
+    # Missing input is only idempotent when exactly the expected output exists.
+    output_nodes = [outer_event(n) for n in calls(source, EVENTS)]
+    for rule in rules:
+        if seen[rule["id"]] == 0:
+            expected = fingerprint(
+                parse(rule["replacement"]).find(kind="call_expression")
+            )
+            matches = sum(fingerprint(n) == expected for n in output_nodes)
+            if matches != rule.get("count", 1):
+                raise ValueError("missing/drifted rule " + rule["id"])
+        elif seen[rule["id"]] != rule.get("count", 1):
+            raise ValueError("unexpected match count for " + rule["id"])
+    return parse(source).commit_edits(edits), report
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--root", type=Path, default=Path("."))
+    p.add_argument("--rules", required=True, type=Path)
+    p.add_argument("--report", type=Path)
+    p.add_argument("--apply", action="store_true")
+    o = p.parse_args()
+    actual = importlib.metadata.version("ast-grep-py")
+    if actual != ENGINE:
+        p.error("requires ast-grep-py==" + ENGINE + ", got " + actual)
+    raw = o.rules.read_bytes()
+    catalog = json.loads(raw)
+    prepared = []
+    receipt = {
+        "engine": "ast-grep-py " + actual,
+        "rules_sha256": digest(raw),
+        "script_sha256": digest(Path(__file__).read_bytes()),
+        "applied": o.apply,
+        "files": [],
+    }
+    for item in catalog["files"]:
+        path = o.root / item["path"]
+        before = path.read_text()
+        after, inventory = convert(before, item["rules"])
+        # Explicit non-call support adjustments are reviewed separately: fields,
+        # includes and functional assertions. They are never guessed from text.
+        for adjustment in item.get("support_adjustments", []):
+            old, new = adjustment["old"], adjustment["new"]
+            if new in after:
+                # A replacement can contain its old anchor (e.g. an include
+                # insertion). Recognize the complete result before the anchor.
+                if after.count(new) != 1 or old in after.replace(new, "", 1):
+                    raise ValueError(
+                        "ambiguous support adjustment " + adjustment["purpose"]
+                    )
+            elif after.count(old) == 1:
+                after = after.replace(old, new, 1)
+            else:
+                raise ValueError(
+                    "drifted/ambiguous support adjustment " + adjustment["purpose"]
+                )
+        if after != before:
+            prepared.append((path, after))
+        receipt["files"].append(
+            {
+                "path": item["path"],
+                "before_sha256": digest(before.encode()),
+                "after_sha256": digest(after.encode()),
+                "converted": sum(i["status"] == "converted" for i in inventory),
+                "rejected": sum(i["status"] == "rejected" for i in inventory),
+                "inventory": inventory,
+            }
+        )
+        sys.stdout.writelines(
+            difflib.unified_diff(
+                before.splitlines(True),
+                after.splitlines(True),
+                fromfile="a/" + item["path"],
+                tofile="b/" + item["path"],
+            )
+        )
+    if o.apply:
+        for path, after in prepared:
+            path.write_text(after)
+    if o.report:
+        o.report.write_text(json.dumps(receipt, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
