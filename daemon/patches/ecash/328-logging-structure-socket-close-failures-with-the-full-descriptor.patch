From b59ea1bb634ee079884ee1a1b9dc021561e3e98e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 14:44:24 -0700
Subject: [PATCH] logging: structure socket-close failures with the full
 descriptor

Copy the original unsigned SOCKET value without narrowing its legacy %d
spelling. Capture numeric errno/WSA last-error immediately after close fails,
and keep error string formatting inside the existing Info guard. Preserve
close/closesocket, the invalid guard, descriptor reset and readable text.

Add an actual POSIX Sock destructor control using invalid fd -2: it cannot
close a live descriptor or race descriptor reuse. Check unsigned JSON, the
EBADF text and exact legacy tinyformat rendering. This is not a Windows
socket-handle control; that platform path is explicitly not forced.

Scripted diff (ast-grep-py 0.51.0):
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/socket-close-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/socket-close306-conversion.json --apply
  git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/util/sock.cpp src/test/logging_event_tests.cpp

Source-only checkpoint pending combined native gate. Shared eCash owner;
no socket semantics change. Preserve immutable native294 proof separately.
---
 .../rules/socket-close-diagnostics.json       | 49 +++++++++++++++++++
 src/logging/fields.h                          |  3 +-
 src/test/logging_event_tests.cpp              | 28 +++++++++++
 src/util/sock.cpp                             |  7 ++-
 4 files changed, 84 insertions(+), 3 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/socket-close-diagnostics.json

diff --git a/contrib/logging/conversion/rules/socket-close-diagnostics.json b/contrib/logging/conversion/rules/socket-close-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..b514643b13fa207b45c2fa4077b1f4d8dd2d04a5
--- /dev/null
+++ b/contrib/logging/conversion/rules/socket-close-diagnostics.json
@@ -0,0 +1,49 @@
+{
+  "schema": 1,
+  "batch": "socket-close-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/util/sock.cpp",
+      "rules": [
+        {
+          "id": "network_socket_close_failed",
+          "old": "LogPrintf(\"Error closing socket %d: %s\\n\", m_socket,\n                  NetworkErrorString(WSAGetLastError()))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"network_socket_close_failed\", \"Error closing socket {socket_descriptor}: {error}\").Field(BCLog::LogField::SocketDescriptor, m_socket).Field(BCLog::LogField::Error, NetworkErrorString(socket_error))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Error closing socket %d: %s\n",
+            "specifiers": [
+              "%d",
+              "%s"
+            ],
+            "arguments": [
+              "m_socket",
+              "NetworkErrorString(WSAGetLastError())"
+            ]
+          },
+          "review_note": "Preserve Info, exact close descriptor/error text, closesocket/close call, INVALID_SOCKET guard/reset and destructor behavior. SOCKET is unsigned on POSIX and UINT_PTR on Windows; preserve full bits despite legacy %d. Numeric last-error snapshot precedes builder, stringrendering remains guarded."
+        }
+      ],
+      "support_adjustments": [
+        {
+          "purpose": "Save numeric errno/WSAerror immediately after failed close before logger can touch it.",
+          "old": "LogInfoEvent(BCLog::ALL, \"network_socket_close_failed\", \"Error closing socket {socket_descriptor}: {error}\").Field(BCLog::LogField::SocketDescriptor, m_socket).Field(BCLog::LogField::Error, NetworkErrorString(socket_error));",
+          "new": "const int socket_error{WSAGetLastError()};\n        LogInfoEvent(BCLog::ALL, \"network_socket_close_failed\", \"Error closing socket {socket_descriptor}: {error}\").Field(BCLog::LogField::SocketDescriptor, m_socket).Field(BCLog::LogField::Error, NetworkErrorString(socket_error));"
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Full unsigned native socket descriptor without narrowing or treating it as a peer ID.",
+          "old": "    X(WaitMilliseconds, wait_milliseconds, INT, \"\", \"\")\n",
+          "new": "    X(WaitMilliseconds, wait_milliseconds, INT, \"\", \"\") \\\n    X(SocketDescriptor, socket_descriptor, UINT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/logging/fields.h b/src/logging/fields.h
index d200c36031f9f0dd9344e27f30d8af3585aa7970..59b93080695f5f81ea9ad44e6b68ed6d6401285e 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -192,7 +192,8 @@
     X(InflightLimitBytes, inflight_limit_bytes, UINT, "", "") \
     X(WaitSeconds, wait_seconds, INT, "", "") \
     X(NetworkActive, network_active, BOOL, "", "") \
-    X(WaitMilliseconds, wait_milliseconds, INT, "", "")
+    X(WaitMilliseconds, wait_milliseconds, INT, "", "") \
+    X(SocketDescriptor, socket_descriptor, UINT, "", "")
 
 namespace BCLog {
 
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index be93a6e0cad78467f33bec6acae4663f91d98ed1..068ae53fd540ea391ac652129756ade48fb2232b 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -1727,4 +1727,32 @@ BOOST_AUTO_TEST_CASE(actual_tls_client_reload_keeps_the_last_valid_context) {
     BOOST_CHECK(row.write().find("BEGIN CERTIFICATE") == std::string::npos);
 }
 
+BOOST_AUTO_TEST_CASE(
+    actual_posix_socket_close_failure_keeps_unsigned_descriptor) {
+#ifndef WIN32
+    Format(BCLog::LogFormat::JSON);
+    // -2 is always an invalid POSIX fd, distinct from INVALID_SOCKET (-1).
+    // No owned or foreign live descriptor is closed or raced for reuse.
+    const auto descriptor{static_cast<SOCKET>(-2)};
+    {
+        Sock invalid{descriptor};
+    }
+    const auto row{Json()};
+    BOOST_CHECK_EQUAL(row["event"].get_str(), "network_socket_close_failed");
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_CHECK(row["socket_descriptor"].isNum());
+    BOOST_CHECK_EQUAL(row["socket_descriptor"].getInt<uint64_t>(),
+                      static_cast<uint64_t>(descriptor));
+    const auto error{NetworkErrorString(EBADF)};
+    BOOST_CHECK_EQUAL(row["error"].get_str(), error);
+    BOOST_CHECK_EQUAL(
+        row["message"].get_str(),
+        strprintf("Error closing socket %d: %s", descriptor, error));
+    BOOST_CHECK(row["fields_truncated"].isNull());
+#else
+    BOOST_TEST_MESSAGE(
+        "POSIX invalid-fd control is not a Windows socket-handle test");
+#endif
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/util/sock.cpp b/src/util/sock.cpp
index d0f937cb2ae07e45c702b2fc8f68b61caf6ae2a0..ff4e5b1f5b7fa9a888f0f72edfece8ce62ba4bfe 100644
--- a/src/util/sock.cpp
+++ b/src/util/sock.cpp
@@ -431,8 +431,11 @@ void Sock::Close() {
     int ret = close(m_socket);
 #endif
     if (ret) {
-        LogPrintf("Error closing socket %d: %s\n", m_socket,
-                  NetworkErrorString(WSAGetLastError()));
+        const int socket_error{WSAGetLastError()};
+        LogInfoEvent(BCLog::ALL, "network_socket_close_failed",
+                     "Error closing socket {socket_descriptor}: {error}")
+            .Field(BCLog::LogField::SocketDescriptor, m_socket)
+            .Field(BCLog::LogField::Error, NetworkErrorString(socket_error));
     }
     m_socket = INVALID_SOCKET;
 }
