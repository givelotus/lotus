+# What each of the framework's phases is shown as
+PHASE_LABELS = {
+    "chain_init": "setting up chain",
+    "network_setup": "starting nodes",
+    "body": "running",
+    "final_stop": "stopping nodes",
+    "cleanup": "cleaning up",
