+            done,
+            self.total,
+            failed,
+            running,
+            size.columns,
+            size.lines,
+            time.time(),
+        )
+        self.clear()
+        self.stream.write("".join(line + "\n" for line in lines))
         self.stream.flush()
-        self.shown = True
