diff --git a/src/init.cpp b/src/init.cpp
index 20cba0a251ccdf547dc1ecb06986e87e005ed551..c118e98172addd6199727047e44377fb14d4c5f4 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -2598,7 +2598,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
         [&args] {
             constexpr uint64_t min_disk_space = 250_MiB;
             if (!CheckDiskSpace(args.GetBlocksDirPath(), min_disk_space)) {
-                LogPrintf("Shutting down due to lack of disk space!\n");
+                LogInfoEvent(BCLog::ALL, "shutdown_disk_space",
+                             "Shutting down due to lack of disk space!");
                 StartShutdown();
             }
             return true;
@@ -2680,7 +2681,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
             LogPrintf("Using asmap version %s for IP bucketing\n",
                       asmap_version.ToString());
