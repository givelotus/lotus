     }
 
@@ -3309,7 +3319,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
             ImportBlocks(chainman, avalanche, vImportFiles);
             if (args.GetBoolArg("-stopafterblockimport",
