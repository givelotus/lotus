index 0000000000000000000000000000000000000000..fa57c15f0ec49b3778dd4887370bbca6046bfbe1
--- /dev/null
+++ b/chronik/native/test/mem_group_utxos_tests.cpp
@@ -0,0 +1,191 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Port of chronik-db mem/group_utxos.rs tests, plus prefix iteration.
+
+#include <chronik/native/mem/group_utxos.h>
+
+#include <test/index_test_util.h>
+#include <test/index_value_group.h>
+
+#include <boost/test/unit_test.hpp>
+
+using namespace chronik::native;
+using namespace chronik::native::mem;
+using chronik::native::test::ErrorMsg;
+using chronik::native::test::MakeInputsTx;
+using chronik::native::test::SerValue;
+using chronik::native::test::TxIdNum;
+using chronik::native::test::ValueGroup;
+
+namespace {
+
+MempoolTx MakeMempoolTx(
+    uint8_t txid_num,
+    const std::vector<std::tuple<uint8_t, uint32_t, int64_t>> &input_values,
+    const std::vector<int64_t> &output_values) {
+    return MempoolTx{std::make_shared<const Tx>(MakeInputsTx(
+                         txid_num, input_values, output_values)),
+                     0};
+}
+
+MempoolGroupUtxos::Utxos
+MakeOutpoints(const std::vector<std::pair<uint8_t, uint32_t>> &outpoints) {
+    MempoolGroupUtxos::Utxos set;
+    for (const auto &[txid_num, out_idx] : outpoints) {
+        set.insert(OutPoint{TxIdNum(txid_num), out_idx});
+    }
+    return set;
+}
+
+bool IsMempoolTx(const TxId &txid) {
+    return txid.b[0] < 10;
+}
+
+std::string Hex32(uint8_t num) {
+    static const char *digits = "0123456789abcdef";
+    std::string out;
+    for (int i = 0; i < 32; ++i) {
+        out += digits[num >> 4];
+        out += digits[num & 0xf];
+    }
+    return out;
+}
+
+std::string OutPointDebug(uint8_t txid_num, uint32_t out_idx) {
+    return "OutPoint { txid: TxId(" + Hex32(txid_num) +
+           "), out_idx: " + std::to_string(out_idx) + " }";
+}
+
+} // namespace
+
+BOOST_AUTO_TEST_SUITE(mem_group_utxos_tests)
+
+BOOST_AUTO_TEST_CASE(test_mempool_group_utxos) {
+    const ValueGroup value_group;
+    MempoolGroupUtxos mempool(value_group);
+    auto utxos = [&](int64_t val) { return mempool.GetUtxos(SerValue(val)); };
+    auto utxos_eq = [&](int64_t val, const MempoolGroupUtxos::Utxos &exp) {
+        const MempoolGroupUtxos::Utxos *got = utxos(val);
+        return got && *got == exp;
+    };
+
+    // spend a confirmed UTXO
+    const MempoolTx tx1 = MakeMempoolTx(1, {{10, 4, 100}}, {101});
+    mempool.Insert(tx1, IsMempoolTx, nullptr);
+    BOOST_CHECK(utxos(100) == nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{1, 0}})));
+
+    // adding again fails
+    BOOST_CHECK_EQUAL(
+        ErrorMsg([&] { mempool.Insert(tx1, IsMempoolTx, nullptr); }),
+        "Inconsistent mempool: UTXO " + OutPointDebug(1, 0) +
+            " already exists in mempool");
+
+    // trying to spend a non-existent mempool UTXO fails
+    for (const int64_t value : {
+             999, // value=999 has no UTXO entries
+             101, // value=101 has one entry but for txid=1, out_idx=0
+         }) {
+        BOOST_CHECK_EQUAL(ErrorMsg([&] {
+                              mempool.Insert(
+                                  MakeMempoolTx(3, {{2, 4, value}}, {}),
+                                  IsMempoolTx, nullptr);
+                          }),
+                          "Inconsistent mempool: UTXO " +
+                              OutPointDebug(2, 4) + " spent by " + Hex32(3) +
+                              " doesn't exist in mempool");
+    }
+
+    // trying to remove a tx with non-existent outputs fails
+    for (const int64_t value : {999, 101}) {
+        BOOST_CHECK_EQUAL(
+            ErrorMsg([&] {
+                mempool.Remove(MakeMempoolTx(3, {}, {value}), IsMempoolTx,
+                               nullptr);
+            }),
+            "Inconsistent mempool when removing tx: UTXO " +
+                OutPointDebug(3, 0) + " doesn't exist in mempool");
+    }
+
+    // Removing tx1 results in an empty state
+    mempool.Remove(tx1, IsMempoolTx, nullptr);
+    BOOST_CHECK(mempool.All().empty());
+
+    // Mining tx1 also results in an empty state
+    mempool.Insert(tx1, IsMempoolTx, nullptr);
+    mempool.RemoveMined(tx1, nullptr);
+    BOOST_CHECK(mempool.All().empty());
+
+    // Add back to mempool again
+    mempool.Insert(tx1, IsMempoolTx, nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{1, 0}})));
+
+    const MempoolTx tx2 = MakeMempoolTx(2, {{1, 0, 101}}, {102, 101});
+    mempool.Insert(tx2, IsMempoolTx, nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{2, 1}})));
+    BOOST_CHECK(utxos_eq(102, MakeOutpoints({{2, 0}})));
+
+    // Removing tx2 restores tx1's outputs, and removes tx2's outputs
+    mempool.Remove(tx2, IsMempoolTx, nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{1, 0}})));
+    BOOST_CHECK(utxos(102) == nullptr);
+
+    // Trying to remove tx2 again fails
+    BOOST_CHECK_EQUAL(
+        ErrorMsg([&] { mempool.Remove(tx2, IsMempoolTx, nullptr); }),
+        "Inconsistent mempool: UTXO " + OutPointDebug(1, 0) +
+            " already unspent in mempool");
+
+    // Add tx2 again
+    mempool.Insert(tx2, IsMempoolTx, nullptr);
+
+    // Add tx3
+    const MempoolTx tx3 =
+        MakeMempoolTx(3, {{2, 0, 102}, {11, 4, 101}}, {101});
+    mempool.Insert(tx3, IsMempoolTx, nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{2, 1}, {3, 0}})));
+    BOOST_CHECK(utxos(102) == nullptr);
+
+    // Mine tx1: leaves everything unchanged
+    mempool.RemoveMined(tx1, nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{2, 1}, {3, 0}})));
+    BOOST_CHECK(utxos(102) == nullptr);
+
+    // Mine tx2: removes its outputs
+    mempool.RemoveMined(tx2, nullptr);
+    BOOST_CHECK(utxos_eq(101, MakeOutpoints({{3, 0}})));
+    BOOST_CHECK(utxos(102) == nullptr);
+
+    // Mine tx3: results in an empty state
+    mempool.RemoveMined(tx3, nullptr);
+    BOOST_CHECK(mempool.All().empty());
+}
+
+BOOST_AUTO_TEST_CASE(test_mempool_group_utxos_prefix) {
+    const ValueGroup value_group;
+    MempoolGroupUtxos mempool(value_group);
+    mempool.Insert(MakeMempoolTx(1, {}, {0x0101, 0x0102, 0x0201}),
+                   IsMempoolTx, nullptr);
+    std::vector<Bytes> visited;
+    auto collect = [&](const Bytes &member, const MempoolGroupUtxos::Utxos &) {
+        visited.push_back(member);
+        return true;
+    };
+    const Bytes prefix = {0, 0, 0, 0, 0, 0, 1};
+    mempool.VisitPrefix(prefix, prefix, collect);
+    BOOST_CHECK(visited ==
+                (std::vector<Bytes>{SerValue(0x0101), SerValue(0x0102)}));
+    visited.clear();
+    mempool.VisitPrefix(prefix, SerValue(0x0102), collect);
+    BOOST_CHECK(visited == (std::vector<Bytes>{SerValue(0x0102)}));
+    visited.clear();
+    mempool.VisitPrefix({}, {}, [&](const Bytes &member, const auto &) {
+        visited.push_back(member);
+        return false;
+    });
+    BOOST_CHECK_EQUAL(visited.size(), 1U);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
diff --git a/chronik/native/test/mem_mempool_tests.cpp b/chronik/native/test/mem_mempool_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1944cfac8a1120111f63291e9f54b8305d0c69cf
--- /dev/null
+++ b/chronik/native/test/mem_mempool_tests.cpp
@@ -0,0 +1,219 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Tests of the Mempool (mem/mempool.rs has no Rust tests): group indexes,
+// errors and the token hook.
+
+#include <chronik/native/codec/script_compress.h>
+#include <chronik/native/groups/script.h>
+#include <chronik/native/mem/mempool.h>
+
+#include <test/index_test_util.h>
+#include <test/index_value_group.h>
+
+#include <boost/test/unit_test.hpp>
+
+using namespace chronik::native;
+using namespace chronik::native::mem;
+using chronik::native::test::ErrorMsg;
+using chronik::native::test::MakeInputsTx;
+using chronik::native::test::TestDb;
+using chronik::native::test::TxIdNum;
+
+namespace {
+
+std::shared_ptr<const GroupDef> MakeScriptGroup() {
+    return std::make_shared<groups::ScriptGroup>(
+        [](ByteView data, uint8_t out[32]) { test::TestSha256(data, out); });
+}
+
+MempoolTx MakeTx(uint8_t txid_num,
+                 const std::vector<std::pair<uint8_t, uint32_t>> &inputs,
+                 const std::vector<Bytes> &output_scripts,
+                 int64_t time_first_seen = 0,
+                 const Bytes &input_script = {0x51}) {
+    std::vector<std::tuple<uint8_t, uint32_t, int64_t>> input_values;
+    for (const auto &[input_txid_num, out_idx] : inputs) {
+        input_values.emplace_back(input_txid_num, out_idx, 1);
+    }
+    Tx tx = MakeInputsTx(txid_num, input_values,
+                         std::vector<int64_t>(output_scripts.size(), 1));
+    for (size_t i = 0; i < output_scripts.size(); ++i) {
+        tx.outputs[i].script = output_scripts[i];
+    }
+    for (TxInput &input : tx.inputs) {
+        input.coin->output.script = input_script;
+    }
+    return MempoolTx{std::make_shared<const Tx>(std::move(tx)),
+                     time_first_seen};
+}
+
+struct TestAux : GroupAux {
+    std::vector<int64_t> values;
+};
+
+/** Token ID group stand-in: members from TestAux (output values). */
+class AuxValueGroup final : public GroupDef {
+public:
+    std::string_view Name() const override { return "AuxValueGroup"; }
+    void InputMembers(const GroupQuery &, const GroupAux *,
+                      std::vector<MemberItem> &) const override {}
+    void OutputMembers(const GroupQuery &, const GroupAux *aux,
+                       std::vector<MemberItem> &out) const override {
+        const auto *test_aux = dynamic_cast<const TestAux *>(aux);
+        if (!test_aux) {
+            return;
+        }
+        for (size_t idx = 0; idx < test_aux->values.size(); ++idx) {
+            out.push_back(
+                MemberItem{idx, test::SerValue(test_aux->values[idx])});
+        }
+    }
+    Bytes SerMember(ByteView member) const override {
+        return Bytes(member.begin(), member.end());
+    }
+    std::optional<GroupHistoryConf> TxHistoryConf() const override {
+        return GroupHistoryConf{"aux_history", "aux_history_num_txs", 4,
+                                std::nullopt};
+    }
+    std::optional<GroupUtxoConf> UtxoConf() const override {
+        return GroupUtxoConf{"aux_utxo"};
+    }
+    UtxoDataKind UtxoData() const override { return UtxoDataKind::Output; }
+};
+
+struct TestTokenHook final : MempoolTokenHook {
+    AuxValueGroup group;
+    std::vector<std::string> *calls;
+    explicit TestTokenHook(std::vector<std::string> *calls_) : calls(calls_) {}
+
+    const GroupDef &TokenIdGroup() const override { return group; }
+    void Insert(const KvStore &, const MempoolTx &tx,
+                const IsMempoolTxFn &is_mempool_tx) override {
+        calls->push_back("insert " + std::to_string(tx.tx->txid.b[0]) +
+                         (is_mempool_tx(tx.tx->txid) ? " in" : " out"));
+    }
+    std::shared_ptr<const GroupAux> AuxFromMempool(const Tx &tx) override {
+        calls->push_back("aux " + std::to_string(tx.txid.b[0]));
+        auto aux = std::make_shared<TestAux>();
+        aux->values = {tx.txid.b[0]};
+        return aux;
+    }
+    void Remove(const TxId &txid) override {
+        calls->push_back("remove " + std::to_string(txid.b[0]));
+    }
+    std::shared_ptr<const GroupAux>
+    Probe(const KvStore &, const MempoolTx &tx,
+          const IsMempoolTxFn &) const override {
+        calls->push_back("probe " + std::to_string(tx.tx->txid.b[0]));
+        return nullptr;
+    }
+};
+
+} // namespace
+
+BOOST_AUTO_TEST_SUITE(mem_mempool_tests)
+
+BOOST_AUTO_TEST_CASE(test_mempool_insert_remove) {
+    TestDb db("mempool");
+    Mempool mempool(MakeScriptGroup(), false, true);
+    const Bytes p2sh = {0xa9, 0x14};
+    const Bytes opreturn = {0x6a, 0x04, 'A', 'B', 'C', 'D'};
+
+    // LOKAD IDs are parsed from the first output
+    const MempoolTx tx1 = MakeTx(1, {{20, 0}}, {opreturn, p2sh}, 100);
+    const MempoolResult result = mempool.Insert(*db, tx1);
+    BOOST_CHECK(result.mempool_tx.tx == tx1.tx);
+    BOOST_CHECK(!result.token_id_aux);
+    BOOST_CHECK(mempool.GetTx(TxIdNum(1)) != nullptr);
+    BOOST_CHECK(mempool.ScriptHistory().MemberHistory(CompressScript(p2sh)));
+    BOOST_CHECK(mempool.ScriptHistory().MemberHistory(
+        CompressScript(Bytes{0x51})));
+    BOOST_CHECK(mempool.ScriptUtxos().GetUtxos(CompressScript(p2sh)));
+    BOOST_CHECK(mempool.SpentBy().OutputsSpent(TxIdNum(20)));
+    BOOST_CHECK(mempool.LokadIdHistory().MemberHistory(
+        Bytes{'A', 'B', 'C', 'D'}));
+    BOOST_CHECK(!mempool.TokenIdHistory());
+
+    // Child spending the mempool output
+    const MempoolTx tx2 = MakeTx(2, {{1, 1}}, {p2sh}, 200, p2sh);
+    mempool.Insert(*db, tx2);
+    const auto *utxos = mempool.ScriptUtxos().GetUtxos(CompressScript(p2sh));
+    BOOST_REQUIRE(utxos);
+    BOOST_CHECK(*utxos == (std::set<OutPoint>{{TxIdNum(2), 0}}));
+
+    // Duplicate tx: the UTXO index fails first, like Rust
+    BOOST_CHECK(ErrorMsg([&] { mempool.Insert(*db, tx2); }) !=
+                "<no exception>");
+
+    std::string hex1;
+    for (int i = 0; i < 32; ++i) {
+        hex1 += "07";
+    }
+    BOOST_CHECK_EQUAL(ErrorMsg([&] { mempool.Remove(TxIdNum(7)); }),
+                      "No such mempool tx: " + hex1);
+
+    // Remove child, then mine parent
+    mempool.Remove(TxIdNum(2));
+    BOOST_CHECK(*mempool.ScriptUtxos().GetUtxos(CompressScript(p2sh)) ==
+                (std::set<OutPoint>{{TxIdNum(1), 1}}));
+    const std::optional<MempoolTx> mined = mempool.RemoveMined(TxIdNum(1));
+    BOOST_REQUIRE(mined);
+    BOOST_CHECK(mined->tx == tx1.tx);
+    BOOST_CHECK(!mempool.RemoveMined(TxIdNum(1)));
+    BOOST_CHECK(mempool.Txs().empty());
+    BOOST_CHECK(mempool.ScriptHistory().All().empty());
+    BOOST_CHECK(mempool.ScriptUtxos().All().empty());
+    BOOST_CHECK(mempool.SpentBy().All().empty());
+    BOOST_CHECK(mempool.LokadIdHistory().All().empty());
+}
+
+BOOST_AUTO_TEST_CASE(test_mempool_duplicate_tx) {
+    TestDb db("mempool_dup");
+    Mempool mempool(MakeScriptGroup(), false, false);
+    // No inputs, no outputs: only the tx map detects the duplicate
+    const MempoolTx tx = MakeTx(3, {}, {});
+    mempool.Insert(*db, tx);
+    std::string hex;
+    for (int i = 0; i < 32; ++i) {
+        hex += "03";
+    }
+    BOOST_CHECK_EQUAL(ErrorMsg([&] { mempool.Insert(*db, tx); }),
+                      "Tx " + hex + " already exists in mempool");
+    // LOKAD ID index disabled
+    const MempoolTx tx_lokad = MakeTx(4, {}, {{0x6a, 0x04, 'A', 'B', 'C', 'D'}});
+    mempool.Insert(*db, tx_lokad);
+    BOOST_CHECK(mempool.LokadIdHistory().All().empty());
+}
+
+BOOST_AUTO_TEST_CASE(test_mempool_token_hook) {
+    TestDb db("mempool_tokens");
+    std::vector<std::string> calls;
+    BOOST_CHECK_EQUAL(
+        ErrorMsg([] { Mempool(MakeScriptGroup(), true, false); }),
+        "Token index enabled, but no mempool token hook given");
+    Mempool mempool(MakeScriptGroup(), true, false,
+                    std::make_unique<TestTokenHook>(&calls));
+    const MempoolTx tx = MakeTx(5, {}, {{0x51}}, 10);
+    const MempoolResult result = mempool.Insert(*db, tx);
+    BOOST_CHECK(result.token_id_aux != nullptr);
+    BOOST_REQUIRE(mempool.TokenIdHistory());
+    BOOST_CHECK(mempool.TokenIdHistory()->MemberHistory(test::SerValue(5)));
+    BOOST_CHECK(mempool.TokenIdUtxos()->GetUtxos(test::SerValue(5)));
+
+    mempool.ProbeTx(*db, MakeTx(6, {}, {}));
+    mempool.Remove(TxIdNum(5));
+    BOOST_CHECK(mempool.TokenIdHistory()->All().empty());
+    BOOST_CHECK(mempool.TokenIdUtxos()->All().empty());
+
+    mempool.Insert(*db, tx);
+    mempool.RemoveMined(TxIdNum(5));
+    BOOST_CHECK(mempool.TokenIdUtxos()->All().empty());
+    BOOST_CHECK(calls == (std::vector<std::string>{
+                             "insert 5 out", "aux 5", "probe 6", "aux 5",
+                             "remove 5", "insert 5 out", "aux 5", "aux 5",
+                             "remove 5"}));
+}
+
+BOOST_AUTO_TEST_SUITE_END()
diff --git a/chronik/native/test/mem_spent_by_tests.cpp b/chronik/native/test/mem_spent_by_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7421fbef37f052054b084855ed8a303b705eaf38
--- /dev/null
+++ b/chronik/native/test/mem_spent_by_tests.cpp
@@ -0,0 +1,134 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Port of chronik-db mem/spent_by.rs tests.
+
+#include <chronik/native/mem/spent_by.h>
+
+#include <test/index_test_util.h>
+
+#include <boost/test/unit_test.hpp>
+
+using namespace chronik::native;
+using namespace chronik::native::mem;
+using chronik::native::test::ErrorMsg;
+using chronik::native::test::MakeInputsTx;
+using chronik::native::test::TxIdNum;
+
+namespace {
+
+/** Rust make_mempool_tx! (test/utxo.rs) */
+MempoolTx MakeMempoolTx(uint8_t txid_num,
+                        const std::vector<std::pair<uint8_t, uint32_t>> &inputs,
+                        size_t num_outputs) {
+    std::vector<std::tuple<uint8_t, uint32_t, int64_t>> input_values;
+    for (const auto &[input_txid_num, out_idx] : inputs) {
+        input_values.emplace_back(input_txid_num, out_idx, -1);
+    }
+    return MempoolTx{
+        std::make_shared<const Tx>(MakeInputsTx(
+            txid_num, input_values, std::vector<int64_t>(num_outputs, -1))),
+        0};
+}
+
+using SB = std::vector<std::tuple<uint32_t, uint8_t, uint32_t>>;
+
+/** spent_by!(out_idx -> (txid_num, input_idx), ...) */
+MempoolSpentBy::Entries SpentByMap(const SB &entries) {
+    MempoolSpentBy::Entries map;
+    for (const auto &[out_idx, txid_num, input_idx] : entries) {
+        map[out_idx] = SpentBy{TxIdNum(txid_num), input_idx};
+    }
+    return map;
+}
+
+bool OutputsEq(const MempoolSpentBy &mempool, uint8_t txid_num,
+               const SB &entries) {
+    const MempoolSpentBy::Entries *got = mempool.OutputsSpent(TxIdNum(txid_num));
+    return got && *got == SpentByMap(entries);
+}
+
+std::string Hex32(uint8_t num) {
+    static const char *digits = "0123456789abcdef";
+    std::string out;
+    for (int i = 0; i < 32; ++i) {
+        out += digits[num >> 4];
+        out += digits[num & 0xf];
+    }
+    return out;
+}
+
+std::string OutPointDebug(uint8_t txid_num, uint32_t out_idx) {
+    return "OutPoint { txid: TxId(" + Hex32(txid_num) +
+           "), out_idx: " + std::to_string(out_idx) + " }";
+}
+
+std::string SpentByDebug(uint8_t txid_num, uint32_t input_idx) {
+    return "SpentBy { txid: TxId(" + Hex32(txid_num) +
+           "), input_idx: " + std::to_string(input_idx) + " }";
+}
+
+} // namespace
+
+BOOST_AUTO_TEST_SUITE(mem_spent_by_tests)
+
+BOOST_AUTO_TEST_CASE(test_mempool_spent_by) {
+    MempoolSpentBy mempool;
+
+    // Add tx spending txid_num=10, out_idx=4
+    const MempoolTx tx1 = MakeMempoolTx(1, {{10, 4}}, 1);
+    mempool.Insert(tx1);
+    BOOST_CHECK(OutputsEq(mempool, 10, {{4, 1, 0}}));
+
+    // Remove tx -> no entries in MempoolSpentBy anymore
+    mempool.Remove(tx1);
+    BOOST_CHECK(mempool.All().empty());
+
+    // Add tx again
+    mempool.Insert(tx1);
+
+    // Failed insert: Tx conflicts with existing tx
+    const MempoolTx tx_conflict = MakeMempoolTx(2, {{0, 0}, {10, 4}}, 0);
+    BOOST_CHECK_EQUAL(ErrorMsg([&] { mempool.Insert(tx_conflict); }),
+                      "Inconsistent mempool: Duplicate spend by entry for " +
+                          OutPointDebug(10, 4) + ": " + SpentByDebug(1, 0) +
+                          " already exists, but tried to add " +
+                          SpentByDebug(2, 1));
+
+    // Failed remove: Output never spent in mempool
+    const MempoolTx tx_missing = MakeMempoolTx(3, {{10, 3}}, 0);
+    BOOST_CHECK_EQUAL(ErrorMsg([&] { mempool.Remove(tx_missing); }),
+                      "Inconsistent mempool: Missing spend by entry for " +
+                          OutPointDebug(10, 3) + ": Expected " +
+                          SpentByDebug(3, 0) +
+                          " to be present, but none found");
+
+    // Failed remove: Output spent by a different tx
+    const MempoolTx tx_mismatch = MakeMempoolTx(4, {{10, 4}}, 0);
+    BOOST_CHECK_EQUAL(ErrorMsg([&] { mempool.Remove(tx_mismatch); }),
+                      "Inconsistent mempool: Mismatched spent-by entry for " +
+                          OutPointDebug(10, 4) + ": Expected " +
+                          SpentByDebug(4, 0) + " to be present, but got " +
+                          SpentByDebug(1, 0));
+
+    // Add more spends to existing entries; also spend mempool tx
+    const MempoolTx tx2 = MakeMempoolTx(5, {{10, 5}, {10, 3}, {1, 0}}, 0);
+    mempool.Insert(tx2);
+    BOOST_CHECK(OutputsEq(mempool, 10, {{3, 5, 1}, {4, 1, 0}, {5, 5, 0}}));
+    BOOST_CHECK(OutputsEq(mempool, 1, {{0, 5, 2}}));
+
+    // "Mine" first tx
+    mempool.Remove(tx1);
+    BOOST_CHECK(OutputsEq(mempool, 10, {{3, 5, 1}, {5, 5, 0}}));
+    // The now mined tx is still marked as spent in the mempool
+    BOOST_CHECK(OutputsEq(mempool, 1, {{0, 5, 2}}));
+
+    // "Mine" dependent tx, now there no entries marked as spent in the
+    // mempool anymore.
+    mempool.Remove(tx2);
+    BOOST_CHECK(mempool.OutputsSpent(TxIdNum(10)) == nullptr);
+    BOOST_CHECK(mempool.OutputsSpent(TxIdNum(1)) == nullptr);
+}
