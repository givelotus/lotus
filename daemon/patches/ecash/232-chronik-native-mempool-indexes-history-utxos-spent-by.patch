diff --git a/chronik/native/core/mem/group_history.cpp b/chronik/native/core/mem/group_history.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..31611c634ca7b280394ea281b06fcaa03f1cb6bc
--- /dev/null
+++ b/chronik/native/core/mem/group_history.cpp
@@ -0,0 +1,75 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/mem/group_history.h>
+
+#include <chronik/native/index/group_history.h>
+
+namespace chronik::native::mem {
+
+MempoolGroupHistory::MempoolGroupHistory(const GroupDef &group)
+    : m_group(group) {
+    const GroupHistoryConf conf = index::RequireHistoryConf(group);
+    if (conf.cf_member_hash_name) {
+        m_member_hash_index.emplace();
+    }
+}
+
+void MempoolGroupHistory::Insert(const MempoolTx &tx, const GroupAux *aux) {
+    const GroupQuery query{false, tx.tx.get()};
+    for (const Bytes &member : TxMembersForGroup(m_group, query, aux)) {
+        Bytes member_ser = m_group.SerMember(member);
+        auto it = m_history.find(member_ser);
+        if (it == m_history.end()) {
+            if (m_member_hash_index) {
+                const auto member_hash = m_group.SerHashMember(member);
+                (*m_member_hash_index)[Bytes(member_hash.begin(),
+                                             member_hash.end())] = member_ser;
+            }
+            it = m_history.emplace(std::move(member_ser), History{}).first;
+        }
+        it->second.emplace(tx.time_first_seen, tx.tx->txid);
+    }
+}
+
+void MempoolGroupHistory::Remove(const MempoolTx &tx, const GroupAux *aux) {
+    const GroupQuery query{false, tx.tx.get()};
+    for (const Bytes &member : TxMembersForGroup(m_group, query, aux)) {
+        const Bytes member_ser = m_group.SerMember(member);
+        auto it = m_history.find(member_ser);
+        if (it == m_history.end()) {
+            continue;
+        }
+        it->second.erase({tx.time_first_seen, tx.tx->txid});
+        if (it->second.empty()) {
+            m_history.erase(it);
+            if (m_member_hash_index) {
+                const auto member_hash = m_group.SerHashMember(member);
+                m_member_hash_index->erase(
+                    Bytes(member_hash.begin(), member_hash.end()));
+            }
+        }
+    }
+}
+
+const MempoolGroupHistory::History *
+MempoolGroupHistory::MemberHistory(ByteView member_ser) const {
+    const auto it = m_history.find(Bytes(member_ser.begin(), member_ser.end()));
+    return it == m_history.end() ? nullptr : &it->second;
+}
+
+std::optional<ByteView> MempoolGroupHistory::MemberSerByMemberHash(
+    const std::array<uint8_t, 32> &member_hash) const {
+    if (!m_member_hash_index) {
+        return std::nullopt;
+    }
+    const auto it = m_member_hash_index->find(
+        Bytes(member_hash.begin(), member_hash.end()));
+    if (it == m_member_hash_index->end()) {
+        return std::nullopt;
+    }
+    return ByteView(it->second);
+}
+
+} // namespace chronik::native::mem
diff --git a/chronik/native/core/mem/group_utxos.cpp b/chronik/native/core/mem/group_utxos.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b2aead954b56e4eefe011e18c24052a04ade99d7
--- /dev/null
+++ b/chronik/native/core/mem/group_utxos.cpp
@@ -0,0 +1,145 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/mem/group_utxos.h>
+
+#include <chronik/native/codec/bytes.h>
+#include <chronik/native/codec/hex.h>
+#include <chronik/native/index/debug_fmt.h>
+
+namespace chronik::native::mem {
+
+MempoolGroupUtxos::MempoolGroupUtxos(const GroupDef &group)
+    : m_group(group) {}
+
+void MempoolGroupUtxos::Insert(const MempoolTx &tx,
+                               const IsMempoolTxFn &is_mempool_tx,
+                               const GroupAux *aux) {
+    const GroupQuery query{false, tx.tx.get()};
+    std::vector<MemberItem> items;
+    m_group.OutputMembers(query, aux, items);
+    for (const MemberItem &item : items) {
+        Utxos &utxos = EnsureEntry(m_group.SerMember(item.member));
+        const OutPoint outpoint{tx.tx->txid, uint32_t(item.idx)};
+        if (!utxos.insert(outpoint).second) {
+            // UTXO has been added before already -> error
+            throw MempoolGroupUtxosError("Inconsistent mempool: UTXO " +
+                                         index::DebugOutPoint(outpoint) +
+                                         " already exists in mempool");
+        }
+    }
+    items.clear();
+    m_group.InputMembers(query, aux, items);
+    for (const MemberItem &item : items) {
+        const TxInput &input = tx.tx->inputs.at(item.idx);
+        if (!is_mempool_tx(input.prev_out.txid)) {
+            continue;
+        }
+        if (std::optional<std::string> err = RemoveUtxo(
+                m_group.SerMember(item.member), &tx.tx->txid,
+                input.prev_out)) {
+            throw MempoolGroupUtxosError(*err);
+        }
+    }
+}
+
+void MempoolGroupUtxos::Remove(const MempoolTx &tx,
+                               const IsMempoolTxFn &is_mempool_tx,
+                               const GroupAux *aux) {
+    const GroupQuery query{false, tx.tx.get()};
+    std::vector<MemberItem> items;
+    m_group.InputMembers(query, aux, items);
+    for (const MemberItem &item : items) {
+        const TxInput &input = tx.tx->inputs.at(item.idx);
+        if (!is_mempool_tx(input.prev_out.txid)) {
+            // If `tx` previously spent a block tx, don't add the UTXO back
+            continue;
+        }
+        Utxos &utxos = EnsureEntry(m_group.SerMember(item.member));
+        // Add the UTXO back
+        if (!utxos.insert(input.prev_out).second) {
+            // If already there, we undid it twice -> error
+            throw MempoolGroupUtxosError(
+                "Inconsistent mempool: UTXO " +
+                index::DebugOutPoint(input.prev_out) +
+                " already unspent in mempool");
+        }
+    }
+    items.clear();
+    m_group.OutputMembers(query, aux, items);
+    for (const MemberItem &item : items) {
+        const OutPoint outpoint{tx.tx->txid, uint32_t(item.idx)};
+        // Due to our assumption, all outputs of this tx must be unspent,
+        // hence a UTXO entry must exist for the member.
+        if (std::optional<std::string> err = RemoveUtxo(
+                m_group.SerMember(item.member), nullptr, outpoint)) {
+            throw MempoolGroupUtxosError(*err);
+        }
+    }
+}
+
+void MempoolGroupUtxos::RemoveMined(const MempoolTx &tx, const GroupAux *aux) {
+    const GroupQuery query{false, tx.tx.get()};
+    std::vector<MemberItem> items;
+    m_group.OutputMembers(query, aux, items);
+    for (const MemberItem &item : items) {
+        // Discard the error here, which is expected if an output has
+        // previously been spent by another mempool tx.
+        RemoveUtxo(m_group.SerMember(item.member), nullptr,
+                   OutPoint{tx.tx->txid, uint32_t(item.idx)});
+    }
+}
+
+const MempoolGroupUtxos::Utxos *
+MempoolGroupUtxos::GetUtxos(ByteView member_ser) const {
+    const auto it = m_utxos.find(Bytes(member_ser.begin(), member_ser.end()));
+    return it == m_utxos.end() ? nullptr : &it->second;
+}
+
+void MempoolGroupUtxos::VisitPrefix(
+    ByteView member_prefix, ByteView member_start,
+    const std::function<bool(const Bytes &, const Utxos &)> &visit) const {
+    for (auto it =
+             m_utxos.lower_bound(Bytes(member_start.begin(), member_start.end()));
+         it != m_utxos.end(); ++it) {
+        if (!StartsWith(it->first, member_prefix)) {
+            return;
+        }
+        if (!visit(it->first, it->second)) {
+            return;
+        }
+    }
+}
+
+MempoolGroupUtxos::Utxos &MempoolGroupUtxos::EnsureEntry(ByteView member_ser) {
+    return m_utxos[Bytes(member_ser.begin(), member_ser.end())];
+}
+
+std::optional<std::string>
+MempoolGroupUtxos::RemoveUtxo(ByteView member_ser, const TxId *txid,
+                              const OutPoint &outpoint) {
+    auto make_err = [&] {
+        if (txid) {
+            return "Inconsistent mempool: UTXO " +
+                   index::DebugOutPoint(outpoint) + " spent by " +
+                   HashToHex(*txid) + " doesn't exist in mempool";
+        }
+        return "Inconsistent mempool when removing tx: UTXO " +
+               index::DebugOutPoint(outpoint) + " doesn't exist in mempool";
+    };
+    const auto it = m_utxos.find(Bytes(member_ser.begin(), member_ser.end()));
+    if (it == m_utxos.end()) {
+        return make_err();
+    }
+    if (it->second.erase(outpoint) == 0) {
+        return make_err();
+    }
+    if (it->second.empty()) {
+        // Clean up if there's no utxos for this member anymore
+        m_utxos.erase(it);
+    }
+    return std::nullopt;
+}
+
+} // namespace chronik::native::mem
diff --git a/chronik/native/core/mem/mempool.cpp b/chronik/native/core/mem/mempool.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..59ace136976e5d1753625e2b2810890b23a86819
--- /dev/null
+++ b/chronik/native/core/mem/mempool.cpp
@@ -0,0 +1,130 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/mem/mempool.h>
+
+#include <chronik/native/codec/hex.h>
+
+namespace chronik::native::mem {
+
+Mempool::Mempool(std::shared_ptr<const GroupDef> script_group,
+                 bool enable_token_index, bool is_lokad_id_index_enabled,
+                 std::unique_ptr<MempoolTokenHook> token_hook)
+    : m_script_group(std::move(script_group)),
+      m_script_history(*m_script_group), m_script_utxos(*m_script_group),
+      m_token_hook(std::move(token_hook)),
+      m_lokad_id_history(m_lokad_id_group),
+      m_is_token_index_enabled(enable_token_index),
+      m_is_lokad_id_index_enabled(is_lokad_id_index_enabled) {
+    if (m_is_token_index_enabled) {
+        if (!m_token_hook) {
+            throw ChronikError(
+                "Token index enabled, but no mempool token hook given");
+        }
+        m_token_id_history = std::make_unique<MempoolGroupHistory>(
+            m_token_hook->TokenIdGroup());
+        m_token_id_utxos = std::make_unique<MempoolGroupUtxos>(
+            m_token_hook->TokenIdGroup());
+    }
+}
+
+bool Mempool::IsMempoolTx(const TxId &txid) const {
+    return m_txs.count(txid) > 0;
+}
+
+MempoolResult Mempool::Insert(const KvStore &store, MempoolTx mempool_tx) {
+    const TxId txid = mempool_tx.tx->txid;
+    const IsMempoolTxFn is_mempool_tx = [this](const TxId &id) {
+        return IsMempoolTx(id);
+    };
+    m_script_history.Insert(mempool_tx, nullptr);
+    m_script_utxos.Insert(mempool_tx, is_mempool_tx, nullptr);
+    m_spent_by.Insert(mempool_tx);
+    std::shared_ptr<const GroupAux> token_id_aux;
+    if (m_is_token_index_enabled) {
+        m_token_hook->Insert(store, mempool_tx, is_mempool_tx);
+        token_id_aux = m_token_hook->AuxFromMempool(*mempool_tx.tx);
+        m_token_id_history->Insert(mempool_tx, token_id_aux.get());
+        m_token_id_utxos->Insert(mempool_tx, is_mempool_tx,
+                                 token_id_aux.get());
+    }
+    if (m_is_lokad_id_index_enabled) {
+        m_lokad_id_history.Insert(mempool_tx, nullptr);
+    }
+    // Like Rust's HashMap::insert, a duplicate replaces the entry, then fails
+    const auto [it, inserted] = m_txs.insert_or_assign(txid, mempool_tx);
+    if (!inserted) {
+        throw MempoolError("Tx " + HashToHex(txid) +
+                           " already exists in mempool");
+    }
+    return MempoolResult{it->second, std::move(token_id_aux)};
+}
+
+MempoolResult Mempool::Remove(const TxId &txid) {
+    const auto it = m_txs.find(txid);
+    if (it == m_txs.end()) {
+        throw MempoolError("No such mempool tx: " + HashToHex(txid));
+    }
+    MempoolTx mempool_tx = std::move(it->second);
+    m_txs.erase(it);
+    const IsMempoolTxFn is_mempool_tx = [this](const TxId &id) {
+        return IsMempoolTx(id);
+    };
+    m_script_history.Remove(mempool_tx, nullptr);
+    m_script_utxos.Remove(mempool_tx, is_mempool_tx, nullptr);
+    m_spent_by.Remove(mempool_tx);
+    std::shared_ptr<const GroupAux> token_id_aux;
+    if (m_is_token_index_enabled) {
+        token_id_aux = m_token_hook->AuxFromMempool(*mempool_tx.tx);
+        m_token_id_history->Remove(mempool_tx, token_id_aux.get());
+        m_token_id_utxos->Remove(mempool_tx, is_mempool_tx,
+                                 token_id_aux.get());
+        m_token_hook->Remove(txid);
+    }
+    if (m_is_lokad_id_index_enabled) {
+        m_lokad_id_history.Remove(mempool_tx, nullptr);
+    }
+    return MempoolResult{std::move(mempool_tx), std::move(token_id_aux)};
+}
+
+std::optional<MempoolTx> Mempool::RemoveMined(const TxId &txid) {
+    const auto it = m_txs.find(txid);
+    if (it == m_txs.end()) {
+        return std::nullopt;
+    }
+    MempoolTx mempool_tx = std::move(it->second);
+    m_txs.erase(it);
+    m_script_history.Remove(mempool_tx, nullptr);
+    m_script_utxos.RemoveMined(mempool_tx, nullptr);
+    m_spent_by.Remove(mempool_tx);
+    if (m_is_token_index_enabled) {
+        const std::shared_ptr<const GroupAux> token_id_aux =
+            m_token_hook->AuxFromMempool(*mempool_tx.tx);
+        m_token_id_history->Remove(mempool_tx, token_id_aux.get());
+        m_token_id_utxos->RemoveMined(mempool_tx, token_id_aux.get());
+        m_token_hook->Remove(txid);
+    }
+    if (m_is_lokad_id_index_enabled) {
+        m_lokad_id_history.Remove(mempool_tx, nullptr);
+    }
+    return mempool_tx;
+}
+
+MempoolResult Mempool::ProbeTx(const KvStore &store,
+                               MempoolTx mempool_tx) const {
+    std::shared_ptr<const GroupAux> token_id_aux;
+    if (m_is_token_index_enabled) {
+        token_id_aux = m_token_hook->Probe(
+            store, mempool_tx,
+            [this](const TxId &id) { return IsMempoolTx(id); });
+    }
+    return MempoolResult{std::move(mempool_tx), std::move(token_id_aux)};
+}
+
+const MempoolTx *Mempool::GetTx(const TxId &txid) const {
+    const auto it = m_txs.find(txid);
+    return it == m_txs.end() ? nullptr : &it->second;
+}
+
+} // namespace chronik::native::mem
