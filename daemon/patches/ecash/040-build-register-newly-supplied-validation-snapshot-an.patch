From 753e2fb580939df806d14345e244b55310bdf620 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] build: register newly supplied validation, snapshot and
 peer-handler sources

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Fast-path single-input CheckRegularTransaction duplicate-input checks,
coalesce BlockUndo disk writes, and optimize bulk mempool clear.

Original-Commit: a4ea86865414bbf4f98512bbd4460e2a42897acc
Original-Patch: ecash/020
Split-Concern: build

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Application-Repair: Keep the unique optional bitcoinkernel snapshot source/link adapter. Remove duplicate server/common registrations and duplicate lotus_v2_header target already compiled at their first owners; retain all implementations and original target sources.

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 7df5fe61d7d530382a03dde0ecaa3da9fe7ff48a..49c99efc3799dc96c96b2f25f531dee044df3f9c 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -872,6 +872,7 @@ if(BUILD_CHAINSTATE)
 		node/blockfitter.cpp
 		node/blockstorage.cpp
 		node/chainstate.cpp
+		node/snapshot.cpp
 		node/utxo_snapshot.cpp
 		policy/fees.cpp
 		policy/packages.cpp
@@ -975,7 +976,7 @@ if(BUILD_CHAINSTATE)
 			# To access the config/ and obj/ directories
 			${CMAKE_CURRENT_BINARY_DIR}
 	)
-	target_link_libraries(bitcoinkernel crypto univalue secp256k1 lotus_v2_mdbx leveldb)
+	target_link_libraries(bitcoinkernel crypto univalue secp256k1 lotus_v2_header lotus_v2_mdbx leveldb)
 	link_boost_headers_only(bitcoinkernel headers)
 
 	if(${CMAKE_SYSTEM_NAME} MATCHES "Windows")
