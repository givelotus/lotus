diff --git a/chronik/native/include/chronik/native/token/parse.h b/chronik/native/include/chronik/native/token/parse.h
new file mode 100644
index 0000000000000000000000000000000000000000..1123750c6f69f9af20a4c27b4fc75cc2cb2c1cee
--- /dev/null
+++ b/chronik/native/include/chronik/native/token/parse.h
@@ -0,0 +1,215 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_TOKEN_PARSE_H
+#define CHRONIK_NATIVE_TOKEN_PARSE_H
+
+#include <chronik/native/script/result.h>
+#include <chronik/native/script/script.h>
+#include <chronik/native/token/structs.h>
+#include <chronik/native/types.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+/** Ports of bitcoinsuite-slp's empp, slp and alp parsers. */
+namespace chronik::native::token {
+
+namespace empp {
+
+using EmppData = std::vector<Bytes>;
+
+struct ParseError {
+    enum class Kind {
+        DataError,
+        EmptyScript,
+        MissingOpReturn,
+        EmptyOpReturn,
+        MissingOpReserved,
+        InvalidPushOpcode,
+        InvalidNonPushOpcode,
+        EmptyPushdata,
+    };
+    Kind kind = Kind::EmptyScript;
+    script::DataError data_error;
+    script::Opcode opcode;
+
+    static ParseError Make(Kind kind, script::Opcode opcode = {}) {
+        return {kind, {}, opcode};
+    }
+    static ParseError FromDataError(script::DataError err) {
+        return {Kind::DataError, std::move(err), {}};
+    }
+    bool operator==(const ParseError &) const = default;
+    std::string ToString() const;
+};
+
+/** Ok(nullopt) if the script is not eMPP at all. */
+Result<std::optional<EmppData>, ParseError> Parse(ByteView script);
+/** Like Parse, but returns the errors Parse ignores. */
+Result<EmppData, ParseError> ParseWithIgnoredErr(ByteView script);
+
+} // namespace empp
+
+namespace slp {
+
+struct ParseError {
+    enum class Kind {
+        DataError,
+        EmptyScript,
+        MissingOpReturn,
+        MissingLokadId,
+        WrongLokadId,
+        InvalidLokadIdOpcode,
+        InvalidAlpLokadId,
+        NonPushOp,
+        DisallowedPush,
+        InvalidFieldSize,
+        InvalidDecimals,
+        InvalidMintBatonIdx,
+        Nft1ChildCannotHaveMintBaton,
+        Nft1ChildInvalidInitialQuantity,
+        Nft1ChildInvalidDecimals,
+        TooFewPushes,
+        UnexpectedNumPushes,
+        SuperfluousPushes,
+        InvalidTokenType,
+        InvalidTxType,
+    };
+    Kind kind = Kind::EmptyScript;
+    script::DataError data_error;
+    script::Opcode opcode;
+    /** WrongLokadId, InvalidTokenType, InvalidTxType */
+    Bytes bytes;
+    size_t op_idx{};
+    std::string field_name;
+    /** InvalidFieldSize */
+    std::vector<size_t> expected_sizes;
+    /** TooFewPushes, UnexpectedNumPushes, SuperfluousPushes */
+    size_t expected{};
+    /** actual sizes/counts, InvalidDecimals */
+    size_t actual{};
+    /** InvalidMintBatonIdx, Nft1ChildInvalidDecimals */
+    uint8_t byte{};
+    /** Nft1ChildInvalidInitialQuantity */
+    Atoms atoms{};
+
+    static ParseError Make(Kind kind) {
+        ParseError err;
+        err.kind = kind;
+        return err;
+    }
+    static ParseError FromDataError(script::DataError err);
+    static ParseError MissingOpReturn(script::Opcode opcode);
+    static ParseError WrongLokadId(Bytes bytes);
+    static ParseError InvalidLokadIdOpcode(script::Opcode opcode);
+    static ParseError NonPushOp(script::Opcode opcode, size_t op_idx);
+    static ParseError DisallowedPush(script::Opcode opcode, size_t op_idx);
+    static ParseError InvalidFieldSize(std::string field_name,
+                                       std::vector<size_t> expected,
+                                       size_t actual);
+    static ParseError InvalidDecimals(size_t actual);
+    static ParseError InvalidMintBatonIdx(uint8_t idx);
+    static ParseError Nft1ChildInvalidInitialQuantity(Atoms atoms);
+    static ParseError Nft1ChildInvalidDecimals(uint8_t decimals);
+    static ParseError TooFewPushes(size_t expected, size_t actual);
+    static ParseError UnexpectedNumPushes(size_t expected, size_t actual);
+    static ParseError SuperfluousPushes(size_t expected, size_t actual);
+    static ParseError InvalidTokenType(Bytes bytes);
+    static ParseError InvalidTxType(Bytes bytes);
+
+    bool operator==(const ParseError &) const = default;
+    std::string ToString() const;
+};
+
+/** Parse the first output of a tx; Ok(nullopt) if not SLP. */
+Result<std::optional<ParsedData>, ParseError> ParseTx(const Tx &tx);
+Result<std::optional<ParsedData>, ParseError> Parse(const TxId &txid,
+                                                    ByteView script);
+Result<ParsedData, ParseError> ParseWithIgnoredErr(const TxId &txid,
+                                                   ByteView script);
+
+// Builders (slp/build.rs)
+script::Script GenesisOpreturn(const GenesisInfo &genesis_info,
+                               SlpTokenType token_type,
+                               std::optional<uint8_t> mint_baton_out_idx,
+                               Atoms initial_quantity);
+script::Script MintOpreturn(const TokenId &token_id, SlpTokenType token_type,
+                            std::optional<uint8_t> mint_baton_out_idx,
+                            Atoms additional_quantity);
+script::Script MintVaultOpreturn(const TokenId &token_id,
+                                 const std::vector<Atoms> &quantities);
+script::Script SendOpreturn(const TokenId &token_id, SlpTokenType token_type,
+                            const std::vector<Atoms> &send_atoms);
+script::Script BurnOpreturn(const TokenId &token_id, SlpTokenType token_type,
+                            Atoms burn_atoms);
+
+extern const char *const ADDITIONAL_QUANTITY_FIELD_NAMES[19];
+extern const char *const TOKEN_OUTPUT_QUANTITY_FIELD_NAMES[19];
+
+} // namespace slp
+
+namespace alp {
+
+struct ParseError {
+    enum class Kind {
+        DataError,
+        NotEnoughBytes,
+        SizeOutOfRange,
+        MissingLokadId,
+        InvalidLokadId,
+        InvalidSlpLokadId,
+        UnknownTxType,
+        DecimalsOutOfRange,
+        LeftoverBytes,
+    };
+    Kind kind = Kind::DataError;
+    script::DataError data_error;
+    std::string field_name;
+    size_t expected{};
+    size_t actual{};
+    /** SizeOutOfRange size, DecimalsOutOfRange */
+    uint8_t byte{};
+    /** MissingLokadId, UnknownTxType, LeftoverBytes */
+    Bytes bytes;
+    LokadId lokad_id{};
+
+    static ParseError FromDataError(script::DataError err);
+    static ParseError NotEnoughBytes(std::string field_name, size_t expected,
+                                     size_t actual);
+    static ParseError SizeOutOfRange(std::string field_name, uint8_t size);
+    static ParseError MissingLokadId(Bytes bytes);
+    static ParseError InvalidLokadId(LokadId lokad_id);
+    static ParseError InvalidSlpLokadId();
+    static ParseError UnknownTxType(Bytes bytes);
+    static ParseError DecimalsOutOfRange(uint8_t decimals);
+    static ParseError LeftoverBytes(Bytes bytes);
+
+    bool operator==(const ParseError &) const = default;
+    std::string ToString() const;
+};
+
+/** Ok(nullopt) for sections of other protocols (missing/other LOKAD ID). */
+Result<std::optional<ParsedData>, ParseError> ParseSection(const TxId &txid,
+                                                           Bytes pushdata);
+Result<ParsedData, ParseError> ParseSectionWithIgnoredErr(const TxId &txid,
+                                                          Bytes pushdata);
+
+// Builders (alp/build.rs)
+script::Script SectionsOpreturn(const std::vector<Bytes> &sections);
+Bytes GenesisSection(AlpTokenType token_type, const GenesisInfo &genesis_info,
+                     const ParsedMintData &mint_data);
+Bytes MintSection(const TokenId &token_id, AlpTokenType token_type,
+                  const ParsedMintData &mint_data);
+Bytes BurnSection(const TokenId &token_id, AlpTokenType token_type,
+                  Atoms atoms);
+Bytes SendSection(const TokenId &token_id, AlpTokenType token_type,
+                  const std::vector<Atoms> &send_amounts);
+
+} // namespace alp
+
+} // namespace chronik::native::token
+
+#endif // CHRONIK_NATIVE_TOKEN_PARSE_H
diff --git a/chronik/native/include/chronik/native/token/structs.h b/chronik/native/include/chronik/native/token/structs.h
new file mode 100644
index 0000000000000000000000000000000000000000..b89220b3093452f3924602c7fa3c5f03a1cbeddd
--- /dev/null
+++ b/chronik/native/include/chronik/native/token/structs.h
@@ -0,0 +1,239 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_TOKEN_STRUCTS_H
+#define CHRONIK_NATIVE_TOKEN_STRUCTS_H
+
+#include <chronik/native/script/script.h>
+#include <chronik/native/types.h>
+
+#include <array>
+#include <compare>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <variant>
+#include <vector>
+
+/**
+ * Port of bitcoinsuite-slp: token ids/types, structs and parsed data
+ * (token_id.rs, token_type.rs, structs.rs, parsed.rs, consts.rs).
+ */
+namespace chronik::native::token {
+
+using Atoms = uint64_t;
+using uint128 = unsigned __int128;
+using LokadId = std::array<uint8_t, 4>;
+
+/** Decimal representation of a u128 */
+std::string U128ToString(uint128 v);
+
+inline const Bytes GENESIS{'G', 'E', 'N', 'E', 'S', 'I', 'S'};
+inline const Bytes MINT{'M', 'I', 'N', 'T'};
+inline const Bytes SEND{'S', 'E', 'N', 'D'};
+inline const Bytes BURN{'B', 'U', 'R', 'N'};
+
+namespace slp_consts {
+inline constexpr LokadId SLP_LOKAD_ID{'S', 'L', 'P', 0};
+inline constexpr uint8_t TOKEN_TYPE_V1 = 1;
+inline constexpr uint8_t TOKEN_TYPE_V2 = 2;
+inline constexpr uint8_t TOKEN_TYPE_V1_NFT1_GROUP = 0x81;
+inline constexpr uint8_t TOKEN_TYPE_V1_NFT1_CHILD = 0x41;
+inline constexpr std::array<uint8_t, 4> ALL_TOKEN_TYPES{
+    TOKEN_TYPE_V1, TOKEN_TYPE_V2, TOKEN_TYPE_V1_NFT1_GROUP,
+    TOKEN_TYPE_V1_NFT1_CHILD};
+} // namespace slp_consts
+
+namespace alp_consts {
+inline constexpr LokadId ALP_LOKAD_ID{'S', 'L', 'P', '2'};
+inline constexpr uint8_t STANDARD_TOKEN_TYPE = 0;
+inline constexpr size_t MAX_TX_INPUTS = 32767;
+} // namespace alp_consts
+
+/** Token ID: the txid of the GENESIS tx (internal byte order). */
+struct TokenId {
+    TxId txid;
+
+    static TokenId FromBeBytes(const std::array<uint8_t, 32> &be) {
+        return TokenId{Hash32::FromReversed(be)};
+    }
+    std::array<uint8_t, 32> ToBeBytes() const { return txid.Reversed(); }
+    /** Hex in big-endian (display) order, like Rust's Display. */
+    std::string ToString() const;
+    auto operator<=>(const TokenId &) const = default;
+    bool operator==(const TokenId &) const = default;
+};
+
+/** SLP token types; ordering follows the Rust enum (derive Ord). */
+struct SlpTokenType {
+    enum class Kind : uint8_t { Fungible, MintVault, Nft1Group, Nft1Child, Unknown };
+    Kind kind = Kind::Fungible;
+    uint8_t unknown{};
+
+    static constexpr SlpTokenType Fungible() { return {Kind::Fungible, 0}; }
+    static constexpr SlpTokenType MintVault() { return {Kind::MintVault, 0}; }
+    static constexpr SlpTokenType Nft1Group() { return {Kind::Nft1Group, 0}; }
+    static constexpr SlpTokenType Nft1Child() { return {Kind::Nft1Child, 0}; }
+    static constexpr SlpTokenType Unknown(uint8_t t) {
+        return {Kind::Unknown, t};
+    }
+    uint8_t ToU8() const;
+    /** e.g. "FUNGIBLE (V1)" */
+    std::string ToString() const;
+    auto operator<=>(const SlpTokenType &) const = default;
+    bool operator==(const SlpTokenType &) const = default;
+};
+
+struct AlpTokenType {
+    enum class Kind : uint8_t { Standard, Unknown };
+    Kind kind = Kind::Standard;
+    uint8_t unknown{};
+
+    static constexpr AlpTokenType Standard() { return {Kind::Standard, 0}; }
+    static constexpr AlpTokenType Unknown(uint8_t t) {
+        return {Kind::Unknown, t};
+    }
+    uint8_t ToU8() const;
+    std::string ToString() const;
+    auto operator<=>(const AlpTokenType &) const = default;
+    bool operator==(const AlpTokenType &) const = default;
+};
+
+/** TokenType::Slp(..) or TokenType::Alp(..); Slp < Alp as in Rust. */
+struct TokenType {
+    enum class Protocol : uint8_t { Slp, Alp };
+    Protocol protocol = Protocol::Slp;
+    SlpTokenType slp;
+    AlpTokenType alp;
+
+    static TokenType Slp(SlpTokenType t) {
+        return {Protocol::Slp, t, AlpTokenType{}};
+    }
+    static TokenType Alp(AlpTokenType t) {
+        return {Protocol::Alp, SlpTokenType{}, t};
+    }
+    bool IsSlp() const { return protocol == Protocol::Slp; }
+    bool IsAlp() const { return protocol == Protocol::Alp; }
+    uint8_t ToU8() const { return IsSlp() ? slp.ToU8() : alp.ToU8(); }
+    /** e.g. "SLP FUNGIBLE (V1)" */
+    std::string ToString() const;
+    auto operator<=>(const TokenType &) const = default;
+    bool operator==(const TokenType &) const = default;
+};
+
+struct TokenMeta {
+    TokenId token_id;
+    TokenType token_type;
+    auto operator<=>(const TokenMeta &) const = default;
+    bool operator==(const TokenMeta &) const = default;
+};
+
+enum class TxType : uint8_t { GENESIS, MINT, SEND, BURN, UNKNOWN };
+
+struct TokenVariant {
+    enum class Kind : uint8_t { Atoms, MintBaton, Unknown };
+    Kind kind = Kind::Atoms;
+    Atoms atoms_value{};
+    uint8_t unknown{};
+
+    static TokenVariant MakeAtoms(Atoms a) { return {Kind::Atoms, a, 0}; }
+    static TokenVariant MintBaton() { return {Kind::MintBaton, 0, 0}; }
+    static TokenVariant Unknown(uint8_t t) { return {Kind::Unknown, 0, t}; }
+
+    Atoms atoms() const { return kind == Kind::Atoms ? atoms_value : 0; }
+    bool IsMintBaton() const { return kind == Kind::MintBaton; }
+    bool operator==(const TokenVariant &) const = default;
+};
+
+struct TokenOutput {
+    size_t token_idx{};
+    TokenVariant variant;
+    bool operator==(const TokenOutput &) const = default;
+};
+
+struct Token {
+    TokenMeta meta;
+    TokenVariant variant;
+    bool operator==(const Token &) const = default;
+    /** Display, e.g. "1234 of <token_id> (SLP FUNGIBLE (V1))" */
+    std::string ToString() const;
+};
+
+struct GenesisInfo {
+    Bytes token_ticker;
+    Bytes token_name;
+    std::optional<script::ShaRmd160> mint_vault_scripthash;
+    Bytes url;
+    std::optional<std::array<uint8_t, 32>> hash;
+    std::optional<Bytes> data;
+    std::optional<Bytes> auth_pubkey;
+    uint8_t decimals{};
+
+    static GenesisInfo EmptySlp() { return GenesisInfo{}; }
+    static GenesisInfo EmptyAlp() {
+        GenesisInfo info;
+        info.data = Bytes{};
+        info.auth_pubkey = Bytes{};
+        return info;
+    }
+    bool operator==(const GenesisInfo &) const = default;
+};
+
+struct ParsedMintData {
+    std::vector<Atoms> atoms_vec;
+    size_t num_batons{};
+
+    /** Output range [first, last) of the atoms */
+    size_t AtomsBegin() const { return 1; }
+    size_t AtomsEnd() const { return 1 + atoms_vec.size(); }
+    size_t BatonsBegin() const { return 1 + atoms_vec.size(); }
+    size_t BatonsEnd() const { return 1 + atoms_vec.size() + num_batons; }
+    bool operator==(const ParsedMintData &) const = default;
+};
+
+struct ParsedGenesis {
+    GenesisInfo info;
+    ParsedMintData mint_data;
+    bool operator==(const ParsedGenesis &) const = default;
+};
+
+/** ParsedTxType: Genesis / Mint / Send / Burn / Unknown */
+struct ParsedTxType {
+    struct Unknown {
+        bool operator==(const Unknown &) const = default;
+    };
+    struct Send {
+        std::vector<Atoms> atoms;
+        bool operator==(const Send &) const = default;
+    };
+    struct Burn {
+        Atoms atoms{};
+        bool operator==(const Burn &) const = default;
+    };
+    std::variant<ParsedGenesis, ParsedMintData, Send, Burn, Unknown> v;
+
+    static ParsedTxType MakeGenesis(ParsedGenesis g) { return {std::move(g)}; }
+    static ParsedTxType MakeMint(ParsedMintData m) { return {std::move(m)}; }
+    static ParsedTxType MakeSend(std::vector<Atoms> a) {
+        return {Send{std::move(a)}};
+    }
+    static ParsedTxType MakeBurn(Atoms a) { return {Burn{a}}; }
+    static ParsedTxType MakeUnknown() { return {Unknown{}}; }
+
+    TxType tx_type() const;
+    const ParsedGenesis *genesis() const {
+        return std::get_if<ParsedGenesis>(&v);
+    }
+    bool operator==(const ParsedTxType &) const = default;
+};
+
+struct ParsedData {
+    TokenMeta meta;
+    ParsedTxType tx_type;
+    bool operator==(const ParsedData &) const = default;
+};
+
+} // namespace chronik::native::token
+
+#endif // CHRONIK_NATIVE_TOKEN_STRUCTS_H
diff --git a/chronik/native/include/chronik/native/token/verify.h b/chronik/native/include/chronik/native/token/verify.h
