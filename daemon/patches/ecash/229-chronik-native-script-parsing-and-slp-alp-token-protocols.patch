+BOOST_AUTO_TEST_CASE(test_parse_alp_mint_valid_amounts) {
+    for (size_t size = 0; size <= 127; ++size) {
+        Bytes pushdata = Cat({MINT_PREFIX, Rep(0x76, 32)});
+        pushdata.push_back(uint8_t(size));
