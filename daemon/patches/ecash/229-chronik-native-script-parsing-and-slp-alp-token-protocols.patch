+}
+ParseError ParseError::SizeOutOfRange(std::string field_name, uint8_t size) {
+    ParseError e;
+    e.kind = K::SizeOutOfRange;
+    e.field_name = std::move(field_name);
+    e.byte = size;
+    return e;
+}
