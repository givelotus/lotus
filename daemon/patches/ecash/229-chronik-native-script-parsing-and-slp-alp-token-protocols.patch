+BOOST_AUTO_TEST_CASE(test_parse_mint_additional_quantity_size) {
+    for (uint8_t token_type : {1, 0x41, 0x81}) {
+        for (int size = 0; size <= 0xff; ++size) {
+            if (size == 8) {
