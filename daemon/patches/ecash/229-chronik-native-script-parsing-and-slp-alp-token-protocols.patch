+static void VerifySer(const Script &a, const Bytes &b) {
+    BOOST_CHECK(a.Ser() == b);
+    BOOST_CHECK_EQUAL(a.SerLen(), b.size());
+    ByteView view = b;
+    auto deser = Script::Deser(view);
+    BOOST_REQUIRE(deser.ok());
+    BOOST_CHECK(deser.value() == a);
+    BOOST_CHECK(view.empty());
+}
