+BOOST_AUTO_TEST_CASE(test_verify_send_wrong_token_id) {
+    for (SlpTokenType token_type : ALL_SLP_TYPES) {
+        check_token_tx(
+            verify<1>(slp::SendOpreturn(TOKEN_ID2, token_type, {7}),
+                      {spent_atoms(meta(TOKEN_ID3, token_type), 7)}),
+            TokenTx{
+                .entries =
+                    {
