+                    .entries =
+                        {
+                            TokenTxEntry{
+                                .meta = meta(TOKEN_ID2, wrong_token_type),
+                                .tx_type = TxType::SEND,
+                                .is_invalid = true,
+                                .burn_error =
+                                    BurnError::InsufficientInputSum(7, 0),
+                            },
+                            TokenTxEntry{
+                                .meta = meta(TOKEN_ID2, token_type),
