+    ParseError e;
+    e.kind = K::InvalidSlpLokadId;
+    return e;
+}
+ParseError ParseError::UnknownTxType(Bytes bytes) {
+    ParseError e;
+    e.kind = K::UnknownTxType;
+    e.bytes = std::move(bytes);
