+Bytes Hex(std::string_view hex) {
+    std::string clean;
+    for (char c : hex) {
+        if (c != ' ' && c != '\n') {
+            clean += c;
+        }
+    }
+    return HexDecode(clean).value();
+}
+
+Bytes Repeat(uint8_t b, size_t n) {
+    return Bytes(n, b);
+}
