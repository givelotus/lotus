+void PrecomputeSingleTxData(const CTransaction &tx,
+                            PrecomputedBatchTxData &out) {
+    (void)tx.GetId();
+    (void)tx.GetHash();
+    out.regular_tx_checked = true;
+    out.regular_tx_valid = CheckRegularTransaction(tx, out.regular_tx_state);
+    if (out.regular_tx_valid) {
+        out.txdata = PrecomputedTransactionData{tx};
+        out.precomputed_txdata_ready = true;
+    } else {
+        out.precomputed_txdata_ready = false;
+    }
+}
+
+void PrecomputeRawTxBatchParallel(
+    const Package &txns,
+    std::vector<PrecomputedBatchTxData> &out_precomputed) {
+    const size_t n = txns.size();
+    out_precomputed.resize(n);
+    if (n == 0) {
+        return;
+    }
+    if (n < 8) {
+        for (size_t i = 0; i < n; ++i) {
+            if (txns[i]) {
+                PrecomputeSingleTxData(*txns[i], out_precomputed[i]);
+            }
+        }
+        return;
+    }
+    const unsigned int hw_threads =
+        std::max(1u, std::thread::hardware_concurrency());
+    const size_t num_workers =
+        std::min<size_t>((n + 3) / 4, static_cast<size_t>(hw_threads));
+    std::atomic<size_t> next_idx{0};
+    ParallelScriptWorkerPool::Instance().Run(num_workers, [&](size_t) {
+        while (true) {
+            const size_t base =
+                next_idx.fetch_add(4, std::memory_order_relaxed);
+            if (base >= n) {
+                break;
+            }
+            const size_t end = std::min(n, base + 4);
+            for (size_t i = base; i < end; ++i) {
+                if (txns[i]) {
+                    PrecomputeSingleTxData(*txns[i], out_precomputed[i]);
+                }
+            }
+        }
+    });
+}
