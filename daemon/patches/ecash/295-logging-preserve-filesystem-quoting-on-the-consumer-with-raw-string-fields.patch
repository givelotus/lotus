+Copied and static STRING fields accept `{path:fsq}` to preserve existing
+`fs::quoted` diagnostics. This surrounds the human value with double quotes
+and escapes embedded quotes and ampersands with `&`; backslashes are unchanged.
+The structured field remains the original unquoted string. This format does
+not apply to numbers, hashes or custom adapters, and does not infer quoting
+from a `Path` key. Conversion rules require an exact old `fs::quoted(...)` AST
+argument. `fs::PathToString` may still run where it did before; only quotation
+and escaping move to the consumer. The existing fixed-record snapshot and
+omission/`fields_truncated` rules remain unchanged.
+
 Scope conventions are enforced by `check-log-events`: `peer_*` carries PeerId,
 `rpc_call_*` carries Method, `mempool_tx_*` carries TxId, and `block_connect_*`
 carries BlockHash. Global listener/server events use names that do not imply
diff --git a/src/logging/event.cpp b/src/logging/event.cpp
index 8d8cd8a8b9b8a7c7d117200d1169e4f1a4832dc2..a8818c857ccf19fd11204e5609defeb221ab1939 100644
--- a/src/logging/event.cpp
+++ b/src/logging/event.cpp
@@ -198,6 +198,28 @@ namespace {
             field.AppendText(out);
             return true;
         }
+        // Match fs::quoted(string): double quotes with '&' escaping quotes
+        // and ampersands. Only the human message is quoted; the copied string
+        // remains raw for structured encoders. Never guess this from a path.
+        if (format == "fsq") {
+            std::string_view value;
+            if (field.kind == FieldKind::STR) {
+                value = {reinterpret_cast<const char *>(field.data.data()),
+                         field.data.size()};
+            } else if (field.kind == FieldKind::STATIC_STR) {
+                const auto str{Load<StaticStr>(field.data)};
+                value = {str.str, str.len};
+            } else {
+                return false;
+            }
+            out += '"';
+            for (const char character : value) {
+                if (character == '"' || character == '&') out += '&';
+                out += character;
+            }
+            out += '"';
+            return true;
+        }
         // Bounded zero-padded hexadecimal preserves diagnostic bit patterns
         // without turning the structured integer into a string. Signed values
         // must be nonnegative; callers cast a signed bitfield to its wire type.
