     def test_comments_and_strings(self):
         source = '// LogEvent(NET, "peer_bad");\nconst char *x = R"q(LogEvent(NET, "peer_bad"))q";\n/* LogEvent(NET,"bad"); */'
         self.assertEqual(check(source, self.names), (0, []))
