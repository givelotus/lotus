From c981607b842f400c5ffff9707b9c11d27777289e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:34:29 -0700
Subject: [PATCH] logging: identify PWA browser launch events without exposing
 login URLs

Convert all4 PWA launcher LogPrintf consumers to stable Info events. Name is the
existing launcher command (open or xdg-open), not a URL, user or wallet. Keep
Windows/POSIX/no-desktop behavior, exact messages, Info severity and ALL category.
Token-bearing login URLs remain terminal-only and unchanged; no browser spawned
for this conversion.

Scripted diff (ast-grep-py0.51.0; reviewed catalog committed here):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/pwa-browser-launch.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/pwa-launch-applied.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/walletpwa/launch.cpp

Validation:15 converter fixtures including all4 AST mappings/exact messages and
severity, idempotence after formatting, event lint4 and diff check PASS. Native
compile/runtime remain pending; no Linux/Windows native checks claimed. Uses
only existing Name/event API. Tier:shared eCash, V2 inherits.
---
 .../conversion/rules/pwa-browser-launch.json  | 68 +++++++++++++++++++
 src/walletpwa/launch.cpp                      | 20 +++---
 2 files changed, 80 insertions(+), 8 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/pwa-browser-launch.json

diff --git a/contrib/logging/conversion/rules/pwa-browser-launch.json b/contrib/logging/conversion/rules/pwa-browser-launch.json
new file mode 100644
index 0000000000000000000000000000000000000000..182a1c8e10ff7bd51c2eedad2bb02b22809b57c8
--- /dev/null
+++ b/contrib/logging/conversion/rules/pwa-browser-launch.json
@@ -0,0 +1,68 @@
+{
+  "schema": 1,
+  "batch": "pwa-browser-launch",
+  "review_note": "Reviewed:all4 PWA launch LogPrintf consumers, existing Name key only; token-bearing URL output remains terminal-only and untouched. Native validation remains a separate pending gate.",
+  "files": [
+    {
+      "path": "src/walletpwa/launch.cpp",
+      "rules": [
+        {
+          "id": "wallet_ui_browser_open_failed",
+          "old": "LogPrintf(\"Could not open a browser for the wallet UI; open the URL \"\n                  \"above or run `getwalletpwaurl`\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_ui_browser_open_failed\", \"Could not open a browser for the wallet UI; open the URL above or run `getwalletpwaurl`\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Could not open a browser for the wallet UI; open the URL above or run `getwalletpwaurl`\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve current Info severity, ALL category, exact readable text, Windows/POSIX/no-desktop branches and browser process behavior. Name is the existing launcher program (open or xdg-open), not a URL/user/wallet. Never add the login URL or token to the logger; terminal-only token-bearing stdout remains untouched and outside this conversion. No GUI launch performed during preparation."
+        },
+        {
+          "id": "wallet_ui_desktop_session_unavailable",
+          "old": "LogPrintf(\"No desktop session; open the URL above or run \"\n                  \"`getwalletpwaurl`\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_ui_desktop_session_unavailable\", \"No desktop session; open the URL above or run `getwalletpwaurl`\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "No desktop session; open the URL above or run `getwalletpwaurl`\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve current Info severity, ALL category, exact readable text, Windows/POSIX/no-desktop branches and browser process behavior. Name is the existing launcher program (open or xdg-open), not a URL/user/wallet. Never add the login URL or token to the logger; terminal-only token-bearing stdout remains untouched and outside this conversion. No GUI launch performed during preparation."
+        },
+        {
+          "id": "wallet_ui_browser_launcher_failed",
+          "old": "LogPrintf(\"Could not start %s to open the wallet UI; open the URL \"\n                  \"above or run `getwalletpwaurl`\\n\",\n                  opener)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_ui_browser_launcher_failed\", \"Could not start {name} to open the wallet UI; open the URL above or run `getwalletpwaurl`\")\n        .Field(BCLog::LogField::Name, opener)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Could not start %s to open the wallet UI; open the URL above or run `getwalletpwaurl`\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "opener"
+            ]
+          },
+          "review_note": "Preserve current Info severity, ALL category, exact readable text, Windows/POSIX/no-desktop branches and browser process behavior. Name is the existing launcher program (open or xdg-open), not a URL/user/wallet. Never add the login URL or token to the logger; terminal-only token-bearing stdout remains untouched and outside this conversion. No GUI launch performed during preparation."
+        },
+        {
+          "id": "wallet_ui_browser_open_started",
+          "old": "LogPrintf(\"Opening the wallet UI in the default browser\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"wallet_ui_browser_open_started\", \"Opening the wallet UI in the default browser\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Opening the wallet UI in the default browser\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve current Info severity, ALL category, exact readable text, Windows/POSIX/no-desktop branches and browser process behavior. Name is the existing launcher program (open or xdg-open), not a URL/user/wallet. Never add the login URL or token to the logger; terminal-only token-bearing stdout remains untouched and outside this conversion. No GUI launch performed during preparation."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/walletpwa/launch.cpp b/src/walletpwa/launch.cpp
index c5fe533d69ae629931b0d2a95c3fb69b878c4d32..e227e6e00a6f40cfd69a1e626691689941e826c8 100644
--- a/src/walletpwa/launch.cpp
+++ b/src/walletpwa/launch.cpp
@@ -73,8 +73,9 @@ static void OpenBrowser(const std::string &url) {
     const auto result{reinterpret_cast<intptr_t>(ShellExecuteW(
         nullptr, L"open", wide.c_str(), nullptr, nullptr, SW_SHOWNORMAL))};
     if (result <= 32) {
-        LogPrintf("Could not open a browser for the wallet UI; open the URL "
-                  "above or run `getwalletpwaurl`\n");
+        LogInfoEvent(
+            BCLog::ALL, "wallet_ui_browser_open_failed",
+            "Could not open a browser for the wallet UI; open the URL above or run `getwalletpwaurl`");
     }
 #else
 #ifdef __APPLE__
@@ -82,8 +83,9 @@ static void OpenBrowser(const std::string &url) {
 #else
     const char *opener{"xdg-open"};
     if (!std::getenv("DISPLAY") && !std::getenv("WAYLAND_DISPLAY")) {
-        LogPrintf("No desktop session; open the URL above or run "
-                  "`getwalletpwaurl`\n");
+        LogInfoEvent(
+            BCLog::ALL, "wallet_ui_desktop_session_unavailable",
+            "No desktop session; open the URL above or run `getwalletpwaurl`");
         return;
     }
 #endif
@@ -92,9 +94,10 @@ static void OpenBrowser(const std::string &url) {
     char *argv[]{arg0.data(), arg1.data(), nullptr};
     pid_t pid;
     if (posix_spawnp(&pid, opener, nullptr, nullptr, argv, environ) != 0) {
-        LogPrintf("Could not start %s to open the wallet UI; open the URL "
-                  "above or run `getwalletpwaurl`\n",
-                  opener);
+        LogInfoEvent(
+            BCLog::ALL, "wallet_ui_browser_launcher_failed",
+            "Could not start {name} to open the wallet UI; open the URL above or run `getwalletpwaurl`")
+            .Field(BCLog::LogField::Name, opener);
         return;
     }
     // Reap the opener when it exits, without holding up startup.
@@ -134,7 +137,8 @@ void LaunchWalletPwa(const ArgsManager &args) {
         tfm::format(std::cout, "Wallet: %s\n", url);
         std::cout.flush();
     }
-    LogPrintf("Opening the wallet UI in the default browser\n");
+    LogInfoEvent(BCLog::ALL, "wallet_ui_browser_open_started",
+                 "Opening the wallet UI in the default browser");
     OpenBrowser(url);
 }
 
-- 
