+/**
+ * Integer floor square root of a 64-bit value.
+ * Uses the standard Newton-Raphson convergence for integer sqrt.
+ * Returns floor(sqrt(x)).
+ */
+uint64_t Sqrt64(uint64_t x) {
+    if (x == 0) {
+        return 0;
+    }
+    // Initial estimate: shift right by half the bit width
+    uint64_t r = x;
+    uint64_t q = (x >> 1) + 1;
+    while (q < r) {
+        r = q;
+        q = (q + x / q) >> 1;
+    }
+    return r;
+}
