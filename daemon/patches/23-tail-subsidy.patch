+int64_t ComputeNextTailSubsidy(const CBlockIndex *pindexPrev,
+                                const Consensus::Params &consensusParams) {
+    // Tail emission: R_{n+1}^tail = clip(R_n^tail * sqrt(W_n/W_{n-1}), R_min, R_max)
+    //
+    // W_n is derived from nBits: higher difficulty = more work per block.
+    // With gamma=1/2, the update is: R_tail *= sqrt(W_n / W_{n-1})
+    //                                         = sqrt(target_{n-1} / target_n)
+    //
+    // To avoid 256-bit arithmetic, we represent the work ratio as a fixed-point
+    // 32.32 value derived from the log2 difference of the two nBits targets.
+    //
+    // Parameters — tune before genesis launch:
+    //   TAIL_R0_INT  : initial tail value
+    //   TAIL_R_MIN   : minimum tail (prevents collapse)
+    //   TAIL_R_MAX   : maximum tail (safety cap against hash spikes)
+    //   PRECISION    : fixed-point precision bits for log2 computation
+
+    // 260 XPI initial tail (matches SUBSIDY floor; grows with difficulty)
+    static constexpr int64_t SUBSIDY_INT = SUBSIDY / SATOSHI;
+    static constexpr int64_t TAIL_R0_INT = SUBSIDY_INT;
+    static constexpr int64_t TAIL_R_MIN = SUBSIDY_INT / 10; // 26 XPI minimum
+    // 10x the boot floor as safety cap; adjust if needed
+    static constexpr int64_t TAIL_R_MAX = 10LL * SUBSIDY_INT;
+
+    // Genesis or first block: return initial tail value.
+    if (!pindexPrev || !pindexPrev->pprev) {
+        return TAIL_R0_INT;
+    }
+
+    const int64_t prevTail = pindexPrev->nTailSubsidy;
+
+    // Derive log2 of work from nBits for current and previous blocks.
+    // log2(W) = LOG_MAX_TARGET - log2(T), where log2(T) is computed from nBits.
+    // The difference log2(W_n) - log2(W_{n-1}) = log2(T_{n-1}) - log2(T_n).
+    static constexpr size_t PRECISION = 20;
+    const uint32_t bitsN   = pindexPrev->nBits;
+    const uint32_t bitsN_1 = pindexPrev->pprev->nBits;
+
+    const int64_t expN   = bitsN   >> 24;
+    const int64_t expN_1 = bitsN_1 >> 24;
+    const uint32_t mantN   = bitsN   & 0x007fffff;
+    const uint32_t mantN_1 = bitsN_1 & 0x007fffff;
+
+    // log2(T) in fixed point = log2(mantissa) + 8*(exp-3)
+    // We compute the difference: log2(T_{n-1}) - log2(T_n)
+    // Positive means T_{n-1} > T_n, i.e. difficulty increased (more work).
+    const int64_t log2TN   = Log2FixedPoint(mantN,   PRECISION) +
+                             ((int64_t)(8 * (expN   - 3)) << PRECISION);
+    const int64_t log2TN_1 = Log2FixedPoint(mantN_1, PRECISION) +
+                             ((int64_t)(8 * (expN_1 - 3)) << PRECISION);
+
+    // delta = log2(W_n/W_{n-1}) = log2(T_{n-1}/T_n) in fixed point
+    const int64_t deltaLog2 = log2TN_1 - log2TN;
+
+    // For gamma=1/2: multiply R_tail by 2^(deltaLog2/2)
+    // Represent as ratio in 32.32 fixed point: ratio = 2^(deltaLog2/2)
+    // ratio_fp = (1 << 32) * 2^(deltaLog2/2)
+    //          = 1 << (32 + deltaLog2/2)
+    // Use Sqrt64 to compute sqrt of the target ratio directly:
+    //   sqrt(W_n/W_{n-1}) = sqrt(T_{n-1}/T_n)
+    // Represent T_{n-1}/T_n as a 32.32 fixed-point ratio.
+    //
+    // To avoid overflow, work with the half-bit-shift representation:
+    // If deltaLog2 >= 0 (work increased, tail should grow):
+    //   half = deltaLog2 / 2 (integer bits) + fractional
+    // We use a simpler integer approximation: shift by half of the log2 delta.
+
+    int64_t nextTail;
+    const int64_t halfDelta = deltaLog2 / 2; // truncated toward zero
+
+    if (halfDelta >= 0) {
+        // Work increased: multiply by 2^(halfDelta/PRECISION)
+        const int64_t intPart  = halfDelta >> PRECISION;
+        const int64_t fracPart = halfDelta & ((1LL << PRECISION) - 1);
+        // Integer part: shift left; fractional part: linear interpolation
+        // R_tail * 2^intPart * (1 + fracPart/2^PRECISION)
+        nextTail = (prevTail << intPart) +
+                   ((prevTail * fracPart) >> PRECISION);
+    } else {
+        // Work decreased: divide by 2^(-halfDelta/PRECISION)
+        const int64_t intPart  = (-halfDelta) >> PRECISION;
+        const int64_t fracPart = (-halfDelta) & ((1LL << PRECISION) - 1);
+        nextTail = (prevTail >> intPart) -
+                   ((prevTail * fracPart) >> PRECISION);
+    }
+
+    // Clip to [R_min, R_max]
+    if (nextTail < TAIL_R_MIN) nextTail = TAIL_R_MIN;
+    if (nextTail > TAIL_R_MAX) nextTail = TAIL_R_MAX;
+
+    return nextTail;
+}
+
+Amount GetBlockSubsidy(const CBlockIndex *pindexPrev,
+                       const Consensus::Params &consensusParams) {
+    const int32_t nHeight = pindexPrev ? pindexPrev->nHeight + 1 : 0;
+    const Amount boot = GetBootSubsidy(nHeight, consensusParams);
+    const int64_t tail = ComputeNextTailSubsidy(pindexPrev, consensusParams);
+    return boot + tail * SATOSHI;
+}
