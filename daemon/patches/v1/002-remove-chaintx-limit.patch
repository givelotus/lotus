# Patch 002 — Remove ancestor/descendant chain-tx length limit from mempool
#
# Target base: eCash v0.24.11  fa7a44f731a2dfe1587e572d9eb0e4bb7c73d79c
#
# Background
# ----------
# Bitcoin (and eCash) enforces a maximum of 50 in-mempool ancestors and 50
# in-mempool descendants per transaction.  The limit was historically needed
# because the original block-construction algorithm iterated all CPFP
# accounting fields that must be re-computed when a new transaction is added
# (O(n²) in chain depth).
#
# Patch 001 replaced block assembly with an O(n log n) algorithm that takes a
# topological snapshot of the mempool, computes package stats once, and then
# sorts.  No pre-computed per-entry ancestor/descendant fields are read during
# mining, so the O(n²) DoS justification for the chain-length cap no longer
# applies.
#
# Changes
# -------
#  src/validation.cpp         — set all four chain-tx limits to SIZE_MAX
#  src/init.cpp               — remove -limitancestor* / -limitdescendant* args
#  src/test/mempool_tests.cpp — add regression test: 100-tx linear chain accepted
#
# NOTE: This patch is written against the eCash v0.24.11 API where
# CalculateMemPoolAncestors still takes explicit limit parameters and the
# limits are enforced in MemPoolAccept.  The v2 equivalent patch targets
# bitcoin-abc 252182e9 where this machinery was already removed upstream.
#
diff --git a/src/validation.cpp b/src/validation.cpp
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -56,6 +56,7 @@
 #include <optional>
 #include <string>
 #include <thread>
+#include <limits>

 namespace {

@@ -340,14 +341,10 @@ public:
     MemPoolAccept(CTxMemPool &mempool)
         : m_pool(mempool), m_view(&m_dummy),
           m_viewmempool(&::ChainstateActive().CoinsTip(), m_pool),
-          m_limit_ancestors(
-              gArgs.GetArg("-limitancestorcount", DEFAULT_ANCESTOR_LIMIT)),
-          m_limit_ancestor_size(
-              gArgs.GetArg("-limitancestorsize", DEFAULT_ANCESTOR_SIZE_LIMIT) *
-              1000),
-          m_limit_descendants(
-              gArgs.GetArg("-limitdescendantcount", DEFAULT_DESCENDANT_LIMIT)),
-          m_limit_descendant_size(gArgs.GetArg("-limitdescendantsize",
-                                               DEFAULT_DESCENDANT_SIZE_LIMIT) *
-                                  1000) {}
+          m_limit_ancestors(std::numeric_limits<size_t>::max()),
+          m_limit_ancestor_size(std::numeric_limits<size_t>::max()),
+          m_limit_descendants(std::numeric_limits<size_t>::max()),
+          m_limit_descendant_size(std::numeric_limits<size_t>::max()) {}

