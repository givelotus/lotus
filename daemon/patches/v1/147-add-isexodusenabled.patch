+struct Params;
+}
+
+/** Check if December 21st, 2021 protocol upgrade has activated. */
+bool IsExodusEnabled(const Consensus::Params &params,
+                     const CBlockIndex *pindexPrev);
 
 #endif // BITCOIN_CONSENSUS_ACTIVATION_H
