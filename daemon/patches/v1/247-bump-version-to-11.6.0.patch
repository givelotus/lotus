From 6590d92300ba588325628ab7c1a166e392947cff Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 00:29:48 -0700
Subject: [PATCH] Set the Lotus daemon version to 11.6.0

Align the CMake project version and client version macros for the
11.6.0 mainnet daemon release. Packaging and network metadata belong to
the separately reviewed release candidate rather than this version-only
source patch.

Rationale added during metadata recovery; this is not a recovered historical
message. Author and date are retained from the recorded replay commit.
The source diff is unchanged.

Recorded-replay-commit: a055e77a25c1664d63080cec4d8409d3a63bc190

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0f76e864d4..30653b2cc8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,7 +7,7 @@ set(CMAKE_USER_MAKE_RULES_OVERRIDE
 )
 
 project(lotus
-	VERSION 11.5.1
+	VERSION 11.6.0
 	DESCRIPTION "Lotus is a full node implementation of the Lotus protocol."
 	HOMEPAGE_URL "https://www.givelotus.org"
 )
@@ -24,7 +24,7 @@ add_custom_target(print-project-name
 
 # Package information
 set(PACKAGE_NAME "Lotus")
-set(PACKAGE_BUGREPORT "https://github.com/LogosFoundation/lotusd/issues")
+set(PACKAGE_BUGREPORT "https://github.com/givelotus/lotus/issues")
 
 # Copyright
 set(COPYRIGHT_YEAR 2026)
diff --git a/src/clientversion.cpp b/src/clientversion.cpp
index 512d15f9f4..962ef63c75 100644
--- a/src/clientversion.cpp
+++ b/src/clientversion.cpp
@@ -92,7 +92,7 @@ std::string CopyrightHolders(const std::string &strPrefix) {
 
 std::string LicenseInfo() {
     const std::string URL_SOURCE_CODE =
-        "<https://github.com/LogosFoundation/lotusd>";
+        "<https://github.com/givelotus/lotus>";
     const std::string URL_WEBSITE = "<https://www.givelotus.org>";
 
     return CopyrightHolders(strprintf(_("Copyright (C) %i-%i").translated, 2009,
