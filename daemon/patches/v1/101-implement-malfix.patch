+            "04030201" // n
+            "00"       // scriptSig
+            "efcdab00" // nSequence
+            // outputs
+            "00"
+            "00000000"));
+    {
+        CHashWriter ss(SER_GETHASH, 0);
+        ss << uint32_t(1); // nVersion
