From 16f7c2567ba42c30a3a0577edaebb4aaf821b750 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Thu, 18 Mar 2021 10:35:05 -0500
Subject: [PATCH 045/196] [backport#19601] Add SHA256Uint256 helper functions
 (#94)

Part 1 of 3.

Co-authored-by: Jeremy Rubin <j@rubin.io>
---
 src/hash.cpp            |  6 ++++++
 src/hash.h              |  4 ++++
 src/test/hash_tests.cpp | 23 +++++++++++++++++++++++
 3 files changed, 33 insertions(+)

diff --git a/src/hash.cpp b/src/hash.cpp
index 966bbe869..3153fda5a 100644
--- a/src/hash.cpp
+++ b/src/hash.cpp
@@ -81,3 +81,9 @@ void BIP32Hash(const ChainCode &chainCode, uint32_t nChild, uint8_t header,
         .Write(num, 4)
         .Finalize(output);
 }
+
+uint256 SHA256Uint256(const uint256 &input) {
+    uint256 result;
+    CSHA256().Write(input.begin(), 32).Finalize(result.begin());
+    return result;
+}
diff --git a/src/hash.h b/src/hash.h
index d4acebaca..c8dda160f 100644
--- a/src/hash.h
+++ b/src/hash.h
@@ -6,6 +6,7 @@
 #ifndef BITCOIN_HASH_H
 #define BITCOIN_HASH_H
 
+#include <attributes.h>
 #include <crypto/common.h>
 #include <crypto/ripemd160.h>
 #include <crypto/sha256.h>
@@ -179,6 +180,9 @@ uint256 SerializeHash(const T &obj, int nType = SER_GETHASH,
     return ss.GetHash();
 }
 
+/** Single-SHA256 a 32-byte input (represented as uint256). */
+NODISCARD uint256 SHA256Uint256(const uint256& input);
+
 uint32_t MurmurHash3(uint32_t nHashSeed, Span<const uint8_t> vDataToHash);
 
 void BIP32Hash(const ChainCode &chainCode, uint32_t nChild, uint8_t header,
diff --git a/src/test/hash_tests.cpp b/src/test/hash_tests.cpp
index 8680e78cd..154b7058b 100644
--- a/src/test/hash_tests.cpp
+++ b/src/test/hash_tests.cpp
@@ -201,4 +201,27 @@ BOOST_AUTO_TEST_CASE(hashverifier_tests) {
     BOOST_CHECK(h1.GetHash() != checksum);
 }
 
+BOOST_AUTO_TEST_CASE(sha256uint256_tests) {
+    BOOST_CHECK_EQUAL(
+        SHA256Uint256(uint256S("00000000000000000000000000000000000000000000000"
+                               "00000000000000000")),
+        uint256S("25295f0d1d592a90b333e26e85149708208e9f8e8bc18f6c77bd62f8ad7a6"
+                 "866"));
+    BOOST_CHECK_EQUAL(
+        SHA256Uint256(uint256S("0123456789abcdef0123456789abcdef0123456789abcde"
+                               "f0123456789abcdef")),
+        uint256S("8947da2b8e453d7c31900c9113891b730c5d4d7a84b332902051d026575fc"
+                 "150"));
+    BOOST_CHECK_EQUAL(
+        SHA256Uint256(uint256S("f17bc115754b0d900491da9715901538578803db10df2c3"
+                               "b9b61558f69907bbe")),
+        uint256S("22858d3cabd4baf35a7432c470c21e338aca3e2de2e6b104eff6d179528b9"
+                 "5ff"));
+    BOOST_CHECK_EQUAL(
+        SHA256Uint256(uint256S("6dd6c5716cc8e24313f619bab92ad24981f54ff7e24173a"
+                               "093f45f801e0342af")),
+        uint256S("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce"
+                 "26f"));
+}
+
 BOOST_AUTO_TEST_SUITE_END()
