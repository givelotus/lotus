 src/rpc/rawtransaction.cpp     |   3 +-
 src/script/interpreter.h       |   3 -
 src/script/sign.cpp            |  12 ++-
 src/script/sign.h              |   3 +-
 src/test/multisig_tests.cpp    |  63 +++++++-------
 src/test/script_p2sh_tests.cpp |  10 +--
 src/test/script_tests.cpp      | 149 +++++++++++++++++----------------
 src/test/transaction_tests.cpp |   9 +-
 src/wallet/wallet.cpp          |  19 ++++-
 10 files changed, 152 insertions(+), 121 deletions(-)

