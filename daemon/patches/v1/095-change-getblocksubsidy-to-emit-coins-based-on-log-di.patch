+        BOOST_CHECK_MESSAGE(
+            max_abs_error < MAX_EXPECTED_ABS_ERROR,
+            strprintf("Subsidy approximation failed, absolute error too large: "
+                      "%.16f >= %.16f, for nBits = %08x",
+                      max_abs_error, MAX_EXPECTED_ABS_ERROR,
+                      max_abs_error_nBits));
+        constexpr double MAX_EXPECTED_REL_ERROR = 0.00000001573502;
+        BOOST_CHECK_MESSAGE(
