+"""
+Test that we can broadcast transactions spending a Taproot output using the key
+spend path.
+
+Outputs have the form:
+
+OP_SCRIPTTYPE OP_1 <33-byte commitment pubkey>
+or
+OP_SCRIPTTYPE OP_1 <33-byte commitment pubkey> <32-byte state>
+
+and inputs have the form:
+
+<65-byte Schnorr signature using BIP341>
+"""
+
+from test_framework.key import ECKey
+from test_framework.blocktools import create_block, create_coinbase, make_conform_to_ctor
+from test_framework.messages import (
+    COutPoint,
+    CTransaction,
+    CTxIn,
+    CTxOut,
+)
+from test_framework.mininode import (
+    P2PDataStore,
+)
+from test_framework.script import (
+    CScript,
+    OP_1,
+    OP_EQUAL,
+    OP_HASH160,
+    OP_SCRIPTTYPE,
+    SIGHASH_ALL,
+    SIGHASH_ANYONECANPAY,
+    SIGHASH_BIP341,
+    SIGHASH_FORKID,
+    SIGHASH_NONE,
+    SIGHASH_SINGLE,
+    SignatureHashBIP341,
+)
+from test_framework.test_framework import BitcoinTestFramework
+
+
+TESTCASES = [
+    dict(outputs=1, inputs=1, sig_hash_types=[SIGHASH_ALL | SIGHASH_BIP341]),
+    dict(outputs=10, inputs=1, sig_hash_types=[SIGHASH_ALL | SIGHASH_BIP341]),
+    dict(outputs=2, inputs=1, sig_hash_types=[SIGHASH_ALL | SIGHASH_BIP341 | SIGHASH_ANYONECANPAY]),
+    dict(outputs=3, inputs=1, sig_hash_types=[SIGHASH_NONE | SIGHASH_BIP341]),
+    dict(outputs=4, inputs=1, sig_hash_types=[SIGHASH_NONE | SIGHASH_BIP341 | SIGHASH_ANYONECANPAY]),
+    dict(outputs=5, inputs=1, sig_hash_types=[SIGHASH_SINGLE | SIGHASH_BIP341]),
+    dict(outputs=6, inputs=1, sig_hash_types=[SIGHASH_SINGLE | SIGHASH_BIP341 | SIGHASH_ANYONECANPAY]),
+    dict(outputs=10, inputs=6, sig_hash_types=[SIGHASH_ALL | SIGHASH_BIP341,
+                                               SIGHASH_ALL | SIGHASH_BIP341 | SIGHASH_ANYONECANPAY,
+                                               SIGHASH_NONE | SIGHASH_BIP341,
+                                               SIGHASH_NONE | SIGHASH_BIP341 | SIGHASH_ANYONECANPAY,
