index c982927c5..bb6f3aa9a 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -11,6 +11,7 @@
 #include <config.h>
 #include <consensus/activation.h>
 #include <consensus/consensus.h>
