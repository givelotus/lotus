+__cold static __attribute__((__destructor__)) void mdbx_global_destructor(void) {
+  mdbx_fini();
+#ifdef ENABLE_GPROF
+  if (!&__gmon_start__)
+    _mcleanup();
+#endif /* ENABLE_GPROF */
+}
