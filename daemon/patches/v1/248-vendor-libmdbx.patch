+static inline meta_ptr_t meta_recent(const MDBX_env *env, const troika_t *troika) {
+  meta_ptr_t r;
+  r.txnid = troika->txnid[troika->recent];
+  r.ptr_v = METAPAGE(env, troika->recent);
+  r.is_steady = (troika->fsm >> troika->recent) & 1;
+  return r;
+}
