+    (__GNUC_PREREQ(6, 0) || __CLANG_PREREQ(5, 0))
+#define MDBX_ATTRIBUTE_TARGET_AVX512BW MDBX_ATTRIBUTE_TARGET("sse,sse2,avx,avx2,avx512bw")
