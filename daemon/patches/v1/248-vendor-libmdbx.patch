+__cold int mdbx_env_get_flags(const MDBX_env *env, unsigned *flags) {
+  int rc = check_env(env, false);
+  if (unlikely(rc != MDBX_SUCCESS))
+    return LOG_IFERR(rc);
+
+  if (unlikely(!flags))
+    return LOG_IFERR(MDBX_EINVAL);
+
+  *flags = env->flags & ENV_USABLE_FLAGS;
+  return MDBX_SUCCESS;
+}
