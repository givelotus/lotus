+MDBX_MAYBE_UNUSED static inline char sanitizer_kind_of_poison(const void *addr, size_t size) {
+  if (ASAN_REGISON_IS_POISONED(addr, size))
+    return 'P';
+  if (mdbx_running_on_Valgrind()) {
