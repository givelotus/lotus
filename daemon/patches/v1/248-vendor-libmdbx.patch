+MDBX_NOTHROW_PURE_FUNCTION MDBX_MAYBE_UNUSED static inline size_t pnl_search_exact(const const_pnl_t pnl, pgno_t pgno) {
+  size_t n = pnl_search_nochk(pnl, pgno);
+  return (n <= pnl_size(pnl) && pnl[n] == pgno) ? n : 0;
