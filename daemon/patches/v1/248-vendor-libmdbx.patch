+#ifndef _WIN32_WINNT
+#error Non-dll build libmdbx requires target Windows version \
+  to be explicitly defined via _WIN32_WINNT for properly \
+  handling thread local storage destructors.
+#endif /* _WIN32_WINNT */
+
