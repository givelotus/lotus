+MDBX_MAYBE_UNUSED MDBX_NOTHROW_PURE_FUNCTION static inline bool cursor_dbi_changed(const MDBX_cursor *mc) {
+  return dbi_changed(mc->txn, cursor_dbi(mc));
+}
