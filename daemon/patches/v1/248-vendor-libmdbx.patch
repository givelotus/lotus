+
+  const HINSTANCE hAdvapi32dll = GetModuleHandleA("advapi32.dll");
+  if (hAdvapi32dll) {
+    MDBX_IMPORT(hAdvapi32dll, RegGetValueA);
+  }
+
+  const HINSTANCE hOle32dll = GetModuleHandleA("ole32.dll");
+  if (hOle32dll) {
+    MDBX_IMPORT(hOle32dll, CoCreateGuid);
+  }
+}
