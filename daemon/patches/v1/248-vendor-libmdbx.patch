+/* non-atomic write with safety for reading a half-updated value */
+MDBX_MAYBE_UNUSED static __always_inline void safe64_update(mdbx_atomic_uint64_t *p, const uint64_t v) {
+#if MDBX_64BIT_ATOMIC
