+/* lite-costs checks */
+#define CHECK0(expr)                                                                                                   \
+  do {                                                                                                                 \
+    if (CHECKS0_ENABLED())                                                                                             \
+      ENSURE(expr);                                                                                                    \
+  } while (0)
+
+#define CHECK0_OBJ(obj, expr)                                                                                          \
+  do {                                                                                                                 \
+    if (CHECKS0_ENABLED())                                                                                             \
+      ENSURE_OBJ(obj, expr);                                                                                           \
+  } while (0)
+
+/* medium-costs checks */
+#define CHECK1(expr)                                                                                                   \
+  do {                                                                                                                 \
+    if (CHECKS1_ENABLED())                                                                                             \
+      ENSURE(expr);                                                                                                    \
+  } while (0)
+
+#define CHECK1_OBJ(obj, expr)                                                                                          \
+  do {                                                                                                                 \
+    if (CHECKS1_ENABLED())                                                                                             \
+      ENSURE_OBJ(obj, expr);                                                                                           \
+  } while (0)
+
+/* high-costs checks */
+#define CHECK2(expr)                                                                                                   \
+  do {                                                                                                                 \
+    if (CHECKS2_ENABLED())                                                                                             \
+      ENSURE(expr);                                                                                                    \
+  } while (0)
+
+#define CHECK2_OBJ(obj, expr)                                                                                          \
+  do {                                                                                                                 \
+    if (CHECKS2_ENABLED())                                                                                             \
+      ENSURE_OBJ(obj, expr);                                                                                           \
+  } while (0)
