From 054bba635a934474cc4ac20b6c5a13a9fc8ab043 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Sun, 7 Mar 2021 17:47:26 -0500
Subject: [PATCH 023/196] Enforce SIGHASH_FORKID from genesis (#44)

---
 src/validation.cpp | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/validation.cpp b/src/validation.cpp
index d8b8588ae..bedfdea9d 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -1524,10 +1524,8 @@ static uint32_t GetNextBlockScriptFlags(const Consensus::Params &params,
     // Always enforce CLEANSTACK
     flags |= SCRIPT_VERIFY_CLEANSTACK;
 
-    // If the UAHF is enabled, we start accepting replay protected txns
-    if (IsUAHFenabled(params, pindex)) {
-        flags |= SCRIPT_ENABLE_SIGHASH_FORKID;
-    }
+    // Always enforce SIGHASH_FORKID
+    flags |= SCRIPT_ENABLE_SIGHASH_FORKID;
 
     // We make sure this node will have replay protection during the next hard
     // fork.
