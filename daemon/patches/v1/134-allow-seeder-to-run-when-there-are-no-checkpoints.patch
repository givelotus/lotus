From 9332d9928a295ea100fd9c9c25efe1e0eb56a1e2 Mon Sep 17 00:00:00 2001
From: tnviet <ngocviet.tran1987@gmail.com>
Date: Mon, 21 Jun 2021 12:27:02 +0700
Subject: [PATCH] Allow seeder to run when there are no checkpoints (#199)

Currently, the seeder segfaults without any checkpoints. This commit
adjust the lookups into mapCheckpoints to first see if it has any elements.
This allows setting up Lotus seeders since we do not have any initial
checkpoints.

Co-authored-by: vince8x <vince.tran8x@gmail.com>
Co-authored-by: Shammah Chancellor <shammah.chancellor@gmail.com>

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 769f1d95e2c3770c6bd2829d88802b02b18aefd7
Recorded-replay-commit: b5665f1958d6f4ce0cbdf562096b00dc9e9a364a

diff --git a/src/seeder/bitcoin.cpp b/src/seeder/bitcoin.cpp
index c49e0536ce..ceafe256e6 100644
--- a/src/seeder/bitcoin.cpp
+++ b/src/seeder/bitcoin.cpp
@@ -76,15 +76,12 @@ PeerMessagingState CSeederNode::ProcessMessage(std::string strCommand,
             // day for each node we check
             if (vAddr) {
                 MessageWriter::WriteMessage(vSend, NetMsgType::GETADDR);
-                doneAfterDelta = GetTimeout();
-                needAddrReply = true;
-            }
-
-            // request headers starting after last checkpoint (only if we have
-            // checkpoints for this network)
-            if (HasCheckpoint()) {
-                std::vector<BlockHash> locatorHash(
-                    1, Params().Checkpoints().mapCheckpoints.rbegin()->second);
+                std::vector<BlockHash> locatorHash(0);
+                if (Params().Checkpoints().mapCheckpoints.size() > 0) {
+                    locatorHash = std::vector<BlockHash>(
+                        1,
+                        Params().Checkpoints().mapCheckpoints.rbegin()->second);
+                }
                 MessageWriter::WriteMessage(
                     vSend, NetMsgType::GETHEADERS,
                     CBlockLocator(std::move(locatorHash)), uint256());
diff --git a/src/seeder/db.h b/src/seeder/db.h
index 48b0ad9dd6..7a2a467d8c 100644
--- a/src/seeder/db.h
+++ b/src/seeder/db.h
@@ -25,7 +25,15 @@
 #define REQUIRE_VERSION 70001
 
 static inline int GetRequireHeight() {
-    return Params().Checkpoints().mapCheckpoints.rbegin()->first;
+    if (Params().Checkpoints().mapCheckpoints.rbegin() !=
+        Params().Checkpoints().mapCheckpoints.rend()) {
+        if (Params().Checkpoints().mapCheckpoints.rbegin() !=
+        Params().Checkpoints().mapCheckpoints.rend()) {
+        return Params().Checkpoints().mapCheckpoints.rbegin()->first;
+    }
+    return 0;
+    }
+    return 0;
 }
 
 static inline bool HasCheckpoint() {
