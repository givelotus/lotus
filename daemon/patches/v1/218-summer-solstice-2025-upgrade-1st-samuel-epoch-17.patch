+        #
+        # Using the first samuel addresses before upgrade fails
+        block = make_block_cb_post_numbers(FIRST_SAMUEL_SCRIPTS)
+        prepare_block(block)
+        assert_equal(node.submitblock(ToHex(block)), 'bad-cb-minerfund')
