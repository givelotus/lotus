+    const uint32_t size_remainder =
+        (control_block.size() - TAPROOT_CONTROL_BASE_SIZE) %
+        TAPROOT_CONTROL_NODE_SIZE;
+    if (control_block.size() < TAPROOT_CONTROL_BASE_SIZE ||
+        control_block.size() > TAPROOT_CONTROL_MAX_SIZE ||
