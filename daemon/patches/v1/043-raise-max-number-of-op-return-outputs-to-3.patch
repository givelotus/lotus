From 96f4063a34a5155d8ea40c625bc2584cc19a9127 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Fri, 12 Mar 2021 23:31:13 -0500
Subject: [PATCH 040/196] Raise max number of OP_RETURN outputs to 3 (#84)

---
 src/policy/policy.cpp             |  4 ++--
 src/test/transaction_tests.cpp    | 28 +++++++++++++++++++++++++---
 test/functional/mempool_accept.py |  3 ++-
 3 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/src/policy/policy.cpp b/src/policy/policy.cpp
index c893c1ba8..c8beed772 100644
--- a/src/policy/policy.cpp
+++ b/src/policy/policy.cpp
@@ -114,8 +114,8 @@ bool IsStandardTx(const CTransaction &tx, bool permit_bare_multisig,
         }
     }
 
-    // only one OP_RETURN txout is permitted
-    if (nDataOut > 1) {
+    // max 3 OP_RETURN txout are permitted
+    if (nDataOut > 3) {
         reason = "multi-op-return";
         return false;
     }
diff --git a/src/test/transaction_tests.cpp b/src/test/transaction_tests.cpp
index 48ff985bb..0cbbf8772 100644
--- a/src/test/transaction_tests.cpp
+++ b/src/test/transaction_tests.cpp
@@ -745,7 +745,7 @@ BOOST_AUTO_TEST_CASE(test_IsStandard) {
     t.vout[0].scriptPubKey = CScript() << OP_RETURN;
     BOOST_CHECK(IsStandardTx(CTransaction(t), reason));
 
-    // Only one TxoutType::NULL_DATA permitted in all cases
+    // 2 OP_RETURNs allowed
     t.vout.resize(2);
     t.vout[0].scriptPubKey =
         CScript() << OP_RETURN
@@ -756,20 +756,42 @@ BOOST_AUTO_TEST_CASE(test_IsStandard) {
                   << ParseHex("04678afdb0fe5548271967f1a67130b7105cd6a828e03909"
                               "a67962e0ea1f61deb649f6bc3f4cef38");
     reason.clear();
-    BOOST_CHECK(!IsStandardTx(CTransaction(t), reason));
-    BOOST_CHECK_EQUAL(reason, "multi-op-return");
+    BOOST_CHECK(IsStandardTx(CTransaction(t), reason));
+
+    // 3 OP_RETURNs also allowed
+    t.vout.resize(3);
+    t.vout[0].scriptPubKey =
+        CScript() << OP_RETURN
+                  << ParseHex("04678afdb0fe5548271967f1a67130b7105cd6a828e03909"
+                              "a67962e0ea1f61deb649f6bc3f4cef38");
+    t.vout[1].scriptPubKey =
+        CScript() << OP_RETURN
+                  << ParseHex("04678afdb0fe5548271967f1a67130b7105cd6a828e03909"
+                              "a67962e0ea1f61deb649f6bc3f4cef38");
+    t.vout[2].scriptPubKey =
+        CScript() << OP_RETURN
+                  << ParseHex("04678afdb0fe5548271967f1a67130b7105cd6a828e03909"
+                              "a67962e0ea1f61deb649f6bc3f4cef38");
+    reason.clear();
+    BOOST_CHECK(IsStandardTx(CTransaction(t), reason));
 
+    // Max. 3 TxoutType::NULL_DATA permitted in all cases
+    t.vout.resize(4);
     t.vout[0].scriptPubKey =
         CScript() << OP_RETURN
                   << ParseHex("04678afdb0fe5548271967f1a67130b7105cd6a828e03909"
                               "a67962e0ea1f61deb649f6bc3f4cef38");
     t.vout[1].scriptPubKey = CScript() << OP_RETURN;
+    t.vout[2].scriptPubKey = CScript() << OP_RETURN;
+    t.vout[3].scriptPubKey = CScript() << OP_RETURN;
     reason.clear();
     BOOST_CHECK(!IsStandardTx(CTransaction(t), reason));
     BOOST_CHECK_EQUAL(reason, "multi-op-return");
 
     t.vout[0].scriptPubKey = CScript() << OP_RETURN;
     t.vout[1].scriptPubKey = CScript() << OP_RETURN;
+    t.vout[2].scriptPubKey = CScript() << OP_RETURN;
+    t.vout[3].scriptPubKey = CScript() << OP_RETURN;
     reason.clear();
     BOOST_CHECK(!IsStandardTx(CTransaction(t), reason));
     BOOST_CHECK_EQUAL(reason, "multi-op-return");
diff --git a/test/functional/mempool_accept.py b/test/functional/mempool_accept.py
index e2fe42feb..2c2ab889f 100755
--- a/test/functional/mempool_accept.py
+++ b/test/functional/mempool_accept.py
@@ -340,9 +340,10 @@ class MempoolAcceptanceTest(BitcoinTestFramework):
                 {'txid': tx.rehash(), 'allowed': False, 'reject-reason': 'dust'}],
             rawtxs=[ToHex(tx)],
         )
+        # 4 OP_RETURN outputs not allowed
         tx = FromHex(CTransaction(), raw_tx_reference)
         tx.vout[0].scriptPubKey = CScript([OP_RETURN, b'\xff'])
-        tx.vout = [tx.vout[0]] * 2
+        tx.vout = [tx.vout[0]] * 4
         self.check_mempool_result(
             result_expected=[
                 {'txid': tx.rehash(), 'allowed': False, 'reject-reason': 'multi-op-return'}],
-- 
2.39.5 (Apple Git-154)

