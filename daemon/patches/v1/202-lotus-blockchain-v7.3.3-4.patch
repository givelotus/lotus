From 65cd9d98b7ebaa1b8a52560c75567eb6a3f7878e Mon Sep 17 00:00:00 2001
From: Matthew <matthew@urgero.net>
Date: Thu, 6 Jun 2024 09:29:22 -0500
Subject: [PATCH 03/46] Lotus Blockchain v7.3.3 (#4)

- Bump version 6.3.3 -> 7.3.3
- Add Lotusia branding
---
 CMakeLists.txt                | 8 ++++----
 contrib/aur/lotus-qt/PKGBUILD | 2 +-
 contrib/aur/lotus/PKGBUILD    | 2 +-
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f9c41e785..f13395cc4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,9 +7,9 @@ set(CMAKE_USER_MAKE_RULES_OVERRIDE
 )
 
 project(lotus
-	VERSION 6.3.3
+	VERSION 7.3.3
 	DESCRIPTION "Lotus is a full node implementation of the Lotus protocol."
-	HOMEPAGE_URL "https://www.givelotus.org"
+	HOMEPAGE_URL "https://lotusia.org"
 )
 
 add_custom_target(print-version
@@ -19,10 +19,10 @@ add_custom_target(print-version
 
 # Package information
 set(PACKAGE_NAME "Lotus")
-set(PACKAGE_BUGREPORT "https://github.com/LogosFoundation/lotusd/issues")
+set(PACKAGE_BUGREPORT "https://github.com/LotusiaStewardship/lotusd/issues")
 
 # Copyright
-set(COPYRIGHT_YEAR 2022)
+set(COPYRIGHT_YEAR 2024)
 set(COPYRIGHT_HOLDERS "The %s developers")
 set(COPYRIGHT_HOLDERS_SUBSTITUTION Bitcoin)
 string(REPLACE "%s" ${COPYRIGHT_HOLDERS_SUBSTITUTION} COPYRIGHT_HOLDERS_FINAL ${COPYRIGHT_HOLDERS})
diff --git a/contrib/aur/lotus-qt/PKGBUILD b/contrib/aur/lotus-qt/PKGBUILD
index dc186eab3..b24376f18 100644
--- a/contrib/aur/lotus-qt/PKGBUILD
+++ b/contrib/aur/lotus-qt/PKGBUILD
@@ -1,7 +1,7 @@
 # Maintainer: Josh Ellithorpe <quest@mac.com>
 
 pkgname=lotus-qt
-pkgver=6.3.3
+pkgver=7.3.3
 pkgrel=0
 pkgdesc="Lotus with lotusd, lotus-cli, lotus-tx, lotus-seeder and lotus-qt"
 arch=('i686' 'x86_64')
diff --git a/contrib/aur/lotus/PKGBUILD b/contrib/aur/lotus/PKGBUILD
index 3413e2a6e..87f14500a 100644
--- a/contrib/aur/lotus/PKGBUILD
+++ b/contrib/aur/lotus/PKGBUILD
@@ -1,7 +1,7 @@
 # Maintainer: Josh Ellithorpe <quest@mac.com>
 
 pkgname=lotusd
-pkgver=6.3.3
+pkgver=7.3.3
 pkgrel=0
 pkgdesc="Lotus with lotusd, lotus-tx, lotus-seeder and lotus-cli"
 arch=('i686' 'x86_64')
