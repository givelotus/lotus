From 3f33ff3e464bc87acb9c7442ca3c70dcfa94710b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matthew=20=F0=9F=AA=B7?= <matthew@urgero.net>
Date: Fri, 31 Oct 2025 16:58:53 -0500
Subject: [PATCH 43/46] Fix: Enable Taproot in mempool after Second Samuel
 activation (#30)

The mempool acceptance code (PreChecks) was not properly removing the
SCRIPT_DISABLE_TAPROOT_SIGHASH_LOTUS flag after Second Samuel
activation, causing valid Taproot transactions to be rejected with
"non-mandatory- script-verify-flag" errors even though they passed
consensus validation.

The issue occurred because STANDARD_SCRIPT_VERIFY_FLAGS always includes
SCRIPT_DISABLE_TAPROOT_SIGHASH_LOTUS. While GetNextBlockScriptFlags()
correctly removes this flag when Second Samuel is active for consensus
validation, the mempool policy check was unconditionally adding it back
via extraFlags.

This fix mirrors the logic already present in ConnectBlock (lines
1738-1741) by checking IsSecondSamuelEnabled() and clearing the disable
flag from extraFlags when appropriate, ensuring mempool policy matches
consensus rules after the upgrade activates.

Without this fix, nodes with Second Samuel activated would reject
Taproot transactions from their mempool while still accepting blocks
containing them, creating an inconsistency between mempool policy and
consensus rules.
---
 src/validation.cpp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/validation.cpp b/src/validation.cpp
index c2cd5f0a9..757e8bffa 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -604,9 +604,16 @@ bool MemPoolAccept::PreChecks(ATMPArgs &args, Workspace &ws) {
             strprintf("%d < %d", nModifiedFees, ::minRelayTxFee.GetFee(nSize)));
     }
 
-    const uint32_t extraFlags = fRequireStandardPolicy
-                                    ? STANDARD_SCRIPT_VERIFY_FLAGS
-                                    : MANDATORY_SCRIPT_VERIFY_FLAGS;
+    uint32_t extraFlags = fRequireStandardPolicy
+                              ? STANDARD_SCRIPT_VERIFY_FLAGS
+                              : MANDATORY_SCRIPT_VERIFY_FLAGS;
+
+    // After Second Samuel, we enable Taproot and SIGHASH_LOTUS
+    if (fRequireStandardPolicy &&
+        IsSecondSamuelEnabled(args.m_config.GetChainParams().GetConsensus(),
+                              ::ChainActive().Tip())) {
+        extraFlags &= ~SCRIPT_DISABLE_TAPROOT_SIGHASH_LOTUS;
+    }
 
     // Validate input scripts against standard script flags.
     const uint32_t scriptVerifyFlags =
