 src/consensus/addresses_testnet.h | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/consensus/addresses_testnet.h b/src/consensus/addresses_testnet.h
index b6bb1667c..848366ffa 100644
