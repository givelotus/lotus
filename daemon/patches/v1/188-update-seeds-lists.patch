 contrib/seeds/nodes_main.txt |  8 ++++++--
 contrib/seeds/seeds_main.txt | 12 +++++++-----
 contrib/seeds/seeds_test.txt |  2 +-
 src/chainparamsseeds.h       |  8 ++++++--
 5 files changed, 21 insertions(+), 11 deletions(-)

