 # eCash network.
-PATTERN_AGENT = re.compile(r"^(/lotusd:1.0.(\d+)\(.+\)/)")
+PATTERN_AGENT = re.compile(r"^(/lotusd:3.(\d+).(\d+)\(.+\)/)")
 
 def parseline(line):
     sline = line.split()
