-    DEFINED, // First state that each softfork starts out as. The genesis block
-             // is by definition in this state for each deployment.
-    STARTED, // For blocks past the starttime.
-    LOCKED_IN, // For one retarget period after the first retarget period with
-               // STARTED blocks of which at least threshold have the associated
-               // bit set in nVersion.
-    ACTIVE, // For all blocks after the LOCKED_IN retarget period (final state)
-    FAILED, // For all blocks once the first retarget period after the timeout
-            // time is hit, if LOCKED_IN wasn't already reached (final state)
-};
