+        CheckOperators(a_i63, a_i63);
+        CheckOperators(a_i63, b_i63);
+        CheckOperators(b_i63, a_i63);
+        CheckOperators(b_i63, b_i63);
+        CheckTernary(a_i63, b_i63, c_i63);
+        if (test < 256) {
