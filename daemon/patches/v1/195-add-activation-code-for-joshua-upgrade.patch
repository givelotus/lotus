Subject: [PATCH] Add activation code for Joshua upgrade (#310)

Make all necessary preparations for the Joshua upgrade Dec 22, 2023.

Used commit 6e2e115 as a template for this commit.

---------
Co-authored-by: Shammah Chancellor <213740+schancel@users.noreply.github.com>

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 6d7f6ad49192fd570fd13a6c554681885efca291
Recorded-replay-commit: f46039ca31053424d7b33d77f522f1c9eb47df95

diff --git a/src/consensus/activation.cpp b/src/consensus/activation.cpp
index c8df6ddd48..d3e30b598d 100644
--- a/src/consensus/activation.cpp
+++ b/src/consensus/activation.cpp
@@ -92,3 +92,13 @@ bool IsDeuteronomyEnabled(const Consensus::Params &params,
     return pindexPrev->GetMedianTimePast() >=
            gArgs.GetIntArg("-deuteronomyactivationtime", params.deuteronomyActivationTime);
 }
+
+bool IsJoshuaEnabled(const Consensus::Params &params,
+                     const CBlockIndex *pindexPrev) {
+    if (pindexPrev == nullptr) {
+        return false;
+    }
+
+    return pindexPrev->GetMedianTimePast() >=
+           gArgs.GetIntArg("-joshuaactivationtime", params.joshuaActivationTime);
+}
