+/** Check if 2023-12-22T03:27:00.000Z protocol upgrade has activated. */
+bool IsJoshuaEnabled(const Consensus::Params &params,
+                     const CBlockIndex *pindexPrev);
+
 #endif // BITCOIN_CONSENSUS_ACTIVATION_H
