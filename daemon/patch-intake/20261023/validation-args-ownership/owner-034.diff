+lotus::v2::Outpoint OutPointToV2Outpoint(const COutPoint &outpoint) {
+    lotus::v2::Outpoint out{};
+    std::copy_n(outpoint.GetTxId().begin(), 32, out.tx_id.begin());
+    out.index = outpoint.GetN();
+    return out;
