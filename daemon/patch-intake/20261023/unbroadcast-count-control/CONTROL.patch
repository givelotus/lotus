From e4332caa231961103cd1418d4327101bf0713992 Mon Sep 17 00:00:00 2001
From: Canonical patch progression <213740+schancel@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:34:15 -0700
Subject: [PATCH] rpc: count unbroadcast transactions without copying their IDs

Reuse the exact caller-locked count accessor supplied by snapshot owner30 in the ordinary mempool-info RPC. This isolated control adds neither snapshot publication nor snapshot-backed reads. Preserve the full-set API for callers that need IDs.
---
 src/rpc/mempool.cpp | 2 +-
 src/txmempool.h     | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/rpc/mempool.cpp b/src/rpc/mempool.cpp
index 2b0952b0d7..759ac7f15e 100644
--- a/src/rpc/mempool.cpp
+++ b/src/rpc/mempool.cpp
@@ -704,7 +704,7 @@ UniValue MempoolInfoToJSON(const CTxMemPool &pool) {
         "mempoolminfee",
         std::max(pool.GetMinFee(), pool.m_opts.min_relay_feerate).GetFeePerK());
     ret.pushKV("minrelaytxfee", pool.m_opts.min_relay_feerate.GetFeePerK());
-    ret.pushKV("unbroadcastcount", uint64_t{pool.GetUnbroadcastTxs().size()});
+    ret.pushKV("unbroadcastcount", uint64_t{pool.GetUnbroadcastTxCount()});
     return ret;
 }
 
diff --git a/src/txmempool.h b/src/txmempool.h
index bf93826c2d..903edf7c59 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -577,6 +577,12 @@ public:
         return m_unbroadcast_txids;
     }
 
+    /** Returns the unbroadcast count without copying the transaction IDs. */
+    size_t GetUnbroadcastTxCount() const EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        AssertLockHeld(cs);
+        return m_unbroadcast_txids.size();
+    }
+
     /** Returns whether a txid is in the unbroadcast set */
     bool IsUnbroadcastTx(const TxId &txid) const EXCLUSIVE_LOCKS_REQUIRED(cs) {
         AssertLockHeld(cs);
-- 
