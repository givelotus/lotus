From ca84c8ea41008b444caf9cc561fd8a002f760fa6 Mon Sep 17 00:00:00 2001
From: Canonical patch progression <213740+schancel@users.noreply.github.com>
Date: Fri, 23 Oct 2026 09:14:29 -0700
Subject: [PATCH] fixup! http: replace libevent evhttp with Boost.Beast
 HTTP/1.1 + async_detect_ssl + zstd server

---
 src/httpserver.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/httpserver.cpp b/src/httpserver.cpp
index 0c38d58fac..4dd813c9d0 100644
--- a/src/httpserver.cpp
+++ b/src/httpserver.cpp
@@ -1845,6 +1845,12 @@ static asio::awaitable<void> ServeHTTP(Stream &stream,
         }
 
         if (!parser.is_done()) {
+            // Beast otherwise reuses its initial 512-byte capacity as the
+            // parser consumes each chunk. Grow lazily for bodies, with bounded
+            // read-ahead rather than one receive operation per tiny chunk.
+            constexpr uint64_t body_read_chunk = 16 * 1024;
+            buffer.reserve(std::min<uint64_t>(
+                body_read_chunk, parser.content_length().value_or(body_read_chunk)));
             auto [body_ec, body_n] = co_await http::async_read(
                 stream, buffer, parser, asio::as_tuple(asio::use_awaitable));
             if (body_ec) {
