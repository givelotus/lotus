+    BOOST_CHECK(contended.get());
+    std::atomic<unsigned> failures{0};
+    util::GetParallelRangeExecutor().Run(2, 1, [&](size_t, size_t) {
+        if (!check_roots()) ++failures;
+    });
+    BOOST_CHECK_EQUAL(failures.load(), 0U);
+}
 
