+        entry.fee_sats = 300;
+        entry.sigchecks = 1;
+        entry.spent_outpoints.push_back({random_hash(), 0});
+        lotus::v2::Coin coin;
+        coin.outpoint = {entry.tx_id, 0};
+        coin.output.value = 1000;
+        coin.output.legacy_script = {OP_TRUE};
+        coin.creation_height = 200;
+        entry.created_coins.push_back(coin);
+        SmtInsert(base, coin);
+    }
