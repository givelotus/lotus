From 510ab830b21322e80e74cc247fbbd92aba489dcd Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <213740+schancel@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:14:22 -0700
Subject: [PATCH] [SHARED] Extract radix nibbles directly from numeric words

---
 src/arith_uint256.h      |  6 +++++
 src/radix.h              |  8 +++++-
 src/test/radix_tests.cpp | 56 ++++++++++++++++++++++++++++++++++++++++
 src/uint256radixkey.h    |  1 +
 4 files changed, 70 insertions(+), 1 deletion(-)

diff --git a/src/arith_uint256.h b/src/arith_uint256.h
index ef81c4ccc4..70f93e13bd 100644
--- a/src/arith_uint256.h
+++ b/src/arith_uint256.h
@@ -264,6 +264,12 @@ public:
     arith_uint256(const base_uint<256> &b) : base_uint<256>(b) {}
     arith_uint256(uint64_t b) : base_uint<256>(b) {}
 
+    /** Numeric nibble indexed from the least significant end; zero past bit 255. */
+    uint32_t GetNibble(uint32_t index) const {
+        if (index >= 64) return 0;
+        return (pn[index / 8] >> (4 * (index % 8))) & 0x0fU;
+    }
+
     /**
      * The "compact" format is a representation of a whole number N using an
      * unsigned 32bit number similar to a floating point format.
diff --git a/src/radix.h b/src/radix.h
index b985fc6258..d4c2371cc1 100644
--- a/src/radix.h
+++ b/src/radix.h
@@ -434,7 +434,13 @@ private:
         RadixNode &operator=(const RadixNode &) = delete;
 
         std::atomic<RadixElement> *get(uint32_t level, const KeyType &key) {
-            return &children[(key >> uint32_t(level * BITS)) & MASK];
+            // Optional numeric-nibble access avoids a full-width temporary.
+            // Other key types retain the generic shift/mask contract.
+            if constexpr (BITS == 4 && requires { key.GetNibble(level); }) {
+                return &children[key.GetNibble(level)];
+            } else {
+                return &children[(key >> uint32_t(level * BITS)) & MASK];
+            }
         }
 
         bool isShared() const { return refcount > 0; }
diff --git a/src/test/radix_tests.cpp b/src/test/radix_tests.cpp
index 2b534636c3..9feee57047 100644
--- a/src/test/radix_tests.cpp
+++ b/src/test/radix_tests.cpp
@@ -614,6 +614,62 @@ BOOST_AUTO_TEST_CASE(tree_traversal) {
     BOOST_CHECK(!ret);
 }
 
+BOOST_AUTO_TEST_CASE(uint256_nibbles_match_full_width_shift) {
+    auto check = [](const arith_uint256 &value) {
+        const Uint256RadixKey key{value};
+        for (uint32_t level = 0; level < 64; ++level) {
+            BOOST_TEST_CONTEXT("value=" << value.GetHex() << " level=" << level) {
+                const uint32_t expected =
+                    static_cast<uint32_t>((value >> (level * 4)).GetLow64() & 15);
+                BOOST_CHECK_EQUAL(value.GetNibble(level), expected);
+                BOOST_CHECK_EQUAL(key.GetNibble(level), expected);
+            }
+        }
+        BOOST_CHECK_EQUAL(value.GetNibble(64), 0U);
+        BOOST_CHECK_EQUAL(key.GetNibble(std::numeric_limits<uint32_t>::max()), 0U);
+    };
+    check(arith_uint256(0));
+    check(~arith_uint256(0));
+    check(UintToArith256(uint256S(
+        "0123456789abcdeffedcba98765432100f1e2d3c4b5a69788796a5b4c3d2e1f0")));
+    check(UintToArith256(uint256S(
+        "aaaaaaaa55555555aaaaaaaa55555555aaaaaaaa55555555aaaaaaaa55555555")));
+    for (unsigned bit = 0; bit < 256; ++bit) {
+        check(arith_uint256(1) << bit);
+    }
+    FastRandomContext rng{true};
+    for (unsigned i = 0; i < 128; ++i) check(UintToArith256(rng.rand256()));
+}
+
+BOOST_AUTO_TEST_CASE(uint256_tree_splits_at_every_nibble) {
+    using E = TestElementUint256;
+    for (unsigned level = 0; level < 64; ++level) {
+        BOOST_TEST_CONTEXT("split level=" << level) {
+            RadixTree<E> tree;
+            const arith_uint256 shared = UintToArith256(uint256S(
+                "c86420fedba9753113579bdf02468acefedcba98765432100123456789abcdef"));
+            const arith_uint256 mask = arith_uint256(15) << (level * 4);
+            std::vector<RCUPtr<E>> entries;
+            // Each trial starts with one leaf, then diverges only at the
+            // selected nibble. Include every possible child slot.
+            for (unsigned nibble = 0; nibble < 16; ++nibble) {
+                const auto key = (shared & ~mask) |
+                    (arith_uint256(nibble) << (level * 4));
+                entries.push_back(RCUPtr<E>::make(ArithToUint256(key)));
+                BOOST_REQUIRE(tree.insert(entries.back()));
+            }
+            for (const auto &entry : entries) {
+                BOOST_CHECK(tree.get(entry->getId()) == entry);
+                BOOST_CHECK(!tree.insert(entry));
+            }
+            for (const auto &entry : entries) {
+                BOOST_REQUIRE(tree.remove(entry->getId()));
+                BOOST_CHECK(!tree.get(entry->getId()));
+            }
+        }
+    }
+}
+
 BOOST_AUTO_TEST_CASE(uint256_key_equality_compares_high_bits) {
     for (uint64_t low : {uint64_t{0}, uint64_t{0x0123456789abcdef}}) {
         const Uint256RadixKey original{arith_uint256(low)};
diff --git a/src/uint256radixkey.h b/src/uint256radixkey.h
index 18a5f9d005..6fc5b2db34 100644
--- a/src/uint256radixkey.h
+++ b/src/uint256radixkey.h
@@ -20,6 +20,7 @@ struct Uint256RadixKey {
     Uint256RadixKey(const uint256 &keyIn) : base(UintToArith256(keyIn)) {}
     Uint256RadixKey(const base_uint<256> &keyIn) : base(keyIn) {}
 
+    uint32_t GetNibble(uint32_t level) const { return base.GetNibble(level); }
     Uint256RadixKey operator>>(uint32_t shift) const { return base >> shift; }
     Uint256RadixKey operator&(const Uint256RadixKey &mask) const {
         return base & mask.base;
