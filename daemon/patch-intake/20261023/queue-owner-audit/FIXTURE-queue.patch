From 94453bdd7d8a681d6a872df85366f370bfa78089 Mon Sep 17 00:00:00 2001
From: Canonical patch progression <213740+schancel@users.noreply.github.com>
Date: Fri, 23 Oct 2026 11:51:06 -0700
Subject: [PATCH] fixup! net: announce transactions by 8-byte short ids to
 peers that support it

---
 src/test/v2_protocol_handler_tests.cpp | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/test/v2_protocol_handler_tests.cpp b/src/test/v2_protocol_handler_tests.cpp
index b4640ac157..94d59b01e0 100644
--- a/src/test/v2_protocol_handler_tests.cpp
+++ b/src/test/v2_protocol_handler_tests.cpp
@@ -1711,8 +1711,16 @@ BOOST_AUTO_TEST_CASE(single_tx_relays_wait_for_the_relay_tick) {
                            PROTOCOL_VERSION, true);
         BOOST_CHECK(peerman->SendMessages(config, &node));
         WITH_LOCK(node.cs_vSend, node.vSendMsg.clear());
-        peerman->GetV2ProtocolHandler()->SetHighBandwidthShortTxPeer(
-            node.GetId(), high_bandwidth);
+        // Exercise the real private-wire negotiation. Local permission or
+        // compact-block bandwidth does not advertise SHORTTX support.
+        DataStream capability{};
+        capability << txrelay::SENDINVSHORT_VERSION
+                   << (high_bandwidth
+                           ? uint64_t{txrelay::TXRELAY_HIGH_BANDWIDTH}
+                           : uint64_t{0});
+        std::atomic<bool> interrupt{false};
+        peerman->ProcessMessage(config, node, NetMsgType::SENDINVSHORT,
+                               capability, 0us, interrupt);
         FastRandomContext rng(uint256{static_cast<uint8_t>(100 + scenario)});
         std::vector<CTransactionRef> txs;
         TestMemPoolEntryHelper entry;
