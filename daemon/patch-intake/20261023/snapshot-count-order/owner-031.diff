+#ifndef BITCOIN_NODE_SNAPSHOT_H
+#define BITCOIN_NODE_SNAPSHOT_H
+
+#include <consensus/amount.h>
+#include <consensus/params.h>
+#include <feerate.h>
+#include <flatfile.h>
