+/** Scalar getmempoolinfo state. It does not pin a transaction tree or construct
+ * the full snapshot (which owns lazy caches and shared_ptrs).
+ */
+struct MempoolInfoSnapshot {
+    const CTxMemPool *mempool_ptr{nullptr};
+    bool mempool_valid{false}, mempool_loaded{false};
+    size_t mempool_size{0}, mempool_bytes{0};
+    size_t finalized_txs_size{0}, finalized_txs_bytes{0};
+    int64_t finalized_txs_sigchecks{0};
+    size_t mempool_usage{0};
+    int64_t total_fee_sats{0};
+    size_t max_mempool{0};
+    int64_t min_relay_fee_sats_per_k{0};
+    double rolling_minimum_fee_rate{0};
+    int64_t last_rolling_fee_update{0};
+    bool block_since_last_rolling_fee_bump{false};
+    size_t unbroadcast_count{0};
+
+    auto Values() const {
+        return std::tuple{mempool_ptr, mempool_valid, mempool_loaded,
+            mempool_size, mempool_bytes, finalized_txs_size, finalized_txs_bytes,
+            finalized_txs_sigchecks, mempool_usage, total_fee_sats, max_mempool,
+            min_relay_fee_sats_per_k, rolling_minimum_fee_rate,
+            last_rolling_fee_update, block_since_last_rolling_fee_bump,
+            unbroadcast_count};
+    }
+};
+
 /** Atomic publication keeps RPC readers independent of chain/mempool locks.
  * Standard atomic shared_ptr operations may internally synchronize; this API
  * does not promise wait freedom or a platform-independent lock-free primitive.
  * Only readers retain older snapshots, avoiding a ring of 1024 chain indexes. */
 class SnapshotPublisher {
     std::shared_ptr<const ChainAndMempoolSnapshot> m_current;
+    util::AtomicSnapshot<decltype(MempoolInfoSnapshot{}.Values())> m_info;
     std::atomic<uint64_t> m_publications{0};
     static constexpr size_t kTemplateHistorySize = 32;
     mutable std::mutex m_publish_mutex;
@@ -300,6 +330,11 @@ public:
     std::shared_ptr<const ChainAndMempoolSnapshot> Load() const noexcept {
         return std::atomic_load_explicit(&m_current, std::memory_order_acquire);
     }
+    MempoolInfoSnapshot LoadMempoolInfo() const noexcept {
+        return std::apply([](auto... fields) {
+            return MempoolInfoSnapshot{fields...};
+        }, m_info.Load());
+    }
     void Publish(std::shared_ptr<const ChainAndMempoolSnapshot> next);
     uint64_t PublicationCount() const noexcept { return m_publications.load(); }
 };
