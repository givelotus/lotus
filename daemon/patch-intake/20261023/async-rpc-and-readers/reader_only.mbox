+++ b/src/node/snapshot.cpp
@@ -595,6 +595,15 @@ SnapshotPublisher::SnapshotPublisher()
 
 void SnapshotPublisher::Publish(std::shared_ptr<const ChainAndMempoolSnapshot> next) {
     if (!next) return;
+    const MempoolInfoSnapshot info{next->mempool_ptr, next->mempool_valid,
+        next->mempool_loaded, next->mempool_size, next->mempool_bytes,
+        next->finalized_txs_size, next->finalized_txs_bytes,
+        next->finalized_txs_sigchecks, next->mempool_usage,
+        next->total_fee / SATOSHI, next->max_mempool,
+        next->min_relay_tx_fee.GetFeePerK() / SATOSHI,
+        next->rolling_minimum_fee_rate, next->last_rolling_fee_update,
+        next->block_since_last_rolling_fee_bump, next->unbroadcast_count};
+    m_info.Store(info.Values());
     std::atomic_store_explicit(&m_current, std::move(next), std::memory_order_release);
     m_publications.fetch_add(1);
 }
