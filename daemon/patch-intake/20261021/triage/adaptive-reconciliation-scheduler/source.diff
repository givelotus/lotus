+BOOST_AUTO_TEST_CASE(reconciliation_same_identity_changes_survive_capture) {
+    txrelay::ReconciliationScheduler scheduler{2, 1s, 1ms, 0ms};
+    FastRandomContext rng{true};
+    const TxId a{rng.rand256()}, b{rng.rand256()};
+    scheduler.Changed(a, 0ms);
+    scheduler.Changed(b, 0ms);
+    auto first = scheduler.Begin(0ms);
+    BOOST_REQUIRE(first);
+    // Insert/remove/reinsert of the same IDs after capture belongs to the next
+    // scheduling generation, rather than being erased with the old ticket.
+    scheduler.Changed(a, 1ms);
+    scheduler.Changed(b, 1ms);
+    scheduler.Complete(*first, 1ms, true);
+    auto next = scheduler.Begin(2ms);
+    BOOST_REQUIRE(next);
+    BOOST_CHECK(next->generation > first->generation);
+    scheduler.Complete(*next, 2ms, true);
+    // Same-generation inbound requests coalesce across initiated passes too.
+    BOOST_CHECK(scheduler.Incoming());
+    BOOST_CHECK(!scheduler.Incoming());
+}
