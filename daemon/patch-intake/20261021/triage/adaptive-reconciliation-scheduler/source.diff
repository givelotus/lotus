+BOOST_AUTO_TEST_CASE(reconciliation_coalesced_hints_and_local_observation) {
+    txrelay::ReconciliationScheduler scheduler{1, 100ms, 10ms, 0ms};
+    FastRandomContext rng{true};
+    const uint256 root{rng.rand256()}, base{rng.rand256()};
+    BOOST_CHECK(!scheduler.Begin(0ms));
+    for (int i = 0; i < 10000; ++i) scheduler.Incoming();
+    BOOST_CHECK(!scheduler.Begin(99ms)); // incoming traffic cannot force fanout
+    for (int i = 1; i <= 3; ++i) {
+        auto pass = scheduler.Begin(i * 100ms);
+        BOOST_REQUIRE(pass);
+        BOOST_CHECK_EQUAL(scheduler.ObserveLocalRoot(root, base, *pass), size_t(i));
+        scheduler.Complete(*pass, i * 100ms, true);
+    }
+    scheduler.Changed(TxId{rng.rand256()}, 301ms);
+    auto changed = scheduler.Begin(310ms);
+    BOOST_REQUIRE(changed);
+    BOOST_CHECK_EQUAL(scheduler.ObserveLocalRoot(root, base, *changed), 1U);
+    scheduler.Complete(*changed, 310ms, true);
+    scheduler.Incoming();
+    auto later = scheduler.Begin(410ms);
+    BOOST_REQUIRE(later);
+    BOOST_CHECK_EQUAL(scheduler.ObserveLocalRoot(root, rng.rand256(), *later), 1U);
+    scheduler.Complete(*later, 410ms, true);
+}
