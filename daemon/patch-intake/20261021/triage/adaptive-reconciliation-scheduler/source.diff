+BOOST_AUTO_TEST_CASE(reconciliation_fresh_subsets_and_fair_discovery) {
+    txrelay::ReconciliationScheduler scheduler{1, 100ms, 1ms, 0ms};
+    FastRandomContext rng{uint256{77}};
+    std::vector<NodeId> peers;
+    for (int i = 0; i < 40; ++i) peers.push_back(i);
+    std::set<std::vector<NodeId>> draws;
+    for (int i = 0; i < 12; ++i) {
+        auto chosen = scheduler.Select(peers, 10, false, rng);
+        BOOST_CHECK_EQUAL(chosen.size(), 10U);
+        std::set<NodeId> unique(chosen.begin(), chosen.end());
+        BOOST_CHECK_EQUAL(unique.size(), chosen.size());
+        std::sort(chosen.begin(), chosen.end());
+        draws.insert(chosen);
+    }
+    BOOST_CHECK_GT(draws.size(), 1U);
+    std::set<NodeId> discovered;
+    for (int i = 0; i < 40; ++i) {
+        auto chosen = scheduler.Select(peers, 1, true, rng);
+        BOOST_REQUIRE_EQUAL(chosen.size(), 1U);
+        discovered.insert(chosen[0]);
+    }
+    BOOST_CHECK_EQUAL(discovered.size(), peers.size());
+}
