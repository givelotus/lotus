diff --git a/src/net/reconciliation_scheduler.h b/src/net/reconciliation_scheduler.h
new file mode 100644
index 0000000000..5a354423fb
--- /dev/null
+++ b/src/net/reconciliation_scheduler.h
@@ -0,0 +1,144 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#ifndef BITCOIN_NET_RECONCILIATION_SCHEDULER_H
+#define BITCOIN_NET_RECONCILIATION_SCHEDULER_H
+#include <net.h>
+#include <primitives/txid.h>
+#include <random.h>
+#include <util/hasher.h>
+#include <algorithm>
+#include <chrono>
+#include <mutex>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+namespace txrelay {
+/** Bounded readiness hints, never delivery acknowledgments or a claim that a
+ * truncated live window covers the whole pool. Caller supplies monotonic time.
+ * Notification threads record changes; the message thread initiates passes. */
+class ReconciliationScheduler {
+public:
+    using Clock = std::chrono::microseconds;
+    struct Ticket { uint64_t generation; Clock cutoff; bool fairness; };
+private:
+    struct Change { uint64_t generation; Clock time; };
+    const size_t m_target;
+    const Clock m_max_wait, m_cooldown, m_margin;
+    std::mutex m_mutex;
+    std::unordered_map<TxId, Change, SaltedTxIdHasher> m_changes;
+    std::optional<std::pair<TxId, Change>> m_overflow;
+    uint64_t m_generation{0};
+    bool m_started{false}, m_active{false}, m_incoming{false};
+    std::optional<uint64_t> m_incoming_generation;
+    Clock m_last_pass{0}, m_last_fair{0}, m_next_attempt{0};
+    NodeId m_last_fair_peer{-1};
+    uint256 m_observed_root, m_observed_base;
+    size_t m_observed_repeats{0};
+public:
+    ReconciliationScheduler(size_t target, Clock max_wait, Clock cooldown,
+                            Clock margin)
+        : m_target(std::clamp<size_t>(target, 1, 8192)), m_max_wait(max_wait),
+          m_cooldown(cooldown), m_margin(margin) {}
+    void Changed(const TxId &id, Clock now) {
+        std::lock_guard lock(m_mutex);
+        ++m_generation;
+        m_observed_repeats = 0;
+        auto it = m_changes.find(id);
+        if (it != m_changes.end()) it->second = {m_generation, now};
+        else if (m_changes.size() < m_target)
+            m_changes.emplace(id, Change{m_generation, now});
+        else m_overflow = std::make_pair(id, Change{m_generation, now});
+    }
+    bool Incoming(bool mismatch = false) {
+        std::lock_guard lock(m_mutex);
+        if (mismatch) m_observed_repeats = 0;
+        // At most one scheduling hint per local membership generation. A
+        // stable node cannot ping-pong fresh passes from identical requests.
+        if (m_incoming_generation == m_generation) return false;
+        m_incoming_generation = m_generation;
+        m_incoming = true;
+        m_observed_repeats = 0; // unsealed observation, never a checkpoint
+        return true;
+    }
+    std::optional<Ticket> Begin(Clock now) {
+        std::lock_guard lock(m_mutex);
+        if (m_max_wait <= Clock{0} || m_active || now < m_next_attempt)
+            return std::nullopt;
+        if (!m_started) {
+            m_started = true;
+            m_last_pass = m_last_fair = now;
+        }
+        const auto cutoff = now - m_margin;
+        size_t eligible{0};
+        for (const auto &[id, change] : m_changes)
+            eligible += change.time <= cutoff;
+        if (eligible < m_target && now - m_last_pass < m_max_wait)
+            return std::nullopt;
+        m_active = true;
+        if (m_incoming) m_observed_repeats = 0;
+        return Ticket{m_generation, cutoff, now - m_last_fair >= m_max_wait};
+    }
+    /** Exception/cancellation path: no allocation and no obligation retired. */
+    void Cancel(Clock now) {
+        std::lock_guard lock(m_mutex);
+        m_active = false;
+        m_next_attempt = now + m_cooldown;
+    }
+    void Complete(const Ticket &ticket, Clock now, bool sent) {
+        std::lock_guard lock(m_mutex);
+        m_active = false;
+        m_next_attempt = now + m_cooldown;
+        if (!sent) return; // retain readiness when no peer/slot was available
+        for (auto it = m_changes.begin(); it != m_changes.end();) {
+            if (it->second.generation <= ticket.generation &&
+                it->second.time <= ticket.cutoff) it = m_changes.erase(it);
+            else ++it;
+        }
+        if (m_overflow && m_overflow->second.generation > ticket.generation &&
+            m_changes.size() < m_target) {
+            m_changes.insert_or_assign(m_overflow->first, m_overflow->second);
+        }
+        if (m_overflow && m_overflow->second.generation <= ticket.generation)
+            m_overflow.reset();
+        m_last_pass = now;
+        if (ticket.fairness) m_last_fair = now;
+        m_incoming = false;
+    }
+    /** Fresh randomness; separately paced rotation prevents starvation even
+     * when continuous count-triggered passes keep resetting the idle timer. */
+    std::vector<NodeId> Select(std::vector<NodeId> peers, size_t count,
+                               bool fairness, FastRandomContext &rng) {
+        if (peers.empty() || count == 0) return {};
+        count = std::min(count, peers.size());
+        std::lock_guard lock(m_mutex);
+        std::optional<NodeId> reserved;
+        if (fairness) {
+            std::sort(peers.begin(), peers.end());
+            auto it = std::upper_bound(peers.begin(), peers.end(), m_last_fair_peer);
+            if (it == peers.end()) it = peers.begin();
+            reserved = *it;
+            m_last_fair_peer = *it;
+            peers.erase(it);
+        }
+        Shuffle(peers.begin(), peers.end(), rng);
+        peers.resize(count - (reserved ? 1 : 0));
+        if (reserved) peers.push_back(*reserved);
+        return peers;
+    }
+    /** Observation of our captures only: existing wire has no fresh-pass ACK.
+     * Never seals a layer, stops discovery, or establishes peer consensus. */
+    size_t ObserveLocalRoot(const uint256 &root, const uint256 &base,
+                            const Ticket &ticket) {
+        std::lock_guard lock(m_mutex);
+        if (ticket.generation != m_generation) return m_observed_repeats = 0;
+        if (m_observed_repeats && root == m_observed_root && base == m_observed_base)
+            ++m_observed_repeats;
+        else m_observed_repeats = 1;
+        m_observed_root = root;
+        m_observed_base = base;
+        return m_observed_repeats;
+    }
+};
+} // namespace txrelay
+#endif
