+BOOST_AUTO_TEST_CASE(reconciliation_permissionless_count_and_incoming_coalescing) {
+    LOCK(NetEventsInterface::g_msgproc_mutex);
+    auto &chainman{static_cast<TestChainstateManager &>(*m_node.chainman)};
+    chainman.JumpOutOfIbd();
+    MockTick clock{8'000'000ms};
+    PeerManager::Options opts;
+    opts.txrecon_target = 3;
+    opts.txrecon_interval = 1s;
+    opts.txrecon_margin = 0ms;
+    // RelayHarness constructs PeerManager with avalanche=nullptr and no proofs.
+    RelayHarness h{m_node, opts};
+    std::atomic<bool> interrupt{false};
+    std::vector<CNode *> peers;
+    for (int i = 0; i < 3; ++i) {
+        auto &peer{h.AddPeer()};
+        DataStream offer{};
+        offer << txrelay::SENDINVSHORT_VERSION
+              << uint64_t(txrelay::TXRELAY_INVSHORT |
+                          (i < 2 ? txrelay::TXRELAY_RECON : 0));
+        h.peerman->ProcessMessage(h.config, peer, NetMsgType::SENDINVSHORT,
+                                  offer, 0us, interrupt);
+        peers.push_back(&peer);
+    }
+    h.SendAll(); // arm monotonic max-wait; no initial summary
+    FastRandomContext rng{true};
+    for (int i = 0; i < 3; ++i) {
+        auto tx{MakeTx(rng)};
+        AddToMempool(m_node, tx);
+        // This isolated harness does not register validation callbacks.
+        h.peerman->TransactionAddedToMempool(tx, nullptr, uint64_t(i));
+        h.peerman->RelayTransaction(tx->GetId());
+    }
+    SetMockTime(GetTime<std::chrono::seconds>() + 1s);
+    clock.Set(8'000'010ms); // threshold beats the one-second maximum wait
+    auto sent{h.SendAll()};
+    BOOST_REQUIRE_EQUAL(sent[peers[0]->GetId()].summaries.size(), 1U);
+    BOOST_REQUIRE_EQUAL(sent[peers[1]->GetId()].summaries.size(), 1U);
+    BOOST_CHECK(sent[peers[2]->GetId()].summaries.empty());
+    const auto summary{sent[peers[0]->GetId()].summaries.front()};
+    uint64_t represented{0};
+    for (const auto &bucket : summary.buckets) represented += bucket.count;
+    BOOST_CHECK_EQUAL(represented, 3U);
+    // Repeated valid incoming summaries are serviced, but cannot recursively
+    // turn one inbound frame into a new outbound subset on every call.
+    for (int i = 0; i < 16; ++i) {
+        DataStream message{};
+        message << summary;
+        h.peerman->ProcessMessage(h.config, *peers[0], NetMsgType::MERKLIXSYNC,
+                                  message, std::chrono::microseconds{i}, interrupt);
+    }
+    for (const auto &[id, messages] : h.SendAll())
+        BOOST_CHECK(messages.summaries.empty());
+    // Losing a peer cannot prevent the other capable peer's timeout discovery.
+    peers[0]->fDisconnect = true;
+    clock.Set(8'001'010ms);
+    auto timeout{h.SendAll()};
+    BOOST_CHECK(timeout[peers[0]->GetId()].summaries.empty());
+    BOOST_REQUIRE_EQUAL(timeout[peers[1]->GetId()].summaries.size(), 1U);
+    BOOST_CHECK(timeout[peers[2]->GetId()].summaries.empty());
+    SetMockTime(0);
+    chainman.ResetIbd();
+}
