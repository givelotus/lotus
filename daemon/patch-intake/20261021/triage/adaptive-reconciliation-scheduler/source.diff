+    const TxId a{rng.rand256()}, b{rng.rand256()}, c{rng.rand256()}, d{rng.rand256()};
+    BOOST_CHECK(!scheduler.Begin(0ms));
+    scheduler.Changed(a, 1ms);
+    scheduler.Changed(a, 1ms); // distinct identity, not notification count
+    scheduler.Changed(b, 1ms);
+    BOOST_CHECK(!scheduler.Begin(6ms));
+    scheduler.Changed(c, 6ms);
+    BOOST_CHECK(!scheduler.Begin(10ms)); // propagation margin
+    auto pass = scheduler.Begin(11ms);
+    BOOST_REQUIRE(pass);
+    BOOST_CHECK(!scheduler.Begin(12ms)); // one initiation in flight
+    scheduler.Changed(d, 12ms); // arrives while the bounded set is saturated
+    scheduler.Complete(*pass, 12ms, true);
+    BOOST_CHECK(!scheduler.Begin(21ms)); // node cooldown
+    BOOST_CHECK(!scheduler.Begin(22ms)); // only a later change remains
+    auto timeout = scheduler.Begin(112ms);
+    BOOST_REQUIRE(timeout);
+    scheduler.Complete(*timeout, 112ms, false); // no slot: obligation retained
+    BOOST_CHECK(!scheduler.Begin(121ms));
+    auto retry = scheduler.Begin(122ms);
+    BOOST_REQUIRE(retry);
+    scheduler.Complete(*retry, 122ms, true);
+}
