+BOOST_AUTO_TEST_CASE(reconciliation_cancel_preserves_readiness) {
+    txrelay::ReconciliationScheduler scheduler{1, 1s, 10ms, 0ms};
+    FastRandomContext rng{true};
+    scheduler.Changed(TxId{rng.rand256()}, 0ms);
+    auto pass = scheduler.Begin(0ms);
+    BOOST_REQUIRE(pass);
+    scheduler.Cancel(1ms); // the production RAII guard uses this on exceptions
+    BOOST_CHECK(!scheduler.Begin(10ms));
+    auto retry = scheduler.Begin(11ms);
+    BOOST_REQUIRE(retry);
+    BOOST_CHECK_EQUAL(retry->generation, pass->generation);
+    scheduler.Complete(*retry, 11ms, true);
+}
