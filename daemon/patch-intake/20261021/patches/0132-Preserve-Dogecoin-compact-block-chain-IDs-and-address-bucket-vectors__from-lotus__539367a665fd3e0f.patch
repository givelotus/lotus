From 4ab09d6ed4f3aabdb338e2f44be7ac6347e74b7b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:41:26 -0700
Subject: [PATCH] Preserve Dogecoin compact-block chain IDs and address-bucket
 vectors

Apply final pinned Doged fixture deltas lost in historical conflict context: compact blocks need chain ID 0x62, and port22556 changes deterministic tried-bucket placement to77/169. Retain newer upstream compact-block coverage and APIs.

diff --git a/src/test/addrman_tests.cpp b/src/test/addrman_tests.cpp
index 958cc59c054f9abbbdda0d496e4805dc80a7175b..f25740139b1f0488f90f49b80fb4f09b304c39d2 100644
--- a/src/test/addrman_tests.cpp
+++ b/src/test/addrman_tests.cpp
@@ -463,7 +463,7 @@ BOOST_AUTO_TEST_CASE(caddrinfo_get_tried_bucket_legacy) {
     // use /16
     std::vector<bool> asmap;
 
-    BOOST_CHECK_EQUAL(info1.GetTriedBucket(nKey1, asmap), 40);
+    BOOST_CHECK_EQUAL(info1.GetTriedBucket(nKey1, asmap), 77);
 
     // Test: Make sure key actually randomizes bucket placement. A fail on
     //  this test could be a security issue.
@@ -599,7 +599,7 @@ BOOST_AUTO_TEST_CASE(caddrinfo_get_tried_bucket) {
 
     std::vector<bool> asmap = FromBytes(asmap_raw, sizeof(asmap_raw) * 8);
 
-    BOOST_CHECK_EQUAL(info1.GetTriedBucket(nKey1, asmap), 236);
+    BOOST_CHECK_EQUAL(info1.GetTriedBucket(nKey1, asmap), 169);
 
     // Test: Make sure key actually randomizes bucket placement. A fail on
     //  this test could be a security issue.
diff --git a/src/test/blockencodings_tests.cpp b/src/test/blockencodings_tests.cpp
index c2910631f424574ac43068726c54417700f39789..6b85c63373cbb89de2e64e2ba48c8654d943c828 100644
--- a/src/test/blockencodings_tests.cpp
+++ b/src/test/blockencodings_tests.cpp
@@ -40,7 +40,7 @@ static CBlock BuildBlockTestCase(FastRandomContext &ctx) {
 
     block.vtx.resize(3);
     block.vtx[0] = MakeTransactionRef(tx);
-    block.nVersion = 42;
+    block.nVersion = 0x620042;
     block.hashPrevBlock = BlockHash(ctx.rand256());
     block.nBits = 0x207fffff;
 
@@ -377,7 +377,7 @@ BOOST_AUTO_TEST_CASE(EmptyBlockRoundTripTest) {
     auto rand_ctx(FastRandomContext(uint256{42}));
     block.vtx.resize(1);
     block.vtx[0] = MakeTransactionRef(std::move(coinbase));
-    block.nVersion = 42;
+    block.nVersion = 0x620042;
     block.hashPrevBlock = BlockHash(rand_ctx.rand256());
     block.nBits = 0x207fffff;
 
