+        return idx;
+    };
+    auto import_smt_local =
+        [&](const std::shared_ptr<const SmtNode> &smt_node) -> uint32_t {
+        if (!smt_node) {
+            return kNullIdx;
+        }
+        UtxoOverlayNode node{};
+        node.digest = smt_node->digest;
+        node.count = static_cast<uint32_t>(smt_node->count);
+        node.key = smt_node->key;
