+        }
+        const UtxoOverlayNode &src = get_node(node_idx);
+        UtxoOverlayNode copy{};
+        copy.child[0] = src.child[0];
+        copy.child[1] = src.child[1];
+        copy.base_child[1 - bit] = src.base_child[1 - bit];
+        copy.child[bit] = new_child;
