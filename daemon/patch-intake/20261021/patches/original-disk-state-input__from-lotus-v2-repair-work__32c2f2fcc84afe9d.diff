+Node ParseNodeFast(BytesView bytes, const Path &path, const Summary &expected) {
+    Require(bytes.size() <= MAX_COIN_BYTES + 41, "node size");
+    Reader r{bytes};
+    const Summary stored = GetSummary(r);
+    Require(stored == expected && stored.kind != 0, "node/head disagreement");
+    Node node;
+    node.summary = stored;
+    if (stored.kind == 1) {
+        const BytesView cb = r.BlobView(MAX_COIN_BYTES);
+        Require(cb.size() >= 37, "coin size");
+        Reader cr{cb};
+        node.coin_outpoint.tx_id = cr.Digest();
+        node.coin_outpoint.index = static_cast<uint32_t>(cr.Int(4));
+        node.coin_bytes.assign(cb.data(), cb.size());
+        node.coin_outpoint_key = OutpointKey(node.coin_outpoint);
+        Require(path.Contains(node.coin_outpoint_key), "leaf path mismatch");
+    } else {
+        const Summary left = GetSummary(r);
+        const Summary right = GetSummary(r);
+        Require(path.depth < 256, "branch depth");
+        Require((left.kind != 0 || right.kind != 0) &&
+                !(left.kind == 0 && right.kind == 1) &&
+                !(left.kind == 1 && right.kind == 0),
+                "uncollapsed branch");
+        node.children = {left, right};
+    }
+    r.End();
+    return node;
+}
