+static bool ClientUsedTLS(const BeastRequest &req,
+                          const HTTPConnectionInfo &conn) {
+    if (conn.is_tls || conn.proxy_tls) {
+        return true;
+    }
+    if (!conn.from_trusted_proxy) {
+        return false;
+    }
+    std::string last;
