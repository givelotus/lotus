From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] crypto: supply SHA256 tagged-hash primitives

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Fast-path single-input CheckRegularTransaction duplicate-input checks,
coalesce BlockUndo disk writes, and optimize bulk mempool clear.

Original-Commit: a4ea86865414bbf4f98512bbd4460e2a42897acc
Original-Patch: ecash/020
Split-Concern: hash

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/lotus_v2/tagged_hash.cpp | 75 ++++++++++++++++++++++++++++++++++++
 src/lotus_v2/tagged_hash.h   | 41 ++++++++++++++++++++
 2 files changed, 116 insertions(+)
 create mode 100644 src/lotus_v2/tagged_hash.cpp
 create mode 100644 src/lotus_v2/tagged_hash.h

diff --git a/src/lotus_v2/tagged_hash.cpp b/src/lotus_v2/tagged_hash.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bfaae698c4daff274b6236bac5107bab6529c0c3
--- /dev/null
+++ b/src/lotus_v2/tagged_hash.cpp
@@ -0,0 +1,75 @@
+#include "tagged_hash.h"
+
+#include <crypto/sha256.h>
+
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <string_view>
+
+namespace lotus::v2 {
+namespace {
+constexpr std::string_view TagView(HashDomain domain) noexcept {
+    switch (domain) {
+    case HashDomain::HeaderBody: return "Lotus/v2/header/body";
+    case HashDomain::HeaderWork: return "Lotus/v2/header/work";
+    case HashDomain::BlockId: return "Lotus/v2/blockid";
+    case HashDomain::Branch: return "Lotus/v2/branch";
+    case HashDomain::InputCore: return "Lotus/v2/inputcore";
+    case HashDomain::InputFull: return "Lotus/v2/inputfull";
+    case HashDomain::OwnInput: return "Lotus/v2/owninput";
+    case HashDomain::Sighash: return "Lotus/v2/sighash";
+    case HashDomain::Output: return "Lotus/v2/output";
+    case HashDomain::CoinEntry: return "Lotus/v2/coinentry";
+    case HashDomain::MerkleIndex: return "Lotus/v2/merkleidx";
+    case HashDomain::TxId: return "Lotus/v2/txid";
+    case HashDomain::TxHash: return "Lotus/v2/txhash";
+    case HashDomain::TxRoot: return "Lotus/v2/txroot";
+    case HashDomain::OutpointKey: return "Lotus/v2/outpointkey";
+    case HashDomain::Utxo: return "Lotus/v2/utxo";
+    case HashDomain::State: return "Lotus/v2/state";
+    }
+    std::abort();
+}
+
+constexpr size_t kNumDomains = static_cast<size_t>(HashDomain::State) + 1;
+
+CSHA256 MakeTagMidstate(HashDomain domain) {
+    const std::string_view tag = TagView(domain);
+    uint8_t tag_hash[CSHA256::OUTPUT_SIZE];
+    CSHA256()
+        .Write(reinterpret_cast<const uint8_t *>(tag.data()), tag.size())
+        .Finalize(tag_hash);
+    CSHA256 hasher;
+    hasher.Write(tag_hash, CSHA256::OUTPUT_SIZE);
+    hasher.Write(tag_hash, CSHA256::OUTPUT_SIZE);
+    return hasher;
+}
+
+const std::array<CSHA256, kNumDomains> &GetTagMidstates() {
+    static const std::array<CSHA256, kNumDomains> kMidstates = []() {
+        std::array<CSHA256, kNumDomains> arr{};
+        for (size_t i = 0; i < kNumDomains; ++i) {
+            arr[i] = MakeTagMidstate(static_cast<HashDomain>(i));
+        }
+        return arr;
+    }();
+    return kMidstates;
+}
+} // namespace
+
+Hash TaggedHash(HashDomain domain, std::span<const uint8_t> payload) {
+    const size_t idx = static_cast<size_t>(domain);
+    if (idx >= kNumDomains) {
+        std::abort();
+    }
+    CSHA256 hasher = GetTagMidstates()[idx];
+    if (!payload.empty()) {
+        hasher.Write(payload.data(), payload.size());
+    }
+    Hash result;
+    hasher.Finalize(result.data());
+    return result;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/tagged_hash.h b/src/lotus_v2/tagged_hash.h
new file mode 100644
index 0000000000000000000000000000000000000000..55eacb731cbfde4c1c569ec9abdc7540c98ff1cb
--- /dev/null
+++ b/src/lotus_v2/tagged_hash.h
@@ -0,0 +1,41 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_TAGGED_HASH_H
+#define LOTUS_V2_TAGGED_HASH_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace lotus::v2 {
+
+using Hash = std::array<uint8_t, 32>;
+using ChainId = Hash;
+using Bytes32 = Hash;
+
+enum class HashDomain {
+    HeaderBody,
+    HeaderWork,
+    BlockId,
+    Branch,
+    InputCore,
+    InputFull,
+    OwnInput,
+    Sighash,
+    Output,
+    CoinEntry,
+    MerkleIndex,
+    TxId,
+    TxHash,
+    TxRoot,
+    OutpointKey,
+    Utxo,
+    State,
+};
+
+// Hardware-accelerated BIP-340 style tagged SHA-256:
+// SHA256(SHA256(tag) || SHA256(tag) || payload).
+Hash TaggedHash(HashDomain domain, std::span<const uint8_t> payload);
+
+} // namespace lotus::v2
+#endif
