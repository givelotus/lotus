From 697ed0e47fb0ec2ac467e8514fa329b6493e0d6c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] mempool: wire CTxMemPool speculative Merklix overlay

Hook MerklixOverlayManager into CTxMemPool::addUnchecked, removeUnchecked,
and block connect reset.

Original-Commit: 2283e3f138ebb4a05ae9c52555f037f031e23bb3
Original-Patch: ecash/007
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Repair: Complete the shared eCash mempool overlay integration and its native add/remove/freeze/reanchor/clear regression. Keep eager incremental overlay maintenance here; assign premature filter, RCU/deferred mutation, parent-link, cached-size and mining-reuse hunks to their purposeful feature owners in purpose-redistribution.json. Preserve eCash script and block validity checks.

diff --git a/src/test/mempool_overlay_tests.cpp b/src/test/mempool_overlay_tests.cpp
index fb8629106f31c70ff494d059121cec221dd23129..732c52cd8386754d3d35970169cf3565ec217a3e 100644
--- a/src/test/mempool_overlay_tests.cpp
+++ b/src/test/mempool_overlay_tests.cpp
@@ -241,4 +241,36 @@ BOOST_AUTO_TEST_CASE(positional_merkle_root_and_syndromes) {
     BOOST_CHECK(spec_a.GetUtxoRootDigest() == eager_layer.GetUtxoRootDigest());
 }
 
+BOOST_AUTO_TEST_CASE(mempool_overlay_tracks_admission_removal_and_tip) {
+    auto &pool = *Assert(m_node.mempool);
+    LOCK2(cs_main, pool.cs);
+    const BlockHash tip(uint256S("11"));
+    pool.ConnectBlockReset(tip, 100, 1000);
+    auto &manager = pool.GetMerklixOverlay();
+    lotus::v2::Hash tip_id{};
+    std::copy(tip.begin(), tip.end(), tip_id.begin());
+    BOOST_CHECK(manager.IsAnchoredAt(tip_id, 100, 1000));
+    const auto parent_tx = MakeTestSpendTx(COutPoint(TxId(uint256S("22")), 0),
+                                          1, 10000 * SATOSHI);
+    const auto child_tx = MakeTestSpendTx(COutPoint(parent_tx->GetId(), 0),
+                                         2, 9000 * SATOSHI);
+    TestMemPoolEntryHelper entry;
+    pool.addUnchecked(entry.Fee(500 * SATOSHI).FromTx(parent_tx));
+    pool.addUnchecked(entry.Fee(600 * SATOSHI).FromTx(child_tx));
+    BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTxCount(), 2U);
+    BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTotalFeesSats(), 1100);
+    const auto frozen_root = pool.FreezeEpochBatch().GetSubtreeARoot();
+    pool.removeRecursive(*child_tx, MemPoolRemovalReason::CONFLICT);
+    BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTxCount(), 1U);
+    BOOST_REQUIRE_EQUAL(manager.GetFrozenEpochs().size(), 1U);
+    BOOST_CHECK(manager.GetFrozenEpochs().back().GetSubtreeARoot() == frozen_root);
+    const BlockHash next_tip(uint256S("33"));
+    pool.ConnectBlockReset(next_tip, 101, 1010);
+    BOOST_CHECK(manager.GetFrozenEpochs().empty());
+    BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTxCount(), 1U);
+    BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetHeight(), 101U);
+    pool.clear();
+    BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTxCount(), 0U);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
