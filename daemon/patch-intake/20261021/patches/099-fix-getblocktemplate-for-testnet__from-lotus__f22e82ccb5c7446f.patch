From 4e99670f2c61c65311ddf4d315b250fa2f6be609 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Mon, 3 May 2021 21:36:18 -0500
Subject: [PATCH] Fix getblocktemplate for testnet (#170)

This fixes a bug where when the testnet resets the nBits to 0x1c100000, the coinbase outputs would remain unchanged, resulting in invalid blocks.

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 3ea92b41a8e559bd8d2d2b7c4a287ce77b8cadcf
Recorded-replay-commit: 87b656ec63b267bff38c347f72c38d4dba846e09

diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index 5093349438..dd00dbbcd0 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -55,6 +55,11 @@ int64_t UpdateTime(CBlockHeader *pblock, const CChainParams &chainParams,
     return nNewTime - nOldTime;
 }
 
+Amount GetBlockRewardFromFees(Amount nFees) {
+    // 50% of fees get burned.
+    return nFees / 2;
+}
+
 void ApplyArgsManOptions(const ArgsManager &args,
                          BlockAssembler::Options &options) {
     options.fPrintPriority =
@@ -173,8 +178,7 @@ BlockAssembler::CreateNewBlock(const CScript &scriptPubKeyIn) {
     }
 
     const auto time_1{SteadyClock::now()};
-    // 50% of fees get burned.
-    const Amount amountFeeReward = blockFitter.nFees / 2;
+    const Amount amountFeeReward = GetBlockRewardFromFees(blockFitter.nFees);
 
     m_last_block_num_txs = blockFitter.nBlockTx;
     m_last_block_size = blockFitter.nBlockSize;
diff --git a/src/node/miner.h b/src/node/miner.h
index b1c03a31e0..9b50e7db19 100644
--- a/src/node/miner.h
+++ b/src/node/miner.h
@@ -36,6 +36,12 @@ class Processor;
 namespace node {
 static const bool DEFAULT_PRINTPRIORITY = false;
 
+/**
+ * Calculate the additional block reward in the coinbase from fees.
+ * Currenty, 50% of fees are burned.
+ */
+Amount GetBlockRewardFromFees(Amount nFees);
+
 struct CBlockTemplateEntry {
     CTransactionRef tx;
     Amount fees;
diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 1c46dcf010..f36ae686d8 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -1079,7 +1079,7 @@ static RPCHelpMan getblocktemplate() {
             // pointer for convenience
             CBlock *pblock = &pblocktemplate->block;
 
-            // Update nTime
+            // Update nTime (can update nBits on testnet)
             int64_t adjustedTime =
                 TicksSinceEpoch<std::chrono::seconds>(GetAdjustedTime());
             UpdateTime(pblock, chainparams, pindexPrev, adjustedTime);
@@ -1088,7 +1088,12 @@ static RPCHelpMan getblocktemplate() {
             UniValue aCaps(UniValue::VARR);
             aCaps.push_back("proposal");
 
-            Amount coinbasevalue = Amount::zero();
+            // CreateNewBlock stores the total fees times -1 in entries[0].fees
+            Amount amountFeeReward =
+                node::GetBlockRewardFromFees(-1 * pblocktemplate->entries[0].fees);
+            // UpdateTime can update nBits, so we recompute the subsidy
+            Amount coinbasevalue =
+                amountFeeReward + GetBlockSubsidy(pblock->nBits, consensusParams);
 
             UniValue transactions(UniValue::VARR);
             transactions.reserve(pblock->vtx.size());
@@ -1099,11 +1104,6 @@ static RPCHelpMan getblocktemplate() {
 
                 if (tx.IsCoinBase()) {
                     index_in_template++;
-
-                    for (const auto &o : pblock->vtx[0]->vout) {
-                        coinbasevalue += o.nValue;
-                    }
-
                     continue;
                 }
 
