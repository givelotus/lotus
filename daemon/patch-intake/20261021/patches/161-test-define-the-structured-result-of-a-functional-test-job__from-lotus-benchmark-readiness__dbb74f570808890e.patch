+++ b/test/functional/README-runner-output.md
@@ -0,0 +1,29 @@
+# Functional test runner: structured results
+
+`test_runner.py` keeps one result per test job (a test file, with its
+arguments). The result is defined by `JobResult` in
+`test_framework/results.py`; its JSON form carries `"schema": 1`. Fields may
+be added in a later schema version, but existing fields keep their meaning.
+
+| Field | Type | Meaning |
+|---|---|---|
+| `schema` | int | Version of this format (1) |
+| `name` | str | Display name, e.g. `wallet_basic.py` or `rpc_bind.py --ipv4` |
+| `file` | str | Test file, relative to `test/functional` |
+| `class_name` | str | Test class that ran |
+| `variant` | str | Variant name, empty for the default |
+| `settings` | object | Shared settings, e.g. `{"transport": "tcp"}` |
+| `status` | str | `passed`, `failed`, `skipped`, `timeout` or `crashed` |
+| `exit_code` | int or null | The test's exit code (null if it never returned one) |
+| `start_time` | float | Start, in seconds since the epoch |
+| `duration` | float | Seconds |
+| `phases` | list | `{"name", "duration"}` per phase: `chain_init`, `network_setup`, `body`, `final_stop`, `cleanup` |
+| `skip_reason` | str or null | Why the test skipped |
+| `failure` | object or null | `{"type", "message", "traceback"}`; `type` is the exception class, or `stderr` when a test passed but wrote to stderr |
+| `tmpdir` | str | The test's directory, kept when it fails |
+| `framework_log` | str | Path of its `test_framework.log` |
+| `node_logs` | list | Paths of the nodes' `debug.log` |
+| `stdout_tail`, `stderr_tail` | str | The last 200 lines of the test's stdout and stderr |
+| `stderr_nonempty` | bool | Whether the test wrote anything to stderr |
+
+`passed` and `skipped` count as success; any other status fails the run.
diff --git a/test/functional/test_framework/results.py b/test/functional/test_framework/results.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb4e6c6b3f91fd517b69d3c38012e04107c30c25
--- /dev/null
+++ b/test/functional/test_framework/results.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""The result of running one functional test job, as the test runner reports it.
+
+Workers send a JobResult to the runner; reporters (console, JSON lines,
+JUnit) render it. The JSON form is versioned by SCHEMA_VERSION and documented
+in test/functional/README-runner-output.md.
+"""
+
+import dataclasses
+import json
+import unittest
+from typing import Any, Dict, List, Optional
+
+SCHEMA_VERSION = 1
+
+PASSED = "passed"
+FAILED = "failed"
+SKIPPED = "skipped"
+TIMEOUT = "timeout"
+CRASHED = "crashed"
+STATUSES = (PASSED, FAILED, SKIPPED, TIMEOUT, CRASHED)
+
+# Lines of captured output kept in a result (the full output stays on disk)
+TAIL_LINES = 200
+
+
+def tail(text: str, lines: int = TAIL_LINES) -> str:
+    return "\n".join(text.splitlines()[-lines:])
+
+
+@dataclasses.dataclass
+class JobResult:
+    # Display name, e.g. "rpc_bind.py[ipv4]" or "wallet_basic.py"
+    name: str
+    file: str
+    status: str
+    exit_code: Optional[int] = None
+    class_name: str = ""
+    variant: str = ""
+    settings: Dict[str, str] = dataclasses.field(default_factory=dict)
+    # Seconds since the epoch, and seconds
+    start_time: float = 0.0
+    duration: float = 0.0
+    phases: List[Dict[str, Any]] = dataclasses.field(default_factory=list)
+    skip_reason: Optional[str] = None
+    # {"type", "message", "traceback"}
+    failure: Optional[Dict[str, str]] = None
+    tmpdir: str = ""
+    framework_log: str = ""
+    node_logs: List[str] = dataclasses.field(default_factory=list)
+    stdout_tail: str = ""
+    stderr_tail: str = ""
+    stderr_nonempty: bool = False
+
+    def __post_init__(self):
+        assert self.status in STATUSES, self.status
+
+    @property
+    def was_successful(self) -> bool:
+        return self.status in (PASSED, SKIPPED)
+
+    def to_dict(self) -> Dict[str, Any]:
+        d = dataclasses.asdict(self)
+        d["schema"] = SCHEMA_VERSION
+        return d
+
+    def to_json(self) -> str:
+        return json.dumps(self.to_dict(), sort_keys=True)
+
+    @classmethod
+    def from_dict(cls, d: Dict[str, Any]) -> "JobResult":
+        fields = {f.name for f in dataclasses.fields(cls)}
+        return cls(**{k: v for k, v in d.items() if k in fields})
+
+
+class TestJobResult(unittest.TestCase):
+    def test_round_trip(self):
+        result = JobResult(
+            name="rpc_bind.py[ipv4]",
+            file="rpc_bind.py",
+            status=FAILED,
+            exit_code=1,
+            variant="ipv4",
+            failure={"type": "AssertionError", "message": "x", "traceback": "tb"},
+        )
+        d = json.loads(result.to_json())
+        self.assertEqual(d["schema"], SCHEMA_VERSION)
+        self.assertEqual(JobResult.from_dict(d), result)
+        self.assertFalse(result.was_successful)
+
+    def test_status_validated(self):
+        with self.assertRaises(AssertionError):
+            JobResult(name="x.py", file="x.py", status="weird")
+        for status in (PASSED, SKIPPED):
+            self.assertTrue(JobResult(name="x", file="x", status=status).was_successful)
+
+    def test_tail(self):
+        text = "\n".join(str(i) for i in range(500))
+        self.assertEqual(tail(text, 3), "497\n498\n499")
