+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace lotus::v2 {
+
+using Hash = std::array<uint8_t, 32>;
+using ChainId = Hash;
+using Bytes32 = Hash;
+
+enum class HashDomain {
+    HeaderBody,
+    HeaderWork,
+    BlockId,
+    Branch,
+    InputCore,
+    InputFull,
+    OwnInput,
+    Sighash,
