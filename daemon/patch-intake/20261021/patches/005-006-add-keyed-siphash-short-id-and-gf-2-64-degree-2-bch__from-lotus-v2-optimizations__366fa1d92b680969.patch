+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_SPARSE_STATE_H
+#define LOTUS_V2_SPARSE_STATE_H
+
+#include "output.h"
+#include "tagged_hash.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace lotus::v2 {
+
+constexpr size_t MAX_COIN_BYTES = 868;
+
+struct Outpoint {
+    Hash tx_id{};
+    uint32_t index{};
+    bool operator==(const Outpoint &) const = default;
+};
+
+struct OutpointLess {
+    bool operator()(const Outpoint &a, const Outpoint &b) const {
+        return a.tx_id != b.tx_id ? a.tx_id < b.tx_id : a.index < b.index;
+    }
+};
+
+struct Coin {
+    Outpoint outpoint;
+    Output output;
+    uint64_t creation_height{};
+    uint64_t creation_parent_mtp{};
+    bool coinbase{};
+};
+
+// Coin output grammar is checked by the P01 Output codec. Burn outputs reject.
+bool EncodeCoin(const Coin &coin, std::vector<uint8_t> &encoded);
+bool DecodeCoinBytes(std::span<const uint8_t> encoded, Coin &coin);
+Hash OutpointKey(const Outpoint &outpoint);
+Hash EmptyUtxoRoot();
+bool UtxoLeaf(const Coin &coin, Hash &out);
+bool UtxoNode(uint16_t depth, const Hash &left, const Hash &right, Hash &out);
+
+enum class ProofPresence : uint8_t { Empty = 0, Present = 1, OtherLeaf = 2 };
+struct CoinProof {
+    ProofPresence presence{};
+    std::optional<Coin> coin;
+    Hash bitmap{}; // Bit d marks a nonempty sibling at depth d.
+    std::vector<Hash> siblings; // Deepest sibling first.
+};
+
+// Typed proof verifier. Wire framing and consensus context are separate.
+bool VerifyCoinProof(const Outpoint &query, const CoinProof &proof,
+                     const Hash &expected_root);
+
+// Bounded scalar reference model, not a database or incremental production
+// index. Every operation recomputes its root from the complete coin set.
+class UtxoSet {
+public:
+    bool Insert(const Coin &coin); // Reject duplicate outpoint or occupied key.
+    bool Erase(const Outpoint &outpoint);
+    const Coin *Find(const Outpoint &outpoint) const;
+    Hash Root() const;
+    CoinProof Prove(const Outpoint &query) const;
+    size_t Size() const { return coins_.size(); }
+    const std::vector<Coin> &Coins() const { return coins_; }
+
+private:
+    std::vector<Coin> coins_;
+};
+
+struct MonetaryState {
+    uint64_t bootstrap_reserve{};
+    uint64_t tail_subsidy{};
+    Hash prev_work{}; // LE unsigned u256.
+    uint64_t ema_block_cost{};
+};
+std::array<uint8_t, 56> EncodeMonetaryState(const MonetaryState &state);
+MonetaryState DecodeMonetaryState(const std::vector<uint8_t> &wire);
+Hash StateRoot(const ChainId &chain_id, uint64_t height,
+               const Hash &utxo_root, const MonetaryState &state);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/tagged_hash.cpp b/src/lotus_v2/tagged_hash.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bfaae698c4daff274b6236bac5107bab6529c0c3
--- /dev/null
+++ b/src/lotus_v2/tagged_hash.cpp
@@ -0,0 +1,75 @@
+#include "tagged_hash.h"
+
+#include <crypto/sha256.h>
+
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <string_view>
+
+namespace lotus::v2 {
+namespace {
+constexpr std::string_view TagView(HashDomain domain) noexcept {
+    switch (domain) {
+    case HashDomain::HeaderBody: return "Lotus/v2/header/body";
+    case HashDomain::HeaderWork: return "Lotus/v2/header/work";
+    case HashDomain::BlockId: return "Lotus/v2/blockid";
+    case HashDomain::Branch: return "Lotus/v2/branch";
+    case HashDomain::InputCore: return "Lotus/v2/inputcore";
+    case HashDomain::InputFull: return "Lotus/v2/inputfull";
+    case HashDomain::OwnInput: return "Lotus/v2/owninput";
+    case HashDomain::Sighash: return "Lotus/v2/sighash";
+    case HashDomain::Output: return "Lotus/v2/output";
+    case HashDomain::CoinEntry: return "Lotus/v2/coinentry";
+    case HashDomain::MerkleIndex: return "Lotus/v2/merkleidx";
+    case HashDomain::TxId: return "Lotus/v2/txid";
+    case HashDomain::TxHash: return "Lotus/v2/txhash";
+    case HashDomain::TxRoot: return "Lotus/v2/txroot";
+    case HashDomain::OutpointKey: return "Lotus/v2/outpointkey";
+    case HashDomain::Utxo: return "Lotus/v2/utxo";
+    case HashDomain::State: return "Lotus/v2/state";
+    }
+    std::abort();
+}
+
+constexpr size_t kNumDomains = static_cast<size_t>(HashDomain::State) + 1;
+
+CSHA256 MakeTagMidstate(HashDomain domain) {
+    const std::string_view tag = TagView(domain);
+    uint8_t tag_hash[CSHA256::OUTPUT_SIZE];
+    CSHA256()
+        .Write(reinterpret_cast<const uint8_t *>(tag.data()), tag.size())
+        .Finalize(tag_hash);
+    CSHA256 hasher;
+    hasher.Write(tag_hash, CSHA256::OUTPUT_SIZE);
+    hasher.Write(tag_hash, CSHA256::OUTPUT_SIZE);
+    return hasher;
+}
+
+const std::array<CSHA256, kNumDomains> &GetTagMidstates() {
+    static const std::array<CSHA256, kNumDomains> kMidstates = []() {
+        std::array<CSHA256, kNumDomains> arr{};
+        for (size_t i = 0; i < kNumDomains; ++i) {
+            arr[i] = MakeTagMidstate(static_cast<HashDomain>(i));
+        }
+        return arr;
+    }();
+    return kMidstates;
+}
+} // namespace
+
+Hash TaggedHash(HashDomain domain, std::span<const uint8_t> payload) {
+    const size_t idx = static_cast<size_t>(domain);
+    if (idx >= kNumDomains) {
+        std::abort();
+    }
+    CSHA256 hasher = GetTagMidstates()[idx];
+    if (!payload.empty()) {
+        hasher.Write(payload.data(), payload.size());
+    }
+    Hash result;
+    hasher.Finalize(result.data());
+    return result;
+}
+
+} // namespace lotus::v2
