-bool BerkeleyBatch::HasKey(DataStream &&key) {
-    if (!pdb) {
-        return false;
-    }
-
-    SafeDbt datKey(key.data(), key.size());
-
-    int ret = pdb->exists(activeTxn, datKey, 0);
-    return ret == 0;
-}
