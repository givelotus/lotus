+
+Hash32 HexToSha256d(const std::string &hex) {
+    BOOST_REQUIRE_EQUAL(hex.size(), 64u);
+    Bytes be;
+    for (size_t i = 0; i < 64; i += 2) {
+        be.push_back(uint8_t(std::stoi(hex.substr(i, 2), nullptr, 16)));
+    }
+    // Sha256d::from_be_hex
+    return Hash32::FromReversed(be);
+}
