@@ -0,0 +1,52 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_AVALANCHE_H
+#define CHRONIK_NATIVE_AVALANCHE_H
+
+#include <cstdint>
+#include <string>
+
+/** Port of chronik-indexer avalanche.rs. */
+namespace chronik::native {
+
+/** The indexer's Avalanche state. */
+struct Avalanche {
+    /** Height of the highest finalized block. Default: -1 */
+    int32_t height = -1;
+
+    /**
+     * Mark the block height as the highest finalized height in the indexer.
+     * Throws ChronikError (DecreasingFinalizedHeight) if `height` is below
+     * the current finalized height.
+     */
+    void FinalizeBlock(int32_t height);
+
+    /**
+     * Disconnect the block, may decrease the highest finalized height. The
+     * disconnected block must either not be finalized, or be the last
+     * finalized block; otherwise the indexer is out of sync with the node and
+     * this throws ChronikError (DisconnectBelowLastFinalizedHeight).
+     */
+    void DisconnectBlock(int32_t height);
+
+    /** Whether the given block height has been finalized by Avalanche. */
+    bool IsFinalHeight(int32_t block_height) const {
+        return block_height <= height;
+    }
+
+    bool operator==(const Avalanche &) const = default;
+};
+
+/** AvalancheError::DecreasingFinalizedHeight message */
+std::string AvalancheDecreasingFinalizedHeightMessage(int32_t indexer_height,
+                                                      int32_t next_height);
+/** AvalancheError::DisconnectBelowLastFinalizedHeight message */
+std::string
+AvalancheDisconnectBelowLastFinalizedHeightMessage(int32_t indexer_height,
+                                                   int32_t disconnected_height);
+
+} // namespace chronik::native
+
+#endif // CHRONIK_NATIVE_AVALANCHE_H
diff --git a/chronik/native/include/chronik/native/host.h b/chronik/native/include/chronik/native/host.h
new file mode 100644
index 0000000000000000000000000000000000000000..bdb3e1254919f7c9e78bf6404b243975e8913aee
--- /dev/null
+++ b/chronik/native/include/chronik/native/host.h
@@ -0,0 +1,123 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_HOST_H
+#define CHRONIK_NATIVE_HOST_H
+
+#include <chronik/native/types.h>
+
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace chronik::native {
+
+/** error = "<TransactionError>: <msg>" */
+struct BroadcastResult {
+    bool ok{};
+    TxId txid;
+    std::string error;
+};
+struct FeeRateInfo {
+    int64_t sats_per_kb{};
+    uint32_t vsize{};
+};
+/** Spent coins NOT resolved */
+struct DecodedTx {
+    bool ok{};
+    Tx tx;
+    std::string error;
+};
+enum class LogLevel { Info, InfoNoRateLimit, Debug };
+
+struct SpentCoinLookup {
+    std::vector<OutPoint> not_found;
+    std::vector<OutPoint> to_uncache;
+};
+
+/**
+ * Everything the indexer core needs from the node. Thread rules:
+ *  - Every method is callable from any Chronik thread (writer, query pool,
+ *    init).
+ *  - The core NEVER calls a Host method while holding its exclusive state
+ *    lock.
+ *  - Methods may take host locks (cs_main, mempool.cs) internally and must
+ *    not call back into Chronik.
+ * Errors: return values for expected misses; throw std::runtime_error for I/O
+ * corruption (the core maps it to FatalError on the writer, 500 on queries).
+ */
+class Host {
+public:
+    virtual ~Host() = default;
+    virtual const HostCapabilities &Capabilities() const = 0;
+
+    // ---- chain view (validated/active chainstate only) ----
+    virtual std::optional<BlockInfo> ActiveTip() const = 0;
+    /** Any branch */
+    virtual std::optional<BlockInfo> LookupBlock(const BlockHash &) const = 0;
+    virtual std::optional<BlockInfo> ActiveAtHeight(int32_t height) const = 0;
+    /** Last common active ancestor */
+    virtual std::optional<BlockInfo> FindFork(const BlockHash &) const = 0;
+    virtual BlockHash GenesisHash() const = 0;
+    /**
+     * Exact raw header bytes (80 ABC/BCHN/Core, 160 Lotus V1, 134 Lotus V2,
+     * variable Doged AuxPoW).
+     */
+    virtual Bytes RawHeader(const BlockInfo &) const = 0;
+    /** Batch form; returns a prefix if the range runs past the active tip. */
+    virtual std::vector<Bytes> RawHeadersByRange(int32_t start,
+                                                 int32_t end) const = 0;
+
+    // ---- immutable block storage (no cs_main needed by contract) ----
+    /**
+     * Load + decode block, spent coins from undo, per-tx data_pos/undo_pos
+     * (host computes first-tx offset: header size [+ vMetadata] +
+     * CompactSize(n_tx), witness-aware sizes).
+     */
+    virtual Block LoadBlock(const BlockInfo &) const = 0;
+    virtual Tx LoadTx(uint32_t file_num, uint32_t data_pos,
+                      uint32_t undo_pos) const = 0;
+    virtual Bytes LoadRawTx(uint32_t file_num, uint32_t data_pos) const = 0;
+
+    // ---- mempool / relay ----
+    /** Rejects trailing bytes */
+    virtual DecodedTx DecodeRawTx(std::span<const uint8_t> raw) const = 0;
+    /** Fill inputs[i].coin from CoinsTip+mempool view (broadcast checks). */
+    virtual SpentCoinLookup LookupSpentCoins(Tx &tx) const = 0;
+    virtual void UncacheCoins(std::span<const OutPoint>) const = 0;
+    virtual BroadcastResult Broadcast(std::span<const uint8_t> raw,
+                                      int64_t max_fee_sats) const = 0;
+    /** Host default max raw-tx fee for a tx of this size */
+    virtual int64_t CalcMaxFee(size_t tx_size) const = 0;
+    virtual std::optional<FeeRateInfo> MempoolFeeRate(const TxId &) const = 0;
+    virtual int64_t EstimateFeeRateSatsPerKb() const = 0;
+    virtual int64_t MinRelayFeeRateSatsPerKb() const = 0;
+    /** nullopt <=> capability absent (Core/BCHN); core reports false. */
+    virtual std::optional<bool>
+    IsFinalizedPreConsensus(const TxId &) const = 0;
+    /**
+     * Waits until every event already published by the node has been applied
+     * by Chronik.
+     */
+    virtual void SyncWithIndexer() const = 0;
+
+    // ---- process ----
+    virtual bool ShutdownRequested() const = 0;
+    virtual void FatalError(std::string_view log_msg,
+                            std::string_view user_msg) const = 0;
+    /**
+     * Info: rate-limited node log (Rust `log!`); InfoNoRateLimit: Rust
+     * `log_no_ratelimit!`; Debug: only with -debug=chronik (`log_chronik!`).
+     */
+    virtual void Log(LogLevel level, std::string_view msg) const = 0;
+    virtual std::string FormatFullVersion() const = 0;
+    /** scripthash, key hashing */
+    virtual void Sha256(std::span<const uint8_t>, uint8_t out[32]) const = 0;
+};
+
+} // namespace chronik::native
+
+#endif // CHRONIK_NATIVE_HOST_H
diff --git a/chronik/native/include/chronik/native/merkle.h b/chronik/native/include/chronik/native/merkle.h
new file mode 100644
index 0000000000000000000000000000000000000000..4da94095e87cffffd4e7b3f05c413e39a50c1d72
--- /dev/null
+++ b/chronik/native/include/chronik/native/merkle.h
@@ -0,0 +1,128 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_MERKLE_H
+#define CHRONIK_NATIVE_MERKLE_H
+
+#include <chronik/native/error.h>
+#include <chronik/native/types.h>
+
+#include <cstddef>
+#include <functional>
+#include <span>
+#include <utility>
+#include <vector>
+
+/**
+ * Port of chronik-indexer merkle.rs: merkle proof helpers for header
+ * checkpoints and in-block tx proofs.
+ *
+ * Hashes are Hash32 in internal (little-endian) order, i.e. Rust's
+ * Sha256d::as_le_bytes(). SHA-256d is a hook so the core never links node
+ * crypto.
+ */
+namespace chronik::native {
+
+/** Raw SHA-256d digest of `data` (Rust Sha256d::digest). */
+using Sha256dFn = std::function<Hash32(ByteView data)>;
+
+/** Build a Sha256dFn from a single SHA-256 (e.g. Host::Sha256). */
+Sha256dFn Sha256dFromSha256(std::function<void(ByteView, uint8_t[32])> sha256);
+
+/** Errors from MerkleTree operations (MerkleTreeError). */
+class MerkleTreeError : public ChronikError {
+public:
+    enum class Kind { BadArgs, HashCountMismatch };
+    /** "Invalid merkle tree arguments" */
+    static MerkleTreeError BadArgs();
+    /** "Expected {expected} hashes from provider, got {actual}" */
+    static MerkleTreeError HashCountMismatch(size_t expected, size_t actual);
+
+    Kind kind() const { return m_kind; }
+    size_t expected() const { return m_expected; }
+    size_t actual() const { return m_actual; }
+
+private:
+    MerkleTreeError(Kind kind, const std::string &msg, size_t expected,
+                    size_t actual)
+        : ChronikError(msg), m_kind(kind), m_expected(expected),
+          m_actual(actual) {}
+    Kind m_kind;
+    size_t m_expected;
+    size_t m_actual;
+};
+
+/**
+ * Length of a merkle branch for `num_hashes` hashes (ceil(log2)). Throws
+ * std::invalid_argument for 0 (Rust assert! panic).
+ */
+size_t CalcBranchLen(size_t num_hashes);
+
+/**
+ * Merkle root and branch for a full list of leaf hashes (Bitcoin-style:
+ * odd levels duplicate the last hash). Throws std::logic_error with
+ * "merkle_root_and_branch called with invalid args" for empty input or
+ * out-of-range index (Rust expect() panic).
+ */
+std::pair<Hash32, std::vector<Hash32>>
+MerkleRootAndBranch(const Sha256dFn &sha256d, std::span<const Hash32> hashes,
+                    size_t index);
+
+/**
+ * `get_hashes(start, count)` must return exactly `count` leaf hashes starting
+ * at height `start`; it may throw (propagated unchanged).
+ */
+using MerkleHashGetter =
+    std::function<std::vector<Hash32>(size_t start, size_t count)>;
+
+/**
+ * Cached mid-level merkle tree over the block-hash chain. Stores hashes at
+ * `depth_higher` above the leaves; proofs fetch only one leaf segment of size
+ * `1 << depth_higher` and combine it with the cache. Not synchronized (Rust
+ * keeps it in a Mutex).
+ */
+class MerkleTree {
+public:
+    explicit MerkleTree(Sha256dFn sha256d) : m_sha256d(std::move(sha256d)) {}
+
+    /** Whether the mid-level cache has been built. */
+    bool IsInitialized() const { return m_initialized; }
+    /** Number of leaf hashes the cache currently covers. */
+    size_t Length() const { return m_length; }
+
+    /**
+     * Truncate the cache to at most `length` leaf hashes (e.g. after a
+     * reorg), rounded down to a segment boundary; 0 clears the cache.
+     */
+    void Truncate(size_t length);
+
+    /**
+     * Merkle root of the first `length` block hashes and the branch proving
+     * the hash at `index` is included. Throws MerkleTreeError.
+     */
+    std::pair<Hash32, std::vector<Hash32>>
+    MerkleRootAndBranch(size_t length, size_t index,
+                        const MerkleHashGetter &get_hashes);
+
+private:
+    size_t SegmentLength() const { return size_t(1) << m_depth_higher; }
+    size_t LeafStart(size_t index) const {
+        return (index >> m_depth_higher) << m_depth_higher;
+    }
+    void Reset();
+    void InitializeWithHashes(std::span<const Hash32> hashes);
+    void ExtendTo(size_t length, const MerkleHashGetter &get_hashes);
+    std::vector<Hash32> LevelFor(size_t length,
+                                 const MerkleHashGetter &get_hashes) const;
+
+    Sha256dFn m_sha256d;
+    size_t m_length = 0;
+    size_t m_depth_higher = 0;
+    std::vector<Hash32> m_level;
+    bool m_initialized = false;
+};
+
+} // namespace chronik::native
+
+#endif // CHRONIK_NATIVE_MERKLE_H
diff --git a/chronik/native/include/chronik/native/pause.h b/chronik/native/include/chronik/native/pause.h
new file mode 100644
index 0000000000000000000000000000000000000000..24eb61374eae817e08788e16770b36b0e9f3e228
--- /dev/null
+++ b/chronik/native/include/chronik/native/pause.h
@@ -0,0 +1,114 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_PAUSE_H
+#define CHRONIK_NATIVE_PAUSE_H
+
+#include <chronik/native/host.h>
+
+#include <functional>
+#include <memory>
+#include <string_view>
+#include <utility>
+
+/**
+ * Port of chronik-indexer pause.rs (-chronikallowpause, /pause, /resume).
+ *
+ * Rust uses a tokio watch channel holding the latest PauseMsg (initially
+ * Resume). Pause::BlockIfPaused blocks the calling (event) thread while the
+ * latest value is Pause; it returns once the value becomes Resume or the
+ * PauseNotify is destroyed (Rust treats the closed channel as "resume").
+ * Like a watch channel, only the latest value counts: a Pause/Resume/Pause
+ * sequence that happens before the blocked thread wakes keeps it blocked.
+ */
+namespace chronik::native {
+
+namespace detail {
+struct PauseState;
+}
+
+/** "403: Pause is not allowed on this node; enable with -chronikallowpause" */
+inline constexpr std::string_view PAUSE_NOT_ALLOWED_MSG =
+    "403: Pause is not allowed on this node; enable with -chronikallowpause";
+/** PauseNotifyError::NotifyFailed (declared in Rust, never returned). */
+inline constexpr std::string_view PAUSE_NOTIFY_FAILED_MSG =
+    "500: Failed notifying pause";
+/**
+ * What Rust actually reports when the Pause side is gone: the tokio watch
+ * SendError, propagated through `?` (Display "channel closed").
+ */
+inline constexpr std::string_view PAUSE_CHANNEL_CLOSED_MSG = "channel closed";
+/** Logged (log!, Info) when blocking. */
+inline constexpr std::string_view PAUSE_BLOCKING_LOG_MSG =
+    "Chronik is paused, resume by calling /resume. To disallow pausing on "
+    "this node, remove the -chronikallowpause arg.\n";
+
+using PauseLogFn = std::function<void(LogLevel, std::string_view)>;
+
+class PauseNotify;
+
+/** Allows blocking the thread until resumed by PauseNotify. */
+class Pause {
+public:
+    /** Pause::new_pair */
+    static std::pair<Pause, PauseNotify> NewPair(bool is_pause_allowed);
+
+    Pause(Pause &&) noexcept;
+    Pause &operator=(Pause &&) noexcept;
+    Pause(const Pause &) = delete;
+    Pause &operator=(const Pause &) = delete;
+    ~Pause();
+
+    /**
+     * If we are paused, block until resumed by our corresponding PauseNotify
+     * (or until it is destroyed). Otherwise, do nothing.
+     */
+    void BlockIfPaused(const PauseLogFn &log = {}) const;
+
+    /** Whether the latest value is Pause (diagnostics/tests). */
+    bool IsPaused() const;
+
+private:
+    explicit Pause(std::shared_ptr<detail::PauseState> state);
+    void Release() noexcept;
+    std::shared_ptr<detail::PauseState> m_state;
+};
+
+/**
+ * Handle to pause/resume indexing any updates from the node. This fills up
+ * the validation interface queue, so use with caution. Thread-safe (shared
+ * by the HTTP handlers; Rust: Arc<PauseNotify>).
+ */
+class PauseNotify {
+public:
+    PauseNotify(PauseNotify &&) noexcept;
+    PauseNotify &operator=(PauseNotify &&) noexcept;
+    PauseNotify(const PauseNotify &) = delete;
+    PauseNotify &operator=(const PauseNotify &) = delete;
+    ~PauseNotify();
+
+    /**
+     * Pause the corresponding Pause, such that the next BlockIfPaused blocks.
+     * No-op if already paused. Throws ChronikError(PAUSE_NOT_ALLOWED_MSG) if
+     * pausing is not allowed, ChronikError(PAUSE_CHANNEL_CLOSED_MSG) if the
+     * Pause was destroyed.
+     */
+    void DoPause() const;
+    /** Resume; any pending BlockIfPaused returns immediately. */
+    void Resume() const;
+
+    bool IsPauseAllowed() const { return m_is_pause_allowed; }
+
+private:
+    friend class Pause;
+    PauseNotify(std::shared_ptr<detail::PauseState> state, bool allowed);
+    void Send(bool pause) const;
+    void Release() noexcept;
+    std::shared_ptr<detail::PauseState> m_state;
+    bool m_is_pause_allowed;
+};
+
+} // namespace chronik::native
+
