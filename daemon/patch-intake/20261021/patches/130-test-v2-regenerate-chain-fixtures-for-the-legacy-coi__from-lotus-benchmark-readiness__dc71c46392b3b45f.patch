From 3cf89f1c3d978f6b726eeeedccf4922d82663325 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 17:17:21 -0700
Subject: [PATCH] test(v2): regenerate chain fixtures for the legacy-coinbase
 regtest chain

The framework's regtest chain now has legacy coinbases and the T1 genesis,
so the deterministic tip hashes and UTXO set hashes move:
- feature_deterministic_chain_setup: the tips at heights 100 and 110 and
  the UTXO set hash at 110;
- feature_utxo_set_hash: hash_serialized of the cached chain (MuHash is
  unchanged);
- rpc_dumptxoutset: the base hash, file digest and txoutset hash.

The regtest m_assumeutxo_data in chainparams is not regenerated here.

Rebase onto coordinator 276 (81e8ef1774): the rpc_dumptxoutset values were
already regenerated by the coordinator for its own chain and are kept; this
commit's values for them were computed on another base and are dropped.
All three fixtures' values are unverified on this stack (no runtime suites
run) and need regeneration in the final runtime phase.

Tier: V2
---
 test/functional/feature_deterministic_chain_setup.py | 6 +++---
 test/functional/feature_utxo_set_hash.py             | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/test/functional/feature_deterministic_chain_setup.py b/test/functional/feature_deterministic_chain_setup.py
index ca19a973c66a3990e38484f8a74244fab26c39a4..f92b2572a9d9a086678fd2dc1acc22edfca0e1c2 100644
--- a/test/functional/feature_deterministic_chain_setup.py
+++ b/test/functional/feature_deterministic_chain_setup.py
@@ -85,7 +85,7 @@ class DeterministicChainSetupTest(BitcoinTestFramework):
         self.log.info("Reproduce the assertion in the TestChain100Setup constructor.")
         mine_blocks(100)
         assert_equal(
-            tip, "1b10a65e0c0b43bd9b95af46c5feb3ec7b6c38c8098ba5a9050a09314dcd7789"
+            tip, "46be4fc974a25e89fb5ec83cf181cab75e3e8fb86543f51d8e1bee84c8c0db52"
         )
 
         self.log.info("Check m_assumeutxo_data at height 110.")
@@ -94,11 +94,11 @@ class DeterministicChainSetupTest(BitcoinTestFramework):
         assert_equal(info["blocks"], 110)
         assert_equal(
             info["bestblockhash"],
-            "6f612a6186111e73723d49260a2dc85c426a805776fe5803af805b870c3ff4d8",
+            "23e847276ee2d85567bf1429a3ff0232566e0432d24f6657ba8a18f6a9b1738e",
         )
         assert_equal(
             node.gettxoutsetinfo()["hash_serialized"],
-            "979957332cd29814873244760d8573d714663fdc4a30021d662e9dfbf3d330c0",
+            "6f07ffe7fb7cb81306de17c163dafc8c2188daeccd2db83b43146fba7da47502",
         )
 
 
diff --git a/test/functional/feature_utxo_set_hash.py b/test/functional/feature_utxo_set_hash.py
index bd6f44aeef4362f2888852cb2608371facdbaa00..1a8a4a05efd75e3bb37154e9797c19f25a4bbebc 100644
--- a/test/functional/feature_utxo_set_hash.py
+++ b/test/functional/feature_utxo_set_hash.py
@@ -23,7 +23,7 @@ class UTXOSetHashTest(BitcoinTestFramework):
         # the cache
         assert_equal(
             self.nodes[0].gettxoutsetinfo()["hash_serialized"],
-            "e1ef57f2326ac3349dc21e3d23b1bd7b83e02a418677f548b032bb30caa33502",
+            "0160d9861236344c05c01f240be8378c59c981de2c4a318b54b3b194f643f27a",
         )
         assert_equal(
             self.nodes[0].gettxoutsetinfo("muhash")["muhash"],
