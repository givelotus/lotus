-        m_fast_sync_active = false;
-        m_reverse_peel_utxo.reset();
-        m_reverse_peel_smt_root.reset();
-        // Retain unresolved provenance when stopping at a shallow horizon.
-    }
-
-    node::PublishChainTipSnapshot(m_chainman, m_mempool);
-    error.clear();
-    return true;
-}
