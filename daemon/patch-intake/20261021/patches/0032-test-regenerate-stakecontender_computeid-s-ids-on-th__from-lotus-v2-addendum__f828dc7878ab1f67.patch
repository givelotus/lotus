From ffd7c4f843d733485a1e1a0040639a73d34f7fae Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 15:01:07 -0700
Subject: [PATCH] test: regenerate stakecontender_computeid's ids on the V2
 regtest chain

StakeContenderId commits to the previous block hash. TestChain100Setup's
tip changed with the V2 regtest genesis (v2/061), while the genesis-parent
vector still matched. Only the two ids derived from the tip moved. The
chain is deterministic: the snapshot tests at height 110 match
chainparams. The whole test-avalanche suite now passes.

Tier: V2 (fixup to v2/061)
---
 src/avalanche/test/stakingrewards_tests.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/avalanche/test/stakingrewards_tests.cpp b/src/avalanche/test/stakingrewards_tests.cpp
index a7be4814e6..4ffe2e1f31 100644
--- a/src/avalanche/test/stakingrewards_tests.cpp
+++ b/src/avalanche/test/stakingrewards_tests.cpp
@@ -84,14 +84,14 @@ BOOST_FIXTURE_TEST_CASE(stakecontender_computeid, TestChain100Setup) {
 
     // Different prevblock should give different hash
     BOOST_CHECK_EQUAL(
-        "a10d1c61b1c2852a19e564d9891a4ccf5a6ed55e1b009076b5a54cd4eb765606",
+        "a000a51068148e4448ad7c1c02c4eccffafdb98557027ceb90e7a52337b34562",
         StakeContenderId(chaintip->GetBlockHash(), proofid1).ToString());
 
     // So should a different proof id
     ProofId proofid2 = ProofId::fromHex(
         "e01bac293ed39e8d5e06214e7fe0bceb9646ef253ce501dcd7a475f802ab07f1");
     BOOST_CHECK_EQUAL(
-        "627383d81943a35e7225eb1589ccc61d7fec17365532ef43d517ef64be889a5a",
+        "8eb7d55c16504d8a9e6e7994a08810f86d69342fb8299916a6b68efc3a335c7c",
         StakeContenderId(chaintip->GetBlockHash(), proofid2).ToString());
 }
 
