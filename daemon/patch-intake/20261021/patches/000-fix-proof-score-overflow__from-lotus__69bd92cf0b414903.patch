From b93a27e27990bfff202a3b7820f878bf0abe2187 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 08:00:58 -0700
Subject: [PATCH] avalanche: avoid overflow when scoring large Dogecoin stakes

Dogecoin MAX_MONEY allows 10 billion coins. Multiplying satoshis by 100 before division overflows uint64_t above approximately 1.84 billion coins; a 2-billion-coin stake incorrectly scores 15532559262 rather than 200000000000. Divide directly by the exact satoshis per hundredth coin, preserving rounding and clamping without overflow. Replace the old overflowing test expectation and add independent constants, additivity and rounding regressions. This changes optional proof scoring, not Dogecoin PoW consensus or Chronik dependencies; it does not establish Avalanche quorum/network compatibility.
---
 src/avalanche/proof.cpp            | 10 ++++++----
 src/avalanche/test/proof_tests.cpp | 15 ++++++++++++++-
 2 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/src/avalanche/proof.cpp b/src/avalanche/proof.cpp
index f51aaca64ae56f4cd60584cef02969e4621f6e2b..8c9a0710d8499bdc39b450ee684d2305a325b419 100644
--- a/src/avalanche/proof.cpp
+++ b/src/avalanche/proof.cpp
@@ -96,10 +96,12 @@ void Proof::computeScore() {
 
 Score Proof::amountToScore(Amount amount) {
     amount = MoneyClamp(amount);
-    // TODO: Cleanup this hack that allows us to compute score when it does not
-    // fit in Amount
-    return (100 * uint64_t(amount / Amount::satoshi())) /
-           (COIN / Amount::satoshi());
+    // One score unit is exactly one hundredth of a coin. Divide first:
+    // 100 * satoshis can overflow uint64_t within Dogecoin's MAX_MONEY.
+    // COIN is divisible by 100, so this preserves rounding for all amounts.
+    static_assert((COIN / Amount::satoshi()) % 100 == 0);
+    static_assert(MAX_MONEY / (COIN / 100) <= std::numeric_limits<Score>::max());
+    return amount / (COIN / 100);
 }
 
 Amount Proof::getStakedAmount() const {
diff --git a/src/avalanche/test/proof_tests.cpp b/src/avalanche/test/proof_tests.cpp
index 2980fa272d67938b70e6d7ca97cefac4787fd216..2d708aa23140328d27483eb00440d2026eabcc5c 100644
--- a/src/avalanche/test/proof_tests.cpp
+++ b/src/avalanche/test/proof_tests.cpp
@@ -943,11 +943,24 @@ BOOST_AUTO_TEST_CASE(amount_to_score) {
     BOOST_CHECK_EQUAL(Proof::amountToScore(PROOF_DUST_THRESHOLD),
                       MIN_VALID_PROOF_SCORE);
     BOOST_CHECK_EQUAL(Proof::amountToScore(MAX_MONEY),
-                      Score((100 * MAX_MONEY) / COIN));
+                      Score(MAX_MONEY / (COIN / 100)));
     BOOST_CHECK_EQUAL(Proof::amountToScore(MAX_MONEY + SATOSHI),
                       Proof::amountToScore(MAX_MONEY));
 }
 
+BOOST_AUTO_TEST_CASE(amount_to_score_large_dogecoin_values) {
+    // 2 billion DOGE already exceeds the old uint64_t intermediate product.
+    const Amount two_billion = int64_t{2000000000} * COIN;
+    BOOST_CHECK_EQUAL(Proof::amountToScore(two_billion), uint64_t{200000000000});
+    BOOST_CHECK_EQUAL(Proof::amountToScore(MAX_MONEY), uint64_t{1000000000000});
+    BOOST_CHECK_EQUAL(Proof::amountToScore(two_billion + two_billion),
+                      Proof::amountToScore(two_billion) * 2);
+    BOOST_CHECK_EQUAL(Proof::amountToScore(two_billion - SATOSHI),
+                      uint64_t{199999999999});
+    BOOST_CHECK_EQUAL(Proof::amountToScore(two_billion + (COIN / 100)),
+                      uint64_t{200000000001});
+}
+
 BOOST_AUTO_TEST_CASE(stake_amount_overflow) {
     const CKey key = CKey::MakeCompressedKey();
     const CPubKey pubkey = key.GetPubKey();
