From 3287ed703325cb382f5d62c3e5b251219ee0a437 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:51:59 -0700
Subject: [PATCH] fixup! feat(v2): add C17a deterministic fee-backed UTXO
 expiry and cleaning-crew validation

Align the two assumeutxo metadata lookup assertions with independently regenerated legacy110 commitment99b8c406. The independent110 coin/stat preimage and production trusted anchor already agree. Retain both height/hash lookup checks,111 transaction count and every negative height. Final full C++ run isolated exactly these two stale literal assertions; no production behavior changes.

Tier: V2 (fixup to C17a deterministic fee-backed UTXO expiry and cleaning-crew validation)
---
 src/test/validation_tests.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/test/validation_tests.cpp b/src/test/validation_tests.cpp
index 5b31bc11e8..653671f801 100644
--- a/src/test/validation_tests.cpp
+++ b/src/test/validation_tests.cpp
@@ -147,7 +147,7 @@ BOOST_AUTO_TEST_CASE(test_assumeutxo) {
     const auto out110 = *params->AssumeutxoForHeight(110);
     BOOST_CHECK_EQUAL(
         out110.hash_serialized.ToString(),
-        "08c03b5c8dd81e473faa95c75238a0cc44f0a8986d5897cb3af69f2c0b9fb324");
+        "99b8c406f1aa808165216c1840766e939f4e1c226757ffd88a25e5b4ebd54bf1");
     BOOST_CHECK_EQUAL(out110.m_chain_tx_count, 111U);
 
     const auto by_hash = params->AssumeutxoForBlockhash(out110.blockhash);
@@ -155,7 +155,7 @@ BOOST_AUTO_TEST_CASE(test_assumeutxo) {
     const auto out110_2 = *by_hash;
     BOOST_CHECK_EQUAL(
         out110_2.hash_serialized.ToString(),
-        "08c03b5c8dd81e473faa95c75238a0cc44f0a8986d5897cb3af69f2c0b9fb324");
+        "99b8c406f1aa808165216c1840766e939f4e1c226757ffd88a25e5b4ebd54bf1");
     BOOST_CHECK_EQUAL(out110_2.m_chain_tx_count, 111U);
 }
 
