+describe('metadata read failures', () => {
+  it('preserves non-NotFound read error identity', async () => {
+    const failure = new Error('storage unavailable')
+    const storage = { get: jest.fn().mockRejectedValue(failure), put: jest.fn() } as unknown as LevelDB
+    await expect(resolveStoreMetadata(storage)).rejects.toBe(failure)
+    expect(storage.put).not.toHaveBeenCalled()
+  })
+  it.each(['{corrupt', JSON.stringify({ networkName: 'another-network', version: STORE_SCHEMA_VERSION })])(
+    'rejects invalid existing metadata without patching or saving: %s', async bytes => {
+      const storage = { get: jest.fn().mockResolvedValue(bytes), put: jest.fn() } as unknown as LevelDB
+      const pinia = createPinia()
+      pinia.use(createStoragePlugin(storage, resolveStoreMetadata(storage)))
+      createApp({}).use(pinia)
+      const restore = jest.fn(async () => ({ value: 9 }))
+      const save = jest.fn(async () => undefined)
+      const useStore = defineStore(`bad-metadata-${nextStoreId++}`, { state: () => ({ value: 7 }), storage: { restore, save } })
+      const store = useStore(pinia)
+      await expect(store.restored).rejects.toThrow()
+      await expect(store.rehydrate()).rejects.toThrow()
+      expect(store.value).toBe(7)
+      expect(restore).not.toHaveBeenCalled()
+      expect(save).not.toHaveBeenCalled()
+      expect(storage.put).not.toHaveBeenCalled()
+    },
+  )
+  it.each(['{}', 'null', '[]', JSON.stringify({ networkName: null, version: null })])(
+    'preserves current field defaults for %s', async bytes => {
+      const storage = { get: jest.fn().mockResolvedValue(bytes) } as unknown as LevelDB
+      await expect(resolveStoreMetadata(storage)).resolves.toEqual({ networkName: displayNetwork, version: STORE_SCHEMA_VERSION })
+    },
+  )
+})
+
+describe('real Level metadata compatibility', () => {
+  const level = require('level/level.js') as typeof import('level').default
+  const { mkdtempSync, rmSync } = require('fs') as typeof import('fs')
+  const { tmpdir } = require('os') as typeof import('os')
+  const { join } = require('path') as typeof import('path')
+  it.each([
+    undefined,
+    JSON.stringify({ networkName: displayNetwork, version: STORE_SCHEMA_VERSION }),
+  ])('preserves current writer save/reopen without hydration writes (metadata: %s)', async marker => {
+    const dir = mkdtempSync(join(tmpdir(), 'frank-metadata-compatible-'))
+    let db = level(dir)
+    try {
+      if (marker !== undefined) await db.put('storeMetadata', marker)
+      const put = jest.spyOn(db, 'put')
+      const makeStore = async () => {
+        const metadata = await resolveStoreMetadata(db)
+        const pinia = createPinia()
+        pinia.use(createStoragePlugin(db, Promise.resolve(metadata)))
+        createApp({}).use(pinia)
+        const useStore = defineStore(`real-metadata-${nextStoreId++}`, {
+          state: () => ({ value: 0 }),
+          storage: {
+            save: async (storage, _mutation, state) => storage.put('payload', JSON.stringify(state)),
+            restore: async storage => {
+              try { return JSON.parse(await storage.get('payload')) }
+              catch (error) {
+                if (error && typeof error === 'object' && 'notFound' in error && error.notFound === true) return {}
+                throw error
+              }
+            },
+          },
+        })
+        const store = useStore(pinia)
+        await store.restored
+        return store
+      }
+      const store = await makeStore()
+      expect(put).not.toHaveBeenCalled()
+      store.value = 7
+      await store.flushPersistence()
+      expect(put.mock.calls.map(call => call[0])).toEqual(['payload'])
+      await db.close()
+      db = level(dir)
+      const reopenedPut = jest.spyOn(db, 'put')
+      const restored = await makeStore()
+      expect(restored.value).toBe(7)
+      expect(await db.get('payload')).toBe('{"value":7}')
+      if (marker === undefined) await expect(db.get('storeMetadata')).rejects.toMatchObject({ notFound: true })
+      else expect(await db.get('storeMetadata')).toBe(marker)
+      expect(reopenedPut).not.toHaveBeenCalled()
+    } finally { await db.close(); rmSync(dir, { recursive: true, force: true }) }
+  })
+  it.each([
+    '{corrupt',
+    JSON.stringify({ networkName: displayNetwork, version: STORE_SCHEMA_VERSION - 1 }),
+    JSON.stringify({ networkName: 'another-network', version: STORE_SCHEMA_VERSION }),
+  ])('rejects existing invalid bytes, then restores after explicit repair: %s', async bytes => {
+    const dir = mkdtempSync(join(tmpdir(), 'frank-metadata-repair-'))
+    let db = level(dir)
+    try {
+      await db.put('storeMetadata', bytes)
+      await db.put('payload', '{"value":7}')
+      const put = jest.spyOn(db, 'put')
+      await expect(resolveStoreMetadata(db)).rejects.toThrow()
+      expect(await db.get('storeMetadata')).toBe(bytes)
+      expect(await db.get('payload')).toBe('{"value":7}')
+      expect(put).not.toHaveBeenCalled()
+      await db.put('storeMetadata', JSON.stringify({ networkName: displayNetwork, version: STORE_SCHEMA_VERSION }))
+      await db.close(); db = level(dir)
+      const reopenedPut = jest.spyOn(db, 'put')
+      await expect(resolveStoreMetadata(db)).resolves.toEqual({ networkName: displayNetwork, version: STORE_SCHEMA_VERSION })
+      expect(await db.get('payload')).toBe('{"value":7}')
+      expect(reopenedPut).not.toHaveBeenCalled()
+    } finally { await db.close(); rmSync(dir, { recursive: true, force: true }) }
+  })
+})
