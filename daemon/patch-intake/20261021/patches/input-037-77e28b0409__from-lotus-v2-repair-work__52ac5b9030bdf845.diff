+    const size_t max_entries =
+        g_v2_state_persist_dir.empty() ? 256 : kMaxCachedV2StateSnapshots;
+    while (g_v2_state_snapshots.size() > max_entries &&
+           !g_v2_state_lru.empty()) {
+        const BlockHash oldest = g_v2_state_lru.front();
+        g_v2_state_lru.pop_front();
+        g_v2_state_lru_pos.erase(oldest);
+        g_v2_state_snapshots.erase(oldest);
+    }
+}
