+        if (sub.sub_buckets[sb].count == std::numeric_limits<uint16_t>::max()) {
+            throw std::length_error("Merklix cell count exceeds legacy wire capacity");
+        }
         sub.sub_buckets[sb].count += 1;
         sub.sub_buckets[sb].s1 ^= sid;
         sub.sub_buckets[sb].s3 ^= GF64Cube(sid);
@@ -1288,6 +1338,7 @@ bool V2PeerProtocolHandler::MaybeSendSync(
         peer.IsBlockOnlyConn() || peer.IsAddrFetchConn()) {
         return false;
     }
+    if (m_mempool.size() > MAX_SCOPED_TXS) return false;
     const auto generation = m_mempool.GetTransactionsUpdated();
     {
         LOCK(m_mutex);
@@ -1313,8 +1364,12 @@ bool V2PeerProtocolHandler::MaybeSendSync(
             cached = m_live_sync_summary;
         }
     }
-    const auto summary = cached ? *cached :
-        BuildSyncSummary(ReconScope::LIVE_MEMPOOL, uint256{});
+    MerklixSyncSummary summary;
+    try {
+        summary = cached ? *cached : BuildSyncSummary(ReconScope::LIVE_MEMPOOL, uint256{});
+    } catch (const std::length_error &) {
+        return false;
+    }
     {
         LOCK(m_mutex);
         auto &state = m_sync_announcements[peer.GetId()];
@@ -1861,7 +1916,16 @@ void V2PeerProtocolHandler::HandleShortTx(
         std::vector<CTransactionRef> merged =
             GetScopedTransactions(scope, resp.context_id);
         merged.insert(merged.end(), valid_txs.begin(), valid_txs.end());
-        SetScopedTransactions(scope, resp.context_id, std::move(merged));
+        if (!SetScopedTransactions(scope, resp.context_id, std::move(merged))) {
+            // Accepted transactions remain in the real mempool and ordinary
+            // relay continues. Do not retain a partial scoped commitment.
+            LOCK(m_mutex);
+            const auto found = m_scoped_txs.find(ScopeKey{scope, resp.context_id});
+            if (found != m_scoped_txs.end()) {
+                m_scoped_cache_bytes -= found->second.bytes;
+                m_scoped_txs.erase(found);
+            }
+        }
     }
 
     m_peerman.RelayTransactionBatch(accepted_txs);
