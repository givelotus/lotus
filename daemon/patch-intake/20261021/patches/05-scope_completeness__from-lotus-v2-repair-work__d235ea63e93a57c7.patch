 void V2PeerProtocolHandler::RegisterCandidateOverlay(
     const BlockHash &prev_block_hash, std::vector<CTransactionRef> txs) {
+    // Cache only complete candidates, without changing ABC merkle metadata.
+    if (txs.size() > MAX_SCOPED_TXS) return;
+    size_t bytes = 0;
+    for (const auto &tx : txs) {
+        if (!tx) continue;
+        bytes += GetSerializeSize(*tx);
+        if (bytes > MAX_SCOPED_TX_BYTES) return;
+    }
     CandidateOverlayEntry entry = BuildCandidateOverlayEntry(txs);
+    entry.bytes = bytes;
     LOCK(m_mutex);
+    while (!m_candidate_overlays.empty() &&
+           (m_candidate_cache_bytes + entry.bytes > MAX_SCOPED_CACHE_BYTES ||
+            (!m_candidate_overlays.count(prev_block_hash) &&
+             m_candidate_overlays.size() >= MAX_TRACKED_RECON_SCOPES))) {
+        const auto victim = m_candidate_overlays.begin();
+        for (const auto &old : victim->second) m_candidate_cache_bytes -= old.bytes;
+        m_candidate_overlays.erase(victim);
+    }
     auto &vec = m_candidate_overlays[prev_block_hash];
     if (vec.size() >= MAX_OVERLAYS_PER_PREV) {
+        m_candidate_cache_bytes -= vec.front().bytes;
         vec.erase(vec.begin());
     }
+    m_candidate_cache_bytes += entry.bytes;
     vec.push_back(std::move(entry));
 }
 
 void V2PeerProtocolHandler::ClearCandidateOverlays() {
     LOCK(m_mutex);
     m_candidate_overlays.clear();
+    m_candidate_cache_bytes = 0;
 }
 
