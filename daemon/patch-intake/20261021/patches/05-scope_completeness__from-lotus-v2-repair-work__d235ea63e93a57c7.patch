+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#include <net/v2_protocol_handler.h>
+#include <net_processing.h>
+#include <net.h>
+#include <validation.h>
+#include <test/util/net.h>
+#include <test/util/setup_common.h>
+#include <primitives/transaction.h>
+#include <script/script.h>
+#include <boost/test/unit_test.hpp>
+using namespace lotus::v2::net;
+BOOST_FIXTURE_TEST_SUITE(merklix_scope_tests, RegTestingSetup)
+BOOST_AUTO_TEST_CASE(complete_scope_boundaries_and_ten_thousand_summary) {
+    const auto &config = m_node.chainman->GetConfig();
+    ConnmanTestMsg connman(config, 1, 2, *m_node.addrman);
+    auto peerman = PeerManager::make(connman, *m_node.addrman, nullptr,
+                                     *m_node.chainman, *m_node.mempool, nullptr, {});
+    auto *handler = peerman->GetV2ProtocolHandler();
+    BOOST_REQUIRE(handler);
+    std::vector<CTransactionRef> txs;
+    for (size_t i = 0; i <= V2PeerProtocolHandler::MAX_SCOPED_TXS; ++i) {
+        CMutableTransaction tx;
+        tx.nVersion = 2;
+        tx.vin.resize(1);
+        uint256 id;
+        for (unsigned byte = 0; byte < 8; ++byte)
+            id.begin()[byte] = static_cast<uint8_t>((i + 1) >> (8 * byte));
+        tx.vin[0].prevout = COutPoint(TxId(id), 0);
+        tx.vout.emplace_back(1000 * SATOSHI, CScript() << OP_TRUE);
+        txs.push_back(MakeTransactionRef(std::move(tx)));
+    }
+    const auto scope = ReconScope::BLOCK_RECON;
+    const uint256 context{123};
+    std::vector<CTransactionRef> ten_k(txs.begin(), txs.begin() + 10000);
+    BOOST_REQUIRE(handler->SetScopedTransactions(scope, context, ten_k));
+    const auto summary = handler->BuildSyncSummary(scope, context);
+    size_t count = 0;
+    for (const auto &bucket : summary.buckets) count += bucket.count;
+    BOOST_CHECK_EQUAL(count, 10000U);
+    BOOST_CHECK(summary.candidate_root == ComputeScopedMerklixRoot(ten_k));
+    std::vector<CTransactionRef> below(txs.begin(), txs.end() - 2);
+    BOOST_REQUIRE(handler->SetScopedTransactions(scope, context, below));
+    BOOST_CHECK_EQUAL(handler->GetScopedTransactions(scope, context).size(),
+                      V2PeerProtocolHandler::MAX_SCOPED_TXS - 1);
+    std::vector<CTransactionRef> at(txs.begin(), txs.end() - 1);
+    BOOST_REQUIRE(handler->SetScopedTransactions(scope, context, at));
+    const auto root = handler->BuildSyncSummary(scope, context).candidate_root;
+    BOOST_CHECK(!handler->SetScopedTransactions(scope, context, txs));
+    BOOST_CHECK_EQUAL(handler->GetScopedTransactions(scope, context).size(),
+                      V2PeerProtocolHandler::MAX_SCOPED_TXS);
+    BOOST_CHECK(root == handler->BuildSyncSummary(scope, context).candidate_root);
+    // Full-set normalization is independent of the recon resource bound.
+    BOOST_CHECK(ComputeScopedMerklixRoot(txs) != root);
+}
+BOOST_AUTO_TEST_SUITE_END()
