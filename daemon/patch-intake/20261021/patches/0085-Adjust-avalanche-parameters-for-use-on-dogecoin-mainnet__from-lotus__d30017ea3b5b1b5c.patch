From dd34970549a635ed3b64cf733305666da94596b5 Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Tue, 26 Aug 2025 22:17:30 +0000
Subject: [PATCH] Adjust avalanche parameters for use on dogecoin mainnet

Maintenance rationale (2026-10-14):
Preserve original Dogecoin coordination thresholds and parameters independently of PoW consensus; this does not establish a deployed Avalanche quorum.

diff --git a/src/avalanche/avalanche.h b/src/avalanche/avalanche.h
index e99e9185ae78c41b00d56b175012286c9050e18d..3c661117d2019672644b183d7b9083272ba2dcd8 100644
--- a/src/avalanche/avalanche.h
+++ b/src/avalanche/avalanche.h
@@ -37,7 +37,7 @@ static constexpr size_t AVALANCHE_DEFAULT_COOLDOWN = 100;
  * quorum.
  */
 static constexpr Amount AVALANCHE_DEFAULT_MIN_QUORUM_STAKE =
-    int64_t(1'000'000'000'000) * SATOSHI; // 10B XEC
+    int64_t(100'000'000'000'000) * SATOSHI; // 1M DOGE
 
 /**
  * Default minimum percentage of stake-weighted peers we must have a node for to
diff --git a/src/avalanche/proof.h b/src/avalanche/proof.h
index bd39b9eb47cd81cb80bf2798fd3bac25bc0166af..0ba32247e202e2e9b8c895c9465406ff979e48b2 100644
--- a/src/avalanche/proof.h
+++ b/src/avalanche/proof.h
@@ -30,12 +30,12 @@ static constexpr int AVALANCHE_MAX_PROOF_STAKES = 1000;
  * Minimum number of confirmations before a stake utxo is mature enough to be
  * included into a proof.
  */
-static constexpr int AVALANCHE_DEFAULT_STAKE_UTXO_CONFIRMATIONS = 2016;
+static constexpr int AVALANCHE_DEFAULT_STAKE_UTXO_CONFIRMATIONS = 20160;
 
 namespace avalanche {
 
 /** Minimum amount per utxo */
-static constexpr Amount PROOF_DUST_THRESHOLD = 100 * COIN;
+static constexpr Amount PROOF_DUST_THRESHOLD = 10000 * COIN;
 
 class ProofValidationState;
 
