From b5e9e4492ef4da9d3688fd4b8a83bdebeaebf257 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:01:48 -0700
Subject: [PATCH] build(v2): link test_lotus_v2_header_boundary against the
 consensus library

The standalone header boundary test compiles primitives/transaction.cpp
directly. CTransaction::FillPrecomputedData() there calls
PrecomputedTransactionData::Compute<CTransaction>, which is defined in
script/interpreter.cpp, so the target failed to link with an undefined
symbol at every commit since it was registered. Link it against
bitcoinconsensus, which brings in the script library that provides it.

check-lotus-v2-header-boundary now builds and passes.

Tier: V2 (fixup to v2/024)
---
 src/lotus_v2/CMakeLists.txt | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index b33a8f6286..de35ba70fa 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -115,7 +115,10 @@ add_executable(test_lotus_v2_header_boundary
     ../crypto/hex_base.cpp
 )
 target_include_directories(test_lotus_v2_header_boundary PRIVATE ..)
-target_link_libraries(test_lotus_v2_header_boundary lotus_v2_header)
+# transaction.cpp fills its cached legacy sighash midstate with
+# PrecomputedTransactionData::Compute, which script/interpreter.cpp defines;
+# take it from the consensus/script libraries.
+target_link_libraries(test_lotus_v2_header_boundary lotus_v2_header bitcoinconsensus)
 add_custom_target(check-lotus-v2-header-boundary
     COMMAND $<TARGET_FILE:test_lotus_v2_header_boundary>
     DEPENDS test_lotus_v2_header_boundary
