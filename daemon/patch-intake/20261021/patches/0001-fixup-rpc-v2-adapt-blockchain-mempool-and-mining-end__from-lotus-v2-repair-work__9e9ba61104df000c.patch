From 4909bfb2d44f21e0ccc26b43e94c70c8f08c89c3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 10:42:49 -0700
Subject: [PATCH 1/2] fixup! rpc(v2): adapt blockchain, mempool and mining
 endpoints

Convert the optional shard array for positional and named CLI calls. Retain hexadecimal block/root strings and reject malformed shard JSON. Regression exercises the real RPCConvertValues/RPCConvertNamedValues implementations; original positional shard argument is incorrectly left as a string.
---
 src/rpc/client.cpp     |  1 +
 src/test/rpc_tests.cpp | 24 ++++++++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/src/rpc/client.cpp b/src/rpc/client.cpp
index d83652e8ecd06f6c8fed22c667aaa041a3008c46..38dd3690e4e3d94dc78d9a8e2209ba33b2681385 100644
--- a/src/rpc/client.cpp
+++ b/src/rpc/client.cpp
@@ -27,6 +27,7 @@ public:
  * @note Parameter indexes start from 0.
  */
 static const CRPCConvertParam vRPCConvertParams[] = {
+    {"setfastsyncpivot", 2, "utxoshards"},
     {"syncutxoshardswarm", 1, "peer_ids"},
     {"syncutxoshardswarm", 2, "auto_peel"},
     {"setmocktime", 0, "timestamp"},
diff --git a/src/test/rpc_tests.cpp b/src/test/rpc_tests.cpp
index 2a7443562da5d588df93e7e3fe5eb81b8cda7ddf..855f49e77b5dbb204cbea1faa3a38bd81b711f93 100644
--- a/src/test/rpc_tests.cpp
+++ b/src/test/rpc_tests.cpp
@@ -653,6 +653,30 @@ BOOST_AUTO_TEST_CASE(rpc_convert_values_generatetoaddress) {
     BOOST_CHECK_EQUAL(result[2].getInt<int>(), 9);
 }
 
+BOOST_AUTO_TEST_CASE(rpc_convert_values_setfastsyncpivot) {
+    const auto positional = RPCConvertValues(
+        "setfastsyncpivot", {"00", "abcd", R"(["00","ff"])"});
+    BOOST_CHECK(positional[0].isStr());
+    BOOST_CHECK(positional[1].isStr());
+    BOOST_REQUIRE(positional[2].isArray());
+    BOOST_CHECK_EQUAL(positional[2].size(), 2U);
+    BOOST_CHECK_EQUAL(positional[2][0].get_str(), "00");
+
+    const auto named = RPCConvertNamedValues(
+        "setfastsyncpivot",
+        {"blockhash=00", "utxoroots_hex=abcd", R"(utxoshards=["00","ff"])"});
+    BOOST_CHECK(named["blockhash"].isStr());
+    BOOST_CHECK(named["utxoroots_hex"].isStr());
+    BOOST_REQUIRE(named["utxoshards"].isArray());
+    BOOST_CHECK_EQUAL(named["utxoshards"][1].get_str(), "ff");
+    BOOST_CHECK_THROW(
+        RPCConvertValues("setfastsyncpivot", {"00", "abcd", "["}),
+        std::runtime_error);
+    BOOST_CHECK_THROW(
+        RPCConvertNamedValues("setfastsyncpivot", {"utxoshards=["}),
+        std::runtime_error);
+}
+
 // Make sure errors are triggered appropriately if parameters have the same
 // names.
 BOOST_AUTO_TEST_CASE(check_dup_param_names) {
