+void PopulateMempoolScalarsLocked(ChainAndMempoolSnapshot &snap,
+                                  const CTxMemPool &mempool)
+    EXCLUSIVE_LOCKS_REQUIRED(mempool.cs) {
+    snap.mempool_ptr = &mempool;
+    snap.mempool_valid = true;
