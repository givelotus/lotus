+void SnapshotPublisher::Publish(std::shared_ptr<const ChainAndMempoolSnapshot> next) {
+    if (!next) return;
+    std::atomic_store_explicit(&m_current, std::move(next), std::memory_order_release);
+    m_publications.fetch_add(1);
+}
