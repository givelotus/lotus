From cfe2bf6dabfa126706186b247322170e808be1b0 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 21:36:41 -0700
Subject: [PATCH] fixup! mempool(v2): avoid repeated parent and overlay work

---
 src/test/mempool_overlay_tests.cpp |  2 ++
 src/txmempool.cpp                  | 12 ++++++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/test/mempool_overlay_tests.cpp b/src/test/mempool_overlay_tests.cpp
index 475963bfd6..b1167bbdfb 100644
--- a/src/test/mempool_overlay_tests.cpp
+++ b/src/test/mempool_overlay_tests.cpp
@@ -1366,10 +1366,12 @@ BOOST_AUTO_TEST_CASE(mempool_overlay_tracks_admission_removal_and_tip) {
     TestMemPoolEntryHelper entry;
     pool.addUnchecked(entry.Fee(500 * SATOSHI).FromTx(parent_tx));
     pool.addUnchecked(entry.Fee(600 * SATOSHI).FromTx(child_tx));
+    pool.FlushPendingOverlayAdds();
     BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTxCount(), 2U);
     BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTotalFeesSats(), 1100);
     const auto frozen_root = pool.FreezeEpochBatch().GetSubtreeARoot();
     pool.removeRecursive(*child_tx, MemPoolRemovalReason::CONFLICT);
+    pool.FlushPendingOverlayAdds();
     BOOST_CHECK_EQUAL(manager.GetSpeculativeOverlay().GetTxCount(), 1U);
     BOOST_REQUIRE_EQUAL(manager.GetFrozenEpochs().size(), 1U);
     BOOST_CHECK(manager.GetFrozenEpochs().back().GetSubtreeARoot() == frozen_root);
diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 5977bf2438..d2b9bf7b0c 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -487,17 +487,25 @@ void CTxMemPool::FlushPendingOverlayAdds() const {
     if (m_pending_overlay_adds.empty() && m_pending_overlay_removes.empty()) {
         return;
     }
+    auto reset_speculative = [&] {
+        // Bulk live-pool rebuilds must not erase immutable frozen epochs.
+        const auto &current = m_merklix_overlay.GetSpeculativeOverlay();
+        lotus::v2::MempoolOverlayLayer empty(current.GetParentBlockId(),
+            current.GetBaseUtxoRoot(), current.GetBaseMonetaryState(),
+            current.GetHeight(), current.GetParentMtp(), current.GetLayerId());
+        m_merklix_overlay.GetSpeculativeOverlay() = std::move(empty);
+    };
     if (!m_pending_overlay_removes.empty()) {
         if (mapTx.empty()) {
             m_pending_overlay_adds.clear();
             m_pending_overlay_removes.clear();
-            m_merklix_overlay.Clear();
+            reset_speculative();
             return;
         }
         if (m_pending_overlay_removes.size() >= mapTx.size()) {
             m_pending_overlay_adds.clear();
             m_pending_overlay_removes.clear();
-            m_merklix_overlay.Clear();
+            reset_speculative();
             std::vector<std::tuple<CTransactionRef, int64_t, int64_t>> remaining;
             remaining.reserve(mapTx.size());
             for (const auto &entry : mapTx.get<entry_id>()) {
-- 
