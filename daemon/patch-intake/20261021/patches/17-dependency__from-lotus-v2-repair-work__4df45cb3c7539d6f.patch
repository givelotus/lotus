Subject: [PATCH] fixup! avalanche: add quorum node-count and
 circulating-supply activation gates

---
 src/avalanche/test/preconsensus_batch_tests.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/avalanche/test/preconsensus_batch_tests.cpp b/src/avalanche/test/preconsensus_batch_tests.cpp
index c8dfdcb18f..58313d8d2a 100644
--- a/src/avalanche/test/preconsensus_batch_tests.cpp
+++ b/src/avalanche/test/preconsensus_batch_tests.cpp
@@ -98,12 +98,12 @@ BOOST_FIXTURE_TEST_CASE(mempool_batch_serialization_and_id, BasicTestingSetup) {
     BOOST_CHECK(deserialized == batch);
     BOOST_CHECK_EQUAL(deserialized.ComputeBatchId(), batch.ComputeBatchId());
 
-    // 2. Verify the eCash tagged SHA256 identifier and field sensitivity
+    // 2. Verify the native keyed BLAKE3 identifier and field sensitivity
     const uint256 idOrig = batch.ComputeBatchId();
     BOOST_CHECK(!idOrig.IsNull());
-    // Independent Python hashlib vector over explicit 168-byte LE serialization.
+    // Independent Python blake3 vector over explicit 168-byte LE serialization.
     BOOST_CHECK_EQUAL(idOrig.GetHex(),
-        "f2550ec763722f0d511967da83bcfc5a4b5460f09a6001b17ed2ebcf85716f23");
+        "3d199c07c8397cdf533ae29cdac697019a4741c5aa7cff64fa6478b16bc805c3");
 
     MempoolBatchAnnouncement modifiedEpoch = batch;
     modifiedEpoch.epoch_seq = 43;
