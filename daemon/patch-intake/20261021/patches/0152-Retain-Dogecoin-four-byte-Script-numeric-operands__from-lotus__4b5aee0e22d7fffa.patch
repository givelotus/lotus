From a62901106f57137b637ad346e7c4928f75f22f8e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:48:20 -0700
Subject: [PATCH] Retain Dogecoin four-byte Script numeric operands

Current ABC permanently enabled eight-byte Script numbers after Tobias fork. Select the historical four-byte operand bound under legacy rules while retaining modern ABC behavior for nonlegacy mode. Preserve overflow results as stack data and the independent five-byte CLTV/CSV exceptions. Native regression exercises signed four-byte limits, five/eight-byte operands, overflow reuse, and both timelock exceptions.

diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index cf00bf5faf8a9ea1d293468197801b44f10e38fc..51cdab8c49468db131f38359636a44ecfa1968f9 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -237,7 +237,12 @@ bool ScriptInterpreter::RunNextOpInner() {
     bool fExec = vfExec.all_true();
 
     // Maximum integer byte size
-    const size_t nMaxNumSize = MAX_SCRIPTNUM_BYTE_SIZE;
+    // Dogecoin retains the historical four-byte operand limit. Arithmetic
+    // may produce a five-byte result; only its later numeric use is rejected.
+    // CLTV and CSV independently retain their five-byte exception below.
+    const size_t nMaxNumSize = (flags & SCRIPT_VERIFY_LEGACY_RULES)
+                                   ? 4
+                                   : MAX_SCRIPTNUM_BYTE_SIZE;
 
     //
     // Read instruction
diff --git a/src/test/script_tests.cpp b/src/test/script_tests.cpp
index a5268252d4d00d262f9e369120614e4e061b8bf5..1802b3d89051ef83f0ef17bc579915d7091cf45b 100644
--- a/src/test/script_tests.cpp
+++ b/src/test/script_tests.cpp
@@ -547,6 +547,52 @@ std::string JSONPrettyPrint(const UniValue &univalue) {
 
 BOOST_FIXTURE_TEST_SUITE(script_tests, ScriptTest)
 
+BOOST_AUTO_TEST_CASE(legacy_numeric_operand_boundaries) {
+    struct LockChecker : BaseSignatureChecker {
+        bool CheckLockTime(const CScriptNum &) const override { return true; }
+        bool CheckSequence(const CScriptNum &) const override { return true; }
+    } checker;
+    auto check = [&](const CScript &script, uint32_t flags, ScriptError expected) {
+        std::vector<std::vector<uint8_t>> stack;
+        ScriptError error;
+        BOOST_CHECK_EQUAL(EvalScript(stack, script, flags, checker, &error),
+                          expected == ScriptError::OK);
+        BOOST_CHECK_EQUAL(error, expected);
+        return stack;
+    };
+    const uint32_t legacy = SCRIPT_VERIFY_LEGACY_RULES;
+    // Both ends of the signed-magnitude four-byte range remain usable.
+    for (const int64_t value : {int64_t{2147483647}, int64_t{-2147483647}}) {
+        check(CScript() << value << OP_0NOTEQUAL, legacy, ScriptError::OK);
+    }
+    // Five- and eight-byte integers are valid stack data but legacy numeric
+    // consumers must reject them. Modern ABC still accepts both widths.
+    for (const int64_t value : {int64_t{2147483648}, int64_t{-2147483648},
+                               int64_t{1} << 55, -(int64_t{1} << 55)}) {
+        check(CScript() << value << OP_DROP, legacy, ScriptError::OK);
+        check(CScript() << value << OP_0NOTEQUAL, legacy,
+              ScriptError::INTEGER_OVERFLOW);
+        check(CScript() << value << OP_0NOTEQUAL, 0, ScriptError::OK);
+    }
+    const CScript overflow = CScript() << int64_t{2147483647} << OP_1ADD;
+    const auto stack = check(overflow, legacy, ScriptError::OK);
+    BOOST_REQUIRE_EQUAL(stack.size(), 1);
+    BOOST_CHECK(stack[0] == CScriptNum(int64_t{2147483648}).getvch());
+    check(CScript(overflow) << OP_1ADD, legacy, ScriptError::INTEGER_OVERFLOW);
+    check(CScript(overflow) << OP_DROP, legacy, ScriptError::OK);
+    // Timelock opcodes intentionally allow five bytes on both VM modes.
+    for (const auto opcode : {OP_CHECKLOCKTIMEVERIFY, OP_CHECKSEQUENCEVERIFY}) {
+        for (const uint32_t mode : {uint32_t{0}, legacy}) {
+            const uint32_t flags = mode | SCRIPT_VERIFY_CHECKLOCKTIMEVERIFY |
+                                   SCRIPT_VERIFY_CHECKSEQUENCEVERIFY;
+            check(CScript() << (int64_t{1} << 32) << opcode, flags,
+                  ScriptError::OK);
+            check(CScript() << (int64_t{1} << 39) << opcode, flags,
+                  ScriptError::INTEGER_OVERFLOW);
+        }
+    }
+}
+
 BOOST_AUTO_TEST_CASE(script_build) {
     const KeyData keys;
 
