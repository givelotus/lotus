+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <node/metrics.h>
+
+#include <algorithm>
+#include <memory>
+
+namespace node {
+
+namespace detail {
+    std::atomic<NodeMetrics *> g_node_metrics{nullptr};
+}
+
+namespace metric_labels {
+    const std::vector<std::string> &HTTPEndpoints() {
+        static const std::vector<std::string> labels{
+            "rpc", "wallet", "rest", "chronik", "health", "metrics", "other"};
+        return labels;
+    }
+    const std::vector<std::string> &HTTPCodeClasses() {
+        static const std::vector<std::string> labels{"1xx", "2xx", "3xx",
+                                                     "4xx", "5xx", "other"};
+        return labels;
+    }
+} // namespace metric_labels
+
+namespace {
+    using metrics::Counter;
+    using metrics::EventHistogram;
+    using metrics::LabelDim;
+    namespace L = metric_labels;
+
+    //! Seconds; HTTP and RPC requests (long polls can take minutes)
+    const std::vector<double> REQUEST_BUCKETS{
+        0.0001, 0.00025, 0.0005, 0.001, 0.0025, 0.005, 0.01, 0.025, 0.05, 0.1,
+        0.25,   0.5,     1,      2.5,   5,      10,    30,   60,    300};
+
+    template <typename T, typename... Args>
+    T &Add(metrics::Registry &reg, Args &&...args) {
+        return reg.Add(std::make_unique<T>(std::forward<Args>(args)...));
+    }
+} // namespace
+
+NodeMetrics::NodeMetrics()
+    : http_requests{Add<Counter>(
+          registry, "lotus_http_requests_total",
+          "HTTP requests answered (not WebSocket sessions), by endpoint and "
+          "status class.",
+          std::vector<LabelDim>{{"endpoint", L::HTTPEndpoints()},
+                                {"code", L::HTTPCodeClasses()}})},
+      http_request_seconds{Add<EventHistogram>(
+          registry, "lotus_http_request_duration_seconds",
+          "Time from receiving an HTTP request's header to writing its "
+          "response, by endpoint.",
+          REQUEST_BUCKETS, /*divisor=*/1e9,
+          std::vector<LabelDim>{{"endpoint", L::HTTPEndpoints()}})},
+      http_tls_handshakes{
+          Add<Counter>(registry, "lotus_http_tls_handshakes_total",
+                       "TLS handshakes on the HTTP listeners, by result.",
+                       std::vector<LabelDim>{{"result", {"ok", "failed"}}})} {}
+
+NodeMetrics &StartNodeMetrics() {
+    NodeMetrics *m{GetNodeMetrics()};
+    if (!m) {
+        // Never freed: recording threads may hold the pointer.
+        m = new NodeMetrics();
+        detail::g_node_metrics.store(m, std::memory_order_release);
+    }
+    m->registry.Start();
+    return *m;
+}
+
+void StopNodeMetrics() {
+    if (NodeMetrics * m{GetNodeMetrics()}) {
+        m->registry.Stop();
+    }
+}
+
+} // namespace node
diff --git a/src/node/metrics.h b/src/node/metrics.h
new file mode 100644
index 0000000000..d2e9d9fb61
--- /dev/null
+++ b/src/node/metrics.h
@@ -0,0 +1,74 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_NODE_METRICS_H
+#define BITCOIN_NODE_METRICS_H
+
+#include <metrics/metrics.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+//! Serve /metrics (to -rpcallowip clients, without authentication)
+static constexpr bool DEFAULT_METRICS{false};
+//! Repeated scrapes within this interval get the previous rendering
+static constexpr std::chrono::milliseconds METRICS_MIN_SCRAPE_INTERVAL{1000};
+
+namespace node {
+
+/** Label values of the node's metrics (index = enum value where noted) */
+namespace metric_labels {
+    //! HTTP endpoint classes (see HTTPEndpoint)
+    const std::vector<std::string> &HTTPEndpoints();
+    //! 0 = 1xx ... 4 = 5xx, 5 = other
+    const std::vector<std::string> &HTTPCodeClasses();
+} // namespace metric_labels
+
+enum class HTTPEndpoint : size_t {
+    RPC,
+    WALLET,
+    REST,
+    CHRONIK,
+    HEALTH,
+    METRICS,
+    OTHER,
+};
+
+/** The node's metrics. Exists only with -metrics (see GetNodeMetrics). */
+struct NodeMetrics {
+    NodeMetrics();
+    metrics::Registry registry;
+
+    // HTTP and RPC
+    metrics::Counter &http_requests;
+    metrics::EventHistogram &http_request_seconds;
+    metrics::Counter &http_tls_handshakes;
+};
+
+namespace detail {
+    extern std::atomic<NodeMetrics *> g_node_metrics;
+}
+
+/**
+ * The node's metrics, or nullptr when they are off. Recording sites do
+ * `if (auto *m{node::GetNodeMetrics()}) m->...`, so disabled metrics cost
+ * one load and a branch. Once created, the object is never freed (like
+ * the logger), so a pointer obtained here stays valid.
+ */
+inline NodeMetrics *GetNodeMetrics() noexcept {
+    return detail::g_node_metrics.load(std::memory_order_acquire);
+}
+
+/** Create the metrics (once) and start the drain thread */
+NodeMetrics &StartNodeMetrics();
+/** Stop the drain thread (recording still works, into full rings) */
+void StopNodeMetrics();
+
+} // namespace node
+
+#endif // BITCOIN_NODE_METRICS_H
diff --git a/test/functional/interface_http_metrics.py b/test/functional/interface_http_metrics.py
new file mode 100755
index 0000000000..7973629073
--- /dev/null
+++ b/test/functional/interface_http_metrics.py
@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test /metrics (-metrics): the Prometheus text format, values that change,
+and access limited to -rpcallowip clients on the RPC listeners."""
+
+import http.client
+import re
+import socket
+import ssl
+import time
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, p2p_port, rpc_port
+
+PUBLIC_PORT_INDEX = 41
+NAME = r"[a-zA-Z_:][a-zA-Z0-9_:]*"
+LABEL = r'[a-zA-Z_][a-zA-Z0-9_]*="(?:[^"\\\n]|\\[\\"n])*"'
+SAMPLE = re.compile(
+    rf"^({NAME})(\{{{LABEL}(?:,{LABEL})*\}})? "
+    r"(NaN|[+-]Inf|[-+]?[0-9]+(?:\.[0-9]+)?(?:[eE][-+]?[0-9]+)?)$"
+)
+LABEL_PAIR = re.compile(r'([a-zA-Z_][a-zA-Z0-9_]*)="((?:[^"\\]|\\.)*)"')
+
+
+def parse(text):
+    """Parse and check an exposition; return {(name, labels): value}."""
+    assert text.endswith("\n")
+    types = {}
+    samples = {}
+    for line in text.splitlines():
+        if line.startswith("# HELP "):
+            assert re.match(rf"^# HELP {NAME} .+$", line), line
+            continue
+        if line.startswith("# TYPE "):
+            _, _, name, kind = line.split(" ")
+            assert kind in ("counter", "gauge", "histogram"), line
+            assert name not in types, f"duplicate TYPE {name}"
+            types[name] = kind
+            continue
+        m = SAMPLE.match(line)
+        assert m, f"bad sample line: {line!r}"
+        name, labels, value = m.group(1), m.group(2) or "", m.group(3)
+        family = name
+        if name not in types:
+            for suffix in ("_bucket", "_sum", "_count"):
+                base = name[: -len(suffix)]
+                if name.endswith(suffix) and types.get(base) == "histogram":
+                    family = base
+        assert family in types, f"sample before/without TYPE: {line}"
+        if types[family] == "counter":
+            assert name.endswith("_total"), name
+        key = (name, tuple(LABEL_PAIR.findall(labels)))
+        assert key not in samples, f"duplicate series {line}"
+        samples[key] = float(value)
+    # Histograms: cumulative buckets ending with +Inf == _count
+    for name, kind in types.items():
+        if kind != "histogram":
+            continue
+        series = {}
+        for (n, labels), v in samples.items():
+            if n == name + "_bucket":
+                rest = tuple(p for p in labels if p[0] != "le")
+                le = dict(labels)["le"]
+                series.setdefault(rest, []).append(
+                    (float("inf") if le == "+Inf" else float(le), v))
+        for rest, buckets in series.items():
+            counts = [v for _, v in sorted(buckets)]
+            assert counts == sorted(counts), f"{name} not cumulative"
+            assert sorted(buckets)[-1][0] == float("inf")
+            assert_equal(counts[-1], samples[(name + "_count", rest)])
+            assert (name + "_sum", rest) in samples
+    return samples
+
+
+class HTTPMetricsTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+
+    def setup_network(self):
+        self.public_port = p2p_port(PUBLIC_PORT_INDEX)
+        self.extra_args = [
+            [
+                "-metrics",
+                "-trustedproxy=127.0.0.1",
+                f"-publicbind=127.0.0.1:{self.public_port}",
+            ],
+            # node1 peers with node0 over P2P WebSocket
+            [f"-addnode=ws://127.0.0.1:{self.public_port}/p2p/ws"],
+        ]
+        self.add_nodes(self.num_nodes, self.extra_args)
+        # node0's public listener first, so node1's first dial succeeds
+        self.start_node(0)
+        self.start_node(1)
+
+    def request(self, port, path="/metrics", method="GET", headers=None):
+        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=30)
+        conn.request(method, path, headers=headers or {})
+        res = conn.getresponse()
+        body = res.read().decode()
+        conn.close()
+        return res, body
+
+    def scrape(self):
+        res, body = self.request(rpc_port(0))
+        assert_equal(res.status, 200)
+        assert_equal(
+            res.getheader("Content-Type"),
+            "text/plain; version=0.0.4; charset=utf-8",
+        )
+        return parse(body)
+
+    def total(self, samples, name, **labels):
+        """Sum of a metric's series matching the given labels"""
+        return sum(
+            v
+            for (n, ls), v in samples.items()
+            if n == name and all(dict(ls).get(k) == w for k, w in labels.items())
+        )
+
+    def run_test(self):
+        node = self.nodes[0]
+        self.log.info("The exposition is well formed")
+        samples = self.scrape()
+        assert_equal(samples[("lotus_metrics_dropped_samples_total", ())], 0)
+
+
+
+        self.log.info("HTTP and RPC requests")
+        node.getblockcount()
+        self.request(rpc_port(0), path="/livez")
+        with socket.create_connection(("127.0.0.1", rpc_port(0))) as raw:
+            ctx = ssl.create_default_context()
+            ctx.check_hostname = False
+            ctx.verify_mode = ssl.CERT_NONE
+            with ctx.wrap_socket(raw):
+                pass
+        time.sleep(1.1)  # past the rendering cache
+        samples = self.scrape()
+        assert self.total(samples, "lotus_http_requests_total",
+                          endpoint="rpc", code="2xx") > 0
+        assert self.total(samples, "lotus_http_requests_total",
+                          endpoint="health", code="2xx") >= 1
+        assert self.total(samples, "lotus_http_requests_total",
+                          endpoint="metrics", code="2xx") >= 1
+        assert self.total(samples, "lotus_http_request_duration_seconds_count",
