+namespace {
+bool VerifyBatchSlice(std::span<const BatchSigItem> slice) {
+    if (slice.empty()) return true;
+    if (slice.size() == 1) {
+        return secp256k1_schnorrsig_verify(
+                   secp256k1_context_static, slice[0].sig.data(),
+                   slice[0].msg.data(), slice[0].msg.size(),
+                   reinterpret_cast<const secp256k1_xonly_pubkey *>(
+                       slice[0].parsed_pubkey.data())) == 1;
+    }
+    const size_t n = slice.size();
+    std::vector<const unsigned char *> sigs(n);
+    std::vector<const unsigned char *> msgs(n);
+    std::vector<const secp256k1_xonly_pubkey *> pubkeys(n);
+
+    static std::atomic<uint64_t> batch_nonce{1};
+    const uint64_t nonce_val =
+        batch_nonce.fetch_add(1, std::memory_order_relaxed);
+    const uint64_t clock_val = static_cast<uint64_t>(
+        std::chrono::steady_clock::now().time_since_epoch().count());
+    const uintptr_t addr_val = reinterpret_cast<uintptr_t>(slice.data());
+
+    CSHA256 hasher;
+    constexpr char domain[] = "Lotus/v2/schnorr-batch-randomizer";
+    hasher.Write(reinterpret_cast<const uint8_t *>(domain), sizeof(domain));
+    hasher.Write(reinterpret_cast<const uint8_t *>(&nonce_val),
+                 sizeof(nonce_val));
+    hasher.Write(reinterpret_cast<const uint8_t *>(&clock_val),
+                 sizeof(clock_val));
+    hasher.Write(reinterpret_cast<const uint8_t *>(&addr_val),
+                 sizeof(addr_val));
+
+    for (size_t i = 0; i < n; ++i) {
+        sigs[i] = slice[i].sig.data();
+        msgs[i] = slice[i].msg.data();
+        pubkeys[i] = reinterpret_cast<const secp256k1_xonly_pubkey *>(
+            slice[i].parsed_pubkey.data());
+        hasher.Write(slice[i].pubkey.data(), slice[i].pubkey.size());
+        hasher.Write(slice[i].sig.data(), slice[i].sig.size());
+        hasher.Write(slice[i].msg.data(), slice[i].msg.size());
+    }
+
+    uint8_t seed[CSHA256::OUTPUT_SIZE];
+    hasher.Finalize(seed);
+
+    CSHA256 expand_base;
+    expand_base.Write(seed, CSHA256::OUTPUT_SIZE);
+    expand_base.Write(seed, CSHA256::OUTPUT_SIZE);
+
+    std::vector<unsigned char> rand32(32 * n, 0);
+    for (size_t i = 1; i < n; ++i) {
+        const uint64_t ctr = static_cast<uint64_t>(i);
+        CSHA256 h = expand_base;
+        h.Write(reinterpret_cast<const uint8_t *>(&ctr), sizeof(ctr));
+        h.Finalize(rand32.data() + 32 * i);
+    }
+
+    return secp256k1_schnorrsig_verify_batch(
+               secp256k1_context_static, sigs.data(), msgs.data(),
+               pubkeys.data(), rand32.data(), n) == 1;
+}
