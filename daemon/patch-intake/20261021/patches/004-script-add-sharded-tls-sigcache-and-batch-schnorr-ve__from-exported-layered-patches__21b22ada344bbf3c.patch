+++ b/src/lotus_v2/commitment.h
@@ -0,0 +1,60 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_COMMITMENT_H
+#define LOTUS_V2_COMMITMENT_H
+
+#include "header.h"
+
+#include <array>
+#include <cstdint>
+#include <span>
+
+namespace lotus::v2 {
+
+// Inputs are canonical serialized P01 components supplied by the transaction
+// codec. These functions hash bytes; they do not validate their grammar.
+Hash InputCoreLeaf(std::span<const uint8_t> encoded_input_core);
+Hash InputFullLeaf(std::span<const uint8_t> encoded_input);
+Hash OutputLeaf(std::span<const uint8_t> serialized_output);
+Hash CoinEntryLeaf(std::span<const uint8_t> serialized_resolved_output);
+Hash BranchLeaf(std::span<const uint8_t> script);
+Hash BranchNode(const Hash &a, const Hash &b);
+Hash BranchProofRoot(const Hash &leaf, std::span<const Hash> bottom_up_siblings);
+
+Hash IndexedNode(uint16_t layer, const Hash &left, const Hash &right);
+Hash IndexedTreeRoot(std::span<const Hash> leaves);
+// Proof contains one sibling per layer. Missing right children must be zero.
+bool IndexedProofRoot(const Hash &leaf, uint32_t index, uint32_t count,
+                      std::span<const Hash> bottom_up_siblings, Hash &out);
+
+using TxHeaderCore = std::array<uint8_t, 16>;
+Hash TransactionId(const ChainId &chain_id, const TxHeaderCore &header_core,
+                   const Hash &inputs_root, const Hash &outputs_root);
+Hash TransactionHash(const ChainId &chain_id, const TxHeaderCore &header_core,
+                     const Hash &full_inputs_root, const Hash &outputs_root);
+
+struct TxIdentityPair {
+    Hash tx_hash;
+    Hash tx_id;
+};
+// Defined for the empty vector as a tool primitive. Block validity requires
+// a coinbase and imposes its own transaction-count limit.
+bool TransactionRoot(std::span<const TxIdentityPair> transactions, Hash &out);
+// Optimization (rolled into initial commitment primitives): expose O(1)
+// Subtree A root and coinbase-combining helpers so block assembly, sealed
+// header relay (sealedheader), and RCU mining snapshots reuse precomputed
+// non-coinbase Subtree A roots without O(N) transaction tree rebuilds.
+Hash TransactionSubtreeARoot(
+    std::span<const TxIdentityPair> non_coinbase_transactions);
+Hash TransactionRootFromSubtreeA(const TxIdentityPair &coinbase_tx,
+                                 const Hash &subtree_a_root);
+
+// Precompute the depth-0 SubtreeA Merklix root over non-coinbase transactions.
+Hash BuildTxSubtreeA(std::span<const TxIdentityPair> non_coinbase_transactions);
+
+// Combine a coinbase transaction identity pair with a precomputed SubtreeA root
+// in O(1) (single tagged SHA-256 leaf + root hash).
+Hash CombineCoinbaseAndSubtreeA(const TxIdentityPair &coinbase_tx,
+                                const Hash &subtree_a_root);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/header.cpp b/src/lotus_v2/header.cpp
new file mode 100644
index 0000000000..662d63aaa9
--- /dev/null
+++ b/src/lotus_v2/header.cpp
@@ -0,0 +1,138 @@
+#include "header.h"
+#include "tagged_hash.h"
+
+#include <algorithm>
+#include <array>
+
+namespace lotus::v2 {
+namespace {
+
+template <size_t N> void PutLE(std::array<uint8_t, N> &out, size_t pos,
+                              uint64_t value, size_t bytes) {
+    for (size_t i = 0; i < bytes; ++i) {
+        out[pos + i] = static_cast<uint8_t>(value >> (8 * i));
+    }
+}
+
+uint64_t ReadLE(const uint8_t *data, size_t bytes) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < bytes; ++i) {
+        value |= uint64_t{data[i]} << (8 * i);
+    }
+    return value;
+}
+
+uint32_t EncodeTarget(const Hash &target) {
+    int top = 31;
+    while (top >= 0 && target[top] == 0) {
+        --top;
+    }
+    if (top < 0) return 0;
+    uint32_t exponent = static_cast<uint32_t>(top + 1);
+    uint32_t mantissa = 0;
+    if (exponent <= 3) {
+        for (int i = top; i >= 0; --i) mantissa = (mantissa << 8) | target[i];
+        mantissa <<= 8 * (3 - exponent);
+    } else {
+        mantissa = (uint32_t{target[top]} << 16) |
+                   (uint32_t{target[top - 1]} << 8) | target[top - 2];
+    }
+    if (mantissa & 0x00800000U) {
+        mantissa >>= 8;
+        ++exponent;
+    }
+    return (exponent << 24) | mantissa;
+}
+
+} // namespace
+
+bool SerializeHeader(const Header &h, std::array<uint8_t, HEADER_SIZE> &out) {
+    if (h.time > MAX_TIME) return false;
+    std::copy(h.prev_id.begin(), h.prev_id.end(), out.begin());
+    PutLE(out, 32, h.bits, 4);
+    PutLE(out, 36, h.time, 6);
+    PutLE(out, 42, h.nonce, 8);
+    PutLE(out, 50, h.version, 4);
+    PutLE(out, 54, h.size, 8);
+    PutLE(out, 62, h.height, 8);
+    std::copy(h.tx_root.begin(), h.tx_root.end(), out.begin() + 70);
+    std::copy(h.state_root.begin(), h.state_root.end(), out.begin() + 102);
+    return true;
+}
+
+bool ParseHeader(const uint8_t *data, size_t size, Header &out) {
+    if (data == nullptr || size != HEADER_SIZE) return false;
+    Header parsed;
+    std::copy_n(data, 32, parsed.prev_id.begin());
+    parsed.bits = static_cast<uint32_t>(ReadLE(data + 32, 4));
+    parsed.time = ReadLE(data + 36, 6);
+    parsed.nonce = ReadLE(data + 42, 8);
+    parsed.version = static_cast<uint32_t>(ReadLE(data + 50, 4));
+    parsed.size = ReadLE(data + 54, 8);
+    parsed.height = ReadLE(data + 62, 8);
+    std::copy_n(data + 70, 32, parsed.tx_root.begin());
+    std::copy_n(data + 102, 32, parsed.state_root.begin());
+    out = parsed;
+    return true;
+}
+
+Hash BodyHash(const ChainId &chain_id, const Header &header) {
+    std::array<uint8_t, 116> body{};
+    std::copy(chain_id.begin(), chain_id.end(), body.begin());
+    PutLE(body, 32, header.version, 4);
+    PutLE(body, 36, header.size, 8);
+    PutLE(body, 44, header.height, 8);
+    std::copy(header.tx_root.begin(), header.tx_root.end(), body.begin() + 52);
+    std::copy(header.state_root.begin(), header.state_root.end(), body.begin() + 84);
+    return TaggedHash(HashDomain::HeaderBody, body);
+}
+
+bool WorkHash(const ChainId &chain_id, const Header &header, Hash &out) {
+    if (header.time > MAX_TIME) return false;
+    std::array<uint8_t, 50> work{};
+    PutLE(work, 0, header.bits, 4);
+    PutLE(work, 4, header.time, 6);
+    PutLE(work, 10, header.nonce, 8);
+    const Hash body_hash = BodyHash(chain_id, header);
+    std::copy(body_hash.begin(), body_hash.end(), work.begin() + 18);
+    out = TaggedHash(HashDomain::HeaderWork, work);
+    return true;
+}
+
+bool BlockId(const ChainId &chain_id, const Header &header, Hash &out) {
+    if (header.time > MAX_TIME) return false;
+    std::array<uint8_t, 64> input{};
+    std::copy(header.prev_id.begin(), header.prev_id.end(), input.begin());
+    Hash work_hash;
+    WorkHash(chain_id, header, work_hash);
+    std::copy(work_hash.begin(), work_hash.end(), input.begin() + 32);
+    out = TaggedHash(HashDomain::BlockId, input);
+    return true;
+}
+
+bool MeetsTarget(const Hash &block_id, const Hash &target) {
+    for (int i = 31; i >= 0; --i) {
+        if (block_id[i] < target[i]) return true;
+        if (block_id[i] > target[i]) return false;
+    }
+    return true;
+}
+
+bool DecodeTarget(uint32_t bits, const Hash &pow_limit, Hash &target) {
+    const uint32_t exponent = bits >> 24;
+    const uint32_t mantissa = bits & 0x007fffffU;
+    if ((bits & 0x00800000U) || mantissa == 0) return false;
+    Hash decoded{};
+    for (unsigned i = 0; i < 3; ++i) {
+        const int position = static_cast<int>(exponent) - 3 + static_cast<int>(i);
+        const uint8_t byte = static_cast<uint8_t>(mantissa >> (8 * i));
+        if (position >= 32 && byte != 0) return false;
+        if (position >= 0 && position < 32) decoded[position] = byte;
+    }
+    if (std::all_of(decoded.begin(), decoded.end(), [](uint8_t b) { return b == 0; })) return false;
+    if (EncodeTarget(decoded) != bits || !MeetsTarget(decoded, pow_limit)) return false;
+    target = decoded;
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/header.h b/src/lotus_v2/header.h
new file mode 100644
index 0000000000..fadef5388c
--- /dev/null
+++ b/src/lotus_v2/header.h
@@ -0,0 +1,48 @@
+// Copyright (c) 2026 The Lotus developers
+// Candidate V2 header primitives. No legacy block type depends on this file.
+#ifndef LOTUS_V2_HEADER_H
+#define LOTUS_V2_HEADER_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace lotus::v2 {
+
+using Hash = std::array<uint8_t, 32>;
+using ChainId = Hash;
+constexpr size_t HEADER_SIZE = 134;
+constexpr uint64_t MAX_TIME = (uint64_t{1} << 48) - 1;
+constexpr uint32_t kHeaderVersion = 2;
+
+struct Header {
+    Hash prev_id{};
+    uint32_t bits{};
+    uint64_t time{};
+    uint64_t nonce{};
+    uint32_t version{};
+    uint64_t size{};
+    uint64_t height{};
+    Hash tx_root{};
+    Hash state_root{};
+};
+
+// Hash byte arrays retain digest order. Interpret them as little-endian
+// unsigned integers only for PoW target comparison.
+bool SerializeHeader(const Header &header, std::array<uint8_t, HEADER_SIZE> &out);
+// Structural parse only. Caller validates version, height, target, size,
+// roots, time eligibility and parent against its chain manifest and context.
+bool ParseHeader(const uint8_t *data, size_t size, Header &out);
+Hash BodyHash(const ChainId &chain_id, const Header &header);
+bool WorkHash(const ChainId &chain_id, const Header &header, Hash &out);
+bool BlockId(const ChainId &chain_id, const Header &header, Hash &out);
+
+// Decode only canonical positive compact targets at or below pow_limit.
+// pow_limit is a 32-byte little-endian unsigned integer. Failure leaves
+// target unchanged. The parser and work/block hash functions likewise leave
+// their outputs unchanged on failure.
+bool DecodeTarget(uint32_t bits, const Hash &pow_limit, Hash &target);
+bool MeetsTarget(const Hash &block_id, const Hash &target);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/output.cpp b/src/lotus_v2/output.cpp
new file mode 100644
index 0000000000..af20524be5
--- /dev/null
+++ b/src/lotus_v2/output.cpp
@@ -0,0 +1,270 @@
+#include "output.h"
+
+#include <algorithm>
+#include <limits>
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+
+    class Reader {
+    public:
+        explicit Reader(const std::vector<uint8_t> &bytes) : bytes_(bytes) {}
+
+        size_t Remaining() const { return bytes_.size() - offset_; }
+        bool Finished() const { return Remaining() == 0; }
+
+        bool Take(size_t count, const uint8_t *&start) {
+            if (count > Remaining()) return false;
+            start = bytes_.data() + offset_;
+            offset_ += count;
+            return true;
+        }
+
+        bool Integer(size_t width, uint64_t &value) {
+            if (width == 0 || width > 8) return false;
+            const uint8_t *start = nullptr;
+            if (!Take(width, start)) return false;
+            value = 0;
+            for (size_t i = 0; i < width; ++i)
+                value |= uint64_t(start[i]) << (8 * i);
+            return true;
+        }
+
+        bool CompactSize(uint64_t cap, uint64_t &value) {
+            uint64_t lead;
+            if (!Integer(1, lead)) return false;
+            if (lead < 253)
+                value = lead;
+            else {
+                size_t width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+                if (!Integer(width, value)) return false;
+                if (value < (width == 2   ? 253ULL
+                             : width == 4 ? 65536ULL
+                                          : 4294967296ULL))
+                    return false;
+            }
+            return value <= cap;
+        }
+
+    private:
+        const std::vector<uint8_t> &bytes_;
+        size_t offset_ = 0;
+    };
+
+    void AppendInteger(uint64_t value, size_t width,
+                       std::vector<uint8_t> &out) {
+        for (size_t i = 0; i < width; ++i)
+            out.push_back(uint8_t(value >> (8 * i)));
+    }
+
+    void AppendCompactSize(uint64_t value, std::vector<uint8_t> &out) {
+        if (value < 253)
+            AppendInteger(value, 1, out);
+        else if (value <= 65535) {
+            out.push_back(253);
+            AppendInteger(value, 2, out);
+        } else if (value <= 4294967295ULL) {
+            out.push_back(254);
+            AppendInteger(value, 4, out);
+        } else {
+            out.push_back(255);
+            AppendInteger(value, 8, out);
+        }
+    }
+
+    bool Valid(const Output &output, std::string &error) {
+        if (output.flags & 0xfc) {
+            error = "flags";
+            return false;
+        }
+        if (output.HasToken()) {
+            if (output.token_id == Hash32{}) {
+                error = "zero token";
+                return false;
+            }
+        } else if (output.token_id != Hash32{}) {
+            error = "native token field";
+            return false;
+        }
+        if (output.branches.empty() ||
+            output.branches.size() > MAX_OUTPUT_BRANCHES) {
+            error = "branch count";
+            return false;
+        }
+        for (size_t i = 0; i < output.branches.size(); ++i) {
+            for (size_t j = 0; j < i; ++j) {
+                if (output.branches[i] == output.branches[j]) {
+                    error = "duplicate branch";
+                    return false;
+                }
+            }
+        }
+        if (output.IsBurn()) {
+            if (!output.paths.empty()) {
+                error = "burn paths";
+                return false;
+            }
+        } else if (output.paths.empty() ||
+                   output.paths.size() > MAX_OUTPUT_PATHS) {
+            error = "path count";
+            return false;
+        }
+        for (size_t p = 0; p < output.paths.size(); ++p) {
+            const auto &path = output.paths[p];
+            if (path.empty() || path.size() > output.branches.size()) {
+                error = "path length";
+                return false;
+            }
+            for (size_t i = 0; i < path.size(); ++i) {
+                if (path[i] >= output.branches.size() ||
+                    (i && path[i - 1] >= path[i])) {
+                    error = "path index";
+                    return false;
+                }
+            }
+            if (p && !(output.paths[p - 1] < path)) {
+                error = "path order";
+                return false;
+            }
+        }
+        return true;
+    }
+
+} // namespace
+
+bool DecodeOutput(const std::vector<uint8_t> &frame, Output &result,
+                  std::string &error) {
+    if (frame.size() > MAX_OUTPUT_BYTES) {
+        error = "output bytes";
+        return false;
+    }
+    Reader reader(frame);
+    Output parsed;
+    uint64_t value;
+    if (!reader.Integer(1, value)) {
+        error = "truncated flags";
+        return false;
+    }
+    parsed.flags = uint8_t(value);
+    if (parsed.flags & 0xfc) {
+        error = "flags";
+        return false;
+    }
+    if (!reader.Integer(8, parsed.value)) {
+        error = "truncated value";
+        return false;
+    }
+    if (parsed.HasToken()) {
+        const uint8_t *token;
+        if (!reader.Take(32, token)) {
+            error = "truncated token";
+            return false;
+        }
+        std::copy_n(token, 32, parsed.token_id.begin());
+    }
+    uint64_t count;
+    if (!reader.CompactSize(MAX_OUTPUT_BRANCHES, count)) {
+        error = "branch count";
+        return false;
+    }
+    // Division avoids host-width multiplication overflow before reserving
+    // storage.
+    if (count > reader.Remaining() / 32) {
+        error = "truncated branches";
+        return false;
+    }
+    parsed.branches.reserve(size_t(count));
+    for (uint64_t i = 0; i < count; ++i) {
+        const uint8_t *branch;
+        if (!reader.Take(32, branch)) {
+            error = "truncated branches";
+            return false;
+        }
+        Hash32 root;
+        std::copy_n(branch, 32, root.begin());
+        parsed.branches.push_back(root);
+    }
+    if (!reader.CompactSize(MAX_OUTPUT_PATHS, count)) {
+        error = "path count";
+        return false;
+    }
+    if (count > reader.Remaining()) {
+        error = "truncated paths";
+        return false;
+    }
+    parsed.paths.reserve(size_t(count));
+    for (uint64_t p = 0; p < count; ++p) {
+        uint64_t length;
+        if (!reader.CompactSize(MAX_OUTPUT_BRANCHES, length)) {
+            error = "path length";
+            return false;
+        }
+        if (length > reader.Remaining()) {
+            error = "truncated path";
+            return false;
+        }
+        std::vector<uint8_t> path;
+        path.reserve(size_t(length));
+        for (uint64_t i = 0; i < length; ++i) {
+            uint64_t index;
+            if (!reader.CompactSize(MAX_OUTPUT_BRANCHES - 1, index)) {
+                error = "path index";
+                return false;
+            }
+            path.push_back(uint8_t(index));
+        }
+        parsed.paths.push_back(std::move(path));
+    }
+    if (!reader.Finished()) {
+        error = "trailing bytes";
+        return false;
+    }
+    if (!Valid(parsed, error)) return false;
+    result = std::move(parsed);
+    error.clear();
+    return true;
+}
+
+bool ComputeOutputSerializedSize(const Output &output, size_t &size,
+                                 std::string &error) {
+    if (!Valid(output, error)) return false;
+    size_t total = 1 + 8 + (output.HasToken() ? 32 : 0) + 1 +
+                   output.branches.size() * 32 + 1;
+    for (const auto &path : output.paths) {
+        total += 1 + path.size();
+    }
+    if (total > MAX_OUTPUT_BYTES) {
+        error = "output bytes";
+        return false;
+    }
+    size = total;
+    error.clear();
+    return true;
+}
+
+bool EncodeOutput(const Output &output, std::vector<uint8_t> &result,
+                  std::string &error) {
+    size_t exact_size = 0;
+    if (!ComputeOutputSerializedSize(output, exact_size, error)) return false;
+    result.clear();
+    result.reserve(exact_size);
+    result.push_back(output.flags);
+    AppendInteger(output.value, 8, result);
+    if (output.HasToken())
+        result.insert(result.end(), output.token_id.begin(),
+                      output.token_id.end());
+    AppendCompactSize(output.branches.size(), result);
+    for (const auto &branch : output.branches)
+        result.insert(result.end(), branch.begin(), branch.end());
+    AppendCompactSize(output.paths.size(), result);
+    for (const auto &path : output.paths) {
+        AppendCompactSize(path.size(), result);
+        for (uint8_t index : path)
+            AppendCompactSize(index, result);
+    }
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/output.h b/src/lotus_v2/output.h
new file mode 100644
index 0000000000..98819170f5
--- /dev/null
+++ b/src/lotus_v2/output.h
@@ -0,0 +1,43 @@
+// Candidate Lotus V2 output wire codec. No transaction validation is implied.
+#ifndef LOTUS_V2_OUTPUT_H
+#define LOTUS_V2_OUTPUT_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+
+using Hash32 = std::array<uint8_t, 32>;
+
+// P01 hard bounds. Any stricter deployment profile must be checked by its
+// caller.
+constexpr size_t MAX_OUTPUT_BRANCHES = 16;
+constexpr size_t MAX_OUTPUT_PATHS = 16;
+constexpr size_t MAX_OUTPUT_BYTES = 812;
+
+struct Output {
+    uint8_t flags = 0;
+    uint64_t value = 0;
+    Hash32 token_id{};
+    std::vector<Hash32> branches;
+    std::vector<std::vector<uint8_t>> paths;
+
+    bool HasToken() const { return (flags & 1) != 0; }
+    bool IsBurn() const { return (flags & 2) != 0; }
+};
+
+// Decode consumes exactly one output frame; any trailing byte is invalid.
+// On failure, result is unchanged and error gives a stable category string.
+bool DecodeOutput(const std::vector<uint8_t> &frame, Output &result,
+                  std::string &error);
+bool EncodeOutput(const Output &output, std::vector<uint8_t> &result,
+                  std::string &error);
+bool ComputeOutputSerializedSize(const Output &output, size_t &size,
+                                 std::string &error);
+
+} // namespace lotus::v2
+
+#endif
diff --git a/src/lotus_v2/signing.cpp b/src/lotus_v2/signing.cpp
new file mode 100644
index 0000000000..8fdcfc2026
--- /dev/null
+++ b/src/lotus_v2/signing.cpp
@@ -0,0 +1,995 @@
+#include "signing.h"
+
+#include "tagged_hash.h"
+#include <crypto/sha256.h>
+
+#include "../support/cleanse.h"
+
+#include <secp256k1.h>
+#include <secp256k1_extrakeys.h>
+#include <secp256k1_schnorr.h>
+#include <secp256k1_schnorrsig.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+namespace lotus::v2 {
+namespace {
+
+    void Integer(uint64_t value, size_t width, std::vector<uint8_t> &out) {
+        for (size_t i = 0; i < width; ++i)
+            out.push_back(uint8_t(value >> (8 * i)));
+    }
+
+    void CompactSize(uint64_t value, std::vector<uint8_t> &out) {
+        if (value < 253)
+            Integer(value, 1, out);
+        else if (value <= 65535) {
+            out.push_back(253);
+            Integer(value, 2, out);
+        } else if (value <= 4294967295ULL) {
+            out.push_back(254);
+            Integer(value, 4, out);
+        } else {
+            out.push_back(255);
+            Integer(value, 8, out);
+        }
+    }
+
+    bool OutputBytes(const Output &output, std::vector<uint8_t> &out,
+                     std::string &error) {
+        return EncodeOutput(output, out, error);
+    }
+
+    bool ResolvedValid(const Transaction &tx, const ResolvedCoins &resolved,
+                       std::string &error) {
+        if (resolved.size() != tx.inputs.size()) {
+            error = "resolved count";
+            return false;
+        }
+        for (size_t i = 0; i < tx.inputs.size(); ++i) {
+            if (tx.inputs[i].flags != 1 && tx.inputs[i].flags != 3) {
+                error = "unsupported input kind for signing";
+                return false;
+            }
+            if (tx.inputs[i].flags == 1 &&
+                (!resolved[i] || resolved[i]->IsBurn())) {
+                error = "spend resolved coin";
+                return false;
+            }
+            if (tx.inputs[i].flags == 3 && resolved[i]) {
+                error = "mint resolved coin";
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool NonzeroDelta(const PositiveDelta &delta) {
+        return std::any_of(delta.begin(), delta.end(),
+                           [](uint8_t byte) { return byte != 0; });
+    }
+
+    bool OwnInputHashFromCoinWire(const Input &input, const TxProfile &profile,
+                                  const std::vector<uint8_t> &coin_wire,
+                                  std::vector<uint8_t> &core, Hash &result,
+                                  std::string &error) {
+        core.clear();
+        if (!EncodeInputCore(input, profile, core, error))
+            return false;
+        CompactSize(coin_wire.size(), core);
+        core.insert(core.end(), coin_wire.begin(), coin_wire.end());
+        result = TaggedHash(HashDomain::OwnInput, core);
+        error.clear();
+        return true;
+    }
+
+    bool OwnInputHashOf(const Input &input, const TxProfile &profile,
+                        const Output &coin, Hash &result, std::string &error) {
+        std::vector<uint8_t> core, wire;
+        if (!OutputBytes(coin, wire, error))
+            return false;
+        return OwnInputHashFromCoinWire(input, profile, wire, core, result,
+                                        error);
+    }
+
+    bool WitnessIsPureMode0Checksig(const BranchWitness &w) noexcept {
+        return w.script.size() == 34 && w.script[0] == 0x20 &&
+               (w.script[33] == 0xbb || w.script[33] == 0xbc) &&
+               w.arguments.size() == 1 &&
+               (w.arguments[0].size() == 64 ||
+                (w.arguments[0].size() == 65 && w.arguments[0][64] == 0));
+    }
+
+    bool WitnessIsMode0Or1Checksig(const BranchWitness &w) noexcept {
+        return w.script.size() == 34 && w.script[0] == 0x20 &&
+               (w.script[33] == 0xbb || w.script[33] == 0xbc) &&
+               w.arguments.size() == 1 &&
+               (w.arguments[0].size() == 64 ||
+                (w.arguments[0].size() == 65 && w.arguments[0][64] <= 1));
+    }
+
+    bool InputIsPureMode0Checksig(const Input &input) noexcept {
+        if (input.flags != 1 || input.witnesses.empty()) return false;
+        for (const auto &w : input.witnesses) {
+            if (!WitnessIsPureMode0Checksig(w)) return false;
+        }
+        return true;
+    }
+
+    bool InputMayUseMode2(const Input &input) noexcept {
+        if (input.flags != 1 || input.witnesses.empty()) return false;
+        for (const auto &w : input.witnesses) {
+            if (!WitnessIsMode0Or1Checksig(w)) return true;
+        }
+        return false;
+    }
+
+    bool TxIsPureMode0Checksig(const Transaction &tx) noexcept {
+        if (tx.inputs.empty()) return false;
+        for (const auto &in : tx.inputs) {
+            if (!InputIsPureMode0Checksig(in)) return false;
+        }
+        return true;
+    }
+
+} // namespace
+
+bool ComputeIdentitiesValidated(const Transaction &tx,
+                                const TxProfile &profile,
+                                const ChainId &chain_id,
+                                IdentityDigests &result, std::string &error) {
+    std::vector<Hash> core_leaves, full_leaves;
+    core_leaves.reserve(tx.inputs.size());
+    full_leaves.reserve(tx.inputs.size());
+    std::vector<uint8_t> core, full;
+    for (const auto &input : tx.inputs) {
+        core.clear();
+        full.clear();
+        if (!EncodeInputCore(input, profile, core, error) ||
+            !EncodeInputFull(input, profile, full, error))
+            return false;
+        core_leaves.push_back(InputCoreLeaf(core));
+        full_leaves.push_back(InputFullLeaf(full));
+    }
+    IdentityDigests computed;
+    computed.inputs_root = IndexedTreeRoot(core_leaves);
+    computed.full_inputs_root = IndexedTreeRoot(full_leaves);
+    computed.output_leaves.reserve(tx.outputs.size());
+    std::vector<uint8_t> wire;
+    for (const auto &output : tx.outputs) {
+        wire.clear();
+        if (!OutputBytes(output, wire, error)) return false;
+        computed.output_leaves.push_back(OutputLeaf(wire));
+    }
+    computed.outputs_root = IndexedTreeRoot(computed.output_leaves);
+    TxHeaderCore header{};
+    header[0] = 7;
+    for (size_t i = 0; i < 8; ++i)
+        header[4 + i] = uint8_t(tx.lock >> (8 * i));
+    header[12] = uint8_t(tx.inputs.size());
+    header[13] = uint8_t(tx.inputs.size() >> 8);
+    header[14] = uint8_t(tx.outputs.size());
+    header[15] = uint8_t(tx.outputs.size() >> 8);
+    computed.txid = TransactionId(chain_id, header, computed.inputs_root,
+                                  computed.outputs_root);
+    computed.txhash = TransactionHash(
+        chain_id, header, computed.full_inputs_root, computed.outputs_root);
+    result = std::move(computed);
+    error.clear();
+    return true;
+}
+
+bool ComputeOutputIdentitiesOnly(const Transaction &tx, const Hash &known_txid,
+                                 const Hash &known_txhash,
+                                 IdentityDigests &result, std::string &error) {
+    IdentityDigests computed{};
+    computed.txid = known_txid;
+    computed.txhash = known_txhash;
+    if (!TxIsPureMode0Checksig(tx)) {
+        computed.output_leaves.reserve(tx.outputs.size());
+        std::vector<uint8_t> wire;
+        for (const auto &output : tx.outputs) {
+            wire.clear();
+            if (!OutputBytes(output, wire, error)) return false;
+            computed.output_leaves.push_back(OutputLeaf(wire));
+        }
+        computed.outputs_root = IndexedTreeRoot(computed.output_leaves);
+    }
+    result = std::move(computed);
+    error.clear();
+    return true;
+}
+
+bool ComputeIdentities(const Transaction &tx, const TxProfile &profile,
+                       const ChainId &chain_id, IdentityDigests &result,
+                       std::string &error) {
+    std::vector<uint8_t> validated_wire;
+    if (!EncodeTransaction(tx, profile, validated_wire, error)) return false;
+    return ComputeIdentitiesValidated(tx, profile, chain_id, result, error);
+}
+
+bool ComputeCoinsRoot(const Transaction &tx, const ResolvedCoins &resolved,
+                      Hash &result, std::string &error) {
+    if (!ResolvedValid(tx, resolved, error)) return false;
+    std::vector<Hash> leaves;
+    leaves.reserve(tx.inputs.size());
+    std::vector<uint8_t> wire;
+    for (size_t i = 0; i < tx.inputs.size(); ++i) {
+        if (tx.inputs[i].flags == 3)
+            leaves.push_back(CoinEntryLeaf({}));
+        else {
+            wire.clear();
+            if (!OutputBytes(*resolved[i], wire, error)) return false;
+            leaves.push_back(CoinEntryLeaf(wire));
+        }
+    }
+    result = IndexedTreeRoot(leaves);
+    error.clear();
+    return true;
+}
+
+bool ComputeOwnInputHash(const Transaction &tx, const TxProfile &profile,
+                         const ResolvedCoins &resolved, size_t input_index,
+                         Hash &result, std::string &error) {
+    if (!ResolvedValid(tx, resolved, error) ||
+        input_index >= tx.inputs.size() || tx.inputs[input_index].flags != 1) {
+        error = "own input spend";
+        return false;
+    }
+    return OwnInputHashOf(tx.inputs[input_index], profile,
+                          *resolved[input_index], result, error);
+}
+
+SigningPreparationStatus PrepareSigningContextChecked(
+    const Transaction &tx, const TxProfile &profile, const ChainId &chain_id,
+    const ResolvedCoins &resolved, PreparedSigningContext &result,
+    std::string &error, const IdentityDigests *precomputed_identities) {
+    try {
+        IdentityDigests computed_ids;
+        const IdentityDigests *ids = precomputed_identities;
+        if (ids == nullptr) {
+            if (!ComputeIdentities(tx, profile, chain_id, computed_ids, error))
+                return SigningPreparationStatus::OperationalError;
+            ids = &computed_ids;
+        }
+        if (!ResolvedValid(tx, resolved, error))
+            return SigningPreparationStatus::OperationalError;
+
+        PreparedSigningContext prepared;
+        prepared.chain_id_ = chain_id;
+        prepared.lock_ = tx.lock;
+        prepared.identities_ = *ids;
+        prepared.txid_ = ids->txid;
+        prepared.outputs_root_ = ids->outputs_root;
+        prepared.output_leaves_ = ids->output_leaves;
+        prepared.own_input_hashes_.resize(tx.inputs.size());
+        prepared.invocations_.resize(tx.inputs.size());
+
+        std::vector<Hash> coin_leaves;
+        coin_leaves.reserve(tx.inputs.size());
+        std::vector<uint8_t> coin_wire, core;
+
+        for (size_t i = 0; i < tx.inputs.size(); ++i) {
+            const Input &input = tx.inputs[i];
+            auto &invocations = prepared.invocations_[i];
+            if (input.flags == 1) {
+                const Output &coin = *resolved[i];
+                if (input.path_index >= coin.paths.size() ||
+                    input.witnesses.size() !=
+                        coin.paths[input.path_index].size()) {
+                    error = "positional witness count/index";
+                    return SigningPreparationStatus::InvalidWitness;
+                }
+                coin_wire.clear();
+                if (!OutputBytes(coin, coin_wire, error))
+                    return SigningPreparationStatus::OperationalError;
+                coin_leaves.push_back(CoinEntryLeaf(coin_wire));
+                if (precomputed_identities == nullptr ||
+                    !InputIsPureMode0Checksig(input)) {
+                    if (!OwnInputHashFromCoinWire(
+                            input, profile, coin_wire, core,
+                            prepared.own_input_hashes_[i].emplace(), error))
+                        return SigningPreparationStatus::OperationalError;
+                    if (i < tx.outputs.size() &&
+                        ids->output_leaves.empty() &&
+                        InputMayUseMode2(input)) {
+                        if (prepared.output_leaves_.empty()) {
+                            prepared.output_leaves_.resize(tx.outputs.size());
+                        }
+                        core.clear();
+                        if (!OutputBytes(tx.outputs[i], core, error))
+                            return SigningPreparationStatus::OperationalError;
+                        prepared.output_leaves_[i] = OutputLeaf(core);
+                    }
+                }
+                const auto &path = coin.paths[input.path_index];
+                invocations.reserve(path.size());
+                for (size_t j = 0; j < path.size(); ++j) {
+                    const uint8_t branch_index = path[j];
+                    const BranchWitness &witness = input.witnesses[j];
+                    const Hash leaf = BranchLeaf(witness.script);
+                    if (branch_index >= coin.branches.size() ||
+                        BranchProofRoot(leaf, witness.siblings) !=
+                            coin.branches[branch_index]) {
+                        error = "branch membership";
+                        return SigningPreparationStatus::InvalidWitness;
+                    }
+                    PreparedSigningContext::Invocation invocation;
+                    invocation.kind = 1;
+                    invocation.selector.reserve(41);
+                    invocation.selector.push_back(1);
+                    Integer(i, 4, invocation.selector);
+                    Integer(branch_index, 4, invocation.selector);
+                    invocation.selector.insert(invocation.selector.end(),
+                                               leaf.begin(), leaf.end());
+                    invocations.push_back(std::move(invocation));
+                }
+            } else if (input.flags == 3) {
+                coin_leaves.push_back(CoinEntryLeaf({}));
+                const BranchWitness &witness = input.witnesses[0];
+                const Hash leaf = BranchLeaf(witness.script);
+                if (BranchProofRoot(leaf, witness.siblings) !=
+                    input.prev_txid) {
+                    error = "mint root";
+                    return SigningPreparationStatus::InvalidWitness;
+                }
+                PreparedSigningContext::Invocation invocation;
+                invocation.kind = 3;
+                invocation.selector.reserve(81);
+                invocation.selector.push_back(3);
+                invocation.selector.insert(invocation.selector.end(),
+                                           input.prev_txid.begin(),
+                                           input.prev_txid.end());
+                invocation.selector.insert(invocation.selector.end(), 16, 0);
+                invocation.selector.insert(invocation.selector.end(),
+                                           leaf.begin(), leaf.end());
+                invocations.push_back(std::move(invocation));
+            }
+        }
+        prepared.coins_root_ = IndexedTreeRoot(coin_leaves);
+        prepared.ready_ = true;
+        result = std::move(prepared);
+        error.clear();
+        return SigningPreparationStatus::Ready;
+    } catch (const std::exception &exception) {
+        error = exception.what();
+        return SigningPreparationStatus::OperationalError;
+    }
+}
+
+bool PrepareSigningContext(const Transaction &tx, const TxProfile &profile,
+                           const ChainId &chain, const ResolvedCoins &coins,
+                           PreparedSigningContext &result, std::string &error) {
+    return PrepareSigningContextChecked(tx, profile, chain, coins, result,
+                                        error) ==
+           SigningPreparationStatus::Ready;
+}
+
+bool SigningMessage(const PreparedSigningContext &prepared, size_t input_index,
+                    size_t witness_index, uint8_t mode,
+                    const std::optional<PositiveDelta> &positive_delta,
+                    Hash &result, std::string &error) {
+    if (!prepared.ready_ || mode > 2 ||
+        input_index >= prepared.invocations_.size() ||
+        witness_index >= prepared.invocations_[input_index].size()) {
+        error = "signing mode or invocation index";
+        return false;
+    }
+    const auto &invocation =
+        prepared.invocations_[input_index][witness_index];
+    if (invocation.kind == 1 && positive_delta) {
+        error = "spend delta";
+        return false;
+    }
+    if (invocation.kind == 3 &&
+        (mode != 0 || !positive_delta || !NonzeroDelta(*positive_delta))) {
+        error = "mint selector delta/mode";
+        return false;
+    }
+    if (mode == 2 && input_index >= prepared.output_leaves_.size()) {
+        error = "partial mode unavailable";
+        return false;
+    }
+    const size_t expected_len =
+        invocation.kind == 3 ? 178 : mode == 0 ? 138 : 150;
+    std::array<uint8_t, 178> preimage{};
+    uint8_t *dst = preimage.data();
+    std::memcpy(dst, prepared.chain_id_.data(), 32);
+    dst += 32;
+    *dst++ = mode;
+    if (mode == 0) {
+        std::memcpy(dst, prepared.txid_.data(), 32);
+        dst += 32;
+        std::memcpy(dst, prepared.coins_root_.data(), 32);
+        dst += 32;
+    } else {
+        if (!prepared.own_input_hashes_[input_index].has_value()) {
+            error = "own input hash unavailable";
+            return false;
+        }
+        dst[0] = 7;
+        dst[1] = 0;
+        dst[2] = 0;
+        dst[3] = 0;
+        dst += 4;
+        for (size_t i = 0; i < 8; ++i) {
+            dst[i] = uint8_t(prepared.lock_ >> (8 * i));
+        }
+        dst += 8;
+        const Hash &own = *prepared.own_input_hashes_[input_index];
+        std::memcpy(dst, own.data(), 32);
+        dst += 32;
+        const Hash &output_commitment = mode == 1
+            ? prepared.outputs_root_ : prepared.output_leaves_[input_index];
+        std::memcpy(dst, output_commitment.data(), 32);
+        dst += 32;
+    }
+    if (invocation.kind == 3) {
+        if (invocation.selector.size() != 81) {
+            error = "sighash preimage width";
+            return false;
+        }
+        std::memcpy(dst, invocation.selector.data(), 33);
+        dst += 33;
+        std::memcpy(dst, positive_delta->data(), 16);
+        dst += 16;
+        std::memcpy(dst, invocation.selector.data() + 49, 32);
+        dst += 32;
+    } else {
+        if (invocation.selector.size() != 41) {
+            error = "sighash preimage width";
+            return false;
+        }
+        std::memcpy(dst, invocation.selector.data(), 41);
+        dst += 41;
+    }
+    if (static_cast<size_t>(dst - preimage.data()) != expected_len) {
+        error = "sighash preimage width";
+        return false;
+    }
+    result = TaggedHash(HashDomain::Sighash,
+                        std::span<const uint8_t>(preimage.data(), expected_len));
+    error.clear();
+    return true;
+}
+
+bool SigningMessage(const Transaction &tx, const TxProfile &profile,
+                    const ChainId &chain_id, const ResolvedCoins &resolved,
+                    size_t input_index, size_t witness_index, uint8_t mode,
+                    const std::optional<PositiveDelta> &positive_delta,
+                    Hash &result, std::string &error) {
+    PreparedSigningContext prepared;
+    if (!PrepareSigningContext(tx, profile, chain_id, resolved, prepared,
+                               error))
+        return false;
+    return SigningMessage(prepared, input_index, witness_index, mode,
+                          positive_delta, result, error);
+}
+
+SignatureStatus VerifyBip340Signature(std::span<const uint8_t> public_key,
+                                      std::span<const uint8_t> signature,
+                                      const Hash &message, bool mint) {
+    if (!((signature.size() == 64) ||
+          (signature.size() == 65 && !mint &&
+           (signature[64] == 1 || signature[64] == 2)))) {
+        return SignatureStatus::InvalidEncoding;
+    }
+    if (public_key.size() != 32) return SignatureStatus::InvalidPublicKey;
+    secp256k1_xonly_pubkey parsed;
+    if (!secp256k1_xonly_pubkey_parse(secp256k1_context_static, &parsed,
+                                      public_key.data())) {
+        return SignatureStatus::InvalidPublicKey;
+    }
+    return secp256k1_schnorrsig_verify(secp256k1_context_static,
+                                       signature.data(), message.data(),
+                                       message.size(), &parsed)
+               ? SignatureStatus::Valid
+               : SignatureStatus::InvalidSignature;
+}
+
+bool SignBip340Message(const std::array<uint8_t, 32> &secret_key,
+                       const Hash &message, uint8_t mode,
+                       const std::array<uint8_t, 32> &aux_randomness,
+                       std::vector<uint8_t> &result, std::string &error) {
+    if (mode > 2) {
+        error = "signing mode";
+        return false;
+    }
+    using ContextPtr = std::unique_ptr<secp256k1_context,
+                                       decltype(&secp256k1_context_destroy)>;
+    ContextPtr ctx(secp256k1_context_create(SECP256K1_CONTEXT_SIGN),
+                   secp256k1_context_destroy);
+    if (!ctx) {
+        error = "secp256k1 context";
+        return false;
+    }
+    // The keypair embeds the private scalar. Keep cleanup attached to its
+    // lifetime, including invalid-key/signing failures and allocation throws.
+    struct ScopedKeypair {
+        secp256k1_keypair value{};
+        ScopedKeypair() = default;
+        ScopedKeypair(const ScopedKeypair &) = delete;
+        ScopedKeypair &operator=(const ScopedKeypair &) = delete;
+        ~ScopedKeypair() { memory_cleanse(&value, sizeof(value)); }
+    } pair;
+    if (!secp256k1_keypair_create(ctx.get(), &pair.value, secret_key.data())) {
+        error = "invalid secret key";
+        return false;
+    }
+    std::vector<uint8_t> sig(64);
+    if (!secp256k1_schnorrsig_sign32(ctx.get(), sig.data(), message.data(),
+                                     &pair.value, aux_randomness.data())) {
+        error = "BIP340 signing failed";
+        return false;
+    }
+    if (mode) sig.push_back(mode);
+    result = std::move(sig);
+    error.clear();
+    return true;
+}
