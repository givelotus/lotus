diff --git a/src/lotus_v2/signing_test/test_cleanup.cpp b/src/lotus_v2/signing_test/test_cleanup.cpp
new file mode 100644
index 0000000000..f1b798b433
--- /dev/null
+++ b/src/lotus_v2/signing_test/test_cleanup.cpp
@@ -0,0 +1,69 @@
+// Public fixture material only. No private bytes are logged or retained here.
+#include "../signing.h"
+#include <secp256k1_extrakeys.h>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+
+namespace {
+size_t cleanups = 0;
+size_t allocations_until_failure = 0;
+void Check(bool condition) { if (!condition) std::abort(); }
+}
+
+// Exercise an exception after keypair creation. Other allocations use the
+// ordinary malloc/free allocation contract for this isolated test executable.
+void *operator new(std::size_t size) {
+    if (allocations_until_failure && --allocations_until_failure == 0) {
+        throw std::bad_alloc();
+    }
+    if (void *result = std::malloc(size ? size : 1)) return result;
+    throw std::bad_alloc();
+}
+void operator delete(void *ptr) noexcept { std::free(ptr); }
+void operator delete(void *ptr, std::size_t) noexcept { std::free(ptr); }
+
+void lotus_v2_test_real_cleanse(void *, size_t);
+void memory_cleanse(void *ptr, size_t size) {
+    Check(size == sizeof(secp256k1_keypair));
+    lotus_v2_test_real_cleanse(ptr, size);
+    const auto *bytes = static_cast<const unsigned char *>(ptr);
+    for (size_t i = 0; i < size; ++i) Check(bytes[i] == 0);
+    ++cleanups;
+}
+
+int main() {
+    using namespace lotus::v2;
+    std::array<uint8_t, 32> secret{};
+    secret.back() = 3; // Public BIP340 fixture key; never real wallet material.
+    const auto original = secret;
+    const Hash message{};
+    const std::array<uint8_t, 32> aux{};
+    std::vector<uint8_t> result;
+    std::string error;
+    for (uint8_t mode = 0; mode <= 2; ++mode) {
+        Check(SignBip340Message(secret, message, mode, aux, result, error));
+        Check(result.size() == (mode ? 65 : 64));
+        Check(!mode || result.back() == mode);
+        Check(cleanups == size_t(mode) + 1 && error.empty());
+        Check(secret == original); // Caller owns its scalar's cleanup.
+    }
+    const auto saved = result;
+    std::array<uint8_t, 32> invalid{};
+    Check(!SignBip340Message(invalid, message, 0, aux, result, error));
+    Check(cleanups == 4 && result == saved && error == "invalid secret key");
+    Check(!SignBip340Message(secret, message, 3, aux, result, error));
+    Check(cleanups == 4 && result == saved && error == "signing mode");
+    for (size_t allocation : {size_t(1), size_t(2)}) {
+        // First allocation creates sig; second grows it for a mode suffix.
+        allocations_until_failure = allocation;
+        try {
+            SignBip340Message(secret, message, allocation == 1 ? 0 : 1, aux, result, error);
+            std::abort();
+        } catch (const std::bad_alloc &) {
+            Check(!allocations_until_failure && result == saved);
+        }
+    }
+    Check(cleanups == 6);
+    std::cout << "Signing keypair cleanup passes success, invalid-key, and allocation exception exits\n";
+}
diff --git a/src/lotus_v2/test_output.cpp b/src/lotus_v2/test_output.cpp
new file mode 100644
index 0000000000..bb157581aa
--- /dev/null
+++ b/src/lotus_v2/test_output.cpp
@@ -0,0 +1,175 @@
+#include "output.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace lotus::v2;
+
+#define CHECK(condition)                                                       \
+    do {                                                                       \
+        if (!(condition))                                                      \
+            throw std::runtime_error("check failed: " #condition);             \
+    } while (false)
+
+namespace {
+std::vector<uint8_t> FromHex(const std::string &hex) {
+    if (hex.size() & 1) throw std::runtime_error("odd hex");
+    auto digit = [](char ch) -> uint8_t {
+        if (ch >= '0' && ch <= '9') return ch - '0';
+        if (ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
+        throw std::runtime_error("bad hex");
+    };
+    std::vector<uint8_t> bytes;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        bytes.push_back((digit(hex[i]) << 4) | digit(hex[i + 1]));
+    return bytes;
+}
+
+void Accept(const std::vector<uint8_t> &wire) {
+    Output parsed;
+    std::string error;
+    CHECK(DecodeOutput(wire, parsed, error));
+    CHECK(error.empty());
+    std::vector<uint8_t> roundtrip;
+    CHECK(EncodeOutput(parsed, roundtrip, error));
+    CHECK(roundtrip == wire);
+}
+
+void Reject(const std::vector<uint8_t> &wire) {
+    Output parsed;
+    parsed.value = 777;
+    std::string error;
+    CHECK(!DecodeOutput(wire, parsed, error));
+    CHECK(!error.empty());
+    CHECK(parsed.value == 777);
+}
+
+void FixedVectors() {
+    // Fixed Python-reference v1 fixture wires, checked as literal expectations.
+    const auto native = FromHex("00e80300000000000001a88cef369f758aec3e594eaa4e"
+                                "8d08c9f12ef3f11bea972ec53a416a148f0605010100");
+    const auto burn = FromHex("02f40100000000000001a88cef369f758aec3e594eaa4e8d"
+                              "08c9f12ef3f11bea972ec53a416a148f060500");
+    const auto token =
+        FromHex("01ffffffffffffffff01000000000000000000000000000000000000000000"
+                "00000000000000000000020000000000000000000000000000000000000000"
+                "00000000000000000000000001000000000000000000000000000000000000"
+                "000000000000000000000000000301000200010101");
+    const auto token_burn =
+        FromHex("03000000000000000001000000000000000000000000000000000000000000"
+                "00000000000000000000010000000000000000000000000000000000000000"
+                "00000000000000000000000000");
+    for (const auto &wire : {native, burn, token, token_burn})
+        Accept(wire);
+
+    for (const auto &wire : {native, burn, token, token_burn}) {
+        for (size_t n = 0; n < wire.size(); ++n)
+            Reject({wire.begin(), wire.begin() + n});
+    }
+    auto extra = native;
+    extra.push_back(0);
+    Reject(extra);
+    auto invalid = native;
+    invalid[0] = 4;
+    Reject(invalid);
+    invalid = native;
+    invalid[9] = 17;
+    Reject(invalid);
+    invalid = native;
+    invalid[9] = 0;
+    Reject(invalid);
+    invalid = native;
+    invalid.back() = 1;
+    Reject(invalid);
+    invalid = native;
+    invalid[43] = 0;
+    Reject(invalid); // empty spendable path
+    invalid = native;
+    invalid.insert(invalid.begin() + 9, {253, 1, 0});
+    invalid.erase(invalid.begin() + 12);
+    Reject(invalid);
+    invalid = native;
+    invalid[42] = 253;
+    invalid.insert(invalid.begin() + 43, {1, 0});
+    Reject(invalid); // nonminimal path count
+    invalid = native;
+    invalid[0] = 1;
+    invalid.insert(invalid.begin() + 9, 32, 0);
+    Reject(invalid);
+    invalid = native;
+    invalid[0] = 2;
+    Reject(invalid); // burn with path
+    invalid = native;
+    invalid[9] = 2;
+    invalid.insert(invalid.begin() + 42, native.begin() + 10,
+                   native.begin() + 42);
+    Reject(invalid); // duplicate branch
+    invalid = native;
+    invalid[42] = 2;
+    Reject(invalid); // too many paths for bytes
+
+    // Maximum 812-byte output: 16 branches; 15 unique 15-index subsets plus
+    // the full 16-index path produce 16 lexicographically ordered paths.
+    Output largest;
+    largest.flags = 1;
+    largest.value = UINT64_MAX;
+    largest.token_id[0] = 1;
+    for (uint8_t i = 0; i < 16; ++i) {
+        Hash32 b{};
+        b[0] = i;
+        largest.branches.push_back(b);
+    }
+    for (uint8_t missing = 0; missing < 15; ++missing) {
+        std::vector<uint8_t> path;
+        for (uint8_t i = 0; i < 16; ++i)
+            if (i != missing) path.push_back(i);
+        largest.paths.push_back(std::move(path));
+    }
+    std::vector<uint8_t> full;
+    for (uint8_t i = 0; i < 16; ++i)
+        full.push_back(i);
+    largest.paths.push_back(std::move(full));
+    std::sort(largest.paths.begin(), largest.paths.end());
+    std::vector<uint8_t> encoded;
+    std::string error;
+    CHECK(EncodeOutput(largest, encoded, error));
+    CHECK(encoded.size() == MAX_OUTPUT_BYTES);
+    Accept(encoded);
+    auto over = encoded;
+    over.push_back(0);
+    Reject(over);
+    std::swap(largest.paths[0], largest.paths[1]);
+    CHECK(!EncodeOutput(largest, encoded, error));
+    std::swap(largest.paths[0], largest.paths[1]);
+    largest.paths[0][1] = largest.paths[0][0];
+    CHECK(!EncodeOutput(largest, encoded, error));
+    largest.paths[0][1] = 2;
+    largest.paths.push_back({0});
+    CHECK(!EncodeOutput(largest, encoded, error));
+}
+
+void Corpus(const char *path) {
+    std::ifstream in(path);
+    if (!in) throw std::runtime_error("cannot open corpus");
+    std::string line;
+    size_t count = 0;
+    while (std::getline(in, line)) {
+        if (line.empty()) continue;
+        Accept(FromHex(line));
+        ++count;
+    }
+    if (count != 256) throw std::runtime_error("corpus count mismatch");
+}
+} // namespace
+
+int main(int argc, char **argv) {
+    FixedVectors();
+    if (argc > 1) Corpus(argv[1]);
+    std::cout
+        << "Lotus V2 output codec: native vectors and rejection cases pass\n";
+}
diff --git a/src/lotus_v2/test_signing.cpp b/src/lotus_v2/test_signing.cpp
new file mode 100644
index 0000000000..8e23285075
--- /dev/null
+++ b/src/lotus_v2/test_signing.cpp
@@ -0,0 +1,240 @@
+#include "signing.h"
+
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+#define CHECK(condition)                                                       \
+    do {                                                                       \
+        if (!(condition))                                                      \
+            throw std::runtime_error("check failed: " #condition);             \
+    } while (false)
+
+namespace {
+std::vector<uint8_t> Hex(const std::string &hex) {
+    CHECK(hex.size() % 2 == 0);
+    auto digit = [](char c) -> uint8_t {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        throw std::runtime_error("hex");
+    };
+    std::vector<uint8_t> out;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        out.push_back((digit(hex[i]) << 4) | digit(hex[i + 1]));
+    return out;
+}
+Hash HashHex(const std::string &hex) {
+    auto bytes = Hex(hex);
+    CHECK(bytes.size() == 32);
+    Hash result;
+    std::copy(bytes.begin(), bytes.end(), result.begin());
+    return result;
+}
+const TxProfile PROFILE{32, 32, 8, 8192, 16, 8192, 64};
+
+void BIP340OfficialVector() {
+    // bitcoin/bips bip-0340/test-vectors.csv row 0.
+    std::array<uint8_t, 32> secret{};
+    secret[31] = 3;
+    Hash message{};
+    std::array<uint8_t, 32> aux{};
+    const auto pubkey =
+        Hex("f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9");
+    const auto expected =
+        Hex("e907831f80848d1069a5371b402410364bdf1c5f8307b0084c55f1ce2dca8215"
+            "25f66a4a85ea8b71e482a74f382d2ce5ebeee8fdb2172f477df4900d310536c0");
+    std::vector<uint8_t> sig;
+    std::string error;
+    CHECK(SignBip340Message(secret, message, 0, aux, sig, error));
+    CHECK(sig == expected);
+    CHECK(VerifyBip340Signature(pubkey, sig, message, false) ==
+          SignatureStatus::Valid);
+    message[0] = 1;
+    CHECK(VerifyBip340Signature(pubkey, sig, message, false) ==
+          SignatureStatus::InvalidSignature);
+    message[0] = 0;
+    auto bad = sig;
+    bad.push_back(0);
+    CHECK(VerifyBip340Signature(pubkey, bad, message, false) ==
+          SignatureStatus::InvalidEncoding);
+    bad.back() = 3;
+    CHECK(VerifyBip340Signature(pubkey, bad, message, false) ==
+          SignatureStatus::InvalidEncoding);
+    bad.back() = 1;
+    CHECK(VerifyBip340Signature(pubkey, bad, message, true) ==
+          SignatureStatus::InvalidEncoding);
+    auto invalid_key = pubkey;
+    invalid_key.assign(32, 255);
+    CHECK(VerifyBip340Signature(invalid_key, sig, message, false) ==
+          SignatureStatus::InvalidPublicKey);
+    secret.fill(0);
+    CHECK(!SignBip340Message(secret, message, 0, aux, sig, error));
+}
+
+void PaymentFixture() {
+    const auto wire =
+        Hex("07000000000000000000000001000100"
+            "1111111111111111111111111111111111111111111111111111111111111111"
+            "00000000ffffffff0100012220f9308a019258c31049344f85f89d5229b531c845"
+            "836f99b08601f113bce036f9bb000140"
+            "170c710899dd02f994fe139b507662b88c0701019174aafa87329af0b65a9c0b84"
+            "9c421cd740417ddeb4c6f70f4c1f50609b58c00fe8e41f9955a1091d5754aa"
+            "00e80300000000000001d0c0707d9e50c9c3aedc8409e2df04bb920a3d9f669e80"
+            "a36d2f68ea1e3f0d2a010100");
+    const auto coin_wire = Hex("00d00700000000000001d0c0707d9e50c9c3aedc8409e2d"
+                               "f04bb920a3d9f669e80a36d2f68ea1e3f0d2a010100");
+    Transaction tx;
+    Output coin;
+    std::string error;
+    CHECK(DecodeTransaction(wire, PROFILE, tx, error));
+    CHECK(DecodeOutput(coin_wire, coin, error));
+    ResolvedCoins resolved{coin};
+    ChainId chain{};
+    for (size_t i = 0; i < 32; ++i)
+        chain[i] = uint8_t(i);
+    IdentityDigests ids;
+    CHECK(ComputeIdentities(tx, PROFILE, chain, ids, error));
+    CHECK(ids.txid == HashHex("6f097525dfa73f4c9eb428ed6e0e2e70efe63224479b8e0c"
+                              "ede896a7e4caab2c"));
+    CHECK(ids.txhash == HashHex("b27873b6da521172796f7365a8b338e694879bc712d8d2"
+                                "ecabdb22d39378704d"));
+    Hash coins, own;
+    CHECK(ComputeCoinsRoot(tx, resolved, coins, error));
+    CHECK(coins == HashHex("deeba4111737eec866fe0d3998ca43ca4ab84b97afa2cc144e8"
+                           "9e60f6dd3dd21"));
+    CHECK(ComputeOwnInputHash(tx, PROFILE, resolved, 0, own, error));
+    CHECK(own == HashHex("e9c6f915cde3bab2ab260ddc74f007767042c4836b6c638b30d9e"
+                         "7397832e5f8"));
+    const std::array<std::string, 3> expected{
+        "04a85123186ad1a571dc9878c2f2ae8e27329e6f409dcece4e47368428067ecd",
+        "edd48a54efc1c6fb3a548525e570021b14c890bada1c0419a66cbdbd04c31c2a",
+        "45d5a4af0c5a832acab582eb5b6fc5b5fadba6f0b670bd92e36256f6d5fd72e8"};
+    PreparedSigningContext prepared;
+    CHECK(PrepareSigningContext(tx, PROFILE, chain, resolved, prepared, error));
+    CHECK(PrepareSigningContextChecked(tx, PROFILE, chain, resolved, prepared, error) ==
+          SigningPreparationStatus::Ready);
+    const auto saved_txid = prepared.Identities().txid;
+    auto wrong_witness = tx;
+    wrong_witness.inputs[0].witnesses[0].script[0] ^= 1;
+    CHECK(PrepareSigningContextChecked(wrong_witness, PROFILE, chain, resolved, prepared, error) ==
+          SigningPreparationStatus::InvalidWitness);
+    CHECK(prepared.Identities().txid == saved_txid);
+    CHECK(PrepareSigningContextChecked(tx, PROFILE, chain, {}, prepared, error) ==
+          SigningPreparationStatus::OperationalError);
+    auto invalid_profile = PROFILE;
+    invalid_profile.max_inputs = 0;
+    CHECK(PrepareSigningContextChecked(tx, invalid_profile, chain, resolved, prepared, error) ==
+          SigningPreparationStatus::OperationalError);
+    CHECK(prepared.Identities().txid == saved_txid);
+
+    for (uint8_t mode = 0; mode < 3; ++mode) {
+        Hash message;
+        CHECK(SigningMessage(tx, PROFILE, chain, resolved, 0, 0, mode,
+                             std::nullopt, message, error));
+        CHECK(message == HashHex(expected[mode]));
+        Hash cached_message;
+        CHECK(SigningMessage(prepared, 0, 0, mode, std::nullopt,
+                             cached_message, error));
+        CHECK(cached_message == message);
+    }
+    const auto signature = tx.inputs[0].witnesses[0].arguments[0];
+    const auto pubkey =
+        Hex("f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9");
+    Hash message;
+    CHECK(SigningMessage(tx, PROFILE, chain, resolved, 0, 0, 0, std::nullopt,
+                         message, error));
+    CHECK(VerifyBip340Signature(pubkey, signature, message, false) ==
+          SignatureStatus::Valid);
+    ChainId other_chain = chain;
+    other_chain[0] ^= 1;
+    Hash cross_chain_message;
+    CHECK(SigningMessage(tx, PROFILE, other_chain, resolved, 0, 0, 0,
+                         std::nullopt, cross_chain_message, error));
+    CHECK(cross_chain_message != message);
+    CHECK(VerifyBip340Signature(pubkey, signature, cross_chain_message,
+                                false) == SignatureStatus::InvalidSignature);
+    const auto original_id = ids.txid;
+    const auto original_hash = ids.txhash;
+    tx.inputs[0].witnesses[0].arguments[0] = {'x'};
+    CHECK(ComputeIdentities(tx, PROFILE, chain, ids, error));
+    CHECK(ids.txid == original_id && ids.txhash != original_hash);
+    Hash mutated_message;
+    CHECK(SigningMessage(tx, PROFILE, chain, resolved, 0, 0, 0, std::nullopt,
+                         mutated_message, error));
+    CHECK(mutated_message == message);
+    tx.outputs.clear();
+    CHECK(!SigningMessage(tx, PROFILE, chain, resolved, 0, 0, 2, std::nullopt,
+                          mutated_message, error));
+    CHECK(!SigningMessage(tx, PROFILE, chain, resolved, 0, 0, 3, std::nullopt,
+                          mutated_message, error));
+}
+
+void MintMessage() {
+    const auto wire =
+        Hex("07000000000000000000000001000100"
+            "1111111111111111111111111111111111111111111111111111111111111111"
+            "00000000ffffffff0100012220f9308a019258c31049344f85f89d5229b531c845"
+            "836f99b08601f113bce036f9bb000140"
+            "170c710899dd02f994fe139b507662b88c0701019174aafa87329af0b65a9c0b84"
+            "9c421cd740417ddeb4c6f70f4c1f50609b58c00fe8e41f9955a1091d5754aa"
+            "00e80300000000000001d0c0707d9e50c9c3aedc8409e2df04bb920a3d9f669e80"
+            "a36d2f68ea1e3f0d2a010100");
+    const auto coin_wire = Hex("00d00700000000000001d0c0707d9e50c9c3aedc8409e2d"
+                               "f04bb920a3d9f669e80a36d2f68ea1e3f0d2a010100");
+    Transaction tx;
+    Output coin;
+    std::string error;
+    CHECK(DecodeTransaction(wire, PROFILE, tx, error));
+    CHECK(DecodeOutput(coin_wire, coin, error));
+    Input mint;
+    mint.flags = 3;
+    mint.sequence = UINT32_MAX;
+    mint.prev_txid = HashHex(
+        "a88cef369f758aec3e594eaa4e8d08c9f12ef3f11bea972ec53a416a148f0605");
+    mint.witnesses.push_back(BranchWitness{{0x4e}, {}, {{'x'}}});
+    tx.inputs.push_back(mint);
+    ResolvedCoins resolved{coin, std::nullopt};
+    ChainId chain{};
+    for (size_t i = 0; i < 32; ++i)
+        chain[i] = uint8_t(i);
+    PositiveDelta delta{};
+    delta[0] = 1;
+    PreparedSigningContext prepared;
+    CHECK(PrepareSigningContext(tx, PROFILE, chain, resolved, prepared, error));
+    Hash message;
+    CHECK(SigningMessage(tx, PROFILE, chain, resolved, 1, 0, 0, delta, message,
+                         error));
+    CHECK(message == HashHex("e377de4d5eeef48cba47286c47dc88a1a61019c06f6f2f1e4"
+                             "ea2f263d60bb587"));
+    Hash cached_message;
+    CHECK(SigningMessage(prepared, 1, 0, 0, delta, cached_message, error));
+    CHECK(cached_message == message);
+    CHECK(!SigningMessage(prepared, 1, 0, 1, delta, cached_message, error));
+    CHECK(!SigningMessage(prepared, 1, 0, 0, std::nullopt, cached_message,
+                          error));
+    CHECK(!SigningMessage(tx, PROFILE, chain, resolved, 1, 0, 1, delta, message,
+                          error));
+    CHECK(!SigningMessage(tx, PROFILE, chain, resolved, 1, 0, 2, delta, message,
+                          error));
+    delta[0] = 0;
+    CHECK(!SigningMessage(tx, PROFILE, chain, resolved, 1, 0, 0, delta, message,
+                          error));
+    delta[0] = 1;
+    tx.inputs[1].witnesses.clear();
+    CHECK(!SigningMessage(tx, PROFILE, chain, resolved, 1, 0, 0, delta, message,
+                          error));
+    tx.inputs[1].flags = 0;
+    Hash coins;
+    CHECK(!ComputeCoinsRoot(tx, resolved, coins, error));
+}
+} // namespace
