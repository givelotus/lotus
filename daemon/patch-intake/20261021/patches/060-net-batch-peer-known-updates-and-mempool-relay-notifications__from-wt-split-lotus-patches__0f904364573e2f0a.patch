From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] net: batch peer-known updates and mempool relay notifications

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Defer internal Merklix branch digest hashing until root materialization, accelerate
GF(2^64) multiplication via ARM64 PMULL / x86 PCLMULQDQ intrinsics, and batch
mempool subscriber notifications.

Original-Commit: 2ef243d434f15e848f3a86a4d30f6fe7e8de3ff8
Original-Patch: ecash/035
Split-Concern: relay

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/net_processing.cpp | 59 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index c8da57de83077fdea72947f514b519afee25b1b3..815bdf1ff81f91fb7e97e0e6bbda1b59ddab03ff 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -846,6 +846,8 @@ public:
     void SendPings() override EXCLUSIVE_LOCKS_REQUIRED(!m_peer_mutex);
     void RelayTransaction(const TxId &txid) override
         EXCLUSIVE_LOCKS_REQUIRED(!m_peer_mutex);
+    void RelayTransactionBatch(std::span<const CTransactionRef> txs) override
+        EXCLUSIVE_LOCKS_REQUIRED(!m_peer_mutex);
     void RelayProof(const avalanche::ProofId &proofid) override
         EXCLUSIVE_LOCKS_REQUIRED(!m_peer_mutex);
     void SetBestHeight(int height) override { m_best_height = height; };
@@ -3313,6 +3315,35 @@ void PeerManagerImpl::RelayTransaction(const TxId &txid) {
     }
 }
 
+void PeerManagerImpl::RelayTransactionBatch(
+    std::span<const CTransactionRef> txs) {
+    if (txs.empty()) {
+        return;
+    }
+    LOCK(m_peer_mutex);
+    for (auto &it : m_peer_map) {
+        Peer &peer = *it.second;
+        auto tx_relay = peer.GetTxRelay();
+        if (!tx_relay) {
+            continue;
+        }
+        LOCK(tx_relay->m_tx_inventory_mutex);
+        if (tx_relay->m_next_inv_send_time == 0s) {
+            continue;
+        }
+        for (const auto &tx : txs) {
+            if (!tx) {
+                continue;
+            }
+            const TxId &txid = tx->GetId();
+            if (!tx_relay->m_tx_inventory_known_filter.contains(txid) ||
+                tx_relay->m_avalanche_stalled_txids.count(txid) > 0) {
+                tx_relay->m_tx_inventory_to_send.insert(txid);
+            }
+        }
+    }
+}
+
 void PeerManagerImpl::MarkPeerKnownTx(NodeId peer_id, const TxId &txid) {
     if (PeerRef peer = GetPeerRef(peer_id)) {
         AddKnownTx(*peer, txid);
@@ -3320,6 +3351,34 @@ void PeerManagerImpl::MarkPeerKnownTx(NodeId peer_id, const TxId &txid) {
     WITH_LOCK(cs_main, m_txrequest.ForgetInvId(txid));
 }
 
+void PeerManagerImpl::MarkPeerKnownTxBatch(
+    NodeId peer_id, std::span<const CTransactionRef> txs) {
+    if (txs.empty()) {
+        return;
+    }
+    if (PeerRef peer = GetPeerRef(peer_id)) {
+        if (auto tx_relay = peer->GetTxRelay()) {
+            LOCK(tx_relay->m_tx_inventory_mutex);
+            for (const auto &tx : txs) {
+                if (!tx) {
+                    continue;
+                }
+                const TxId &txid = tx->GetId();
+                tx_relay->m_tx_inventory_known_filter.insert(txid);
+                tx_relay->m_tx_inventory_to_send.erase(txid);
+            }
+        }
+    }
+    LOCK(cs_main);
+    if (m_txrequest.Size() > 0) {
+        for (const auto &tx : txs) {
+            if (tx) {
+                m_txrequest.ForgetInvId(tx->GetId());
+            }
+        }
+    }
+}
