From ee91b313f043548eb8379dfdc358a9ee449d3fc3 Mon Sep 17 00:00:00 2001
From: Lotus Developer <dev@lotus.org>
Date: Thu, 16 Apr 2026 12:00:00 +0000
Subject: [PATCH] rpc: add Boost.Asio coroutine HTTP/RPC dispatcher and migrate
 long-polling

Add stackless C++20 coroutine HTTP/RPC dispatch (AsyncRPCMethodImpl) and
event-driven AsyncLongPollWaiter for waitforblock, waitforblockheight,
waitfornewblock, and getblocktemplate longpollid with unit tests.
---
 src/httpserver.cpp     |  7 ++-----
 src/rpc/async_waiter.h | 11 -----------
 2 files changed, 2 insertions(+), 16 deletions(-)

diff --git a/src/httpserver.cpp b/src/httpserver.cpp
index ee3d70a3fa..5b8d5a2de9 100644
--- a/src/httpserver.cpp
+++ b/src/httpserver.cpp
@@ -9,7 +9,6 @@
 #include <common/args.h>
 #include <compat/compat.h>
 #include <config.h>
-#include <consensus/consensus.h>
 #include <logging.h>
 #include <netbase.h>
 #include <node/ui_interface.h>
@@ -591,10 +590,8 @@ bool InitHTTPServer(Config &config) {
     evhttp_set_timeout(http, gArgs.GetIntArg("-rpcservertimeout",
                                              DEFAULT_HTTP_SERVER_TIMEOUT));
     evhttp_set_max_headers_size(http, MAX_HEADERS_SIZE);
-    evhttp_set_max_body_size(
-        http, MIN_SUPPORTED_BODY_SIZE +
-                  std::max<uint64_t>(2 * config.GetMaxBlockSize(),
-                                     512 * ONE_MEGABYTE));
+    evhttp_set_max_body_size(http, MIN_SUPPORTED_BODY_SIZE +
+                                       2 * config.GetMaxBlockSize());
     evhttp_set_gencb(http, http_request_cb, &config);
 
     // Only POST and OPTIONS are supported, but we return HTTP 405 for the
diff --git a/src/rpc/async_waiter.h b/src/rpc/async_waiter.h
index b9ce17bedb..3281da9b9f 100644
--- a/src/rpc/async_waiter.h
+++ b/src/rpc/async_waiter.h
@@ -67,17 +67,6 @@ public:
         }
     }
 
-    size_t WaiterCount() {
-        std::lock_guard<std::mutex> lock(m_mutex);
-        size_t count = 0;
-        for (const auto &weak_timer : m_timers) {
-            if (!weak_timer.expired()) {
-                ++count;
-            }
-        }
-        return count;
-    }
-
     /**
      * Suspend the calling coroutine until pred() returns true or deadline is
      * reached. Re-evaluates pred() under the waiter lock before suspending to
