+def lotus_v2_indexed_tree_root(leaves: list) -> bytes:
+    if not leaves:
+        return lotus_v2_tagged_hash("Lotus/v2/merkleidx", b"\x02")
+    if len(leaves) == 1:
+        return leaves[0]
+    cur = list(leaves)
+    layer = 0
+    while len(cur) > 1:
+        if len(cur) & 1:
+            cur.append(b"\x00" * 32)
+        nxt = []
+        for i in range(0, len(cur), 2):
+            nxt.append(
+                lotus_v2_tagged_hash(
+                    "Lotus/v2/merkleidx",
+                    b"\x01" + layer.to_bytes(2, "little") + cur[i] + cur[i + 1],
+                )
+            )
+        cur = nxt
+        layer += 1
+    return cur[0]
