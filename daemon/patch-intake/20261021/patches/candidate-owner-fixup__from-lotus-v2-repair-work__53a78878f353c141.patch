index f9e357f802..3980ee8c0d 100644
--- a/src/test/txrelay_tests.cpp
+++ b/src/test/txrelay_tests.cpp
@@ -22,6 +22,7 @@
 #include <validation.h>
 
 #include <test/util/net.h>
