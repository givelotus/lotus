--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -1145,6 +1145,7 @@ private:
         EXCLUSIVE_LOCKS_REQUIRED(!m_peer_mutex, g_msgproc_mutex, cs_main);
 
     void ProcessSingleTx(CNode &pfrom, Peer &peer, const CTransactionRef &ptx,
