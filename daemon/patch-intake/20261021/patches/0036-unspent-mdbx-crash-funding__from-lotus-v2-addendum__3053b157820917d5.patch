From 9c3c44b0fa48e55e4c4c281ba30558e2d5fed099 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:01:27 -0700
Subject: [PATCH] fixup! policy(v2): relay and accept legacy and v7
 transactions

Funding chunks consume earlier outputs; appending every returned output leaves29 already-spent inputs in the five2000-transaction crash workload. Recompute only currently unspent non-coinbase outputs after each chunk, retaining all10000 transfers and the original SIGKILL/recovery assertions. Five full cycles then complete/recover, exposing the separate asynchronous in-flight marker race; proposed timing barrier remains unapplied pending technical review.

Tier: V2 (fixup to policy(v2): relay and accept legacy and v7 transactions)
---
 test/functional/feature_mdbx_crash.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/test/functional/feature_mdbx_crash.py b/test/functional/feature_mdbx_crash.py
index 9ffad7b1e2..051233ddc0 100644
--- a/test/functional/feature_mdbx_crash.py
+++ b/test/functional/feature_mdbx_crash.py
@@ -50,10 +50,17 @@ class MdbxCrashTest(BitcoinTestFramework):
         funding = []
         needed = self.options.transactions * self.options.crash_cycles
         while len(funding) < needed:
-            funding += wallet.send_self_transfer_multi(
+            wallet.send_self_transfer_multi(
                 from_node=source,
-                num_outputs=min(250, needed - len(funding)),
-            )["new_utxos"]
+                num_outputs=min(250, needed - len(funding) + 1),
+            )
+            # Further funding transactions may spend earlier funding outputs.
+            # Keep only the wallet's currently unspent non-coinbase outputs.
+            funding = [
+                utxo
+                for utxo in wallet.get_utxos(mark_as_spent=False)
+                if not utxo["coinbase"]
+            ]
         initial += self.generate(wallet, 1, sync_fun=self.no_op)
         for blockhash in initial:
             raw_initial = source.getblock(blockhash, False)
