From aafa0f0d9f6b083cafce8d1ac018ccc3ab742f98 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:31:16 -0700
Subject: consensus(v2): judge v7 finality by the full V2 lock and its kind

The v7 decoder copies the 64-bit V2 lock into the legacy 32-bit nLockTime
as uint32(lock >> 8), and IsFinalTx then judged that copy with legacy
rules. Three things went wrong:

- the 56-bit lock value was truncated, so a height lock of 2^32 + 5
  became height 5 and was final almost at once;
- the 500,000,000 threshold, not the lock's kind byte, chose between
  height and time, so a height lock above 500M was compared with the
  median time past;
- legacy "lock < height" and the all-sequences-final override applied,
  where V2 makes a lock final once the height (or parent MTP) reaches
  its value, whatever the input sequences.

The V2 reference rule (CheckOrdinaryLocks) already had the right
semantics. It moves into lotus_v2/lock.h as AbsoluteLockSatisfied, and
both CheckOrdinaryLocks and IsFinalTx now call it for transactions in the
v7 wire format, so the node and the reference share one rule. The
wrapped legacy-grammar form has no V2 lock and keeps the legacy rule.

v2_finality_tests covers the truncation, the kind byte, the
reached-value boundary and the sequence override; each case fails
before this change.

Tier: V2 (fixup to v2/045)
---
 src/consensus/tx_verify.cpp          | 11 ++++
 src/lotus_v2/lock.h                  | 27 +++++++++
 src/lotus_v2/ordinary_validation.cpp |  7 +--
 src/test/CMakeLists.txt              |  1 +
 src/test/v2_finality_tests.cpp       | 85 ++++++++++++++++++++++++++++
 5 files changed, 127 insertions(+), 4 deletions(-)
 create mode 100644 src/lotus_v2/lock.h
 create mode 100644 src/test/v2_finality_tests.cpp

diff --git a/src/consensus/tx_verify.cpp b/src/consensus/tx_verify.cpp
index b665aacc2c..5d2831cee0 100644
--- a/src/consensus/tx_verify.cpp
+++ b/src/consensus/tx_verify.cpp
@@ -12,6 +12,7 @@
 #include <consensus/consensus.h>
 #include <consensus/params.h>
 #include <consensus/validation.h>
+#include <lotus_v2/lock.h>
 #include <primitives/transaction.h>
 #include <script/script_flags.h>
 #include <util/check.h>
@@ -19,6 +20,16 @@
 
 static bool IsFinalTx(const CTransaction &tx, int nBlockHeight,
                       int64_t nBlockTime) {
+    // A transaction in the v7 wire format carries the V2 lock, whose value
+    // is 56 bits wide and whose kind byte (not a 500M threshold) says height
+    // or time; its nLockTime is only a truncated display copy. (The wrapped
+    // legacy-grammar form has a legacy nLockTime and no V2 lock.)
+    if (tx.nVersion == 7 && tx.fHasV2Lock) {
+        return lotus::v2::AbsoluteLockSatisfied(
+            tx.nV2Lock, uint64_t(std::max(nBlockHeight, 0)),
+            uint64_t(std::max<int64_t>(nBlockTime, 0)));
+    }
+
     if (tx.nLockTime == 0) {
         return true;
     }
diff --git a/src/lotus_v2/lock.h b/src/lotus_v2/lock.h
new file mode 100644
index 0000000000..23fc7e16ae
--- /dev/null
+++ b/src/lotus_v2/lock.h
@@ -0,0 +1,27 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#ifndef LOTUS_V2_LOCK_H
+#define LOTUS_V2_LOCK_H
+
+#include <cstdint>
+
+namespace lotus::v2 {
+
+// The 64-bit V2 transaction lock is (value << 8) | kind. Kind 0 (only with
+// value 0) is no lock, kind 1 is a height and kind 2 is a parent median time
+// past. A locked transaction is final once the candidate block's height, or
+// its parent's median time past, has reached the full 56-bit value. Input
+// sequences never disable the lock.
+inline bool AbsoluteLockSatisfied(uint64_t lock, uint64_t candidate_height,
+                                  uint64_t parent_mtp) {
+    const uint8_t kind = uint8_t(lock);
+    const uint64_t value = lock >> 8;
+    if (kind == 1) return candidate_height >= value;
+    if (kind == 2) return parent_mtp >= value;
+    return true;
+}
+
+} // namespace lotus::v2
+
+#endif // LOTUS_V2_LOCK_H
diff --git a/src/lotus_v2/ordinary_validation.cpp b/src/lotus_v2/ordinary_validation.cpp
index a3c2e23fe1..c56c3b9184 100644
--- a/src/lotus_v2/ordinary_validation.cpp
+++ b/src/lotus_v2/ordinary_validation.cpp
@@ -1,4 +1,5 @@
 #include "ordinary_validation.h"
+#include "lock.h"
 #include "vendor/blake3/blake3.h"
 
 #include <algorithm>
@@ -208,10 +209,8 @@ Hash OrdinaryValidationProfileDigest(const OrdinaryCandidateProfile &op) {
 bool CheckOrdinaryLocks(const Transaction &tx, const std::vector<Coin> &spent,
                         const OrdinaryCandidateProfile &profile,
                         std::string &error) {
-    const uint8_t kind = uint8_t(tx.lock);
-    const uint64_t value = tx.lock >> 8;
-    if ((kind == 1 && profile.candidate_height < value) ||
-        (kind == 2 && profile.parent_mtp < value)) {
+    if (!AbsoluteLockSatisfied(tx.lock, profile.candidate_height,
+                               profile.parent_mtp)) {
         error = "absolute lock";
         return false;
     }
