From cc2dc566b4472efaf762a93e0a8cb5222d122798 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 09:32:08 -0700
Subject: [PATCH] consensus: gate the vanity-prefix coinbase height bypass fix

The v8.3.4 change intended to permit FRBTC or other vanity data instead of
logos in the existing first-output OP_RETURN, followed by the block height.
At height 1018000 and above a different prefix instead returns success
before parsing the height. TestBlockValidity accepts missing, wrong,
truncated and overlong height commitments through this branch.

Gate only that early success return on a new consensus parameter,
coinbaseHeightValidationActivationHeight. Its INT_MAX sentinel explicitly
disables the fix until a coordinated network upgrade chooses an activation
height. After activation, vanity prefixes continue through the unchanged
height parser. Keep the existing direct byte lengths, three-byte unsigned
height limit, trailing data, logos restriction below 1018000, and early
block exceptions. Do not broaden accepted script encodings.

Header height, coinbase amounts/reward and miner-fund validation are not
bypassed or modified. No live network activation is selected here.

Validation: the identical final full-block regression fails eight
assertions before the fix and passes afterward. The 13 native cases in
validation_block_tests, miner_tests, txvalidation_tests and
 txvalidationcache_tests pass. The new test exercises actual
TestBlockValidity with FRBTC/logos, missing/wrong/truncated/overlong height,
valid trailing data, invalid prefixes, preactivation/default compatibility,
and the activation boundary.

Base: Lotus 6590d92300ba588325628ab7c1a166e392947cff on ABC 8c67fe1e85.
---
 src/consensus/params.h              |  5 +++
 src/test/validation_block_tests.cpp | 62 +++++++++++++++++++++++++++++
 src/validation.cpp                  | 23 ++++++-----
 3 files changed, 79 insertions(+), 11 deletions(-)

diff --git a/src/consensus/params.h b/src/consensus/params.h
index 285c15f56bb049d6bd50b559ad968b0140c0d7d8..b940a651850d6fe8f77520bea5d675da3647c3af 100644
--- a/src/consensus/params.h
+++ b/src/consensus/params.h
@@ -50,6 +50,11 @@ constexpr bool ValidDeployment(BuriedDeployment dep) {
  * Parameters that influence chain consensus.
  */
 struct Params {
+    // Disabled until a coordinated upgrade fixes the vanity-prefix height
+    // bypass.
+    int coinbaseHeightValidationActivationHeight =
+        std::numeric_limits<int>::max();
+
     BlockHash hashGenesisBlock;
     int nSubsidyHalvingInterval;
     /** Unix time used for MTP activation of 2021-12-21T15:59:00.000Z protocol upgrade */
diff --git a/src/test/validation_block_tests.cpp b/src/test/validation_block_tests.cpp
index 77d5cbd41a8c1beb7f60cda97fb5b5dcdf2f85ab..b43b4283f5958bd77fb9a7db9441a238ed1eb6f4 100644
--- a/src/test/validation_block_tests.cpp
+++ b/src/test/validation_block_tests.cpp
@@ -51,6 +51,68 @@ struct MinerTestingSetup : public TestingSetup {
 
 BOOST_FIXTURE_TEST_SUITE(validation_block_tests, MinerTestingSetup)
 
+BOOST_AUTO_TEST_CASE(coinbase_vanity_height_commitment) {
+    const Config &config = m_node.chainman->GetConfig();
+    auto &chainstate = m_node.chainman->ActiveChainstate();
+    LOCK(cs_main);
+    auto *tip = chainstate.m_chain.Tip();
+    auto &params =
+        const_cast<Consensus::Params &>(m_node.chainman->GetConsensus());
+    const int saved_height = tip->nHeight;
+    const int saved_activation =
+        params.coinbaseHeightValidationActivationHeight;
+    const int height = 1401000;
+    auto block = Block(config, tip->GetBlockHash(), height);
+    tip->nHeight = height - 1;
+    params.coinbaseHeightValidationActivationHeight = height;
+    const std::vector<uint8_t> vanity{'F', 'R', 'B', 'T', 'C'};
+    const auto check = [&](const CScript &script, bool expected) {
+        CMutableTransaction coinbase(*block->vtx[0]);
+        coinbase.vout[0].scriptPubKey = script;
+        block->vtx[0] = MakeTransactionRef(coinbase);
+        block->SetSize(::GetSerializeSize(*block));
+        BlockValidationState state;
+        const bool valid = TestBlockValidity(
+            state, config.GetChainParams(), chainstate, *block, tip,
+            [] { return NodeClock::now(); },
+            BlockValidationOptions(config)
+                .withCheckPoW(false)
+                .withCheckMerkleRoot(false));
+        BOOST_CHECK_MESSAGE(valid == expected, state.ToString());
+        if (!expected)
+            BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-cb-height");
+    };
+    // Activate exactly at this height, preserving the existing serialization
+    // rules.
+    check(CScript() << OP_RETURN << vanity, false);
+    check(CScript() << OP_RETURN << vanity << (height - 1), false);
+    check(CScript() << OP_RETURN << vanity << height, true);
+    check(CScript() << OP_RETURN << COINBASE_PREFIX << height, true);
+    check(CScript() << OP_RETURN << vanity << height << OP_NOP, true);
+    auto truncated = CScript() << OP_RETURN << vanity << height;
+    truncated.pop_back();
+    check(truncated, false);
+    check(CScript() << OP_RETURN << vanity
+                    << std::vector<uint8_t>{0xa8, 0x60, 0x15, 0},
+          false);
+    check(CScript(), false);
+    check(CScript() << OP_TRUE, false);
+    // No parser relaxation: an incomplete PUSHDATA1 prefix remains invalid.
+    check(CScript() << OP_RETURN << OP_PUSHDATA1 << 5, false);
+    // One block before activation retains the old vanity-prefix bypass.
+    params.coinbaseHeightValidationActivationHeight = height + 1;
+    check(CScript() << OP_RETURN << vanity, true);
+    check(CScript() << OP_RETURN << vanity << (height - 1), true);
+    // The default sentinel preserves historical acceptance without deployment.
+    params.coinbaseHeightValidationActivationHeight = saved_activation;
+    check(CScript() << OP_RETURN << vanity, true);
+    check(CScript() << OP_RETURN << vanity << (height - 1), true);
+    // The logos path already required the correct height, even before
+    // activation.
+    check(CScript() << OP_RETURN << COINBASE_PREFIX << (height - 1), false);
+    tip->nHeight = saved_height;
+}
+
 struct TestSubscriber final : public CValidationInterface {
     uint256 m_expected_tip;
 
diff --git a/src/validation.cpp b/src/validation.cpp
index 43764167b31d8033b5450d61cdacdb5a1d3ca4cf..9727e892ccd460b7676db4b66196ba856e871a20 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4674,20 +4674,21 @@ static bool ContextualCheckBlock(const CBlock &block,
         std::vector<uint8_t> prefixData(scriptPubKey.begin() + pos,
                                         scriptPubKey.begin() + pos + prefixLen);
 
-        // NOTE: v8.3.4 (patch 207) accidentally returned `true` early from
-        // ContextualCheckBlock whenever `prefixData != COINBASE_PREFIX` at
-        // `nHeight >= 1018000` (`!strictCheckingCoinbaseShame`), skipping the
-        // subsequent `<nHeight>` check for non-"logos" coinbases. We preserve
-        // that early `return true` for `nHeight >= 1018000` to avoid a chain
-        // split against LotusiaStewardship/lotusd nodes, while properly calling
-        // `state.Invalid(...)` on failures when `nHeight < 1018000`.
+        // v8.3.4 accidentally skipped height validation for vanity prefixes
+        // after height 1018000. Preserve historical acceptance until a
+        // coordinated upgrade activates the fix, then continue through the
+        // existing height parser regardless of the vanity prefix.
         if (prefixLen != COINBASE_PREFIX.size() || prefixData != COINBASE_PREFIX) {
-            if (!strictCheckingCoinbaseShame) {
+            if (strictCheckingCoinbaseShame) {
+                return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                     "bad-cb-height",
+                                     "block height mismatch in coinbase");
+            }
+            if (params.coinbaseHeightValidationActivationHeight ==
+                    std::numeric_limits<int>::max() ||
+                nHeight < params.coinbaseHeightValidationActivationHeight) {
                 return true;
             }
-            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
-                                 "bad-cb-height",
-                                 "block height mismatch in coinbase");
         }
 
         // Move position past prefix data
