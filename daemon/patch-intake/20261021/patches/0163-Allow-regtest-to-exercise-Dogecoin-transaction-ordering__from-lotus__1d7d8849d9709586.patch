From 24c100791a83b6727088d56cfffce495927ea7e6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:57:20 -0700
Subject: [PATCH] Allow regtest to exercise Dogecoin transaction ordering

Add a hidden regtest-only magnetic-anomaly height override so functional tests can disable the inherited ABC CTOR fixture setting and verify actual Dogecoin parent-before-child consensus. Preserve the original regtest fixture default and all mainnet/testnet parameters. Reject negative or overflowing activation heights.

diff --git a/src/chainparams.cpp b/src/chainparams.cpp
index 2649d76ed09dc73216534af14b22c98aafb444fe..0f92b2fd7d45f5ce0a91a29dc76bbf6627784e88 100644
--- a/src/chainparams.cpp
+++ b/src/chainparams.cpp
@@ -16,6 +16,7 @@
 #include <util/chaintype.h>
 
 #include <cassert>
+#include <limits>
 
 static std::unique_ptr<const CChainParams> globalChainParams;
 
@@ -29,6 +30,12 @@ void ReadChainArgs(const ArgsManager &args,
     options.ecash = args.GetBoolArg("-ecash", cashaddr::DEFAULT_ECASH);
     // Only relevant for REGTEST
     options.fastprune = args.GetBoolArg("-fastprune", false);
+    const int64_t magneticAnomalyHeight = args.GetIntArg("-magneticanomalyheight", 0);
+    if (magneticAnomalyHeight < 0 ||
+        magneticAnomalyHeight > std::numeric_limits<int32_t>::max()) {
+        throw std::invalid_argument("-magneticanomalyheight must be a nonnegative int32 height");
+    }
+    options.regtest_magnetic_anomaly_height = int32_t(magneticAnomalyHeight);
 }
 
 std::unique_ptr<const CChainParams> CreateChainParams(const ArgsManager &args,
diff --git a/src/init.cpp b/src/init.cpp
index 2d6f01607212140bf30e022d5c6e4d2395942b99..f600f7a0c04fe0f165b01de65e413eb761c8f850 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -501,6 +501,7 @@ void SetupServerArgs(NodeContext &node) {
         "-automaticunparking",
         "-replayprotectionactivationtime",
         "-legacyscriptrules",
+        "-magneticanomalyheight",
         "-enableminerfund",
         "-chronikallowpause",
         "-chronikcors",
diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 74e900f47c2fc4c1b24015bb79fa13e9562d0638..88324f44e4be77c87660c4b6f466595fb2d6b3f5 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -395,8 +395,9 @@ public:
         // November 13, 2017 hard fork is always on on regtest.
         consensus.daaHeight = 0;
 
-        // November 15, 2018 hard fork is always on on regtest.
-        consensus.magneticAnomalyHeight = 0;
+        // Retain the inherited CTOR fixture default while allowing regtest
+        // to exercise Dogecoin mainnet/testnet dependency ordering.
+        consensus.magneticAnomalyHeight = opts.regtest_magnetic_anomaly_height;
 
         // November 15, 2019 protocol upgrade
         consensus.gravitonHeight = 0;
diff --git a/src/kernel/chainparams.h b/src/kernel/chainparams.h
index a54268c92d1e40546ffaba1c4645df84da470a63..16dac7d7ffe8a45f9b831991ec286d4690eeb025 100644
--- a/src/kernel/chainparams.h
+++ b/src/kernel/chainparams.h
@@ -160,6 +160,7 @@ public:
     struct ChainOptions {
         bool ecash{true};
         bool fastprune{false};
+        int32_t regtest_magnetic_anomaly_height{0};
     };
 
     static std::unique_ptr<const CChainParams>
