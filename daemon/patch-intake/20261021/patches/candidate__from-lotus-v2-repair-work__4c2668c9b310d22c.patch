@@ -133,6 +133,8 @@ struct UtxoOverlayNode {
     uint32_t count{0};
     std::array<uint32_t, 2> child{{0, 0}};
     std::array<std::shared_ptr<const SmtNode>, 2> base_child{{nullptr, nullptr}};
