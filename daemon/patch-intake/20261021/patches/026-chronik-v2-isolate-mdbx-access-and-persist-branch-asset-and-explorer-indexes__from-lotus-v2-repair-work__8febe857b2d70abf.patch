+/// Index the UTXOs of V2 asset IDs in the DB.
+pub type V2AssetUtxoWriter<'a> = GroupUtxoWriter<'a, V2AssetGroup>;
+/// Read the UTXOs of V2 asset IDs in the DB.
+pub type V2AssetUtxoReader<'a> = GroupUtxoReader<'a, V2AssetGroup>;
