+    ) -> c_int;
+    fn mdbx_env_open(
+        env: *mut MDBX_env,
+        pathname: *const c_char,
+        flags: u32,
+        mode: MdbxMode,
+    ) -> c_int;
+    fn mdbx_env_close_ex(env: *mut MDBX_env, dont_sync: bool) -> c_int;
+    fn mdbx_txn_begin_ex(
+        env: *mut MDBX_env,
+        parent: *mut MDBX_txn,
+        flags: u32,
+        txn: *mut *mut MDBX_txn,
+        context: *mut c_void,
+    ) -> c_int;
+    fn mdbx_txn_commit_ex(txn: *mut MDBX_txn, latency: *mut c_void) -> c_int;
+    fn mdbx_txn_abort(txn: *mut MDBX_txn) -> c_int;
+    fn mdbx_dbi_open(
+        txn: *mut MDBX_txn,
+        name: *const c_char,
+        flags: u32,
+        dbi: *mut MdbxDbi,
+    ) -> c_int;
+    fn mdbx_get(
+        txn: *const MDBX_txn,
+        dbi: MdbxDbi,
+        key: *const MDBX_val,
+        data: *mut MDBX_val,
+    ) -> c_int;
+    fn mdbx_put(
+        txn: *mut MDBX_txn,
+        dbi: MdbxDbi,
+        key: *const MDBX_val,
+        data: *mut MDBX_val,
+        flags: u32,
+    ) -> c_int;
+    fn mdbx_del(
+        txn: *mut MDBX_txn,
+        dbi: MdbxDbi,
+        key: *const MDBX_val,
+        data: *const MDBX_val,
+    ) -> c_int;
+    fn mdbx_cursor_open(
+        txn: *mut MDBX_txn,
+        dbi: MdbxDbi,
+        cursor: *mut *mut MDBX_cursor,
+    ) -> c_int;
+    fn mdbx_cursor_close(cursor: *mut MDBX_cursor);
+    fn mdbx_cursor_get(
+        cursor: *mut MDBX_cursor,
+        key: *mut MDBX_val,
+        data: *mut MDBX_val,
+        op: MDBX_cursor_op,
+    ) -> c_int;
+    fn mdbx_strerror_r(
+        errnum: c_int,
+        buf: *mut c_char,
+        buflen: usize,
+    ) -> *const c_char;
+}
+
+/// Error returned by `libmdbx` or flat segment file operations.
+#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]
+#[error("mdbx storage error: {0}")]
+pub struct MdbxError(pub String);
+
+fn mdbx_err(rc: c_int) -> MdbxError {
+    let mut buf = [0 as c_char; 256];
+    let msg = unsafe {
+        let ptr = mdbx_strerror_r(rc, buf.as_mut_ptr(), buf.len());
+        if ptr.is_null() {
+            format!("libmdbx error code {rc}")
+        } else {
+            CStr::from_ptr(ptr).to_string_lossy().into_owned()
+        }
+    };
+    MdbxError(format!("{msg} ({rc})"))
+}
+
+fn check_rc(rc: c_int) -> Result<(), MdbxError> {
+    if rc == MDBX_SUCCESS || rc == MDBX_RESULT_TRUE {
+        Ok(())
+    } else {
+        Err(mdbx_err(rc))
+    }
+}
