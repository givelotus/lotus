 src/node/metrics.cpp                      | 30 +++++++++++++++++++++++
 src/node/metrics.h                        | 15 ++++++++++++
 src/validation.cpp                        |  9 +++++++
 test/functional/interface_http_metrics.py | 25 +++++++++++++++++++
 6 files changed, 88 insertions(+)

