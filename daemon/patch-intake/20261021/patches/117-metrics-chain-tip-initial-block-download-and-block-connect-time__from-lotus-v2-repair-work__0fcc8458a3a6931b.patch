+        age = samples[("lotus_chain_tip_age_seconds", ())]
+        assert abs(age - (time.time() - tip_time)) < 30, age
+        assert samples[("lotus_block_connect_seconds_sum", ())] > 0
 
         self.log.info("HTTP and RPC requests")
         node.getblockcount()
