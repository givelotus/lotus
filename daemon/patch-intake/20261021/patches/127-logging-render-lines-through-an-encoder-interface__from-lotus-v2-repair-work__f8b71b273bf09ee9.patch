-void AppendDigits(std::string &out, uint32_t value, int width) {
-    char buf[10];
-    for (int i = width - 1; i >= 0; --i) {
-        buf[i] = char('0' + value % 10);
-        value /= 10;
-    }
-    out.append(buf, width);
-}
