-//! Characters needing no JSON escaping: printable ASCII but '"', '\\', DEL.
-constexpr std::array<bool, 256> JSON_PLAIN{[] {
-    std::array<bool, 256> plain{};
-    for (int c = 0x20; c < 0x7f; ++c) {
-        plain[c] = c != '"' && c != '\\';
-    }
-    return plain;
-}()};
