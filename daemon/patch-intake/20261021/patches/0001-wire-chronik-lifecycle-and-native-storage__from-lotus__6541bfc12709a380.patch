+bool BlockManager::MakeIndexedBlockDurable(const CBlockIndex& index)
+{
+    AssertLockHeld(::cs_main);
+    // WriteBlockIndexDB persists all dirty lookup/file metadata, including
+    // files newer than this queued callback. Flush every referenced dirty
+    // file first so a backlog spanning file rollover cannot publish metadata
+    // for future data that has not reached the same durability boundary.
+    std::set<int> files{m_dirty_fileinfo};
+    files.insert(index.nFile);
+    for (int file : files) {
+        if (!FlushBlockFile(file, /*fFinalize=*/false, /*finalize_undo=*/false)) return false;
+    }
+    WriteBlockIndexDB();
+    return true;
+}
+
+bool BlockManager::ReadIndexedTransaction(CMutableTransaction& tx, const FlatFilePos& pos) const
+{
+    try {
+        AutoFile file{OpenBlockFile(pos, /*fReadOnly=*/true)};
+        if (file.IsNull()) return false;
+        file >> TX_WITH_WITNESS(tx);
+        return true;
+    } catch (const std::exception& e) {
+        LogError("Reading indexed transaction at %s: %s", pos.ToString(), e.what());
+        return false;
+    }
+}
+
+bool BlockManager::ReadIndexedTransactionUndo(CTxUndo& undo, const FlatFilePos& pos) const
+{
+    try {
+        AutoFile file{OpenUndoFile(pos, /*fReadOnly=*/true)};
+        if (file.IsNull()) return false;
+        file >> undo;
+        return true;
+    } catch (const std::exception& e) {
+        LogError("Reading indexed transaction undo at %s: %s", pos.ToString(), e.what());
+        return false;
+    }
+}
+
 /** Open an undo file (rev?????.dat) */
 AutoFile BlockManager::OpenUndoFile(const FlatFilePos& pos, bool fReadOnly) const
 {
