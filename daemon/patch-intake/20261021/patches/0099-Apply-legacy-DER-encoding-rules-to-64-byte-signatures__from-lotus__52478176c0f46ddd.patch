From 7289b524baffc21091ee433f832ae59d4fc27512 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:30:49 -0700
Subject: [PATCH] Apply legacy DER encoding rules to 64-byte signatures

Dogecoin does not reserve Schnorr-length signatures. Tobias legacy verifier correctly selects ECDSA, but the inherited ABC encoding guards still bypass DER checks for CHECKSIG and reject that length for CHECKMULTISIG. Gate both Schnorr encoding exceptions on nonlegacy mode and test valid and malformed 64-byte DER encodings.

diff --git a/src/script/sigencoding.cpp b/src/script/sigencoding.cpp
index b484411a593f77ed4d9117f3cb8a47eae00772bc..32555d2e8acef6e5ea476a1db57185ed6f9813a1 100644
--- a/src/script/sigencoding.cpp
+++ b/src/script/sigencoding.cpp
@@ -160,7 +160,7 @@ static bool IsSchnorrSig(const slicedvaltype &sig) {
 static bool CheckRawECDSASignatureEncoding(const slicedvaltype &sig,
                                            uint32_t flags,
                                            ScriptError *serror) {
-    if (IsSchnorrSig(sig)) {
+    if (IsSchnorrSig(sig) && !(flags & SCRIPT_VERIFY_LEGACY_RULES)) {
         // In an ECDSA-only context, 64-byte signatures are forbidden.
         return set_error(serror, ScriptError::SIG_BADLENGTH);
     }
@@ -191,7 +191,7 @@ static bool CheckRawSchnorrSignatureEncoding(const slicedvaltype &sig,
 
 static bool CheckRawSignatureEncoding(const slicedvaltype &sig, uint32_t flags,
                                       ScriptError *serror) {
-    if (IsSchnorrSig(sig)) {
+    if (IsSchnorrSig(sig) && !(flags & SCRIPT_VERIFY_LEGACY_RULES)) {
         // In a generic-signature context, 64-byte signatures are interpreted
         // as Schnorr signatures (always correctly encoded).
         return true;
diff --git a/src/test/schnorr_tests.cpp b/src/test/schnorr_tests.cpp
index fc42fe742f57f1936df87834c8a0675fae60fb5b..895e7165c98b687f1a7435f0479270ce6dfa0319 100644
--- a/src/test/schnorr_tests.cpp
+++ b/src/test/schnorr_tests.cpp
@@ -114,6 +114,32 @@ BOOST_AUTO_TEST_CASE(opcodes_random_flags) {
         valtype Zero64_with_hashtype =
             SignatureWithHashType(Zero64, SigHashType().withForkId(hasForkId));
 
+        if (isLegacy) {
+            for (const auto &sig : {Zero64_with_hashtype, DER64_with_hashtype}) {
+                const bool badDer = sig == Zero64_with_hashtype &&
+                    (flags & (SCRIPT_VERIFY_DERSIG | SCRIPT_VERIFY_LOW_S |
+                              SCRIPT_VERIFY_STRICTENC));
+                const ScriptError failure = badDer ? ScriptError::SIG_DER :
+                    hasNullFail ? ScriptError::SIG_NULLFAIL : ScriptError::OK;
+                for (const auto &script : {scriptCHECKSIG, scriptCHECKMULTISIG}) {
+                    const bool multi = script == scriptCHECKMULTISIG;
+                    const std::vector<valtype> stack = multi
+                        ? std::vector<valtype>{{}, sig, {1}, pubkeyC, {1}}
+                        : std::vector<valtype>{sig, pubkeyC};
+                    if (failure == ScriptError::OK) {
+                        CheckPass(flags, stack, script, {});
+                    } else {
+                        CheckError(flags, stack, script, failure);
+                    }
+                }
+            }
+            CheckError(flags, {Zero64, {}, pubkeyC}, scriptCHECKDATASIG,
+                       ScriptError::BAD_OPCODE);
+            CheckError(flags, {DER64, {}, pubkeyC}, scriptCHECKDATASIGVERIFY,
+                       ScriptError::BAD_OPCODE);
+            continue;
+        }
+
         // Test CHECKSIG & CHECKDATASIG with he non-DER sig, which can fail from
         // encoding, otherwise upon verification.
         if (hasNullFail) {
diff --git a/src/test/sigencoding_tests.cpp b/src/test/sigencoding_tests.cpp
index ebec9b513b48d9a4c32e37b2e0e60023f01a7442..3945b9132ff2c4510cc62af6394488d4d9935a38 100644
--- a/src/test/sigencoding_tests.cpp
+++ b/src/test/sigencoding_tests.cpp
@@ -13,6 +13,26 @@
 
 BOOST_FIXTURE_TEST_SUITE(sigencoding_tests, BasicTestingSetup)
 
+BOOST_AUTO_TEST_CASE(legacy_64_byte_der_encoding) {
+    // Two 29-byte positive integers form a valid 64-byte DER signature.
+    // It must remain ECDSA under legacy rules, even at Schnorr's length.
+    valtype signature{0x30, 62, 0x02, 29};
+    signature.insert(signature.end(), 29, 1);
+    signature.push_back(0x02);
+    signature.push_back(29);
+    signature.insert(signature.end(), 29, 1);
+    signature.push_back(1); // SIGHASH_ALL
+    const uint32_t flags = SCRIPT_VERIFY_LEGACY_RULES | SCRIPT_VERIFY_DERSIG;
+    ScriptError err = ScriptError::OK;
+    BOOST_CHECK(CheckTransactionSignatureEncoding(signature, flags, &err));
+    BOOST_CHECK(CheckTransactionECDSASignatureEncoding(signature, flags, &err));
+    signature[0] = 0x31;
+    BOOST_CHECK(!CheckTransactionSignatureEncoding(signature, flags, &err));
+    BOOST_CHECK(err == ScriptError::SIG_DER);
+    BOOST_CHECK(!CheckTransactionECDSASignatureEncoding(signature, flags, &err));
+    BOOST_CHECK(err == ScriptError::SIG_DER);
+}
+
 static valtype SignatureWithHashType(valtype vchSig, SigHashType sigHash) {
     vchSig.push_back(static_cast<uint8_t>(sigHash.getRawSigHashType()));
     return vchSig;
@@ -196,7 +216,9 @@ BOOST_AUTO_TEST_CASE(checksignatureencoding_test) {
 
     MMIXLinearCongruentialGenerator lcg;
     for (int i = 0; i < 4096; i++) {
-        uint32_t flags = lcg.next();
+        // These vectors exercise the modern Schnorr encoding rules.
+        // Legacy 64-byte DER behavior is tested separately above.
+        uint32_t flags = lcg.next() & ~SCRIPT_VERIFY_LEGACY_RULES;
 
         ScriptError err = ScriptError::OK;
 
@@ -368,7 +390,9 @@ BOOST_AUTO_TEST_CASE(checkpubkeyencoding_test) {
 
     MMIXLinearCongruentialGenerator lcg;
     for (int i = 0; i < 4096; i++) {
-        uint32_t flags = lcg.next();
+        // These vectors exercise the modern Schnorr encoding rules.
+        // Legacy 64-byte DER behavior is tested separately above.
+        uint32_t flags = lcg.next() & ~SCRIPT_VERIFY_LEGACY_RULES;
 
         ScriptError err = ScriptError::OK;
 
@@ -406,7 +430,9 @@ BOOST_AUTO_TEST_CASE(checkschnorr_test) {
 
     MMIXLinearCongruentialGenerator lcg;
     for (int i = 0; i < 4096; i++) {
-        uint32_t flags = lcg.next();
+        // These vectors exercise the modern Schnorr encoding rules.
+        // Legacy 64-byte DER behavior is tested separately above.
+        uint32_t flags = lcg.next() & ~SCRIPT_VERIFY_LEGACY_RULES;
 
         const bool hasForkId = (flags & SCRIPT_ENABLE_SIGHASH_FORKID) != 0;
 
