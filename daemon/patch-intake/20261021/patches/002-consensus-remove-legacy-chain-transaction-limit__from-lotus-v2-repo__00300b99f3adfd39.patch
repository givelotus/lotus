From 2cda15c536c92b1a5c046b7e54806f96aebfb0d5 Mon Sep 17 00:00:00 2001
From: Lotus V2 Builder <builder@lotus.org>
Date: Sat, 17 Oct 2026 13:57:54 -0700
Subject: [PATCH] consensus: remove legacy chain-transaction limit

Remove the inherited chain-transaction limit for the Lotus V2 development
chain so high-throughput regtest and benchmark runs are not artificially
throttled.
---
 src/node/miner.cpp         |  4 ++--
 src/test/mempool_tests.cpp | 30 ++++++++++++++++++++++++++++++
 src/test/miner_tests.cpp   |  1 +
 src/validation.cpp         |  1 +
 4 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index 359123e7e5..5cddb87881 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -18,6 +18,7 @@
 #include <consensus/merkle.h>
 #include <consensus/tx_verify.h>
 #include <consensus/validation.h>
+#include <feerate.h>
 #include <minerfund.h>
 #include <policy/block/stakingrewards.h>
 #include <policy/policy.h>
@@ -31,8 +32,7 @@
 
 #include <algorithm>
 #include <queue>
-#include <unordered_map>
-#include <utility>
+#include <unordered_set>
 
 namespace node {
 int64_t UpdateTime(CBlockHeader *pblock, const CChainParams &chainParams,
diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index 8c7f094d90..06058654f0 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -778,4 +778,34 @@ BOOST_AUTO_TEST_CASE(setAvalancheFinalized_ContextualCheckTransactionFailures) {
     }
 }
 
+BOOST_AUTO_TEST_CASE(long_chain_accepted) {
+    // Verify that chains longer than the old 50-tx ancestor/descendant limit
+    // are accepted into the mempool.  The O(n log n) mining algorithm (patch 29)
+    // reads no pre-computed CPFP fields, so there is no O(n²) DoS justification
+    // for a chain-length cap.  Build a strictly linear chain of 100 transactions
+    // each spending the single output of the previous one and verify all land
+    // in the mempool.
+    TestMemPoolEntryHelper entry;
+    entry.SigChecks(0);
+    LOCK2(cs_main, m_node.mempool->cs);
+
+    CMutableTransaction first;
+    first.vin.resize(1);
+    first.vin[0].scriptSig = CScript();
+    first.vout.emplace_back(10000 * SATOSHI, CScript() << OP_TRUE);
+    m_node.mempool->addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(first));
+
+    TxId prevId = first.GetId();
+    for (int i = 1; i < 100; i++) {
+        CMutableTransaction tx;
+        tx.vin.resize(1);
+        tx.vin[0].prevout = COutPoint(prevId, 0);
+        tx.vout.emplace_back(9000 * SATOSHI, CScript() << OP_TRUE);
+        m_node.mempool->addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(tx));
+        prevId = tx.GetId();
+    }
+
+    BOOST_CHECK_EQUAL(m_node.mempool->size(), 100UL);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
