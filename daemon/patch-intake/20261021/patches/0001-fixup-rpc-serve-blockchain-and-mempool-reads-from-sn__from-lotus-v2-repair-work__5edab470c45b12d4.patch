From 2bd978da071d0983a3f339916783b8c69c43995d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 11:06:23 -0700
Subject: [PATCH 1/6] fixup! rpc: serve blockchain and mempool reads from
 snapshots

---
 src/test/util/chainstate.h                    |  7 ++++++-
 .../validation_chainstatemanager_tests.cpp    | 21 +++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/src/test/util/chainstate.h b/src/test/util/chainstate.h
index 1f00ed4b64..ecb04c38bb 100644
--- a/src/test/util/chainstate.h
+++ b/src/test/util/chainstate.h
@@ -18,6 +18,8 @@
 
 #include <boost/test/unit_test.hpp>
 
+#include <functional>
+
 const auto NoMalleation = [](AutoFile &file, node::SnapshotMetadata &meta) {};
 
 /**
@@ -34,7 +36,8 @@ template <typename F = decltype(NoMalleation)>
 static bool CreateAndActivateUTXOSnapshot(TestingSetup *fixture,
                                           F malleation = NoMalleation,
                                           bool reset_chainstate = false,
-                                          bool in_memory_chainstate = false) {
+                                          bool in_memory_chainstate = false,
+                                          std::function<void()> before_activate = {}) {
     node::NodeContext &node = fixture->m_node;
     fs::path root = fixture->m_path_root;
 
@@ -133,6 +136,8 @@ static bool CreateAndActivateUTXOSnapshot(TestingSetup *fixture,
         new_active.m_chain.SetTip(*(tip->pprev));
     }
 
+    if (before_activate) before_activate();
+
     auto res = node.chainman->ActivateSnapshot(auto_infile, metadata,
                                                in_memory_chainstate);
 
diff --git a/src/test/validation_chainstatemanager_tests.cpp b/src/test/validation_chainstatemanager_tests.cpp
index e3caa6cc12..8ffe01529b 100644
--- a/src/test/validation_chainstatemanager_tests.cpp
+++ b/src/test/validation_chainstatemanager_tests.cpp
@@ -8,6 +8,7 @@
 #include <kernel/disconnected_transactions.h>
 #include <node/chainstatemanager_args.h>
 #include <node/kernel_notifications.h>
+#include <node/snapshot.h>
 #include <node/utxo_snapshot.h>
 #include <primitives/blockhash.h>
 #include <random.h>
@@ -37,6 +38,26 @@ using util::ToString;
 
 BOOST_FIXTURE_TEST_SUITE(validation_chainstatemanager_tests, TestingSetup)
 
+// A chainstate switch must replace the last immutable RPC generation even
+// though the ChainstateManager object's address remains unchanged.
+BOOST_FIXTURE_TEST_CASE(snapshot_activation_publishes_new_rpc_tip, TestChain100Setup) {
+    mineBlocks(10);
+    auto &manager = *m_node.chainman;
+    BOOST_REQUIRE(CreateAndActivateUTXOSnapshot(
+        this, NoMalleation, false, true, [&] {
+            LOCK(::cs_main);
+            BOOST_REQUIRE_EQUAL(manager.ActiveHeight(), 109);
+            node::PublishChainTipSnapshot(manager, m_node.mempool.get());
+            BOOST_REQUIRE_EQUAL(node::GetChainTipSnapshot()->height, 109);
+        }));
+    const auto published = node::GetChainTipSnapshot();
+    BOOST_REQUIRE(published);
+    BOOST_CHECK_EQUAL(published->chainman_ptr, &manager);
+    BOOST_CHECK_EQUAL(published->height, 110);
+    BOOST_CHECK_EQUAL(published->best_block_hash,
+                     WITH_LOCK(::cs_main, return manager.ActiveTip()->GetBlockHash()));
+}
+
 //! Basic tests for ChainstateManager.
 //!
 //! First create a legacy (IBD) chainstate, then create a snapshot chainstate.
