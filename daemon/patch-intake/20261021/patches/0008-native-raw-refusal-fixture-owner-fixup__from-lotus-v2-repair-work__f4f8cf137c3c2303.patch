From 0e519e0fe2870726e4e3323a00ae8110c941e498 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 07:44:26 -0700
Subject: [PATCH] fixup! [v2 only] net: P2P over WebSocket only, on the P2P
 port

Align the native WebSocket-only refusal fixture with the shared raw-off port classifier retained by this owner. Raw Bitcoin P2P is closed before HTTP parsing, so require the exact raw-refusal log and EOF/reset with no response bytes instead of HTTP400. Catch only ConnectionResetError (timeout and other socket errors still fail); preserve peer transport checks, manual destination/handshake behavior, whitebind and shared listener assertions. Actual unchanged daemon before-control reaches this stale oracle after successful WS block sync/manual-name checks.
---
 test/functional/p2p_websocket_only.py | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/test/functional/p2p_websocket_only.py b/test/functional/p2p_websocket_only.py
index ed31885e4e..34917a5c32 100755
--- a/test/functional/p2p_websocket_only.py
+++ b/test/functional/p2p_websocket_only.py
@@ -71,10 +71,15 @@ class P2PWebSocketOnlyTest(BitcoinTestFramework):
             + b"version".ljust(12, b"\x00")
             + len(payload).to_bytes(4, "little")
         )
-        with socket.create_connection(("127.0.0.1", p2p_port(0)), timeout=10) as s:
-            s.sendall(header + b"\x00" * 4 + payload)
-            reply = s.recv(64)
-        assert reply.startswith(b"HTTP/1.1 400"), reply
+        with node0.assert_debug_log(["raw P2P is not accepted (-p2prawlisten=0)"]):
+            with socket.create_connection(("127.0.0.1", p2p_port(0)), timeout=10) as s:
+                s.sendall(header + b"\x00" * 4 + payload)
+                try:
+                    reply = s.recv(64)
+                except ConnectionResetError:
+                    # The shared port classifier closes raw P2P before HTTP.
+                    reply = b""
+        assert_equal(reply, b"")
         assert all(p["transport"] == "ws" for p in node0.getpeerinfo())
 
         self.log.info("-whitebind permissions apply to WebSocket peers")
