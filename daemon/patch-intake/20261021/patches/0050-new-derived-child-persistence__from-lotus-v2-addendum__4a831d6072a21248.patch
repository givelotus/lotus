From 7bac9554aeaadc5fea0c6fcec9e3fb3d3f0e15b4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 00:39:17 -0700
Subject: [PATCH] fixup! v2: swap CBlockHeader and block index to 134-byte V2
 header and BLAKE3 BlockId

Mark every derived child snapshot unpersisted even when its parent was loaded from disk. Loaded ancestors are correctly already on disk, but that flag must not suppress writing a new child during bounded cache eviction. Add an independent reload-parent/derive-child/exceed64-entry-cache regression requiring child file existence, read-back and exact state commitment: before2failures, afterpass. Full candidate suite and recorded-seed validation ordering/reorg tests pass without relaxing roots or cache limits.

Tier: V2 (fixup to v2: swap CBlockHeader and block index to 134-byte V2 header and BLAKE3 BlockId; correct bounded ancestor-cache repair58bcd6e706)
---
 src/primitives/block.cpp              |  3 ++
 src/test/v2_candidate_state_tests.cpp | 53 +++++++++++++++++++++++++++
 2 files changed, 56 insertions(+)

diff --git a/src/primitives/block.cpp b/src/primitives/block.cpp
index d8de813b78..eb9e1537ce 100644
--- a/src/primitives/block.cpp
+++ b/src/primitives/block.cpp
@@ -584,6 +584,9 @@ V2BlockStateSnapshot BuildNextV2BlockState(const CBlock &block,
                 state.inserted_coins.clear();
             }
         }
+        // Loading the parent may mark its snapshot persisted. This derived
+        // child has not been written and must still be persisted on eviction.
+        state.persisted_to_disk = false;
         parent_utxo_digest = SmtRoot(state.utxo_root);
         parent_mon_state = state.mon_state;
 
diff --git a/src/test/v2_candidate_state_tests.cpp b/src/test/v2_candidate_state_tests.cpp
index 665e4cd5bc..7e3b9d036d 100644
--- a/src/test/v2_candidate_state_tests.cpp
+++ b/src/test/v2_candidate_state_tests.cpp
@@ -107,6 +107,59 @@ BOOST_AUTO_TEST_CASE(overlay_mismatch_does_not_publish_state_or_supply) {
                                              true, &hash, &expected) == expected);
     BOOST_CHECK(GetV2BlockStateSnapshot(hash, root, monetary));
 }
+BOOST_AUTO_TEST_CASE(child_of_reloaded_parent_is_persisted_on_eviction) {
+    const auto dir = std::filesystem::temp_directory_path() /
+        ("lotus-reloaded-parent-child-" + std::to_string(
+            std::chrono::steady_clock::now().time_since_epoch().count()));
+    SetV2StatePersistDir(dir.string());
+    CBlock parent;
+    parent.nBits = 0x207fffff;
+    parent.nHeight = 1;
+    parent.nNonce = 0x5501;
+    parent.hashStateRoot = ComputeV2BlockStateRoot(parent, BlockHash{}, 1, 0, false);
+    const auto parent_hash = parent.GetHash();
+    RecordV2BlockState(parent, parent_hash, BlockHash{}, 1, 0);
+    BOOST_REQUIRE(FlushV2BlockStatesToDisk());
+    SetV2StatePersistDir("");
+    SetV2StatePersistDir(dir.string());
+    std::shared_ptr<const lotus::v2::SmtNode> loaded;
+    lotus::v2::MonetaryState monetary;
+    BOOST_REQUIRE(GetV2BlockStateSnapshot(parent_hash, loaded, monetary));
+    // Drop this read-back cache entry without deleting its complete file, so
+    // deriving the new child has to load the already-persisted parent itself.
+    SetV2StatePersistDir("");
+    SetV2StatePersistDir(dir.string());
+    CBlock child;
+    child.nBits = 0x207fffff;
+    child.nHeight = 2;
+    child.nNonce = 0x5502;
+    child.hashPrevBlock = parent_hash;
+    child.hashStateRoot = ComputeV2BlockStateRoot(child, parent_hash, 2, 0, false);
+    const auto child_hash = child.GetHash();
+    RecordV2BlockState(child, child_hash, parent_hash, 2, 0);
+    // Exceed the existing64-entry disk-backed cache without revisiting child.
+    for (uint64_t i = 0; i < 65; ++i) {
+        CBlock other;
+        other.nBits = 0x207fffff;
+        other.nHeight = 1;
+        other.nNonce = 0x5600 + i;
+        other.hashStateRoot = ComputeV2BlockStateRoot(other, BlockHash{}, 1, 0, false);
+        RecordV2BlockState(other, other.GetHash(), BlockHash{}, 1, 0);
+    }
+    const auto child_file = dir / (child_hash.GetHex() + ".bin");
+    const bool persisted = std::filesystem::is_regular_file(child_file);
+    BOOST_CHECK_MESSAGE(persisted, "Missing newly derived child file: " << child_file.string());
+    BOOST_CHECK(GetV2BlockStateSnapshot(child_hash, loaded, monetary));
+    if (persisted) {
+        const auto digest = lotus::v2::StateRoot(GetActiveV2ChainId(), 2,
+                                                lotus::v2::SmtRoot(loaded), monetary);
+        uint256 restored;
+        std::copy_n(digest.begin(), 32, restored.begin());
+        BOOST_CHECK(restored == child.hashStateRoot);
+    }
+    SetV2StatePersistDir("");
+    if (persisted) std::filesystem::remove_all(dir);
+}
