From 23fe866fe5e6ae9d7d5d1e4790c3c0e36efa0ba2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:18:42 -0700
Subject: [PATCH] fixup! logging: structure connection limits and relative
 data-directory startup

Make the focused connection-budget test disable Avalanche explicitly.
Its correct outbound reservation otherwise raises maxconnections=7 to150.
Found by inspecting the old227 actual node logs before after-gate launch;
production behavior was correct. No C++ or registry changes.
---
 test/functional/feature_logging_connection_startup.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/test/functional/feature_logging_connection_startup.py b/test/functional/feature_logging_connection_startup.py
index fe96e89349928cfe896410ef351275a153e1248f..eb19e9f36686f3559747912b504e8968daf2e1f6 100644
--- a/test/functional/feature_logging_connection_startup.py
+++ b/test/functional/feature_logging_connection_startup.py
@@ -15,7 +15,9 @@ class ConnectionStartupLoggingTest(BitcoinTestFramework):
     num_nodes = 1
     setup_clean_chain = True
     wallet_names = []
-    extra_args = [["-logformat=json", "-maxconnections=7", "-logratelimit=0"]]
+    extra_args = [
+        ["-logformat=json", "-avalanche=0", "-maxconnections=7", "-logratelimit=0"]
+    ]
 
     def run_test(self):
         node = self.nodes[0]
