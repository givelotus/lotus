     : vin(), vout(), nVersion(CTransaction::CURRENT_VERSION), nLockTime(0),
-      m_serialize_size(ComputeSerializeSize()), hash(),
-      m_precomputed(PrecomputedTransactionData::Compute(*this)) {}
+      m_serialize_size(ComputeSerializeSize()), hash() {}
 CTransaction::CTransaction(const CMutableTransaction &tx)
     : vin(tx.vin.begin(), tx.vin.end()), vout(tx.vout.begin(), tx.vout.end()),
       nVersion(tx.nVersion), nLockTime(tx.nLockTime),
