 src/primitives/transaction.h   | 26 ++++++++++++++---
 src/test/miner_tests.cpp       |  3 +-
 src/test/transaction_tests.cpp | 52 ++++++++++++++++++++++++++++++++--
 src/test/txpackage_tests.cpp   | 18 ++++++------
 src/test/undo_tests.cpp        |  4 +--
 src/test/validation_tests.cpp  |  3 +-
