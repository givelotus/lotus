From 8d6770e60a3202a0d343964336b3728db0972e25 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 16:28:15 -0700
Subject: [PATCH] blockstorage: allocate block index entries with
 ChunkedSlabAllocator

Reuse the single-threaded ChunkedSlabAllocator header introduced by ecash/056 for BlockManager block-index entries protected by cs_main.
---
 src/node/blockstorage.h         | 10 ++++++--
 src/test/blockmanager_tests.cpp | 43 +++++++++++++++++++++++++++++++++
 2 files changed, 51 insertions(+), 2 deletions(-)

diff --git a/src/node/blockstorage.h b/src/node/blockstorage.h
index 0f769e2dd0698f80b8309e328c49876cc04d130c..7ae6e90132d0d2a811c58d025927db1ab294cffb 100644
--- a/src/node/blockstorage.h
+++ b/src/node/blockstorage.h
@@ -19,6 +19,7 @@
 #include <kernel/chain.h>
 #include <kernel/cs_main.h>
 #include <protocol.h>
+#include <support/allocators/chunked_slab.h>
 #include <sync.h>
 #include <txdb.h>
 #include <util/fs.h>
@@ -68,8 +69,13 @@ static constexpr size_t UNDO_DATA_DISK_OVERHEAD{
 // Because validation code takes pointers to the map's CBlockIndex objects, if
 // we ever switch to another associative container, we need to either use a
 // container that has stable addressing (true of all std associative
-// containers), or make the key a `std::unique_ptr<CBlockIndex>`
-using BlockMap = std::unordered_map<BlockHash, CBlockIndex, BlockHasher>;
+// containers), or make the key a `std::unique_ptr<CBlockIndex>`.
+// Nodes are carved from contiguous slab chunks, which never move, so this
+// keeps stable addressing while packing CBlockIndex entries densely for
+// pprev/GetAncestor() traversal. The map is only mutated under cs_main.
+using BlockMap = std::unordered_map<
+    BlockHash, CBlockIndex, BlockHasher, std::equal_to<BlockHash>,
+    ChunkedSlabAllocator<std::pair<const BlockHash, CBlockIndex>, 16384>>;
 
 struct PruneLockInfo {
     //! Height of earliest block that should be kept and not pruned
diff --git a/src/test/blockmanager_tests.cpp b/src/test/blockmanager_tests.cpp
index 4372109abd7fa1db888cbfddfdc6dc17a245abf0..6b4b9f85eb342bb4ba4c2af7f48bc97b244380d5 100644
--- a/src/test/blockmanager_tests.cpp
+++ b/src/test/blockmanager_tests.cpp
@@ -11,6 +11,8 @@
 #include <util/chaintype.h>
 #include <validation.h>
 
+#include <arith_uint256.h>
+
 #include <boost/test/unit_test.hpp>
 #include <test/util/logging.h>
 #include <test/util/setup_common.h>
@@ -221,4 +223,45 @@ BOOST_AUTO_TEST_CASE(blockmanager_flush_block_file) {
     BOOST_CHECK_EQUAL(read_block.nVersion, 2);
 }
 
+BOOST_AUTO_TEST_CASE(blockmap_slab_pointer_stability) {
+    // BlockMap nodes are carved from 16384-slot slab chunks. Inserting enough
+    // entries to force several rehashes must not move any CBlockIndex, since
+    // validation holds raw CBlockIndex pointers into the map.
+    constexpr size_t NUM_ENTRIES{3 * 16384 + 100};
+    node::BlockMap map;
+    std::vector<std::pair<BlockHash, const CBlockIndex *>> first_entries;
+    for (size_t i = 0; i < NUM_ENTRIES; ++i) {
+        const BlockHash hash{ArithToUint256(arith_uint256{i + 1})};
+        auto [it, inserted] = map.try_emplace(hash);
+        BOOST_REQUIRE(inserted);
+        it->second.nHeight = int(i);
+        if (i < 100) {
+            first_entries.emplace_back(hash, &it->second);
+        }
+    }
+    BOOST_CHECK_EQUAL(map.size(), NUM_ENTRIES);
+    for (size_t i = 0; i < first_entries.size(); ++i) {
+        const auto &[hash, pindex] = first_entries[i];
+        const auto it = map.find(hash);
+        BOOST_REQUIRE(it != map.end());
+        BOOST_CHECK_EQUAL(&it->second, pindex);
+        BOOST_CHECK_EQUAL(pindex->nHeight, int(i));
+    }
+    // Four node chunks hold all entries; bucket arrays use operator new.
+    const size_t chunks = map.get_allocator().resource()->NumAllocatedChunks();
+    BOOST_CHECK_GE(chunks, 4U);
+    BOOST_CHECK_LE(chunks, 5U);
+
+    // Erased slots are recycled before a new chunk is carved.
+    for (size_t i = 0; i < 16384; ++i) {
+        map.erase(BlockHash{ArithToUint256(arith_uint256{i + 1})});
+    }
+    for (size_t i = 0; i < 16384; ++i) {
+        map.try_emplace(
+            BlockHash{ArithToUint256(arith_uint256{NUM_ENTRIES + i + 1})});
+    }
+    BOOST_CHECK_EQUAL(map.get_allocator().resource()->NumAllocatedChunks(),
+                      chunks);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
