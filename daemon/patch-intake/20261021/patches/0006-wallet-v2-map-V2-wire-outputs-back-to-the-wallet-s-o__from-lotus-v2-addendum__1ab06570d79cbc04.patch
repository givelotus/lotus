--- a/src/wallet/wallet.cpp
+++ b/src/wallet/wallet.cpp
@@ -1172,11 +1172,54 @@ bool CWallet::LoadToWallet(const TxId &txid, const UpdateWalletTxFn &fill_wtx) {
     return true;
 }
 
-bool CWallet::AddToWalletIfInvolvingMe(const CTransactionRef &ptx,
+CTransactionRef CWallet::WithV2OutputScripts(const CTransactionRef &tx) const {
+    AssertLockHeld(cs_wallet);
+    std::optional<CMutableTransaction> restored;
+    for (size_t i = 0; i < tx->vout.size(); ++i) {
+        const CTxOut &out = tx->vout[i];
+        // The synthetic wire script of a plain single-branch output:
+        // flags 0, value, one branch, one path {0} (see CTxOut::FromV2Output).
+        const CScript &spk = out.scriptPubKey;
+        if (out.vBranches.size() != 1 || spk.size() != 45 || spk[0] != 0x00 ||
+            spk[9] != 0x01 || spk[42] != 0x01 || spk[43] != 0x01 ||
+            spk[44] != 0x00 ||
+            !std::equal(out.vBranches[0].begin(), out.vBranches[0].end(),
+                        spk.begin() + 10)) {
+            continue;
+        }
+        uint256 branch;
+        std::copy(out.vBranches[0].begin(), out.vBranches[0].end(),
+                  branch.begin());
+        for (const auto &spk_man_pair : m_spk_managers) {
+            if (auto script =
+                    spk_man_pair.second->GetScriptForV2Branch(branch)) {
+                if (!restored) {
+                    restored.emplace(*tx);
+                }
+                restored->vout[i].scriptPubKey = std::move(*script);
+                break;
+            }
+        }
+    }
+    if (!restored) {
+        return tx;
+    }
+    CTransactionRef result = MakeTransactionRef(std::move(*restored));
+    // The script is not part of the V2 wire or identity, so this cannot
+    // change; never substitute a different transaction if it somehow did.
+    if (result->GetId() != tx->GetId() || result->GetHash() != tx->GetHash()) {
+        return tx;
+    }
+    return result;
+}
+
+bool CWallet::AddToWalletIfInvolvingMe(const CTransactionRef &ptx_wire,
                                        CWalletTx::Confirmation confirm,
                                        bool fUpdate) {
     AssertLockHeld(cs_wallet);
 
+    const CTransactionRef ptx = WithV2OutputScripts(ptx_wire);
+
     const TxId &txid = ptx->GetId();
 
     if (!confirm.hashBlock.IsNull()) {
@@ -2278,6 +2321,16 @@ DBErrors CWallet::LoadWallet() {
         return nLoadWalletRet;
     }
 
+    // Transactions are read before the keys and scripts that recognize their
+    // outputs, so restore V2 output scripts once everything is loaded.
+    for (auto &[txid, wtx] : mapWallet) {
+        CTransactionRef tx = WithV2OutputScripts(wtx.tx);
+        if (tx != wtx.tx) {
+            wtx.tx = std::move(tx);
+            wtx.MarkDirty();
+        }
+    }
+
     return DBErrors::LOAD_OK;
 }
 
