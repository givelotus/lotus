diff --git a/src/wallet/scriptpubkeyman.cpp b/src/wallet/scriptpubkeyman.cpp
index 3d596a11c3..d0776f94ef 100644
--- a/src/wallet/scriptpubkeyman.cpp
+++ b/src/wallet/scriptpubkeyman.cpp
@@ -6,6 +6,7 @@
 #include <common/args.h>
 #include <config.h>
 #include <key_io.h>
+#include <lotus_v2/commitment.h>
 #include <logging.h>
 #include <node/types.h>
 #include <outputtype.h>
@@ -156,6 +157,58 @@ IsMineResult IsMineInner(const LegacyScriptPubKeyMan &keystore,
 
 } // namespace
 
+namespace {
+uint256 V2BranchOf(const CScript &script) {
+    const lotus::v2::Hash leaf = lotus::v2::BranchLeaf(
+        std::span<const uint8_t>(script.data(), script.size()));
+    uint256 branch;
+    std::copy(leaf.begin(), leaf.end(), branch.begin());
+    return branch;
+}
+} // namespace
+
+std::optional<CScript>
+LegacyScriptPubKeyMan::GetScriptForV2Branch(const uint256 &branch) const {
+    LOCK(cs_KeyStore);
+    const std::array<size_t, 6> state{
+        mapKeys.size(),      mapCryptedKeys.size(), mapScripts.size(),
+        setWatchOnly.size(), mapWatchKeys.size(),   m_watch_only_removals};
+    if (state != m_v2_branch_index_state) {
+        // The scripts IsMine can recognize from what is stored: pay-to-pubkey
+        // and pay-to-pubkey-hash for every key, pay-to-script-hash for every
+        // redeem script, and every watch-only script.
+        m_v2_branch_scripts.clear();
+        const auto add = [&](const CScript &script) {
+            m_v2_branch_scripts.emplace(V2BranchOf(script), script);
+        };
+        const auto add_pubkey = [&](const CPubKey &pubkey) {
+            add(GetScriptForRawPubKey(pubkey));
+            add(GetScriptForDestination(PKHash(pubkey)));
+        };
+        for (const auto &[keyid, key] : mapKeys) {
+            add_pubkey(key.GetPubKey());
+        }
+        for (const auto &[keyid, crypted] : mapCryptedKeys) {
+            add_pubkey(crypted.first);
+        }
+        for (const auto &[keyid, pubkey] : mapWatchKeys) {
+            add_pubkey(pubkey);
+        }
+        for (const auto &[scriptid, script] : mapScripts) {
+            add(GetScriptForDestination(ScriptHash(script)));
+        }
+        for (const CScript &script : setWatchOnly) {
+            add(script);
+        }
+        m_v2_branch_index_state = state;
+    }
+    const auto it = m_v2_branch_scripts.find(branch);
+    if (it == m_v2_branch_scripts.end()) {
+        return std::nullopt;
+    }
+    return it->second;
+}
+
 isminetype LegacyScriptPubKeyMan::IsMine(const CScript &script) const {
     switch (IsMineInner(*this, script, IsMineSigVersion::TOP)) {
         case IsMineResult::INVALID:
@@ -822,6 +875,7 @@ bool LegacyScriptPubKeyMan::RemoveWatchOnly(const CScript &dest) {
     {
         LOCK(cs_KeyStore);
         setWatchOnly.erase(dest);
+        ++m_watch_only_removals;
         CPubKey pubKey;
         if (ExtractPubKey(dest, pubKey)) {
             mapWatchKeys.erase(pubKey.GetID());
@@ -1710,6 +1764,25 @@ DescriptorScriptPubKeyMan::GetNewDestination(const OutputType type) {
     }
 }
 
+std::optional<CScript>
+DescriptorScriptPubKeyMan::GetScriptForV2Branch(const uint256 &branch) const {
+    LOCK(cs_desc_man);
+    // The map only grows between descriptor updates (which reset the
+    // index), so its size identifies its contents.
+    if (m_v2_branch_index_size != m_map_script_pub_keys.size()) {
+        m_v2_branch_scripts.clear();
+        for (const auto &[script, index] : m_map_script_pub_keys) {
+            m_v2_branch_scripts.emplace(V2BranchOf(script), script);
+        }
+        m_v2_branch_index_size = m_map_script_pub_keys.size();
+    }
+    const auto it = m_v2_branch_scripts.find(branch);
+    if (it == m_v2_branch_scripts.end()) {
+        return std::nullopt;
+    }
+    return it->second;
+}
+
 isminetype DescriptorScriptPubKeyMan::IsMine(const CScript &script) const {
     LOCK(cs_desc_man);
     if (m_map_script_pub_keys.count(script) > 0) {
@@ -2409,6 +2482,8 @@ void DescriptorScriptPubKeyMan::UpdateWalletDescriptor(
 
     m_map_pubkeys.clear();
     m_map_script_pub_keys.clear();
+    m_v2_branch_scripts.clear();
+    m_v2_branch_index_size = 0;
     m_max_cached_index = -1;
     m_wallet_descriptor = descriptor;
 }
