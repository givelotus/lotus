 src/support/allocators/chunked_slab.h | 312 ++++++++++++++++++++++++++
 src/test/blockmanager_tests.cpp       |  43 ++++
 3 files changed, 363 insertions(+), 2 deletions(-)
 create mode 100644 src/support/allocators/chunked_slab.h

