From 0f441a2632013d6b1f168747eb8bfcaeadc15122 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 07:17:11 -0700
Subject: [PATCH] fixup! [v2 only] net: p2p-v2 WebSocket framing

Reuse the shared compress-once declaration of EncodeCoalescedLocked instead of redeclaring the identical method when adding p2p-v2 framing. Actual normal native ChronikON/walletON build at sealed405 fails in httpserver.cpp with the duplicate declaration; no framing or locking behavior changes.
---
 src/net_websocket_sock.h | 2 --
 1 file changed, 2 deletions(-)

diff --git a/src/net_websocket_sock.h b/src/net_websocket_sock.h
index 2947fa03d5..d1549b04be 100644
--- a/src/net_websocket_sock.h
+++ b/src/net_websocket_sock.h
@@ -109,8 +109,6 @@ private:
     //! Frame coalesced data; write as much as possible. False on error.
     /** Whether m_coalesce holds data that can be encoded now */
     bool CoalescedReadyLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
-    /** Encode what m_coalesce holds (whole messages only, in P2P_V2) */
-    void EncodeCoalescedLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
     bool FlushLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
     //! Read and decode what is available. False on fatal error.
     bool FillLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
-- 
