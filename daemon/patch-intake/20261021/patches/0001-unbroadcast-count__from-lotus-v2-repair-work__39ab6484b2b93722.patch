From 0cda9ca9a5153ae9fed825f7a292a0699064d083 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 23:38:28 -0700
Subject: [PATCH] fixup! rpc: publish immutable chain and mempool snapshots

PopulateMempoolScalarsLocked needs only the number of unbroadcast txids,
but GetUnbroadcastTxs returns std::set<TxId> by value. For U unbroadcast
transactions each scalar capture copies U tree nodes and then destroys
the temporary while mempool.cs is held: O(U) work and O(U) temporary space.

Add GetUnbroadcastTxCount, requiring and asserting the caller holds cs,
and read the authoritative set size directly in O(1) time and O(1) space.
Use it in snapshot scalars and the existing bulk-clear state comparison,
whose enclosing lock already holds pool.cs. Keep the copying getter for
relay and persistence consumers that need the IDs. No separate counter
or RPC field change is introduced.

The snapshot foundation already contained this cost; this is not evidence
of a new regression between the historical and current benchmark tips.
No throughput improvement is claimed without a controlled A/B measurement.

Causal-Owner: stable ID 15, 8e2d738c3453012b35a249aaca79e53c4b6ed516
Owner-Context: mempool_tests.cpp count-only caller belongs to stable ID 33,
 9ff6b73a0f99753b851ffd5b93218a5cc0e094c7; fold that hunk with its owner.
Validation: git diff --check; reviewed GUARDED_BY(cs), lock annotations,
 caller locks, authoritative set access, and remaining ID-copy consumers.
Compile/Runtime: NOT_RUN; defer bounded existing native suites until the
 current final507 benchmark compiler releases the shared resource window.
---
 src/node/snapshot.cpp      | 2 +-
 src/test/mempool_tests.cpp | 2 +-
 src/txmempool.h            | 6 ++++++
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/node/snapshot.cpp b/src/node/snapshot.cpp
index d1ea7053bd0314e6782be55d2c510c2315e44e96..87544d255809e19dca3fdc3d45d7e918205d35c6 100644
--- a/src/node/snapshot.cpp
+++ b/src/node/snapshot.cpp
@@ -223,7 +223,7 @@ void PopulateMempoolScalarsLocked(ChainAndMempoolSnapshot &snap,
     snap.last_rolling_fee_update = mempool.GetLastRollingFeeUpdate();
     snap.block_since_last_rolling_fee_bump =
         mempool.GetBlockSinceLastRollingFeeBump();
-    snap.unbroadcast_count = mempool.GetUnbroadcastTxs().size();
+    snap.unbroadcast_count = mempool.GetUnbroadcastTxCount();
     snap.transactions_updated = mempool.GetTransactionsUpdated();
     snap.mempool_sequence = mempool.GetSequence();
     snap.mempool_reset_seq = mempool.GetSnapshotResetSequence();
diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index b743c29ce97ec07643cb5f664a8638af51065ff4..300503610fe1f27266c73df03fdcec9a5f8a1b0f 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -1055,7 +1055,7 @@ BOOST_AUTO_TEST_CASE(bulk_clear_matches_staged_block_removal_state) {
         return std::make_tuple(pool.size(), pool.mapNextTx.size(),
             pool.GetTotalTxSize(), pool.GetTotalFee(), pool.DynamicMemoryUsage(),
             pool.GetTransactionsUpdated() - updates, pool.GetSequence() - sequence,
-            pool.GetRollingMinimumFeeRate(), pool.GetUnbroadcastTxs().size(),
+            pool.GetRollingMinimumFeeRate(), pool.GetUnbroadcastTxCount(),
             pool.GetUtxoFastFilter().MempoolSpentCount(),
             pool.GetUtxoFastFilter().UnspentCount(), overlay.GetFrozenEpochs().size(),
             overlay.GetSpeculativeOverlay().GetTxCount(), after->mempool_size,
diff --git a/src/txmempool.h b/src/txmempool.h
index 773797152b3c353af24f75442586e3e089feabca..6ae3e18f09d25c35353f67c0d5f2bd5ab4a2c4e3 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -605,6 +605,12 @@ public:
         return m_unbroadcast_txids;
     }
 
+    /** Returns the unbroadcast count without copying the transaction IDs. */
+    size_t GetUnbroadcastTxCount() const EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        AssertLockHeld(cs);
+        return m_unbroadcast_txids.size();
+    }
+
     /** Returns whether a txid is in the unbroadcast set */
     bool IsUnbroadcastTx(const TxId &txid) const EXCLUSIVE_LOCKS_REQUIRED(cs) {
         AssertLockHeld(cs);
