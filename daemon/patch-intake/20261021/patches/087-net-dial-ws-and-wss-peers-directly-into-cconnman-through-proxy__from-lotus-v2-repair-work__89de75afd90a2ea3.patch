+
+    @staticmethod
+    def recvall(conn, n):
+        data = b""
+        while len(data) < n:
+            chunk = conn.recv(n - len(data))
+            if not chunk:
+                raise ConnectionError("closed")
+            data += chunk
+        return data
+
+    def handle(self, conn):
+        try:
+            ver, nmethods = self.recvall(conn, 2)
+            self.recvall(conn, nmethods)
+            conn.sendall(b"\x05\x00")
+            ver, cmd, _, atyp = self.recvall(conn, 4)
+            if atyp == 3:
