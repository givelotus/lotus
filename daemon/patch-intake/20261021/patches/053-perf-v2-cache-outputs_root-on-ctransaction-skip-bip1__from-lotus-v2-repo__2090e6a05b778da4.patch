-    std::vector<uint8_t> encoded;
-    encoded.reserve(MAX_OUTPUT_BYTES);
-    encoded.push_back(output.flags);
-    AppendInteger(output.value, 8, encoded);
+    size_t exact_size = 0;
+    if (!ComputeOutputSerializedSize(output, exact_size, error)) return false;
+    result.clear();
+    result.reserve(exact_size);
+    result.push_back(output.flags);
+    AppendInteger(output.value, 8, result);
     if (output.HasToken())
-        encoded.insert(encoded.end(), output.token_id.begin(),
-                       output.token_id.end());
-    AppendCompactSize(output.branches.size(), encoded);
