 #include <policy/policy.h>
 #include <reverse_iterator.h>
 #include <random.h>
@@ -843,6 +846,49 @@ BOOST_AUTO_TEST_CASE(SanityCheckGetterAndSetter) {
     BOOST_CHECK_EQUAL(int(pool.getSanityCheck() * 1000.0), 1000);
 }
 
+BOOST_AUTO_TEST_CASE(SanityCheckTopologicalLongChain) {
+    CTxMemPool pool;
+    pool.setSanityCheck(1.0);
+    LOCK2(cs_main, pool.cs);
+    CCoinsViewCache coins(pcoinsTip.get());
+    const COutPoint funding(TxId(uint256S("01")), 0);
+    coins.AddCoin(funding, Coin(CTxOut(100000 * SATOSHI, CScript() << OP_TRUE), 0, false), false);
+
+    TestMemPoolEntryHelper entry;
+    std::vector<CTransactionRef> chain;
+    CMutableTransaction tx;
+    tx.vin.resize(1);
+    tx.vin[0].prevout = funding;
+    Amount value = 100000 * SATOSHI;
+    for (size_t i = 0; i < 512; ++i) {
+        value -= SATOSHI;
+        tx.vout = {CTxOut(value - SATOSHI, CScript() << OP_TRUE),
+                   CTxOut(SATOSHI, CScript() << OP_TRUE)};
+        chain.push_back(MakeTransactionRef(tx));
+        pool.addUnchecked(entry.Fee(SATOSHI).FromTx(chain.back()));
+        // Two inputs with one parent exercise deduplicated graph links.
+        tx.vin.resize(2);
+        tx.vin[0].prevout = COutPoint(chain.back()->GetId(), 0);
+        tx.vin[1].prevout = COutPoint(chain.back()->GetId(), 1);
+    }
+    BOOST_CHECK_EQUAL(pool.size(), chain.size());
+    // The hashed TxId index is unrelated to admission/topological order.
+    bool hashOrderIsTopological = true;
+    uint64_t previous = 0;
+    for (const auto &item : pool.mapTx) {
+        hashOrderIsTopological &= item.GetEntryId() > previous;
+        previous = item.GetEntryId();
+    }
+    BOOST_CHECK(!hashOrderIsTopological);
+    pool.check(&coins);
+    pool.removeRecursive(*chain[256]);
+    BOOST_CHECK_EQUAL(pool.size(), 256);
+    pool.check(&coins);
+    pool.removeRecursive(*chain.front());
+    BOOST_CHECK_EQUAL(pool.size(), 0);
+    pool.check(&coins);
+}
+
