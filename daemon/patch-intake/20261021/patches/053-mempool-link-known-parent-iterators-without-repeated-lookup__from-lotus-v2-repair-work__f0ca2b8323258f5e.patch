From 8147047761e3e3f19eaa2941361a45b1fe473fa8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] mempool: link known parent iterators without repeated lookup

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Resolve intra-batch and confirmed inputs in a single pass using the flat
open-addressed txid_table and CCoinsViewCache::PeekCoin, and link mempool
parent iterators in O(1).

Original-Commit: 2e1bd9c9d007e29db509bb92d0b3da0face7da0f
Original-Patch: ecash/039
Split-Concern: parents

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Application-Repair: Complete known-parent iterator API with its actual raw-batch Finalize consumer relocated from60. Retain direct per-input linkage and cached in-batch/existing parent iterators while preserving COW parent-change tracking, filter lifecycle and atomic no-trimming insertion. Ordinary admission still searches parents by default; no validation is bypassed.
---
 src/txmempool.cpp  | 33 ++++++++++++++++++++++-----------
 src/txmempool.h    |  5 ++++-
 src/validation.cpp | 26 +++++++++++++++++++++-----
 3 files changed, 47 insertions(+), 17 deletions(-)

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 674041eca51ffec1c7e14a0622079b07116c5ab6..b02a7c2a3226e0759743b0e13a3140d779e96930 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -162,7 +162,10 @@ void CTxMemPool::AddTransactionsUpdated(unsigned int n) {
     nTransactionsUpdated += n;
 }
 
-void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
+CTxMemPool::txiter CTxMemPool::addUnchecked(
+    CTxMemPoolEntryRef entry,
+    bool search_mempool_parents,
+    std::span<const txiter> batch_parent_iters) {
     // get a guaranteed unique id (in case tests re-use the same object)
     entry->SetEntryId(nextEntryId++);
 
@@ -192,19 +195,27 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
     cachedInnerUsage += entry->DynamicMemoryUsage();
 
     const CTransactionRef tx = entry->GetSharedTx();
-    std::set<TxId> setParentTransactions;
+    const TxId *last_parent_txid = nullptr;
     for (const CTxIn &in : tx->vin) {
         mapNextTx.insert(std::make_pair(&in.prevout, tx));
         m_utxo_fast_filter.MarkSpentInMempool(in.prevout.GetTxId().begin(), in.prevout.GetN());
-        setParentTransactions.insert(in.prevout.GetTxId());
+        if (search_mempool_parents &&
+            (!last_parent_txid || *last_parent_txid != in.prevout.GetTxId())) {
+            last_parent_txid = &in.prevout.GetTxId();
+            auto pit = mapTx.find(*last_parent_txid);
+            if (pit != mapTx.end() && pit != newit) {
+                UpdateParent(newit, pit, true);
+                UpdateChild(pit, newit, true);
+            }
+        }
     }
-    // Don't bother worrying about child transactions of this one. It is
-    // guaranteed that a new transaction arriving will not have any children,
-    // because such children would be orphans.
-
-    // Update ancestors with information about this tx
-    for (const auto &pit : GetIterSet(setParentTransactions)) {
-        UpdateParent(newit, pit, true);
+    if (!search_mempool_parents) {
+        for (const txiter &pit : batch_parent_iters) {
+            if (pit != mapTx.end() && pit != newit) {
+                UpdateParent(newit, pit, true);
+                UpdateChild(pit, newit, true);
+            }
+        }
     }
 
     for (uint32_t i = 0; i < tx->vout.size(); ++i) {
@@ -212,7 +223,6 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
             m_utxo_fast_filter.AddUnspent(tx->GetId().begin(), i);
         }
     }
-    UpdateParentsOf(true, newit);
     m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
                                        entry->GetSigChecks());
     m_overlay_warm.store(false, std::memory_order_relaxed);
@@ -222,6 +232,7 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
     m_total_fee += entry->GetFee();
     MarkSnapshotEntryChanged(tx->GetId());
     node::PublishMempoolSnapshot(*this);
+    return newit;
 }
 
 void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
diff --git a/src/txmempool.h b/src/txmempool.h
index 52b966683e3e86c70bbfa98d3b1d52a1fdca16e3..0a0b459fdb3b9cf5f3aca8dcbbd7c9e53460f094 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -35,6 +35,7 @@
 #include <memory>
 #include <optional>
 #include <set>
+#include <span>
 #include <string>
 #include <unordered_map>
 #include <utility>
@@ -377,7 +378,9 @@ public:
 
     // addUnchecked must update state for all parents of a given transaction,
     // updating child links as necessary.
-    void addUnchecked(CTxMemPoolEntryRef entry)
+    txiter addUnchecked(CTxMemPoolEntryRef entry,
+                        bool search_mempool_parents = true,
+                        std::span<const txiter> batch_parent_iters = {})
         EXCLUSIVE_LOCKS_REQUIRED(cs, cs_main);
 
     void removeRecursive(const CTransaction &tx, MemPoolRemovalReason reason)
diff --git a/src/validation.cpp b/src/validation.cpp
index cac5bea9d239951d9e7f9ad1afef0c8555aeb633..f5ac03db03bfaa8f347061d87b07ce2dca24c572 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -733,7 +733,9 @@ private:
     // Returns true if the transaction is in the mempool after any size
     // limiting is performed, false otherwise.
     bool Finalize(const ATMPArgs &args, Workspace &ws,
-        std::vector<PendingMempoolNotification> *deferred_notifications = nullptr)
+        std::vector<PendingMempoolNotification> *deferred_notifications = nullptr,
+        std::span<const CTxMemPool::txiter> batch_parent_iters = {},
+        CTxMemPool::txiter *out_iter = nullptr)
         EXCLUSIVE_LOCKS_REQUIRED(cs_main, m_pool.cs);
 
     // Submit all transactions to the mempool and call ConsensusScriptChecks to
@@ -1276,7 +1278,9 @@ bool MemPoolAccept::ConsensusScriptChecks(const ATMPArgs &args, Workspace &ws) {
 }
 
 bool MemPoolAccept::Finalize(const ATMPArgs &args, Workspace &ws,
-    std::vector<PendingMempoolNotification> *deferred_notifications) {
+    std::vector<PendingMempoolNotification> *deferred_notifications,
+    std::span<const CTxMemPool::txiter> batch_parent_iters,
+    CTxMemPool::txiter *out_iter) {
     AssertLockHeld(cs_main);
     AssertLockHeld(m_pool.cs);
     const TxId &txid = ws.m_ptx->GetId();
@@ -1286,7 +1290,9 @@ bool MemPoolAccept::Finalize(const ATMPArgs &args, Workspace &ws,
     // Store transaction in memory
     CTxMemPoolEntry *pentry = ws.m_entry.release();
     auto entry = CTxMemPoolEntryRef::acquire(pentry);
-    m_pool.addUnchecked(entry);
+    const auto newit = m_pool.addUnchecked(entry, !ws.m_inputs_pre_resolved,
+                                         batch_parent_iters);
+    if (out_iter) *out_iter = newit;
 
     auto spentCoins = ws.m_resolved_inputs.empty()
         ? GetSpentCoins(ws.m_ptx, m_view)
@@ -1965,8 +1971,18 @@ PackageMempoolAcceptResult MemPoolAccept::AcceptRawTxBatch(
 
         // No size trimming or script execution can partially accept a batch:
         // both were completed under the same chain/pool locks above.
-        for (Workspace &ws : workspaces) {
-            const bool inserted = Finalize(args, ws, &deferred_notifications);
+        std::vector<CTxMemPool::txiter> batch_iters(workspaces.size());
+        std::vector<CTxMemPool::txiter> parent_iters;
+        for (size_t idx = 0; idx < workspaces.size(); ++idx) {
+            Workspace &ws = workspaces[idx];
+            parent_iters.assign(ws.m_mempool_parent_iters.begin(),
+                                ws.m_mempool_parent_iters.end());
+            for (uint32_t parent_idx : ws.m_batch_parent_indices) {
+                assert(parent_idx < idx);
+                parent_iters.push_back(batch_iters[parent_idx]);
+            }
+            const bool inserted = Finalize(args, ws, &deferred_notifications,
+                                           parent_iters, &batch_iters[idx]);
             assert(inserted);
             const TxId &id = ws.m_ptx->GetId();
             results.emplace(id, MempoolAcceptResult::Success(ws.m_vsize, ws.m_base_fees,
