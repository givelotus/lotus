From d51c5808b1dc3fc5eb741b4c07c1c178f6170bab Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:23:14 -0700
Subject: [PATCH] Reject witness arguments above the 8192-byte element cap

The caller-selected profile may tighten the argument limit but cannot raise P01/P03 MAX_ELEMENT_BYTES. Exercise the exact 8192-byte acceptance boundary and reject a profile requesting 8193 bytes in Debug and Release.
---
 src/lotus_v2/test_transaction.cpp | 26 ++++++++++++++++++++++++++
 src/lotus_v2/transaction.cpp      |  6 +++++-
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/test_transaction.cpp b/src/lotus_v2/test_transaction.cpp
index 4c8a8373f..5d92b7e07 100644
--- a/src/lotus_v2/test_transaction.cpp
+++ b/src/lotus_v2/test_transaction.cpp
@@ -120,6 +120,31 @@ void FixedPayment() {
         !EncodeTransaction(tx, PROFILE, mutated, error)); // duplicate outpoint
 }
 
+void ArgumentElementBound() {
+    Transaction tx;
+    Input spend;
+    spend.prev_txid[0] = 1;
+    spend.sequence = UINT32_MAX;
+    spend.flags = 1;
+    spend.witnesses.resize(1);
+    spend.witnesses[0].script = {0x51};
+    spend.witnesses[0].arguments = {std::vector<uint8_t>(8192, 0x41)};
+    tx.inputs.push_back(spend);
+    std::vector<uint8_t> wire;
+    std::string error;
+    CHECK(EncodeTransaction(tx, PROFILE, wire, error));
+    Transaction decoded;
+    CHECK(DecodeTransaction(wire, PROFILE, decoded, error));
+    CHECK(decoded.inputs[0].witnesses[0].arguments[0].size() == 8192);
+
+    tx.inputs[0].witnesses[0].arguments[0].push_back(0x41);
+    CHECK(!EncodeTransaction(tx, PROFILE, wire, error));
+    TxProfile excessive = PROFILE;
+    excessive.max_argument_bytes = 8193;
+    CHECK(!EncodeTransaction(tx, excessive, wire, error));
+    CHECK(!DecodeTransaction(wire, excessive, decoded, error));
+}
+
 void Mint() {
     const auto payment = FromHex(
         "07000000000000000000000001000100"
@@ -256,6 +281,7 @@ void Corpus(const char *path) {
 
 int main(int argc, char **argv) {
     FixedPayment();
+    ArgumentElementBound();
     Mint();
     Coinbase();
     if (argc > 1) Corpus(argv[1]);
diff --git a/src/lotus_v2/transaction.cpp b/src/lotus_v2/transaction.cpp
index 903379eec..296047cff 100644
--- a/src/lotus_v2/transaction.cpp
+++ b/src/lotus_v2/transaction.cpp
@@ -7,6 +7,8 @@
 namespace lotus::v2 {
 namespace {
 
+    constexpr size_t MAX_WITNESS_ARGUMENT_BYTES = 8192;
+
     class Reader {
     public:
         explicit Reader(const std::vector<uint8_t> &frame) : frame_(frame) {}
@@ -82,7 +84,9 @@ namespace {
     bool ValidProfile(const TxProfile &p, std::string &error) {
         if (p.max_inputs == 0 || p.max_inputs > 65535 ||
             p.max_outputs > 65535 || p.max_mints > p.max_inputs ||
-            p.max_arguments > 65535 || p.max_branch_proof_depth > 64) {
+            p.max_arguments > 65535 ||
+            p.max_argument_bytes > MAX_WITNESS_ARGUMENT_BYTES ||
+            p.max_branch_proof_depth > 64) {
             error = "profile";
             return false;
         }
