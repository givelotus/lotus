+    MDBX_txn *txn = AcquireReadTxn();
+    int rc = mdbx_get(txn, m_dbi, &k, &v);
+    ReleaseReadTxn(txn);
+    if (rc == MDBX_SUCCESS) {
+        return true;
+    }
+    if (rc == MDBX_NOTFOUND) {
+        return false;
+    }
+    dbwrapper_private::HandleError(rc, "mdbx_get(exists)");
+    return false;
 }
 
