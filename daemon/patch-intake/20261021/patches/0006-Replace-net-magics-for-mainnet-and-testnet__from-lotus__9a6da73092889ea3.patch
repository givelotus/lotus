From b28d756c19fa14413d807daeadeb772c2aeac518 Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Tue, 11 Jun 2024 18:48:27 +0000
Subject: [PATCH] Replace net magics for mainnet and testnet

Maintenance explanation (added 2026-10-14; not original author text):
Use Dogecoin network message magic for peer framing rather than ABC magic.
Discovery changes do not implement the rest of Dogecoin consensus.

The original subject, author and author date are preserved. Only message
metadata changes; exact source diff bytes and intermediate trees are retained.

diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 87e56bca367bb71799e18230d63cd572a7df2c34..f06acace6a9230b9f7c46d99a9168a3f83b84603 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -161,10 +161,10 @@ public:
         diskMagic[1] = 0xbe;
         diskMagic[2] = 0xb4;
         diskMagic[3] = 0xd9;
-        netMagic[0] = 0xe3;
-        netMagic[1] = 0xe1;
-        netMagic[2] = 0xf3;
-        netMagic[3] = 0xe8;
+        netMagic[0] = 0xc0;
+        netMagic[1] = 0xc0;
+        netMagic[2] = 0xc0;
+        netMagic[3] = 0xc0;
         nDefaultPort = 22556;
         nPruneAfterHeight = 100000;
         m_assumed_blockchain_size =
@@ -323,10 +323,10 @@ public:
         diskMagic[1] = 0x11;
         diskMagic[2] = 0x09;
         diskMagic[3] = 0x07;
-        netMagic[0] = 0xf4;
-        netMagic[1] = 0xe5;
-        netMagic[2] = 0xf3;
-        netMagic[3] = 0xf4;
+        netMagic[0] = 0xfc;
+        netMagic[1] = 0xc1;
+        netMagic[2] = 0xb7;
+        netMagic[3] = 0xdc;
         nDefaultPort = 44556;
         nPruneAfterHeight = 1000;
         m_assumed_blockchain_size =
diff --git a/test/functional/test_framework/p2p.py b/test/functional/test_framework/p2p.py
index 60eb0b55771f08f3ee655f934549be2a3270062f..1bb2cb98cc2059e6731ad349025b5e13434bf4a6 100644
--- a/test/functional/test_framework/p2p.py
+++ b/test/functional/test_framework/p2p.py
@@ -147,8 +147,8 @@ MESSAGEMAP = {
 }
 
 NET_MAGIC_BYTES = {
-    "mainnet": b"\xe3\xe1\xf3\xe8",
-    "testnet3": b"\xf4\xe5\xf3\xf4",
+    "mainnet": b"\xc0\xc0\xc0\xc0",
+    "testnet3": b"\xfc\xc1\xb7\xdc",
     "regtest": b"\xda\xb5\xbf\xfa",
 }
 
