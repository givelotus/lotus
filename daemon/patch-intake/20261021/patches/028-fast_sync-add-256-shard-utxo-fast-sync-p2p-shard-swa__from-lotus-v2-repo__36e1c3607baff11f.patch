+MonetaryState MakeTestMonetaryState() {
+    MonetaryState m{};
+    m.bootstrap_reserve = 500000000;
+    m.tail_subsidy = 94;
+    m.prev_work[0] = 2;
+    m.ema_block_cost = 4000;
+    return m;
+}
