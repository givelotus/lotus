+                RequestNextReversePeelBlockLocked(
+                    peel_res.earliest_verified_height,
+                    peel_res.parent_blockhash);
+            }
+        }
+    }
+
+    if (peel_failed_discourage) {
+        m_peerman.DiscouragePeer(pfrom.GetId(), "bad-blockundo-peel");
+    }
