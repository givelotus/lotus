+void Chainstate::ActivateVerifiedFastSyncPivot(
+    CBlockIndex *pindex_pivot,
+    const std::vector<lotus::v2::Coin> &coins,
+    const lotus::v2::MonetaryState &monetary_state) {
+    AssertLockHeld(::cs_main);
+    Assert(pindex_pivot != nullptr);
+    const BlockHash pivot_hash = pindex_pivot->GetBlockHash();
+
+    ImportV2BlockStateCoinsAndMonetary(pivot_hash, coins, monetary_state,
+                                       /*is_tip=*/true);
+
+    if (HasCoinsViews()) {
+        CCoinsViewCache &coins_cache = CoinsTip();
+        coins_cache.Flush();
+        std::vector<COutPoint> existing_outpoints;
+        if (std::unique_ptr<CCoinsViewCursor> pcursor{CoinsDB().Cursor()}) {
+            while (pcursor->Valid()) {
+                COutPoint key;
+                if (pcursor->GetKey(key)) {
+                    existing_outpoints.push_back(key);
+                }
+                pcursor->Next();
+            }
+        }
+        for (const COutPoint &op : existing_outpoints) {
+            coins_cache.SpendCoin(op);
+        }
+        for (const auto &v2_coin : coins) {
+            uint256 raw_txid;
+            std::memcpy(raw_txid.begin(), v2_coin.outpoint.tx_id.data(), 32);
+            COutPoint outpoint{TxId{raw_txid}, v2_coin.outpoint.index};
+            CTxOut txout = CTxOut::FromV2Output(v2_coin.output);
+            ::Coin legacy_coin(std::move(txout),
+                               static_cast<uint32_t>(v2_coin.creation_height),
+                               v2_coin.coinbase);
+            coins_cache.AddCoin(outpoint, std::move(legacy_coin),
+                                /*possible_overwrite=*/true);
+        }
+        coins_cache.SetBestBlock(pivot_hash);
+        coins_cache.Flush();
+    }
+
+    if (!pindex_pivot->IsValid(BlockValidity::SCRIPTS) ||
+        !pindex_pivot->HaveNumChainTxs()) {
+        m_fast_sync_pivot_base = pindex_pivot;
+        if (!pindex_pivot->HaveNumChainTxs()) {
+            pindex_pivot->m_chain_tx_count =
+                static_cast<unsigned int>(pindex_pivot->nHeight + 1);
+            m_blockman.m_dirty_blockindex.insert(pindex_pivot);
+        }
+    }
+
+    if (m_chain.Tip() != pindex_pivot) {
+        m_chain.SetTip(*pindex_pivot);
+        setBlockIndexCandidates.insert(pindex_pivot);
+        PruneBlockIndexCandidates();
+        if (m_mempool) {
+            LOCK(m_mempool->cs);
+            m_mempool->ConnectBlockReset(
+                pivot_hash, static_cast<uint64_t>(pindex_pivot->nHeight + 1),
+                static_cast<uint64_t>(pindex_pivot->GetMedianTimePast()));
+        }
+        UpdateTip(pindex_pivot);
+    } else if (m_mempool) {
+        LOCK(m_mempool->cs);
+        m_mempool->ConnectBlockReset(
+            pivot_hash, static_cast<uint64_t>(pindex_pivot->nHeight + 1),
+            static_cast<uint64_t>(pindex_pivot->GetMedianTimePast()));
+    }
+
+    ActivateFastSyncPivot(pindex_pivot->nHeight);
+}
