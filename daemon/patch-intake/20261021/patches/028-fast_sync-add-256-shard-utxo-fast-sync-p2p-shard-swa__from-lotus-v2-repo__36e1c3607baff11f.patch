+                                    req.prefix_depth, req.prefix_bits,
+                                    shard_msg, err)) {
+        return;
+    }
+    std::vector<uint8_t> payload;
+    if (!lotus::v2::EncodeUtxoShardMessage(shard_msg, payload, err)) {
