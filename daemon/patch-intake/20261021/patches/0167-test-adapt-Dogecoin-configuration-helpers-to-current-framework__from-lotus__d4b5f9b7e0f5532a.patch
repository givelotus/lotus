From 69a34ff8d78bb1974ccdf0031f65642109d953bc Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:59:40 -0700
Subject: [PATCH] test: adapt Dogecoin configuration helpers to current
 framework

The ported default-fee test uses remove_from_config, but modern ABC removed config_path. Use the same dogecoin.conf path as append_config and cookie helpers. Align the temporary default-data-directory helper with doged platform paths so default-path tests remain isolated and meaningful.

diff --git a/test/functional/test_framework/util.py b/test/functional/test_framework/util.py
index 6b1d841c7a83e16de0894a38b2c2281f2de5fa16..9e677eedcdd9669c1ba3874a0ce87a6ec0ca6950 100644
--- a/test/functional/test_framework/util.py
+++ b/test/functional/test_framework/util.py
@@ -607,13 +607,13 @@ def get_temp_default_datadir(temp_dir: pathlib.Path) -> tuple[dict, pathlib.Path
     temp_dir, as well as the complete path it would return."""
     if sys.platform == "win32":
         env = {"APPDATA": str(temp_dir)}
-        datadir = temp_dir / "Bitcoin"
+        datadir = temp_dir / "doge"
     else:
         env = {"HOME": str(temp_dir)}
         if sys.platform == "darwin":
-            datadir = temp_dir / "Library/Application Support/Bitcoin"
+            datadir = temp_dir / "Library/Application Support/doge"
         else:
-            datadir = temp_dir / ".bitcoin"
+            datadir = temp_dir / ".doge"
     return env, datadir
 
 
@@ -624,12 +624,12 @@ def append_config(datadir, options):
 
 
 def remove_from_config(datadir, options):
-    with open(config_path(datadir), "r", encoding="utf8") as f:
+    with open(os.path.join(datadir, "dogecoin.conf"), "r", encoding="utf8") as f:
         config = f.read()
         for option in options:
             config = config.replace(option + "\n", "")
 
-    with open(config_path(datadir), "w", encoding="utf8") as f:
+    with open(os.path.join(datadir, "dogecoin.conf"), "w", encoding="utf8") as f:
         f.write(config)
 
 
