From 730339630a4e1766a216b9f319005ff23d86d855 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 17:01:57 -0700
Subject: [PATCH] node: report which block files may grow and announce
 pruned-file deletion

Readers outside BlockManager that keep block files open need two facts
the node did not expose:

- MayAppendToBlockFile(n): whether a block may still be written to
  blk n (it is a blockfile cursor's current file, or does not exist
  yet). Every other blk file is complete. The comment notes that undo
  data can still be appended to an older rev file when a block stored
  there is connected later (e.g. in a reorg).
- RegisterUnlinkFilesCallback(): UnlinkPrunedFiles runs the registered
  callbacks with the file numbers before it deletes them, so a reader
  can close its descriptors. Callbacks run under their own mutex, so
  none runs after UnregisterUnlinkFilesCallback() returns.

GetUndoPosFilename() completes GetBlockPosFilename() for rev files.

Test: blockmanager_unlink_files_callback (callbacks see the files
before deletion; unregistered callbacks never run).

Tier: eCash
---
 src/node/blockstorage.cpp       | 34 +++++++++++++++++++++++++
 src/node/blockstorage.h         | 36 ++++++++++++++++++++++++++-
 src/test/blockmanager_tests.cpp | 44 +++++++++++++++++++++++++++++++++
 3 files changed, 113 insertions(+), 1 deletion(-)

diff --git a/src/node/blockstorage.cpp b/src/node/blockstorage.cpp
index aa5965b08b68d3657e356c251d5a49405983c9dd..b815e65c44319343a7c2cbcc502680d2436d9374 100644
--- a/src/node/blockstorage.cpp
+++ b/src/node/blockstorage.cpp
@@ -671,8 +671,38 @@ uint64_t BlockManager::CalculateCurrentUsage() {
     return retval;
 }
 
+uint64_t
+BlockManager::RegisterUnlinkFilesCallback(UnlinkFilesCallback callback) {
+    LOCK(m_unlink_callbacks_mutex);
+    const uint64_t handle = m_next_unlink_callback++;
+    m_unlink_callbacks.emplace(handle, std::move(callback));
+    return handle;
+}
+
+void BlockManager::UnregisterUnlinkFilesCallback(uint64_t handle) {
+    LOCK(m_unlink_callbacks_mutex);
+    m_unlink_callbacks.erase(handle);
+}
+
+bool BlockManager::MayAppendToBlockFile(int file_num) {
+    LOCK(cs_LastBlockFile);
+    for (const auto &cursor : m_blockfile_cursors) {
+        if (cursor && cursor->file_num == file_num) {
+            return true;
+        }
+    }
+    return file_num > MaxBlockfileNum();
+}
+
 void BlockManager::UnlinkPrunedFiles(
     const std::set<int> &setFilesToPrune) const {
+    {
+        // Under the mutex, so no callback runs after its unregistration.
+        LOCK(m_unlink_callbacks_mutex);
+        for (const auto &[handle, callback] : m_unlink_callbacks) {
+            callback(setFilesToPrune);
+        }
+    }
     std::error_code error_code;
     for (const int i : setFilesToPrune) {
         FlatFilePos pos(i, 0);
@@ -712,6 +742,10 @@ fs::path BlockManager::GetBlockPosFilename(const FlatFilePos &pos) const {
     return BlockFileSeq().FileName(pos);
 }
 
+fs::path BlockManager::GetUndoPosFilename(const FlatFilePos &pos) const {
+    return UndoFileSeq().FileName(pos);
+}
+
 FlatFilePos BlockManager::FindNextBlockPos(unsigned int nAddSize,
                                            unsigned int nHeight,
                                            uint64_t nTime) {
diff --git a/src/node/blockstorage.h b/src/node/blockstorage.h
index 7ae6e90132d0d2a811c58d025927db1ab294cffb..10cc65952ca597162b8a247fd2bf69df3b468687 100644
--- a/src/node/blockstorage.h
+++ b/src/node/blockstorage.h
@@ -8,7 +8,9 @@
 #include <array>
 #include <cstdint>
 #include <functional>
+#include <map>
 #include <optional>
+#include <set>
 #include <unordered_map>
 #include <vector>
 
@@ -255,6 +257,11 @@ private:
 
     const kernel::BlockManagerOpts m_opts;
 
+    mutable Mutex m_unlink_callbacks_mutex;
+    std::map<uint64_t, std::function<void(const std::set<int> &)>>
+        m_unlink_callbacks GUARDED_BY(m_unlink_callbacks_mutex);
+    uint64_t m_next_unlink_callback GUARDED_BY(m_unlink_callbacks_mutex){0};
+
 public:
     using Options = kernel::BlockManagerOpts;
 
@@ -437,11 +444,38 @@ public:
 
     /** Translation to a filesystem path. */
     fs::path GetBlockPosFilename(const FlatFilePos &pos) const;
+    /** Path of the undo file (rev?????.dat) of a position. */
+    fs::path GetUndoPosFilename(const FlatFilePos &pos) const;
+
+    /**
+     * Whether a block may still be written to block file file_num: it is
+     * the current file of a blockfile cursor, or a file not created yet.
+     * Every other blk file is complete and never appended to again. Undo
+     * data is different: it is written when a block is connected, so a rev
+     * file can still grow after its blk file is complete (e.g. when a reorg
+     * connects blocks stored there).
+     */
+    bool MayAppendToBlockFile(int file_num);
+
+    /** Called with the numbers of the blk/rev files about to be deleted. */
+    using UnlinkFilesCallback = std::function<void(const std::set<int> &)>;
+    /**
+     * Register a callback that UnlinkPrunedFiles runs before it deletes
+     * files, e.g. to close cached descriptors of them. It must not take
+     * cs_main or cs_LastBlockFile. Returns a handle for
+     * UnregisterUnlinkFilesCallback; once that returns, the callback is not
+     * running and won't run again.
+     */
+    uint64_t RegisterUnlinkFilesCallback(UnlinkFilesCallback callback)
+        EXCLUSIVE_LOCKS_REQUIRED(!m_unlink_callbacks_mutex);
+    void UnregisterUnlinkFilesCallback(uint64_t handle)
+        EXCLUSIVE_LOCKS_REQUIRED(!m_unlink_callbacks_mutex);
 
     /**
      *  Actually unlink the specified files
      */
-    void UnlinkPrunedFiles(const std::set<int> &setFilesToPrune) const;
+    void UnlinkPrunedFiles(const std::set<int> &setFilesToPrune) const
+        EXCLUSIVE_LOCKS_REQUIRED(!m_unlink_callbacks_mutex);
 
     /** Functions for disk access for blocks */
     bool ReadBlock(CBlock &block, const FlatFilePos &pos) const;
diff --git a/src/test/blockmanager_tests.cpp b/src/test/blockmanager_tests.cpp
index 6b4b9f85eb342bb4ba4c2af7f48bc97b244380d5..94c0af3d52f128cf49b8ca522424f769106d11c2 100644
--- a/src/test/blockmanager_tests.cpp
+++ b/src/test/blockmanager_tests.cpp
@@ -60,6 +60,50 @@ BOOST_AUTO_TEST_CASE(blockmanager_find_block_pos) {
                           BLOCK_SERIALIZATION_HEADER_SIZE);
 }
 
+BOOST_FIXTURE_TEST_CASE(blockmanager_unlink_files_callback,
+                        TestChain100Setup) {
+    auto &blockman = Assert(m_node.chainman)->m_blockman;
+    const CBlockIndex *tip{WITH_LOCK(
+        ::cs_main, return Assert(m_node.chainman)->ActiveChain().Tip())};
+    const int file_number{WITH_LOCK(::cs_main, return tip->GetBlockPos().nFile)};
+    const FlatFilePos pos(file_number, 0);
+
+    std::vector<std::set<int>> calls;
+    bool existed_during_call{false};
+    const uint64_t handle = blockman.RegisterUnlinkFilesCallback(
+        [&](const std::set<int> &files) {
+            calls.push_back(files);
+            // Runs before the files are deleted.
+            existed_during_call = fs::exists(blockman.GetBlockPosFilename(pos)) &&
+                                  fs::exists(blockman.GetUndoPosFilename(pos));
+        });
+    int other_calls{0};
+    const uint64_t other = blockman.RegisterUnlinkFilesCallback(
+        [&](const std::set<int> &) { ++other_calls; });
+    BOOST_CHECK(handle != other);
+
+    {
+        LOCK(::cs_main);
+        blockman.PruneOneBlockFile(file_number);
+    }
+    blockman.UnlinkPrunedFiles({file_number});
+    BOOST_REQUIRE_EQUAL(calls.size(), 1U);
+    BOOST_CHECK(calls[0] == std::set<int>{file_number});
+    BOOST_CHECK(existed_during_call);
+    BOOST_CHECK_EQUAL(other_calls, 1);
+    BOOST_CHECK(!fs::exists(blockman.GetBlockPosFilename(pos)));
+    BOOST_CHECK(!fs::exists(blockman.GetUndoPosFilename(pos)));
+
+    // Unregistered callbacks don't run again.
+    blockman.UnregisterUnlinkFilesCallback(handle);
+    blockman.UnlinkPrunedFiles({file_number});
+    BOOST_CHECK_EQUAL(calls.size(), 1U);
+    BOOST_CHECK_EQUAL(other_calls, 2);
+    blockman.UnregisterUnlinkFilesCallback(other);
+    blockman.UnlinkPrunedFiles({file_number});
+    BOOST_CHECK_EQUAL(other_calls, 2);
+}
+
 BOOST_FIXTURE_TEST_CASE(blockmanager_scan_unlink_already_pruned_files,
                         TestChain100Setup) {
     // Cap last block file size, and mine new block in a new block file.
