From 02dc24cf3ebd0f433815194b5925636ca46b0d0a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:29:56 -0700
Subject: [PATCH] policy: preserve Doged optional RTT activation boundaries

Adapt cab9e5e7f00003fb6683f42990ac45e2c26a8bfd and 33d27f74ef43be3f5078f8a64140ed84374b5375 onto current ABC without reintroducing eCash consensus upgrades. Retain default-off, legacy activation override arguments, and the original four-window/five-window transition. Purpose-named policy fields preserve historical network timestamps. Add explicit disabled, enable-boundary and override tests; existing upstream algorithm tests explicitly activate the optional policy. Depends on the corresponding Params/network/RPC field adaptation in the Dogecoin consensus port.

diff --git a/src/policy/block/rtt.cpp b/src/policy/block/rtt.cpp
index 043585f84910e44901ec9d0599d18cea669eef95..ac3037c3e6a6cd11c7e7a04cb593fff636cfb7e9 100644
--- a/src/policy/block/rtt.cpp
+++ b/src/policy/block/rtt.cpp
@@ -113,6 +113,18 @@ static const std::vector<double> RTT_CONSTANT_FACTOR = {
     RTT_CONSTANT_FACTOR_17,
 };
 
+std::vector<size_t> GetRTTFactorIndices(const Consensus::Params &params,
+                                      const CBlockIndex *pprev) {
+    // Preserve Doged's optional Shibusawa policy activation, independently of
+    // eCash consensus upgrades removed from current ABC.
+    if (!pprev || pprev->GetMedianTimePast() <
+                      gArgs.GetIntArg("-shibusawaactivationtime",
+                                      params.rttOneBlockActivationTime)) {
+        return {2, 5, 11, 17};
+    }
+    return {1, 2, 5, 11, 17};
+}
+
 std::optional<uint32_t>
 GetNextRTTWorkRequired(const CBlockIndex *pprev, int64_t now,
                        const Consensus::Params &consensusParams) {
@@ -147,7 +159,7 @@ GetNextRTTWorkRequired(const CBlockIndex *pprev, int64_t now,
     const double prevTargetDouble = prevTarget.getdouble();
 
     double minTarget = UintToArith256(consensusParams.powLimit).getdouble();
-    for (size_t i : {1, 2, 5, 11, 17}) {
+    for (size_t i : GetRTTFactorIndices(consensusParams, pprev)) {
         // Zero (or negative) difftime are not possible, so clamp to minimum 1s
         const int64_t diffTime =
             std::max<int64_t>(1, now - prevHeaderReceivedTime[i]);
@@ -168,5 +180,9 @@ GetNextRTTWorkRequired(const CBlockIndex *pprev, int64_t now,
 }
 
 bool isRTTEnabled(const Consensus::Params &params, const CBlockIndex *pprev) {
-    return gArgs.GetBoolArg("-enablertt", DEFAULT_ENABLE_RTT);
+    // The legacy argument remains compatible; the field names its policy role.
+    return pprev && pprev->GetMedianTimePast() >=
+                        gArgs.GetIntArg("-augustoactivationtime",
+                                        params.rttActivationTime) &&
+           gArgs.GetBoolArg("-enablertt", DEFAULT_ENABLE_RTT);
 }
diff --git a/src/policy/block/rtt.h b/src/policy/block/rtt.h
index 228d1de03bebd1de8b3dd7d0ada018fbf8909ffb..324c8ed2a5510de19133cc7a119e1ed65fab1f42 100644
--- a/src/policy/block/rtt.h
+++ b/src/policy/block/rtt.h
@@ -19,7 +19,7 @@ struct Params;
 }
 
 /** Default for -enablertt */
-static constexpr bool DEFAULT_ENABLE_RTT{true};
+static constexpr bool DEFAULT_ENABLE_RTT{false};
 
 class RTTPolicy : public ParkingPolicy {
 private:
@@ -37,6 +37,9 @@ public:
 /**
  * Compute the real time block hash target given the previous block parameters.
  */
+std::vector<size_t> GetRTTFactorIndices(const Consensus::Params &params,
+                                      const CBlockIndex *pprev);
+
 std::optional<uint32_t>
 GetNextRTTWorkRequired(const CBlockIndex *pprev, int64_t now,
                        const Consensus::Params &consensusParams);
diff --git a/src/test/rtt_tests.cpp b/src/test/rtt_tests.cpp
index beede7e3ae8398e3767c0971e7d819d4044cd26b..01ce293c35b642e6066d8f3b7fcac3f4541a1f18 100644
--- a/src/test/rtt_tests.cpp
+++ b/src/test/rtt_tests.cpp
@@ -25,6 +25,8 @@ BOOST_FIXTURE_TEST_SUITE(rtt_tests, BasicTestingSetup)
 BOOST_FIXTURE_TEST_CASE(check_rtt_next_work_required, BasicTestingSetup) {
     const Consensus::Params &consensusParams = Params().GetConsensus();
 
+    gArgs.ForceSetArg("-augustoactivationtime", "0");
+    gArgs.ForceSetArg("-shibusawaactivationtime", "0");
     int64_t now = GetTime();
     SetMockTime(now);
 
@@ -301,6 +303,8 @@ BOOST_FIXTURE_TEST_CASE(check_rtt_next_work_required, BasicTestingSetup) {
     // now == 0 returns nullopt even if ancestors have non-zero receive times
     BOOST_CHECK(
         !GetNextRTTWorkRequired(&blocks[0], 0, consensusParams).has_value());
+    gArgs.ClearForcedArg("-augustoactivationtime");
+    gArgs.ClearForcedArg("-shibusawaactivationtime");
 }
 
 BOOST_AUTO_TEST_CASE(rtt_policy) {
@@ -316,6 +320,8 @@ BOOST_AUTO_TEST_CASE(rtt_policy) {
         }
     };
 
+    gArgs.ForceSetArg("-augustoactivationtime", "0");
+    gArgs.ForceSetArg("-shibusawaactivationtime", "0");
     int64_t now = GetTime();
     SetMockTime(now);
 
@@ -381,6 +387,34 @@ BOOST_AUTO_TEST_CASE(rtt_policy) {
     }
 
     gArgs.ClearForcedArg("-enablertt");
+    gArgs.ClearForcedArg("-augustoactivationtime");
+    gArgs.ClearForcedArg("-shibusawaactivationtime");
+}
+
+BOOST_AUTO_TEST_CASE(dogecoin_optional_rtt_activation) {
+    Consensus::Params params = Params().GetConsensus();
+    params.rttActivationTime = 100;
+    params.rttOneBlockActivationTime = 200;
+    CBlockIndex previous;
+    previous.nTime = 100;
+    BOOST_CHECK(!isRTTEnabled(params, &previous));
+    gArgs.ForceSetArg("-enablertt", "1");
+    previous.nTime = 99;
+    BOOST_CHECK(!isRTTEnabled(params, &previous));
+    previous.nTime = 100;
+    BOOST_CHECK(isRTTEnabled(params, &previous));
+    BOOST_CHECK(!isRTTEnabled(params, nullptr));
+    previous.nTime = 199;
+    BOOST_CHECK_EQUAL(GetRTTFactorIndices(params, &previous).size(), 4);
+    previous.nTime = 200;
+    BOOST_CHECK_EQUAL(GetRTTFactorIndices(params, &previous).size(), 5);
+    gArgs.ForceSetArg("-augustoactivationtime", "201");
+    BOOST_CHECK(!isRTTEnabled(params, &previous));
+    gArgs.ForceSetArg("-shibusawaactivationtime", "201");
+    BOOST_CHECK_EQUAL(GetRTTFactorIndices(params, &previous).size(), 4);
+    gArgs.ClearForcedArg("-augustoactivationtime");
+    gArgs.ClearForcedArg("-shibusawaactivationtime");
+    gArgs.ClearForcedArg("-enablertt");
 }
 
 BOOST_AUTO_TEST_SUITE_END()
