+        ssVal1 << v1;
+        BOOST_CHECK(
+            ldb->Put(leveldb::WriteOptions(),
+                     leveldb::Slice(
+                         reinterpret_cast<const char *>(ssKey1.data()),
+                         ssKey1.size()),
+                     leveldb::Slice(
+                         reinterpret_cast<const char *>(ssVal1.data()),
+                         ssVal1.size()))
+                .ok());
+
+        DataStream ssKey2{};
+        ssKey2.reserve(DBWRAPPER_PREALLOC_KEY_SIZE);
+        ssKey2 << k2;
+        DataStream ssVal2{};
+        ssVal2.reserve(DBWRAPPER_PREALLOC_VALUE_SIZE);
+        ssVal2 << v2;
+        BOOST_CHECK(
+            ldb->Put(leveldb::WriteOptions(),
+                     leveldb::Slice(
