+namespace dbwrapper {
+Status DestroyDB(const std::string &path_str, const DestroyOptions &) {
+    std::error_code ec;
+    const fs::path db_path = fs::PathFromString(path_str);
+    if (!std::filesystem::exists(db_path, ec)) {
+        return Status{true};
+    }
+    WipeMdbxFilesInDir(db_path);
+    fs::remove(db_path, ec);
+    return Status{!ec};
+}
