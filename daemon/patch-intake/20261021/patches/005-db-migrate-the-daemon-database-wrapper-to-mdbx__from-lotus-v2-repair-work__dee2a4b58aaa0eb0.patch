+    const uint8_t k2{'b'};
+    const uint256 v2 = m_rng.rand256();
+
+    {
+        leveldb::Options ldb_opts;
+        ldb_opts.create_if_missing = true;
+        leveldb::DB *ldb = nullptr;
+        leveldb::Status status =
+            leveldb::DB::Open(ldb_opts, fs::PathToString(mig_path), &ldb);
