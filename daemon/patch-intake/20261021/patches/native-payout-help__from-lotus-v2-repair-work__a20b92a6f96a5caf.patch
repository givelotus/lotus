From 6deb3e4fc99f7c1944b2862665f7ea5f36de7322 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 09:07:20 -0700
Subject: [PATCH] fixup! transaction(v2): integrate native transaction
 identities and serialization

Document the fail-closed native payout boundary in mining RPC help: native version7 requires a native address; legacy descriptors/addresses require an explicitly permitted legacy coinbase. This is part of the payout guard, not a new feature.
---
 src/rpc/mining.cpp | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 29fdf09db4dbd1108a8830f71a3686348a5a4608..94ae0f8867473801b156eb9c31cb571bcc1ffd72 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -340,8 +340,8 @@ static bool getScriptFromDescriptor(const std::string &descriptor,
 static RPCHelpMan generatetodescriptor() {
     return RPCHelpMan{
         "generatetodescriptor",
-        "Mine blocks immediately to a specified descriptor (before the RPC "
-        "call returns)\n",
+        "Mine blocks immediately to a specified legacy descriptor. Native "
+        "coinbases require generatetoaddress with a native address.\n",
         {
             {"num_blocks", RPCArg::Type::NUM, RPCArg::Optional::NO,
              "How many blocks are generated immediately."},
@@ -409,7 +409,8 @@ static RPCHelpMan generatetoaddress() {
     return RPCHelpMan{
         "generatetoaddress",
         "Mine blocks immediately to a specified address before the "
-        "RPC call returns)\n",
+        "RPC call returns. Version 7 requires a native address; legacy "
+        "addresses require a permitted legacy coinbase version.\n",
         {
             {"nblocks", RPCArg::Type::NUM, RPCArg::Optional::NO,
              "How many blocks are generated immediately."},
@@ -462,8 +463,8 @@ static RPCHelpMan generateblock() {
         "specified address or descriptor (before the RPC call returns)\n",
         {
             {"output", RPCArg::Type::STR, RPCArg::Optional::NO,
-             "The address or descriptor to send the newly generated bitcoin "
-             "to."},
+             "The payout address: native for version 7, legacy address or "
+             "descriptor for a permitted legacy coinbase version."},
             {
                 "transactions",
                 RPCArg::Type::ARR,
-- 
