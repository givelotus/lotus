+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#include <net/recon_syndrome_index.h>
+#include <net/v2_protocol_handler.h>
+#include <test/util/setup_common.h>
+#include <txmempool.h>
+#include <validation.h>
+#include <boost/test/unit_test.hpp>
+#include <random>
+using namespace lotus::v2::net;
+BOOST_FIXTURE_TEST_SUITE(merklix_incremental_tests, RegTestingSetup)
+BOOST_AUTO_TEST_CASE(random_insert_remove_equals_full_recomputation) {
+    std::mt19937_64 rng(0x197723);
+    constexpr uint64_t k0 = 17, k1 = 29;
+    ReconSyndromeIndex index(k0, k1);
+    std::array<TxId, 1000> ids;
+    std::array<bool, 1000> active{};
+    for (auto &id : ids) {
+        uint256 bytes;
+        for (unsigned i = 0; i < 32; ++i) bytes.begin()[i] = rng();
+        id = TxId(bytes);
+    }
+    for (int step = 0; step < 5000; ++step) {
+        const size_t selected = rng() % ids.size();
+        if (active[selected]) index.Remove(ids[selected]); else index.Add(ids[selected]);
+        active[selected] = !active[selected];
+        if (step % 50) continue;
+        std::array<ReconSyndromeIndex::Cell, 256> full8{};
+        std::array<ReconSyndromeIndex::Cell, 4096> full12{};
+        size_t count = 0;
+        for (size_t tx = 0; tx < ids.size(); ++tx) {
+            if (!active[tx]) continue;
+            ++count;
+            const auto &id = ids[tx];
+            const uint64_t sid = ComputeMerklixShortId(k0, k1, id);
+            auto accumulate = [&](auto &cell) {
+                ++cell.count; cell.s1 ^= sid;
+                cell.s3 ^= GF64Cube(sid); cell.s5 ^= GF64Pow5(sid);
+            };
+            accumulate(full8[id.begin()[0]]);
+            accumulate(full12[(uint16_t(id.begin()[0]) << 4) | (id.begin()[1] >> 4)]);
+        }
+        BOOST_CHECK_EQUAL(index.Size(), count);
+        for (uint16_t parent = 0; parent < 16; ++parent) {
+            const auto actual = index.Summary(8, parent);
+            for (size_t cell = 0; cell < 16; ++cell)
+                BOOST_REQUIRE(actual[cell] == full8[parent * 16 + cell]);
+        }
+        for (uint16_t parent = 0; parent < 256; ++parent) {
+            const auto actual = index.Summary(12, parent);
+            for (size_t cell = 0; cell < 16; ++cell)
+                BOOST_REQUIRE(actual[cell] == full12[parent * 16 + cell]);
+        }
+    }
+}
+BOOST_AUTO_TEST_CASE(real_mempool_add_remove_and_clear_keep_cached_cells) {
+    auto &pool = *m_node.mempool;
+    const auto [k0, k1] = DeriveReconSipHashKey(ReconScope::LIVE_MEMPOOL, uint256{}, 0);
+    CMutableTransaction tx;
+    tx.nVersion = 2;
+    tx.vin.resize(1);
+    uint256 prev;
+    prev.begin()[0] = 123;
+    tx.vin[0].prevout = COutPoint(TxId(prev), 0);
+    tx.vout.emplace_back(1000 * SATOSHI, CScript() << OP_TRUE);
+    const auto ref = MakeTransactionRef(tx);
+    const uint16_t parent = ref->GetId().begin()[0] >> 4;
+    const auto cell = ref->GetId().begin()[0] & 15;
+    LOCK2(cs_main, pool.cs);
+    BOOST_REQUIRE(pool.GetReconSyndromes(k0, k1, 8, parent));
+    TestMemPoolEntryHelper helper;
+    pool.addUnchecked(helper.FromTx(ref));
+    auto summary = pool.GetReconSyndromes(k0, k1, 8, parent);
+    BOOST_REQUIRE(summary);
+    BOOST_CHECK_EQUAL((*summary)[cell].count, 1U);
+    BOOST_CHECK_EQUAL((*summary)[cell].s1, ComputeMerklixShortId(k0, k1, ref->GetId()));
+    pool.removeRecursive(*ref, MemPoolRemovalReason::CONFLICT);
+    summary = pool.GetReconSyndromes(k0, k1, 8, parent);
+    BOOST_REQUIRE(summary);
+    BOOST_CHECK_EQUAL((*summary)[cell].count, 0U);
+    BOOST_CHECK_EQUAL((*summary)[cell].s1, 0U);
+    pool.addUnchecked(helper.FromTx(ref));
+    pool.clear();
+    summary = pool.GetReconSyndromes(k0, k1, 8, parent);
+    BOOST_REQUIRE(summary);
+    BOOST_CHECK_EQUAL((*summary)[cell].count, 0U);
+}
+BOOST_AUTO_TEST_SUITE_END()
