+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#include <bench/bench.h>
+#include <net/recon_syndrome_index.h>
+#include <random.h>
+
+static void MerklixSyndromeCopy(benchmark::Bench &bench) {
+    for (size_t transactions : {1000, 10000, 50000}) {
+        lotus::v2::net::ReconSyndromeIndex index(17, 29);
+        FastRandomContext rng(true);
+        for (size_t i = 0; i < transactions; ++i) index.Add(TxId(rng.rand256()));
+        uint16_t parent = 0;
+        bench.name("MerklixSyndromeCopy_" + std::to_string(transactions))
+            .unit("summary").run([&] {
+                const auto cells = index.Summary(12, parent++ & 255);
+                ankerl::nanobench::doNotOptimizeAway(cells);
+            });
+    }
+}
+BENCHMARK(MerklixSyndromeCopy);
diff --git a/src/net/recon_syndrome_index.h b/src/net/recon_syndrome_index.h
