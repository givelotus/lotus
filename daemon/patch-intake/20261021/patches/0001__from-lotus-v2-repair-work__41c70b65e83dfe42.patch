+std::optional<std::array<lotus::v2::net::ReconSyndromeIndex::Cell, 16>>
+CTxMemPool::GetReconSyndromes(uint64_t k0, uint64_t k1, uint8_t depth, uint16_t parent) const {
+    AssertLockHeld(cs);
+    using Index = lotus::v2::net::ReconSyndromeIndex;
+    if (mapTx.size() > Index::MAX_TRANSACTIONS) return std::nullopt;
+    if (!m_recon_syndromes) {
+        auto index = std::make_unique<Index>(k0, k1);
+        for (const auto &entry : mapTx) index->Add(entry->GetTx().GetId());
+        m_recon_syndromes = std::move(index);
+    }
+    if (!m_recon_syndromes->Matches(k0, k1)) return std::nullopt;
+    return m_recon_syndromes->Summary(depth, parent);
+}
+
 void CTxMemPool::AddTransactionsUpdated(unsigned int n) {
     nTransactionsUpdated += n;
 }
