--- /dev/null
+++ b/src/net/recon_syndrome_index.h
@@ -0,0 +1,65 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#ifndef BITCOIN_NET_RECON_SYNDROME_INDEX_H
+#define BITCOIN_NET_RECON_SYNDROME_INDEX_H
+#include <crypto/siphash.h>
+#include <lotus_v2/set_reconciliation.h>
+#include <primitives/transaction.h>
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+
+namespace lotus::v2::net {
+/** Fixed-size depth-8/12 summaries. The owner serializes membership changes;
+ * removal applies the identical XOR operations. No transactions are retained.
+ */
+class ReconSyndromeIndex {
+public:
+    struct Cell {
+        uint32_t count{0};
+        uint64_t s1{0}, s3{0}, s5{0};
+        bool operator==(const Cell &) const = default;
+    };
+    static constexpr size_t MAX_TRANSACTIONS = 65536;
+private:
+    uint64_t m_k0, m_k1;
+    std::array<Cell, 256> m_depth8{};
+    std::array<Cell, 4096> m_depth12{};
+    size_t m_count{0};
+    void Update(const TxId &id, bool add) {
+        uint64_t sid = SipHashUint256(m_k0, m_k1, id);
+        if (!sid) sid = 1;
+        const uint64_t s3 = lotus::v2::GF64Cube(sid), s5 = lotus::v2::GF64Pow5(sid);
+        auto update = [&](Cell &cell) {
+            if (!add && !cell.count) throw std::logic_error("removing absent Merklix syndrome member");
+            if (add) ++cell.count; else --cell.count;
+            cell.s1 ^= sid; cell.s3 ^= s3; cell.s5 ^= s5;
+        };
+        const uint16_t prefix8 = id.begin()[0];
+        const uint16_t prefix12 = (prefix8 << 4) | (id.begin()[1] >> 4);
+        update(m_depth8[prefix8]);
+        update(m_depth12[prefix12]);
+        if (add) ++m_count; else --m_count;
+    }
+public:
+    ReconSyndromeIndex(uint64_t k0, uint64_t k1) : m_k0(k0), m_k1(k1) {}
+    bool Matches(uint64_t k0, uint64_t k1) const { return k0 == m_k0 && k1 == m_k1; }
+    size_t Size() const { return m_count; }
+    void Add(const TxId &id) {
+        if (m_count >= MAX_TRANSACTIONS) throw std::length_error("Merklix index capacity exceeded");
+        Update(id, true);
+    }
+    void Remove(const TxId &id) { Update(id, false); }
+    std::array<Cell, 16> Summary(uint8_t depth, uint16_t parent) const {
+        if ((depth != 8 && depth != 12) || parent >= (1U << (depth - 4)))
+            throw std::out_of_range("invalid Merklix syndrome prefix");
+        std::array<Cell, 16> out;
+        const auto *first = depth == 8 ? &m_depth8[parent * 16] : &m_depth12[parent * 16];
+        std::copy_n(first, 16, out.begin());
+        return out;
+    }
+};
+} // namespace lotus::v2::net
+#endif
