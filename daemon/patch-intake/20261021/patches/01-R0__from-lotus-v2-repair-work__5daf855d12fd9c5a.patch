+bool V2PeerProtocolHandler::MaybeSendSync(
+    CNode &peer, std::chrono::microseconds now, std::chrono::milliseconds cadence) {
+    if (!(GetPeerServices(peer.GetId()) & NODE_MERKLIX) ||
+        !peer.fSuccessfullyConnected || peer.fDisconnect ||
+        peer.IsBlockOnlyConn() || peer.IsAddrFetchConn()) {
+        return false;
+    }
+    const auto generation = m_mempool.GetTransactionsUpdated();
+    {
+        LOCK(m_mutex);
+        auto &state = m_sync_announcements[peer.GetId()];
+        if (now < state.next) {
+            return false;
+        }
+        state.next = now + std::max(cadence, std::chrono::milliseconds{100});
+        if (state.generation == generation &&
+            now - state.last_sent < std::chrono::seconds{1}) {
+            return false;
+        }
+        state.generation = generation;
+    }
+    // LIVE_MEMPOOL's null context is deliberately not cached as a scoped set:
+    // SHORTTX validation updates the real mempool, and later announcements
+    // reflect removals and tip changes as well as additions. Keep the existing
+    // wire encoding; capability advertisement opts peers into initiation.
+    std::optional<MerklixSyncSummary> cached;
+    {
+        LOCK(m_mutex);
+        if (m_live_sync_summary && m_live_sync_generation == generation) {
+            cached = m_live_sync_summary;
+        }
+    }
+    const auto summary = cached ? *cached :
+        BuildSyncSummary(ReconScope::LIVE_MEMPOOL, uint256{});
+    {
+        LOCK(m_mutex);
+        auto &state = m_sync_announcements[peer.GetId()];
+        m_live_sync_summary = summary;
+        m_live_sync_generation = generation;
+        if (state.root == summary.candidate_root &&
+            now - state.last_sent < std::chrono::seconds{1}) {
+            return false;
+        }
+        state.root = summary.candidate_root;
+        state.last_sent = now;
+    }
+    m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::MERKLIXSYNC, summary));
+    return true;
+}
