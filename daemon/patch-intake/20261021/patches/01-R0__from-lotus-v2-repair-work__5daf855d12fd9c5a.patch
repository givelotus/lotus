+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Divergent real mempools start reconciliation through the production sender.
+
+No RPC initiates reconciliation. RPC only seeds transactions while disconnected
+and observes convergence. Check wire counters so ordinary inv relay alone cannot
+make the test pass. This is a liveness test, not WAN performance evidence.
+"""
+from decimal import Decimal
+import time
+
+from test_framework.merklix_relay import (
+    FUNDING_DESCRIPTOR, VALUE_UNITS_PER_COIN, build_merklix_tx,
+)
+from test_framework.test_framework import BitcoinTestFramework
+
+
+class MerklixInitiationTest(BitcoinTestFramework):
+    def add_options(self, parser):
+        parser.add_argument("--legacy-control", action="store_true")
+
+    def set_test_params(self):
+        self.num_nodes = 3
+        self.setup_clean_chain = True
+        self.extra_args = [["-avalanche=0",
+                            f"-merklixreconciliation={int(not self.options.legacy_control)}"]
+                           for _ in range(self.num_nodes)]
+
+    def run_test(self):
+        self.generatetodescriptor(self.nodes[0], 120, FUNDING_DESCRIPTOR)
+        self.sync_all()
+        self.disconnect_nodes(0, 1)
+        self.disconnect_nodes(1, 2)
+        expected = set()
+        for i, node in enumerate(self.nodes):
+            for j in range(4):
+                block = node.getblock(node.getblockhash(4 * i + j + 1), 2)
+                cb = block["tx"][0]
+                out = cb["vout"][0]
+                value = int(Decimal(str(out["value"])) * VALUE_UNITS_PER_COIN)
+                # Two differences in each of two top-level buckets force the
+                # legal request alias across the actual TCP framing boundary.
+                for nonce in range(1000):
+                    tx = build_merklix_tx(int(cb["txid"], 16), 0,
+                                           [value - 10000 - nonce])
+                    if ((tx.txid_int & 255) >> 4) == (5 if j < 2 else 10):
+                        break
+                else:
+                    raise AssertionError("could not construct bucket fixture")
+                expected.add(node.sendrawtransaction(tx.serialize().hex()))
+        self.connect_nodes(0, 1)
+        self.connect_nodes(1, 2)
+        if self.options.legacy_control:
+            time.sleep(3)
+            assert all(len(n.getrawmempool()) == 4 for n in self.nodes)
+            self.log.info("Legacy control remains divergent after 3 seconds")
+            return
+        self.wait_until(lambda: all(set(n.getrawmempool()) == expected for n in self.nodes))
+        sent = {}
+        for node in self.nodes:
+            for peer in node.getpeerinfo():
+                for command, count in peer.get("bytessent_per_msg", {}).items():
+                    sent[command] = sent.get(command, 0) + count
+        # Accepted SHORTTX transactions are deliberately relayed onward by
+        # ordinary INV as well. The disabled-capability control isolates the
+        # initiation trigger; do not require zero secondary INV traffic.
+        assert sent.get("merklixsync", 0) > 0, sent
+        assert sent.get("getmrklbckt", 0) > 0, sent
+        assert sent.get("merklixbuck", 0) > 0, sent
+        assert sent.get("getshorttx", 0) > 0, sent
+        assert sent.get("shorttx", 0) > 0, sent
+        self.log.info("Production reconciliation bytes by message: %s", sent)
+
+
+if __name__ == "__main__":
+    MerklixInitiationTest().main()
