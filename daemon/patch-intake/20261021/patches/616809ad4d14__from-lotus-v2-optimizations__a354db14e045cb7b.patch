From 616809ad4d147c97f25b0225b629c781d9a2de67 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 23:07:10 -0700
Subject: [PATCH] fixup! net: batch-validate solicited/high-bandwidth SHORTTX
 and coalesce incoming TX bursts

Adapt existing SHORTTX relay fixture to the required ordinary-peer trickle: verify immediate HB delivery before advancing mock time for ordinary INV delivery; retain exact20-transaction assertions.
---
 src/test/v2_protocol_handler_tests.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/test/v2_protocol_handler_tests.cpp b/src/test/v2_protocol_handler_tests.cpp
index b71049dcd9..fa8516361b 100644
--- a/src/test/v2_protocol_handler_tests.cpp
+++ b/src/test/v2_protocol_handler_tests.cpp
@@ -2482,7 +2482,7 @@ BOOST_AUTO_TEST_CASE(shorttx_batch_admission_fallback_and_proactive_push) {
                                 cur_time, interrupt);
     }
 
-    // All 20 transactions must be admitted to the mempool via ProcessRawTxBatch!
+    // All 20 transactions must be admitted through ordinary transaction validation.
     for (const auto &tx : valid_batch) {
         BOOST_CHECK(m_node.mempool->exists(tx->GetId()));
     }
@@ -2492,8 +2492,11 @@ BOOST_AUTO_TEST_CASE(shorttx_batch_admission_fallback_and_proactive_push) {
     //    - peer_to (normal low-bandwidth peer) receives INV (and NEVER unsolicited SHORTTX)
     //    - peer_hb (opted-in High-Bandwidth peer) receives preemptive SHORTTX!
     BOOST_CHECK(peerman->SendMessages(config, &peer_from));
-    BOOST_CHECK(peerman->SendMessages(config, &peer_to));
     BOOST_CHECK(peerman->SendMessages(config, &peer_hb));
+    // Ordinary peers keep the upstream randomized trickle; this assertion
+    // checks eventual INV relay, while the HB peer above sends immediately.
+    SetMockTime(base_time + 60);
+    BOOST_CHECK(peerman->SendMessages(config, &peer_to));
 
     {
         V1TransportDeserializer deser_from(config, peer_from.GetId());
