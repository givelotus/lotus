From 32db29d63d59ad52e393e3665c26ec5086fd51d5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:57:14 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

---
 src/txdb.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/txdb.cpp b/src/txdb.cpp
index 4c90abc409..fe25313e4e 100644
--- a/src/txdb.cpp
+++ b/src/txdb.cpp
@@ -262,6 +262,9 @@ void CCoinsViewDB::BatchWrite(CoinsViewCacheCursor &cursor,
                 if (rng.randrange(m_options.simulate_crash_ratio) == 0) {
                     LogInfoEvent(BCLog::ALL, "chain_database_crash_simulated",
                                  "Simulating a crash. Goodbye.");
+                    // _Exit skips logger shutdown; retain the deterministic
+                    // fault-injection diagnostic before terminating.
+                    LogInstance().Flush();
                     _Exit(0);
                 }
             }
