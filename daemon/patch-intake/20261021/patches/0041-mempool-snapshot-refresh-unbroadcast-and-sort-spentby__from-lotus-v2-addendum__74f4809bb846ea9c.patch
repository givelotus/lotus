From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 16:55:00 -0700
Subject: [PATCH] snapshot: refresh unbroadcast flags and sort spentby lists

The incremental mempool snapshot copies the previous entries when no
entry was removed. A copied entry keeps its old unbroadcast flag, but
AddUnbroadcastTx runs after the entry is added, so getrawmempool verbose
reports unbroadcast=false while getmempoolinfo counts the transaction
(mempool_unbroadcast). Refresh the flag of copied entries, as the full
rebuild path already does.

spentby was in mempool child-set order on a full rebuild and in arrival
order when appended, so the same mempool printed different lists
(mining_prioritisetransaction compares entries across a restart). Keep it
sorted, as depends already is and as upstream's std::set was.

Found while running the legacy-transaction tests on addendum-t1;
mempool_unbroadcast passes with this change.

Tier: V2 (fixup to "rpc(v2): publish native state roots and snapshot metadata")
---
 src/node/snapshot.cpp | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/node/snapshot.cpp b/src/node/snapshot.cpp
index 650094cc7a..511433ebcb 100644
--- a/src/node/snapshot.cpp
+++ b/src/node/snapshot.cpp
@@ -164,6 +164,9 @@ MempoolEntrySnapshot MakeMempoolEntrySnapshot(const CTxMemPoolEntry &e,
         entry_snap.spentby.push_back(
             child.get()->GetTx().GetId().ToString());
     }
+    // Sorted, as the depends list, so the order does not depend on
+    // admission order.
+    std::sort(entry_snap.spentby.begin(), entry_snap.spentby.end());
     entry_snap.unbroadcast = mempool.IsUnbroadcastTx(entry_snap.txid);
     return entry_snap;
 }
@@ -235,6 +238,16 @@ void PopulateMempoolScalarsLocked(ChainAndMempoolSnapshot &snap,
         snap.mempool_bytes, now_ms);
 }
 
+// Entries copied from the previous snapshot keep their old unbroadcast flag;
+// the unbroadcast set changes without adding or removing an entry.
+static void RefreshUnbroadcast(std::vector<MempoolEntrySnapshot> &entries,
+                               const CTxMemPool &mempool)
+    EXCLUSIVE_LOCKS_REQUIRED(mempool.cs) {
+    for (MempoolEntrySnapshot &entry : entries) {
+        entry.unbroadcast = mempool.IsUnbroadcastTx(entry.txid);
+    }
+}
+
 void PopulateMempoolVectorsLocked(ChainAndMempoolSnapshot &snap,
                                   const CTxMemPool &mempool,
                                   const ChainAndMempoolSnapshot *prev)
@@ -257,6 +270,7 @@ void PopulateMempoolVectorsLocked(ChainAndMempoolSnapshot &snap,
                 snap.mempool_txids = prev->mempool_txids;
                 snap.mempool_entries = prev->mempool_entries;
                 snap.mempool_spent_outpoints = prev->mempool_spent_outpoints;
+                RefreshUnbroadcast(snap.mempool_entries, mempool);
                 snap.mempool_vectors_ready = true;
                 return;
             }
@@ -321,9 +335,13 @@ void PopulateMempoolVectorsLocked(ChainAndMempoolSnapshot &snap,
                     });
                 if (pit != snap.mempool_entries.end() &&
                     pit->txid == parent_txid) {
-                    pit->spentby.push_back(std::move(child_txid_str));
+                    pit->spentby.insert(
+                        std::upper_bound(pit->spentby.begin(),
+                                         pit->spentby.end(), child_txid_str),
+                        child_txid_str);
                 }
             }
+            RefreshUnbroadcast(snap.mempool_entries, mempool);
             snap.mempool_vectors_ready = true;
             return;
         }
