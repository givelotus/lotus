From 715545c454758de8c5e5dc8cfecc7aba57ab56ef Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 17:44:38 -0700
Subject: [PATCH] http: move reply bodies into the response instead of copying
 them

HTTPRequest::WriteReply() took the body by const reference and copied it
into the Beast response; it now takes it by value and moves it, and the
response is moved on to the socket write. Existing callers still compile
unchanged (lvalues are copied as before); the JSON-RPC reply and the REST
block/tx/header/UTXO replies now pass rvalues, so their bodies are never
copied after being generated.

This saves one reply-sized allocation and copy per request (3.35 MB for
getblock verbosity 2 of a 1000-transaction block). Throughput on that
workload is unchanged within run-to-run noise, as JSON generation
dominates; the benefit is lower peak memory under concurrent large
replies.
---
 src/httprpc.cpp    |  2 +-
 src/httpserver.cpp |  5 +++--
 src/httpserver.h   |  3 ++-
 src/rest.cpp       | 42 +++++++++++++++++++++---------------------
 4 files changed, 27 insertions(+), 25 deletions(-)

diff --git a/src/httprpc.cpp b/src/httprpc.cpp
index 62fff16c4ab7ff86ea1e5e711ff6b57643e5fb93..4eec995dd86ba86fefe48e9ac4fbc263b6a68960 100644
--- a/src/httprpc.cpp
+++ b/src/httprpc.cpp
@@ -393,7 +393,7 @@ bool HTTPRPCRequestProcessor::ProcessHTTPRequest(HTTPRequest *req) {
         }
 
         req->WriteHeader("Content-Type", "application/json");
-        req->WriteReply(HTTP_OK, strReply);
+        req->WriteReply(HTTP_OK, std::move(strReply));
     } catch (const UniValue &objError) {
         JSONErrorReply(req, objError, jreq.id);
         return false;
diff --git a/src/httpserver.cpp b/src/httpserver.cpp
index 2512adcfb442a7836fbb02f22690ac91a9f26461..1346a87ebcdeef3f300d7128798ac037729b650a 100644
--- a/src/httpserver.cpp
+++ b/src/httpserver.cpp
@@ -1779,14 +1779,15 @@ void HTTPRequest::WriteHeader(const std::string &hdr,
     m_impl->beast_res.insert(hdr, value);
 }
 
-void HTTPRequest::WriteReply(int nStatus, const std::string &strReply) {
+void HTTPRequest::WriteReply(int nStatus, std::string strReply) {
     assert(!replySent && m_impl);
     if (ShutdownRequested()) {
         WriteHeader("Connection", "close");
     }
     BeastResponse &res = m_impl->beast_res;
     res.result(static_cast<unsigned>(nStatus));
-    res.body() = strReply;
+    // The body is moved through to the socket write: no copies.
+    res.body() = std::move(strReply);
     MaybeCompressZstd(m_impl->beast_req, res);
     FinalizeResponse(res, m_impl->beast_req.version());
 
diff --git a/src/httpserver.h b/src/httpserver.h
index b883c5434505131e49f4bdda6fcfe52e0f5297b2..0ec5d8e9e328d4412ab0f818fa3cf6616cc67bda 100644
--- a/src/httpserver.h
+++ b/src/httpserver.h
@@ -221,12 +221,13 @@ public:
      * message. Replies of at least HTTP_ZSTD_MIN_REPLY_SIZE bytes are sent
      * with "Content-Encoding: zstd" when the client's Accept-Encoding allows
      * it and no Content-Encoding header was written.
+     * Pass an rvalue (e.g. std::move) to hand the body over without copying.
      *
      * @note Can be called only once. As this will give the request back to the
      * main thread, do not call any other HTTPRequest methods after calling
      * this.
      */
-    void WriteReply(int nStatus, const std::string &strReply = "");
+    void WriteReply(int nStatus, std::string strReply = "");
 };
 
 /**
