From 58264ca95f31e43853e6df383edf27e02dc3efeb Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 18:14:51 -0700
Subject: [PATCH] chronik: native -chroniktokenindex=1 is an init error on
 Lotus V2 nodes

Fixup 0038 made the Rust Chronik default -chroniktokenindex to 0 on Lotus
V2 nodes and reject -chroniktokenindex=1 there with an init error. The
native Chronik already turned the SLP/ALP token index off on V2 through
HostCapabilities::slp_alp_tokens, but it still defaulted the argument to
1 and silently ignored an explicit -chroniktokenindex=1.

Parse the argument the way the Rust ParseChronikParams does: the default
is !kLotusV2Node, and -chroniktokenindex=1 on a V2 node fails with the
same message ("-chroniktokenindex=1 is not supported: Lotus V2 nodes do
not index SLP/ALP tokens. Remove it or use -chroniktokenindex=0."). eCash
nodes are unchanged. The capability gate stays as a second guard.

Tier: V2
---
 chronik/native/hosts/abc/abc_entry.cpp | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/chronik/native/hosts/abc/abc_entry.cpp b/chronik/native/hosts/abc/abc_entry.cpp
index 258ac800da924bd9a8505b888ea337b1d92eefb8..38cfe7ec9c67e0ba5b977f3b1eb549d4dfb220c1 100644
--- a/chronik/native/hosts/abc/abc_entry.cpp
+++ b/chronik/native/hosts/abc/abc_entry.cpp
@@ -181,10 +181,21 @@ ParseChronikParams(const ArgsManager &args, const Config &config, bool fWipe) {
                        .c_str())}};
     }
 
+    // Lotus V2 nodes do not index SLP/ALP tokens (user decision 2026-10-19),
+    // as in the Rust Chronik: the token index defaults to off and cannot be
+    // enabled.
+    const bool enable_token_index =
+        args.GetBoolArg("-chroniktokenindex", !kLotusV2Node);
+    if (kLotusV2Node && enable_token_index) {
+        return {{_("-chroniktokenindex=1 is not supported: Lotus V2 nodes do "
+                   "not index SLP/ALP tokens. Remove it or use "
+                   "-chroniktokenindex=0.")}};
+    }
+
     native::ServiceParams out;
     out.indexer.datadir_net = args.GetDataDirNet();
     out.indexer.wipe = fWipe;
-    out.indexer.token_index = args.GetBoolArg("-chroniktokenindex", true);
+    out.indexer.token_index = enable_token_index;
     out.indexer.lokad_id_index = args.GetBoolArg("-chroniklokadidindex", true);
     // Without Electrum, the scripthash index defaults to off (as in Rust).
     out.indexer.scripthash_index =
