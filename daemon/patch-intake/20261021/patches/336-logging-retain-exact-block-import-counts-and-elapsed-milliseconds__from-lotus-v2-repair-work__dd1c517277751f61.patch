From d7a31b2415dad5477c4a765f292d8c05ea321bef Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 15:48:27 -0700
Subject: [PATCH] logging: retain exact block-import counts and elapsed
 milliseconds

Expose the existing signed loaded-block count and signed millisecond interval
without converting them to floating point or substituting a different clock.
Keep exact Info text, import accounting, exceptions, interrupts and consensus
checks. Extend the owned real reindex fixture to inspect actual completion
fields after unchanged genesis/height and clean shutdown. Runtime pending;
no throughput benchmark or clock-rollback injection is claimed.

Scripted diff (ast-grep-py0.51.0; explicit single-site catalog):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/external-block-import-completion.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/external-import356-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/validation.cpp
---
 .../external-block-import-completion.json     | 42 +++++++++++++++++++
 src/logging/fields.h                          |  4 +-
 src/validation.cpp                            |  7 +++-
 .../feature_logging_block_file_reindex.py     | 11 +++++
 4 files changed, 61 insertions(+), 3 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/external-block-import-completion.json

diff --git a/contrib/logging/conversion/rules/external-block-import-completion.json b/contrib/logging/conversion/rules/external-block-import-completion.json
new file mode 100644
index 0000000000000000000000000000000000000000..bf858e8e4bd5673ebb2acb10f0bfe002104fa014
--- /dev/null
+++ b/contrib/logging/conversion/rules/external-block-import-completion.json
@@ -0,0 +1,42 @@
+{
+  "schema": 1,
+  "batch": "external-block-import-completion",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "block_file_external_import_completed",
+          "old": "LogPrintf(\"Loaded %i blocks from external file in %dms\\n\", nLoaded,\n              GetTimeMillis() - nStart)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_file_external_import_completed\", \"Loaded {imported_block_count} blocks from external file in {elapsed_milliseconds}ms\").Field(BCLog::LogField::ImportedBlockCount, nLoaded).Field(BCLog::LogField::ElapsedMilliseconds, GetTimeMillis() - nStart)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Loaded %i blocks from external file in %dms\n",
+            "specifiers": [
+              "%i",
+              "%d"
+            ],
+            "arguments": [
+              "nLoaded",
+              "GetTimeMillis() - nStart"
+            ]
+          },
+          "review_note": "Preserve Info, signed int loaded-block count and signed wall-clock milliseconds including possible clock rollback. No integer-to-double coercion, timer substitution, import accounting, interrupt/exception or block-validation change. Existing real owned reindex fixture will check actual fields; this is not a benchmark."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Preserve exact signed original counter and elapsed-millisecond types without repurposing unsigned Count or floating ElapsedMs. Append IDs only.",
+          "old": "    X(SnapshotProgressPercent, snapshot_progress_percent, FLOAT, \"\", \"\")\n",
+          "new": "    X(SnapshotProgressPercent, snapshot_progress_percent, FLOAT, \"\", \"\") \\\n    X(ImportedBlockCount, imported_block_count, INT, \"\", \"\") \\\n    X(ElapsedMilliseconds, elapsed_milliseconds, INT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/logging/fields.h b/src/logging/fields.h
index c8a5d07bb825eb8348c69506ebf366c645ef9b0a..e370bc7bd8119ffb5cf87ca4138e4d06f061d5f3 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -199,7 +199,9 @@
     X(SnapshotHash, snapshot_hash, HASH, "", "") \
     X(BlockIndexDescription, block_index_description, STRING, "", "") \
     X(SnapshotCacheMB, snapshot_cache_mb, UINT, "", "") \
-    X(SnapshotProgressPercent, snapshot_progress_percent, FLOAT, "", "")
+    X(SnapshotProgressPercent, snapshot_progress_percent, FLOAT, "", "") \
+    X(ImportedBlockCount, imported_block_count, INT, "", "") \
+    X(ElapsedMilliseconds, elapsed_milliseconds, INT, "", "")
 
 namespace BCLog {
 
diff --git a/src/validation.cpp b/src/validation.cpp
index f5cd2d626e01fb67729033c58bba6534e8f90d6c..e4447fbda10634f3f05cbdb4f4b8e37e1ffa60aa 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -7642,8 +7642,11 @@ void ChainstateManager::LoadExternalBlockFile(
         GetNotifications().fatalError(std::string("System error: ") + e.what());
     }
 
-    LogPrintf("Loaded %i blocks from external file in %dms\n", nLoaded,
-              GetTimeMillis() - nStart);
+    LogInfoEvent(
+        BCLog::ALL, "block_file_external_import_completed",
+        "Loaded {imported_block_count} blocks from external file in {elapsed_milliseconds}ms")
+        .Field(BCLog::LogField::ImportedBlockCount, nLoaded)
+        .Field(BCLog::LogField::ElapsedMilliseconds, GetTimeMillis() - nStart);
 }
 
