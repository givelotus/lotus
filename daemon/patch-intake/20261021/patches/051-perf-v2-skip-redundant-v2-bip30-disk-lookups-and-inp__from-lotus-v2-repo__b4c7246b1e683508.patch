     }
     if (invocation.kind == 3) {
-        preimage.insert(preimage.end(), invocation.selector.begin(),
-                        invocation.selector.begin() + 33);
-        preimage.insert(preimage.end(), positive_delta->begin(),
-                        positive_delta->end());
