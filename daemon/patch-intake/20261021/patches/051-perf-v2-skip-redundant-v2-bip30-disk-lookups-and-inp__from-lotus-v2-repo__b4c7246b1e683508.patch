         error = "sighash preimage width";
         return false;
     }
-    result = TaggedHash(HashDomain::Sighash, preimage);
+    result = TaggedHash(HashDomain::Sighash,
+                        std::span<const uint8_t>(preimage.data(), expected_len));
     error.clear();
     return true;
 }
