     TESTNET = 'T',
     REGTEST = 'R',
+    UNKNOWN = 'U'
 };
 
 enum AddressType : uint8_t {
@@ -55,6 +59,11 @@ std::string Encode(const Content &addressContent);
  * modified.
  */
 DecodeError Decode(const std::string &address, Content &parsedOutput);
+/**
