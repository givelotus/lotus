From b63d8fe72891ade439c628d6ba96744f2662996b Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:49:37 -0700
Subject: [PATCH] fuzz(v2): decode negotiated Merklix batch and sized messages

---
 src/test/fuzz/v2_merklix_sync.cpp | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/src/test/fuzz/v2_merklix_sync.cpp b/src/test/fuzz/v2_merklix_sync.cpp
index 333c5b33b5..435a474d11 100644
--- a/src/test/fuzz/v2_merklix_sync.cpp
+++ b/src/test/fuzz/v2_merklix_sync.cpp
@@ -3,6 +3,8 @@
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
 #include <crypto/siphash.h>
+#include <net/v2_protocol_handler.h>
+#include <streams.h>
 #include <lotus_v2/commitment.h>
 #include <lotus_v2/tagged_hash.h>
 #include <uint256.h>
@@ -188,6 +190,35 @@ BucketSyndrome ComputeBucketSyndrome(
 } // namespace
 
 FUZZ_TARGET(v2_merklix_sync) {
+    // Negotiated vector encodings reject CompactSize bounds before allocation.
+    // Keep the existing set-difference fuzz cases below unchanged.
+    {
+        DataStream wire{buffer};
+        try {
+            lotus::v2::net::MerklixBucketBatchRequest request;
+            wire >> request;
+            Assert(request.requests.size() <= request.MAX_REQUESTS);
+        } catch (const std::exception &) {}
+    }
+    {
+        DataStream wire{buffer};
+        try {
+            lotus::v2::net::MerklixBucketBatchReply reply;
+            wire >> reply;
+            Assert(reply.summaries.size() <= reply.MAX_SUMMARIES);
+            for (const auto &summary : reply.summaries)
+                Assert(summary.overflow_short_ids.size() <= 4096);
+        } catch (const std::exception &) {}
+    }
+    {
+        DataStream wire{buffer};
+        try {
+            lotus::v2::net::MerklixSizedSync sized;
+            wire >> sized;
+            Assert(sized.sketches.size() <= 256);
+            Assert(sized.short_ids.size() <= 65536);
+        } catch (const std::exception &) {}
+    }
     FuzzedDataProvider fdp(buffer.data(), buffer.size());
 
     const uint64_t k0 = fdp.ConsumeIntegral<uint64_t>();
