     if (!CheckPeerRateLimit(pfrom.GetId(), time_received)) {
@@ -1060,6 +1104,9 @@ void V2PeerProtocolHandler::HandleMerklixSync(
 
     const MerklixSyncDiffResult diff = DiffSyncSummary(summary);
     if (!diff.single_missing_short_ids.empty()) {
