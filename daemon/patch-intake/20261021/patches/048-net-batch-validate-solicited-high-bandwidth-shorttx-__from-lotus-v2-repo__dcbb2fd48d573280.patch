 src/net/v2_protocol_handler.h          |  48 ++
 src/net_processing.cpp                 | 689 ++++++++++++++++---------
 src/net_processing.h                   |  13 +-
 src/rpc/mempool.cpp                    |  48 ++
 src/test/v2_protocol_handler_tests.cpp | 324 +++++++++++-
 7 files changed, 1069 insertions(+), 270 deletions(-)

