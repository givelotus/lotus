+            ++m_pool.m_defer_snapshot_depth;
+        }
+        ScopedSnapshotDefer(const ScopedSnapshotDefer &) = delete;
+        ScopedSnapshotDefer &operator=(const ScopedSnapshotDefer &) = delete;
+
+        void CancelFlush() noexcept { m_flush_on_exit = false; }
+
+        ~ScopedSnapshotDefer();
+    };
