+                            throw std::ios_base::failure(
+                                "invalid V2 argument size");
+                        }
+                    }
+                }
+            } else if (in.flags == 2) {
+                has_coinbase = true;
+                if (in.sequence != UINT32_MAX) {
+                    throw std::ios_base::failure(
+                        "invalid V2 coinbase sequence");
+                }
+                const uint64_t has_cb = ReadCompactSize(s);
+                if (has_cb > 1) {
