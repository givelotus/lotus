From c6bc219f4a81a2a15760c91787dec686c203aaf1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 19:26:18 -0700
Subject: [PATCH 2/2] chronik: native Chronik schema version 14 on Lotus V2, as
 Rust

The fixup to v2/026 "chronik(v2): keep eCash's compact UtxoDataOutput
duplicate entries" moves the Rust CURRENT_INDEXER_VERSION from 13 to 14,
so a Chronik database written by an earlier V2 build (postcard
UtxoDataOutput entries) is refused with "-reindex/-chronikreindex"
instead of being misread. The native Chronik writes and checks the same
version: kCurrentIndexerVersion becomes 14 and the metadata tests expect
it. The db_values exporter no longer needs an eCash-tier checkout: on V2
it now regenerates test/fixtures/db_values.json byte for byte.

Tier: V2
---
 .../tests/export_native_db_values.rs          |  8 +++----
 .../native/include/chronik/native/schema.h    |  4 +++-
 chronik/native/test/metadata_tests.cpp        | 22 +++++++++----------
 3 files changed, 17 insertions(+), 17 deletions(-)

diff --git a/chronik/chronik-db/tests/export_native_db_values.rs b/chronik/chronik-db/tests/export_native_db_values.rs
index 8097660468..ea14c9f49d 100644
--- a/chronik/chronik-db/tests/export_native_db_values.rs
+++ b/chronik/chronik-db/tests/export_native_db_values.rs
@@ -12,11 +12,9 @@
 //! chronik/native/test/golden_db_values_tests.cpp decodes every case with the
 //! native codecs, re-encodes it and requires byte equality.
 //!
-//! The fixtures describe the eCash-tier storage layout. This crate's working
-//! tree carries Lotus V2 additions that change `UtxoDataOutput`'s duplicate
-//! encoding (postcard `(i64, Bytes)` instead of `sats LE8 || script`), so run
-//! the exporter against the eCash-tier chronik-db (a copy of the eCash-tier
-//! checkout with this file placed in `chronik/chronik-db/tests/`):
+//! The fixtures describe the eCash-tier storage layout, which the Lotus V2
+//! tier keeps (including `UtxoDataOutput`'s `sats LE8 || script` duplicate
+//! entries), so the exporter gives the same bytes on either tier:
 //!
 //!   CHRONIK_NATIVE_FIXTURES_DIR=<repo>/chronik/native/test/fixtures \
 //!   cargo test --locked -p chronik-db --test export_native_db_values
diff --git a/chronik/native/include/chronik/native/schema.h b/chronik/native/include/chronik/native/schema.h
index 9ef3228952..3d3c69d9ac 100644
--- a/chronik/native/include/chronik/native/schema.h
+++ b/chronik/native/include/chronik/native/schema.h
@@ -19,7 +19,9 @@
  */
 namespace chronik::native::schema {
 
-inline constexpr uint64_t kCurrentIndexerVersion = 13;
+// Lotus V2: 14 refuses databases of earlier V2 builds, whose UtxoDataOutput
+// entries were postcard instead of sats LE8 || raw script (as Rust chronik-db).
+inline constexpr uint64_t kCurrentIndexerVersion = 14;
 
 inline constexpr std::string_view kBlk = "blk";
 inline constexpr std::string_view kBlkByFirstTx = "blk_by_first_tx";
diff --git a/chronik/native/test/metadata_tests.cpp b/chronik/native/test/metadata_tests.cpp
index dc4b98b3ed..c9562210d1 100644
--- a/chronik/native/test/metadata_tests.cpp
+++ b/chronik/native/test/metadata_tests.cpp
@@ -206,15 +206,15 @@ BOOST_AUTO_TEST_CASE(schema_version_fresh_db) {
     VerifySchemaVersion(*f.store, logs.Fn());
     BOOST_REQUIRE_EQUAL(logs.lines.size(), 1u);
     BOOST_CHECK_EQUAL(logs.lines[0],
-                      "Chronik has version 13, initialized DB with that version\n");
+                      "Chronik has version 14, initialized DB with that version\n");
     {
         auto txn = f.store->BeginRead();
-        BOOST_CHECK_EQUAL(*f.Reader(*txn).GetSchemaVersion(), 13u);
+        BOOST_CHECK_EQUAL(*f.Reader(*txn).GetSchemaVersion(), 14u);
     }
     // Reopen: the DB now has the current version
     logs.lines.clear();
     VerifySchemaVersion(*f.store, logs.Fn());
-    BOOST_CHECK_EQUAL(logs.lines.at(0), "Chronik has version 13, DB has version 13\n");
+    BOOST_CHECK_EQUAL(logs.lines.at(0), "Chronik has version 14, DB has version 14\n");
 }
 
 BOOST_AUTO_TEST_CASE(schema_version_errors) {
@@ -228,18 +228,18 @@ BOOST_AUTO_TEST_CASE(schema_version_errors) {
     }
     {
         Fixture f;
-        f.PutMeta(meta_fields::kSchemaVersion, PostcardU64(14));
+        f.PutMeta(meta_fields::kSchemaVersion, PostcardU64(15));
         CheckThrowsText([&] { VerifySchemaVersion(*f.store, logs.Fn()); },
-                        "Chronik outdated: Chronik has version 13, but the "
-                        "database has version 14. Upgrade your node to the "
+                        "Chronik outdated: Chronik has version 14, but the "
+                        "database has version 15. Upgrade your node to the "
                         "appropriate version.");
     }
     {
         Fixture f;
-        f.PutMeta(meta_fields::kSchemaVersion, PostcardU64(12));
+        f.PutMeta(meta_fields::kSchemaVersion, PostcardU64(13));
         CheckThrowsText([&] { VerifySchemaVersion(*f.store, logs.Fn()); },
-                        "DB outdated: Chronik has version 13, but the database "
-                        "has version 12. -reindex/-chronikreindex to reindex "
+                        "DB outdated: Chronik has version 14, but the database "
+                        "has version 13. -reindex/-chronikreindex to reindex "
                         "the database to the new version.");
     }
     {
@@ -357,7 +357,7 @@ BOOST_AUTO_TEST_CASE(plugin_data_refused) {
     Logs logs;
     Fixture f;
     BOOST_CHECK_NO_THROW(RefuseIfPluginData(*f.store));
-    f.PutMeta(meta_fields::kSchemaVersion, PostcardU64(13));
+    f.PutMeta(meta_fields::kSchemaVersion, PostcardU64(14));
     f.Put(schema::kPluginMeta, Bytes{1}, Bytes{2});
     PrepareDbParams params;
     params.enable_token_index = false;
@@ -379,7 +379,7 @@ BOOST_AUTO_TEST_CASE(prepare_db_sequence) {
     {
         auto txn = f.store->BeginRead();
         auto r = f.Reader(*txn);
-        BOOST_CHECK_EQUAL(*r.GetSchemaVersion(), 13u);
+        BOOST_CHECK_EQUAL(*r.GetSchemaVersion(), 14u);
         BOOST_CHECK(r.IsTokenIndexEnabled());
         BOOST_CHECK(*r.IsLokadIdIndexEnabled());
         BOOST_CHECK(!*r.IsScripthashIndexEnabled());
