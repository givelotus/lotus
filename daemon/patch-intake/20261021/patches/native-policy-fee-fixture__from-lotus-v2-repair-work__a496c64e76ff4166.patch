From 565017067707df9e084778a9ff1408bc21d5ad9b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:20:35 -0700
Subject: [PATCH] fixup! consensus(v2): connect native state, monetary and
 script rules

Migrate the policy fee RPC fixture to real admitted and mined native funding, retaining exact non-v7 and fee-hysteresis rejection controls. The unchanged native-only test helper must move from owner121 to this owner112, where all required APIs already exist; owner121 reuses it. Full focused policy and RPC suites:27cases3273assertions pass on matched205 production plus test-only overlay. No final209 runtime claim.
---
 src/test/policy_fee_tests.cpp | 40 +++++++++++++++++++++++------------
 1 file changed, 26 insertions(+), 14 deletions(-)

diff --git a/src/test/policy_fee_tests.cpp b/src/test/policy_fee_tests.cpp
index 818cb9f9fd4514b7e44d34ac61c0376546fffbc6..4708f5249e9288fa4f65453ebb900c6116de60f9 100644
--- a/src/test/policy_fee_tests.cpp
+++ b/src/test/policy_fee_tests.cpp
@@ -25,6 +25,7 @@
 #include <util/time.h>
 
 #include <test/util/setup_common.h>
+#include <test/util/native_snapshot_setup.h>
 #include <test/util/transaction_utils.h>
 
 #include <boost/test/unit_test.hpp>
@@ -202,7 +203,7 @@ BOOST_AUTO_TEST_CASE(VmEnumerateConstantBoundAndExecutedCost) {
                    static_cast<uint64_t>(enum_break.accounting_cost));
 }
 
-BOOST_FIXTURE_TEST_CASE(GetFeeRateInfoAndTestRawTxBatchRpc, TestChain100Setup) {
+BOOST_FIXTURE_TEST_CASE(GetFeeRateInfoAndTestRawTxBatchRpc, NativeSnapshotChainSetup) {
     GlobalConfig config;
     auto &fee_ctrl = lotus::v2::GetGlobalFeeHysteresisController();
     fee_ctrl.Reset(TicksSinceEpoch<std::chrono::milliseconds>(NodeClock::now()));
@@ -239,17 +240,15 @@ BOOST_FIXTURE_TEST_CASE(GetFeeRateInfoAndTestRawTxBatchRpc, TestChain100Setup) {
     // on pure version=7 transactions while enforcing Tier 1 RPC fee hysteresis.
     const std::vector<uint8_t> v2_op_true_script{0x4e};
     const lotus::v2::Hash v2_op_true_leaf = lotus::v2::BranchLeaf(v2_op_true_script);
-    CScript coinbase_spk =
-        CScript() << ToByteVector(coinbaseKey.GetPubKey()) << OP_CHECKSIG;
     const Amount cb_val = m_coinbase_txns[0]->vout[0].nValue;
-    CMutableTransaction legacy_mtx = CreateValidMempoolTransaction(
-        m_coinbase_txns[0], 0, 1, coinbaseKey,
-        CScript(v2_op_true_script.begin(), v2_op_true_script.end()),
-        cb_val - 2000 * SATOSHI, /*submit=*/false);
-    legacy_mtx.vout[0].nFlags = 0;
-    legacy_mtx.vout[0].vBranches = {v2_op_true_leaf};
-    legacy_mtx.vout[0].vPaths = {{0}};
-    CTransactionRef legacy_tx = MakeTransactionRef(legacy_mtx);
+    const CMutableTransaction funding = CreateNativeMempoolTransaction(
+        m_coinbase_txns[0], 0, cb_val - 2000 * SATOSHI);
+    const CTransactionRef funding_tx = MakeTransactionRef(funding);
+    // The format rejection must not depend on a legacy signature or admission.
+    CMutableTransaction legacy_mtx = funding;
+    legacy_mtx.nVersion = 2;
+    legacy_mtx.fHasV2Lock = false;
+    const CTransactionRef legacy_tx = MakeTransactionRef(legacy_mtx);
     const std::string legacy_tx_hex = EncodeHexTx(*legacy_tx);
 
     {
@@ -269,14 +268,27 @@ BOOST_FIXTURE_TEST_CASE(GetFeeRateInfoAndTestRawTxBatchRpc, TestChain100Setup) {
                           "bad-txns-non-v7-format");
     }
 
-    CreateAndProcessBlock({legacy_mtx}, coinbase_spk);
+    // Confirm genuinely admitted native funding before evaluating the candidate.
+    auto block = node::BlockAssembler(
+                     config, m_node.chainman->ActiveChainstate(), m_node.mempool.get())
+                     .CreateNewBlock(CScript(program.begin(), program.end()))->block;
+    BOOST_REQUIRE_EQUAL(block.vtx.size(), 2U);
+    BOOST_REQUIRE(block.vtx[1]->GetId() == funding_tx->GetId());
+    while (!CheckProofOfWork(block.GetHash(), block.nBits,
+                             config.GetChainParams().GetConsensus())) {
+        ++block.nNonce;
+    }
+    BOOST_REQUIRE(m_node.chainman->ProcessNewBlock(
+        std::make_shared<const CBlock>(block), true, true, nullptr));
+    BOOST_REQUIRE(m_node.chainman->ActiveTip()->GetBlockHash() == block.GetHash());
+    BOOST_REQUIRE_EQUAL(m_node.mempool->size(), 0U);
 
     CMutableTransaction mtx;
     mtx.nVersion = 7;
     mtx.fHasV2Lock = true;
     mtx.nV2Lock = 0;
     mtx.nLockTime = 0;
-    CTxIn txin(COutPoint(legacy_tx->GetId(), 0), CScript(), CTxIn::SEQUENCE_FINAL);
+    CTxIn txin(COutPoint(funding_tx->GetId(), 0), CScript(), CTxIn::SEQUENCE_FINAL);
     txin.nFlags = 1;
     txin.nPathIndex = 0;
     lotus::v2::BranchWitness wit;
@@ -285,7 +297,7 @@ BOOST_FIXTURE_TEST_CASE(GetFeeRateInfoAndTestRawTxBatchRpc, TestChain100Setup) {
     mtx.vin.push_back(std::move(txin));
     lotus::v2::Output v2_out;
     v2_out.flags = 0;
-    v2_out.value = static_cast<uint64_t>((legacy_mtx.vout[0].nValue - 2000 * SATOSHI) / SATOSHI);
+    v2_out.value = static_cast<uint64_t>((funding.vout[0].nValue - 2000 * SATOSHI) / SATOSHI);
     v2_out.branches = {v2_op_true_leaf};
     v2_out.paths = {{0}};
     mtx.vout.push_back(CTxOut::FromV2Output(v2_out));
-- 
