From e51937a63effc6c78effb24ad869e6c1530ed7f8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 05:32:01 -0700
Subject: [PATCH] v2: stop linking lotus-cli against libevent

The RPC client no longer uses libevent, so its executable does not need
the explicit link. The line exists only in V2, where the client target
is named lotus-cli.

Tier: V2 (fixup to v2/003)
---
 src/CMakeLists.txt | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 83159d2a63..c47abfaabd 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -791,7 +791,6 @@ if(BUILD_CLI)
 	)
 
 	target_link_libraries(lotus-cli common rpcclient)
-	link_event(lotus-cli event)
 
 	add_to_symbols_check(lotus-cli)
 	add_to_security_check(lotus-cli)
-- 
2.50.1 (Apple Git-155)

