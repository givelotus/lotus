 src/init/common.cpp                |  8 ++++++++
 src/logging.cpp                    |  4 +++-
 src/logging.h                      |  1 +
 src/logging/encoder.cpp            | 12 ++++++++++++
 src/logging/encoder.h              |  2 ++
 src/test/logging_event_tests.cpp   | 25 +++++++++++++++++++++++++
