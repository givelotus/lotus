From 06485f41eba61685a4f862fe099aeac78808cba1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:56:22 -0700
Subject: [PATCH] test: regenerate rpc_dumptxoutset's mocked-time vectors

The block hash at height 100, the snapshot file digest and the txoutset
hash all depend on the regtest genesis (v2/061) and the V2 coinbase as
mined. They are identical over two fresh runs, and the test passes. They
will need regenerating once the legacy-coinbase bridge changes regtest
coinbases.

Tier: V2 (fixup to v2/061)
---
 test/functional/rpc_dumptxoutset.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/test/functional/rpc_dumptxoutset.py b/test/functional/rpc_dumptxoutset.py
index d6043acb72..2cd09c27bc 100644
--- a/test/functional/rpc_dumptxoutset.py
+++ b/test/functional/rpc_dumptxoutset.py
@@ -35,7 +35,7 @@ class DumptxoutsetTest(BitcoinTestFramework):
         # Blockhash should be deterministic based on mocked time.
         assert_equal(
             out["base_hash"],
-            "60f75030687b4e2cef45b190fdea91bfb8dd6a3a1e278a89862b2f419046d6e3",
+            "7f39db7f1bcd635e77e4cc515d7740ffd83682a95bd98d31481eb07bcefcb8f5",
         )
 
         with open(str(expected_path), "rb") as f:
@@ -43,12 +43,12 @@ class DumptxoutsetTest(BitcoinTestFramework):
             # UTXO snapshot hash should be deterministic based on mocked time.
             assert_equal(
                 digest,
-                "c54f4cbd9cf759264c90dff5cdc4928ba2cb8bced56bf6a4de51fcca07e92470",
+                "cfe64ce3e3de8f268bf9c6e57cf20dc143f63ae272ad8b684e8050d7e7166974",
             )
 
         assert_equal(
             out["txoutset_hash"],
-            "c42618bf1f1223c7c99ea76266d11bd0011ba5aaea613822555a48bede0509a7",
+            "410d4da0704092677bf3a476b39b3c5bd6ec12249d5d1376a90b92108b2e865b",
         )
         assert_equal(out["nchaintx"], 101)
 
