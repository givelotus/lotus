From 9ab2f309705d451d7e28d32e2b722d8e736b9e71 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 05:03:36 -0700
Subject: fixup! [v2 only] net: cache dictionary-versioned independent
 compressed block frames

---
 src/net_zstd_independent.h       | 2 ++
 src/test/net_websocket_tests.cpp | 7 +++++++
 2 files changed, 9 insertions(+)

diff --git a/src/net_zstd_independent.h b/src/net_zstd_independent.h
index a080bab25c..b2dfba4869 100644
--- a/src/net_zstd_independent.h
+++ b/src/net_zstd_independent.h
@@ -63,6 +63,8 @@ inline void DecompressP2PIndependent(Span<const uint8_t> frame,
         throw std::runtime_error(
             "unsupported independent frame/dictionary version");
     frame = frame.subspan(5);
+    if (frame.size() < 6 || ReadLE32(frame.data()) != ZSTD_MAGICNUMBER)
+        throw std::runtime_error("independent payload is not a zstd frame");
     const auto frame_size =
         ZSTD_findFrameCompressedSize(frame.data(), frame.size());
     CheckIndependentZstd(frame_size);
diff --git a/src/test/net_websocket_tests.cpp b/src/test/net_websocket_tests.cpp
index 8e10a961d9..8b48cd25be 100644
--- a/src/test/net_websocket_tests.cpp
+++ b/src/test/net_websocket_tests.cpp
@@ -776,6 +776,13 @@ BOOST_AUTO_TEST_CASE(independent_frame_rejects_bad_flags_and_versions) {
                       std::runtime_error);
     BOOST_CHECK_THROW(DecompressP2PIndependent(original, out, 100),
                       std::runtime_error);
+    // A skippable zstd frame is not an independently compressed P2P payload.
+    bad.assign(13, 0);
+    bad[0] = 1;
+    WriteLE32(bad.data() + 1, P2P_ZSTD_DICT_VERSION);
+    WriteLE32(bad.data() + 5, 0x184d2a50);
+    BOOST_CHECK_THROW(DecompressP2PIndependent(bad, out, 100000),
+                      std::runtime_error);
     // A complete frame with a declared window above the stream memory limit
     // must be rejected even when its content size fits the plain-message cap.
     std::vector<uint8_t> window_payload(2 * 1024 * 1024, 0x24);
