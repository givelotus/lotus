+    while True:
+        for i in range(len(sources)):
+            while not buffers[i] and not done[i]:
+                read(i)
+        live = [i for i, b in enumerate(buffers) if b]
+        if not live:
+            return
+        limits = [buffers[i][-1][key] for i in live if not done[i]]
+        out: List[bytes] = []
+        if not limits:
+            for i in live:
+                out += buffers[i]
+                buffers[i] = []
+        else:
+            limit = min(limits)
+            for i in live:
+                batch = buffers[i]
+                n = _count_below(batch, limit, key)
+                if n == len(batch):
+                    out += batch
+                    buffers[i] = []
+                elif n:
+                    out += batch[:n]
