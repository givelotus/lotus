+// What the open wallets saw arrive for a message, read once per wallet into a digest map: no
+// request, and no per-message scan of the coin list (review finding A7).
+import { verifiedReceiptsReader } from './message-receipts'
+
+const DIGEST = 'ab'.repeat(32)
+const payment = (over: Record<string, unknown>) => ({
+  address: '0x1',
+  origin: 'stealth',
+  status: 'received',
+  amountWei: 0n,
+  claimedAmountWei: 10n ** 21n,
+  spendable: true,
+  payloadDigest: DIGEST,
+  ...over,
+})
+const monad = {
+  chainIdentifier: 'monad-testnet',
+  getReceivedPayments: jest.fn(() => [
+    payment({ receivedAmountWei: 10n ** 18n }),
+    payment({ receivedAmountWei: 2n, status: 'pending', partial: true }),
+    // Claimed only: nothing seen arriving.
+    payment({ status: 'pending', receivedAmountWei: undefined }),
+    payment({ status: 'not-received' }),
+    // A stamp coin is counted with the message's stamp, not here.
+    payment({ origin: 'stamp', receivedAmountWei: 5n }),
+    payment({ payloadDigest: 'cd'.repeat(32), receivedAmountWei: 7n }),
+  ]),
+}
+const sepolia = {
+  chainIdentifier: 'ethereum-sepolia',
+  getReceivedPayments: jest.fn(() => [payment({ receivedAmountWei: 3n })]),
+}
+let mockPrimary: unknown = monad
+jest.mock('../accounts/session', () => ({
+  accountSession: { peekWallet: () => mockPrimary },
+}))
+jest.mock('../accounts/evm-wallets', () => ({
+  peekOpenedEvmWallets: () => [{ wallet: monad }, { wallet: sepolia }],
+}))
+
+beforeEach(() => {
+  monad.getReceivedPayments.mockClear()
+  sepolia.getReceivedPayments.mockClear()
+  mockPrimary = monad
+})
+
+it('reads each wallet once, however many messages are looked up', () => {
+  const read = verifiedReceiptsReader()
+  for (let i = 0; i < 50; i += 1) read(DIGEST)
+  expect(monad.getReceivedPayments).toHaveBeenCalledTimes(1)
+  expect(sepolia.getReceivedPayments).toHaveBeenCalledTimes(1)
+})
+
+it('counts only what was seen arriving, per digest and per wallet chain', () => {
+  const read = verifiedReceiptsReader()
+  expect(read(`0x${DIGEST.toUpperCase()}`)).toEqual([
+    { chainIdentifier: 'monad-testnet', baseUnits: 10n ** 18n + 2n },
+    { chainIdentifier: 'ethereum-sepolia', baseUnits: 3n },
+  ])
+  expect(read('cd'.repeat(32))).toEqual([
+    { chainIdentifier: 'monad-testnet', baseUnits: 7n },
+  ])
+  expect(read('ef'.repeat(32))).toEqual([])
+})
+
+it('verifies nothing when no session can answer', () => {
+  mockPrimary = undefined
+  monad.getReceivedPayments.mockImplementationOnce(() => {
+    throw new Error('closed')
+  })
+  expect(verifiedReceiptsReader()(DIGEST)).toEqual([
+    { chainIdentifier: 'ethereum-sepolia', baseUnits: 3n },
+  ])
+})
diff --git a/app/src/utils/message-receipts.ts b/app/src/utils/message-receipts.ts
new file mode 100644
index 000000000..af72b4a2b
--- /dev/null
+++ b/app/src/utils/message-receipts.ts
@@ -0,0 +1,64 @@
+import type { NativeWalletHandle } from '@frank/wallet/chain'
+import { accountSession } from '../accounts/session'
+import { peekOpenedEvmWallets } from '../accounts/evm-wallets'
+import type {
+  ChainAmount,
+  VerifiedMessageReceipts,
+} from '../stores/chats-domain'
+
+/** The account's wallets that are open now, one per canonical chain. Opens nothing. */
+function openWallets(): NativeWalletHandle[] {
+  const byChain = new Map<string, NativeWalletHandle>()
+  const primary = accountSession.peekWallet()
+  if (primary) byChain.set(primary.chainIdentifier, primary)
+  for (const { wallet } of peekOpenedEvmWallets())
+    if (!byChain.has(wallet.chainIdentifier))
+      byChain.set(wallet.chainIdentifier, wallet)
+  return Array.from(byChain.values())
+}
+
+/** A message digest as the wallet keys its coins: bare lower-case hex. */
+const digestKey = (payloadDigest: string) =>
+  payloadDigest.replace(/^0x/, '').toLowerCase()
+
+/**
+ * A reader of what the open wallets saw arrive on chain for a message's content payments
+ * (stealth transfers), matched by the message's payloadDigest, each on its wallet's canonical
+ * chain. Each wallet's coins are read once, here, from memory: no request is made, and looking
+ * up any number of messages afterwards costs nothing more. A payment only claimed adds nothing;
+ * a wallet that cannot tell (closed, or a chain without this list) adds nothing either. Take a
+ * new reader to see newer wallet state.
+ */
+export function verifiedReceiptsReader(): VerifiedMessageReceipts {
+  let wallets: NativeWalletHandle[]
+  try {
+    wallets = openWallets()
+  } catch {
+    // No session to ask: nothing verified.
+    return () => []
+  }
+  const byDigest = new Map<string, ChainAmount[]>()
+  for (const wallet of wallets) {
+    const received = new Map<string, bigint>()
+    try {
+      for (const payment of wallet.getReceivedPayments?.() ?? []) {
+        // As the wallet's own message summary counts content: shown arriving, or in part.
+        if (payment.origin !== 'stealth' || !payment.payloadDigest) continue
+        if (payment.status !== 'received' && payment.partial !== true) continue
+        const amount = payment.receivedAmountWei ?? 0n
+        if (amount <= 0n) continue
+        const key = digestKey(payment.payloadDigest)
+        received.set(key, (received.get(key) ?? 0n) + amount)
+      }
+    } catch {
+      // A wallet that cannot answer now verified nothing.
+      continue
+    }
+    for (const [key, baseUnits] of Array.from(received)) {
+      const list = byDigest.get(key) ?? []
+      list.push({ chainIdentifier: wallet.chainIdentifier, baseUnits })
+      byDigest.set(key, list)
+    }
+  }
+  return payloadDigest => byDigest.get(digestKey(payloadDigest)) ?? []
+}
