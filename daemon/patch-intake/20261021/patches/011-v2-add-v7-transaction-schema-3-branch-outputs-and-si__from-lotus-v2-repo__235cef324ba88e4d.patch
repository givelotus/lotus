diff --git a/src/lotus_v2/field_size.cpp b/src/lotus_v2/field_size.cpp
new file mode 100644
index 0000000000..58a5130d16
--- /dev/null
+++ b/src/lotus_v2/field_size.cpp
@@ -0,0 +1,67 @@
+// Copyright (c) 2026 The Lotus developers
+#include "field_size.h"
+
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+
+void AccumulatePaths(const std::vector<std::vector<uint8_t>> &paths,
+                     std::vector<size_t> &sizes) {
+    for (size_t slot = 0; slot < paths.size(); ++slot) {
+        const size_t encoded = PathSerializedSize(paths[slot]);
+        if (sizes.size() <= slot) sizes.resize(slot + 1, 0);
+        if (encoded > sizes[slot]) sizes[slot] = encoded;
+    }
+}
+
+} // namespace
+
+bool OutputSerializedSize(const Output &output, size_t &size,
+                          std::string &error) {
+    std::vector<uint8_t> encoded;
+    if (!EncodeOutput(output, encoded, error)) return false;
+    size = encoded.size();
+    error.clear();
+    return true;
+}
+
+bool DeriveFieldSizes(const VmExecutionContext &context,
+                      std::map<uint8_t, std::vector<size_t>> &field_sizes,
+                      std::string &error) {
+    std::vector<size_t> outputs;
+    outputs.reserve(context.tx.outputs.size());
+    for (const Output &output : context.tx.outputs) {
+        size_t size = 0;
+        if (!OutputSerializedSize(output, size, error)) {
+            field_sizes.clear();
+            return false;
+        }
+        outputs.push_back(size);
+    }
+    std::vector<size_t> coins(context.tx.inputs.size(), 0);
+    std::vector<size_t> coin_paths;
+    std::vector<size_t> output_paths;
+    for (size_t i = 0; i < context.tx.inputs.size(); ++i) {
+        if (i >= context.resolved.size() || !context.resolved[i]) continue;
+        const Output &coin = *context.resolved[i];
+        size_t size = 0;
+        if (!OutputSerializedSize(coin, size, error)) {
+            field_sizes.clear();
+            return false;
+        }
+        coins[i] = size;
+        AccumulatePaths(coin.paths, coin_paths);
+    }
+    for (const Output &output : context.tx.outputs)
+        AccumulatePaths(output.paths, output_paths);
+    field_sizes.clear();
+    field_sizes.emplace(0xdb, std::move(coin_paths));
+    field_sizes.emplace(0xdc, std::move(coins));
+    field_sizes.emplace(0xe6, std::move(output_paths));
+    field_sizes.emplace(0xe7, std::move(outputs));
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/field_size.h b/src/lotus_v2/field_size.h
new file mode 100644
index 0000000000..19d68ba2da
--- /dev/null
+++ b/src/lotus_v2/field_size.h
@@ -0,0 +1,35 @@
+// Copyright (c) 2026 The Lotus developers
+// Serialized sizes of authenticated output, coin and path fields. This is not
+// a block-acceptance check.
+#ifndef LOTUS_V2_FIELD_SIZE_H
+#define LOTUS_V2_FIELD_SIZE_H
+
+#include "vm.h"
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+
+// Bytes pushed for one path: a single length byte plus the branch indices.
+// Valid paths are at most MAX_OUTPUT_BRANCHES indices, each one byte on the
+// wire, so this matches Vec(CompactSize(index)).
+inline size_t PathSerializedSize(const std::vector<uint8_t> &path) {
+    return 1 + path.size();
+}
+
+// EncodeOutput's byte length. Fails closed on a field that will not encode.
+bool OutputSerializedSize(const Output &output, size_t &size, std::string &error);
+
+// Fills 0xdb (UTXOPATH), 0xdc (UTXOOUTPUT), 0xe6 (OUTPUTPATH) and 0xe7
+// (OUTPUTRECORD). One complete-record entry per input or output; a missing
+// coin is 0. Path vectors are indexed by slot and hold the widest authenticated
+// path at that slot. Empty path vectors mean no path exists. Caller hints are
+// not consulted.
+bool DeriveFieldSizes(const VmExecutionContext &context,
+                      std::map<uint8_t, std::vector<size_t>> &field_sizes,
+                      std::string &error);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/output.cpp b/src/lotus_v2/output.cpp
new file mode 100644
index 0000000000..98f5140316
--- /dev/null
+++ b/src/lotus_v2/output.cpp
@@ -0,0 +1,257 @@
+#include "output.h"
+
+#include <algorithm>
+#include <limits>
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+
+    class Reader {
+    public:
+        explicit Reader(const std::vector<uint8_t> &bytes) : bytes_(bytes) {}
+
+        size_t Remaining() const { return bytes_.size() - offset_; }
+        bool Finished() const { return Remaining() == 0; }
+
+        bool Take(size_t count, const uint8_t *&start) {
+            if (count > Remaining()) return false;
+            start = bytes_.data() + offset_;
+            offset_ += count;
+            return true;
+        }
+
+        bool Integer(size_t width, uint64_t &value) {
+            if (width == 0 || width > 8) return false;
+            const uint8_t *start = nullptr;
+            if (!Take(width, start)) return false;
+            value = 0;
+            for (size_t i = 0; i < width; ++i)
+                value |= uint64_t(start[i]) << (8 * i);
+            return true;
+        }
+
+        bool CompactSize(uint64_t cap, uint64_t &value) {
+            uint64_t lead;
+            if (!Integer(1, lead)) return false;
+            if (lead < 253)
+                value = lead;
+            else {
+                size_t width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+                if (!Integer(width, value)) return false;
+                if (value < (width == 2   ? 253ULL
+                             : width == 4 ? 65536ULL
+                                          : 4294967296ULL))
+                    return false;
+            }
+            return value <= cap;
+        }
+
+    private:
+        const std::vector<uint8_t> &bytes_;
+        size_t offset_ = 0;
+    };
+
+    void AppendInteger(uint64_t value, size_t width,
+                       std::vector<uint8_t> &out) {
+        for (size_t i = 0; i < width; ++i)
+            out.push_back(uint8_t(value >> (8 * i)));
+    }
+
+    void AppendCompactSize(uint64_t value, std::vector<uint8_t> &out) {
+        if (value < 253)
+            AppendInteger(value, 1, out);
+        else if (value <= 65535) {
+            out.push_back(253);
+            AppendInteger(value, 2, out);
+        } else if (value <= 4294967295ULL) {
+            out.push_back(254);
+            AppendInteger(value, 4, out);
+        } else {
+            out.push_back(255);
+            AppendInteger(value, 8, out);
+        }
+    }
+
+    bool Valid(const Output &output, std::string &error) {
+        if (output.flags & 0xfc) {
+            error = "flags";
+            return false;
+        }
+        if (output.HasToken()) {
+            if (output.token_id == Hash32{}) {
+                error = "zero token";
+                return false;
+            }
+        } else if (output.token_id != Hash32{}) {
+            error = "native token field";
+            return false;
+        }
+        if (output.branches.empty() ||
+            output.branches.size() > MAX_OUTPUT_BRANCHES) {
+            error = "branch count";
+            return false;
+        }
+        for (size_t i = 0; i < output.branches.size(); ++i) {
+            for (size_t j = 0; j < i; ++j) {
+                if (output.branches[i] == output.branches[j]) {
+                    error = "duplicate branch";
+                    return false;
+                }
+            }
+        }
+        if (output.IsBurn()) {
+            if (!output.paths.empty()) {
+                error = "burn paths";
+                return false;
+            }
+        } else if (output.paths.empty() ||
+                   output.paths.size() > MAX_OUTPUT_PATHS) {
+            error = "path count";
+            return false;
+        }
+        for (size_t p = 0; p < output.paths.size(); ++p) {
+            const auto &path = output.paths[p];
+            if (path.empty() || path.size() > output.branches.size()) {
+                error = "path length";
+                return false;
+            }
+            for (size_t i = 0; i < path.size(); ++i) {
+                if (path[i] >= output.branches.size() ||
+                    (i && path[i - 1] >= path[i])) {
+                    error = "path index";
+                    return false;
+                }
+            }
+            if (p && !(output.paths[p - 1] < path)) {
+                error = "path order";
+                return false;
+            }
+        }
+        return true;
+    }
+
+} // namespace
+
+bool DecodeOutput(const std::vector<uint8_t> &frame, Output &result,
+                  std::string &error) {
+    if (frame.size() > MAX_OUTPUT_BYTES) {
+        error = "output bytes";
+        return false;
+    }
+    Reader reader(frame);
+    Output parsed;
+    uint64_t value;
+    if (!reader.Integer(1, value)) {
+        error = "truncated flags";
+        return false;
+    }
+    parsed.flags = uint8_t(value);
+    if (parsed.flags & 0xfc) {
+        error = "flags";
+        return false;
+    }
+    if (!reader.Integer(8, parsed.value)) {
+        error = "truncated value";
+        return false;
+    }
+    if (parsed.HasToken()) {
+        const uint8_t *token;
+        if (!reader.Take(32, token)) {
+            error = "truncated token";
+            return false;
+        }
+        std::copy_n(token, 32, parsed.token_id.begin());
+    }
+    uint64_t count;
+    if (!reader.CompactSize(MAX_OUTPUT_BRANCHES, count)) {
+        error = "branch count";
+        return false;
+    }
+    // Division avoids host-width multiplication overflow before reserving
+    // storage.
+    if (count > reader.Remaining() / 32) {
+        error = "truncated branches";
+        return false;
+    }
+    parsed.branches.reserve(size_t(count));
+    for (uint64_t i = 0; i < count; ++i) {
+        const uint8_t *branch;
+        if (!reader.Take(32, branch)) {
+            error = "truncated branches";
+            return false;
+        }
+        Hash32 root;
+        std::copy_n(branch, 32, root.begin());
+        parsed.branches.push_back(root);
+    }
+    if (!reader.CompactSize(MAX_OUTPUT_PATHS, count)) {
+        error = "path count";
+        return false;
+    }
+    if (count > reader.Remaining()) {
+        error = "truncated paths";
+        return false;
+    }
+    parsed.paths.reserve(size_t(count));
+    for (uint64_t p = 0; p < count; ++p) {
+        uint64_t length;
+        if (!reader.CompactSize(MAX_OUTPUT_BRANCHES, length)) {
+            error = "path length";
+            return false;
+        }
+        if (length > reader.Remaining()) {
+            error = "truncated path";
+            return false;
+        }
+        std::vector<uint8_t> path;
+        path.reserve(size_t(length));
+        for (uint64_t i = 0; i < length; ++i) {
+            uint64_t index;
+            if (!reader.CompactSize(MAX_OUTPUT_BRANCHES - 1, index)) {
+                error = "path index";
+                return false;
+            }
+            path.push_back(uint8_t(index));
+        }
+        parsed.paths.push_back(std::move(path));
+    }
+    if (!reader.Finished()) {
+        error = "trailing bytes";
+        return false;
+    }
+    if (!Valid(parsed, error)) return false;
+    result = std::move(parsed);
+    error.clear();
+    return true;
+}
+
+bool EncodeOutput(const Output &output, std::vector<uint8_t> &result,
+                  std::string &error) {
+    if (!Valid(output, error)) return false;
+    std::vector<uint8_t> encoded;
+    encoded.reserve(MAX_OUTPUT_BYTES);
+    encoded.push_back(output.flags);
+    AppendInteger(output.value, 8, encoded);
+    if (output.HasToken())
+        encoded.insert(encoded.end(), output.token_id.begin(),
+                       output.token_id.end());
+    AppendCompactSize(output.branches.size(), encoded);
+    for (const auto &branch : output.branches)
+        encoded.insert(encoded.end(), branch.begin(), branch.end());
+    AppendCompactSize(output.paths.size(), encoded);
+    for (const auto &path : output.paths) {
+        AppendCompactSize(path.size(), encoded);
+        for (uint8_t index : path)
+            AppendCompactSize(index, encoded);
+    }
+    if (encoded.size() > MAX_OUTPUT_BYTES) {
+        error = "output bytes";
+        return false;
+    }
+    result = std::move(encoded);
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/output.h b/src/lotus_v2/output.h
new file mode 100644
index 0000000000..b22ddec97b
--- /dev/null
+++ b/src/lotus_v2/output.h
@@ -0,0 +1,41 @@
+// Candidate Lotus V2 output wire codec. No transaction validation is implied.
+#ifndef LOTUS_V2_OUTPUT_H
+#define LOTUS_V2_OUTPUT_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+
+using Hash32 = std::array<uint8_t, 32>;
+
+// P01 hard bounds. Any stricter deployment profile must be checked by its
+// caller.
+constexpr size_t MAX_OUTPUT_BRANCHES = 16;
+constexpr size_t MAX_OUTPUT_PATHS = 16;
+constexpr size_t MAX_OUTPUT_BYTES = 812;
+
+struct Output {
+    uint8_t flags = 0;
+    uint64_t value = 0;
+    Hash32 token_id{};
+    std::vector<Hash32> branches;
+    std::vector<std::vector<uint8_t>> paths;
+
+    bool HasToken() const { return (flags & 1) != 0; }
+    bool IsBurn() const { return (flags & 2) != 0; }
+};
+
+// Decode consumes exactly one output frame; any trailing byte is invalid.
+// On failure, result is unchanged and error gives a stable category string.
+bool DecodeOutput(const std::vector<uint8_t> &frame, Output &result,
+                  std::string &error);
+bool EncodeOutput(const Output &output, std::vector<uint8_t> &result,
+                  std::string &error);
+
+} // namespace lotus::v2
+
+#endif
