From fbf08016ca89c28f56aa67dac4bac5f9e5f8a842 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Sun, 11 Apr 2021 20:01:28 -0500
Subject: [PATCH] Change default datadir from ~/.bitcoin to ~/.lotus (#142)

Respectively updates Windows and Mac default datadirs

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: e80698283b999f23bff6a9babd38b9a20f6ee277
Recorded-replay-commit: 2b6c0140d2f8ac33fa36209e8fb0dc155a803485

diff --git a/src/common/args.cpp b/src/common/args.cpp
index 358beb1cc6..e608a39c30 100644
--- a/src/common/args.cpp
+++ b/src/common/args.cpp
@@ -725,12 +725,12 @@ std::string HelpMessageOpt(const std::string &option,
 }
 
 fs::path GetDefaultDataDir() {
-    // Windows: C:\Users\Username\AppData\Roaming\Bitcoin
-    // macOS: ~/Library/Application Support/Bitcoin
-    // Unix-like: ~/.bitcoin
+    // Windows: C:\Users\Username\AppData\Roaming\Lotus
+    // macOS: ~/Library/Application Support/Lotus
+    // Unix-like: ~/.lotus
 #ifdef WIN32
     // Windows
-    return GetSpecialFolderPath(CSIDL_APPDATA) / "Bitcoin";
+    return GetSpecialFolderPath(CSIDL_APPDATA) / "Lotus";
 #else
     fs::path pathRet;
     char *pszHome = getenv("HOME");
@@ -741,10 +741,10 @@ fs::path GetDefaultDataDir() {
     }
 #ifdef MAC_OSX
     // macOS
-    return pathRet / "Library/Application Support/Bitcoin";
+    return pathRet / "Library/Application Support/Lotus";
 #else
     // Unix-like
-    return pathRet / ".bitcoin";
+    return pathRet / ".lotus";
 #endif
 #endif
 }
