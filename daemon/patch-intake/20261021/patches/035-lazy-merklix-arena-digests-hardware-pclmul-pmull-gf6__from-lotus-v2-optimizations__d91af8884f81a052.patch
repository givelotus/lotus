From d06404b2f7622fdc4b453c1a6279ad4fc9316ed1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] perf: lazy Merklix arena digests, hardware PCLMUL/PMULL GF64,
 and batched P2P/mempool signals

Defer internal Merklix branch digest hashing until root materialization, accelerate
GF(2^64) multiplication via ARM64 PMULL / x86 PCLMULQDQ intrinsics, and batch
mempool subscriber notifications.

Build-prerequisite maintenance:
- Retain the existing overlay, s5, lazy-snapshot and mempool-queue interfaces removed by 020 while their implementations/callers remain; retain prerequisite filter/fee headers and the optional batch-collector declaration.
- Define the avabatch inventory ID required by the original 012 implementation/tests (0x20000006), preserve it in GetKind, and map its command name.
- Remove the stale treasury lock annotation until its V2 treasury mutex exists; no runtime treasury code is changed.
- Declare the existing mempool-batch vote variant and visitors with their 012 definitions; defer the V2-only supply gate until its V2 supply API is present.
- Reorder the V2 circulating-supply integration case to the V2 API introduction; it referenced absent SetV2BlockCirculatingSupplyForTest on L1.
- Compile the original Avalanche batch hashing helpers and define their avabatch wire command. Vendor/link BLAKE3 for the existing non-consensus batch-ID hash; L1 tagged hashes and block/transaction consensus hashes remain SHA-based.
- Keep one copy of the adaptive-epoch accessors and freeze API duplicated by 023.
- Restore the missing testrawtxbatch result-lambda binding and removeUnchecked transaction alias, and include declarations used by validation; these are compile repairs to existing expressions.
- Include the concrete disconnected-transaction type in its native test, and retain the 011 inventory expectations (50/25 ms, 2500 items/s, 350000 retained IDs) across stale 020 test literals.
- Keep the first copy of each preconsensus batch test; 023 appended duplicate BOOST test definitions already present in 012.

Original-Commit: 2ef243d434f15e848f3a86a4d30f6fe7e8de3ff8
---
 src/lotus_v2/set_reconciliation.cpp | 52 +++++++++++++++++++++++++
 src/net_processing.cpp              | 59 ++++++++++++++++++++++++++++-
 2 files changed, 109 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/set_reconciliation.cpp b/src/lotus_v2/set_reconciliation.cpp
index 299c9d69d3748ec0719ccd1a467f3cf098c41020..ca87ada896a14ea559b193157c32ddc43cbb091b 100644
--- a/src/lotus_v2/set_reconciliation.cpp
+++ b/src/lotus_v2/set_reconciliation.cpp
@@ -91,7 +91,58 @@ uint64_t ComputeShortTxId(uint64_t k0, uint64_t k1,
     return out != 0 ? out : 1ULL;
 }
 
+#if defined(__aarch64__) && defined(__ARM_FEATURE_CRYPTO)
+#include <arm_neon.h>
+#define LOTUS_GF64_USE_ARM_PMULL 1
+#elif defined(__x86_64__) && defined(__PCLMUL__)
+#include <wmmintrin.h>
+#define LOTUS_GF64_USE_X86_PCLMUL 1
+#endif
+
 uint64_t GF64Mul(uint64_t a, uint64_t b) noexcept {
+#if defined(LOTUS_GF64_USE_ARM_PMULL)
+    const poly128_t p = vmull_p64(static_cast<poly64_t>(a),
+                                  static_cast<poly64_t>(b));
+    uint64_t lo = 0;
+    uint64_t hi = 0;
+    uint8_t bytes[16];
+    std::memcpy(bytes, &p, 16);
+    std::memcpy(&lo, bytes, 8);
+    std::memcpy(&hi, bytes + 8, 8);
+    // Reduce hi * x^64 modulo x^64 + x^4 + x^3 + x + 1 (0x1B).
+    // Since hi < 2^64 and degree(0x1B) == 4, r1 = hi * 0x1B is at most 68 bits:
+    // its low 64 bits (r1_lo) are degrees 0..63, and its high 4 bits (r1_hi)
+    // are degrees 64..67 which are reduced a second time by multiplying by 0x1B.
+    const poly128_t r1 = vmull_p64(static_cast<poly64_t>(hi),
+                                   static_cast<poly64_t>(kGF64Modulus));
+    uint64_t r1_lo = 0;
+    uint64_t r1_hi = 0;
+    uint8_t r1_bytes[16];
+    std::memcpy(r1_bytes, &r1, 16);
+    std::memcpy(&r1_lo, r1_bytes, 8);
+    std::memcpy(&r1_hi, r1_bytes + 8, 8);
+    const poly128_t r2 = vmull_p64(static_cast<poly64_t>(r1_hi),
+                                   static_cast<poly64_t>(kGF64Modulus));
+    uint64_t r2_lo = 0;
+    std::memcpy(&r2_lo, &r2, 8);
+    return lo ^ r1_lo ^ r2_lo;
+#elif defined(LOTUS_GF64_USE_X86_PCLMUL)
+    const __m128i va = _mm_cvtsi64_si128(static_cast<long long>(a));
+    const __m128i vb = _mm_cvtsi64_si128(static_cast<long long>(b));
+    const __m128i prod = _mm_clmulepi64_si128(va, vb, 0x00);
+    const uint64_t lo = static_cast<uint64_t>(_mm_cvtsi128_si64(prod));
+    const uint64_t hi =
+        static_cast<uint64_t>(_mm_extract_epi64(prod, 1));
+    const __m128i vmod = _mm_cvtsi64_si128(static_cast<long long>(kGF64Modulus));
+    const __m128i r1 = _mm_clmulepi64_si128(
+        _mm_cvtsi64_si128(static_cast<long long>(hi)), vmod, 0x00);
+    const uint64_t r1_lo = static_cast<uint64_t>(_mm_cvtsi128_si64(r1));
+    const uint64_t r1_hi = static_cast<uint64_t>(_mm_extract_epi64(r1, 1));
+    const __m128i r2 = _mm_clmulepi64_si128(
+        _mm_cvtsi64_si128(static_cast<long long>(r1_hi)), vmod, 0x00);
+    return lo ^ r1_lo ^
+           static_cast<uint64_t>(_mm_cvtsi128_si64(r2));
+#else
     uint64_t res = 0;
     for (int i = 0; i < 64 && b != 0; ++i) {
         if (b & 1ULL) {
@@ -105,6 +156,7 @@ uint64_t GF64Mul(uint64_t a, uint64_t b) noexcept {
         b >>= 1;
     }
     return res;
+#endif
 }
 
 uint64_t GF64Sqr(uint64_t a) noexcept {
