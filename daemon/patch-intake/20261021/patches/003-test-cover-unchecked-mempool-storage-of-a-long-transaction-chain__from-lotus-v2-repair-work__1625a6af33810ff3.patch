From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] test: cover unchecked mempool storage of a long transaction
 chain

Exercise storage of a 100-transaction chain through addUnchecked. This fixture
bypasses transaction admission and does not remove a chain limit or change
consensus. Historical rationale overstated the payload. Unrelated whitespace
and a redundant parking-policy include are omitted from this test-only owner.

Original-Commit: f91d46dd19ede97d810baad55d1c0e46b80f7d1e
Original-Patch: ecash/002
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/test/mempool_tests.cpp | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index 8c7f094d90..1737f4a587 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -778,4 +778,34 @@ BOOST_AUTO_TEST_CASE(setAvalancheFinalized_ContextualCheckTransactionFailures) {
     }
 }
 
+BOOST_AUTO_TEST_CASE(unchecked_long_chain_storage) {
+    // Exercise the unchecked mempool container with a 100-transaction chain.
+    // addUnchecked bypasses input/script checks and admission policy; this is
+    // not evidence that ProcessTransaction accepts such a chain. No consensus
+    // or ancestor/descendant admission limit is changed by this fixture.
+    // Each transaction references the preceding transaction's single output.
+    // Verify all entries remain present in the container.
+    TestMemPoolEntryHelper entry;
+    entry.SigChecks(0);
+    LOCK2(cs_main, m_node.mempool->cs);
+
+    CMutableTransaction first;
+    first.vin.resize(1);
+    first.vin[0].scriptSig = CScript();
+    first.vout.emplace_back(10000 * SATOSHI, CScript() << OP_TRUE);
+    m_node.mempool->addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(first));
+
+    TxId prevId = first.GetId();
+    for (int i = 1; i < 100; i++) {
+        CMutableTransaction tx;
+        tx.vin.resize(1);
+        tx.vin[0].prevout = COutPoint(prevId, 0);
+        tx.vout.emplace_back(9000 * SATOSHI, CScript() << OP_TRUE);
+        m_node.mempool->addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(tx));
+        prevId = tx.GetId();
+    }
+
+    BOOST_CHECK_EQUAL(m_node.mempool->size(), 100UL);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
