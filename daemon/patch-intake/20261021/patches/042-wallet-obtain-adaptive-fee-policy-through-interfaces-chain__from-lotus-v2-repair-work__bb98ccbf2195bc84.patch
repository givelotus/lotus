From dcdfad2e1cb5133a470b9966af4668395d406063 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] wallet: obtain adaptive fee policy through interfaces::Chain

Expose the local RPC admission floor through the chain interface and include
the wallet recommendation cushion in the node provider's estimate under
congestion. Transaction creation consumes these interface values; the wallet
fee code no longer reaches into the process-global controller. Providers without
adaptive policy retain the default zero interface floor and normal relay policy.

Test the interface estimate, admission floor and resulting wallet fee rate with
an elevated congestion rate.

Original-Commit: 1e3b144a4d743cf802e0a3a90e9a4367da034b77
Original-Patch: ecash/029
Split-Concern: wallet
---
 src/interfaces/chain.h           |  3 +++
 src/node/interfaces.cpp          | 12 +++++++++++-
 src/wallet/fees.cpp              |  4 +++-
 src/wallet/test/wallet_tests.cpp | 19 +++++++++++++++++++
 4 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/src/interfaces/chain.h b/src/interfaces/chain.h
index 937fc1b4f669ba021be50c170eed7507984ac1fd..776828a7570bc34997f080b2aa08ef1bb7b6310a 100644
--- a/src/interfaces/chain.h
+++ b/src/interfaces/chain.h
@@ -218,6 +218,9 @@ public:
     //! Estimate fee
     virtual CFeeRate estimateFee() const = 0;
 
+    //! Current local RPC admission floor; zero when the provider has no adaptive policy.
+    virtual CFeeRate rpcAdmissionFee() const { return {}; }
+
     //! Relay current minimum fee (from -minrelaytxfee settings).
     virtual CFeeRate relayMinFee() = 0;
 
diff --git a/src/node/interfaces.cpp b/src/node/interfaces.cpp
index dac0b3656eb75703853f3d8e60c08bf1e6ba539c..35680c2eaa7d0f57e68ddec5bea3d530dc4ff2f1 100644
--- a/src/node/interfaces.cpp
+++ b/src/node/interfaces.cpp
@@ -10,6 +10,7 @@
 #include <config.h>
 #include <init.h>
 #include <interfaces/chain.h>
+#include <lotus_v2/fee_hysteresis.h>
 #include <interfaces/handler.h>
 #include <interfaces/node.h>
 #include <interfaces/wallet.h>
@@ -703,7 +704,16 @@ namespace {
             if (!m_node.mempool) {
                 return {};
             }
-            return m_node.mempool->estimateFee();
+            const auto now = TicksSinceEpoch<std::chrono::milliseconds>(NodeClock::now());
+            const auto info = lotus::v2::GetGlobalFeeHysteresisController().GetFeeRateInfo(now);
+            const auto estimate = m_node.mempool->estimateFee();
+            if (info.rpc_admission_feerate_per_kcu <= info.consensus_floor_per_kcu) return estimate;
+            return std::max(estimate, CFeeRate(static_cast<int64_t>(info.recommended_sdk_feerate_per_kcu) * SATOSHI));
+        }
+        CFeeRate rpcAdmissionFee() const override {
+            const auto now = TicksSinceEpoch<std::chrono::milliseconds>(NodeClock::now());
+            const auto rate = lotus::v2::GetGlobalFeeHysteresisController().GetRpcAdmissionRatePerKCu(now);
+            return CFeeRate(static_cast<int64_t>(rate) * SATOSHI);
         }
         CFeeRate relayMinFee() override {
             if (!m_node.mempool) {
diff --git a/src/wallet/fees.cpp b/src/wallet/fees.cpp
index 740e272950250b26e631d0e1ccf2fc02a4ca083b..9f30ec29fa6cbc83b8c96be81d5bb21c6b9e0681 100644
--- a/src/wallet/fees.cpp
+++ b/src/wallet/fees.cpp
@@ -20,7 +20,8 @@ Amount GetMinimumFee(const CWallet &wallet, unsigned int nTxBytes,
 }
 
 CFeeRate GetRequiredFeeRate(const CWallet &wallet) {
-    return std::max(wallet.m_min_fee, wallet.chain().relayMinFee());
+    return std::max({wallet.m_min_fee, wallet.chain().relayMinFee(),
+                     wallet.chain().rpcAdmissionFee()});
 }
 
 CFeeRate GetMinimumFeeRate(const CWallet &wallet,
@@ -37,6 +38,7 @@ CFeeRate GetMinimumFeeRate(const CWallet &wallet,
         if (neededFeeRate == CFeeRate()) {
             neededFeeRate = wallet.m_fallback_fee;
         }
+
     }
 
     // Prevent user from paying a fee below the min relay fee.
diff --git a/src/wallet/test/wallet_tests.cpp b/src/wallet/test/wallet_tests.cpp
index 9cb4f303bf53d30f776bd2c05e65092efda8b29e..1614569682d43281faf0720b453b9e9397eb74df 100644
--- a/src/wallet/test/wallet_tests.cpp
+++ b/src/wallet/test/wallet_tests.cpp
@@ -6,6 +6,9 @@
 #include <chainparams.h>
 #include <config.h>
 #include <interfaces/chain.h>
+#include <lotus_v2/fee_hysteresis.h>
+#include <wallet/fees.h>
+#include <util/time.h>
 #include <node/blockstorage.h>
 #include <node/context.h>
 #include <policy/policy.h>
@@ -38,6 +41,22 @@ using node::MAX_BLOCKFILE_SIZE;
 
 BOOST_FIXTURE_TEST_SUITE(wallet_tests, WalletTestingSetup)
 
+BOOST_AUTO_TEST_CASE(adaptive_fees_via_chain_interface) {
+    auto &controller = lotus::v2::GetGlobalFeeHysteresisController();
+    const auto now = TicksSinceEpoch<std::chrono::milliseconds>(NodeClock::now());
+    controller.Reset(now);
+    controller.SetRpcAdmissionRatePerKCu(9000, now);
+    const auto info = controller.GetFeeRateInfo(now);
+    const CFeeRate admission(static_cast<int64_t>(info.rpc_admission_feerate_per_kcu) * SATOSHI);
+    const CFeeRate recommended(static_cast<int64_t>(info.recommended_sdk_feerate_per_kcu) * SATOSHI);
+    BOOST_CHECK(m_wallet.chain().rpcAdmissionFee() == admission);
+    // The wallet's chain abstraction must publish congestion estimates itself.
+    BOOST_CHECK(m_wallet.chain().estimateFee() >= recommended);
+    BOOST_CHECK(GetRequiredFeeRate(m_wallet) >= admission);
+    BOOST_CHECK(GetMinimumFeeRate(m_wallet, CCoinControl{}) >= recommended);
+    controller.Reset(now);
+}
+
 static std::shared_ptr<CWallet> TestLoadWallet(WalletContext &context) {
     DatabaseOptions options;
     DatabaseStatus status;
