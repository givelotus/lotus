From e6bcb448e36795fc2a822da294156beae6720574 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 18:42:41 -0700
Subject: [PATCH] miner: don't read a backlog entry after popping it

BlockAssembler::addTxs took a reference to backlog.front(), popped the
queue, then returned a copy made through that reference, reading an
element pop() had already destroyed. AddressSanitizer reports this as a
container-overflow in miner_tests. Move the entry out before popping.

diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index 7a3d17d9c98d3e613406fdbffdc6f29e87358819..409b5182a773464570ecf068c3678d87ad3aec5d 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -385,7 +385,8 @@ void BlockAssembler::addTxs(const CTxMemPool &mempool) {
             return *mi++;
         }
 
-        auto &entry = backlog.front();
+        // Move the entry out before pop() destroys it.
+        CTxMemPoolEntryRef entry = std::move(backlog.front());
         backlog.pop();
 
         isFromBacklog = true;
