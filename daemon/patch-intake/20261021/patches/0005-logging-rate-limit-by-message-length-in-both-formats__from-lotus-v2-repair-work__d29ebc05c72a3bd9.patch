From 1ebc61fed42f7d3ee2ec042d988e87cf5159c0d4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 01:13:33 -0700
Subject: [PATCH 05/18] logging: rate limit by message length, in both formats

The per-location quota of unconditional logging counted the formatted
line: the text line with its prefixes, or the JSON object with all its
metadata. The same messages then exhausted the quota several times
sooner with -logformat=json, and the text limit depended on options such
as -logsourcelocations.

The quota now counts the message itself, as passed to the logger, which
is already known before any formatting: a limit means the same whatever
the format and options. The test checks that the same number of
messages fit in text and JSON.
---
 src/logging.cpp            |  7 +++--
 src/logging.h              |  3 +-
 src/test/logging_tests.cpp | 59 ++++++++++++++++++++------------------
 3 files changed, 37 insertions(+), 32 deletions(-)

diff --git a/src/logging.cpp b/src/logging.cpp
index 85506238b2..9c0032643f 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -757,9 +757,10 @@ void BCLog::Logger::LogPrintStr_(std::string_view str,
     }
     bool ratelimit{false};
     if (should_ratelimit && m_limiter) {
-        // The quota counts the bytes written: the whole line, in either
-        // format.
-        auto status{m_limiter->Consume(source_loc, str_prefixed)};
+        // The quota counts the message (as passed to the logger, before
+        // any prefix or JSON wrapping), so that a limit means the same in
+        // both formats.
+        auto status{m_limiter->Consume(source_loc, str)};
         if (status == LogRateLimiter::Status::NEWLY_SUPPRESSED) {
             // with should_ratelimit=false, this cannot lead to infinit
             // recursion
diff --git a/src/logging.h b/src/logging.h
index 39e9eef9bf..21814867e9 100644
--- a/src/logging.h
+++ b/src/logging.h
@@ -202,7 +202,8 @@ public:
         STILL_SUPPRESSED,
     };
     //! Consumes `source_loc`'s available bytes corresponding to the size of the
-    //! (formatted) `str` and returns its status.
+    //! message `str` (without log prefixes or JSON wrapping) and returns its
+    //! status.
     [[nodiscard]] Status Consume(const std::source_location &source_loc,
                                  std::string_view str)
         EXCLUSIVE_LOCKS_REQUIRED(!m_mutex);
diff --git a/src/test/logging_tests.cpp b/src/test/logging_tests.cpp
index 96a8e61455..913fbb5007 100644
--- a/src/test/logging_tests.cpp
+++ b/src/test/logging_tests.cpp
@@ -705,36 +705,39 @@ BOOST_FIXTURE_TEST_CASE(logging_json_format, LogSetup) {
 }
 
 BOOST_FIXTURE_TEST_CASE(logging_json_rate_limit, LogSetup) {
-    LogInstance().m_log_format = BCLog::LogFormat::JSON;
-    ScopedScheduler scheduler{};
-    LogInstance().SetRateLimiting(scheduler.GetLimiter(1000, 1h));
-
-    for (int i = 0; i < 20; ++i) {
-        LogInfo("%s\n", std::string(100, 'x'));
-    }
-    flush_debug_log();
-    const auto records{ReadJsonLogLines()};
-    BOOST_TEST_INFO_SCOPE(util::Join(ReadDebugLogLines(), "\n"));
-    // JSON lines are counted against the quota with their metadata, so
-    // fewer than ten 100-byte messages fit in 1000 bytes.
-    size_t plain{0}, flagged{0}, warnings{0};
-    for (const UniValue &r : records) {
-        const bool rl{r.exists("ratelimited") && r["ratelimited"].get_bool()};
-        if (r["level"].get_str() == "warning") {
-            ++warnings;
-            BOOST_CHECK(rl);
-            BOOST_CHECK(
-                r["msg"].get_str().starts_with("Excessive logging detected"));
-        } else if (rl) {
-            ++flagged;
-        } else {
-            ++plain;
+    // The quota counts messages, not lines: the same number of messages
+    // fit in text and JSON format, whatever the metadata adds.
+    for (const auto format : {BCLog::LogFormat::TEXT, BCLog::LogFormat::JSON}) {
+        LogInstance().m_log_format = format;
+        LogInstance().m_log_timestamps = true;
+        LogInstance().m_log_sourcelocations = true;
+        ScopedScheduler scheduler{};
+        LogInstance().SetRateLimiting(scheduler.GetLimiter(1000, 1h));
+        std::ofstream{LogInstance().m_file_path, std::ios::trunc};
+        for (int i = 0; i < 20; ++i) {
+            // 100 bytes with the newline
+            LogInfo("%s\n", std::string(99, 'x'));
+        }
+        flush_debug_log();
+        LogInstance().SetRateLimiting(nullptr);
+        size_t messages{0}, warnings{0};
+        for (const std::string &line : ReadDebugLogLines()) {
+            if (line.find("Excessive logging detected") != std::string::npos) {
+                ++warnings;
+            } else if (line.find(std::string(99, 'x')) != std::string::npos) {
+                ++messages;
+            }
+        }
+        BOOST_TEST_INFO_SCOPE("format " << int(format));
+        BOOST_CHECK_EQUAL(warnings, 1U);
+        // Ten fit in the quota; the eleventh starts the suppression and is
+        // still written (as in text mode).
+        BOOST_CHECK_EQUAL(messages, 11U);
+        if (format == BCLog::LogFormat::JSON) {
+            const auto records{ReadJsonLogLines()};
+            BOOST_CHECK(records.back()["ratelimited"].get_bool());
         }
     }
-    BOOST_CHECK_EQUAL(warnings, 1U);
-    BOOST_CHECK(plain > 0 && plain < 10);
-    // The line that started the suppression
-    BOOST_CHECK_EQUAL(flagged, 1U);
 }
 
 BOOST_AUTO_TEST_SUITE_END()
