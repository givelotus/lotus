From 5a2810b8006a7d55e238241bc795151efc5a9c1e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:42:27 -0700
Subject: [PATCH] rpc(v2): convert setfastsyncpivot's utxoshards argument from
 JSON

rpc_help failed: setfastsyncpivot, added by v2/040, declares its third
argument utxoshards as an array, but the client conversion table had no
entry for it. lotus-cli therefore passed the array as a string, and
the named-argument consistency check in rpc_help reported
('setfastsyncpivot', 2, 'utxoshards').

The table now lists it. rpc_help, which compares the table against
every server command, is the regression test and passes again.

Tier: V2 (fixup to v2/040)
---
 src/rpc/client.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/rpc/client.cpp b/src/rpc/client.cpp
index fcb294f771..640a6be494 100644
--- a/src/rpc/client.cpp
+++ b/src/rpc/client.cpp
@@ -185,6 +185,7 @@ static const CRPCConvertParam vRPCConvertParams[] = {
     {"getblockstats", 0, "hash_or_height"},
     {"getblockstats", 1, "stats"},
     {"pruneblockchain", 0, "height"},
+    {"setfastsyncpivot", 2, "utxoshards"},
     {"keypoolrefill", 0, "newsize"},
     {"getrawmempool", 0, "verbose"},
     {"getrawmempool", 1, "mempool_sequence"},
-- 
