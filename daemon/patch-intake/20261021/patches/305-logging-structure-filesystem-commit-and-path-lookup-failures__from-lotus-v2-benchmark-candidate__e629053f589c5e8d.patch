From abb30f1dce4647a01c78c763c3d80f529ab3ba10 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 12:22:40 -0700
Subject: [PATCH] logging: structure filesystem commit and path-lookup failures

Give the six existing filesystem diagnostics stable event identities and
registered Error fields, preserving Info severity, text, platform guards,
ignored EINVAL cases and failure returns. Observe errno/GetLastError before
EventBuilder construction: exact reviewed branch-entry adjustments capture
only the original error-string expression, as the old LogPrintf arguments
did before calling the logging function. No new error-code API is required.

Scripted diff (ast-grep-py0.51.0 with exact reviewed support adjustments):
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/filesystem-commit-failures.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/filesystem-commit-213-dryrun.json
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/filesystem-commit-failures.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/filesystem-commit-213-apply.json --apply
  git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/util/fs_helpers.cpp src/test/logging_event_tests.cpp

The manual focused test calls real FileCommit on macOS /dev/null (actual
F_FULLFSYNC failure), or buffered Linux /dev/full (actual fflush failure),
checking the false result, original Info level, error text and typed JSON.
Only macOS is available for native execution here; Linux/Windows behavior
must not be claimed from that run. No user files, nodes or datadirs involved.

Validation at commit: event lint421 sites and whitespace pass. Native test
and exact owner replay pending; first207 immutable native proof unchanged.
Tier: shared eCash; V2 inherits. No public header/registry/API change.
---
 .../rules/filesystem-commit-failures.json     | 137 ++++++++++++++++++
 src/test/logging_event_tests.cpp              |  39 ++++-
 src/util/fs_helpers.cpp                       |  31 +++-
 3 files changed, 198 insertions(+), 9 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/filesystem-commit-failures.json

diff --git a/contrib/logging/conversion/rules/filesystem-commit-failures.json b/contrib/logging/conversion/rules/filesystem-commit-failures.json
new file mode 100644
index 0000000000000000000000000000000000000000..a2d96061fed3660ab2cd248e46a71171432f057b
--- /dev/null
+++ b/contrib/logging/conversion/rules/filesystem-commit-failures.json
@@ -0,0 +1,137 @@
+{
+  "schema": 1,
+  "batch": "filesystem-commit-failures",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/util/fs_helpers.cpp",
+      "rules": [
+        {
+          "id": "file_commit_stdio_flush_failed",
+          "old": "LogPrintf(\"fflush failed: %s\\n\", SysErrorString(errno))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"file_commit_stdio_flush_failed\", \"fflush failed: {error}\").Field(BCLog::LogField::Error, commit_error)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "fflush failed: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "SysErrorString(errno)"
+            ]
+          },
+          "review_note": "Preserve Info level, exact text and failure return. Explicit reviewed support adjustment evaluates the original error-string argument at failure-branch entry before EventBuilder is constructed, preserving errno/GetLastError observation timing; no private paths or raw FILE pointers added. Platform guards and ignored EINVAL cases unchanged."
+        },
+        {
+          "id": "file_commit_windows_flush_failed",
+          "old": "LogPrintf(\"FlushFileBuffers failed: %s\\n\",\n                  Win32ErrorString(GetLastError()))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"file_commit_windows_flush_failed\", \"FlushFileBuffers failed: {error}\").Field(BCLog::LogField::Error, commit_error)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "FlushFileBuffers failed: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "Win32ErrorString(GetLastError())"
+            ]
+          },
+          "review_note": "Preserve Info level, exact text and failure return. Explicit reviewed support adjustment evaluates the original error-string argument at failure-branch entry before EventBuilder is constructed, preserving errno/GetLastError observation timing; no private paths or raw FILE pointers added. Platform guards and ignored EINVAL cases unchanged."
+        },
+        {
+          "id": "file_commit_fullfsync_failed",
+          "old": "LogPrintf(\"fcntl F_FULLFSYNC failed: %s\\n\", SysErrorString(errno))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"file_commit_fullfsync_failed\", \"fcntl F_FULLFSYNC failed: {error}\").Field(BCLog::LogField::Error, commit_error)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "fcntl F_FULLFSYNC failed: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "SysErrorString(errno)"
+            ]
+          },
+          "review_note": "Preserve Info level, exact text and failure return. Explicit reviewed support adjustment evaluates the original error-string argument at failure-branch entry before EventBuilder is constructed, preserving errno/GetLastError observation timing; no private paths or raw FILE pointers added. Platform guards and ignored EINVAL cases unchanged."
+        },
+        {
+          "id": "file_commit_fdatasync_failed",
+          "old": "LogPrintf(\"fdatasync failed: %s\\n\", SysErrorString(errno))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"file_commit_fdatasync_failed\", \"fdatasync failed: {error}\").Field(BCLog::LogField::Error, commit_error)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "fdatasync failed: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "SysErrorString(errno)"
+            ]
+          },
+          "review_note": "Preserve Info level, exact text and failure return. Explicit reviewed support adjustment evaluates the original error-string argument at failure-branch entry before EventBuilder is constructed, preserving errno/GetLastError observation timing; no private paths or raw FILE pointers added. Platform guards and ignored EINVAL cases unchanged."
+        },
+        {
+          "id": "file_commit_fsync_failed",
+          "old": "LogPrintf(\"fsync failed: %s\\n\", SysErrorString(errno))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"file_commit_fsync_failed\", \"fsync failed: {error}\").Field(BCLog::LogField::Error, commit_error)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "fsync failed: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "SysErrorString(errno)"
+            ]
+          },
+          "review_note": "Preserve Info level, exact text and failure return. Explicit reviewed support adjustment evaluates the original error-string argument at failure-branch entry before EventBuilder is constructed, preserving errno/GetLastError observation timing; no private paths or raw FILE pointers added. Platform guards and ignored EINVAL cases unchanged."
+        },
+        {
+          "id": "windows_special_folder_path_failed",
+          "old": "LogPrintf(\n        \"SHGetSpecialFolderPathW() failed, could not obtain requested path.\\n\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"windows_special_folder_path_failed\", \"SHGetSpecialFolderPathW() failed, could not obtain requested path.\")",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "SHGetSpecialFolderPathW() failed, could not obtain requested path.\n",
+            "specifiers": [],
+            "arguments": []
+          },
+          "review_note": "Preserve Info level, exact text and failure return. Explicit reviewed support adjustment evaluates the original error-string argument at failure-branch entry before EventBuilder is constructed, preserving errno/GetLastError observation timing; no private paths or raw FILE pointers added. Platform guards and ignored EINVAL cases unchanged."
+        }
+      ],
+      "support_adjustments": [
+        {
+          "purpose": "Capture exactly the old error-string expression before typed builder construction; keep error code timing and guarded branch unchanged.",
+          "old": "if (fflush(file) != 0) {\n",
+          "new": "if (fflush(file) != 0) {\n        const auto commit_error{SysErrorString(errno)};\n"
+        },
+        {
+          "purpose": "Capture exactly the old error-string expression before typed builder construction; keep error code timing and guarded branch unchanged.",
+          "old": "if (FlushFileBuffers(hFile) == 0) {\n",
+          "new": "if (FlushFileBuffers(hFile) == 0) {\n        const auto commit_error{Win32ErrorString(GetLastError())};\n"
+        },
+        {
+          "purpose": "Capture exactly the old error-string expression before typed builder construction; keep error code timing and guarded branch unchanged.",
+          "old": "if (fcntl(fileno(file), F_FULLFSYNC, 0) == -1) {\n",
+          "new": "if (fcntl(fileno(file), F_FULLFSYNC, 0) == -1) {\n        const auto commit_error{SysErrorString(errno)};\n"
+        },
+        {
+          "purpose": "Capture exactly the old error-string expression before typed builder construction; keep error code timing and guarded branch unchanged.",
+          "old": "if (fdatasync(fileno(file)) != 0 && errno != EINVAL) {\n",
+          "new": "if (fdatasync(fileno(file)) != 0 && errno != EINVAL) {\n        const auto commit_error{SysErrorString(errno)};\n"
+        },
+        {
+          "purpose": "Capture exactly the old error-string expression before typed builder construction; keep error code timing and guarded branch unchanged.",
+          "old": "if (fsync(fileno(file)) != 0 && errno != EINVAL) {\n",
+          "new": "if (fsync(fileno(file)) != 0 && errno != EINVAL) {\n        const auto commit_error{SysErrorString(errno)};\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 8ff569cb92023e7cc3e64434ebd53a474be8ab15..b0d375539fbb06a229e0f9bcb81145ba5b825684 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -19,13 +19,16 @@
 #include <test/util/setup_common.h>
 #include <univalue.h>
 #include <util/fs.h>
+#include <util/fs_helpers.h>
 #include <util/strencodings.h>
 #include <util/translation.h>
 
 #include <boost/test/unit_test.hpp>
 
-#ifdef __linux__
+#if defined(__linux__) || defined(MAC_OSX)
 #include <fcntl.h>
+#endif
+#ifdef __linux__
 #include <sys/socket.h>
 #include <sys/un.h>
 #include <unistd.h>
@@ -1286,4 +1289,38 @@ BOOST_AUTO_TEST_CASE(
     BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
+#if (defined(MAC_OSX) && defined(F_FULLFSYNC)) || defined(__linux__)
+BOOST_AUTO_TEST_CASE(
+    file_commit_failure_preserves_error_text_and_false_return) {
+    Format(BCLog::LogFormat::JSON);
+#if defined(MAC_OSX) && defined(F_FULLFSYNC)
+    // /dev/null accepts stdio writes but cannot perform F_FULLFSYNC.
+    AutoFile file{fsbridge::fopen(fs::path{"/dev/null"}, "wb")};
+    constexpr const char *event{"file_commit_fullfsync_failed"};
+    constexpr const char *prefix{"fcntl F_FULLFSYNC failed: "};
+#else
+    // Buffer one byte so /dev/full reports its actual ENOSPC in fflush.
+    std::array<char, 4096> buffer{};
+    AutoFile file{fsbridge::fopen(fs::path{"/dev/full"}, "wb")};
+    BOOST_REQUIRE(!file.IsNull());
+    BOOST_REQUIRE_EQUAL(
+        setvbuf(file.Get(), buffer.data(), _IOFBF, buffer.size()), 0);
+    constexpr const char *event{"file_commit_stdio_flush_failed"};
+    constexpr const char *prefix{"fflush failed: "};
+#endif
+    BOOST_REQUIRE(!file.IsNull());
+    const char value{'x'};
+    BOOST_REQUIRE_EQUAL(fwrite(&value, 1, 1, file.Get()), 1U);
+    BOOST_CHECK(!FileCommit(file.Get()));
+    const auto row{Json()};
+    BOOST_CHECK_EQUAL(row["event"].get_str(), event);
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_REQUIRE(row["error"].isStr());
+    BOOST_CHECK(!row["error"].get_str().empty());
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      std::string{prefix} + row["error"].get_str());
+    BOOST_CHECK(row["fields_truncated"].isNull());
+}
+#endif
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/util/fs_helpers.cpp b/src/util/fs_helpers.cpp
index 17c37b53426b011e683b28eb8d03940a0b403cb7..4cea7f2c2e268565706b9b905a79f837748b9a86 100644
--- a/src/util/fs_helpers.cpp
+++ b/src/util/fs_helpers.cpp
@@ -111,31 +111,45 @@ std::streampos GetFileSize(const char *path, std::streamsize max) {
 bool FileCommit(FILE *file) {
     // harmless if redundantly called
     if (fflush(file) != 0) {
-        LogPrintf("fflush failed: %s\n", SysErrorString(errno));
+        const auto commit_error{SysErrorString(errno)};
+        LogInfoEvent(BCLog::ALL, "file_commit_stdio_flush_failed",
+                     "fflush failed: {error}")
+            .Field(BCLog::LogField::Error, commit_error);
         return false;
     }
 #ifdef WIN32
     HANDLE hFile = (HANDLE)_get_osfhandle(_fileno(file));
     if (FlushFileBuffers(hFile) == 0) {
-        LogPrintf("FlushFileBuffers failed: %s\n",
-                  Win32ErrorString(GetLastError()));
+        const auto commit_error{Win32ErrorString(GetLastError())};
+        LogInfoEvent(BCLog::ALL, "file_commit_windows_flush_failed",
+                     "FlushFileBuffers failed: {error}")
+            .Field(BCLog::LogField::Error, commit_error);
         return false;
     }
 #elif defined(MAC_OSX) && defined(F_FULLFSYNC)
     // Manpage says "value other than -1" is returned on success
     if (fcntl(fileno(file), F_FULLFSYNC, 0) == -1) {
-        LogPrintf("fcntl F_FULLFSYNC failed: %s\n", SysErrorString(errno));
+        const auto commit_error{SysErrorString(errno)};
+        LogInfoEvent(BCLog::ALL, "file_commit_fullfsync_failed",
+                     "fcntl F_FULLFSYNC failed: {error}")
+            .Field(BCLog::LogField::Error, commit_error);
         return false;
     }
 #elif HAVE_FDATASYNC
     // Ignore EINVAL for filesystems that don't support sync
     if (fdatasync(fileno(file)) != 0 && errno != EINVAL) {
-        LogPrintf("fdatasync failed: %s\n", SysErrorString(errno));
+        const auto commit_error{SysErrorString(errno)};
+        LogInfoEvent(BCLog::ALL, "file_commit_fdatasync_failed",
+                     "fdatasync failed: {error}")
+            .Field(BCLog::LogField::Error, commit_error);
         return false;
     }
 #else
     if (fsync(fileno(file)) != 0 && errno != EINVAL) {
-        LogPrintf("fsync failed: %s\n", SysErrorString(errno));
+        const auto commit_error{SysErrorString(errno)};
+        LogInfoEvent(BCLog::ALL, "file_commit_fsync_failed",
+                     "fsync failed: {error}")
+            .Field(BCLog::LogField::Error, commit_error);
         return false;
     }
 #endif
@@ -249,8 +263,9 @@ fs::path GetSpecialFolderPath(int nFolder, bool fCreate) {
         return fs::path(pszPath);
     }
 
-    LogPrintf(
-        "SHGetSpecialFolderPathW() failed, could not obtain requested path.\n");
+    LogInfoEvent(
+        BCLog::ALL, "windows_special_folder_path_failed",
+        "SHGetSpecialFolderPathW() failed, could not obtain requested path.");
     return fs::path("");
 }
 #endif
