From 3f367f82a2d41f1f795ec4ec128e375d6c662729 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 20:33:08 -0700
Subject: blockstorage: read blocks into memory before deserializing them

ReadBlock deserialized straight from the block file, so every field went
through a separate buffered file read, and every transaction was copied
through the per-thread scratch buffer.

Read the block with ReadRawBlock, which checks the disk magic and size
and reads the block with one read, then deserialize it from that buffer.
Its transactions are then built in place from the buffer.

ReadBlockBench drops from about 3.17 ms to 2.43 ms (-23%) with software
SHA-256. ReadBlock now also rejects a block whose disk magic does not
match, as ReadRawBlock already did.
---
 src/node/blockstorage.cpp | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/src/node/blockstorage.cpp b/src/node/blockstorage.cpp
index d142117707ea0b9135ac38489c36d081e9a2bd9a..aa5965b08b68d3657e356c251d5a49405983c9dd 100644
--- a/src/node/blockstorage.cpp
+++ b/src/node/blockstorage.cpp
@@ -942,16 +942,15 @@ bool BlockManager::WriteBlockUndo(const CBlockUndo &blockundo,
 bool BlockManager::ReadBlock(CBlock &block, const FlatFilePos &pos) const {
     block.SetNull();
 
-    // Open history file to read
-    AutoFile filein{OpenBlockFile(pos, true)};
-    if (filein.IsNull()) {
-        LogError("ReadBlock: OpenBlockFile failed for %s\n", pos.ToString());
+    // Read the whole block with one read, then deserialize it from memory so
+    // its transactions are built straight from these bytes.
+    std::vector<uint8_t> block_data;
+    if (!ReadRawBlock(block_data, pos)) {
         return false;
     }
 
-    // Read block
     try {
-        filein >> block;
+        SpanReader{block_data} >> block;
     } catch (const std::exception &e) {
         LogError("%s: Deserialize or I/O error - %s at %s\n", __func__,
                  e.what(), pos.ToString());
