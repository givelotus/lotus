From 568fdb4d97a39e7c2b021dc2f74d3b9a6e2b86c0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:09:12 -0700
Subject: [PATCH] build: allow pinned external in-process Chronik source

Keep the stock in-tree path as the default. An explicit external provider verifies the source export before configuring the unchanged Chronik Rust/CXX component. Redirect bridge tests and protobuf generation to the same source so the host chronik directory is unnecessary.

This host adapter targets exact ABC 1fb7db17 and changes no consensus, policy, runtime ABI or NNG interface. Native macOS arm64 daemon/CLI/test and full Rust test/Clippy targets pass with the declared upstream Rust 1.87 toolchain. Nine existing Chronik functional tests pass with the host chronik directory absent.
---
 CMakeLists.txt          | 16 +++++++++++++++-
 src/test/CMakeLists.txt |  6 +++---
 test/CMakeLists.txt     |  2 +-
 3 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0fb513579e..d728d9fc57 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -146,9 +146,23 @@ deprecate_build_flag(BUILD_BITCOIN_CHRONIK_PLUGINS BUILD_CHRONIK_PLUGINS)
 option(BUILD_CHRONIK "Activate the Chronik indexer" OFF)
 option(BUILD_CHRONIK_PLUGINS "Activate the plugin system for Chronik" OFF)
 
+set(CHRONIK_SOURCE_DIR "" CACHE PATH "Pinned external Chronik export")
+set(CHRONIK_PROVIDER_MODULE "" CACHE FILEPATH "Shared Chronik CMake provider")
+set(CHRONIK_TEST_SOURCE_DIR "${CMAKE_SOURCE_DIR}/chronik")
+if(BUILD_CHRONIK AND CHRONIK_SOURCE_DIR)
+    set(CHRONIK_TEST_SOURCE_DIR "${CHRONIK_SOURCE_DIR}/chronik")
+endif()
 add_subdirectory(src)
 if(BUILD_CHRONIK)
-	add_subdirectory(chronik)
+    if(CHRONIK_SOURCE_DIR)
+        if(NOT EXISTS "${CHRONIK_PROVIDER_MODULE}")
+            message(FATAL_ERROR "External Chronik requires CHRONIK_PROVIDER_MODULE")
+        endif()
+        include("${CHRONIK_PROVIDER_MODULE}")
+        lotus_add_chronik_from_source(SOURCE_DIR "${CHRONIK_SOURCE_DIR}" HOST_PROFILE abc)
+    else()
+        add_subdirectory(chronik)
+    endif()
 endif()
 
 add_subdirectory(test)
diff --git a/src/test/CMakeLists.txt b/src/test/CMakeLists.txt
index 9c5a6db6a0..8db2aed633 100644
--- a/src/test/CMakeLists.txt
+++ b/src/test/CMakeLists.txt
@@ -110,9 +110,9 @@ gen_asmap_headers(ASMAP_HEADERS
 
 if(BUILD_CHRONIK)
 	set(BITCOIN_CHRONIK_TESTS
-		../../chronik/test/bridgecompression_tests.cpp
-		../../chronik/test/bridgeprimitives_tests.cpp
-		../../chronik/test/chronikbridge_tests.cpp
+		${CHRONIK_TEST_SOURCE_DIR}/test/bridgecompression_tests.cpp
+		${CHRONIK_TEST_SOURCE_DIR}/test/bridgeprimitives_tests.cpp
+		${CHRONIK_TEST_SOURCE_DIR}/test/chronikbridge_tests.cpp
 	)
 endif()
 
diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index c11a6959c9..c0bcb4feff 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -35,7 +35,7 @@ if(BUILD_CHRONIK)
 	find_package(Protobuf 3.0.0 REQUIRED)
 	protobuf_generate_python(
 		PROTOBUF_PY
-		../chronik/chronik-proto/proto/chronik.proto
+		${CHRONIK_TEST_SOURCE_DIR}/chronik-proto/proto/chronik.proto
 	)
 	list(APPEND _TEST_TARGET_DEPENDS "${PROTOBUF_PY}")
 	add_custom_target(protobuf-chronik ALL DEPENDS "${PROTOBUF_PY}")
