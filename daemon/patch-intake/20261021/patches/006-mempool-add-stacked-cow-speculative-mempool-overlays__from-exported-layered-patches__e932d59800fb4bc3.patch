+            EdPoint result = Identity();
+            EdPoint acc;
+            Require(BN_copy(acc.x.n, base.x.n) && BN_copy(acc.y.n, base.y.n) &&
+                    BN_copy(acc.z.n, base.z.n) && BN_copy(acc.t.n, base.t.n));
