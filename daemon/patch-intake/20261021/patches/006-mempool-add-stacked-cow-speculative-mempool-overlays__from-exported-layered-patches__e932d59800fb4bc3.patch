+
+MempoolOverlayLayer::MempoolOverlayLayer()
+    : base_mon_state_(GetInitialV2MonetaryState()) {
+    const auto [k0, k1] = DeriveEpochSipHashKey(parent_block_id_, layer_id_);
+    siphash_k0_ = k0;
+    siphash_k1_ = k1;
+}
+
+MempoolOverlayLayer::MempoolOverlayLayer(
+    const Hash &parent_block_id,
+    std::shared_ptr<const SmtNode> base_utxo_root,
+    const MonetaryState &base_mon_state,
+    uint64_t height,
+    uint64_t parent_mtp,
+    uint64_t layer_id) {
+    Reset(parent_block_id, std::move(base_utxo_root), base_mon_state, height,
+          parent_mtp, layer_id);
+}
+
+void MempoolOverlayLayer::Reset(const Hash &parent_block_id,
+                                std::shared_ptr<const SmtNode> base_utxo_root,
+                                const MonetaryState &base_mon_state,
+                                uint64_t height,
+                                uint64_t parent_mtp,
+                                uint64_t layer_id) {
+    layer_id_ = layer_id;
+    parent_block_id_ = parent_block_id;
+    height_ = height;
+    parent_mtp_ = parent_mtp;
+    base_mon_state_ = base_mon_state;
+
+    tx_arena_.Reset();
+    tx_root_idx_ = TxOverlayArena::kNullIdx;
+    utxo_arena_.Reset(std::move(base_utxo_root));
+    utxo_arena_dirty_ = false;
+    sum_non_cb_effective_cost_ = 0;
+    total_fees_sats_ = 0;
+    total_sigchecks_ = 0;
+    total_bytes_ = 0;
+    conflict_count_ = 0;
+    const auto [k0, k1] = DeriveEpochSipHashKey(parent_block_id_, layer_id_);
+    siphash_k0_ = k0;
+    siphash_k1_ = k1;
+    syndrome_ = BucketSyndrome{};
+
+    positional_merkle_dirty_ = true;
+    null_merkle_root_ = Hash{};
+    coinbase_merkle_branch_.clear();
+
+    active_txs_.clear();
+    created_coins_.clear();
+    spent_outpoints_.clear();
+}
+
+void MempoolOverlayLayer::EnsureUtxoArenaUpdated() const {
+    if (!utxo_arena_dirty_) {
+        return;
+    }
+    auto base_root = utxo_arena_.GetBaseSmtRoot();
+    utxo_arena_.Reset(std::move(base_root));
+    const auto erased = GetNetErasedOutpoints();
+    const auto inserted = GetNetInsertedCoins();
+    if (erased.size() + inserted.size() >= 16) {
+        utxo_arena_.BatchUpdateParallel(erased, inserted);
+    } else {
+        for (const auto &op : erased) {
+            utxo_arena_.EraseOutpoint(op);
+        }
+        for (const auto &coin : inserted) {
+            utxo_arena_.InsertCoin(coin);
+        }
+    }
+    utxo_arena_dirty_ = false;
+}
+
+Hash ComputeMerkleRootFromLeftSpine(const Hash &leaf0,
+                                    std::span<const Hash> branch) {
+    Hash cur = leaf0;
+    uint8_t pair_buf[64];
+    for (const Hash &sibling : branch) {
+        std::memcpy(pair_buf, cur.data(), 32);
+        std::memcpy(pair_buf + 32, sibling.data(), 32);
+        SHA256D64(cur.data(), pair_buf, 1);
+    }
+    return cur;
+}
+
+void MempoolOverlayLayer::EnsurePositionalMerkleUpdated() const {
+    if (!positional_merkle_dirty_) {
+        return;
+    }
+    coinbase_merkle_branch_.clear();
+    if (active_txs_.empty()) {
+        null_merkle_root_ = Hash{};
+        positional_merkle_dirty_ = false;
+        return;
+    }
+
+    std::vector<Hash> level;
+    level.reserve(active_txs_.size() + 1);
+    level.push_back(Hash{}); // Slot 0: null coinbase placeholder
+    for (const auto &[tx_id, _] : active_txs_) {
+        level.push_back(tx_id);
+    }
+
+    while (level.size() > 1) {
+        coinbase_merkle_branch_.push_back(level[1]);
+        if (level.size() & 1U) {
+            level.push_back(level.back());
+        }
+        const size_t pairs = level.size() / 2;
+        SHA256D64(level[0].data(), level[0].data(), pairs);
+        level.resize(pairs);
+    }
+    null_merkle_root_ = level[0];
+    positional_merkle_dirty_ = false;
+}
+
+Hash MempoolOverlayLayer::ComputePositionalMerkleRoot(
+    const Hash &coinbase_txid) const {
+    EnsurePositionalMerkleUpdated();
+    return ComputeMerkleRootFromLeftSpine(coinbase_txid,
+                                          coinbase_merkle_branch_);
+}
+
+bool MempoolOverlayLayer::Contains(const Hash &tx_id) const {
+    return active_txs_.find(tx_id) != active_txs_.end();
+}
+
+bool MempoolOverlayLayer::AddTransaction(
+    const Hash &tx_id,
+    const Hash &tx_hash,
+    uint64_t linear_cost,
+    const std::vector<Outpoint> &spent_outpoints,
+    const std::vector<Coin> &created_coins,
+    int64_t fee_sats,
+    int64_t sigchecks,
+    std::shared_ptr<const void> tx_ref) {
+    if (active_txs_.find(tx_id) != active_txs_.end()) {
+        return false;
+    }
+
+    const uint64_t eff_cost =
+        TransactionEffectiveCost(linear_cost, kDefaultMonetaryProfile);
+
+    tx_root_idx_ = tx_arena_.InsertTxLeaf(tx_root_idx_, tx_id, tx_hash);
+    sum_non_cb_effective_cost_ += eff_cost;
+    total_fees_sats_ += fee_sats;
+    total_sigchecks_ += sigchecks;
+    total_bytes_ += linear_cost;
+    syndrome_.Add(ComputeShortTxId(siphash_k0_, siphash_k1_, tx_id));
+    positional_merkle_dirty_ = true;
+
+    for (const auto &op : spent_outpoints) {
+        const uint32_t new_ref = ++spent_outpoints_[op];
+        if (new_ref == 2) {
+            ++conflict_count_;
+        }
+        if (commit_state_root_in_header_ && !utxo_arena_dirty_) {
+            if (new_ref == 1) {
+                utxo_arena_.EraseOutpoint(op);
+            }
+        } else {
+            utxo_arena_dirty_ = true;
+        }
+    }
+
+    for (const auto &coin : created_coins) {
+        created_coins_[coin.outpoint] = coin;
+        if (commit_state_root_in_header_ && !utxo_arena_dirty_) {
+            if (spent_outpoints_.find(coin.outpoint) == spent_outpoints_.end()) {
+                utxo_arena_.InsertCoin(coin);
+            }
+        } else {
+            utxo_arena_dirty_ = true;
+        }
+    }
+
+    OverlayTxEntry entry{};
+    entry.tx_id = tx_id;
+    entry.tx_hash = tx_hash;
+    entry.linear_cost = linear_cost;
+    entry.effective_cost = eff_cost;
+    entry.fee_sats = fee_sats;
+    entry.sigchecks = sigchecks;
+    entry.spent_outpoints = spent_outpoints;
+    entry.created_coins = created_coins;
+    entry.tx_ref = std::move(tx_ref);
+
+    active_txs_.emplace(tx_id, std::move(entry));
+    return true;
+}
+
+size_t MempoolOverlayLayer::AddTransactionBatch(
+    std::span<OverlayTxEntry> entries) {
+    if (entries.empty()) {
+        return 0;
+    }
+    if (entries.size() == 1) {
+        auto &e = entries[0];
+        return AddTransaction(e.tx_id, e.tx_hash, e.linear_cost,
+                              e.spent_outpoints, e.created_coins, e.fee_sats,
+                              e.sigchecks, std::move(e.tx_ref))
+                   ? 1
+                   : 0;
+    }
+
+    std::vector<std::pair<Hash, Hash>> tx_leaves;
+    tx_leaves.reserve(entries.size());
+
+    std::vector<Outpoint> newly_spent_ops;
+    newly_spent_ops.reserve(entries.size() * 2);
+
+    std::unordered_map<Outpoint, bool, OutpointHasher> batch_created_ops;
+    batch_created_ops.reserve(entries.size() * 2);
+
+    std::vector<Coin> batch_created_list;
+    batch_created_list.reserve(entries.size() * 2);
+
+    size_t added_count = 0;
+    for (auto &entry : entries) {
+        if (active_txs_.find(entry.tx_id) != active_txs_.end()) {
+            continue;
+        }
+        entry.effective_cost =
+            TransactionEffectiveCost(entry.linear_cost, kDefaultMonetaryProfile);
+        sum_non_cb_effective_cost_ += entry.effective_cost;
+        total_fees_sats_ += entry.fee_sats;
+        total_sigchecks_ += entry.sigchecks;
+        total_bytes_ += entry.linear_cost;
+        syndrome_.Add(ComputeShortTxId(siphash_k0_, siphash_k1_, entry.tx_id));
+        tx_leaves.emplace_back(entry.tx_id, entry.tx_hash);
+
+        for (const auto &op : entry.spent_outpoints) {
+            const uint32_t new_ref = ++spent_outpoints_[op];
+            if (new_ref == 1) {
+                newly_spent_ops.push_back(op);
+            } else if (new_ref == 2) {
+                ++conflict_count_;
+            }
+        }
+
+        for (const auto &coin : entry.created_coins) {
+            created_coins_[coin.outpoint] = coin;
+            if (commit_state_root_in_header_ && !utxo_arena_dirty_) {
+                batch_created_ops[coin.outpoint] = true;
+                batch_created_list.push_back(coin);
+            }
+        }
+
+        const Hash tx_id = entry.tx_id;
+        active_txs_.emplace(tx_id, std::move(entry));
+        ++added_count;
+    }
+
+    if (added_count == 0) {
+        return 0;
+    }
+
+    positional_merkle_dirty_ = true;
+
+    if (tx_leaves.size() >= 16) {
+        tx_root_idx_ = tx_arena_.InsertBatchParallel(tx_root_idx_, tx_leaves);
+    } else {
+        for (const auto &[tx_id, tx_hash] : tx_leaves) {
+            tx_root_idx_ = tx_arena_.InsertTxLeaf(tx_root_idx_, tx_id, tx_hash);
+        }
+    }
+
+    if (!commit_state_root_in_header_ || utxo_arena_dirty_) {
+        utxo_arena_dirty_ = true;
+        return added_count;
+    }
+
+    std::vector<Outpoint> erased_for_arena;
+    erased_for_arena.reserve(newly_spent_ops.size());
+    for (const auto &op : newly_spent_ops) {
+        if (batch_created_ops.find(op) == batch_created_ops.end()) {
+            erased_for_arena.push_back(op);
+        }
+    }
+
+    std::vector<Coin> inserted_for_arena;
+    inserted_for_arena.reserve(batch_created_list.size());
+    for (const auto &coin : batch_created_list) {
+        if (spent_outpoints_.find(coin.outpoint) == spent_outpoints_.end()) {
+            inserted_for_arena.push_back(coin);
+        }
+    }
+
+    if (erased_for_arena.size() + inserted_for_arena.size() >= 16) {
+        utxo_arena_.BatchUpdateParallel(erased_for_arena, inserted_for_arena);
+    } else {
+        for (const auto &op : erased_for_arena) {
+            utxo_arena_.EraseOutpoint(op);
+        }
+        for (const auto &coin : inserted_for_arena) {
+            utxo_arena_.InsertCoin(coin);
+        }
+    }
+
+    return added_count;
+}
+
+bool MempoolOverlayLayer::RemoveTransaction(const Hash &tx_id) {
+    auto it = active_txs_.find(tx_id);
+    if (it == active_txs_.end()) {
+        return false;
+    }
+
+    const OverlayTxEntry &entry = it->second;
+    tx_root_idx_ = tx_arena_.EraseTxLeaf(tx_root_idx_, tx_id);
+    assert(sum_non_cb_effective_cost_ >= entry.effective_cost);
+    sum_non_cb_effective_cost_ -= entry.effective_cost;
+    total_fees_sats_ -= entry.fee_sats;
+    total_sigchecks_ -= entry.sigchecks;
+    total_bytes_ = (total_bytes_ >= entry.linear_cost)
+                       ? (total_bytes_ - entry.linear_cost)
+                       : 0;
+    syndrome_.Remove(ComputeShortTxId(siphash_k0_, siphash_k1_, tx_id));
+    positional_merkle_dirty_ = true;
+
+    for (const auto &coin : entry.created_coins) {
+        created_coins_.erase(coin.outpoint);
+        if (commit_state_root_in_header_ && !utxo_arena_dirty_) {
+            if (spent_outpoints_.find(coin.outpoint) == spent_outpoints_.end()) {
+                utxo_arena_.EraseOutpoint(coin.outpoint);
+            }
+        } else {
+            utxo_arena_dirty_ = true;
+        }
+    }
+
+    for (const auto &op : entry.spent_outpoints) {
+        auto sp_it = spent_outpoints_.find(op);
+        if (sp_it != spent_outpoints_.end()) {
+            if (sp_it->second == 2) {
+                assert(conflict_count_ > 0);
+                --conflict_count_;
+            }
+            if (--sp_it->second == 0) {
+                spent_outpoints_.erase(sp_it);
+                if (commit_state_root_in_header_ && !utxo_arena_dirty_) {
+                    auto cr_it = created_coins_.find(op);
+                    if (cr_it != created_coins_.end()) {
+                        utxo_arena_.InsertCoin(cr_it->second);
+                    } else if (auto base_coin =
+                                   SmtFind(utxo_arena_.GetBaseSmtRoot(), op)) {
+                        utxo_arena_.InsertCoin(*base_coin);
+                    }
+                } else {
+                    utxo_arena_dirty_ = true;
+                }
+            }
+        }
+    }
+
+    active_txs_.erase(it);
+    return true;
+}
+
+std::vector<Outpoint> MempoolOverlayLayer::GetNetErasedOutpoints() const {
+    std::vector<Outpoint> erased;
+    erased.reserve(spent_outpoints_.size());
+    for (const auto &[op, count] : spent_outpoints_) {
+        if (count > 0 && created_coins_.find(op) == created_coins_.end()) {
+            erased.push_back(op);
+        }
+    }
+    std::sort(erased.begin(), erased.end(), OutpointLess{});
+    return erased;
+}
+
+std::vector<Coin> MempoolOverlayLayer::GetNetInsertedCoins() const {
+    std::vector<Coin> inserted;
+    inserted.reserve(created_coins_.size());
+    for (const auto &[op, coin] : created_coins_) {
+        if (spent_outpoints_.find(op) == spent_outpoints_.end()) {
+            inserted.push_back(coin);
+        }
+    }
+    std::sort(inserted.begin(), inserted.end(),
+              [](const Coin &a, const Coin &b) {
+                  return OutpointLess{}(a.outpoint, b.outpoint);
+              });
+    return inserted;
+}
