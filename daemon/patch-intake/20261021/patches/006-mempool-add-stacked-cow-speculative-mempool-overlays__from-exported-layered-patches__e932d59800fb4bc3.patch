+        BigInt g;
+        g.limbs = ShlMag({1}, (bits + 1) / 2);
+        for (;;) {
+            auto [q, rem] = DivModMag(x.limbs, g.limbs);
+            (void)rem;
+            Mag sum = AddMag(g.limbs, q);
+            Mag next = ShrMag(sum, 1);
+            if (CompareMag(next, g.limbs) >= 0) break;
+            g.limbs = std::move(next);
+        }
+        g.Normalize();
+        return g;
