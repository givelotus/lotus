+bool PreparedVmTransaction::Prepare(
+    const Transaction &tx, const TxProfile &profile, const ChainId &chain,
+    const ResolvedCoins &coins, const VmCostProfile &cost, std::string &error) {
+    return PrepareChecked(tx, profile, chain, coins, cost, error) ==
+           SigningPreparationStatus::Ready;
+}
+
+VmResult EvaluateVmImpl(std::span<const uint8_t> script,
+                        const std::vector<VmBytes> &arguments,
+                        const VmProfile &profile, uint16_t input_count,
+                        uint16_t output_count,
+                        const VmExecutionContext *context,
+                        const VmCostProfile *cost_profile,
+                        VmCostUnits *charged_cost,
+                        BatchSigCollector *batch_sigs) {
+    try {
+        if (!profile.max_script_bytes || !profile.max_element_bytes ||
+            profile.max_element_bytes > VM_HARD_ELEMENT_BYTES ||
+            !profile.max_stack_items || !profile.max_altstack_items ||
+            !profile.max_vm_bytes || !profile.max_ast_depth ||
+            !profile.max_steps)
+            throw VmFailure("invalid explicit VM profile",
+                            VmStatus::OperationalError);
+        if (script.size() > profile.max_script_bytes ||
+            arguments.size() > profile.max_arguments)
+            throw VmFailure("invocation framing limit");
+        size_t bytes = 0;
+        for (const auto &arg : arguments) {
+            if (arg.size() > profile.max_element_bytes ||
+                arg.size() > profile.max_vm_bytes - bytes)
+                throw VmFailure("argument byte limit");
+            bytes += arg.size();
+        }
+        if (arguments.size() > profile.max_stack_items)
+            throw VmFailure("argument count exceeds stack cap");
+
+        // Copy so a derived size cannot shrink a caller hint, and so the
+        // caller's profile is left unchanged. Charging below reads this copy.
+        std::optional<VmCostProfile> authenticated_cost;
+        if (context && context->prepared && !context->prepared->Owns(*context))
+            throw VmFailure("prepared transaction ownership mismatch",
+                            VmStatus::OperationalError);
+        const bool cached_cost = context && context->prepared &&
+            cost_profile == &context->prepared->Cost();
+        if (cached_cost) {
+            if (context->prepared->MaxFieldBound() > profile.max_element_bytes)
+                throw VmFailure("invalid field-size bound",
+                                VmStatus::OperationalError);
+        } else if (cost_profile) {
+            CheckCostProfile(*cost_profile, profile);
+        }
+        if (cost_profile && context &&
+            (!context->prepared || cost_profile != &context->prepared->Cost())) {
+            authenticated_cost = *cost_profile;
+            VM_COUNT_PREPARATION(field_sizes);
+            ApplyDerivedFieldSizes(*authenticated_cost, *context);
+            cost_profile = &*authenticated_cost;
+        }
+        VmCostProfile default_unit_cost;
+        if (!cost_profile) {
+            default_unit_cost.max_invocation_cost = ~VmCostUnits(0);
+            default_unit_cost.structural_byte_cost = 1;
+            for (auto &f : default_unit_cost.opcode) {
+                f = {1, 1, 1};
+            }
+        }
+        const VmCostProfile &exec_cost_profile =
+            cost_profile ? *cost_profile : default_unit_cost;
+        std::optional<PreparedSigningContext> local_signing;
+        const PreparedSigningContext *prepared_signing = nullptr;
+        if (context) {
+            if (context->input_index >= context->tx.inputs.size())
+                throw VmFailure("invocation input index",
+                                VmStatus::OperationalError);
+            const auto &input = context->tx.inputs[context->input_index];
+            if (input.flags == 3) {
+                if (!context->positive_delta ||
+                    arguments.size() >= profile.max_stack_items ||
+                    profile.max_element_bytes < 16 ||
+                    profile.max_vm_bytes - bytes < 16)
+                    throw VmFailure("mint initial stack bound");
+                UInt delta = 0;
+                for (size_t i = 0; i < 16; ++i)
+                    delta |= UInt((*context->positive_delta)[i]) << (8 * i);
+                if (delta == 0 || delta > (UInt(1) << 127) - 1)
+                    throw VmFailure("mint delta is not positive N");
+            }
+            if (context->witness_index >= input.witnesses.size())
+                throw VmFailure("invocation witness index",
+                                VmStatus::OperationalError);
+            const auto &witness = input.witnesses[context->witness_index];
+            if (!std::equal(script.begin(), script.end(),
+                            witness.script.begin(), witness.script.end()) ||
+                arguments != witness.arguments)
+                throw VmFailure("invocation bytes disagree with witness",
+                                VmStatus::OperationalError);
+            std::string error;
+            if (context->prepared) {
+                prepared_signing = &context->prepared->Signing();
+            } else {
+                local_signing.emplace();
+                VM_COUNT_PREPARATION(signing);
+                const auto preparation = PrepareSigningContextChecked(
+                    context->tx, context->tx_profile, context->chain_id,
+                    context->resolved, *local_signing, error);
+                if (preparation != SigningPreparationStatus::Ready)
+                    throw VmFailure(
+                        "invocation membership/context invalid",
+                        preparation == SigningPreparationStatus::InvalidWitness
+                            ? VmStatus::Invalid
+                            : VmStatus::OperationalError);
+                prepared_signing = &*local_signing;
+            }
+            Hash message;
+            if (!SigningMessage(*prepared_signing, context->input_index,
+                                context->witness_index, 0,
+                                context->positive_delta, message, error))
+                throw VmFailure("invocation membership/context invalid",
+                                VmStatus::OperationalError);
+        }
+        std::vector<Instruction> code;
+        code.reserve(8);
+        const VmCostUnits exec_structural =
+            RawMul(script.size(), exec_cost_profile.structural_byte_cost);
+        if (Scan(script, profile, code)) {
+            if (cost_profile) {
+                const auto cost =
+                    CostMul(script.size(), cost_profile->structural_byte_cost,
+                            *cost_profile);
+                if (cost > cost_profile->max_invocation_cost)
+                    throw VmFailure("static cost cap exceeded");
+                *charged_cost = cost;
+            }
+            return {VmStatus::AutomaticSuccess, {}, {}, exec_structural};
+        }
+        Structure(code, profile);
+        if (cost_profile) {
+            const auto structural =
+                CostMul(script.size(), cost_profile->structural_byte_cost,
+                        *cost_profile);
+            const auto instructions =
+                SizePass(code, profile, *cost_profile, script.size(),
+                         input_count, output_count,
+                         cached_cost ? context->prepared : nullptr)
+                    .Charge(
+                        arguments,
+                        context &&
+                            context->tx.inputs[context->input_index].flags ==
+                                3);
+            const auto cost = CostAdd(structural, instructions, *cost_profile);
+            if (cost > cost_profile->max_invocation_cost)
+                throw VmFailure("static cost cap exceeded");
+            *charged_cost = cost;
+        }
+        BatchSigCollector *target_sigs =
+            batch_sigs ? batch_sigs : (context ? context->batch_sigs : nullptr);
+        BatchSigCollector staged_sigs;
+        Machine machine(code, script, profile, exec_cost_profile, input_count,
+                        output_count, arguments, context, prepared_signing,
+                        target_sigs ? &staged_sigs : nullptr);
+        try {
+            auto final_stack = machine.Run();
+            if (target_sigs) {
+                target_sigs->Merge(std::move(staged_sigs));
+            }
+            const VmCostUnits executed =
+                RawAdd(exec_structural, machine.ExecutedCost());
+            return {VmStatus::Success, {}, std::move(final_stack), executed};
+        } catch (const VmFailure &failure) {
+            const VmCostUnits executed =
+                RawAdd(exec_structural, machine.ExecutedCost());
+            return {failure.status, failure.what(), {}, executed};
+        }
+    } catch (const VmFailure &failure) {
+        return {failure.status, failure.what(), {}};
+    } catch (const std::exception &failure) {
+        return {VmStatus::OperationalError, failure.what(), {}};
+    }
+}
+VmResult EvaluateVm(std::span<const uint8_t> script,
+                    const std::vector<VmBytes> &arguments,
+                    const VmProfile &profile, uint16_t input_count,
+                    uint16_t output_count, BatchSigCollector *batch_sigs) {
+    return EvaluateVmImpl(script, arguments, profile, input_count, output_count,
+                          nullptr, nullptr, nullptr, batch_sigs);
+}
+VmResult EvaluateVmWithContext(std::span<const uint8_t> script,
+                               const std::vector<VmBytes> &arguments,
+                               const VmProfile &profile,
+                               const VmExecutionContext &context,
+                               BatchSigCollector *batch_sigs) {
+    if (context.tx.inputs.size() > UINT16_MAX ||
+        context.tx.outputs.size() > UINT16_MAX)
+        return {VmStatus::Invalid, "transaction count width", {}};
+    return EvaluateVmImpl(
+        script, arguments, profile, uint16_t(context.tx.inputs.size()),
+        uint16_t(context.tx.outputs.size()), &context, nullptr, nullptr,
+        batch_sigs);
+}
+VmChargedResult EvaluateVmCharged(std::span<const uint8_t> script,
+                                  const std::vector<VmBytes> &arguments,
+                                  const VmProfile &profile,
+                                  const VmCostProfile &cost_profile,
+                                  uint16_t input_count, uint16_t output_count,
+                                  const VmExecutionContext *context,
+                                  BatchSigCollector *batch_sigs) {
+    if (context) {
+        if (context->tx.inputs.size() > UINT16_MAX ||
+            context->tx.outputs.size() > UINT16_MAX)
+            return {{VmStatus::Invalid, "transaction count width", {}},
+                    0,
+                    0,
+                    false};
+        input_count = uint16_t(context->tx.inputs.size());
+        output_count = uint16_t(context->tx.outputs.size());
+    }
+    VmCostUnits cost = 0;
+    auto invocation =
+        EvaluateVmImpl(script, arguments, profile, input_count, output_count,
+                       context, &cost_profile, &cost, batch_sigs);
+    return {std::move(invocation), cost, cost, cost != 0};
+}
+} // namespace lotus::v2
+
diff --git a/src/lotus_v2/vm.h b/src/lotus_v2/vm.h
new file mode 100644
index 0000000000..7290fda800
--- /dev/null
+++ b/src/lotus_v2/vm.h
@@ -0,0 +1,190 @@
+// Copyright (c) 2026 The Lotus developers
+// Candidate P03 execution core. This is not a consensus validation entrypoint:
+// callers still need authenticated witness context and P05 static accounting.
+#ifndef LOTUS_V2_VM_H
+#define LOTUS_V2_VM_H
+
+#include "signing.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace lotus::v2 {
+using VmBytes = std::vector<uint8_t>;
+// P05's immutable per-item bound; caller profiles may only tighten it.
+constexpr size_t VM_HARD_ELEMENT_BYTES = 8192;
+constexpr size_t VM_MIN_NUMERIC_BYTES = 16;
+constexpr size_t VM_MAX_NUMERIC_BYTES = 1024;
+constexpr size_t VM_MAX_MUL_BYTES = 2048;
+
+struct VmProfile {
+    size_t max_script_bytes;
+    size_t max_arguments;
+    size_t max_element_bytes;
+    size_t max_stack_items;
+    size_t max_altstack_items;
+    size_t max_vm_bytes;
+    size_t max_ast_depth;
+    size_t max_steps; // host-work guard; P05 cost is a separate obligation
+};
+
+// Candidate schedule is supplied explicitly. The coefficients must be
+// nonnegative and monotonically bound the selected primitive's work; no
+// mainnet schedule is selected here. All assigned bytes need positive base.
+using VmCostUnits = __uint128_t;
+
+enum class VmStatus {
+    Success,
+    AutomaticSuccess,
+    Invalid,
+    Unsupported,
+    OperationalError
+};
+struct VmResult {
+    VmStatus status = VmStatus::Invalid;
+    std::string error;
+    std::vector<VmBytes> final_stack;
+    VmCostUnits executed_cost = 0;
+};
+
+class PreparedVmTransaction;
+
+struct VmExecutionContext {
+    const Transaction &tx;
+    const TxProfile &tx_profile;
+    const ChainId &chain_id;
+    const ResolvedCoins &resolved;
+    size_t input_index;
+    size_t witness_index;
+    std::optional<PositiveDelta> positive_delta;
+    const PreparedVmTransaction *prepared = nullptr;
+    BatchSigCollector *batch_sigs = nullptr;
+};
+
+struct VmOpcodeCost {
+    uint64_t base = 0;
+    uint64_t per_operand_byte = 0;
+    uint64_t per_result_byte = 0;
+};
+struct VmCostProfile {
+    VmCostUnits max_invocation_cost = 0;
+    uint64_t structural_byte_cost = 0;
+    std::array<VmOpcodeCost, 256> opcode{};
+    // P05 field-size hints for db/dc/e6/e7. With an execution context, an
+    // absent vector is the serialized authenticated field; a caller vector
+    // may only be larger. Without a context, an absent vector uses
+    // MAX_ELEMENT_BYTES.
+    std::map<uint8_t, std::vector<size_t>> field_sizes;
+};
+// Same schedule checks used by charged execution; useful for rejecting a local
+// configuration before opening chainstate. Does not execute a program.
+bool ValidateVmCostProfile(const VmProfile &, const VmCostProfile &, std::string &);
+// Owns an immutable transaction/coin/cost snapshot, prepared once before all
+// invocations. Contexts must refer to this snapshot's exact objects; a cache
+// from another transaction or mutable caller objects is never trusted.
+#ifdef LOTUS_V2_VM_TEST_INSTRUMENTATION
+enum class VmCryptoFault {
+    None,
+    Digest,
+    P256Context,
+    P256Verify,
+    EdAllocation
+};
+void SetVmCryptoFault(VmCryptoFault);
+struct VmPreparationCounts { size_t signing = 0; size_t field_sizes = 0; };
+VmPreparationCounts VmPreparationWorkCounts();
+#endif
+
+class PreparedVmTransaction {
+public:
+    PreparedVmTransaction() = default;
+    // Invocation contexts borrow these members and this object. Keep their
+    // addresses stable for the complete lifetime of every borrowed context.
+    PreparedVmTransaction(const PreparedVmTransaction &) = delete;
+    PreparedVmTransaction &operator=(const PreparedVmTransaction &) = delete;
+    PreparedVmTransaction(PreparedVmTransaction &&) = delete;
+    PreparedVmTransaction &operator=(PreparedVmTransaction &&) = delete;
+    SigningPreparationStatus
+    PrepareChecked(const Transaction &, const TxProfile &, const ChainId &,
+                   const ResolvedCoins &, const VmCostProfile &, std::string &,
+                   const IdentityDigests *precomputed_identities = nullptr);
+    bool Prepare(const Transaction &, const TxProfile &, const ChainId &,
+                 const ResolvedCoins &, const VmCostProfile &, std::string &);
+    // Borrowed contexts are valid until this object is prepared again or
+    // destroyed; callers must finish all invocations before either event.
+    VmExecutionContext Invocation(size_t input, size_t witness,
+        std::optional<PositiveDelta> delta = std::nullopt,
+        BatchSigCollector *batch_sigs = nullptr) const {
+        return {tx_, profile_, chain_, coins_, input, witness, delta, this,
+                batch_sigs};
+    }
+    const VmCostProfile &Cost() const { return cost_; }
+    size_t MaxFieldBound(uint8_t op) const { return field_maxima_[op]; }
+    bool TryGetFieldSizeAt(uint8_t op, size_t idx, size_t &out_size) const;
+    size_t MaxFieldBound() const { return max_field_bound_; }
+    size_t MintCount() const { return mint_count_; }
+    const PreparedSigningContext &Signing() const { return signing_; }
+    bool Owns(const VmExecutionContext &context) const {
+        return ready_ && &context.tx == &tx_ && &context.tx_profile == &profile_ &&
+            &context.chain_id == &chain_ && &context.resolved == &coins_;
+    }
+private:
+    Transaction tx_;
+    TxProfile profile_{};
+    ChainId chain_{};
+    ResolvedCoins coins_;
+    VmCostProfile cost_;
+    PreparedSigningContext signing_;
+    std::array<size_t, 256> field_maxima_{};
+    size_t max_field_bound_ = 0;
+    size_t mint_count_ = 0;
+    bool ready_ = false;
+};
+
+struct VmChargedResult {
+    VmResult invocation;
+    VmCostUnits accounting_cost = 0;
+    VmCostUnits enforcement_cost = 0;
+    bool charged = false;
+};
+
+// `script` is exact revealed bytecode, `arguments` are already framed witness
+// arguments. The caller must authenticate branch membership and enforce all
+// transaction-wide bounds before invoking this standalone core.
+VmResult EvaluateVm(std::span<const uint8_t> script,
+                    const std::vector<VmBytes> &arguments,
+                    const VmProfile &profile, uint16_t input_count = 0,
+                    uint16_t output_count = 0,
+                    BatchSigCollector *batch_sigs = nullptr);
+
+// This overload authenticates the active script/arguments and selected-branch
+// membership before OP_SUCCESS scanning. It still requires P05 cost gating and
+// transaction-wide validation by the caller. It prepares a signing snapshot
+// once per invocation, then reuses it for every SIGHASH/CHECKSIG opcode.
+VmResult EvaluateVmWithContext(std::span<const uint8_t> script,
+                               const std::vector<VmBytes> &arguments,
+                               const VmProfile &profile,
+                               const VmExecutionContext &context,
+                               BatchSigCollector *batch_sigs = nullptr);
+
+// The genesis accounting/enforcement views currently coincide. This entrypoint
+// charges before executing ordinary bytecode and retains structural-only cost
+// for a genesis OP_SUCCESS invocation. It does not charge transaction-wide
+// resolution, hashing, state or monetary work (P05 L(tx) obligations).
+VmChargedResult EvaluateVmCharged(std::span<const uint8_t> script,
+                                  const std::vector<VmBytes> &arguments,
+                                  const VmProfile &profile,
+                                  const VmCostProfile &cost_profile,
+                                  uint16_t input_count = 0,
+                                  uint16_t output_count = 0,
+                                  const VmExecutionContext *context = nullptr,
+                                  BatchSigCollector *batch_sigs = nullptr);
+
+} // namespace lotus::v2
+#endif
+
diff --git a/src/lotus_v2/vm_cost.inc b/src/lotus_v2/vm_cost.inc
new file mode 100644
index 0000000000..394bb24734
--- /dev/null
+++ b/src/lotus_v2/vm_cost.inc
@@ -0,0 +1,733 @@
+// Included once inside vm.cpp's private namespace: the cost pass shares the
+// exact scanner/structured instruction boundaries used by execution.
+struct SizeState {
+    bool known = true;
+    std::vector<size_t> main;
+    std::vector<size_t> alt;
+};
+struct SizeCharge {
+    VmCostUnits cost = 0;
+    VmCostUnits worst = 0;
+    std::optional<SizeState> state;
+    std::array<std::optional<SizeState>, 3> exits;
+};
+SizeState UnknownSizes() {
+    return {false, {}, {}};
+}
+std::optional<SizeState> MergeSizes(const std::optional<SizeState> &a,
+                                    const std::optional<SizeState> &b) {
+    if (!a) return b;
+    if (!b) return a;
+    if (!a->known || !b->known || a->main.size() != b->main.size() ||
+        a->alt.size() != b->alt.size())
+        return UnknownSizes();
+    SizeState out = *a;
+    for (size_t i = 0; i < out.main.size(); ++i)
+        out.main[i] = std::max(out.main[i], b->main[i]);
+    for (size_t i = 0; i < out.alt.size(); ++i)
+        out.alt[i] = std::max(out.alt[i], b->alt[i]);
+    return out;
+}
+bool SameHeight(const SizeState &a, const SizeState &b) {
+    return a.known && b.known && a.main.size() == b.main.size() &&
+           a.alt.size() == b.alt.size();
+}
+VmCostUnits CostAdd(VmCostUnits a, VmCostUnits b,
+                    const VmCostProfile &profile) {
+    (void)profile;
+    VmCostUnits result;
+    if (__builtin_add_overflow(a, b, &result))
+        throw VmFailure("static cost u128 overflow");
+    return result;
+}
+VmCostUnits CostMul(VmCostUnits a, VmCostUnits b,
+                    const VmCostProfile &profile) {
+    (void)profile;
+    VmCostUnits result;
+    if (__builtin_mul_overflow(a, b, &result))
+        throw VmFailure("static cost u128 overflow");
+    return result;
+}
+VmCostUnits RawAdd(VmCostUnits a, VmCostUnits b) {
+    VmCostUnits result;
+    return __builtin_add_overflow(a, b, &result) ? ~VmCostUnits(0) : result;
+}
+VmCostUnits RawMul(VmCostUnits a, VmCostUnits b) {
+    VmCostUnits result;
+    return __builtin_mul_overflow(a, b, &result) ? ~VmCostUnits(0) : result;
+}
+VmCostUnits OpCost(uint8_t op, std::span<const size_t> operands,
+                   std::span<const size_t> results,
+                   const VmCostProfile &profile, bool enforce = true) {
+    const auto &formula = profile.opcode[op];
+    VmCostUnits cost = formula.base;
+    for (size_t bound : operands)
+        cost = enforce
+                   ? CostAdd(cost,
+                             CostMul(formula.per_operand_byte, bound, profile),
+                             profile)
+                   : RawAdd(cost, RawMul(formula.per_operand_byte, bound));
+    for (size_t bound : results)
+        cost = enforce
+                   ? CostAdd(cost,
+                             CostMul(formula.per_result_byte, bound, profile),
+                             profile)
+                   : RawAdd(cost, RawMul(formula.per_result_byte, bound));
+    return cost;
+}
+VmCostUnits WorstOpCost(uint8_t op, size_t limit,
+                        const VmCostProfile &profile) {
+    std::vector<size_t> operands(6, limit);
+    if (op == 0xa0 || op == 0xa1 || op == 0xa2 || op == 0xb2 || op == 0xb3 ||
+        op == 0xb4) {
+        const size_t max_limbs = std::max<size_t>(
+            1, (std::min<size_t>(limit, VM_MAX_NUMERIC_BYTES) + 15) / 16);
+        const size_t quad = max_limbs * max_limbs;
+        if (quad > 1) operands.push_back((quad - 1) * 16);
+    }
+    std::array<size_t, 4> results;
+    results.fill(limit);
+    return OpCost(op, operands, results, profile, false);
+}
+void CheckCostProfile(const VmCostProfile &cost, const VmProfile &vm_profile) {
+    if (!cost.max_invocation_cost || !cost.structural_byte_cost)
+        throw VmFailure("invalid explicit cost profile",
+                        VmStatus::OperationalError);
+    for (unsigned op = 0; op <= 255; ++op)
+        if (GenesisAssigned(uint8_t(op)) && !cost.opcode[op].base)
+            throw VmFailure("missing assigned opcode cost", true);
+    for (const auto &[op, sizes] : cost.field_sizes) {
+        if (op != 0xdb && op != 0xdc && op != 0xe6 && op != 0xe7 && op != 0xf0)
+            throw VmFailure("invalid field-size opcode",
+                            VmStatus::OperationalError);
+        for (size_t size : sizes)
+            if (size > vm_profile.max_element_bytes)
+                throw VmFailure("invalid field-size bound",
+                                VmStatus::OperationalError);
+    }
+}
+// Field-size hints lower static charges below MAX_ELEMENT_BYTES, so they must
+// never be smaller than the field the instruction can actually push. With an
+// execution context, check every non-empty hint against the authenticated
+// transaction outputs and resolved coins before charging. Indexed hints
+// (complete outputs) need one entry per output/input. Path hints are indexed
+// by path slot: the maximum must cover every path (non-constant selector),
+// and an in-range entry must cover that slot on every input or output.
+// Empty hints are ignored here; ApplyDerivedFieldSizes fills them.
+void CheckFieldSizesAgainstContext(const VmCostProfile &cost,
+                                   const VmExecutionContext &ctx) {
+    auto output_size = [](const Output &output) {
+        size_t size = 0;
+        std::string error;
+        if (!OutputSerializedSize(output, size, error))
+            throw VmFailure("field-size output encoding",
+                            VmStatus::OperationalError);
+        return size;
+    };
+    auto coin = [&](size_t i) -> const Output * {
+        return i < ctx.resolved.size() && ctx.resolved[i] ? &*ctx.resolved[i]
+                                                          : nullptr;
+    };
+    for (const auto &[op, sizes] : cost.field_sizes) {
+        if (sizes.empty() || op == 0xf0) continue; // f0 uses the script length
+        if (op == 0xe7 || op == 0xdc) {
+            const size_t count =
+                op == 0xe7 ? ctx.tx.outputs.size() : ctx.tx.inputs.size();
+            if (sizes.size() != count)
+                throw VmFailure("field-size hint count",
+                                VmStatus::OperationalError);
+            for (size_t i = 0; i < count; ++i) {
+                const Output *field =
+                    op == 0xe7 ? &ctx.tx.outputs[i] : coin(i);
+                if (field && sizes[i] < output_size(*field))
+                    throw VmFailure("field-size hint below authenticated field",
+                                    VmStatus::OperationalError);
+            }
+        } else {
+            const size_t widest =
+                *std::max_element(sizes.begin(), sizes.end());
+            auto too_small = [&](const Output &output) {
+                for (size_t slot = 0; slot < output.paths.size(); ++slot) {
+                    const size_t encoded = PathSerializedSize(output.paths[slot]);
+                    if (widest < encoded ||
+                        (slot < sizes.size() && sizes[slot] < encoded))
+                        return true;
+                }
+                return false;
+            };
+            if (op == 0xe6) {
+                for (const auto &output : ctx.tx.outputs)
+                    if (too_small(output))
+                        throw VmFailure(
+                            "field-size hint below authenticated field",
+                            VmStatus::OperationalError);
+            } else {
+                for (size_t i = 0; i < ctx.tx.inputs.size(); ++i)
+                    if (const Output *field = coin(i))
+                        if (too_small(*field))
+                            throw VmFailure(
+                                "field-size hint below authenticated field",
+                                VmStatus::OperationalError);
+            }
+        }
+    }
+}
+// Reject a caller hint below the authenticated field, then fill any absent
+// vector from that field. A larger hint is left in place and only overcharges.
+void ApplyDerivedFieldSizes(VmCostProfile &cost, const VmExecutionContext &ctx) {
+    CheckFieldSizesAgainstContext(cost, ctx);
+    std::map<uint8_t, std::vector<size_t>> derived;
+    std::string error;
+    if (!DeriveFieldSizes(ctx, derived, error))
+        throw VmFailure("field-size output encoding",
+                        VmStatus::OperationalError);
+    for (auto &[op, sizes] : derived) {
+        if (sizes.empty()) continue;
+        const auto found = cost.field_sizes.find(op);
+        if (found == cost.field_sizes.end() || found->second.empty())
+            cost.field_sizes[op] = std::move(sizes);
+    }
+}
+std::optional<Int> LiteralValue(const Instruction *previous) {
+    if (!previous) return std::nullopt;
+    const auto op = previous->op;
+    if ((op >= 1 && op <= 0x4c) && previous->data.size() == VM_MIN_NUMERIC_BYTES)
+        return Numeric(previous->data);
+    if (op == 0) return 0;
+    if (op == 0x4d) return -1;
+    if (op >= 0x4e && op <= 0x5d) return Int(op - 0x4d);
+    return std::nullopt;
+}
+
+class SizePass {
+    const std::vector<Instruction> &code;
+    const VmCostProfile &schedule;
+    const PreparedVmTransaction *prepared;
+    size_t script_length;
+    uint16_t input_count;
+    uint16_t output_count;
+    size_t limit;
+    VmCostUnits Worst(uint8_t op) const {
+        VmCostUnits cost = WorstOpCost(op, limit, schedule);
+        if (op == 0xc0 || op == 0xc1)
+            cost = CostAdd(cost, CostMul(
+                MerkleStepCost(std::nullopt),
+                op == 0xc0 ? 64 : std::min<size_t>(256, limit / 32),
+                schedule), schedule);
+        return cost;
+    }
+    VmCostUnits MerkleStepCost(std::optional<Int> selector) const {
+        // Tagged nodes include their domain prefix and marker; 96 bytes is a
+        // conservative bound for both branch and indexed-node preimages.
+        const std::array<size_t, 1> tagged{96}, pair{64};
+        const std::array<size_t, 1> digest{32};
+        const std::array<VmCostUnits, 4> cost{
+            OpCost(0xba, tagged, digest, schedule),
+            OpCost(0xba, pair, digest, schedule),
+            OpCost(0xb8, pair, digest, schedule),
+            OpCost(0xb9, pair, digest, schedule)};
+        if (selector && *selector >= 0 && *selector <= 3)
+            return cost[size_t(*selector)];
+        // The profile has no frozen ordering relation among its algorithms.
+        // Taking all four preserves a bound even for unusual draft schedules.
+        return *std::max_element(cost.begin(), cost.end());
+    }
+    struct TransferResult {
+        SizeState state;
+        VmCostUnits cost;
+    };
+    TransferResult Transfer(const Instruction &ins, SizeState state,
+                            const Instruction *previous) const {
+        const uint8_t op = ins.op;
+        if (!state.known) return {UnknownSizes(), Worst(op)};
