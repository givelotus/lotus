+            } else if (op == 0xbb || op == 0xbc) {
+                pop();
+                pop();
+                if (op == 0xbb) push(16);
+            } else if (op == 0xbd) {
+                pop();
+                pop();
+                pop();
+                pop();
+                push(16);
+            } else if (op == 0xdd) {
+                pop();
+                pop();
+                push(16);
