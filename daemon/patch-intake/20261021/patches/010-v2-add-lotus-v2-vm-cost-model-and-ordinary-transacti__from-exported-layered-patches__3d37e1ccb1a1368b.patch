+              .status == VmStatus::Invalid);
+
+    Input mint;
+    mint.flags = 3;
+    mint.sequence = UINT32_MAX;
+    mint.witnesses.push_back(BranchWitness{Hex("5e"), {}, {}});
+    mint.prev_txid = BranchLeaf(mint.witnesses[0].script);
+    tx.inputs.push_back(mint);
+    resolved.push_back(std::nullopt);
