+    check({1, 2, 1}, 0x7d, {1, 2, 1});
+    check({1, 2, 3, 2}, 0x7e, {2, 3, 1});
+    check({1, 2, 3}, 0x7f, {2, 3, 1});
+    check({1, 2}, 0x80, {2, 1});
