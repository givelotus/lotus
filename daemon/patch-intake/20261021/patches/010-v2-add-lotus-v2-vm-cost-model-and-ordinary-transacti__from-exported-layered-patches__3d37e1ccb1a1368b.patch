+# ---------------------------------------------------------------- integers
+U_BOUNDARY = (0, 1, 2, 3, (1 << 63), (1 << 64) - 1, 1 << 64, (1 << 64) + 1,
+              (1 << 127) - 1, 1 << 127, (1 << 127) + 1, U_MAX - 1, U_MAX)
