+#!/usr/bin/env python3
+"""Compare deterministic P03 core scripts with the independent Python VM.
+
+Usage: python3 differential.py PYTHON_REFERENCE_ROOT NATIVE_RUNNER
+The selected scripts avoid context-dependent opcodes and P05-only rejection.
+"""
+import random
+import subprocess
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(sys.argv[1]).resolve()))
+from lotus_v2_reference.vm import (  # noqa: E402
+    ASSIGNED, VMError, VMProfile, UnsupportedFeature, evaluate, number,
+)
+
+profile = VMProfile(512, 8, 128, 16, 8, 256, 8, 100000, 1,
+                    {op: 1 for op in ASSIGNED})
+runner = sys.argv[2]
+fixed = [
+    ("66615e4c", (), 0, 0), ("614e635e64", (), 0, 0),
+    ("5e4cfd", (), 0, 0), ("015e4e91", (), 0, 0),
+    ("0244", (), 0, 0), ("4cfd01005e", (), 0, 0),
+    ("4c015e5e", (), 0, 0), ("4cfd", (), 0, 0),
+    ("bd", (), 0, 0), ("0064", (), 0, 0),
+    ("616a64", (), 0, 0), ("676167646a", (), 0, 0),
+    ("6767676a6a6a", (), 0, 0),
+    ("4d4e9e00a6", (), 0, 0), ("00696a4e", (), 0, 0),
+    ("4e69614e6b646a4e", (), 0, 0),
+    ("677967794f6b6a666a4e", (), 1, 0),
+    ("4e7a91", (), 0, 0), ("4c004c00914e91", (), 0, 0),
+    ("006179634e64", (), 0, 0),
+    ("03616263b820ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad91", (), 0, 0),
+    ("03616263ba206437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d8591", (), 0, 0),
+    ("61", (number(2),), 0, 0), ("98", (number(2**127-1),), 0, 0),
+    ("4e4e", (), 0, 0), ("4e6b", (), 0, 0),
+    ("89026263920161924e", (b"abc", number(1)), 0, 0),
+]
+stack_cases = (
+    ((1, 2), 0x72, ()),
+    ((1, 2), 0x73, (1, 2, 1, 2)),
+    ((1, 2, 3), 0x74, (1, 2, 3, 1, 2, 3)),
+    ((1, 2, 3, 4), 0x75, (1, 2, 3, 4, 1, 2)),
+    ((1, 2, 3, 4, 5, 6), 0x76, (3, 4, 5, 6, 1, 2)),
+    ((1, 2, 3, 4), 0x77, (3, 4, 1, 2)),
+    ((1, 2), 0x78, (1, 2, 2)),
+    ((1, 2), 0x79, (1,)),
+    ((1, 2), 0x7a, (1, 2, 2)),
+    ((1, 2), 0x7b, (2,)),
+    ((1, 2), 0x7c, (1, 2, 1)),
+    ((1, 2, 1), 0x7d, (1, 2, 1)),
+    ((1, 2, 3, 2), 0x7e, (2, 3, 1)),
+    ((1, 2, 3), 0x7f, (2, 3, 1)),
+    ((1, 2), 0x80, (2, 1)),
+    ((1, 2), 0x81, (2, 1, 2)),
+)
+for initial, op, expected in stack_cases:
+    script = (bytes(0x4d + n for n in initial) + bytes((op,)) +
+              b"".join(bytes((0x4d + n, 0x92)) for n in reversed(expected)) +
+              b"\x4e")
+    fixed.append((script.hex(), (), 0, 0))
+rng = random.Random(0x1032026)
+# Generated scripts produce a Boolean from arithmetic or byte equality,
+# sometimes under one or two conditional frames.
+for _ in range(256):
+    a, b = rng.randrange(-12, 13), rng.randrange(-12, 13)
+    opcode = rng.choice([0x9e, 0x9f, 0xa0, 0xa1, 0xa2, 0xa3,
+                         0xa4, 0xa5, 0xa6, 0xa8, 0xa9, 0xaa,
+                         0xad, 0xae])
+    prefix = (bytes((0x10,)) + number(a) + bytes((0x10,)) + number(b) +
+              bytes((opcode,)))
+    if opcode in (0x9e, 0x9f, 0xa0, 0xa1, 0xa2, 0xa3, 0xad, 0xae):
+        # Convert arbitrary arithmetic result to canonical Boolean.
+        prefix += bytes((0x9d,))
+    if rng.getrandbits(1):
+        prefix += bytes((0x61, 0x4e, 0x63, 0x00, 0x64))
+    fixed.append((prefix.hex(), (), 0, 0))
+
+for _ in range(64):
+    x, lo, hi = (rng.randrange(-12, 13) for _ in range(3))
+    script = b"".join(bytes((0x10,)) + number(n) for n in (x, lo, hi))
+    fixed.append(((script + b"\xaf").hex(), (), 0, 0))
+
+for index, (script_hex, args, inputs, outputs) in enumerate(fixed):
+    try:
+        result = evaluate(bytes.fromhex(script_hex), args, profile,
+                          input_count=inputs, output_count=outputs)
+        expected = "A" if result.automatic else "S"
+    except UnsupportedFeature:
+        expected = "U"
+    except VMError:
+        expected = "I"
+    actual = subprocess.check_output(
+        [runner, script_hex, str(inputs), str(outputs), *(arg.hex() for arg in args)],
+        text=True).strip()
+    if actual != expected:
+        raise SystemExit(f"case {index} {script_hex}: Python {expected}, native {actual}")
+print(f"{len(fixed)} Python/native P03 core cases agree")
diff --git a/src/lotus_v2/vm_test/differential_bytes.py b/src/lotus_v2/vm_test/differential_bytes.py
new file mode 100644
index 0000000000..408e3536fc
--- /dev/null
+++ b/src/lotus_v2/vm_test/differential_bytes.py
@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""Independent Python byte-operation oracle for the native P03 VM runner.
+
+Usage: python3 differential_bytes.py NATIVE_RUNNER
+Only test data and expected outputs are generated here; no reference VM code
+is imported. The native script compares every output item byte-for-byte.
+"""
+
+import random
+import subprocess
+import sys
+
+runner = sys.argv[1]
+rng = random.Random(0xB17E2026)
+
+
+def number(value):
+    return value.to_bytes(16, "little", signed=True)
+
+
+def min_signed_width(value):
+    if value == 0:
+        return 1
+    raw = value.to_bytes((value.bit_length() + 8) // 8, "little", signed=True)
+    w = len(raw)
+    while w > 1:
+        top = raw[w - 1]
+        prev = raw[w - 2]
+        if (top == 0x00 and (prev & 0x80) == 0) or (top == 0xff and (prev & 0x80) != 0):
+            w -= 1
+        else:
+            break
+    return w
+
+
+def bin2num_expected(value):
+    if len(value) > 1024:
+        return None
+    v = int.from_bytes(value, "little", signed=True) if value else 0
+    w = max(16, min_signed_width(v))
+    return (v.to_bytes(w, "little", signed=True),)
+
+
+def push(data):
+    if not data:
+        return b"\x4c\x00"
+    if len(data) <= 75:
+        return bytes((len(data),)) + data
+    if len(data) < 0xfd:
+        return b"\x4c" + bytes((len(data),)) + data
+    return b"\x4c\xfd" + len(data).to_bytes(2, "little") + data
+
+
+def check(op, arguments, expected, *, bigint=False):
+    script = bytes((op,))
+    status = "I" if expected is None else "S"
+    if expected is not None:
+        for item in reversed(expected):
+            script += push(item) + b"\x92"
+        script += b"\x4e"
+    cmd = [runner]
+    if bigint:
+        cmd.append("--bigint")
+    cmd.extend([script.hex(), "0", "0", *(arg.hex() for arg in arguments)])
+    output = subprocess.check_output(cmd, text=True).strip()
+    if output != status:
+        raise SystemExit(f"{op:02x} {arguments!r}: expected {status}, got {output}")
+
+
+count = 0
+for _ in range(100):
+    value = rng.randbytes(rng.randrange(0, 65))
+    index = rng.randrange(-2, len(value) + 3)
+    check(0x89, (value, number(index)),
+          (value[:index], value[index:]) if 0 <= index <= len(value) else None)
+    count += 1
+
+for _ in range(100):
+    value = rng.choice((rng.randrange(-(1 << 16), 1 << 16),
+                        -(1 << 127), (1 << 127) - 1))
+    width = rng.randrange(0, 21)
+    try:
+        encoded = value.to_bytes(width, "little", signed=True)
+    except OverflowError:
+        encoded = None
+    check(0x8a, (number(value), number(width)),
+          (encoded,) if encoded is not None else None)
+    count += 1
+
+for _ in range(100):
+    value = rng.randbytes(rng.randrange(0, 33))
+    check(0x8b, (value,), bin2num_expected(value))
+    count += 1
+
+for _ in range(100):
+    a = rng.randbytes(rng.randrange(0, 33))
+    b = rng.randbytes(rng.randrange(0, 33))
+    check(0x8d, (a,), (bytes(byte ^ 255 for byte in a),))
+    w = max(len(a), len(b))
+    pa = a.ljust(w, b"\x00")
+    pb = b.ljust(w, b"\x00")
+    for op in (0x8e, 0x8f, 0x90):
+        function = {0x8e: lambda x, y: x & y,
+                    0x8f: lambda x, y: x | y,
+                    0x90: lambda x, y: x ^ y}[op]
+        expected = (bytes(function(x, y) for x, y in zip(pa, pb)),)
+        check(op, (a, b), expected)
+    lower, higher = sorted((a, b), key=lambda data: (int.from_bytes(data, "little"), len(data)))
+    check(0x93, (a, b), (lower, higher))
+    count += 5
+
+for _ in range(100):
+    data = rng.randbytes(rng.randrange(0, 33))
+    shift = rng.choice((rng.randrange(-300, 301), -(1 << 127)))
+    bits = len(data) * 8
+    value = int.from_bytes(data, "little")
+    moved = ((value << shift) & ((1 << bits) - 1)) if shift >= 0 else value >> -shift
+    expected = moved.to_bytes(len(data), "little")
+    check(0x94, (data, number(shift)), (expected,))
+    count += 1
+
+# Wide / SIMD / 1024-byte byte-operation and zero-padding vectors
+for w_a, w_b in ((16, 32), (32, 16), (17, 64), (64, 256), (256, 512), (512, 1024), (1024, 1024)):
+    a = rng.randbytes(w_a)
+    b = rng.randbytes(w_b)
+    check(0x8d, (a,), (bytes(byte ^ 255 for byte in a),), bigint=True)
+    w = max(len(a), len(b))
+    pa = a.ljust(w, b"\x00")
+    pb = b.ljust(w, b"\x00")
+    check(0x8e, (a, b), (bytes(x & y for x, y in zip(pa, pb)),), bigint=True)
+    check(0x8f, (a, b), (bytes(x | y for x, y in zip(pa, pb)),), bigint=True)
+    check(0x90, (a, b), (bytes(x ^ y for x, y in zip(pa, pb)),), bigint=True)
+    check(0x8b, (a,), bin2num_expected(a), bigint=True)
+    count += 5
+check(0x8b, (b"\x00" * 1025,), None, bigint=True)
+count += 1
+
+print(f"{count} independent byte-operation vectors agree with native VM")
