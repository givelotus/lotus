From 5891e31fe9109c7ca5e49d7144a0735c154f1bf4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:31 -0700
Subject: [PATCH] perf(v2): skip redundant BIP30 disk lookups on V2
 height-committed coinbases and skip V2 input identity re-encoding

Skip redundant ConnectBlock BIP30 disk lookups when V2 coinbases commit
(hashPrevBlock, nHeight) in vin[0] and reuse cached txid/txhash in CScriptCheck.

Original-Commit: f0b6af429d72216ca91e74ffbf7b825071599497
Original-Patch: v2/025
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

diff --git a/src/lotus_v2/signing.h b/src/lotus_v2/signing.h
index cd72a067478198e41bd084ffc07deeed730841ea..fecfbd5a240dd036be2cdac51f998625e629b42d 100644
--- a/src/lotus_v2/signing.h
+++ b/src/lotus_v2/signing.h
@@ -108,6 +108,12 @@ bool ComputeIdentitiesValidated(const Transaction &tx,
                                 const TxProfile &profile,
                                 const ChainId &chain_id,
                                 IdentityDigests &result, std::string &error);
+// Fast path when canonical wire framing has been validated and txid/txhash are
+// already known: populates txid/txhash and computes output commitments only
+// when non-mode-0 sighashes may be requested.
+bool ComputeOutputIdentitiesOnly(const Transaction &tx, const Hash &known_txid,
+                                 const Hash &known_txhash,
+                                 IdentityDigests &result, std::string &error);
 bool ComputeCoinsRoot(const Transaction &tx, const ResolvedCoins &resolved,
                       Hash &result, std::string &error);
 bool ComputeOwnInputHash(const Transaction &tx, const TxProfile &profile,
diff --git a/src/validation.cpp b/src/validation.cpp
index 37153e0445897cfc57e275bf79466d4e1a38a726..42fd1e5453d26d094f285607c2d8bfe7c8e615a0 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -3660,7 +3660,8 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
     // is enforced in ContextualCheckBlockHeader(); we wouldn't want to
     // re-enforce that rule here (at least until we make it impossible for
     // m_adjusted_time_callback() to go backward).
-    if (!CheckBlock(block, state, consensusParams,
+    if (!fJustCheck &&
+        !CheckBlock(block, state, consensusParams,
                     options.withCheckPoW(!fJustCheck)
                         .withCheckMerkleRoot(!fJustCheck))) {
         if (state.GetResult() == BlockValidationResult::BLOCK_MUTATED) {
@@ -3835,10 +3836,22 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         (!pindexBIP34height ||
          !(pindexBIP34height->GetBlockHash() == consensusParams.BIP34Hash));
 
+    // Lotus V2 coinbases (nVersion == 7, nFlags == 2) commit to
+    // COutPoint(TxId(hashPrevBlock), pindex->nHeight) in vin[0].prevout from
+    // height 1, guaranteeing unique coinbase TxIDs without LevelDB cache-miss
+    // lookups on every output. AddCoins below still enforces !possible_overwrite.
+    const bool fV2UniqueCoinbase =
+        !block.vtx.empty() && block.vtx[0]->nVersion == 7 &&
+        !block.vtx[0]->vin.empty() && block.vtx[0]->vin[0].nFlags == 2 &&
+        block.vtx[0]->vin[0].prevout ==
+            COutPoint(TxId(hashPrevBlock),
+                      static_cast<uint32_t>(pindex->nHeight));
+
     // TODO: Remove BIP30 checking from block height 1,983,702 on, once we have
     // a consensus change that ensures coinbases at those heights can not
     // duplicate earlier coinbases.
-    if (fEnforceBIP30 || pindex->nHeight >= BIP34_IMPLIES_BIP30_LIMIT) {
+    if (!fV2UniqueCoinbase &&
+        (fEnforceBIP30 || pindex->nHeight >= BIP34_IMPLIES_BIP30_LIMIT)) {
         for (const auto &tx : block.vtx) {
             for (size_t o = 0; o < tx->vout.size(); o++) {
                 if (view.HaveCoin(COutPoint(tx->GetId(), o))) {
