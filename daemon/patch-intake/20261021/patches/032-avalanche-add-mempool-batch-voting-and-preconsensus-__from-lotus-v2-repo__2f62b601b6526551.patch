+        )
+
+    def batch_id(self) -> int:
+        key = b"lotus.v2.preconsensus.batch".ljust(32, b"\x00")
+        return uint256_from_str(blake3_keyed_single_chunk(key, self.serialize()))
+
+    def __repr__(self):
