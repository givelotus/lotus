+            + self.epoch_seq.to_bytes(4, "little")
+            + ser_uint256(self.parent_batch_id)
+            + ser_uint256(self.subtree_a_root)
+            + ser_uint256(self.utxo_root)
+            + self.tx_count.to_bytes(4, "little")
