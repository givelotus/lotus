+double Processor::AdaptiveEpochController::rttFloorLocked() const {
+    AssertLockHeld(m_cs);
+    std::vector<double> samples;
+    for (const auto &[_, rtt] : m_peerRtts) {
+        samples.push_back(rtt);
+    }
+    if (samples.empty()) {
+        return m_minWindowMs;
+    }
+    std::sort(samples.begin(), samples.end());
+    const size_t index = (9 * samples.size() + 9) / 10 - 1;
+    return std::clamp(samples[index], m_minWindowMs, 1000.0);
+}
+
 void Processor::AdaptiveEpochController::recordPollRtt(
-    std::chrono::milliseconds rtt) {
-    recordPollRttMs(static_cast<double>(rtt.count()));
