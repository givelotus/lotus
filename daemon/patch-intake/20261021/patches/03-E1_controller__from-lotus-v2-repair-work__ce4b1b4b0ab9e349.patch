+BOOST_AUTO_TEST_CASE(epoch_controller_population_p90_and_memory_cap) {
+    avalanche::Processor::AdaptiveEpochController ctrl;
+    const SteadyMilliseconds start{std::chrono::milliseconds{1000}};
+    ctrl.recordBatchFrozen(start);
+    BOOST_CHECK(!ctrl.shouldPipelineNextBatch(1, start + std::chrono::milliseconds{99}));
+    BOOST_CHECK(ctrl.shouldPipelineNextBatch(1, start + std::chrono::milliseconds{100}));
+    BOOST_CHECK(!ctrl.shouldPipelineNextBatch(0, start + std::chrono::seconds{1}));
+    BOOST_CHECK(ctrl.shouldPipelineNextBatch(10000, start));
+    for (NodeId peer = 0; peer < 10; ++peer) {
+        ctrl.recordPollRttMs(peer >= 8 ? 240.0 : 2.0, peer);
+    }
+    for (int sample = 0; sample < 100; ++sample) {
+        ctrl.recordPollRttMs(1.0, 0);
+    }
+    BOOST_CHECK_EQUAL(ctrl.getRttP90Ms(), 240.0);
+    BOOST_CHECK(!ctrl.shouldPipelineNextBatch(1, start + std::chrono::milliseconds{239}));
+    BOOST_CHECK(ctrl.shouldPipelineNextBatch(1, start + std::chrono::milliseconds{240}));
+    for (int i = 0; i < 10; ++i) ctrl.recordMissOrConflict();
+    BOOST_CHECK_EQUAL(ctrl.getSettlingWindowMs(), 1000.0);
+    ctrl.removePeer(8);
+    ctrl.removePeer(9);
+    for (int i = 0; i < 50; ++i) ctrl.recordCleanFastPath();
+    BOOST_CHECK_EQUAL(ctrl.getSettlingWindowMs(), 100.0);
+    BOOST_CHECK_EQUAL(ctrl.getFreezeCount(), 1U);
+}
