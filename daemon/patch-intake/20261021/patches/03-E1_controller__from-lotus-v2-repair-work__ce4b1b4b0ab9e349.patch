-            (1.0 - m_ewmaAlpha) * m_rttEwmaMs + m_ewmaAlpha * clampedRtt;
-        if (m_settlingWindowMs < m_rttEwmaMs) {
-            m_settlingWindowMs = m_rttEwmaMs;
-        }
+void Processor::AdaptiveEpochController::recordPollRttMs(double rttMs, NodeId peer) {
+    if (!std::isfinite(rttMs) || rttMs < 0.0) {
+        return;
     }
+    LOCK(m_cs);
+    const double clampedRtt = std::clamp(rttMs, 0.1, 1000.0);
+    m_rttEwmaMs = m_rttSampleCount == 0 ? clampedRtt :
+        (1.0 - m_ewmaAlpha) * m_rttEwmaMs + m_ewmaAlpha * clampedRtt;
+    // One observation per connected peer, so a frequently polled fast peer
+    // does not dominate the population percentile. Bound unsolicited state.
+    if (!m_peerRtts.count(peer) && m_peerRtts.size() >= 256) {
+        m_peerRtts.erase(m_peerRtts.begin());
+    }
+    m_peerRtts[peer] = clampedRtt;
+    m_settlingWindowMs = std::max(m_settlingWindowMs, rttFloorLocked());
     ++m_rttSampleCount;
 }
 
+void Processor::AdaptiveEpochController::removePeer(NodeId peer) {
+    LOCK(m_cs);
+    m_peerRtts.erase(peer);
+}
+
+void Processor::AdaptiveEpochController::setMinWindowMs(double ms) {
+    LOCK(m_cs);
+    m_minWindowMs = std::isfinite(ms) ? std::clamp(ms, 1.0, 1000.0) : 100.0;
+    m_settlingWindowMs = std::clamp(m_settlingWindowMs, rttFloorLocked(), 1000.0);
+}
+
+double Processor::AdaptiveEpochController::getRttP90Ms() const {
+    LOCK(m_cs);
+    return rttFloorLocked();
+}
+
+uint64_t Processor::AdaptiveEpochController::getFreezeCount() const {
+    LOCK(m_cs);
+    return m_freezeCount;
+}
+
+double Processor::AdaptiveEpochController::getFreezeRateHz() const {
+    LOCK(m_cs);
+    const auto elapsed = (Now<SteadyMilliseconds>() - m_createdAt).count();
+    return elapsed > 0 ? 1000.0 * m_freezeCount / elapsed : 0.0;
+}
+
