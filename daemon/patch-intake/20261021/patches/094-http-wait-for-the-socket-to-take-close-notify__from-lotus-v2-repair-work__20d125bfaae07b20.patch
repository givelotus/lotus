From 0df6462ff4a15151f4535eaaa07d896636a1dee9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 21:15:10 -0700
Subject: [PATCH] http: wait for the socket to take close_notify

After the last HTTPS response the server made one non-blocking
SSL_shutdown. With the send buffer still full of response data that
attempt fails and no close_notify is sent: the client sees a bare FIN,
a truncated close. OsslStream::async_shutdown waits for writability
like the other operations, bounded by a 5 s deadline.

Found as a hang of ossl_stream_reads_gathers_and_retries on Linux,
whose client waits for close_notify after draining 3 MiB through a
16 KiB send buffer.

diff --git a/src/http_tls_stream.h b/src/http_tls_stream.h
index cfd8e615ca..a766d7ca7a 100644
--- a/src/http_tls_stream.h
+++ b/src/http_tls_stream.h
@@ -118,7 +118,21 @@ public:
                         std::forward<Token>(token), /*zero_is_eof=*/false);
     }
 
-    /** Send close_notify once (not waiting for the peer's) */
+    /**
+     * Send close_notify, waiting for the socket to take it (not for the
+     * peer's). Completes with an error if the session was released.
+     */
+    template <typename Token> auto async_shutdown(Token &&token) {
+        return Run<int>(
+            [this]() {
+                // 0: our close_notify is sent; the peer's is not awaited.
+                const int r{SSL_shutdown(m_ssl.get())};
+                return r == 0 ? 1 : r;
+            },
+            std::forward<Token>(token), /*zero_is_eof=*/false);
+    }
+
+    /** Send close_notify once, without waiting (not for the peer's) */
     void shutdown(boost::system::error_code &ec) {
         ec = {};
         if (m_ssl) {
diff --git a/src/httpserver.cpp b/src/httpserver.cpp
index 711aab8bf3..6ed7a1f12a 100644
--- a/src/httpserver.cpp
+++ b/src/httpserver.cpp
@@ -316,6 +316,8 @@ static Config *g_config{nullptr};
 static uint64_t g_max_body_size{MIN_SUPPORTED_BODY_SIZE};
 //! Idle/read/write timeout
 static std::chrono::seconds g_server_timeout{DEFAULT_HTTP_SERVER_TIMEOUT};
+//! How long a TLS connection may take to accept our close_notify
+static constexpr std::chrono::seconds CLOSE_NOTIFY_TIMEOUT{5};
 //! Set by InterruptHTTPServer: reject new requests with 503
 static std::atomic<bool> g_reject_requests{false};
 //! List of subnets to allow RPC connections from
@@ -1350,8 +1352,24 @@ static asio::awaitable<void> HandleConnection(tcp::socket socket,
                         }
                     }
                     co_await ServeHTTP(tls_stream, buffer, conn);
-                    tls_stream.shutdown(ec);
-                    sock.shutdown(tcp::socket::shutdown_send, ec);
+                    if (tls_stream.native_handle()) {
+                        // Not handed off: close_notify after the last
+                        // response, even if the send buffer is full now
+                        // (a single attempt could drop it, which reads as a
+                        // truncated close). Bounded like the handshake.
+                        deadline.expires_after(CLOSE_NOTIFY_TIMEOUT);
+                        deadline.async_wait(
+                            [fd = sock.native_handle()](
+                                const boost::system::error_code &wec) {
+                                if (!wec) {
+                                    ::shutdown(fd, SHUT_RDWR);
+                                }
+                            });
+                        co_await tls_stream.async_shutdown(
+                            asio::as_tuple(asio::use_awaitable));
+                        deadline.cancel();
+                        sock.shutdown(tcp::socket::shutdown_send, ec);
+                    }
                 }
             }
         }
diff --git a/src/test/httpserver_tests.cpp b/src/test/httpserver_tests.cpp
index b10ec538b6..8f6b563315 100644
--- a/src/test/httpserver_tests.cpp
+++ b/src/test/httpserver_tests.cpp
@@ -229,9 +229,11 @@ BOOST_AUTO_TEST_CASE(ossl_stream_reads_gathers_and_retries) {
                     sent += n;
                 }
             }
-            boost::system::error_code ec;
-            stream.shutdown(ec);
-            co_return blocked;
+            // close_notify must get out even though the client is still
+            // draining a full socket.
+            auto [sec, s] = co_await stream.async_shutdown(
+                asio::as_tuple(asio::use_awaitable));
+            co_return blocked && !sec;
         },
         asio::use_future)};
     io.run();
