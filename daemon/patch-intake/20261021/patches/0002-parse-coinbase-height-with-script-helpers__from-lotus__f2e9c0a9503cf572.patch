From 1635dba95787d567c9514dbbdf39657339f641b2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 09:43:50 -0700
Subject: [PATCH] consensus: separately gate script parsing of coinbase height
 commitments

The historical parser treats each opcode as a raw byte length and reads at
most three unsigned little-endian height bytes. This rejects valid data
pushes using PUSHDATA1/2/4 and CScript's signed-number serialization once
the third byte's sign bit is set (height 8388608), plus later four-byte
heights. Use GetOp and Lotus CScriptNum for the upgraded parser, including
small integer opcodes and an int64 comparison without narrowing.

Keep this encoding change separate from the vanity-prefix early-return
repair. Add independent coinbaseHeightParserActivationHeight with an
explicitly disabled INT_MAX sentinel; no network activation is selected.
Before activation, select the existing parser unchanged. After activation,
require OP_RETURN, an arbitrary data prefix (still logos below 1018000),
and the actual height. Allow nonminimal encodings and trailing data.

This changes the accepted block set in both directions: PUSHDATA/numeric
forms are added, while the old unsigned high-bit three-byte representation
is no longer a positive script number. It requires coordinated consensus
upgrade review, not an unannounced soft-fork bugfix deployment.

Validation: identical native TestBlockValidity parser regressions fail nine
assertions before the change and pass afterward. All 14 cases across
validation_block_tests, miner_tests, txvalidation_tests and
 txvalidationcache_tests pass. Covers FRBTC/logos, PUSHDATA1/2/4, missing,
wrong, truncated, negative and overflowing heights, small integer opcodes,
8388608, four-byte and INT_MAX bounds, and disabled/preactivation behavior.

Depends on: cc2dc566b4472efaf762a93e0a8cb5222d122798
---
 src/consensus/params.h              |   3 +
 src/test/validation_block_tests.cpp | 101 ++++++++++++++++++++++++++++
 src/validation.cpp                  |  46 ++++++++++++-
 3 files changed, 149 insertions(+), 1 deletion(-)

diff --git a/src/consensus/params.h b/src/consensus/params.h
index b940a65185..d46a44ecc7 100644
--- a/src/consensus/params.h
+++ b/src/consensus/params.h
@@ -54,6 +54,9 @@ struct Params {
     // bypass.
     int coinbaseHeightValidationActivationHeight =
         std::numeric_limits<int>::max();
+    // Independently gated parser upgrade: changes the accepted commitment
+    // encodings.
+    int coinbaseHeightParserActivationHeight = std::numeric_limits<int>::max();
 
     BlockHash hashGenesisBlock;
     int nSubsidyHalvingInterval;
diff --git a/src/test/validation_block_tests.cpp b/src/test/validation_block_tests.cpp
index b43b4283f5..f23c9c8e58 100644
--- a/src/test/validation_block_tests.cpp
+++ b/src/test/validation_block_tests.cpp
@@ -113,6 +113,107 @@ BOOST_AUTO_TEST_CASE(coinbase_vanity_height_commitment) {
     tip->nHeight = saved_height;
 }
 
+BOOST_AUTO_TEST_CASE(coinbase_height_script_parser) {
+    const Config &config = m_node.chainman->GetConfig();
+    auto &chainstate = m_node.chainman->ActiveChainstate();
+    LOCK(cs_main);
+    auto *tip = chainstate.m_chain.Tip();
+    auto &params =
+        const_cast<Consensus::Params &>(m_node.chainman->GetConsensus());
+    const int saved_height = tip->nHeight;
+    const int saved_activation =
+        params.coinbaseHeightValidationActivationHeight;
+    const int saved_parser = params.coinbaseHeightParserActivationHeight;
+    auto block = Block(config, tip->GetBlockHash(), 1);
+    const std::vector<uint8_t> vanity{'F', 'R', 'B', 'T', 'C'};
+    const auto check = [&](const CScript &script, int height, bool expected) {
+        tip->nHeight = height - 1;
+        block->nHeight = height;
+        block->hashEpochBlock = height % EPOCH_NUM_BLOCKS == 0
+                                    ? tip->GetBlockHash()
+                                    : tip->hashEpochBlock;
+        CMutableTransaction coinbase(*block->vtx[0]);
+        coinbase.vout[0].scriptPubKey = script;
+        block->vtx[0] = MakeTransactionRef(coinbase);
+        block->SetSize(::GetSerializeSize(*block));
+        BlockValidationState state;
+        const bool valid = TestBlockValidity(
+            state, config.GetChainParams(), chainstate, *block, tip,
+            [] { return NodeClock::now(); },
+            BlockValidationOptions(config)
+                .withCheckPoW(false)
+                .withCheckMerkleRoot(false));
+        BOOST_CHECK_MESSAGE(valid == expected,
+                            "height " << height << ": " << state.ToString());
+        if (!expected)
+            BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-cb-height");
+    };
+    const int height = 1401000;
+    params.coinbaseHeightValidationActivationHeight = 1;
+    params.coinbaseHeightParserActivationHeight = 1;
+    check(CScript() << OP_RETURN << vanity << height, height, true);
+    check(CScript() << OP_RETURN << COINBASE_PREFIX << height, height, true);
+    check(CScript() << OP_RETURN << vanity, height, false);
+    check(CScript() << OP_RETURN << vanity << (height - 1), height, false);
+    check(CScript() << OP_RETURN << vanity << -1, height, false);
+    check(CScript() << OP_RETURN << vanity << std::vector<uint8_t>(6, 1),
+          height, false);
+    check(CScript() << OP_RETURN << vanity
+                    << std::vector<uint8_t>{0xa8, 0x60, 0x15, 0},
+          height, true);
+    check(CScript() << OP_RETURN << vanity << height << OP_NOP, height, true);
+    for (const auto opcode : {OP_PUSHDATA1, OP_PUSHDATA2, OP_PUSHDATA4}) {
+        CScript script;
+        script << OP_RETURN;
+        script.push_back(opcode);
+        script.push_back(5);
+        if (opcode >= OP_PUSHDATA2) script.push_back(0);
+        if (opcode == OP_PUSHDATA4) {
+            script.push_back(0);
+            script.push_back(0);
+        }
+        script.insert(script.end(), vanity.begin(), vanity.end());
+        script << height;
+        check(script, height, true);
+        script.pop_back();
+        check(script, height, false);
+    }
+    check(CScript() << OP_RETURN << OP_PUSHDATA1 << 5, height, false);
+    check(CScript() << OP_RETURN << OP_DUP << height, height, false);
+    check(CScript(), height, false);
+    // Preserve the historical compulsory logos prefix below 1018000.
+    check(CScript() << OP_RETURN << vanity << 1, 1, false);
+    for (int small : {1, 16, 17}) {
+        check(CScript() << OP_RETURN << COINBASE_PREFIX << small, small, true);
+    }
+    // CScript numbers need a fourth byte once the third byte's sign bit is set.
+    check(CScript() << OP_RETURN << vanity << 0x800000, 0x800000, true);
+    check(CScript() << OP_RETURN << vanity << 0x1000000, 0x1000000, true);
+    const int max_height = std::numeric_limits<int>::max();
+    check(CScript() << OP_RETURN << vanity << max_height, max_height, true);
+    check(CScript() << OP_RETURN << vanity << (int64_t{max_height} + 1),
+          max_height, false);
+    check(CScript() << OP_RETURN << vanity << int64_t{0x7fffffffff}, max_height,
+          false);
+    // The old unsigned three-byte representation is negative under CScriptNum.
+    check(CScript() << OP_RETURN << vanity << std::vector<uint8_t>{0, 0, 0x80},
+          0x800000, false);
+    params.coinbaseHeightParserActivationHeight = height + 1;
+    check(CScript() << OP_RETURN << vanity
+                    << std::vector<uint8_t>{0xa8, 0x60, 0x15, 0},
+          height, false);
+    params.coinbaseHeightParserActivationHeight = saved_parser;
+    check(CScript() << OP_RETURN << vanity
+                    << std::vector<uint8_t>{0xa8, 0x60, 0x15, 0},
+          height, false);
+    check(CScript() << OP_RETURN << vanity << std::vector<uint8_t>{0, 0, 0x80},
+          0x800000, true);
+    // Both default sentinels retain even the historic missing-height bypass.
+    params.coinbaseHeightValidationActivationHeight = saved_activation;
+    check(CScript() << OP_RETURN << vanity, height, true);
+    tip->nHeight = saved_height;
+}
+
 struct TestSubscriber final : public CValidationInterface {
     uint256 m_expected_tip;
 
diff --git a/src/validation.cpp b/src/validation.cpp
index 9727e892cc..f0c7712f46 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4558,6 +4558,38 @@ static bool ContextualCheckBlockHeader(
     return true;
 }
 
+// The parser upgrade is separate from the historical vanity-prefix bypass fix:
+// it changes which script encodings are valid and requires its own activation.
+static bool HasCoinbaseHeightCommitment(const CScript &script, int height) {
+    auto pc = script.begin();
+    opcodetype opcode;
+    std::vector<uint8_t> data;
+    if (!script.GetOp(pc, opcode, data) || opcode != OP_RETURN ||
+        !script.GetOp(pc, opcode, data) || opcode > OP_PUSHDATA4) {
+        return false;
+    }
+    if (height < 1018000 && data != COINBASE_PREFIX) {
+        return false;
+    }
+    if (!script.GetOp(pc, opcode, data)) {
+        return false;
+    }
+    if (opcode >= OP_1 && opcode <= OP_16) {
+        return CScript::DecodeOP_N(opcode) == height;
+    }
+    if (opcode > OP_PUSHDATA4) {
+        return false;
+    }
+    try {
+        // Keep nonminimal encodings valid. Five bytes suffice for signed 32-bit
+        // positive heights; compare without narrowing or unsigned
+        // interpretation.
+        return CScriptNum(data, false, 5) == int64_t{height};
+    } catch (const scriptnum_overflow_error &) {
+        return false;
+    }
+}
+
 /**
  * NOTE: This function is not currently invoked by ConnectBlock(), so we
  * should consider upgrade issues if we change which consensus rules are
@@ -4618,7 +4650,19 @@ static bool ContextualCheckBlock(const CBlock &block,
     // This rule applies to all blocks except the genesis block (height 0).
     // Note: This rule was added after some blocks were already mined, so we need
     // to be flexible with validation for older blocks.
-    if (nHeight > 0) {
+    const bool useHeightScriptParser =
+        nHeight > 0 &&
+        params.coinbaseHeightParserActivationHeight !=
+            std::numeric_limits<int>::max() &&
+        nHeight >= params.coinbaseHeightParserActivationHeight;
+    if (useHeightScriptParser) {
+        if (!HasCoinbaseHeightCommitment(block.vtx[0]->vout[0].scriptPubKey,
+                                         nHeight)) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-height",
+                                 "block height mismatch in coinbase");
+        }
+    } else if (nHeight > 0) {
         // Get the coinbase transaction's first output scriptPubKey
         const CScript &scriptPubKey = block.vtx[0]->vout[0].scriptPubKey;
 
