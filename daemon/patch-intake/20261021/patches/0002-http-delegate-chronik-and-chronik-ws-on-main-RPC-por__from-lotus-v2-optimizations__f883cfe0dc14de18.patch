+static bool IsPublicPath(std::string_view uri) {
+    return std::any_of(g_public_prefixes.begin(), g_public_prefixes.end(),
+                       [&](const std::string &prefix) {
+                           return URIHasPathPrefix(uri, prefix);
+                       });
+}
