+static asio::awaitable<boost::system::error_code>
+ConnectChronik(beast::tcp_stream &upstream) {
+    tcp::resolver resolver{co_await asio::this_coro::executor};
+    auto [rec, results] = co_await resolver.async_resolve(
+        g_chronik_proxy.host, std::to_string(g_chronik_proxy.port),
+        asio::as_tuple(asio::use_awaitable));
+    if (rec) {
+        co_return rec;
+    }
+    upstream.expires_after(std::chrono::seconds{10});
+    auto [cec, endpoint] = co_await upstream.async_connect(
+        results, asio::as_tuple(asio::use_awaitable));
+    if (!cec) {
+        boost::system::error_code ignored;
+        upstream.socket().set_option(tcp::no_delay(true), ignored);
+    }
+    co_return cec;
+}
+
+/**
+ * Forward a /chronik request to Chronik's own HTTP listener, reusing the
+ * per-client upstream connection when possible.
+ */
+static asio::awaitable<BeastResponse>
+ProxyChronikHTTP(const BeastRequest &req, const HTTPConnectionInfo &conn,
+                 std::optional<beast::tcp_stream> &upstream) {
+    const unsigned version{req.version()};
+    BeastRequest out{req.method(), ChronikUpstreamTarget(req.target()), 11};
+    for (const auto &f : req) {
+        if (!IsHopByHopField(f.name()) &&
+            f.name() != http::field::accept_encoding &&
+            !beast::iequals(f.name_string(), "X-Forwarded-For") &&
+            !beast::iequals(f.name_string(), "X-Forwarded-Proto")) {
+            out.insert(f.name_string(), f.value());
+        }
+    }
+    out.set(http::field::host, strprintf("%s:%u", g_chronik_proxy.host,
+                                         g_chronik_proxy.port));
+    std::string forwarded_for{conn.peer.ToStringAddr()};
+    if (auto xff = req.find("X-Forwarded-For"); xff != req.end()) {
+        forwarded_for = std::string{xff->value()} + ", " + forwarded_for;
+    }
+    out.set("X-Forwarded-For", forwarded_for);
+    out.set("X-Forwarded-Proto", conn.is_tls ? "https" : "http");
+    out.body() = req.body();
+    out.keep_alive(true);
+    out.prepare_payload();
+
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        const bool reused{upstream.has_value()};
+        if (!upstream) {
+            upstream.emplace(co_await asio::this_coro::executor);
+            if (auto ec = co_await ConnectChronik(*upstream)) {
+                upstream.reset();
+                LogDebug(BCLog::HTTP, "Chronik proxy connect failed: %s\n",
+                         ec.message());
+                co_return MakeSimpleResponse(502, version,
+                                             "Chronik is not reachable");
+            }
+        }
+        upstream->expires_after(g_server_timeout);
+        auto [wec, wn] = co_await http::async_write(
+            *upstream, out, asio::as_tuple(asio::use_awaitable));
+        http::response_parser<http::string_body> parser;
+        parser.body_limit(MAX_CHRONIK_PROXY_RESPONSE_SIZE);
+        beast::flat_buffer upstream_buffer;
+        boost::system::error_code rec{wec};
+        if (!rec) {
+            auto [ec, n] = co_await http::async_read(
+                *upstream, upstream_buffer, parser,
+                asio::as_tuple(asio::use_awaitable));
+            rec = ec;
+        }
+        if (rec) {
+            upstream.reset();
+            if (reused) {
+                // The idle upstream connection was closed: retry once.
+                continue;
+            }
+            LogDebug(BCLog::HTTP, "Chronik proxy request failed: %s\n",
+                     rec.message());
+            co_return MakeSimpleResponse(502, version, "Chronik proxy error");
+        }
+        auto upstream_res{parser.release()};
+        if (!upstream_res.keep_alive()) {
+            upstream.reset();
+        }
+        BeastResponse res{upstream_res.result(), version};
+        for (const auto &f : upstream_res) {
+            if (!IsHopByHopField(f.name())) {
+                res.insert(f.name_string(), f.value());
+            }
+        }
+        res.body() = std::move(upstream_res.body());
+        MaybeCompressZstd(req, res);
+        FinalizeResponse(res, version);
+        co_return res;
+    }
+    co_return MakeSimpleResponse(502, version, "Chronik proxy error");
+}
+
+/** Copy WebSocket messages from `from` to `to` until either side fails */
+template <typename From, typename To>
+static asio::awaitable<void> PumpWebSocket(From &from, To &to) {
+    beast::flat_buffer buffer;
+    while (true) {
+        auto [rec, rn] = co_await from.async_read(
+            buffer, asio::as_tuple(asio::use_awaitable));
+        if (rec) {
+            co_return;
+        }
+        to.binary(from.got_binary());
+        auto [wec, wn] = co_await to.async_write(
+            buffer.data(), asio::as_tuple(asio::use_awaitable));
+        if (wec) {
+            co_return;
+        }
+        buffer.consume(buffer.size());
+    }
+}
+
+/** Bridge a /chronik/ws upgrade to Chronik's /ws endpoint */
+template <typename Stream>
+static asio::awaitable<void> ProxyChronikWebSocket(Stream &stream,
+                                                   const BeastRequest &req,
+                                                   const HTTPConnectionInfo &conn) {
+    beast::tcp_stream upstream_tcp{co_await asio::this_coro::executor};
+    if (auto ec = co_await ConnectChronik(upstream_tcp)) {
+        LogDebug(BCLog::HTTP, "Chronik WebSocket proxy connect failed: %s\n",
+                 ec.message());
+        BeastResponse res{MakeSimpleResponse(502, req.version(),
+                                             "Chronik is not reachable")};
+        res.keep_alive(false);
+        co_await WriteResponse(stream, res);
+        co_return;
+    }
+    websocket::stream<beast::tcp_stream> upstream{std::move(upstream_tcp)};
+    upstream.next_layer().expires_never();
+    upstream.set_option(
+        websocket::stream_base::timeout::suggested(beast::role_type::client));
+    const std::string forwarded_for{conn.peer.ToStringAddr()};
+    upstream.set_option(websocket::stream_base::decorator(
+        [forwarded_for](websocket::request_type &r) {
+            r.set("X-Forwarded-For", forwarded_for);
+        }));
+    const std::string target{
+        ChronikUpstreamTarget(req.target()).substr(std::string_view{"/ws"}.size())};
+    auto [hec] = co_await upstream.async_handshake(
+        strprintf("%s:%u", g_chronik_proxy.host, g_chronik_proxy.port),
+        "/ws" + target, asio::as_tuple(asio::use_awaitable));
+    if (hec) {
+        LogDebug(BCLog::HTTP, "Chronik WebSocket handshake failed: %s\n",
+                 hec.message());
+        BeastResponse res{MakeSimpleResponse(502, req.version(),
+                                             "Chronik WebSocket error")};
+        res.keep_alive(false);
+        co_await WriteResponse(stream, res);
+        co_return;
+    }
+
+    beast::get_lowest_layer(stream).expires_never();
+    websocket::stream<Stream &> client{stream};
+    client.set_option(
+        websocket::stream_base::timeout::suggested(beast::role_type::server));
+    auto [aec] =
+        co_await client.async_accept(req, asio::as_tuple(asio::use_awaitable));
+    if (aec) {
+        co_return;
+    }
+    co_await (PumpWebSocket(client, upstream) ||
+              PumpWebSocket(upstream, client));
+    boost::system::error_code ignored;
+    beast::get_lowest_layer(upstream).socket().close(ignored);
+}
+
+/**
+ * Handle a WebSocket upgrade request if a WebSocket endpoint matches its
+ * target. Returns true if the connection was taken over.
+ */
+template <typename Stream>
+static asio::awaitable<bool>
+TryHandleWebSocketUpgrade(Stream &stream, const BeastRequest &req,
+                          const HTTPConnectionInfo &conn) {
+    const std::string_view target{req.target()};
+    if (g_chronik_proxy.enabled &&
+        URIHasPathPrefix(target, CHRONIK_PREFIX + "/ws")) {
+        co_await ProxyChronikWebSocket(stream, req, conn);
+        co_return true;
+    }
+    co_return false;
+}
