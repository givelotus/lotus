+/** Map "/chronik/x?y" to "/x?y" */
+static std::string ChronikUpstreamTarget(std::string_view target) {
+    std::string rest{target.substr(CHRONIK_PREFIX.size())};
+    if (rest.empty() || rest[0] != '/') {
+        rest.insert(rest.begin(), '/');
+    }
+    return rest;
+}
