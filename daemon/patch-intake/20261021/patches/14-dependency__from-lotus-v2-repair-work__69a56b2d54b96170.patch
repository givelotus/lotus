From c5c08a8817bd048eb263d5414d8cc0a446327d64 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:18:25 -0700
Subject: [PATCH] fixup! avalanche: add treasury contender voting, 50/25/25
 reward split, and default slate

---
 src/avalanche/processor.cpp            | 6 ++++++
 src/avalanche/test/processor_tests.cpp | 8 ++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/avalanche/processor.cpp b/src/avalanche/processor.cpp
index 0924bb6e65..49b061174b 100644
--- a/src/avalanche/processor.cpp
+++ b/src/avalanche/processor.cpp
@@ -784,6 +784,12 @@ bool Processor::registerVotes(NodeId nodeid, const Response &response,
             continue;
         }
 
+        // Treasury handles provisional decisions above. Other item kinds
+        // update finalized state only after the vote has actually finalized.
+        if (status != VoteStatus::Finalized && status != VoteStatus::Invalid) {
+            continue;
+        }
+
         if (const auto *batch = std::get_if<const MempoolBatchVoteItem>(&item)) {
             if (update.getStatus() == VoteStatus::Finalized) {
                 finalizeMempoolBatch(batch->GetId());
diff --git a/src/avalanche/test/processor_tests.cpp b/src/avalanche/test/processor_tests.cpp
index 761f4cf118..8b73cfcdc8 100644
--- a/src/avalanche/test/processor_tests.cpp
+++ b/src/avalanche/test/processor_tests.cpp
@@ -269,8 +269,11 @@ struct BlockProvider {
         const BlockHash blockHash = block.GetHash();
 
         LOCK(cs_main);
-        return Assert(fixture->m_node.chainman)
+        auto *index = Assert(fixture->m_node.chainman)
             ->m_blockman.LookupBlockIndex(blockHash);
+        BOOST_REQUIRE(index);
+        BOOST_REQUIRE_EQUAL(fixture->m_node.chainman->ActiveTip()->GetBlockHash(), blockHash);
+        return index;
     }
 
     uint256 getVoteItemId(const CBlockIndex *pindex) const {
@@ -701,7 +704,8 @@ BOOST_AUTO_TEST_CASE_TEMPLATE(vote_item_register, P, VoteItemProviders) {
     auto registerNewVote = [&](const Response &resp) {
         runEventLoop();
         auto nodeid = avanodes[nextNodeIndex++ % avanodes.size()]->GetId();
-        BOOST_CHECK(registerVotes(nodeid, resp, updates));
+        std::string error;
+        BOOST_CHECK_MESSAGE(registerVotes(nodeid, resp, updates, error), error);
     };
 
     // Let's vote for this item a few times.
