From e2c253a05d7085d82e4314f2ff7834c821433993 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:57:33 -0700
Subject: [PATCH] fixup! chronik: offload ChronikValidationInterface callbacks
 to dedicated worker thread

Exercise worker exception as fatal failure while draining accepted successors and honoring the queue fence.
---
 src/test/validationinterface_tests.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/test/validationinterface_tests.cpp b/src/test/validationinterface_tests.cpp
index 9ca779f25e..f1af7d802d 100644
--- a/src/test/validationinterface_tests.cpp
+++ b/src/test/validationinterface_tests.cpp
@@ -835,4 +835,25 @@ BOOST_AUTO_TEST_CASE(bounded_worker_overflow_keeps_scheduler_responsive) {
     reentrant.Stop();
 }
 
+BOOST_AUTO_TEST_CASE(bounded_worker_exception_is_fatal_and_drains_accepted_work) {
+    std::atomic<unsigned> fatal{0}, completed{0};
+    std::promise<void> started, release;
+    auto released = release.get_future().share();
+    BoundedTaskQueue queue(10, 10, [&] { ++fatal; });
+    BOOST_REQUIRE(queue.Enqueue(1, [&] {
+        started.set_value();
+        released.wait();
+        throw std::runtime_error("injected indexer failure");
+    }));
+    started.get_future().wait();
+    BOOST_REQUIRE(queue.Enqueue(1, [&] { ++completed; }));
+    release.set_value();
+    queue.Sync();
+    BOOST_CHECK_EQUAL(fatal.load(), 1);
+    BOOST_CHECK_EQUAL(completed.load(), 1);
+    BOOST_CHECK_EQUAL(queue.BytesRetained(), 0);
+    BOOST_CHECK(!queue.Enqueue(1, [] {}));
+    queue.Stop();
+}
+
 BOOST_AUTO_TEST_SUITE_END()
