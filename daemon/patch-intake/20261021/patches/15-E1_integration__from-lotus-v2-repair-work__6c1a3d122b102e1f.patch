+std::optional<bool> PeerManagerImpl::ValidateEpochScope(const avalanche::MempoolBatchAnnouncement &batch) {
+    using namespace lotus::v2;
+    const auto txs = m_v2_protocol_handler.GetScopedTransactions(
+        net::ReconScope::EPOCH_BATCH, batch.ComputeBatchId());
+    if (txs.size() < batch.tx_count) return std::nullopt;
+    if (txs.size() != batch.tx_count || net::ComputeScopedMerklixRoot(txs) != batch.subtree_a_root) return false;
+    std::vector<CTransactionRef> parent_txs;
+    if (batch.epoch_seq == 1) {
+        if (!batch.parent_batch_id.IsNull()) return false;
+    } else {
+        avalanche::MempoolBatchAnnouncement parent;
+        if (!m_avalanche->getMempoolBatch(batch.parent_batch_id, parent)) return std::nullopt;
+        if (parent.prev_block_hash != batch.prev_block_hash ||
+            uint64_t(parent.epoch_seq) + 1 != batch.epoch_seq) return false;
+        if (!m_avalanche->isMempoolBatchFinalized(batch.parent_batch_id)) return std::nullopt;
+        parent_txs = m_v2_protocol_handler.GetScopedTransactions(net::ReconScope::EPOCH_BATCH, batch.parent_batch_id);
+        if (parent_txs.size() != parent.tx_count || net::ComputeScopedMerklixRoot(parent_txs) != parent.subtree_a_root)
+            return std::nullopt;
+    }
+    LOCK2(cs_main, m_mempool.cs);
+    const auto *tip = m_chainman.ActiveTip();
+    if (!tip || tip->GetBlockHash() != batch.prev_block_hash) return false;
+    m_mempool.SyncMerklixOverlayToTip(batch.prev_block_hash, tip->nHeight + 1, tip->GetMedianTimePast());
+    const auto &base = m_mempool.GetOverlayManager().GetSpeculativeOverlay();
+    std::unordered_set<TxId, SaltedTxIdHasher> selected;
+    for (const auto &tx : txs) selected.insert(tx->GetId());
+    for (const auto &tx : parent_txs) if (!selected.count(tx->GetId())) return false;
+    std::vector<std::tuple<CTransactionRef, int64_t, int64_t>> entries;
+    entries.reserve(txs.size());
+    for (const auto &tx : txs) {
+        const auto entry = m_mempool.GetIter(tx->GetId());
+        if (!entry) return false;
+        for (const auto &input : tx->vin) {
+            if (input.nFlags == 3) continue;
+            if (m_mempool.exists(input.prevout.GetTxId())) {
+                if (!selected.count(input.prevout.GetTxId())) return false;
+            } else if (!m_chainman.ActiveChainstate().CoinsTip().HaveCoin(input.prevout)) return false;
+        }
+        entries.emplace_back(tx, (**entry)->GetFee() / SATOSHI, (**entry)->GetSigChecks());
+    }
+    MempoolOverlayLayer exact(base.GetParentBlockId(), base.GetBaseUtxoRoot(),
+        base.GetBaseMonetaryState(), base.GetHeight(), base.GetParentMtp(), base.GetLayerId());
+    if (AddTransactionsToOverlayBatch(exact, entries) != entries.size()) return false;
+    uint256 utxo;
+    const auto digest = exact.GetUtxoRootDigest();
+    std::memcpy(utxo.begin(), digest.data(), 32);
+    HashWriter ordered;
+    for (const auto &[id, _] : exact.GetOrderedTxs()) ordered.write(std::as_bytes(std::span{id}));
+    if (utxo != batch.utxo_root || ordered.GetHash() != batch.short_ids_hash) return false;
+    m_v2_protocol_handler.RegisterCandidateOverlay(batch.prev_block_hash, txs);
+    return true;
+}
