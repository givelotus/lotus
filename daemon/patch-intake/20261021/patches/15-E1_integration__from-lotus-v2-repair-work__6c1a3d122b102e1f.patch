+BOOST_FIXTURE_TEST_CASE(production_epoch_sender_and_exact_scope_verification,
+                        AvalancheTestChain100Setup) {
+    using namespace std::chrono_literals;
+    using namespace lotus::v2::net;
+    auto &processor = *m_node.avalanche;
+    auto &chainman = static_cast<TestChainstateManager &>(*m_node.chainman);
+    if (chainman.IsInitialBlockDownload()) chainman.JumpOutOfIbd();
+    const auto *tip = WITH_LOCK(cs_main, return chainman.ActiveTip());
+    AvalancheTest::setFinalizationTip(processor, tip);
+    auto proof = buildRandomProof(chainman.ActiveChainstate(), MIN_VALID_PROOF_SCORE);
+    BOOST_REQUIRE(processor.withPeerManager([&](avalanche::PeerManager &pm) { return pm.registerProof(proof); }));
+    const auto services = ServiceFlags(NODE_NETWORK | NODE_AVALANCHE | NODE_MERKLIX |
+        NODE_MERKLIX_BATCH | NODE_MERKLIX_SIZED | NODE_MERKLIX_EPOCH);
+    std::vector<CNode *> nodes;
+    std::atomic<bool> interrupt{false};
+    LOCK(NetEventsInterface::g_msgproc_mutex);
+    for (int i = 0; i < 8; ++i) {
+        auto *node = new CNode(1800 + i, nullptr, CAddress(), 0, 0, 0, CAddress(), "",
+                              ConnectionType::OUTBOUND_FULL_RELAY, false);
+        m_node.peerman->InitializeNode(config, *node, services);
+        m_connman->AddTestNode(*node);
+        nodes.push_back(node);
+        auto version = NetMsg::Make(NetMsgType::VERSION, PROTOCOL_VERSION,
+            Using<CustomUintFormatter<8>>(services), int64_t{}, int64_t{},
+            WithParams(CNetAddr::V1, CService{}), int64_t{},
+            WithParams(CNetAddr::V1, CService{}), uint64_t{1}, std::string{},
+            int32_t{}, true, uint64_t{1});
+        DataStream stream(version.data);
+        m_node.peerman->ProcessMessage(config, *node, NetMsgType::VERSION, stream, 1s, interrupt);
+        DataStream verack;
+        m_node.peerman->ProcessMessage(config, *node, NetMsgType::VERACK, verack, 1s, interrupt);
+        BOOST_REQUIRE(node->fSuccessfullyConnected);
+        BOOST_REQUIRE(processor.withPeerManager([&](avalanche::PeerManager &pm) {
+            return pm.addNode(node->GetId(), proof->getId(), DEFAULT_AVALANCHE_MAX_ELEMENT_POLL);
+        }));
+    }
+    BOOST_REQUIRE(processor.isQuorumEstablished());
+    const CScript redeem = CScript() << std::vector<uint8_t>(48, 0x42) << OP_DROP << OP_TRUE;
+    const auto script = GetScriptForDestination(ScriptHash(redeem));
+    CMutableTransaction mutable_tx;
+    mutable_tx.nVersion = 2;
+    mutable_tx.vin.emplace_back(COutPoint(TxId(GetRandHash()), 0));
+    mutable_tx.vin[0].scriptSig = CScript() << ToByteVector(redeem);
+    mutable_tx.vout.emplace_back(1000 * SATOSHI, script);
+    auto tx = MakeTransactionRef(std::move(mutable_tx));
+    {
+        LOCK(cs_main);
+        chainman.ActiveChainstate().CoinsTip().AddCoin(tx->vin[0].prevout,
+            Coin(CTxOut(5000 * SATOSHI, script), 1, false), true);
+    }
+    BOOST_REQUIRE(chainman.ProcessTransaction(tx, false).m_result_type == MempoolAcceptResult::ResultType::VALID);
+    auto drain = [&](CNode &node) {
+        V1TransportDeserializer decoder(config, node.GetId());
+        std::vector<CNetMessage> messages;
+        LOCK(node.cs_vSend);
+        for (const auto &chunk : node.vSendMsg) {
+            Span<const uint8_t> bytes{chunk};
+            while (!bytes.empty()) {
+                BOOST_REQUIRE_GE(decoder.Read(config, bytes), 0);
+                if (decoder.Complete()) {
+                    bool rejected = false;
+                    messages.push_back(decoder.GetMessage(0us, rejected));
+                    BOOST_REQUIRE(!rejected);
+                }
+            }
+        }
+        node.vSendMsg.clear(); node.nSendSize = 0; node.fPauseSend = false;
+        return messages;
+    };
+    auto &node = *nodes.front();
+    drain(node);
+    auto &controller = processor.getAdaptiveEpochController();
+    controller.recordBatchFrozen(Now<SteadyMilliseconds>() - 2s);
+    const auto freezes = controller.getFreezeCount();
+    BOOST_REQUIRE(m_node.peerman->SendMessages(config, &node));
+    avalanche::MempoolBatchAnnouncement announced;
+    bool got_batch = false, got_sketch = false;
+    // The mock connection's zero send-buffer cap can pause after AVABATCH;
+    // drain it and permit the next pass to send the named epoch sketch.
+    for (int pass = 0; pass < 3; ++pass) {
+        for (auto &message : drain(node)) {
+            if (message.m_type == NetMsgType::AVABATCH) {
+                message.m_recv >> announced;
+                got_batch = true;
+            }
+            if (message.m_type == NetMsgType::MERKLIXSIZED) {
+                MerklixSizedSync push; message.m_recv >> push;
+                got_sketch |= push.summary.scope == uint8_t(ReconScope::EPOCH_BATCH);
+            }
+        }
+        m_node.peerman->SendMessages(config, &node);
+    }
+    BOOST_REQUIRE(got_batch);
+    BOOST_CHECK(got_sketch);
+    BOOST_CHECK_EQUAL(announced.tx_count, 1U);
+    BOOST_CHECK_EQUAL(controller.getFreezeCount(), freezes + 1);
+    BOOST_CHECK(!processor.tryFreezeAndRegisterNextEpochBatch(tip->GetBlockHash(), nullptr, true));
+    // Receiver acceptance is checked through production ProcessMessage and
+    // SendMessages. The admitted exact scope is provided directly here; the
+    // separate 10k transport test covers fetching that scope over SHORTTX.
+    auto *handler = m_node.peerman->GetV2ProtocolHandler();
+    auto receive = [&](avalanche::MempoolBatchAnnouncement batch, bool expected) {
+        const auto id = batch.ComputeBatchId();
+        BOOST_REQUIRE(handler->SetScopedTransactions(ReconScope::EPOCH_BATCH, id, {tx}));
+        SetMockTime(GetTime() + 1);
+        DataStream wire; wire << batch;
+        m_node.peerman->ProcessMessage(config, node, NetMsgType::AVABATCH, wire,
+                                       GetTime<std::chrono::microseconds>(), interrupt);
+        drain(node);
+        m_node.peerman->SendMessages(config, &node);
+        BOOST_CHECK_EQUAL(processor.isMempoolBatchLocallyAccepted(id), expected);
+        drain(node);
+    };
+    auto wrong_utxo = announced; wrong_utxo.utxo_root.begin()[0] ^= 1;
+    receive(wrong_utxo, false);
+    auto wrong_ids = announced; wrong_ids.short_ids_hash.begin()[0] ^= 1;
+    receive(wrong_ids, false);
+    processor.rejectMempoolBatch(announced.ComputeBatchId());
+    BOOST_CHECK(!processor.isMempoolBatchLocallyAccepted(announced.ComputeBatchId()));
+    receive(announced, true);
+    for (size_t i = 0; i < Processor::MAX_MEMPOOL_BATCH_RECORDS + 3; ++i) {
+        auto unaccepted = announced;
+        unaccepted.prev_block_hash = BlockHash(GetRandHash());
+        BOOST_REQUIRE(processor.registerMempoolBatch(unaccepted, false, false));
+    }
+    BOOST_CHECK(processor.isMempoolBatchKnown(announced.ComputeBatchId()));
+    BOOST_CHECK(processor.isMempoolBatchLocallyAccepted(announced.ComputeBatchId()));
+    AvalancheTest::checkBatchIndicesBounded(processor);
+    // No claim of real quorum finalization or WAN epoch latency is made here.
+}
+
