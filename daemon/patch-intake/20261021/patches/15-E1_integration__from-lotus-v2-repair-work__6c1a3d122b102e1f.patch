+bool Processor::getLatestAcceptedMempoolBatch(
+    const BlockHash &parent, MempoolBatchAnnouncement &out) const {
+    LOCK(cs_mempoolBatches);
+    bool found = false;
+    for (const auto &[id, batch] : m_mempoolBatches) {
+        if (batch.prev_block_hash == parent && m_acceptedMempoolBatches.count(id) &&
+            (!found || batch.epoch_seq > out.epoch_seq)) {
+            out = batch;
+            found = true;
+        }
+    }
+    return found;
+}
