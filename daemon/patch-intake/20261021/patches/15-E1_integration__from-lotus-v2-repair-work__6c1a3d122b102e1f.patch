 namespace {
+bool CanRetainNextEpoch(const CTxMemPool &pool) EXCLUSIVE_LOCKS_REQUIRED(pool.cs) {
+    AssertLockHeld(pool.cs);
+    const auto &manager = pool.GetOverlayManager();
+    if (manager.GetFrozenEpochs().size() >= 64) return false;
+    size_t count = 0, bytes = 0;
+    auto add = [&](const lotus::v2::MempoolOverlayLayer &layer) {
+        count += layer.GetTxCount();
+        if (count > 65536) return false;
+        for (const auto &[_, entry] : layer.GetOrderedTxs()) {
+            const auto tx = std::static_pointer_cast<const CTransaction>(entry.tx_ref);
+            if (!tx) return false;
+            bytes += GetSerializeSize(*tx);
+            if (bytes > 64 * 1024 * 1024) return false;
+        }
+        return true;
+    };
+    if (!add(manager.GetSpeculativeOverlay())) return false;
+    for (const auto &layer : manager.GetFrozenEpochs()) if (!add(layer)) return false;
+    return true;
+}
