+void PeerManagerImpl::MaybeSendEpoch(CNode &node, Peer &peer, std::chrono::microseconds now) {
+    using namespace lotus::v2::net;
+    if (!m_avalanche || !(peer.m_our_services & NODE_MERKLIX_EPOCH) ||
+        !(peer.m_their_services.load() & NODE_MERKLIX_EPOCH) || node.fPauseSend ||
+        node.IsBlockOnlyConn() || node.IsAddrFetchConn()) return;
+    if (peer.m_pending_epoch) {
+        if (now >= peer.m_pending_epoch_expires) peer.m_pending_epoch.reset();
+        else if (now >= peer.m_next_epoch_check) {
+            peer.m_next_epoch_check = now + 100ms;
+            // Charge the full bounded validation visit cost before copying or
+            // rebuilding an untrusted exact scope. A depleted budget waits.
+            if (peer.m_epoch_validation_budget.Consume(0, 16 * peer.m_pending_epoch->tx_count, false, now)) {
+                const auto accepted = ValidateEpochScope(*peer.m_pending_epoch);
+                if (accepted.has_value()) {
+                    if (*accepted) m_avalanche->setMempoolBatchAccepted(peer.m_pending_epoch->ComputeBatchId());
+                    peer.m_pending_epoch.reset();
+                }
+            }
+        }
+    }
+    if (!m_avalanche->isQuorumEstablished() || m_chainman.IsInitialBlockDownload()) return;
+    const CBlockIndex *tip = WITH_LOCK(cs_main, return m_chainman.ActiveTip());
+    if (!tip || !m_avalanche->isPreconsensusActivated(tip)) return;
+    if (now >= m_next_epoch_freeze) {
+        m_next_epoch_freeze = now + m_avalanche->getAdaptiveEpochController().getSettlingWindow();
+        {
+            LOCK2(cs_main, m_mempool.cs);
+            if (tip != m_chainman.ActiveTip()) return;
+            m_mempool.SyncMerklixOverlayToTip(tip->GetBlockHash(), tip->nHeight + 1, tip->GetMedianTimePast());
+        }
+        m_avalanche->tryFreezeAndRegisterNextEpochBatch(tip->GetBlockHash());
+    }
+    avalanche::MempoolBatchAnnouncement batch;
+    if (!m_avalanche->getLatestAcceptedMempoolBatch(tip->GetBlockHash(), batch)) return;
+    const auto id = batch.ComputeBatchId();
+    if (peer.m_last_epoch_announced == id && now < peer.m_next_epoch_announcement) {
+        if (peer.m_epoch_sketch_pending)
+            peer.m_epoch_sketch_pending = !m_v2_protocol_handler.PushScopedSync(node, ReconScope::EPOCH_BATCH, id);
+        return;
+    }
+    std::vector<CTransactionRef> txs;
+    {
+        LOCK(m_mempool.cs);
+        for (const auto &frozen : m_mempool.GetOverlayManager().GetFrozenEpochs()) {
+            const auto root = frozen.GetSubtreeARoot();
+            if (std::memcmp(root.data(), batch.subtree_a_root.begin(), 32)) continue;
+            txs.reserve(frozen.GetTxCount());
+            for (const auto &[_, entry] : frozen.GetOrderedTxs())
+                txs.push_back(std::static_pointer_cast<const CTransaction>(entry.tx_ref));
+            break;
+        }
+    }
+    if (txs.size() != batch.tx_count || !m_v2_protocol_handler.SetScopedTransactions(
+            ReconScope::EPOCH_BATCH, id, std::move(txs))) return;
+    // The unchanged announcement payload names the immutable exact-set scope;
+    // the negotiated sketch immediately starts reconciliation of that scope.
+    m_connman.PushMessage(&node, NetMsg::Make(NetMsgType::AVABATCH, batch));
+    peer.m_epoch_sketch_pending = true;
+    if (!node.fPauseSend)
+        peer.m_epoch_sketch_pending = !m_v2_protocol_handler.PushScopedSync(node, ReconScope::EPOCH_BATCH, id);
+    peer.m_last_epoch_announced = id;
+    peer.m_next_epoch_announcement = now + 1s;
+}
