From 56ae7d3c7de68c3cb3b37627c585c29a32f0a2df Mon Sep 17 00:00:00 2001
From: Lotus Developer <dev@lotus.org>
Date: Thu, 16 Apr 2026 12:00:00 +0000
Subject: [PATCH] v2: add DiskStateStore::CommitFinalizedOverlay for O(1) block
 state commit

Add DiskStateStore::CommitFinalizedOverlay so ConnectBlock can commit
pre-validated Merklix overlay mutations and updated roots directly to
libmdbx without re-computing the Sparse Merkle Tree.
---
 src/lotus_v2/disk_state.cpp | 60 +++++++++++++++++++++++++++++++++++++
 src/lotus_v2/disk_state.h   |  9 ++++++
 2 files changed, 69 insertions(+)

diff --git a/src/lotus_v2/disk_state.cpp b/src/lotus_v2/disk_state.cpp
index 832f31e8eb..0132b26001 100644
--- a/src/lotus_v2/disk_state.cpp
+++ b/src/lotus_v2/disk_state.cpp
@@ -1,5 +1,6 @@
 // Copyright (c) 2026 The Lotus developers
 #include "disk_state.h"
+#include "mempool_overlay.h"
 #include "vendor/blake3/blake3.h"
 #include "vendor/libmdbx/mdbx.h"
 
@@ -2395,6 +2396,65 @@ bool DiskStateStore::Begin(DiskStateTransaction &out, DiskStateError &error) {
         out.impl_ = std::make_unique<DiskStateTransaction::Impl>(impl_); impl_->active = true;
     });
 }
+bool DiskStateStore::CommitFinalizedOverlay(
+    const MempoolOverlayLayer &overlay,
+    const std::vector<Coin> &coinbase_coins,
+    const DiskStateMetadata &next,
+    DiskStateError &error) {
+    DiskStateTransaction txn;
+    if (!Begin(txn, error)) {
+        return false;
+    }
+    for (const auto &op : overlay.GetNetErasedOutpoints()) {
+        if (!txn.Erase(op, error)) {
+            txn.Abort();
+            return false;
+        }
+    }
+    for (const auto &coin : overlay.GetNetInsertedCoins()) {
+        if (!txn.Insert(coin, error)) {
+            txn.Abort();
+            return false;
+        }
+    }
+    for (const auto &cb_coin : coinbase_coins) {
+        if (!txn.Insert(cb_coin, error)) {
+            txn.Abort();
+            return false;
+        }
+    }
+    return txn.Commit(next, error);
+}
+bool DiskStateStore::CommitFinalizedOverlay(
+    const MempoolOverlayLayer &overlay,
+    const std::vector<Coin> &coinbase_coins,
+    const DiskStateMetadata &next,
+    const Header &fully_connected,
+    DiskStateError &error) {
+    DiskStateTransaction txn;
+    if (!Begin(txn, error)) {
+        return false;
+    }
+    for (const auto &op : overlay.GetNetErasedOutpoints()) {
+        if (!txn.Erase(op, error)) {
+            txn.Abort();
+            return false;
+        }
+    }
+    for (const auto &coin : overlay.GetNetInsertedCoins()) {
+        if (!txn.Insert(coin, error)) {
+            txn.Abort();
+            return false;
+        }
+    }
+    for (const auto &cb_coin : coinbase_coins) {
+        if (!txn.Insert(cb_coin, error)) {
+            txn.Abort();
+            return false;
+        }
+    }
+    return txn.Commit(next, fully_connected, error);
+}
 Hash DiskStateTransaction::Root() const { return impl_ ? impl_->head.root.digest : EmptyUtxoRoot(); }
 DiskStateStats DiskStateTransaction::Stats() const { return impl_ ? impl_->Stats() : DiskStateStats{}; }
 bool DiskStateTransaction::ReadCoin(const Outpoint &outpoint, std::optional<Coin> &out, DiskStateError &error) const {
