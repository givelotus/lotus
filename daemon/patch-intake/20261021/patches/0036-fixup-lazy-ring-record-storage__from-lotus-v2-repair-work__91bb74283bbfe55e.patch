From afb22ca9c0ecde55ccd74903e2b1cd7d139e9964 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 07:13:45 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

Start LogRecord lifetimes only for claimed slots. Default-constructing source_location in every unused record eagerly touched every page, despite the previous constructor comment. Keep trivial destruction explicit and launder consumer slot pointers after reuse. Local residency control fails before and passes after; macOS and Linux SPSC sanitizer controls cover multiple wraps.
---
 src/logging.h | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/src/logging.h b/src/logging.h
index 445d87d7ab..22a4af26fb 100644
--- a/src/logging.h
+++ b/src/logging.h
@@ -26,11 +26,13 @@
 #include <list>
 #include <memory>
 #include <mutex>
+#include <new>
 #include <optional>
 #include <source_location>
 #include <string>
 #include <string_view>
 #include <thread>
+#include <type_traits>
 #include <unordered_map>
 #include <unordered_set>
 #include <vector>
@@ -279,6 +281,7 @@ struct LogRecord {
     alignas(8) std::byte payload[LOG_RECORD_SIZE - 64];
 };
 static_assert(sizeof(LogRecord) == LOG_RECORD_SIZE);
+static_assert(std::is_trivially_destructible_v<LogRecord>);
 static_assert(offsetof(LogRecord, payload) == 64);
 
 /**
@@ -294,7 +297,7 @@ public:
     static constexpr size_t CAPACITY{1024};
     static_assert((CAPACITY & (CAPACITY - 1)) == 0);
 
-    //! User-provided, so the slots (512 KiB) are not zeroed: their pages
+    //! User-provided, so unused slot bytes are not initialized: their pages
     //! are only touched when used.
     LogRing() {}
 
@@ -307,7 +310,10 @@ public:
                 return nullptr;
             }
         }
-        return &m_slots[head & (CAPACITY - 1)];
+        // Begin the record lifetime only when used: default-constructing all
+        // source_location members at ring allocation would touch every page.
+        void *slot{m_slots.data() + (head & (CAPACITY - 1)) * LOG_RECORD_SIZE};
+        return ::new (slot) LogRecord;
     }
     /**
      * Producer: publish the slot returned by Claim. Returns true while the
@@ -336,7 +342,11 @@ public:
     }
     /** Consumer: the oldest record (Available() > 0) */
     LogRecord &Front() noexcept {
-        return m_slots[m_tail.load(std::memory_order_relaxed) & (CAPACITY - 1)];
+        const auto offset{
+            (m_tail.load(std::memory_order_relaxed) & (CAPACITY - 1)) *
+            LOG_RECORD_SIZE};
+        return *std::launder(
+            reinterpret_cast<LogRecord *>(m_slots.data() + offset));
     }
     /** Consumer: release the oldest record */
     void Pop() noexcept {
@@ -369,7 +379,7 @@ private:
     std::atomic<uint64_t> m_dropped{0};
     // Consumer-owned
     alignas(64) std::atomic<uint64_t> m_tail{0};
-    alignas(64) std::array<LogRecord, CAPACITY> m_slots;
+    alignas(64) std::array<std::byte, CAPACITY * LOG_RECORD_SIZE> m_slots;
 };
 
 /**
