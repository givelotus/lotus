From 09d588d17b53e505515cc76337fff7cf485d8542 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 04:41:01 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

---
 src/logging.cpp                    | 17 ++++++++++++-----
 src/logging.h                      |  1 +
 src/logging/event.h                |  2 ++
 src/test/logging_tests.cpp         | 26 ++++++++++++++++++++------
 test/functional/feature_logging.py | 16 ++++++++++++++++
 5 files changed, 51 insertions(+), 11 deletions(-)

diff --git a/src/logging.cpp b/src/logging.cpp
index 42e051a6e6..ea51d1997e 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -740,6 +740,7 @@ void BCLog::Logger::WriteEmergency(LogRecord &rec) NO_THREAD_SAFETY_ANALYSIS {
     m_line_buf.swap(saved);
     // An error may be followed immediately by abort inside the callback.
     if (m_fileout) fflush(m_fileout);
+    if (m_json_fileout) fflush(m_json_fileout);
     if (m_print_to_console) fflush(stdout);
 }
 
@@ -1038,7 +1039,12 @@ void BCLog::Logger::BeginEvent(EventBuilder &b) noexcept {
                 ring->CountDrop();
                 return;
             }
-            rec = ClaimSlow(*ring);
+            if (t_in_consumer) {
+                b.m_emergency = true;
+                rec = &ring->m_emergency;
+            } else {
+                rec = ClaimSlow(*ring);
+            }
             if (!rec) {
                 ring->CountDrop();
                 return;
@@ -1076,6 +1082,10 @@ void BCLog::Logger::EndEvent(EventBuilder &b) noexcept {
     if (limiter && limiter->SuppressionsActive()) {
         rec.flags |= LogRecord::SUPPRESSIONS;
     }
+    if (b.m_emergency) {
+        WriteEmergency(rec);
+        return;
+    }
     if (b.m_buffered) {
         StdLockGuard scoped_lock(m_cs);
         if (m_buffering) {
@@ -1105,10 +1115,7 @@ void BCLog::Logger::EndEvent(EventBuilder &b) noexcept {
     if (b.m_ring->Commit() &&
         !m_wake_requested.load(std::memory_order_relaxed) &&
         !m_wake_requested.exchange(true)) {
-        {
-            std::lock_guard<std::mutex> lock(m_wake_mutex);
-            m_wake = true;
-        }
+        m_wake = true;
         m_wake_cv.notify_one();
     }
     if (rec.level >= Level::Error) {
diff --git a/src/logging.h b/src/logging.h
index f663bdfac7..46047ba2f3 100644
--- a/src/logging.h
+++ b/src/logging.h
@@ -588,6 +588,7 @@ public:
     bool Enabled() const {
         return m_buffering.load(std::memory_order_relaxed) ||
                m_print_to_console || m_print_to_file ||
+               !m_json_file_path.empty() ||
                m_log_format == LogFormat::JOURNALD ||
                m_has_callbacks.load(std::memory_order_relaxed);
     }
diff --git a/src/logging/event.h b/src/logging/event.h
index 8b92f9744a..2045484fb8 100644
--- a/src/logging/event.h
+++ b/src/logging/event.h
@@ -305,6 +305,8 @@ private:
     //! The slot being filled (in the thread's ring, or m_buffered)
     LogRecord *m_rec{nullptr};
     LogRing *m_ring{nullptr};
+    //! Rare reentrant severe overflow (already on the consuming thread).
+    bool m_emergency{false};
     //! Before logging starts: a heap record kept until StartLogging
     std::unique_ptr<LogRecord> m_buffered;
     //! Payload bytes used
diff --git a/src/test/logging_tests.cpp b/src/test/logging_tests.cpp
index cd67d36e87..549617817d 100644
--- a/src/test/logging_tests.cpp
+++ b/src/test/logging_tests.cpp
@@ -926,7 +926,7 @@ BOOST_FIXTURE_TEST_CASE(logging_async_reopen_under_load, LogSetup) {
 
 BOOST_FIXTURE_TEST_CASE(logging_producer_wake_does_not_lock, LogSetup) {
     LogInstance().EnableCategory(BCLog::NET);
-    {
+    for (const bool structured : {false, true}) {
         LogInstance().PauseForTesting(true);
         LogInstance().Flush();
         std::promise<void> done;
@@ -937,7 +937,11 @@ BOOST_FIXTURE_TEST_CASE(logging_producer_wake_does_not_lock, LogSetup) {
         std::thread producer{[&] {
             util::ThreadRename("wake-test");
             for (size_t i = 0; i < BCLog::LogRing::CAPACITY / 2; ++i) {
-                LogDebug(BCLog::NET, "wake probe\n");
+                if (structured) {
+                    LogEvent(BCLog::NET, "wake_probe", "wake probe");
+                } else {
+                    LogDebug(BCLog::NET, "wake probe\n");
+                }
             }
             done.set_value();
         }};
@@ -948,7 +952,9 @@ BOOST_FIXTURE_TEST_CASE(logging_producer_wake_does_not_lock, LogSetup) {
         producer.join();
         LogInstance().PauseForTesting(false);
         LogInstance().Flush();
-        BOOST_CHECK_MESSAGE(ready, "plain producer blocked on wake mutex");
+        BOOST_CHECK_MESSAGE(
+            ready, (structured ? "structured producer blocked on wake mutex"
+                               : "plain producer blocked on wake mutex"));
     }
 }
 
@@ -969,9 +975,16 @@ BOOST_FIXTURE_TEST_CASE(logging_callback_severe_overflow, LogSetup) {
         // Callback runs on the consuming thread. Its own ring cannot drain
         // until this callback returns, so this deterministically fills it.
         for (size_t i = 0; i < count; ++i) {
-            LogWarning("callback warning %u\n", i);
+            if (i & 1) {
+                LogWarningEvent(BCLog::NET, "callback_warning",
+                                "callback warning {count}")
+                    .Field(BCLog::LogField::Count, uint64_t{i});
+            } else {
+                LogWarning("callback warning %u\n", i);
+            }
         }
         LogError("callback plain error\n");
+        LogErrorEvent(BCLog::NET, "callback_error", "callback typed error");
         callback_line_intact = line == original;
     })};
     LogPrintf("callback seed\n");
@@ -982,12 +995,13 @@ BOOST_FIXTURE_TEST_CASE(logging_callback_severe_overflow, LogSetup) {
     size_t warnings{0}, errors{0};
     for (const auto &line : ReadDebugLogLines()) {
         warnings += line.find("callback warning ") != std::string::npos;
-        errors += line.find("callback plain error") != std::string::npos;
+        errors += line.find("callback plain error") != std::string::npos ||
+                  line.find("callback typed error") != std::string::npos;
     }
     BOOST_REQUIRE(triggered);
     BOOST_CHECK(callback_line_intact);
     BOOST_CHECK_EQUAL(warnings, count);
-    BOOST_CHECK_EQUAL(errors, 1U);
+    BOOST_CHECK_EQUAL(errors, 2U);
     BOOST_CHECK_EQUAL(LogInstance().DroppedLines() - before, 0U);
 }
 
diff --git a/test/functional/feature_logging.py b/test/functional/feature_logging.py
index b2fe584790..17f57f5da1 100644
--- a/test/functional/feature_logging.py
+++ b/test/functional/feature_logging.py
@@ -88,6 +88,7 @@ class LoggingTest(BitcoinTestFramework):
         self.test_ecs_format()
         self.test_syslog_format()
         self.test_text_priority()
+        self.test_json_aux_only()
 
     def assert_no_absolute_source_paths(self, log_path):
         src = os.path.join(self.config["environment"]["SRCDIR"], "src") + os.sep
@@ -202,6 +203,21 @@ class LoggingTest(BitcoinTestFramework):
             lines = [line for line in stream if line.strip()]
         assert lines and all(not line.startswith("<") for line in lines)
 
+    def test_json_aux_only(self):
+        self.log.info("An auxiliary JSON sink keeps logging enabled on its own")
+        path = self.relative_log_path("aux-only.jsonl")
+        self.restart_node(0, [
+            "-nodebuglogfile", "-printtoconsole=0", f"-debuglogjsonfile={path}",
+        ])
+        height = self.nodes[0].getblockcount() + 1
+        self.generate(self.nodes[0], 1)
+        self.stop_node(0)
+        with open(path, encoding="utf-8") as stream:
+            records = [json.loads(line) for line in stream if line.strip()]
+        assert any("UpdateTip: new best=" in record["message"] and
+                   f"height={height} " in record["message"] for record in records)
+        assert any(record["message"] == "Shutdown: done" for record in records)
+
     def test_json_format(self):
         self.log.info("Test -logformat=json")
         self.stop_node(0)
-- 
