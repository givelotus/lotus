From e30da0072d750c0f2f96c64377172198a21ea4c7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] transaction: cache serialized transaction size

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Cache serialized byte size on CTransaction, batch removeForBlock Merklix overlay
erasures, and eliminate redundant ConnectTip snapshot rebuilds.

Original-Commit: 6e40636b727c24c87f8e6c1b798d59663edd64bc
Original-Patch: ecash/034
Split-Concern: size

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/primitives/transaction.cpp | 4 ----
 src/primitives/transaction.h   | 5 ++++-
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index 48cace2ef0..fb357f6dfd 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -201,10 +201,6 @@ Amount CTransaction::GetValueOut() const {
     return nValueOut;
 }
 
-unsigned int CTransaction::GetTotalSize() const {
-    return ::GetSerializeSize(*this);
-}
-
 std::string CTransaction::ToString() const {
     std::string str;
     str += strprintf("CTransaction(txid=%s, ver=%u, vin.size=%u, vout.size=%u, "
diff --git a/src/primitives/transaction.h b/src/primitives/transaction.h
index 04fa0da46b..47d842743d 100644
--- a/src/primitives/transaction.h
+++ b/src/primitives/transaction.h
@@ -262,7 +262,10 @@ public:
      * Get the total transaction size in bytes.
      * @return Total transaction size in bytes
      */
-    unsigned int GetTotalSize() const;
+    unsigned int GetTotalSize() const {
+        return m_serialize_size > 0 ? m_serialize_size
+                                    : ::GetSerializeSize(*this);
+    }
 
     bool IsCoinBase() const {
         return (vin.size() == 1 && vin[0].prevout.IsNull());
