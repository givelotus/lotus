From 35b1f2a1cabb7c4332867a05dc7c9a4c0584b235 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] transaction: precompute transaction identities and preserve
 cached metadata

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Resolve intra-batch and confirmed inputs in a single pass using the flat
open-addressed txid_table and CCoinsViewCache::PeekCoin, and link mempool
parent iterators in O(1).

Original-Commit: 2e1bd9c9d007e29db509bb92d0b3da0face7da0f
Original-Patch: ecash/039
Split-Concern: hash

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/primitives/transaction.cpp | 69 ++++++++++++++++++++++------------
 src/primitives/transaction.h   |  9 +++--
 2 files changed, 51 insertions(+), 27 deletions(-)

diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index fb357f6dfd..94315eaaca 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -52,28 +52,33 @@ lotus::v2::Output CTxOut::ToV2Output() const {
         lotus::v2::MAX_OUTPUT_BRANCHES * 31 - 2;
     if (scriptPubKey.size() <= kMaxPackedScriptBytes) {
         const uint16_t script_len = static_cast<uint16_t>(scriptPubKey.size());
-        std::vector<uint8_t> packed(2 + script_len);
-        packed[0] = static_cast<uint8_t>(script_len & 0xffU);
-        packed[1] = static_cast<uint8_t>((script_len >> 8U) & 0xffU);
-        if (script_len > 0) {
-            std::copy(scriptPubKey.begin(), scriptPubKey.end(),
-                      packed.begin() + 2);
-        }
+        const size_t total_packed = 2 + static_cast<size_t>(script_len);
         const size_t num_branches =
-            std::max<size_t>(1, (packed.size() + 30) / 31);
+            std::max<size_t>(1, (total_packed + 30) / 31);
         out.branches.resize(num_branches);
+        const uint8_t *raw_script = scriptPubKey.data();
         for (size_t k = 0; k < num_branches; ++k) {
             out.branches[k].fill(0);
-            const size_t offset = k * 31;
-            const size_t chunk =
-                offset < packed.size()
-                    ? std::min<size_t>(31, packed.size() - offset)
-                    : 0;
-            if (chunk > 0) {
-                std::copy_n(packed.data() + offset, chunk,
-                            out.branches[k].data());
+            uint8_t *dst = out.branches[k].data();
+            if (k == 0) {
+                dst[0] = static_cast<uint8_t>(script_len & 0xffU);
+                dst[1] = static_cast<uint8_t>((script_len >> 8U) & 0xffU);
+                const size_t first_chunk =
+                    std::min<size_t>(29, script_len);
+                if (first_chunk > 0) {
+                    std::copy_n(raw_script, first_chunk, dst + 2);
+                }
+            } else {
+                const size_t script_offset = 29 + (k - 1) * 31;
+                const size_t chunk =
+                    script_offset < script_len
+                        ? std::min<size_t>(31, script_len - script_offset)
+                        : 0;
+                if (chunk > 0) {
+                    std::copy_n(raw_script + script_offset, chunk, dst);
+                }
             }
-            out.branches[k][31] = static_cast<uint8_t>(0x81U + k);
+            dst[31] = static_cast<uint8_t>(0x81U + k);
         }
     } else {
         std::vector<uint8_t> script_bytes(scriptPubKey.begin(),
@@ -106,14 +111,26 @@ CTxOut CTxOut::FromV2Output(const lotus::v2::Output &out) {
             const size_t expected_branches =
                 std::max<size_t>(1, (total_packed + 30) / 31);
             if (expected_branches == out.branches.size()) {
-                std::vector<uint8_t> packed(out.branches.size() * 31);
-                for (size_t k = 0; k < out.branches.size(); ++k) {
-                    std::copy_n(out.branches[k].data(), 31,
-                                packed.data() + k * 31);
+                CScript script;
+                script.resize(script_len);
+                uint8_t *dst = script.data();
+                const size_t first_chunk =
+                    std::min<size_t>(29, script_len);
+                if (first_chunk > 0) {
+                    std::copy_n(out.branches[0].data() + 2, first_chunk, dst);
                 }
-                return CTxOut(
-                    val, CScript(packed.begin() + 2,
-                                 packed.begin() + 2 + script_len));
+                for (size_t k = 1; k < out.branches.size(); ++k) {
+                    const size_t script_offset = 29 + (k - 1) * 31;
+                    const size_t chunk =
+                        script_offset < script_len
+                            ? std::min<size_t>(31, script_len - script_offset)
+                            : 0;
+                    if (chunk > 0) {
+                        std::copy_n(out.branches[k].data(), chunk,
+                                    dst + script_offset);
+                    }
+                }
+                return CTxOut(val, std::move(script));
             }
         }
     }
@@ -127,6 +144,10 @@ CTxOut CTxOut::FromV2Output(const lotus::v2::Output &out) {
     return CTxOut(val, std::move(script));
 }
 
+CTxOut CTxOut::FromV2Output(lotus::v2::Output &&out) {
+    return FromV2Output(static_cast<const lotus::v2::Output &>(out));
+}
+
 std::string CTxOut::ToString() const {
     const Amount xec = 100 * SATOSHI;
     return strprintf("CTxOut(nValue=%d.%02d, scriptPubKey=%s)", nValue / xec,
diff --git a/src/primitives/transaction.h b/src/primitives/transaction.h
index 47d842743d..eae693e66d 100644
--- a/src/primitives/transaction.h
+++ b/src/primitives/transaction.h
@@ -102,10 +102,12 @@ public:
 
     explicit CTxIn(COutPoint prevoutIn, CScript scriptSigIn = CScript(),
                    uint32_t nSequenceIn = SEQUENCE_FINAL)
-        : prevout(prevoutIn), scriptSig(scriptSigIn), nSequence(nSequenceIn) {}
+        : prevout(prevoutIn), scriptSig(std::move(scriptSigIn)),
+          nSequence(nSequenceIn) {}
     CTxIn(TxId prevTxId, uint32_t nOut, CScript scriptSigIn = CScript(),
           uint32_t nSequenceIn = SEQUENCE_FINAL)
-        : CTxIn(COutPoint(prevTxId, nOut), scriptSigIn, nSequenceIn) {}
+        : CTxIn(COutPoint(prevTxId, nOut), std::move(scriptSigIn),
+                nSequenceIn) {}
 
     SERIALIZE_METHODS(CTxIn, obj) {
         READWRITE(obj.prevout, obj.scriptSig, obj.nSequence);
@@ -137,7 +139,7 @@ public:
     CTxOut() { SetNull(); }
 
     CTxOut(Amount nValueIn, CScript scriptPubKeyIn)
-        : nValue(nValueIn), scriptPubKey(scriptPubKeyIn) {}
+        : nValue(nValueIn), scriptPubKey(std::move(scriptPubKeyIn)) {}
 
     SERIALIZE_METHODS(CTxOut, obj) { READWRITE(obj.nValue, obj.scriptPubKey); }
 
@@ -158,6 +160,7 @@ public:
 
     lotus::v2::Output ToV2Output() const;
     static CTxOut FromV2Output(const lotus::v2::Output &out);
+    static CTxOut FromV2Output(lotus::v2::Output &&out);
 
     std::string ToString() const;
 };
