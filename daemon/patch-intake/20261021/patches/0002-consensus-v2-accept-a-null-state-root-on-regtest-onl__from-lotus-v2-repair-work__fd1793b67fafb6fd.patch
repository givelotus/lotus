From cc88bb70c626eed4e9d76ea0357d6ecc52c1fc6d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:36:50 -0700
Subject: [PATCH 2/3] consensus(v2): accept a null state root on regtest only

ConnectBlock skipped the hashStateRoot check when the root was null and
the network allowed min-difficulty blocks. That rule is true on testnet
as well as regtest, so a testnet block could omit its state commitment
entirely and every testnet node would accept it.

The allowance is now its own consensus parameter, allowNullStateRoot,
true on regtest only. Regtest keeps it because the functional test
framework builds blocks in Python (create_block, used by about 70
tests) and cannot compute the sparse-Merkle state root; -strictstateroot
still turns it off there. Mainnet and testnet always check the root.

v2_finality_tests validates a template block with its real root and with
a null root under testnet parameters (the null root fails before this
change) and checks that regtest still accepts the null root.

Tier: V2 (fixup to v2/032)
---
 src/consensus/params.h         |  6 +++++
 src/init.cpp                   |  6 ++---
 src/kernel/chainparams.cpp     |  1 +
 src/test/v2_finality_tests.cpp | 40 ++++++++++++++++++++++++++++++++++
 src/validation.cpp             |  2 +-
 5 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/src/consensus/params.h b/src/consensus/params.h
index 6848c512dd..5de30e3d09 100644
--- a/src/consensus/params.h
+++ b/src/consensus/params.h
@@ -68,6 +68,12 @@ struct Params {
     /** Proof of work parameters */
     uint256 powLimit;
     bool fPowAllowMinDifficultyBlocks;
+    /**
+     * Accept a block whose V2 hashStateRoot is null without checking it.
+     * Regtest only: blocks built by the functional test framework cannot
+     * compute the state root. -strictstateroot turns it off.
+     */
+    bool allowNullStateRoot{false};
     bool fPowNoRetargeting;
     int64_t nDAAHalfLife;
     int64_t nPowTargetSpacing;
diff --git a/src/init.cpp b/src/init.cpp
index 50fa1573bb..69f7cf33dc 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -775,9 +775,9 @@ void SetupServerArgs(NodeContext &node) {
                              DEFAULT_TXINDEX),
                    ArgsManager::ALLOW_ANY, OptionsCategory::OPTIONS);
     argsman.AddArg("-strictstateroot",
-                   "Require non-null V2 block state root even on regtest "
-                   "(default: 0 on regtest, always enforced on mainnet/testnet "
-                   "and whenever hashStateRoot is non-null)",
+                   "Require a non-null V2 block state root on regtest too "
+                   "(default: 0; the root is always required on mainnet and "
+                   "testnet, and always checked when it is non-null)",
                    ArgsManager::ALLOW_ANY | ArgsManager::DEBUG_ONLY,
                    OptionsCategory::DEBUG_TEST);
 #if ENABLE_CHRONIK
diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index c4c39558ce..7b4be7e9d3 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -426,6 +426,7 @@ public:
         consensus.nPowTargetTimespan = 14 * 24 * 60 * 60;
         consensus.nPowTargetSpacing = 2 * 60;
         consensus.fPowAllowMinDifficultyBlocks = true;
+        consensus.allowNullStateRoot = true;
         consensus.fPowNoRetargeting = true;
 
         // two days
diff --git a/src/test/v2_finality_tests.cpp b/src/test/v2_finality_tests.cpp
index ab8e57cf79..93cb064586 100644
--- a/src/test/v2_finality_tests.cpp
+++ b/src/test/v2_finality_tests.cpp
@@ -8,8 +8,12 @@
 #include <consensus/validation.h>
 #include <chain.h>
 #include <validation.h>
+#include <config.h>
+#include <node/miner.h>
 #include <primitives/transaction.h>
+#include <timedata.h>
 
+#include <test/util/mining.h>
 #include <test/util/setup_common.h>
 
 #include <boost/test/unit_test.hpp>
@@ -68,4 +72,40 @@ BOOST_AUTO_TEST_CASE(v7_relative_lock_points_at_tip) {
     }
 }
 
+namespace {
+struct TestNetSetup : public TestingSetup {
+    TestNetSetup() : TestingSetup(ChainType::TESTNET) {}
+};
+struct RegTestSetup : public TestingSetup {
+    RegTestSetup() : TestingSetup(ChainType::REGTEST) {}
+};
+
+std::string ValidateWithStateRoot(node::NodeContext &node, bool null_root) {
+    std::shared_ptr<CBlock> block =
+        PrepareBlock(GetConfig(), node, CScript() << OP_TRUE);
+    if (null_root) block->hashStateRoot.SetNull();
+    LOCK(cs_main);
+    Chainstate &chainstate = node.chainman->ActiveChainstate();
+    BlockValidationState state;
+    const bool ok = TestBlockValidity(
+        state, GetConfig().GetChainParams(), chainstate, *block,
+        node.chainman->ActiveTip(), GetAdjustedTime,
+        BlockValidationOptions(GetConfig()).withCheckPoW(false));
+    return ok ? "valid" : state.GetRejectReason();
+}
+} // namespace
+
+// Only regtest may skip the state root check for a null root (blocks built by
+// the functional test framework). Testnet, which shares regtest's
+// min-difficulty rule, must check it like mainnet.
+BOOST_FIXTURE_TEST_CASE(null_state_root_rejected_on_testnet, TestNetSetup) {
+    BOOST_CHECK_EQUAL(ValidateWithStateRoot(m_node, false), "valid");
+    BOOST_CHECK_EQUAL(ValidateWithStateRoot(m_node, true),
+                      "bad-blk-stateroot");
+}
+
+BOOST_FIXTURE_TEST_CASE(null_state_root_accepted_on_regtest, RegTestSetup) {
+    BOOST_CHECK_EQUAL(ValidateWithStateRoot(m_node, true), "valid");
+}
+
 BOOST_AUTO_TEST_SUITE_END()
