-void V2PeerProtocolHandler::SetScopedTransactions(
+bool V2PeerProtocolHandler::SetScopedTransactions(
     ReconScope scope, const uint256 &context_id,
     std::vector<CTransactionRef> txs) {
+    // Reject before sorting, copying, or hashing untrusted collections. An
+    // overflow is an unsupported complete scope, never a partial commitment.
+    if (txs.size() > MAX_SCOPED_TXS) return false;
+    size_t bytes = 0;
+    for (const auto &tx : txs) {
+        if (!tx) continue;
+        bytes += GetSerializeSize(*tx);
+        if (bytes > MAX_SCOPED_TX_BYTES) return false;
+    }
     ScopedTxSetEntry entry;
+    entry.bytes = bytes;
     entry.txs = NormalizeCtorTxList(txs);
     entry.subtree_a_root = ComputeSubtreeAHash(entry.txs);
     LOCK(m_mutex);
     const ScopeKey key{scope, context_id};
-    if (m_scoped_txs.find(key) == m_scoped_txs.end() &&
-        m_scoped_txs.size() >= MAX_TRACKED_RECON_SCOPES) {
+    const auto previous = m_scoped_txs.find(key);
+    const size_t old_bytes = previous == m_scoped_txs.end() ? 0 : previous->second.bytes;
+    if (m_scoped_cache_bytes - old_bytes + bytes > MAX_SCOPED_CACHE_BYTES) return false;
+    if (previous == m_scoped_txs.end() && m_scoped_txs.size() >= MAX_TRACKED_RECON_SCOPES) {
+        m_scoped_cache_bytes -= m_scoped_txs.begin()->second.bytes;
         m_scoped_txs.erase(m_scoped_txs.begin());
     }
+    m_scoped_cache_bytes = m_scoped_cache_bytes - old_bytes + bytes;
     m_scoped_txs[key] = std::move(entry);
+    return true;
 }
 
