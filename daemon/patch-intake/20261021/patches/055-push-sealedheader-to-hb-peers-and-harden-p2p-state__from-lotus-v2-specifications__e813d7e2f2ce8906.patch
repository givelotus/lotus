+bool V2PeerProtocolHandler::HasPendingShortTxRequests(NodeId peer_id) const {
+    LOCK(m_mutex);
+    for (const auto &[key, entry] : m_pending_shorttx_requests) {
+        if (key.peer_id == peer_id && !entry.requested_short_ids.empty()) {
