From 4147b820f00bcbf699ed771ce9596bb75115fe74 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 03:38:34 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

Capture structured source_location at the EventBuilder caller, outside the constexpr descriptor lambda. The old descriptor reported the lambda operator rather than the function that logged. Keep descriptors constant-initialized and avoid adding a dynamically guarded static.

Causal generic JSON regression fails before with test_method()::(anonymous class)::operator() and passes after with the actual test_method. All 32 logging/event tests pass, including the GCP metadata check that exposed it. Actual file-sink functional tests also pass. The GCP format itself remains a separate uncommitted change.
---
 src/logging.cpp                  |  7 ++++---
 src/logging/event.h              | 12 +++++++-----
 src/test/logging_event_tests.cpp |  9 +++++++++
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/src/logging.cpp b/src/logging.cpp
index 0f6c34fac2..898492efce 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -974,7 +974,7 @@ void BCLog::Logger::BeginEvent(EventBuilder &b) noexcept {
             ring->m_open_line = false;
         }
     }
-    FillRecordHeader(*rec, site.loc, site.category, site.level);
+    FillRecordHeader(*rec, b.m_source_loc, site.category, site.level);
     rec->event = &site;
     b.m_rec = rec;
 }
@@ -1041,8 +1041,9 @@ void BCLog::Logger::EndEvent(EventBuilder &b) noexcept {
 }
 
 BCLog::EventBuilder::EventBuilder(const LogEventSite &site,
-                                  LogSiteLimit *limit) noexcept
-    : m_site{site}, m_limit{limit} {
+                                  LogSiteLimit *limit,
+                                  std::source_location loc) noexcept
+    : m_site{site}, m_limit{limit}, m_source_loc{loc} {
     LogInstance().BeginEvent(*this);
 }
 
diff --git a/src/logging/event.h b/src/logging/event.h
index 26710d956f..8b92f9744a 100644
--- a/src/logging/event.h
+++ b/src/logging/event.h
@@ -62,7 +62,6 @@ struct LogEventSite {
     const char *message;
     LogFlags category;
     Level level;
-    std::source_location loc;
 };
 
 namespace detail {
@@ -196,7 +195,9 @@ template <typename T> struct LogRef;
 /** Builds one structured log record; see the file comment */
 class EventBuilder {
 public:
-    EventBuilder(const LogEventSite &site, LogSiteLimit *limit) noexcept;
+    EventBuilder(
+        const LogEventSite &site, LogSiteLimit *limit,
+        std::source_location loc = std::source_location::current()) noexcept;
     ~EventBuilder();
     EventBuilder(const EventBuilder &) = delete;
     EventBuilder &operator=(const EventBuilder &) = delete;
@@ -299,6 +300,8 @@ private:
     friend class Logger;
     const LogEventSite &m_site;
     LogSiteLimit *const m_limit;
+    //! Captured at the caller, outside the descriptor's constexpr lambda.
+    const std::source_location m_source_loc;
     //! The slot being filled (in the thread's ring, or m_buffered)
     LogRecord *m_rec{nullptr};
     LogRing *m_ring{nullptr};
@@ -338,13 +341,12 @@ void AppendEventMessage(std::string &out, const LogEventSite &site,
 
 /**
  * The site description of the call site this is expanded at, a constant
- * (category, level, event name, message template and source location).
+ * (category, level, event name and message template).
  */
 #define LOG_EVENT_SITE_(category, level, event, ...)                           \
     ([]() -> const BCLog::LogEventSite & {                                     \
         static constexpr BCLog::LogEventSite site{                             \
-            event, BCLog::detail::EventMessage(__VA_ARGS__), category, level,  \
-            std::source_location::current()};                                  \
+            event, BCLog::detail::EventMessage(__VA_ARGS__), category, level}; \
         return site;                                                           \
     }())
 
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index c2b197bc7a..9f08141a0f 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -268,4 +268,13 @@ BOOST_AUTO_TEST_CASE(json_event_name_escaping) {
     BOOST_CHECK_EQUAL(record["message"].get_str(), "event message");
 }
 
+BOOST_AUTO_TEST_CASE(structured_source_caller) {
+    Format(BCLog::LogFormat::JSON);
+    LogInstance().m_log_sourcelocations = true;
+    LogEvent(BCLog::NET, "caller_location");
+    const auto record{Json()};
+    BOOST_CHECK_EQUAL(record["source"]["function"].get_str(),
+                      "logging_event_tests::structured_source_caller::test_method");
+}
+
 BOOST_AUTO_TEST_SUITE_END()
-- 
