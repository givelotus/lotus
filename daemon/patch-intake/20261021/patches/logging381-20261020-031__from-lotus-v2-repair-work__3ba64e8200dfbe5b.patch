From d1a6bb6fe99eba42ac04796871e5414ef0a140ad Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 12:08:24 -0700
Subject: [PATCH] logging: structure transaction-index disk-read failure stages

Preserve the four existing Error sites, their readable diagnostics and
FindTx false returns. Name open, seek, deserialization and txid mismatch
stages independently; copy exception text through the registered Error key.
No new producer fields, serialization changes or transaction material.

Scripted diff (ast-grep-py 0.51.0; reviewed exact call/argument catalog):
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/transaction-index-read-failures.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/txindex-194-dryrun.json
  /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/transaction-index-read-failures.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/txindex-194-apply.json --apply
  git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/index/txindex.cpp src/test/txindex_tests.cpp

The hand-written focused regression seeds only isolated txindex records and
calls real FindTx paths for missing block file, EOF/deserialization and a
valid transaction under the wrong txid. It checks unchanged failure returns,
text and typed JSON after flushing the logger. Assertions run on the test
thread, not the asynchronous callback. Regular-file fseek failure is not
forced; its producer/control-flow equivalence is checked by the catalog.

Validation at commit: production event lint 402 sites, AST catalog replay
and idempotence, and diff whitespace pass. New native case is source-ready,
not yet compiled/run; immutable first190 native checkpoint remains valid.
Tier: shared eCash; V2 inherits. No public header or API changes.
---
 .../transaction-index-read-failures.json      | 82 +++++++++++++++++++
 src/index/txindex.cpp                         | 18 +++-
 src/test/txindex_tests.cpp                    | 82 +++++++++++++++++++
 3 files changed, 178 insertions(+), 4 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/transaction-index-read-failures.json

diff --git a/contrib/logging/conversion/rules/transaction-index-read-failures.json b/contrib/logging/conversion/rules/transaction-index-read-failures.json
new file mode 100644
index 0000000000000000000000000000000000000000..012aa576593dfbe0579195be7ee9059f854ad18f
--- /dev/null
+++ b/contrib/logging/conversion/rules/transaction-index-read-failures.json
@@ -0,0 +1,82 @@
+{
+  "schema": 1,
+  "batch": "transaction-index-read-failures",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/index/txindex.cpp",
+      "rules": [
+        {
+          "id": "transaction_index_block_file_open_failed",
+          "old": "LogError(\"%s: OpenBlockFile failed\\n\", __func__)",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"transaction_index_block_file_open_failed\", \"{source_function}: OpenBlockFile failed\").Field(BCLog::LogField::SourceFunction, __func__)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "%s: OpenBlockFile failed\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "__func__"
+            ]
+          },
+          "review_note": "Preserve each distinct read-failure stage, Error level, original terse diagnostics and false return. No new transaction/key material and no added hot-path arguments. No public registry/API changes."
+        },
+        {
+          "id": "transaction_index_block_file_seek_failed",
+          "old": "LogError(\"%s: fseek(...) failed\\n\", __func__)",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"transaction_index_block_file_seek_failed\", \"{source_function}: fseek(...) failed\").Field(BCLog::LogField::SourceFunction, __func__)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "%s: fseek(...) failed\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "__func__"
+            ]
+          },
+          "review_note": "Preserve each distinct read-failure stage, Error level, original terse diagnostics and false return. No new transaction/key material and no added hot-path arguments. No public registry/API changes."
+        },
+        {
+          "id": "transaction_index_block_read_failed",
+          "old": "LogError(\"%s: Deserialize or I/O error - %s\\n\", __func__, e.what())",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"transaction_index_block_read_failed\", \"{source_function}: Deserialize or I/O error - {error}\").Field(BCLog::LogField::SourceFunction, __func__).Field(BCLog::LogField::Error, e.what())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "%s: Deserialize or I/O error - %s\n",
+            "specifiers": [
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "__func__",
+              "e.what()"
+            ]
+          },
+          "review_note": "Preserve each distinct read-failure stage, Error level, original terse diagnostics and false return. No new transaction/key material and no added hot-path arguments. No public registry/API changes."
+        },
+        {
+          "id": "transaction_index_txid_mismatch",
+          "old": "LogError(\"%s: txid mismatch\\n\", __func__)",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"transaction_index_txid_mismatch\", \"{source_function}: txid mismatch\").Field(BCLog::LogField::SourceFunction, __func__)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "%s: txid mismatch\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "__func__"
+            ]
+          },
+          "review_note": "Preserve each distinct read-failure stage, Error level, original terse diagnostics and false return. No new transaction/key material and no added hot-path arguments. No public registry/API changes."
