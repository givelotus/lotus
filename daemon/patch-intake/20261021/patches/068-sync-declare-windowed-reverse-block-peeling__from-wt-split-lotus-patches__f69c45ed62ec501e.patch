From 3e04287a00af64cbd9e98cd01c53e2ea874875ce Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] sync: declare windowed reverse block peeling

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Add multi-block windowed reverse peeling (PeelDiskBlockWindowReverse),
reuse cached base_self digests in ExportSmtNode, and expose the
-prunefinalized=<n> finality undo horizon option.

Original-Commit: 1eb9935fb36e2cd480dd209196b60003da777541
Original-Patch: ecash/041
Split-Concern: peel

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/lotus_v2/fast_sync.h | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/lotus_v2/fast_sync.h b/src/lotus_v2/fast_sync.h
index 4d14ddd1e15157ca7b94052d10ca0f18b15f5c09..0b882763c0a7576fb9cf63704b432fa0a8ef4544 100644
--- a/src/lotus_v2/fast_sync.h
+++ b/src/lotus_v2/fast_sync.h
@@ -223,6 +223,25 @@ bool VerifyAndPeelReverseBlock(
     const std::optional<Hash> &expected_parent_utxo_root,
     Hash &out_parent_utxo_root, std::string &error);
 
+struct ReversePeelBlockStep {
+    std::vector<uint8_t> block_wire;
+    BlockUndoMessage undo_msg;
+    Header parent_header{};
+    std::vector<Header> history;
+};
+
+// Peels a contiguous window of K blocks [h, h - 1, ..., h - K + 1] backwards in
+// RAM with full cryptographic verification at every intermediate height,
+// cancelling cross-block ephemeral UTXOs in memory and committing the net delta
+// to DiskStateStore in a single batch.
+bool PeelDiskBlockWindowReverse(const std::vector<ReversePeelBlockStep> &steps,
+                                const HeaderChainProfile &header_profile,
+                                OrdinaryCandidateProfile ordinary_profile,
+                                const MonetaryProfile &monetary_profile,
+                                const BlockCostProfile &cost_profile,
+                                DiskStateStore &store,
+                                std::string &error);
+
 } // namespace lotus::v2
 
 #endif // LOTUS_V2_FAST_SYNC_H
