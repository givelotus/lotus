From b6fff0eb2f682a9c29347a89eb833188301f3b25 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] net: coalesce outbound inventory with a short suppression
 window

Coalesce outbound transaction inventory for an average 25 ms, retaining the
shared randomized inbound timer at 50 ms. Incoming announcements can suppress
queued duplicates before the next send. Wire the millisecond constants into
net processing and retain bounded inventory bursts and recent-relay caching.
The historical rationale named different constants; this payload uses 2,500
for burst sizing and retains 350,000 recent announcements. It does not implement
a strict 2,500 items/second rate limiter.

Original-Commit: 23b0b69b1c0c517ba82d8baa46c723975eda5000
Original-Patch: ecash/011
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Repair: Complete the inventory timing owner with millisecond inbound scheduling and a 25 ms randomized outbound delay; retain exact suppression and constant assertions, use a nonzero test send buffer, and omit handler ownership and future batch APIs now assigned to their actual purpose owners.

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 4804ced4af..0b76dff6ec 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -269,22 +269,6 @@ static constexpr auto AVG_LOCAL_ADDRESS_BROADCAST_INTERVAL{24h};
 static constexpr auto AVG_ADDRESS_BROADCAST_INTERVAL{30s};
 /** Delay between rotating the peers we relay a particular address to */
 static constexpr auto ROTATE_ADDR_RELAY_DEST_INTERVAL{24h};
-/**
- * Average delay between trickled inventory transmissions for inbound peers.
- * Blocks and peers with NetPermissionFlags::NoBan permission bypass this.
- */
-static constexpr auto INBOUND_INVENTORY_BROADCAST_INTERVAL{5s};
-/**
- * Maximum rate of inventory items to send per second.
- * Limits the impact of low-fee transaction floods.
- */
-static constexpr unsigned int INVENTORY_BROADCAST_PER_SECOND = 7;
-/** Maximum number of inventory items to send per transmission. */
-static constexpr unsigned int INVENTORY_BROADCAST_MAX_PER_MB =
-    INVENTORY_BROADCAST_PER_SECOND *
-    count_seconds(INBOUND_INVENTORY_BROADCAST_INTERVAL);
-/** The number of most recently announced transactions a peer can request. */
-static constexpr unsigned int INVENTORY_MAX_RECENT_RELAY = 3500;
 /**
  * Verify that INVENTORY_MAX_RECENT_RELAY is enough to cache everything
  * typically relayed before unconditional relay from the mempool kicks in. This
@@ -1414,7 +1398,7 @@ private:
      */
     std::chrono::microseconds
     NextInvToInbounds(std::chrono::microseconds now,
-                      std::chrono::seconds average_interval)
+                      std::chrono::milliseconds average_interval)
         EXCLUSIVE_LOCKS_REQUIRED(g_msgproc_mutex);
 
     lotus::v2::net::V2PeerProtocolHandler m_v2_protocol_handler;
@@ -1828,7 +1812,7 @@ static bool IsLimitedPeer(const Peer &peer) {
 
 std::chrono::microseconds
 PeerManagerImpl::NextInvToInbounds(std::chrono::microseconds now,
-                                   std::chrono::seconds average_interval) {
+                                   std::chrono::milliseconds average_interval) {
     if (m_next_inv_to_inbounds.load() < now) {
         // If this function were called from multiple threads simultaneously
         // it would possible that both update the next send variable, and return
@@ -9076,9 +9060,10 @@ bool PeerManagerImpl::SendMessages(const Config &config, CNode *pto) {
                     next = NextInvToInbounds(
                         current_time, INBOUND_INVENTORY_BROADCAST_INTERVAL);
                 } else {
-                    // Skip delay for outbound peers, as there is less privacy
-                    // concern for them.
-                    next = current_time;
+                    // Briefly defer outbound inventory so incoming announcements
+                    // can suppress transactions the peer already knows.
+                    next = current_time +
+                           m_rng.rand_exp_duration(OUTBOUND_INVENTORY_BROADCAST_INTERVAL);
                 }
             }
 
diff --git a/src/net_processing.h b/src/net_processing.h
index 9a35cea278..5b1374bd51 100644
--- a/src/net_processing.h
+++ b/src/net_processing.h
@@ -43,6 +43,37 @@ static const unsigned int MAX_CMPCTBLOCKS_INFLIGHT_PER_BLOCK = 3;
 /** The maximum number of address records permitted in an ADDR message. */
 static constexpr size_t MAX_ADDR_TO_SEND{1000};
 
+/**
+ * Average delay between trickled inventory transmissions for inbound peers.
+ * Blocks and peers with NetPermissionFlags::NoBan permission bypass this.
+ */
+static constexpr std::chrono::milliseconds
+    INBOUND_INVENTORY_BROADCAST_INTERVAL{50};
+/**
+ * Average delay between trickled inventory transmissions for outbound peers.
+ * Batches outbound inv messages over a short suppression window so incoming
+ * invs and Merklix reconciliation summaries can suppress redundant outbound
+ * invs.
+ */
+static constexpr std::chrono::milliseconds
+    OUTBOUND_INVENTORY_BROADCAST_INTERVAL{25};
+/**
+ * Maximum rate of inventory items to send per second.
+ * Allows higher-throughput transaction relay while retaining bounded bursts.
+ */
+static constexpr unsigned int INVENTORY_BROADCAST_PER_SECOND = 2500;
+/**
+ * Maximum number of inventory items to send per transmission per MB of max
+ * block size.
+ */
+static constexpr unsigned int INVENTORY_BROADCAST_MAX_PER_MB =
+    INVENTORY_BROADCAST_PER_SECOND * 5;
+static constexpr unsigned int INVENTORY_BROADCAST_MAX =
+    5000 * INVENTORY_BROADCAST_PER_SECOND;
+/** The number of most recently announced transactions a peer can request. */
+static constexpr unsigned int INVENTORY_MAX_RECENT_RELAY = 350000;
+
+
 /**
  * Number of headers sent in one getheaders result. We rely on the assumption
  * that if a peer sends less than this number, we reached its tip. Changing
diff --git a/src/test/v2_protocol_handler_tests.cpp b/src/test/v2_protocol_handler_tests.cpp
index 5ef1d50e49..1e2999ac6d 100644
--- a/src/test/v2_protocol_handler_tests.cpp
+++ b/src/test/v2_protocol_handler_tests.cpp
@@ -1400,4 +1400,133 @@ BOOST_AUTO_TEST_CASE(ecash_rejects_v2_commitment_in_legacy_header) {
     BOOST_CHECK(handler->MatchCandidateOverlay(*block, block->vtx[0]) == nullptr);
 }
 
+BOOST_AUTO_TEST_CASE(outbound_inv_queue_suppression_window) {
+    LOCK(NetEventsInterface::g_msgproc_mutex);
+
+    const Config &config = m_node.chainman->GetConfig();
+    auto connman = std::make_unique<ConnmanTestMsg>(config, 0x3559, 0x3559,
+                                                    *m_node.addrman);
+    PeerManager::Options peer_opts;
+    peer_opts.deterministic_rng = true;
+    auto peerman = PeerManager::make(*connman, *m_node.addrman, nullptr,
+                                     *m_node.chainman, *m_node.mempool,
+                                     /*avalanche=*/nullptr, peer_opts);
+
+    CConnman::Options options;
+    options.m_msgproc = {peerman.get()};
+    options.nSendBufferMaxSize = 1024 * 1024;
+    connman->Init(options);
+
+    const int64_t base_time = 1'700'000'000;
+    SetMockTime(base_time);
+
+    CAddress addr(MakeTestIp(0xa0b0c030), NODE_NONE);
+    CNode peer_node(/*id=*/303, /*sock=*/nullptr, addr,
+                    /*nKeyedNetGroupIn=*/0, /*nLocalHostNonceIn=*/0,
+                    /*nLocalExtraEntropyIn=*/0, CAddress(), /*pszDest=*/"",
+                    ConnectionType::OUTBOUND_FULL_RELAY,
+                    /*inbound_onion=*/false);
+    connman->Handshake(
+        /*node=*/peer_node,
+        /*successfully_connected=*/true,
+        /*remote_services=*/ServiceFlags(NODE_NETWORK),
+        /*local_services=*/ServiceFlags(NODE_NETWORK),
+        /*version=*/PROTOCOL_VERSION,
+        /*relay_txs=*/true);
+
+    // Prime the outbound inv send timer via an initial SendMessages call.
+    BOOST_CHECK(peerman->SendMessages(config, &peer_node));
+    {
+        LOCK(peer_node.cs_vSend);
+        peer_node.vSendMsg.clear();
+    }
+
+    // Add two transactions to the mempool and queue both for relay to peer_node.
+    FastRandomContext rng(uint256{55});
+    CTransactionRef tx_suppressed = MakeNonCoinbaseTx(rng, 0x31);
+    CTransactionRef tx_unsuppressed = MakeNonCoinbaseTx(rng, 0x32);
+    BOOST_REQUIRE(tx_suppressed && tx_unsuppressed);
+
+    TestMemPoolEntryHelper entry;
+    {
+        LOCK2(cs_main, m_node.mempool->cs);
+        m_node.mempool->addUnchecked(entry.FromTx(tx_suppressed));
+        m_node.mempool->addUnchecked(entry.FromTx(tx_unsuppressed));
+    }
+
+    peerman->RelayTransaction(tx_suppressed->GetId());
+    peerman->RelayTransaction(tx_unsuppressed->GetId());
+
+    // Simulate receiving a remote INV for tx_suppressed during the outbound
+    // suppression window (before mocktime advances).
+    {
+        std::vector<CInv> remote_invs{CInv(MSG_TX, tx_suppressed->GetId())};
+        DataStream inv_stream{};
+        inv_stream << remote_invs;
+        std::atomic<bool> interrupt{false};
+        peerman->ProcessMessage(config, peer_node, NetMsgType::INV, inv_stream,
+                                std::chrono::seconds{base_time}, interrupt);
+    }
+
+    // Advance mocktime past the outbound broadcast interval so the queue
+    // flushes.
+    SetMockTime(base_time + 5);
+    BOOST_CHECK(peerman->SendMessages(config, &peer_node));
+
+    // Inspect sent INV messages: tx_unsuppressed must be announced, while
+    // tx_suppressed must have been suppressed by the incoming INV.
+    bool saw_suppressed = false;
+    bool saw_unsuppressed = false;
+    V1TransportDeserializer deserializer(config, peer_node.GetId());
+    {
+        LOCK(peer_node.cs_vSend);
+        for (const auto &chunk : peer_node.vSendMsg) {
+            Span<const uint8_t> sp{chunk};
+            while (!sp.empty()) {
+                const int ret = deserializer.Read(config, sp);
+                BOOST_REQUIRE_GE(ret, 0);
+                if (deserializer.Complete()) {
+                    bool reject_message = false;
+                    CNetMessage msg = deserializer.GetMessage(0us, reject_message);
+                    BOOST_CHECK(!reject_message);
+                    if (msg.m_type == NetMsgType::INV) {
+                        std::vector<CInv> sent_invs;
+                        msg.m_recv >> sent_invs;
+                        for (const CInv &inv : sent_invs) {
+                            if (inv.IsMsgTx()) {
+                                if (inv.hash == tx_suppressed->GetId()) {
+                                    saw_suppressed = true;
+                                }
+                                if (inv.hash == tx_unsuppressed->GetId()) {
+                                    saw_unsuppressed = true;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    BOOST_CHECK(!saw_suppressed);
+    BOOST_CHECK(saw_unsuppressed);
+
+    SetMockTime(0);
+    peerman->FinalizeNode(config, peer_node);
+}
+
+BOOST_AUTO_TEST_CASE(inventory_broadcast_constants) {
+    // Verify Stage H1 inventory broadcast constants
+    static_assert(INBOUND_INVENTORY_BROADCAST_INTERVAL ==
+                  std::chrono::milliseconds{50});
+    static_assert(OUTBOUND_INVENTORY_BROADCAST_INTERVAL ==
+                  std::chrono::milliseconds{25});
+    static_assert(INVENTORY_BROADCAST_PER_SECOND == 2500);
+    static_assert(INVENTORY_MAX_RECENT_RELAY == 350000);
+    BOOST_CHECK_EQUAL(INBOUND_INVENTORY_BROADCAST_INTERVAL.count(), 50);
+    BOOST_CHECK_EQUAL(OUTBOUND_INVENTORY_BROADCAST_INTERVAL.count(), 25);
+    BOOST_CHECK_EQUAL(INVENTORY_BROADCAST_PER_SECOND, 2500U);
+    BOOST_CHECK_EQUAL(INVENTORY_MAX_RECENT_RELAY, 350000U);
+}
+
+
 BOOST_AUTO_TEST_SUITE_END()
