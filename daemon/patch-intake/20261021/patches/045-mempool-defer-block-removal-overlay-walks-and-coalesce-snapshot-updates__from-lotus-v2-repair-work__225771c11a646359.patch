From 4060db773c9654fa8978002686c1d4349c470d38 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] mempool: defer block-removal overlay walks and coalesce
 snapshot updates

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Cache serialized byte size on CTransaction, batch removeForBlock Merklix overlay
erasures, and eliminate redundant ConnectTip snapshot rebuilds.

Original-Commit: 6e40636b727c24c87f8e6c1b798d59663edd64bc
Original-Patch: ecash/034
Split-Concern: overlay

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Application-Repair: Preserve the original deferred removal/rebuild algorithm and pending-removal field. Reconcile only the existing defer-depth name and retain COW changed-entry tracking and complete scope-exit flush; the current tip adapter already flushes pending changes before reanchor, so omit duplicate pre-reanchor flush code.

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index cc5dfbbb6bcbee8c2e99e8d36b8265aa7c018111..e7b87701dc2de9f52cc05c0089e7579f44afeef6 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -237,8 +237,13 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     const CTransaction &tx = (*it)->GetTx();
     const TxId &txid = tx.GetId();
     MarkSnapshotEntryChanged(txid);
-    FlushPendingOverlayAdds();
-    RemoveTransactionFromOverlay(m_merklix_overlay, (*it)->GetTx());
+
+    if (m_snapshot_defer_depth > 0) {
+        m_pending_overlay_removes.push_back(txid);
+    } else {
+        FlushPendingOverlayAdds();
+        RemoveTransactionFromOverlay(m_merklix_overlay, tx);
+    }
 
     if (reason != MemPoolRemovalReason::BLOCK) {
         if (m_opts.signals) {
@@ -420,6 +425,7 @@ void CTxMemPool::_clear() {
     m_snapshot_changed_entries.clear();
     m_snapshot_needs_reset = true;
     m_pending_overlay_adds.clear();
+    m_pending_overlay_removes.clear();
     m_merklix_overlay.Clear();
     mapTx.clear();
     mapNextTx.clear();
@@ -435,10 +441,45 @@ void CTxMemPool::_clear() {
 
 void CTxMemPool::FlushPendingOverlayAdds() const {
     AssertLockHeld(cs);
-    if (m_pending_overlay_adds.empty()) return;
-    auto pending = std::move(m_pending_overlay_adds);
-    m_pending_overlay_adds.clear();
-    AddTransactionsToOverlayBatch(m_merklix_overlay, pending);
+    if (m_pending_overlay_adds.empty() && m_pending_overlay_removes.empty()) {
+        return;
+    }
+    if (!m_pending_overlay_removes.empty()) {
+        if (mapTx.empty()) {
+            m_pending_overlay_adds.clear();
+            m_pending_overlay_removes.clear();
+            m_merklix_overlay.Clear();
+            return;
+        }
+        if (m_pending_overlay_removes.size() >= mapTx.size()) {
+            m_pending_overlay_adds.clear();
+            m_pending_overlay_removes.clear();
+            m_merklix_overlay.Clear();
+            std::vector<std::tuple<CTransactionRef, int64_t, int64_t>> remaining;
+            remaining.reserve(mapTx.size());
+            for (const auto &entry : mapTx.get<entry_id>()) {
+                remaining.emplace_back(entry->GetSharedTx(),
+                                       entry->GetFee() / SATOSHI,
+                                       entry->GetSigChecks());
+            }
+            AddTransactionsToOverlayBatch(m_merklix_overlay, remaining);
+            return;
+        }
+    }
+    if (!m_pending_overlay_adds.empty()) {
+        auto pending = std::move(m_pending_overlay_adds);
+        m_pending_overlay_adds.clear();
+        AddTransactionsToOverlayBatch(m_merklix_overlay, pending);
+    }
+    if (!m_pending_overlay_removes.empty()) {
+        auto removes = std::move(m_pending_overlay_removes);
+        m_pending_overlay_removes.clear();
+        for (const TxId &rm_txid : removes) {
+            lotus::v2::Hash id{};
+            std::memcpy(id.data(), rm_txid.begin(), 32);
+            m_merklix_overlay.RemoveTransaction(id);
+        }
+    }
 }
 
 const lotus::v2::MempoolOverlayLayer &CTxMemPool::FreezeEpochBatch() {
diff --git a/src/txmempool.h b/src/txmempool.h
index 48941f432c5cb911f1c2944d367aff35325747e1..2701db78bc10a78dd0b6ca83e82bac848c048cc2 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -694,6 +694,7 @@ private:
     mutable lotus::v2::MerklixOverlayManager m_merklix_overlay GUARDED_BY(cs);
     mutable std::vector<std::tuple<CTransactionRef, int64_t, int64_t>>
         m_pending_overlay_adds GUARDED_BY(cs);
+    mutable std::vector<TxId> m_pending_overlay_removes GUARDED_BY(cs);
     /** Set ancestor state for an entry */
     void UpdateEntryForAncestors(txiter it, const setEntries *setAncestors)
         EXCLUSIVE_LOCKS_REQUIRED(cs);
