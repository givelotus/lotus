From b17e2f78d00662867301b34cea78286b8666356e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 16:15:53 -0700
Subject: [PATCH] fixup! logging: retain integral values in bounded numeric
 message formats

Teach the source validator the same bounded integer f/g and decimal-width
contract as the actual renderer. This repairs validation false rejections;
no C++ API, producer, binary or runtime behavior changes. Preserve malformed,
oversized and nonnumeric registry-type rejection. Twenty-six new positive
controls fail on the exact356 validator and pass here;37 negatives remain
rejected, plus the full validator self-tests pass. Static lint cannot prove
the sign of an INT u operand; the native renderer separately rejects negative
signed values.356 native/runtime seal is immutable and remains valid, but its
original lint output was not clean and must not be reported as lint-validated.
---
 test/lint/lint-log-events.py | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/test/lint/lint-log-events.py b/test/lint/lint-log-events.py
index c33c08afb09412138736ca37df8912a8e90becb7..db378a433e417a94383cf5123f6499d8f72eb2f2 100755
--- a/test/lint/lint-log-events.py
+++ b/test/lint/lint-log-events.py
@@ -161,9 +161,12 @@ def check(source, names, types=None):
                     elif re.fullmatch(r"(?:0(?:[1-9]|1[0-6]))?x", spec):
                         if types is None or types.get(key) not in {"INT", "UINT"}:
                             raise ValueError("hex format requires an INT/UINT registry field")
+                    elif re.fullmatch(r"(?:0?(?:[1-9]|1[0-9]|20))?[du]", spec):
+                        if types is None or types.get(key) not in {"INT", "UINT"}:
+                            raise ValueError("decimal format requires an INT/UINT registry field")
                     elif re.fullmatch(r"(?:\.(?:[0-9]|1[0-8]))?[fg]", spec):
-                        if types is None or types.get(key) != "FLOAT":
-                            raise ValueError("float format requires a FLOAT registry field")
+                        if types is None or types.get(key) not in {"FLOAT", "INT", "UINT"}:
+                            raise ValueError("float format requires a FLOAT/INT/UINT registry field")
                     else:
                         raise ValueError("template format spec is not supported")
                 used = {placeholder.group(1) for placeholder in placeholders}
@@ -241,6 +244,24 @@ class ContractTests(unittest.TestCase):
         self.assertIn("requires a FLOAT", check(
             source % ".2f", names, {"ElapsedMs": "STRING"})[1][0][1])
 
+    def test_integral_numeric_format_contract(self):
+        names = {"Count": "count"}
+        source = 'LogInfoEvent(BCLog::ALL,"counted","{count:%s}").Field(LogField::Count, value);'
+        for kind in ("INT", "UINT"):
+            for spec in ("d", "u", "1d", "01u", "05u", "15d", "20u", "020d",
+                         "f", "g", ".0f", ".2f", ".18g"):
+                self.assertFalse(check(source % spec, names, {"Count": kind})[1],
+                                 (kind, spec))
+            for spec in ("0d", "00u", "005u", "21d", "021u", "+5d", "-5d",
+                         "1.0d", ".19f", "08.2f"):
+                self.assertTrue(check(source % spec, names, {"Count": kind})[1],
+                                (kind, spec))
+        for kind in ("STRING", "BOOL", "HASH", "DURATION"):
+            for spec in ("15d", "05u", "f", ".2g"):
+                self.assertTrue(check(source % spec, names, {"Count": kind})[1],
+                                (kind, spec))
+        self.assertTrue(check(source % "15d", names, {"Count": "FLOAT"})[1])
+
     def test_hex_precision_contract(self):
         names = {"Version": "version"}
         source = 'LogInfoEventNoRateLimit(BCLog::ALL,"v","{version:%s}").Field(LogField::Version, v);'
