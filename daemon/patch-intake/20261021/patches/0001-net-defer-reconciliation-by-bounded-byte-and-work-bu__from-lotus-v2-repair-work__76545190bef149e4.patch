+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#ifdef MERKLIX_STANDALONE_TEST_MAIN
+#define BOOST_TEST_MODULE merklix_cost_budget_tests
+#include <boost/test/included/unit_test.hpp>
+#else
+#include <boost/test/unit_test.hpp>
+#endif
+#include <net/recon_cost_budget.h>
+using namespace std::chrono_literals;
+using lotus::v2::net::ReconCostBudget;
+BOOST_AUTO_TEST_SUITE(merklix_cost_budget_tests)
+BOOST_AUTO_TEST_CASE(legitimate_peak_and_flood_recovery) {
+    ReconCostBudget budget;
+    // 16 first replies, then at most 256 depth-12 summaries and their
+    // followups for a 5,000-difference round, remain below the sketch burst.
+    for (int message = 0; message < 300; ++message)
+        BOOST_REQUIRE(budget.Consume(600, 2000, false, 1s));
+    BOOST_CHECK(!budget.Consume(ReconCostBudget::SKETCH_BURST, 1, false, 1s));
+    // Independent payload capacity remains available after sketch depletion.
+    BOOST_CHECK(budget.Consume(2 * 1024 * 1024, 1, true, 1s));
+    BOOST_CHECK(budget.Consume(600, 2000, false, 2s));
+    BOOST_CHECK(!budget.Consume(ReconCostBudget::PAYLOAD_BURST + 1, 1, true, 3s));
+}
+BOOST_AUTO_TEST_CASE(work_budget_and_clock_reversal) {
+    ReconCostBudget budget;
+    BOOST_REQUIRE(budget.Consume(1, ReconCostBudget::WORK_BURST, false, 5s));
+    BOOST_CHECK(!budget.Consume(1, 1, false, 4s));
+    BOOST_CHECK(!budget.Consume(1, 1, true, 5s));
+    BOOST_CHECK(budget.Consume(1, ReconCostBudget::WORK_BURST, true, 6s));
+}
+BOOST_AUTO_TEST_SUITE_END()
