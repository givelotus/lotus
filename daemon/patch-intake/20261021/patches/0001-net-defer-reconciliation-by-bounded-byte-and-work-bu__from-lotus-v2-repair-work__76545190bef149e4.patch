+bool V2PeerProtocolHandler::DispatchReconMessage(
+    CNode &pfrom, const std::string &msg_type, DataStream &vRecv,
+    std::chrono::microseconds time_received) {
+    if (msg_type == NetMsgType::MERKLIXSYNC) {
+        HandleMerklixSync(pfrom, vRecv, time_received);
+        return true;
+    }
+    if (msg_type == NetMsgType::GETMERKLIXBUCK ||
+        msg_type == NetMsgType::LEGACY_GETMERKLIXBUCK) {
+        HandleGetMerklixBuck(pfrom, vRecv, time_received);
+        return true;
+    }
+    if (msg_type == NetMsgType::MERKLIXBUCK) {
+        HandleMerklixBuck(pfrom, vRecv, time_received);
+        return true;
+    }
+    if (msg_type == NetMsgType::GETSHORTTX) {
+        HandleGetShortTx(pfrom, vRecv, time_received);
+        return true;
+    }
+    if (msg_type == NetMsgType::SHORTTX) {
+        HandleShortTx(pfrom, vRecv, time_received);
+        return true;
+    }
+    return false;
+}
+
+bool V2PeerProtocolHandler::AdmitReconMessage(
+    CNode &peer, const std::string &type, DataStream &stream,
+    std::chrono::microseconds now) {
+    const bool payload = type == NetMsgType::SHORTTX;
+    // Charge scans independently of wire bytes: tiny requests can otherwise
+    // repeatedly trigger an expensive full-set walk. R3 replaces these walks.
+    const size_t visits = std::max<size_t>(1, m_mempool.size());
+    const size_t work = stream.size() / 26 +
+        (type == NetMsgType::GETMERKLIXBUCK ||
+         type == NetMsgType::LEGACY_GETMERKLIXBUCK ? 16 * visits : visits);
+    LOCK(m_mutex);
+    auto &queue = m_recon_queues[peer.GetId()];
+    if (stream.size() > (payload ? ReconCostBudget::PAYLOAD_BURST :
+                         ReconCostBudget::SKETCH_BURST) ||
+        work > ReconCostBudget::WORK_BURST) {
+        ++m_stats.recon_queue_rejected;
+        peer.fDisconnect = true;
+        return false;
+    }
+    if (queue.messages.empty() && queue.budget.Consume(stream.size(), work, payload, now)) {
+        return true;
+    }
+    // Bound both count and storage across all peers; no unbounded promise to
+    // retain a flood. A peer exceeding the queue receives TCP backoff/teardown.
+    if (queue.messages.size() >= 256 || queue.bytes + stream.size() > 2 * 1024 * 1024 ||
+        m_recon_queued_bytes + stream.size() > 16 * 1024 * 1024) {
+        ++m_stats.recon_queue_rejected;
+        peer.fDisconnect = true;
+        return false;
+    }
+    queue.messages.push_back({type, SerializeData(stream.begin(), stream.end()), work, payload});
+    queue.bytes += stream.size();
+    m_recon_queued_bytes += stream.size();
+    ++m_stats.rate_limited_messages;
+    ++m_stats.recon_deferred;
+    return false;
+}
+
+void V2PeerProtocolHandler::DrainReconMessages(
+    CNode &peer, std::chrono::microseconds now) {
+    // Bound one message-handler pass even if a long idle period replenished
+    // the bucket. Preserve ordering and charge queued work before dispatch.
+    for (size_t message = 0; message < 32 && !peer.fDisconnect; ++message) {
+        std::optional<DeferredReconMessage> next;
+        {
+            LOCK(m_mutex);
+            auto found = m_recon_queues.find(peer.GetId());
+            if (found == m_recon_queues.end() || found->second.messages.empty()) return;
+            auto &queue = found->second;
+            auto &front = queue.messages.front();
+            if (!queue.budget.Consume(front.bytes.size(), front.work, front.payload, now)) return;
+            queue.bytes -= front.bytes.size();
+            m_recon_queued_bytes -= front.bytes.size();
+            next = std::move(front);
+            queue.messages.pop_front();
+            ++m_stats.recon_drained;
+        }
+        DataStream stream{Span{next->bytes}};
+        DispatchReconMessage(peer, next->type, stream, now);
+    }
+}
