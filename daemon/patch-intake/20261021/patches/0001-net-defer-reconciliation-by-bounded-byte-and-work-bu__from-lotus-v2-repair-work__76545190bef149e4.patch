+"""Cost-limited sketches defer bounded traffic and disconnect a sustained flood."""
+from test_framework.p2p import P2PInterface
+from test_framework.test_framework import BitcoinTestFramework
+
+
+class RawSync:
+    msgtype = b"merklixsync"
+
+    def serialize(self):
+        # Invalid scope is intentional: admission must bound attacker work
+        # before decoding, and normal malformed handling must remain intact.
+        return b"\0" * 273
+
+
+class MerklixLimitsTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+        self.extra_args = [["-avalanche=0"]]
+
