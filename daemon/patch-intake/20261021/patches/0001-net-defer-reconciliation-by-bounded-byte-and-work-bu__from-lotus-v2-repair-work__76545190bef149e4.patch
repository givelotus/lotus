+void V2PeerProtocolHandler::SendBucketRequest(
+    CNode &peer, const MerklixBucketRequest &req) {
+    {
+        LOCK(m_mutex);
+        auto &pending = m_expected_buckets[peer.GetId()];
+        const uint8_t depth = req.depth_bits == 0 ? 4 : req.depth_bits;
+        auto next = pending;
+        for (uint8_t bucket = 0; bucket < 16; ++bucket) {
+            if (!(req.bucket_mask & (1U << bucket))) continue;
+            const uint8_t child_depth = depth == 16 ? 16 : depth + 4;
+            const uint16_t prefix = depth == 16 ? req.parent_prefix :
+                static_cast<uint16_t>((req.parent_prefix << 4) | bucket);
+            next.emplace(req.scope, req.context_id, req.salt_k0, req.salt_k1,
+                            child_depth, prefix);
+            if (next.size() > 1024) return;
+        }
+        pending = std::move(next);
     }
+    m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::GETMERKLIXBUCK, req));
