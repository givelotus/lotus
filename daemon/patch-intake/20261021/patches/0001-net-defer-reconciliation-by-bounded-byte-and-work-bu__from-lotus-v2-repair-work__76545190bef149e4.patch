+#ifndef BITCOIN_NET_RECON_COST_BUDGET_H
+#define BITCOIN_NET_RECON_COST_BUDGET_H
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+
+namespace lotus::v2::net {
+/** Separate byte budgets prevent transaction payload from starving sketches.
+ * Work units charge the number of transaction/cell visits before dispatch.
+ * This class never allocates and does not grant credit on clock reversal.
+ */
+class ReconCostBudget {
+    double m_sketch{256 * 1024};
+    double m_payload{4 * 1024 * 1024};
+    double m_work{1024 * 1024};
+    std::chrono::microseconds m_last{};
+    bool m_started{false};
+public:
+    static constexpr size_t SKETCH_BURST = 256 * 1024;
+    static constexpr size_t PAYLOAD_BURST = 4 * 1024 * 1024;
+    static constexpr size_t WORK_BURST = 1024 * 1024;
+
+    bool Consume(size_t bytes, size_t work, bool payload,
+                 std::chrono::microseconds now) {
+        if (!m_started) { m_last = now; m_started = true; }
+        const double seconds = std::max(0.0, (now - m_last).count() / 1e6);
+        m_last = std::max(m_last, now);
+        m_sketch = std::min<double>(SKETCH_BURST, m_sketch + seconds * SKETCH_BURST);
+        m_payload = std::min<double>(PAYLOAD_BURST, m_payload + seconds * PAYLOAD_BURST);
+        m_work = std::min<double>(WORK_BURST, m_work + seconds * WORK_BURST);
+        double &tokens = payload ? m_payload : m_sketch;
+        if (bytes > tokens || work > m_work) return false;
+        tokens -= bytes;
+        m_work -= work;
+        return true;
+    }
+};
+} // namespace lotus::v2::net
+#endif
