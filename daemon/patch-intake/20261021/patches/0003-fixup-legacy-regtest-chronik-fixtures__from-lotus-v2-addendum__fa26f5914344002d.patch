From aab540e61882ff5aff0d556801d3200eee5d7829 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:18:53 -0700
Subject: [PATCH] fixup! test(v2): regenerate chain fixtures for the
 legacy-coinbase regtest chain

Align Chronik fixtures with native genesis and legacy-created regtest coins. Keep legacy P2PK genesis queries empty, compare native coinbase data through its native field, and compare legacy coinbase outputs through their script grammar. Pin the explicit legacy output and spent-coin flags.

Tier: V2 (fixup to test(v2): regenerate chain fixtures for the legacy-coinbase regtest chain)
---
 chronik/test/bridgeprimitives_tests.cpp        | 10 +++++++---
 src/test/chronik_native_abc_tests.cpp          |  6 +++++-
 test/functional/chronik_script_history.py      | 10 +++-------
 test/functional/chronik_script_utxos.py        | 18 +++++-------------
 test/functional/chronik_tx.py                  |  4 ++++
 .../test_framework/chronik/test_data.py        |  9 +++++++--
 6 files changed, 31 insertions(+), 26 deletions(-)

diff --git a/chronik/test/bridgeprimitives_tests.cpp b/chronik/test/bridgeprimitives_tests.cpp
index 778e855042..d8e954a78f 100644
--- a/chronik/test/bridgeprimitives_tests.cpp
+++ b/chronik/test/bridgeprimitives_tests.cpp
@@ -145,6 +145,10 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_genesis, TestChain100Setup) {
 
     chronik_bridge::Block bridgedGenesisBlock = chronik_bridge::bridge_block(
         genesisBlock, *genesisBlockUndo, *pgenesis);
+    const CTxIn &genesisInput = genesisBlock.vtx[0]->vin[0];
+    const CScript genesisInputScript = genesisBlock.vtx[0]->nVersion == 7
+        ? CScript(genesisInput.vCoinbaseData.begin(), genesisInput.vCoinbaseData.end())
+        : genesisInput.scriptSig;
     chronik_bridge::Tx expectedGenesisTx = {
         .txid = HashToArray(genesisBlock.vtx[0]->GetId()),
         .version = genesisBlock.vtx[0]->nVersion,
@@ -153,7 +157,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_genesis, TestChain100Setup) {
                 .txid = {},
                 .out_idx = 0xffff'ffff,
             }),
-            .script = ToRustVec<uint8_t>(genesisBlock.vtx[0]->vin[0].scriptSig),
+            .script = ToRustVec<uint8_t>(genesisInputScript),
             .sequence = 0xffff'ffff,
             .coin = {}, // null coin
         }},
@@ -260,7 +264,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_detailled, TestChain100Setup) {
         .outputs = {{
             .sats = 2500000000,
             .script = ToRustVec<uint8_t>(
-                CanonicalNativeOutputBytes(testBlock.vtx[0]->vout[0])),
+                ExpectedBridgeScriptBytes(testBlock.vtx[0]->vout[0])),
         }},
         .locktime = 0,
     };
@@ -276,7 +280,7 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_detailled, TestChain100Setup) {
             .sequence = 0xffff'ffff,
             .coin = chronik_bridge::Coin({
                 .output = {5000000000, ToRustVec<uint8_t>(
-                    CanonicalNativeOutputBytes(coinsBlock.vtx[0]->vout[0]))},
+                    ExpectedBridgeScriptBytes(coinsBlock.vtx[0]->vout[0]))},
                 .height = 101,
                 .is_coinbase = true,
             }),
diff --git a/src/test/chronik_native_abc_tests.cpp b/src/test/chronik_native_abc_tests.cpp
index 70626117b2..88ffd4dc45 100644
--- a/src/test/chronik_native_abc_tests.cpp
+++ b/src/test/chronik_native_abc_tests.cpp
@@ -295,12 +295,16 @@ BOOST_FIXTURE_TEST_CASE(test_bridge_genesis, TestChain100Setup) {
     cn::Block convertedGenesisBlock =
         cn::abc::ConvertBlock(genesisBlock, *genesisBlockUndo, *pgenesis);
 
+    const CTxIn &genesisInput = genesisBlock.vtx[0]->vin[0];
+    const CScript genesisInputScript = genesisBlock.vtx[0]->nVersion == 7
+        ? CScript(genesisInput.vCoinbaseData.begin(), genesisInput.vCoinbaseData.end())
+        : genesisInput.scriptSig;
     cn::Tx expectedGenesisTx;
     expectedGenesisTx.txid = ToHash(genesisBlock.vtx[0]->GetId());
     expectedGenesisTx.version = int32_t(genesisBlock.vtx[0]->nVersion);
     expectedGenesisTx.inputs = {{
         .prev_out = {.txid = {}, .out_idx = 0xffff'ffff},
-        .script = ToBytes(genesisBlock.vtx[0]->vin[0].scriptSig),
+        .script = ToBytes(genesisInputScript),
         .sequence = 0xffff'ffff,
         // Like the bridge: an empty (not absent) coin for coinbase inputs
         .coin = cn::Coin{},
diff --git a/test/functional/chronik_script_history.py b/test/functional/chronik_script_history.py
index 8ebb48aa7d..8fd9aa6f5c 100644
--- a/test/functional/chronik_script_history.py
+++ b/test/functional/chronik_script_history.py
@@ -109,16 +109,12 @@ class ChronikScriptHistoryTest(BitcoinTestFramework):
             chronik.script("p2pk", GENESIS_CB_PK)
             .history(page=2**32 - 1, page_size=200)
             .ok(),
-            pb.TxHistoryPage(num_pages=1, num_txs=1),
+            pb.TxHistoryPage(),
         )
 
         genesis_db_script_history = chronik.script("p2pk", GENESIS_CB_PK).history().ok()
-        from test_framework.chronik.test_data import genesis_cb_tx
-
-        assert_equal(
-            genesis_db_script_history,
-            pb.TxHistoryPage(txs=[genesis_cb_tx()], num_pages=1, num_txs=1),
-        )
+        # The V2 genesis output commits a native branch, not a legacy P2PK.
+        assert_equal(genesis_db_script_history, pb.TxHistoryPage())
 
         script_type = "p2sh"
         payload_hex = P2SH_OP_TRUE[2:-1].hex()
