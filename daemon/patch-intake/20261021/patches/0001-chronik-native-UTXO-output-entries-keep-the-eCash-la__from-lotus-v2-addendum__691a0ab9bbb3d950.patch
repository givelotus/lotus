From 993da32094c3392f76b0e048fe219d8acee3cf3e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 19:25:17 -0700
Subject: [PATCH 1/2] chronik: native UTXO output entries keep the eCash layout
 (revert 0045)

Reverts ee53dfb8a1 "chronik: native UTXO output entries use the V2
postcard layout" (addendum native mailbox 0045). The Rust Chronik on V2
now keeps ecash/007's compact UtxoDataOutput duplicate entries
(tx_num BE8 || out_idx BE4 || sats LE8 || raw script), see the fixup to
v2/026 "chronik(v2): keep eCash's compact UtxoDataOutput duplicate
entries", so the native codec needs no V2 special case. The four
UtxoDupOutput vectors of test/fixtures/db_values.json, the error texts and
the token-id/group-UTXO dump expectations return to the eCash layout.

Equivalent to dropping mailbox 0045; the coordinator can drop it instead
of applying this commit.

Tier: V2
---
 chronik/native/core/index/group_utxos.cpp     | 38 +++++--------------
 .../include/chronik/native/codec/postcard.h   |  2 -
 chronik/native/test/fixtures/db_values.json   |  8 ++--
 chronik/native/test/groups_token_id_tests.cpp | 18 ++++-----
 .../native/test/index_group_utxos_tests.cpp   | 26 ++++++-------
 5 files changed, 35 insertions(+), 57 deletions(-)

diff --git a/chronik/native/core/index/group_utxos.cpp b/chronik/native/core/index/group_utxos.cpp
index 21f75ea052..49960f280a 100644
--- a/chronik/native/core/index/group_utxos.cpp
+++ b/chronik/native/core/index/group_utxos.cpp
@@ -109,14 +109,9 @@ Bytes EncodeUtxoDup(UtxoDataKind kind, const UtxoEntry &entry) {
     buf.reserve(UtxoFixedDupSize(kind).value_or(48));
     PutBe<uint64_t>(buf, entry.outpoint.tx_num);
     PutBe<uint32_t>(buf, entry.outpoint.out_idx);
-    if (kind == UtxoDataKind::Value) {
-        PutLe<int64_t>(buf, entry.sats);
-    } else {
-        // Lotus V2 (v2/026): UtxoDataOutput keeps the default postcard
-        // payload, (i64 zigzag varint, Bytes length-prefixed).
-        postcard::Writer w(buf);
-        w.I64(entry.sats);
-        w.ByteVec(entry.script);
+    PutLe<int64_t>(buf, entry.sats);
+    if (kind == UtxoDataKind::Output) {
+        Append(buf, entry.script);
     }
     return buf;
 }
@@ -130,28 +125,15 @@ UtxoEntry DecodeUtxoDup(UtxoDataKind kind, ByteView bytes) {
     entry.outpoint.tx_num = FromBe<uint64_t>(bytes.subspan(0, 8));
     entry.outpoint.out_idx = FromBe<uint32_t>(bytes.subspan(8, 4));
     const ByteView data = bytes.subspan(12);
-    // Lotus V2 (v2/026): any payload failure is reported as postcard's
-    // DeserializeBadEncoding over the payload bytes.
-    const auto bad = [&] {
+    const bool ok = kind == UtxoDataKind::Value ? data.size() == 8
+                                                : data.size() >= 8;
+    if (!ok) {
         postcard::ThrowDeserializeError(DataTypeName(kind),
-                                        postcard::kBadEncoding, data);
-    };
-    if (kind == UtxoDataKind::Value) {
-        if (data.size() != 8) {
-            bad();
-        }
-        entry.sats = FromLe<int64_t>(data);
-        return entry;
-    }
-    postcard::Reader r(data);
-    try {
-        entry.sats = r.I64();
-        entry.script = r.ByteVec();
-    } catch (const postcard::Error &) {
-        bad();
+                                        postcard::kUnexpectedEnd, bytes);
     }
-    if (!r.AtEnd()) {
-        bad();
+    entry.sats = FromLe<int64_t>(data.subspan(0, 8));
+    if (kind == UtxoDataKind::Output) {
+        entry.script.assign(data.begin() + 8, data.end());
     }
     return entry;
 }
