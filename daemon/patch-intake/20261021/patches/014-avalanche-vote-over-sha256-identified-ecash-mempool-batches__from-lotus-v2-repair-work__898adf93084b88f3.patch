+
+    CMutableTransaction mtx2;
+    mtx2.nVersion = 2;
+    mtx2.vin.resize(1);
+    mtx2.vin[0].prevout = COutPoint(TxId(GetRandHash()), 1);
+    mtx2.vin[0].scriptSig = CScript() << OP_2;
+    mtx2.vout.emplace_back(20 * COIN, CScript() << OP_TRUE);
