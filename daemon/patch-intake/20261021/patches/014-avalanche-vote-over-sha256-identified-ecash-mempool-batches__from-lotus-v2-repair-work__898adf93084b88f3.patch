+
+    MempoolBatchAnnouncement modifiedTxCount = batch;
+    modifiedTxCount.tx_count = 129;
+    BOOST_CHECK(modifiedTxCount.ComputeBatchId() != idOrig);
+
+    MempoolBatchAnnouncement zeroTxCount = batch;
+    zeroTxCount.tx_count = 0;
