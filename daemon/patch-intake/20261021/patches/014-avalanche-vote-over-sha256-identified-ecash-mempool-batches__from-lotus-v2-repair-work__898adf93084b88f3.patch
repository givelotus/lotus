+    }
+
+    // 2b. Block with enough transactions but wrong subtree_a_root is parked.
+    {
+        CMutableTransaction wrongMtx(*tx2);
+        wrongMtx.vout[0].nValue = 19 * COIN;
+        CTransactionRef wrongTx2 = MakeTransactionRef(std::move(wrongMtx));
