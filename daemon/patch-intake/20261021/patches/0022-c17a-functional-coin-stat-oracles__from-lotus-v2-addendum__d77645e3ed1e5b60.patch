From 7cd1f6a0f927b7a3059673bcb1438e81a76fe696 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 22:06:20 -0700
Subject: [PATCH] fixup! feat(v2): add C17a deterministic fee-backed UTXO
 expiry and cleaning-crew validation

Recompute the deterministic legacy110 coin-stat commitment from independently serialized LegacyCoinWire and C17a fee/expiry bytes. Keep both block identity constants unchanged. Restore real legacy coinbase/spend families in the independent MuHash control and derive paid lifetime from its actual input/output values. Both focused functional tests pass. Offline generator and reference hashes are preserved in final-sweep/generators/chain-fixtures. Tier: V2
---
 .../feature_deterministic_chain_setup.py      |  2 +-
 test/functional/feature_utxo_set_hash.py      | 26 ++++++++++++++++---
 2 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/test/functional/feature_deterministic_chain_setup.py b/test/functional/feature_deterministic_chain_setup.py
index f92b2572a9..a6a2868aad 100644
--- a/test/functional/feature_deterministic_chain_setup.py
+++ b/test/functional/feature_deterministic_chain_setup.py
@@ -98,7 +98,7 @@ class DeterministicChainSetupTest(BitcoinTestFramework):
         )
         assert_equal(
             node.gettxoutsetinfo()["hash_serialized"],
-            "6f07ffe7fb7cb81306de17c163dafc8c2188daeccd2db83b43146fba7da47502",
+            "52ee14591e11529d6244d610cb90e4e503f99a6fca2e657cedbe1658971d437e",
         )
 
 
diff --git a/test/functional/feature_utxo_set_hash.py b/test/functional/feature_utxo_set_hash.py
index 1a8a4a05ef..805354d556 100644
--- a/test/functional/feature_utxo_set_hash.py
+++ b/test/functional/feature_utxo_set_hash.py
@@ -4,7 +4,7 @@
 """Test UTXO set hash value calculation in gettxoutsetinfo."""
 
 from test_framework.blocktools import COINBASE_MATURITY, create_transaction
-from test_framework.messages import CBlock, COutPoint, FromHex
+from test_framework.messages import CBlock, COutPoint, FromHex, ser_string
 from test_framework.muhash import MuHash3072
 from test_framework.test_framework import BitcoinTestFramework
 from test_framework.util import assert_equal
@@ -37,7 +37,7 @@ class UTXOSetHashTest(BitcoinTestFramework):
 
         # Generate 100 blocks and remove the first since we plan to spend its
         # coinbase
-        block_hashes = self.generate(node, COINBASE_MATURITY)
+        block_hashes = self.generate(node, COINBASE_MATURITY, coinbase_version=2)
         blocks = [
             FromHex(CBlock(), node.getblock(block, False)) for block in block_hashes
         ]
@@ -50,7 +50,7 @@ class UTXOSetHashTest(BitcoinTestFramework):
         txid = node.sendrawtransaction(hexstring=tx.serialize().hex(), maxfeerate=0)
 
         tx_block = self.generateblock(
-            node, output=node.getnewaddress(), transactions=[txid]
+            node, output=node.getnewaddress(), transactions=[txid], coinbase_version=2
         )
         blocks.append(FromHex(CBlock(), node.getblock(tx_block["hash"], False)))
 
@@ -76,7 +76,25 @@ class UTXOSetHashTest(BitcoinTestFramework):
 
                     data = COutPoint(tx.txid_int, n).serialize()
                     data += (height * 2 + coinbase).to_bytes(4, "little", signed=True)
-                    data += tx_out.serialize()
+                    # Canonical LegacyCoinWire and C17a lifetime metadata,
+                    # calculated from this fixture's real input/output values.
+                    assert tx.nVersion in (1, 2)
+                    coin_wire = b"\x80" + tx_out.serialize()
+                    data += ser_string(coin_wire)
+                    if coinbase:
+                        fee_per_output = 0
+                        lifespan = 21_024_000
+                    else:
+                        assert_equal(tx.txid_hex, txid)
+                        assert_equal(tx.vin[0].prevout.txid, spending.vtx[0].txid_int)
+                        assert_equal(tx.vin[0].prevout.n, 0)
+                        fee = spending.vtx[0].vout[0].nValue - sum(
+                            out.nValue for out in tx.vout
+                        )
+                        fee_per_output = fee // len(tx.vout)
+                        lifespan = min(21_024_000, 131_400 + fee_per_output)
+                    data += fee_per_output.to_bytes(8, "little")
+                    data += (height + lifespan).to_bytes(8, "little")
 
                     muhash.insert(data)
 
