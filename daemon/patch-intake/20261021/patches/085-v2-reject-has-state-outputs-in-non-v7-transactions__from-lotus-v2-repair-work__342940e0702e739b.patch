From 76a349edb218ad3ec922a37badadbf670b74ed7a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 06:15:12 -0700
Subject: [PATCH] v2: reject HAS_STATE outputs in non-v7 transactions

Only a V2 script can authorize a HAS_STATE output: ENFORCEOUTPUT with a
state-constraining template, checked by the per-transaction post-check.
That post-check runs only for v7 transactions. A transaction of any other
version could therefore create a stateful output, with an arbitrary
"authenticated" root, through the legacy scriptPubKey output bridge.
CheckTransactionCommon now rejects such outputs with
bad-txns-legacy-state-output. Coinbases are covered too.

The check decodes only outputs whose first wire byte (or native flags)
has the state bit and no unknown bits. Ordinary scripts are not decoded.

Test: transaction_tests/v2_legacy_state_output. A legacy transaction
with a stateful bridge output is rejected. The same output without state,
and a P2PKH output, are accepted.

Tier: V2
---
 src/consensus/tx_check.cpp     | 19 +++++++++++++++++
 src/test/transaction_tests.cpp | 38 ++++++++++++++++++++++++++++++++++
 2 files changed, 57 insertions(+)

diff --git a/src/consensus/tx_check.cpp b/src/consensus/tx_check.cpp
index f9ed24f1d0fa765edd41db542076347ab5f1c83d..cd35185d379a4d55ffa83f57ba457da052eab60c 100644
--- a/src/consensus/tx_check.cpp
+++ b/src/consensus/tx_check.cpp
@@ -32,6 +32,25 @@ static bool CheckTransactionCommon(const CTransaction &tx,
                              "bad-txns-v2-too-many-outputs");
     }
 
+    // Only a V2 script can authorize a HAS_STATE output (ENFORCEOUTPUT and
+    // the per-transaction post-check), so a transaction of another version
+    // must not create one through the legacy output bridge.
+    if (tx.nVersion != 7) {
+        for (const auto &txout : tx.vout) {
+            const bool maybe_state =
+                !txout.vBranches.empty()
+                    ? (txout.nFlags & lotus::v2::OUTPUT_FLAG_HAS_STATE) != 0
+                    : txout.scriptPubKey.size() >= 43 &&
+                          (txout.scriptPubKey[0] &
+                           lotus::v2::OUTPUT_FLAG_HAS_STATE) != 0 &&
+                          (txout.scriptPubKey[0] & 0xf8) == 0;
+            if (maybe_state && txout.ToV2Output().HasState()) {
+                return state.Invalid(TxValidationResult::TX_CONSENSUS,
+                                     "bad-txns-legacy-state-output");
+            }
+        }
+    }
+
     // Size limit
     if (::GetSerializeSize(tx) > MAX_TX_SIZE) {
         return state.Invalid(TxValidationResult::TX_CONSENSUS,
diff --git a/src/test/transaction_tests.cpp b/src/test/transaction_tests.cpp
index e5d82ffefe2fbcbafd6a27a5301f69eb8d370eb6..6cf16af59afe77312d6673e748b6b8fe752a0208 100644
--- a/src/test/transaction_tests.cpp
+++ b/src/test/transaction_tests.cpp
@@ -2084,4 +2084,42 @@ BOOST_AUTO_TEST_CASE(v2_state_output_post_check) {
     }
 }
 
+BOOST_AUTO_TEST_CASE(v2_legacy_state_output) {
+    // A non-V2 transaction runs no V2 script, so it cannot create a
+    // HAS_STATE output through the legacy scriptPubKey bridge.
+    lotus::v2::Output stateful;
+    stateful.flags = lotus::v2::OUTPUT_FLAG_HAS_STATE;
+    stateful.value = 1000;
+    stateful.branches = {lotus::v2::BranchLeaf(std::vector<uint8_t>{0x4e})};
+    stateful.paths = {{0}};
+    stateful.state_root[0] = 1;
+    std::vector<uint8_t> wire;
+    std::string error;
+    BOOST_REQUIRE(lotus::v2::EncodeOutput(stateful, wire, error));
+    auto make = [&](int32_t version, CScript script) {
+        CMutableTransaction mtx;
+        mtx.nVersion = version;
+        mtx.vin.emplace_back(COutPoint{TxId{uint256S("bb")}, 0});
+        mtx.vout.emplace_back(1000 * SATOSHI, script);
+        return CTransaction{mtx};
+    };
+    TxValidationState state;
+    BOOST_CHECK(!CheckRegularTransaction(
+        make(2, CScript(wire.begin(), wire.end())), state));
+    BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-txns-legacy-state-output");
+    // The same output without the state flag, and ordinary scripts whose
+    // first byte has bit 2 set, are unaffected.
+    stateful.flags = 0;
+    stateful.state_root = {};
+    BOOST_REQUIRE(lotus::v2::EncodeOutput(stateful, wire, error));
+    TxValidationState plain;
+    BOOST_CHECK(CheckRegularTransaction(
+        make(2, CScript(wire.begin(), wire.end())), plain));
+    TxValidationState p2pkh;
+    BOOST_CHECK(CheckRegularTransaction(
+        make(2, CScript() << OP_DUP << OP_HASH160 << std::vector<uint8_t>(20, 7)
+                          << OP_EQUALVERIFY << OP_CHECKSIG),
+        p2pkh));
+}
+
 BOOST_AUTO_TEST_SUITE_END()
