diff --git a/src/lotus_v2/incremental_utxo.cpp b/src/lotus_v2/incremental_utxo.cpp
new file mode 100644
index 000000000..0995f5027
--- /dev/null
+++ b/src/lotus_v2/incremental_utxo.cpp
@@ -0,0 +1,185 @@
+#include "incremental_utxo.h"
+
+#include <array>
+#include <cassert>
+#include <utility>
+#include <vector>
+
+namespace lotus::v2 {
+namespace {
+bool KeyBit(const Hash &key, unsigned depth) {
+    assert(depth < 256);
+    return (key[depth / 8] >> (depth % 8)) & 1;
+}
+
+void SetBit(Hash &bitmap, unsigned depth) {
+    assert(depth < 256);
+    bitmap[depth / 8] |= uint8_t{1} << (depth % 8);
+}
+
+Hash NodeHash(unsigned depth, const Hash &left, const Hash &right) {
+    Hash out;
+    const bool valid = UtxoNode(depth, left, right, out);
+    assert(valid);
+    (void)valid;
+    return out;
+}
+} // namespace
+
+struct IncrementalUtxoSet::Node {
+    Hash digest{};
+    size_t count{};
+    Hash key{};
+    std::unique_ptr<Coin> coin;
+    std::array<std::unique_ptr<Node>, 2> child;
+
+    bool IsLeaf() const { return coin != nullptr; }
+    Hash ChildHash(unsigned bit) const {
+        return child[bit] ? child[bit]->digest : EmptyUtxoRoot();
+    }
+    void Refresh(unsigned depth) {
+        digest = NodeHash(depth, ChildHash(0), ChildHash(1));
+    }
+};
+
+IncrementalUtxoSet::IncrementalUtxoSet() = default;
+IncrementalUtxoSet::~IncrementalUtxoSet() = default;
+
+std::unique_ptr<IncrementalUtxoSet::Node>
+IncrementalUtxoSet::MakeLeaf(const Coin &coin, const Hash &key,
+                             const Hash &leaf_hash) {
+    auto node = std::make_unique<Node>();
+    node->digest = leaf_hash;
+    node->count = 1;
+    node->key = key;
+    node->coin = std::make_unique<Coin>(coin);
+    return node;
+}
+
+std::unique_ptr<IncrementalUtxoSet::Node>
+IncrementalUtxoSet::JoinLeaves(std::unique_ptr<Node> &existing,
+                               std::unique_ptr<Node> added, unsigned depth) {
+    assert(depth < 256 && existing->IsLeaf() && added->IsLeaf());
+    assert(existing->key != added->key);
+    const Hash old_key = existing->key;
+    unsigned split = depth;
+    while (KeyBit(existing->key, split) == KeyBit(added->key, split)) {
+        ++split;
+        assert(split < 256); // Different 256-bit keys must differ by bit 255.
+    }
+    // Allocate the entire new path before moving the old leaf. An allocation
+    // failure therefore cannot remove an existing coin from the tree.
+    std::vector<std::unique_ptr<Node>> branches;
+    branches.reserve(split - depth + 1);
+    for (unsigned d = depth; d <= split; ++d) branches.push_back(std::make_unique<Node>());
+    auto subtree = std::move(branches.back());
+    subtree->count = 2;
+    const unsigned old_bit = KeyBit(existing->key, split);
+    subtree->child[old_bit] = std::move(existing);
+    subtree->child[1 - old_bit] = std::move(added);
+    subtree->Refresh(split);
+    for (unsigned d = split; d-- > depth;) {
+        auto parent = std::move(branches[d - depth]);
+        parent->count = 2;
+        // Both leaves share bit d, so the old leaf's cached key selects the
+        // only nonempty child at this level.
+        parent->child[KeyBit(old_key, d)] = std::move(subtree);
+        parent->Refresh(d);
+        subtree = std::move(parent);
+    }
+    return subtree;
+}
+
+bool IncrementalUtxoSet::InsertAt(std::unique_ptr<Node> &node,
+                                  const Coin &coin, const Hash &key,
+                                  const Hash &leaf_hash, unsigned depth) {
+    if (!node) {
+        node = MakeLeaf(coin, key, leaf_hash);
+        return true;
+    }
+    if (node->IsLeaf()) {
+        // Same-key different-outpoint collision and identical outpoints both
+        // reject before any mutation. No merge or overwrite is possible.
+        if (node->key == key) return false;
+        auto added = MakeLeaf(coin, key, leaf_hash);
+        node = JoinLeaves(node, std::move(added), depth);
+        return true;
+    }
+    if (depth >= 256) return false;
+    if (!InsertAt(node->child[KeyBit(key, depth)], coin, key, leaf_hash, depth + 1)) return false;
+    ++node->count;
+    node->Refresh(depth);
+    return true;
+}
+
+bool IncrementalUtxoSet::EraseAt(std::unique_ptr<Node> &node,
+                                 const Outpoint &outpoint, const Hash &key,
+                                 unsigned depth) {
+    if (!node) return false;
+    if (node->IsLeaf()) {
+        if (node->key != key || node->coin->outpoint != outpoint) return false;
+        node.reset();
+        return true;
+    }
+    if (depth >= 256) return false;
+    if (!EraseAt(node->child[KeyBit(key, depth)], outpoint, key, depth + 1)) return false;
+    --node->count;
+    if (node->count == 1) {
+        const unsigned remaining = node->child[0] ? 0 : 1;
+        assert(node->child[remaining] && node->child[remaining]->IsLeaf());
+        node = std::move(node->child[remaining]);
+    } else {
+        node->Refresh(depth);
+    }
+    return true;
+}
+
+bool IncrementalUtxoSet::Insert(const Coin &coin) {
+    Hash leaf_hash;
+    if (!UtxoLeaf(coin, leaf_hash)) return false; // Includes output validation and burn pruning.
+    const Hash key = OutpointKey(coin.outpoint);
+    if (!InsertAt(root_, coin, key, leaf_hash, 0)) return false;
+    ++size_;
+    return true;
+}
+
+bool IncrementalUtxoSet::Erase(const Outpoint &outpoint) {
+    if (!EraseAt(root_, outpoint, OutpointKey(outpoint), 0)) return false;
+    --size_;
+    return true;
+}
+
+Hash IncrementalUtxoSet::Root() const {
+    return root_ ? root_->digest : EmptyUtxoRoot();
+}
+
+CoinProof IncrementalUtxoSet::Prove(const Outpoint &query) const {
+    CoinProof proof;
+    const Hash key = OutpointKey(query);
+    const Node *node = root_.get();
+    std::vector<std::pair<unsigned, Hash>> ancestors;
+    unsigned depth = 0;
+    while (node && !node->IsLeaf()) {
+        assert(depth < 256);
+        const unsigned bit = KeyBit(key, depth);
+        ancestors.emplace_back(depth, node->ChildHash(1 - bit));
+        node = node->child[bit].get();
+        ++depth;
+    }
+    if (!node) {
+        proof.presence = ProofPresence::Empty;
+    } else {
+        proof.presence = node->coin->outpoint == query
+                             ? ProofPresence::Present : ProofPresence::OtherLeaf;
+        proof.coin = *node->coin;
+    }
+    for (auto it = ancestors.rbegin(); it != ancestors.rend(); ++it) {
+        if (it->second != EmptyUtxoRoot()) {
+            SetBit(proof.bitmap, it->first);
+            proof.siblings.push_back(it->second);
+        }
+    }
+    return proof;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/incremental_utxo.h b/src/lotus_v2/incremental_utxo.h
new file mode 100644
index 000000000..076fbd76e
--- /dev/null
+++ b/src/lotus_v2/incremental_utxo.h
@@ -0,0 +1,44 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_INCREMENTAL_UTXO_H
+#define LOTUS_V2_INCREMENTAL_UTXO_H
+
+#include "sparse_state.h"
+
+#include <cstddef>
+#include <memory>
+
+namespace lotus::v2 {
+
+// In-memory path-local version of P02's collapsed sparse tree. The scalar
+// UtxoSet remains the independent oracle. No disk or block undo is implied.
+class IncrementalUtxoSet {
+public:
+    IncrementalUtxoSet();
+    ~IncrementalUtxoSet();
+    IncrementalUtxoSet(const IncrementalUtxoSet &) = delete;
+    IncrementalUtxoSet &operator=(const IncrementalUtxoSet &) = delete;
+
+    bool Insert(const Coin &coin);
+    bool Erase(const Outpoint &outpoint);
+    Hash Root() const;
+    CoinProof Prove(const Outpoint &query) const;
+    size_t Size() const { return size_; }
+
+private:
+    struct Node;
+    static std::unique_ptr<Node> MakeLeaf(const Coin &coin, const Hash &key,
+                                          const Hash &leaf_hash);
+    static std::unique_ptr<Node> JoinLeaves(std::unique_ptr<Node> &existing,
+                                            std::unique_ptr<Node> added,
+                                            unsigned depth);
+    static bool InsertAt(std::unique_ptr<Node> &node, const Coin &coin,
+                         const Hash &key, const Hash &leaf_hash, unsigned depth);
+    static bool EraseAt(std::unique_ptr<Node> &node, const Outpoint &outpoint,
+                        const Hash &key, unsigned depth);
+
+    std::unique_ptr<Node> root_;
+    size_t size_{};
+};
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/test_incremental_utxo.cpp b/src/lotus_v2/test_incremental_utxo.cpp
new file mode 100644
index 000000000..316af91ff
--- /dev/null
+++ b/src/lotus_v2/test_incremental_utxo.cpp
@@ -0,0 +1,167 @@
+#include "incremental_utxo.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool condition, const char *message) {
+    if (!condition) {
+        std::cerr << "V2 incremental UTXO: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+Coin MakeCoin(uint32_t index) {
+    Coin coin;
+    for (unsigned i = 0; i < 32; ++i) coin.outpoint.tx_id[i] = i;
+    coin.outpoint.index = index;
+    coin.output.flags = 0;
+    coin.output.value = 1000 + index;
+    Hash branch;
+    branch.fill(0x11);
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = index + 7;
+    coin.creation_parent_mtp = index + 1234;
+    coin.coinbase = index % 2 == 0;
+    return coin;
+}
+
+void CheckProof(const IncrementalUtxoSet &incremental, const UtxoSet &scalar,
+                const Outpoint &query) {
+    const CoinProof fast = incremental.Prove(query);
+    const CoinProof slow = scalar.Prove(query);
+    Check(fast.presence == slow.presence, "presence agrees with scalar");
+    Check(fast.bitmap == slow.bitmap, "bitmap agrees with scalar");
+    Check(fast.siblings == slow.siblings, "bottom-up siblings agree with scalar");
+    Check(fast.coin.has_value() == slow.coin.has_value(), "terminal coin presence agrees");
+    if (fast.coin) {
+        std::vector<uint8_t> fast_bytes, slow_bytes;
+        Check(EncodeCoin(*fast.coin, fast_bytes) && EncodeCoin(*slow.coin, slow_bytes) &&
+                  fast_bytes == slow_bytes,
+              "terminal coin bytes agree with scalar");
+    }
+    Check(VerifyCoinProof(query, fast, incremental.Root()), "incremental proof verifies");
+}
+
+void CheckState(const IncrementalUtxoSet &incremental, const UtxoSet &scalar,
+                const std::vector<Coin> &coins, uint32_t absent_index) {
+    Check(incremental.Root() == scalar.Root(), "root agrees with scalar");
+    Check(incremental.Size() == scalar.Size(), "size agrees with scalar");
+    for (const Coin &coin : coins) CheckProof(incremental, scalar, coin.outpoint);
+    CheckProof(incremental, scalar, MakeCoin(absent_index).outpoint);
+}
+} // namespace
+
+int main() {
+    IncrementalUtxoSet incremental;
+    UtxoSet scalar;
+    std::vector<Coin> fixtures{MakeCoin(0), MakeCoin(47), MakeCoin(1)};
+    CheckState(incremental, scalar, {}, 0);
+    for (size_t i = 0; i < fixtures.size(); ++i) {
+        Check(incremental.Insert(fixtures[i]) && scalar.Insert(fixtures[i]),
+              "insert shared-prefix fixture");
+        CheckState(incremental, scalar,
+                   std::vector<Coin>(fixtures.begin(), fixtures.begin() + i + 1), 200);
+    }
+    const Hash fixture_root = incremental.Root();
+    Check(!incremental.Insert(fixtures[0]) && incremental.Root() == fixture_root &&
+              incremental.Size() == fixtures.size(),
+          "duplicate cannot overwrite root or size");
+    Coin burn = MakeCoin(201);
+    burn.output.flags = 2;
+    burn.output.paths.clear();
+    Check(!incremental.Insert(burn) && incremental.Root() == fixture_root,
+          "burn output rejects without mutation");
+    Coin malformed = MakeCoin(202);
+    malformed.output.paths.clear();
+    Check(!incremental.Insert(malformed) && incremental.Root() == fixture_root,
+          "malformed output rejects without mutation");
+    Check(!incremental.Erase(MakeCoin(203).outpoint) && incremental.Root() == fixture_root,
+          "missing deletion leaves root unchanged");
+    for (auto it = fixtures.rbegin(); it != fixtures.rend(); ++it) {
+        Check(incremental.Erase(it->outpoint) && scalar.Erase(it->outpoint),
+              "delete shared-prefix fixture");
+        Check(incremental.Root() == scalar.Root(), "delete collapses like scalar");
+    }
+    Check(incremental.Root() == EmptyUtxoRoot(), "deletion restores empty root");
+
+    // Deterministic randomized sequence stresses path-local splits, partial
+    // empty sibling chains, proof order, and reverse-order undo.
+    uint64_t rng = 0x7a6d43bc53a49e27ULL;
+    auto Next = [&]() {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        return rng;
+    };
+    std::vector<Coin> coins;
+    std::vector<Hash> roots{incremental.Root()};
+    for (unsigned n = 0; n < 96; ++n) {
+        const uint32_t index = static_cast<uint32_t>(Next());
+        Coin coin = MakeCoin(index);
+        Check(incremental.Insert(coin) && scalar.Insert(coin), "random insert");
+        coins.push_back(coin);
+        roots.push_back(incremental.Root());
+        Check(incremental.Root() == scalar.Root(), "random insert root agreement");
+        if (n % 8 == 0) {
+            CheckProof(incremental, scalar, coins[n / 2].outpoint);
+            CheckProof(incremental, scalar, MakeCoin(index ^ 0x80000000U).outpoint);
+        }
+    }
+    const Hash final_root = incremental.Root();
+    IncrementalUtxoSet reversed;
+    for (auto it = coins.rbegin(); it != coins.rend(); ++it) {
+        Check(reversed.Insert(*it), "reverse-order insert");
+    }
+    Check(reversed.Root() == final_root, "root independent of insertion order");
+    for (size_t n = coins.size(); n > 0; --n) {
+        Check(incremental.Erase(coins[n - 1].outpoint) &&
+                  scalar.Erase(coins[n - 1].outpoint),
+              "reverse undo deletion");
+        Check(incremental.Root() == scalar.Root() && incremental.Root() == roots[n - 1],
+              "reverse undo restores exact recorded root");
+        if (n % 11 == 0) {
+            CheckProof(incremental, scalar, coins[n - 1].outpoint);
+        }
+    }
+    Check(incremental.Root() == EmptyUtxoRoot() && incremental.Size() == 0,
+          "full undo restores initial tree");
+    for (const Coin &coin : coins) Check(incremental.Insert(coin), "reinsert after undo");
+    Check(incremental.Root() == final_root, "reinsert restores final root");
+
+    // Mix inserts and deletes from a nonempty tree to exercise repeated
+    // collapse/re-expansion and absent proofs at changing roots.
+    UtxoSet mixed_scalar;
+    IncrementalUtxoSet mixed_incremental;
+    std::vector<Coin> active;
+    uint32_t next_index = 100000;
+    for (unsigned step = 0; step < 240; ++step) {
+        if (active.empty() || (Next() & 3) != 0) {
+            Coin coin = MakeCoin(next_index++);
+            Check(mixed_scalar.Insert(coin) && mixed_incremental.Insert(coin),
+                  "mixed insert");
+            active.push_back(coin);
+        } else {
+            const size_t index = Next() % active.size();
+            const Outpoint spent = active[index].outpoint;
+            Check(mixed_scalar.Erase(spent) && mixed_incremental.Erase(spent),
+                  "mixed delete");
+            active.erase(active.begin() + index);
+            CheckProof(mixed_incremental, mixed_scalar, spent);
+        }
+        Check(mixed_incremental.Root() == mixed_scalar.Root() &&
+                  mixed_incremental.Size() == active.size(),
+              "mixed root and size agree");
+        if (!active.empty()) {
+            CheckProof(mixed_incremental, mixed_scalar, active[Next() % active.size()].outpoint);
+        }
+        CheckProof(mixed_incremental, mixed_scalar, MakeCoin(next_index + 1000).outpoint);
+    }
+    std::cout << "V2 incremental UTXO differential cases passed\n";
+}
