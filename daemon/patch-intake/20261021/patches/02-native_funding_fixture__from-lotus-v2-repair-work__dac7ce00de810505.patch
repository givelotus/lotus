Subject: [PATCH] test(v2): adapt shared Merklix relay fixtures to native
 version7 funding

---
 .../test_framework/merklix_relay.py           | 24 +++++--------------
 1 file changed, 6 insertions(+), 18 deletions(-)

diff --git a/test/functional/test_framework/merklix_relay.py b/test/functional/test_framework/merklix_relay.py
index c4077fa2d9..3d8866eb20 100644
--- a/test/functional/test_framework/merklix_relay.py
+++ b/test/functional/test_framework/merklix_relay.py
@@ -1,23 +1,11 @@
 #!/usr/bin/env python3
-# Copyright (c) 2026 The Bitcoin developers
+# Copyright (c) 2026 The Lotus developers
 # Distributed under the MIT software license, see the accompanying
 # file COPYING or http://www.opensource.org/licenses/mit-license.php.
-"""ABC funding and legacy transaction adapter for Merklix relay tests."""
-from test_framework.hash import hash160
-from test_framework.messages import COutPoint, CTransaction, CTxIn, CTxOut
-from test_framework.script import CScript, OP_DROP, OP_EQUAL, OP_HASH160, OP_TRUE
+"""Native V2 funding adapter for the shared Merklix relay harnesses."""
+from p2p_v2_fast_sync_and_reverse_peel import (
+    V2_OP_TRUE_DESCRIPTOR as FUNDING_DESCRIPTOR,
+    build_v2_op_true_tx as build_merklix_tx,
+)
 
-# A padded redeem script keeps legacy transactions above the policy size floor.
-_REDEEM = CScript([b"\x42" * 48, OP_DROP, OP_TRUE])
-_OUTPUT = CScript([OP_HASH160, hash160(_REDEEM), OP_EQUAL])
-FUNDING_DESCRIPTOR = f"raw({_OUTPUT.hex()})"
-# eCash RPC amounts are XEC (100 satoshis), not consensus COIN (1e8).
 VALUE_UNITS_PER_COIN = 100
-
-
-def build_merklix_tx(prev_txid, prev_index, values):
-    tx = CTransaction()
-    tx.nVersion = 2
-    tx.vin = [CTxIn(COutPoint(prev_txid, prev_index), CScript([_REDEEM]), 0xffffffff)]
-    tx.vout = [CTxOut(value, _OUTPUT) for value in values]
-    return tx
