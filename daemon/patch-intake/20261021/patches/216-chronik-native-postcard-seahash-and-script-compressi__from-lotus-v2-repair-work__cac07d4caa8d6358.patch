+    {
+        const Bytes b{0x02};
+        postcard::Reader r(b);
+        BOOST_CHECK_THROW(r.OptionTag(), postcard::Error);
+    }
+    {
+        const Bytes b{0x02, 0xc3, 0x28}; // invalid utf-8
+        postcard::Reader r(b);
+        BOOST_CHECK_EXCEPTION(r.Str(), postcard::Error, [](const auto &e) {
