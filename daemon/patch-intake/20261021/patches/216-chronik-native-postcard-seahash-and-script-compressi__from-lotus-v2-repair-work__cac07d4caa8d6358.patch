+BOOST_AUTO_TEST_CASE(seahash_golden) {
+    for (size_t n : {0, 1, 7, 8, 9, 15, 16, 17, 23, 24, 25, 31, 32, 33, 63, 64,
+                     65, 100, 1000}) {
+        const Bytes data = Seq(n, 13, 5);
+        Bytes out;
+        PutBe<uint64_t>(out, SeaHash(data));
+        CheckBytes("seahash/" + std::to_string(n), out);
