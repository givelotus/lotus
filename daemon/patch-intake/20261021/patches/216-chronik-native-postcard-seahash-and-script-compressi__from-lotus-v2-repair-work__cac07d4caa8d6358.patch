+++ b/chronik/native/core/codec/postcard.cpp
@@ -0,0 +1,165 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/codec/hex.h>
+#include <chronik/native/codec/postcard.h>
+
+namespace chronik::native::postcard {
+
+void Writer::Varint(uint64_t v) {
+    while (v >= 0x80) {
+        m_out.push_back(uint8_t(v) | 0x80);
+        v >>= 7;
+    }
+    m_out.push_back(uint8_t(v));
+}
+
+void Writer::U128(unsigned __int128 v) {
+    while (v >= 0x80) {
+        m_out.push_back(uint8_t(v) | 0x80);
+        v >>= 7;
+    }
+    m_out.push_back(uint8_t(v));
+}
+
+uint8_t Reader::U8() {
+    if (m_pos >= m_data.size()) {
+        throw Error(std::string(kUnexpectedEnd));
+    }
+    return m_data[m_pos++];
+}
+
+bool Reader::Bool() {
+    const uint8_t b = U8();
+    if (b > 1) {
+        throw Error(std::string(kBadBool));
+    }
+    return b == 1;
+}
+
+bool Reader::OptionTag() {
+    const uint8_t b = U8();
+    if (b > 1) {
+        throw Error(std::string(kBadOption));
+    }
+    return b == 1;
+}
+
+uint64_t Reader::Varint(size_t max_bytes, uint8_t max_last) {
+    uint64_t out = 0;
+    for (size_t i = 0; i < max_bytes; ++i) {
+        const uint8_t val = U8();
+        out |= uint64_t(val & 0x7f) << (7 * i);
+        if ((val & 0x80) == 0) {
+            if (i == max_bytes - 1 && val > max_last) {
+                throw Error(std::string(kBadVarint));
+            }
+            return out;
+        }
+    }
+    throw Error(std::string(kBadVarint));
+}
+
+unsigned __int128 Reader::U128() {
+    unsigned __int128 out = 0;
+    constexpr size_t max_bytes = 19;
+    for (size_t i = 0; i < max_bytes; ++i) {
+        const uint8_t val = U8();
+        out |= (unsigned __int128)(val & 0x7f) << (7 * i);
+        if ((val & 0x80) == 0) {
+            if (i == max_bytes - 1 && val > 0x03) {
+                throw Error(std::string(kBadVarint));
+            }
+            return out;
+        }
+    }
+    throw Error(std::string(kBadVarint));
+}
+
+ByteView Reader::Raw(size_t n) {
+    if (m_data.size() - m_pos < n) {
+        throw Error(std::string(kUnexpectedEnd));
+    }
+    const ByteView v = m_data.subspan(m_pos, n);
+    m_pos += n;
+    return v;
+}
+
+Bytes Reader::ByteVec() {
+    const uint64_t len = Usize();
+    if (len > m_data.size() - m_pos) {
+        throw Error(std::string(kUnexpectedEnd));
+    }
+    const ByteView v = Raw(size_t(len));
+    return Bytes(v.begin(), v.end());
+}
+
+static bool IsValidUtf8(ByteView v) {
+    size_t i = 0;
+    while (i < v.size()) {
+        const uint8_t c = v[i];
+        size_t n;
+        uint32_t cp;
+        if (c < 0x80) {
+            ++i;
+            continue;
+        } else if ((c & 0xe0) == 0xc0) {
+            n = 1;
+            cp = c & 0x1f;
+        } else if ((c & 0xf0) == 0xe0) {
+            n = 2;
+            cp = c & 0x0f;
+        } else if ((c & 0xf8) == 0xf0) {
+            n = 3;
+            cp = c & 0x07;
+        } else {
+            return false;
+        }
+        if (i + n >= v.size()) {
+            return false;
+        }
+        for (size_t k = 1; k <= n; ++k) {
+            if ((v[i + k] & 0xc0) != 0x80) {
+                return false;
+            }
+            cp = (cp << 6) | (v[i + k] & 0x3f);
+        }
+        // Reject overlong encodings, surrogates and out-of-range code points.
+        if ((n == 1 && cp < 0x80) || (n == 2 && cp < 0x800) ||
+            (n == 3 && cp < 0x10000) || cp > 0x10ffff ||
+            (cp >= 0xd800 && cp <= 0xdfff)) {
+            return false;
+        }
+        i += n + 1;
+    }
+    return true;
+}
+
+std::string Reader::Str() {
+    const uint64_t len = Usize();
+    if (len > m_data.size() - m_pos) {
+        throw Error(std::string(kUnexpectedEnd));
+    }
+    const ByteView v = Raw(size_t(len));
+    if (!IsValidUtf8(v)) {
+        throw Error(std::string(kBadUtf8));
+    }
+    return std::string(v.begin(), v.end());
+}
+
+void ThrowDeserializeError(std::string_view type_name, std::string_view error,
+                           ByteView bytes) {
+    throw ChronikError("Inconsistent DB: Cannot deserialize byte sequence as " +
+                       std::string(type_name) + ": " + std::string(error) +
+                       ". Byte sequence: " + HexEncode(bytes));
+}
+
+void ThrowDeserializeLeftover(std::string_view type_name, ByteView processed,
+                              ByteView leftover) {
+    throw ChronikError("Inconsistent DB: Deserializing as " +
+                       std::string(type_name) + " has leftover data: " +
+                       HexEncode(processed) + "[" + HexEncode(leftover) + "]");
+}
+
+} // namespace chronik::native::postcard
diff --git a/chronik/native/core/codec/script_compress.cpp b/chronik/native/core/codec/script_compress.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c65c150e259a6ba979680a0e9018ad4f4ff8e868
--- /dev/null
+++ b/chronik/native/core/codec/script_compress.cpp
@@ -0,0 +1,155 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/codec/script_compress.h>
+
+namespace chronik::native {
+
+namespace {
+constexpr uint8_t OP_DUP = 0x76;
+constexpr uint8_t OP_HASH160 = 0xa9;
+constexpr uint8_t OP_EQUAL = 0x87;
+constexpr uint8_t OP_EQUALVERIFY = 0x88;
+constexpr uint8_t OP_CHECKSIG = 0xac;
+} // namespace
+
+void WriteCoreVarInt(Bytes &out, uint64_t n) {
+    uint8_t tmp[10];
+    size_t len = 0;
+    while (true) {
+        tmp[len] = uint8_t(n & 0x7f) | (len != 0 ? 0x80 : 0x00);
+        if (n <= 0x7f) {
+            break;
+        }
+        n = (n >> 7) - 1;
+        len++;
+    }
+    while (true) {
+        out.push_back(tmp[len]);
+        if (len == 0) {
+            break;
+        }
+        len--;
+    }
+}
+
+bool ReadCoreVarInt(ByteView in, size_t &pos, uint64_t &n) {
+    n = 0;
+    while (true) {
+        if (pos >= in.size()) {
+            return false;
+        }
+        const uint8_t ch = in[pos++];
+        if (n > (UINT64_MAX >> 7)) {
+            return false;
+        }
+        n = (n << 7) | (ch & 0x7f);
+        if (ch & 0x80) {
+            if (n == UINT64_MAX) {
+                return false;
+            }
+            n++;
+        } else {
+            return true;
+        }
+    }
+}
+
+Bytes CompressScript(ByteView s) {
+    Bytes out;
+    // P2PKH: OP_DUP OP_HASH160 <20> OP_EQUALVERIFY OP_CHECKSIG
+    if (s.size() == 25 && s[0] == OP_DUP && s[1] == OP_HASH160 &&
+        s[2] == 20 && s[23] == OP_EQUALVERIFY && s[24] == OP_CHECKSIG) {
+        out.reserve(21);
+        out.push_back(0x00);
+        out.insert(out.end(), s.begin() + 3, s.begin() + 23);
+        return out;
+    }
+    // P2SH: OP_HASH160 <20> OP_EQUAL
+    if (s.size() == 23 && s[0] == OP_HASH160 && s[1] == 20 &&
+        s[22] == OP_EQUAL) {
+        out.reserve(21);
+        out.push_back(0x01);
+        out.insert(out.end(), s.begin() + 2, s.begin() + 22);
+        return out;
+    }
+    // P2PK compressed: <33> pubkey OP_CHECKSIG
+    if (s.size() == 35 && s[0] == 33 && s[34] == OP_CHECKSIG &&
+        (s[1] == 0x02 || s[1] == 0x03)) {
+        return Bytes(s.begin() + 1, s.begin() + 34);
+    }
+    // P2PK uncompressed: <65> 04 x y OP_CHECKSIG
+    if (s.size() == 67 && s[0] == 65 && s[66] == OP_CHECKSIG &&
+        s[1] == 0x04) {
+        out.reserve(33);
+        out.push_back(uint8_t((s[65] & 0x01) | 0x04));
+        out.insert(out.end(), s.begin() + 2, s.begin() + 34);
+        return out;
+    }
+    out.reserve(s.size() + 3);
+    WriteCoreVarInt(out, uint64_t(s.size()) + kCompressNumSpecialScripts);
+    out.insert(out.end(), s.begin(), s.end());
+    return out;
+}
+
+std::optional<Bytes> DecompressScript(ByteView c,
+                                      const DecompressPubKeyFn &decompress) {
+    size_t pos = 0;
+    uint64_t n;
+    if (!ReadCoreVarInt(c, pos, n)) {
+        return std::nullopt;
+    }
+    const ByteView rest = c.subspan(pos);
+    Bytes out;
+    switch (n) {
+        case 0x00:
+            if (rest.size() != 20) {
+                return std::nullopt;
+            }
+            out = {OP_DUP, OP_HASH160, 20};
+            out.insert(out.end(), rest.begin(), rest.end());
+            out.push_back(OP_EQUALVERIFY);
+            out.push_back(OP_CHECKSIG);
+            return out;
+        case 0x01:
+            if (rest.size() != 20) {
+                return std::nullopt;
+            }
+            out = {OP_HASH160, 20};
+            out.insert(out.end(), rest.begin(), rest.end());
+            out.push_back(OP_EQUAL);
+            return out;
+        case 0x02:
+        case 0x03:
+            if (rest.size() != 32) {
+                return std::nullopt;
+            }
+            out = {33, uint8_t(n)};
+            out.insert(out.end(), rest.begin(), rest.end());
+            out.push_back(OP_CHECKSIG);
+            return out;
+        case 0x04:
+        case 0x05: {
+            if (rest.size() != 32 || !decompress) {
+                return std::nullopt;
+            }
+            // Compressed pubkey form: 02/03 || x
+            const auto pk = decompress(c);
+            if (!pk || pk->size() != 65) {
+                return std::nullopt;
+            }
+            out = {65};
+            out.insert(out.end(), pk->begin(), pk->end());
+            out.push_back(OP_CHECKSIG);
+            return out;
+        }
+        default:
+            if (rest.size() != n - kCompressNumSpecialScripts) {
+                return std::nullopt;
+            }
+            return Bytes(rest.begin(), rest.end());
+    }
+}
+
+} // namespace chronik::native
diff --git a/chronik/native/core/codec/seahash.cpp b/chronik/native/core/codec/seahash.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..39300f06f787a1355f80ad5d0ede3c7456145695
--- /dev/null
+++ b/chronik/native/core/codec/seahash.cpp
@@ -0,0 +1,65 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chronik/native/codec/seahash.h>
+
+namespace chronik::native {
+
+namespace {
+
+constexpr uint64_t Diffuse(uint64_t x) {
+    x *= 0x6eed0e9da4d94a4fULL;
+    const uint64_t a = x >> 32;
+    const uint64_t b = x >> 60;
+    x ^= a >> b;
+    x *= 0x6eed0e9da4d94a4fULL;
+    return x;
+}
+
+/** Little-endian read of up to 8 bytes (seahash helper::read_int/read_u64). */
+uint64_t ReadLe(const uint8_t *p, size_t n) {
+    uint64_t v = 0;
+    for (size_t i = 0; i < n; ++i) {
+        v |= uint64_t(p[i]) << (8 * i);
+    }
+    return v;
+}
+
+} // namespace
+
+uint64_t SeaHashSeeded(ByteView buf, uint64_t a, uint64_t b, uint64_t c,
+                       uint64_t d) {
+    const uint8_t *ptr = buf.data();
+    const size_t n_blocks = buf.size() / 32;
+    for (size_t i = 0; i < n_blocks; ++i, ptr += 32) {
+        a = Diffuse(a ^ ReadLe(ptr, 8));
+        b = Diffuse(b ^ ReadLe(ptr + 8, 8));
+        c = Diffuse(c ^ ReadLe(ptr + 16, 8));
+        d = Diffuse(d ^ ReadLe(ptr + 24, 8));
+    }
+    // The excess (< 32 bytes) fills the lanes a, b, c, d in order; every
+    // touched lane is diffused, the last one with a zero-extended partial
+    // little-endian word (State::hash in seahash/src/buffer.rs).
+    size_t excessive = buf.size() - n_blocks * 32;
+    uint64_t *lanes[4] = {&a, &b, &c, &d};
+    for (size_t lane = 0; excessive > 0; ++lane) {
+        const size_t take = excessive < 8 ? excessive : 8;
+        *lanes[lane] = Diffuse(*lanes[lane] ^ ReadLe(ptr, take));
+        ptr += take;
+        excessive -= take;
+    }
+    // finalize
+    a ^= b;
+    c ^= d;
+    a ^= c;
+    a ^= uint64_t(buf.size());
+    return Diffuse(a);
+}
+
+uint64_t SeaHash(ByteView data) {
+    return SeaHashSeeded(data, 0x16f11fe89b0d677cULL, 0xb480a793d8e6c86cULL,
+                         0x6fe2e5aaf078ebc9ULL, 0x14f994a4c5259381ULL);
+}
+
+} // namespace chronik::native
