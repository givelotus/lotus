+                  leveldb::Env *storage_env = nullptr)
+        : p(std::move(profiles)), journal_cap(cap), candidates(candidate_mode),
+          env(storage_env) {
+        auto name = (std::filesystem::canonical(std::filesystem::temp_directory_path()) /
+                     "lotus-v2-real-reorg-XXXXXX").string();
+        Check(mkdtemp(name.data()) != nullptr, "temporary home");
+        path = name;
+        Open();
+    }
+    ~Home() {
+        store = {};
+        std::filesystem::remove_all(path);
+    }
+    void Open() {
+        store = {};
+        DiskStateOptions options;
+        options.env = env;
+        options.cache_bytes = 1024;
+        options.write_buffer_bytes = 64 << 10;
+        options.recovery = DiskRecoveryOptions{journal_cap, 4 << 20};
+        if (candidates) options.candidates = CandidateStoreOptions{64, 64, 8};
+        std::string error;
+        Check(OpenDevelopmentChain(path, Bytes(genesis_wire), p.header,
+                                   p.ordinary, p.monetary, p.cost,
+                                   DecodeMonetaryState(Bytes(initial_money)),
+                                   options, store, error),
+              "open/reopen: " + error);
+    }
+    void Connect(size_t n) {
+        StagedBlockTransition out;
+        std::string error;
+        Check(ConnectEligibleDiskBlock(Bytes(V(n).wire), UINT64_MAX, 0,
+                                       p.header, p.ordinary, p.monetary, p.cost,
+                                       store, out,
+                                       error) == DiskBlockAdmission::Accepted,
+              "real disk complete connect: " + error);
+        Match(n);
+    }
+    void Match(size_t n) {
+        const auto &v = V(n);
+        const auto meta = store.Metadata();
+        Check(meta.tip == H(v.id) && store.Root() == H(v.root) &&
+                  meta.monetary == Bytes(v.monetary),
+              "checkpoint exact tip/root/money");
+        const auto wire = Bytes(v.wire);
+        Check(meta.header == std::vector<uint8_t>(wire.begin(),
+                                                  wire.begin() + HEADER_SIZE),
+              "checkpoint exact header");
+        std::vector<Header> history;
+        std::vector<uint8_t> retained;
+        std::string error;
+        Check(ReadDiskChainContext(meta, p.header, history, retained, error) &&
+                  retained == wire,
+              "checkpoint exact retained body and authenticated history");
+        std::map<Outpoint, std::vector<uint8_t>, OutpointLess> expected, all;
+        for (const auto &coin : v.coins) {
+            auto b = Bytes(coin);
+            expected.emplace(Key(b), b);
+        }
+        for (const auto &row : vectors)
+            for (const auto &coin : row.coins) {
+                auto b = Bytes(coin);
+                all.emplace(Key(b), b);
+            }
+        DiskStateError failure;
+        for (const auto &[key, ignored] : all) {
+            (void)ignored;
+            std::optional<Coin> coin;
+            Check(store.ReadCoin(key, coin, failure), failure.message);
+            auto wanted = expected.find(key);
+            Check(bool(coin) == (wanted != expected.end()),
+                  "all touched coin presence");
+            if (coin) {
+                std::vector<uint8_t> actual;
+                Check(EncodeCoin(*coin, actual) && actual == wanted->second,
+                      "exact touched CoinEntry");
+            }
+            CoinProof proof;
+            Check(store.Prove(key, proof, failure) &&
+                      VerifyCoinProof(key, proof, store.Root()),
+                  "touched coin authenticated proof");
+        }
+        std::optional<ActiveChainIndex> active;
+        Check(store.ReadActiveIndex(active, failure) && active &&
+                  active->tip == meta.tip &&
+                  active->height == HeaderOf(v).height,
+              "atomic I/S agreement");
+        ChainWork expected_work{};
+        expected_work[0] = uint8_t(2 * (HeaderOf(v).height + 1));
+        uint64_t expected_max_time{};
+        for (const auto &h : history)
+            expected_max_time = std::max(expected_max_time, h.time);
+        Check(active->chain_work == expected_work &&
+                  active->max_ancestor_time == expected_max_time,
+              "exact cumulative work and full ancestor eligibility commitment");
+        for (const auto &h : history) {
+            Hash id;
+            Check(BlockId(p.header.chain_id, h, id), "history identity");
+            std::optional<Hash> active_id;
+            std::optional<IndexedHeader> indexed;
+            Check(store.ReadActiveId(h.height, active_id, failure) &&
+                      active_id && *active_id == id,
+                  "atomic active height ancestry");
+            Check(store.ReadIndexedHeader(id, indexed, failure) && indexed &&
+                      indexed->stage == HeaderStage::Connected,
+                  "Connected ancestry");
+        }
+    }
+};
+void Setup(Home &home, bool invalid) {
+    for (size_t n : {0, 1, 2, 3}) {
+        home.Connect(n);
+        home.Open();
+        home.Match(n);
+    }
+    std::string error;
+    for (size_t n : (invalid ? std::vector<size_t>{4, 7, 8}
+                             : std::vector<size_t>{4, 5, 6}))
+        Check(AdmitDevelopmentHeader(HeaderOf(V(n)), home.p.header,
+                                     home.p.ordinary, home.p.monetary,
+                                     home.p.cost, home.store,
+                                     error) == HeaderAdmission::Stored,
+              "replacement contextual header admission: " + error);
+}
+} // namespace runtime_fixture
+#endif
diff --git a/src/lotus_v2/test_dev_genesis.cpp b/src/lotus_v2/test_dev_genesis.cpp
new file mode 100644
index 0000000000..ad229e17e4
--- /dev/null
+++ b/src/lotus_v2/test_dev_genesis.cpp
@@ -0,0 +1,164 @@
+// Copyright (c) 2026 The Lotus developers
+#include "dev_genesis.h"
+
+#include "commitment.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const char *message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+std::string Hex(const Hash &hash) {
+    constexpr char chars[] = "0123456789abcdef";
+    std::string result;
+    for (uint8_t byte : hash) {
+        result.push_back(chars[byte >> 4]);
+        result.push_back(chars[byte & 15]);
+    }
+    return result;
+}
+
+bool SameHeader(const Header &a, const Header &b) {
+    return a.prev_id == b.prev_id && a.bits == b.bits && a.time == b.time &&
+           a.nonce == b.nonce && a.version == b.version && a.size == b.size &&
+           a.height == b.height && a.tx_root == b.tx_root &&
+           a.state_root == b.state_root;
+}
+
+bool ZeroHash(const Hash &hash) {
+    for (uint8_t byte : hash) {
+        if (byte != 0) return false;
+    }
+    return true;
+}
+
+void RejectUnchanged(const Hash &prev_id, uint64_t height) {
+    DevelopmentGenesisFixture rejected;
+    rejected.header.version = 0xdeadbeef;
+    rejected.header.nonce = 7;
+    rejected.header.height = 99;
+    rejected.state.bootstrap_reserve = 123;
+    Check(!MakeDevelopmentGenesis(prev_id, height, rejected),
+          "nonzero previous id or height must be rejected");
+    Check(rejected.header.version == 0xdeadbeef && rejected.header.nonce == 7 &&
+              rejected.header.height == 99 &&
+              rejected.state.bootstrap_reserve == 123,
+          "rejected construction leaves the fixture unchanged");
+}
+} // namespace
+
+int main() {
+    try {
+        Check(HEADER_SIZE == 134, "header encoding is 134 bytes");
+        DevelopmentGenesisFixture fixture;
+        fixture.header.version = 1;
+        Check(MakeDevelopmentGenesis({}, 0, fixture), "construct height 0");
+        Check(fixture.chain_id == kDevelopmentChainId &&
+                  ZeroHash(fixture.chain_id),
+              "development chain id is all zeros");
+        const Header &header = fixture.header;
+        Check(ZeroHash(header.prev_id) && header.nonce == 0 &&
+                  header.version == 2 && header.height == 0 &&
+                  header.time <= MAX_TIME && header.bits == 0x1d00ffff &&
+                  header.size == HEADER_SIZE,
+              "height-0 header fields");
+        Hash pow_limit{};
+        pow_limit[31] = 0xff;
+        Hash target{};
+        Check(DecodeTarget(header.bits, pow_limit, target),
+              "bits stay the header test canonical target");
+
+        // Empty transaction root already pinned by test_commitment.cpp.
+        Hash tx_root{};
+        Check(TransactionRoot({}, tx_root) && header.tx_root == tx_root &&
+                  Hex(header.tx_root) ==
+                      "24518f458e1e543b742619b81b0f24839a1753a447ff5322ca80fcfa705b0856",
+              "tx root is the existing empty commitment");
+
+        Check(fixture.state.bootstrap_reserve == 9 &&
+                  fixture.state.tail_subsidy == 200 &&
+                  fixture.state.prev_work[0] == 9 &&
+                  fixture.state.ema_block_cost == 4,
+              "genesis state is the existing monetary test state");
+        const Hash utxo = EmptyUtxoRoot();
+        const Hash state_root =
+            StateRoot(fixture.chain_id, 0, utxo, fixture.state);
+        const Hash state_root_again =
+            StateRoot(fixture.chain_id, 0, utxo, fixture.state);
+        Check(header.state_root == state_root && state_root == state_root_again,
+              "state root matches two StateRoot calls");
+        Check(Hex(state_root) ==
+                  "3ecef0a5a8524cde7fa2921c52256c5a4306783c6d24e8604ec2b6288ec39acf",
+              "development genesis state root matches the Python fixture");
+
+        std::array<uint8_t, HEADER_SIZE> bytes{};
+        Check(SerializeHeader(header, bytes), "serialize development header");
+        Check(bytes.size() == 134, "serialized header is exactly 134 bytes");
+        Header parsed;
+        parsed.version = 0x11111111;
+        Check(ParseHeader(bytes.data(), bytes.size(), parsed), "parse header");
+        Check(SameHeader(parsed, header), "parse restores the same fields");
+        std::array<uint8_t, HEADER_SIZE> repeated{};
+        Check(SerializeHeader(parsed, repeated) && repeated == bytes,
+              "serialize parsed header");
+
+        DevelopmentGenesisFixture again;
+        Check(MakeDevelopmentGenesis({}, 0, again) &&
+                  SameHeader(again.header, header) &&
+                  again.state.bootstrap_reserve ==
+                      fixture.state.bootstrap_reserve &&
+                  again.state.tail_subsidy == fixture.state.tail_subsidy &&
+                  again.state.prev_work == fixture.state.prev_work &&
+                  again.state.ema_block_cost == fixture.state.ema_block_cost,
+              "fixture construction is deterministic");
+
+        Hash nonzero{};
+        nonzero[0] = 1;
+        RejectUnchanged(nonzero, 0);
+        nonzero[0] = 0;
+        nonzero[31] = 1;
+        RejectUnchanged(nonzero, 0);
+        RejectUnchanged({}, 1);
+        RejectUnchanged({}, UINT64_MAX);
+        nonzero[0] = 1;
+        RejectUnchanged(nonzero, 1);
+
+        // Same AdvanceMonetary arguments as test_monetary.cpp Step(state).
+        // Subsidy 202 is that test's expected integer. The monetary tests do
+        // not pin a state-root integer, so only two calls are compared.
+        // No new economic vector was added.
+        const MonetaryTransition first = AdvanceMonetary(
+            DevelopmentGenesis, fixture.state, 9, {}, 0, 0, 1, 1, 4, 4);
+        const MonetaryTransition second = AdvanceMonetary(
+            DevelopmentGenesis, fixture.state, 9, {}, 0, 0, 1, 1, 4, 4);
+        Check(first.subsidy == 202 && second.subsidy == 202 &&
+                  first.bootstrap_issued == 2 && second.bootstrap_issued == 2 &&
+                  first.state.bootstrap_reserve == 7 &&
+                  second.state.bootstrap_reserve == 7 &&
+                  first.state.tail_subsidy == 200 &&
+                  second.state.tail_subsidy == 200,
+              "existing height-one subsidy");
+        const Hash transition_root =
+            StateRoot(fixture.chain_id, 1, utxo, first.state);
+        const Hash transition_root_again =
+            StateRoot(fixture.chain_id, 1, utxo, second.state);
+        Check(transition_root == transition_root_again,
+              "transition state root is deterministic");
+        Check(transition_root != header.state_root,
+              "issuance step is not the recorded genesis root");
+        std::cout << "development genesis fixture checks passed\n"
+                  << "subsidy 202 matches the existing monetary test; "
+                  << "genesis state root matches the recorded Python digest; "
+                  << "no new economic vector\n";
+    } catch (const std::exception &error) {
+        std::cerr << "development genesis: " << error.what() << '\n';
+        return EXIT_FAILURE;
+    }
+}
diff --git a/src/lotus_v2/test_development_chain.cpp b/src/lotus_v2/test_development_chain.cpp
new file mode 100644
index 0000000000..639be5238d
--- /dev/null
+++ b/src/lotus_v2/test_development_chain.cpp
@@ -0,0 +1,828 @@
+// Copyright (c) 2026 The Lotus developers
+#include "dev_genesis.h"
+#include "development_chain.h"
+#include "disk_body.h"
+#include "header_admission.h"
+#include "signing.h"
+#include <cstdlib>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+using namespace lotus::v2;
+namespace {
+// Explicit easy-target genesis fixture; distinct from toy DevelopmentGenesis 200/9.
+constexpr MonetaryProfile EasyGenesis{2,3,2,4,3,5,2,2000,3,1000,200,Hash{2}};
+void Check(bool value, const std::string &why) {
+    if (!value) throw std::runtime_error(why);
+}
+std::string FreshPath() {
+    auto pattern = (std::filesystem::canonical(std::filesystem::temp_directory_path()) /
+                    "lotus-v2-initializer-XXXXXX").string();
+    Check(mkdtemp(pattern.data()) != nullptr, "temporary path");
+    std::filesystem::remove_all(pattern);
+    return pattern;
+}
+struct Fixture {
+    HeaderChainProfile hp;
+    OrdinaryCandidateProfile op;
+    MonetaryState money;
+    BlockCostProfile costs{1, 1, 1, 1};
+    Header header;
+    Transaction cb;
+    std::vector<uint8_t> wire;
+    std::optional<Coin> coin;
+    Hash root;
+    explicit Fixture(bool burn) {
+        hp.version = 2;
+        hp.genesis_time = 1000;
+        hp.genesis_bits = 0x207fffff;
+        hp.pow_limit.fill(255);
+        hp.half_life_seconds = 172800;
+        hp.spacing_seconds = 120;
+        op.transaction = {32, 32, 8, 512, 8, 8192, 64};
+        op.vm = {512, 8, 8192, 32, 32, 65536, 16, 1000000};
+        op.coinbase_maturity = 2;
+        op.dust_limit = EasyGenesis.dust_limit;
+        op.max_total_invocation_cost = 1000000;
+        op.vm_cost.max_invocation_cost = 1000000;
+        op.vm_cost.structural_byte_cost = 1;
+        // Synthetic positive schedule, not a calibrated network cost profile.
+        for (auto &opcode : op.vm_cost.opcode)
+            opcode.base = 1;
+        money.bootstrap_reserve = 9;
+        money.tail_subsidy = 200;
+        money.prev_work[0] = 2;
+        money.ema_block_cost = 4;
+        Input input;
+        input.flags = 2;
+        input.sequence = UINT32_MAX;
+        cb.inputs = {input};
+        Output output;
+        output.flags = burn ? 2 : 0;
+        output.branches = {BranchLeaf(std::vector<uint8_t>{0x4e})};
+        if (!burn) output.paths = {{0}};
+        cb.outputs = {output};
+        header.version = 2;
+        header.time = 1000;
+        header.bits = hp.genesis_bits;
+        Rebuild();
+    }
+    void Rebuild() {
+        std::string error;
+        IdentityDigests ids;
+        Check(ComputeIdentities(cb, op.transaction, hp.chain_id, ids, error),
+              error);
+        IncrementalUtxoSet tree;
+        coin.reset();
+        if (!cb.outputs[0].IsBurn()) {
+            coin = Coin{{ids.txid, 0}, cb.outputs[0], 0, 0, true};
+            Check(tree.Insert(*coin), "fixture coin");
+        }
+        root = tree.Root();
+        header.state_root = StateRoot(hp.chain_id, 0, root, money);
+        Check(CompleteTransactionRoot({cb}, op.transaction, hp.chain_id,
+                                      header.tx_root, error),
+              error);
+        std::vector<uint8_t> transaction;
+        Check(EncodeTransaction(cb, op.transaction, transaction, error), error);
+        header.size = HEADER_SIZE + 4 + CompactSizeWidth(transaction.size()) +
+                      transaction.size();
+        MineAndEncode();
+    }
+    void MineAndEncode() {
+        std::string error;
+        Hash target, id;
+        Check(DecodeTarget(header.bits, hp.pow_limit, target),
+              "fixture target");
+        header.nonce = 0;
+        for (;; ++header.nonce) {
+            Check(BlockId(hp.chain_id, header, id), "fixture block ID");
+            if (MeetsTarget(id, target)) break;
+        }
+        hp.genesis_id = id;
+        Check(EncodeBlockWire(header, {cb}, op.transaction, wire, error),
+              error);
+    }
+    bool Open(const std::string &path, DiskStateStore &out,
+              std::string &error) const {
+        return OpenDevelopmentChain(path, wire, hp, op, EasyGenesis,
+                                    costs, money, {}, out, error);
+    }
+};
+ChainWork SmallWork(uint64_t value) {
+    ChainWork work{};
+    for (size_t i = 0; i < 8; ++i)
+        work[i] = uint8_t(value >> (8 * i));
+    return work;
+}
+void CheckActiveIndex(const DiskStateStore &store, const Hash &tip,
+                      uint64_t height, uint64_t work, uint64_t max_time) {
+    DiskStateError failure;
+    std::optional<ActiveChainIndex> active;
+    Check(store.ReadActiveIndex(active, failure) && active.has_value(),
+          failure.message);
+    Check(active->tip == tip && active->height == height &&
+              active->chain_work == SmallWork(work) &&
+              active->max_ancestor_time == max_time,
+          "active index matches exact tip height work and ancestor time");
+    std::optional<Hash> at_height;
+    Check(store.ReadActiveId(height, at_height, failure) && at_height == tip,
+          "active height ID matches tip");
+    std::optional<IndexedHeader> indexed;
+    Check(store.ReadIndexedHeader(tip, indexed, failure) && indexed.has_value(),
+          failure.message);
+    Check(indexed->header.height == height &&
+              indexed->chain_work == SmallWork(work) &&
+              indexed->max_ancestor_time == max_time &&
+              indexed->stage == HeaderStage::Connected,
+          "connected header index matches active index");
+}
+void CheckValid(bool burn) {
+    Fixture f(burn);
+    const auto path = FreshPath();
+    DiskStateStore store;
+    std::string error;
+    Check(f.Open(path, store, error), error);
+    const auto metadata = store.Metadata();
+    CheckActiveIndex(store, f.hp.genesis_id, 0, 2, f.header.time);
+    const auto money = EncodeMonetaryState(f.money);
+    Check(metadata.tip == f.hp.genesis_id && store.Root() == f.root,
+          "exact genesis ID/root");
+    Check(metadata.monetary == std::vector<uint8_t>(money.begin(), money.end()),
+          "genesis never advances monetary state");
+    Check(metadata.header == std::vector<uint8_t>(f.wire.begin(),
+                                                  f.wire.begin() + HEADER_SIZE),
+          "exact persisted genesis header");
+    std::vector<Header> history;
+    std::vector<uint8_t> body;
+    Check(ReadDiskChainContext(metadata, f.hp, history, body, error) &&
+              history.size() == 1 && body == f.wire,
+          "exact genesis history/body");
+    auto check_coin = [&] {
+        DiskStateError failure;
+        std::optional<Coin> found;
+        IdentityDigests ids;
+        Check(ComputeIdentities(f.cb, f.op.transaction, f.hp.chain_id, ids,
+                                error),
+              error);
+        Check(store.ReadCoin({ids.txid, 0}, found, failure), failure.message);
+        Check(found.has_value() == !burn,
+              "burn pruned; spendable zero retained");
+        if (found)
+            Check(found->output.value == 0 && found->creation_height == 0 &&
+                      found->creation_parent_mtp == 0 && found->coinbase,
+                  "genesis zero-coin context");
+    };
+    check_coin();
+    Check(!f.Open(path, store, error) && store.Metadata() == metadata &&
+              store.Root() == f.root,
+          "already-open output rejected without mutation");
+    store = DiskStateStore{};
+    Check(f.Open(path, store, error), error);
+    Check(store.Metadata() == metadata && store.Root() == f.root,
+          "exact reopen");
+    check_coin();
+    // Reject another exact manifest without mutating existing storage or
+    // output.
+    store = DiskStateStore{};
+    Fixture other = f;
+    ++other.header.time;
+    ++other.hp.genesis_time;
+    other.Rebuild();
+    DiskStateStore untouched;
+    Check(!other.Open(path, untouched, error) && !untouched.IsOpen(),
+          "different manifest rejected");
+    Check(f.Open(path, store, error) && store.Metadata() == metadata &&
+              store.Root() == f.root,
+          "failed alternate open preserves existing state");
+    store = DiskStateStore{};
+    std::filesystem::remove_all(path);
+}
+void InvalidBeforeOpen() {
+    for (unsigned mutation = 0; mutation < 7; ++mutation) {
+        Fixture f(true);
+        switch (mutation) {
+            case 0:
+                f.hp.genesis_id = {};
+                break;
+            case 1:
+                f.header.state_root[0] ^= 1;
+                break;
+            case 2:
+                f.money.prev_work[0] = 3;
+                break;
+            case 3:
+                f.cb.inputs[0].prev_index = 1;
+                f.Rebuild();
+                break;
+            case 4:
+                f.cb.outputs[0].value = 1;
+                f.Rebuild();
+                break;
+            case 5:
+                f.wire.pop_back();
+                break;
+            case 6:
+                f.header.tx_root[0] ^= 1;
+                break;
+        }
+        if (mutation == 1 || mutation == 6) {
+            f.MineAndEncode();
+        }
+        const auto path = FreshPath();
+        DiskStateStore out;
+        std::string error;
+        Check(!f.Open(path, out, error),
+              "invalid genesis accepted mutation " + std::to_string(mutation));
+        const char *reasons[] = {"explicit genesis identity",
+                                 "genesis state commitment",
+                                 "initial monetary genesis work",
+                                 "coinbase",
+                                 "genesis native issuance",
+                                 "block",
+                                 "transaction root"};
+        Check(error.find(reasons[mutation]) != std::string::npos,
+              "unexpected rejection reason for mutation " +
+                  std::to_string(mutation) + ": " + error);
+        Check(!out.IsOpen() && !std::filesystem::exists(path),
+              "invalid genesis created database path");
+    }
+}
+void InvalidProfilesBeforeOpen() {
+    for (unsigned mutation = 0; mutation < 13; ++mutation) {
+        Fixture f(true);
+        switch (mutation) {
+            case 0:
+                f.op.coinbase_maturity = 0;
+                break;
+            case 1:
+                f.op.max_total_invocation_cost = 0;
+                break;
+            case 2:
+                f.op.vm_cost.max_invocation_cost = 0;
+                break;
+            case 3:
+                ++f.op.dust_limit;
+                break;
+            case 4:
+                f.op.vm.max_script_bytes = 0;
+                break;
+            case 5:
+                f.op.vm.max_element_bytes = 0;
+                break;
+            case 6:
+                f.op.vm.max_element_bytes = VM_HARD_ELEMENT_BYTES + 1;
+                break;
+            case 7:
+                f.op.vm.max_stack_items = 0;
+                break;
+            case 8:
+                f.op.vm.max_altstack_items = 0;
+                break;
+            case 9:
+                f.op.vm.max_vm_bytes = 0;
+                break;
+            case 10:
+                f.op.vm.max_ast_depth = 0;
+                break;
+            case 11:
+                f.op.vm.max_steps = 0;
+                break;
+            case 12:
+                f.op.dust_limit = 0;
+                break;
+        }
+        const auto path = FreshPath();
+        DiskStateStore out;
+        std::string error;
+        Check(!f.Open(path, out, error),
+              "invalid development profile accepted");
+        const auto reason = mutation <= 2 || mutation == 12
+                                ? "ordinary profile resource limits"
+                            : mutation == 3 ? "dust mismatch"
