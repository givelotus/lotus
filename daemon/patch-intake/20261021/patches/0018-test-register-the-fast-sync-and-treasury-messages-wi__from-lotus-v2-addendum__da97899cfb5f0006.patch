From 3b16ddac1c45dfeae1c78d102d9ba74f7f996046 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:42:28 -0700
Subject: [PATCH] test: register the fast-sync and treasury messages with
 P2PConnection

v2/044 added msg_getutxoroots, msg_utxoroots, msg_getutxoshard,
msg_utxoshard, msg_getblockundo, msg_blockundo and msg_avatreasury to
the test framework, but not to MESSAGEMAP. P2PConnection drops the
connection on any message type it does not know, so
p2p_v2_fast_sync_and_reverse_peel's peers died with "Received unknown
msgtype ... utxoroots" as soon as the node answered, and their
on_utxoroots/on_utxoshard/on_blockundo/on_getutxo* handlers could never
run.

They are now registered. p2p_v2_fast_sync_and_reverse_peel passes,
which exercises every one of the fast-sync messages in both directions.

Tier: V2 (fixup to v2/044)
---
 test/functional/test_framework/p2p.py | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/test/functional/test_framework/p2p.py b/test/functional/test_framework/p2p.py
index d3cee2f672..335ead0549 100644
--- a/test/functional/test_framework/p2p.py
+++ b/test/functional/test_framework/p2p.py
@@ -42,7 +42,9 @@ from test_framework.messages import (
     msg_avabatch,
     msg_avaproofs,
     msg_avaproofsreq,
+    msg_avatreasury,
     msg_block,
+    msg_blockundo,
     msg_blocktxn,
     msg_cfcheckpt,
     msg_cfheaders,
@@ -57,8 +59,11 @@ from test_framework.messages import (
     msg_getavaproofs,
     msg_getblocks,
     msg_getblocktxn,
+    msg_getblockundo,
     msg_getdata,
     msg_getheaders,
+    msg_getutxoroots,
+    msg_getutxoshard,
     msg_headers,
     msg_inv,
     msg_mempool,
@@ -71,6 +76,8 @@ from test_framework.messages import (
     msg_sendheaders,
     msg_tcpavaresponse,
     msg_tx,
+    msg_utxoroots,
+    msg_utxoshard,
     msg_verack,
     msg_version,
     sha256,
@@ -115,9 +122,11 @@ MESSAGEMAP = {
     b"avaproofs": msg_avaproofs,
     b"avaproofsreq": msg_avaproofsreq,
     b"avaresponse": msg_tcpavaresponse,
+    b"avatreasury": msg_avatreasury,
     b"avahello": msg_avahello,
     b"block": msg_block,
     b"blocktxn": msg_blocktxn,
+    b"blockundo": msg_blockundo,
     b"cfcheckpt": msg_cfcheckpt,
     b"cfheaders": msg_cfheaders,
     b"cfilter": msg_cfilter,
@@ -131,8 +140,11 @@ MESSAGEMAP = {
     b"getavaproofs": msg_getavaproofs,
     b"getblocks": msg_getblocks,
     b"getblocktxn": msg_getblocktxn,
+    b"getblockundo": msg_getblockundo,
     b"getdata": msg_getdata,
     b"getheaders": msg_getheaders,
+    b"getutxoroots": msg_getutxoroots,
+    b"getutxoshard": msg_getutxoshard,
     b"headers": msg_headers,
     b"inv": msg_inv,
     b"mempool": msg_mempool,
@@ -144,6 +156,8 @@ MESSAGEMAP = {
     b"sendcmpct": msg_sendcmpct,
     b"sendheaders": msg_sendheaders,
     b"tx": msg_tx,
+    b"utxoroots": msg_utxoroots,
+    b"utxoshard": msg_utxoshard,
     b"verack": msg_verack,
     b"version": msg_version,
 }
