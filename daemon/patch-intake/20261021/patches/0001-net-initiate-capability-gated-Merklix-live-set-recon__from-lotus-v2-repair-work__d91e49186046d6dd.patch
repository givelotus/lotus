+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#include <protocol.h>
+#include <streams.h>
+#include <boost/test/unit_test.hpp>
+BOOST_AUTO_TEST_SUITE(merklix_wire_tests)
+BOOST_AUTO_TEST_CASE(all_enumerated_commands_fit_and_roundtrip_transport_header) {
+    const CMessageHeader::MessageMagic magic{{1, 2, 3, 4}};
+    BOOST_CHECK_EQUAL(std::string(NetMsgType::GETMERKLIXBUCK), "getmrklbckt");
+    BOOST_CHECK_GT(std::string(NetMsgType::LEGACY_GETMERKLIXBUCK).size(),
+                   CMessageHeader::MESSAGE_TYPE_SIZE);
+    for (const auto &command : getAllNetMessageTypes()) {
+        BOOST_REQUIRE_LE(command.size(), CMessageHeader::MESSAGE_TYPE_SIZE);
+        CMessageHeader header(magic, command.c_str(), 42);
+        DataStream bytes;
+        bytes << header;
+        BOOST_CHECK_EQUAL(bytes.size(), CMessageHeader::HEADER_SIZE);
+        CMessageHeader parsed;
+        bytes >> parsed;
+        BOOST_CHECK(parsed.IsMessageTypeValid());
+        BOOST_CHECK_EQUAL(parsed.GetMessageType(), command);
+        BOOST_CHECK_EQUAL(parsed.nMessageSize, 42U);
+        BOOST_CHECK(parsed.pchMessageStart == magic);
+    }
+}
+BOOST_AUTO_TEST_SUITE_END()
