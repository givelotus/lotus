From b6834b6d91ceceb0383a941cfadfc9844bc96d83 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:03:55 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

Owner-context transport of source fixup d01feb0fcccba9310ab3605f4275445bc7c2d412. Nonfinite JSON is null; finite formatting unchanged. Generic native regression avoids later-format dependencies. Actual-source native and artifact fail/pass receipts accompany this packet. No conversion tail included.
---
 src/logging/encoder.cpp          | 10 +++++++++-
 src/test/logging_event_tests.cpp | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/src/logging/encoder.cpp b/src/logging/encoder.cpp
index a699abaa48..b538474c64 100644
--- a/src/logging/encoder.cpp
+++ b/src/logging/encoder.cpp
@@ -14,2 +14,3 @@
 #include <chrono>
+#include <cmath>
 
@@ -293,3 +294,2 @@ namespace {
             case FieldKind::U64:
-            case FieldKind::F64:
             case FieldKind::DURATION_NS:
@@ -297,2 +297,10 @@ namespace {
                 return;
+            case FieldKind::F64:
+                // JSON has no NaN or infinity literals; retain the key as null.
+                if (std::isfinite(f.F64())) {
+                    f.AppendText(out);
+                } else {
+                    out += "null";
+                }
+                return;
             case FieldKind::BOOL:
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 31ff98ec61..4293c14204 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -15,3 +15,5 @@
 #include <chrono>
+#include <cmath>
 #include <fstream>
+#include <limits>
 #include <memory>
@@ -91,2 +93,32 @@ BOOST_FIXTURE_TEST_SUITE(logging_event_tests, EventLogSetup)
 
+BOOST_AUTO_TEST_CASE(nonfinite_float_fields_produce_valid_json) {
+    // Raw consumer fixture: Value supplies a name, not a producer type contract.
+    BCLog::JsonEncoder encoder;
+    const BCLog::LogEventSite site{"numeric_encoding", nullptr, BCLog::ALL,
+                                   BCLog::Level::Info};
+    for (const double value : {1.25, std::numeric_limits<double>::quiet_NaN(),
+                               std::numeric_limits<double>::infinity(),
+                               -std::numeric_limits<double>::infinity()}) {
+        std::array<std::byte, sizeof(BCLog::FieldHeader) + sizeof(value)> data;
+        const BCLog::FieldHeader header{BCLog::FieldId::Value,
+                                        BCLog::FieldKind::F64, false,
+                                        sizeof(value), 0};
+        std::memcpy(data.data(), &header, sizeof(header));
+        std::memcpy(data.data() + sizeof(header), &value, sizeof(value));
+        BCLog::LogLine line{};
+        line.level = BCLog::Level::Info;
+        line.category = BCLog::ALL;
+        line.event = &site;
+        line.fields = BCLog::FieldList{data, 1};
+        std::string encoded;
+        encoder.Encode(line, BCLog::LogOptions{.timestamps = false}, encoded);
+        UniValue record;
+        const bool valid{record.read(encoded)};
+        BOOST_CHECK_MESSAGE(valid, encoded);
+        if (!valid) continue;
+        if (std::isfinite(value)) BOOST_CHECK_EQUAL(record["value"].get_real(), value);
+        else BOOST_CHECK(record["value"].isNull());
+    }
+}
+
 BOOST_AUTO_TEST_CASE(event_text_and_json) {
