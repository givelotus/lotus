From 069a02ff42ab67dfe3b6803f2a9a507465a6560a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:18:43 -0700
Subject: [PATCH] logging: structure SQLite statement and transaction
 diagnostics

Convert eleven statement binding/execution, cursor and transaction diagnostics. Capture SQLite error strings before resetting or closing statements, and preserve original levels and human wording. Wallet notification callbacks are untouched.

Scripted diff (run from this commit parent repository root):
/private/tmp/beast-http-p2p-patches/parallel/metrics/conversion-tool/venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/sqlite-statements.json --report /tmp/lotus-logging-sqlite-statements-codemod.json --apply
Engine: ast-grep-py 0.51.0 (requirements tracked alongside script).
Tracked script: contrib/logging/conversion/convert.py
Script SHA256: 0d3524bb806867089e1bf621862c1f169340ad7a2560bdeb1a9414617c1fbc48
Tracked rules: contrib/logging/conversion/rules/sqlite-statements.json
Rules SHA256: 5f04e3f8425e079c2cd8f8ca2981c8a8327acb1080dd7ccb4bc45a75c3ab9faa
Input scope: src/wallet/sqlite.cpp
Prerequisite tool commit: 43d5848cf66d39fa34b84890f59d2fad087f3615
Manual adjustments outside catalog: none.
Scripted non-call support adjustments: src/wallet/sqlite.cpp: Preserve reviewed local indentation and line wrapping only; src/wallet/sqlite.cpp: Preserve reviewed local indentation and line wrapping only.

Full standard functional suite: 259 passed, 61 platform/disabled skips, zero failures/errors. All five targets, targeted native tests and event lint pass. Candidate tree 7437124f754d7f5fa640a9738e966a06fed1f4f7 stayed unchanged.
---
 src/wallet/sqlite.cpp | 58 ++++++++++++++++++++++++++++---------------
 1 file changed, 38 insertions(+), 20 deletions(-)

diff --git a/src/wallet/sqlite.cpp b/src/wallet/sqlite.cpp
index 294f9f8781..0069bbf2e0 100644
--- a/src/wallet/sqlite.cpp
+++ b/src/wallet/sqlite.cpp
@@ -418,8 +418,10 @@ bool SQLiteBatch::ReadKey(DataStream &&key, DataStream &value) {
     int res = sqlite3_bind_blob(m_read_stmt, 1, key.data(), key.size(),
                                 SQLITE_STATIC);
     if (res != SQLITE_OK) {
-        LogPrintf("%s: Unable to bind statement: %s\n", __func__,
-                  sqlite3_errstr(res));
+        LogInfoEvent(BCLog::ALL, "sqlite_statement_bind_failed",
+                     "{name}: Unable to bind statement: {error}")
+            .Field(BCLog::LogField::Name, __func__)
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
         sqlite3_clear_bindings(m_read_stmt);
         sqlite3_reset(m_read_stmt);
         return false;
@@ -428,8 +430,10 @@ bool SQLiteBatch::ReadKey(DataStream &&key, DataStream &value) {
     if (res != SQLITE_ROW) {
         if (res != SQLITE_DONE) {
             // SQLITE_DONE means "not found", don't log an error in that case.
-            LogPrintf("%s: Unable to execute statement: %s\n", __func__,
-                      sqlite3_errstr(res));
+            LogInfoEvent(BCLog::ALL, "sqlite_statement_execute_failed",
+                         "{name}: Unable to execute statement: {error}")
+                .Field(BCLog::LogField::Name, __func__)
+                .Field(BCLog::LogField::Error, sqlite3_errstr(res));
         }
         sqlite3_clear_bindings(m_read_stmt);
         sqlite3_reset(m_read_stmt);
@@ -463,16 +467,20 @@ bool SQLiteBatch::WriteKey(DataStream &&key, DataStream &&value,
     // Insert index 1 is key, 2 is value
     int res = sqlite3_bind_blob(stmt, 1, key.data(), key.size(), SQLITE_STATIC);
     if (res != SQLITE_OK) {
-        LogPrintf("%s: Unable to bind key to statement: %s\n", __func__,
-                  sqlite3_errstr(res));
+        LogInfoEvent(BCLog::ALL, "sqlite_key_bind_failed",
+                     "{name}: Unable to bind key to statement: {error}")
+            .Field(BCLog::LogField::Name, __func__)
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
         sqlite3_clear_bindings(stmt);
         sqlite3_reset(stmt);
         return false;
     }
     res = sqlite3_bind_blob(stmt, 2, value.data(), value.size(), SQLITE_STATIC);
     if (res != SQLITE_OK) {
-        LogPrintf("%s: Unable to bind value to statement: %s\n", __func__,
-                  sqlite3_errstr(res));
+        LogInfoEvent(BCLog::ALL, "sqlite_value_bind_failed",
+                     "{name}: Unable to bind value to statement: {error}")
+            .Field(BCLog::LogField::Name, __func__)
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
         sqlite3_clear_bindings(stmt);
         sqlite3_reset(stmt);
         return false;
@@ -483,8 +491,10 @@ bool SQLiteBatch::WriteKey(DataStream &&key, DataStream &&value,
     sqlite3_clear_bindings(stmt);
     sqlite3_reset(stmt);
     if (res != SQLITE_DONE) {
-        LogPrintf("%s: Unable to execute statement: %s\n", __func__,
-                  sqlite3_errstr(res));
+        LogInfoEvent(BCLog::ALL, "sqlite_statement_execute_failed",
+                     "{name}: Unable to execute statement: {error}")
+            .Field(BCLog::LogField::Name, __func__)
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
     }
     return res == SQLITE_DONE;
 }
@@ -499,8 +509,10 @@ bool SQLiteBatch::EraseKey(DataStream &&key) {
     int res = sqlite3_bind_blob(m_delete_stmt, 1, key.data(), key.size(),
                                 SQLITE_STATIC);
     if (res != SQLITE_OK) {
-        LogPrintf("%s: Unable to bind statement: %s\n", __func__,
-                  sqlite3_errstr(res));
+        LogInfoEvent(BCLog::ALL, "sqlite_statement_bind_failed",
+                     "{name}: Unable to bind statement: {error}")
+            .Field(BCLog::LogField::Name, __func__)
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
         sqlite3_clear_bindings(m_delete_stmt);
         sqlite3_reset(m_delete_stmt);
         return false;
@@ -511,8 +523,10 @@ bool SQLiteBatch::EraseKey(DataStream &&key) {
     sqlite3_clear_bindings(m_delete_stmt);
     sqlite3_reset(m_delete_stmt);
     if (res != SQLITE_DONE) {
-        LogPrintf("%s: Unable to execute statement: %s\n", __func__,
-                  sqlite3_errstr(res));
+        LogInfoEvent(BCLog::ALL, "sqlite_statement_execute_failed",
+                     "{name}: Unable to execute statement: {error}")
+            .Field(BCLog::LogField::Name, __func__)
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
     }
     return res == SQLITE_DONE;
 }
@@ -562,9 +576,10 @@ bool SQLiteBatch::ReadAtCursor(DataStream &key, DataStream &value,
         return true;
     }
     if (res != SQLITE_ROW) {
-        LogPrintf(
-            "SQLiteBatch::ReadAtCursor: Unable to execute cursor step: %s\n",
-            sqlite3_errstr(res));
+        LogInfoEvent(
+            BCLog::ALL, "sqlite_cursor_step_failed",
+            "SQLiteBatch::ReadAtCursor: Unable to execute cursor step: {error}")
+            .Field(BCLog::LogField::Error, sqlite3_errstr(res));
         return false;
     }
 
@@ -590,7 +605,8 @@ bool SQLiteBatch::TxnBegin() {
     int res = sqlite3_exec(m_database.m_db, "BEGIN TRANSACTION", nullptr,
                            nullptr, nullptr);
     if (res != SQLITE_OK) {
-        LogPrintf("SQLiteBatch: Failed to begin the transaction\n");
+        LogInfoEvent(BCLog::ALL, "sqlite_transaction_begin_failed",
+                     "SQLiteBatch: Failed to begin the transaction");
     }
     return res == SQLITE_OK;
 }
@@ -602,7 +618,8 @@ bool SQLiteBatch::TxnCommit() {
     int res = sqlite3_exec(m_database.m_db, "COMMIT TRANSACTION", nullptr,
                            nullptr, nullptr);
     if (res != SQLITE_OK) {
-        LogPrintf("SQLiteBatch: Failed to commit the transaction\n");
+        LogInfoEvent(BCLog::ALL, "sqlite_transaction_commit_failed",
+                     "SQLiteBatch: Failed to commit the transaction");
     }
     return res == SQLITE_OK;
 }
@@ -614,7 +631,8 @@ bool SQLiteBatch::TxnAbort() {
     int res = sqlite3_exec(m_database.m_db, "ROLLBACK TRANSACTION", nullptr,
                            nullptr, nullptr);
     if (res != SQLITE_OK) {
-        LogPrintf("SQLiteBatch: Failed to abort the transaction\n");
+        LogInfoEvent(BCLog::ALL, "sqlite_transaction_abort_failed",
+                     "SQLiteBatch: Failed to abort the transaction");
     }
     return res == SQLITE_OK;
 }
