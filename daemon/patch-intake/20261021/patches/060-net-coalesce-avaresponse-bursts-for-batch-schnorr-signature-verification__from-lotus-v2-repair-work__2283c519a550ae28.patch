+                               trailing_non_ava_msg->m_recv,
+                               trailing_non_ava_msg->m_time, interruptMsgProc);
+            }
         } else {
             ProcessMessage(config, *pfrom, msg.m_type, msg.m_recv, msg.m_time,
                            interruptMsgProc);
