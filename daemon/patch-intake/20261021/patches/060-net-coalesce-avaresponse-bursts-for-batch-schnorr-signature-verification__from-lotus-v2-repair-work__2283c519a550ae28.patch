+                                   /*is_incoming=*/true);
+                }
+
+                if (next_msg.m_type == NetMsgType::AVARESPONSE) {
+                    ava_batch.push_back(std::move(next_msg));
+                } else {
+                    trailing_non_ava_msg.emplace(std::move(next_msg));
+                    break;
+                }
+            }
+
+            ProcessAvaResponseBatch(config, *pfrom, *peer, ava_batch,
