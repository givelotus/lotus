new file mode 100644
index 0000000000000000000000000000000000000000..d17407a78f01bc3723822b49b53f21b1ed18693f
--- /dev/null
+++ b/src/lotus_v2/field_size.cpp
@@ -0,0 +1,63 @@
+// Copyright (c) 2026 The Lotus developers
+#include "field_size.h"
+
+#include <utility>
+
+namespace lotus::v2 {
+namespace {
+
+void AccumulatePaths(const std::vector<std::vector<uint8_t>> &paths,
+                     std::vector<size_t> &sizes) {
+    for (size_t slot = 0; slot < paths.size(); ++slot) {
+        const size_t encoded = PathSerializedSize(paths[slot]);
+        if (sizes.size() <= slot) sizes.resize(slot + 1, 0);
+        if (encoded > sizes[slot]) sizes[slot] = encoded;
+    }
+}
+
+} // namespace
+
+bool OutputSerializedSize(const Output &output, size_t &size,
+                          std::string &error) {
+    return ComputeOutputSerializedSize(output, size, error);
+}
+
+bool DeriveFieldSizes(const VmExecutionContext &context,
+                      std::map<uint8_t, std::vector<size_t>> &field_sizes,
+                      std::string &error) {
+    std::vector<size_t> outputs;
+    outputs.reserve(context.tx.outputs.size());
+    for (const Output &output : context.tx.outputs) {
+        size_t size = 0;
+        if (!OutputSerializedSize(output, size, error)) {
+            field_sizes.clear();
+            return false;
+        }
+        outputs.push_back(size);
+    }
+    std::vector<size_t> coins(context.tx.inputs.size(), 0);
+    std::vector<size_t> coin_paths;
+    std::vector<size_t> output_paths;
+    for (size_t i = 0; i < context.tx.inputs.size(); ++i) {
+        if (i >= context.resolved.size() || !context.resolved[i]) continue;
+        const Output &coin = *context.resolved[i];
+        size_t size = 0;
+        if (!OutputSerializedSize(coin, size, error)) {
+            field_sizes.clear();
+            return false;
+        }
+        coins[i] = size;
+        AccumulatePaths(coin.paths, coin_paths);
+    }
+    for (const Output &output : context.tx.outputs)
+        AccumulatePaths(output.paths, output_paths);
+    field_sizes.clear();
+    field_sizes.emplace(0xdb, std::move(coin_paths));
+    field_sizes.emplace(0xdc, std::move(coins));
+    field_sizes.emplace(0xe6, std::move(output_paths));
+    field_sizes.emplace(0xe7, std::move(outputs));
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/generate_sparse_vectors.py b/src/lotus_v2/generate_sparse_vectors.py
new file mode 100644
index 0000000000000000000000000000000000000000..5629002c615581e401d3a2c10188e3e96dba01c1
--- /dev/null
+++ b/src/lotus_v2/generate_sparse_vectors.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Independent P02 collapsed sparse-map vectors; blake3==1.0.11."""
+import json
+
+import blake3
+
+
+def h(tag, value):
+    return blake3.blake3(b"Lotus/v2/" + tag.encode() + b"\0" + value).digest()
+
+
+def le(value, width):
+    return value.to_bytes(width, "little")
+
+
+def cs(n):
+    if n < 253:
+        return bytes([n])
+    if n <= 65535:
+        return b"\xfd" + le(n, 2)
+    if n <= 0xFFFFFFFF:
+        return b"\xfe" + le(n, 4)
+    return b"\xff" + le(n, 8)
+
+
+TXID = bytes(range(32))
+OUTPUT = b"\x00" + le(1000, 8) + b"\x01" + b"\x11" * 32 + b"\x01\x01\x00"
+
+
+def coin(index, height=7, mtp=1234, coinbase=1):
+    outpoint = TXID + le(index, 4)
+    record = outpoint + cs(len(OUTPUT)) + OUTPUT + le(height, 8) + le(mtp, 8) + bytes([coinbase])
+    key = h("outpointkey", outpoint)
+    leaf = h("utxo", b"\x00" + key + cs(len(record)) + record)
+    return key, leaf, record
+
+
+EMPTY = h("utxo", b"\x02")
+
+
+def bit(key, depth):
+    return (key[depth // 8] >> (depth % 8)) & 1
+
+
+def tree(coins, depth=0):
+    if not coins:
+        return EMPTY
+    if len(coins) == 1:
+        return coins[0][1]
+    left = [c for c in coins if not bit(c[0], depth)]
+    right = [c for c in coins if bit(c[0], depth)]
+    return h("utxo", b"\x01" + le(depth, 2) + tree(left, depth + 1) + tree(right, depth + 1))
+
+
+def main():
+    assert blake3.__version__ == "1.0.11"
+    first = coin(0)
+    same_prefix = next(i for i in range(1, 1000) if coin(i)[0][0] & 15 == first[0][0] & 15)
+    other_first_bit = next(i for i in range(1, 1000) if bit(coin(i)[0], 0) != bit(first[0], 0))
+    second, third = coin(same_prefix), coin(other_first_bit)
+    monetary = le(11, 8) + le(22, 8) + bytes(range(32)) + le(33, 8)
+    chain = bytes(range(32, 64))
+    root = tree([first, second, third])
+    state = h("state", b"\x00" + chain + le(9, 8) + root + cs(len(monetary)) + monetary)
+    print(json.dumps({
+        "dependency": "python-blake3 1.0.11",
+        "index_same_prefix": same_prefix,
+        "index_other_first_bit": other_first_bit,
+        "key_0": first[0].hex(),
+        "coin_0": first[2].hex(),
+        "leaf_0": first[1].hex(),
+        "empty_root": EMPTY.hex(),
+        "root_2_colliding_prefix": tree([first, second]).hex(),
+        "root_3": root.hex(),
+        "changed_metadata_root": tree([coin(0, 8), second, third]).hex(),
+        "monetary": monetary.hex(),
+        "state_root": state.hex(),
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()
