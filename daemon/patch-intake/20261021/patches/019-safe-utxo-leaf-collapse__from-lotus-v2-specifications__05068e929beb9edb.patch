From e635fa8799272383faf4955616412feb7aa0c4c6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:28:04 -0700
Subject: [PATCH] Move surviving UTXO leaf clear of parent before collapse

When a branch drops to one leaf, extract the remaining child to a local owner before replacing and destroying its parent. This avoids moving from a subobject whose enclosing node is being destroyed.
---
 src/lotus_v2/incremental_utxo.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/incremental_utxo.cpp b/src/lotus_v2/incremental_utxo.cpp
index 0995f5027..43665aa95 100644
--- a/src/lotus_v2/incremental_utxo.cpp
+++ b/src/lotus_v2/incremental_utxo.cpp
@@ -127,7 +127,8 @@ bool IncrementalUtxoSet::EraseAt(std::unique_ptr<Node> &node,
     if (node->count == 1) {
         const unsigned remaining = node->child[0] ? 0 : 1;
         assert(node->child[remaining] && node->child[remaining]->IsLeaf());
-        node = std::move(node->child[remaining]);
+        auto survivor = std::move(node->child[remaining]);
+        node = std::move(survivor);
     } else {
         node->Refresh(depth);
     }
