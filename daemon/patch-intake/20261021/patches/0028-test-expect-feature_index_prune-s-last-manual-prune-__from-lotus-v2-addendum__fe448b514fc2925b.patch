From c2d7b90502627d882524b67172588f262d6f383f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:51:20 -0700
Subject: [PATCH] test: expect feature_index_prune's last manual prune at 8 *
 269 - 1

v2/034 scaled eCash's 6 * 346 - 1 to 9 * 269 - 1. eCash's expectation
stops at the end of the file before the one containing tip - 288 (the
tip is 2500, so blocks above 2212 are kept). With V2's 269 blocks per
file, that file holds 2152..2420, so pruning ends at 2151 = 8 * 269 - 1,
which the node logs as deleting blk/rev 00000..00007. The test passes
twice in a row under test_runner.

Tier: V2 (fixup to v2/034)
---
 test/functional/feature_index_prune.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/test/functional/feature_index_prune.py b/test/functional/feature_index_prune.py
index 677d06297f..185f06b564 100644
--- a/test/functional/feature_index_prune.py
+++ b/test/functional/feature_index_prune.py
@@ -195,7 +195,10 @@ class FeatureIndexPruneTest(BitcoinTestFramework):
         for node in self.nodes[:2]:
             with node.assert_debug_log(["limited pruning to height 2489"]):
                 pruneheight_new = node.pruneblockchain(2500)
-                assert_equal(pruneheight_new, 9 * 269 - 1)
+                # 269 blocks per file. The tip is 2500, so blocks above
+                # 2500 - 288 = 2212 are kept and the file holding 2152..2420
+                # stays: pruning ends at the end of the eighth file.
+                assert_equal(pruneheight_new, 8 * 269 - 1)
 
         self.log.info(
             "ensure that prune locks don't prevent indices from failing in a reorg scenario"
