From ced68805cb895be7055c9a1ad5fc17a37894253b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:15:02 -0700
Subject: [PATCH] fixup! avalanche: vote over SHA256-identified eCash mempool
 batches

---
 test/functional/abc_feature_minerfund.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/test/functional/abc_feature_minerfund.py b/test/functional/abc_feature_minerfund.py
index 196b6db311..b2a1392691 100644
--- a/test/functional/abc_feature_minerfund.py
+++ b/test/functional/abc_feature_minerfund.py
@@ -49,6 +49,8 @@ class MinerFundTest(BitcoinTestFramework):
         self.extra_args = [
             [
                 "-enableminerfund",
+                # Keep policy parking stable until the explicit unpark checks.
+                "-automaticunparking=0",
             ],
             [],
         ]
@@ -146,7 +148,7 @@ class MinerFundTest(BitcoinTestFramework):
 
     def test_without_avalanche(self):
         self.log.info("Test the behavior when avalanche is completely disabled")
-        self.restart_node(0, extra_args=["-enableminerfund"])
+        self.restart_node(0, extra_args=self.extra_args[0])
         self.restart_node(1, extra_args=["-avalanche=0"])
         self.connect_nodes(0, 1)
 
@@ -176,7 +178,7 @@ class MinerFundTest(BitcoinTestFramework):
 
     def test_parked_chain(self):
         self.log.info("Test parking a competing chain")
-        self.restart_node(0, extra_args=["-enableminerfund"])
+        self.restart_node(0, extra_args=self.extra_args[0])
         node = self.nodes[0]
 
         self.generate(node, 1, sync_fun=self.no_op)
