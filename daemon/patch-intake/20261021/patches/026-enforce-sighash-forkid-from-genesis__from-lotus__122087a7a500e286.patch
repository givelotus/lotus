From e67cf5f77c2a719ce9f9e5cfdcb024fe013bff5a Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Sun, 7 Mar 2021 17:47:26 -0500
Subject: [PATCH] Enforce SIGHASH_FORKID from genesis (#44)

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 054bba635a934474cc4ac20b6c5a13a9fc8ab043
Recorded-replay-commit: 195f2d2558a8e10ac81ffaf5939e972cd312a336

diff --git a/src/validation.cpp b/src/validation.cpp
index f6a4a0863d..feae695cbc 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -2039,10 +2039,8 @@ static uint32_t GetNextBlockScriptFlags(const CBlockIndex *pindex,
         flags |= SCRIPT_VERIFY_CHECKSEQUENCEVERIFY;
     }
 
-    // If the UAHF is enabled, we start accepting replay protected txns
-    if (IsUAHFenabled(consensusparams, pindex)) {
-        flags |= SCRIPT_ENABLE_SIGHASH_FORKID;
-    }
+    // Always enforce SIGHASH_FORKID
+    flags |= SCRIPT_ENABLE_SIGHASH_FORKID;
 
     // We make sure this node will have replay protection during the next hard
     // fork.
