+        SCRIPT_VERIFY_SIGPUSHONLY | SCRIPT_VERIFY_CLEANSTACK |
+        SCRIPT_ENABLE_SCHNORR_MULTISIG | SCRIPT_VERIFY_MINIMALDATA |
