+                        base: Some(Some(base_val)),
+                        operands: vec![op_bytes],
+                    };
+                }
+                KeyOp::Delete => {
+                    *e.into_mut() = KeyOp::Merge {
+                        base: Some(None),
+                        operands: vec![op_bytes],
+                    };
+                }
+                KeyOp::Merge { operands, .. } => {
+                    operands.push(op_bytes);
+                }
+            },
+        }
+    }
