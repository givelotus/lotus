+        cf: &CF,
+        from: K,
+        to: K,
+    ) {
+        let from_ref = from.as_ref();
+        let to_ref = to.as_ref();
+        let cf_batch = self.cf_batches.entry(cf.dbi).or_default();
+        cf_batch
+            .key_ops
+            .retain(|k, _| k.as_slice() < from_ref || k.as_slice() >= to_ref);
+        cf_batch
+            .dup_ops
+            .retain(|k, _| k.as_slice() < from_ref || k.as_slice() >= to_ref);
+        cf_batch
+            .delete_ranges
+            .push((from_ref.to_vec(), to_ref.to_vec()));
+    }
