+            ("MANIFEST-000001", b"manifest".as_slice()),
+            ("000002.sst", b"retained data bytes".as_slice()),
+        ];
+        for (name, bytes) in fixtures {
+            std::fs::write(db_path.join(name), bytes)?;
+        }
