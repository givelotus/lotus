 test/functional/wallet_assumeutxo.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/functional/wallet_assumeutxo.py b/test/functional/wallet_assumeutxo.py
index 2a96c03a4d..ac1b3067dd 100644
--- a/test/functional/wallet_assumeutxo.py
+++ b/test/functional/wallet_assumeutxo.py
@@ -116,7 +116,7 @@ class AssumeutxoTest(BitcoinTestFramework):
 
         assert_equal(
             dump_output["txoutset_hash"],
-            "372adda95d453e80ce3d77396daa852c7bf620be323ea38eb61a34859dafc2b0",
+            "e991114bf2e506b572bf601810835a90ca0d61244a1275b658a0c4313fa357dd",
         )
         assert_equal(dump_output["nchaintx"], 334)
         assert_equal(n0.getblockchaininfo()["blocks"], SNAPSHOT_BASE_HEIGHT)
