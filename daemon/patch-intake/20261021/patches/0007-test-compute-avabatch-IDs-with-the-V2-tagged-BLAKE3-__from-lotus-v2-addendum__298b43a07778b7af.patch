From 369731374146b7d70ed033b79204670cb187a90a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:51:32 -0700
Subject: [PATCH] test: compute avabatch IDs with the V2 tagged BLAKE3 hash

test_runner.py runs the test framework's own unit tests before any
functional test, and one of them failed, so test_runner.py could not run
at all.

v2/006 changed lotus::v2::TaggedHash, which MempoolBatchAnnouncement::
ComputeBatchId uses, from SHA256 to unkeyed BLAKE3 over the domain tag,
a NUL separator and the payload, and updated the native vector in
preconsensus_batch_tests (cf456a4b...). The Python mirror was not
updated: its self-test still asserted the eCash SHA256 vector
(f2550ec7...). v2/044 then added a second msg_avabatch class, which
shadows the first, whose batch_id used keyed BLAKE3 with the domain
padded into the key. That matches neither the native code nor either
vector (it gives 3d199c07...).

batch_id now hashes exactly what the native code hashes, and the
self-test asserts the native vector. It is renamed, since it no longer
checks a SHA256 identifier. The treasury contender ID, which the native
code does compute with keyed BLAKE3, is unchanged.

Tier: V2 (fixup to v2/044)
---
 test/functional/test_framework/messages.py | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/test/functional/test_framework/messages.py b/test/functional/test_framework/messages.py
index 3656f5ff6d..0df0b68f9c 100644
--- a/test/functional/test_framework/messages.py
+++ b/test/functional/test_framework/messages.py
@@ -3018,8 +3018,12 @@ class msg_avabatch:
         )
 
     def batch_id(self) -> int:
-        key = b"lotus.v2.preconsensus.batch".ljust(32, b"\x00")
-        return uint256_from_str(blake3_keyed_single_chunk(key, self.serialize()))
+        # Mirrors lotus::v2::TaggedHash(PreconsensusBatch, ...): unkeyed
+        # BLAKE3 over the domain tag, one NUL separator and the 168-byte
+        # serialization.
+        return uint256_from_str(
+            blake3_single_chunk(b"lotus.v2.preconsensus.batch\x00" + self.serialize())
+        )
 
     def __repr__(self):
         return (
@@ -3190,7 +3194,7 @@ class msg_blockundo:
 
 
 class TestFrameworkMessages(unittest.TestCase):
-    def test_ecash_batch_sha256_identifier_and_wire_round_trip(self):
+    def test_v2_batch_blake3_identifier_and_wire_round_trip(self):
         batch = msg_avabatch(
             prev_block_hash=int("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20", 16),
             epoch_seq=42,
@@ -3200,11 +3204,11 @@ class TestFrameworkMessages(unittest.TestCase):
             tx_count=128,
             short_ids_hash=int("bb" * 32, 16),
         )
-        # Same independently calculated vector as the native batch wire test.
+        # Same vector as the native mempool_batch_serialization_and_id test.
         self.assertEqual(len(batch.serialize()), 168)
         self.assertEqual(
             f"{batch.batch_id():064x}",
-            "f2550ec763722f0d511967da83bcfc5a4b5460f09a6001b17ed2ebcf85716f23",
+            "cf456a4b7889237c3adace3e092fa4186c2c8c00642735c13eb8d80c7d977d46",
         )
         restored = msg_avabatch()
         restored.deserialize(BytesIO(batch.serialize()))
