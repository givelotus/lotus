     for (const C mode : {C::NONE, C::ZSTD, C::ZSTD_DICT}) {
diff --git a/src/tls_util.cpp b/src/tls_util.cpp
index df86d20216db91ba3e9e64f90caffdf37227f0b8..7a76904ec12d7c3f45dcc2e346a6ae69ba4d8fa0 100644
--- a/src/tls_util.cpp
+++ b/src/tls_util.cpp
@@ -4,6 +4,7 @@
 
 #include <tls_util.h>
 
+#include <logging.h>
 #include <util/strencodings.h>
 #include <util/string.h>
 
@@ -175,6 +176,47 @@ bool UseCertificateFiles(SSL_CTX *ctx, const fs::path &cert_chain,
            SSL_CTX_check_private_key(ctx) == 1;
 }
 
+ReloadingClientContext::ReloadingClientContext(
+    const std::optional<fs::path> &cert, const std::optional<fs::path> &key)
+    : m_cert{cert}, m_key{key} {
+    auto ctx{NewContext(/*server=*/false)};
+    if (ctx) {
+        // Self-signed peers are allowed; explicit SPKI pins authenticate
+        // peers in the dialer, as before certificate reloading.
+        SSL_CTX_set_verify(ctx.get(), SSL_VERIFY_NONE, nullptr);
+        m_context = std::shared_ptr<SSL_CTX>{ctx.release(), SslCtxDeleter{}};
+    }
+}
+
+std::shared_ptr<SSL_CTX> ReloadingClientContext::Get() {
+    std::lock_guard<std::mutex> lock{m_mutex};
+    const auto now{std::chrono::steady_clock::now()};
+    if (!m_context || !m_cert || !m_key || now < m_next_check) {
+        return m_context;
+    }
+    m_next_check = now + std::chrono::seconds{1};
+    std::error_code cert_error, key_error;
+    const auto cert_mtime{fs::last_write_time(*m_cert, cert_error)};
+    const auto key_mtime{fs::last_write_time(*m_key, key_error)};
+    if (m_loaded && !cert_error && !key_error && cert_mtime == m_cert_mtime &&
+        key_mtime == m_key_mtime) {
+        return m_context;
+    }
+    auto ctx{NewContext(/*server=*/false)};
+    if (!ctx || !UseCertificateFiles(ctx.get(), *m_cert, *m_key)) {
+        LogPrintf("Not reloading TLS client certificate %s: %s\n",
+                  fs::PathToString(*m_cert), ErrorString());
+        return m_context;
+    }
+    SSL_CTX_set_verify(ctx.get(), SSL_VERIFY_NONE, nullptr);
+    m_context = std::shared_ptr<SSL_CTX>{ctx.release(), SslCtxDeleter{}};
+    m_loaded = true;
+    m_cert_mtime = cert_mtime;
+    m_key_mtime = key_mtime;
+    LogPrintf("Loaded TLS client certificate %s\n", fs::PathToString(*m_cert));
+    return m_context;
+}
+
 namespace {
 EVP_PKEY *NewP256Key() {
     std::unique_ptr<EVP_PKEY_CTX, EVPPKeyCtxDeleter> pctx{
diff --git a/src/tls_util.h b/src/tls_util.h
index 185932df724e8f01a5d05c39e1e9d31170b3ed5f..4d8433e86f7342ece76298872df99fb7a0c5a7e9 100644
--- a/src/tls_util.h
+++ b/src/tls_util.h
@@ -11,6 +11,7 @@
 
 #include <chrono>
 #include <memory>
+#include <mutex>
 #include <optional>
 #include <string>
 #include <vector>
@@ -45,6 +46,26 @@ bool UseCertificatePem(SSL_CTX *ctx, const std::string &cert_chain_pem,
 bool UseCertificateFiles(SSL_CTX *ctx, const fs::path &cert_chain,
                          const fs::path &key);
 
+/**
+ * Client TLS contexts are immutable after publication. Check file mtimes on
+ * new handshakes (at most once a second), just like the inbound listener.
+ * A failed replacement retains the last valid context; existing SSL objects
+ * retain their own OpenSSL reference to that context.
+ */
+class ReloadingClientContext {
+    std::mutex m_mutex;
+    std::shared_ptr<SSL_CTX> m_context;
+    std::optional<fs::path> m_cert, m_key;
+    fs::file_time_type m_cert_mtime{}, m_key_mtime{};
+    bool m_loaded{false};
+    std::chrono::steady_clock::time_point m_next_check{};
+
+public:
+    ReloadingClientContext(const std::optional<fs::path> &cert,
+                           const std::optional<fs::path> &key);
+    std::shared_ptr<SSL_CTX> Get();
+};
+
 struct SelfSigned {
     std::string cert_pem;
     std::string key_pem;
diff --git a/test/functional/p2p_websocket_client_cert_reload.py b/test/functional/p2p_websocket_client_cert_reload.py
new file mode 100755
index 0000000000000000000000000000000000000000..133de89979bac80e2313284372aa20f39e47ab59
--- /dev/null
+++ b/test/functional/p2p_websocket_client_cert_reload.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Outbound wss dials reload client keys, retaining old sessions and bad-file fallback."""
+import base64
+import hashlib
+import os
+import shutil
+import subprocess
+import time
+from pathlib import Path
+
+from test_framework.test_framework import BitcoinTestFramework, SkipTest
+from test_framework.util import assert_equal, rpc_port
+
+
+class ClientCertificateReloadTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 3
+        self.setup_clean_chain = True
+        self.extra_args = [["-tlsmutual"], [], ["-tlsmutual"]]
+
+    def setup_network(self):
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_nodes()
+
+    def skip_test_if_missing_module(self):
+        self.openssl = shutil.which("openssl")
+        if not self.openssl:
+            raise SkipTest("openssl not available")
+
+    def issue(self, path):
+        cert, key = path / "rotated.pem", path / "rotated.key"
+        subprocess.run([self.openssl, "req", "-new", "-x509", "-newkey", "ec",
+                        "-pkeyopt", "ec_paramgen_curve:P-256", "-nodes", "-days", "1",
+                        "-subj", "/CN=rotated.example", "-keyout", str(key), "-out", str(cert)],
+                       check=True, capture_output=True)
+        pubkey = subprocess.run([self.openssl, "x509", "-pubkey", "-noout", "-in", str(cert)],
+                                check=True, capture_output=True).stdout
+        der = subprocess.run([self.openssl, "pkey", "-pubin", "-outform", "DER"],
+                             input=pubkey, check=True, capture_output=True).stdout
+        return cert.read_bytes(), key.read_bytes(), base64.urlsafe_b64encode(hashlib.sha256(der).digest()).decode().rstrip("=")
+
+    def peers(self, n):
+        return [p for p in self.nodes[n].getpeerinfo() if p["transport"] == "wss"]
+
+    def dial(self, n):
+        self.nodes[1].addnode(f"wss://localhost:{rpc_port(n)}/p2p/ws", "onetry")
+        self.wait_until(lambda: len(self.peers(n)) == 1)
+        return self.peers(n)[0]["websocket"]["peer_spki"]
+
+    def disconnect_second(self):
+        self.nodes[2].disconnectnode(nodeid=self.peers(2)[0]["id"])
+        self.wait_until(lambda: not self.peers(2))
+        self.wait_until(lambda: len(self.peers(1)) == 1)
+
+    def replace(self, path, contents):
+        tmp = path.with_suffix(".replacement")
+        tmp.write_bytes(contents)
+        os.replace(tmp, path)
+
+    def run_test(self):
+        old = self.dial(0)
+        assert old
+        retained = self.peers(0)[0]["id"]
+        client_dir = Path(self.nodes[1].datadir) / self.chain
+        cert, key = client_dir / "node_tls_cert.pem", client_dir / "node_tls_key.pem"
+        replacement_cert, replacement_key, expected = self.issue(client_dir)
+        assert old != expected
+        self.replace(cert, replacement_cert)
+        self.replace(key, replacement_key)
+        time.sleep(1.1)  # Same mtime-check cadence as the inbound TLS listener.
+        assert_equal(self.dial(2), expected)
+        # Rotation must not disconnect or mutate the already established session.
+        assert_equal(self.peers(0)[0]["id"], retained)
+        assert_equal(self.peers(0)[0]["websocket"]["peer_spki"], old)
+        received_ping = self.peers(0)[0].get("bytesrecv_per_msg", {}).get("ping", 0)
+        self.nodes[1].ping()
+        self.wait_until(lambda: self.peers(0)[0].get("bytesrecv_per_msg", {}).get("ping", 0) > received_ping)
+        self.disconnect_second()
+
+        self.log.info("A mismatched certificate/key retains the last good identity")
+        third_cert, third_key, third_spki = self.issue(client_dir)
+        self.replace(cert, third_cert)
+        time.sleep(1.1)
+        assert_equal(self.dial(2), expected)
+        self.disconnect_second()
+        self.replace(key, third_key)
+        time.sleep(1.1)
+        assert_equal(self.dial(2), third_spki)
+        assert_equal(self.peers(0)[0]["id"], retained)
+        assert_equal(self.peers(0)[0]["websocket"]["peer_spki"], old)
+
+
+if __name__ == "__main__":
+    ClientCertificateReloadTest().main()
