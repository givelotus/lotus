From 94f480b7438aec9fc58230f6f04ca5645a7f1b8e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:56:47 -0700
Subject: [PATCH] test: check Dogecoin transaction dependency order and UTXO
 undo

Exercise the mainnet/testnet non-CTOR rule on regtest using the dedicated activation-height override. Reject child-before-parent despite both outputs appearing in the block, accept ordered dependencies, and spend the child in a later block.

Disconnect both blocks and verify each UTXO transition, then reconnect and verify the whole chain. This regression is for sequential Dogecoin connection, independent of optional coordination or indexing.

diff --git a/test/functional/dogecoin_transaction_order.py b/test/functional/dogecoin_transaction_order.py
new file mode 100644
index 0000000000000000000000000000000000000000..8fe2d27402e08166b3e20b53242939390d78b335
--- /dev/null
+++ b/test/functional/dogecoin_transaction_order.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Dogecoin connects transactions in wire order and undoes dependencies safely."""
+from copy import deepcopy
+from io import BytesIO
+
+from test_framework.address import byte_to_base58, P2SH_OP_TRUE, SCRIPTSIG_OP_TRUE
+from test_framework.blocktools import create_tx_with_script
+from test_framework.messages import CBlock
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+
+class DogecoinTransactionOrderTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.setup_clean_chain = True
+        self.num_nodes = 1
+        self.extra_args = [["-avalanche=0", "-legacyscriptrules", "-magneticanomalyheight=2147483647"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        address = byte_to_base58(bytes(P2SH_OP_TRUE[2:-1]), 196)
+
+        def work(txs=()):
+            block = CBlock()
+            block.deserialize(BytesIO(bytes.fromhex(node.getrawunsolvedblock(address)["blockhex"])))
+            block.vtx = block.vtx[:1] + list(txs)
+            block.hashMerkleRoot = block.calc_merkle_root()
+            block.solve()
+            return block
+
+        def spend(tx):
+            return create_tx_with_script(tx, 0, SCRIPTSIG_OP_TRUE,
+                                         amount=tx.vout[0].nValue - 100000000,
+                                         script_pub_key=P2SH_OP_TRUE)
+
+        first = work()
+        assert_equal(node.submitblock(first.serialize().hex()), None)
+        self.generatetoaddress(node, 100, address)
+        coinbase = first.vtx[0]
+        parent = spend(coinbase)
+        child = spend(parent)
+        valid = work([parent, child])
+        reversed_block = deepcopy(valid)
+        reversed_block.vtx[1:] = [child, parent]
+        reversed_block.hashMerkleRoot = reversed_block.calc_merkle_root()
+        reversed_block.solve()
+        previous_tip = node.getbestblockhash()
+        assert_equal(node.submitblock(reversed_block.serialize().hex()),
+                     "bad-txns-inputs-missingorspent")
+        assert_equal(node.getbestblockhash(), previous_tip)
+        assert node.gettxout(coinbase.txid_hex, 0, False) is not None
+
+        assert_equal(node.submitblock(valid.serialize().hex()), None)
+        assert_equal(node.gettxout(coinbase.txid_hex, 0, False), None)
+        assert_equal(node.gettxout(parent.txid_hex, 0, False), None)
+        assert node.gettxout(child.txid_hex, 0, False) is not None
+        grandchild = spend(child)
+        following = work([grandchild])
+        assert_equal(node.submitblock(following.serialize().hex()), None)
+        assert_equal(node.gettxout(child.txid_hex, 0, False), None)
+        assert node.gettxout(grandchild.txid_hex, 0, False) is not None
+
+        # Undo a cross-block spend, then the same-block parent/child chain.
+        node.invalidateblock(following.hash_hex)
+        assert node.gettxout(child.txid_hex, 0, False) is not None
+        assert_equal(node.gettxout(grandchild.txid_hex, 0, False), None)
+        node.invalidateblock(valid.hash_hex)
+        assert_equal(node.getbestblockhash(), previous_tip)
+        assert node.gettxout(coinbase.txid_hex, 0, False) is not None
+        assert_equal(node.gettxout(parent.txid_hex, 0, False), None)
+        assert_equal(node.gettxout(child.txid_hex, 0, False), None)
+        node.reconsiderblock(valid.hash_hex)
+        node.reconsiderblock(following.hash_hex)
+        assert_equal(node.getbestblockhash(), following.hash_hex)
+        assert_equal(node.gettxout(coinbase.txid_hex, 0, False), None)
+        assert_equal(node.gettxout(parent.txid_hex, 0, False), None)
+        assert_equal(node.gettxout(child.txid_hex, 0, False), None)
+        assert node.gettxout(grandchild.txid_hex, 0, False) is not None
+        assert_equal(node.verifychain(4, 0), True)
+
+
+if __name__ == "__main__":
+    DogecoinTransactionOrderTest().main()
