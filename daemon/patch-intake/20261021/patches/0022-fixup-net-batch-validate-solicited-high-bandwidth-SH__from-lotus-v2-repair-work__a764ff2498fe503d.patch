Subject: [PATCH 22/23] fixup! net: batch-validate solicited/high-bandwidth
 SHORTTX and coalesce incoming TX bursts

---
 test/functional/rpc_atomic_tx_batch.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/test/functional/rpc_atomic_tx_batch.py b/test/functional/rpc_atomic_tx_batch.py
index 6bc8e1c42c..a418c61be0 100644
--- a/test/functional/rpc_atomic_tx_batch.py
+++ b/test/functional/rpc_atomic_tx_batch.py
@@ -20,8 +20,12 @@ class AtomicTxBatchTest(BitcoinTestFramework):
         self.num_nodes = 2
         self.setup_clean_chain = True
         self.supports_cli = False
-        self.extra_args = [["-avalanche=0", "-highbandwidthtx=1"],
-                           ["-avalanche=0", "-highbandwidthtx=1"]]
+        # This test explicitly verifies shorttx; override the framework's
+        # compatibility default that disables that path for legacy fixtures.
+        self.extra_args = [
+            ["-avalanche=0", "-highbandwidthtx=1", "-testdisablehighbandwidthshorttx=0"],
+            ["-avalanche=0", "-highbandwidthtx=1", "-testdisablehighbandwidthshorttx=0"],
+        ]
 
     def run_test(self):
         node, peer = self.nodes
