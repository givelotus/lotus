From b40f8c3dfe3239361912c0dd30579738cfec3389 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:28:58 -0700
Subject: [PATCH] fixup! chronik(v2): expose native HTTP, Electrum and
 WebSocket views

Replace four Option.is_none_or calls introduced after the declared Rust1.80 minimum with equivalent map_or(true) predicates. Preserve all page caps, pinned-anchor availability and fail-closed query behavior. Full strict configured Chronik Clippy and134tests pass; no lint suppression or MSRV increase.

Tier: V2 (fixup to native Chronik HTTP query transport owner28ce9b891b7)
---
 chronik/chronik-http/src/v2.rs          | 6 +++---
 chronik/chronik-http/src/v2_explorer.rs | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/chronik/chronik-http/src/v2.rs b/chronik/chronik-http/src/v2.rs
index 43ef15157f..79747117db 100644
--- a/chronik/chronik-http/src/v2.rs
+++ b/chronik/chronik-http/src/v2.rs
@@ -257,7 +257,7 @@ async fn branches(s: V2HttpState, body: Body, history: bool) -> Response {
     if r.page_size == 0
         || r.page_size > 100
         || r.positions.len() > 16
-        || count.is_none_or(|n| n > 256)
+        || count.map_or(true, |n| n > 256)
         || (!history && r.include_burn)
     {
         return fail(StatusCode::BAD_REQUEST, "invalid_limits");
@@ -293,7 +293,7 @@ async fn branches(s: V2HttpState, body: Body, history: bool) -> Response {
         Err(()) => return fail(StatusCode::BAD_REQUEST, "invalid_cursor"),
     };
     let stamp = observe(&s);
-    if stamp.is_none_or(|stamp| stamp.anchor.is_none()) {
+    if stamp.map_or(true, |stamp| stamp.anchor.is_none()) {
         return internal();
     }
     let Ok(db) = s.db.try_lock() else {
@@ -352,7 +352,7 @@ async fn utxo(
         return fail(StatusCode::BAD_REQUEST, "invalid_outpoint");
     }
     let stamp = observe(&s);
-    if stamp.is_none_or(|stamp| stamp.anchor.is_none()) {
+    if stamp.map_or(true, |stamp| stamp.anchor.is_none()) {
         return internal();
     }
     let Ok(db) = s.db.try_lock() else {
diff --git a/chronik/chronik-http/src/v2_explorer.rs b/chronik/chronik-http/src/v2_explorer.rs
index 726c1e9339..fd2911d41a 100644
--- a/chronik/chronik-http/src/v2_explorer.rs
+++ b/chronik/chronik-http/src/v2_explorer.rs
@@ -575,7 +575,7 @@ async fn handle(
         };
     }
     if s.index_error.load(std::sync::atomic::Ordering::Acquire)
-        || stamp.is_none_or(|s| s.anchor.is_none())
+        || stamp.map_or(true, |s| s.anchor.is_none())
     {
         return failure(unavailable(), None);
     }
