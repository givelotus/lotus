From 5bb9058c8850bd41187c0c61db5ede33d801cf28 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] validation: fast-path single-input duplicate checks and
 disabled sequence locks

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Fast-path single-input CheckRegularTransaction duplicate-input checks,
coalesce BlockUndo disk writes, and optimize bulk mempool clear.

Original-Commit: a4ea86865414bbf4f98512bbd4460e2a42897acc
Original-Patch: ecash/020
Split-Concern: txcheck

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/consensus/tx_check.cpp  | 17 +++++++++++++++++
 src/consensus/tx_verify.cpp |  8 +++++++-
 src/validation.cpp          |  5 ++++-
 3 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/src/consensus/tx_check.cpp b/src/consensus/tx_check.cpp
index 4e269c168f675416f4b275c05f2fb3851794eea3..db8f90bfbe94f0513f3faf1dfd25a4385407cf4d 100644
--- a/src/consensus/tx_check.cpp
+++ b/src/consensus/tx_check.cpp
@@ -82,6 +82,23 @@ bool CheckRegularTransaction(const CTransaction &tx, TxValidationState &state) {
         return false;
     }
 
+    if (tx.vin.size() <= 8) {
+        for (size_t i = 0; i < tx.vin.size(); ++i) {
+            const auto &txin = tx.vin[i];
+            if (txin.prevout.IsNull()) {
+                return state.Invalid(TxValidationResult::TX_CONSENSUS,
+                                     "bad-txns-prevout-null");
+            }
+            for (size_t j = 0; j < i; ++j) {
+                if (txin.prevout == tx.vin[j].prevout) {
+                    return state.Invalid(TxValidationResult::TX_CONSENSUS,
+                                         "bad-txns-inputs-duplicate");
+                }
+            }
+        }
+        return true;
+    }
+
     std::unordered_set<COutPoint, SaltedOutpointHasher> vInOutPoints;
     for (const auto &txin : tx.vin) {
         if (txin.prevout.IsNull()) {
diff --git a/src/consensus/tx_verify.cpp b/src/consensus/tx_verify.cpp
index d680fba3e4ef270a08cf14f62652eb564057614d..61ea104534b560efbb90892e9722327fb15c058f 100644
--- a/src/consensus/tx_verify.cpp
+++ b/src/consensus/tx_verify.cpp
@@ -172,8 +172,14 @@ std::pair<int, int64_t> CalculateSequenceLocks(const CTransaction &tx,
 bool EvaluateSequenceLocks(const CBlockIndex &block,
                            std::pair<int, int64_t> lockPair) {
     assert(block.pprev);
+    if (lockPair.first >= block.nHeight) {
+        return false;
+    }
+    if (lockPair.second < 0) {
+        return true;
+    }
     int64_t nBlockTime = block.pprev->GetMedianTimePast();
-    if (lockPair.first >= block.nHeight || lockPair.second >= nBlockTime) {
+    if (lockPair.second >= nBlockTime) {
         return false;
     }
 
diff --git a/src/validation.cpp b/src/validation.cpp
index 8f87ef7bd64540b2c891a0d9cb7a9c7bd1cf7218..d2b1e8c58b939ab4cf4c96e89fba73a8230a8e38 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
