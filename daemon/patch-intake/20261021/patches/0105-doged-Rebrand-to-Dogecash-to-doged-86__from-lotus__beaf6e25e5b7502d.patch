From 5d58e14cc43a1adde271ea1762048ef1c05c2c76 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Tue, 26 Nov 2024 23:15:40 +0100
Subject: [PATCH] [doged] Rebrand to Dogecash to doged (#86)

Part of an ongoing rebrand effort. See #82.

Current-ABC adaptation (2026-10-14): Preserve final pinned doged network client identity and platform default data paths, adapting to current ArgsManager. Incorporates original datadir isolation intent from e3d7f8ce6ecdb00ed3474716a39afd5d205ae50a without reverting newer argument parsing APIs.

Original-Commit: 34ab40c4a0babb49ec0f85259ee544220a0427a6

diff --git a/src/clientversion.cpp b/src/clientversion.cpp
index 8df98f99d2ffcdd91a59239374846efcd8b10853..5cbac971746f5519156bd3fbf594189344bab7c1 100644
--- a/src/clientversion.cpp
+++ b/src/clientversion.cpp
@@ -13,10 +13,10 @@
 
 /**
  * Name of client reported in the 'version' message. Report the same name
- * for both bitcoind and bitcoin-qt, to make it harder for attackers to
+ * for both doged and bitcoin-qt, to make it harder for attackers to
  * target servers or GUI users specifically.
  */
-const std::string CLIENT_NAME("Bitcoin ABC");
+const std::string CLIENT_NAME("doged");
 
 #ifdef HAVE_BUILD_INFO
 #include <obj/build.h>
@@ -92,8 +92,8 @@ std::string CopyrightHolders(const std::string &strPrefix) {
 
 std::string LicenseInfo() {
     const std::string URL_SOURCE_CODE =
-        "<https://github.com/Bitcoin-ABC/bitcoin-abc>";
-    const std::string URL_WEBSITE = "<https://www.bitcoinabc.org>";
+        "<https://github.com/doged-io/doged>";
+    const std::string URL_WEBSITE = "<https://www.doged.io>";
 
     return CopyrightHolders(strprintf(_("Copyright (C) %i-%i").translated, 2009,
                                       COPYRIGHT_YEAR) +
diff --git a/src/common/args.cpp b/src/common/args.cpp
index 5f9cacf9423630bdcf3df33bcd0f15bb0906cb82..bed1c594ad1d5dfa0cc6d8108901dde0f39a8618 100644
--- a/src/common/args.cpp
+++ b/src/common/args.cpp
@@ -725,12 +725,12 @@ std::string HelpMessageOpt(const std::string &option,
 }
 
 fs::path GetDefaultDataDir() {
-    // Windows: C:\Users\Username\AppData\Roaming\Bitcoin
-    // macOS: ~/Library/Application Support/Bitcoin
-    // Unix-like: ~/.bitcoin
+    // Windows: C:\Users\Username\AppData\Roaming\doge
+    // macOS: ~/Library/Application Support/doge
+    // Unix-like: ~/.doge
 #ifdef WIN32
     // Windows
-    return GetSpecialFolderPath(CSIDL_APPDATA) / "Bitcoin";
+    return GetSpecialFolderPath(CSIDL_APPDATA) / "doge";
 #else
     fs::path pathRet;
     char *pszHome = getenv("HOME");
@@ -741,10 +741,10 @@ fs::path GetDefaultDataDir() {
     }
 #ifdef MAC_OSX
     // macOS
-    return pathRet / "Library/Application Support/Bitcoin";
+    return pathRet / "Library/Application Support/doge";
 #else
     // Unix-like
-    return pathRet / ".bitcoin";
+    return pathRet / ".doge";
 #endif
 #endif
 }
