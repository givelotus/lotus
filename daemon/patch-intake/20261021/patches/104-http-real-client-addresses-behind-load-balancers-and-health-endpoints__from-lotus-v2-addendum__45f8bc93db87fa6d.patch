new file mode 100644
index 0000000000..710df24063
--- /dev/null
+++ b/src/proxy_protocol.cpp
@@ -0,0 +1,112 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <proxy_protocol.h>
+
+#include <netbase.h>
+#include <util/strencodings.h>
+#include <util/string.h>
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+
+namespace proxy_protocol {
+
+std::optional<size_t> V2PayloadSize(Span<const uint8_t> fixed) {
+    if (fixed.size() < V2_FIXED_SIZE ||
+        std::memcmp(fixed.data(), V2_SIGNATURE, sizeof(V2_SIGNATURE)) != 0 ||
+        (fixed[12] & 0xF0) != 0x20) {
+        return std::nullopt;
+    }
+    const size_t len{(size_t(fixed[14]) << 8) | fixed[15]};
+    if (len > V2_MAX_PAYLOAD) {
+        return std::nullopt;
+    }
+    return len;
+}
+
+std::optional<Header> ParseV2(Span<const uint8_t> header) {
+    const auto len{V2PayloadSize(header)};
+    if (!len || header.size() != V2_FIXED_SIZE + *len) {
+        return std::nullopt;
+    }
+    const uint8_t command{uint8_t(header[12] & 0x0F)};
+    const uint8_t family{header[13]};
+    const Span<const uint8_t> addrs{header.subspan(V2_FIXED_SIZE)};
+    if (command == 0x0) {
+        // LOCAL: the proxy's own connection (e.g. a health check).
+        return Header{};
+    }
+    if (command != 0x1) {
+        return std::nullopt;
+    }
+    // TCP over IPv4 (0x11) or IPv6 (0x21); anything else carries no usable
+    // client address.
+    if (family == 0x11 && addrs.size() >= 12) {
+        in_addr a;
+        std::memcpy(&a, addrs.data(), 4);
+        const uint16_t port{uint16_t((addrs[8] << 8) | addrs[9])};
+        return Header{CService{a, port}};
+    }
+    if (family == 0x21 && addrs.size() >= 36) {
+        in6_addr a;
+        std::memcpy(&a, addrs.data(), 16);
+        const uint16_t port{uint16_t((addrs[32] << 8) | addrs[33])};
+        return Header{CService{a, port}};
+    }
+    return Header{};
+}
+
+std::optional<Header> ParseV1(std::string_view line) {
+    if (line.size() > V1_MAX_LINE || !line.ends_with("\r\n") ||
+        !line.starts_with("PROXY ")) {
+        return std::nullopt;
+    }
+    line.remove_suffix(2);
+    const auto fields{util::SplitString(line, ' ')};
+    if (fields.size() >= 2 && fields[1] == "UNKNOWN") {
+        // The proxy could not tell (e.g. its own health check).
+        return Header{};
+    }
+    if (fields.size() != 6 || (fields[1] != "TCP4" && fields[1] != "TCP6")) {
+        return std::nullopt;
+    }
+    const auto port{ToIntegral<uint16_t>(fields[4])};
+    const auto source{LookupHost(fields[2], /*fAllowLookup=*/false)};
+    if (!port || !source || (fields[1] == "TCP4") != source->IsIPv4()) {
+        return std::nullopt;
+    }
+    return Header{CService{*source, *port}};
+}
+
+CService ResolveForwardedClient(
+    const CService &peer, const std::vector<std::string_view> &forwarded,
+    const std::function<bool(const CNetAddr &)> &trusted) {
+    std::vector<std::string> hops;
+    for (const std::string_view field : forwarded) {
+        for (const std::string &hop : util::SplitString(field, ',')) {
+            hops.emplace_back(util::TrimStringView(hop));
+        }
+    }
+    CService current{peer};
+    while (trusted(current) && !hops.empty()) {
+        std::string hop{std::move(hops.back())};
+        hops.pop_back();
+        // An entry may carry a port ("a.b.c.d:p", "[v6]:p") or not ("v6").
+        uint16_t port{0};
+        std::string host;
+        if (!SplitHostPort(hop, port, host)) {
+            break;
+        }
+        const auto next{LookupHost(host, /*fAllowLookup=*/false)};
+        if (!next || !next->IsValid()) {
+            break;
+        }
+        current = CService{*next, port};
+    }
+    return current;
+}
+
+} // namespace proxy_protocol
diff --git a/src/proxy_protocol.h b/src/proxy_protocol.h
new file mode 100644
index 0000000000..c293f73d90
--- /dev/null
+++ b/src/proxy_protocol.h
@@ -0,0 +1,74 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_PROXY_PROTOCOL_H
+#define BITCOIN_PROXY_PROTOCOL_H
+
+#include <netaddress.h>
+#include <span.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+/**
+ * Client addresses behind load balancers and reverse proxies.
+ *
+ * A node behind one or more proxies sees their addresses, not the client's.
+ * Proxies in trusted subnets (-trustedproxy) can tell it the real one: a
+ * PROXY protocol header at the start of the connection (layer-4 balancers
+ * such as AWS NLB, HAProxy), and X-Forwarded-For on each HTTP request
+ * (HTTP proxies such as AWS ALB, nginx). Nothing from an untrusted peer is
+ * believed.
+ */
+namespace proxy_protocol {
+
+//! PROXY protocol v2 signature (the first 12 bytes of a v2 header)
+inline constexpr uint8_t V2_SIGNATURE[12]{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D,
+                                          0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A};
+//! Size of the fixed part of a v2 header (signature, command, family, length)
+inline constexpr size_t V2_FIXED_SIZE{16};
+//! Largest v2 address block accepted (addresses plus TLVs)
+inline constexpr size_t V2_MAX_PAYLOAD{1024};
+//! Longest v1 header line, CRLF included (from the specification)
+inline constexpr size_t V1_MAX_LINE{107};
+
+struct Header {
+    //! The client, or std::nullopt for LOCAL/UNKNOWN (health checks from the
+    //! proxy itself): keep the connection's own peer address.
+    std::optional<CService> source;
+};
+
+/**
+ * Length of the address block of a v2 header, from its fixed 16 bytes, or
+ * std::nullopt if they are not a valid v2 header.
+ */
+std::optional<size_t> V2PayloadSize(Span<const uint8_t> fixed);
+
+/** Parse a whole v2 header (fixed part and address block) */
+std::optional<Header> ParseV2(Span<const uint8_t> header);
+
+/** Parse a v1 header line ("PROXY TCP4 <src> <dst> <sport> <dport>\r\n") */
+std::optional<Header> ParseV1(std::string_view line);
+
+/**
+ * The client of an HTTP request: starting from the connection's peer, while
+ * the current address is a trusted proxy, step to the next X-Forwarded-For
+ * hop from the right. Stops at the first untrusted address (the client), or
+ * at an entry that is not an address.
+ *
+ * @param peer       The connection's peer (after any PROXY header)
+ * @param forwarded  The values of every X-Forwarded-For field, in order
+ * @param trusted    Whether an address is a trusted proxy
+ */
+CService ResolveForwardedClient(
+    const CService &peer, const std::vector<std::string_view> &forwarded,
+    const std::function<bool(const CNetAddr &)> &trusted);
+
+} // namespace proxy_protocol
+
+#endif // BITCOIN_PROXY_PROTOCOL_H
