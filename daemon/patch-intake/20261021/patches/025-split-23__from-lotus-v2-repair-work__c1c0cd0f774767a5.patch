new file mode 100644
index 0000000000000000000000000000000000000000..0177a605c90177b58ca008f85d0dc9e83a3bafc4
--- /dev/null
+++ b/src/test/schnorr_batch_api_tests.cpp
@@ -0,0 +1,67 @@
+// Copyright (c) 2026 The Lotus developers
