From fed75be8cd5d5cd3c6a8893eee3d19207ff23033 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:24:27 -0700
Subject: [PATCH] Apply VM invocation cap after composing static charge

Review integration note (2026-10-14; newly recorded explanation):
Apply the invocation cap to the complete composed charge while checking every selected intermediate in u128. A zero-count loop still pays setup and structural bytes but is not rejected solely because its provisional body cost exceeds the invocation cap. Test skipped and executed BREAK behavior.

---
 src/lotus_v2/test_vm.cpp | 23 +++++++++++++++++++++++
 src/lotus_v2/vm.cpp      | 13 ++++++++++---
 src/lotus_v2/vm_cost.inc | 14 ++++++--------
 3 files changed, 39 insertions(+), 11 deletions(-)

diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index 1ecf93921..3f7caf1f1 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -58,6 +58,11 @@ void ControlAndArithmetic() {
           "4e7a91", "4c004c00914e91"})
         Expect(valid, VmStatus::Success, {}, PROFILE, 1);
     Expect("006179634e64", VmStatus::Success);
+    Expect("00614e6b634e64", VmStatus::Success); // BREAK in skipped arm
+    Expect("00696b6a4e", VmStatus::Success); // BREAK in zero-iteration loop
+    Expect("4e614e6b634e64", VmStatus::Invalid); // executed outside loop
+    Expect("00616b", VmStatus::Invalid); // still requires complete syntax
+    Expect("006b6a", VmStatus::Invalid);
     Expect("61", VmStatus::Invalid, {Number(2)});
     Expect("4e6b", VmStatus::Invalid);
     VmBytes max(16, 255);
@@ -128,6 +133,21 @@ void ChargedAccounting() {
     CHECK(!charge("5e4cfd").charged);
     schedule.max_invocation_cost = 3;
     CHECK(charge("5e4cfd").charged);
+    // A zero-bound body can exceed the invocation cap before multiplication;
+    // only the complete charge is capped, while every u128 intermediate is
+    // still checked. The same body with one input exceeds the cap.
+    schedule = IllustrativeCost();
+    schedule.max_invocation_cost = 24;
+    auto zero_bound = charge("67794e796a4e", {}, 0);
+    CHECK(zero_bound.charged && zero_bound.accounting_cost == 24 &&
+          zero_bound.invocation.status == VmStatus::Success);
+    auto one_bound = charge("67794e796a4e", {}, 1);
+    CHECK(!one_bound.charged &&
+          one_bound.invocation.status == VmStatus::Invalid);
+    schedule.max_invocation_cost = 76;
+    one_bound = charge("67794e796a4e", {}, 1);
+    CHECK(one_bound.charged && one_bound.accounting_cost == 76 &&
+          one_bound.invocation.status == VmStatus::Success);
     schedule = IllustrativeCost();
     schedule.opcode[0xbb].base = 0;
     CHECK(charge("5e").invocation.status == VmStatus::Unsupported);
@@ -138,6 +158,9 @@ void ChargedAccounting() {
     huge.max_element_bytes = SIZE_MAX;
     auto overflow = EvaluateVmCharged(Hex("b8"), {}, huge, schedule);
     CHECK(!overflow.charged && overflow.invocation.status == VmStatus::Invalid);
+    overflow = EvaluateVmCharged(Hex("6779b86a4e"), {}, huge, schedule);
+    CHECK(!overflow.charged && overflow.invocation.status == VmStatus::Invalid &&
+          overflow.invocation.error == "static cost u128 overflow");
 }
 void AuthenticatedPayment() {
     const auto wire =
diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
index 58798a8c2..e7b945611 100644
--- a/src/lotus_v2/vm.cpp
+++ b/src/lotus_v2/vm.cpp
@@ -680,10 +680,14 @@ VmResult EvaluateVmImpl(std::span<const uint8_t> script,
                                 true);
         }
         if (Scan(script, profile, code)) {
-            if (cost_profile)
-                *charged_cost =
+            if (cost_profile) {
+                const auto cost =
                     CostMul(script.size(), cost_profile->structural_byte_cost,
                             *cost_profile);
+                if (cost > cost_profile->max_invocation_cost)
+                    throw VmFailure("static cost cap exceeded");
+                *charged_cost = cost;
+            }
             return {VmStatus::AutomaticSuccess, {}, {}};
         }
         Structure(code, profile);
@@ -699,7 +703,10 @@ VmResult EvaluateVmImpl(std::span<const uint8_t> script,
                         context &&
                             context->tx.inputs[context->input_index].flags ==
                                 3);
-            *charged_cost = CostAdd(structural, instructions, *cost_profile);
+            const auto cost = CostAdd(structural, instructions, *cost_profile);
+            if (cost > cost_profile->max_invocation_cost)
+                throw VmFailure("static cost cap exceeded");
+            *charged_cost = cost;
         }
         Machine machine(code, profile, input_count, output_count, arguments,
                         context);
diff --git a/src/lotus_v2/vm_cost.inc b/src/lotus_v2/vm_cost.inc
