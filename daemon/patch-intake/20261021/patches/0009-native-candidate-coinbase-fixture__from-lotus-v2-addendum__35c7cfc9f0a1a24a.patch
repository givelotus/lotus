From 4b118e9bdb8809c5613ba7b91b8efee069babd77 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:32:56 -0700
Subject: [PATCH] fixup! v2: swap CBlockHeader and block index to 134-byte V2
 header and BLAKE3 BlockId

Construct the explicitly native candidate-state coinbase as version7 with a real native OP_TRUE output, retaining mismatch rejection and unchanged state/supply oracles. Focused candidate-state suite passes.

Tier: V2
---
 src/test/v2_candidate_state_tests.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/test/v2_candidate_state_tests.cpp b/src/test/v2_candidate_state_tests.cpp
index a299bbba45..665e4cd5bc 100644
--- a/src/test/v2_candidate_state_tests.cpp
+++ b/src/test/v2_candidate_state_tests.cpp
@@ -1,5 +1,6 @@
 // Copyright (c) 2026 The Lotus developers
 #include <primitives/block.h>
+#include <primitives/v2_outputs.h>
 #include <lotus_v2/candidate_state_key.h>
 #include <lotus_v2/mempool_overlay.h>
 #include <script/script.h>
@@ -84,10 +85,11 @@ BOOST_AUTO_TEST_CASE(accepted_zero_root_state_uses_actual_header_hash) {
 BOOST_AUTO_TEST_CASE(overlay_mismatch_does_not_publish_state_or_supply) {
     SetV2StatePersistDir("");
     CMutableTransaction cb;
+    cb.nVersion = 7;
     cb.vin.resize(1);
     cb.vin[0].prevout = COutPoint();
     cb.vin[0].nFlags = 2;
-    cb.vout.emplace_back(100 * SATOSHI, CScript() << OP_TRUE);
+    cb.vout.push_back(OpTrueOutput(100 * SATOSHI));
     const CTransaction coinbase{std::move(cb)};
     lotus::v2::MempoolOverlayLayer overlay;
     const auto expected = ComputeV2StateRootFromOverlay(coinbase, overlay, 0x207fffff, 1, 0);
