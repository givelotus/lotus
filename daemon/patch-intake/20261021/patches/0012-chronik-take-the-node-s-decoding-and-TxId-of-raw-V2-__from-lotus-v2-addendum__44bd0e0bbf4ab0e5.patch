 chronik/chronik-cpp/chronik_bridge.cpp        | 77 ++++++++++++++-----
 chronik/chronik-cpp/chronik_bridge.h          |  2 +
 .../chronik-indexer/src/query/broadcast.rs    | 10 ++-
 chronik/test/chronikbridge_tests.cpp          | 49 ++++++++++++
 5 files changed, 125 insertions(+), 24 deletions(-)

diff --git a/chronik/chronik-bridge/src/ffi.rs b/chronik/chronik-bridge/src/ffi.rs
index bcc95ef725..5eff2a3a1c 100644
--- a/chronik/chronik-bridge/src/ffi.rs
+++ b/chronik/chronik-bridge/src/ffi.rs
@@ -280,6 +280,17 @@ mod ffi_inner {
             block_index: &CBlockIndex,
         ) -> Result<&CBlockIndex>;
 
+        /// Replace `tx`, the legacy-shaped decoding of `raw_tx`, by the
+        /// node's own decoding of `raw_tx`: its inputs and outputs as
+        /// Chronik indexes them, its TxId, and unset (default) coins. If the
+        /// node cannot decode `raw_tx`, keep the legacy-shaped fields and
+        /// set the TxId the node computes for them.
+        fn decode_raw_tx(
+            self: &ChronikBridge,
+            raw_tx: &[u8],
+            tx: &mut Tx,
+        ) -> Result<()>;
+
         /// Lookup the spent coins of a tx and fill them in in-place.
         /// - `not_found` will be the outpoints that couldn't be found in the
         ///   node or the DB.
diff --git a/chronik/chronik-cpp/chronik_bridge.cpp b/chronik/chronik-cpp/chronik_bridge.cpp
index 989be51d19..67a96008f0 100644
--- a/chronik/chronik-cpp/chronik_bridge.cpp
+++ b/chronik/chronik-cpp/chronik_bridge.cpp
@@ -439,32 +439,67 @@ const CBlockIndex &ChronikBridge::find_fork(const CBlockIndex &index) const {
     return *fork;
 }
 
+void ChronikBridge::decode_raw_tx(rust::Slice<const uint8_t> raw_tx,
+                                  Tx &tx) const {
+    std::optional<CMutableTransaction> node_tx;
+    try {
+        DataStream stream{chronik::util::FromRustSlice(raw_tx)};
+        CMutableTransaction mtx;
+        stream >> mtx;
+        node_tx = std::move(mtx);
+    } catch (const std::exception &) {
+        // Not a node tx: keep the legacy-shaped fields.
+    }
+    if (node_tx) {
+        // A native V2 tx has no legacy-shaped fields: take the node's
+        // inputs, outputs and identity, as indexed once it is broadcast.
+        const CTransaction ctx{std::move(*node_tx)};
+        const bool is_coinbase = ctx.IsCoinBase();
+        rust::Vec<TxInput> inputs;
+        inputs.reserve(ctx.vin.size());
+        for (const CTxIn &input : ctx.vin) {
+            if (!is_coinbase && input.nFlags == 3) {
+                continue;
+            }
+            inputs.push_back({
+                .prev_out = BridgeOutPoint(input.prevout),
+                .script = BridgeTxInputScript(input),
+                .sequence = input.nSequence,
+                .coin = {},
+            });
+        }
+        tx.txid = chronik::util::HashToArray(ctx.GetId());
+        tx.version = ctx.nVersion;
+        tx.inputs = std::move(inputs);
+        tx.outputs = BridgeTxOutputs(ctx.vout);
+        tx.locktime = ctx.nLockTime;
+        return;
+    }
+    CMutableTransaction mtx;
+    mtx.nVersion = tx.version;
+    mtx.nLockTime = tx.locktime;
+    mtx.vin.reserve(tx.inputs.size());
+    for (const TxInput &in : tx.inputs) {
+        mtx.vin.emplace_back(
+            COutPoint(TxId(chronik::util::ArrayToHash(in.prev_out.txid)),
+                      in.prev_out.out_idx),
+            CScript(in.script.data(), in.script.data() + in.script.size()),
+            in.sequence);
+    }
+    mtx.vout.reserve(tx.outputs.size());
+    for (const TxOutput &out : tx.outputs) {
+        mtx.vout.emplace_back(
+            out.sats * SATOSHI,
+            CScript(out.script.data(), out.script.data() + out.script.size()));
+    }
+    tx.txid = chronik::util::HashToArray(CTransaction(mtx).GetId());
+}
