+    ix.reset();
+    // Resuming later continues where it stopped
+    env.host.SetShutdown(false);
+    ix = env.OpenSynced();
+    BOOST_CHECK_EQUAL(Tip(*ix)->height, 5);
+    const auto dump = Dump(*ix);
+    ix->Close();
