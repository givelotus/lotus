+    env.host.SetShutdown(false);
+    ix = env.OpenSynced();
+    BOOST_CHECK(Tip(*ix)->hash == env.host.ActiveBlock(4).info.hash);
+    const auto dump = Dump(*ix);
+    ix->Close();
+    BOOST_CHECK(dump == env.FreshDump());
