+int32_t TipHeight(Service &service) {
+    auto snap = service.Impl().indexer->Impl().Snapshot();
+    auto tip = index::BlockReader(snap.Store(), snap.Txn()).Tip();
+    return tip ? tip->height : -1;
+}
