From 6b7a8380b797b7cf220e07aa07db599a7118efd4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 22:23:22 -0700
Subject: [PATCH] fixup! fast_sync(v2): adapt 256-shard UTXO SnapSync and
 reverse peel to V2 header state_root

Select native version7 coinbases explicitly for all raw4e funding in the V2-only fast-sync/reverse-peel fixture. The inherited harness intentionally defaults to actual legacy coinbases; spending its raw4e legacy outputs as native correctly failed legacy-template validation. Keep inherited defaults and every anchor, shard, parent-child, peel and rejection assertion. Full focused functional passes3.8seconds.

Tier: V2
---
 test/functional/p2p_v2_fast_sync_and_reverse_peel.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/test/functional/p2p_v2_fast_sync_and_reverse_peel.py b/test/functional/p2p_v2_fast_sync_and_reverse_peel.py
index 13c707bb16..18ae9713a6 100755
--- a/test/functional/p2p_v2_fast_sync_and_reverse_peel.py
+++ b/test/functional/p2p_v2_fast_sync_and_reverse_peel.py
@@ -170,6 +170,7 @@ class FastSyncAndReversePeelTest(BitcoinTestFramework):
             node0,
             101,
             V2_OP_TRUE_DESCRIPTOR,
+            coinbase_version=7,
             sync_fun=lambda: self.sync_all(self.nodes[0:2]),
         )
 
@@ -191,6 +192,7 @@ class FastSyncAndReversePeelTest(BitcoinTestFramework):
             node0,
             1,
             V2_OP_TRUE_DESCRIPTOR,
+            coinbase_version=7,
             sync_fun=lambda: self.sync_all(self.nodes[0:2]),
         )
         assert_equal(node0.getblockcount(), 102)
@@ -209,6 +211,7 @@ class FastSyncAndReversePeelTest(BitcoinTestFramework):
             node0,
             1,
             V2_OP_TRUE_DESCRIPTOR,
+            coinbase_version=7,
             sync_fun=lambda: self.sync_all(self.nodes[0:2]),
         )
         assert_equal(node0.getblockcount(), 103)
@@ -218,6 +221,7 @@ class FastSyncAndReversePeelTest(BitcoinTestFramework):
             node0,
             1,
             V2_OP_TRUE_DESCRIPTOR,
+            coinbase_version=7,
             sync_fun=lambda: self.sync_all(self.nodes[0:2]),
         )
         assert_equal(node0.getblockcount(), 104)
@@ -412,7 +416,9 @@ class FastSyncAndReversePeelTest(BitcoinTestFramework):
         )
         spend_tx = build_v2_op_true_tx(child_tx.txid_int, 0, [child_val - 5_000])
         node2.sendrawtransaction(spend_tx.serialize().hex())
-        self.generatetodescriptor(node2, 1, V2_OP_TRUE_DESCRIPTOR, sync_fun=self.no_op)
+        self.generatetodescriptor(
+            node2, 1, V2_OP_TRUE_DESCRIPTOR, coinbase_version=7, sync_fun=self.no_op
+        )
         assert_equal(node2.getblockcount(), 105)
         hash_105 = node2.getblockhash(105)
         block_105_hex = node2.getblock(hash_105, 0)
