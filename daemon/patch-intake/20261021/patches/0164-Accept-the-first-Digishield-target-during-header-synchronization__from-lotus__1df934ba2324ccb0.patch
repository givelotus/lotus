From 5370ae44bec4dbe2cc65c9d98e35c12a570332e3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:57:27 -0700
Subject: [PATCH] Accept the first Digishield target during header
 synchronization

Header presync and redownload pass the candidate block height. Select its DAA parameters rather than the parent parameters, matching full GetNextWorkRequired validation. Otherwise the first Digishield target at height 145000 is rejected as an off-interval legacy retarget.

Inherited from Tobias doged 9690833b8b6709b7a7837bc397f0d04bf3b885d1. New regression checks both networks around the historical clamp, Digishield, and min-difficulty transitions against full DAA calculation. Native dogecoin_daa_tests fails one assertion before this repair and passes afterward; no production state changed.

diff --git a/src/pow/pow.cpp b/src/pow/pow.cpp
index 62a04b63f64891a600f19f4450ed3468f7944e54..6de10ef83d1fbed9d11239639ec95057e9441ab5 100644
--- a/src/pow/pow.cpp
+++ b/src/pow/pow.cpp
@@ -141,7 +141,9 @@ uint32_t GetNextWorkRequired(const CBlockIndex *pindexPrev,
 bool PermittedDifficultyTransition(const Consensus::Params &params,
                                    int64_t height, uint32_t old_nbits,
                                    uint32_t new_nbits) {
-    const Consensus::DaaParams daaParams = params.DaaParamsAtHeight(height - 1);
+    // Header synchronization receives the candidate height, just like the
+    // full DAA calculation. In particular, block 145000 is already Digishield.
+    const Consensus::DaaParams daaParams = params.DaaParamsAtHeight(height);
 
     if (daaParams.fPowAllowMinDifficultyBlocks || params.fPowNoRetargeting) {
         return true;
@@ -159,7 +161,7 @@ bool PermittedDifficultyTransition(const Consensus::Params &params,
     // Prior to Digishield, the difficulty could change only every 240 blocks,
     // so we can bail out early if we observe a difficulty change at an
     // unexpected block height.
-    if (!IsDigishieldEnabled(params, height - 1) &&
+    if (!IsDigishieldEnabled(params, height) &&
         height % params.DifficultyAdjustmentInterval(daaParams) != 0) {
         return false;
     }
diff --git a/src/pow/test/dogecoin_daa_tests.cpp b/src/pow/test/dogecoin_daa_tests.cpp
index b62f54cba7931923f93be55de91e98fff54b6e51..f8650b4b729ea6090d0651da2182d070793bfcb8 100644
--- a/src/pow/test/dogecoin_daa_tests.cpp
+++ b/src/pow/test/dogecoin_daa_tests.cpp
@@ -67,6 +67,40 @@ BOOST_AUTO_TEST_CASE(get_next_work_pre_digishield) {
         pindexLast->nBits, expected_nbits));
 }
 
+BOOST_AUTO_TEST_CASE(header_sync_accepts_daa_transition_boundaries) {
+    for (const auto chain : {ChainType::MAIN, ChainType::TESTNET}) {
+        DummyConfig config(ChainTypeToString(chain));
+        const auto &params = config.GetChainParams().GetConsensus();
+        // Exercise each historical clamp/algorithm/min-difficulty boundary
+        // and both adjacent heights against the full difficulty calculation.
+        for (const int transition : {5001, 10001, params.digishieldHeight,
+                                     params.digishieldMinDiffHeight}) {
+            for (int height = transition - 1; height <= transition + 1;
+                 ++height) {
+                auto blocks = MakeMockBlocks(241, height - 241);
+                for (size_t i = 0; i < blocks.size(); ++i) {
+                    blocks[i].nTime = 1400000000 + i * 30;
+                    blocks[i].nBits = 0x1b499dfd;
+                }
+                CBlockHeader header;
+                header.nTime = blocks.back().nTime + 30;
+                const auto next = GetNextWorkRequired(
+                    &blocks.back(), &header, config.GetChainParams());
+                BOOST_TEST_CONTEXT("height=" << height << " chain="
+                                   << ChainTypeToString(chain)) {
+                    BOOST_CHECK(PermittedDifficultyTransition(
+                        params, height, blocks.back().nBits, next));
+                    if (height == params.digishieldHeight) {
+                        // Ensure this actually exercises a changed target on
+                        // the first block, rather than the unchanged shortcut.
+                        BOOST_CHECK_NE(next, blocks.back().nBits);
+                    }
+                }
+            }
+        }
+    }
+}
+
 BOOST_AUTO_TEST_CASE(get_next_work_digishield) {
     DummyConfig config(ChainTypeToString(ChainType::MAIN));
     std::vector<CBlockIndex> blocks = MakeMockBlocks(2, 144999);
@@ -74,7 +108,7 @@ BOOST_AUTO_TEST_CASE(get_next_work_digishield) {
     CBlockHeader header;
     blocks[0].nTime = 1395094427; // Block # 144999
 
-    // First hard-fork at 145,000, which applies to block 145,001 onwards
+    // Historical mainnet fixture after the first Digishield block at 145000
     CBlockIndex *pindexLast = &blocks[1];
     BOOST_CHECK_EQUAL(pindexLast->nHeight, 145000);
     pindexLast->nTime = 1395094679;
