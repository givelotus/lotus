From d1420c53b697875e32f45631f61b8f7fb82b2ef7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] mempool: defer FlushPendingOverlayAdds in
 SyncMerklixOverlayToTip until overlay read

Keep SyncMerklixOverlayToTip O(1) during block connect and tip updates by
deferring pending Merklix overlay flushes until a template or sync reader
queries the overlay.

Build-prerequisite maintenance:
- Retain the existing overlay, s5, lazy-snapshot and mempool-queue interfaces removed by 020 while their implementations/callers remain; retain prerequisite filter/fee headers and the optional batch-collector declaration.
- Define the avabatch inventory ID required by the original 012 implementation/tests (0x20000006), preserve it in GetKind, and map its command name.
- Remove the stale treasury lock annotation until its V2 treasury mutex exists; no runtime treasury code is changed.
- Declare the existing mempool-batch vote variant and visitors with their 012 definitions; defer the V2-only supply gate until its V2 supply API is present.
- Reorder the V2 circulating-supply integration case to the V2 API introduction; it referenced absent SetV2BlockCirculatingSupplyForTest on L1.
- Compile the original Avalanche batch hashing helpers and define their avabatch wire command. Vendor/link BLAKE3 for the existing non-consensus batch-ID hash; L1 tagged hashes and block/transaction consensus hashes remain SHA-based.
- Keep one copy of the adaptive-epoch accessors and freeze API duplicated by 023.
- Restore the missing testrawtxbatch result-lambda binding and removeUnchecked transaction alias, and include declarations used by validation; these are compile repairs to existing expressions.
- Include the concrete disconnected-transaction type in its native test, and retain the 011 inventory expectations (50/25 ms, 2500 items/s, 350000 retained IDs) across stale 020 test literals.
- Keep the first copy of each preconsensus batch test; 023 appended duplicate BOOST test definitions already present in 012.
- Declare the overlay warm-state flag and helper used by 038, which were otherwise delayed until V2 integration. Keep one copy of the bulk-clear function appended a second time by 038; omit its V2-only input flag check while the transaction type remains legacy.

Original-Commit: 182b61908f156c240116fd49f53abc4220f95831
---
 src/txmempool.cpp | 32 +++++++++++++++++++++++++++++++-
 src/txmempool.h   |  2 ++
 2 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index b40fda212dd161227b2728153abc904162a08b26..d42336722a5ce22f6a7cc6dffe52b2b122428f87 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -219,6 +219,7 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
 
     m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
                                         entry->GetSigChecks());
+    m_overlay_warm.store(false, std::memory_order_relaxed);
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
@@ -234,6 +235,7 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     const CTransaction &tx = (*it)->GetTx();
     const TxId &txid = tx.GetId();
 
+    m_overlay_warm.store(false, std::memory_order_relaxed);
     if (m_defer_snapshot_depth > 0) {
         m_pending_overlay_removes.push_back(txid);
     } else {
@@ -425,6 +427,7 @@ void CTxMemPool::_clear() {
     m_pending_overlay_adds.clear();
     m_pending_overlay_removes.clear();
     m_merklix_overlay.Clear();
+    m_overlay_warm.store(true, std::memory_order_relaxed);
     m_utxo_fast_filter.ClearMempool();
     totalTxSize = 0;
     m_total_fee = Amount::zero();
@@ -509,7 +512,8 @@ void CTxMemPool::SyncMerklixOverlayToTip(const BlockHash &tip_hash,
         FlushPendingOverlayAdds();
         return;
     }
-    if (!m_pending_overlay_removes.empty()) {
+    if (m_merklix_overlay.GetSpeculativeOverlay().GetTxCount() > 0 ||
+        !m_pending_overlay_removes.empty()) {
         FlushPendingOverlayAdds();
     }
     std::shared_ptr<const lotus::v2::SmtNode> utxo_root;
@@ -519,6 +523,30 @@ void CTxMemPool::SyncMerklixOverlayToTip(const BlockHash &tip_hash,
     FlushPendingOverlayAdds();
 }
 
+
+
+void CTxMemPool::WarmMerklixOverlayIfNeeded(const BlockHash &tip_hash,
+                                            uint64_t next_height,
+                                            uint64_t next_mtp) const {
+    if (m_overlay_warm.load(std::memory_order_acquire) || tip_hash.IsNull()) {
+        return;
+    }
+    TRY_LOCK(cs, lock_mp);
+    if (!lock_mp) {
+        return;
+    }
+    if (mapTx.empty()) {
+        m_overlay_warm.store(true, std::memory_order_release);
+        return;
+    }
+    SyncMerklixOverlayToTip(tip_hash, next_height, next_mtp);
+    FlushPendingOverlayAdds();
+    const auto &spec = m_merklix_overlay.GetSpeculativeOverlay();
+    (void)spec.GetSubtreeARoot();
+    (void)spec.GetUtxoRoot();
+    m_overlay_warm.store(true, std::memory_order_release);
+}
+
 bool CTxMemPool::TryClearAllForConnectedBlock(
     const std::vector<CTransactionRef> &vtx) {
     AssertLockHeld(cs);
@@ -555,6 +583,7 @@ void CTxMemPool::ConnectBlockReset(const BlockHash &new_tip_hash,
                                    uint64_t next_height,
                                    uint64_t next_mtp) {
     AssertLockHeld(cs);
+    m_overlay_warm.store(false, std::memory_order_relaxed);
     lotus::v2::Hash tip_id{};
     std::memcpy(tip_id.data(), new_tip_hash.begin(), 32);
     std::shared_ptr<const lotus::v2::SmtNode> utxo_root;
@@ -564,6 +593,7 @@ void CTxMemPool::ConnectBlockReset(const BlockHash &new_tip_hash,
         m_pending_overlay_removes.clear();
         m_merklix_overlay.ResetToTip(tip_id, std::move(utxo_root), mon_state,
                                      next_height, next_mtp);
+        m_overlay_warm.store(true, std::memory_order_release);
     } else if (!m_pending_overlay_removes.empty()) {
         m_pending_overlay_adds.clear();
         m_pending_overlay_removes.clear();
diff --git a/src/txmempool.h b/src/txmempool.h
index fa7a591f1a13499bcd33759b3b951edf093ed03d..6c9c4337d21a26f559a15c80b2e143b01f45acca 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -647,6 +647,7 @@ public:
      * Ensure the Merklix overlay is anchored at the given tip block snapshot,
      * next block height, and parent MTP. O(1) no-op if already anchored.
      */
+    void WarmMerklixOverlayIfNeeded(const BlockHash &tip_hash, uint64_t next_height, uint64_t next_mtp) const LOCKS_EXCLUDED(cs);
     void SyncMerklixOverlayToTip(const BlockHash &tip_hash,
                                  uint64_t next_height,
                                  uint64_t next_mtp) const
@@ -731,6 +732,7 @@ public:
     }
 
 private:
+    mutable std::atomic<bool> m_overlay_warm{false};
     mutable lotus::v2::MerklixOverlayManager m_merklix_overlay GUARDED_BY(cs);
     mutable std::vector<std::tuple<CTransactionRef, int64_t, int64_t>>
         m_pending_overlay_adds GUARDED_BY(cs);
