diff --git a/chronik/native/include/chronik/native/index/group_history.h b/chronik/native/include/chronik/native/index/group_history.h
new file mode 100644
index 0000000000000000000000000000000000000000..d6c9548fdc306e8edf5c84f9f793745a61ebf27d
--- /dev/null
+++ b/chronik/native/include/chronik/native/index/group_history.h
@@ -0,0 +1,173 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_GROUP_HISTORY_H
+#define CHRONIK_NATIVE_INDEX_GROUP_HISTORY_H
+
+#include <chronik/native/extension.h>
+#include <chronik/native/index/data.h>
+#include <chronik/native/index/index_tx.h>
+#include <chronik/native/store.h>
+#include <chronik/native/types.h>
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+/**
+ * Port of chronik-db io/group_history.rs.
+ *
+ * Txs of a group member are stored paginated: each page is stored at the key
+ * `<serialized member> || <4-byte BE page num>` as concatenated postcard
+ * TxNums, and the member's total number of txs at `<serialized member>` in the
+ * num_txs table (u32 BE). Txs are ordered strictly ascendingly, within and
+ * between pages.
+ *
+ * Pages are extended/trimmed with the Rust CONCAT ('C') / TRIM ('T') merge
+ * operands, applied here as read-modify-writes with the same bytes and error
+ * handling (index/merge.h).
+ */
+namespace chronik::native::index {
+
+/** Represent page numbers with 32-bit unsigned integers. */
+using PageNum = uint32_t;
+/** Represent num txs with 32-bit unsigned integers. */
+using NumTxs = uint32_t;
+
+/** Settings for group history. */
+struct GroupHistorySettings {
+    /** Whether to index scripts by scripthash */
+    bool is_member_hash_index_enabled = false;
+};
+
+/** Stats about cache hits, num requests etc. */
+struct GroupHistoryStats {
+    /** Total number of members updated. */
+    size_t n_total = 0;
+    /** Time [s] for insert/delete. */
+    double t_total = 0;
+    /** Time [s] for grouping txs. */
+    double t_group = 0;
+    /** Time [s] for serializing members. */
+    double t_ser_members = 0;
+    /** Time [s] for fetching existing tx data. */
+    double t_fetch = 0;
+};
+
+/** In-memory data for the tx history. */
+struct GroupHistoryMemData {
+    GroupHistoryStats stats;
+    /** Whether to index scripts by scripthash */
+    bool is_member_hash_index_enabled = false;
+
+    GroupHistoryMemData() = default;
+    explicit GroupHistoryMemData(const GroupHistorySettings &settings)
+        : is_member_hash_index_enabled(
+              settings.is_member_hash_index_enabled) {}
+};
+
+/** Decode num_txs; "Inconsistent DB: Bad num_txs size: [..]" otherwise. */
+NumTxs BytesToNumTxs(ByteView bytes);
+
+/** `member_ser || page_num BE4` */
+Bytes KeyForMemberPage(ByteView member_ser, PageNum page_num);
+
+/** The history conf of the group; throws if it has none. */
+GroupHistoryConf RequireHistoryConf(const GroupDef &group);
+
+/** Write txs grouped and paginated to the DB. */
+class GroupHistoryWriter {
+public:
+    GroupHistoryWriter(const KvStore &store, const GroupDef &group);
+
+    /** Group the txs, then insert them to into each member of the group. */
+    void Insert(WriteTxn &txn, std::span<const IndexTx> txs,
+                const GroupAux *aux, GroupHistoryMemData &mem_data) const;
+
+    /** Group the txs, then delete them from each member of the group. */
+    void Delete(WriteTxn &txn, std::span<const IndexTx> txs,
+                const GroupAux *aux, GroupHistoryMemData &mem_data) const;
+
+    /** Clear all history data from the DB */
+    void Wipe(WriteTxn &txn) const;
+
+    /** Clear member_hash data from the DB */
+    void WipeMemberHash(WriteTxn &txn) const;
+
+    /**
+     * Compute the script hash index (Rust `reindex_member_hash`), committing
+     * its own write txns, the first after the first entry and then every
+     * 1,000,000 entries. Checks `shutdown_requested` every 10,000 entries.
+     * `log(msg, no_rate_limit)` receives the Rust log lines.
+     */
+    void ReindexMemberHash(
+        KvStore &store,
+        const std::function<Bytes(ByteView)> &decompress_script,
+        const std::function<bool()> &shutdown_requested,
+        const std::function<void(const std::string &, bool)> &log) const;
+
+private:
+    struct Fetched {
+        std::vector<NumTxs> members_num_txs;
+        std::vector<std::pair<Bytes, std::vector<TxNum>>> grouped_txs;
+        std::vector<Bytes> ser_members;
+    };
+
+    Fetched FetchMembersNumTxs(const ReadTxn &txn,
+                               std::span<const IndexTx> txs,
+                               const GroupAux *aux,
+                               GroupHistoryMemData &mem_data) const;
+
+    std::vector<std::pair<Bytes, std::vector<TxNum>>>
+    GroupTxs(std::span<const IndexTx> txs, const GroupAux *aux) const;
+
+    const GroupDef &m_group;
+    GroupHistoryConf m_conf;
+    TableId m_cf_page;
+    TableId m_cf_num_txs;
+    std::optional<TableId> m_cf_member_hash;
+};
+
+/** Read pages of grouped txs from the DB. */
+class GroupHistoryReader {
+public:
+    GroupHistoryReader(const KvStore &store, const ReadTxn &txn,
+                       const GroupDef &group);
+
+    /**
+     * Read the tx_nums for the given member on the given page, or nullopt if
+     * the page doesn't exist in the DB.
+     */
+    std::optional<std::vector<TxNum>> PageTxs(ByteView member_ser,
+                                              PageNum page_num) const;
+
+    /** Total number of pages and txs: (num_pages, num_txs). */
+    std::pair<size_t, size_t> MemberNumPagesAndTxs(ByteView member_ser) const;
+
+    /** Size of pages the data is stored in. */
+    size_t PageSize() const { return m_conf.page_size; }
+
+    /**
+     * Serialized member from the member hash (big-endian bytes, Rust
+     * `Sha256::to_be_bytes`); only for groups with a member hash table.
+     */
+    std::optional<Bytes>
+    MemberSerByMemberHash(const std::array<uint8_t, 32> &member_hash) const;
+
+private:
+    const ReadTxn &m_txn;
+    GroupHistoryConf m_conf;
+    TableId m_cf_page;
+    TableId m_cf_num_txs;
+    std::optional<TableId> m_cf_member_hash;
+};
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_GROUP_HISTORY_H
diff --git a/chronik/native/include/chronik/native/index/group_utxos.h b/chronik/native/include/chronik/native/index/group_utxos.h
new file mode 100644
index 0000000000000000000000000000000000000000..74ab68f7b4af64401f2f3af33e7b6cd079c452ad
--- /dev/null
+++ b/chronik/native/include/chronik/native/index/group_utxos.h
@@ -0,0 +1,132 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_INDEX_GROUP_UTXOS_H
+#define CHRONIK_NATIVE_INDEX_GROUP_UTXOS_H
+
+#include <chronik/native/extension.h>
+#include <chronik/native/index/data.h>
+#include <chronik/native/index/index_tx.h>
+#include <chronik/native/store.h>
+#include <chronik/native/types.h>
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <span>
+#include <string_view>
+#include <vector>
+
+/**
+ * Port of chronik-db io/group_utxos.rs (eCash tier, schema v13).
+ *
+ * The UTXOs of a member are the duplicate values of key `<serialized member>`
+ * in a DUPSORT table, sorted by their 12-byte `tx_num BE8 || out_idx BE4`
+ * outpoint prefix, followed by the UtxoDataKind payload (see extension.h).
+ *
+ * Within one Insert/Delete call, dup writes are collected like the Rust
+ * WriteBatch (keyed by member and outpoint prefix): a UTXO created and spent
+ * within the call cancels out without touching the table.
+ */
+namespace chronik::native::index {
+
+/** Entry in the UTXO DB for a group (Rust `UtxoEntry<D>`). */
+struct UtxoEntry {
+    /** Outpoint of the UTXO. */
+    DbOutpoint outpoint;
+    /** UtxoDataValue / first part of UtxoDataOutput. */
+    int64_t sats = 0;
+    /** UtxoDataOutput only (empty for UtxoDataValue). */
+    Bytes script;
+
+    bool operator==(const UtxoEntry &) const = default;
+};
+
+/** In-memory data for indexing UTXOs of a group. */
+struct GroupUtxoStats {
+    /** Total number of txs updated. */
+    size_t n_total = 0;
+    /** Time [s] for insert/delete. */
+    double t_total = 0;
+};
+
+struct GroupUtxoMemData {
+    GroupUtxoStats stats;
+};
+
+/** `tx_num BE8 || out_idx BE4` */
+std::array<uint8_t, 12> EncodeOutpointPrefix(const DbOutpoint &outpoint);
+
+/** Dup value of the entry (Rust `encode_utxo_dup`). */
+Bytes EncodeUtxoDup(UtxoDataKind kind, const UtxoEntry &entry);
+
+/** Rust `decode_utxo_dup`, with its SerError texts. */
+UtxoEntry DecodeUtxoDup(UtxoDataKind kind, ByteView bytes);
+
+/** The UTXO conf of the group; throws if it has none. */
+GroupUtxoConf RequireUtxoConf(const GroupDef &group);
+
+/** Write UTXOs of a group to the DB. */
+class GroupUtxoWriter {
+public:
+    GroupUtxoWriter(const KvStore &store, const GroupDef &group);
+
+    /**
+     * Insert the txs of a block: add all the UTXOs created by the outputs of
+     * the txs, remove all the UTXOs spent by the inputs of the txs.
+     */
+    void Insert(WriteTxn &txn, std::span<const IndexTx> txs,
+                const GroupAux *aux, GroupUtxoMemData &mem_data) const;
+
+    /**
+     * Remove the txs of a block: add all the UTXOs spent by the inputs of
+     * the txs and remove all the UTXOs created by the outputs of the txs.
+     */
+    void Delete(WriteTxn &txn, std::span<const IndexTx> txs,
+                const GroupAux *aux, GroupUtxoMemData &mem_data) const;
+
+    /** Clear all UTXO data from the DB */
+    void Wipe(WriteTxn &txn) const;
+
+    /** Data of an output / spent coin (Rust `UtxoData::from_output`). */
+    UtxoEntry OutputUtxo(const IndexTx &index_tx, size_t idx) const;
+    UtxoEntry InputUtxo(const IndexTx &index_tx, size_t idx) const;
+
+private:
+    const GroupDef &m_group;
+    UtxoDataKind m_kind;
+    TableId m_cf;
+};
+
+/** Read UTXOs of a group from the DB. */
+class GroupUtxoReader {
+public:
+    GroupUtxoReader(const KvStore &store, const ReadTxn &txn,
+                    const GroupDef &group);
+
+    /** Query the UTXOs for the given serialized member. */
+    std::optional<std::vector<UtxoEntry>> Utxos(ByteView member) const;
+
+    /**
+     * Visit all group members with a given prefix, starting from the first
+     * key >= `member_start` (or the first key if empty), stopping at the
+     * first key without the prefix (Rust `prefix_iterator`). `visit` returns
+     * false to stop early.
+     */
+    void VisitPrefix(
+        ByteView member_prefix, ByteView member_start,
+        const std::function<bool(ByteView member,
+                                 std::vector<UtxoEntry> &&utxos)> &visit)
+        const;
+
+private:
+    const ReadTxn &m_txn;
+    UtxoDataKind m_kind;
+    TableId m_cf;
+};
+
+} // namespace chronik::native::index
+
+#endif // CHRONIK_NATIVE_INDEX_GROUP_UTXOS_H
diff --git a/chronik/native/test/groups_script_tests.cpp b/chronik/native/test/groups_script_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3baa8c8aed03ae211e74b72dbe554913bfaa02d6
--- /dev/null
+++ b/chronik/native/test/groups_script_tests.cpp
@@ -0,0 +1,156 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Port of chronik-db groups/script.rs tests, plus LokadIdGroup, TxIdGroup and
+// group table specs.
+
+#include <chronik/native/groups/lokad_id.h>
+#include <chronik/native/groups/script.h>
+#include <chronik/native/groups/txid.h>
+#include <chronik/native/schema.h>
+
+#include <test/index_test_util.h>
+
+#include <boost/test/unit_test.hpp>
+
+using namespace chronik::native;
+using namespace chronik::native::groups;
+
+namespace {
+
+ScriptGroup MakeScriptGroup() {
+    return ScriptGroup(
+        [](ByteView data, uint8_t out[32]) { test::TestSha256(data, out); });
+}
+
+std::vector<MemberItem> Inputs(const GroupDef &group, const GroupQuery &q) {
+    std::vector<MemberItem> out;
+    group.InputMembers(q, nullptr, out);
+    return out;
+}
+
+std::vector<MemberItem> Outputs(const GroupDef &group, const GroupQuery &q) {
+    std::vector<MemberItem> out;
+    group.OutputMembers(q, nullptr, out);
+    return out;
+}
+
+} // namespace
+
+BOOST_AUTO_TEST_SUITE(groups_script_tests)
+
+BOOST_AUTO_TEST_CASE(test_script_group) {
+    const ScriptGroup script_group = MakeScriptGroup();
+    Tx tx;
+    for (const Bytes &script : {Bytes{0x51}, Bytes{0x52}}) {
+        TxInput input;
+        Coin coin;
+        coin.output.script = script;
+        input.coin = coin;
+        tx.inputs.push_back(input);
+    }
+    for (const Bytes &script :
+         {Bytes{0x53}, Bytes{0x6a}, Bytes{0x6a}, Bytes{0x51}, Bytes{0x6a}}) {
+        TxOutput output;
+        output.script = script;
+        tx.outputs.push_back(output);
+    }
+
+    GroupQuery query{false, &tx};
+    BOOST_CHECK(TxMembersForGroup(script_group, query, nullptr) ==
+                (std::vector<Bytes>{{0x51}, {0x52}, {0x53}, {0x51}}));
+    BOOST_CHECK(Inputs(script_group, query) ==
+                (std::vector<MemberItem>{{0, {0x51}}, {1, {0x52}}}));
+    BOOST_CHECK(Outputs(script_group, query) ==
+                (std::vector<MemberItem>{{0, {0x53}}, {3, {0x51}}}));
+
+    query = GroupQuery{true, &tx};
+    BOOST_CHECK(TxMembersForGroup(script_group, query, nullptr) ==
+                (std::vector<Bytes>{{0x53}, {0x51}}));
+    BOOST_CHECK(Inputs(script_group, query).empty());
+    BOOST_CHECK(Outputs(script_group, query) ==
+                (std::vector<MemberItem>{{0, {0x53}}, {3, {0x51}}}));
+
+    BOOST_CHECK(script_group.SerMember(Bytes{0x53}) == (Bytes{0x07, 0x53}));
+}
+
+BOOST_AUTO_TEST_CASE(test_script_group_inputs_stop_at_missing_coin) {
+    const ScriptGroup script_group = MakeScriptGroup();
+    Tx tx;
+    tx.inputs.resize(3);
+    tx.inputs[0].coin = Coin{TxOutput{1, {0x51}}, 0, false};
+    tx.inputs[2].coin = Coin{TxOutput{1, {0x52}}, 0, false};
+    const GroupQuery query{false, &tx};
+    BOOST_CHECK(Inputs(script_group, query) ==
+                (std::vector<MemberItem>{{0, {0x51}}}));
+    // sha256("") as big-endian bytes
+    const auto hash = script_group.SerHashMember(Bytes{});
+    BOOST_CHECK_EQUAL(hash[0], 0x55);
+    BOOST_CHECK_EQUAL(hash[31], 0xe3);
+    BOOST_CHECK(script_group.IsHashMemberSupported());
+}
+
+BOOST_AUTO_TEST_CASE(test_lokad_id_and_txid_groups) {
+    const LokadIdGroup lokad_id_group;
+    const TxIdGroup txid_group;
+    Tx tx;
+    tx.txid = test::TxIdNum(7);
+    tx.txid.b[0] = 1;
+    tx.inputs.resize(1);
+    TxOutput opreturn;
+    // OP_RETURN "ABCD"
+    opreturn.script = {0x6a, 0x04, 'A', 'B', 'C', 'D'};
+    tx.outputs.push_back(opreturn);
+    const GroupQuery query{false, &tx};
+
+    BOOST_CHECK(Inputs(lokad_id_group, query).empty());
+    BOOST_CHECK(Outputs(lokad_id_group, query) ==
+                (std::vector<MemberItem>{{0, {'A', 'B', 'C', 'D'}}}));
+    BOOST_CHECK(lokad_id_group.SerMember(Bytes{'A', 'B', 'C', 'D'}) ==
+                (Bytes{'A', 'B', 'C', 'D'}));
+    BOOST_CHECK(!lokad_id_group.IsHashMemberSupported());
+    BOOST_CHECK(!lokad_id_group.UtxoConf());
+
+    BOOST_CHECK(Inputs(txid_group, query).empty());
+    const std::vector<MemberItem> txid_items = Outputs(txid_group, query);
+    BOOST_REQUIRE_EQUAL(txid_items.size(), 1U);
+    BOOST_CHECK(txid_items[0].member == Bytes(tx.txid.b.begin(),
+                                              tx.txid.b.end()));
+    const Bytes txid_ser = txid_group.SerMember(txid_items[0].member);
+    BOOST_CHECK_EQUAL(txid_ser.front(), 7);
+    BOOST_CHECK_EQUAL(txid_ser.back(), 1);
+    BOOST_CHECK(GroupTableSpecs(txid_group).empty());
+}
+
+BOOST_AUTO_TEST_CASE(test_group_table_specs) {
+    const auto script_specs = GroupTableSpecs(MakeScriptGroup());
+    BOOST_REQUIRE_EQUAL(script_specs.size(), 4U);
+    BOOST_CHECK(script_specs[0].name == schema::kScriptHistory);
+    BOOST_CHECK(script_specs[1].name == schema::kScriptHistoryNumTxs);
+    BOOST_CHECK(script_specs[2].name == schema::kScripthash);
+    BOOST_CHECK(script_specs[3].name == schema::kScriptUtxo);
+    BOOST_CHECK(script_specs[3].kind == TableSpec::Kind::Dup);
+    BOOST_CHECK(script_specs[3].dup_fixed_size == uint32_t(20));
+
+    const auto lokad_specs = GroupTableSpecs(LokadIdGroup());
+    BOOST_REQUIRE_EQUAL(lokad_specs.size(), 2U);
+    BOOST_CHECK(lokad_specs[0].name == schema::kLokadIdHistory);
+    BOOST_CHECK(lokad_specs[1].name == schema::kLokadIdHistoryNumTxs);
+
+    // The specs match the schema's tables
+    schema::Schema schema;
+    for (const TableSpec &spec : script_specs) {
+        bool found = false;
+        for (const TableSpec &table : schema.Tables()) {
+            if (table.name == spec.name) {
+                found = true;
+                BOOST_CHECK(table.kind == spec.kind);
+                BOOST_CHECK(table.dup_fixed_size == spec.dup_fixed_size);
+            }
+        }
+        BOOST_CHECK(found);
+    }
+}
+
+BOOST_AUTO_TEST_SUITE_END()
