Subject: [PATCH] fixup! [v2 only] bench: orchestrate real-block fixture and
 WS/WSS load matrix

---
 contrib/p2p-load/run_matrix.py | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/contrib/p2p-load/run_matrix.py b/contrib/p2p-load/run_matrix.py
index 49533936f9..0b8f2ab1d9 100644
--- a/contrib/p2p-load/run_matrix.py
+++ b/contrib/p2p-load/run_matrix.py
@@ -113,6 +113,13 @@ def quantile(values,p):
     values=sorted(values)
     return values[min(len(values)-1,math.ceil(p*len(values))-1)] if values else None
 
+def metrics(port):
+    try:
+        with urllib.request.urlopen(f'http://127.0.0.1:{port}/metrics',timeout=2) as response:
+            return {'status':response.status,'body':response.read().decode()}
+    except urllib.error.HTTPError as e: return {'status':e.code,'body':e.read().decode(errors='replace')}
+    except Exception as e: return {'status':'unavailable','error':str(e)}
+
 def sample_cpu(pid):
     return subprocess.run(['ps','-M','-p',str(pid),'-o','pid,%cpu,time,comm'],capture_output=True,text=True).stdout
 
@@ -121,15 +128,18 @@ def matrix(args,fx):
     for transport in args.transports.split(','):
         for n in [int(x) for x in args.peers.split(',')]:
             for scenario in args.scenarios.split(','):
-                name=f'{transport}-{n}-{scenario}'; folder=args.output/name; folder.mkdir(exist_ok=True)
+                name=f'{transport}-{n}-{scenario}'; folder=args.output/name
                 resultpath=folder/'result.json'
                 if resultpath.exists() and json.loads(resultpath.read_text()).get('status')=='ok':
                     records.append(json.loads(resultpath.read_text())); continue
+                if folder.exists(): folder.rename(args.output/f'{name}-previous-{time.time_ns()}')
+                folder.mkdir()
                 data=folder/'data'
                 if not data.exists(): subprocess.run(['cp','-cR',str(args.output/'fixture'),str(data)],check=True)
                 p,rpc,cmd=start(args,data,transport=='wss')
                 client=None
                 try:
+                    metrics_before=metrics(args.rpcport)
                     hashes=folder/'hashes.txt'; hashes.write_text('\n'.join(fx['serve_hashes']) if scenario=='serve' else '')
                     ready=folder/'ready'; ready.unlink(missing_ok=True)
                     clientjson=folder/'client.json'
@@ -150,6 +160,7 @@ def matrix(args,fx):
                         time.sleep(.25)
                     clientdata=json.loads(clientjson.read_text()) if clientjson.exists() else {}
                     save(folder/'cpu-samples.json',samples)
+                    save(folder/'metrics.json',{'before':metrics_before,'after':metrics(args.rpcport)})
                     peers=clientdata.get('peers',[])
                     expected=50 if scenario=='serve' else 1
                     status='resource_blocked' if resource_blocker else 'ok' if client.returncode==0 and len(peers)==n and all(row['blocks']==expected for row in peers) else 'failed'
@@ -158,7 +169,7 @@ def matrix(args,fx):
                     transfer_begin=min((row['request_us'] for row in peers if row['request_us']),default=submitted or 0)
                     transfer_end=max((row['last_us'] for row in peers),default=0)
                     transfer_seconds=(transfer_end-transfer_begin)/1e6 if transfer_begin and transfer_end else None
-                    result={'name':name,'status':status,'transport':transport,'scenario':scenario,'peers':n,'expected_blocks_per_peer':expected,'node_command':cmd,'client_command':clientcmd,'elapsed_wall_seconds':time.monotonic()-begin,'client_cpu_seconds':clientdata.get('client_cpu_seconds'),'first_seconds':min(durations) if durations else None,'p50_seconds':quantile(durations,.5),'p99_seconds':quantile(durations,.99),'last_seconds':max(durations) if durations else None,'received_bytes':bytes_total,'submitted_monotonic_us':submitted,'load_average':os.getloadavg(),'run_count':1,'throughput_MBps':bytes_total/1e6/transfer_seconds if status=='ok' and transfer_seconds and transfer_seconds>0 else None,'transfer_seconds':transfer_seconds,'peak_combined_rss_bytes':max((v['combined_rss_bytes'] for v in samples),default=0),'resource_blocker':resource_blocker,'client_detail':'client.json','server_client_cpu_samples':'cpu-samples.json'}
+                    result={'name':name,'status':status,'transport':transport,'scenario':scenario,'peers':n,'expected_blocks_per_peer':expected,'node_command':cmd,'client_command':clientcmd,'executables':{str(binary):hashlib.sha256(binary.read_bytes()).hexdigest() for binary in [args.build/'src/bitcoind',args.build/'src/bench/p2p-load']},'source_commit':subprocess.check_output(['git','-C',str(ROOT),'rev-parse','HEAD'],text=True).strip(),'elapsed_wall_seconds':time.monotonic()-begin,'client_cpu_seconds':clientdata.get('client_cpu_seconds'),'first_seconds':min(durations) if durations else None,'p50_seconds':quantile(durations,.5),'p99_seconds':quantile(durations,.99),'last_seconds':max(durations) if durations else None,'received_bytes':bytes_total,'submitted_monotonic_us':submitted,'load_average':os.getloadavg(),'run_count':1,'throughput_MBps':bytes_total/1e6/transfer_seconds if status=='ok' and transfer_seconds and transfer_seconds>0 else None,'transfer_seconds':transfer_seconds,'peak_combined_rss_bytes':max((v['combined_rss_bytes'] for v in samples),default=0),'resource_blocker':resource_blocker,'client_detail':'client.json','server_client_cpu_samples':'cpu-samples.json'}
                     save(resultpath,result); records.append(result)
                     print(name,status,flush=True)
                 finally:
