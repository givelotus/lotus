From 83684aad148ba0999b49cf7d667543187b3c0f2c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:52:01 -0700
Subject: [PATCH] test: add MSG_AVA_TREASURY_CONTENDER to the framework

abc_p2p_avalanche_batch_and_treasury imports it, and the import failed
before the test started. Its value matches C++
(MSG_TYPE_AVALANCHE_INBOUND | 0x5). The test now passes, including the
50/25/25 split and the TreasuryPolicy park of a block missing the
treasury output.

Tier: V2 (fixup to v2/043)
---
 test/functional/test_framework/messages.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/test/functional/test_framework/messages.py b/test/functional/test_framework/messages.py
index 892b9465b6..d1613c8fa0 100644
--- a/test/functional/test_framework/messages.py
+++ b/test/functional/test_framework/messages.py
@@ -65,6 +65,7 @@ MSG_FILTERED_BLOCK = 3
 MSG_CMPCT_BLOCK = 4
 MSG_AVA_PROOF = 0x1F000001
 MSG_AVA_STAKE_CONTENDER = 0x1F000002
+MSG_AVA_TREASURY_CONTENDER = 0x20000005
 MSG_AVA_MEMPOOL_BATCH = 0x20000006
 MSG_TYPE_MASK = 0xFFFFFFFF >> 2
 
@@ -316,6 +317,7 @@ class CInv:
         MSG_CMPCT_BLOCK: "CompactBlock",
         MSG_AVA_PROOF: "avalanche proof",
         MSG_AVA_STAKE_CONTENDER: "avalanche stake contender",
+        MSG_AVA_TREASURY_CONTENDER: "avalanche treasury contender",
         MSG_AVA_MEMPOOL_BATCH: "avalanche mempool batch",
     }
 
