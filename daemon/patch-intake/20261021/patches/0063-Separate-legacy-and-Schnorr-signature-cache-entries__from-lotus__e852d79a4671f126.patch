From f63692cb2f1625fab391a9e81903456425c9c79b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:29:04 -0700
Subject: [PATCH] Separate legacy and Schnorr signature cache entries

Legacy Script interprets 64-byte signatures as ECDSA rather than Schnorr. Include the legacy mode bit in signature cache keys so a successful nonlegacy verification cannot bypass legacy verification when the same cache is reused. Preserve the upstream node-owned cache lifecycle and cover both signature modes with a native regression.

diff --git a/src/script/sigcache.cpp b/src/script/sigcache.cpp
index c2a21addf6e4a48ebbc73c3c1bbe6c6c29744b03..47d1627ccdf488eb3d7b85ad2bef24f36877427b 100644
--- a/src/script/sigcache.cpp
+++ b/src/script/sigcache.cpp
@@ -34,11 +34,13 @@ SignatureCache::SignatureCache(const size_t max_size_bytes) {
 
 void SignatureCache::ComputeEntry(uint256 &entry, const uint256 &hash,
                                   const std::vector<uint8_t> &vchSig,
-                                  const CPubKey &pubkey) const {
+                                  const CPubKey &pubkey, uint32_t flags) const {
+    const uint8_t legacy = (flags & SCRIPT_VERIFY_LEGACY_RULES) != 0;
     CSHA256 hasher = m_salted_hasher;
     hasher.Write(hash.begin(), 32)
         .Write(pubkey.data(), pubkey.size())
         .Write(vchSig.data(), vchSig.size())
+        .Write(&legacy, 1)
         .Finalize(entry.begin());
 }
 
@@ -55,9 +57,9 @@ void SignatureCache::Set(const uint256 &entry) {
 template <typename F>
 bool RunMemoizedCheck(SignatureCache &signatureCache,
                       const std::vector<uint8_t> &vchSig, const CPubKey &pubkey,
-                      const uint256 &sighash, bool storeOrErase, const F &fun) {
+                      const uint256 &sighash, bool storeOrErase, uint32_t flags, const F &fun) {
     uint256 entry;
-    signatureCache.ComputeEntry(entry, sighash, vchSig, pubkey);
+    signatureCache.ComputeEntry(entry, sighash, vchSig, pubkey, flags);
     if (signatureCache.Get(entry, !storeOrErase)) {
         return true;
     }
@@ -73,7 +75,7 @@ bool RunMemoizedCheck(SignatureCache &signatureCache,
 bool CachingTransactionSignatureChecker::IsCached(
     const std::vector<uint8_t> &vchSig, const CPubKey &pubkey,
     const uint256 &sighash) const {
-    return RunMemoizedCheck(m_signature_cache, vchSig, pubkey, sighash, true,
+    return RunMemoizedCheck(m_signature_cache, vchSig, pubkey, sighash, true, 0,
                             [] { return false; });
 }
 
@@ -81,7 +83,7 @@ bool CachingTransactionSignatureChecker::VerifySignature(
     const std::vector<uint8_t> &vchSig, const CPubKey &pubkey,
     const uint256 &sighash, uint32_t flags) const {
     return RunMemoizedCheck(
-        m_signature_cache, vchSig, pubkey, sighash, store, [&] {
+        m_signature_cache, vchSig, pubkey, sighash, store, flags, [&] {
             return TransactionSignatureChecker::VerifySignature(vchSig, pubkey,
                                                                 sighash, flags);
         });
diff --git a/src/script/sigcache.h b/src/script/sigcache.h
index 2b3af669cf1012339aafb44d46d051e00558e63f..3d64bfd86cb42f63b49d8f7e0fffe3e9363ace01 100644
--- a/src/script/sigcache.h
+++ b/src/script/sigcache.h
@@ -32,7 +32,7 @@ static constexpr size_t DEFAULT_SIGNATURE_CACHE_BYTES{32 << 20};
  */
 class SignatureCache {
 private:
-    //! Entries are SHA256(nonce || signature hash || public key || signature):
+    //! Entries are SHA256(nonce || signature hash || public key || signature || legacy mode):
     CSHA256 m_salted_hasher;
     typedef CuckooCache::cache<CuckooCache::KeyOnly<uint256>,
                                SignatureCacheHasher>
@@ -48,7 +48,7 @@ public:
 
     void ComputeEntry(uint256 &entry, const uint256 &hash,
                       const std::vector<uint8_t> &vchSig,
-                      const CPubKey &pubkey) const;
+                      const CPubKey &pubkey, uint32_t flags = 0) const;
 
     bool Get(const uint256 &entry, const bool erase);
 
diff --git a/src/test/sigcache_tests.cpp b/src/test/sigcache_tests.cpp
index c3013757d198a4d0d15c21ce02d527b0c1fdefc6..a60ae5eda8789263eb7ad8fc18964ccbf6c70373 100644
--- a/src/test/sigcache_tests.cpp
+++ b/src/test/sigcache_tests.cpp
@@ -50,6 +50,28 @@ public:
 
 BOOST_FIXTURE_TEST_SUITE(sigcache_tests, BasicTestingSetup)
 
+BOOST_AUTO_TEST_CASE(legacy_signature_cache_isolation) {
+    CKey key;
+    key.MakeNewKey(true);
+    const uint256 hash = Hash(std::string("legacy signature cache"));
+    std::vector<uint8_t> signature;
+    BOOST_REQUIRE(key.SignSchnorr(hash, signature));
+    const CTransaction tx{CMutableTransaction{}};
+    PrecomputedTransactionData txdata(tx);
+    SignatureCache cache{DEFAULT_SIGNATURE_CACHE_BYTES};
+    CachingTransactionSignatureChecker checker(&tx, 0, Amount::zero(), true,
+                                               cache, txdata);
+    // A cached Schnorr success must not authorize it as a legacy ECDSA signature.
+    BOOST_CHECK(checker.VerifySignature(signature, key.GetPubKey(), hash, 0));
+    BOOST_CHECK(!checker.VerifySignature(signature, key.GetPubKey(), hash,
+                                         SCRIPT_VERIFY_LEGACY_RULES));
+    BOOST_CHECK(checker.VerifySignature(signature, key.GetPubKey(), hash, 0));
+    BOOST_REQUIRE(key.SignECDSA(hash, signature));
+    BOOST_CHECK(checker.VerifySignature(signature, key.GetPubKey(), hash,
+                                        SCRIPT_VERIFY_LEGACY_RULES));
+    BOOST_CHECK(checker.VerifySignature(signature, key.GetPubKey(), hash, 0));
+}
+
 BOOST_AUTO_TEST_CASE(sig_pubkey_hash_variations) {
     /**
      * Making CachingTransactionSignatureChecker requires a tx. So we make a
