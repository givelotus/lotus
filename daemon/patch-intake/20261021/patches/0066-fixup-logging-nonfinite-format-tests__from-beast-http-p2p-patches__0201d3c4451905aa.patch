From 03a38e595e930680dd4deb7fe51d1851e06ffec6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:38:24 -0700
Subject: [PATCH] fixup! logging: add Elastic Common Schema JSON output

Extend the original raw floating-field JSON regression to the GCP and ECS encoders once those classes exist. Check finite preservation and null for NaN/positive/negative infinity in all three formats. This is later-owner test coverage for the separate shared encoder fixup, not a new producer feature or application reachability claim. Native logging_event_tests pass: 20 cases, 590 assertions; all five targets build. Isolated-index three-way application succeeds at the ECS owner after applying the earlier shared encoder fixup.
---
 src/test/logging_event_tests.cpp | 26 +++++++++++++++++---------
 1 file changed, 17 insertions(+), 9 deletions(-)

diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 3d9691acdb..c04ea0856f 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -108,7 +108,9 @@ BOOST_FIXTURE_TEST_SUITE(logging_event_tests, EventLogSetup)
 
 BOOST_AUTO_TEST_CASE(nonfinite_float_fields_produce_valid_json) {
     // Raw consumer fixture: Value supplies a name, not a producer type contract.
-    BCLog::JsonEncoder encoder;
+    BCLog::JsonEncoder json;
+    BCLog::JsonGcpEncoder gcp;
+    BCLog::JsonEcsEncoder ecs;
     const BCLog::LogEventSite site{"numeric_encoding", nullptr, BCLog::ALL,
                                    BCLog::Level::Info};
     for (const double value : {1.25, std::numeric_limits<double>::quiet_NaN(),
@@ -125,14 +127,20 @@ BOOST_AUTO_TEST_CASE(nonfinite_float_fields_produce_valid_json) {
         line.category = BCLog::ALL;
         line.event = &site;
         line.fields = BCLog::FieldList{data, 1};
-        std::string encoded;
-        encoder.Encode(line, BCLog::LogOptions{.timestamps = false}, encoded);
-        UniValue record;
-        const bool valid{record.read(encoded)};
-        BOOST_CHECK_MESSAGE(valid, encoded);
-        if (!valid) continue;
-        if (std::isfinite(value)) BOOST_CHECK_EQUAL(record["value"].get_real(), value);
-        else BOOST_CHECK(record["value"].isNull());
+        for (const BCLog::LogEncoder *encoder :
+             {static_cast<BCLog::LogEncoder *>(&json),
+              static_cast<BCLog::LogEncoder *>(&gcp),
+              static_cast<BCLog::LogEncoder *>(&ecs)}) {
+            std::string encoded;
+            encoder->Encode(line, BCLog::LogOptions{.timestamps = false}, encoded);
+            UniValue record;
+            const bool valid{record.read(encoded)};
+            BOOST_CHECK_MESSAGE(valid, encoded);
+            if (!valid) continue;
+            const auto &field{record[encoder == &ecs ? "lotus.value" : "value"]};
+            if (std::isfinite(value)) BOOST_CHECK_EQUAL(field.get_real(), value);
+            else BOOST_CHECK(field.isNull());
+        }
     }
 }
 
