@@ -90,6 +90,11 @@ enum class ScriptError {
        marker */
     INVALID_OP_SCRIPTTYPE,
 
+    /* Key spend path for Taproot must use BIP341 sighash */
+    TAPROOT_KEY_SPEND_MUST_USE_BIP341_SIGHASH,
