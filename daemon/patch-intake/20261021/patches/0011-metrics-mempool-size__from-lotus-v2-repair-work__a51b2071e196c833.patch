From b2f1ef0d4bdda37ea5fb96730d130062b30189eb Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 02:05:43 -0700
Subject: [PATCH 11/18] metrics: mempool size

The mempool's transaction count and total size live under the mempool
lock; they are mirrored into gauges where they change (addUnchecked,
removeUnchecked, _clear), with that lock already held, so scraping takes
no mempool lock. The stores are relaxed atomics, about a nanosecond.
---
 src/node/metrics.cpp                      |  4 ++++
 src/node/metrics.h                        | 12 ++++++++++++
 src/txmempool.cpp                         |  5 +++++
 test/functional/interface_http_metrics.py | 11 +++++++++++
 4 files changed, 32 insertions(+)

diff --git a/src/node/metrics.cpp b/src/node/metrics.cpp
index 2293532727..9b8c5372cd 100644
--- a/src/node/metrics.cpp
+++ b/src/node/metrics.cpp
@@ -158,6 +158,10 @@ NodeMetrics::NodeMetrics()
           "Time to connect a block to the chain tip (ConnectBlock: "
           "validating it and updating the UTXO view).",
           BLOCK_CONNECT_BUCKETS, /*divisor=*/1e9)},
+      mempool_transactions{Add<Gauge>(registry, "lotus_mempool_transactions",
+                                      "Transactions in the mempool.")},
+      mempool_bytes{Add<Gauge>(registry, "lotus_mempool_bytes",
+                               "Total size of the mempool's transactions.")},
       http_requests{Add<Counter>(
           registry, "lotus_http_requests_total",
           "HTTP requests answered (not WebSocket sessions), by endpoint and "
diff --git a/src/node/metrics.h b/src/node/metrics.h
index 450c70ad76..08fb57b4c8 100644
--- a/src/node/metrics.h
+++ b/src/node/metrics.h
@@ -77,6 +77,10 @@ struct NodeMetrics {
     metrics::Gauge &initial_block_download;
     metrics::EventHistogram &block_connect_seconds;
 
+    // Mempool
+    metrics::Gauge &mempool_transactions;
+    metrics::Gauge &mempool_bytes;
+
     // HTTP and RPC
     metrics::Counter &http_requests;
     metrics::EventHistogram &http_request_seconds;
@@ -108,6 +112,14 @@ void StopNodeMetrics();
 /** Label index of a P2P message type ("other" for unknown types) */
 size_t MetricMsgTypeIndex(std::string_view msg_type) noexcept;
 
+/** Set the mempool gauges (call with the mempool lock held) */
+inline void SetMempoolMetrics(size_t transactions, uint64_t bytes) noexcept {
+    if (auto *m{GetNodeMetrics()}) {
+        m->mempool_transactions.Set(double(transactions));
+        m->mempool_bytes.Set(double(bytes));
+    }
+}
+
 /** Set the chain tip gauges (call with cs_main held, where the tip changes) */
 inline void SetTipMetrics(int height, int64_t block_time) noexcept {
     if (auto *m{GetNodeMetrics()}) {
diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 11d210d950..721fd533b7 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -14,6 +14,7 @@
 #include <consensus/tx_verify.h>
 #include <consensus/validation.h>
 #include <logging.h>
+#include <node/metrics.h>
 #include <policy/fees.h>
 #include <policy/policy.h>
 #include <reverse_iterator.h>
@@ -189,6 +190,7 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
+    node::SetMempoolMetrics(mapTx.size(), totalTxSize);
     m_total_fee += entry->GetFee();
 }
 
@@ -224,6 +226,8 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     RemoveUnbroadcastTx(txid, true);
 
     totalTxSize -= (*it)->GetTxSize();
+    // (one entry is about to leave mapTx)
+    node::SetMempoolMetrics(mapTx.size() - 1, totalTxSize);
     m_total_fee -= (*it)->GetFee();
     cachedInnerUsage -= (*it)->DynamicMemoryUsage();
     cachedInnerUsage -=
@@ -368,6 +372,7 @@ void CTxMemPool::_clear() {
     mapNextTx.clear();
     totalTxSize = 0;
     m_total_fee = Amount::zero();
+    node::SetMempoolMetrics(0, 0);
     cachedInnerUsage = 0;
     lastRollingFeeUpdate = GetTime();
     blockSinceLastRollingFeeBump = false;
diff --git a/test/functional/interface_http_metrics.py b/test/functional/interface_http_metrics.py
index b1c259e316..7835a63d03 100755
--- a/test/functional/interface_http_metrics.py
+++ b/test/functional/interface_http_metrics.py
@@ -178,6 +178,17 @@ class HTTPMetricsTest(BitcoinTestFramework):
         assert samples[("lotus_block_connect_seconds_sum", ())] > 0
         # Message handling is timed for 1 message in 16.
         assert self.total(samples, "lotus_p2p_message_handling_seconds_count") > 0
+        assert_equal(samples[("lotus_mempool_transactions", ())], 0)
+        tx = wallet.send_self_transfer(from_node=node)
+        self.wait_until(
+            lambda: self.scrape()[("lotus_mempool_transactions", ())] == 1
+        )
+        assert_equal(
+            self.scrape()[("lotus_mempool_bytes", ())], len(tx["hex"]) // 2)
+        self.generate(node, 1)
+        self.wait_until(
+            lambda: self.scrape()[("lotus_mempool_transactions", ())] == 0
+        )
 
         self.log.info("HTTP and RPC requests")
         node.getblockcount()
