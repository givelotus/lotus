From eda0548ab54ca7a1f144a2e166e5bab6c3609408 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] net: tune outbound inv broadcast queue and incoming inv
 suppression window

Tune outbound inventory broadcast intervals (150ms outbound, 500ms inbound)
and increase INVENTORY_BROADCAST_PER_SECOND to 250.

Original-Commit: 23b0b69b1c0c517ba82d8baa46c723975eda5000
Original-Patch: ecash/011
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/net_processing.h | 61 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/src/net_processing.h b/src/net_processing.h
index 1f01c21441f78cc9b4a2d2e6826b26f7c4474078..e13f4c692ffda4c51d709fa63b5a7ac0f9a7c0ef 100644
--- a/src/net_processing.h
+++ b/src/net_processing.h
@@ -16,6 +16,10 @@ struct ProofId;
 class Processor;
 } // namespace avalanche
 
+namespace lotus::v2::net {
+class V2PeerProtocolHandler;
+} // namespace lotus::v2::net
+
 class AddrMan;
 class CTxMemPool;
 class ChainstateManager;
@@ -41,6 +45,36 @@ static const unsigned int MAX_CMPCTBLOCKS_INFLIGHT_PER_BLOCK = 3;
 /** The maximum number of address records permitted in an ADDR message. */
 static constexpr size_t MAX_ADDR_TO_SEND{1000};
 
+/**
+ * Average delay between trickled inventory transmissions for inbound peers.
+ * Blocks and peers with NetPermissionFlags::NoBan permission bypass this.
+ */
+static constexpr std::chrono::milliseconds
+    INBOUND_INVENTORY_BROADCAST_INTERVAL{50};
+/**
+ * Average delay between trickled inventory transmissions for outbound peers.
+ * Batches outbound inv messages over a short suppression window so incoming
+ * invs and Merklix reconciliation summaries can suppress redundant outbound
+ * invs.
+ */
+static constexpr std::chrono::milliseconds
+    OUTBOUND_INVENTORY_BROADCAST_INTERVAL{25};
+/**
+ * Maximum rate of inventory items to send per second.
+ * Scaled for V2 high-throughput transaction relay.
+ */
+static constexpr unsigned int INVENTORY_BROADCAST_PER_SECOND = 2500;
+/**
+ * Maximum number of inventory items to send per transmission per MB of max
+ * block size.
+ */
+static constexpr unsigned int INVENTORY_BROADCAST_MAX_PER_MB =
+    INVENTORY_BROADCAST_PER_SECOND * 5;
+static constexpr unsigned int INVENTORY_BROADCAST_MAX =
+    5000 * INVENTORY_BROADCAST_PER_SECOND;
+/** The number of most recently announced transactions a peer can request. */
+static constexpr unsigned int INVENTORY_MAX_RECENT_RELAY = 350000;
+
 /**
  * Number of headers sent in one getheaders result. We rely on the assumption
  * that if a peer sends less than this number, we reached its tip. Changing
@@ -127,6 +161,15 @@ public:
     /** Relay transaction to all peers. */
     virtual void RelayTransaction(const TxId &txid) = 0;
 
+    /** Relay a batch of transactions to all peers, coalescing per-peer mutex acquisitions. */
+    virtual void RelayTransactionBatch(std::span<const CTransactionRef> txs) {
+        for (const auto &tx : txs) {
+            if (tx) {
+                RelayTransaction(tx->GetId());
+            }
+        }
+    }
+
     /** Relay proof to all peers */
     virtual void RelayProof(const avalanche::ProofId &proofid) = 0;
 
@@ -158,6 +201,24 @@ public:
      */
     virtual void UpdateLastBlockAnnounceTime(NodeId node,
                                              int64_t time_in_seconds) = 0;
+
+    /** Accessor for the V2 P2P protocol handler. */
+    virtual lotus::v2::net::V2PeerProtocolHandler *GetV2ProtocolHandler() {
+        return nullptr;
+    }
+
+    /** Mark a transaction as known by a specific peer so it is not relayed back to them. */
+    virtual void MarkPeerKnownTx(NodeId peer_id, const TxId &txid) {}
+
+    /** Mark a batch of transactions as known by a specific peer, coalescing lock acquisitions. */
+    virtual void MarkPeerKnownTxBatch(NodeId peer_id,
+                                      std::span<const CTransactionRef> txs) {
+        for (const auto &tx : txs) {
+            if (tx) {
+                MarkPeerKnownTx(peer_id, tx->GetId());
+            }
+        }
+    }
 };
 
 #endif // BITCOIN_NET_PROCESSING_H
