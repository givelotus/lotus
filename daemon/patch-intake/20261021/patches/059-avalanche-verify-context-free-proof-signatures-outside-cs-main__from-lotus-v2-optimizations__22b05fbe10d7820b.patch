From aafd1eb6b319ced11b8f09cfc9d25f1f5ae551c7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:57:46 -0700
Subject: [PATCH] avalanche: verify context-free Proof signatures outside
 cs_main

Original-Commit: 08c8002e098e8aa2549e6f8565a441c360451dc8
Original-Patch: ecash/046
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/avalanche/peermanager.cpp |  6 ++++--
 src/avalanche/proof.cpp       | 23 ++++++++++++++++-------
 src/avalanche/proof.h         |  4 ++++
 3 files changed, 24 insertions(+), 9 deletions(-)

diff --git a/src/avalanche/peermanager.cpp b/src/avalanche/peermanager.cpp
index 84cf765405..666353d4a9 100644
--- a/src/avalanche/peermanager.cpp
+++ b/src/avalanche/peermanager.cpp
@@ -323,8 +323,10 @@ bool PeerManager::registerProof(const ProofRef &proof,
 
     // Check the proof's validity.
     ProofValidationState validationState;
-    if (!WITH_LOCK(cs_main, return proof->verify(stakeUtxoDustThreshold,
-                                                 chainman, validationState))) {
+    if (!proof->verify(stakeUtxoDustThreshold, validationState) ||
+        !WITH_LOCK(cs_main, return proof->verifyUtxos(
+                                stakeUtxoDustThreshold, chainman,
+                                validationState))) {
         if (isImmatureState(validationState)) {
             immatureProofPool.addProofIfPreferred(proof);
             if (immatureProofPool.countProofs() >
diff --git a/src/avalanche/proof.cpp b/src/avalanche/proof.cpp
index 130f42c4e6..6994d76253 100644
--- a/src/avalanche/proof.cpp
+++ b/src/avalanche/proof.cpp
@@ -225,14 +225,11 @@ bool Proof::verify(const Amount &stakeUtxoDustThreshold,
     return true;
 }
 
-bool Proof::verify(const Amount &stakeUtxoDustThreshold,
-                   const ChainstateManager &chainman,
-                   ProofValidationState &state) const {
+bool Proof::verifyUtxos(const Amount &stakeUtxoDustThreshold,
+                        const ChainstateManager &chainman,
+                        ProofValidationState &state) const {
     AssertLockHeld(cs_main);
-    if (!verify(stakeUtxoDustThreshold, state)) {
-        // state is set by verify.
-        return false;
-    }
+    (void)stakeUtxoDustThreshold;
 
     const CBlockIndex *activeTip = chainman.ActiveTip();
     const int64_t tipMedianTimePast =
@@ -316,4 +313,16 @@ bool Proof::verify(const Amount &stakeUtxoDustThreshold,
     return true;
 }
 
+bool Proof::verify(const Amount &stakeUtxoDustThreshold,
+                   const ChainstateManager &chainman,
+                   ProofValidationState &state) const {
+    AssertLockHeld(cs_main);
+    if (!verify(stakeUtxoDustThreshold, state)) {
+        // state is set by verify.
+        return false;
+    }
+
+    return verifyUtxos(stakeUtxoDustThreshold, chainman, state);
+}
+
 } // namespace avalanche
diff --git a/src/avalanche/proof.h b/src/avalanche/proof.h
index f6a81a29c2..52335e268c 100644
--- a/src/avalanche/proof.h
+++ b/src/avalanche/proof.h
@@ -174,6 +174,10 @@ public:
 
     bool verify(const Amount &stakeUtxoDustThreshold,
                 ProofValidationState &state) const;
+    bool verifyUtxos(const Amount &stakeUtxoDustThreshold,
+                     const ChainstateManager &chainman,
+                     ProofValidationState &state) const
+        EXCLUSIVE_LOCKS_REQUIRED(cs_main);
     bool verify(const Amount &stakeUtxoDustThreshold,
                 const ChainstateManager &chainman,
                 ProofValidationState &state) const
