From 104c205c9789165d83af4149834ea423f8670458 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 17:06:06 -0700
Subject: [PATCH] lint(v2): forbid the removed hybrid transaction forms

test/lint/lint-v2-tx-hybrid.py rejects, in src/ and test/functional/,
the removed helpers (AdaptLegacy, HasStructuralV2Identity,
IsDisallowedNonV7Tx), the reject reason bad-txns-non-v7-format, and the
wrapped version constants 0x80000007/0xC0000007 outside the two tests
that assert those versions do not decode.

The design's other two rules are not added: CTxIn and CTxOut keep their
V2 fields (one class per kind, the version invariant enforced at
serialization), so `nFlags == 0` (CTxIn::IsLegacy, V2 output flags) and
direct scriptSig/scriptPubKey access remain legitimate.

Tier: V2
---
 test/lint/README.md            |  7 ++++
 test/lint/lint-v2-tx-hybrid.py | 75 ++++++++++++++++++++++++++++++++++
 2 files changed, 82 insertions(+)
 create mode 100755 test/lint/lint-v2-tx-hybrid.py

diff --git a/test/lint/README.md b/test/lint/README.md
index f222b6b641d76a4ffd33534209b46fd2c4ca6d97..ed8daae7cc24d2ea544921814a0bd840bea55ea9 100644
--- a/test/lint/README.md
+++ b/test/lint/README.md
@@ -4,6 +4,13 @@ check-doc.py
 ============
 Check for missing documentation of command line options.
 
+lint-v2-tx-hybrid.py
+====================
+Check that the removed hybrid-transaction forms (the wrapped versions
+0x80000007/0xC0000007, AdaptLegacy, HasStructuralV2Identity,
+IsDisallowedNonV7Tx, bad-txns-non-v7-format) do not return to `src/` or
+`test/functional/`.
+
 git-subtree-check.sh
 ====================
 Run this script from the root of the repository to verify that a subtree matches the contents of
diff --git a/test/lint/lint-v2-tx-hybrid.py b/test/lint/lint-v2-tx-hybrid.py
new file mode 100755
index 0000000000000000000000000000000000000000..5dd4f70551db7efb47f4326c7234800157120318
--- /dev/null
+++ b/test/lint/lint-v2-tx-hybrid.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+"""
+Check that the removed hybrid-transaction forms do not come back.
+
+A transaction is legacy (version 1 or 2) or V2 (version 7); other versions,
+including the former wrapped versions 0x80000007 and 0xC0000007, do not
+decode. This lint rejects, in src/ and test/functional/:
+- the removed helpers AdaptLegacy, HasStructuralV2Identity and
+  IsDisallowedNonV7Tx, and the reject reason bad-txns-non-v7-format;
+- the wrapped version constants, except in tests that assert they do not
+  decode.
+"""
+
+import re
+import subprocess
+import sys
+
+FORBIDDEN = [
+    (r"\bAdaptLegacy\b", "removed legacy adaptation"),
+    (r"\bHasStructuralV2Identity\b", "removed hybrid identity test"),
+    (r"\bIsDisallowedNonV7Tx\b", "removed non-v7 RPC refusal"),
+    (r"bad-txns-non-v7-format", "removed non-v7 reject reason"),
+    (r"\b0x[8C]0000007U?\b", "wrapped transaction version"),
+]
+
+# Tests that check the wrapped versions fail to decode.
+WRAPPED_VERSION_TESTS = {
+    "src/test/transaction_tests.cpp",
+    "test/functional/feature_tx_version.py",
+}
+
+EXCLUDED_PREFIXES = (
+    "src/leveldb/",
+    "src/secp256k1/",
+    "src/crc32c/",
+    "src/lotus_v2/vendor/",
+    "test/lint/lint-v2-tx-hybrid.py",
+)
+
+
+def main():
+    files = subprocess.check_output(
+        ["git", "ls-files", "--", "src", "test/functional"], text=True
+    ).split()
+    errors = []
+    for path in files:
+        if path.startswith(EXCLUDED_PREFIXES) or not path.endswith(
+            (".cpp", ".h", ".py", ".rs")
+        ):
+            continue
+        try:
+            with open(path, encoding="utf8") as f:
+                lines = f.read().splitlines()
+        except (OSError, UnicodeDecodeError):
+            continue
+        for n, line in enumerate(lines, 1):
+            for pattern, what in FORBIDDEN:
+                if not re.search(pattern, line, re.IGNORECASE):
+                    continue
+                if what == "wrapped transaction version" and (
+                    path in WRAPPED_VERSION_TESTS
+                ):
+                    continue
+                errors.append(f"{path}:{n}: {what}: {line.strip()}")
+    for e in errors:
+        print(e)
+    return 1 if errors else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
