 }
 
+// Independent tiny-fixture oracle: scan sorted candidates for the first
+// transaction whose explicit test dependencies have already been emitted.
+static std::vector<TxId> DependencyOrderedIds(
+    std::vector<TxId> pending,
+    const std::vector<std::pair<TxId, TxId>> &child_parent_edges) {
+    std::sort(pending.begin(), pending.end());
+    std::vector<TxId> ordered;
+    while (!pending.empty()) {
+        auto ready =
+            std::find_if(pending.begin(), pending.end(), [&](const auto &id) {
+                return std::none_of(
+                    child_parent_edges.begin(), child_parent_edges.end(),
+                    [&](const auto &edge) {
+                        return edge.first == id &&
+                               std::find(pending.begin(), pending.end(),
+                                         edge.second) != pending.end();
+                    });
+            });
+        BOOST_REQUIRE(ready != pending.end());
+        ordered.push_back(*ready);
+        pending.erase(ready);
+    }
+    return ordered;
+}
+
+static void CheckDependencyOrder(const CBlock &block) {
+    for (auto child = block.vtx.begin() + 1; child != block.vtx.end();
+         ++child) {
+        for (const auto &input : (*child)->vin) {
+            const auto parent = std::find_if(
+                block.vtx.begin(), block.vtx.end(), [&](const auto &tx) {
+                    return tx->GetId() == input.prevout.GetTxId();
+                });
+            if (parent != block.vtx.end()) {
+                BOOST_CHECK(parent < child);
+            }
+        }
+    }
+}
