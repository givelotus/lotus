From e2f6b29bf4dbb2be14ed2192bc971e0b5f13affb Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Wed, 3 Sep 2025 18:36:41 +0000
Subject: [PATCH] Fix min difficulty rules on testnet prior to digishield
 activation

(cherry picked from commit 3489448cac261fbd5619d6d128d3f63142d05c80)

Maintenance rationale (2026-10-14):
Preserve the historical pre-DigiShield testnet minimum-difficulty behavior instead of applying the later exception early.

diff --git a/src/consensus/params.cpp b/src/consensus/params.cpp
index eacd84d13e18fa2dae3b77d26c8b755830767450..35b5d2b3293343e8bd2674f3edc112e37d706c7e 100644
--- a/src/consensus/params.cpp
+++ b/src/consensus/params.cpp
@@ -15,7 +15,8 @@ DaaParams Params::DaaParamsAtHeight(int32_t nHeight) const {
 
     daaParams.fPowAllowMinDifficultyBlocks = enableTestnetMinDifficulty;
     // Blocks 145000 - 157499 have fPowAllowMinDifficultyBlocks disabled
-    if (enableTestnetMinDifficulty && hasDigishield && nHeight < 157500) {
+    if (enableTestnetMinDifficulty && nHeight >= digishieldHeight &&
+        nHeight < digishieldMinDiffHeight) {
         daaParams.fPowAllowMinDifficultyBlocks = false;
     }
 
diff --git a/src/consensus/params.h b/src/consensus/params.h
index d42f25f3dc69d990913d1b160437ee019088bbcc..5321f85398e31ed6888df26bc8c9c86f074187bc 100644
--- a/src/consensus/params.h
+++ b/src/consensus/params.h
@@ -80,6 +80,16 @@ struct Params {
     /** Dogecoin "Digishield" activation height */
     int digishieldHeight;
 
+    /**
+     * Dogecoin "Digishield" testnet min-difficulty height.
+     * Note: The logic for this is confusing and the original dogecoin code
+     * should be used as reference. The mainnet and testnet logic are
+     * intertwined in an ugly way and should be refactored with extreme care.
+     * Ideally, this min-diff logic should be removed and testnet forked from
+     * a point that it is not required.
+     */
+    int digishieldMinDiffHeight;
+
     /** Coinbase maturity before Digishield */
     int32_t initialCoinbaseMaturity;
 
diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 729eed4ea82c2c429e96edad96255eec2fb552cd..94b25a2466bcdcfdf781edf0649e4e08f7d8bf7d 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -135,6 +135,7 @@ public:
 
         // Dogecoin: Digishield activation height
         consensus.digishieldHeight = 145000;
+        consensus.digishieldMinDiffHeight = 157500;
         consensus.initialCoinbaseMaturity = 30;
 
         /**
@@ -292,6 +293,7 @@ public:
 
         // Dogecoin: Digishield activation height
         consensus.digishieldHeight = 145000;
+        consensus.digishieldMinDiffHeight = 157500;
         consensus.initialCoinbaseMaturity = 30;
 
         diskMagic[0] = 0xfb;
@@ -448,6 +450,7 @@ public:
 
         // Digishield activation height
         consensus.digishieldHeight = 1450;
+        consensus.digishieldMinDiffHeight = 157500;
         // keep maturity same as Bitcoin for tests
         consensus.initialCoinbaseMaturity = REGTEST_COINBASE_MATURITY;
 
diff --git a/src/pow/pow.cpp b/src/pow/pow.cpp
index 41f79bba9a78db500c1e7b3f1b3cffe4e732375e..62a04b63f64891a600f19f4450ed3468f7944e54 100644
--- a/src/pow/pow.cpp
+++ b/src/pow/pow.cpp
@@ -47,10 +47,12 @@ uint32_t GetNextWorkRequired(const CBlockIndex *pindexPrev,
         UintToArith256(params.powLimit).GetCompact();
 
     const int32_t nHeight = pindexPrev->nHeight;
-    const Consensus::DaaParams daaParams = params.DaaParamsAtHeight(nHeight + 1);
+    const Consensus::DaaParams daaParams =
+        params.DaaParamsAtHeight(nHeight + 1);
 
     // Dogecoin: Special rules for minimum difficulty blocks with Digishield
-    if (AllowDigishieldMinDifficultyForBlock(pindexPrev, pblock, params,
+    if (nHeight >= params.digishieldMinDiffHeight &&
+        AllowDigishieldMinDifficultyForBlock(pindexPrev, pblock, params,
                                              daaParams)) {
         // Special difficulty rule for testnet:
         // If the new block's timestamp is more than 2* nTargetSpacing minutes
