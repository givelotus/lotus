+void BCLog::Logger::RecordDeleter::operator()(LogRecord *rec) const {
+    if (rec->event) {
+        ReleaseFields(
+            FieldList{std::span<const std::byte>{rec->payload, rec->size},
+                      rec->num_fields});
+    }
+    delete rec;
+}
