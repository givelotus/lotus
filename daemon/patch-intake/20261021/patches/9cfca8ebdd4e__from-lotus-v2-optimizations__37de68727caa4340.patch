From 9cfca8ebdd4e7027b206fdf9c005ad0c8fdc21b8 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 23:01:37 -0700
Subject: [PATCH] fixup! net: batch-validate solicited/high-bandwidth SHORTTX
 and coalesce incoming TX bursts

Attribute malformed coalesced TX decode failure to the bad message after processing its valid prefix; do not blame resource/runtime exceptions on that peer.
---
 src/net_processing.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index e33365818a..30970f586b 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -8535,7 +8535,13 @@ bool PeerManagerImpl::ProcessMessages(const Config &config, CNode *pfrom,
                     CTransactionRef ptx;
                     try {
                         next_msg.m_recv >> ptx;
+                    } catch (const std::ios_base::failure &) {
+                        ProcessTxBatch(*pfrom, *peer, tx_batch);
+                        Misbehaving(*peer, "malformed coalesced TX message");
+                        throw;
                     } catch (...) {
+                        // Resource/runtime failures must not discard the
+                        // already decoded prefix or blame valid messages.
                         ProcessTxBatch(*pfrom, *peer, tx_batch);
                         throw;
                     }
