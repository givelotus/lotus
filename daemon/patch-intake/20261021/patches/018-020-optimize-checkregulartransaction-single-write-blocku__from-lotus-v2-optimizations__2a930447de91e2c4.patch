+    secp256k1_scalar_clear(&g_sc);
+    for (i = 0; i < n_sigs; i++) {
+        secp256k1_scalar s;
+        secp256k1_scalar z;
+        int overflow = 0;
+        if (sig64[i] == NULL || msghash32[i] == NULL || pubkey[i] == NULL) {
