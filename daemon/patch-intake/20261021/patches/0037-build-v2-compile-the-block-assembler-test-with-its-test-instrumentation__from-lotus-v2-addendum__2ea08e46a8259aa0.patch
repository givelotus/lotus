From 5c5ca59488b02be153e5971abaad193c87c53a08 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 17:01:59 -0700
Subject: [PATCH] build(v2): compile the block assembler test with its test
 instrumentation

test_block_assembler.cpp calls SetLocalBlockBuildTestHook, which
block_assembler.{h,cpp} declare and define only under
LOTUS_V2_BLOCK_ASSEMBLER_TEST_INSTRUMENTATION. The standalone
block_assembler_test/CMakeLists.txt defines it, but the in-tree
test_lotus_v2_block_assembler target did not, so `all` failed to compile.

Follow the existing test_lotus_v2_vm pattern: the test target compiles
its own instrumented copy of block_assembler.cpp, with the definition
private to that target. lotus_v2_validation, the daemon and every other
target keep the uninstrumented object.

Tier: V2 (fixup to v2/024 build(v2): register standalone storage and
runtime libraries)
---
 src/lotus_v2/CMakeLists.txt | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index 6ace56d38a..e5ecaadd86 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -280,7 +280,8 @@ add_custom_target(check-lotus-v2-block-preview
     COMMAND $<TARGET_FILE:test_lotus_v2_block_preview>
     DEPENDS test_lotus_v2_block_preview)
 
-add_executable(test_lotus_v2_block_assembler test_block_assembler.cpp)
+add_executable(test_lotus_v2_block_assembler test_block_assembler.cpp block_assembler.cpp)
+target_compile_definitions(test_lotus_v2_block_assembler PRIVATE LOTUS_V2_BLOCK_ASSEMBLER_TEST_INSTRUMENTATION)
 target_link_libraries(test_lotus_v2_block_assembler PRIVATE lotus_v2_development_runtime)
 add_custom_target(check-lotus-v2-block-assembler
     COMMAND $<TARGET_FILE:test_lotus_v2_block_assembler>
