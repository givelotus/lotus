From 309d106bf84281ebee5647e41d7d1e5af61b3734 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:31:16 -0700
Subject: [PATCH 14/15] mempool(v2): compute BIP68 lock points for v7
 transactions

CalculateLockPointsAtTip and CalculateLockPointsFromResolvedCoins
returned empty lock points for every v7 transaction, on the assumption
that V2 inputs always carry SEQUENCE_FINAL. The v7 decoder accepts
relative-lock sequences (delay in the low 16 bits, 0x400000 for time),
and ConnectBlock's SequenceLocks enforces them for every version >= 2.
The mempool could therefore accept, relay and offer for mining a
transaction that every block containing it would fail.

Both shortcuts are removed, so mempool lock points come from the same
CalculateSequenceLocks as block validation. v2_finality_tests checks
the lock points and CheckSequenceLocksAtTip of a v7 spend with a
10-block relative lock before and at its maturity; it fails before this
change.

Tier: V2 (fixup to v2/032)
---
 src/test/v2_finality_tests.cpp | 32 ++++++++++++++++++++++++++++++++
 src/validation.cpp             | 12 ------------
 2 files changed, 32 insertions(+), 12 deletions(-)

diff --git a/src/test/v2_finality_tests.cpp b/src/test/v2_finality_tests.cpp
index 604295229a..1ecdf427bb 100644
--- a/src/test/v2_finality_tests.cpp
+++ b/src/test/v2_finality_tests.cpp
@@ -4,7 +4,10 @@
 
 #include <chainparams.h>
 #include <consensus/tx_verify.h>
+#include <coins.h>
 #include <consensus/validation.h>
+#include <chain.h>
+#include <validation.h>
 #include <primitives/transaction.h>
 
 #include <test/util/setup_common.h>
@@ -82,4 +85,33 @@ BOOST_AUTO_TEST_CASE(v7_lock_reached_value_and_sequences) {
     BOOST_CHECK(!IsNonFinal(V7WithLock(0, 0), 0, 0));
 }
 
+// A v7 input sequence is a BIP68 relative lock, which ConnectBlock enforces.
+// The mempool must compute the same lock points instead of assuming final
+// sequences, or it accepts a transaction no block may contain.
+BOOST_AUTO_TEST_CASE(v7_relative_lock_points_at_tip) {
+    constexpr int COIN_HEIGHT = 50;
+    constexpr uint32_t DELAY = 10;
+    const CTransaction tx = V7WithLock(0, DELAY);
+
+    CCoinsView base;
+    CCoinsViewCache view(&base);
+    view.AddCoin(tx.vin[0].prevout,
+                 Coin(CTxOut(1000 * SATOSHI, CScript() << OP_TRUE),
+                      COIN_HEIGHT, false),
+                 false);
+
+    for (const int tip_height : {COIN_HEIGHT + 5, COIN_HEIGHT + int(DELAY)}) {
+        CBlockIndex tip;
+        tip.nHeight = tip_height;
+        const auto lock_points = CalculateLockPointsAtTip(&tip, view, tx);
+        BOOST_REQUIRE(lock_points.has_value());
+        BOOST_CHECK_EQUAL(lock_points->height,
+                          COIN_HEIGHT + int(DELAY) - 1);
+        // The next block (tip + 1) may hold the spend once DELAY blocks
+        // have passed since the coin's block.
+        BOOST_CHECK_EQUAL(CheckSequenceLocksAtTip(&tip, *lock_points),
+                          tip_height + 1 >= COIN_HEIGHT + int(DELAY));
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/validation.cpp b/src/validation.cpp
index 84c33f9646..8850cc948f 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -192,14 +192,6 @@ std::optional<LockPoints> CalculateLockPointsAtTip(CBlockIndex *tip,
                                                    const CCoinsView &coins_view,
                                                    const CTransaction &tx) {
     assert(tip);
-    if (tx.nVersion == CTransaction::CURRENT_VERSION && !tx.vin.empty() &&
-        (tx.vin[0].nFlags == 1 || tx.vin[0].nFlags == 3)) {
-        // Pure V2 transactions always set nSequence = SEQUENCE_FINAL
-        // (SEQUENCE_LOCKTIME_DISABLE_FLAG set), so BIP68 relative lock points
-        // are always {-1, -1} without deep-copying input Coins from coins_view.
-        return LockPoints{};
-    }
-
     auto prev_heights{CalculatePrevHeights(*tip, coins_view, tx)};
     if (!prev_heights.has_value()) {
         return std::nullopt;
@@ -656,10 +648,6 @@ std::optional<LockPoints> CalculateLockPointsFromResolvedCoins(
     CBlockIndex *tip, const CTransaction &tx,
     const std::vector<Coin> &resolved_inputs) {
     assert(tip);
-    if (tx.nVersion == CTransaction::CURRENT_VERSION && !tx.vin.empty() &&
-        (tx.vin[0].nFlags == 1 || tx.vin[0].nFlags == 3)) {
-        return LockPoints{};
-    }
     std::vector<int> prev_heights(tx.vin.size());
     for (size_t i = 0; i < tx.vin.size(); ++i) {
         if (tx.vin[i].nFlags == 3) {
