From 32074a40feb51c6cccc96fafda1ac05db6127ec1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:01:18 -0700
Subject: [PATCH 02/30] test: don't treat the standalone loopback stress script
 as a test

lotus_v2_loopback_tps_stress.py is a benchmark run by hand. test_runner.py
treated it as a functional test, and its name follows no test naming
convention, so check_script_prefixes() found 14 badly named tests where it
allows 13 and aborted every run before starting a test. List it with the
other non-test scripts.
---
 test/functional/test_runner.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/test/functional/test_runner.py b/test/functional/test_runner.py
index 96d212dc412782211117e2881c5402816b980626..665d38aae2c3ab448873a354069d8e2d15e2ae30 100755
--- a/test/functional/test_runner.py
+++ b/test/functional/test_runner.py
@@ -94,6 +94,8 @@ NON_TESTS = {
     # are not test scripts.
     "combine_logs.py",
     "create_cache.py",
+    # A standalone benchmark script, run by hand
+    "lotus_v2_loopback_tps_stress.py",
     "test_runner.py",
 }
 
