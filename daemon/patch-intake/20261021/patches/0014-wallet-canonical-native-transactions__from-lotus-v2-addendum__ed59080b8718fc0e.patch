-CTransactionRef CWallet::WithV2OutputScripts(const CTransactionRef &tx) const {
+CScript CWallet::GetScriptForOutput(const CTxOut &out) const {
     AssertLockHeld(cs_wallet);
-    std::optional<CMutableTransaction> restored;
-    for (size_t i = 0; i < tx->vout.size(); ++i) {
-        const CTxOut &out = tx->vout[i];
-        // The synthetic wire script of a plain single-branch output:
-        // flags 0, value, one branch, one path {0} (see CTxOut::FromV2Output).
-        const CScript &spk = out.scriptPubKey;
-        if (out.vBranches.size() != 1 || spk.size() != 45 || spk[0] != 0x00 ||
-            spk[9] != 0x01 || spk[42] != 0x01 || spk[43] != 0x01 ||
-            spk[44] != 0x00 ||
-            !std::equal(out.vBranches[0].begin(), out.vBranches[0].end(),
-                        spk.begin() + 10)) {
-            continue;
-        }
-        uint256 branch;
-        std::copy(out.vBranches[0].begin(), out.vBranches[0].end(),
-                  branch.begin());
-        for (const auto &spk_man_pair : m_spk_managers) {
-            if (auto script =
-                    spk_man_pair.second->GetScriptForV2Branch(branch)) {
-                if (!restored) {
-                    restored.emplace(*tx);
-                }
-                restored->vout[i].scriptPubKey = std::move(*script);
-                break;
-            }
+    // Resolve only a known plain native branch for wallet ownership/address
+    // queries. The transaction and its canonical output bytes stay immutable.
+    if (out.IsLegacy() || out.nFlags != 0 || out.vBranches.size() != 1 ||
+        out.vPaths.size() != 1 || out.vPaths[0].size() != 1 ||
+        out.vPaths[0][0] != 0) {
+        return out.scriptPubKey;
+    }
+    uint256 branch;
+    std::copy(out.vBranches[0].begin(), out.vBranches[0].end(), branch.begin());
+    for (const auto &spk_man_pair : m_spk_managers) {
+        if (auto script = spk_man_pair.second->GetScriptForV2Branch(branch)) {
+            return std::move(*script);
         }
     }
-    if (!restored) {
-        return tx;
-    }
-    CTransactionRef result = MakeTransactionRef(std::move(*restored));
-    // The script is not part of the V2 wire or identity, so this cannot
-    // change; never substitute a different transaction if it somehow did.
-    if (result->GetId() != tx->GetId() || result->GetHash() != tx->GetHash()) {
-        return tx;
-    }
-    return result;
+    return out.scriptPubKey;
 }
 
