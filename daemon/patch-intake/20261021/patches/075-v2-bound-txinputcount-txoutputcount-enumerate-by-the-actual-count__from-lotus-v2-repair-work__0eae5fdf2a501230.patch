From 5e2e82a8c1818efee295aa5f04ff57f6f8406d1a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 04:46:04 -0700
Subject: [PATCH] v2: bound TXINPUTCOUNT/TXOUTPUTCOUNT ENUMERATE by the actual
 count

With the fused 67/68 loop headers retired, a loop over inputs or
outputs is written `TXINPUTCOUNT ENUMERATE ... ENDENUMERATE` (or with
TXOUTPUTCOUNT). The size pass only knew literal bounds, so it charged
such a loop at 256 iterations (65,536 when nested), a large regression
from the fused headers, which were charged at the exact count (I-7).

Decision (2026-10-19): when the instruction immediately before
ENUMERATE in the same sequence is TXINPUTCOUNT or TXOUTPUTCOUNT, the
static bound is min(256, count), taken from the counts the invocation
is charged with (the transaction's own counts with a context).
Otherwise a literal bound is used, otherwise 256. Execution is
unchanged: the popped bound must be 0..256, which the 256 input/output
cap now guarantees for real transactions.

Tests: at 0, 1, 2, 255 and 256 inputs the idiom charges exactly what a
one-byte constant bound charges, 16 less than a 16-byte literal, the
old fused-header charge plus 34, and equals its executed cost; 257 is
charged as 256 and errors at run time; the nested input/output idiom
equals nested constants; an instruction between the count and
ENUMERATE loses the precision; three nested loops never decode.

Tier: V2
---
 src/lotus_v2/test_vm.cpp | 59 ++++++++++++++++++++++++++++++++++++++++
 src/lotus_v2/vm_cost.inc | 23 ++++++++++++----
 2 files changed, 76 insertions(+), 6 deletions(-)

diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index 1c5c2085378615cbddeed759f36c6f513a4cef46..2317c9f639be500f49d7f8c2a8124c357c6899b2 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -611,6 +611,64 @@ void ChargedAccounting() {
     CHECK(!rejected_profile.charged &&
           rejected_profile.invocation.error == "invalid explicit VM profile");
 }
+// `TXINPUTCOUNT|TXOUTPUTCOUNT ENUMERATE` is the only input/output loop. Its
+// static bound is min(256, count), so it charges exactly what a literal bound
+// of the same count charges (the old fused 67/68 charge plus the count push
+// and ENUMERATE's operand).
+void EnumerateIdiom() {
+    auto schedule = IllustrativeCost();
+    auto charge = [&](const std::string &script, uint16_t inputs,
+                      uint16_t outputs = 0) {
+        return EvaluateVmCharged(Hex(script), {}, PROFILE, schedule, inputs,
+                                 outputs);
+    };
+    auto literal = [](unsigned n) {
+        VmBytes push(16);
+        push[0] = uint8_t(n);
+        push[1] = uint8_t(n >> 8);
+        std::string hex = "10";
+        const char *digits = "0123456789abcdef";
+        for (auto b : push) {
+            hex.push_back(digits[b >> 4]);
+            hex.push_back(digits[b & 15]);
+        }
+        return hex;
+    };
+    for (unsigned count : {0u, 1u, 2u, 255u, 256u}) {
+        const auto idiom = charge("c969794e796a4e", uint16_t(count));
+        CHECK(idiom.charged && idiom.invocation.status == VmStatus::Success);
+        // A one-byte constant costs what TXINPUTCOUNT costs.
+        if (count <= 16) {
+            VmBytes script = Hex("69794e796a4e");
+            script.insert(script.begin(), uint8_t(count ? 0x4d + count : 0));
+            const auto constant =
+                EvaluateVmCharged(script, {}, PROFILE, schedule, 0, 0);
+            CHECK(constant.accounting_cost == idiom.accounting_cost);
+        }
+        // A 16-byte literal push differs only by its 16 extra script bytes.
+        const auto pushed = charge(literal(count) + "69794e796a4e", 0);
+        CHECK(pushed.accounting_cost == idiom.accounting_cost + 16);
+        // Executed cost equals the static bound for this straight body.
+        CHECK(idiom.invocation.executed_cost == idiom.accounting_cost);
+    }
+    CHECK(charge("c969794e796a4e", 1).accounting_cost == 76 + 34);
+    // The static bound saturates at 256; at runtime 257 is out of range.
+    const auto over = charge("c969794e796a4e", 257);
+    CHECK(over.charged &&
+          over.accounting_cost == charge("c969794e796a4e", 256).accounting_cost &&
+          over.invocation.status == VmStatus::Invalid &&
+          over.invocation.error == "loop bound");
+    // Output idiom and nesting: both bounds come from the transaction.
+    const auto nested = charge("c969ca69796a796a4e", 3, 4);
+    const auto nested_constant = charge("5069 5169 796a796a4e", 0, 0);
+    CHECK(nested.invocation.status == VmStatus::Success &&
+          nested.accounting_cost == nested_constant.accounting_cost);
+    // Only the instruction immediately before ENUMERATE counts.
+    const auto separated = charge("c960 69794e796a4e", 1);
+    CHECK(separated.accounting_cost > charge("c969794e796a4e", 256).accounting_cost);
+    // Three nested loops never decode, whatever their bounds.
+    Expect("c969c969c9696a6a6a4e", VmStatus::Invalid, {}, PROFILE, 1);
+}
 void AuthenticatedPayment() {
     const auto wire =
         Hex("07000000000000000000000001000100"
@@ -1222,6 +1280,7 @@ int main() {
     ContextFieldOpcodes();
     HashAndBounds();
     ChargedAccounting();
+    EnumerateIdiom();
     AuthenticatedPayment();
     AuthenticatedFieldSizeHints();
     PreparedTransactionOwnership();
diff --git a/src/lotus_v2/vm_cost.inc b/src/lotus_v2/vm_cost.inc
index e948812f74b0656ff137f87f0b7ef2063171f88c..dc33c29629f54744c99d49b5d44634e856083cfc 100644
--- a/src/lotus_v2/vm_cost.inc
+++ b/src/lotus_v2/vm_cost.inc
@@ -212,8 +212,8 @@ class SizePass {
     const VmCostProfile &schedule;
     const PreparedVmTransaction *prepared;
     size_t script_length;
-    [[maybe_unused]] uint16_t input_count;
-    [[maybe_unused]] uint16_t output_count;
+    uint16_t input_count;
+    uint16_t output_count;
     size_t limit;
     VmCostUnits Worst(VmOpcode op) const {
         VmCostUnits cost = WorstOpCost(op, limit, schedule);
@@ -647,10 +647,7 @@ class SizePass {
                     for (auto &exit_state : body.exits)
                         if (exit_state) exit_state = UnknownSizes();
                 }
-                const auto lit = LiteralValue(previous);
-                const size_t bound = (lit && *lit >= 0 && *lit <= 256)
-                                         ? static_cast<size_t>(*lit)
-                                         : 256;
+                const size_t bound = LoopBound(previous);
                 const std::array<size_t, 1> loop_operand{16};
                 part = OpCost(op, loop_operand, {}, schedule);
                 VmCostUnits iter = CostAdd(OpCost(0x6a, {}, {}, schedule),
@@ -715,6 +712,20 @@ class SizePass {
         return out;
     }
 
+    // Static iteration bound of ENUMERATE. `TXINPUTCOUNT ENUMERATE` and
+    // `TXOUTPUTCOUNT ENUMERATE` (the count opcode immediately before, in the
+    // same sequence) are bounded by min(256, count), keeping the precision of
+    // the retired fused loop headers (I-7). Otherwise a literal bound is
+    // used, and failing that the maximum 256.
+    size_t LoopBound(const Instruction *previous) const {
+        if (previous && previous->op == 0xc9)
+            return std::min<size_t>(256, input_count);
+        if (previous && previous->op == 0xca)
+            return std::min<size_t>(256, output_count);
+        const auto lit = LiteralValue(previous);
+        return lit && *lit >= 0 && *lit <= 256 ? size_t(*lit) : 256;
+    }
+
 public:
     SizePass(const std::vector<Instruction> &code, const VmProfile &vm,
              const VmCostProfile &schedule, size_t script_length,
-- 
