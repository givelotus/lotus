Subject: [PATCH] fixup! [v2 only] bench: add production-transport multi-peer
 P2P load client

---
 src/bench/p2p_load.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/bench/p2p_load.cpp b/src/bench/p2p_load.cpp
index a74057b99c..4c8cec0c09 100644
--- a/src/bench/p2p_load.cpp
+++ b/src/bench/p2p_load.cpp
@@ -53,6 +53,9 @@ int main(int argc, char **argv) {
             throw std::runtime_error(
                 "usage: p2p-load URL PEERS THREADS SECONDS BLOCK_HASH_FILE "
                 "READY_FILE JSON_OUTPUT");
+        LogInstance().m_print_to_console = true;
+        LogInstance().EnableCategory(BCLog::NET);
+        LogInstance().StartLogging();
         SelectParams(ChainType::REGTEST);
         GlobalConfig cfg;
         cfg.SetMaxBlockSize(128000000);
@@ -147,7 +150,9 @@ int main(int argc, char **argv) {
                             if (n < 0) {
                                 if (errno == EAGAIN || errno == EWOULDBLOCK)
                                     continue;
-                                throw std::runtime_error("receive failed");
+                                throw std::runtime_error(
+                                    "receive failed peer " + std::to_string(i) +
+                                    ": " + std::strerror(errno));
                             }
                             Span<const uint8_t> bytes{buf.data(), size_t(n)};
                             while (!bytes.empty()) {
