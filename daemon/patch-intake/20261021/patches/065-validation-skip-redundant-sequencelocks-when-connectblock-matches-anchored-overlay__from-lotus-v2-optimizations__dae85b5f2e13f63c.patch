From 7da659a8579989b1dc2a4589368c773200d6f5ee Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:54:33 -0700
Subject: [PATCH] validation: skip redundant SequenceLocks when ConnectBlock
 matches anchored overlay

Original-Commit: 8ea9ea122afe671861234ea2a529f13fcccc8777
Original-Patch: ecash/052
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/kernel/mempool_entry.h |  6 ++++++
 src/validation.cpp         | 29 ++++++++++++++++++++++-------
 2 files changed, 28 insertions(+), 7 deletions(-)

diff --git a/src/kernel/mempool_entry.h b/src/kernel/mempool_entry.h
index a5fc593b32..e72ee20aac 100644
--- a/src/kernel/mempool_entry.h
+++ b/src/kernel/mempool_entry.h
@@ -19,6 +19,8 @@
 #include <memory>
 #include <set>
 
+class CBlockIndex;
+
 struct LockPoints {
     // Will be set to the blockchain height and median time past values that
     // would be necessary to satisfy all relative locktime constraints (BIP68)
@@ -96,6 +98,7 @@ private:
     Amount m_modified_fee{Amount::zero()};
     //! Track the height and time at which tx was final
     LockPoints lockPoints;
+    const CBlockIndex *m_sequence_validation_tip{nullptr};
 
     IMPLEMENT_RCU_REFCOUNT(uint64_t);
 
@@ -116,6 +119,7 @@ public:
           nTime(other.nTime), entryHeight(other.entryHeight),
           sigChecks(other.sigChecks), m_modified_fee(other.m_modified_fee),
           lockPoints(std::move(other.lockPoints)),
+          m_sequence_validation_tip(other.m_sequence_validation_tip),
           refcount(other.refcount.load()) {};
 
     uint64_t GetEntryId() const { return entryId; }
@@ -141,6 +145,8 @@ public:
     }
     size_t DynamicMemoryUsage() const { return nUsageSize; }
     const LockPoints &GetLockPoints() const { return lockPoints; }
+    const CBlockIndex *GetSequenceValidationTip() const { return m_sequence_validation_tip; }
+    void SetSequenceValidationTip(const CBlockIndex *tip) { m_sequence_validation_tip = tip; }
 
     // Updates the modified fees used for mining priority score
     void UpdateModifiedFee(Amount fee_diff) {
diff --git a/src/validation.cpp b/src/validation.cpp
index f0502b5b3f..81a8d29e52 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -1296,6 +1296,7 @@ bool MemPoolAccept::Finalize(const ATMPArgs &args, Workspace &ws,
     // Store transaction in memory
     CTxMemPoolEntry *pentry = ws.m_entry.release();
     auto entry = CTxMemPoolEntryRef::acquire(pentry);
+    entry->SetSequenceValidationTip(m_active_chainstate.m_chain.Tip());
     const auto newit = m_pool.addUnchecked(entry, !ws.m_inputs_pre_resolved,
                                          batch_parent_iters);
     if (out_iter) *out_iter = newit;
@@ -3357,6 +3358,7 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
     };
     std::vector<PendingBlockTxCheck> pending_script_txs;
     std::vector<int> prevalidated_overlay_sigchecks;
+    bool prevalidated_sequence_locks = false;
     if (!fJustCheck && fScriptChecks && m_mempool && block.vtx.size() > 1 &&
         pindex->pprev != nullptr && pindex->pprev->pprev != nullptr &&
         GetNextBlockScriptFlags(pindex->pprev, m_chainman) ==
@@ -3371,6 +3373,7 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
                 sigchecks.reserve(ordered.size());
                 size_t idx = 1;
                 bool all_match = true;
+                bool all_sequence_validated = true;
                 for (const auto &[_, oentry] : ordered) {
                     if (block.vtx[idx].get() != oentry.tx_ref.get() ||
                         oentry.sigchecks < 0) {
@@ -3388,11 +3391,14 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
                         all_match = false;
                         break;
                     }
+                    all_sequence_validated &=
+                        (*entry)->GetSequenceValidationTip() == pindex->pprev;
                     sigchecks.push_back(int(oentry.sigchecks));
                     ++idx;
                 }
                 if (all_match) {
                     prevalidated_overlay_sigchecks = std::move(sigchecks);
+                    prevalidated_sequence_locks = all_sequence_validated;
                 }
             }
         }
@@ -3422,9 +3428,12 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         // the spent Coin into blockundo.vtxundo[txIndex].vprevout for
         // CheckTxInputsFromSpentCoins, BIP68 prevheights, and Pass 2 parallel
         // script verification.
+        const bool need_sequence_locks = !prevalidated_sequence_locks;
         CTxUndo &txundo = blockundo.vtxundo.at(txIndex);
         txundo.vprevout.resize(tx.vin.size());
-        prevheights.resize(tx.vin.size());
+        if (need_sequence_locks) {
+            prevheights.resize(tx.vin.size());
+        }
         bool inputs_ok = true;
         for (size_t j = 0; j < tx.vin.size(); j++) {
             if (!view.SpendCoin(tx.vin[j].prevout, &txundo.vprevout[j])) {
@@ -3436,10 +3445,13 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
                 inputs_ok = false;
                 break;
             }
-            prevheights[j] =
-                (tx.vin[j].nSequence & CTxIn::SEQUENCE_LOCKTIME_DISABLE_FLAG)
-                    ? 0
-                    : txundo.vprevout[j].GetHeight();
+            if (need_sequence_locks) {
+                prevheights[j] =
+                    (tx.vin[j].nSequence &
+                     CTxIn::SEQUENCE_LOCKTIME_DISABLE_FLAG)
+                        ? 0
+                        : txundo.vprevout[j].GetHeight();
+            }
         }
         if (!inputs_ok) {
             break;
@@ -3470,8 +3482,11 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
 
         // Check that transaction is BIP68 final. BIP68 lock checks (as
         // opposed to nLockTime checks) must be in ConnectBlock because they
-        // require the UTXO set.
-        if (!SequenceLocks(tx, nLockTimeFlags, prevheights, *pindex)) {
+        // require the UTXO set. When all block transactions match the
+        // prevalidated mempool overlay, BIP68 sequence locks were already
+        // verified against the same chain tip.
+        if (need_sequence_locks &&
+            !SequenceLocks(tx, nLockTimeFlags, prevheights, *pindex)) {
             state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
                           "bad-txns-nonfinal",
                           "contains a non-BIP68-final transaction " +
