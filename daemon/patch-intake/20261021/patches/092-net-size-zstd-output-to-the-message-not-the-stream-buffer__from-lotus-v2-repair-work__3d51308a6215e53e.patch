From d4a263e0463ab4ff1e8d986e11ace2d18969af4a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 21:05:41 -0700
Subject: [PATCH] net: size zstd output to the message, not the stream buffer

CompressFrame resized its output to ZSTD_CStreamOutSize() (128 KiB) plus
the bound for every message. Resizing zero-fills, so each small P2P
message paid for 128 KiB of memset: 1.1 us per 32-250 byte message, now
0.5 us. The loop still grows the buffer if zstd reports more pending.
---
 src/net_zstd_dict.h | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/net_zstd_dict.h b/src/net_zstd_dict.h
index c313c838c14280399a4ace4df725fe0929953e24..1456f94a7097edafc6e83c7a478431acf538efd9 100644
--- a/src/net_zstd_dict.h
+++ b/src/net_zstd_dict.h
@@ -93,9 +93,14 @@ public:
         const size_t start{out.size()};
         size_t written{0};
         while (true) {
-            if (out.size() - start - written < ZSTD_CStreamOutSize()) {
-                out.resize(start + written + ZSTD_CStreamOutSize() +
-                           ZSTD_compressBound(input.size - input.pos));
+            // Room for the rest of the input plus the flush, growing only if
+            // zstd reports more pending. Sized to the message, not to
+            // ZSTD_CStreamOutSize(): resizing zero-fills, and 128 KiB of it
+            // per small message dominated the cost.
+            const size_t want{ZSTD_compressBound(input.size - input.pos) +
+                              FLUSH_SLACK};
+            if (out.size() - start - written < want) {
+                out.resize(start + written + want);
             }
             ZSTD_outBuffer output{out.data() + start, out.size() - start,
                                   written};
@@ -141,6 +146,9 @@ public:
     }
 
 private:
+    //! Extra output room for the block headers of a flush
+    static constexpr size_t FLUSH_SLACK = 32;
+
     static size_t Check(size_t ret) {
         if (ZSTD_isError(ret)) {
             throw std::runtime_error(ZSTD_getErrorName(ret));
