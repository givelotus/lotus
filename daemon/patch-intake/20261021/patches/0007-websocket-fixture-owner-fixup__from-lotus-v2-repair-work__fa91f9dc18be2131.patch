From b2c08f5c005066bde5aa5960a3803e3ebe21eeb1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 07:32:36 -0700
Subject: [PATCH] fixup! v2: swap CBlockHeader and block index to 134-byte V2
 header and BLAKE3 BlockId

Adapt the shared compress-once WebSocket block-message fixture to the native CBlockHeader timestamp API. The header swap removes nTime and provides SetBlockTime; preserve the same randomized 32-bit timestamp, nonce, payload bytes, socket workloads and every assertion. Actual normal native ChronikON/walletON test TU fails before this consumer adaptation.
---
 src/test/net_websocket_tests.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/test/net_websocket_tests.cpp b/src/test/net_websocket_tests.cpp
index 6c1b7d95e2..7256a44e4d 100644
--- a/src/test/net_websocket_tests.cpp
+++ b/src/test/net_websocket_tests.cpp
@@ -1060,7 +1060,7 @@ P2PMessage MakeBlockMessage(FastRandomContext &rng, size_t size) {
     std::vector<uint8_t> payload;
     CBlockHeader header;
     header.nNonce = rng.rand32();
-    header.nTime = rng.rand32();
+    header.SetBlockTime(rng.rand32());
     VectorWriter{payload, 0, header};
     auto body{rng.randbytes<uint8_t>(size)};
     // Like transactions: random hashes and keys between repeated structure.
