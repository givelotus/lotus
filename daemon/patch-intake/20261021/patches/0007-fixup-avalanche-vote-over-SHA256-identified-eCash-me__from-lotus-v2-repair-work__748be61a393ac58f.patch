From 45fc417ba42687dae44c63b5c0e6a250c322e34d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 11:23:08 -0700
Subject: [PATCH] fixup! avalanche: vote over SHA256-identified eCash mempool
 batches

---
 test/functional/abc_p2p_avalanche_voting.py    | 3 +++
 test/functional/chronik_electrum_blockchain.py | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/test/functional/abc_p2p_avalanche_voting.py b/test/functional/abc_p2p_avalanche_voting.py
index 6648644f57..31eddcd16e 100644
--- a/test/functional/abc_p2p_avalanche_voting.py
+++ b/test/functional/abc_p2p_avalanche_voting.py
@@ -41,6 +41,9 @@ class AvalancheTest(BitcoinTestFramework):
                 "-avaminquorumstake=0",
                 "-avaminavaproofsnodecount=0",
                 "-persistavapeers=0",
+                # Observe voted/manual parking until this test explicitly
+                # accepts or unparks the block, without work-based retries.
+                "-automaticunparking=0",
                 "-avalanchestakingpreconsensus=0",
             ],
             [
diff --git a/test/functional/chronik_electrum_blockchain.py b/test/functional/chronik_electrum_blockchain.py
index a7cd5dad30..1713cdf707 100644
--- a/test/functional/chronik_electrum_blockchain.py
+++ b/test/functional/chronik_electrum_blockchain.py
@@ -62,6 +62,9 @@ class ChronikElectrumBlockchain(BitcoinTestFramework):
         self.extra_args = [
             [
                 "-chronik",
+                # Manual disconnect/reconnect notification tests control the
+                # park lifetime explicitly.
+                "-automaticunparking=0",
                 f"-chronikelectrumbind=127.0.0.1:{chronikelectrum_port(0)}:t",
             ]
         ]
