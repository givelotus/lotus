+        const lotus::v2::Hash root = ComputeSubtreeAHash(out_txs);
+        std::memcpy(out_root.begin(), root.data(), 32);
+        return;
     }
-    return {};
+    out_txs.clear();
+    const lotus::v2::Hash empty_root = lotus::v2::EmptyTxRoot();
+    std::memcpy(out_root.begin(), empty_root.data(), 32);
+}
