From f81552a9d46e2103205cf2f2d18e89a7054c858f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:42:28 -0700
Subject: [PATCH] rpc(v2): report fast-sync state in getblockchaininfo

p2p_v2_fast_sync_and_reverse_peel (v2/038) reads fast_sync_active and
earliest_verified_height from getblockchaininfo, before and after
installing a fast-sync pivot, and rpc_blockchain (v2/041) lists both
among getblockchaininfo's keys. The node never returned them: only
getfastsyncinfo, setfastsyncpivot and peelblocks did. Both tests
failed, with a KeyError and a key-list mismatch.

The chain snapshot that getblockchaininfo reads (ecash/017) already
records both values, so getblockchaininfo now returns them and
documents them. The eCash tier is unchanged: its getblockchaininfo and
rpc_blockchain do not include these keys.

p2p_v2_fast_sync_and_reverse_peel now passes, including the check that
getblockchaininfo reports fast_sync_active=true and
earliest_verified_height=104 right after setfastsyncpivot.
rpc_blockchain gets past the key check and now stops at
bad-txns-non-v7-format (MiniWallet legacy transactions).

Tier: V2 (fixup to v2/038)
---
 src/rpc/blockchain.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/rpc/blockchain.cpp b/src/rpc/blockchain.cpp
index fd8a4ccb75..67648b6616 100644
--- a/src/rpc/blockchain.cpp
+++ b/src/rpc/blockchain.cpp
@@ -1548,6 +1548,12 @@ RPCHelpMan getblockchaininfo() {
                 {RPCResult::Type::NUM, "prune_target_size",
                  "the target size used by pruning (only present if automatic "
                  "pruning is enabled)"},
+                {RPCResult::Type::BOOL, "fast_sync_active",
+                 "whether the active chainstate was installed from a fast-sync "
+                 "UTXO snapshot whose history is not yet fully verified"},
+                {RPCResult::Type::NUM, "earliest_verified_height",
+                 "lowest height from which the active chain's blocks have been "
+                 "verified (0 unless fast sync is active)"},
                 {RPCResult::Type::STR, "warnings",
                  "any network and blockchain warnings"},
             }},
@@ -1585,6 +1591,9 @@ RPCHelpMan getblockchaininfo() {
                 }
             }
 
+            obj.pushKV("fast_sync_active", snap.fast_sync_active);
+            obj.pushKV("earliest_verified_height",
+                       snap.earliest_verified_height);
             obj.pushKV("warnings", GetWarnings(false).original);
             return obj;
         },
