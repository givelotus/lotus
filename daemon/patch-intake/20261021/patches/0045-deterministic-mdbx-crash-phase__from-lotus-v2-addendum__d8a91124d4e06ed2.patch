From 971e2a43689e5dbd601175893a71651b33aa1728 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:35:47 -0700
Subject: [PATCH] fixup! db: migrate the daemon database wrapper to MDBX

Make the real ConnectBlock SIGKILL phase deterministic with a hidden exact-height regtest-only pause and synchronously flushed marker. Reject non-regtest, nonpositive and overflowing heights at startup. Preserve all five cycles of 2000 transactions, external SIGKILL, recovery and continued-mining assertions. Original timing heuristic fails after all recovery cycles in10.6s; exactheight after passes13.6s and all five startup safety guards pass.

Tier: eCash (fixup to db: migrate the daemon database wrapper to MDBX)
---
 src/init.cpp                          | 10 ++++++++++
 src/validation.cpp                    | 14 ++++++++++++++
 test/functional/feature_mdbx_crash.py | 23 ++++++++++++++++++-----
 3 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/src/init.cpp b/src/init.cpp
index 327d7d2c76..2fae7a80e0 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -113,6 +113,7 @@
 #include <cstdio>
 #include <fstream>
 #include <functional>
+#include <limits>
 #include <set>
 #include <string>
 #include <thread>
@@ -492,6 +493,7 @@ void SetupServerArgs(NodeContext &node) {
     // Hidden Options
     std::vector<std::string> hidden_args = {
         "-dbcrashratio",
+        "-testblockconnectpauseheight",
         "-forcecompactdb",
         "-maxaddrtosend",
         "-parkdeepreorg",
@@ -2216,6 +2218,14 @@ bool AppInitParameterInteraction(Config &config, const ArgsManager &args) {
     // specified in default section of config file, but not overridden
     // on the command line or in this chain's section of the config file.
     ChainType chain = args.GetChainType();
+    if (args.IsArgSet("-testblockconnectpauseheight") &&
+        (chain != ChainType::REGTEST ||
+         args.GetIntArg("-testblockconnectpauseheight", 0) <= 0 ||
+         args.GetIntArg("-testblockconnectpauseheight", 0) >
+             std::numeric_limits<int>::max())) {
+        return InitError(Untranslated(
+            "-testblockconnectpauseheight requires regtest and a positive block height."));
+    }
     bilingual_str errors;
     for (const auto &arg : args.GetUnsuitableSectionOnlyArgs()) {
         errors +=
diff --git a/src/validation.cpp b/src/validation.cpp
index 0474a6ce16..ce43ae06c3 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4635,6 +4635,20 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
              Ticks<MillisecondsDouble>(m_chainman.time_forks) /
                  m_chainman.num_blocks_total);
 
+    // Deterministic process-crash coverage pauses inside the real connection,
+    // rather than inferring an in-flight operation from asynchronous logs.
+    // Parameter interaction rejects this hidden option outside regtest.
+    if (!fJustCheck && params.GetChainType() == ChainType::REGTEST &&
+        gArgs.GetIntArg("-testblockconnectpauseheight", -1) == pindex->nHeight) {
+        LogInfo("Pausing block connection at test height %d\n",
+                pindex->nHeight);
+        LogInstance().Flush();
+        while (!m_chainman.m_interrupt) {
+            std::this_thread::sleep_for(std::chrono::milliseconds{1});
+        }
+        return state.Error("Block connection interrupted during test pause");
+    }
+
     std::vector<int> prevheights;
     Amount nFees = Amount::zero();
     int nInputs = 0;
diff --git a/test/functional/feature_mdbx_crash.py b/test/functional/feature_mdbx_crash.py
index 051233ddc0..cd9dad5840 100644
--- a/test/functional/feature_mdbx_crash.py
+++ b/test/functional/feature_mdbx_crash.py
@@ -99,6 +99,16 @@ class MdbxCrashTest(BitcoinTestFramework):
             connect_start = time.monotonic()
             assert_equal(control.submitblock(raw), None)
             connect_seconds = time.monotonic() - connect_start
+            # Pause at an exact future height inside ConnectBlock. A log
+            # marker alone is otherwise racy with the asynchronous logger.
+            crash_height = source.getblockcount()
+            self.restart_node(
+                1,
+                extra_args=[
+                    *self.extra_args[1],
+                    f"-testblockconnectpauseheight={crash_height}",
+                ],
+            )
             started = threading.Event()
             errors = []
 
@@ -118,13 +128,16 @@ class MdbxCrashTest(BitcoinTestFramework):
             while worker.is_alive() and time.monotonic() < deadline:
                 with open(target.debug_log_path, "rb") as log:
                     log.seek(log_offset)
-                    connect_phase_seen = b"- Fork checks:" in log.read()
+                    connect_phase_seen = (
+                        f"Pausing block connection at test height {crash_height}".encode()
+                        in log.read()
+                    )
                 if connect_phase_seen:
                     break
                 time.sleep(0.0005)
             delay = 0
-            time.sleep(delay)
             connect_in_flight = worker.is_alive()
+            assert connect_phase_seen and connect_in_flight
             target.process.kill()
             target.process.wait(timeout=30)
             worker.join(timeout=30)
@@ -162,15 +175,15 @@ class MdbxCrashTest(BitcoinTestFramework):
                     "continued": True,
                 }
             )
-        assert all(
-            item["connect_in_flight"] and item["connect_phase_seen"] for item in results
-        )
         result_path = (
             Path(self.options.result_json)
             if self.options.result_json
             else (Path(self.options.tmpdir) / "mdbx-crash-results.json")
         )
         result_path.write_text(json.dumps(results, indent=2) + "\n")
+        assert all(
+            item["connect_in_flight"] and item["connect_phase_seen"] for item in results
+        )
 
 
 if __name__ == "__main__":
