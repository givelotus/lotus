+    std::cout << "V2 block template passed\n";
+    std::cout << "body " << Hex(body) << '\n';
+    std::cout << "work " << Hex(work) << '\n';
+    std::cout << "block_id " << Hex(block_id) << '\n';
+    std::cout << "job " << json << '\n';
+}
