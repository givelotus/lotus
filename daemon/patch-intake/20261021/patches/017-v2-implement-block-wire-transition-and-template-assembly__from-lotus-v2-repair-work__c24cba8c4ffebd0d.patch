+        out.wire = {0x77};
+        Check(BuildLocalDiskBlockTemplate(
+                  Request(home), Limits(), home.p.header, home.p.ordinary,
+                  home.p.monetary, home.p.cost, home.store, out,
+                  error) == LocalBlockBuildResult::Inconclusive &&
+                  out.wire == std::vector<uint8_t>{0x77},
+              label);
+        Check(Raw(home) == before, "pending fence changes no raw state key");
+    };
+    refuse("assembler cannot bypass pending recovery journal");
+    bool restored = false;
+    for (unsigned n = 0; n < 40; ++n) {
+        const auto result =
+            StepDevelopmentSwitch(UINT64_MAX, 0, runtime_fixture::Limits(),
+                                  home.p, home.store, progress, error);
+        if (result == ReorgResult::RestoredSource) {
+            restored = true;
+            break;
+        }
+        Check(result == ReorgResult::Progress,
+              "real recovery restores source before receipt fence");
+    }
+    Check(restored, "invalid middle source restored");
+    refuse("assembler cannot bypass unacknowledged receipt");
+    DiskStateError failure;
+    std::optional<CandidateTerminalReceipt> receipt;
+    Check(home.store.ReadCandidateReceipt(receipt, failure) && receipt &&
+              receipt->failure,
+          "actual deterministic receipt for propagation gate");
+    Check(home.store.AcknowledgeCandidateReceipt(receipt->id,
+                                                 receipt->stable_tip, failure),
+          failure.message);
+    refuse("assembler cannot bypass pending invalidity propagation");
+    bool complete = false;
+    for (unsigned n = 0; n < 20; ++n) {
+        CandidateInvalidationProgress next;
+        Check(home.store.StepCandidateInvalidation({1, 1000, 1000, 1 << 20},
+                                                   next, failure),
+              failure.message);
+        if (next.complete) {
+            complete = true;
+            break;
+        }
+    }
+    Check(complete, "bounded invalidity propagation completed");
+    Build(home, Request(home));
+}
+} // namespace
+int main(int argc, char **argv) {
+    try {
+        if (argc == 2 && std::string(argv[1]) == "--exceptions") {
+            BuilderExceptionsAreClassified();
+            std::cout << "builder exception classification tests passed\n";
+            return 0;
+        }
+        SignedMatureParentChild();
+        InsufficientAndResourceRefusals();
+        BuilderExceptionsAreClassified();
+        NonceBoundaries();
+        PendingRecoveryFences();
+        RuntimePreviewFacade();
+        std::cout << "local block assembler signed integration tests passed\n";
+        return 0;
+    } catch (const std::exception &error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_block_checksig.cpp b/src/lotus_v2/test_block_checksig.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..15d78aacccf631b8fee9acdba34afd2981a87235
--- /dev/null
+++ b/src/lotus_v2/test_block_checksig.cpp
@@ -0,0 +1,293 @@
+// Copyright (c) 2026 The Lotus developers
+// In-memory ConnectOrdinaryBlock spend of one BIP340 CHECKSIG witness.
+// Not lotusd ConnectTip and not a claim that lotusd accepted a block.
+#include "block.h"
+
+#include "commitment.h"
+#include "signing.h"
+
+#include <secp256k1.h>
+#include <secp256k1_extrakeys.h>
+
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool ok, const std::string &message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+// 0x4e is the numeric literal 1, used only as the created output's branch.
+// The spent coin commits the CHECKSIG script below, not this byte.
+const std::vector<uint8_t> TRUE_SCRIPT{0x4e};
+const MonetaryProfile kMonetary{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000, 200, Hash{9}};
+// BIP340 test-vector secret (scalar 3). Mode 0 is a 64-byte signature; a
+// trailing sighash byte is only present for modes 1 and 2.
+const std::array<uint8_t, 32> kAux{};
+
+OrdinaryCandidateProfile MakeProfile() {
+    OrdinaryCandidateProfile profile{
+        TxProfile{32, 32, 8, 512, 8, 8192, 64},
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 100000},
+        VmCostProfile{}, 100, 50000, 2, 3, 1000000};
+    profile.vm_cost.max_invocation_cost = 1000000;
+    profile.vm_cost.structural_byte_cost = 1;
+    for (auto &opcode : profile.vm_cost.opcode) opcode = {1, 1, 1};
+    return profile;
+}
+
+Hash Chain() {
+    Hash chain{};
+    for (size_t i = 0; i < chain.size(); ++i)
+        chain[i] = static_cast<uint8_t>(i);
+    return chain;
+}
+
+std::array<uint8_t, 32> SecretKey() {
+    std::array<uint8_t, 32> secret{};
+    secret[31] = 3;
+    return secret;
+}
+
+std::vector<uint8_t> XOnlyPublicKey(const std::array<uint8_t, 32> &secret) {
+    using ContextPtr =
+        std::unique_ptr<secp256k1_context, decltype(&secp256k1_context_destroy)>;
+    ContextPtr ctx(secp256k1_context_create(SECP256K1_CONTEXT_SIGN),
+                   secp256k1_context_destroy);
+    Check(static_cast<bool>(ctx), "secp256k1 context");
+    secp256k1_keypair pair;
+    Check(secp256k1_keypair_create(ctx.get(), &pair, secret.data()) == 1,
+          "BIP340 secret rejected by the linked library");
+    secp256k1_xonly_pubkey xonly;
+    Check(secp256k1_keypair_xonly_pub(ctx.get(), &xonly, nullptr, &pair) == 1,
+          "x-only public key");
+    std::vector<uint8_t> pubkey(32);
+    Check(secp256k1_xonly_pubkey_serialize(ctx.get(), pubkey.data(), &xonly) ==
+              1,
+          "serialize x-only public key");
+    return pubkey;
+}
+
+// Push the 32-byte x-only key, then CHECKSIG (0xbb). The signature is a
+// witness argument: the script leaf is inside the sighash, so the signature
+// cannot live in the script.
+std::vector<uint8_t> ChecksigScript(const std::vector<uint8_t> &pubkey) {
+    Check(pubkey.size() == 32, "pubkey width");
+    std::vector<uint8_t> script;
+    script.reserve(34);
+    script.push_back(0x20);
+    script.insert(script.end(), pubkey.begin(), pubkey.end());
+    script.push_back(0xbb);
+    return script;
+}
+
+MonetaryState InitialMoney() {
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 200;
+    money.prev_work[0] = 9;
+    money.ema_block_cost = 4;
+    return money;
+}
+
+Coin MakeFunding(const Hash &branch) {
+    Coin coin;
+    coin.outpoint.tx_id[0] = 0x71;
+    coin.outpoint.index = 3;
+    coin.output.flags = 0;
+    coin.output.value = 20000;
+    coin.output.branches = {branch};
+    coin.output.paths = {{0}};
+    coin.creation_height = 90;
+    coin.creation_parent_mtp = 49000;
+    coin.coinbase = false;
+    return coin;
+}
+
+struct World {
+    DevelopmentUtxoView view;
+    IncrementalUtxoSet utxo;
+    MonetaryState monetary = InitialMoney();
+    OrdinaryParentContext parent;
+    Coin funding;
+    explicit World(const std::vector<uint8_t> &locking_script) {
+        funding = MakeFunding(BranchLeaf(locking_script));
+        Check(view.emplace(funding.outpoint, funding).second &&
+                  utxo.Insert(funding),
+              "parent coin");
+        parent.chain_id = Chain();
+        parent.monetary = monetary;
+        parent.header.height = 99;
+        parent.header.time = 50000;
+        parent.header.version = 1;
+        parent.header.size = HEADER_SIZE;
+        parent.header.state_root = StateRoot(
+            parent.chain_id, parent.header.height, utxo.Root(), monetary);
+    }
+};
+
+struct ParentBytes {
+    std::vector<std::vector<uint8_t>> coins;
+    Hash utxo{};
+    std::array<uint8_t, 56> monetary{};
+    Hash state{};
+};
+
+ParentBytes Capture(const World &world) {
+    ParentBytes snap;
+    for (const auto &entry : world.view) {
+        Check(entry.first == entry.second.outpoint, "view outpoint");
+        std::vector<uint8_t> encoded;
+        Check(EncodeCoin(entry.second, encoded), "encode parent coin");
+        snap.coins.push_back(std::move(encoded));
+    }
+    snap.utxo = world.utxo.Root();
+    snap.monetary = EncodeMonetaryState(world.monetary);
+    snap.state = world.parent.header.state_root;
+    return snap;
+}
+
+void ExpectParent(const World &world, const ParentBytes &parent,
+                  const std::string &where) {
+    const ParentBytes now = Capture(world);
+    Check(now.coins == parent.coins, where + " view is not the parent coins");
+    Check(now.utxo == parent.utxo, where + " utxo root moved");
+    Check(now.monetary == parent.monetary, where + " monetary bytes moved");
+    Check(StateRoot(world.parent.chain_id, world.parent.header.height,
+                    world.utxo.Root(), world.monetary) == parent.state,
+          where + " state root moved");
+}
+
+bool Connect(World &world, const Transaction &tx,
+             const OrdinaryCandidateProfile &profile,
+             OrdinaryBlockConnected &connected, std::string &error) {
+    return ConnectOrdinaryBlock({tx}, world.parent, profile, kMonetary,
+                                world.view, world.utxo, world.monetary,
+                                connected, error);
+}
+
+Transaction Spend(const Outpoint &spent, const std::vector<uint8_t> &script,
+                  const std::vector<uint8_t> &signature) {
+    Transaction tx;
+    Input input;
+    input.prev_txid = spent.tx_id;
+    input.prev_index = spent.index;
+    input.sequence = UINT32_MAX;
+    input.flags = 1;
+    input.path_index = 0;
+    input.witnesses = {BranchWitness{script, {}, {signature}}};
+    tx.inputs.push_back(input);
+    Output output;
+    output.value = 15000;
+    output.branches = {BranchLeaf(TRUE_SCRIPT)};
+    output.paths = {{0}};
+    tx.outputs.push_back(output);
+    return tx;
+}
+
+struct SignedSpend {
+    Transaction tx;
+    Hash message{};
+    std::vector<uint8_t> signature;
+};
+
+SignedSpend SignSpend(const World &world, const std::vector<uint8_t> &script,
+                      const std::vector<uint8_t> &pubkey,
+                      const OrdinaryCandidateProfile &profile) {
+    SignedSpend spend;
+    spend.tx = Spend(world.funding.outpoint, script, std::vector<uint8_t>(64));
+    Check(spend.tx.inputs[0].witnesses[0].script == script &&
+              world.funding.output.branches.size() == 1 &&
+              world.funding.output.branches[0] == BranchLeaf(script),
+          "parent locking script is not the executed witness script");
+    const ResolvedCoins resolved{world.funding.output};
+    std::string error;
+    Check(SigningMessage(spend.tx, profile.transaction, world.parent.chain_id,
+                         resolved, 0, 0, 0, std::nullopt, spend.message, error),
+          "sighash: " + error);
+    Check(SignBip340Message(SecretKey(), spend.message, 0, kAux,
+                            spend.signature, error),
+          "SignBip340Message: " + error);
+    Check(spend.signature.size() == 64, "mode 0 signature width");
+    Check(VerifyBip340Signature(pubkey, spend.signature, spend.message,
+                                false) == SignatureStatus::Valid,
+          "VerifyBip340Signature rejected the signature just produced");
+    spend.tx.inputs[0].witnesses[0].arguments = {spend.signature};
+    Hash again{};
+    Check(SigningMessage(spend.tx, profile.transaction, world.parent.chain_id,
+                         resolved, 0, 0, 0, std::nullopt, again, error),
+          "sighash after signature: " + error);
+    Check(again == spend.message, "witness signature changed the sighash");
+    return spend;
+}
+
+void ChecksigSpendConnectsAndMutationRestoresParent() {
+    const std::vector<uint8_t> pubkey = XOnlyPublicKey(SecretKey());
+    const auto vector_key = std::vector<uint8_t>{
+        0xf9, 0x30, 0x8a, 0x01, 0x92, 0x58, 0xc3, 0x10, 0x49, 0x34, 0x4f,
+        0x85, 0xf8, 0x9d, 0x52, 0x29, 0xb5, 0x31, 0xc8, 0x45, 0x83, 0x6f,
+        0x99, 0xb0, 0x86, 0x01, 0xf1, 0x13, 0xbc, 0xe0, 0x36, 0xf9};
+    Check(pubkey == vector_key, "linked library x-only key is not BIP340 vector 0");
+    const std::vector<uint8_t> script = ChecksigScript(pubkey);
+    const OrdinaryCandidateProfile profile = MakeProfile();
+    World world(script);
+    const ParentBytes parent = Capture(world);
+    const SignedSpend spend = SignSpend(world, script, pubkey, profile);
+
+    Transaction mutated = spend.tx;
+    mutated.inputs[0].witnesses[0].arguments[0][0] ^= 0x01;
+    Check(VerifyBip340Signature(
+              pubkey, mutated.inputs[0].witnesses[0].arguments[0],
+              spend.message, false) == SignatureStatus::InvalidSignature,
+          "mutated signature was still valid");
+    OrdinaryBlockConnected discarded;
+    std::string error;
+    Check(!Connect(world, mutated, profile, discarded, error),
+          "mutated CHECKSIG signature was accepted");
+    Check(error == "witness VM invalid/unsupported: CHECKSIG NULLFAIL",
+          "mutated CHECKSIG rejection: " + error);
+    ExpectParent(world, parent, "mutated signature");
+
+    OrdinaryBlockConnected connected;
+    error.clear();
+    if (!Connect(world, spend.tx, profile, connected, error)) {
+        throw std::runtime_error(
+            "VerifyBip340Signature accepted the signature but "
+            "ConnectOrdinaryBlock rejected it: " +
+            error);
+    }
+    Check(world.utxo.Root() == connected.utxo_root &&
+              world.utxo.Root() != parent.utxo,
+          "CHECKSIG spend did not move the utxo root");
+    Check(EncodeMonetaryState(world.monetary) == connected.monetary_bytes &&
+              connected.monetary_bytes != parent.monetary,
+          "CHECKSIG spend did not move monetary bytes");
+    Check(world.view.count(world.funding.outpoint) == 0,
+          "parent CHECKSIG coin was not spent");
+    IdentityDigests ids;
+    Check(ComputeIdentities(spend.tx, profile.transaction, world.parent.chain_id,
+                            ids, error),
+          "CHECKSIG spend identity");
+    Check(world.view.count(Outpoint{ids.txid, 0}) == 1 && world.view.size() == 1,
+          "CHECKSIG output missing");
+    Check(connected.invocation_cost > 0, "CHECKSIG invocation was free");
+}
+} // namespace
+
+int main() {
+    try {
+        ChecksigSpendConnectsAndMutationRestoresParent();
+        std::cout << "ordinary CHECKSIG connect checks passed\n";
+        return 0;
+    } catch (const std::exception &failure) {
+        std::cerr << failure.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_block_complete.cpp b/src/lotus_v2/test_block_complete.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ea239ce7010da8ad93aae66beeafea6ef9a8ab79
--- /dev/null
+++ b/src/lotus_v2/test_block_complete.cpp
@@ -0,0 +1,848 @@
+// Copyright (c) 2026 The Lotus developers
+// Synthetic authenticated parent for module checks; no genesis funding claim.
+#include "block.h"
+#include "block_transition.h"
+#ifdef LOTUS_V2_TEST_DISK
+#include "disk_block.h"
+#include <filesystem>
+#include <cstdlib>
+#endif
+#include "dev_genesis.h"
+#include "signing.h"
+#include <iostream>
+#include <stdexcept>
+using namespace lotus::v2;
+namespace {
+void Check(bool v, const std::string &why) {
+    if (!v) throw std::runtime_error(why);
+}
+class TestState final : public BlockStateTransaction {
+public:
+    DevelopmentUtxoView coins;
+    IncrementalUtxoSet tree;
+    bool aborted = false, fail_reads = false, fail_writes = false;
+    bool throw_writes = false;
+    unsigned writes = 0;
+    explicit TestState(const DevelopmentUtxoView &initial) : coins(initial) {
+        for (const auto &[key, coin] : initial) {
+            (void)key;
+            Check(tree.Insert(coin), "test state init");
+        }
+    }
+    CoinReadResult Read(const Outpoint &key, Coin &coin, std::string &error) override {
+        if (fail_reads) { error = "injected storage read"; return CoinReadResult::Error; }
+        auto it = coins.find(key);
+        if (it == coins.end()) return CoinReadResult::Missing;
+        coin = it->second; return CoinReadResult::Found;
+    }
+    bool Insert(const Coin &coin, std::string &error) override {
+        if (throw_writes && ++writes == 2)
+            throw std::invalid_argument("injected backend exception after mutation");
+        if (fail_writes) { error = "injected storage write"; return false; }
+        return coins.emplace(coin.outpoint, coin).second && tree.Insert(coin);
+    }
+    bool Erase(const Outpoint &key, std::string &error) override {
+        if (throw_writes && ++writes == 2)
+            throw std::invalid_argument("injected backend exception after mutation");
+        if (fail_writes) { error = "injected storage write"; return false; }
+        return coins.erase(key) == 1 && tree.Erase(key);
+    }
+    Hash Root() const override { return tree.Root(); }
+    void Abort() noexcept override {
+        aborted = true; coins.clear(); tree = IncrementalUtxoSet{};
+    }
+};
+const TxProfile TX{32, 32, 8, 512, 8, 8192, 64};
+const BlockCostProfile COST{1, 1, 1, 1};
+Output Native(uint64_t value, bool burn = false) {
+    Output o;
+    o.value = value;
+    o.flags = burn ? 2 : 0;
+    o.branches = {BranchLeaf(std::vector<uint8_t>{0x4e})};
+    if (!burn) o.paths = {{0}};
+    return o;
+}
+Transaction Coinbase(const Hash &parent, uint64_t height, bool burn = true) {
+    Transaction tx;
+    Input i;
+    i.prev_txid = parent;
+    i.prev_index = height;
+    i.sequence = UINT32_MAX;
+    i.flags = 2;
+    tx.inputs = {i};
+    tx.outputs = {Native(0, burn)};
+    return tx;
+}
+Transaction Payment(const Outpoint &outpoint) {
+    Transaction tx;
+    Input i;
+    i.prev_txid = outpoint.tx_id;
+    i.prev_index = outpoint.index;
+    i.sequence = UINT32_MAX;
+    i.flags = 1;
+    i.witnesses = {BranchWitness{{0x4e}, {}, {}}};
+    tx.inputs = {i};
+    tx.outputs = {Native(1000)};
+    return tx;
+}
+std::vector<uint8_t> Wire(Header &h, const std::vector<Transaction> &txs) {
+    std::string error;
+    h.size = 138;
+    for (const auto &tx : txs) {
+        std::vector<uint8_t> raw;
+        Check(EncodeTransaction(tx, TX, raw, error), error);
+        h.size += raw.size() + CompactSizeWidth(raw.size());
+    }
+    Check(CompleteTransactionRoot(txs, TX, {}, h.tx_root, error), error);
+    std::vector<uint8_t> raw;
+    Check(EncodeBlockWire(h, txs, TX, raw, error), error);
+    return raw;
+}
+void WireChecks() {
+    Header h;
+    h.version = 2;
+    h.bits = 0x1d00ffff;
+    h.height = 1;
+    h.time = 1;
+    auto tx = Coinbase({}, 1);
+    auto wire = Wire(h, {tx});
+    FramedBlock decoded;
+    std::string error;
+    Check(wire.size() == 240, "minimum full coinbase size");
+    Check(DecodeBlockWire(wire, TX, {}, decoded, error), error);
+    const auto charge =
+        AuthenticatedTransactionCosts(tx, TX, {}, 1, 0, 0, COST);
+    Check(charge.account_linear == 1570 && charge.enforce_linear == 1570,
+          "independent minimum cost vector");
+    Check(AuthenticatedEnvelopeCost(1, 1, COST) == 993,
+          "independent envelope vector");
+    Check(BlockEffectiveCost(993, {1570}, DevelopmentGenesis) == 310675,
+          "independent parabolic vector");
+    auto rejects = [&](const std::vector<uint8_t> &bad) {
+        const auto before = decoded.header.tx_root;
+        Check(!DecodeBlockWire(bad, TX, {}, decoded, error),
+              "wire mutation accepted");
+        Check(decoded.header.tx_root == before, "decode failure wrote result");
+    };
+    for (size_t cut = 0; cut < wire.size(); ++cut)
+        rejects({wire.begin(), wire.begin() + cut});
+    auto bad = wire;
+    bad.push_back(0);
+    rejects(bad);
+    bad = wire;
+    bad[134] = 0;
+    rejects(bad);
+    bad = wire;
+    std::fill(bad.begin() + 134, bad.begin() + 138, 255);
+    rejects(bad);
+    bad = wire;
+    bad[139] = 8;
+    rejects(bad);
+    bad = wire;
+    bad[70] ^= 1;
+    rejects(bad); // tx root
+    bad = wire;
+    bad.insert(bad.begin() + 138, {253, 101});
+    bad[140] = 0;
+    Header longer = h;
+    longer.size = bad.size();
+    std::array<uint8_t, HEADER_SIZE> hb;
+    Check(SerializeHeader(longer, hb), "header encode");
+    std::copy(hb.begin(), hb.end(), bad.begin());
+    rejects(bad);
+    Hash root;
+    Transaction spend = Payment(Outpoint{});
+    Check(!CompleteTransactionRoot({}, TX, {}, root, error), "empty block");
+    Check(!CompleteTransactionRoot({spend}, TX, {}, root, error),
+          "missing coinbase");
+    Check(!CompleteTransactionRoot({spend, tx}, TX, {}, root, error),
+          "misplaced coinbase");
+    Check(!CompleteTransactionRoot({tx, tx}, TX, {}, root, error),
+          "second coinbase");
+    spend.outputs.clear();
+    Transaction witness_changed = spend;
+    witness_changed.inputs[0].witnesses[0].arguments = {{9}};
+    Check(!CompleteTransactionRoot({tx, spend, witness_changed}, TX, {}, root,
+                                   error) &&
+              error == "duplicate transaction id",
+          "zero-output duplicate id");
+    spend.outputs = {Native(0, true)};
+    witness_changed = spend;
+    witness_changed.inputs[0].witnesses[0].arguments = {{9}};
+    Check(!CompleteTransactionRoot({tx, spend, witness_changed}, TX, {}, root,
+                                   error) &&
+              error == "duplicate transaction id",
+          "burn-only duplicate id");
+    Check(!CheckCoinbaseContext(tx, {}, uint64_t{1} << 32, error),
+          "derived coinbase height must fit u32");
+    MonetaryState initial;
+    initial.bootstrap_reserve = 9;
+    initial.tail_subsidy = 200;
+    initial.prev_work[0] = 9;
+    initial.ema_block_cost = 4;
+    bool failed = false;
+    try {
+        AdvanceMonetary(DevelopmentGenesis, initial, 9, {}, 0, 0, 101, 1, 0, 0);
+    } catch (const std::invalid_argument &e) {
+        failed = std::string(e.what()) == "insufficient entitlement";
+    }
+    Check(failed, "bare old genesis cannot afford K=240 from entitlement202");
+}
+#ifdef LOTUS_V2_TEST_DISK
+void DiskHistoryRolloverChecks() {
+    // An explicitly trusted synthetic height-ten seed, not a genesis-derived
+    // funding history. Subsequent children use actual complete-block
+    // validation.
+    Coin funding;
+    funding.outpoint.tx_id[0] = 17;
+    funding.output = Native(1000000000000000000ULL);
+    DevelopmentUtxoView view{{funding.outpoint, funding}};
+    IncrementalUtxoSet tree;
+    Check(tree.Insert(funding), "rollover funding");
+    MonetaryState money;
+    money.bootstrap_reserve = 9;
+    money.tail_subsidy = 94; // AbsoluteTail(DevelopmentGenesis, 2) for synthetic parent.
+    money.prev_work[0] = 2;
+    money.ema_block_cost = 4;
+    Hash limit;
+    limit.fill(255);
+    const HeaderChainProfile hp{{}, 2, 1000, 0x207fffff, limit, 172800, 120};
+    OrdinaryCandidateProfile profile{
+        TX,
+        VmProfile{512, 8, 8192, 32, 32, 65536, 16, 1000000},
+        VmCostProfile{},
