+        LOCK(m_node.mempool->cs);
+        BlockPolicyValidationState state;
+        PreConsensusPolicy policy(*m_node.avalanche, candidateIdx,
+                                  blockMissingTx, *m_node.mempool);
+        ParkingPolicy &policy_ref = policy;
+        BOOST_CHECK(!policy_ref(state));
