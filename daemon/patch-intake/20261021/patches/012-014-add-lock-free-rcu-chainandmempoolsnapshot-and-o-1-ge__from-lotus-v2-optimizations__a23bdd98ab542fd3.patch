new file mode 100644
index 0000000000000000000000000000000000000000..b9ce17bedb8ceb514703a668ac5a5ea54cff3da3
--- /dev/null
+++ b/src/rpc/async_waiter.h
@@ -0,0 +1,144 @@
+// Copyright (c) 2026 The Lotus developers
