From e1ddf4eb96b60aff1229c9d92a684fcb586a6429 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 16:11:09 -0700
Subject: [PATCH] logging: expose pthread batch-scheduler failure codes

Keep the original Info message and stable returned pthread error. Also expose
that same code numerically without substituting ambient errno. Preserve all
SCHED_BATCH guards and scheduling behavior. This branch is absent on macOS;
real Linux/BSD scheduler-failure runtime coverage is not claimed.

Scripted diff (ast-grep-py0.51.0; single reviewed site):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/batch-scheduler-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/batch-priority367-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/util/batchpriority.cpp
---
 .../rules/batch-scheduler-diagnostics.json    | 29 +++++++++++++++++++
 src/util/batchpriority.cpp                    |  5 +++-
 2 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 contrib/logging/conversion/rules/batch-scheduler-diagnostics.json

diff --git a/contrib/logging/conversion/rules/batch-scheduler-diagnostics.json b/contrib/logging/conversion/rules/batch-scheduler-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..8cd8d64eb643cdace8067013046a430948ec64f0
--- /dev/null
+++ b/contrib/logging/conversion/rules/batch-scheduler-diagnostics.json
@@ -0,0 +1,29 @@
+{
+  "schema": 1,
+  "batch": "batch-scheduler-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/util/batchpriority.cpp",
+      "rules": [
+        {
+          "id": "batch_thread_scheduler_failed",
+          "old": "LogPrintf(\"Failed to pthread_setschedparam: %s\\n\", SysErrorString(rc))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"batch_thread_scheduler_failed\", \"Failed to pthread_setschedparam: {error}\").Field(BCLog::LogField::Error, SysErrorString(rc)).Field(BCLog::LogField::ErrorCode, rc)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Failed to pthread_setschedparam: %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "SysErrorString(rc)"
+            ]
+          },
+          "review_note": "Preserve Info, SysErrorString of the returned pthread error (not ambient errno), original rc!=0/SCHED_BATCH guards and scheduling call/parameters. Additional numeric error is the same stable return code. macOS SCHED_BATCH branch is absent; real Linux/BSD scheduling-failure runtime not newly forced."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/util/batchpriority.cpp b/src/util/batchpriority.cpp
index 2571387a3e4105a7e35584537253a1415d5f91f2..a73f35382d39f71e0a2c0ba809023db915cdb5bf 100644
--- a/src/util/batchpriority.cpp
+++ b/src/util/batchpriority.cpp
@@ -19,7 +19,10 @@ void ScheduleBatchPriority() {
     const static sched_param param{};
     const int rc = pthread_setschedparam(pthread_self(), SCHED_BATCH, &param);
     if (rc != 0) {
-        LogPrintf("Failed to pthread_setschedparam: %s\n", SysErrorString(rc));
+        LogInfoEvent(BCLog::ALL, "batch_thread_scheduler_failed",
+                     "Failed to pthread_setschedparam: {error}")
+            .Field(BCLog::LogField::Error, SysErrorString(rc))
+            .Field(BCLog::LogField::ErrorCode, rc);
     }
 #endif
 }
-- 
2.50.1 (Apple Git-155)

