 DEFAULT_JOBS = os.cpu_count() or 1
 
 SETUP_SCRIPTS_SUBDIR = "setup_scripts"
@@ -180,7 +183,15 @@ class TestCase:
     """
 
     def __init__(
-        self, test_num, test_case, tests_dir, tmpdir, failfast_event, flags=None
+        self,
+        test_num,
