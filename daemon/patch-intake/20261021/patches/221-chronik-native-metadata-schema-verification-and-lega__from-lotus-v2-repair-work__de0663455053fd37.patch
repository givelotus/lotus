+        BOOST_CHECK(!VerifyScripthashIndex(*f.store, true, true, logs.Fn()));
+        auto txn = f.store->BeginRead();
+        BOOST_CHECK(*f.Reader(*txn).IsLokadIdIndexEnabled());
+        BOOST_CHECK(*f.Reader(*txn).IsScripthashIndexEnabled());
