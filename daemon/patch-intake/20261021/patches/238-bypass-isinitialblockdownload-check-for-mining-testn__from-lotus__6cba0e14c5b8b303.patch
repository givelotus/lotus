From 00ae1eeeb828911c63f80f3b30ed57662c50c06e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matthew=20=F0=9F=AA=B7?= <matthew@urgero.net>
Date: Fri, 31 Oct 2025 13:35:12 -0500
Subject: [PATCH] Bypass `IsInitialBlockDownload` check for mining testnet
 (#28)

This is to allow mining on the 4+ year old testnet genesis block. Also
bypass node count check for private testnets (i.e. allow 0 connected
nodes for mining).

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: aca68485e88a379801a45e382657abc4c615cf4d
Recorded-replay-commit: c1b3f4addc96d9d4f00c9313188e9d2c22274dc0

diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index d6e6d99197..d51d27b5f9 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -954,13 +954,18 @@ static RPCHelpMan getblocktemplate() {
                 throw JSONRPCError(RPC_INVALID_PARAMETER, "Invalid mode");
             }
 
+            const bool isTestnet = chainparams.IsTestChain();
+
             const CConnman &connman = EnsureConnman(node);
-            if (connman.GetNodeCount(ConnectionDirection::Both) == 0) {
+            // Allow mining on testnet even without connections (for private testnets)
+            if (!isTestnet &&
+                connman.GetNodeCount(ConnectionDirection::Both) == 0) {
                 throw JSONRPCError(RPC_CLIENT_NOT_CONNECTED,
                                    "Bitcoin is not connected!");
             }
 
-            if (chainman.IsInitialBlockDownload()) {
+            // Allow mining on testnet even during initial block download
+            if (!isTestnet && chainman.IsInitialBlockDownload()) {
                 throw JSONRPCError(
                     RPC_CLIENT_IN_INITIAL_DOWNLOAD, PACKAGE_NAME
                     " is in initial sync and waiting for blocks...");
@@ -1312,16 +1317,20 @@ static RPCHelpMan getrawunsolvedblock() {
             }
 
             const CChainParams &chainparams = config.GetChainParams();
+            const bool isTestnet = chainparams.IsTestChain();
 
             NodeContext &node = EnsureAnyNodeContext(request.context);
             const CConnman &connman = EnsureConnman(node);
-            if (connman.GetNodeCount(ConnectionDirection::Both) == 0) {
+            // Allow mining on testnet even without connections (for private testnets)
+            if (!isTestnet &&
+                connman.GetNodeCount(ConnectionDirection::Both) == 0) {
                 throw JSONRPCError(RPC_CLIENT_NOT_CONNECTED,
                                    "Node is not connected!");
             }
 
             ChainstateManager &chainman = EnsureChainman(node);
-            if (chainman.IsInitialBlockDownload()) {
+            // Allow mining on testnet even during initial block download
+            if (!isTestnet && chainman.IsInitialBlockDownload()) {
                 throw JSONRPCError(
                     RPC_CLIENT_IN_INITIAL_DOWNLOAD, PACKAGE_NAME
                     " is in initial sync and waiting for blocks...");
