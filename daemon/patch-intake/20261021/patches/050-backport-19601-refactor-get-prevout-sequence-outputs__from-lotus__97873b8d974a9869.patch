From 9c35323709234de7d5a8e00dffee45bb4897b510 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Thu, 18 Mar 2021 11:53:54 -0500
Subject: [PATCH] [backport#19601] Refactor Get{Prevout,Sequence,Outputs}Hash
 to Get{Prevouts,Sequences,Outputs}SHA256. (#97)

Several proposals (Taproot, MuHash, CTV) require access to the single
hash.

Part 3 of 3.

Co-authored-by: Jeremy Rubin <j@rubin.io>

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 04c1a7eafc10babac38e42120da02be0fb7335b8
Recorded-replay-commit: f80b7d6d5d5d3b95f2d339524ba20ae7f526992b

diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index 00f1718040..ccc3086e09 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -1569,37 +1569,41 @@ public:
     }
 };
 
-template <class T> uint256 GetPrevoutHash(const T &txTo) {
+/** Compute the (single) SHA256 of the concatenation of all prevouts of a tx. */
+template <class T> uint256 GetPrevoutsSHA256(const T &txTo) {
     HashWriter ss{};
     for (const auto &txin : txTo.vin) {
         ss << txin.prevout;
     }
-    return ss.GetHash();
+    return ss.GetSHA256();
 }
 
-template <class T> uint256 GetSequenceHash(const T &txTo) {
+/** Compute the (single) SHA256 of the concatenation of all nSequences of a tx.
+ */
+template <class T> uint256 GetSequencesSHA256(const T &txTo) {
     HashWriter ss{};
     for (const auto &txin : txTo.vin) {
         ss << txin.nSequence;
     }
-    return ss.GetHash();
+    return ss.GetSHA256();
 }
 
-template <class T> uint256 GetOutputsHash(const T &txTo) {
+/** Compute the (single) SHA256 of the concatenation of all txouts of a tx. */
+template <class T> uint256 GetOutputsSHA256(const T &txTo) {
     HashWriter ss{};
     for (const auto &txout : txTo.vout) {
         ss << txout;
     }
-    return ss.GetHash();
+    return ss.GetSHA256();
 }
 
 } // namespace
 
 template <class T>
 PrecomputedTransactionData::PrecomputedTransactionData(const T &txTo) {
-    hashPrevouts = GetPrevoutHash(txTo);
-    hashSequence = GetSequenceHash(txTo);
-    hashOutputs = GetOutputsHash(txTo);
+    hashPrevouts = SHA256Uint256(GetPrevoutsSHA256(txTo));
+    hashSequence = SHA256Uint256(GetSequencesSHA256(txTo));
+    hashOutputs = SHA256Uint256(GetOutputsSHA256(txTo));
 }
 
 // explicit instantiation
@@ -1674,17 +1678,20 @@ uint256 SignatureHash(const CScript &scriptCode, const T &txTo,
         uint256 hashOutputs;
 
         if (!sigHashType.hasAnyoneCanPay()) {
-            hashPrevouts = cache ? cache->hashPrevouts : GetPrevoutHash(txTo);
+            hashPrevouts = cache ? cache->hashPrevouts
+                                 : SHA256Uint256(GetPrevoutsSHA256(txTo));
         }
 
         if (!sigHashType.hasAnyoneCanPay() &&
             (sigHashType.getBaseType() != BaseSigHashType::SINGLE) &&
             (sigHashType.getBaseType() != BaseSigHashType::NONE)) {
-            hashSequence = cache ? cache->hashSequence : GetSequenceHash(txTo);
+            hashSequence = cache ? cache->hashSequence
+                                 : SHA256Uint256(GetSequencesSHA256(txTo));
         }
         if ((sigHashType.getBaseType() != BaseSigHashType::SINGLE) &&
             (sigHashType.getBaseType() != BaseSigHashType::NONE)) {
-            hashOutputs = cache ? cache->hashOutputs : GetOutputsHash(txTo);
+            hashOutputs = cache ? cache->hashOutputs
+                                : SHA256Uint256(GetOutputsSHA256(txTo));
         } else if ((sigHashType.getBaseType() == BaseSigHashType::SINGLE) &&
                    (nIn < txTo.vout.size())) {
             HashWriter inner_ss{};
