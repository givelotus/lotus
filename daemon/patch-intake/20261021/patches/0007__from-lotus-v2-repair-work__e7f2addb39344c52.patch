From de6fcf9bdd8a0eda51fe07f38cc03cebe954f529 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 03:15:42 -0700
Subject: [PATCH] fixup! [v2 only] bench: add production-transport multi-peer
 P2P load client

---
 src/bench/CMakeLists.txt | 6 ++++--
 src/bench/p2p_load.cpp   | 7 ++++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/bench/CMakeLists.txt b/src/bench/CMakeLists.txt
index 5f35943fdb..a00ae6cea3 100644
--- a/src/bench/CMakeLists.txt
+++ b/src/bench/CMakeLists.txt
@@ -109,5 +109,7 @@ set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY ADDITIONAL_CLEAN_FI
 )
 
 # Standalone transport load tool, not part of the microbenchmark runner.
-add_executable(p2p-load p2p_load.cpp)
-target_link_libraries(p2p-load server)
+if(UNIX)
+	add_executable(p2p-load p2p_load.cpp)
+	target_link_libraries(p2p-load server)
+endif()
diff --git a/src/bench/p2p_load.cpp b/src/bench/p2p_load.cpp
index 4c8cec0c09..d12e297cb5 100644
--- a/src/bench/p2p_load.cpp
+++ b/src/bench/p2p_load.cpp
@@ -3,6 +3,8 @@
 // Load-only peers: production socket/dialer/TLS/WebSocket/p2p-v2 transport.
 #include <chrono>
 #include <config.h>
+#include <cstring>
+#include <ctime>
 #include <fstream>
 #include <iostream>
 #include <net.h>
@@ -112,15 +114,18 @@ int main(int argc, char **argv) {
                     const int64_t deadline = Now() + int64_t(seconds * 1e6);
                     while (Now() < deadline && !failed && finished < count) {
                         Sock::EventsPerSock events;
+                        bool buffered = false;
                         for (size_t i = t; i < count; i += threads) {
                             auto &p = peers[i];
+                            buffered |= p.sock->HasBufferedRecv();
                             Sock::Event wanted =
                                 Sock::RECV | p.sock->PendingEvents();
                             if (p.sent < p.tx.size()) wanted |= Sock::SEND;
                             events.emplace(p.sock, Sock::Events{wanted});
                         }
                         if (!peers[t].sock->WaitMany(
-                                std::chrono::milliseconds{10}, events))
+                                std::chrono::milliseconds{buffered ? 0 : 10},
+                                events))
                             throw std::runtime_error("poll failed");
                         for (size_t i = t; i < count; i += threads) {
                             auto &p = peers[i];
-- 
