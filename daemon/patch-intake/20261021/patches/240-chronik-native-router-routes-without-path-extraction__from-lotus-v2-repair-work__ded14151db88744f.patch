From 44443f3d298f62a8b4afa753688236fdd8cbe1e3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 10:02:49 -0700
Subject: [PATCH] chronik: native router routes without path extraction

axum handlers that read the request URI themselves (OriginalUri) rather
than using the Path extractor never reject a request for its path
parameters. Add a per-pattern PathExtraction mode: Decode (the default,
axum's Path: percent-decoded, invalid UTF-8 rejected with 400) or Raw
(the handler receives the still-encoded segments and no rejection
happens). Extension routes that port such handlers use Raw.

Tier: eCash
---
 chronik/native/core/http/router.cpp          | 11 ++++++++-
 chronik/native/include/chronik/native/http.h | 24 ++++++++++++++++----
 chronik/native/test/http_tests.cpp           | 19 ++++++++++++++++
 3 files changed, 48 insertions(+), 6 deletions(-)

diff --git a/chronik/native/core/http/router.cpp b/chronik/native/core/http/router.cpp
index 3139a4749429c18e0775f3f8a980b36f7897cf02..a841e2336c8be885e73bc824fb48a4edcd9994b9 100644
--- a/chronik/native/core/http/router.cpp
+++ b/chronik/native/core/http/router.cpp
@@ -173,6 +173,7 @@ struct Router::Route {
     std::vector<std::pair<std::string, HttpHandler>> methods;
     std::string allow;
     bool is_websocket = false;
+    PathExtraction extraction = PathExtraction::Decode;
 
     const HttpHandler *Find(std::string_view method) const {
         for (const auto &[m, h] : methods) {
@@ -197,7 +198,7 @@ Router::Router(RouterOptions opts) : m_opts(std::move(opts)) {
 }
 
 void Router::Add(std::string_view method, std::string_view pattern,
-                 HttpHandler handler) {
+                 HttpHandler handler, PathExtraction extraction) {
     Route *route = nullptr;
     for (auto &r : m_routes) {
         if (r->pattern == pattern) {
@@ -215,8 +216,12 @@ void Router::Add(std::string_view method, std::string_view pattern,
                 new_route->segments.push_back({false, std::string(seg)});
             }
         }
+        new_route->extraction = extraction;
         route = new_route.get();
         m_routes.push_back(std::move(new_route));
+    } else if (route->extraction != extraction) {
+        throw std::logic_error("Mixed path extraction for " +
+                               std::string(pattern));
     }
     if (route->Find(method)) {
         throw std::logic_error("Overlapping method route for " +
@@ -350,6 +355,10 @@ HttpResponse Router::Dispatch(const HttpRequest &req) const {
     // Path extractor: percent-decode params; invalid UTF-8 is a rejection.
     // Only routes with params extract them (Path<...>).
     params.names = route->param_names;
+    if (route->extraction == PathExtraction::Raw) {
+        params.values.assign(raw_params.begin(), raw_params.end());
+        raw_params.clear();
+    }
     for (size_t i = 0; i < raw_params.size(); ++i) {
         std::string decoded = PercentDecode(raw_params[i]);
         if (!IsValidUtf8(decoded)) {
diff --git a/chronik/native/include/chronik/native/http.h b/chronik/native/include/chronik/native/http.h
index d96f46dd54c0b65737873314ec8681a3267e222d..7830f9e9316e28515d6243db6f0118e529652f9f 100644
--- a/chronik/native/include/chronik/native/http.h
+++ b/chronik/native/include/chronik/native/http.h
@@ -244,13 +244,27 @@ public:
     Router(Router &&) noexcept;
     Router &operator=(Router &&) noexcept;
 
+    /**
+     * How a route's ":param" values reach its handler:
+     *  - Decode: axum's Path extractor (percent-decoded, invalid UTF-8 is a
+     *    400 rejection before the handler runs);
+     *  - Raw: handlers that read the URI themselves (axum OriginalUri, no
+     *    Path extractor): values are the raw, still-encoded segments and no
+     *    rejection happens.
+     * All methods of one pattern share its mode.
+     */
+    enum class PathExtraction { Decode, Raw };
+
     void Add(std::string_view method, std::string_view pattern,
-             HttpHandler handler);
-    void Get(std::string_view pattern, HttpHandler h) {
-        Add("GET", pattern, std::move(h));
+             HttpHandler handler,
+             PathExtraction extraction = PathExtraction::Decode);
+    void Get(std::string_view pattern, HttpHandler h,
+             PathExtraction extraction = PathExtraction::Decode) {
+        Add("GET", pattern, std::move(h), extraction);
     }
-    void Post(std::string_view pattern, HttpHandler h) {
-        Add("POST", pattern, std::move(h));
+    void Post(std::string_view pattern, HttpHandler h,
+              PathExtraction extraction = PathExtraction::Decode) {
+        Add("POST", pattern, std::move(h), extraction);
     }
     /**
      * POST route with an explicit OPTIONS handler answering 200
diff --git a/chronik/native/test/http_tests.cpp b/chronik/native/test/http_tests.cpp
index 23f5421de36394116f90e4ca4550a6bcb26243a1..3a33c94ab56efa66640ec63f197cdb8d9abf061c 100644
--- a/chronik/native/test/http_tests.cpp
+++ b/chronik/native/test/http_tests.cpp
@@ -362,6 +362,25 @@ BOOST_AUTO_TEST_CASE(path_params) {
     resp = router.Handle(MakeRequest("GET", "/blocks/%ff/1"));
     BOOST_CHECK_EQUAL(resp.status, 400);
     BOOST_CHECK_EQUAL(BodyStr(resp), "Invalid URL: Invalid UTF-8 in `start`");
+
+    // Raw routes (no Path extractor) get the encoded segments, unchecked.
+    router.Get(
+        "/raw/:a/:b",
+        [](const HttpRequest &, const PathParams &p) {
+            BOOST_REQUIRE_EQUAL(p.names.size(), 2u);
+            return HttpResponse::Text(200, "raw:" + p[0] + "," + p[1]);
+        },
+        Router::PathExtraction::Raw);
+    BOOST_CHECK_EQUAL(
+        BodyStr(router.Handle(MakeRequest("GET", "/raw/%ff/ab%2Fcd"))),
+        "raw:%ff,ab%2Fcd");
+    BOOST_CHECK_EQUAL(router.Handle(MakeRequest("HEAD", "/raw/x/y")).status,
+                      200);
+    BOOST_CHECK_THROW(router.Post("/raw/:a/:b",
+                                  [](const HttpRequest &, const PathParams &) {
+                                      return HttpResponse::Empty(200);
+                                  }),
+                      std::logic_error);
 }
 
 BOOST_AUTO_TEST_CASE(handler_errors) {
