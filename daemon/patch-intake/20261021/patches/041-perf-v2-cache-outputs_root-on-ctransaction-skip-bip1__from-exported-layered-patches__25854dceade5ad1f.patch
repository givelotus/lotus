From 8fe59ed570c632f3b993732ba26621efeed4d658 Mon Sep 17 00:00:00 2001
From: Lotus Developer <dev@lotus.org>
Date: Thu, 16 Apr 2026 12:00:00 +0000
Subject: [PATCH] perf(v2): cache outputs_root on CTransaction, skip BIP143
 precompute on v7 txs, and eliminate VM scan allocations

Cache m_outputs_hash on CTransaction during InitHashes(), add zero-allocation
ComputeOutputSerializedSize, skip output_leaves_ hashing when no input uses
SIGHASH_SINGLE, replace std::map field_maxima_ with std::array<size_t, 256>
in a single VM scan pass, and skip legacy BIP143 PrecomputedTransactionData
on v7 transactions.
---
 src/lotus_v2/output.h | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/lotus_v2/output.h b/src/lotus_v2/output.h
index cd17853204..98819170f5 100644
--- a/src/lotus_v2/output.h
+++ b/src/lotus_v2/output.h
@@ -27,7 +27,6 @@ struct Output {
 
     bool HasToken() const { return (flags & 1) != 0; }
     bool IsBurn() const { return (flags & 2) != 0; }
-    bool operator==(const Output &) const = default;
 };
 
 // Decode consumes exactly one output frame; any trailing byte is invalid.
