From b8b274fd917a00eaf7c8b25a52f3afd7154f49ba Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:57:59 -0700
Subject: [PATCH] fixup! chronik: offload ChronikValidationInterface callbacks
 to dedicated worker thread

Advance completed sequence only after fatal callback; protect Sync predicate as well as wake ordering.
---
 src/util/bounded_task_queue.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/util/bounded_task_queue.h b/src/util/bounded_task_queue.h
index e07be17b5d..e3d6c04574 100644
--- a/src/util/bounded_task_queue.h
+++ b/src/util/bounded_task_queue.h
@@ -54,13 +54,16 @@ class BoundedTaskQueue {
                 std::lock_guard<std::mutex> lock(m_mutex);
                 m_bytes -= task.bytes;
                 --m_count;
-                ++m_completed;
                 if (failed && !m_failed) {
                     m_failed = m_stopping = notify_failure = true;
                 }
             }
             // A completed fence must also observe the fatal notification.
             if (notify_failure) m_fail();
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                ++m_completed;
+            }
             m_drained.notify_all();
         }
     }
