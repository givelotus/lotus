From 31bacd72d49939a8b21d4edd792f12f80700514d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 07:16:12 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

Recheck the test pause flag after acquiring the consumer mutex. A worker can pass its outer check, wait for the lock, then drain after another thread has paused it. The lock-controlled regression fails with only this recheck removed and passes with it present, making paused-ring allocation and drop controls quiescent after Flush.
---
 src/logging.cpp            |  5 ++++-
 src/test/logging_tests.cpp | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/src/logging.cpp b/src/logging.cpp
index 5cbde91b40..c5a1ecafec 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -248,7 +248,10 @@ void BCLog::Logger::ThreadMain() NO_THREAD_SAFETY_ANALYSIS {
         bool busy{false};
         if (!m_paused_for_testing) {
             StdLockGuard consumer_lock(m_consumer_mutex);
-            busy = DrainLocked();
+            // A test can pause while this pass is waiting for the lock.
+            if (!m_paused_for_testing) {
+                busy = DrainLocked();
+            }
         }
         std::unique_lock<std::mutex> lock(m_wake_mutex);
         if (m_stop) {
diff --git a/src/test/logging_tests.cpp b/src/test/logging_tests.cpp
index 1b5a84c610..f56c619bf8 100644
--- a/src/test/logging_tests.cpp
+++ b/src/test/logging_tests.cpp
@@ -37,6 +37,9 @@ namespace BCLog {
 /** Test-only access: hold the consumer wake mutex while producers publish. */
 struct LoggerTestAccess {
     static StdMutex &WakeMutex(Logger &logger) { return logger.m_wake_mutex; }
+    static StdMutex &ConsumerMutex(Logger &logger) {
+        return logger.m_consumer_mutex;
+    }
     static void ResetWake(Logger &logger) { logger.m_wake_requested = false; }
 };
 } // namespace BCLog
@@ -1045,4 +1048,35 @@ BOOST_FIXTURE_TEST_CASE(logging_error_is_flushed_by_consumer, LogSetup) {
     BOOST_CHECK(content.find("consumer flush marker\n") != std::string::npos);
 }
 
+BOOST_FIXTURE_TEST_CASE(logging_pause_rechecks_consumer_lock, LogSetup) {
+    LogInstance().PauseForTesting(true);
+    LogInstance().Flush();
+    std::atomic<bool> seen{false};
+    auto callback{LogInstance().PushBackCallback([&](const std::string &line) {
+        if (line.find("paused consumer marker") != std::string::npos)
+            seen = true;
+    })};
+    {
+        std::unique_lock<StdMutex> consumer{
+            BCLog::LoggerTestAccess::ConsumerMutex(LogInstance())};
+        LogInstance().PauseForTesting(false);
+        std::thread producer{[] {
+            for (size_t i = 0; i < BCLog::LogRing::WAKE_THRESHOLD; ++i) {
+                LogPrintf("paused consumer marker\n");
+            }
+        }};
+        producer.join();
+        // Let the notified worker pass the outer pause check and block on
+        // this lock, then pause it before it can acquire the lock.
+        std::this_thread::sleep_for(std::chrono::milliseconds{100});
+        LogInstance().PauseForTesting(true);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds{50});
+    BOOST_CHECK(!seen.load());
+    LogInstance().Flush();
+    BOOST_CHECK(seen.load());
+    LogInstance().DeleteCallback(callback);
+    LogInstance().PauseForTesting(false);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
