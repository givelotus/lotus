From e8207b020835c8f49c2871ed428c2c5faed67428 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] mempool: defer block-removal overlay walks and coalesce
 snapshot updates

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Cache serialized byte size on CTransaction, batch removeForBlock Merklix overlay
erasures, and eliminate redundant ConnectTip snapshot rebuilds.

Original-Commit: 6e40636b727c24c87f8e6c1b798d59663edd64bc
Original-Patch: ecash/034
Split-Concern: overlay

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Application-Repair: Preserve the original deferred removal/rebuild algorithm and pending-removal field. Reconcile only the existing defer-depth name and retain COW changed-entry tracking and complete scope-exit flush; the current tip adapter already flushes pending changes before reanchor, so omit duplicate pre-reanchor flush code.

Plan-v2 owner repair: B4: deferred removal/re-addition reflects the final authoritative incarnation and preserves frozen epochs during live-overlay rebuild.

diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index 1823ca6d4e38699114800abeeec373e123ce9408..765d63c0f7e4f4ff7cd98dd8bdb494779c251c28 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -993,4 +993,66 @@ BOOST_AUTO_TEST_CASE(bulk_clear_matches_staged_block_removal_state) {
     BOOST_CHECK(staged == bulk);
 }
 
+BOOST_AUTO_TEST_CASE(deferred_overlay_remove_readd_matches_authoritative_pool) {
+    CTxMemPool &pool = *m_node.mempool;
+    LOCK2(cs_main, pool.cs);
+    TestMemPoolEntryHelper entry;
+    std::vector<CTransactionRef> txs;
+    for (uint32_t i = 0; i < 3; ++i) {
+        CMutableTransaction tx;
+        tx.vin.emplace_back(TxId{uint256{uint8_t(i + 1)}}, 0);
+        tx.vout.emplace_back(1000 * SATOSHI, CScript() << OP_TRUE);
+        txs.push_back(MakeTransactionRef(tx));
+        pool.addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(txs.back()));
+    }
+    const auto before = pool.GetMerklixOverlay().GetSpeculativeOverlay().GetSubtreeARoot();
+    {
+        CTxMemPool::ScopedSnapshotDefer defer(pool);
+        pool.removeRecursive(*txs[0], MemPoolRemovalReason::MANUAL);
+        pool.addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(txs[0]));
+    }
+    BOOST_CHECK_EQUAL(pool.size(), 3U);
+    const auto &spec = pool.GetMerklixOverlay().GetSpeculativeOverlay();
+    BOOST_CHECK_EQUAL(spec.GetTxCount(), pool.size());
+    BOOST_CHECK(spec.GetSubtreeARoot() == before);
+}
+
+BOOST_AUTO_TEST_CASE(deferred_overlay_randomized_operations_match_full_rebuild) {
+    CTxMemPool &pool = *m_node.mempool;
+    LOCK2(cs_main, pool.cs);
+    TestMemPoolEntryHelper entry;
+    FastRandomContext random(uint256{uint8_t(9)});
+    std::vector<CTransactionRef> txs;
+    for (uint32_t i = 0; i < 8; ++i) {
+        CMutableTransaction tx;
+        tx.vin.emplace_back(TxId{uint256{uint8_t(i + 1)}}, 0);
+        tx.vout.emplace_back(1000 * SATOSHI, CScript() << OP_TRUE);
+        txs.push_back(MakeTransactionRef(tx));
+    }
+    for (size_t round = 0; round < 64; ++round) {
+        {
+            CTxMemPool::ScopedSnapshotDefer defer(pool);
+            for (size_t op = 0; op < 8; ++op) {
+                const auto &tx = txs[random.randrange(txs.size())];
+                if (pool.exists(tx->GetId())) {
+                    pool.removeRecursive(*tx, MemPoolRemovalReason::MANUAL);
+                } else {
+                    pool.addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(tx));
+                }
+            }
+        }
+        lotus::v2::MerklixOverlayManager rebuilt;
+        std::vector<std::tuple<CTransactionRef, int64_t, int64_t>> current;
+        for (const auto &item : pool.mapTx.get<entry_id>()) {
+            current.emplace_back(item->GetSharedTx(), item->GetFee() / SATOSHI,
+                                 item->GetSigChecks());
+        }
+        AddTransactionsToOverlayBatch(rebuilt, current);
+        const auto &actual = pool.GetMerklixOverlay().GetSpeculativeOverlay();
+        const auto &expected = rebuilt.GetSpeculativeOverlay();
+        BOOST_CHECK_EQUAL(actual.GetTxCount(), expected.GetTxCount());
+        BOOST_CHECK(actual.GetSubtreeARoot() == expected.GetSubtreeARoot());
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index aa8d16f16bca503ed122471d6b7a6762aa178bdb..f91d3e74392660f6f6689f059a1a821574fbe441 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -237,8 +237,13 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     const CTransaction &tx = (*it)->GetTx();
     const TxId &txid = tx.GetId();
     MarkSnapshotEntryChanged(txid);
-    FlushPendingOverlayAdds();
-    RemoveTransactionFromOverlay(m_merklix_overlay, (*it)->GetTx());
+
+    if (m_snapshot_defer_depth > 0) {
+        m_pending_overlay_removes.push_back(txid);
+    } else {
+        FlushPendingOverlayAdds();
+        RemoveTransactionFromOverlay(m_merklix_overlay, tx);
+    }
 
     if (reason != MemPoolRemovalReason::BLOCK) {
         if (m_opts.signals) {
@@ -420,6 +425,7 @@ void CTxMemPool::_clear() {
     m_snapshot_changed_entries.clear();
     m_snapshot_needs_reset = true;
     m_pending_overlay_adds.clear();
+    m_pending_overlay_removes.clear();
     m_merklix_overlay.Clear();
     mapTx.clear();
     mapNextTx.clear();
@@ -435,10 +441,55 @@ void CTxMemPool::_clear() {
 
 void CTxMemPool::FlushPendingOverlayAdds() const {
     AssertLockHeld(cs);
-    if (m_pending_overlay_adds.empty()) return;
+    if (m_pending_overlay_adds.empty() && m_pending_overlay_removes.empty()) {
+        return;
+    }
+    if (m_pending_overlay_removes.empty()) {
+        auto pending = std::move(m_pending_overlay_adds);
+        m_pending_overlay_adds.clear();
+        AddTransactionsToOverlayBatch(m_merklix_overlay, pending);
+        return;
+    }
+    if (mapTx.empty() || m_pending_overlay_removes.size() >= mapTx.size()) {
+        m_pending_overlay_adds.clear();
+        m_pending_overlay_removes.clear();
+        // Rebuilding the live pool must not discard frozen consensus epochs.
+        auto &spec = m_merklix_overlay.GetSpeculativeOverlay();
+        spec.Reset(spec.GetParentBlockId(), spec.GetBaseUtxoRoot(),
+                   spec.GetBaseMonetaryState(), spec.GetHeight(),
+                   spec.GetParentMtp(), spec.GetLayerId());
+        std::vector<std::tuple<CTransactionRef, int64_t, int64_t>> remaining;
+        remaining.reserve(mapTx.size());
+        for (const auto &entry : mapTx.get<entry_id>()) {
+            remaining.emplace_back(entry->GetSharedTx(),
+                                   entry->GetFee() / SATOSHI,
+                                   entry->GetSigChecks());
+        }
+        AddTransactionsToOverlayBatch(m_merklix_overlay, remaining);
+        return;
+    }
+    // Remove the old identity first. Only the final mapTx incarnation of a
+    // transaction is added below, so remove->re-add and add->remove commute
+    // correctly across a deferred scope.
+    for (const TxId &txid : m_pending_overlay_removes) {
+        lotus::v2::Hash id{};
+        std::memcpy(id.data(), txid.begin(), 32);
+        m_merklix_overlay.RemoveTransaction(id);
+    }
+    m_pending_overlay_removes.clear();
     auto pending = std::move(m_pending_overlay_adds);
     m_pending_overlay_adds.clear();
-    AddTransactionsToOverlayBatch(m_merklix_overlay, pending);
+    std::vector<std::tuple<CTransactionRef, int64_t, int64_t>> current;
+    current.reserve(pending.size());
+    for (const auto &[tx, fee, sigchecks] : pending) {
+        const auto found = mapTx.find(tx->GetId());
+        if (found != mapTx.end()) {
+            current.emplace_back((*found)->GetSharedTx(),
+                                 (*found)->GetFee() / SATOSHI,
+                                 (*found)->GetSigChecks());
+        }
+    }
+    AddTransactionsToOverlayBatch(m_merklix_overlay, current);
 }
 
 const lotus::v2::MempoolOverlayLayer &CTxMemPool::FreezeEpochBatch() {
