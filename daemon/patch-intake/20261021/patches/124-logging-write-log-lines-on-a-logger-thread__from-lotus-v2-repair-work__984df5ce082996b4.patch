+            waited = waitpid(pid, &status, WNOHANG);
+            if (waited != 0) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds{10});
+        } while (std::chrono::steady_clock::now() < deadline);
+        if (waited == 0) {
+            kill(pid, SIGKILL);
+            waitpid(pid, &status, 0);
