+bool CNetAddr::IsValidWSSDomain(Span<const uint8_t> name) {
+    if (name.empty() || name.size() > ADDR_WSS_MAX_SIZE) {
+        return false;
+    }
+    size_t label_len{0};
+    for (size_t i = 0; i < name.size(); ++i) {
+        const uint8_t c{name[i]};
+        if (c == '.') {
+            if (label_len == 0 || name[i - 1] == '-') {
+                return false;
+            }
+            label_len = 0;
+            continue;
+        }
+        const bool alnum{(c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')};
+        if (!alnum && !(c == '-' && label_len > 0)) {
+            return false;
+        }
+        if (++label_len > 63) {
+            return false;
+        }
+    }
+    return label_len > 0 && name.back() != '-';
+}
+
+bool CNetAddr::SetWSSDomain(std::string_view domain) {
+    std::vector<uint8_t> name(domain.begin(), domain.end());
+    for (uint8_t &c : name) {
+        if (c >= 'A' && c <= 'Z') {
+            c = c - 'A' + 'a';
+        }
+    }
+    if (!IsValidWSSDomain(name)) {
+        return false;
+    }
+    m_net = NET_WSS;
+    m_addr.assign(name.begin(), name.end());
+    m_scope_id = 0;
+    return true;
+}
