+    }
+    BOOST_CHECK(IsWebSocketURL("wss://a"));
+    BOOST_CHECK(IsWebSocketURL("ws://a"));
+    BOOST_CHECK(!IsWebSocketURL("1.2.3.4:8333"));
+}
+
 BOOST_AUTO_TEST_SUITE_END()
