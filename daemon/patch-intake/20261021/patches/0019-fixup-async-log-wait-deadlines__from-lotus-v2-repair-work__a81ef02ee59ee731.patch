From 8ec53f4649205df4a4988e9e9d6a5afd9aa66bbc Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 03:19:34 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

Start debug-log wait deadlines after the context action. Async writes may drain just after the action returns; measuring the timeout before yield consumed the entire budget during long actions. Add deterministic mocked-clock regressions for text and byte helpers. The complete inherited extended suite reproduced four failures; all four pass after this fix on the identical daemon binary.
---
 test/functional/test_framework/log_match.py | 51 +++++++++++++++++++++
 test/functional/test_framework/test_node.py |  6 ++-
 test/functional/test_runner.py              |  1 +
 3 files changed, 56 insertions(+), 2 deletions(-)
 create mode 100644 test/functional/test_framework/log_match.py

diff --git a/test/functional/test_framework/log_match.py b/test/functional/test_framework/log_match.py
new file mode 100644
index 0000000000..a9f67b4ad0
--- /dev/null
+++ b/test/functional/test_framework/log_match.py
@@ -0,0 +1,51 @@
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from test_framework.test_node import TestNode
+
+
+class AsyncLogDeadlineTests(unittest.TestCase):
+    def exercise(self, helper, messages):
+        with tempfile.TemporaryDirectory() as directory:
+            logfile = Path(directory) / "debug.log"
+            logfile.touch()
+            clock = [0.0]
+
+            def fail(message):
+                raise AssertionError(message)
+
+            node = SimpleNamespace(
+                timeout_factor=1,
+                debug_log_path=logfile,
+                debug_log_size=lambda **kwargs: logfile.stat().st_size,
+                _raise_assertion_error=fail,
+            )
+
+            def drain(_interval):
+                logfile.write_text("expected asynchronous line\n")
+                clock[0] += 0.05
+            with (
+                patch("test_framework.test_node.time.time", lambda: clock[0]),
+                patch("test_framework.test_node.time.sleep", drain),
+            ):
+                with helper(node, messages, timeout=2):
+                    # The action takes longer than the logging wait budget.
+                    # The logger drains only after the action returns.
+                    clock[0] = 3.0
+
+    def test_assert_deadline_starts_after_action(self):
+        self.exercise(TestNode.assert_debug_log, ["expected asynchronous line"])
+
+    def test_wait_deadline_starts_after_action(self):
+        self.exercise(TestNode.wait_for_debug_log, [b"expected asynchronous line"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/test/functional/test_framework/test_node.py b/test/functional/test_framework/test_node.py
index 9c4f6a6853..c42bc587d9 100644
--- a/test/functional/test_framework/test_node.py
+++ b/test/functional/test_framework/test_node.py
@@ -629,13 +629,15 @@ class TestNode:
             raise AssertionError("Expected debug messages is empty")
         if unexpected_msgs is None:
             unexpected_msgs = []
-        time_end = time.time() + timeout * self.timeout_factor
         prev_size = self.debug_log_size(
             encoding="utf-8"
         )  # Must use same encoding that is used to read() below
 
         yield
 
+        # The action can take arbitrarily long; give the asynchronous logger
+        # its full wait budget after the action has completed.
+        time_end = time.time() + timeout * self.timeout_factor
         missing = []
         while True:
             found = True
@@ -683,12 +685,12 @@ class TestNode:
         If a chatty_callable is provided, it is repeated at every iteration.
         """
         assert chatty_callable is None or interval is not None
-        time_end = time.time() + timeout * self.timeout_factor
         # Must use same mode that is used to read() below
         prev_size = self.debug_log_size(mode="rb")
 
         yield
 
+        time_end = time.time() + timeout * self.timeout_factor
         missing: List[bytes] = []
         while True:
             found = True
