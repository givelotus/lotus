+struct StateRootDiagnostic : public CValidationInterface {
+    ChainstateManager &chainman;
+    CTxMemPool &pool;
+    const MinerTestingSetup &fixture;
+    StateRootDiagnostic(ChainstateManager &manager, CTxMemPool &mempool, const MinerTestingSetup &setup)
+        : chainman(manager), pool(mempool), fixture(setup) {}
+    void BlockChecked(const CBlock &block, const BlockValidationState &state) override {
+        if (state.GetRejectReason() != "bad-blk-stateroot") return;
+        LOCK(cs_main);
+        const auto *parent = chainman.m_blockman.LookupBlockIndex(block.hashPrevBlock);
+        if (!parent) return;
+        const uint64_t height = parent->nHeight + 1;
+        const uint64_t mtp = parent->GetMedianTimePast();
+        const auto full = ComputeV2BlockStateRoot(block, block.hashPrevBlock, height, mtp, false);
+        std::shared_ptr<const lotus::v2::SmtNode> root;
+        lotus::v2::MonetaryState monetary;
+        const bool found = GetV2BlockStateSnapshot(block.hashPrevBlock, root, monetary);
+        const auto parent_digest = lotus::v2::StateRoot(
+            GetActiveV2ChainId(), parent->nHeight, lotus::v2::SmtRoot(root), monetary);
+        uint256 parent_computed;
+        std::copy_n(parent_digest.begin(), 32, parent_computed.begin());
+        LogInfo("PARENT_DIAGNOSTIC parent=%s height=%d fixture_mtp=%d indexed_mtp=%d declared=%s loaded=%s\n",
+                parent->GetBlockHash().GetHex(), parent->nHeight,
+                fixture.GetParentMedianTimePast(block.hashPrevBlock), mtp,
+                parent->GetBlockHeader().hashStateRoot.GetHex(), parent_computed.GetHex());
+        LOCK(pool.cs);
+        const auto &manager = pool.GetMerklixOverlay();
+        const auto &overlay = manager.GetSpeculativeOverlay();
+        const auto fast = ComputeV2StateRootFromOverlay(*block.vtx[0], overlay, block.nBits, height, mtp);
+        lotus::v2::Hash parent_id{};
+        std::copy_n(block.hashPrevBlock.begin(), 32, parent_id.begin());
+        LogInfo("ROOT_DIAGNOSTIC block=%s height=%d declared=%s full=%s overlay=%s txs=%d anchored=%d parent_found=%d base_match=%d parent_ema=%d overlay_ema=%d\n",
+                block.GetHash().GetHex(), height, block.hashStateRoot.GetHex(), full.GetHex(), fast.GetHex(),
+                overlay.GetTxCount(), manager.IsAnchoredAt(parent_id, height, mtp), found,
+                overlay.GetBaseUtxoRoot() == root, monetary.ema_block_cost,
+                overlay.GetBaseMonetaryState().ema_block_cost);
+    }
+};
