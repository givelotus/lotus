From 4ddf60874b8f6d38adcd735b64214c20d1e861e0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 21:33:05 -0700
Subject: [PATCH] test: fix TLS unit tests and the proxy test on Linux

- OpenSSL's socket BIO writes with write(), which raises SIGPIPE on Linux
  once the peer has closed (macOS sockets here set SO_NOSIGPIPE). The node
  ignores SIGPIPE in AppInitBasicSetup; the TLS unit test suites now do
  too, instead of being killed when one end closes before the other.
- The test SOCKS5 proxy stopped with close() only. On Linux that neither
  wakes the thread blocked in accept() nor stops the socket listening, so
  the "dead proxy" kept forwarding; shut it down first.
---
 src/net_websocket_tls.h                |  4 ++++
 src/test/httpserver_tests.cpp          | 19 ++++++++++++++++++-
 src/test/net_websocket_tests.cpp       | 19 ++++++++++++++++++-
 test/functional/p2p_websocket_proxy.py |  9 +++++++++
 4 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/src/net_websocket_tls.h b/src/net_websocket_tls.h
index 054d7b904f..cfbeaf5e87 100644
--- a/src/net_websocket_tls.h
+++ b/src/net_websocket_tls.h
@@ -14,6 +14,10 @@
  * SSL_OP_ENABLE_KTLS), OpenSSL offloads record encryption to the kernel
  * behind the same calls.
  *
+ * OpenSSL's socket BIO writes with write(), not send(MSG_NOSIGNAL): a write
+ * after the peer closed raises SIGPIPE on Linux, which the node ignores
+ * (AppInitBasicSetup). A custom BIO would avoid that but lose kernel TLS.
+ *
  * The handshake has completed before the layer is constructed.
  */
 class TlsByteLayer final : public WebSocketByteLayer {
diff --git a/src/test/httpserver_tests.cpp b/src/test/httpserver_tests.cpp
index 8f6b563315..8ad1b5b80d 100644
--- a/src/test/httpserver_tests.cpp
+++ b/src/test/httpserver_tests.cpp
@@ -11,6 +11,8 @@
 
 #include <boost/test/unit_test.hpp>
 
+#include <csignal>
+
 #include <boost/asio/as_tuple.hpp>
 #include <boost/asio/co_spawn.hpp>
 #include <boost/asio/detached.hpp>
@@ -27,7 +29,22 @@
 
 #include <thread>
 
-BOOST_FIXTURE_TEST_SUITE(httpserver_tests, BasicTestingSetup)
+namespace {
+/**
+ * OpenSSL writes to sockets with write(), which raises SIGPIPE once the peer
+ * has closed. The node ignores SIGPIPE at startup (AppInitBasicSetup); do
+ * the same here, where tests close one end before the other.
+ */
+struct HTTPServerTestingSetup : BasicTestingSetup {
+    HTTPServerTestingSetup() {
+#ifndef WIN32
+        signal(SIGPIPE, SIG_IGN);
+#endif
+    }
+};
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(httpserver_tests, HTTPServerTestingSetup)
 
 BOOST_AUTO_TEST_CASE(test_query_parameters) {
     std::string uri{};
diff --git a/src/test/net_websocket_tests.cpp b/src/test/net_websocket_tests.cpp
index 80fdadac10..202fa4295d 100644
--- a/src/test/net_websocket_tests.cpp
+++ b/src/test/net_websocket_tests.cpp
@@ -16,6 +16,8 @@
 
 #include <boost/test/unit_test.hpp>
 
+#include <csignal>
+
 #include <cerrno>
 #include <chrono>
 #include <cstring>
@@ -161,7 +163,22 @@ struct RawPeer {
 };
 } // namespace
 
-BOOST_FIXTURE_TEST_SUITE(net_websocket_tests, BasicTestingSetup)
+namespace {
+/**
+ * OpenSSL writes to sockets with write(), which raises SIGPIPE once the peer
+ * has closed. The node ignores SIGPIPE at startup (AppInitBasicSetup); do
+ * the same here, where tests close one end before the other.
+ */
+struct WebSocketTestingSetup : BasicTestingSetup {
+    WebSocketTestingSetup() {
+#ifndef WIN32
+        signal(SIGPIPE, SIG_IGN);
+#endif
+    }
+};
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(net_websocket_tests, WebSocketTestingSetup)
 
 BOOST_AUTO_TEST_CASE(roundtrip_all_modes_and_sizes) {
     FastRandomContext rng{/*fDeterministic=*/true};
diff --git a/test/functional/p2p_websocket_proxy.py b/test/functional/p2p_websocket_proxy.py
index df5f06b40e..adddd1d55c 100644
--- a/test/functional/p2p_websocket_proxy.py
+++ b/test/functional/p2p_websocket_proxy.py
@@ -36,6 +36,9 @@ class ForwardingSocks5Proxy:
                 conn, _ = self.server.accept()
             except OSError:
                 return
+            if not self.running:
+                conn.close()
+                return
             threading.Thread(target=self.handle, args=(conn,), daemon=True).start()
 
     @staticmethod
@@ -88,6 +91,12 @@ class ForwardingSocks5Proxy:
 
     def stop(self):
         self.running = False
+        # On Linux, close() alone neither wakes a thread blocked in accept()
+        # nor stops the socket listening; shutdown() does both.
+        try:
+            self.server.shutdown(socket.SHUT_RDWR)
+        except OSError:
+            pass
         self.server.close()
 
 
