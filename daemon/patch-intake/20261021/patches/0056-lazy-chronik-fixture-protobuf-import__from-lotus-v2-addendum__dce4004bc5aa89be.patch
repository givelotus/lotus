From bfd6de4466ce26a736a94a03a8e2705546479ee4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 01:43:17 -0700
Subject: [PATCH] fixup! test(v2): regenerate chain fixtures for the
 legacy-coinbase regtest chain

Keep the independently checked native genesis output constant importable before test framework setup. Load generated protobuf code only when building the protobuf fixture, after the profile module path is configured. This repairs the new module-level canonical genesis constant imports without adding path shims.

Tier: V2 (fixup to test(v2): regenerate chain fixtures for the legacy-coinbase regtest chain)
---
 .../functional/test_framework/chronik/test_data.py | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/test/functional/test_framework/chronik/test_data.py b/test/functional/test_framework/chronik/test_data.py
index 3a15fa484a..3fb6314d98 100644
--- a/test/functional/test_framework/chronik/test_data.py
+++ b/test/functional/test_framework/chronik/test_data.py
@@ -9,15 +9,23 @@ from test_framework.blocktools import (
     GENESIS_CB_TXID,
     TIME_GENESIS_BLOCK,
 )
-from test_framework.chronik.client import pb
-from test_framework.messages import lotus_v2_branch_leaf, _lotus_v2_encode_output
+from test_framework.messages import _lotus_v2_encode_output, lotus_v2_branch_leaf
 
 GENESIS_NATIVE_OUTPUT = _lotus_v2_encode_output(
-    (0, 5000000000, bytes(32), [lotus_v2_branch_leaf(bytes(GENESIS_CB_SCRIPT_PUBKEY))], [[0]])
+    (
+        0,
+        5000000000,
+        bytes(32),
+        [lotus_v2_branch_leaf(bytes(GENESIS_CB_SCRIPT_PUBKEY))],
+        [[0]],
+    )
 )
 
 
 def genesis_cb_tx():
+    # Framework setup adds the profile-specific generated protobuf module path.
+    from test_framework.chronik.client import pb
+
     return pb.Tx(
         txid=bytes.fromhex(GENESIS_CB_TXID)[::-1],
         version=7,
