 snapshots

---
 src/rpc/blockchain.cpp               |  7 ++++++-
 src/test/rpc_snapshot_read_tests.cpp | 24 ++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/rpc/blockchain.cpp b/src/rpc/blockchain.cpp
index cf0698e825..ac21772f56 100644
--- a/src/rpc/blockchain.cpp
+++ b/src/rpc/blockchain.cpp
@@ -662,7 +662,12 @@ static RPCHelpMan getblockheader() {
             ChainstateManager &chainman = EnsureAnyChainman(request.context);
             auto snap = LoadOrInitChainSnapshot(request.context, chainman);
             if (snap && snap->active_chain) {
-                if (const auto *hdr = snap->active_chain->FindByHash(hash)) {
+                // A headers-only snapshot can predate background block
+                // download without an active-tip change. Recheck its mutable
+                // nTx under cs_main; complete snapshots and raw headers keep
+                // the lock-independent path.
+                if (const auto *hdr = snap->active_chain->FindByHash(hash);
+                    hdr && (!fVerbose || hdr->nTx != 0)) {
                     if (!fVerbose) {
                         DataStream ssBlock{};
                         ssBlock << hdr->header;
diff --git a/src/test/rpc_snapshot_read_tests.cpp b/src/test/rpc_snapshot_read_tests.cpp
index d8ed21085d..1cea7e14e9 100644
--- a/src/test/rpc_snapshot_read_tests.cpp
+++ b/src/test/rpc_snapshot_read_tests.cpp
@@ -37,6 +37,30 @@
 
 BOOST_FIXTURE_TEST_SUITE(rpc_snapshot_read_tests, TestChain100Setup)
 
+BOOST_AUTO_TEST_CASE(header_only_snapshot_rechecks_new_block_metadata) {
+    auto &manager = *m_node.chainman;
+    BlockHash hash;
+    unsigned int expected;
+    {
+        LOCK(::cs_main);
+        auto *index = manager.ActiveChain()[50];
+        hash = index->GetBlockHash();
+        expected = index->nTx;
+        // Capture the headers-only state before background download fills the
+        // mutable block index, without changing the active chain's tip.
+        index->nTx = 0;
+        node::PublishChainTipSnapshot(manager, m_node.mempool.get());
+        index->nTx = expected;
+    }
+    JSONRPCRequest request;
+    request.context = &m_node;
+    request.strMethod = "getblockheader";
+    request.params = UniValue(UniValue::VARR);
+    request.params.push_back(hash.GetHex());
+    const auto result = tableRPC.execute(GlobalConfig{}, request);
+    BOOST_CHECK_EQUAL(result["nTx"].getInt<int>(), expected);
+}
+
