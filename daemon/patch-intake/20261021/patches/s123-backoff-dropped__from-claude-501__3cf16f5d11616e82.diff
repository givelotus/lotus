@@ -336,6 +336,16 @@ def ensure_for(*, duration, f, check_interval=0.2):
         time.sleep(check_interval)
 
 
+def backoff_intervals(initial=0.01, maximum=1.0):
+    """Sleep intervals for polling: start at `initial` seconds and double up
+    to `maximum`. Conditions that become true quickly are noticed quickly,
+    without polling slow ones more often than every `maximum` seconds."""
+    interval = min(initial, maximum)
+    while True:
+        yield interval
+        interval = min(interval * 2, maximum)
+
