From a6dee9c9f417649e79721b095641fdcc72b9d259 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 12:28:47 -0700
Subject: [PATCH] build: disable ZeroMQ by default without removing its
 implementation

Keep the existing notification source, RPC, command-line configuration and dependency recipe available for users who explicitly configure BUILD_BITCOIN_ZMQ=ON. Change only the default build choice to OFF, independent of mining, mempool and NNG candidates. This is the first of two review patches; the following optional patch removes the interface and its source entirely. No performance improvement is claimed. Acceptance base: abd433abe04f74780744b9eac06731f3690ce68a.
---
 src/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 2aec803d3..6b9db3972 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -13,5 +13,5 @@ set(CMAKE_CXX_VISIBILITY_PRESET hidden)
 option(BUILD_BITCOIN_DAEMON "Build bitcoind" ON)
 option(BUILD_BITCOIN_WALLET "Activate the wallet functionality" ON)
-option(BUILD_BITCOIN_ZMQ "Activate the ZeroMQ functionalities" ON)
+option(BUILD_BITCOIN_ZMQ "Activate the ZeroMQ functionalities" OFF)
 option(BUILD_BITCOIN_CLI "Build bitcoin-cli" ON)
 option(BUILD_BITCOIN_TX "Build bitcoin-tx" ON)
-- 
