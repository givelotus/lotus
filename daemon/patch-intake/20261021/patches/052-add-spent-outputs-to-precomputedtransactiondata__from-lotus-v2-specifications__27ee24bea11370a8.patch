+template <class T>
+PrecomputedTransactionData
+PrecomputedTransactionData::FromCoinsView(const T &tx,
+                                          const CCoinsView &coins_view) {
+    std::vector<CTxOut> spent_outputs;
+    spent_outputs.reserve(tx.vin.size());
