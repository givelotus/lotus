+            // Created earlier, or elsewhere in the same block (which may be
+            // in canonical, not topological, order).
+            coin->creation.height > tx->location.height ||
+            (coin->creation.height == tx->location.height &&
+             coin->creation.tx_index == tx->location.tx_index)) {
             ThrowCorrupt();
         }
     }
