From 84e47e42f7e1c41600234b877e24a961e9a5c85f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:27:51 -0700
Subject: [PATCH] fixup! script: implement legacy Schnorr batch MSM and
 signature-cache integration

Distinguish block consensus checks from mempool policy checks in the parallel resolved-coin script verifier. Block callers apply the supplied consensus flags and report the first actual script failure as mandatory; mempool callers retain the existing standardness fallback and classification.

The inherited CLTV control correctly rejected Negative locktime but the parallel block path labelled that block failure non-mandatory after retrying with CLTV stripped. Its original mandatory block-error assertion now passes, while its original non-mandatory mempool assertion still passes. BIP68 and the real four-wallet-family control also pass. Acceptance rules and script flags remain unchanged.

Tier: ECASH
---
 src/validation.cpp | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/validation.cpp b/src/validation.cpp
index 50cac4703f..ea25d82aee 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -423,7 +423,7 @@ std::optional<ParallelTxScriptError> VerifyTxScriptsFromResolvedCoins(
     int &nSigChecksOut, TxSigCheckLimiter &txLimitSigChecks,
     CheckInputsLimiter *pBlockLimitSigChecks,
     lotus::v2::BatchSigCollector *sig_collector,
-    bool *produced_records = nullptr) {
+    bool *produced_records = nullptr, bool consensus_only = false) {
     assert(!tx.IsCoinBase());
     assert(resolved_inputs.size() == tx.vin.size());
     if (produced_records) *produced_records = false;
@@ -555,7 +555,9 @@ std::optional<ParallelTxScriptError> VerifyTxScriptsFromResolvedCoins(
             }
             uint32_t mandatoryFlags =
                 flags & ~STANDARD_NOT_MANDATORY_VERIFY_FLAGS;
-            if (flags != mandatoryFlags) {
+            // Block flags are consensus requirements. The policy fallback is
+            // only meaningful for mempool checks that add standardness flags.
+            if (!consensus_only && flags != mandatoryFlags) {
                 CScriptCheck check2(prev_txout, tx, signature_cache, i,
                                     mandatoryFlags, sigCacheStore, txdata,
                                     nullptr, nullptr, v2_resolved_coins,
@@ -5037,7 +5039,8 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
                     tx, resolved_inputs, flags, fCacheResults, txdata,
                     m_chainman.m_validation_cache.m_signature_cache,
                     tx_sigchecks[k], nSigChecksTxLimiters[t_idx],
-                    &nSigChecksBlockLimiter, &local_sigs, &tx_produced[k]);
+                    &nSigChecksBlockLimiter, &local_sigs, &tx_produced[k],
+                    /*consensus_only=*/true);
                 if (err.has_value()) {
                     tx_errors[k] = std::move(err);
                     size_t prev = min_failed_p.load(std::memory_order_relaxed);
@@ -5078,7 +5081,8 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
                 /*cache_results=*/false, tx.GetPrecomputedData(),
                 m_chainman.m_validation_cache.m_signature_cache,
                 dummy_sigchecks, dummy_tx_limiter, &dummy_block_limiter,
-                /*sig_collector=*/nullptr);
+                /*sig_collector=*/nullptr, /*produced_records=*/nullptr,
+                /*consensus_only=*/true);
         };
 
         const bool pool_failed = min_failed_p.load() < n_pool;
