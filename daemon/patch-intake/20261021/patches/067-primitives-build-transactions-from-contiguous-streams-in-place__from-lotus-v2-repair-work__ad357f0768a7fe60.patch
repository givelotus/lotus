From b14eb0bfabccbd105eaf2190ac62d026fbf85753 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 20:33:08 -0700
Subject: [PATCH] primitives: build transactions from contiguous streams in
 place

Every deserialized CTransaction first copied its bytes into a per-thread
scratch buffer, then copied them again into its own storage. When the
stream already holds its unread bytes in one buffer, as DataStream does for
P2P messages and SpanReader does for in-memory blocks, the first copy is
unnecessary.

For such streams, ScanTransactionWire checks the transaction's structure
where it lies, with the same ReadCompactSize calls and limits as
ReadTransactionWire, and the transaction is built from those bytes. The
stream is advanced only after the transaction has been built, because
DataStream::ignore releases its buffer when it reaches the end. Other
streams (files, hashing readers) keep the scratch-buffer path.

SpanReader gains data() and ignore(), matching DataStream, so it takes
this path as well.

Block 413567 deserializes about 6% faster with software SHA-256 (about
150 us of 2.5 ms per block); the saving does not depend on hashing.

Tests: SpanReader, DataStream and a read-only stream accept and reject
the same truncated, trailing, non-canonical and oversized inputs as
CMutableTransaction; contiguous streams leave the scratch buffer
untouched, consume exactly the transaction, and the result does not
refer to the stream's bytes.
---
 src/primitives/transaction.cpp | 44 ++++++++++++++-
 src/primitives/transaction.h   | 41 ++++++++++++--
 src/streams.h                  |  9 ++++
 src/test/transaction_tests.cpp | 98 +++++++++++++++++++++++++++++-----
 4 files changed, 175 insertions(+), 17 deletions(-)

diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index 6336a9c777..7c7554af28 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -304,6 +304,47 @@ void DeallocateTransactionStorage(void *p, size_t bytes) noexcept {
     DeallocateStorage(p, bytes);
 }
 
+TransactionWire ScanTransactionWire(Span<const uint8_t> bytes) {
+    size_t pos = 0;
+    auto skip = [&](uint64_t count) {
+        if (count > bytes.size() - pos) {
+            throw std::ios_base::failure("ScanTransactionWire(): end of data");
+        }
+        pos += count;
+    };
+    auto read_compact_size = [&]() {
+        SpanReader reader{bytes.subspan(pos)};
+        const uint64_t n = ReadCompactSize(reader);
+        pos = bytes.size() - reader.size();
+        return n;
+    };
+    TransactionWire wire;
+    auto skip_script = [&]() {
+        const uint64_t size = read_compact_size();
+        if (IsLongScript(size)) {
+            wire.long_script_bytes += size;
+        }
+        skip(size);
+    };
+    skip(sizeof(uint32_t));
+    const uint64_t n_inputs = read_compact_size();
+    for (uint64_t i = 0; i < n_inputs; ++i) {
+        skip(sizeof(uint256) + sizeof(uint32_t));
+        skip_script();
+        skip(sizeof(uint32_t));
+    }
+    const uint64_t n_outputs = read_compact_size();
+    for (uint64_t i = 0; i < n_outputs; ++i) {
+        skip(sizeof(int64_t));
+        skip_script();
+    }
+    skip(sizeof(uint32_t));
+    wire.bytes = bytes.first(pos);
+    wire.n_inputs = n_inputs;
+    wire.n_outputs = n_outputs;
+    return wire;
+}
+
 size_t CTransaction::StorageSize(const TransactionWire &wire) {
     return Offsets(wire.n_inputs, wire.n_outputs, wire.long_script_bytes).total;
 }
@@ -368,7 +409,8 @@ CTransaction::Layout CTransaction::Place(const TransactionWire &wire,
     layout.vout = {
         std::launder(reinterpret_cast<const CTxOut *>(base + offsets.vout)),
         wire.n_outputs};
-    // Hash now: the serialization is not kept.
+    // Hash now: the serialization is not kept, and a contiguous stream may
+    // release it as soon as this returns.
     layout.hash = HashSerialization(bytes);
     layout.serialize_size = bytes.size();
     layout.long_script_bytes = wire.long_script_bytes;
diff --git a/src/primitives/transaction.h b/src/primitives/transaction.h
index f3e5832e9b..f790bcd887 100644
--- a/src/primitives/transaction.h
+++ b/src/primitives/transaction.h
@@ -15,6 +15,7 @@
 #include <span.h>
 
 #include <atomic>
+#include <concepts>
 #include <cstddef>
 #include <memory>
 #include <vector>
@@ -247,6 +248,20 @@ constexpr bool IsLongScript(uint64_t size) {
 /** Per-thread scratch buffer for serialized transaction bytes. */
 std::vector<uint8_t> &TransactionScratchBuffer();
 
+/**
+ * Find the serialized transaction at the start of bytes, checking its
+ * structure exactly like ReadTransactionWire, without copying it.
+ */
+TransactionWire ScanTransactionWire(Span<const uint8_t> bytes);
+
+/** Streams whose unread bytes are contiguous in memory, such as DataStream. */
+template <typename Stream>
+concept ContiguousReadStream = requires(Stream &s, size_t n) {
+    { UCharCast(s.data()) } -> std::convertible_to<const uint8_t *>;
+    { s.size() } -> std::convertible_to<size_t>;
+    s.ignore(n);
+};
+
 /**
  * Read one serialized transaction from s into buf, checking its structure
  * exactly like CMutableTransaction deserialization does. buf is reused, so
@@ -306,6 +321,24 @@ TransactionWire ReadTransactionWire(Stream &s, std::vector<uint8_t> &buf) {
     return wire;
 }
 
+/**
+ * Read one serialized transaction from s and return build(wire). Bytes of a
+ * contiguous stream are used where they are, and only consumed once build
+ * has returned; other streams are read into the per-thread scratch buffer.
+ */
+template <typename Stream, typename Build>
+auto ReadTransactionWith(Stream &s, Build &&build) {
+    if constexpr (ContiguousReadStream<Stream>) {
+        const TransactionWire wire =
+            ScanTransactionWire({UCharCast(s.data()), size_t(s.size())});
+        auto result = build(wire);
+        s.ignore(wire.bytes.size());
+        return result;
+    } else {
+        return build(ReadTransactionWire(s, TransactionScratchBuffer()));
+    }
+}
+
 /**
  * The basic transaction that is broadcasted on the network and contained in
  * blocks. A transaction can contain multiple inputs and outputs.
@@ -368,8 +401,7 @@ public:
      */
     template <typename Stream>
     CTransaction(deserialize_type, Stream &s)
-        : CTransaction(OwnedLayout(
-              ReadTransactionWire(s, TransactionScratchBuffer()))) {}
+        : CTransaction(ReadTransactionWith(s, &CTransaction::OwnedLayout)) {}
 
     bool IsNull() const { return vin.empty() && vout.empty(); }
 
@@ -584,8 +616,9 @@ CTransactionRef MakeTransactionRef(const CMutableTransaction &tx);
  */
 template <> struct SharedPtrDeserializer<CTransaction> {
     template <typename Stream> static CTransactionRef Make(Stream &s) {
-        return MakeTransactionRef(
-            ReadTransactionWire(s, TransactionScratchBuffer()));
+        return ReadTransactionWith(s, [](const TransactionWire &wire) {
+            return MakeTransactionRef(wire);
+        });
     }
 };
 
