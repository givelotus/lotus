 src/httpmetrics.cpp                       |  4 +++-
 src/node/metrics.cpp                      |  5 +++++
 src/node/metrics.h                        |  6 +++--
 src/util/threadnames.cpp                  |  5 +++++
 test/functional/interface_http_metrics.py |  1 +
 6 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/src/bench/metrics.cpp b/src/bench/metrics.cpp
