+    std::string method;
+    //! Target with the /chronik prefix stripped (starts with '/')
+    std::string target;
+    std::vector<std::pair<std::string, std::string>> headers;
+    std::string body;
+    //! Real client address, without port
+    std::string peer_ip;
+};
