From cc8a5cfd808e8e37172312a56f9102056bd10b71 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:46:17 -0700
Subject: [PATCH] test: ignore the placeholder-genesis warning when checking
 stderr

v2/062 makes mainnet and testnet nodes print a placeholder-genesis
warning on every start. Tests that compare stderr, such as
feature_config_args (acceptnonstdtxn on main) and testnet nodes in
p2p_dos_header_tree, saw that line before or instead of the output they
expected. The framework now drops exactly that line before comparing.
Other warnings are still compared.

Tier: V2 (fixup to v2/062)
---
 test/functional/test_framework/test_node.py | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/test/functional/test_framework/test_node.py b/test/functional/test_framework/test_node.py
index 1de058bf64..83804135df 100644
--- a/test/functional/test_framework/test_node.py
+++ b/test/functional/test_framework/test_node.py
@@ -56,6 +56,19 @@ class ErrorMatch(Enum):
     PARTIAL_REGEX = 3
 
 
+# Mainnet and testnet start with a placeholder V2 genesis and warn about it on
+# stderr every time. Tests that check stderr compare what follows it.
+PLACEHOLDER_GENESIS_WARNING = (
+    "Warning: This network uses a placeholder Lotus V2 genesis block. Its "
+    "chain will be discarded when Lotus V2 launches."
+)
+
+
+def strip_placeholder_genesis_warning(stderr):
+    lines = [line for line in stderr.splitlines() if line != PLACEHOLDER_GENESIS_WARNING]
+    return "\n".join(lines).strip()
+
+
 class TestNode:
     """A class for representing a bitcoind node under test.
 
@@ -568,7 +581,9 @@ class TestNode:
         )
         # Check that stderr is as expected
         self.stderr.seek(0)
-        stderr = self.stderr.read().decode("utf-8").strip()
+        stderr = strip_placeholder_genesis_warning(
+            self.stderr.read().decode("utf-8")
+        )
         if stderr != expected_stderr:
             raise AssertionError(f"Unexpected stderr {stderr} != {expected_stderr}")
 
@@ -866,7 +881,9 @@ class TestNode:
                 # Check stderr for expected message
                 if expected_msg is not None:
                     log_stderr.seek(0)
-                    stderr = log_stderr.read().decode("utf-8").strip()
+                    stderr = strip_placeholder_genesis_warning(
+                        log_stderr.read().decode("utf-8")
+                    )
                     if match == ErrorMatch.PARTIAL_REGEX:
                         if re.search(expected_msg, stderr, flags=re.MULTILINE) is None:
                             self._raise_assertion_error(
-- 
