-
-bool Start(const ArgsManager &args, const Config &config,
-           const node::NodeContext &node, bool fWipe) {
-    util::Result<chronik_bridge::SetupParams> params =
-        ParseChronikParams(args, config, fWipe);
-    if (!params) {
-        return InitError(ErrorString(params));
-    }
-    return chronik_bridge::setup_chronik(*params, node);
+bool Start(const ArgsManager &args, const Config &config, const ::NodeContext &node, bool wipe) {
+    const Options options = ReadOptions(args);
+    const std::string network = config.GetChainParams().NetworkIDString();
+    if (network != "main" && network != "test" && network != "regtest") {
+        return InitError("This Chronik BCHN profile supports main, test and regtest only");
+    }
+    if (options.token_index) {
+        return InitError(
+            "CashTokens-aware Chronik indexing is not implemented; raw token bytes are preserved");
+    }
+    chronik_bridge::SetupParams params{};
+    params.net = network == "main"   ? chronik_bridge::Net::Mainnet
+                 : network == "test" ? chronik_bridge::Net::Testnet
+                                     : chronik_bridge::Net::Regtest;
+    params.datadir = GetDataDir(false).string();
+    params.datadir_net = GetDataDir().string();
+    for (const auto &host : options.binds)
+        params.hosts.push_back(host);
+    params.default_port = network == "regtest" ? 18440 : network == "test" ? 18331 : 8331;
+    params.wipe_db = wipe;
+    params.enable_token_index = false;
+    params.enable_lokad_id_index = true;
+    params.enable_scripthash_index = options.script_hash_index;
+    params.is_pause_allowed = false;
+    params.enable_perf_stats = false;
+    params.ws_ping_interval_secs = network == "regtest" ? 5 : 45;
+    params.enable_cors = options.cors;
+    params.tx_num_cache = {DEFAULT_TX_NUM_CACHE_BUCKETS, DEFAULT_TX_NUM_CACHE_BUCKET_SIZE};
+    params.electrum_default_port = 50001;
+    params.electrum_default_protocol = 't';
+    params.electrum_max_history = DEFAULT_ELECTRUM_MAX_HISTORY;
+    params.max_subs = DEFAULT_MAX_SUBS;
+    params.max_subs_per_ip = DEFAULT_MAX_SUBS_PER_IP;
+    params.subscription_max_script_size = DEFAULT_SUBSCRIPTION_MAX_SCRIPT_SIZE;
+    params.subscription_max_plugin_size = DEFAULT_SUBSCRIPTION_MAX_PLUGIN_SIZE;
+    return chronik_bridge::setup_chronik(std::move(params), node);
 }
