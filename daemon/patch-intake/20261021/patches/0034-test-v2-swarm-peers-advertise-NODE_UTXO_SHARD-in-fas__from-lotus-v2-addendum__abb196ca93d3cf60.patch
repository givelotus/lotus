From c97cda0ab81a1d0f651a2b79f5253641f4fd1d67 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 16:06:12 -0700
Subject: test(v2): swarm peers advertise NODE_UTXO_SHARD in fast-sync test

syncutxoshardswarm only asks peers whose version message advertised
NODE_UTXO_SHARD (PeerSupportsUtxoShardsLocked reads the services recorded
by SetPeerServices). The test's two SwarmServerPeer connections used the
framework default NODE_NETWORK, so the RPC failed with "no NODE_UTXO_SHARD
capable peers available". Connect them with P2P_SERVICES | NODE_UTXO_SHARD.
The node's selection rule is unchanged.

Tier: V2 (fixup to v2/038 fast_sync(v2): adapt 256-shard UTXO SnapSync and
reverse peel to V2 header state_root)
---
 .../functional/p2p_v2_fast_sync_and_reverse_peel.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/test/functional/p2p_v2_fast_sync_and_reverse_peel.py b/test/functional/p2p_v2_fast_sync_and_reverse_peel.py
index 102b235825..13c707bb16 100755
--- a/test/functional/p2p_v2_fast_sync_and_reverse_peel.py
+++ b/test/functional/p2p_v2_fast_sync_and_reverse_peel.py
@@ -9,6 +9,7 @@ Forward Block Mining on a Fast-Synced Node, and Bijective Reverse Block Peeling
 """
 
 from test_framework.messages import (
+    NODE_UTXO_SHARD,
     COutPoint,
     CTransaction,
     CTxIn,
@@ -21,7 +22,7 @@ from test_framework.messages import (
     msg_utxoroots,
     msg_utxoshard,
 )
-from test_framework.p2p import P2PInterface, p2p_lock
+from test_framework.p2p import P2P_SERVICES, P2PInterface, p2p_lock
 from test_framework.test_framework import BitcoinTestFramework
 from test_framework.util import (
     assert_equal,
@@ -88,6 +89,10 @@ class FastSyncPeer(P2PInterface):
         self.blockundos[message.block_id] = message
 
 
+# The node only asks peers that advertise NODE_UTXO_SHARD for shards.
+SWARM_PEER_SERVICES = P2P_SERVICES | NODE_UTXO_SHARD
+
+
 class SwarmServerPeer(P2PInterface):
     """P2P peer that serves UTXOROOTS and UTXOSHARD messages to a syncing node,
     with optional adversarial corruption of a target shard (e.g. shard 0x3F).
@@ -348,12 +353,14 @@ class FastSyncAndReversePeelTest(BitcoinTestFramework):
         peer_bad = node2.add_p2p_connection(
             SwarmServerPeer(
                 roots_msg.raw_payload, shards_by_key, corrupt_shard_bits=0x3F
-            )
+            ),
+            services=SWARM_PEER_SERVICES,
         )
         peer_good = node2.add_p2p_connection(
             SwarmServerPeer(
                 roots_msg.raw_payload, shards_by_key, corrupt_shard_bits=None
-            )
+            ),
+            services=SWARM_PEER_SERVICES,
         )
         # Hold peer_good's responses briefly so peer_bad can inject corrupted shard 0x3F
         # while (8, 0x3F) is in flight in the swarm coordinator.
