From 1da06cfbc0bb9967fbf5b6789b3b507bd4d9bb85 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Fri, 22 Nov 2024 19:35:20 +0100
Subject: [PATCH] [Dogecash] Change message magic to "Dogecoin Signed Message"
 (#77)

Dogecoin uses a different message magic, so let's use that.

diff --git a/src/common/signmessage.cpp b/src/common/signmessage.cpp
index 5e92af37e83d7e8616016b7ae8daa932ba07a2c1..40e945ab0a00ab14cb002951337f8db2940f44d7 100644
--- a/src/common/signmessage.cpp
+++ b/src/common/signmessage.cpp
@@ -20,7 +20,7 @@
  * Text used to signify that a signed message follows and to prevent
  * inadvertently signing a transaction.
  */
-const std::string MESSAGE_MAGIC = "eCash Signed Message:\n";
+const std::string MESSAGE_MAGIC = "Dogecoin Signed Message:\n";
 
 MessageVerificationResult MessageVerify(const CChainParams &params,
                                         const std::string &address,
diff --git a/src/test/util_tests.cpp b/src/test/util_tests.cpp
index 5b01c64719537ff0edd60735c51fe9826a4a5c2e..30d8d96524df976912251ba1eea3f83a4d3cfe8b 100644
--- a/src/test/util_tests.cpp
+++ b/src/test/util_tests.cpp
@@ -3071,8 +3071,8 @@ BOOST_AUTO_TEST_CASE(message_sign) {
     const std::string message = "Trust no one";
 
     const std::string expected_signature =
-        "H3CcyS18y471Ya5WTYAke25spvA5eyBMvAuNhxDkuAjsdNGX+"
-        "NoouNlY1KoselGvF65Werf7OdtKAoOZ9WB17Rc=";
+        "H8p7fTCDAg2VDPzIDhT+jNiZUXNiaWlLMBVR13vXqy9TKb/yehZ3uCFnf1bZZ/tj/"
+        "VeU0u6pUofUVexgntYq2Hw=";
 
     CKey privkey;
     std::string generated_signature;
@@ -3128,15 +3128,15 @@ BOOST_AUTO_TEST_CASE(message_verify) {
 
     BOOST_CHECK_EQUAL(
         MessageVerify(*params, "D9LXVWacjEAqsWLXrsmrUFoWc8MdPuYuMP",
-                      "H3CcyS18y471Ya5WTYAke25spvA5eyBMvAuNhxDkuAjsdNGX+"
-                      "NoouNlY1KoselGvF65Werf7OdtKAoOZ9WB17Rc=",
+                      "H8p7fTCDAg2VDPzIDhT+jNiZUXNiaWlLMBVR13vXqy9TKb/"
+                      "yehZ3uCFnf1bZZ/tj/VeU0u6pUofUVexgntYq2Hw=",
                       "Trust no one"),
         MessageVerificationResult::OK);
 
     BOOST_CHECK_EQUAL(
         MessageVerify(*params, "DSwQQ4pXFo5cCCUW37ScqLnujf9XTqAFvn",
-                      "HxO6qEsMrNvPA7QTMUbdzF/uXbW78yPG6gFITses9XVvMdBULIFwrfhN"
-                      "f196N+rxnK5eSl8eF3aKe4INunzFJXg=",
+                      "IJCinOadYbCcS7NoQ6mRYyiLk3zSHkSc/"
+                      "ers6VdsBrPKaFyrvesK8ztXyxQdeYkCvUcTu4aHCwlVOkFw38h4S7E=",
                       "Trust me"),
         MessageVerificationResult::OK);
 }
