     return registry;
 }
 
+// ---------------------------------------------------------------------------
+
+namespace {
+    bool CheckedAdd(__uint128_t &total, __uint128_t value) {
+        if (total + value < total) return false;
+        total += value;
+        return true;
+    }
+} // namespace
+
+bool NativeConservation::AddInput(__uint128_t value) {
+    return CheckedAdd(inputs_, value);
+}
+bool NativeConservation::AddOutput(__uint128_t value) {
+    return CheckedAdd(outputs_, value);
+}
+const char *ConservationFailureName(ConservationFailure failure) {
+    switch (failure) {
+    case ConservationFailure::None:
+        return "";
+    case ConservationFailure::Overflow:
+        return "conservation-overflow";
+    case ConservationFailure::NativeInflation:
+        return "native-inflation";
+    case ConservationFailure::MintWithoutDelta:
+        return "mint-without-positive-delta";
+    case ConservationFailure::TokenInflation:
+        return "token-inflation";
+    }
+    return "conservation-unknown";
+}
+
+bool NativeConservation::Final(std::string &error) {
+    const auto failure = Check();
+    error = ConservationFailureName(failure);
+    return failure == ConservationFailure::None;
+}
+bool TokenConservation::Final(std::string &error) {
+    const auto failure = Check();
+    error = ConservationFailureName(failure);
+    return failure == ConservationFailure::None;
+}
+
+ConservationFailure NativeConservation::Check() const {
+    return inputs_ < outputs_ ? ConservationFailure::NativeInflation
+                              : ConservationFailure::None;
+}
+
+bool TokenConservation::AddInput(const Hash32 &token, __uint128_t value) {
+    return CheckedAdd(totals_[token].inputs, value);
+}
+bool TokenConservation::AddOutput(const Hash32 &token, __uint128_t value) {
+    return CheckedAdd(totals_[token].outputs, value);
+}
+ConservationFailure TokenConservation::Check() const {
+    std::set<Hash32> positive;
+    for (const auto &[token, totals] : totals_)
+        if (totals.outputs > totals.inputs) positive.insert(token);
+    // Mint inputs in transaction order; a second mint of one token finds
+    // its delta already taken.
+    for (const Hash32 &token : mints_)
+        if (positive.erase(token) != 1)
+            return ConservationFailure::MintWithoutDelta;
+    return positive.empty() ? ConservationFailure::None
+                            : ConservationFailure::TokenInflation;
+}
+
 } // namespace lotus::v2
diff --git a/src/lotus_v2/deferred_checks.h b/src/lotus_v2/deferred_checks.h
index 6429367ce3e2843bb431dc31fde9c735a1d0f993..3e9eb1125fea6d00d1f6632ac19ca7f7fa5ab810 100644
--- a/src/lotus_v2/deferred_checks.h
+++ b/src/lotus_v2/deferred_checks.h
@@ -33,6 +33,7 @@
 #include <atomic>
 #include <cstddef>
 #include <cstdint>
+#include <map>
 #include <memory>
 #include <optional>
 #include <span>
@@ -264,6 +265,68 @@ std::vector<OutputClaim> OutputClaimsOf(const DeferredRecords &records);
 std::vector<StateAuthorization>
 StateAuthorizationsOf(const DeferredRecords &records);
 
+// ---------------------------------------------------------------------------
+// Conservation kinds. Their contributions are structural (input and output
+// values), applied when the transaction is prepared; no script contributes,
+// so their final rules are decided before any input runs, by the caller
+// that prepares the transaction (the ordinary V2 path and the node's
+// CheckTxInputs variants). Each caller keeps its own reject reasons and its
+// historical precedence between these and its other structural rules: the
+// failure code below is mapped by the caller.
+
+enum class ConservationFailure {
+    None,
+    Overflow,              // a running total does not fit
+    NativeInflation,       // native outputs exceed native inputs
+    MintWithoutDelta,      // a mint input whose token has no positive delta
+    TokenInflation,        // a positive token delta without a mint input
+};
+
+// Generic names of the conservation failures (callers may map the code to
+// their own reasons instead).
+const char *ConservationFailureName(ConservationFailure failure);
+
+// Native conservation: one counter per transaction. Inputs add, outputs
+// (including burns) subtract; the remainder is the fee and must be >= 0.
+class NativeConservation final : public DeferredAccumulator {
+public:
+    bool AddInput(__uint128_t value);
+    bool AddOutput(__uint128_t value);
+    ConservationFailure Check() const;
+    bool Final(std::string &error) override;
+    __uint128_t Inputs() const { return inputs_; }
+    __uint128_t Outputs() const { return outputs_; }
+    // Valid when Check() passes.
+    __uint128_t Fee() const { return inputs_ - outputs_; }
+
+private:
+    __uint128_t inputs_ = 0;
+    __uint128_t outputs_ = 0;
+};
+
+// Token conservation: one counter per token id. Spent amounts add, outputs
+// (including burns) subtract. Final: every token whose outputs exceed its
+// inputs (a positive delta) is matched by exactly one mint input for that
+// token, and every mint input names a token with a positive delta.
+class TokenConservation final : public DeferredAccumulator {
+public:
+    struct Totals {
+        __uint128_t inputs = 0;
+        __uint128_t outputs = 0;
+    };
+    bool AddInput(const Hash32 &token, __uint128_t value);
+    bool AddOutput(const Hash32 &token, __uint128_t value);
+    // Mint inputs in transaction order.
+    void AddMint(const Hash32 &token) { mints_.push_back(token); }
+    ConservationFailure Check() const;
+    bool Final(std::string &error) override;
+    const std::map<Hash32, Totals> &PerToken() const { return totals_; }
+
+private:
+    std::map<Hash32, Totals> totals_;
+    std::vector<Hash32> mints_;
+};
+
 } // namespace lotus::v2
 
 #endif
