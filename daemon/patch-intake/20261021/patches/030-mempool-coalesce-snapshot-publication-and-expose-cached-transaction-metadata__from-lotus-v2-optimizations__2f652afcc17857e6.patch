-uint256 CTransaction::ComputeHash() const {
-    return (HashWriter{} << *this).GetHash();
+namespace {
+struct CountingHashWriter : public HashWriter {
+    uint32_t m_size{0};
+    void write(Span<const std::byte> src) {
+        m_size += static_cast<uint32_t>(src.size());
+        HashWriter::write(src);
+    }
+    template <typename T> CountingHashWriter &operator<<(const T &obj) {
+        ::Serialize(*this, obj);
+        return *this;
+    }
+};
+} // namespace
+
+uint256 CTransaction::ComputeHash() {
+    CountingHashWriter writer;
+    writer << *this;
+    m_serialize_size = writer.m_size;
+    return writer.GetHash();
 }
 
