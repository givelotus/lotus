+bool VerifyLegacyBatchSlice(std::span<const LegacyBatchSigItem> slice) {
+    if (slice.empty()) return true;
+    if (slice.size() == 1) {
+        return secp256k1_schnorr_verify(
+                   secp256k1_context_static, slice[0].sig.data(),
+                   slice[0].msg.data(),
+                   reinterpret_cast<const secp256k1_pubkey *>(
+                       slice[0].parsed_pubkey.data())) == 1;
+    }
+    const size_t n = slice.size();
+    std::vector<const unsigned char *> sigs(n);
+    std::vector<const unsigned char *> msgs(n);
+    std::vector<const secp256k1_pubkey *> pubkeys(n);
+
+    static std::atomic<uint64_t> batch_nonce{1};
+    const uint64_t nonce_val =
+        batch_nonce.fetch_add(1, std::memory_order_relaxed);
+    const uint64_t clock_val = static_cast<uint64_t>(
+        std::chrono::steady_clock::now().time_since_epoch().count());
+    const uintptr_t addr_val = reinterpret_cast<uintptr_t>(slice.data());
+
+    blake3_hasher hasher;
+    blake3_hasher_init(&hasher);
+    constexpr char domain[] = "Lotus/v2/legacy-schnorr-batch-randomizer";
+    blake3_hasher_update(&hasher, domain, sizeof(domain));
+    blake3_hasher_update(&hasher, &nonce_val, sizeof(nonce_val));
+    blake3_hasher_update(&hasher, &clock_val, sizeof(clock_val));
+    blake3_hasher_update(&hasher, &addr_val, sizeof(addr_val));
+
+    for (size_t i = 0; i < n; ++i) {
+        sigs[i] = slice[i].sig.data();
+        msgs[i] = slice[i].msg.data();
+        pubkeys[i] = reinterpret_cast<const secp256k1_pubkey *>(
+            slice[i].parsed_pubkey.data());
+        blake3_hasher_update(&hasher, slice[i].parsed_pubkey.data(),
+                             slice[i].parsed_pubkey.size());
+        blake3_hasher_update(&hasher, slice[i].sig.data(), slice[i].sig.size());
+        blake3_hasher_update(&hasher, slice[i].msg.data(), slice[i].msg.size());
+    }
+
+    std::vector<unsigned char> rand32(32 * n);
+    blake3_hasher_finalize(&hasher, rand32.data(), rand32.size());
+
+    return secp256k1_schnorr_verify_batch(
+               secp256k1_context_static, sigs.data(), msgs.data(),
+               pubkeys.data(), rand32.data(), n) == 1;
+}
