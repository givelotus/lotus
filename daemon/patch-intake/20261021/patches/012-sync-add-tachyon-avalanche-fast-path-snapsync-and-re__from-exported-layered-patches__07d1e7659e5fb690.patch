+    if (args.GetBoolArg("-serveutxoshards", true)) {
+        nLocalServices = ServiceFlags(nLocalServices | NODE_UTXO_SHARD);
+    }
+
     PeerManager::Options peerman_opts{};
     ApplyArgsManOptions(args, peerman_opts);
 
