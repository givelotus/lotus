From bd58819dc71decc19b95ae1b7b55acff62810a0c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] perf: eliminate 5 CPU hotspots in 3-node loopback TPS profile

Eliminate redundant hex formatting, map lookups, and lock contention identified
in 3-node loopback high-TPS profiling.

Original-Commit: 5a6bd7cbe31742a801c42a2c1c0aacfdb050ef5c
Original-Patch: ecash/030
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Application-Repair: Retain deferred parallel overlay insertion and flush-on-read/freeze/removal/scope-exit behavior with its missing pending-vector/accessor prerequisites. Adapt only to the already-evidenced snapshot defer-depth name and retain COW changed-entry tracking, eager filter lifecycle and coherent snapshot publication; do not restore obsolete duplicate destructor or undo tested snapshot behavior.

Candidate-Application-Repair: Complete the adapted destructor body: flush pending overlay additions whenever the outermost existing snapshot-defer scope exits, then publish once if dirty. Preserve the original flush ordering and avoid duplicate destructor definitions.

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index a3df694ee8862b3ec960bdc9ff9d6d6589374533..aa8d16f16bca503ed122471d6b7a6762aa178bdb 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -213,8 +213,14 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
         }
     }
     UpdateParentsOf(true, newit);
-    AddTransactionToOverlay(m_merklix_overlay, tx,
-                            entry->GetFee() / SATOSHI, entry->GetSigChecks());
+    if (m_snapshot_defer_depth > 0) {
+        m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
+                                           entry->GetSigChecks());
+    } else {
+        FlushPendingOverlayAdds();
+        AddTransactionToOverlay(m_merklix_overlay, tx,
+                                entry->GetFee() / SATOSHI, entry->GetSigChecks());
+    }
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
@@ -231,6 +237,7 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     const CTransaction &tx = (*it)->GetTx();
     const TxId &txid = tx.GetId();
     MarkSnapshotEntryChanged(txid);
+    FlushPendingOverlayAdds();
     RemoveTransactionFromOverlay(m_merklix_overlay, (*it)->GetTx());
 
     if (reason != MemPoolRemovalReason::BLOCK) {
@@ -412,6 +419,7 @@ void CTxMemPool::removeForFinalizedBlock(
 void CTxMemPool::_clear() {
     m_snapshot_changed_entries.clear();
     m_snapshot_needs_reset = true;
+    m_pending_overlay_adds.clear();
     m_merklix_overlay.Clear();
     mapTx.clear();
     mapNextTx.clear();
@@ -425,8 +433,17 @@ void CTxMemPool::_clear() {
     ++nTransactionsUpdated;
 }
 
+void CTxMemPool::FlushPendingOverlayAdds() const {
+    AssertLockHeld(cs);
+    if (m_pending_overlay_adds.empty()) return;
+    auto pending = std::move(m_pending_overlay_adds);
+    m_pending_overlay_adds.clear();
+    AddTransactionsToOverlayBatch(m_merklix_overlay, pending);
+}
+
 const lotus::v2::MempoolOverlayLayer &CTxMemPool::FreezeEpochBatch() {
     AssertLockHeld(cs);
+    FlushPendingOverlayAdds();
     const auto &frozen = m_merklix_overlay.FreezeEpochBatch();
     node::PublishMempoolSnapshot(*this);
     return frozen;
@@ -436,6 +453,7 @@ void CTxMemPool::SyncMerklixOverlayToTip(const BlockHash &tip_hash,
                                        uint64_t next_height,
                                        uint64_t parent_mtp) const {
     AssertLockHeld(cs);
+    FlushPendingOverlayAdds();
     lotus::v2::Hash tip_id{};
     std::copy(tip_hash.begin(), tip_hash.end(), tip_id.begin());
     if (!m_merklix_overlay.IsAnchoredAt(tip_id, next_height, parent_mtp)) {
@@ -996,9 +1014,12 @@ void CTxMemPool::AddUnbroadcastTx(const TxId &txid) {
 CTxMemPool::ScopedSnapshotDefer::~ScopedSnapshotDefer() {
     AssertLockHeld(m_pool.cs);
     assert(m_pool.m_snapshot_defer_depth > 0);
-    if (--m_pool.m_snapshot_defer_depth == 0 && m_pool.m_snapshot_dirty) {
-        m_pool.m_snapshot_dirty = false;
-        node::PublishMempoolSnapshot(m_pool);
+    if (--m_pool.m_snapshot_defer_depth == 0) {
+        m_pool.FlushPendingOverlayAdds();
+        if (m_pool.m_snapshot_dirty) {
+            m_pool.m_snapshot_dirty = false;
+            node::PublishMempoolSnapshot(m_pool);
+        }
     }
 }
 
diff --git a/src/txmempool.h b/src/txmempool.h
index db54faa4f99baf650a8eb4208478867ba9dc52c0..48941f432c5cb911f1c2944d367aff35325747e1 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -606,10 +606,13 @@ public:
         return func(*m_conflicting);
     }
 
+    void FlushPendingOverlayAdds() const EXCLUSIVE_LOCKS_REQUIRED(cs);
+
     /** Shared speculative transaction overlay; not proof of script validity. */
     lotus::v2::MerklixOverlayManager &GetMerklixOverlay() const
         EXCLUSIVE_LOCKS_REQUIRED(cs) {
         AssertLockHeld(cs);
+        FlushPendingOverlayAdds();
         return m_merklix_overlay;
     }
 
@@ -689,6 +692,8 @@ private:
     mutable unsigned int m_snapshot_defer_depth GUARDED_BY(cs){0};
     mutable bool m_snapshot_dirty GUARDED_BY(cs){false};
     mutable lotus::v2::MerklixOverlayManager m_merklix_overlay GUARDED_BY(cs);
+    mutable std::vector<std::tuple<CTransactionRef, int64_t, int64_t>>
+        m_pending_overlay_adds GUARDED_BY(cs);
     /** Set ancestor state for an entry */
     void UpdateEntryForAncestors(txiter it, const setEntries *setAncestors)
         EXCLUSIVE_LOCKS_REQUIRED(cs);
