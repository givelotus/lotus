+
+class ChainstateManager;
+class CTxMemPool;
+
+namespace lotus::v2 {
+using Hash = std::array<uint8_t, 32>;
+static constexpr uint32_t kHeaderVersion = 1;
+struct SmtNode;
+struct UtxoOverlayArena;
