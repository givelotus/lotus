+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_TRANSPORT_QUERY_POOL_H
+#define CHRONIK_NATIVE_TRANSPORT_QUERY_POOL_H
+
+#include <chronik/native/http.h>
+
+#include <boost/asio/associated_executor.hpp>
+#include <boost/asio/async_result.hpp>
+#include <boost/asio/dispatch.hpp>
+#include <boost/asio/executor_work_guard.hpp>
+#include <boost/asio/post.hpp>
+#include <boost/asio/strand.hpp>
+#include <boost/asio/thread_pool.hpp>
+
+#include <functional>
+#include <memory>
+
+namespace chronik::native {
+
+/**
+ * Fixed pool of threads running blocking Chronik work (HTTP handlers, WS
+ * subscription handling), so transport io threads never block (design §3.4).
+ */
+class QueryPool {
+public:
+    using executor_type = boost::asio::thread_pool::executor_type;
+
+    explicit QueryPool(size_t num_threads = DefaultThreads());
+    ~QueryPool();
+    QueryPool(const QueryPool &) = delete;
+    QueryPool &operator=(const QueryPool &) = delete;
+
+    /** min(8, max(1, hardware_concurrency / 2)) */
+    static size_t DefaultThreads();
+
+    executor_type GetExecutor() { return m_pool.get_executor(); }
+    /** A strand on the pool: posted work runs serialized, in order. */
+    boost::asio::strand<executor_type> MakeStrand() {
+        return boost::asio::make_strand(m_pool.get_executor());
+    }
+    void Post(std::function<void()> fn) {
+        boost::asio::post(m_pool, std::move(fn));
+    }
+    /** Stop accepting work and join (pending work is abandoned). */
+    void Stop();
+    /** Wait for queued work to finish, then join. */
+    void Join();
+    size_t NumThreads() const { return m_num_threads; }
+
+private:
+    size_t m_num_threads;
+    boost::asio::thread_pool m_pool;
+};
+
+/**
+ * Run router.Handle(req) on the pool and deliver the response to the
+ * completion handler on its associated executor (e.g. an io strand or a
+ * coroutine's executor). Usable with callbacks or boost::asio::use_awaitable:
+ *
+ *   HttpResponse resp = co_await AsyncHandle(pool, router, std::move(req),
+ *                                            boost::asio::use_awaitable);
+ */
+template <typename CompletionToken>
+auto AsyncHandle(QueryPool &pool, const Router &router, HttpRequest req,
+                 CompletionToken &&token) {
+    return boost::asio::async_initiate<CompletionToken, void(HttpResponse)>(
+        [&pool, &router](auto handler, HttpRequest request) {
+            auto work = boost::asio::make_work_guard(
+                boost::asio::get_associated_executor(handler));
+            // asio::post, not Post(std::function): handlers are move-only
+            boost::asio::post(pool.GetExecutor(), [&router,
+                                                   request = std::move(request),
+                       handler = std::move(handler),
+                       work = std::move(work)]() mutable {
+                HttpResponse resp = router.Handle(request);
+                auto ex = work.get_executor();
+                boost::asio::dispatch(
+                    ex, [handler = std::move(handler),
+                         resp = std::move(resp)]() mutable {
+                        std::move(handler)(std::move(resp));
+                    });
+                work.reset();
+            });
+        },
+        token, std::move(req));
+}
+
+} // namespace chronik::native
+
+#endif // CHRONIK_NATIVE_TRANSPORT_QUERY_POOL_H
diff --git a/chronik/native/include/chronik/native/ws.h b/chronik/native/include/chronik/native/ws.h
new file mode 100644
index 0000000000000000000000000000000000000000..4676bbaba80bf18d8181468fe13232a82c23185d
--- /dev/null
+++ b/chronik/native/include/chronik/native/ws.h
@@ -0,0 +1,77 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_WS_H
+#define CHRONIK_NATIVE_WS_H
+
+#include <chronik/native/types.h>
+
+#include <functional>
+#include <memory>
+#include <span>
+#include <string>
+
+/**
+ * Transport-neutral WebSocket session interfaces (design §6.1).
+ *
+ * The transport (standalone Beast listener, or the node's in-process
+ * /chronik/ws) implements WsSession; the core implements one WsHandler per
+ * session (port of chronik-http ws.rs handle_subscribe_socket).
+ *
+ * Threading: a transport calls the WsHandler methods of one session one at a
+ * time, in order, never on an io thread (they run serialized on the query
+ * pool, so a handler may take the indexer's shared lock). OnClosed is called
+ * exactly once, last; afterwards the transport drops the handler.
+ *
+ * The transport itself implements the protocol-level parts of ws.rs:
+ *  - binary frames are passed to OnBinary, text frames call OnText;
+ *  - Ping is answered with Pong; Pong is ignored;
+ *  - Close or an error ends the session (OnClosed);
+ *  - messages/frames above MAX_WS_MESSAGE_SIZE (20,000 B) end the session;
+ *  - after `ping_interval` without session activity, a Ping with payload
+ *    "Bitcoin ABC Chronik Indexer" is sent. Rust re-arms that sleep on every
+ *    loop iteration, i.e. after any client message and any subscription
+ *    event; the transport resets it on every received frame and every
+ *    SendBinary, and the handler calls NotifyActivity() for events it handled
+ *    without sending (e.g. deduplicated messages).
+ */
+namespace chronik::native {
+
+/** Payload of Chronik's keep-alive pings (ws.rs schedule_ping). */
+constexpr const char *WS_PING_PAYLOAD = "Bitcoin ABC Chronik Indexer";
+
+class WsSession {
+public:
+    virtual ~WsSession() = default;
+    /** Non-blocking enqueue of a binary message; callable from any thread. */
+    virtual void SendBinary(Bytes msg) = 0;
+    /** Close the connection (normal closure); callable from any thread. */
+    virtual void Close() = 0;
+    /** Real client IP address, without port. */
+    virtual const std::string &PeerIp() const = 0;
+    /** Restart the idle-ping timer (see above). */
+    virtual void NotifyActivity() = 0;
+};
+
+class WsHandler {
+public:
+    virtual ~WsHandler() = default;
+    /** A binary message (a proto::WsSub) */
+    virtual void OnBinary(std::span<const uint8_t> msg) = 0;
+    /** A text message (Rust replies with an "Unexpected message type" error) */
+    virtual void OnText() = 0;
+    /** The session ended; release subscriptions. Called exactly once. */
+    virtual void OnClosed() = 0;
+};
+
+/**
+ * Creates the handler for a newly upgraded session. The handler may keep the
+ * shared_ptr to its session to send messages; it must drop it in OnClosed().
+ */
+using WsAccept =
+    std::function<std::unique_ptr<WsHandler>(std::shared_ptr<WsSession>)>;
+
+} // namespace chronik::native
+
+#endif // CHRONIK_NATIVE_WS_H
diff --git a/chronik/native/test/transport_tests.cpp b/chronik/native/test/transport_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0f319cc62b4719b73298c483d0d8a701bfe26a3a
--- /dev/null
+++ b/chronik/native/test/transport_tests.cpp
@@ -0,0 +1,575 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Integration tests of the standalone Beast listener on 127.0.0.1:0, with a
+// Beast client: HTTP routing/keep-alive/limits/CORS and the WebSocket
+// transport (echo handler, pings, pongs, max message size).
+
+#include <chronik/native/error.h>
+#include <chronik/native/http.h>
+#include <chronik/native/proto.h>
+#include <chronik/native/transport/beast_listener.h>
+#include <chronik/native/transport/query_pool.h>
+#include <chronik/native/ws.h>
+
+#include <boost/asio/co_spawn.hpp>
+#include <boost/asio/detached.hpp>
+#include <boost/asio/io_context.hpp>
+#include <boost/asio/ip/tcp.hpp>
+#include <boost/asio/use_awaitable.hpp>
+#include <boost/beast/core.hpp>
+#include <boost/beast/http.hpp>
+#include <boost/beast/websocket.hpp>
+#include <boost/test/unit_test.hpp>
+
+#include <atomic>
+#include <cerrno>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+using namespace chronik::native;
+namespace asio = boost::asio;
+namespace beast = boost::beast;
+namespace http = beast::http;
+namespace websocket = beast::websocket;
+using tcp = asio::ip::tcp;
+
+namespace {
+
+using Response = http::response<http::string_body>;
+
+struct Client {
+    asio::io_context ioc;
+    tcp::socket socket{ioc};
+    beast::flat_buffer buffer;
+
+    explicit Client(uint16_t port) {
+        socket.connect(
+            tcp::endpoint(asio::ip::make_address("127.0.0.1"), port));
+    }
+
+    Response Request(http::verb method, const std::string &target,
+                     std::string body = {},
+                     std::vector<std::pair<std::string, std::string>>
+                         headers = {}) {
+        http::request<http::string_body> req{method, target, 11};
+        req.set(http::field::host, "127.0.0.1");
+        for (auto &[k, v] : headers) {
+            req.set(k, v);
+        }
+        req.body() = std::move(body);
+        req.prepare_payload();
+        http::write(socket, req);
+        return Read(method == http::verb::head);
+    }
+
+    Response Read(bool head = false) {
+        http::response_parser<http::string_body> parser;
+        parser.skip(head);
+        http::read(socket, buffer, parser);
+        return parser.release();
+    }
+
+    /** True if the server closed the connection. */
+    bool ServerClosed() {
+        beast::error_code ec;
+        char c;
+        socket.read_some(asio::buffer(&c, 1), ec);
+        return ec == asio::error::eof || ec == asio::error::connection_reset;
+    }
+};
+
+std::string ErrMsg(const Response &res) {
+    proto::Error err;
+    BOOST_REQUIRE(err.ParseFromString(res.body()));
+    return err.msg();
+}
+
+/** Echo handler; counters shared with the test. */
+struct WsCounters {
+    std::atomic<int> accepted{0};
+    std::atomic<int> closed{0};
+    std::atomic<int> texts{0};
+    std::atomic<bool> on_io_thread{false};
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::string last_peer_ip;
+
+    void WaitClosed(int n) {
+        std::unique_lock lock(mutex);
+        cv.wait_for(lock, std::chrono::seconds(5),
+                    [&] { return closed.load() >= n; });
+    }
+};
+
+class EchoHandler : public WsHandler {
+public:
+    EchoHandler(std::shared_ptr<WsSession> session,
+                std::shared_ptr<WsCounters> counters)
+        : m_session(std::move(session)), m_counters(std::move(counters)) {}
+
+    void OnBinary(std::span<const uint8_t> msg) override {
+        const std::string text(msg.begin(), msg.end());
+        if (text == "delay") {
+            // Reply later, without activity in between (pings are due)
+            std::thread([session = m_session] {
+                std::this_thread::sleep_for(std::chrono::milliseconds(700));
+                const std::string done = "done";
+                session->SendBinary(Bytes(done.begin(), done.end()));
+            }).detach();
+            return;
+        }
+        if (text == "close") {
+            m_session->Close();
+            return;
+        }
+        m_session->SendBinary(Bytes(msg.begin(), msg.end()));
+    }
+    void OnText() override {
+        ++m_counters->texts;
+        const std::string reply = "Unexpected message type Text";
+        m_session->SendBinary(Bytes(reply.begin(), reply.end()));
+    }
+    void OnClosed() override {
+        m_session.reset();
+        {
+            std::lock_guard lock(m_counters->mutex);
+            ++m_counters->closed;
+        }
+        m_counters->cv.notify_all();
+    }
+
+private:
+    std::shared_ptr<WsSession> m_session;
+    std::shared_ptr<WsCounters> m_counters;
+};
+
+Router MakeRouter() {
+    Router router(RouterOptions{true, {}});
+    router.Get("/info", [](const HttpRequest &req, const PathParams &) {
+        return HttpResponse::Text(200, "info from " + req.peer_ip);
+    });
+    router.Get("/blocks/:start/:end",
+               [](const HttpRequest &, const PathParams &p) {
+                   return HttpResponse::Text(
+                       200, std::to_string(PathI32(p, 0) + PathI32(p, 1)));
+               });
+    router.PostWithOptions(
+        "/broadcast-tx", [](const HttpRequest &req, const PathParams &) {
+            auto raw = ParseProtobufRequest<proto::BroadcastTxRequest>(req);
+            proto::RawTx out;
+            out.set_raw_tx(raw.raw_tx());
+            return HttpResponse::Protobuf(out);
+        });
+    router.AddWebSocket("/ws");
+    return router;
+}
+
+struct Fixture {
+    Router router = MakeRouter();
+    QueryPool pool{2};
+    std::shared_ptr<WsCounters> counters = std::make_shared<WsCounters>();
+    std::unique_ptr<BeastListener> listener;
+    uint16_t port = 0;
+
+    explicit Fixture(ListenerOptions opts = DefaultOpts()) {
+        auto counters_ = counters;
+        listener = std::make_unique<BeastListener>(
+            router, pool,
+            [counters_](std::shared_ptr<WsSession> session)
+                -> std::unique_ptr<WsHandler> {
+                ++counters_->accepted;
+                {
+                    std::lock_guard lock(counters_->mutex);
+                    counters_->last_peer_ip = session->PeerIp();
+                }
+                return std::make_unique<EchoHandler>(std::move(session),
+                                                     counters_);
+            },
+            std::move(opts));
+        listener->Start();
+        port = listener->BoundPorts().at(0);
+    }
+
+    static ListenerOptions DefaultOpts() {
+        ListenerOptions opts;
+        opts.binds = {{"127.0.0.1", 0}};
+        opts.ws_ping_interval = std::chrono::milliseconds(300);
+        return opts;
+    }
+};
+
+using WsClient = websocket::stream<tcp::socket>;
+
+std::unique_ptr<WsClient> ConnectWs(asio::io_context &ioc, uint16_t port,
+                                    websocket::response_type *res = nullptr) {
+    auto ws = std::make_unique<WsClient>(ioc);
+    ws->next_layer().connect(
+        tcp::endpoint(asio::ip::make_address("127.0.0.1"), port));
+    ws->read_message_max(1 << 20);
+    websocket::response_type ignored;
+    ws->handshake(res ? *res : ignored, "127.0.0.1", "/ws");
+    ws->binary(true);
+    return ws;
+}
+
+std::string ReadMsg(WsClient &ws) {
+    beast::flat_buffer buf;
+    ws.read(buf);
+    return beast::buffers_to_string(buf.data());
+}
+
+void WriteMsg(WsClient &ws, const std::string &msg) {
+    ws.write(asio::buffer(msg));
+}
+
+} // namespace
+
+BOOST_AUTO_TEST_SUITE(transport_tests)
+
+BOOST_AUTO_TEST_CASE(http_routes_and_keep_alive) {
+    Fixture fx;
+    Client client(fx.port);
+
+    // Several requests on one keep-alive connection
+    Response res = client.Request(http::verb::get, "/info");
+    BOOST_CHECK_EQUAL(res.result_int(), 200);
+    BOOST_CHECK_EQUAL(res.body(), "info from 127.0.0.1");
+    BOOST_CHECK_EQUAL(res[http::field::content_type],
+                      "text/plain; charset=utf-8");
+    BOOST_CHECK_EQUAL(res["access-control-allow-origin"], "*");
+    BOOST_CHECK(res.keep_alive());
+
+    res = client.Request(http::verb::get, "/blocks/2/40");
+    BOOST_CHECK_EQUAL(res.body(), "42");
+
+    res = client.Request(http::verb::head, "/info");
+    BOOST_CHECK_EQUAL(res.result_int(), 200);
+    BOOST_CHECK_EQUAL(res[http::field::content_length], "19");
+    BOOST_CHECK(res.body().empty());
+
+    res = client.Request(http::verb::get, "/nope?a=1");
+    BOOST_CHECK_EQUAL(res.result_int(), 404);
+    BOOST_CHECK_EQUAL(res[http::field::content_type], "application/x-protobuf");
+    BOOST_CHECK_EQUAL(ErrMsg(res), "404: Not found: /nope?a=1");
+
+    res = client.Request(http::verb::delete_, "/info");
+    BOOST_CHECK_EQUAL(res.result_int(), 405);
+    BOOST_CHECK_EQUAL(res[http::field::allow], "GET,HEAD");
+    BOOST_CHECK(res.body().empty());
+
+    res = client.Request(http::verb::get, "/blocks/x/1");
+    BOOST_CHECK_EQUAL(res.result_int(), 400);
+    BOOST_CHECK_EQUAL(res.body(), "Invalid URL: Cannot parse value at index 0 "
+                                  "with value `\"x\"` to a `i32`");
+
+    // CORS preflight
+    res = client.Request(http::verb::options, "/broadcast-tx", {},
+                         {{"Origin", "https://example.com"},
+                          {"Access-Control-Request-Method", "POST"}});
+    BOOST_CHECK_EQUAL(res.result_int(), 200);
+    BOOST_CHECK_EQUAL(res["access-control-allow-origin"], "*");
+    BOOST_CHECK_EQUAL(res["access-control-allow-methods"], "*");
+    BOOST_CHECK_EQUAL(res[http::field::vary],
+                      "origin, access-control-request-method, "
+                      "access-control-request-headers");
+
+    // POST protobuf
+    proto::BroadcastTxRequest req;
+    req.set_raw_tx("\x01\x02\x03");
+    res = client.Request(http::verb::post, "/broadcast-tx",
+                         req.SerializeAsString(),
+                         {{"Content-Type", "application/x-protobuf"}});
+    BOOST_CHECK_EQUAL(res.result_int(), 200);
+    proto::RawTx raw;
+    BOOST_REQUIRE(raw.ParseFromString(res.body()));
+    BOOST_CHECK_EQUAL(raw.raw_tx(), "\x01\x02\x03");
+
+    res = client.Request(http::verb::post, "/broadcast-tx", "\xff",
+                         {{"Content-Type", "application/x-protobuf"}});
+    BOOST_CHECK_EQUAL(res.result_int(), 400);
+    BOOST_CHECK_EQUAL(ErrMsg(res), "400: Bad protobuf: failed to decode "
+                                   "Protobuf message: invalid varint");
+
+    res = client.Request(http::verb::post, "/broadcast-tx", "",
+                         {{"Content-Type", "text/plain"}});
+    BOOST_CHECK_EQUAL(ErrMsg(res), "400: Content-Type must be "
+                                   "application/x-protobuf, got text/plain");
+
+    // GET on /ws without upgrade headers: axum's WebSocketUpgrade rejection
+    res = client.Request(http::verb::get, "/ws");
+    BOOST_CHECK_EQUAL(res.result_int(), 400);
+    BOOST_CHECK_EQUAL(res.body(),
+                      "Connection header did not include 'upgrade'");
+
+    // Connection: close is honoured
+    res = client.Request(http::verb::get, "/info", {},
+                         {{"Connection", "close"}});
+    BOOST_CHECK_EQUAL(res.result_int(), 200);
+    BOOST_CHECK(!res.keep_alive());
+    BOOST_CHECK(client.ServerClosed());
+}
