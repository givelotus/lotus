+int secp256k1_schnorrsig_verify_batch(const secp256k1_context* ctx, const unsigned char * const *sig64, const unsigned char * const *msg32, const secp256k1_xonly_pubkey * const *pubkey, const unsigned char *rand32, size_t n_sigs) {
+    secp256k1_schnorrsig_batch_data bdata;
+    secp256k1_scalar g_sc;
+    secp256k1_gej rj;
+    secp256k1_scratch *scratch;
+    size_t i;
+    size_t n_points;
+    size_t scratch_size;
+    int ret;
