From 913b79cf8d9942f9bde5ab67fb5bb7547458dedf Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 07:14:00 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

Run the final drain on the live consumer, then join it. The exiting caller can have destroyed its thread-local encoder buffers before atexit runs. The actual syslog encoder ASan control fails on the old caller lifecycle and passes on a live worker; ordinary queued records retain the same sinks and ordering.
---
 src/logging.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/logging.cpp b/src/logging.cpp
index 2c2d98bae0..1ffb41234b 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -181,7 +181,7 @@ bool BCLog::Logger::StartLogging() {
     // destroyed, see LogInstance).
     static std::once_flag flush_at_exit;
     std::call_once(flush_at_exit,
-                   [] { std::atexit([] { LogInstance().Flush(); }); });
+                   [] { std::atexit([] { LogInstance().StopThread(); }); });
     return true;
 }
 
