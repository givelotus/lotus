@@ -170,22 +172,47 @@ inline void UnserializeTransaction(TxType &tx, Stream &s) {
     s >> tx.nVersion;
     tx.vin.clear();
     tx.vout.clear();
+    // VectorFormatter is what std::vector<CTxIn/CTxOut> deserialization
+    // uses, including its batched-allocation DoS limit; spelling it out
+    // lets the same code fill CTransaction's inline containers.
     /* Try to read the vin. In case the dummy is there, this will be read as an
