-    s >> tx.vin;
+    VectorFormatter<DefaultFormatter>{}.Unser(s, tx.vin);
     /* We read a non-empty vin. Assume a normal vout follows. */
-    s >> tx.vout;
+    VectorFormatter<DefaultFormatter>{}.Unser(s, tx.vout);
     s >> tx.nLockTime;
 }
 
+/**
+ * Serialize a vector of inputs or outputs exactly like std::vector<T>,
+ * whatever container holds them.
+ */
+template <typename Stream, typename Container>
+inline void SerializeTxElements(Stream &s, const Container &elems) {
+    WriteCompactSize(s, elems.size());
+    for (const auto &elem : elems) {
+        s << elem;
+    }
+}
+
 template <typename Stream, typename TxType>
 inline void SerializeTransaction(const TxType &tx, Stream &s) {
     s << tx.nVersion;
-    s << tx.vin;
-    s << tx.vout;
+    SerializeTxElements(s, tx.vin);
+    SerializeTxElements(s, tx.vout);
     s << tx.nLockTime;
 }
 
+/**
+ * Inputs and outputs of a CTransaction keep room for the common 1-input,
+ * 2-output transaction inline, avoiding two heap allocations per
+ * transaction. Larger transactions spill to the heap like std::vector.
+ */
+static constexpr size_t TX_INLINE_INPUTS{1};
+static constexpr size_t TX_INLINE_OUTPUTS{2};
+using CTxInVector = boost::container::small_vector<CTxIn, TX_INLINE_INPUTS>;
+using CTxOutVector = boost::container::small_vector<CTxOut, TX_INLINE_OUTPUTS>;
