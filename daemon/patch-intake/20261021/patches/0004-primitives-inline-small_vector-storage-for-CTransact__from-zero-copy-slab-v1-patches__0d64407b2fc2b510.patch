diff --git a/src/test/transaction_tests.cpp b/src/test/transaction_tests.cpp
index 5473089973..6d29065238 100644
--- a/src/test/transaction_tests.cpp
+++ b/src/test/transaction_tests.cpp
@@ -13,6 +13,7 @@
 #include <consensus/tx_verify.h>
 #include <consensus/validation.h>
 #include <core_io.h>
+#include <core_memusage.h>
 #include <key.h>
 #include <policy/policy.h>
 #include <policy/settings.h>
@@ -1014,4 +1015,48 @@ BOOST_AUTO_TEST_CASE(cached_size_and_precomputed_data) {
     }
 }
 
+BOOST_AUTO_TEST_CASE(inline_inputs_and_outputs) {
+    // CTransaction keeps TX_INLINE_INPUTS inputs and TX_INLINE_OUTPUTS
+    // outputs inline; serialization must be byte-identical to the
+    // std::vector-based CMutableTransaction whether or not they spill.
+    FastRandomContext rng{/*fDeterministic=*/true};
+    for (size_t n_in = 0; n_in <= TX_INLINE_INPUTS + 2; ++n_in) {
+        for (size_t n_out = 0; n_out <= TX_INLINE_OUTPUTS + 2; ++n_out) {
+            CMutableTransaction mtx;
+            for (size_t i = 0; i < n_in; ++i) {
+                mtx.vin.emplace_back(TxId{rng.rand256()}, uint32_t(i),
+                                     CScript() << rng.randbytes(70));
+            }
+            for (size_t i = 0; i < n_out; ++i) {
+                mtx.vout.emplace_back(int64_t(i + 1) * SATOSHI,
+                                      CScript() << OP_TRUE);
+            }
+            DataStream expected{};
+            expected << mtx;
+
+            CMutableTransaction moved{mtx};
+            for (const CTransaction &tx :
+                 {CTransaction{mtx}, CTransaction{std::move(moved)}}) {
+                DataStream actual{};
+                actual << tx;
+                BOOST_CHECK_EQUAL(HexStr(actual), HexStr(expected));
+                BOOST_CHECK(tx.GetId() == mtx.GetId());
+                BOOST_CHECK(CMutableTransaction{tx}.vin == mtx.vin);
+                BOOST_CHECK(CMutableTransaction{tx}.vout == mtx.vout);
+
+                // Round-trip through deserialization.
+                DataStream ss{expected};
+                const CTransaction decoded{deserialize, ss};
+                BOOST_CHECK(decoded.GetHash() == tx.GetHash());
+
+                // No heap usage is reported while elements fit inline.
+                BOOST_CHECK_EQUAL(memusage::DynamicUsage(tx.vin) == 0,
+                                  n_in <= TX_INLINE_INPUTS);
+                BOOST_CHECK_EQUAL(memusage::DynamicUsage(tx.vout) == 0,
+                                  n_out <= TX_INLINE_OUTPUTS);
+            }
+        }
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
