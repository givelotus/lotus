diff --git a/src/core_memusage.h b/src/core_memusage.h
index eb738d98ec..1aba130b02 100644
--- a/src/core_memusage.h
+++ b/src/core_memusage.h
@@ -26,16 +26,23 @@ static inline size_t RecursiveDynamicUsage(const CTxOut &out) {
     return RecursiveDynamicUsage(out.scriptPubKey);
 }
 
+namespace memusage {
+/** Heap usage of a small_vector: zero while its elements fit inline. */
+template <typename X, size_t N>
+static inline size_t
+DynamicUsage(const boost::container::small_vector<X, N> &v) {
+    return v.capacity() > N ? MallocUsage(v.capacity() * sizeof(X)) : 0;
+}
+} // namespace memusage
+
 static inline size_t RecursiveDynamicUsage(const CTransaction &tx) {
     size_t mem =
         memusage::DynamicUsage(tx.vin) + memusage::DynamicUsage(tx.vout);
-    for (std::vector<CTxIn>::const_iterator it = tx.vin.begin();
-         it != tx.vin.end(); it++) {
-        mem += RecursiveDynamicUsage(*it);
+    for (const CTxIn &in : tx.vin) {
+        mem += RecursiveDynamicUsage(in);
     }
-    for (std::vector<CTxOut>::const_iterator it = tx.vout.begin();
-         it != tx.vout.end(); it++) {
-        mem += RecursiveDynamicUsage(*it);
+    for (const CTxOut &out : tx.vout) {
+        mem += RecursiveDynamicUsage(out);
     }
     return mem;
 }
