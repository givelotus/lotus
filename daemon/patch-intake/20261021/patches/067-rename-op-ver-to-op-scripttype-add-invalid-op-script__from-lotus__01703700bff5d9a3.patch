From fbbb4ea4c869fce725213ba831a4d8648a90a0f2 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Tue, 30 Mar 2021 12:01:45 -0500
Subject: [PATCH] Rename OP_VER to OP_SCRIPTTYPE, add INVALID_OP_SCRIPTTYPE
 (#119)

This opcode allows us to introduce new models of execution, such as Taproot.

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 94ba0c84253bbb00091427533261f42d35635217
Recorded-replay-commit: 9f6b6cf26b3791500bfa47bc418a351cefa79d2c

diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index a3715d57db..89ed83e39b 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -83,7 +83,6 @@ static void CleanupScriptCode(CScript &scriptCode,
 static bool IsOpcodeDisabled(opcodetype opcode, uint32_t flags) {
     switch (opcode) {
         case OP_RESERVED:
-        case OP_VER:
         case OP_VERIF:
         case OP_VERNOTIF:
         case OP_IFDUP:
@@ -273,6 +272,10 @@ bool ScriptInterpreter::RunNextOpInner() {
         return set_error(serror, ScriptError::DISABLED_OPCODE);
     }
 
+    if (opcode == OP_SCRIPTTYPE) {
+        return set_error(serror, ScriptError::INVALID_OP_SCRIPTTYPE);
+    }
+
     if (fExec && 0 <= opcode && opcode <= OP_PUSHDATA4) {
         if (fRequireMinimal && !CheckMinimalPush(vchPushValue, opcode)) {
             return set_error(serror, ScriptError::MINIMALDATA);
diff --git a/src/script/script.cpp b/src/script/script.cpp
index 21d771e821..18781213ca 100644
--- a/src/script/script.cpp
+++ b/src/script/script.cpp
@@ -62,8 +62,8 @@ std::string GetOpName(opcodetype opcode) {
         // control
         case OP_NOP:
             return "OP_NOP";
-        case OP_VER:
-            return "OP_VER";
+        case OP_SCRIPTTYPE:
+            return "OP_SCRIPTTYPE";
         case OP_IF:
             return "OP_IF";
         case OP_NOTIF:
diff --git a/src/script/script.h b/src/script/script.h
index 9e20b8d4b7..1cdef5e8eb 100644
--- a/src/script/script.h
+++ b/src/script/script.h
@@ -80,7 +80,7 @@ enum opcodetype {
 
     // control
     OP_NOP = 0x61,
-    OP_VER = 0x62,
+    OP_SCRIPTTYPE = 0x62,
     OP_IF = 0x63,
     OP_NOTIF = 0x64,
     OP_VERIF = 0x65,
diff --git a/src/script/script_error.cpp b/src/script/script_error.cpp
index a98a8d998e..05dbb62cfd 100644
--- a/src/script/script_error.cpp
+++ b/src/script/script_error.cpp
@@ -109,6 +109,8 @@ std::string ScriptErrorString(const ScriptError serror) {
             return "OP_NUM2BIN size limit exceeded";
         case ScriptError::SIGCHECKS_LIMIT_EXCEEDED:
             return "Validation resources exceeded (SigChecks)";
+        case ScriptError::INVALID_OP_SCRIPTTYPE:
+            return "Marker opcode OP_SCRIPTTYPE cannot be executed";
         case ScriptError::UNKNOWN:
         case ScriptError::ERROR_COUNT:
         default:
diff --git a/src/script/script_error.h b/src/script/script_error.h
index 07d46b50f5..ae9ab4d397 100644
--- a/src/script/script_error.h
+++ b/src/script/script_error.h
@@ -86,6 +86,10 @@ enum class ScriptError {
     /* Auxiliary errors (unused by interpreter) */
     SIGCHECKS_LIMIT_EXCEEDED,
 
+    /* OP_SCRIPTTYPE should never be executed in an executed script, it's only a
+       marker */
+    INVALID_OP_SCRIPTTYPE,
+
     ERROR_COUNT,
 };
 
