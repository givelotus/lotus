From bc2630fb1d997c813abfd150f4f0c258aacb7cd1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] db: coalesce undo writes and cache written block sizes

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Fast-path single-input CheckRegularTransaction duplicate-input checks,
coalesce BlockUndo disk writes, and optimize bulk mempool clear.

Original-Commit: a4ea86865414bbf4f98512bbd4460e2a42897acc
Original-Patch: ecash/020
Split-Concern: undo

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/node/blockstorage.cpp | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/src/node/blockstorage.cpp b/src/node/blockstorage.cpp
index 5f405a0db9..771355367d 100644
--- a/src/node/blockstorage.cpp
+++ b/src/node/blockstorage.cpp
@@ -876,8 +876,11 @@ bool BlockManager::WriteBlockUndo(const CBlockUndo &blockundo,
     // Write undo information to disk
     if (block.GetUndoPos().IsNull()) {
         FlatFilePos pos;
+        DataStream undo_stream{};
+        undo_stream.reserve(blockundo.vtxundo.size() * 64 + 32);
+        undo_stream << blockundo;
         const unsigned int blockundo_size{
-            static_cast<unsigned int>(GetSerializeSize(blockundo))};
+            static_cast<unsigned int>(undo_stream.size())};
         if (!FindUndoPos(state, block.nFile, pos,
                          blockundo_size + UNDO_DATA_DISK_OVERHEAD)) {
             LogError("FindUndoPos failed\n");
@@ -895,12 +898,12 @@ bool BlockManager::WriteBlockUndo(const CBlockUndo &blockundo,
 
         // Write undo data
         pos.nPos += BLOCK_SERIALIZATION_HEADER_SIZE;
-        fileout << blockundo;
+        fileout.write(MakeByteSpan(undo_stream));
 
         // calculate & write checksum
         HashWriter hasher{};
         hasher << block.pprev->GetBlockHash();
-        hasher << blockundo;
+        hasher.write(MakeByteSpan(undo_stream));
         fileout << hasher.GetHash();
 
         // rev files are written in block height order, whereas blk files are
@@ -1091,11 +1094,12 @@ FlatFilePos BlockManager::WriteBlock(const CBlock &block, int nHeight) {
         return FlatFilePos();
     }
 
-    // Write index header
-    fileout << GetParams().DiskMagic() << block_size;
-    // Write block
+    // Write index header and block in a single buffered write
     pos.nPos += BLOCK_SERIALIZATION_HEADER_SIZE;
-    fileout << block;
+    DataStream block_stream{};
+    block_stream.reserve(block_size + BLOCK_SERIALIZATION_HEADER_SIZE);
+    block_stream << GetParams().DiskMagic() << block_size << block;
+    fileout.write(MakeByteSpan(block_stream));
     return pos;
 }
 
