From 427bc0aba09b6e7b7d675b36857b5fc209df2656 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 00:13:34 -0700
Subject: [PATCH] fixup! test(v2): migrate functional fixtures and harnesses to
 native transactions

Restore the inherited coin-stats test to genuine legacy1 transaction assertions: version, raw wire prefix and actual OP_RETURN script. Preserve every amount, fee, index hash, restart, reindex, paid output metadata, reorg and unclean restart oracle. Native-only nFlags raised AttributeError before; private matching-binary after passes all checks in8s.

Tier: V2 (fixup to test(v2): migrate functional fixtures and harnesses to native transactions)
---
 test/functional/feature_coinstatsindex.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/test/functional/feature_coinstatsindex.py b/test/functional/feature_coinstatsindex.py
index e1f8dee76b..34912ce4d6 100644
--- a/test/functional/feature_coinstatsindex.py
+++ b/test/functional/feature_coinstatsindex.py
@@ -198,12 +198,12 @@ class CoinStatsIndexTest(BitcoinTestFramework):
         tx2.vout = [
             CTxOut(int(20_990_000 * XEC), CScript([OP_RETURN] + [OP_FALSE] * 50))
         ]
-        # Replacing outputs must rebuild native branch commitments/witnesses;
-        # otherwise empty output branches select the legacy compatibility wire.
+        # This inherited accounting test spends genuine legacy transactions.
         self.wallet.sign_tx(tx2)
-        assert_equal(tx2.vout[0].nFlags, 2)
+        assert_equal(tx2.nVersion, 1)
+        assert_equal(tx2.vout[0].scriptPubKey[0], OP_RETURN)
         tx2_hex = tx2.serialize().hex()
-        assert_equal(tx2_hex[:8], "07000000")
+        assert_equal(tx2_hex[:8], "01000000")
         self.nodes[0].sendrawtransaction(tx2_hex)
 
         # Include both txs in a block
