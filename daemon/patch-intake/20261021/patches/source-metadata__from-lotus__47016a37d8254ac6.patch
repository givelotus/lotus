From a3298b97085ce84009989e4e040229ad0e5fddbc Mon Sep 17 00:00:00 2001
From: Lotus Release Tool <build@givelotus.org>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] Scope bitcoin-abc source build labels to native version tags

Keep distributor release identity in the component manifest.
Unrelated monorepo component tags must not override native build labels.

diff --git a/contrib/guix/libexec/codesign.sh b/contrib/guix/libexec/codesign.sh
index 6d8b359a169b26250cdc6034bd6b65504153879f..765bfb187aec7f3aa82914ab311322f56599118c 100755
--- a/contrib/guix/libexec/codesign.sh
+++ b/contrib/guix/libexec/codesign.sh
@@ -42,7 +42,7 @@ OUTDIR="${DISTSRC}/output"
 
 git_head_version() {
     local recent_tag
-    if recent_tag="$(git -C "$1" describe --exact-match HEAD 2> /dev/null)"; then
+    if recent_tag="$(git -C "$1" describe --match "v0.34.1*" --exact-match HEAD 2> /dev/null)"; then
         echo "${recent_tag#v}"
     else
         git -C "$1" rev-parse --short=12 HEAD
diff --git a/contrib/shell/git-utils.bash b/contrib/shell/git-utils.bash
index c0f3e60b4f19c82a15cb439852d35e44f88b93f6..1036c2c0d7d5c6e72d0a0f71ce76b4f1ffae69c6 100644
--- a/contrib/shell/git-utils.bash
+++ b/contrib/shell/git-utils.bash
@@ -8,7 +8,7 @@ git_root() {
 
 git_head_version() {
     local recent_tag
-    if recent_tag="$(git describe --exact-match HEAD 2> /dev/null)"; then
+    if recent_tag="$(git describe --match "v0.34.1*" --exact-match HEAD 2> /dev/null)"; then
         echo "${recent_tag#v}"
     else
         git rev-parse --short=12 HEAD
diff --git a/electrum/contrib/base.sh b/electrum/contrib/base.sh
index ab523454750b093d3084a06d4470778d61510000..7fdfdd4f8bc1daff130d4123437ad18c9a41a8fb 100755
--- a/electrum/contrib/base.sh
+++ b/electrum/contrib/base.sh
@@ -202,7 +202,7 @@ function setup_pkg()
         pushd "$pkgbuilddir"
         local commit=`git rev-parse HEAD`
         local branch=`git rev-parse --abbrev-ref HEAD`
-        local tag=`git describe --tags`
+        local tag=`git describe --match "v5.5.2*" --tags`
         if [[ ${commit} = ${checkout_ref} || ${branch} = ${checkout_ref} || ${tag} = ${checkout_ref} ]] ; then
             warn "$pkgname already cloned and $checkout_ref is already the current HEAD"
             # Just make sure there are no accidental changes
diff --git a/share/genbuild.sh b/share/genbuild.sh
index bc5a49085d037e47ad20f5d3b7fd580af9767a51..8db5674b09e21c943948eca0dcd2f76984f5443d 100755
--- a/share/genbuild.sh
+++ b/share/genbuild.sh
@@ -25,7 +25,7 @@ if [ -e "$(command -v git)" ] && [ "$(git rev-parse --is-inside-work-tree 2>/dev
     git diff >/dev/null 2>/dev/null
 
     # if latest commit is tagged and not dirty, then override using the tag name
-    RAWDESC=$(git describe --abbrev=0 2>/dev/null)
+    RAWDESC=$(git describe --match "v0.34.1*" --abbrev=0 2>/dev/null)
     if [ "$(git rev-parse HEAD)" = "$(git rev-list -1 $RAWDESC 2>/dev/null)" ]; then
         git diff-index --quiet HEAD -- && GIT_TAG=$RAWDESC
     fi
