From 4356d1c143b26deaad610374b3c4360ed6108d0f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:35:31 -0700
Subject: [PATCH] build: update RPC documentation and Electrum daemon target
 references

Complete the executable rename in current CMake generator expressions and the optional Electrum integration target, preserving the BITCOIND environment override. Source filenames and internal Qt libraries remain unchanged.

diff --git a/doc/rpc/CMakeLists.txt b/doc/rpc/CMakeLists.txt
index d2c26d3cadac6a31e7bec0b16052d22c469f8301..9507aecf4a91ceff6e1e14b3b952fe52d4a29fd6 100644
--- a/doc/rpc/CMakeLists.txt
+++ b/doc/rpc/CMakeLists.txt
@@ -6,12 +6,12 @@ if(BUILD_CLI)
 		COMMAND
 			"${CMAKE_CURRENT_SOURCE_DIR}/gen-rpc-docs.sh"
 			"${CMAKE_CURRENT_SOURCE_DIR}/generate.go"
-			"$<TARGET_FILE:bitcoind>"
-			"$<TARGET_FILE:bitcoin-cli>"
+			"$<TARGET_FILE:doged>"
+			"$<TARGET_FILE:doge-cli>"
 		WORKING_DIRECTORY "${CMAKE_BINARY_DIR}"
 		DEPENDS
-			bitcoind
-			bitcoin-cli
+			doged
+			doge-cli
 	)
 endif()
 
diff --git a/electrum/CMakeLists.txt b/electrum/CMakeLists.txt
index 7ae6dbcd7bd8a7ac747c0baeac7fd4921984281f..0b0e5fe0af2ee14fdc3d817ee27fe798d611e1f2 100644
--- a/electrum/CMakeLists.txt
+++ b/electrum/CMakeLists.txt
@@ -18,10 +18,10 @@ if(BUILD_CHRONIK)
 	add_custom_target(check-electrum-functional
 		COMMENT "Run Electrum ABC functional tests..."
 		COMMAND
-			"BITCOIND=${CMAKE_BINARY_DIR}/src/bitcoind"
+			"BITCOIND=${CMAKE_BINARY_DIR}/src/doged"
 			"${Python_EXECUTABLE}" ./test_runner.py functional
 		DEPENDS
-			bitcoind
+			doged
 			${CMAKE_CURRENT_BINARY_DIR}/test_runner.py
 	)
 
