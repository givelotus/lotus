From 2b12a501694ca71e4852a51711434a3d0e27ed09 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 08:54:03 -0700
Subject: [PATCH] fixup! wallet(v2): build legacy version 2 transactions
 explicitly

Native branch ownership does not imply that the ordinary legacy-only wallet funder/signer can spend it. Exclude unsupported native policies from legacy coin selection and report spendable/solvable false, retaining ownership tracking. Native wallet funding/signing remains a separate feature.
---
 src/wallet/spend.cpp             | 16 ++++++++++------
 src/wallet/test/wallet_tests.cpp | 10 ++++++++++
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/wallet/spend.cpp b/src/wallet/spend.cpp
index bacd012d3109ac89731d0783b4596d3fdda9922a..fbd108b3f90c82ecddd17ef5a3c9c9b3d1b382ce 100644
--- a/src/wallet/spend.cpp
+++ b/src/wallet/spend.cpp
@@ -188,13 +188,17 @@ void AvailableCoins(const CWallet &wallet, std::vector<COutput> &vCoins,
             std::unique_ptr<SigningProvider> provider =
                 wallet.GetSolvingProvider(wtx.tx->vout[i].scriptPubKey);
 
-            bool solvable =
-                provider ? IsSolvable(*provider, wtx.tx->vout[i].scriptPubKey)
-                         : false;
+            // The ordinary CWallet signer/funder currently creates legacy
+            // transactions only. Recognizing a native branch is ownership
+            // metadata, not proof that this signer can spend that policy.
+            const bool legacy = wtx.tx->vout[i].IsLegacy();
+            bool solvable = legacy && provider &&
+                            IsSolvable(*provider, wtx.tx->vout[i].scriptPubKey);
             bool spendable =
-                ((mine & ISMINE_SPENDABLE) != ISMINE_NO) ||
-                (((mine & ISMINE_WATCH_ONLY) != ISMINE_NO) &&
-                 (coinControl && coinControl->fAllowWatchOnly && solvable));
+                legacy &&
+                (((mine & ISMINE_SPENDABLE) != ISMINE_NO) ||
+                 (((mine & ISMINE_WATCH_ONLY) != ISMINE_NO) &&
+                  (coinControl && coinControl->fAllowWatchOnly && solvable)));
 
             vCoins.push_back(
                 COutput(wallet, wtx, i, nDepth, spendable, solvable, safeTx,
diff --git a/src/wallet/test/wallet_tests.cpp b/src/wallet/test/wallet_tests.cpp
index bc704b8ca0c9a2cff5068a6daf0dfc4c7b72e2f5..dc8b5dfb66d155f3c8c1428dbde49c51b5210b2d 100644
--- a/src/wallet/test/wallet_tests.cpp
+++ b/src/wallet/test/wallet_tests.cpp
@@ -139,6 +139,16 @@ BOOST_AUTO_TEST_CASE(native_wallet_ownership_keeps_canonical_transaction) {
     BOOST_CHECK(m_wallet.IsMine(tx->vout[0]) & ISMINE_SPENDABLE);
     BOOST_CHECK(m_wallet.IsMine(CTxOut(1000 * SATOSHI, script)) & ISMINE_SPENDABLE);
 
+    // Ownership recognition must not advertise a native coin as spendable by
+    // the ordinary wallet's currently legacy-only funder/signer.
+    CCoinControl control;
+    control.m_include_unsafe_inputs = true;
+    std::vector<COutput> available;
+    AvailableCoins(m_wallet, available, &control);
+    BOOST_REQUIRE_EQUAL(available.size(), 1U);
+    BOOST_CHECK(!available[0].fSpendable);
+    BOOST_CHECK(!available[0].fSolvable);
+
     CKey unrelated;
     unrelated.MakeNewKey(true);
     const auto unknown = V0LeafOutput(
