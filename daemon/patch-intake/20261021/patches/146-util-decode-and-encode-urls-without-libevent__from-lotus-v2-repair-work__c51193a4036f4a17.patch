From eb8f4cee07edfdd3c2c931fe5e6d3746bd6c5b2a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 05:27:36 -0700
Subject: [PATCH] util: decode and encode URLs without libevent

urlDecode called evhttp_uridecode, so every binary linking the util
library needed libevent for a few lines of percent-decoding. Decode in
place instead, with the same rules: "%XX" with two hex digits is
decoded, anything else (including '+') is copied, and the result ends
at the first decoded NUL.

Add urlEncode, which keeps the unreserved characters A-Za-z0-9-._~ and
writes every other byte as upper-case "%XX", matching evhttp_uriencode
as the RPC client uses it for wallet paths. util_tests still compares
both functions with libevent on the fixed vectors.

Tier: eCash
---
 src/test/util_tests.cpp |  1 +
 src/util/url.cpp        | 45 ++++++++++++++++++++++++++++++++++-------
 src/util/url.h          | 12 +++++++++++
 3 files changed, 51 insertions(+), 7 deletions(-)

diff --git a/src/test/util_tests.cpp b/src/test/util_tests.cpp
index 13cb7932afe58a7387da57d95773c2e95ee48ec7..5ba9fed51bab8120d427682a7089f0567b1c0e61 100644
--- a/src/test/util_tests.cpp
+++ b/src/test/util_tests.cpp
@@ -3335,6 +3335,7 @@ BOOST_AUTO_TEST_CASE(url_encode) {
         {"\xff", "%FF"},
     };
     for (const auto &[input, expected] : vectors) {
+        BOOST_CHECK_EQUAL(urlEncode(input), expected);
         char *encoded = evhttp_uriencode(input.data(), input.size(), false);
         BOOST_REQUIRE(encoded);
         BOOST_CHECK_EQUAL(std::string(encoded), expected);
diff --git a/src/util/url.cpp b/src/util/url.cpp
index 5e0c7b92f50aff36011fe3f7c673d695b11ae48a..630f9f122d0179cc3dfcd90b70fffdd0186087b8 100644
--- a/src/util/url.cpp
+++ b/src/util/url.cpp
@@ -4,16 +4,47 @@
 
 #include <util/url.h>
 
-#include <cstdlib>
-#include <event2/http.h>
+#include <util/strencodings.h>
+
+#include <cstddef>
+#include <cstdint>
 
 std::string urlDecode(const std::string &urlEncoded) {
     std::string res;
-    if (!urlEncoded.empty()) {
-        char *decoded = evhttp_uridecode(urlEncoded.c_str(), false, nullptr);
-        if (decoded) {
-            res = std::string(decoded);
-            free(decoded);
+    res.reserve(urlEncoded.size());
+    for (size_t i = 0; i < urlEncoded.size(); ++i) {
+        char c = urlEncoded[i];
+        if (c == '%' && i + 2 < urlEncoded.size()) {
+            const signed char hi = HexDigit(urlEncoded[i + 1]);
+            const signed char lo = HexDigit(urlEncoded[i + 2]);
+            if (hi >= 0 && lo >= 0) {
+                c = static_cast<char>((hi << 4) | lo);
+                i += 2;
+            }
+        }
+        if (c == '\0') {
+            // The result was a C string: it ends at the first NUL.
+            break;
+        }
+        res.push_back(c);
+    }
+    return res;
+}
+
+std::string urlEncode(const std::string &str) {
+    static constexpr char HEX[] = "0123456789ABCDEF";
+    std::string res;
+    res.reserve(str.size());
+    for (const char ch : str) {
+        const uint8_t c = static_cast<uint8_t>(ch);
+        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+            (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_' ||
+            c == '~') {
+            res.push_back(ch);
+        } else {
+            res.push_back('%');
+            res.push_back(HEX[c >> 4]);
+            res.push_back(HEX[c & 0xf]);
         }
     }
     return res;
diff --git a/src/util/url.h b/src/util/url.h
index 3d7315a3383050b0ca39b577832ca6488f4d0fe4..12bd6eeef0e45df46dbd94f6000bf799ab19afaa 100644
--- a/src/util/url.h
+++ b/src/util/url.h
@@ -7,6 +7,18 @@
 
 #include <string>
 
+/**
+ * Percent-decode a URL component. Only "%XX" with two hexadecimal digits (in
+ * either case) is decoded; anything else, including '+', is copied unchanged.
+ * The result ends at the first decoded NUL character.
+ */
 std::string urlDecode(const std::string &urlEncoded);
 
+/**
+ * Percent-encode a URL component. The unreserved characters A-Z, a-z, 0-9,
+ * '-', '.', '_' and '~' are kept; every other byte becomes "%XX" in upper-case
+ * hexadecimal.
+ */
+std::string urlEncode(const std::string &str);
+
 #endif // BITCOIN_UTIL_URL_H
