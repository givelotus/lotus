+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test compress-once block frames (p2p-zstd-v1-frames) with mixed peers.
+
+One node serves the same block to WebSocket peers that negotiated
+p2p-zstd-v1-frames, peers that did not (p2p-zstd-v1, none) and a raw TCP
+peer. Every peer receives the identical block, the block is compressed once
+(metrics), and only negotiated peers ever see or may send RSV2 frames.
+Node-to-node, upgraded dialers negotiate frames and dialers offering only
+p2p-zstd-v1 (as older ecashd nodes do) do not.
+"""
+
+import http.client
+import time
+
+from test_framework.messages import MSG_BLOCK, CInv, msg_getdata, msg_ping
+from test_framework.p2p import P2PInterface
+from test_framework.test_framework import BitcoinTestFramework, SkipTest
+from test_framework.util import assert_equal, rpc_port
+from test_framework.wallet import MiniWallet
+
+FRAMES = "p2p-zstd-v1-frames"
+
+
+class BlockCollector(P2PInterface):
+    def __init__(self):
+        super().__init__()
+        self.blocks = {}
+
+    def on_block(self, message):
+        self.blocks[message.block.hash_hex] = message.block.serialize().hex()
+
+
+class P2PWebSocketCompressOnceTest(BitcoinTestFramework):
+    num_nodes = 3
+    topology = "none"
+
+    def skip_test_if_missing_module(self):
+        try:
+            import websocket  # noqa: F401
+            import zstandard  # noqa: F401
+        except ImportError:
+            raise SkipTest("websocket-client and zstandard are required")
+
+    def setup_network(self):
+        url = f"ws://127.0.0.1:{rpc_port(0)}/p2p/ws"
+        self.extra_args = [
+            ["-metrics"],
+            # Upgraded dialer: offers p2p-zstd-v1-frames by default.
+            [f"-addnode={url}"],
+            # Dialer offering what an older ecashd offers.
+            [f"-addnode={url}", "-p2pwebsocketoffer=p2p-zstd-v1,p2p-zstd"],
+        ]
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_node(0)
+        self.start_node(1)
+        self.start_node(2)
+
+    def scrape(self):
+        # Repeated scrapes within a second return the previous rendering.
+        time.sleep(1.1)
+        conn = http.client.HTTPConnection("127.0.0.1", rpc_port(0), timeout=30)
+        conn.request("GET", "/metrics")
+        res = conn.getresponse()
+        assert_equal(res.status, 200)
+        values = {}
+        for line in res.read().decode().splitlines():
+            if line.startswith("lotus_p2p_compress_once") or line.startswith(
+                "lotus_p2p_websocket_independent"
+            ):
+                name, value = line.rsplit(" ", 1)
+                values[name] = float(value)
+        conn.close()
+        return values
+
+    def ws_peers(self, n):
+        return [p for p in self.nodes[n].getpeerinfo() if p["transport"] != "tcp"]
+
+    def connect(self, subprotocols):
+        from test_framework.p2p_websocket import P2PWebSocketClient
+
+        peer = P2PWebSocketClient(
+            f"ws://127.0.0.1:{rpc_port(0)}/p2p/ws",
+            subprotocols=subprotocols,
+            srcdir=self.config["environment"]["SRCDIR"],
+        )
+        peer.handshake()
+        return peer
+
+    def run_test(self):
+        node = self.nodes[0]
+
+        self.log.info("Node-to-node: upgraded dialers negotiate frames")
+        self.wait_until(lambda: len(self.ws_peers(0)) == 2)
+        self.wait_until(lambda: len(self.ws_peers(1)) == 1)
+        self.wait_until(lambda: len(self.ws_peers(2)) == 1)
+        frames_by_subver = {}
+        for p in self.ws_peers(0):
+            frames_by_subver.setdefault(p["websocket"]["independent_frames"], 0)
+            frames_by_subver[p["websocket"]["independent_frames"]] += 1
+            assert_equal(p["websocket"]["compression"], "p2p-zstd-v1")
+        assert_equal(frames_by_subver, {True: 1, False: 1})
+        assert_equal(self.ws_peers(1)[0]["websocket"]["independent_frames"], True)
+        assert_equal(self.ws_peers(2)[0]["websocket"]["independent_frames"], False)
+        metrics = self.scrape()
+        assert_equal(metrics["lotus_p2p_websocket_independent_frame_peers"], 1)
+
+        # Serve only the test's own peers from here on.
+        self.stop_node(1)
+        self.stop_node(2)
+        self.wait_until(lambda: len(self.ws_peers(0)) == 0)
+
+        self.log.info("Mine a block larger than -p2pcompressoncethreshold")
+        wallet = MiniWallet(node)
+        for _ in range(40):
+            wallet.send_self_transfer_multi(from_node=node, num_outputs=100)
+        blockhash = self.generate(node, 1, sync_fun=self.no_op)[0]
+        raw_block = bytes.fromhex(node.getblock(blockhash, 0))
+        assert len(raw_block) > 100000, len(raw_block)
+
+        self.log.info("Peers: two with frames, p2p-zstd-v1, none and raw TCP")
+        frames_a = self.connect([FRAMES, "p2p-zstd-v1", "p2p-zstd"])
+        frames_b = self.connect([FRAMES])
+        plain_zstd = self.connect(["p2p-zstd-v1", "p2p-zstd"])
+        uncompressed = self.connect(None)
+        assert_equal(frames_a.subprotocol, FRAMES)
+        assert_equal(frames_b.subprotocol, FRAMES)
+        assert_equal(plain_zstd.subprotocol, "p2p-zstd-v1")
+        assert_equal(uncompressed.subprotocol, None)
+        tcp = node.add_p2p_connection(BlockCollector())
+        self.wait_until(lambda: len(self.ws_peers(0)) == 4)
+        before = self.scrape()
+        assert_equal(before["lotus_p2p_websocket_independent_frame_peers"], 2)
+
+        ws_peers = [frames_a, frames_b, plain_zstd, uncompressed]
+        getdata = msg_getdata([CInv(MSG_BLOCK, int(blockhash, 16))])
+        for peer in ws_peers:
+            peer.send_message(getdata)
+        tcp.send_without_ping(getdata)
+
+        received = []
+        for peer in ws_peers:
+            while True:
+                msgtype, raw = peer.recv_raw_message()
+                if msgtype == b"block":
+                    received.append(raw)
+                    break
+        self.log.info("Every peer received the identical block")
+        for raw in received:
+            assert_equal(raw[24:], raw_block)
+            assert_equal(raw, received[0])
+        tcp.wait_until(lambda: blockhash in tcp.blocks)
+        assert_equal(tcp.blocks[blockhash], raw_block.hex())
+
+        self.log.info("Only negotiated peers got an independent frame")
+        assert_equal(frames_a.independent_frames_recv, 1)
+        assert_equal(frames_b.independent_frames_recv, 1)
+        assert_equal(plain_zstd.independent_frames_recv, 0)
+        assert_equal(uncompressed.independent_frames_recv, 0)
+        sent = {
+            p["websocket"]["independent_frames"]: p["websocket"][
+                "independent_frames_sent"
+            ]
+            for p in self.ws_peers(0)
+        }
+        assert_equal(sent, {True: 1, False: 0})
+
+        self.log.info("The block was compressed once for both peers")
+        after = self.scrape()
+
+        def delta(name):
+            return after.get(name, 0) - before.get(name, 0)
+
+        assert_equal(delta("lotus_p2p_compress_once_encodes_total"), 1)
+        assert_equal(delta("lotus_p2p_compress_once_cache_misses_total"), 1)
+        assert_equal(delta("lotus_p2p_compress_once_cache_hits_total"), 1)
+        assert_equal(
+            delta('lotus_p2p_websocket_independent_frames_total{direction="sent"}'),
+            2,
+        )
+        assert_equal(after["lotus_p2p_compress_once_cache_entries"], 1)
+        assert after["lotus_p2p_compress_once_cache_bytes"] > 0
+
+        self.log.info("Serving it again is a cache hit")
+        frames_a.send_message(getdata)
+        while frames_a.recv_raw_message()[0] != b"block":
+            pass
+        again = self.scrape()
+        assert_equal(
+            again["lotus_p2p_compress_once_encodes_total"],
+            after["lotus_p2p_compress_once_encodes_total"],
+        )
+        assert_equal(
+            again["lotus_p2p_compress_once_cache_hits_total"],
+            after["lotus_p2p_compress_once_cache_hits_total"] + 1,
+        )
+
+        self.log.info("A negotiated peer may send independent frames")
+        frames_a.send_independent(frames_a.build_message(msg_ping(nonce=42)))
+        assert_equal(frames_a.wait_for(b"pong").nonce, 42)
+        self.wait_until(
+            lambda: (
+                sum(p["websocket"]["independent_frames_recv"] for p in self.ws_peers(0))
+                == 1
+            )
+        )
