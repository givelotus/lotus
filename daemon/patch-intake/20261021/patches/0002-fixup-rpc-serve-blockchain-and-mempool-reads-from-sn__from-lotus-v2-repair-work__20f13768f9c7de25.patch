From 7f43d762d9c1c2b6966a8bcb49e06277e523cc44 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 11:08:07 -0700
Subject: [PATCH 2/6] fixup! rpc: serve blockchain and mempool reads from
 snapshots

---
 src/validation.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/validation.cpp b/src/validation.cpp
index 0be3568a20..c8494e669a 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -7847,6 +7847,16 @@ std::vector<Chainstate *> ChainstateManager::GetAll() {
     return out;
 }
 
+// Startup/reset switches can select a chainstate before it has a loaded tip.
+// Retire its previous RPC generation rather than publishing an unready view.
+static void InvalidateChainstateRpcSnapshot(const ChainstateManager &chainman) {
+    auto &publisher = node::GetGlobalSnapshotPublisher();
+    const auto current = publisher.Load();
+    if (current && current->chainman_ptr == &chainman) {
+        publisher.Publish(std::make_shared<const node::ChainAndMempoolSnapshot>());
+    }
+}
+
 Chainstate &ChainstateManager::InitializeChainstate(CTxMemPool *mempool) {
     AssertLockHeld(::cs_main);
     assert(!m_ibd_chainstate);
@@ -7854,6 +7864,7 @@ Chainstate &ChainstateManager::InitializeChainstate(CTxMemPool *mempool) {
 
     m_ibd_chainstate = std::make_unique<Chainstate>(mempool, m_blockman, *this);
     m_active_chainstate = m_ibd_chainstate.get();
+    InvalidateChainstateRpcSnapshot(*this);
     return *m_active_chainstate;
 }
 
@@ -8084,6 +8095,9 @@ util::Result<CBlockIndex *> ChainstateManager::ActivateSnapshot(
                   (1000 * 1000));
 
     this->MaybeRebalanceCaches();
+    // The manager identity is unchanged, but RPC readers must observe the
+    // newly active snapshot before loadtxoutset returns.
+    node::PublishChainTipSnapshot(*this, m_active_chainstate->m_mempool);
     return snapshot_start_block;
 }
 
@@ -8401,6 +8415,7 @@ SnapshotCompletionResult ChainstateManager::MaybeCompleteSnapshotValidation() {
                   "and stopping node\n");
 
         m_active_chainstate = m_ibd_chainstate.get();
+        InvalidateChainstateRpcSnapshot(*this);
         m_snapshot_chainstate->m_disabled = true;
         assert(!this->IsUsable(m_snapshot_chainstate.get()));
         assert(this->IsUsable(m_ibd_chainstate.get()));
@@ -8552,6 +8567,7 @@ void ChainstateManager::MaybeRebalanceCaches() {
 }
 
 void ChainstateManager::ResetChainstates() {
+    InvalidateChainstateRpcSnapshot(*this);
     m_ibd_chainstate.reset();
     m_snapshot_chainstate.reset();
     m_active_chainstate = nullptr;
@@ -8624,6 +8640,7 @@ ChainstateManager::ActivateExistingSnapshot(BlockHash base_blockhash) {
     m_snapshot_chainstate->m_mempool = m_active_chainstate->m_mempool;
     m_active_chainstate->m_mempool = nullptr;
     m_active_chainstate = m_snapshot_chainstate.get();
+    InvalidateChainstateRpcSnapshot(*this);
     return *m_snapshot_chainstate;
 }
 
@@ -8688,6 +8705,7 @@ bool ChainstateManager::DeleteSnapshotChainstate() {
     m_active_chainstate = m_ibd_chainstate.get();
     m_active_chainstate->m_mempool = m_snapshot_chainstate->m_mempool;
     m_snapshot_chainstate.reset();
+    node::PublishChainTipSnapshot(*this, m_active_chainstate->m_mempool);
     return true;
 }
 
