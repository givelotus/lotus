From d9599298c4ec5432c32ce3aab0eef5d9ba7d3013 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 22:23:37 -0700
Subject: [PATCH] fixup! http: configurable P2P WebSocket path and upgrade
 token

---
 src/init.cpp                                  | 35 ++++++++++++-------
 .../functional/p2p_websocket_addr_versions.py | 23 ++++++++++++
 test/functional/p2p_websocket_token.py        |  2 --
 3 files changed, 46 insertions(+), 14 deletions(-)

diff --git a/src/init.cpp b/src/init.cpp
index a48217e0c8..e140709c2f 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -1005,8 +1005,8 @@ void SetupServerArgs(NodeContext &node) {
     argsman.AddArg(
         "-p2pwebsocketpath=<path>",
         strprintf("Serve P2P WebSocket upgrades at this path instead of %s. "
-                  "Peers then need the full URL (-addnode=wss://host/path); "
-                  "incompatible with -externaldomain",
+                  "It is advertised with -externaldomain; otherwise peers "
+                  "need the full URL (-addnode=wss://host/path)",
                   P2P_WEBSOCKET_PATH),
         ArgsManager::ALLOW_ANY, OptionsCategory::CONNECTION);
     argsman.AddArg(
@@ -1016,13 +1016,15 @@ void SetupServerArgs(NodeContext &node) {
         "\"t=<token>\" cookie. Dial such a peer with "
         "wss://host/path?token=<token> (the token is sent as a header). "
         "Without it, the endpoint answers like any unknown path. Can be "
-        "specified multiple times; incompatible with -externaldomain.",
+        "specified multiple times; incompatible with -externaldomain, since "
+        "the token is never advertised.",
         ArgsManager::ALLOW_ANY | ArgsManager::SENSITIVE,
         OptionsCategory::CONNECTION);
     argsman.AddArg(
         "-externaldomain=<domain>[:port]",
         "Advertise that this node accepts P2P over WebSocket+TLS at "
-        "wss://<domain>:<port>/p2p/ws (default port: 443), e.g. behind a "
+        "wss://<domain>:<port>/p2p/ws (default port: 443; the path is "
+        "-p2pwebsocketpath if set), e.g. behind a "
         "TLS-terminating proxy. Only announced to peers supporting ADDRv2 "
         "(BIP155); others never see it. Can be specified multiple times.",
         ArgsManager::ALLOW_ANY | ArgsManager::NETWORK_ONLY,
@@ -3482,23 +3484,32 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
     }
 
     if (args.IsArgSet("-externaldomain") &&
-        (args.IsArgSet("-p2pwebsockettoken") ||
-         args.GetArg("-p2pwebsocketpath", P2P_WEBSOCKET_PATH) !=
-             P2P_WEBSOCKET_PATH)) {
-        // Peers learning a NET_WSS address dial its default path, without a
-        // token: advertising it would only reveal a node they cannot use.
+        args.IsArgSet("-p2pwebsockettoken")) {
+        // Peers learning a NET_WSS address dial it without a token:
+        // advertising it would only reveal a node they cannot use.
         return InitError(_("-externaldomain cannot be combined with "
-                           "-p2pwebsockettoken or -p2pwebsocketpath: peers "
-                           "learning the address could not connect"));
+                           "-p2pwebsockettoken: peers learning the address "
+                           "could not connect"));
     }
+    // A -p2pwebsocketpath is advertised with the domain.
+    const std::string ws_path{
+        args.GetArg("-p2pwebsocketpath", P2P_WEBSOCKET_PATH)};
     for (const std::string &strDomain : args.GetArgs("-externaldomain")) {
         uint16_t port{443};
         std::string host;
         CNetAddr domain;
-        if (!SplitHostPort(strDomain, port, host) || !domain.SetWSSDomain(host)) {
+        if (!SplitHostPort(strDomain, port, host) ||
+            !domain.SetWSSDomain(host)) {
             return InitError(strprintf(_("Invalid -externaldomain: '%s'"),
                                        strDomain));
         }
+        if (!domain.SetWSSDomain(host, ws_path)) {
+            return InitError(strprintf(
+                _("-p2pwebsocketpath '%s' cannot be advertised with "
+                  "-externaldomain (use / followed by A-Z a-z 0-9 - . _ ~ /, "
+                  "at most 255 characters)"),
+                ws_path));
+        }
         AddLocal(CService{domain, port}, LOCAL_MANUAL);
     }
 
diff --git a/test/functional/p2p_websocket_addr_versions.py b/test/functional/p2p_websocket_addr_versions.py
index e24a9635dd..8e44e1c9b2 100755
--- a/test/functional/p2p_websocket_addr_versions.py
+++ b/test/functional/p2p_websocket_addr_versions.py
@@ -17,6 +17,7 @@ import time
 from test_framework.messages import NODE_NETWORK, CAddress, msg_addrv2
 from test_framework.p2p import P2PInterface, p2p_lock
 from test_framework.test_framework import BitcoinTestFramework
+from test_framework.test_node import ErrorMatch
 from test_framework.util import assert_equal
 
 
@@ -98,6 +99,28 @@ class P2PWebSocketAddrVersionsTest(BitcoinTestFramework):
         ):
             pass
 
+        self.log.info("-externaldomain advertises -p2pwebsocketpath")
+        self.restart_node(0, self.extra_args[0] + [
+            "-externaldomain=Self.Example.org:8443",
+            "-p2pwebsocketpath=/lotus/ws",
+        ])
+        # Nodes advertise themselves only once out of initial block download.
+        self.generate(self.nodes[0], 1, sync_fun=self.no_op)
+        peer = self.nodes[0].add_p2p_connection(AddrReceiver())
+        self.nodes[0].setmocktime(int(time.time()) + 24 * 60 * 60)
+        peer.wait_until(lambda: any(a.net == CAddress.NET_WSS for a in peer.received))
+        self.nodes[0].setmocktime(0)
+        with p2p_lock:
+            own = [(a.wss_version, a.ip, a.port) for a in peer.received
+                   if a.net == CAddress.NET_WSS]
+        assert_equal(own, [(1, "self.example.org/lotus/ws", 8443)])
+        self.stop_node(0)
+        self.nodes[0].assert_start_raises_init_error(
+            ["-externaldomain=self.example.org", "-p2pwebsocketpath=/a!b"],
+            "cannot be advertised with -externaldomain",
+            match=ErrorMatch.PARTIAL_REGEX,
+        )
+
 
 if __name__ == "__main__":
     P2PWebSocketAddrVersionsTest().main()
diff --git a/test/functional/p2p_websocket_token.py b/test/functional/p2p_websocket_token.py
index 9f006df279..32ee9c5ae0 100755
--- a/test/functional/p2p_websocket_token.py
+++ b/test/functional/p2p_websocket_token.py
@@ -129,8 +129,6 @@ class P2PWebSocketTokenTest(BitcoinTestFramework):
         for args, error in (
             (["-p2pwebsockettoken=x", "-externaldomain=example.org"],
              "-externaldomain cannot be combined"),
-            ([f"-p2pwebsocketpath={PATH}", "-externaldomain=example.org"],
-             "-externaldomain cannot be combined"),
             (["-p2pwebsocketpath=/"], "Unable to start HTTP server"),
             (["-p2pwebsocketpath=relative"], "Unable to start HTTP server"),
             (["-p2pwebsockettoken=bad token"], "Unable to start HTTP server"),
