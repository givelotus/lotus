From 7cf6af205683645ba53a3aff51a1e4f5282f0241 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 08:24:02 -0700
Subject: [PATCH] logging: structure initialization and thread lifecycle
 diagnostics

Preserve existing info levels and human wording while adding stable event names and typed count/height/thread-name fields.

Full extended functional suite: 276 passed, 61 platform/disabled skips, zero failures/errors. All five targets and structured-event lint pass. Candidate tree 277271a9ce24ad736ade3e110fa2cfd2315ea97b stayed unchanged through the gate.

(cherry picked from commit ae6fdcdc4b6301bf5cee90636391e5ac18f5908b)

N3-Source-Commit: ae6fdcdc4b6301bf5cee90636391e5ac18f5908b
N3-Source-Export: 0047
---
 src/init.cpp        | 44 +++++++++++++++++++++++++++++---------------
 src/util/thread.cpp |  6 ++++--
 2 files changed, 33 insertions(+), 17 deletions(-)

diff --git a/src/init.cpp b/src/init.cpp
index 4294bcf45f21f7ab433be150352cd4331a29d177..2451892fa80e35e14beb1feb622ec426971801fe 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -2587,7 +2587,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
         [&args] {
             constexpr uint64_t min_disk_space = 250_MiB;
             if (!CheckDiskSpace(args.GetBlocksDirPath(), min_disk_space)) {
-                LogPrintf("Shutting down due to lack of disk space!\n");
+                LogInfoEvent(BCLog::ALL, "shutdown_disk_space",
+                             "Shutting down due to lack of disk space!");
                 StartShutdown();
             }
             return true;
@@ -2669,7 +2670,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
             LogPrintf("Using asmap version %s for IP bucketing\n",
                       asmap_version.ToString());
         } else {
-            LogPrintf("Using /16 prefix for IP bucketing\n");
+            LogInfoEvent(BCLog::ALL, "ip_bucketing_legacy",
+                         "Using /16 prefix for IP bucketing");
         }
 
         uiInterface.InitMessage(_("Loading P2P addresses...").translated);
@@ -2928,9 +2930,11 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
     Assert(!ApplyArgsManOptions(args, chainman_opts));
 
     if (chainman_opts.checkpoints_enabled) {
-        LogPrintf("Checkpoints will be verified.\n");
+        LogInfoEvent(BCLog::ALL, "checkpoint_verification_enabled",
+                     "Checkpoints will be verified.");
     } else {
-        LogPrintf("Skipping checkpoint verification.\n");
+        LogInfoEvent(BCLog::ALL, "checkpoint_verification_disabled",
+                     "Skipping checkpoint verification.");
     }
 
     BlockManager::Options blockman_opts{
@@ -2945,7 +2949,7 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
     const auto [index_cache_sizes, kernel_cache_sizes] =
         CalculateCacheSizes(args, g_enabled_filter_types.size());
 
-    LogInfo("Cache configuration:\n");
+    LogInfoEvent(BCLog::ALL, "cache_configuration", "Cache configuration:");
     LogInfo("* Using %.1f MiB for block index database\n",
             kernel_cache_sizes.block_tree_db * (1.0 / 1024 / 1024));
     if (args.GetBoolArg("-txindex", DEFAULT_TXINDEX)) {
@@ -3005,11 +3009,13 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
         // latter is not in libbitcoinkernel.
         chainman.snapshot_download_completed = [&node]() {
             if (!node.chainman->m_blockman.IsPruneMode()) {
-                LogPrintf("[snapshot] re-enabling NODE_NETWORK services\n");
+                LogInfoEvent(BCLog::ALL, "snapshot_network_service_restored",
+                             "[snapshot] re-enabling NODE_NETWORK services");
                 node.connman->AddLocalServices(NODE_NETWORK);
             }
 
-            LogPrintf("[snapshot] restarting indexes\n");
+            LogInfoEvent(BCLog::ALL, "snapshot_indexes_restarting",
+                         "[snapshot] restarting indexes");
 
             // Drain the validation interface queue to ensure that the old
             // indexes don't have any pending work.
@@ -3101,7 +3107,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
                     do_reindex = true;
                     AbortShutdown();
                 } else {
-                    LogPrintf("Aborted block database rebuild. Exiting.\n");
+                    LogInfoEvent(BCLog::ALL, "block_database_rebuild_aborted",
+                                 "Aborted block database rebuild. Exiting.");
                     return false;
                 }
             } else {
@@ -3115,7 +3122,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
     // As the program has not fully started yet, Shutdown() is possibly
     // overkill.
     if (ShutdownRequested()) {
-        LogPrintf("Shutdown requested. Exiting.\n");
+        LogInfoEvent(BCLog::ALL, "startup_shutdown_requested",
+                     "Shutdown requested. Exiting.");
         return false;
     }
 
@@ -3233,11 +3241,13 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
         // Prior to setting NODE_NETWORK, check if we can provide historical
         // blocks.
         if (!background_sync_in_progress) {
-            LogPrintf("Setting NODE_NETWORK on non-prune mode\n");
+            LogInfoEvent(BCLog::ALL, "network_service_enabled",
+                         "Setting NODE_NETWORK on non-prune mode");
             nLocalServices = ServiceFlags(nLocalServices | NODE_NETWORK);
         } else {
-            LogPrintf("Running node in NODE_NETWORK_LIMITED mode until "
-                      "snapshot background sync completes\n");
+            LogInfoEvent(BCLog::ALL, "snapshot_network_limited",
+                         "Running node in NODE_NETWORK_LIMITED mode until "
+                         "snapshot background sync completes");
         }
     }
 
@@ -3298,7 +3308,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
             ImportBlocks(chainman, avalanche, vImportFiles);
             if (args.GetBoolArg("-stopafterblockimport",
                                 DEFAULT_STOPAFTERBLOCKIMPORT)) {
-                LogPrintf("Stopping after block import\n");
+                LogInfoEvent(BCLog::ALL, "block_import_stop_requested",
+                             "Stopping after block import");
                 StartShutdown();
                 return;
             }
@@ -3343,7 +3354,9 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
     //// debug print
     {
         LOCK(cs_main);
-        LogPrintf("block tree size = %u\n", chainman.BlockIndex().size());
+        LogInfoEvent(BCLog::ALL, "block_index_loaded",
+                     "block tree size = {count}")
+            .Field(BCLog::LogField::Count, chainman.BlockIndex().size());
         chain_active_height = chainman.ActiveChain().Height();
         if (const CBlockIndex *tip{chainman.ActiveChain().Tip()}) {
             node::SetTipMetrics(tip->nHeight, tip->GetBlockTime());
@@ -3366,7 +3379,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
             tip_info->header_time = chainman.m_best_header->GetBlockTime();
         }
     }
-    LogPrintf("nBestHeight = %d\n", chain_active_height);
+    LogInfoEvent(BCLog::ALL, "chain_tip_loaded", "nBestHeight = {height}")
+        .Field(BCLog::LogField::Height, chain_active_height);
     if (node.peerman) {
         node.peerman->SetBestHeight(chain_active_height);
     }
diff --git a/src/util/thread.cpp b/src/util/thread.cpp
index a305a59844386b7fffbaddd052f696e77086f049..6eb5945d4f14b25b0adfafd9a6bd950ef6fc2e63 100644
--- a/src/util/thread.cpp
+++ b/src/util/thread.cpp
@@ -15,9 +15,11 @@ void util::TraceThread(std::string_view thread_name,
                        std::function<void()> thread_func) {
     util::ThreadRename(std::string{thread_name});
     try {
-        LogPrintf("%s thread start\n", thread_name);
+        LogInfoEvent(BCLog::ALL, "thread_started", "{name} thread start")
+            .Field(BCLog::LogField::Name, thread_name);
         thread_func();
-        LogPrintf("%s thread exit\n", thread_name);
+        LogInfoEvent(BCLog::ALL, "thread_exited", "{name} thread exit")
+            .Field(BCLog::LogField::Name, thread_name);
     } catch (const std::exception &e) {
         PrintExceptionContinue(&e, thread_name);
         throw;
-- 
