 src/flatfile.cpp                              | 10 +++-
 src/logging/fields.h                          |  3 +-
 src/test/logging_event_tests.cpp              | 54 ++++++++++++++++-
 4 files changed, 121 insertions(+), 5 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/flatfile-open-diagnostics.json

diff --git a/contrib/logging/conversion/rules/flatfile-open-diagnostics.json b/contrib/logging/conversion/rules/flatfile-open-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..ab1afabe643af03e29155b21c1b868f97d5fe830
--- /dev/null
+++ b/contrib/logging/conversion/rules/flatfile-open-diagnostics.json
@@ -0,0 +1,59 @@
+{
+  "schema": 1,
+  "batch": "flatfile-open-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/flatfile.cpp",
+      "rules": [
+        {
+          "id": "flatfile_open_failed",
+          "old": "LogPrintf(\"Unable to open file %s\\n\", fs::PathToString(path))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"flatfile_open_failed\", \"Unable to open file {path}\").Field(BCLog::LogField::Path, fs::PathToString(path))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Unable to open file %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "fs::PathToString(path)"
+            ]
+          },
+          "review_note": "Preserve Info, original plain path text (not fs::quoted), unsigned offset, fopen/fseek/close ordering and nullptr returns. Add no errno reads or pointer fields."
+        },
+        {
+          "id": "flatfile_seek_failed",
+          "old": "LogPrintf(\"Unable to seek to position %u of %s\\n\", pos.nPos,\n                  fs::PathToString(path))",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"flatfile_seek_failed\", \"Unable to seek to position {file_offset} of {path}\").Field(BCLog::LogField::FileOffset, pos.nPos).Field(BCLog::LogField::Path, fs::PathToString(path))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Unable to seek to position %u of %s\n",
+            "specifiers": [
+              "%u",
+              "%s"
+            ],
+            "arguments": [
+              "pos.nPos",
+              "fs::PathToString(path)"
+            ]
+          },
+          "review_note": "Preserve Info, original plain path text (not fs::quoted), unsigned offset, fopen/fseek/close ordering and nullptr returns. Add no errno reads or pointer fields."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "File byte position is a UINT offset, not a byte-count or file number.",
+          "old": "    X(ASMapHash, asmap_hash, HASH, \"\", \"\")\n",
+          "new": "    X(ASMapHash, asmap_hash, HASH, \"\", \"\") \\\n    X(FileOffset, file_offset, UINT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/flatfile.cpp b/src/flatfile.cpp
index 6a4cae418c69657c8f620cc781bc8a1dc88d81d2..b7a3769ab8709c19d46c60676102b3533bf7c91a 100644
--- a/src/flatfile.cpp
+++ b/src/flatfile.cpp
@@ -38,12 +38,16 @@ FILE *FlatFileSeq::Open(const FlatFilePos &pos, bool read_only) {
         file = fsbridge::fopen(path, "wb+");
     }
     if (!file) {
-        LogPrintf("Unable to open file %s\n", fs::PathToString(path));
+        LogInfoEvent(BCLog::ALL, "flatfile_open_failed",
+                     "Unable to open file {path}")
+            .Field(BCLog::LogField::Path, fs::PathToString(path));
         return nullptr;
     }
     if (pos.nPos && fseek(file, pos.nPos, SEEK_SET)) {
-        LogPrintf("Unable to seek to position %u of %s\n", pos.nPos,
-                  fs::PathToString(path));
+        LogInfoEvent(BCLog::ALL, "flatfile_seek_failed",
+                     "Unable to seek to position {file_offset} of {path}")
+            .Field(BCLog::LogField::FileOffset, pos.nPos)
+            .Field(BCLog::LogField::Path, fs::PathToString(path));
         fclose(file);
         return nullptr;
     }
diff --git a/src/logging/fields.h b/src/logging/fields.h
index 6ded3d57a30b36c3c89d3fc65affcd5c24ce86e3..4124b5dbc19705d504110399651a470a35e22ebf 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -146,7 +146,8 @@
     X(ExpectedMinimumChainWorkHex, expected_minimum_chain_work_hex, STRING, "", "") \
