From 4c771a71c39b68ceb2a39f51d0dc76cb13367981 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 19:33:11 -0700
Subject: [PATCH] net: fail closed when a WebSocket dial would bypass -proxy

The WebSocket dialer resolves names and connects directly. With -proxy
set (e.g. Tor or a circumvention client), a ws:// or wss:// peer would
therefore leak the node's address and DNS lookups to a connection the user
expects to be proxied. Refuse such dials until they can be tunnelled, and
also refuse them when -onlynet excludes the wss network.

p2p_websocket_proxy.py checks that, with -proxy, ws:// and wss:// dials
are refused without touching the proxy or the target, that -onlynet
without wss refuses them, and that they work otherwise.

Integration ownership relative to the old stack: this safeguard and functional regression were previously folded into old ecash/080. Restore their distinct authoritative HTTP/WS series-20261019/0010 position, preserving the final behavior.

diff --git a/src/net.cpp b/src/net.cpp
index 7eff43076190924d84865cc047508abfc899cbc4..42350ad75f7b1e9eff131915d608939ed591a94d 100644
--- a/src/net.cpp
+++ b/src/net.cpp
@@ -1128,6 +1128,23 @@ CNode *CConnman::ConnectWebSocketNode(const std::string &url,
                                       const CAddress *wss_addr,
                                       bool fCountFailure,
                                       ConnectionType conn_type) {
+    // The WebSocket dialer connects directly. Until it can tunnel through
+    // the configured proxy, refuse rather than leak our address and DNS
+    // lookups to a connection the user expects to be proxied.
+    Proxy proxy;
+    if (HaveNameProxy() || GetProxy(NET_IPV4, proxy) ||
+        GetProxy(NET_IPV6, proxy)) {
+        LogPrintf("Not connecting to %s: WebSocket peers cannot be reached "
+                  "through -proxy yet\n",
+                  url);
+        return nullptr;
+    }
+    if (!IsReachable(NET_WSS)) {
+        LogPrintf("Not connecting to %s: network wss is not reachable "
+                  "(-onlynet)\n",
+                  url);
+        return nullptr;
+    }
     const WebSocketDialer dialer{GetWebSocketDialer()};
     if (!dialer) {
         LogPrintf("Cannot connect to %s: P2P over WebSocket is unavailable\n",
diff --git a/test/functional/p2p_websocket_proxy.py b/test/functional/p2p_websocket_proxy.py
new file mode 100644
index 0000000000000000000000000000000000000000..a13527dffb9be455e9062f07f51b122543a737cc
--- /dev/null
+++ b/test/functional/p2p_websocket_proxy.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test that ws:// and wss:// P2P dials never bypass -proxy or -onlynet."""
+
+import time
+
+from test_framework.socks5 import Socks5Configuration, Socks5Server
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, p2p_port
+
+PUBLIC_PORT_INDEX = 40
+PROXY_PORT_INDEX = 41
+
+
+class P2PWebSocketProxyTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+
+    def setup_network(self):
+        self.public_port = p2p_port(PUBLIC_PORT_INDEX)
+        conf = Socks5Configuration()
+        conf.addr = ("127.0.0.1", p2p_port(PROXY_PORT_INDEX))
+        conf.unauth = True
+        self.socks = Socks5Server(conf)
+        self.socks.start()
+        self.extra_args = [
+            [f"-publicbind=127.0.0.1:{self.public_port}"],
+            [f"-proxy=127.0.0.1:{p2p_port(PROXY_PORT_INDEX)}"],
+        ]
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_nodes()
+
+    def ws_peers(self, n):
+        return [p for p in self.nodes[n].getpeerinfo() if p["transport"] != "tcp"]
+
+    def try_dial(self, n, url, expected_log):
+        with self.nodes[n].assert_debug_log([expected_log]):
+            self.nodes[n].addnode(node=url, command="onetry")
+        # Give a (wrong) direct connection time to show up.
+        time.sleep(1)
+        assert_equal(self.ws_peers(0), [])
+        assert_equal(self.ws_peers(n), [])
+
+    def run_test(self):
+        url = f"wss://localhost:{self.public_port}/p2p/ws"
+
+        self.log.info("With -proxy, a wss:// dial is refused, not made directly")
+        self.try_dial(
+            1, url, "WebSocket peers cannot be reached through -proxy yet"
+        )
+        assert self.socks.queue.empty()
+
+        self.log.info("ws:// too")
+        self.try_dial(
+            1,
+            f"ws://127.0.0.1:{self.public_port}/p2p/ws",
+            "WebSocket peers cannot be reached through -proxy yet",
+        )
+
+        self.log.info("-onlynet without wss refuses WebSocket dials")
+        self.restart_node(1, ["-onlynet=ipv4"])
+        self.try_dial(1, url, "network wss is not reachable")
+
+        self.log.info("Without either, the dial works")
+        self.restart_node(1, [])
+        self.nodes[1].addnode(node=url, command="onetry")
+        self.wait_until(lambda: len(self.ws_peers(1)) == 1)
+
+        self.socks.stop()
+
+
+if __name__ == "__main__":
+    P2PWebSocketProxyTest().main()
