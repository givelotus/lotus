From 8cbd0aa56d7a2ec6a54146bb56066db2b9692069 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 08:11:40 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

Keep the entire versioned WSS address payload when packing typed address fields. The former fixed 32-byte prefix silently changed long hosts and paths. Variable-size adapters reserve their actual size within MAX_SIZE; a value too large for the record is explicitly omitted with fields_truncated. Record/ring size and the wire protocol are unchanged.

The same native regression fails five assertions against the old headers and passes with this repair, including a maximum-length WSS host/path. All five targets build; 67 logging/event/metrics/RPC cases and 154024 assertions pass, plus 14 framework tests and compiler/lint contracts. A calibrated macOS malloc/calloc/realloc/new observer reports zero caller allocations for warm ordinary, Error and full-ring warning paths carrying WSS addresses: 384 ordinary and all 131104 warning records delivered to the callback sink, zero drops; full ring observed. This is a callback allocation/correctness probe, not disk throughput.
---
 doc/logging-api.md               |  6 ++++++
 src/logging/event.h              | 15 ++++++++++---
 src/logging/values.h             | 25 +++++++++++++--------
 src/test/logging_event_tests.cpp | 37 ++++++++++++++++++++++++++++++++
 4 files changed, 71 insertions(+), 12 deletions(-)

diff --git a/doc/logging-api.md b/doc/logging-api.md
index d68642f7a5..19f3141e36 100644
--- a/doc/logging-api.md
+++ b/doc/logging-api.md
@@ -31,6 +31,12 @@ blobs should be represented by their size or hash. Cold startup and severe
 backpressure are separate paths; see [async guarantees](logging-async.md).
 Legacy printf calls still format on the caller until converted.
 
+Variable-size adapters may provide `LogValue<T>::Size(value)` bounded by
+`MAX_SIZE`; the builder reserves only that value's actual bytes. Address
+adapters retain the full raw WSS host/path payload instead of silently
+shortening it to an unrelated endpoint. If the complete value exceeds the
+record, it is omitted and `fields_truncated` is set; record size is unchanged.
+
 A template refers to provided fields by generic name, such as `{peer_id}`.
 Fields not used in the template remain available to structured encoders and
 are appended in text output. Message wording should remain stable during
diff --git a/src/logging/event.h b/src/logging/event.h
index 2045484fb8..bb891f357d 100644
--- a/src/logging/event.h
+++ b/src/logging/event.h
@@ -180,6 +180,9 @@ private:
  *   static size_t Pack(const T &value, std::span<std::byte> out);
  *   static void Render(std::span<const std::byte> packed, std::string &out);
  * Pack copies what Render needs (no pointers to the caller's memory).
+ * A variable-size type may also provide Size(value), at most MAX_SIZE.
+ * Only that many bytes are reserved, so short values of a potentially long
+ * type still fit; a value that does not fit is explicitly marked truncated.
  */
 template <typename T> struct LogValue;
 
@@ -260,14 +263,20 @@ public:
     template <typename T>
         requires requires { LogValue<T>::MAX_SIZE; }
     EventBuilder &Field(FieldKey<FieldType::STRING> key, const T &value) {
+        const size_t capacity{[&] {
+            if constexpr (requires { LogValue<T>::Size(value); }) {
+                return size_t{LogValue<T>::Size(value)};
+            } else {
+                return size_t{LogValue<T>::MAX_SIZE};
+            }
+        }()};
         std::byte *out{Reserve(key.id, FieldKind::CUSTOM,
-                               sizeof(PackedRenderFn) + LogValue<T>::MAX_SIZE)};
+                               sizeof(PackedRenderFn) + capacity)};
         if (out) {
             const PackedRenderFn fn{&LogValue<T>::Render};
             std::memcpy(out, &fn, sizeof(fn));
             const size_t size{LogValue<T>::Pack(
-                value,
-                std::span<std::byte>{out + sizeof(fn), LogValue<T>::MAX_SIZE})};
+                value, std::span<std::byte>{out + sizeof(fn), capacity})};
             Finish(sizeof(fn) + size);
         }
         return *this;
diff --git a/src/logging/values.h b/src/logging/values.h
index 2ecbb92eda..5aa29f2f9b 100644
--- a/src/logging/values.h
+++ b/src/logging/values.h
@@ -21,28 +21,32 @@ namespace BCLog {
 
 /** Network addresses: copied as raw bytes, rendered in canonical form */
 template <> struct LogValue<CNetAddr> {
-    //! Network, scope id, length, then the address (IPv6, Tor v3, I2P...)
-    static constexpr size_t MAX_SIZE{1 + 4 + 1 + 32};
+    //! Network, scope id, uint16 length, then the full address payload.
+    static constexpr size_t MAX_SIZE{1 + 4 + 2 + ADDR_WSS_MAX_SIZE};
+    static size_t Size(const CNetAddr &addr) {
+        return 1 + 4 + 2 + addr.RawAddrBytes().size();
+    }
     static size_t Pack(const CNetAddr &addr, std::span<std::byte> out) {
         const auto bytes{addr.RawAddrBytes()};
-        const uint8_t len{uint8_t(std::min<size_t>(bytes.size(), 32))};
+        const uint16_t len{uint16_t(bytes.size())};
         const uint8_t net{uint8_t(addr.RawNetwork())};
         const uint32_t scope{addr.RawScopeId()};
         std::memcpy(out.data(), &net, 1);
         std::memcpy(out.data() + 1, &scope, 4);
-        std::memcpy(out.data() + 5, &len, 1);
-        std::memcpy(out.data() + 6, bytes.data(), len);
-        return 6 + len;
+        std::memcpy(out.data() + 5, &len, 2);
+        std::memcpy(out.data() + 7, bytes.data(), len);
+        return 7 + len;
     }
     static CNetAddr Unpack(std::span<const std::byte> in) {
-        uint8_t net, len;
+        uint8_t net;
+        uint16_t len;
         uint32_t scope;
         std::memcpy(&net, in.data(), 1);
         std::memcpy(&scope, in.data() + 1, 4);
-        std::memcpy(&len, in.data() + 5, 1);
+        std::memcpy(&len, in.data() + 5, 2);
         return CNetAddr::FromRaw(
             Network(net),
-            Span{reinterpret_cast<const uint8_t *>(in.data() + 6), len}, scope);
+            Span{reinterpret_cast<const uint8_t *>(in.data() + 7), len}, scope);
     }
     static void Render(std::span<const std::byte> in, std::string &out) {
         out += Unpack(in).ToStringAddr();
@@ -52,6 +56,9 @@ template <> struct LogValue<CNetAddr> {
 /** Network address and port */
 template <> struct LogValue<CService> {
     static constexpr size_t MAX_SIZE{2 + LogValue<CNetAddr>::MAX_SIZE};
+    static size_t Size(const CService &service) {
+        return 2 + LogValue<CNetAddr>::Size(service);
+    }
     static size_t Pack(const CService &service, std::span<std::byte> out) {
         const uint16_t port{service.GetPort()};
         std::memcpy(out.data(), &port, 2);
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index f0e6480e2e..f2207c4183 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -565,4 +565,41 @@ BOOST_AUTO_TEST_CASE(peer_address_and_port_are_separate) {
     BOOST_CHECK_EQUAL(record["peer_port"].getInt<int>(), 10605);
 }
 
+BOOST_AUTO_TEST_CASE(wss_packed_address_keeps_full_payload) {
+    CNetAddr address;
+    BOOST_REQUIRE(
+        address.SetWSSDomain("this-is-a-long-websocket-peer-name.example.org",
+                             "/p2p/custom-websocket-path"));
+    std::array<std::byte, BCLog::LogValue<CService>::MAX_SIZE> packed;
+    const CService service{address, 443};
+    const auto size{BCLog::LogValue<CService>::Pack(service, packed)};
+    std::string rendered;
+    BCLog::LogValue<CService>::Render(std::span{packed}.first(size), rendered);
+    BOOST_CHECK_EQUAL(rendered, service.ToStringAddrPort());
+    Format(BCLog::LogFormat::JSON);
+    LogEvent(BCLog::NET, "peer_wss_address", "WSS {addr}")
+        .Field(LogField::PeerId, 42)
+        .Field(LogField::Addr, service);
+    const auto record{Json()};
+    BOOST_CHECK_EQUAL(record["addr"].get_str(), service.ToStringAddrPort());
+    BOOST_CHECK(record["fields_truncated"].isNull());
+    const std::string label(63, 'a');
+    const std::string host{label + "." + label + "." + label + "." +
+                           std::string(61, 'b')};
+    BOOST_REQUIRE_EQUAL(host.size(), 253U);
+    BOOST_REQUIRE(address.SetWSSDomain(host, "/" + std::string(254, 'c')));
+    const CService maximum{address, 443};
+    const auto maximum_size{BCLog::LogValue<CService>::Pack(maximum, packed)};
+    rendered.clear();
+    BCLog::LogValue<CService>::Render(std::span{packed}.first(maximum_size),
+                                      rendered);
+    BOOST_CHECK_EQUAL(rendered, maximum.ToStringAddrPort());
+    LogEvent(BCLog::NET, "peer_wss_address", "WSS {addr}")
+        .Field(LogField::PeerId, 42)
+        .Field(LogField::Addr, maximum);
+    const auto oversized{Json()};
+    BOOST_CHECK(oversized["addr"].isNull());
+    BOOST_CHECK(oversized["fields_truncated"].get_bool());
+}
+
 BOOST_AUTO_TEST_SUITE_END()
