From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:30:08 -0700
Subject: [PATCH] Test Chronik AuxPoW rollback, reconnect and persisted disk
 parity

Extend the retained Dogecoin AuxPoW acceptance/rejection fixture with single-block and whole-chain disconnect/reconnect checks. With Avalanche disabled, compare Chronik chain height, variable-length headers, transaction IDs and disk-read raw transactions to RPC before and after each transition and after restart. This is additional coverage; it does not establish historical mainnet synchronization.

diff --git a/test/functional/chronik_dogecoin_reorg.py b/test/functional/chronik_dogecoin_reorg.py
new file mode 100644
index 0000000000000000000000000000000000000000..c286a0fff6f4585d30a73dd605bf1427d350730a
--- /dev/null
+++ b/test/functional/chronik_dogecoin_reorg.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Independent AuxPoW disconnect/reconnect and Chronik disk parity regression."""
+import io
+from dogecoin_auxpow import DogecoinAuxpowTest
+from test_framework.messages import CBlock, CBlockHeader
+from test_framework.util import assert_equal
+
+class ChronikDogecoinReorgTest(DogecoinAuxpowTest):
+    def set_test_params(self):
+        super().set_test_params()
+        self.extra_args = [["-chronik", "-avalanche=0"]]
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_chronik()
+
+    def check_parity(self, height):
+        node = self.nodes[0]
+        node.syncwithvalidationinterfacequeue()
+        chronik = node.get_chronik_client()
+        assert_equal(chronik.blockchain_info().ok().tip_height, height)
+        for h in range(height + 1):
+            block_hash = node.getblockhash(h)
+            block = CBlock()
+            block.deserialize(io.BytesIO(bytes.fromhex(node.getblock(block_hash, 0))))
+            header = CBlockHeader(block).serialize()
+            if h:
+                assert len(header) > 80
+            assert_equal(chronik.block_header(h).ok().raw_header, header)
+            indexed = chronik.block_txs(h).ok().txs
+            assert_equal(len(indexed), len(block.vtx))
+            for tx, actual in zip(block.vtx, indexed):
+                assert_equal(actual.txid, bytes.fromhex(tx.txid_hex)[::-1])
+                assert_equal(chronik.raw_tx(tx.txid_hex).ok().raw_tx, tx.serialize())
+
+    def run_test(self):
+        super().run_test()
+        node = self.nodes[0]
+        tip = node.getbestblockhash()
+        first = node.getblockhash(1)
+        self.check_parity(2)
+        node.invalidateblock(tip)
+        assert_equal(node.getblockcount(), 1)
+        self.check_parity(1)
+        node.reconsiderblock(tip)
+        assert_equal(node.getbestblockhash(), tip)
+        self.check_parity(2)
+        node.invalidateblock(first)
+        assert_equal(node.getblockcount(), 0)
+        self.check_parity(0)
+        node.reconsiderblock(first)
+        assert_equal(node.getbestblockhash(), tip)
+        self.check_parity(2)
+        assert_equal(node.verifychain(4, 0), True)
+        self.restart_node(0)
+        assert_equal(node.getbestblockhash(), tip)
+        self.check_parity(2)
+
+if __name__ == '__main__':
+    ChronikDogecoinReorgTest().main()
