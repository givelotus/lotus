From f3a774378ea54c99b804aaec5dff90a86add559b Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 08:22:15 -0700
Subject: [PATCH] rpc(v2): advertise the native application message proof
 scheme

Dependent on chain discovery and native message RPC integration. Distinguish the Lotus chain-bound digest from the eCash compact signature domain and publish type-1 message-address parameters separately from receive/send capabilities. Preserve the truthful legacy wallet destination descriptor until native wallet lifecycle support lands. The PWA strict validator must adopt the new scheme in the same integration.
---
 doc/standards/lotus-message-signing.md   | 13 +++++++++++++
 src/rpc/mining.cpp                       | 16 +++++++++++++++-
 test/functional/mining_pow_descriptor.py |  9 ++++++++-
 3 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/doc/standards/lotus-message-signing.md b/doc/standards/lotus-message-signing.md
index 61969973c562ebf47f6514c770a5eb724ec7312d..c6bd5cdb313e26c8ffee72ad334a66b7e6bf0020 100644
--- a/doc/standards/lotus-message-signing.md
+++ b/doc/standards/lotus-message-signing.md
@@ -92,6 +92,19 @@ WIF so the returned envelope has the native header. Do not add another RPC
 just to select the format. Do not mix eCash and Lotus signature domains based
 on the address's text.
 
+## Discovery integration
+
+After both this feature and `getchainconfig` are integrated, the V2 discovery
+adapter reports `features.message_signing` as
+`lotus-chain-bound-compact-ecdsa-v1`, and
+`features.native_keyhash_message_signing` as true. Its `message_address`
+object identifies `format: xpiaddr`, the current network HRP, `types: [1]`,
+and `keyhash: blake3-xonly32`. This describes message RPC support only. It
+must not change the separate global receive/send address capabilities until
+native wallet destination and spending support is actually integrated.
+The PWA's strict ChainConfig validator must adopt this scheme at the same
+integration point, so it never mislabels a Lotus proof as eCash-compatible.
+
 ## Independent digest vector and validation gates
 
 ```
diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 906eea683c932b1797d0cd42d39edcd79f1e4069..286426941ae21175a52aca2ac3bf1c613264dca3 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -696,7 +696,21 @@ static RPCHelpMan getchainconfig() {
             UniValue features(UniValue::VOBJ);
             features.pushKV("legacytransactions", true);
             features.pushKV("nativetransactions", true);
-            features.pushKV("message_signing", "legacy-p2pkh");
+            features.pushKV("message_signing",
+                            "lotus-chain-bound-compact-ecdsa-v1");
+            features.pushKV("native_keyhash_message_signing", true);
+            // This is a message-proof capability, not native wallet payment
+            // readiness. Keep address.format/acceptedformats truthful above.
+            UniValue message_address(UniValue::VOBJ);
+            message_address.pushKV("format", "xpiaddr");
+            message_address.pushKV("hrp", network == "main"      ? "xpi"
+                                          : network == "regtest" ? "rxpi"
+                                                                 : "txpi");
+            message_address.pushKV("keyhash", "blake3-xonly32");
+            UniValue message_types(UniValue::VARR);
+            message_types.push_back(1);
+            message_address.pushKV("types", std::move(message_types));
+            features.pushKV("message_address", std::move(message_address));
             UniValue node(UniValue::VOBJ);
             node.pushKV("client", CLIENT_NAME);
             node.pushKV("version", CLIENT_VERSION);
diff --git a/test/functional/mining_pow_descriptor.py b/test/functional/mining_pow_descriptor.py
index bd7104b3b3a714dc5e2a96ad9d79831b76e5a569..202e1d869f437bba21d6dc0cd7556a265d9695fc 100644
--- a/test/functional/mining_pow_descriptor.py
+++ b/test/functional/mining_pow_descriptor.py
@@ -109,7 +109,14 @@ class MiningProofOfWorkTest(BitcoinTestFramework):
             {
                 "legacytransactions": True,
                 "nativetransactions": self.expected_kind() == "lotus-v2",
-                "message_signing": "legacy-p2pkh",
+                "message_signing": "lotus-chain-bound-compact-ecdsa-v1",
+                "native_keyhash_message_signing": True,
+                "message_address": {
+                    "format": "xpiaddr",
+                    "hrp": "rxpi",
+                    "types": [1],
+                    "keyhash": "blake3-xonly32",
+                },
             },
         )
         assert config["node"]["client"]
-- 
