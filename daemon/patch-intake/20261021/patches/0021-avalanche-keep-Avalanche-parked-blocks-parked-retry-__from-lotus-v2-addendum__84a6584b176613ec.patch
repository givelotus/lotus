From 8d75848e69c930634f79c223db126ec9be5f05ed Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:41:36 -0700
Subject: [PATCH] avalanche: keep Avalanche-parked blocks parked; retry only
 batch parks by work

ecash/014 made -automaticunparking default to true even with Avalanche,
so that a finalized-batch mismatch park is a temporary work penalty. That
also undid every other park. When Avalanche rejects the tip, the fork
point is the tip's parent, the ABC fork penalty is zero, and
FindMostWorkChain unparked the block in the same call ("Unpark chain up
to block ... as it has accumulated enough PoW"). The rejected block came
straight back. Avalanche finalization waits and miner-fund, staking-reward
and RTT policy parks then never held.

Restore the upstream default (automatic unparking off when Avalanche is
on). Batch-mismatch parks are still retried by work regardless of that
option, but only when every park on the candidate's path is a batch park.
Such a park still needs more than its own head's work, and finalized
ancestry still wins.

Tests: avalanche_park_is_not_undone_by_work (a parked tip stays parked
under Avalanche defaults); avalanche_defaults_keep_upstream_unparking;
init_tests is back to the upstream expectation. The existing batch retry
tests now run with automatic unparking off: without the FindMostWorkChain
change they fail 9 checks, and with it they pass.

Tier: eCash (fixup to ecash/014)
---
 src/avalanche/test/init_tests.cpp             |  2 +-
 .../test/preconsensus_batch_tests.cpp         | 31 ++++++++++++++++---
 src/init.cpp                                  |  4 ++-
 src/node/chainstatemanager_args.cpp           |  9 ++++--
 src/validation.cpp                            | 27 ++++++++++++++--
 5 files changed, 61 insertions(+), 12 deletions(-)

diff --git a/src/avalanche/test/init_tests.cpp b/src/avalanche/test/init_tests.cpp
index f8d589a132..7efb4f7aac 100644
--- a/src/avalanche/test/init_tests.cpp
+++ b/src/avalanche/test/init_tests.cpp
@@ -26,7 +26,7 @@ BOOST_AUTO_TEST_CASE(avalanche_flag_tests) {
         args.ForceSetArg("-avalanche", "1");
         InitParameterInteraction(args);
 
-        BOOST_CHECK_EQUAL(args.GetBoolArg("-automaticunparking", true), true);
+        BOOST_CHECK_EQUAL(args.GetBoolArg("-automaticunparking", true), false);
     }
 
     {
diff --git a/src/avalanche/test/preconsensus_batch_tests.cpp b/src/avalanche/test/preconsensus_batch_tests.cpp
index 12b02280cb..743af63c12 100644
--- a/src/avalanche/test/preconsensus_batch_tests.cpp
+++ b/src/avalanche/test/preconsensus_batch_tests.cpp
@@ -125,19 +125,42 @@ BOOST_FIXTURE_TEST_CASE(avaresponse_burst_preserves_individual_messages,
     }
 }
 
-BOOST_FIXTURE_TEST_CASE(preconsensus_defaults_keep_work_based_unparking,
+BOOST_FIXTURE_TEST_CASE(avalanche_defaults_keep_upstream_unparking,
                         BasicTestingSetup) {
     kernel::Notifications notifications;
     ChainstateManager::Options opts{.config = GetConfig(),
                                     .notifications = notifications};
-    BOOST_CHECK(opts.automatic_unparking);
     ArgsManager args;
     args.ForceSetArg("-avalanche", "1");
     BOOST_REQUIRE(!node::ApplyArgsManOptions(args, opts));
+    BOOST_CHECK(!opts.automatic_unparking);
+    args.ForceSetArg("-avalanche", "0");
+    BOOST_REQUIRE(!node::ApplyArgsManOptions(args, opts));
     BOOST_CHECK(opts.automatic_unparking);
-    args.ForceSetArg("-automaticunparking", "0");
+    args.ForceSetArg("-avalanche", "1");
+    args.ForceSetArg("-automaticunparking", "1");
     BOOST_REQUIRE(!node::ApplyArgsManOptions(args, opts));
-    BOOST_CHECK(!opts.automatic_unparking);
+    BOOST_CHECK(opts.automatic_unparking);
+}
+
+// An Avalanche rejection parks the block. With Avalanche on, automatic
+// unparking is off, so the parked tip must not come back merely because
+// its own work exceeds the (zero) penalty of a fork at the tip. The batch
+// retry tests below run with these same defaults.
+BOOST_FIXTURE_TEST_CASE(avalanche_park_is_not_undone_by_work,
+                        AvalancheTestChain100Setup) {
+    auto &chainman = *m_node.chainman;
+    auto &chainstate = chainman.ActiveChainstate();
+    BOOST_REQUIRE(!chainman.m_options.automatic_unparking);
+    CBlockIndex *tip = WITH_LOCK(cs_main, return chainman.ActiveTip());
+    CBlockIndex *parent = tip->pprev;
+    BlockValidationState state;
+    BOOST_REQUIRE(chainstate.ParkBlock(state, tip));
+    BOOST_REQUIRE(chainstate.ActivateBestChain(state, nullptr,
+                                               m_node.avalanche.get()));
+    BOOST_CHECK_EQUAL(WITH_LOCK(cs_main, return chainman.ActiveTip()), parent);
+    WITH_LOCK(cs_main, BOOST_CHECK(tip->nStatus.isParked()));
+    WITH_LOCK(cs_main, BOOST_CHECK(!tip->m_preconsensus_policy_parked));
 }
 
 BOOST_FIXTURE_TEST_CASE(work_unparking_preserves_finalized_ancestry,
diff --git a/src/init.cpp b/src/init.cpp
index 5b58b7d035..1aea6b7634 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -2036,7 +2036,9 @@ void InitParameterInteraction(ArgsManager &args) {
 
     // If avalanche is set, soft set all the feature flags accordingly.
     if (args.IsArgSet("-avalanche")) {
-        args.SoftSetBoolArg("-automaticunparking", true);
+        const bool fAvalanche =
+            args.GetBoolArg("-avalanche", AVALANCHE_DEFAULT_ENABLED);
+        args.SoftSetBoolArg("-automaticunparking", !fAvalanche);
     }
 }
 
diff --git a/src/node/chainstatemanager_args.cpp b/src/node/chainstatemanager_args.cpp
index 10c653620c..648021ecc8 100644
--- a/src/node/chainstatemanager_args.cpp
+++ b/src/node/chainstatemanager_args.cpp
@@ -95,9 +95,12 @@ ApplyArgsManOptions(const ArgsManager &args, ChainstateManager::Options &opts) {
         opts.park_deep_reorg = *value;
     }
 
-    // Preconsensus parking is a temporary work penalty, including when
-    // Avalanche is enabled. An operator can explicitly disable unparking.
-    opts.automatic_unparking = args.GetBoolArg("-automaticunparking", true);
+    // Avalanche-parked chains stay parked unless the operator asks for
+    // unparking. Finalized-batch mismatches are retried by work regardless;
+    // see Chainstate::FindMostWorkChain.
+    opts.automatic_unparking = args.GetBoolArg(
+        "-automaticunparking",
+        !args.GetBoolArg("-avalanche", AVALANCHE_DEFAULT_ENABLED));
 
     opts.replay_protection_activation_time =
         gArgs.GetIntArg("-replayprotectionactivationtime");
diff --git a/src/validation.cpp b/src/validation.cpp
index aed08b0277..574c1b3f26 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -5570,6 +5570,27 @@ CBlockIndex *Chainstate::FindMostWorkChain(
 
         const CBlockIndex *pindexFork = m_chain.FindFork(pindexNew);
 
+        // A finalized-batch mismatch is a temporary work penalty, even when
+        // general automatic unparking is off (the Avalanche default). It only
+        // applies when every park on the candidate's path is such a park, so
+        // Avalanche rejections and other parks stay parked as upstream.
+        bool fBatchRetryOnly = false;
+        if (!fAutoUnpark) {
+            bool sawBatchPark = false;
+            bool sawOtherPark = false;
+            for (const CBlockIndex *p = pindexNew; p && p != pindexFork;
+                 p = p->pprev) {
+                if (p->nStatus.isParked()) {
+                    if (p->m_preconsensus_policy_parked) {
+                        sawBatchPark = true;
+                    } else {
+                        sawOtherPark = true;
+                    }
+                }
+            }
+            fBatchRetryOnly = sawBatchPark && !sawOtherPark;
+        }
+
         // Check whether all blocks on the path between the currently active
         // chain and the candidate are valid. Just going until the active chain
         // is an optimization, as we know all blocks in it are valid already.
@@ -5581,7 +5602,8 @@ CBlockIndex *Chainstate::FindMostWorkChain(
             // If this is a parked chain, but it has enough PoW, clear the park
             // state.
             bool fParkedChain = pindexTest->nStatus.isOnParkedChain();
-            if (fAutoUnpark && fParkedChain && !conflictsFinalizedAncestry) {
+            if ((fAutoUnpark || fBatchRetryOnly) && fParkedChain &&
+                !conflictsFinalizedAncestry) {
                 const CBlockIndex *pindexTip = m_chain.Tip();
 
                 // During initialization, pindexTip and/or pindexFork may be
@@ -5826,8 +5848,7 @@ bool Chainstate::ActivateBestChainStep(
                     // Let FindMostWorkChain apply the ordinary work/finality
                     // checks instead of losing that candidate until new data.
                     if (pindexConnect->m_preconsensus_policy_parked &&
-                        pindexMostWork != pindexConnect &&
-                        m_chainman.m_options.automatic_unparking) {
+                        pindexMostWork != pindexConnect) {
                         TryAddBlockIndexCandidate(pindexMostWork);
                     }
                     fContinue = false;
