diff --git a/src/lotus_v2/blocksnap.cpp b/src/lotus_v2/blocksnap.cpp
new file mode 100644
index 0000000000..0298157a8e
--- /dev/null
+++ b/src/lotus_v2/blocksnap.cpp
@@ -0,0 +1,209 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <lotus_v2/blocksnap.h>
+
+#include <blockencodings.h>
+#include <crypto/sha256.h>
+#include <hash.h>
+
+#include <cstring>
+
+namespace lotus::v2 {
+
+namespace {
+
+inline uint256 HashToUint256(const Hash &h) noexcept {
+    uint256 out;
+    std::memcpy(out.begin(), h.data(), 32);
+    return out;
+}
+
+inline Hash Uint256ToHash(const uint256 &u) noexcept {
+    Hash out{};
+    std::memcpy(out.data(), u.begin(), 32);
+    return out;
+}
+
+} // namespace
+
+uint256 ComputeMerkleRootFromBranch(const uint256 &leaf,
+                                    const std::vector<uint256> &branch,
+                                    uint32_t index) noexcept {
+    uint256 cur = leaf;
+    uint8_t buf[64];
+    for (const uint256 &sibling : branch) {
+        if ((index & 1U) != 0) {
+            std::memcpy(buf, sibling.begin(), 32);
+            std::memcpy(buf + 32, cur.begin(), 32);
+        } else {
+            std::memcpy(buf, cur.begin(), 32);
+            std::memcpy(buf + 32, sibling.begin(), 32);
+        }
+        SHA256D64(cur.begin(), buf, 1);
+        index >>= 1U;
+    }
+    return cur;
+}
+
+void ComputeNullMerkleRootAndBranch(
+    const std::vector<CTransactionRef> &sorted_txs,
+    uint256 &null_merkle_root_out,
+    std::vector<uint256> &coinbase_branch_out) {
+    coinbase_branch_out.clear();
+    if (sorted_txs.empty()) {
+        null_merkle_root_out = uint256::ZERO;
+        return;
+    }
+
+    const size_t total_leaves = 1 + sorted_txs.size();
+    std::vector<uint256> level;
+    level.reserve((total_leaves + 1) & ~size_t(1));
+    level.push_back(uint256::ZERO);
+    for (const auto &tx : sorted_txs) {
+        level.push_back(tx ? tx->GetId() : uint256::ZERO);
+    }
+
+    while (level.size() > 1) {
+        if (level.size() & 1U) {
+            level.push_back(level.back());
+        }
+        coinbase_branch_out.push_back(level[1]);
+        const size_t pairs = level.size() / 2;
+        SHA256D64(level[0].begin(), level[0].begin(), pairs);
+        level.resize(pairs);
+    }
+    null_merkle_root_out = level[0];
+}
+
+void ComputeBlockCoinbaseMerkleBranch(
+    const CBlock &block, uint256 &null_merkle_root_out,
+    std::vector<uint256> &coinbase_branch_out) {
+    if (block.vtx.size() <= 1) {
+        null_merkle_root_out = uint256::ZERO;
+        coinbase_branch_out.clear();
+        return;
+    }
+    std::vector<CTransactionRef> non_cb(block.vtx.begin() + 1, block.vtx.end());
+    ComputeNullMerkleRootAndBranch(non_cb, null_merkle_root_out,
+                                   coinbase_branch_out);
+}
+
+SealedBlock::SealedBlock(const CBlock &block,
+                         std::vector<uint256> epoch_batch_ids_in)
+    : header(block.GetBlockHeader()),
+      tx_coinbase(block.vtx.empty() ? CTransactionRef{} : block.vtx[0]),
+      epoch_batch_ids(std::move(epoch_batch_ids_in)) {
+    uint256 unused_null_root;
+    ComputeBlockCoinbaseMerkleBranch(block, unused_null_root,
+                                     coinbase_merkle_branch);
+}
+
+SealedBlock::SealedBlock(const CBlockHeader &header_in,
+                         CTransactionRef coinbase_in,
+                         std::vector<uint256> branch_in,
+                         std::vector<uint256> epoch_ids_in)
+    : header(header_in), tx_coinbase(std::move(coinbase_in)),
+      coinbase_merkle_branch(std::move(branch_in)),
+      epoch_batch_ids(std::move(epoch_ids_in)) {}
+
+SealedBlock::SealedBlock(const CBlockHeader &header_in,
+                         CTransactionRef coinbase_in,
+                         const MempoolOverlayLayer &layer)
+    : header(header_in), tx_coinbase(std::move(coinbase_in)) {
+    const auto &layer_branch = layer.GetCoinbaseMerkleBranch();
+    coinbase_merkle_branch.reserve(layer_branch.size());
+    for (const Hash &h : layer_branch) {
+        coinbase_merkle_branch.push_back(HashToUint256(h));
+    }
+    epoch_batch_ids.push_back(HashToUint256(layer.GetSubtreeARoot()));
+}
+
+bool SealedBlock::VerifyMerkleSpine(
+    const uint256 &local_null_merkle_root) const noexcept {
+    if (!IsValid()) {
+        return false;
+    }
+    const uint256 computed_null_root = ComputeMerkleRootFromBranch(
+        uint256::ZERO, coinbase_merkle_branch, /*index=*/0);
+    if (computed_null_root != local_null_merkle_root) {
+        return false;
+    }
+    const uint256 computed_merkle_root = ComputeMerkleRootFromBranch(
+        tx_coinbase->GetId(), coinbase_merkle_branch, /*index=*/0);
+    return computed_merkle_root == header.hashMerkleRoot;
+}
+
+bool SealedBlock::VerifyAgainstLayer(const MempoolOverlayLayer &layer) const {
+    if (!IsValid()) {
+        return false;
+    }
+    const Hash cb_tx_id = Uint256ToHash(tx_coinbase->GetId());
+    if (layer.Contains(cb_tx_id)) {
+        return false;
+    }
+    const auto &layer_branch = layer.GetCoinbaseMerkleBranch();
+    if (coinbase_merkle_branch.size() != layer_branch.size()) {
+        return false;
+    }
+    const uint256 local_null_root = HashToUint256(layer.GetNullMerkleRoot());
+    return VerifyMerkleSpine(local_null_root);
+}
+
+std::shared_ptr<const CBlock>
+SealedBlock::ReconstructBlock(const MempoolOverlayLayer &layer) const {
+    if (!VerifyAgainstLayer(layer)) {
+        return nullptr;
+    }
+    auto block = std::make_shared<CBlock>(header);
+    block->vtx.reserve(1 + layer.GetTxCount());
+    block->vtx.push_back(tx_coinbase);
+    for (const auto &[_, oentry] : layer.GetOrderedTxs()) {
+        CTransactionRef tx =
+            std::static_pointer_cast<const CTransaction>(oentry.tx_ref);
+        if (!tx) {
+            return nullptr;
+        }
+        block->vtx.push_back(std::move(tx));
+    }
+    block->m_checked_merkle_root = true;
+    return block;
+}
+
+std::shared_ptr<const CBlock>
+SealedBlock::ReconstructBlock(const MerklixOverlayManager &mgr) const {
+    if (!IsValid()) {
+        return nullptr;
+    }
+    const auto &frozen = mgr.GetFrozenEpochs();
+    if (!epoch_batch_ids.empty()) {
+        for (const uint256 &target_id : epoch_batch_ids) {
+            const Hash target_hash = Uint256ToHash(target_id);
+            for (auto it = frozen.rbegin(); it != frozen.rend(); ++it) {
+                if (it->GetSubtreeARoot() == target_hash ||
+                    it->GetNullMerkleRoot() == target_hash) {
+                    if (auto blk = ReconstructBlock(*it)) {
+                        return blk;
+                    }
+                }
+            }
+            const auto &spec = mgr.GetSpeculativeOverlay();
+            if (spec.GetSubtreeARoot() == target_hash ||
+                spec.GetNullMerkleRoot() == target_hash) {
+                if (auto blk = ReconstructBlock(spec)) {
+                    return blk;
+                }
+            }
+        }
+    }
+
+    for (auto it = frozen.rbegin(); it != frozen.rend(); ++it) {
+        if (auto blk = ReconstructBlock(*it)) {
+            return blk;
+        }
+    }
+    return ReconstructBlock(mgr.GetSpeculativeOverlay());
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/blocksnap.h b/src/lotus_v2/blocksnap.h
new file mode 100644
index 0000000000..148af15206
--- /dev/null
+++ b/src/lotus_v2/blocksnap.h
@@ -0,0 +1,129 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_LOTUS_V2_BLOCKSNAP_H
+#define BITCOIN_LOTUS_V2_BLOCKSNAP_H
+
+#include <lotus_v2/mempool_overlay.h>
+#include <primitives/block.h>
+#include <primitives/transaction.h>
+#include <serialize.h>
+#include <uint256.h>
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace lotus::v2 {
+
+/**
+ * Compute the positional SHA-256d Merkle root from a leaf hash at `index`
+ * (0 for the coinbase slot along the leftmost spine) and its sibling hashes
+ * `branch` from bottom (leaf level) to top.
+ */
+uint256 ComputeMerkleRootFromBranch(const uint256 &leaf,
+                                    const std::vector<uint256> &branch,
+                                    uint32_t index = 0) noexcept;
+
+/**
+ * Given a CTOR-sorted list of non-coinbase transactions, run a single flat
+ * SHA-256d pass with a placeholder `uint256::ZERO` leaf at index 0 to compute:
+ * - `null_merkle_root_out`: positional Merkle root with `uint256::ZERO` at slot 0.
+ * - `coinbase_branch_out`: the ceil(log2(N + 1)) (<= 16) sibling hashes along
+ *   the leftmost spine.
+ */
+void ComputeNullMerkleRootAndBranch(
+    const std::vector<CTransactionRef> &sorted_txs,
+    uint256 &null_merkle_root_out,
+    std::vector<uint256> &coinbase_branch_out);
+
+/**
+ * Extract the leftmost-spine `coinbase_merkle_branch` and `null_merkle_root`
+ * directly from an assembled `CBlock` (`block.vtx[1..N]`).
+ */
+void ComputeBlockCoinbaseMerkleBranch(
+    const CBlock &block, uint256 &null_merkle_root_out,
+    std::vector<uint256> &coinbase_branch_out);
+
+/**
+ * Fixed-size BlockSnap (`SealedBlock`) announcement for standard 80-byte
+ * headers and positional SHA-256d Merkle trees (~1.2 KB regardless of block
+ * size).
+ *
+ * Carries:
+ * - Standard 80-byte `CBlockHeader`
+ * - `CTransactionRef tx_coinbase`
+ * - `std::vector<uint256> coinbase_merkle_branch` (<= 16 spine siblings)
+ * - `std::vector<uint256> epoch_batch_ids`
+ *
+ * Receiver verification (in O(log N) <= 16 SHA-256d hashes, zero tx re-hashing):
+ * 1. `ComputeMerkleRootFromBranch(uint256::ZERO, coinbase_merkle_branch, 0) == local_epoch.null_merkle_root`
+ *    (proves the miner used the exact same transaction set and authenticates the spine siblings)
+ * 2. `ComputeMerkleRootFromBranch(tx_coinbase->GetId(), coinbase_merkle_branch, 0) == header.hashMerkleRoot`
+ *    (proves `header.hashMerkleRoot` commits to `tx_coinbase` + the pre-synced epoch transactions)
+ */
+class SealedBlock {
+public:
+    static constexpr size_t MAX_MERKLE_BRANCH_DEPTH = 32;
+    static constexpr size_t MAX_EPOCH_BATCH_IDS = 16;
+
+    CBlockHeader header;
+    CTransactionRef tx_coinbase;
+    std::vector<uint256> coinbase_merkle_branch;
+    std::vector<uint256> epoch_batch_ids;
+
+    SealedBlock() = default;
+    explicit SealedBlock(const CBlock &block,
+                         std::vector<uint256> epoch_batch_ids_in = {});
+    SealedBlock(const CBlockHeader &header_in, CTransactionRef coinbase_in,
+                std::vector<uint256> branch_in = {},
+                std::vector<uint256> epoch_ids_in = {});
+    SealedBlock(const CBlockHeader &header_in, CTransactionRef coinbase_in,
+                const MempoolOverlayLayer &layer);
+
+    bool IsValid() const noexcept {
+        return !header.IsNull() && tx_coinbase != nullptr &&
+               !tx_coinbase->IsNull() && tx_coinbase->IsCoinBase() &&
+               coinbase_merkle_branch.size() <= MAX_MERKLE_BRANCH_DEPTH &&
+               epoch_batch_ids.size() <= MAX_EPOCH_BATCH_IDS;
+    }
+
+    /**
+     * Authenticate both the transaction set (via `local_null_merkle_root`) and
+     * the block header's `hashMerkleRoot` (via `tx_coinbase->GetId()`) using
+     * only the leftmost Merkle spine.
+     */
+    bool VerifyMerkleSpine(const uint256 &local_null_merkle_root) const noexcept;
+
+    /**
+     * Verify this `SealedBlock` against a frozen or speculative
+     * `MempoolOverlayLayer` in O(log N) (<= 16 SHA-256d hashes).
+     */
+    bool VerifyAgainstLayer(const MempoolOverlayLayer &layer) const;
+
+    /**
+     * Reconstruct the full `CBlock` in O(1) from a verified
+     * `MempoolOverlayLayer` without re-hashing the N transactions.
+     * Marks `block->m_checked_merkle_root = true` so `CheckBlock` skips
+     * redundant full-block Merkle hashing.
+     */
+    std::shared_ptr<const CBlock>
+    ReconstructBlock(const MempoolOverlayLayer &layer) const;
+
+    /**
+     * Search `mgr`'s frozen epoch layers and speculative layer (prioritizing
+     * any `epoch_batch_ids` match) and reconstruct the full `CBlock` in O(1).
+     */
+    std::shared_ptr<const CBlock>
+    ReconstructBlock(const MerklixOverlayManager &mgr) const;
+
+    SERIALIZE_METHODS(SealedBlock, obj) {
+        READWRITE(obj.header, Using<DefaultFormatter>(obj.tx_coinbase),
+                  obj.coinbase_merkle_branch, obj.epoch_batch_ids);
+    }
+};
+
+} // namespace lotus::v2
+
+#endif // BITCOIN_LOTUS_V2_BLOCKSNAP_H
