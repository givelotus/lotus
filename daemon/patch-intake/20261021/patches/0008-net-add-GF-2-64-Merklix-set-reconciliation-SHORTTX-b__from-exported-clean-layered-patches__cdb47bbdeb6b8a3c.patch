+        v2_handler->SetScopedTransactions(scope, context_id, {shared_tx});
+        remote_handler.SetScopedTransactions(
+            scope, context_id,
+            {shared_tx, single_missing_tx, pair_missing_tx1, pair_missing_tx2});
