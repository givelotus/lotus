+ */
+struct PrecomputedBatchTxData {
+    PrecomputedTransactionData txdata;
+    TxValidationState regular_tx_state;
+    bool regular_tx_checked{false};
+    bool regular_tx_valid{false};
+    bool precomputed_txdata_ready{false};
