From 53f4389723d8d6a39b513412817865ad1440c687 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:48:21 -0700
Subject: [PATCH] fixup! wallet: deliver chain notifications to each wallet on
 its own FIFO worker

Log the original standard exception text from a wallet notification callback, then rethrow into the existing queue failure handler. Unknown exceptions are identified separately. Preserve fail-stop shutdown, discarded later callbacks and completion fences.

The injected callback-failure regression now requires the original diagnostic text and still verifies shutdown, exact causal event counts, discarded block/flush callbacks and completed fence. Native focused regression passes. Drain fixture mining notifications before registering each dedicated-worker test subscriber, preserving exact ordered event oracles rather than allowing a pre-test block into them.

Tier: ECASH
---
 src/node/interfaces.cpp                | 10 +++++++++-
 src/test/validationinterface_tests.cpp | 11 +++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/node/interfaces.cpp b/src/node/interfaces.cpp
index 5c92078561..ecf19d8ee2 100644
--- a/src/node/interfaces.cpp
+++ b/src/node/interfaces.cpp
@@ -546,7 +546,15 @@ namespace {
             m_queue->Enqueue(TASK_OVERHEAD + bytes,
                              [this, f = std::forward<F>(f)]() mutable {
                                  if (!m_failed.load()) {
-                                     f();
+                                     try {
+                                         f();
+                                     } catch (const std::exception &e) {
+                                         LogPrintf("Wallet notification callback exception: %s\n", e.what());
+                                         throw;
+                                     } catch (...) {
+                                         LogPrintf("Wallet notification callback exception: unknown exception\n");
+                                         throw;
+                                     }
                                  }
                              });
         }
diff --git a/src/test/validationinterface_tests.cpp b/src/test/validationinterface_tests.cpp
index 94f9e263e0..ef9498ddff 100644
--- a/src/test/validationinterface_tests.cpp
+++ b/src/test/validationinterface_tests.cpp
@@ -20,6 +20,7 @@
 #include <util/validation_queue_memory.h>
 
 #include <test/util/setup_common.h>
+#include <test/util/logging.h>
 
 #include <boost/test/unit_test.hpp>
 
@@ -1093,6 +1094,8 @@ constexpr auto DEDICATED_WORKER =
 
 BOOST_FIXTURE_TEST_CASE(async_notifications_offload_scheduler,
                         TestChain100Setup) {
+    // Fixture callbacks predate this subscriber and its causal event oracle.
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
     using namespace std::chrono_literals;
     std::promise<void> release;
     auto released = release.get_future().share();
@@ -1137,6 +1140,8 @@ BOOST_FIXTURE_TEST_CASE(async_notifications_offload_scheduler,
 
 BOOST_FIXTURE_TEST_CASE(async_notifications_preserve_order_across_reorg,
                         TestChain100Setup) {
+    // Fixture callbacks predate this subscriber and its causal event oracle.
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
     auto async_fake = std::make_shared<RecordingNotifications>();
     auto sync_fake = std::make_shared<RecordingNotifications>();
     auto async_handler =
@@ -1182,6 +1187,8 @@ BOOST_FIXTURE_TEST_CASE(async_notifications_preserve_order_across_reorg,
 
 BOOST_FIXTURE_TEST_CASE(async_notifications_disconnect_drains,
                         TestChain100Setup) {
+    // Fixture callbacks predate this subscriber and its causal event oracle.
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
     using namespace std::chrono_literals;
     std::promise<void> release;
     auto released = release.get_future().share();
@@ -1218,6 +1225,10 @@ BOOST_FIXTURE_TEST_CASE(async_notifications_disconnect_drains,
 
 BOOST_FIXTURE_TEST_CASE(async_notifications_worker_exception_discards_rest,
                         TestChain100Setup) {
+    ASSERT_DEBUG_LOG("Wallet notification callback exception: injected wallet failure");
+    // Fixture mining may still have callbacks queued. They predate both
+    // subscribers and must not enter the three-block causal event oracle.
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
     std::promise<void> release;
     auto released = release.get_future().share();
     auto fake = std::make_shared<RecordingNotifications>();
