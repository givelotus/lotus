+bool DecodeGetBlockUndoRequest(const std::vector<uint8_t> &bytes,
+                               GetBlockUndoRequest &out,
+                               std::string &error) {
+    if (bytes.size() != 32) {
+        error = "invalid getblockundo request size";
+        return false;
