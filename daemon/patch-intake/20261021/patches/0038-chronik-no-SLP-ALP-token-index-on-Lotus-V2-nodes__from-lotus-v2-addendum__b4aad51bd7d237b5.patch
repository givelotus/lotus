diff --git a/chronik/chronik-cpp/chronik.cpp b/chronik/chronik-cpp/chronik.cpp
index c730c8d423..820a33e135 100644
--- a/chronik/chronik-cpp/chronik.cpp
+++ b/chronik/chronik-cpp/chronik.cpp
@@ -182,6 +182,19 @@ ParseChronikParams(const ArgsManager &args, const Config &config, bool fWipe) {
                        .c_str())}};
     }
 
+    // Lotus V2 nodes (recognised by their V2 output fields) do not index
+    // SLP/ALP tokens (user decision 2026-10-19), as in the native Chronik:
+    // the token index defaults to off and cannot be enabled.
+    constexpr bool is_lotus_v2_node =
+        requires(const CTxOut &output) { output.vBranches; };
+    const bool enable_token_index =
+        args.GetBoolArg("-chroniktokenindex", !is_lotus_v2_node);
+    if (is_lotus_v2_node && enable_token_index) {
+        return {{_("-chroniktokenindex=1 is not supported: Lotus V2 nodes do "
+                   "not index SLP/ALP tokens. Remove it or use "
+                   "-chroniktokenindex=0.")}};
+    }
+
     return {{
         .net = ParseNet(params.GetChainType()),
         .datadir = args.GetDataDirBase().u8string(),
@@ -191,7 +204,7 @@ ParseChronikParams(const ArgsManager &args, const Config &config, bool fWipe) {
                                              : DEFAULT_BINDS),
         .default_port = BaseParams().ChronikPort(),
         .wipe_db = fWipe,
-        .enable_token_index = args.GetBoolArg("-chroniktokenindex", true),
+        .enable_token_index = enable_token_index,
         .enable_lokad_id_index = args.GetBoolArg("-chroniklokadidindex", true),
         .enable_scripthash_index = is_scripthashindex_enabled,
         .is_pause_allowed = is_pause_allowed,
diff --git a/src/init.cpp b/src/init.cpp
index ec7cdb8685..b654800fbb 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -795,7 +795,8 @@ void SetupServerArgs(NodeContext &node) {
                   DEFAULT_CHRONIK_PUBLIC_ON_RPC_PORT),
         ArgsManager::ALLOW_ANY, OptionsCategory::CHRONIK);
     argsman.AddArg("-chroniktokenindex",
-                   "Enable token indexing in Chronik (default: 1)",
+                   "Enable SLP/ALP token indexing in Chronik (default: 1; "
+                   "not supported on Lotus V2 nodes, default 0)",
                    ArgsManager::ALLOW_ANY, OptionsCategory::CHRONIK);
     argsman.AddArg("-chroniklokadidindex",
                    "Enable LOKAD ID indexing in Chronik (default: 1)",
