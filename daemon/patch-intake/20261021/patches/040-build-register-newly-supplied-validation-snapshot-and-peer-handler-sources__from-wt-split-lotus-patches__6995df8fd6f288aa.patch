From 24d02b7154c8a0e21851e0a94eca7f03e2d58606 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] build: register newly supplied validation, snapshot and
 peer-handler sources

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Fast-path single-input CheckRegularTransaction duplicate-input checks,
coalesce BlockUndo disk writes, and optimize bulk mempool clear.

Original-Commit: a4ea86865414bbf4f98512bbd4460e2a42897acc
Original-Patch: ecash/020
Split-Concern: build

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/CMakeLists.txt          |  7 +++++--
 src/lotus_v2/CMakeLists.txt | 30 ++++++++++++++++++++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index cd17ec8244c1a2028c066ca857ce44bd271fae84..446f5e53fcc40a639834738d4239ee59952980a1 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -558,7 +558,7 @@ add_library(common
 	${NETWORK_SOURCES}
 )
 
-target_link_libraries(common bitcoinconsensus util secp256k1 script)
+target_link_libraries(common bitcoinconsensus util secp256k1 script lotus_v2_header)
 
 # script library
 add_library(script
@@ -656,6 +656,7 @@ add_library(server
 	minerfund.cpp
 	net.cpp
 	net_processing.cpp
+	net/v2_protocol_handler.cpp
 	node/abort.cpp
 	node/blockfitter.cpp
 	node/blockmanager_args.cpp
@@ -676,6 +677,7 @@ add_library(server
 	node/miner.cpp
 	node/peerman_args.cpp
 	node/psbt.cpp
+	node/snapshot.cpp
 	node/transaction.cpp
 	node/ui_interface.cpp
 	node/utxo_snapshot.cpp
@@ -871,6 +873,7 @@ if(BUILD_CHAINSTATE)
 		node/blockfitter.cpp
 		node/blockstorage.cpp
 		node/chainstate.cpp
+		node/snapshot.cpp
 		node/utxo_snapshot.cpp
 		policy/fees.cpp
 		policy/packages.cpp
@@ -974,7 +977,7 @@ if(BUILD_CHAINSTATE)
 			# To access the config/ and obj/ directories
 			${CMAKE_CURRENT_BINARY_DIR}
 	)
-	target_link_libraries(bitcoinkernel crypto univalue secp256k1 lotus_v2_mdbx leveldb)
+	target_link_libraries(bitcoinkernel crypto univalue secp256k1 lotus_v2_header lotus_v2_mdbx leveldb)
 	link_boost_headers_only(bitcoinkernel headers)
 
 	if(${CMAKE_SYSTEM_NAME} MATCHES "Windows")
diff --git a/src/lotus_v2/CMakeLists.txt b/src/lotus_v2/CMakeLists.txt
index de741bc5601e8a76571eef115e73902b32644795..4b6b13934450cac0811dd1536ebfe06c14d2ab96 100644
--- a/src/lotus_v2/CMakeLists.txt
+++ b/src/lotus_v2/CMakeLists.txt
@@ -1,3 +1,33 @@
+if(NOT TARGET Boost::headers)
+    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.30)
+        cmake_policy(SET CMP0167 OLD)
+    endif()
+    find_package(Boost 1.64 REQUIRED)
+endif()
+
+add_library(lotus_v2_header STATIC
+    tagged_hash.cpp
+    signing.cpp
+    output.cpp
+    commitment.cpp
+    sparse_state.cpp
+    set_reconciliation.cpp
+    utxo_fast_filter.cpp
+    mempool_overlay.cpp
+    blocksnap.cpp
+    fast_sync.cpp
+    fee_hysteresis.cpp
+)
+target_include_directories(lotus_v2_header PUBLIC
+    "${CMAKE_CURRENT_SOURCE_DIR}"
+    ..
+)
+target_link_libraries(lotus_v2_header PUBLIC
+    secp256k1
+    crypto
+    Boost::headers
+)
+
 add_library(lotus_v2_mdbx STATIC
     vendor/libmdbx/mdbx.c
     vendor/libmdbx/mdbx_batch.c
-- 
