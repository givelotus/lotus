From 5422e076ce5e63dce6b5aa4a9b7dd722e90b4a5f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:30:19 -0700
Subject: [PATCH] chronik: cover legacy signed transaction version round trips

Verify exact on-disk bytes and parsing for -1, INT_MIN and INT_MAX so indexing historical signed versions cannot silently reinterpret the field as an unsigned integer.

diff --git a/chronik/bitcoinsuite-core/src/tx/tx.rs b/chronik/bitcoinsuite-core/src/tx/tx.rs
index 1b3393d9cbc6bcda3ca227bdf58d89ba292c7fb9..71897576ee1335782a4b50cf46eff8e83e1c15f8 100644
--- a/chronik/bitcoinsuite-core/src/tx/tx.rs
+++ b/chronik/bitcoinsuite-core/src/tx/tx.rs
@@ -273,6 +273,23 @@ mod tests {
         assert_eq!(tx, Tx::deser(&mut bytes).unwrap());
     }
 
+    #[test]
+    fn test_legacy_signed_versions() -> Result<(), hex::FromHexError> {
+        // Dogecoin preserves signed nVersion values, including negative values
+        // accepted by historical consensus. These bytes must survive indexing.
+        for (version, raw) in [
+            (-1, "ffffffff000000000000"),
+            (i32::MIN, "00000080000000000000"),
+            (i32::MAX, "ffffff7f000000000000"),
+        ] {
+            verify_ser(
+                TxMut { version, ..TxMut::default() },
+                &hex::decode(raw)?,
+            );
+        }
+        Ok(())
+    }
+
     #[test]
     fn test_ser_tx() -> Result<(), hex::FromHexError> {
         verify_ser(TxMut::default(), &[0; 10]);
