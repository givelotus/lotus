+    const uint64_t upper =
+        config_.max_adaptive_block_bytes > 1000
+            ? config_.max_adaptive_block_bytes - 1000
+            : config_.max_adaptive_block_bytes;
+    return std::clamp(desired, config_.min_adaptive_target_bytes, upper);
