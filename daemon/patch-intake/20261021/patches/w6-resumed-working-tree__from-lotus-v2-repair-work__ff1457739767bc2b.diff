+        m_info->min_rtt_us = ci.min_rtt / NGTCP2_MICROSECONDS;
+        m_info->cwnd = ci.cwnd;
+        m_info->lost_pkts = ci.pkt_lost;
+        m_info->udp_bytes_sent = ci.bytes_sent;
+        m_info->udp_bytes_recv = ci.bytes_recv;
+    }
