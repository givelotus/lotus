+        }
+        if (m_channel->RxHasRoom()) {
+            m_channel->credit_wanted = false;
+            for (const StreamClass cls : ALL_STREAM_CLASSES) {
+                uint64_t &deferred{m_deferred_credit[StreamClassIndex(cls)]};
