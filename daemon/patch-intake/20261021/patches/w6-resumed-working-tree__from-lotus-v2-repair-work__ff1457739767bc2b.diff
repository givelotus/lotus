+public:
+    P2PSessionHandler(std::shared_ptr<EngineWaker> waker, bool compress,
+                      std::shared_ptr<DialState> dial = nullptr,
+                      std::optional<std::vector<unsigned char>> spki_pin = {},
+                      std::optional<std::vector<unsigned char>> cert_pin = {})
