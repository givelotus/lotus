+    def schedule(self, now, data, heap, sequence, destination):
+        self.stats["pkts"] += 1
+        self.stats["bytes"] += len(data)
+        if self.rng.random() < self.loss:
+            self.stats["lost"] += 1
+            return
+        while self.departures and self.departures[0] <= now:
+            self.departures.popleft()
