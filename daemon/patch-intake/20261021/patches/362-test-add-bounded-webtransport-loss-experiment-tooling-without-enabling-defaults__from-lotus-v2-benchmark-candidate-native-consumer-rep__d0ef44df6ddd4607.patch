+        self.delay_s, self.loss, self.rng = delay_s, loss, rng
+        self.next_free = 0.0
+        self.departures = deque()
+        self.pending = 0
+        self.pending_bytes = 0
+        self.stats = {
+            "pkts": 0,
+            "bytes": 0,
+            "lost": 0,
+            "dropped_queue": 0,
+            "forwarded": 0,
+            "send_errors": 0,
+            "peak_pending": 0,
+            "peak_pending_bytes": 0,
+        }
