From a4345c1c49dbdabe4a8d487a63f6d652210f8908 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 18:31:59 -0700
Subject: [PATCH 11/12] net: build a new relay epoch outside the index lock

At a block the short-id index is re-keyed from the whole mempool. That
took the index lock for the whole rebuild: 0.4-1.4 s at a 1M-transaction
mempool (RelayIndexRekey1M, previous commit), during which every invshort
lookup, every transaction queued for relay and every short-id request
waited.

The new epoch is now built in a private structure and swapped in under
the lock; until then the current and previous epochs keep answering.
Insert no longer needs the lock (it is only called on a private epoch or
with the lock held), so it is renamed InsertUnlocked and documented as
such; the collision counter it bumps is a mutable atomic.

Tests: txrelay_tests (index epochs and collisions) pass;
RelayIndexRekey1M still costs 0.4-1.4 s of CPU per block (unchanged: the
same work, outside the lock). Not done: incremental double indexing that
would spread the work over the epoch.
---
 src/net/txrelay_index.cpp | 16 +++++++++++-----
 src/net/txrelay_index.h   |  6 +++---
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/src/net/txrelay_index.cpp b/src/net/txrelay_index.cpp
index a6538cd5d2..09a4b8192d 100644
--- a/src/net/txrelay_index.cpp
+++ b/src/net/txrelay_index.cpp
@@ -57,7 +57,7 @@ std::optional<uint64_t> ParseShortIdRequestKey(const uint256 &key,
 TxRelayIndex::TxRelayIndex(unsigned shortid_bits)
     : m_bits{std::clamp(shortid_bits, 1U, 64U)} {}
 
-void TxRelayIndex::Insert(Epoch &epoch, const TxId &txid) {
+void TxRelayIndex::InsertUnlocked(Epoch &epoch, const TxId &txid) const {
     const uint64_t short_id{ShortId(epoch.key, txid)};
     if (!epoch.short_id_of.emplace(txid, short_id).second) {
         return;
@@ -81,16 +81,22 @@ void TxRelayIndex::Insert(Epoch &epoch, const TxId &txid) {
 
 void TxRelayIndex::SetEpoch(const EpochKey &key,
                             const std::vector<std::pair<TxId, Clock>> &txs) {
-    LOCK(m_mutex);
-    if (m_current && m_current->key == key) {
+    if (WITH_LOCK(m_mutex, return m_current && m_current->key == key)) {
         return;
     }
+    // Build the new epoch without the lock: at a 1M-transaction mempool this
+    // takes about half a second, during which lookups keep using the
+    // current and previous epochs.
     auto epoch{std::make_unique<Epoch>()};
     epoch->key = key;
     epoch->by_short_id.reserve(txs.size());
     epoch->short_id_of.reserve(txs.size());
     for (const auto &[txid, time] : txs) {
-        Insert(*epoch, txid);
+        InsertUnlocked(*epoch, txid);
+    }
+    LOCK(m_mutex);
+    if (m_current && m_current->key == key) {
+        return;
     }
     if (m_window.empty()) {
         // First epoch: the window starts from the mempool's admission times.
@@ -153,7 +159,7 @@ void TxRelayIndex::Add(const TxId &txid, Clock time) {
         if (m_current->short_id_of.count(txid)) {
             return;
         }
-        Insert(*m_current, txid);
+        InsertUnlocked(*m_current, txid);
     }
     m_window.emplace_back(time, txid);
 }
diff --git a/src/net/txrelay_index.h b/src/net/txrelay_index.h
index be0b692ea8..79599124c8 100644
--- a/src/net/txrelay_index.h
+++ b/src/net/txrelay_index.h
@@ -140,8 +140,8 @@ private:
         std::unordered_map<uint64_t, std::vector<TxId>> by_short_id;
         std::unordered_map<TxId, uint64_t, SaltedTxIdHasher> short_id_of;
     };
-    void Insert(Epoch &epoch, const TxId &txid)
-        EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
+    //! Index txid in epoch (which the caller owns or guards with m_mutex)
+    void InsertUnlocked(Epoch &epoch, const TxId &txid) const;
     const Epoch *Get(const uint256 &epoch_id) const
         EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
 
@@ -151,7 +151,7 @@ private:
     std::unique_ptr<Epoch> m_previous GUARDED_BY(m_mutex);
     //! (admission time, txid), in admission order
     std::deque<std::pair<Clock, TxId>> m_window GUARDED_BY(m_mutex);
-    std::atomic<uint64_t> m_collisions{0};
+    mutable std::atomic<uint64_t> m_collisions{0};
 };
 
 } // namespace txrelay
