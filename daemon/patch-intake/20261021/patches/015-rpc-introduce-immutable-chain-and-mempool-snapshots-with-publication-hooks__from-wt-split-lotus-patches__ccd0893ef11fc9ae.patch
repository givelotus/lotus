+void PopulateMiningTemplate(ChainAndMempoolSnapshot &snap,
+                            const CTxMemPool *mempool_locked,
+                            const ChainAndMempoolSnapshot *prev,
+                            SnapshotPublisher &publisher)
+    NO_THREAD_SAFETY_ANALYSIS {
+    if (!snap.chain_valid || snap.height < 0 || !snap.consensus_params) {
+        return;
+    }
+
+    // Fast path: if the tip and mempool have not changed since the previous
+    // snapshot, reuse the already-assembled mining template in O(1).
+    if (prev && prev->mining_template.template_valid &&
+        prev->mining_template_ready &&
+        prev->mining_template.prev_block_hash == snap.best_block_hash &&
+        prev->mining_template.next_height == snap.height + 1 &&
+        prev->mining_template.nBits == snap.next_nBits &&
+        prev->mining_template.parent_mtp == snap.mediantime &&
+        prev->mempool_ptr == mempool_locked &&
+        (!mempool_locked ||
+         (prev->transactions_updated == snap.transactions_updated &&
+          prev->mempool_size == snap.mempool_size &&
+          prev->mining_template.non_coinbase_txs.size() ==
+              snap.mempool_size))) {
+        snap.mining_template = prev->mining_template;
+        snap.mining_template_ready = true;
+        return;
+    }
+
+    MiningTemplateSnapshot tmpl{};
+    tmpl.template_id = snap.mining_template.template_id != 0
+                           ? snap.mining_template.template_id
+                           : publisher.AllocateTemplateId();
+    tmpl.prev_block_hash = snap.best_block_hash;
+    tmpl.next_height = snap.height + 1;
+    tmpl.nHeaderVersion = 2;
+    if (snap.consensus_params->fPowAllowMinDifficultyBlocks) {
+        tmpl.nHeaderVersion =
+            gArgs.GetIntArg("-blockversion", tmpl.nHeaderVersion);
+    }
+    tmpl.nBits = snap.next_nBits;
+    tmpl.parent_mtp = snap.mediantime;
+    tmpl.min_time = snap.mediantime + 1;
+    tmpl.total_fees = Amount::zero();
+    tmpl.non_cb_serialized_size = 0;
+
+    if (mempool_locked && !mempool_locked->mapTx.empty()) {
+        struct SelectedEntry {
+            CTransactionRef tx;
+            Amount fee;
+            int64_t sigchecks;
+        };
+        BlockFitter blockFitter(GetConfig());
+        std::vector<SelectedEntry> selected;
+        selected.reserve(mempool_locked->mapTx.size());
+
+        lotus::v2::Hash tip_id{};
+        std::memcpy(tip_id.data(), snap.best_block_hash.begin(), 32);
+        const auto &spec_overlay =
+            mempool_locked->GetMerklixOverlay().GetSpeculativeOverlay();
+
+        bool min_fee_ok = true;
+        const auto &fee_sorted = mempool_locked->mapTx.get<modified_feerate>();
+        if (!fee_sorted.empty()) {
+            auto lowest_it = fee_sorted.end();
+            --lowest_it;
+            if (blockFitter.isBelowBlockMinFeeRate(
+                    (*lowest_it)->GetModifiedFeeRate())) {
+                min_fee_ok = false;
+            }
+        }
+
+        const bool use_overlay_fast_path =
+            min_fee_ok &&
+            mempool_locked->GetMerklixOverlay().IsAnchoredAt(
+                tip_id, uint64_t(tmpl.next_height), uint64_t(tmpl.parent_mtp)) &&
+            !spec_overlay.HasDoubleSpends() &&
+            spec_overlay.GetTxCount() == mempool_locked->mapTx.size() &&
+            blockFitter.testTxFits(spec_overlay.GetTotalBytes(),
+                                   spec_overlay.GetTotalSigChecks());
+
+        if (use_overlay_fast_path) {
+            const auto &ordered = spec_overlay.GetOrderedTxs();
+            tmpl.non_coinbase_txs.reserve(ordered.size());
+            tmpl.tx_fees.reserve(ordered.size());
+            tmpl.tx_sigchecks.reserve(ordered.size());
+            for (const auto &[tx_id, oentry] : ordered) {
+                auto tx_ref =
+                    std::static_pointer_cast<const CTransaction>(oentry.tx_ref);
+                if (!tx_ref) {
+                    TxId id;
+                    std::memcpy(id.begin(), tx_id.data(), 32);
+                    tx_ref = mempool_locked->get(id);
+                }
+                if (!tx_ref) {
+                    continue;
+                }
+                const Amount fee = oentry.fee_sats * SATOSHI;
+                tmpl.total_fees += fee;
+                tmpl.non_cb_serialized_size += oentry.linear_cost;
+                tmpl.non_coinbase_txs.push_back(std::move(tx_ref));
+                tmpl.tx_fees.push_back(fee);
+                tmpl.tx_sigchecks.push_back(oentry.sigchecks);
+            }
+            tmpl.v2_base_state.sum_non_cb_effective_cost =
+                spec_overlay.GetSumNonCbEffectiveCost();
+            tmpl.roots_ready = false;
+        } else {
+            struct DepNode {
+                CTxMemPoolEntryRef entry;
+                size_t missing_parents;
+                std::vector<size_t> children;
+            };
+            std::vector<DepNode> nodes;
+            nodes.reserve(mempool_locked->mapTx.size());
+            std::unordered_map<TxId, size_t, SaltedTxIdHasher> locations;
+            locations.reserve(mempool_locked->mapTx.size());
+            for (const auto &entry : mempool_locked->mapTx.get<entry_id>()) {
+                locations.emplace(entry->GetTx().GetId(), nodes.size());
+                nodes.push_back(
+                    {entry, entry->GetMemPoolParentsConst().size(), {}});
+            }
+            for (size_t child = 0; child < nodes.size(); ++child) {
+                for (const auto &parent :
+                     nodes[child].entry->GetMemPoolParentsConst()) {
+                    const auto pos =
+                        locations.find(parent.get()->GetTx().GetId());
+                    if (pos != locations.end()) {
+                        nodes[pos->second].children.push_back(child);
+                    }
+                }
+            }
+            auto lowerPriority = [&nodes](size_t a, size_t b) {
+                return CompareTxMemPoolEntryByModifiedFeeRate{}(
+                    nodes[b].entry, nodes[a].entry);
+            };
+            std::priority_queue<size_t, std::vector<size_t>,
+                                decltype(lowerPriority)>
+                ready(lowerPriority);
+            for (size_t i = 0; i < nodes.size(); ++i) {
+                if (nodes[i].missing_parents == 0) {
+                    ready.push(i);
+                }
+            }
+
+            while (!ready.empty()) {
+                const size_t idx = ready.top();
+                ready.pop();
+                const auto &entry = nodes[idx].entry;
+                if (blockFitter.isBelowBlockMinFeeRate(
+                        entry->GetModifiedFeeRate())) {
+                    break;
+                }
+                const uint64_t tx_size = entry->GetTxSize();
+                const int64_t tx_sigchecks = entry->GetSigChecks();
+                if (!blockFitter.testTxFits(tx_size, tx_sigchecks)) {
+                    continue;
+                }
+                TxValidationState tx_state;
+                if (!ContextualCheckTransaction(*snap.consensus_params,
+                                                entry->GetTx(), tx_state,
+                                                tmpl.next_height,
+                                                tmpl.parent_mtp)) {
+                    continue;
+                }
+                blockFitter.addTx(tx_size, tx_sigchecks, entry->GetFee());
+                tmpl.total_fees += entry->GetFee();
+                selected.push_back(
+                    {entry->GetSharedTx(), entry->GetFee(), tx_sigchecks});
+                for (const size_t child : nodes[idx].children) {
+                    if (nodes[child].missing_parents > 0 &&
+                        --nodes[child].missing_parents == 0) {
+                        ready.push(child);
+                    }
+                }
+            }
+
+            std::sort(selected.begin(), selected.end(),
+                      [](const SelectedEntry &a, const SelectedEntry &b) {
+                          return a.tx->GetId() < b.tx->GetId();
+                      });
+
+            tmpl.non_coinbase_txs.reserve(selected.size());
+            tmpl.tx_fees.reserve(selected.size());
+            tmpl.tx_sigchecks.reserve(selected.size());
+
+            for (auto &item : selected) {
+                const uint64_t sz = item.tx->GetTotalSize();
+                tmpl.non_cb_serialized_size += sz;
+                tmpl.non_coinbase_txs.push_back(std::move(item.tx));
+                tmpl.tx_fees.push_back(item.fee);
+                tmpl.tx_sigchecks.push_back(item.sigchecks);
+            }
+            tmpl.roots_ready = false;
+        }
+    } else {
+        tmpl.subtree_a_root = lotus::v2::EmptyTxRoot();
+        tmpl.coinbase_merkle_branch.clear();
+        tmpl.roots_ready = true;
+    }
+
+    tmpl.block_reward = tmpl.total_fees + snap.next_subsidy;
+    tmpl.v2_base_state.non_cb_tx_count = tmpl.non_coinbase_txs.size();
+    tmpl.v2_base_state.height = uint64_t(tmpl.next_height);
+    tmpl.v2_base_state.parent_mtp = uint64_t(tmpl.parent_mtp);
+    tmpl.template_valid = true;
+
+    snap.mining_template = std::move(tmpl);
+    snap.mining_template_ready = true;
+}
+
+void InitLazyMiningTemplateStub(ChainAndMempoolSnapshot &snap,
+                                const CTxMemPool &mempool_locked,
+                                const ChainAndMempoolSnapshot *prev,
+                                SnapshotPublisher &publisher)
+    NO_THREAD_SAFETY_ANALYSIS {
+    if (!snap.chain_valid || snap.height < 0 || !snap.consensus_params) {
+        return;
+    }
+    if (prev && prev->mining_template.template_valid &&
+        prev->mining_template_ready &&
+        prev->mining_template.prev_block_hash == snap.best_block_hash &&
+        prev->mining_template.next_height == snap.height + 1 &&
+        prev->mining_template.nBits == snap.next_nBits &&
+        prev->mining_template.parent_mtp == snap.mediantime &&
+        prev->mempool_ptr == &mempool_locked &&
+        prev->transactions_updated == snap.transactions_updated &&
+        prev->mempool_size == snap.mempool_size &&
+        prev->mining_template.non_coinbase_txs.size() == snap.mempool_size) {
+        snap.mining_template = prev->mining_template;
+        snap.mining_template_ready = true;
+        return;
+    }
+    if (mempool_locked.mapTx.empty()) {
+        PopulateMiningTemplate(snap, &mempool_locked, prev, publisher);
+        return;
+    }
+    MiningTemplateSnapshot tmpl{};
+    tmpl.template_id = publisher.AllocateTemplateId();
+    tmpl.prev_block_hash = snap.best_block_hash;
+    tmpl.next_height = snap.height + 1;
+    tmpl.nHeaderVersion = 2;
+    if (snap.consensus_params->fPowAllowMinDifficultyBlocks) {
+        tmpl.nHeaderVersion =
+            gArgs.GetIntArg("-blockversion", tmpl.nHeaderVersion);
+    }
+    tmpl.nBits = snap.next_nBits;
+    tmpl.parent_mtp = snap.mediantime;
+    tmpl.min_time = snap.mediantime + 1;
+    tmpl.total_fees = Amount::zero();
+    tmpl.block_reward = snap.next_subsidy;
+    tmpl.non_cb_serialized_size = 0;
+    tmpl.v2_base_state.height = uint64_t(tmpl.next_height);
+    tmpl.v2_base_state.parent_mtp = uint64_t(tmpl.parent_mtp);
+    tmpl.roots_ready = false;
+    tmpl.template_valid = true;
+    snap.mining_template = std::move(tmpl);
+    snap.mining_template_ready = false;
+}
