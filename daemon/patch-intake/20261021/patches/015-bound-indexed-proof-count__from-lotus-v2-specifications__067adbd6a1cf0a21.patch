From dc7bc1db6403ad6da625688e7430a18b3b7c9ab1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:22:38 -0700
Subject: [PATCH] Reject truncated indexed proofs at the maximum count

Compute ceiling division without overflowing the public uint32 count domain. A regression rejects one-level proofs for UINT32_MAX leaves and verifies consumption of all 32 levels. The test fails before the repair; Debug and Release primitive checks pass afterward.
---
 src/lotus_v2/commitment.cpp      |  2 +-
 src/lotus_v2/test_commitment.cpp | 18 ++++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/lotus_v2/commitment.cpp b/src/lotus_v2/commitment.cpp
index 96002a0c7..cd73cb0a8 100644
--- a/src/lotus_v2/commitment.cpp
+++ b/src/lotus_v2/commitment.cpp
@@ -143,7 +143,7 @@ bool IndexedProofRoot(const Hash &leaf, uint32_t index, uint32_t count,
         root = (offset & 1) ? IndexedNode(layer, sibling, root)
                             : IndexedNode(layer, root, sibling);
         offset >>= 1;
-        width = (width + 1) / 2;
+        width = width / 2 + (width & 1);
         ++layer;
     }
     if (layer != siblings.size()) return false;
diff --git a/src/lotus_v2/test_commitment.cpp b/src/lotus_v2/test_commitment.cpp
index e7a167235..e1f0da0b9 100644
--- a/src/lotus_v2/test_commitment.cpp
+++ b/src/lotus_v2/test_commitment.cpp
@@ -5,6 +5,7 @@
 #include <array>
 #include <cstdlib>
 #include <iostream>
+#include <limits>
 #include <string>
 #include <vector>
 
@@ -112,6 +113,23 @@ int main() {
     Check(!IndexedProofRoot(leaves[2], 0, 1, proof_for_last, proof_root),
           "reject excess proof sibling");
 
+    // Exercise the public uint32 count domain without allocating billions of
+    // leaves. Ceil(width / 2) must not wrap at the first level.
+    const uint32_t maximum_count = std::numeric_limits<uint32_t>::max();
+    std::array<Hash, 32> maximum_proof{};
+    proof_root.fill(0xa5);
+    Check(!IndexedProofRoot(leaves[0], 0, maximum_count,
+                            std::span(maximum_proof).first(1), proof_root) &&
+              proof_root[0] == 0xa5,
+          "maximum count rejects a truncated proof without changing output");
+    Hash maximum_expected = leaves[0];
+    for (uint16_t layer = 0; layer < maximum_proof.size(); ++layer) {
+        maximum_expected = IndexedNode(layer, maximum_expected, maximum_proof[layer]);
+    }
+    Check(IndexedProofRoot(leaves[0], 0, maximum_count, maximum_proof, proof_root) &&
+              proof_root == maximum_expected,
+          "maximum count consumes all 32 proof levels");
+
     ChainId chain;
     TxHeaderCore header;
     for (unsigned i = 0; i < 32; ++i) chain[i] = i;
