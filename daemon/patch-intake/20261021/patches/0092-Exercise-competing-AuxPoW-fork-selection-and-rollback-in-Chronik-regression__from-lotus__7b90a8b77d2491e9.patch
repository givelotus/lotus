From dc5efe710fbe2bfc9c4d816f590cfe28e9f31c20 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:30:46 -0700
Subject: [PATCH] Exercise competing AuxPoW fork selection and rollback in
 Chronik regression

Generate a two-block alternative AuxPoW suffix with fresh parent commitments. Confirm the longer branch remains active after reconsidering the original tip, then invalidate its ancestor and verify the original branch is restored with exact Chronik parity.

diff --git a/test/functional/chronik_dogecoin_reorg.py b/test/functional/chronik_dogecoin_reorg.py
index c286a0fff6f4585d30a73dd605bf1427d350730a..8a2aa746c20e591b864d76de04ffa3852681709a 100644
--- a/test/functional/chronik_dogecoin_reorg.py
+++ b/test/functional/chronik_dogecoin_reorg.py
@@ -2,7 +2,11 @@
 """Independent AuxPoW disconnect/reconnect and Chronik disk parity regression."""
 import io
 from dogecoin_auxpow import DogecoinAuxpowTest
-from test_framework.messages import CBlock, CBlockHeader
+from test_framework.address import P2SH_OP_TRUE
+from test_framework.blocktools import VERSION_CHAIN_ID_BITS, create_block, create_coinbase
+from test_framework.messages import (CBlock, CBlockHeader, CAuxPow, CTxIn, COutPoint,
+                                     MERGE_MINE_PREFIX, VERSION_AUXPOW_BIT)
+from test_framework.script import CScript
 from test_framework.util import assert_equal
 
 class ChronikDogecoinReorgTest(DogecoinAuxpowTest):
@@ -32,6 +36,20 @@ class ChronikDogecoinReorgTest(DogecoinAuxpowTest):
                 assert_equal(actual.txid, bytes.fromhex(tx.txid_hex)[::-1])
                 assert_equal(chronik.raw_tx(tx.txid_hex).ok().raw_tx, tx.serialize())
 
+    def fork_block(self, previous, height, timestamp):
+        coinbase = create_coinbase(height)
+        coinbase.vout[0].scriptPubKey = P2SH_OP_TRUE
+        block = create_block(int(previous, 16), coinbase, timestamp)
+        block.nVersion = VERSION_CHAIN_ID_BITS | VERSION_AUXPOW_BIT | 5
+        block.auxpow = CAuxPow()
+        commitment = MERGE_MINE_PREFIX + bytes.fromhex(block.hash_hex)
+        commitment += b"\x01\0\0\0\0\0\0\0"
+        block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), CScript(commitment))]
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
+        block.solve()
+        assert_equal(self.nodes[0].submitblock(block.serialize().hex()), None)
+        return block.hash_hex
+
     def run_test(self):
         super().run_test()
         node = self.nodes[0]
@@ -50,6 +68,17 @@ class ChronikDogecoinReorgTest(DogecoinAuxpowTest):
         node.reconsiderblock(first)
         assert_equal(node.getbestblockhash(), tip)
         self.check_parity(2)
+        # Competing longer AuxPoW fork, followed by a rollback to the original.
+        timestamp = node.getblockheader(tip)["time"]
+        node.invalidateblock(tip)
+        fork2 = self.fork_block(first, 2, timestamp + 1)
+        fork3 = self.fork_block(fork2, 3, timestamp + 2)
+        node.reconsiderblock(tip)
+        assert_equal(node.getbestblockhash(), fork3)
+        self.check_parity(3)
+        node.invalidateblock(fork2)
+        assert_equal(node.getbestblockhash(), tip)
+        self.check_parity(2)
         assert_equal(node.verifychain(4, 0), True)
         self.restart_node(0)
         assert_equal(node.getbestblockhash(), tip)
