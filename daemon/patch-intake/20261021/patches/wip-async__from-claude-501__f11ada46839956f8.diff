+uint64_t BCLog::Logger::DroppedLines() const {
+    StdLockGuard lock(m_rings_mutex);
+    uint64_t dropped{m_dropped_retired};
+    for (const auto &ring : m_rings) {
+        dropped += ring->Dropped();
+    }
+    return dropped;
+}
