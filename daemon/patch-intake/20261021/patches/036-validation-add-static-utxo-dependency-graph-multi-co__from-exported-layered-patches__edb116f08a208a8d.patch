diff --git a/src/test/lotus_v2_tests.cpp b/src/test/lotus_v2_tests.cpp
index ed76ddf5c9..02f6102864 100644
--- a/src/test/lotus_v2_tests.cpp
+++ b/src/test/lotus_v2_tests.cpp
@@ -1134,5 +1134,115 @@ BOOST_AUTO_TEST_CASE(v2_nullfail_and_batch_sig_collector) {
     }
 }
 
+BOOST_FIXTURE_TEST_CASE(v2_parallel_utxo_dependency_validation,
+                        TestChain100Setup) {
+    this->mineBlocks(2);
+    CScript coinbase_spk =
+        CScript() << ToByteVector(coinbaseKey.GetPubKey()) << OP_CHECKSIG;
+    FillableSigningProvider keystore;
+    keystore.AddKey(coinbaseKey);
+
+    // Build a 32-tx multi-chain batch with intra-batch parent->child UTXO
+    // dependencies (8 chains of depth 4) and validate via ProcessRawTxBatch.
+    constexpr size_t kChains = 8;
+    constexpr size_t kChainDepth = 4;
+
+    CMutableTransaction fanout_mtx;
+    fanout_mtx.nVersion = 2;
+    fanout_mtx.vin.emplace_back(COutPoint(m_coinbase_txns[0]->GetId(), 0));
+    const Amount total_in = m_coinbase_txns[0]->vout[0].nValue;
+    const Amount per_chain =
+        (total_in - 50000 * SATOSHI) / int64_t(kChains);
+    fanout_mtx.vout.resize(kChains);
+    for (size_t c = 0; c < kChains; ++c) {
+        fanout_mtx.vout[c].nValue = per_chain;
+        fanout_mtx.vout[c].scriptPubKey = coinbase_spk;
+    }
+    {
+        SignatureData sigdata;
+        BOOST_REQUIRE(ProduceSignature(
+            keystore,
+            MutableTransactionSignatureCreator(
+                &fanout_mtx, 0, total_in, SigHashType().withForkId()),
+            coinbase_spk, sigdata));
+        UpdateInput(fanout_mtx.vin[0], sigdata);
+    }
+    CTransactionRef fanout_tx = MakeTransactionRef(fanout_mtx);
+    CreateAndProcessBlock({fanout_mtx}, coinbase_spk);
+
+    std::vector<CTransactionRef> batch_txs;
+    std::vector<CMutableTransaction> batch_mtxs;
+    batch_txs.reserve(kChains * kChainDepth);
+    batch_mtxs.reserve(kChains * kChainDepth);
+
+    for (size_t c = 0; c < kChains; ++c) {
+        TxId prev_txid = fanout_tx->GetId();
+        uint32_t prev_vout = uint32_t(c);
+        Amount prev_val = per_chain;
+        for (size_t d = 0; d < kChainDepth; ++d) {
+            CMutableTransaction mtx;
+            mtx.nVersion = 2;
+            mtx.vin.emplace_back(COutPoint(prev_txid, prev_vout));
+            const Amount next_val = prev_val - 2000 * SATOSHI;
+            mtx.vout.emplace_back(next_val, coinbase_spk);
+            SignatureData sigdata;
+            BOOST_REQUIRE(ProduceSignature(
+                keystore,
+                MutableTransactionSignatureCreator(
+                    &mtx, 0, prev_val, SigHashType().withForkId()),
+                coinbase_spk, sigdata));
+            UpdateInput(mtx.vin[0], sigdata);
+            CTransactionRef tx_ref = MakeTransactionRef(mtx);
+            prev_txid = tx_ref->GetId();
+            prev_vout = 0;
+            prev_val = next_val;
+            batch_mtxs.push_back(std::move(mtx));
+            batch_txs.push_back(std::move(tx_ref));
+        }
+    }
+
+    // 1. Corrupting a signature in the middle of the batch must fail cleanly
+    {
+        std::vector<CTransactionRef> bad_batch = batch_txs;
+        CMutableTransaction bad_mtx = batch_mtxs[17];
+        std::vector<uint8_t> bad_script(bad_mtx.vin[0].scriptSig.begin(),
+                                        bad_mtx.vin[0].scriptSig.end());
+        BOOST_REQUIRE(bad_script.size() > 10);
+        bad_script[10] ^= 0x01;
+        bad_mtx.vin[0].scriptSig =
+            CScript(bad_script.begin(), bad_script.end());
+        bad_batch[17] = MakeTransactionRef(std::move(bad_mtx));
+
+        LOCK(cs_main);
+        const auto bad_res = ProcessRawTxBatch(
+            m_node.chainman->ActiveChainstate(), *m_node.mempool, bad_batch,
+            /*test_accept=*/false);
+        BOOST_CHECK(bad_res.m_state.IsInvalid());
+        BOOST_CHECK_EQUAL(m_node.mempool->size(), 0U);
+    }
+
+    // 2. Valid dependency-chain batch succeeds via static UTXO resolution +
+    //    multi-core parallel script verification
+    {
+        LOCK(cs_main);
+        const auto ok_res = ProcessRawTxBatch(
+            m_node.chainman->ActiveChainstate(), *m_node.mempool, batch_txs,
+            /*test_accept=*/false);
+        BOOST_CHECK(ok_res.m_state.IsValid());
+        BOOST_CHECK_EQUAL(ok_res.m_tx_results.size(), batch_txs.size());
+        BOOST_CHECK_EQUAL(m_node.mempool->size(), batch_txs.size());
+    }
+
+    // 3. ConnectBlock validates and connects the 32 chained transactions
+    CBlock connected = CreateAndProcessBlock(batch_mtxs, coinbase_spk);
+    {
+        LOCK(cs_main);
+        BOOST_CHECK_EQUAL(m_node.chainman->ActiveTip()->GetBlockHash(),
+                          connected.GetHash());
+        BOOST_CHECK_EQUAL(m_node.mempool->size(), 0U);
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
 
