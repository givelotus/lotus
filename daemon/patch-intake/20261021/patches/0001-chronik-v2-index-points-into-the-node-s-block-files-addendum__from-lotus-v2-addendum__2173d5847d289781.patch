+}
+impl db::TxSource for NodeTxSource {
+    fn load_tx(
+        &self,
+        pos: db::TxPos,
+        txid: TxId,
+        coinbase: bool,
+    ) -> Result<db::NodeTx> {
+        let tx = f::load_v2_native_tx(
+            &self.node.bridge,
+            pos.file_num,
+            pos.data_pos,
+            coinbase,
+        )
+        .map_err(|e| e.to_string())?;
+        if tx.txid != txid.0 .0 {
+            return Err("transaction identity at block-file position".into());
+        }
+        let tx = confirmed_tx(
+            tx,
+            db::Anchor {
+                block_id: [0; 32],
+                height: 0,
+            },
+        )?;
+        Ok(db::NodeTx::from(&tx))
+    }
+}
