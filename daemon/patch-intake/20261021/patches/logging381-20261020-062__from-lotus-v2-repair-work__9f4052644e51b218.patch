From 8fc7748c55ae09c7bd69e5c1ddae59de0535bf25 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 15:32:23 -0700
Subject: [PATCH] logging: retain integral values in bounded numeric message
 formats

Match tinyformat's integral operands in f/g formats without coercing them to
double, adding a fractional part, or losing UINT64_MAX bits. Add explicit
zero/space-padded decimal d/u formats bounded to widths1 through20 for old
blk%05u filenames and %15d startup timings. Rendering remains on the consumer;
structured fields remain raw numeric values. Reject signed-negative %u because
the normalized field cannot recover its original source-width cast.

Extend the reviewed AST converter to preserve the exact supported decimal
specifier. Its19 source-only tests pass. Add native old-tinyformat comparison
controls for UINT64_MAX, INT64_MIN, signed padding, integral f/g, malformed
formats and plain-text/JSON output. Native/component checks remain pending;
this commit does not convert or count any additional production producers.

This is a manually reviewed rendering capability and test change, not a
scripted producer conversion. Validation command:
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python -m unittest discover -s contrib/logging/conversion -p test_convert.py
---
 contrib/logging/conversion/convert.py      |  2 +
 contrib/logging/conversion/test_convert.py | 16 ++++++
 src/logging/event.cpp                      | 54 +++++++++++++++++---
 src/test/logging_event_tests.cpp           | 57 ++++++++++++++++++++--
 4 files changed, 120 insertions(+), 9 deletions(-)

diff --git a/contrib/logging/conversion/convert.py b/contrib/logging/conversion/convert.py
index 59ef01fbf6c3c20764bfd76c3d125374831b9466..5071386f51556c6cccc357efff57305a91857af2 100755
--- a/contrib/logging/conversion/convert.py
+++ b/contrib/logging/conversion/convert.py
@@ -156,6 +156,8 @@ def validate_mapping(old, event):
             return None  # Exact LogChar snapshot contract checked below.
         if re.fullmatch(r"%(?:ll|l|z|t|j)?[diu]", spec):
             return None
+        if re.fullmatch(r"%0?(?:[1-9]|1[0-9]|20)[du]", spec):
+            return spec[1:]
         if re.fullmatch(r"%(?:0(?:[1-9]|1[0-6]))?x", spec):
             return spec[1:]
         if re.fullmatch(r"%(?:\.(?:[0-9]|1[0-8]))?[fg]", spec):
diff --git a/contrib/logging/conversion/test_convert.py b/contrib/logging/conversion/test_convert.py
index c428082e368e498783037e1b1737c4957c177a9a..bf2d9c716eac67224d682ec70cd79a22a42538ff 100755
--- a/contrib/logging/conversion/test_convert.py
+++ b/contrib/logging/conversion/test_convert.py
@@ -111,6 +111,22 @@ class ConversionTest(unittest.TestCase):
             new = 'LogInfoEvent(BCLog::ALL,"value","value={count}").Field(BCLog::LogField::Count,x)'
             self.assertEqual(convert.convert(old, [rule(old, new)])[0], new)
 
+    def test_bounded_decimal_padding_preserves_explicit_format(self):
+        for spec in ["%05u", "%15d", "%20u", "%020d", "%1d"]:
+            old = 'LogPrintf("value=' + spec + '", x)'
+            new = ('LogInfoEvent(BCLog::ALL,"value","value={count:' + spec[1:]
+                   + '}").Field(BCLog::LogField::Count,x)')
+            self.assertEqual(convert.convert(old, [rule(old, new)])[0], new)
+            changed = new.replace(spec[1:] + '}', '}')
+            with self.assertRaises(ValueError):
+                convert.convert(old, [rule(old, changed)])
+        for spec in ["%021u", "%21d", "%005u", "%+5d"]:
+            old = 'LogPrintf("value=' + spec + '", x)'
+            new = ('LogInfoEvent(BCLog::ALL,"value","value={count:' + spec[1:]
+                   + '}").Field(BCLog::LogField::Count,x)')
+            with self.assertRaises(ValueError):
+                convert.convert(old, [rule(old, new)])
+
     def test_character_requires_original_byte_snapshot(self):
         old = 'LogError("key=(%c,%d)", DB_PREFIX, height)'
         new = ('LogErrorEvent(BCLog::ALL,"key_error","key=({value},{height})")'
diff --git a/src/logging/event.cpp b/src/logging/event.cpp
index a8818c857ccf19fd11204e5609defeb221ab1939..c4d8c565174ea4b022df7bd5ae32754885ab20e4 100644
--- a/src/logging/event.cpp
+++ b/src/logging/event.cpp
@@ -190,8 +190,8 @@ void AppendQuotedText(std::string &out, std::string_view text) {
 }
 
 namespace {
-    // Only explicit, bounded float precision is supported; formatting runs here
-    // on the consumer, with the same backend as the original printf call.
+    // Explicit, bounded formatting runs on the consumer, with the same
+    // backend and integral values as the original printf call.
     bool AppendFormattedField(std::string &out, const FieldView &field,
                               std::string_view format) {
         if (format.empty()) {
@@ -220,6 +220,40 @@ namespace {
             out += '"';
             return true;
         }
+        // Decimal padding is bounded to a 64-bit integer's maximum width.
+        // Preserve the numeric field, including all UINT64_MAX bits. A signed
+        // negative value with %u needs its original source width to reproduce
+        // its cast, which the normalized field does not retain: reject it.
+        if ((format.back() == 'd' || format.back() == 'u') &&
+            (field.kind == FieldKind::I64 || field.kind == FieldKind::U64)) {
+            const bool unsigned_format{format.back() == 'u'};
+            if (unsigned_format && field.kind == FieldKind::I64 &&
+                field.I64() < 0)
+                return false;
+            format.remove_suffix(1);
+            if (format.empty()) {
+                field.AppendText(out);
+                return true;
+            }
+            const bool zero_pad{format.front() == '0'};
+            if (zero_pad) format.remove_prefix(1);
+            if (format.empty() || format.front() == '0') return false;
+            int width{0};
+            const auto [end, error]{std::from_chars(
+                format.data(), format.data() + format.size(), width)};
+            if (error != std::errc{} || end != format.data() + format.size() ||
+                width < 1 || width > 20)
+                return false;
+            if (field.kind == FieldKind::U64) {
+                out += strprintf(zero_pad ? "%0*u" : "%*u", width, field.U64());
+            } else if (unsigned_format) {
+                out += strprintf(zero_pad ? "%0*u" : "%*u", width,
+                                 uint64_t(field.I64()));
+            } else {
+                out += strprintf(zero_pad ? "%0*d" : "%*d", width, field.I64());
+            }
+            return true;
+        }
         // Bounded zero-padded hexadecimal preserves diagnostic bit patterns
         // without turning the structured integer into a string. Signed values
         // must be nonnegative; callers cast a signed bitfield to its wire type.
@@ -241,8 +275,10 @@ namespace {
             out += strprintf("%0*x", width, value);
             return true;
         }
-        if (field.kind != FieldKind::F64 ||
-            (format.back() != 'f' && format.back() != 'g')) return false;
+        if ((field.kind != FieldKind::F64 && field.kind != FieldKind::I64 &&
+             field.kind != FieldKind::U64) ||
+            (format.back() != 'f' && format.back() != 'g'))
+            return false;
         const char kind{format.back()};
         format.remove_suffix(1);
         int precision{6};
@@ -254,8 +290,14 @@ namespace {
             if (error != std::errc{} || end != format.data() + format.size() ||
                 precision < 0 || precision > 18) return false;
         }
-        out += kind == 'f' ? strprintf("%.*f", precision, field.F64())
-                           : strprintf("%.*g", precision, field.F64());
+        // tinyformat streams integral operands as integers even with %f/%g;
+        // precision does not invent a fractional part or round a large value.
+        if (field.kind == FieldKind::I64 || field.kind == FieldKind::U64) {
+            field.AppendText(out);
+        } else {
+            out += kind == 'f' ? strprintf("%.*f", precision, field.F64())
+                               : strprintf("%.*g", precision, field.F64());
+        }
         return true;
     }
 } // namespace
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 068ae53fd540ea391ac652129756ade48fb2232b..eb55cc323f2997eac38196ec6872cb15d06055da 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -197,9 +197,60 @@ BOOST_AUTO_TEST_CASE(float_message_precision_preserves_raw_fields) {
         .Field(LogField::ElapsedMs, 1.25);
     BOOST_CHECK_EQUAL(Json()["message"].get_str(),
                       "{elapsed_ms:.19f}/{elapsed_ms:08.2f}/{elapsed_ms:.2x}");
-    LogInfoEvent(BCLog::ALL, "invalid_float_type", "{count:.2f}")
-        .Field(LogField::Count, 1);
-    BOOST_CHECK_EQUAL(Json()["message"].get_str(), "{count:.2f}");
+    LogInfoEvent(BCLog::ALL, "invalid_float_type", "{config_enabled:.2f}")
+        .Field(LogField::ConfigEnabled, true);
+    BOOST_CHECK_EQUAL(Json()["message"].get_str(), "{config_enabled:.2f}");
+}
+
+BOOST_AUTO_TEST_CASE(integer_decimal_and_float_formats_keep_exact_fields) {
+    Format(BCLog::LogFormat::JSON);
+    for (const uint64_t value :
+         {uint64_t{0}, uint64_t{1}, std::numeric_limits<uint64_t>::max()}) {
+        LogInfoEventNoRateLimit(
+            BCLog::ALL, "integer_float_format_fixture",
+            "{count:.0f}/{count:.2f}/{count:g}/{count:.18g}/{count:05u}/{count:20u}")
+            .Field(LogField::Count, value);
+        const auto row{Json()};
+        BOOST_CHECK_EQUAL(row["message"].get_str(),
+                          strprintf("%.0f/%.2f/%g/%.18g/%05u/%20u", value,
+                                    value, value, value, value, value));
+        BOOST_CHECK(row["count"].isNum());
+        BOOST_CHECK_EQUAL(row["count"].getValStr(), std::to_string(value));
+        BOOST_CHECK(row["fields_truncated"].isNull());
+    }
+    for (const int64_t value :
+         {std::numeric_limits<int64_t>::min(), int64_t{-1}, int64_t{0},
+          int64_t{1}, std::numeric_limits<int64_t>::max()}) {
+        LogInfoEventNoRateLimit(
+            BCLog::ALL, "signed_integer_format_fixture",
+            "{version:.2f}/{version:g}/{version:05d}/{version:20d}")
+            .Field(LogField::Version, value);
+        const auto row{Json()};
+        BOOST_CHECK_EQUAL(
+            row["message"].get_str(),
+            strprintf("%.2f/%g/%05d/%20d", value, value, value, value));
+        BOOST_CHECK(row["version"].isNum());
+        BOOST_CHECK_EQUAL(row["version"].getInt<int64_t>(), value);
+        BOOST_CHECK(row["fields_truncated"].isNull());
+    }
+    for (const char *invalid :
+         {"{count:021u}", "{count:00u}", "{count:+5u}", "{count:5.2u}",
+          "{count:.19f}", "{count:.2e}"}) {
+        const BCLog::LogEventSite site{"integer_format_invalid", invalid,
+                                       BCLog::ALL, BCLog::Level::Info};
+        BCLog::EventBuilder{site, nullptr}.Field(LogField::Count, uint64_t{1});
+        BOOST_CHECK_EQUAL(Json()["message"].get_str(), invalid);
+    }
+    LogInfoEventNoRateLimit(BCLog::ALL, "signed_unsigned_format_invalid",
+                            "{version:05u}")
+        .Field(LogField::Version, -1);
+    BOOST_CHECK_EQUAL(Json()["message"].get_str(), "{version:05u}");
+    Format(BCLog::LogFormat::TEXT);
+    LogInfoEventNoRateLimit(BCLog::ALL, "integer_format_text_fixture",
+                            "size={count:.2f} file={count:05u}")
+        .Field(LogField::Count, uint64_t{123});
+    BOOST_CHECK_EQUAL(Lines().at(0), strprintf("size=%.2f file=%05u",
+                                               uint64_t{123}, uint64_t{123}));
 }
 
 BOOST_AUTO_TEST_CASE(filesystem_quoted_message_preserves_raw_snapshot) {
