From 03c53b4d6f5636195d5b5a6df0b440f487cd459c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 14:36:14 -0700
Subject: [PATCH] 013-add-v2-signing-hash-domains

Import own-input and sighash domain tags with vectors from 5fff7aa289b645448b01cb5fb11a921756c248d7.
---
 src/lotus_v2/generate_commitment_vectors.py | 2 ++
 src/lotus_v2/tagged_hash.cpp                | 2 ++
 src/lotus_v2/tagged_hash.h                  | 2 ++
 src/lotus_v2/test_commitment.cpp            | 9 +++++++++
 4 files changed, 15 insertions(+)

diff --git a/src/lotus_v2/generate_commitment_vectors.py b/src/lotus_v2/generate_commitment_vectors.py
index a42f4f50f..c1d35076a 100644
--- a/src/lotus_v2/generate_commitment_vectors.py
+++ b/src/lotus_v2/generate_commitment_vectors.py
@@ -77,6 +77,8 @@ def main():
         "branch_node": branch_node(a, b).hex(),
         "inputcore_leaf_01": leaves[0].hex(),
         "inputfull_leaf_01": h("inputfull", b"\x01").hex(),
+        "owninput_domain_01": h("owninput", b"\x01").hex(),
+        "sighash_domain_01": h("sighash", b"\x01").hex(),
         "output_leaf_010203": h("output", b"\x03\x01\x02\x03").hex(),
         "coinentry_mint": h("coinentry", b"\x00").hex(),
         "indexed_roots": [indexed(leaves[:n]).hex() for n in range(6)],
diff --git a/src/lotus_v2/tagged_hash.cpp b/src/lotus_v2/tagged_hash.cpp
index 1cd3dc432..e11bb0913 100644
--- a/src/lotus_v2/tagged_hash.cpp
+++ b/src/lotus_v2/tagged_hash.cpp
@@ -15,6 +15,8 @@ const char *Tag(HashDomain domain) {
     case HashDomain::Branch: return "Lotus/v2/branch";
     case HashDomain::InputCore: return "Lotus/v2/inputcore";
     case HashDomain::InputFull: return "Lotus/v2/inputfull";
+    case HashDomain::OwnInput: return "Lotus/v2/owninput";
+    case HashDomain::Sighash: return "Lotus/v2/sighash";
     case HashDomain::Output: return "Lotus/v2/output";
     case HashDomain::CoinEntry: return "Lotus/v2/coinentry";
     case HashDomain::MerkleIndex: return "Lotus/v2/merkleidx";
diff --git a/src/lotus_v2/tagged_hash.h b/src/lotus_v2/tagged_hash.h
index 687cfb630..2d2f6cb91 100644
--- a/src/lotus_v2/tagged_hash.h
+++ b/src/lotus_v2/tagged_hash.h
@@ -15,6 +15,8 @@ enum class HashDomain {
     Branch,
     InputCore,
     InputFull,
+    OwnInput,
+    Sighash,
     Output,
     CoinEntry,
     MerkleIndex,
diff --git a/src/lotus_v2/test_commitment.cpp b/src/lotus_v2/test_commitment.cpp
index 068ec099e..e7a167235 100644
--- a/src/lotus_v2/test_commitment.cpp
+++ b/src/lotus_v2/test_commitment.cpp
@@ -1,4 +1,5 @@
 #include "commitment.h"
+#include "tagged_hash.h"
 
 #include <algorithm>
 #include <array>
@@ -64,6 +65,14 @@ int main() {
               "e52dcda03b190fbbf9aa3f01500b77571b4b20692ad12bef4f62bb4f65f85a01",
           "mint coin entry is Bytes(empty)");
     Check(OutputLeaf(output) != CoinEntryLeaf(output), "output and coin domains differ");
+    const Hash own_input = TaggedHash(HashDomain::OwnInput, one);
+    const Hash sighash = TaggedHash(HashDomain::Sighash, one);
+    Check(Hex(own_input) == "b2658f901ab19e72f66bedb13ed74ac4a13fbc0f8b7d1af17b695cbca53287e5",
+          "independent own-input tag vector");
+    Check(Hex(sighash) == "152e69663b11475f32adbe5b718e3fa817076b9017dfe8478c04d8d066afb76b",
+          "independent sighash tag vector");
+    Check(own_input != sighash && own_input != InputCoreLeaf(one),
+          "signing domains remain separated from each other and input core");
 
     const char *indexed_expected[] = {
         "42717c875691058000ff7d89bae835b2d60733fd2082c120aa813124f68cf638",
