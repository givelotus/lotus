+static void SaltedOutpointHasherTwoContexts(benchmark::Bench &bench) {
+    uint64_t sink = 0;
+    bench.run([&] {
+        const uint64_t k0 = FastRandomContext().rand64();
+        const uint64_t k1 = FastRandomContext().rand64();
+        const COutPoint outpoint;
+        sink +=
