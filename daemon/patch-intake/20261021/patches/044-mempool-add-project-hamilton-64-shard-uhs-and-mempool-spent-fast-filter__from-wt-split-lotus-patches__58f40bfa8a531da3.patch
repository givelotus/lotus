+++ b/src/txmempool.cpp
@@ -231,9 +231,10 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     // even if not directly reported below.
     uint64_t mempool_sequence = GetAndIncrementSequence();
 
-    const TxId &txid = (*it)->GetTx().GetId();
+    const CTransaction &tx = (*it)->GetTx();
+    const TxId &txid = tx.GetId();
 
-    RemoveTransactionFromOverlay(m_merklix_overlay, (*it)->GetTx());
+    RemoveTransactionFromOverlay(m_merklix_overlay, tx);
 
     if (reason != MemPoolRemovalReason::BLOCK) {
         if (m_opts.signals) {
@@ -416,6 +417,7 @@ void CTxMemPool::_clear() {
     mapTx.clear();
     mapNextTx.clear();
     m_merklix_overlay.Clear();
+    m_utxo_fast_filter.ClearMempool();
     totalTxSize = 0;
     m_total_fee = Amount::zero();
     cachedInnerUsage = 0;
