From bdd501b5febca9c007e757faa23bbd5e598a090c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 06:24:00 -0700
Subject: [PATCH] fixup! mempool: add persistent Merklix overlay arenas and
 O(1) commitment helpers with CSHA256

---
 src/lotus_v2/mempool_overlay.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/mempool_overlay.cpp b/src/lotus_v2/mempool_overlay.cpp
index a546ef31b9..ba1f805ae3 100644
--- a/src/lotus_v2/mempool_overlay.cpp
+++ b/src/lotus_v2/mempool_overlay.cpp
@@ -1841,8 +1841,20 @@ void MempoolOverlayLayer::EnsureUtxoArenaUpdated() const {
     }
     auto base_root = utxo_arena_.GetBaseSmtRoot();
     utxo_arena_.Reset(std::move(base_root));
-    const auto erased = GetNetErasedOutpoints();
-    const auto inserted = GetNetInsertedCoins();
+    std::vector<Outpoint> erased;
+    erased.reserve(spent_outpoints_.size());
+    for (const auto &[op, count] : spent_outpoints_) {
+        if (count > 0 && created_coins_.find(op) == created_coins_.end()) {
+            erased.push_back(op);
+        }
+    }
+    std::vector<Coin> inserted;
+    inserted.reserve(created_coins_.size());
+    for (const auto &[op, coin] : created_coins_) {
+        if (spent_outpoints_.find(op) == spent_outpoints_.end()) {
+            inserted.push_back(coin);
+        }
+    }
     if (erased.size() + inserted.size() >= 16) {
         utxo_arena_.BatchUpdateParallel(erased, inserted);
     } else {
