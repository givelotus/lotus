From 8e55d33a42bbd6b83731b088d83d0618bb3cc29a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 03:25:32 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

Escape event descriptor names as JSON, just like every other string. A descriptor containing quotes, backslashes or newline previously emitted an invalid JSON record. The focused new encoder test fails before (exit 201) and passes afterward; all 30 logging/event cases pass. This hardens rendering without changing call-site field identities.
---
 src/logging/encoder.cpp          | 2 +-
 src/test/logging_event_tests.cpp | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/logging/encoder.cpp b/src/logging/encoder.cpp
index c19baadc46..a46c75cfd5 100644
--- a/src/logging/encoder.cpp
+++ b/src/logging/encoder.cpp
@@ -390,7 +390,7 @@ void JsonEncoder::Encode(const LogLine &line, const LogOptions &opts,
     out += '"';
     if (line.event) {
         out += ",\"event\":\"";
-        out += line.event->event;
+        AppendJsonEscaped(out, line.event->event);
         out += '"';
         for (const FieldView f : line.fields) {
             out += ",\"";
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 6dd50857a3..c2b197bc7a 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -260,4 +260,12 @@ BOOST_AUTO_TEST_CASE(logfmt_encoding) {
     BOOST_CHECK(lines[0].find("level=\"debug\"") != std::string::npos);
 }
 
+BOOST_AUTO_TEST_CASE(json_event_name_escaping) {
+    Format(BCLog::LogFormat::JSON);
+    LogEvent(BCLog::NET, "quote\"slash\\newline\n", "event message");
+    const auto record{Json()};
+    BOOST_CHECK_EQUAL(record["event"].get_str(), "quote\"slash\\newline\n");
+    BOOST_CHECK_EQUAL(record["message"].get_str(), "event message");
+}
+
 BOOST_AUTO_TEST_SUITE_END()
