+        Check(expected == chain.profile.Binding(), "provider expected binding");
+        const auto mtp = ParentMedianTime(chain.profile.header,
+                                          chain.history.front(), chain.history);
+        Check(mtp.has_value(), "provider MTP");
+        out = {expected,
