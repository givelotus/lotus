-BerkeleyBatch::BerkeleyBatch(BerkeleyDatabase &database, const bool read_only,
-                             bool fFlushOnCloseIn)
-    : m_database(database) {
-    database.AddRef();
-    database.Open();
-    fReadOnly = read_only;
-    fFlushOnClose = fFlushOnCloseIn;
-    env = database.env.get();
-    pdb = database.m_db.get();
-    strFile = database.strFile;
