-BerkeleyDatabase::~BerkeleyDatabase() {
-    if (env) {
-        LOCK(cs_db);
-        env->CloseDb(strFile);
-        assert(!m_db);
-        size_t erased = env->m_databases.erase(strFile);
-        assert(erased == 1);
-        env->m_fileids.erase(strFile);
