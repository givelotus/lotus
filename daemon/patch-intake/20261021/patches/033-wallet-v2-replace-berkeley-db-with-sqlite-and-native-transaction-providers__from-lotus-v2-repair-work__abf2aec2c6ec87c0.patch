+        if (lookup_failure != Result::Success &&
+            (!failure_lookup || lookups == failure_lookup))
+            return lookup_failure;
+        if (anchor.snapshot.tip != chain.store.Metadata().tip ||
+            anchor.snapshot.root != chain.store.Root())
