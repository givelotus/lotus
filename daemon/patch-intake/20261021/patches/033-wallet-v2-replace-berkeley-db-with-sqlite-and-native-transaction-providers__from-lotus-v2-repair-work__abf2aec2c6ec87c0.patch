+        return Result::Success;
+    }
+    Result Status(const V2Hash &, const V2Hash &, const std::vector<uint8_t> &,
+                  TransactionState &out, std::string &) override {
+        ++statuses;
+        out = {"pending", receipt_id, receipt_hash, {}, 0};
