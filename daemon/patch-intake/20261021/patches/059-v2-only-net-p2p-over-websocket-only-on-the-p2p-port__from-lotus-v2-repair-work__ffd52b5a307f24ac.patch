+bool AddP2PListener(const CService &addr, bilingual_str &error) {
+    const std::string host{addr.ToStringAddr()};
+    boost::system::error_code ec;
+    const auto ip{asio::ip::make_address(host, ec)};
+    if (ec) {
+        error = strprintf(Untranslated("Cannot listen on %s"),
+                          addr.ToStringAddrPort());
+        return false;
+    }
+    const tcp::endpoint endpoint{ip, addr.GetPort()};
+    for (const auto &listener : g_acceptors) {
+        if (listener.acceptor->local_endpoint(ec) == endpoint) {
+            LogPrintf("P2P on %s shares the %s listener\n",
+                      addr.ToStringAddrPort(),
+                      listener.public_only ? "public" : "RPC");
+            return true;
+        }
+    }
+    if (!BindEndpoint(host, addr.GetPort(), /*public_only=*/true)) {
+        error = strprintf(_("Unable to bind to %s on this computer. %s is "
+                            "probably already running."),
+                          addr.ToStringAddrPort(), PACKAGE_NAME);
+        return false;
+    }
+    auto &listener{g_acceptors.back()};
+    asio::co_spawn(listener.acceptor->get_executor(),
+                   AcceptLoop(*listener.acceptor, listener.public_only),
+                   asio::detached);
+    LogPrintf("Listening for P2P (WebSocket) on %s\n", addr.ToStringAddrPort());
+    return true;
+}
