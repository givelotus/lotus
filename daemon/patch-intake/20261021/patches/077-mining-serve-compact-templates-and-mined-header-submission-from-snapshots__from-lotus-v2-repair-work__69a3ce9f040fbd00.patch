+        custom_tmpl.template_id = pub.AllocateTemplateId();
+        custom_tmpl.prev_block_hash = BlockHash(uint256S("42"));
+        custom_tmpl.next_height = 777;
+        pub.RecordMiningTemplate(custom_tmpl);
