+        auto found_by_id =
+            pub.FindMiningTemplate(custom_tmpl.template_id, BlockHash());
+        BOOST_REQUIRE(found_by_id.has_value());
+        BOOST_CHECK_EQUAL(found_by_id->next_height, 777);
