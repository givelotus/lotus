-
-static std::map<void *, short> tags;
-static std::map<void *, uint16_t> orders;
-static uint16_t tagSequence = 0;
-
-static void *tag_malloc(size_t sz) {
-    void *mem = malloc(sz);
-    if (!mem) {
-        return mem;
-    }
-    tags[mem]++;
-    orders[mem] = tagSequence++;
-    return mem;
-}
-
-static void tag_free(void *mem) {
-    tags[mem]--;
-    orders[mem] = tagSequence++;
-    free(mem);
-}
