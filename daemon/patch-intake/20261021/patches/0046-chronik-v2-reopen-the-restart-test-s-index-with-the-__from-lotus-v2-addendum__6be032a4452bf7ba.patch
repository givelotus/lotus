From 8f280c3a04b21f483c17ba06258d95d35136a304 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 19:02:20 -0700
Subject: [PATCH 46/46] chronik(v2): reopen the restart test's index with the
 same tx source

restart_inverse_burns_and_replay closes the V2 index and reopens it with
V2Db::open, which creates a fresh, empty MemTxSource. Since the index
points into the node's block files (v2/037), the replay, disconnect and
reconnect after the restart read the creating transactions back through
the source, and the test failed with Node("unknown transaction"). A real
node's block files survive a restart; open both indexes with
V2Db::open_recording on one shared source, as
schema4_complete_facts_atomic_replay_and_tamper does. The native port
of the test gets the same change.

Tier: V2 (fixup to v2/037)
---
 chronik/chronik-db/src/v2_branch.rs | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/chronik/chronik-db/src/v2_branch.rs b/chronik/chronik-db/src/v2_branch.rs
index 7d366aada3..75e6eb22d4 100644
--- a/chronik/chronik-db/src/v2_branch.rs
+++ b/chronik/chronik-db/src/v2_branch.rs
@@ -1831,7 +1831,11 @@ mod tests {
     #[test]
     fn restart_inverse_burns_and_replay() {
         let dir = tempdir::TempDir::new("v2-index").unwrap();
-        let mut db = V2Db::open(dir.path(), binding(), bounds()).unwrap();
+        // The node's block files outlive a restart: share one source.
+        let mem = Arc::new(MemTxSource::default());
+        let mut db =
+            V2Db::open_recording(dir.path(), binding(), bounds(), mem.clone())
+                .unwrap();
         db.initialize_genesis(fixture_genesis(vec![])).unwrap();
         let genesis = db.snapshot().unwrap().anchor;
         let first = block(
@@ -1876,7 +1880,9 @@ mod tests {
         // Existing read snapshots remain coherent across disconnect.
         drop(anchored);
         drop(db);
-        let mut db = V2Db::open(dir.path(), binding(), bounds()).unwrap();
+        let mut db =
+            V2Db::open_recording(dir.path(), binding(), bounds(), mem.clone())
+                .unwrap();
         assert_eq!(db.snapshot().unwrap().anchor, second.anchor);
         db.connect(&second).unwrap();
         db.disconnect(second.anchor).unwrap();
