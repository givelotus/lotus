-    const double baseMs = std::max({0.1, m_settlingWindowMs, m_rttEwmaMs});
-    const double maxWindowMs =
-        static_cast<double>(AVALANCHE_DEFAULT_QUERY_TIMEOUT.count());
-    m_settlingWindowMs = std::min(maxWindowMs, 2.0 * baseMs);
