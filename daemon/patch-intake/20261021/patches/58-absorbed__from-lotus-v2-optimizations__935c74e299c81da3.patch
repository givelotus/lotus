From 2621b6f74b11af8ec50aceeb24a90f27708cbe37 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] mempool: expose lazy arena digest interfaces

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Defer internal Merklix branch digest hashing until root materialization, accelerate
GF(2^64) multiplication via ARM64 PMULL / x86 PCLMULQDQ intrinsics, and batch
mempool subscriber notifications.

Original-Commit: 2ef243d434f15e848f3a86a4d30f6fe7e8de3ff8
Original-Patch: ecash/035
Split-Concern: arena

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/lotus_v2/mempool_overlay.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/lotus_v2/mempool_overlay.h b/src/lotus_v2/mempool_overlay.h
index 3e1a98e4c54637d78763c8d65e4fdb401a117b38..03740385629c121dcd9943eda564b4be8163113f 100644
--- a/src/lotus_v2/mempool_overlay.h
+++ b/src/lotus_v2/mempool_overlay.h
@@ -72,6 +72,7 @@ struct TxOverlayNode {
     Hash key{};
     Hash tx_hash{};
     bool is_leaf{false};
+    bool digest_dirty{false};
 };
 
 /**
@@ -107,7 +108,7 @@ public:
     size_t ArenaNodeCount() const noexcept { return nodes_.size(); }
 
 private:
-    std::vector<TxOverlayNode> nodes_;
+    mutable std::vector<TxOverlayNode> nodes_;
 
     uint32_t AllocNode(const TxOverlayNode &node);
     uint32_t MakeLeaf(const Hash &tx_id, const Hash &tx_hash,
@@ -119,7 +120,8 @@ private:
                       unsigned depth);
     uint32_t EraseAt(uint32_t node_idx, const Hash &tx_id, unsigned depth);
     Hash ChildHash(uint32_t idx) const;
-    void RefreshNode(uint32_t idx, unsigned depth);
+    void RefreshNode(uint32_t idx, unsigned depth) const;
+    void EnsureDigest(uint32_t idx, unsigned depth) const;
 };
 
 /**
