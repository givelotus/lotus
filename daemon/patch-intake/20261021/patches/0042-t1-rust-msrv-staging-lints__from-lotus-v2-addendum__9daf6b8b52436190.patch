From abd8e14b125f8c22b2619d8fdb420bdd17e0eea5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:28:40 -0700
Subject: [PATCH] fixup! chronik(v2): retain legacy identities and coins in
 both indexes

Use usize.div_ceil for the same derived1718 per-wire staging counter and map_or(true) for the same missing/invalid legacy spend-selector predicate, honoring the declared Rust1.80 minimum. No staging cap, allocation, legacy/native grammar or rejection changes. Full strict Chronik Clippy and134tests pass with these lint repairs.

Tier: V2 (fixup to T1 chronik(v2): retain legacy identities and coins in both indexes; sealed original88b97b650c)
---
 chronik/chronik-db/src/v2_branch.rs | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/chronik/chronik-db/src/v2_branch.rs b/chronik/chronik-db/src/v2_branch.rs
index 81b764e95f..d6beeff8bc 100644
--- a/chronik/chronik-db/src/v2_branch.rs
+++ b/chronik/chronik-db/src/v2_branch.rs
@@ -42,9 +42,8 @@ pub const MIN_LEGACY_OUTPUT_WIRE_BYTES: usize = 9;
 // 6*1200, over nine wire bytes. Seven covers explorer per-byte/chunk charges.
 // This is a checked accounting ceiling, never an allocation size.
 pub const STAGING_PER_WIRE_BYTE: usize = 7
-    + (RESERVE_ASSET_ELEMENT + RESERVE_OUTPUT + MIN_LEGACY_OUTPUT_WIRE_BYTES
-        - 1)
-        / MIN_LEGACY_OUTPUT_WIRE_BYTES;
+    + (RESERVE_ASSET_ELEMENT + RESERVE_OUTPUT)
+        .div_ceil(MIN_LEGACY_OUTPUT_WIRE_BYTES);
 /// Staging reserved once per block (framing, checkpoint, header facts).
 pub const STAGING_PER_BLOCK: usize = 64 * 1024;
 /// Branch staging reserved per transaction.
@@ -692,7 +691,7 @@ impl V2Db {
                 tx.explorer
                     .inputs
                     .get(s.input_index as usize)
-                    .is_none_or(|i| i.flags != 1 && i.flags != 4)
+                    .map_or(true, |i| i.flags != 1 && i.flags != 4)
             }) {
                 return Err(Error::Invalid("full spend missing"));
             }
