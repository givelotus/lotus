From 1e24611c94a6db7aececab69245a074f6be4e238 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] perf: eliminate 5 CPU hotspots in 3-node loopback TPS profile

Eliminate redundant hex formatting, map lookups, and lock contention identified
in 3-node loopback high-TPS profiling.

Build-prerequisite maintenance:
- Retain the existing overlay, s5, lazy-snapshot and mempool-queue interfaces removed by 020 while their implementations/callers remain; retain prerequisite filter/fee headers and the optional batch-collector declaration.
- Retain the reconciliation s5/sub-bucket declarations used by the 020 protocol implementation and restored by 022.
- Define the avabatch inventory ID required by the original 012 implementation/tests (0x20000006), preserve it in GetKind, and map its command name.
- Remove the stale treasury lock annotation until its V2 treasury mutex exists; no runtime treasury code is changed.
- Declare the existing mempool-batch vote variant and visitors with their 012 definitions; defer the V2-only supply gate until its V2 supply API is present.
- Reorder the V2 circulating-supply integration case to the V2 API introduction; it referenced absent SetV2BlockCirculatingSupplyForTest on L1.
- Compile the original Avalanche batch hashing helpers and define their avabatch wire command. Vendor/link BLAKE3 for the existing non-consensus batch-ID hash; L1 tagged hashes and block/transaction consensus hashes remain SHA-based.
- Keep one copy of the adaptive-epoch accessors and freeze API duplicated by 023.
- Retain the pre-existing multi-depth reconciliation definitions/declarations across the incomplete 020 removal; declare the transaction-processing methods already defined in 020.
- Restore the missing testrawtxbatch result-lambda binding and removeUnchecked transaction alias, and include declarations used by validation; these are compile repairs to existing expressions.
- Include the concrete disconnected-transaction type in its native test, and retain the 011 inventory expectations (50/25 ms, 2500 items/s, 350000 retained IDs) across stale 020 test literals.
- Define peer-known transaction overrides at their first 020 use. The batch fallback calls the scalar operation; the coalesced-lock implementation remains in 035. Retain the existing s5 recovery overload removed by 020.
- Keep the first copy of each preconsensus batch test; 023 appended duplicate BOOST test definitions already present in 012.

Original-Commit: 5a6bd7cbe31742a801c42a2c1c0aacfdb050ef5c
---
 src/txmempool.cpp | 50 +++++++++++++++++++++++++++--------------------
 1 file changed, 29 insertions(+), 21 deletions(-)

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index da5db41736c175521f62dc027bbcae81fa3dfe8e..4e98ed2038f0290de15a664a730b6397a9f205e7 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -217,9 +217,15 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
         }
     }
 
-    AddTransactionToOverlay(m_merklix_overlay, tx,
-                            entry->GetFee() / SATOSHI,
-                            entry->GetSigChecks());
+    if (m_defer_snapshot_depth > 0) {
+        m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
+                                            entry->GetSigChecks());
+    } else {
+        FlushPendingOverlayAdds();
+        AddTransactionToOverlay(m_merklix_overlay, tx,
+                                entry->GetFee() / SATOSHI,
+                                entry->GetSigChecks());
+    }
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
@@ -235,6 +241,7 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     const CTransaction &tx = (*it)->GetTx();
     const TxId &txid = tx.GetId();
 
+    FlushPendingOverlayAdds();
     RemoveTransactionFromOverlay(m_merklix_overlay, tx);
 
     if (reason != MemPoolRemovalReason::BLOCK) {
@@ -417,6 +424,7 @@ void CTxMemPool::removeForFinalizedBlock(
 void CTxMemPool::_clear() {
     mapTx.clear();
     mapNextTx.clear();
+    m_pending_overlay_adds.clear();
     m_merklix_overlay.Clear();
     m_utxo_fast_filter.ClearMempool();
     totalTxSize = 0;
@@ -428,20 +436,34 @@ void CTxMemPool::_clear() {
     ++nTransactionsUpdated;
 }
 
+void CTxMemPool::FlushPendingOverlayAdds() const {
+    AssertLockHeld(cs);
+    if (m_pending_overlay_adds.empty()) {
+        return;
+    }
+    auto pending = std::move(m_pending_overlay_adds);
+    m_pending_overlay_adds.clear();
+    AddTransactionsToOverlayBatch(m_merklix_overlay, pending);
+}
+
 CTxMemPool::ScopedSnapshotDefer::~ScopedSnapshotDefer() {
     LOCK(m_pool.cs);
     assert(m_pool.m_defer_snapshot_depth > 0);
     --m_pool.m_defer_snapshot_depth;
-    if (m_pool.m_defer_snapshot_depth == 0 && m_pool.m_snapshot_dirty) {
-        m_pool.m_snapshot_dirty = false;
-        if (m_flush_on_exit) {
-            node::PublishMempoolSnapshot(m_pool);
+    if (m_pool.m_defer_snapshot_depth == 0) {
+        m_pool.FlushPendingOverlayAdds();
+        if (m_pool.m_snapshot_dirty) {
+            m_pool.m_snapshot_dirty = false;
+            if (m_flush_on_exit) {
+                node::PublishMempoolSnapshot(m_pool);
+            }
         }
     }
 }
 
 const lotus::v2::MempoolOverlayLayer &CTxMemPool::FreezeEpochBatch() {
     AssertLockHeld(cs);
+    FlushPendingOverlayAdds();
     return m_merklix_overlay.FreezeEpochBatch();
 }
 
@@ -527,20 +549,6 @@ void CTxMemPool::ConnectBlockReset(const BlockHash &new_tip_hash,
     }
 }
 
-void CTxMemPool::FlushPendingOverlayAdds() const {
-    AssertLockHeld(cs);
-    if (!m_pending_overlay_adds.empty()) {
-        AddTransactionsToOverlayBatch(m_merklix_overlay, m_pending_overlay_adds);
-        m_pending_overlay_adds.clear();
-    }
-    for (const auto &id : m_pending_overlay_removes) {
-        lotus::v2::Hash hash{};
-        std::memcpy(hash.data(), id.begin(), hash.size());
-        m_merklix_overlay.RemoveTransaction(hash);
-    }
-    m_pending_overlay_removes.clear();
-}
-
 void CTxMemPool::clear(bool include_finalized_txs) {
     LOCK(cs);
     _clear();
