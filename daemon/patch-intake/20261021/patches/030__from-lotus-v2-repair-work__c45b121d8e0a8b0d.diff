+bool CTxMemPool::TryClearAllForConnectedBlock(
+    const std::vector<CTransactionRef> &vtx) {
+    AssertLockHeld(cs);
+    if (!mapDeltas.empty() || vtx.size() <= 1 ||
+        mapTx.size() != vtx.size() - 1) {
+        return false;
+    }
+    for (size_t i = 1; i < vtx.size(); ++i) {
+        if (mapTx.find(vtx[i]->GetId()) == mapTx.end()) {
+            return false;
+        }
+    }
+    const size_t n_removed = vtx.size() - 1;
+    m_sequence_number += n_removed;
+    for (size_t i = 1; i < vtx.size(); ++i) {
+        const CTransaction &tx = *vtx[i];
+        for (const CTxIn &txin : tx.vin) {
+            m_utxo_fast_filter.RemoveUnspent(txin.prevout.GetTxId().begin(),
+                                             txin.prevout.GetN());
+        }
+    }
+    if (!m_unbroadcast_txids.empty()) {
+        m_unbroadcast_txids.clear();
+    }
+    _clear();
+    nTransactionsUpdated += (n_removed - 1);
+    updateFeeForBlock();
+    node::PublishMempoolSnapshot(*this);
+    return true;
+}
