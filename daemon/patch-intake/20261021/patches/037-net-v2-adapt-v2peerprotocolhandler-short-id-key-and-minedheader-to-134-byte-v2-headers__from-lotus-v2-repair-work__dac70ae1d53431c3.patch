-inline uint256 HashToUint256(const Hash &h) noexcept {
-    uint256 out;
-    std::memcpy(out.begin(), h.data(), 32);
-    return out;
-}
-
-inline Hash Uint256ToHash(const uint256 &u) noexcept {
-    Hash out{};
-    std::memcpy(out.data(), u.begin(), 32);
-    return out;
-}
-
