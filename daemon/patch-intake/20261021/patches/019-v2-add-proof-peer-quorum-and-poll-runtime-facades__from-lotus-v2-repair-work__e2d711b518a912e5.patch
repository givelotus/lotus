@@ -0,0 +1,48 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_POLL_H
+#define LOTUS_V2_AVALANCHE_POLL_H
+#include "avalanche_chain.h"
+#include "avalanche_diagnostics.h"
+#include "avalanche_quorum.h"
+#include <memory>
+namespace lotus::v2::ava {
+enum class ItemKind { Block, Proof };
+struct PollItem { ItemKind kind{}; Hash id{}; bool operator<(const PollItem &) const; };
+struct OutgoingPoll { NodeId node{}; uint64_t round{}; std::vector<PollItem> items; };
+enum class PollReceiveResult { Applied, Ignored, Rejected, LocalFailure };
+class PollEngine {
+public:
+    explicit PollEngine(Profile);
+    ~PollEngine();
+    bool Reconcile(const PollItem &, bool accepted, std::string &);
+    // Remove obsolete proof records before admitting replacement inventory.
+    // Work is bounded by max_queries; other vote histories remain intact.
+    void PruneProofs(const Quorum &);
+    bool Next(Quorum &, const ChainSnapshot &, int64_t now_milliseconds,
+              OutgoingPoll &, std::string &);
+    // Query deadlines use monotonic milliseconds; proof replacement times use
+    // the independently supplied wall-clock seconds.
+    // Single-owner operation: apply must atomically accept/reject the whole
+    // block batch and must not reenter this engine or mutate quorum. Proof
+    // transitions and staged vote confidence commit only after it accepts.
+    PollReceiveResult ReceiveResponse(Quorum &, NodeId, const SignedResponse &, const ChainSnapshot &,
+                 int64_t now_milliseconds, int64_t wall_seconds, const ApplyBlockUpdates &, std::string &);
+    // Compatibility predicate: only Applied is true; an authenticated ignored
+    // late/unknown response is false but is not grounds to disconnect its peer.
+    bool Receive(Quorum &, NodeId, const SignedResponse &, const ChainSnapshot &,
+                 int64_t now_milliseconds, int64_t wall_seconds, const ApplyBlockUpdates &, std::string &);
+    // Signatures for incoming polls are not required by ABC; only authenticated
+    // connection admission and signed outgoing responses. Observe is fenced.
+    bool Respond(const OutgoingPoll &, const ObserveBlock &, const Quorum &,
+                 const CKey &session_key, SignedResponse &, std::string &) const;
+    void Disconnect(NodeId);
+    // Passive native VoteRecord observation; never polls or expires queries.
+    std::optional<uint16_t> Confidence(const PollItem &) const;
+    PollDiagnostics Diagnostics() const;
+private:
+    PollReceiveResult ReceiveResponseImpl(Quorum &, NodeId, const SignedResponse &, const ChainSnapshot &,
+        int64_t, int64_t, const ApplyBlockUpdates &, std::string &);
+    struct Impl; std::unique_ptr<Impl> impl_;
+};
+} // namespace lotus::v2::ava
+#endif
diff --git a/src/lotus_v2/avalanche_proof.cpp b/src/lotus_v2/avalanche_proof.cpp
new file mode 100644
index 0000000000..356d1753ec
--- /dev/null
+++ b/src/lotus_v2/avalanche_proof.cpp
@@ -0,0 +1,66 @@
+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_proof.h"
+#include "commitment.h"
+#include <avalanche/validation.h>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+namespace lotus::v2::ava {
+bool ValidateProfile(const Profile &p, std::string &error) {
+    const Hash zero{};
+    if (p.chain_id == zero || p.genesis_id == zero || p.validation_digest == zero ||
+        p.stake_dust <= Amount::zero() || !MoneyRange(p.stake_dust) || !MoneyRange(p.min_quorum_stake) ||
+        p.stake_confirmations == 0 || !std::isfinite(p.min_connected_ratio) ||
+        p.min_connected_ratio < 0 || p.min_connected_ratio > 1 ||
+        p.max_element_poll < 16 || p.max_element_poll > 1024 ||
+        p.stale_vote_threshold < AVALANCHE_VOTE_STALE_MIN_THRESHOLD || p.stale_vote_factor == 0 ||
+        p.query_timeout_ms == 0 || p.max_proofs == 0 || p.max_nodes == 0 || p.max_queries == 0) {
+        error = "invalid-avalanche-profile"; return false;
+    }
+    error.clear(); return true;
+}
+bool AdmitProof(const Profile &p, const ChainSnapshot &snapshot, const CoinLookup &lookup,
+                const ProofEnvelope &env, AdmittedProof &out, const SnapshotReader &read,
+                std::string &error) {
+    auto fail = [&](const char *reason) { error = reason; return false; };
+    if (!ValidateProfile(p, error)) return false;
+    if (!lookup || !read || read() != snapshot) return fail("stale-chain-snapshot");
+    if (!env.proof) return fail("missing-proof");
+    ::avalanche::ProofValidationState state;
+    if (!env.proof->verify(p.stake_dust, state)) { error = state.GetRejectReason(); return false; }
+    const auto expiry = env.proof->getExpirationTime();
+    if (expiry > 0 && snapshot.median_time_past >= uint64_t(expiry)) return fail("expired-proof");
+    const auto &stakes = env.proof->getStakes();
+    if (env.payment_locks.size() != stakes.size()) return fail("payment-lock-count");
+    for (size_t i = 0; i < stakes.size(); ++i) {
+        const auto &stake = stakes[i].getStake();
+        const auto &native = stake.getUTXO();
+        Outpoint point{};
+        std::copy(native.GetTxId().begin(), native.GetTxId().end(), point.tx_id.begin());
+        point.index = native.GetN();
+        std::optional<Coin> coin;
+        if (!lookup(point, coin, error)) return false;
+        if (!coin) return fail("utxo-missing-or-spent");
+        if (coin->outpoint != point) return fail("lookup-outpoint-mismatch");
+        if (coin->creation_height != stake.getHeight()) return fail("height-mismatch");
+        if (coin->coinbase != stake.isCoinbase()) return fail("coinbase-mismatch");
+        if (coin->output.value > uint64_t(std::numeric_limits<int64_t>::max()) ||
+            int64_t(coin->output.value) * SATOSHI != stake.getAmount()) return fail("amount-mismatch");
+        if (coin->creation_height > snapshot.height ||
+            snapshot.height - coin->creation_height < uint64_t(p.stake_confirmations - 1))
+            return fail("immature-utxo");
+        const auto &lock = env.payment_locks[i];
+        const auto &key = stake.getPubkey();
+        if (!key.IsFullyValid() || !key.IsCompressed() || lock.size() != 35 || lock[0] != 0x20 ||
+            lock[33] != 0xbc || lock[34] != 0x4e ||
+            !std::equal(lock.begin() + 1, lock.begin() + 33, key.begin() + 1))
+            return fail("payment-lock-key-mismatch");
+        const auto &output = coin->output;
+        if (output.flags != 0 || output.token_id != Hash32{} ||
+            output.paths != std::vector<std::vector<uint8_t>>{{0}} ||
+            output.branches != std::vector<Hash32>{BranchLeaf(lock)}) return fail("payment-lock-mismatch");
+    }
+    if (read() != snapshot) return fail("stale-chain-snapshot");
+    out = {env, snapshot}; error.clear(); return true;
+}
+}
diff --git a/src/lotus_v2/avalanche_proof.h b/src/lotus_v2/avalanche_proof.h
new file mode 100644
index 0000000000..9ad6d2098f
--- /dev/null
+++ b/src/lotus_v2/avalanche_proof.h
@@ -0,0 +1,41 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_AVALANCHE_PROOF_H
+#define LOTUS_V2_AVALANCHE_PROOF_H
+#include <avalanche/avalanche.h>
+#include <avalanche/proof.h>
+#include <avalanche/voterecord.h>
+#include "sparse_state.h"
+#include <functional>
+namespace lotus::v2::ava {
+// All amounts map one V2 base unit to one ABC SATOSHI. This adapter retains
+// ABC proof signatures/ids/score; payout script is proof metadata, never a V2
+// coinbase instruction. Only native single-key Payment locks are supported.
+struct Profile {
+    Hash chain_id{}, genesis_id{}, validation_digest{};
+    Amount stake_dust{::avalanche::PROOF_DUST_THRESHOLD};
+    uint32_t stake_confirmations{AVALANCHE_DEFAULT_STAKE_UTXO_CONFIRMATIONS};
+    Amount min_quorum_stake{AVALANCHE_DEFAULT_MIN_QUORUM_STAKE};
+    double min_connected_ratio{AVALANCHE_DEFAULT_MIN_QUORUM_CONNECTED_STAKE_RATIO};
+    uint32_t min_avaproofs_nodes{8};
+    uint64_t conflicting_proof_cooldown_seconds{AVALANCHE_DEFAULT_CONFLICTING_PROOF_COOLDOWN};
+    uint64_t peer_replacement_cooldown_seconds{AVALANCHE_DEFAULT_PEER_REPLACEMENT_COOLDOWN};
+    uint32_t stale_vote_threshold{AVALANCHE_VOTE_STALE_THRESHOLD}, stale_vote_factor{AVALANCHE_VOTE_STALE_FACTOR};
+    uint32_t max_element_poll{1024}, query_timeout_ms{10000};
+    bool persist_peers{DEFAULT_PERSIST_AVAPEERS};
+    uint64_t max_proofs{10000}, max_nodes{10000}, max_queries{10000};
+};
+struct ChainSnapshot { Hash tip{}; uint64_t generation{}, height{}, median_time_past{}; bool initial_download{}; bool operator==(const ChainSnapshot &) const = default; };
+using SnapshotReader = std::function<ChainSnapshot()>;
+using CoinLookup = std::function<bool(const Outpoint &, std::optional<Coin> &, std::string &)>;
+struct ProofEnvelope {
+    ::avalanche::ProofRef proof;
+    // Ordered with signed stakes. Each must be exactly PUSH32 x-only-key
+    // followed by bytes 0xbc,0x4e (35 bytes), and match the coin's sole branch leaf.
+    std::vector<std::vector<uint8_t>> payment_locks;
+};
+struct AdmittedProof { ProofEnvelope envelope; ChainSnapshot validated_at; };
+bool ValidateProfile(const Profile &, std::string &);
+bool AdmitProof(const Profile &, const ChainSnapshot &, const CoinLookup &,
+                const ProofEnvelope &, AdmittedProof &, const SnapshotReader &, std::string &);
+} // namespace lotus::v2::ava
+#endif
diff --git a/src/lotus_v2/avalanche_protocol.cpp b/src/lotus_v2/avalanche_protocol.cpp
new file mode 100644
index 0000000000..090fa96da7
--- /dev/null
+++ b/src/lotus_v2/avalanche_protocol.cpp
@@ -0,0 +1,31 @@
+// Copyright (c) 2026 The Lotus developers
+#include "avalanche_protocol.h"
+#include <avalanche/validation.h>
+#include <hash.h>
+namespace lotus::v2::ava {
+uint256 HelloDigest(const ::avalanche::Delegation &delegation, const ConnectionTranscript &t) {
+    return (HashWriter{} << delegation.getId() << t.sender_nonce << t.receiver_nonce
+            << t.sender_entropy << t.receiver_entropy).GetHash();
+}
+bool AuthenticateHello(const ::avalanche::Delegation &delegation, const SchnorrSig &signature,
+                       const ConnectionTranscript &t, uint32_t max_elements,
+                       AuthenticatedHello &out, std::string &error) {
+    if (max_elements < 16 || max_elements > 1024) { error = "invalid-max-elements"; return false; }
+    ::avalanche::DelegationState state;
+    CPubKey key;
+    if (!delegation.verify(state, key)) { error = state.GetRejectReason(); return false; }
+    if (!key.VerifySchnorr(HelloDigest(delegation, t), signature)) {
+        error = "invalid-hello-signature"; return false;
+    }
+    out = {delegation.getProofId(), key, max_elements}; error.clear(); return true;
+}
+uint256 ResponseDigest(const ::avalanche::Response &response) {
+    return (HashWriter{} << response).GetHash();
+}
+bool AuthenticateResponse(const CPubKey &key, const SignedResponse &response, std::string &error) {
+    if (!key.VerifySchnorr(ResponseDigest(response.response), response.signature)) {
+        error = "invalid-response-signature"; return false;
+    }
+    error.clear(); return true;
+}
+}
