From ce82004c469076e8b209c5f9d7058f7a466116b0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matthew=20=F0=9F=AA=B7?= <matthew@urgero.net>
Date: Tue, 6 May 2025 12:26:44 -0500
Subject: [PATCH] Resolve divergent branches (#15)

Take latest master from
[Boblepointu/lotusd](https://github.com/Boblepointu/lotusd) and rebase
it onto our `lotusd/master`, resolving conflicts by choosing the changes
from the Boblepointu branch.

---------

Co-authored-by: Bob <alexandre@guillioud.com>
Co-authored-by: Mrs Turtle <mrs.turtle@lotusia.org>
Co-authored-by: Boblepointu <blackdeamon38@gmail.com>

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: a84f85b692505b7ed8af9da2b404be1d79ab7398
Recorded-replay-commit: 70fbd3f7923d7587be4452e6012cb7bc75cda288

diff --git a/src/init.cpp b/src/init.cpp
index 52f4f5ad0f..1c61525486 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -2000,7 +2000,7 @@ bool AppInitParameterInteraction(Config &config, const ArgsManager &args) {
     // Check blockmaxsize does not exceed maximum accepted block size.
     const int64_t nProposedMaxGeneratedBlockSize =
         args.GetIntArg("-blockmaxsize", DEFAULT_MAX_GENERATED_BLOCK_SIZE);
-    if (nProposedMaxGeneratedBlockSize <= 0) {
+    if (nProposedMaxGeneratedBlockSize <= 0 && args.IsArgSet("-blockmaxsize")) {
         return InitError(_("Max generated block size must be greater than 0"));
     }
     if (uint64_t(nProposedMaxGeneratedBlockSize) > config.GetMaxBlockSize()) {
diff --git a/src/kernel/mempool_persist.cpp b/src/kernel/mempool_persist.cpp
index 5c2737a486..80de679eae 100644
--- a/src/kernel/mempool_persist.cpp
+++ b/src/kernel/mempool_persist.cpp
@@ -86,7 +86,7 @@ bool LoadMempool(CTxMemPool &pool, const fs::path &load_path,
                 LOCK(cs_main);
                 const auto &accepted =
                     AcceptToMemoryPool(active_chainstate, tx, nTime,
-                                       /*bypass_limits=*/false,
+                                       /*bypass_limits=*/true,
                                        /*test_accept=*/false);
                 if (accepted.m_result_type ==
                     MempoolAcceptResult::ResultType::VALID) {
diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index b74924a254..d6e6d99197 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -1219,7 +1219,12 @@ static RPCHelpMan getblocktemplate() {
             const uint64_t sigCheckLimit =
                 GetMaxBlockSigChecksCount(DEFAULT_MAX_BLOCK_SIZE);
             result.pushKV("sigchecklimit", sigCheckLimit);
-            result.pushKV("sizelimit", DEFAULT_MAX_BLOCK_SIZE);
+            uint64_t blockSizeLimit = DEFAULT_MAX_BLOCK_SIZE;
+            if (gArgs.IsArgSet("-blockmaxsize")) {
+                blockSizeLimit =
+                    gArgs.GetIntArg("-blockmaxsize", DEFAULT_MAX_BLOCK_SIZE);
+            }
+            result.pushKV("sizelimit", blockSizeLimit);
             result.pushKV("curtime", pblock->GetBlockTime());
             result.pushKV("bits", strprintf("%08x", pblock->nBits));
             result.pushKV("height", int64_t(pindexPrev->nHeight) + 1);
