From 67b6da6c690d3aa06b689bc116c0254049089d15 Mon Sep 17 00:00:00 2001
From: Lotus contributors <build@givelotus.org>
Date: Wed, 14 Oct 2026 17:50:24 -0700
Subject: [PATCH] Add separate Bitcoin witness wire codec foundation

Retain ABC/Lotus/Doged TxMut serialization and existing HTTP/protobuf contracts. Parse exact Core witness flags and canonical CompactSize, retain full wire bytes separately, distinguish stripped txid from wtxid, and report byte/weight sizes. Native Core f13ae519 serializers and hashes supply 161 acceptance/rejection fixtures, including full-witness block offsets. This optional source patch does not implement or enable a Bitcoin Core Chronik host bridge, indexer or provider profile.

diff --git a/chronik/bitcoinsuite-core/src/tx/bitcoin.rs b/chronik/bitcoinsuite-core/src/tx/bitcoin.rs
new file mode 100644
index 0000000000000000000000000000000000000000..770f721c1bb7d34f7bc589d6073793f9002251eb
--- /dev/null
+++ b/chronik/bitcoinsuite-core/src/tx/bitcoin.rs
@@ -0,0 +1,222 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+//! Bitcoin Core's witness-aware wire format, separate from ABC's [`TxMut`].
+//!
+//! This codec parses bytes, not consensus or Script validity. It does not enable
+//! a Bitcoin Core Chronik host or change existing ABC/Lotus/Doged serializers.
+
+use bytes::Bytes;
+use thiserror::Error;
+
+use crate::{
+    bytes::read_bytes,
+    error::DataError,
+    hash::{Hashed, Sha256d},
+    script::Script,
+    ser::BitcoinSer,
+    tx::{OutPoint, Tx, TxId, TxInput, TxMut, TxOutput},
+};
+
+/// Parsing errors for the Bitcoin Core transaction wire format.
+#[derive(Clone, Debug, Error, Eq, PartialEq)]
+pub enum BitcoinTxError {
+    /// Fixed-width field or byte string exceeds remaining bytes.
+    #[error(transparent)]
+    Data(#[from] DataError),
+    /// CompactSize used more bytes than its value requires.
+    #[error("Non-canonical CompactSize")]
+    NonCanonicalCompactSize,
+    /// Core's default CompactSize limit was exceeded.
+    #[error("CompactSize exceeds MAX_SIZE")]
+    SizeLimit,
+    /// A vector count cannot fit in the remaining input.
+    #[error("Vector count exceeds remaining bytes")]
+    InvalidCount,
+    /// Optional transaction flags other than witness are unsupported by Core.
+    #[error("Unknown transaction optional data: {0:#x}")]
+    UnknownFlags(u8),
+    /// A witness marker was present, but all witness stacks were empty.
+    #[error("Superfluous witness record")]
+    SuperfluousWitness,
+    /// Bytes remained after the transaction locktime.
+    #[error("Trailing transaction bytes")]
+    TrailingBytes,
+}
+
+/// Immutable BTC wire transaction with separately identified stripped content.
+///
+/// Use [`Self::raw`] for broadcast/raw-tx responses. [`Self::stripped_tx`] is
+/// deliberately explicit: serializing it omits witness and must not be used for
+/// the full wire transaction or disk offsets. No implicit `Deref`/`BitcoinSer`
+/// conversion is provided, avoiding accidental witness stripping.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct BitcoinTx {
+    stripped: Tx,
+    raw: Bytes,
+    witness: Vec<Vec<Bytes>>,
+    wtxid: Sha256d,
+    stripped_size: usize,
+}
+
+impl BitcoinTx {
+    /// Parse exactly one Core-compatible transaction, rejecting trailing bytes.
+    pub fn from_raw(raw: Bytes) -> Result<Self, BitcoinTxError> {
+        let mut data = raw.clone();
+        let version = u32::deser(&mut data)?;
+        let mut inputs = read_inputs(&mut data)?;
+        let mut outputs = Vec::new();
+        let flags = if inputs.is_empty() {
+            let flags = u8::deser(&mut data)?;
+            if flags != 0 {
+                if flags != 1 {
+                    return Err(BitcoinTxError::UnknownFlags(flags));
+                }
+                inputs = read_inputs(&mut data)?;
+                outputs = read_outputs(&mut data)?;
+            }
+            flags
+        } else {
+            outputs = read_outputs(&mut data)?;
+            0
+        };
+        let mut witness = Vec::with_capacity(inputs.len());
+        for _ in &inputs {
+            witness.push(if flags == 1 {
+                let count = read_count(&mut data)?;
+                if count > data.len() {
+                    return Err(BitcoinTxError::InvalidCount);
+                }
+                let mut stack = Vec::with_capacity(count);
+                for _ in 0..count {
+                    stack.push(read_string(&mut data)?);
+                }
+                stack
+            } else {
+                Vec::new()
+            });
+        }
+        if flags == 1 && witness.iter().all(Vec::is_empty) {
+            return Err(BitcoinTxError::SuperfluousWitness);
+        }
+        let locktime = u32::deser(&mut data)?;
+        if !data.is_empty() {
+            return Err(BitcoinTxError::TrailingBytes);
+        }
+        let tx = TxMut {
+            version,
+            inputs,
+            outputs,
+            locktime,
+        };
+        let stripped = tx.ser();
+        // Explicit BTC SHA256d, independent of Lotus's merkleized TxId profile.
+        let txid = TxId::from(Sha256d::digest(&stripped));
+        let wtxid = Sha256d::digest(&raw);
+        Ok(Self {
+            stripped: Tx::with_txid(txid, tx),
+            raw,
+            witness,
+            wtxid,
+            stripped_size: stripped.len(),
+        })
+    }
+
+    /// Stripped transaction body, whose ID excludes marker/flags/witness.
+    pub fn stripped_tx(&self) -> &Tx {
+        &self.stripped
+    }
+
+    /// Full canonical wire bytes, including witness when present.
+    pub fn raw(&self) -> &Bytes {
+        &self.raw
+    }
+
+    /// One witness stack per input; legacy inputs have empty stacks.
+    pub fn witness(&self) -> &[Vec<Bytes>] {
+        &self.witness
+    }
+
+    /// Whether at least one input has a nonempty witness stack.
+    pub fn has_witness(&self) -> bool {
+        self.witness.iter().any(|stack| !stack.is_empty())
+    }
+
+    /// Witness transaction hash (SHA256d of full bytes), distinct from `TxId`.
+    pub fn wtxid(&self) -> Sha256d {
+        self.wtxid
+    }
+
+    /// Size of legacy serialization, excluding marker/flags/witness.
+    pub fn stripped_size(&self) -> usize {
+        self.stripped_size
+    }
+
+    /// BIP141 transaction weight, including marker/flags as witness bytes.
+    pub fn weight(&self) -> u64 {
+        3 * self.stripped_size as u64 + self.raw.len() as u64
+    }
+
+    /// Weight-based virtual size rounded up to a whole byte.
+    /// This is not Core's potentially sigop-adjusted mempool policy size.
+    pub fn vsize(&self) -> u64 {
+        self.weight().div_ceil(4)
+    }
+}
+
+// Core ReadCompactSize defaults to range_check=true and MAX_SIZE=0x02000000.
+// Check counts before allocating; raw byte lengths bound every vector allocation.
+fn read_count(data: &mut Bytes) -> Result<usize, BitcoinTxError> {
+    let marker = u8::deser(data)?;
+    let (value, minimum) = match marker {
+        0xfd => (u16::deser(data)? as u64, 0xfd),
+        0xfe => (u32::deser(data)? as u64, 0x10000),
+        0xff => (u64::deser(data)?, 0x100000000),
+        value => (value as u64, 0),
+    };
+    if value < minimum {
+        return Err(BitcoinTxError::NonCanonicalCompactSize);
+    }
+    if value > 0x02000000 {
+        return Err(BitcoinTxError::SizeLimit);
+    }
+    Ok(value as usize)
+}
+
+fn read_string(data: &mut Bytes) -> Result<Bytes, BitcoinTxError> {
+    let size = read_count(data)?;
+    Ok(read_bytes(data, size)?)
+}
+
+fn read_inputs(data: &mut Bytes) -> Result<Vec<TxInput>, BitcoinTxError> {
+    let count = read_count(data)?;
+    if count > data.len() / 41 {
+        return Err(BitcoinTxError::InvalidCount);
+    }
+    let mut inputs = Vec::with_capacity(count);
+    for _ in 0..count {
+        inputs.push(TxInput {
+            prev_out: OutPoint::deser(data)?,
+            script: Script::new(read_string(data)?),
+            sequence: u32::deser(data)?,
+            coin: None,
+        });
+    }
+    Ok(inputs)
+}
+
+fn read_outputs(data: &mut Bytes) -> Result<Vec<TxOutput>, BitcoinTxError> {
+    let count = read_count(data)?;
+    if count > data.len() / 9 {
+        return Err(BitcoinTxError::InvalidCount);
+    }
+    let mut outputs = Vec::with_capacity(count);
+    for _ in 0..count {
+        outputs.push(TxOutput {
+            sats: i64::deser(data)?,
+            script: Script::new(read_string(data)?),
+        });
+    }
+    Ok(outputs)
+}
