diff --git a/chronik/bitcoinsuite-core/tests/bitcoin_codec.rs b/chronik/bitcoinsuite-core/tests/bitcoin_codec.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2dc3cce1a4e790f7334969565d137ed9fd787b8c
--- /dev/null
+++ b/chronik/bitcoinsuite-core/tests/bitcoin_codec.rs
@@ -0,0 +1,151 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license; see the repository COPYING.
+
+use bitcoinsuite_core::{hash::Hashed, ser::BitcoinSer, tx::BitcoinTx};
+use bytes::Bytes;
+use serde_json::Value;
+
+fn decode_segments(segments: &Value) -> Bytes {
+    let mut raw = Vec::new();
+    for segment in segments.as_array().unwrap() {
+        if let Some(hex) = segment.get("hex") {
+            raw.extend(hex::decode(hex.as_str().unwrap()).unwrap());
+        } else {
+            let byte = segment["byte"].as_u64().unwrap() as u8;
+            let count = segment["count"].as_u64().unwrap() as usize;
+            raw.resize(raw.len() + count, byte);
+        }
+    }
+    Bytes::from(raw)
+}
+
+fn fixtures() -> Value {
+    serde_json::from_str(include_str!("fixtures/bitcoin_core_wire.json")).unwrap()
+}
+
+#[test]
+fn matches_pinned_core_wire_oracle() {
+    let fixtures = fixtures();
+    assert_eq!(
+        fixtures["core_pin"],
+        "f13ae519de94394314cd63a27924b0998ac65d45"
+    );
+    for case in fixtures["cases"].as_array().unwrap() {
+        let name = case["name"].as_str().unwrap();
+        let raw = decode_segments(&case["raw"]);
+        let decoded = BitcoinTx::from_raw(raw.clone());
+        assert_eq!(
+            decoded.is_ok(),
+            case["core"]["accepted"],
+            "{name}: {decoded:?}"
+        );
+        if !case["core"]["accepted"].as_bool().unwrap() {
+            continue;
+        }
+        let tx = decoded.unwrap();
+        let core = &case["core"];
+        assert_eq!(tx.raw(), &raw, "{name}: full serialization");
+        assert_eq!(
+            tx.stripped_tx().ser(),
+            decode_segments(&core["stripped"]),
+            "{name}: stripped serialization"
+        );
+        assert_eq!(
+            tx.stripped_tx().txid().to_string(),
+            core["txid"],
+            "{name}: txid"
+        );
+        assert_eq!(tx.wtxid().hex_be(), core["wtxid"], "{name}: wtxid");
+        assert_eq!(
+            tx.raw().len() as u64,
+            core["size"].as_u64().unwrap(),
+            "{name}: size"
+        );
+        assert_eq!(
+            tx.stripped_size() as u64,
+            core["stripped_size"].as_u64().unwrap(),
+            "{name}: stripped size"
+        );
+        assert_eq!(
+            tx.weight(),
+            core["weight"].as_u64().unwrap(),
+            "{name}: weight"
+        );
+        assert_eq!(
+            tx.vsize(),
+            core["weight"].as_u64().unwrap().div_ceil(4),
+            "{name}: vsize"
+        );
+        assert_eq!(
+            tx.has_witness(),
+            core["has_witness"],
+            "{name}: witness presence"
+        );
+        assert_eq!(
+            tx.witness().len(),
+            tx.stripped_tx().inputs.len(),
+            "{name}: witness inputs"
+        );
+        // These offsets were measured by reading an actual Core-serialized
+        // two-transaction block, not inferred from Rust's stripped structure.
+        assert_eq!(core["first_tx_offset"], 81, "{name}: header+count");
+        assert_eq!(
+            core["second_tx_offset"].as_u64().unwrap(),
+            81 + tx.raw().len() as u64,
+            "{name}: disk offset"
+        );
+        if tx.has_witness() {
+            assert_ne!(
+                core["second_tx_offset"].as_u64().unwrap(),
+                81 + tx.stripped_size() as u64,
+                "{name}: stripped size must not advance disk position"
+            );
+        } else {
+            assert_eq!(
+                tx.stripped_tx().txid().to_bytes(),
+                *tx.wtxid().as_le_bytes(),
+                "{name}: legacy hash equality"
+            );
+        }
+    }
+}
+
+#[test]
+fn witness_mutation_keeps_txid_but_changes_wtxid_and_wire_bytes() {
+    let fixture = fixtures();
+    let cases = fixture["cases"].as_array().unwrap();
+    let find = |name| {
+        let case = cases.iter().find(|case| case["name"] == name).unwrap();
+        BitcoinTx::from_raw(decode_segments(&case["raw"])).unwrap()
+    };
+    let first = find("witness");
+    let second = find("witness_mutation_same_txid");
+    assert_eq!(first.stripped_tx(), second.stripped_tx());
+    assert_ne!(first.raw(), second.raw());
+    assert_ne!(first.wtxid(), second.wtxid());
+}
+
+#[test]
+fn existing_other_script_contract_preserves_btc_witness_programs() {
+    use bitcoinsuite_core::script::{ScriptType, ScriptVariant};
+    let fixture = fixtures();
+    for name in ["witness", "p2wsh_and_p2tr_outputs"] {
+        let case = fixture["cases"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|case| case["name"] == name)
+            .unwrap();
+        let tx = BitcoinTx::from_raw(decode_segments(&case["raw"])).unwrap();
+        for output in &tx.stripped_tx().outputs {
+            assert_eq!(
+                output.script.variant(),
+                ScriptVariant::Other(output.script.clone())
+            );
+            let variant =
+                ScriptVariant::from_type_and_payload(ScriptType::Other, output.script.bytecode())
+                    .unwrap();
+            assert_eq!(variant.to_script(), output.script);
+        }
+    }
+}
