+    auto response = router.Handle(MakeRequest("GET", "/observed"));
+    BOOST_CHECK_EQUAL(response.status, 200);
+    BOOST_CHECK_EQUAL(BodyStr(response), "unchanged");
+    BOOST_CHECK_EQUAL(calls, 1U);
+    BOOST_CHECK_EQUAL(status, 200);
+}
