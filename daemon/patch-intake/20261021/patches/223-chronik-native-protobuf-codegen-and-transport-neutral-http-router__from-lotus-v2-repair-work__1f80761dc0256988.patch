diff --git a/chronik/native/core/http/http.cpp b/chronik/native/core/http/http.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..74f008450857de35cd2a9e9e20f11563074e8c8f
--- /dev/null
+++ b/chronik/native/core/http/http.cpp
@@ -0,0 +1,274 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// HttpRequest/HttpResponse helpers and the port of chronik-http error.rs.
+
+#include <chronik/native/error.h>
+#include <chronik/native/http.h>
+#include <chronik/native/proto.h>
+
+#include <google/protobuf/message_lite.h>
+
+#include <cctype>
+
+namespace chronik::native {
+
+namespace {
+
+bool IEquals(std::string_view a, std::string_view b) {
+    if (a.size() != b.size()) {
+        return false;
+    }
+    for (size_t i = 0; i < a.size(); ++i) {
+        if (std::tolower(static_cast<unsigned char>(a[i])) !=
+            std::tolower(static_cast<unsigned char>(b[i]))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+const std::string *FindHeader(const std::vector<HttpHeader> &headers,
+                              std::string_view name) {
+    for (const auto &[key, value] : headers) {
+        if (IEquals(key, name)) {
+            return &value;
+        }
+    }
+    return nullptr;
+}
+
+int HexVal(char c) {
+    if (c >= '0' && c <= '9') {
+        return c - '0';
+    }
+    if (c >= 'a' && c <= 'f') {
+        return c - 'a' + 10;
+    }
+    if (c >= 'A' && c <= 'F') {
+        return c - 'A' + 10;
+    }
+    return -1;
+}
+
+/** Append `cp` as UTF-8. */
+void AppendUtf8(std::string &out, uint32_t cp) {
+    if (cp < 0x80) {
+        out.push_back(char(cp));
+    } else if (cp < 0x800) {
+        out.push_back(char(0xC0 | (cp >> 6)));
+        out.push_back(char(0x80 | (cp & 0x3F)));
+    } else if (cp < 0x10000) {
+        out.push_back(char(0xE0 | (cp >> 12)));
+        out.push_back(char(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(char(0x80 | (cp & 0x3F)));
+    } else {
+        out.push_back(char(0xF0 | (cp >> 18)));
+        out.push_back(char(0x80 | ((cp >> 12) & 0x3F)));
+        out.push_back(char(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(char(0x80 | (cp & 0x3F)));
+    }
+}
+
+/**
+ * Rust String::from_utf8_lossy: invalid sequences become U+FFFD, with the
+ * "maximal subpart" rule (each invalid sequence prefix is one replacement).
+ */
+std::string Utf8Lossy(std::string_view in) {
+    std::string out;
+    out.reserve(in.size());
+    const auto *s = reinterpret_cast<const uint8_t *>(in.data());
+    size_t i = 0, n = in.size();
+    while (i < n) {
+        uint8_t b = s[i];
+        if (b < 0x80) {
+            out.push_back(char(b));
+            ++i;
+            continue;
+        }
+        size_t need;
+        uint8_t lo = 0x80, hi = 0xBF;
+        if (b >= 0xC2 && b <= 0xDF) {
+            need = 1;
+        } else if (b >= 0xE0 && b <= 0xEF) {
+            need = 2;
+            if (b == 0xE0) {
+                lo = 0xA0;
+            } else if (b == 0xED) {
+                hi = 0x9F;
+            }
+        } else if (b >= 0xF0 && b <= 0xF4) {
+            need = 3;
+            if (b == 0xF0) {
+                lo = 0x90;
+            } else if (b == 0xF4) {
+                hi = 0x8F;
+            }
+        } else {
+            out += "\xEF\xBF\xBD";
+            ++i;
+            continue;
+        }
+        size_t j = 1;
+        bool ok = true;
+        for (; j <= need; ++j) {
+            if (i + j >= n) {
+                ok = false;
+                break;
+            }
+            uint8_t c = s[i + j];
+            uint8_t l = j == 1 ? lo : 0x80, h = j == 1 ? hi : 0xBF;
+            if (c < l || c > h) {
+                ok = false;
+                break;
+            }
+        }
+        if (ok) {
+            out.append(in.substr(i, need + 1));
+            i += need + 1;
+        } else {
+            out += "\xEF\xBF\xBD";
+            i += j;
+        }
+    }
+    return out;
+}
+
+/** form_urlencoded byte decoding: '+' -> ' ', %XX -> byte. */
+std::string FormDecode(std::string_view in) {
+    std::string out;
+    out.reserve(in.size());
+    for (size_t i = 0; i < in.size(); ++i) {
+        char c = in[i];
+        if (c == '+') {
+            out.push_back(' ');
+        } else if (c == '%' && i + 2 < in.size() &&
+                   HexVal(in[i + 1]) >= 0 && HexVal(in[i + 2]) >= 0) {
+            out.push_back(char(HexVal(in[i + 1]) * 16 + HexVal(in[i + 2])));
+            i += 2;
+        } else {
+            out.push_back(c);
+        }
+    }
+    return Utf8Lossy(out);
+}
+
+} // namespace
+
+const std::string *HttpRequest::Header(std::string_view name) const {
+    return FindHeader(headers, name);
+}
+
+std::string HttpRequest::Target() const {
+    if (!has_query) {
+        return path;
+    }
+    return path + "?" + query_string;
+}
+
+std::map<std::string, std::string> HttpRequest::QueryParams() const {
+    std::map<std::string, std::string> params;
+    std::string_view qs = query_string;
+    while (!qs.empty()) {
+        size_t amp = qs.find('&');
+        std::string_view pair = qs.substr(0, amp);
+        qs = amp == std::string_view::npos ? std::string_view{}
+                                           : qs.substr(amp + 1);
+        if (pair.empty()) {
+            continue;
+        }
+        size_t eq = pair.find('=');
+        std::string key = FormDecode(pair.substr(0, eq));
+        std::string value = eq == std::string_view::npos
+                                ? std::string{}
+                                : FormDecode(pair.substr(eq + 1));
+        params[std::move(key)] = std::move(value);
+    }
+    return params;
+}
+
+const std::string *HttpResponse::Header(std::string_view name) const {
+    return FindHeader(headers, name);
+}
+
+void HttpResponse::SetHeader(std::string name, std::string value) {
+    for (auto &[key, val] : headers) {
+        if (IEquals(key, name)) {
+            val = std::move(value);
+            return;
+        }
+    }
+    headers.emplace_back(std::move(name), std::move(value));
+}
+
+std::string HttpResponse::ContentType() const {
+    const std::string *ct = Header("content-type");
+    return ct ? *ct : std::string{};
+}
+
+HttpResponse HttpResponse::Protobuf(const google::protobuf::MessageLite &msg,
+                                    int status) {
+    HttpResponse resp;
+    resp.status = status;
+    std::string out;
+    msg.SerializeToString(&out);
+    resp.body.assign(out.begin(), out.end());
+    resp.headers.emplace_back("content-type",
+                              std::string(CONTENT_TYPE_PROTOBUF));
+    return resp;
+}
+
+HttpResponse HttpResponse::Text(int status, std::string_view text) {
+    HttpResponse resp;
+    resp.status = status;
+    resp.body.assign(text.begin(), text.end());
+    resp.headers.emplace_back("content-type", std::string(CONTENT_TYPE_TEXT));
+    return resp;
+}
+
+HttpResponse HttpResponse::Empty(int status) {
+    HttpResponse resp;
+    resp.status = status;
+    return resp;
+}
+
+StatusError ReportStatusError(std::string_view error_msg,
+                              const HttpLogFn &log) {
+    const std::string msg(error_msg);
+    const std::optional<int> status = ParseErrorStatus(msg);
+    if (!status) {
+        if (log) {
+            log(msg + "\n", true);
+            log("Chronik HTTP server got an unknown error: " + msg + "\n",
+                false);
+        }
+        return {500, "Unknown error, contact admins"};
+    }
+    if (*status >= 500 && *status <= 599) {
+        if (log) {
+            log(msg + "\n", true);
+            log("Chronik HTTP server got an internal server error: " + msg +
+                    "\n",
+                false);
+        }
+    }
+    return {*status, msg};
+}
+
+HttpResponse ErrorResponse(std::string_view error_msg, const HttpLogFn &log) {
+    StatusError err = ReportStatusError(error_msg, log);
+    proto::Error proto;
+    proto.set_msg(err.msg);
+    return HttpResponse::Protobuf(proto, err.status);
+}
+
+HttpResponse ExceptionResponse(const std::exception &err,
+                               const HttpLogFn &log) {
+    if (const auto *rejection = dynamic_cast<const HttpRejection *>(&err)) {
+        return HttpResponse::Text(rejection->Status(), rejection->Body());
+    }
+    return ErrorResponse(err.what(), log);
+}
+
+} // namespace chronik::native
diff --git a/chronik/native/core/http/parse.cpp b/chronik/native/core/http/parse.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..63fe8308d267d6bf8ecf06f7ede4d13121dc072e
--- /dev/null
+++ b/chronik/native/core/http/parse.cpp
@@ -0,0 +1,262 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Port of chronik-http parse.rs (hex/LOKAD ID parts) plus axum's typed Path
+// rejections and Rust Debug formatting used in wire-visible messages.
+
+#include <chronik/native/error.h>
+#include <chronik/native/http.h>
+
+#include <cstdio>
+#include <limits>
+
+namespace chronik::native {
+
+namespace {
+
+/** Decode one UTF-8 code point (input assumed valid UTF-8). */
+uint32_t NextCodePoint(std::string_view s, size_t &i) {
+    const auto b = static_cast<uint8_t>(s[i]);
+    auto cont = [&](size_t k) {
+        return i + k < s.size() ? uint32_t(uint8_t(s[i + k]) & 0x3F) : 0u;
+    };
+    if (b < 0x80) {
+        i += 1;
+        return b;
+    }
+    if (b < 0xE0) {
+        uint32_t cp = (uint32_t(b & 0x1F) << 6) | cont(1);
+        i += 2;
+        return cp;
+    }
+    if (b < 0xF0) {
+        uint32_t cp = (uint32_t(b & 0x0F) << 12) | (cont(1) << 6) | cont(2);
+        i += 3;
+        return cp;
+    }
+    uint32_t cp = (uint32_t(b & 0x07) << 18) | (cont(1) << 12) |
+                  (cont(2) << 6) | cont(3);
+    i += 4;
+    return cp;
+}
+
+void AppendUtf8(std::string &out, uint32_t cp) {
+    if (cp < 0x80) {
+        out.push_back(char(cp));
+    } else if (cp < 0x800) {
+        out.push_back(char(0xC0 | (cp >> 6)));
+        out.push_back(char(0x80 | (cp & 0x3F)));
+    } else if (cp < 0x10000) {
+        out.push_back(char(0xE0 | (cp >> 12)));
+        out.push_back(char(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(char(0x80 | (cp & 0x3F)));
+    } else {
+        out.push_back(char(0xF0 | (cp >> 18)));
+        out.push_back(char(0x80 | ((cp >> 12) & 0x3F)));
+        out.push_back(char(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(char(0x80 | (cp & 0x3F)));
+    }
+}
+
+/**
+ * Approximation of Rust's `char::is_printable` for the code points that
+ * plausibly occur in request parameters: controls, soft hyphen, zero-width
+ * and bidi format characters, private use and specials are not printable.
+ */
+bool IsPrintable(uint32_t cp) {
+    if (cp < 0x20 || (cp >= 0x7F && cp <= 0xA0) || cp == 0xAD) {
+        return false;
+    }
+    if ((cp >= 0x200B && cp <= 0x200F) || (cp >= 0x2028 && cp <= 0x202E) ||
+        (cp >= 0x2060 && cp <= 0x206F) || cp == 0xFEFF ||
+        (cp >= 0xE000 && cp <= 0xF8FF) || (cp >= 0xFFF0 && cp <= 0xFFFC) ||
+        cp == 0xFFFE || cp == 0xFFFF || cp >= 0xF0000) {
+        return false;
+    }
+    return true;
+}
+
+void AppendEscaped(std::string &out, uint32_t cp, bool in_str) {
+    switch (cp) {
+        case '\t':
+            out += "\\t";
+            return;
+        case '\r':
+            out += "\\r";
+            return;
+        case '\n':
+            out += "\\n";
+            return;
+        case '\\':
+            out += "\\\\";
+            return;
+        case 0:
+            out += "\\0";
+            return;
+        case '"':
+            out += in_str ? "\\\"" : "\"";
+            return;
+        case '\'':
+            out += in_str ? "'" : "\\'";
+            return;
+        default:
+            break;
+    }
+    if (!IsPrintable(cp)) {
+        char buf[16];
+        std::snprintf(buf, sizeof(buf), "\\u{%x}", cp);
+        out += buf;
+        return;
+    }
+    AppendUtf8(out, cp);
+}
+
+/** Rust `{:?}` of a char */
+std::string RustDebugChar(uint32_t cp) {
+    std::string out = "'";
+    AppendEscaped(out, cp, false);
+    out += "'";
+    return out;
+}
+
+/** Rust `str::parse::<i64>` restricted to [min, max]. */
+std::optional<int64_t> ParseRustInt(std::string_view s, int64_t min,
+                                    int64_t max) {
+    if (s.empty()) {
+        return std::nullopt;
+    }
+    bool neg = false;
+    size_t i = 0;
+    if (s[0] == '+' || s[0] == '-') {
+        neg = s[0] == '-';
+        i = 1;
+        if (s.size() == 1) {
+            return std::nullopt;
+        }
+    }
+    if (neg && min >= 0) {
+        // unsigned types reject a '-' sign
+        return std::nullopt;
+    }
+    __int128 value = 0;
+    for (; i < s.size(); ++i) {
+        if (s[i] < '0' || s[i] > '9') {
+            return std::nullopt;
+        }
+        value = value * 10 + (s[i] - '0');
+        if (value > (__int128(1) << 64)) {
+            return std::nullopt;
+        }
+    }
+    if (neg) {
+        value = -value;
+    }
+    if (value < min || value > max) {
+        return std::nullopt;
+    }
+    return int64_t(value);
+}
+
+} // namespace
+
+std::string RustDebugStr(std::string_view s) {
+    std::string out = "\"";
+    size_t i = 0;
+    while (i < s.size()) {
+        AppendEscaped(out, NextCodePoint(s, i), true);
+    }
+    out += "\"";
+    return out;
+}
+
+std::optional<std::string> HexDecodeError(std::string_view payload) {
+    if (payload.size() % 2 != 0) {
+        return "Odd number of digits";
+    }
+    for (size_t i = 0; i < payload.size(); ++i) {
+        const char c = payload[i];
+        const bool ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
+                        (c >= 'A' && c <= 'F');
+        if (!ok) {
+            // hex 0.4: `c as char` of the byte, so each byte is a Latin-1
+            // char; formatted with {:?}
+            return "Invalid character " +
+                   RustDebugChar(static_cast<uint8_t>(c)) + " at position " +
+                   std::to_string(i);
+        }
+    }
+    return std::nullopt;
+}
+
+Bytes ParseHex(std::string_view payload) {
+    if (auto err = HexDecodeError(payload)) {
+        throw ChronikError("400: Invalid hex: " + *err);
+    }
+    Bytes out(payload.size() / 2);
+    auto val = [](char c) -> uint8_t {
+        if (c >= '0' && c <= '9') {
+            return uint8_t(c - '0');
+        }
+        if (c >= 'a' && c <= 'f') {
+            return uint8_t(c - 'a' + 10);
+        }
+        return uint8_t(c - 'A' + 10);
+    };
+    for (size_t i = 0; i < out.size(); ++i) {
+        out[i] = uint8_t(val(payload[2 * i]) << 4 | val(payload[2 * i + 1]));
+    }
+    return out;
+}
+
+std::array<uint8_t, 4> ParseLokadId(ByteView lokad_id) {
+    if (lokad_id.size() != 4) {
+        throw ChronikError(
+            "400: Invalid LOKAD ID length: expected 4 but got " +
+            std::to_string(lokad_id.size()));
+    }
+    return {lokad_id[0], lokad_id[1], lokad_id[2], lokad_id[3]};
+}
+
+std::array<uint8_t, 4> ParseLokadIdHex(std::string_view lokad_id_hex) {
+    const Bytes bytes = ParseHex(lokad_id_hex);
+    return ParseLokadId(bytes);
+}
+
+int32_t PathI32(const PathParams &params, size_t index) {
+    const std::string &value = params[index];
+    auto parsed =
+        ParseRustInt(value, std::numeric_limits<int32_t>::min(),
+                     std::numeric_limits<int32_t>::max());
+    if (!parsed) {
+        throw HttpRejection(400, "Invalid URL: Cannot parse value at index " +
+                                     std::to_string(index) + " with value `" +
+                                     RustDebugStr(value) + "` to a `i32`");
+    }
+    return int32_t(*parsed);
+}
+
+uint32_t PathU32(const PathParams &params, size_t index) {
+    const std::string &value = params[index];
+    auto parsed = ParseRustInt(value, 0, std::numeric_limits<uint32_t>::max());
+    if (!parsed) {
+        throw HttpRejection(400, "Invalid URL: Cannot parse value at index " +
+                                     std::to_string(index) + " with value `" +
+                                     RustDebugStr(value) + "` to a `u32`");
+    }
+    return uint32_t(*parsed);
+}
+
+int32_t PathSingleI32(const PathParams &params) {
+    const std::string &value = params[0];
+    auto parsed =
+        ParseRustInt(value, std::numeric_limits<int32_t>::min(),
+                     std::numeric_limits<int32_t>::max());
+    if (!parsed) {
+        throw HttpRejection(400, "Invalid URL: Cannot parse `" +
+                                     RustDebugStr(value) + "` to a `i32`");
+    }
+    return int32_t(*parsed);
+}
+
+} // namespace chronik::native
