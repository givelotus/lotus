From 7b804898f934e2d464c279e614449568d10b2f86 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:43:36 -0700
Subject: [PATCH] tests: retain historical mining activation rules with scoped
 regtest parameters

Maintenance rationale (2026-10-14):
Keep all original mining assertions active using easy Scrypt regtest proof of work with the historical activation regime expected by the fixtures. Scope and restore the copied chain parameters so later tests retain their own network selection.

diff --git a/src/config.h b/src/config.h
index d4424f16683bfb86fc1c1614f18a1cebb38cb11f..0fc85b8ccc597955a844bd1d2c02dfb3d9f140d3 100644
--- a/src/config.h
+++ b/src/config.h
@@ -36,6 +36,8 @@ public:
     bool SetMaxBlockSize(uint64_t maxBlockSize) override;
     uint64_t GetMaxBlockSize() const override;
     void SetChainParams(const CChainParams chainParamsIn) override;
+    //! Restore the selected network after a temporary test override.
+    void ClearChainParams() { chainParams.reset(); }
     const CChainParams &GetChainParams() const override;
     void SetCashAddrEncoding(bool) override;
     bool UseCashAddrEncoding() const override;
diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 749abe594dc22ff19c9b0368a1234a8a9d7b7347..4bf1376ef6469d63dba5a0089ddecbbf505a87fb 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -58,8 +58,9 @@ namespace miner_tests {
 struct MinerTestingSetup : public AvalancheTestingSetup {
     bool m_preconsensus{false};
 
-    MinerTestingSetup(const std::vector<const char *> &extra_args = {})
-        : AvalancheTestingSetup(ChainType::REGTEST, extra_args) {}
+    MinerTestingSetup(const std::vector<const char *> &extra_args = {},
+                      ChainType chain = ChainType::MAIN)
+        : AvalancheTestingSetup(chain, extra_args) {}
 
     void TestPackageSelection(const CChainParams &chainparams,
                               const CScript &scriptPubKey,
@@ -105,17 +106,43 @@ struct MinerTestingSetup : public AvalancheTestingSetup {
     }
 };
 
-struct MinerTestingSetupNoCheckpoints : public MinerTestingSetup {
-    MinerTestingSetupNoCheckpoints() : MinerTestingSetup({"-checkpoints=0"}) {}
+// These validity scenarios deliberately exercise the pre-BCH activation
+// regime. Keep that regime while using regtest's inexpensive Scrypt target,
+// fixed subsidy and maturity instead of Bitcoin's hard-coded SHA256 nonces.
+class MiningValidityParams : public CChainParams {
+public:
+    MiningValidityParams() : CChainParams(Params()) {
+        const auto regtest = consensus;
+        const auto main = CreateChainParams(ArgsManager{}, ChainType::MAIN);
+        consensus = main->GetConsensus();
+        consensus.powLimit = regtest.powLimit;
+        consensus.fPowNoRetargeting = regtest.fPowNoRetargeting;
+        consensus.nSubsidyHalvingInterval = regtest.nSubsidyHalvingInterval;
+        consensus.initialCoinbaseMaturity = regtest.initialCoinbaseMaturity;
+        consensus.auxpowStartHeight = regtest.auxpowStartHeight;
+        consensus.hashGenesisBlock = regtest.hashGenesisBlock;
+    }
 };
 
-struct PreconsensusMinerTestingSetupNoCheckpoints : public MinerTestingSetup {
-    PreconsensusMinerTestingSetupNoCheckpoints()
-        : MinerTestingSetup({"-checkpoints=0"}) {
-        m_preconsensus = true;
+struct MinerTestingSetupNoCheckpoints : public MinerTestingSetup {
+    MinerTestingSetupNoCheckpoints()
+        : MinerTestingSetup({"-checkpoints=0"}, ChainType::REGTEST) {
+        auto &config =
+            static_cast<GlobalConfig &>(const_cast<Config &>(GetConfig()));
+        config.SetChainParams(MiningValidityParams{});
+    }
+    ~MinerTestingSetupNoCheckpoints() {
+        auto &config =
+            static_cast<GlobalConfig &>(const_cast<Config &>(GetConfig()));
+        config.ClearChainParams();
     }
 };
 
+struct PreconsensusMinerTestingSetupNoCheckpoints
+    : public MinerTestingSetupNoCheckpoints {
+    PreconsensusMinerTestingSetupNoCheckpoints() { m_preconsensus = true; }
+};
+
 } // namespace miner_tests
 
 BOOST_FIXTURE_TEST_SUITE(miner_tests, MinerTestingSetup)
@@ -178,13 +205,11 @@ void MinerTestingSetup::TestPackageSelection(
     std::unique_ptr<CBlockTemplate> pblocktemplate =
         AssemblerForTest(chainparams).CreateNewBlock(scriptPubKey);
 
-    // Since we use the mainnet for the test, the ordering is not enforced by
-    // CTOR.
+    // The fixture keeps mainnet historical activation heights, so ordering
+    // is not enforced by CTOR.
     // But using preconsensus, CTOR is always enforced.
     std::vector<TxId> txids = {mediumFeeTxId, parentTxId, highFeeTxId};
-    if (m_preconsensus || IsMagneticAnomalyEnabled(
-                                 chainparams.GetConsensus(),
-                                 m_node.chainman->ActiveTip())) {
+    if (m_preconsensus) {
         std::sort(txids.begin(), txids.end());
     }
     BOOST_CHECK(pblocktemplate->block.vtx[1]->GetId() == txids[0]);
@@ -363,8 +388,10 @@ void MinerTestingSetup::TestBasicMining(
 
     // Subsidy changing.
     int nHeight = m_node.chainman->ActiveHeight();
-    // Create an actual 209999-long block chain (without valid blocks).
-    while (m_node.chainman->ActiveHeight() < 209999) {
+    const int halvingHeight =
+        chainparams.GetConsensus().nSubsidyHalvingInterval;
+    // Extend to either side of the fixture subsidy transition.
+    while (m_node.chainman->ActiveHeight() < halvingHeight - 1) {
         CBlockIndex *prev = m_node.chainman->ActiveTip();
         CBlockIndex *next = new CBlockIndex();
         next->phashBlock = new BlockHash(m_rng.rand256());
@@ -377,8 +404,8 @@ void MinerTestingSetup::TestBasicMining(
     }
     BOOST_CHECK(pblocktemplate =
                     AssemblerForTest(chainparams).CreateNewBlock(scriptPubKey));
-    // Extend to a 210000-long block chain.
-    while (m_node.chainman->ActiveHeight() < 210000) {
+    BOOST_CHECK_EQUAL(pblocktemplate->block.vtx[0]->GetValueOut(), 25 * COIN);
+    while (m_node.chainman->ActiveHeight() < halvingHeight) {
         CBlockIndex *prev = m_node.chainman->ActiveTip();
         CBlockIndex *next = new CBlockIndex();
         next->phashBlock = new BlockHash(m_rng.rand256());
@@ -730,9 +757,7 @@ void MinerTestingSetup::TestPrioritisedMining(
     std::vector<TxId> txids = {hashFreeParent, hashFreePrioritisedTx,
                                hashFreeChild, hashParentTx,
                                hashPrioritisedChild};
-    if (m_preconsensus || IsMagneticAnomalyEnabled(
-                                 chainparams.GetConsensus(),
-                                 m_node.chainman->ActiveTip())) {
+    if (m_preconsensus) {
         std::sort(txids.begin(), txids.end());
     }
     BOOST_CHECK(pblocktemplate->block.vtx[1]->GetId() == txids[0]);
@@ -754,8 +779,7 @@ void MinerTestingSetup::TestPrioritisedMining(
 void MinerTestingSetup::CreateNewBlock_validity() {
     gArgs.ForceSetArg("-enableminerfund", "0");
     // Note that by default, these tests run with size accounting enabled.
-    GlobalConfig config;
-    const CChainParams &chainparams = config.GetChainParams();
+    const CChainParams &chainparams = m_node.chainman->GetParams();
     CScript scriptPubKey =
         CScript() << ParseHex("04678afdb0fe5548271967f1a67130b7105cd6a828e03909"
                               "a67962e0ea1f61deb649f6bc3f4cef38c4f35504e51ec112"
@@ -799,8 +823,9 @@ void MinerTestingSetup::CreateNewBlock_validity() {
         }
         std::shared_ptr<const CBlock> shared_pblock =
             std::make_shared<const CBlock>(*pblock);
-        BOOST_REQUIRE(Assert(m_node.chainman)
-                          ->ProcessNewBlock(shared_pblock, true, true, nullptr));
+        BOOST_REQUIRE(
+            Assert(m_node.chainman)
+                ->ProcessNewBlock(shared_pblock, true, true, nullptr));
         pblock->hashPrevBlock = pblock->GetHash();
     }
 
