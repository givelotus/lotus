From 68e2479c15f8db0500651474823bc5570976dd72 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 01:40:58 -0700
Subject: [PATCH] fixup! consensus(v2): connect native state, monetary and
 script rules

Partition the original8000-output legacy fan transaction under the retained universal256-output limit. Keep199 blocks,98 heavy blocks,8000 fan outputs and2666 three-input spends per heavy block. A32-way split and32 fan transactions add32 transactions per heavy block; max outputs250. Preserve send-without-ping backlog and shutdown safety workload; no consensus changes.

Tier: V2 (fixup to consensus(v2): connect native state, monetary and script rules)
---
 test/functional/chronik_shutdown.py | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/test/functional/chronik_shutdown.py b/test/functional/chronik_shutdown.py
index d554314770..c958b49247 100644
--- a/test/functional/chronik_shutdown.py
+++ b/test/functional/chronik_shutdown.py
@@ -41,16 +41,25 @@ class ChronikShutdown(BitcoinTestFramework):
             txs = []
             if i > 101:
                 txid = coinbase_txs[i - 101].txid_int
-                fan_tx = CTransaction()
-                fan_tx.vin = [CTxIn(COutPoint(txid, 0))]
-                fan_tx.vout = [CTxOut(1000, CScript([OP_TRUE]))] * 8000
-                fan_txid_int = fan_tx.txid_int
-                txs.append(fan_tx)
+                # Preserve all 8,000 fan outputs and 2,666 three-input
+                # spends under the universal 256-output transaction limit.
+                split_tx = CTransaction()
+                split_tx.vin = [CTxIn(COutPoint(txid, 0))]
+                split_tx.vout = [CTxOut(250_000, CScript([OP_TRUE]))] * 32
+                txs.append(split_tx)
+                fan_outpoints = []
+                for split_idx in range(32):
+                    fan_tx = CTransaction()
+                    fan_tx.vin = [CTxIn(COutPoint(split_tx.txid_int, split_idx))]
+                    fan_tx.vout = [CTxOut(1000, CScript([OP_TRUE]))] * 250
+                    txs.append(fan_tx)
+                    fan_outpoints.extend(
+                        COutPoint(fan_tx.txid_int, k) for k in range(250)
+                    )
+                assert len(fan_outpoints) == 8000
                 for j in range(0, 7997, 3):
                     tx = CTransaction()
-                    tx.vin = [
-                        CTxIn(COutPoint(fan_txid_int, k)) for k in range(j, j + 3)
-                    ]
+                    tx.vin = [CTxIn(fan_outpoints[k]) for k in range(j, j + 3)]
                     tx.vout = [CTxOut(1000, CScript([OP_TRUE]))]
                     txs.append(tx)
             block = create_block(
