From f1f3cc2274fbe1e2c08c639afb6fd0f321a82c54 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] mempool: add Project Hamilton 64-shard UHS and mempool-spent
 fast filter

Add the 64-shard cache-line-aligned UTXO Hash Set (UHS) and MempoolSpentFilter
for O(1) lock-free double-spend pre-filtering.

Original-Commit: f24485875feb5b7e5ae418b4d3bc5833f38cca27
Original-Patch: ecash/024
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/lotus_v2/utxo_fast_filter.h | 158 ++++++++++++++++++++++++++++++++
 src/txmempool.cpp               |   6 +-
 src/txmempool.h                 |   1 +
 3 files changed, 163 insertions(+), 2 deletions(-)
 create mode 100644 src/lotus_v2/utxo_fast_filter.h

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 9dce17b66d184c5a8800615bea9de5e303c2682b..f7faa63a717ab54e59c15b69f27ee2e3e36553c2 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -231,9 +231,10 @@ void CTxMemPool::removeUnchecked(txiter it, MemPoolRemovalReason reason) {
     // even if not directly reported below.
     uint64_t mempool_sequence = GetAndIncrementSequence();
 
-    const TxId &txid = (*it)->GetTx().GetId();
+    const CTransaction &tx = (*it)->GetTx();
+    const TxId &txid = tx.GetId();
 
-    RemoveTransactionFromOverlay(m_merklix_overlay, (*it)->GetTx());
+    RemoveTransactionFromOverlay(m_merklix_overlay, tx);
 
     if (reason != MemPoolRemovalReason::BLOCK) {
         if (m_opts.signals) {
@@ -416,6 +417,7 @@ void CTxMemPool::_clear() {
     mapTx.clear();
     mapNextTx.clear();
     m_merklix_overlay.Clear();
+    m_utxo_fast_filter.ClearMempool();
     totalTxSize = 0;
     m_total_fee = Amount::zero();
     cachedInnerUsage = 0;
diff --git a/src/txmempool.h b/src/txmempool.h
index efd830c2c2ff33145455bd6c1bae57146d3596ff..66d92b1627d753c8174311d43e26f691ef6f2fea 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -14,6 +14,7 @@
 #include <kernel/mempool_entry.h>
 #include <kernel/mempool_options.h>
 #include <lotus_v2/mempool_overlay.h>
+#include <lotus_v2/utxo_fast_filter.h>
 #include <node/blockfitter.h>
 #include <policy/packages.h>
 #include <primitives/transaction.h>
