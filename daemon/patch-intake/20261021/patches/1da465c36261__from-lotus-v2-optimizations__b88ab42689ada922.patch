From 1da465c36261ec9f080fac8712e6b33aa47b2e83 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:57:46 -0700
Subject: [PATCH] fixup! chronik: offload ChronikValidationInterface callbacks
 to dedicated worker thread

Publish fatal worker notification before waking completion fences, so Sync cannot race the failure notification.
---
 src/util/bounded_task_queue.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/util/bounded_task_queue.h b/src/util/bounded_task_queue.h
index 33aa33279f..e07be17b5d 100644
--- a/src/util/bounded_task_queue.h
+++ b/src/util/bounded_task_queue.h
@@ -59,8 +59,9 @@ class BoundedTaskQueue {
                     m_failed = m_stopping = notify_failure = true;
                 }
             }
-            m_drained.notify_all();
+            // A completed fence must also observe the fatal notification.
             if (notify_failure) m_fail();
+            m_drained.notify_all();
         }
     }
 
