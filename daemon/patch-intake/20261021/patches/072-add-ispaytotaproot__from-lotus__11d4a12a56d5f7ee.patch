From f3d2b7345bcf9a2a0d33a7dcced4196e657e590a Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Tue, 6 Apr 2021 12:13:29 -0500
Subject: [PATCH] Add IsPayToTaproot (#126)

This returns whether a script is a valid Taproot output script.

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 5befa99b2ff1d3f9fde2dad2210e62ef0062cace
Recorded-replay-commit: d3980454f44879aeb2cced8a983830a0398b3eff

diff --git a/src/script/taproot.cpp b/src/script/taproot.cpp
index dcdd541f64..93fbeb0d96 100644
--- a/src/script/taproot.cpp
+++ b/src/script/taproot.cpp
@@ -4,6 +4,7 @@
 
 #include <hash.h>
 #include <pubkey.h>
+#include <script/script.h>
 #include <script/taproot.h>
 
 static const HashWriter HASHER_TAPLEAF = TaggedHash("TapLeaf");
@@ -62,3 +63,24 @@ bool VerifyTaprootCommitment(uint256 &tapleaf_hash,
     }
     return q == q_expected;
 }
+
+bool IsPayToTaproot(const CScript &script) {
+    if (script.size() < TAPROOT_SIZE_WITHOUT_STATE) {
+        return false;
+    }
+    // Taproot must start with OP_SCRIPTTYPE OP_1
+    if (script[0] != OP_SCRIPTTYPE || script[1] != TAPROOT_SCRIPTTYPE) {
+        return false;
+    }
+    // First push (commitment) must be 33 bytes long
+    if (script[2] != CPubKey::COMPRESSED_SIZE) {
+        return false;
+    }
+    // If there's only a commitment but no state, we're valid
+    if (script.size() == TAPROOT_SIZE_WITHOUT_STATE) {
+        return true;
+    }
+    // Otherwise, we need a state with 32 bytes.
+    return script.size() == TAPROOT_SIZE_WITH_STATE &&
+           script[TAPROOT_SIZE_WITHOUT_STATE] == CSHA256::OUTPUT_SIZE;
+}
diff --git a/src/script/taproot.h b/src/script/taproot.h
index 7b7ad74e6b..c12eaca0c5 100644
--- a/src/script/taproot.h
+++ b/src/script/taproot.h
@@ -19,6 +19,15 @@ static constexpr size_t TAPROOT_CONTROL_MAX_SIZE =
     TAPROOT_CONTROL_BASE_SIZE +
     TAPROOT_CONTROL_NODE_SIZE * TAPROOT_CONTROL_MAX_NODE_COUNT;
 
+static constexpr opcodetype TAPROOT_SCRIPTTYPE = OP_1;
+
+// OP_SCRIPTTYPE <type> 0x21...
+static constexpr uint32_t TAPROOT_INTRO_SIZE = 3;
+static constexpr uint32_t TAPROOT_SIZE_WITHOUT_STATE =
+    TAPROOT_INTRO_SIZE + CPubKey::COMPRESSED_SIZE;
+static constexpr uint32_t TAPROOT_SIZE_WITH_STATE =
+    TAPROOT_INTRO_SIZE + CPubKey::COMPRESSED_SIZE + 33;
+
 /**
  * Verifies that the control block proves that script is part of the commitment.
  *
@@ -37,4 +46,13 @@ bool VerifyTaprootCommitment(uint256 &tapleaf_hash,
                              const valtype &control_block,
                              const valtype &commitment, const CScript &script);
 
+/**
+ * Returns whether the script is a valid Taproot output script.
+ *
+ * Valid scripts can be either of these:
+ * - `OP_SCRIPTTYPE OP_1 <33-byte commitment>
+ * - `OP_SCRIPTTYPE OP_1 <33-byte commitment> <32-byte state>
+ */
+bool IsPayToTaproot(const CScript &script);
+
 #endif // BITCOIN_SCRIPT_TAPROOT_H
diff --git a/src/test/taproot_tests.cpp b/src/test/taproot_tests.cpp
index 6514e3da5b..ef280e40b1 100644
--- a/src/test/taproot_tests.cpp
+++ b/src/test/taproot_tests.cpp
@@ -2,6 +2,10 @@
 // Distributed under the MIT software license, see the accompanying
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
+#include <core_io.h>
+#include <policy/policy.h>
+#include <script/interpreter.h>
+#include <script/sigencoding.h>
 #include <script/taproot.h>
 #include <util/strencodings.h>
 
@@ -249,4 +253,34 @@ BOOST_AUTO_TEST_CASE(verify_taproot_commitment_3) {
     BOOST_CHECK_EQUAL(taproot_leaf, uint256(expected_taproot_leaf));
 }
 
+BOOST_AUTO_TEST_CASE(is_p2tr) {
+    BOOST_CHECK(!IsPayToTaproot(CScript() << OP_SCRIPTTYPE << OP_1));
+    BOOST_CHECK(
+        !IsPayToTaproot(CScript() << OP_SCRIPTTYPE << OP_1 << valtype(0)));
+    BOOST_CHECK(
+        !IsPayToTaproot(CScript() << OP_SCRIPTTYPE << OP_1 << valtype(32)));
+    BOOST_CHECK(
+        !IsPayToTaproot(CScript() << OP_SCRIPTTYPE << OP_1 << valtype(34)));
+    for (uint32_t commitment_len = 0; commitment_len < 70; ++commitment_len) {
+        bool is_valid_commitment = commitment_len == 33;
+        BOOST_CHECK_EQUAL(is_valid_commitment,
+                          IsPayToTaproot(CScript() << OP_SCRIPTTYPE << OP_1
+                                                   << valtype(commitment_len)));
+        for (uint32_t state_len = 0; state_len < 70; ++state_len) {
+            bool is_valid_state = state_len == 32;
+            BOOST_CHECK_EQUAL(is_valid_commitment && is_valid_state,
+                              IsPayToTaproot(CScript()
+                                             << OP_SCRIPTTYPE << OP_1
+                                             << valtype(commitment_len)
+                                             << valtype(state_len)));
+            for (uint32_t junk_len = 0; junk_len < 70; ++junk_len) {
+                BOOST_CHECK(!IsPayToTaproot(CScript() << OP_SCRIPTTYPE << OP_1
+                                                      << valtype(commitment_len)
+                                                      << valtype(state_len)
+                                                      << valtype(junk_len)));
+            }
+        }
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
