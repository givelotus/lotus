diff --git a/src/test/sockwakeup_tests.cpp b/src/test/sockwakeup_tests.cpp
new file mode 100644
index 0000000000..1c3f63f010
--- /dev/null
+++ b/src/test/sockwakeup_tests.cpp
@@ -0,0 +1,101 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <util/sockwakeup.h>
+
+#include <test/util/setup_common.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <chrono>
+#include <thread>
+
+using namespace std::chrono_literals;
+
+namespace {
+bool Woken(const SockWakeup &w, std::chrono::milliseconds timeout) {
+    Sock::Event occurred{0};
+    return w.WaitSock()->Wait(timeout, Sock::RECV, &occurred) &&
+           (occurred & Sock::RECV);
+}
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(sockwakeup_tests, BasicTestingSetup)
+
+BOOST_AUTO_TEST_CASE(wake_and_drain) {
+    auto w{SockWakeup::Make()};
+    BOOST_REQUIRE(w);
+    BOOST_CHECK(!Woken(*w, 0ms));
+    // Many wakeups before a drain: one byte, one wakeup.
+    for (int i = 0; i < 1000; ++i) {
+        w->Wake();
+    }
+    BOOST_CHECK(Woken(*w, 0ms));
+    w->Drain();
+    BOOST_CHECK(!Woken(*w, 0ms));
+    // After a drain, the next Wake() writes again.
+    w->Wake();
+    BOOST_CHECK(Woken(*w, 0ms));
+    w->Drain();
+    BOOST_CHECK(!Woken(*w, 0ms));
+}
+
+BOOST_AUTO_TEST_CASE(wake_from_another_thread_ends_a_wait) {
+    auto w{SockWakeup::Make()};
+    BOOST_REQUIRE(w);
+    const auto start{std::chrono::steady_clock::now()};
+    std::thread waker{[&] {
+        std::this_thread::sleep_for(20ms);
+        w->Wake();
+    }};
+    BOOST_CHECK(Woken(*w, 10s));
+    waker.join();
+    BOOST_CHECK(std::chrono::steady_clock::now() - start < 5s);
+    w->Drain();
+}
+
+BOOST_AUTO_TEST_CASE(no_lost_wakeup_under_contention) {
+    // A waiter loops wait/drain while another thread wakes it after each
+    // change: every change must be seen without waiting for a timeout.
+    auto w{SockWakeup::Make()};
+    BOOST_REQUIRE(w);
+    std::atomic<int> changes{0};
+    constexpr int N{2000};
+    std::thread waker{[&] {
+        for (int i = 0; i < N; ++i) {
+            changes.fetch_add(1);
+            w->Wake();
+        }
+    }};
+    int seen{0};
+    while (seen < N) {
+        // Look at the state, then wait (as SocketHandler does): a change
+        // after the look is always followed by a wakeup.
+        seen = changes.load();
+        if (seen == N) {
+            break;
+        }
+        BOOST_REQUIRE_MESSAGE(Woken(*w, 5s), "lost wakeup at " << seen);
+        w->Drain();
+    }
+    waker.join();
+}
+
+BOOST_AUTO_TEST_CASE(loopback_pair) {
+    // The Windows path, exercised on every platform.
+    auto pair{SockWakeup::MakeLoopbackPair()};
+    BOOST_REQUIRE(pair);
+    auto &[recv, send] = *pair;
+    const uint8_t byte{7};
+    BOOST_CHECK_EQUAL(send->Send(&byte, 1, 0), 1);
+    Sock::Event occurred{0};
+    BOOST_CHECK(recv->Wait(5s, Sock::RECV, &occurred));
+    uint8_t got{0};
+    BOOST_CHECK_EQUAL(recv->Recv(&got, 1, 0), 1);
+    BOOST_CHECK_EQUAL(got, 7);
+    // Non-blocking: nothing more to read.
+    BOOST_CHECK_EQUAL(recv->Recv(&got, 1, 0), -1);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
diff --git a/src/util/sockwakeup.cpp b/src/util/sockwakeup.cpp
new file mode 100644
index 0000000000..9774f301c0
--- /dev/null
+++ b/src/util/sockwakeup.cpp
@@ -0,0 +1,98 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <util/sockwakeup.h>
+
+#include <compat/compat.h>
+
+#include <cstring>
+
+std::optional<std::pair<std::unique_ptr<Sock>, std::unique_ptr<Sock>>>
+SockWakeup::MakeLoopbackPair() {
+    const SOCKET listen_fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (listen_fd == INVALID_SOCKET) {
+        return std::nullopt;
+    }
+    Sock listener{listen_fd};
+    sockaddr_in addr;
+    std::memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr.sin_port = 0;
+    socklen_t len{sizeof(addr)};
+    if (listener.Bind(reinterpret_cast<const sockaddr *>(&addr), len) != 0 ||
+        listener.Listen(1) != 0 ||
+        listener.GetSockName(reinterpret_cast<sockaddr *>(&addr), &len) != 0) {
+        return std::nullopt;
+    }
+    const SOCKET connect_fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (connect_fd == INVALID_SOCKET) {
+        return std::nullopt;
+    }
+    auto send{std::make_unique<Sock>(connect_fd)};
+    if (send->Connect(reinterpret_cast<const sockaddr *>(&addr), len) != 0) {
+        return std::nullopt;
+    }
+    // Accept the connection, making sure it is ours: compare the peer
+    // address with the connecting socket's own.
+    sockaddr_in local, peer;
+    socklen_t local_len{sizeof(local)}, peer_len{sizeof(peer)};
+    if (send->GetSockName(reinterpret_cast<sockaddr *>(&local), &local_len) !=
+        0) {
+        return std::nullopt;
+    }
+    auto recv{listener.Accept(reinterpret_cast<sockaddr *>(&peer), &peer_len)};
+    if (!recv || peer.sin_port != local.sin_port ||
+        peer.sin_addr.s_addr != local.sin_addr.s_addr) {
+        return std::nullopt;
+    }
+    const int one{1};
+    (void)send->SetSockOpt(IPPROTO_TCP, TCP_NODELAY,
+                           reinterpret_cast<const char *>(&one), sizeof(one));
+    if (!send->SetNonBlocking() || !recv->SetNonBlocking()) {
+        return std::nullopt;
+    }
+    return std::make_pair(std::move(recv), std::move(send));
+}
+
+std::unique_ptr<SockWakeup> SockWakeup::Make() {
+#ifndef WIN32
+    int sv[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0) {
+        auto recv{std::make_unique<Sock>(SOCKET(sv[0]))};
+        auto send{std::make_unique<Sock>(SOCKET(sv[1]))};
+        if (recv->SetNonBlocking() && send->SetNonBlocking()) {
+            return std::unique_ptr<SockWakeup>{
+                new SockWakeup{std::move(recv), std::move(send)}};
+        }
+        return nullptr;
+    }
+#endif
+    auto pair{MakeLoopbackPair()};
+    if (!pair) {
+        return nullptr;
+    }
+    return std::unique_ptr<SockWakeup>{
+        new SockWakeup{std::move(pair->first), std::move(pair->second)}};
+}
+
+void SockWakeup::Wake() {
+    if (!m_pending.exchange(true)) {
+        const uint8_t byte{0};
+        // Nothing to do if this fails: the socket buffer then already holds
+        // a byte that will wake the waiter.
+        (void)m_send->Send(&byte, 1, MSG_NOSIGNAL);
+    }
+}
+
+void SockWakeup::Drain() {
+    uint8_t buf[64];
+    while (m_recv->Recv(buf, sizeof(buf), 0) > 0) {
+    }
+    // Clear the flag only now. Cleared before reading, a Wake() in between
+    // could set it and have its byte read here, after which no Wake() would
+    // write again. Cleared after, a Wake() in between at worst leaves a byte
+    // for one early return from the next wait.
+    m_pending = false;
+}
