From 070869d41312d5447ccfd5478eff154a51ffea4a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 03:46:40 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

Keep an arbitrary remote peer endpoint in the custom ECS namespace. ECS source.address denotes the sender of a network exchange, whereas our Addr field is also used for outbound peers and is not role-specific. Preserve OTel network.peer.address, which explicitly represents the remote peer.

The independent registry contract fails against the old header and passes after. All 33 logging/event cases and actual file-sink functional tests pass in the ECS validation candidate. The ECS encoder is a separate change.
---
 src/logging/fields.h             | 8 ++++----
 src/test/logging_event_tests.cpp | 5 +++--
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/src/logging/fields.h b/src/logging/fields.h
index d5f2d51bda..b2897e72de 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -29,9 +29,9 @@
  *
  * Standard names (checked against ECS 8.x and OpenTelemetry semantic
  * conventions 1.x; see doc/logging.md):
- *  - source.address: ECS "IP address of the source", any peer we talk to
- *    (ECS has no "peer" fieldset; source/destination describe the network
- *    endpoints). OTel network.peer.address is the remote address.
+ *  - Addr is a remote peer, not necessarily a network sender. ECS therefore
+ *    keeps it custom (lotus.addr) rather than claiming source.address.
+ *    OTel network.peer.address explicitly means the remote address.
  *  - network.direction: ECS values include "inbound" and "outbound".
  *  - user_agent.original: ECS and OTel.
  *  - error.message: ECS; OTel's error.message is in development status.
@@ -43,7 +43,7 @@
 #define BCLOG_FIELDS(X)                                                        \
     /* Id, generic name, type, ECS name, OTel name */                          \
     X(PeerId, peer_id, INT, "", "")                                            \
-    X(Addr, addr, STRING, "source.address", "network.peer.address")            \
+    X(Addr, addr, STRING, "", "network.peer.address")                          \
     X(Network, network, STRING, "", "")                                        \
     X(Direction, direction, STRING, "network.direction", "")                   \
     X(Transport, transport, STRING, "", "")                                    \
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 11307d1d84..4dd4f0dafd 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -241,8 +241,9 @@ BOOST_AUTO_TEST_CASE(event_field_registry) {
         BOOST_CHECK(f.otel.empty() ||
                     f.otel.find('.') != std::string_view::npos);
     }
-    BOOST_CHECK_EQUAL(BCLog::GetFieldInfo(BCLog::FieldId::Addr).ecs,
-                      "source.address");
+    BOOST_CHECK(BCLog::GetFieldInfo(BCLog::FieldId::Addr).ecs.empty());
+    BOOST_CHECK_EQUAL(BCLog::GetFieldInfo(BCLog::FieldId::Addr).otel,
+                      "network.peer.address");
     BOOST_CHECK_EQUAL(BCLog::GetFieldInfo(BCLog::FieldId::Error).ecs,
                       "error.message");
 }
