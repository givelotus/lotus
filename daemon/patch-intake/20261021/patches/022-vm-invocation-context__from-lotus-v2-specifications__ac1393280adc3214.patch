From 6ad2999f9e665780bd19fd64cce83a4c90e37f53 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:21 -0700
Subject: [PATCH] Authenticate VM invocation and add signing introspection
 subset

Review integration note (2026-10-14; newly recorded explanation):
Authenticate revealed witness bytes and branch membership before execution, then add signature and transaction-introspection operations. Resolved coins and mint deltas remain obligations of the outer transaction validator.

---
 src/lotus_v2/test_vm.cpp            | 109 +++++++++++++
 src/lotus_v2/vm.cpp                 | 230 +++++++++++++++++++++++++++-
 src/lotus_v2/vm.h                   |  20 +++
 src/lotus_v2/vm_test/CMakeLists.txt |  18 ++-
 4 files changed, 364 insertions(+), 13 deletions(-)

diff --git a/src/lotus_v2/test_vm.cpp b/src/lotus_v2/test_vm.cpp
index b79e66828..4a91597da 100644
--- a/src/lotus_v2/test_vm.cpp
+++ b/src/lotus_v2/test_vm.cpp
@@ -92,10 +92,119 @@ void HashAndBounds() {
     Expect("4e4e91", VmStatus::Invalid, {}, tiny_bytes);
     Expect("5e", VmStatus::AutomaticSuccess, {}, tiny_bytes);
 }
+void AuthenticatedPayment() {
+    const auto wire =
+        Hex("07000000000000000000000001000100"
+            "1111111111111111111111111111111111111111111111111111111111111111"
+            "00000000ffffffff0100012220f9308a019258c31049344f85f89d5229b531c845"
+            "836f99b08601f113bce036f9bb000140"
+            "170c710899dd02f994fe139b507662b88c0701019174aafa87329af0b65a9c0b84"
+            "9c421cd740417ddeb4c6f70f4c1f50609b58c00fe8e41f9955a1091d5754aa"
+            "00e80300000000000001d0c0707d9e50c9c3aedc8409e2df04bb920a3d9f669e80"
+            "a36d2f68ea1e3f0d2a010100");
+    const auto coin_wire = Hex("00d00700000000000001d0c0707d9e50c9c3aedc8409e2d"
+                               "f04bb920a3d9f669e80a36d2f68ea1e3f0d2a010100");
+    const TxProfile tx_profile{32, 32, 8, 8192, 16, 8192, 64};
+    Transaction tx;
+    Output coin;
+    std::string error;
+    CHECK(DecodeTransaction(wire, tx_profile, tx, error));
+    CHECK(DecodeOutput(coin_wire, coin, error));
+    ResolvedCoins resolved{coin};
+    ChainId chain{};
+    for (size_t i = 0; i < 32; ++i)
+        chain[i] = uint8_t(i);
+    VmExecutionContext context{tx, tx_profile, chain,       resolved,
+                               0,  0,          std::nullopt};
+    auto &witness = tx.inputs[0].witnesses[0];
+    const auto original_args = witness.arguments;
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Success);
+    auto wrong_args = witness.arguments;
+    wrong_args[0][0] ^= 1;
+    CHECK(EvaluateVmWithContext(witness.script, wrong_args, PROFILE, context)
+              .status == VmStatus::Invalid);
+    witness.arguments = wrong_args;
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Invalid);
+    witness.arguments = original_args;
+    CHECK(EvaluateVmWithContext(Hex("5e"), witness.arguments, PROFILE, context)
+              .status == VmStatus::Invalid);
+    witness.script = Hex("5e");
+    witness.siblings.clear();
+    resolved[0]->branches[0] = BranchLeaf(witness.script);
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::AutomaticSuccess);
+    witness.script = Hex("00f2e8"); // output 0 requires this branch root
+    witness.arguments.clear();
+    const auto root = BranchLeaf(witness.script);
+    resolved[0]->branches[0] = root;
+    tx.outputs[0].branches[0] = root;
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Success);
+    tx.outputs[0].branches[0].front() ^= 1;
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Invalid);
+
+    VmBytes sighash_script = Hex("00c28c10");
+    const auto thirty_two = Number(32);
+    sighash_script.insert(sighash_script.end(), thirty_two.begin(),
+                          thirty_two.end());
+    const auto finish = Hex("a68079");
+    sighash_script.insert(sighash_script.end(), finish.begin(), finish.end());
+    witness.script = sighash_script;
+    resolved[0]->branches[0] = BranchLeaf(witness.script);
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Success);
+    witness.script = Hex("50c2"); // mode 03 rejects
+    resolved[0]->branches[0] = BranchLeaf(witness.script);
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Invalid);
+
+    witness.script = Hex("b820ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb"
+                         "410ff61f20015ad91");
+    witness.arguments = {Hex("616263")};
+    resolved[0]->branches[0] = BranchLeaf(witness.script);
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Success);
+    witness.arguments = {Hex("616264")};
+    CHECK(EvaluateVmWithContext(witness.script, witness.arguments, PROFILE,
+                                context)
+              .status == VmStatus::Invalid);
+
+    Input mint;
+    mint.flags = 3;
+    mint.sequence = UINT32_MAX;
+    mint.witnesses.push_back(BranchWitness{Hex("5e"), {}, {}});
+    mint.prev_txid = BranchLeaf(mint.witnesses[0].script);
+    tx.inputs.push_back(mint);
+    resolved.push_back(std::nullopt);
+    PositiveDelta delta{};
+    delta[0] = 1;
+    VmExecutionContext mint_context{tx, tx_profile, chain, resolved,
+                                    1,  0,          delta};
+    CHECK(EvaluateVmWithContext(mint.witnesses[0].script, {}, PROFILE,
+                                mint_context)
+              .status == VmStatus::AutomaticSuccess);
+    VmProfile underfunded = PROFILE;
+    underfunded.max_vm_bytes = 15;
+    CHECK(EvaluateVmWithContext(mint.witnesses[0].script, {}, underfunded,
+                                mint_context)
+              .status == VmStatus::Invalid);
+}
 } // namespace
 int main() {
     FramingAndSuccess();
     ControlAndArithmetic();
     HashAndBounds();
+    AuthenticatedPayment();
     std::cout << "Lotus V2 VM core vectors pass\n";
 }
diff --git a/src/lotus_v2/vm.cpp b/src/lotus_v2/vm.cpp
index e7973a6b5..f970e305d 100644
--- a/src/lotus_v2/vm.cpp
+++ b/src/lotus_v2/vm.cpp
@@ -178,6 +178,7 @@ namespace {
         const VmProfile &profile;
         uint16_t input_count;
         uint16_t output_count;
+        const VmExecutionContext *context;
         std::vector<VmBytes> stack;
         std::vector<VmBytes> alternate;
         size_t bytes = 0;
@@ -208,6 +209,43 @@ namespace {
             if (++steps > profile.max_steps)
                 throw VmFailure("step bound exceeded");
         }
+        size_t Index(Int value, size_t bound) const {
+            if (value < 0 || value >= Int(bound))
+                throw VmFailure("introspection index out of range");
+            return size_t(value);
+        }
+        const VmExecutionContext &Context() const {
+            if (!context)
+                throw VmFailure("introspection needs authenticated context",
+                                true);
+            return *context;
+        }
+        const Output &CoinAt(Int index) const {
+            const auto &ctx = Context();
+            const size_t i = Index(index, ctx.tx.inputs.size());
+            if (ctx.tx.inputs[i].flags != 1 || !ctx.resolved[i])
+                throw VmFailure("UTXO read at nonspend input");
+            return *ctx.resolved[i];
+        }
+        const Output &OutputAt(Int index) const {
+            const auto &ctx = Context();
+            return ctx.tx.outputs[Index(index, ctx.tx.outputs.size())];
+        }
+        bool RequiresBranch(const Output &output, const VmBytes &root) const {
+            if (root.size() != 32 || output.IsBurn() || output.paths.empty())
+                return false;
+            for (const auto &path : output.paths) {
+                bool found = false;
+                for (const auto branch_index : path) {
+                    if (branch_index < output.branches.size() &&
+                        std::equal(root.begin(), root.end(),
+                                   output.branches[branch_index].begin()))
+                        found = true;
+                }
+                if (!found) return false;
+            }
+            return true;
+        }
         // 0=continue; positive value exits that many active loops.
         unsigned Execute(size_t begin, size_t end, unsigned active_loops) {
             for (size_t i = begin; i < end; ++i) {
@@ -405,12 +443,129 @@ namespace {
                         Push(VmBytes(node.begin(), node.end()));
                         break;
                     }
+                    case 0xc2: {
+                        const Int selected = Numeric(Pop());
+                        if (selected < 0 || selected > 2)
+                            throw VmFailure("SIGHASH mode");
+                        const auto &ctx = Context();
+                        Hash message;
+                        std::string error;
+                        if (!SigningMessage(ctx.tx, ctx.tx_profile,
+                                            ctx.chain_id, ctx.resolved,
+                                            ctx.input_index, ctx.witness_index,
+                                            uint8_t(selected),
+                                            ctx.positive_delta, message, error))
+                            throw VmFailure("SIGHASH message unavailable");
+                        Push(VmBytes(message.begin(), message.end()));
+                        break;
+                    }
+                    case 0xbb:
+                    case 0xbc: {
+                        auto key = Pop(), signature = Pop();
+                        if (!context)
+                            throw VmFailure(
+                                "CHECKSIG needs authenticated context", true);
+                        const uint8_t mode =
+                            signature.size() == 65 ? signature.back() : 0;
+                        Hash message;
+                        std::string error;
+                        if (!SigningMessage(
+                                context->tx, context->tx_profile,
+                                context->chain_id, context->resolved,
+                                context->input_index, context->witness_index,
+                                mode, context->positive_delta, message, error))
+                            throw VmFailure("CHECKSIG message unavailable");
+                        const bool mint =
+                            context->tx.inputs[context->input_index].flags == 3;
+                        const auto verified = VerifyBip340Signature(
+                            key, signature, message, mint);
+                        if (verified == SignatureStatus::InvalidEncoding ||
+                            verified == SignatureStatus::InvalidPublicKey)
+                            throw VmFailure("CHECKSIG wire encoding");
+                        const bool valid = verified == SignatureStatus::Valid;
+                        if (op == 0xbc && !valid)
+                            throw VmFailure("CHECKSIGVERIFY false");
+                        if (op == 0xbb) Push(Number(valid));
+                        break;
+                    }
                     case 0xc9:
                         Push(Number(input_count));
                         break;
                     case 0xca:
                         Push(Number(output_count));
                         break;
+                    case 0xcb: {
+                        const auto &tx = Context().tx;
+                        Push(Number(std::count_if(tx.inputs.begin(),
+                                                  tx.inputs.end(),
+                                                  [](const Input &input) {
+                                                      return input.flags == 3;
+                                                  })));
+                        break;
+                    }
+                    case 0xd0:
+                        Push(Number(Context().input_index));
+                        break;
+                    case 0xd1: {
+                        const auto &tx = Context().tx;
+                        const size_t i =
+                            Index(Numeric(Pop()), tx.inputs.size());
+                        Push(Number(tx.inputs[i].flags));
+                        break;
+                    }
+                    case 0xd6:
+                        Push(Number(CoinAt(Numeric(Pop())).value));
+                        break;
+                    case 0xd7: {
+                        const auto &coin = CoinAt(Numeric(Pop()));
+                        Push(coin.HasToken() ? VmBytes(coin.token_id.begin(),
+                                                       coin.token_id.end())
+                                             : VmBytes(32));
+                        break;
+                    }
+                    case 0xdd: {
+                        auto root = Pop();
+                        const auto &coin = CoinAt(Numeric(Pop()));
+                        Push(Number(RequiresBranch(coin, root)));
+                        break;
+                    }
+                    case 0xe0:
+                        Push(Number(OutputAt(Numeric(Pop())).flags));
+                        break;
+                    case 0xe1:
+                        Push(Number(OutputAt(Numeric(Pop())).value));
+                        break;
+                    case 0xe2: {
+                        const auto &output = OutputAt(Numeric(Pop()));
+                        Push(output.HasToken()
+                                 ? VmBytes(output.token_id.begin(),
+                                           output.token_id.end())
+                                 : VmBytes(32));
+                        break;
+                    }
+                    case 0xe8: {
+                        auto root = Pop();
+                        const auto &output = OutputAt(Numeric(Pop()));
+                        Push(Number(RequiresBranch(output, root)));
+                        break;
+                    }
+                    case 0xf1:
+                        Push(Number(
+                            Context().tx.inputs[Context().input_index].flags));
+                        break;
+                    case 0xf2: {
+                        const auto &ctx = Context();
+                        const auto &input = ctx.tx.inputs[ctx.input_index];
+                        const Hash &root =
+                            input.flags == 3
+                                ? input.prev_txid
+                                : ctx.resolved[ctx.input_index]->branches
+                                      [ctx.resolved[ctx.input_index]
+                                           ->paths[input.path_index]
+                                                  [ctx.witness_index]];
+                        Push(VmBytes(root.begin(), root.end()));
+                        break;
+                    }
                     default:
                         throw VmFailure("assigned opcode not implemented",
                                         true);
