From 223d57e7704a62128beaec7348b39f07ea5e3f5e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:21:27 -0700
Subject: [PATCH] fixup! logging: add reproducible reviewed C++ AST conversion
 tool

Accept the standard C++ escaped apostrophe in ordinary format literals, preserving backslash parity and rejecting unsupported escapes. The prior JSON-only decoder rejected existing validation diagnostics before reviewed AST mapping. Exact new regression fails the old decoder; all18 converter tests including catalog mappings pass. No production C++ or registry changes. Commands: /private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/test_convert.py
---
 contrib/logging/conversion/convert.py      | 15 ++++++++++++++-
 contrib/logging/conversion/test_convert.py | 22 ++++++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/contrib/logging/conversion/convert.py b/contrib/logging/conversion/convert.py
index a5d2fa73652e3fe4188e4bd410be79b5888e82c8..59ef01fbf6c3c20764bfd76c3d125374831b9466 100755
--- a/contrib/logging/conversion/convert.py
+++ b/contrib/logging/conversion/convert.py
@@ -75,8 +75,21 @@ def literal(node):
         return "".join(literal(c) for c in node.named_children())
     if node.kind() != "string_literal" or not node.text().startswith('"'):
         raise ValueError("dynamic, raw, prefixed or concatenated format")
+    # Normalize the one standard C++ escape JSON lacks, tracking pairs so an
+    # escaped backslash before an apostrophe keeps its original meaning.
+    raw = node.text()
+    normalized = []
+    index = 0
+    while index < len(raw):
+        if raw[index] == "\\" and index + 1 < len(raw):
+            following = raw[index + 1]
+            normalized.append("'" if following == "'" else raw[index:index + 2])
+            index += 2
+        else:
+            normalized.append(raw[index])
+            index += 1
     try:
-        return json.loads(node.text())
+        return json.loads("".join(normalized))
     except (ValueError, TypeError):
         raise ValueError("unsupported C++ literal escape") from None
 
diff --git a/contrib/logging/conversion/test_convert.py b/contrib/logging/conversion/test_convert.py
index 72fd0e126e9cfe6d3ede8edd6472c448c1e48bf0..c428082e368e498783037e1b1737c4957c177a9a 100755
--- a/contrib/logging/conversion/test_convert.py
+++ b/contrib/logging/conversion/test_convert.py
@@ -41,6 +41,28 @@ class ConversionTest(unittest.TestCase):
         self.assertEqual(description["format"], "foo=%% value=%08.2f\n")
         self.assertEqual(description["specifiers"], ["%08.2f"])
 
+    def test_cpp_apostrophe_escape_and_backslash_parity(self):
+        # Standard C++ allows escaped apostrophes even inside a double-quoted
+        # literal. Preserve escaped backslashes and normal JSON-compatible
+        # escapes; never strip a backslash based on a raw regex replacement.
+        for run in range(1, 6):
+            raw = "\\" * run + "'"
+            expression = 'LogPrintf("value=' + raw + '\\n")'
+            node = convert.calls(expression, convert.LEGACY)[0]
+            expected = "value=" + "\\" * (run // 2) + "'\n"
+            self.assertEqual(convert.describe(node)["format"], expected)
+        old = r'LogPrintf("Missing input %d in transaction \'%s\'\n", i, label)'
+        new = ('LogInfoEvent(BCLog::ALL,"missing_input",'
+               '"Missing input {count} in transaction \'{name}\'")'
+               '.Field(BCLog::LogField::Count,i)'
+               '.Field(BCLog::LogField::Name,label)')
+        after, _ = convert.convert(old, [rule(old, new)])
+        self.assertEqual(after, new)
+        self.assertEqual(convert.convert(after, [rule(old, new)])[0], after)
+        for escape in (r"\a", r"\v", r"\x27", r"\047", r"\?"):
+            with self.assertRaises(ValueError):
+                convert.describe(convert.calls('LogPrintf("' + escape + '")', convert.LEGACY)[0])
+
     def test_unsupported_formats_are_rejected(self):
         for expression in [
             "LogPrintf(fmt, x)",
