+    const std::string down(up.rbegin(), up.rend());
+    size_t queued{0};
+    std::string got;
+    uint8_t buf[65536];
+    for (int i = 0; i < 100000; ++i) {
+        if (queued < down.size() &&
+            srv.server.session.TunnelQueued(id) < 200000) {
+            const size_t n{std::min<size_t>(100000, down.size() - queued)};
+            srv.server.session.TunnelSend(
