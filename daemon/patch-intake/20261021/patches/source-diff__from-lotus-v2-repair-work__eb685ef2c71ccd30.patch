+{
+  "schema": 1,
+  "batch": "database-wrapper-lifecycle",
+  "review_note": "Shared database lifecycle and existing public obfuscation diagnostics; requires copied-byte LogHex API. No consensus, migration behavior or level changes. External LevelDB Logv continuation remains infrastructure, reviewed separately.",
+  "files": [
+    {
+      "path": "src/dbwrapper.cpp",
+      "rules": [
+        {
+          "id": "database_fatal_error",
+          "old": "LogPrintf(\"%s\\n\", errmsg)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"database_fatal_error\", \"{error}\").Field(BCLog::LogField::Error, errmsg)",
+          "count": 2,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "%s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "errmsg"
+            ]
+          },
+          "review_note": "Preserve exact original message, level/category, argument evaluation order and control flow. Keep both fatal diagnostics Info as before; Error retains already formatted backend context. Max-open-file limits stay signed. DB basename is Name, full paths are Path. Existing public XOR obfuscation bytes (not wallet/private encryption keys) are copied via LogHex and formatted only by the consumer; no new diagnostic disclosure. Existing LevelDB migration compatibility is unchanged."
+        },
