From 222f3c252a4686a177ff98b18d5136ba957f438f Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 19 Oct 2026 15:59:00 -0700
Subject: [PATCH] fixup! chain: give Lotus V2 its own data directory, ports and
 network identity

Refresh only the three deterministic snapshot vectors for the current C17a coin provenance encoding. Two fresh generation runs and an independent 100-block wire replay produce identical hashes and snapshot bytes. The unchanged standard rpc_dumptxoutset test fails before and passes after; no consensus or assertion changes.
---
 test/functional/rpc_dumptxoutset.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/test/functional/rpc_dumptxoutset.py b/test/functional/rpc_dumptxoutset.py
index bdb9376e0b..b44052e4cb 100644
--- a/test/functional/rpc_dumptxoutset.py
+++ b/test/functional/rpc_dumptxoutset.py
@@ -34,7 +34,7 @@ class DumptxoutsetTest(BitcoinTestFramework):
         # Blockhash should be deterministic based on mocked time.
         assert_equal(
             out["base_hash"],
-            "7f39db7f1bcd635e77e4cc515d7740ffd83682a95bd98d31481eb07bcefcb8f5",
+            "6b5c9c9712708ffd25e654e5abb35061dfbc37623d3940b34153293d645bde34",
         )
 
         with open(str(expected_path), "rb") as f:
@@ -42,12 +42,12 @@ class DumptxoutsetTest(BitcoinTestFramework):
             # UTXO snapshot hash should be deterministic based on mocked time.
             assert_equal(
                 digest,
-                "cfe64ce3e3de8f268bf9c6e57cf20dc143f63ae272ad8b684e8050d7e7166974",
+                "b1df6241f2f84a1b904cdf3fbc548d2120f948557e7bc658e1a735a4a46bfd51",
             )
 
         assert_equal(
             out["txoutset_hash"],
-            "410d4da0704092677bf3a476b39b3c5bd6ec12249d5d1376a90b92108b2e865b",
+            "f77d4da77d2e2935a1555ce3b455f041ff3b82fb7add5fac62f00ca6bb1e3736",
         )
         assert_equal(out["nchaintx"], 101)
 
