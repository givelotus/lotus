From cedf89cf83f94c3f98d288fb5a727c7ec801fed5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 00:11:21 -0700
Subject: [PATCH] fixup! net: wire concrete Merklix peer handling and
 transaction relay

Do not hash transaction roots for list-only bucket drill-down. Keep summary and diff roots computed from exactly their original normalized transaction list, once rather than twice. The optional private root output retains the existing root path for callers that request it. No reconciliation membership, wire formats or policy changes. Source-confirmed CPU-profile follow-up, with runtime and causal A/B pending separately from lazy snapshot publication.
---
 src/net/v2_protocol_handler.cpp | 34 +++++++++++++++++++++------------
 src/net/v2_protocol_handler.h   |  2 +-
 2 files changed, 23 insertions(+), 13 deletions(-)

diff --git a/src/net/v2_protocol_handler.cpp b/src/net/v2_protocol_handler.cpp
index dcf0aedd2b..4c36555b5b 100644
--- a/src/net/v2_protocol_handler.cpp
+++ b/src/net/v2_protocol_handler.cpp
@@ -869,13 +869,15 @@ void V2PeerProtocolHandler::SetScopedTransactions(
 
 void V2PeerProtocolHandler::GetScopedTransactionsAndRoot(
     ReconScope scope, const uint256 &context_id,
-    std::vector<CTransactionRef> &out_txs, uint256 &out_root) const {
+    std::vector<CTransactionRef> &out_txs, uint256 *out_root) const {
     {
         LOCK(m_mutex);
         auto it = m_scoped_txs.find(ScopeKey{scope, context_id});
         if (it != m_scoped_txs.end()) {
             out_txs = it->second.txs;
-            std::memcpy(out_root.begin(), it->second.subtree_a_root.data(), 32);
+            if (out_root) {
+                std::memcpy(out_root->begin(), it->second.subtree_a_root.data(), 32);
+            }
             return;
         }
     }
@@ -885,8 +887,10 @@ void V2PeerProtocolHandler::GetScopedTransactionsAndRoot(
         // reconciliation window, not the whole mempool.
         if (auto window{m_relay_epochs->RelayReconSet(context_id)}) {
             out_txs = NormalizeCtorTxList(*window);
-            const lotus::v2::Hash root = ComputeSubtreeAHash(out_txs);
-            std::memcpy(out_root.begin(), root.data(), 32);
+            if (out_root) {
+                const lotus::v2::Hash root = ComputeSubtreeAHash(out_txs);
+                std::memcpy(out_root->begin(), root.data(), 32);
+            }
             return;
         }
     }
@@ -908,8 +912,10 @@ void V2PeerProtocolHandler::GetScopedTransactionsAndRoot(
                     }
                 }
                 if (out_txs.size() == m_mempool.mapTx.size()) {
-                    const lotus::v2::Hash root = layer.GetSubtreeARoot();
-                    std::memcpy(out_root.begin(), root.data(), 32);
+                    if (out_root) {
+                        const lotus::v2::Hash root = layer.GetSubtreeARoot();
+                        std::memcpy(out_root->begin(), root.data(), 32);
+                    }
                     return;
                 }
             }
@@ -919,20 +925,24 @@ void V2PeerProtocolHandler::GetScopedTransactionsAndRoot(
             }
         }
         out_txs = NormalizeCtorTxList(mempool_txs);
-        const lotus::v2::Hash root = ComputeSubtreeAHash(out_txs);
-        std::memcpy(out_root.begin(), root.data(), 32);
+        if (out_root) {
+            const lotus::v2::Hash root = ComputeSubtreeAHash(out_txs);
+            std::memcpy(out_root->begin(), root.data(), 32);
+        }
         return;
     }
     out_txs.clear();
-    const lotus::v2::Hash empty_root = lotus::v2::EmptyTxRoot();
-    std::memcpy(out_root.begin(), empty_root.data(), 32);
+    if (out_root) {
+        const lotus::v2::Hash empty_root = lotus::v2::EmptyTxRoot();
+        std::memcpy(out_root->begin(), empty_root.data(), 32);
+    }
 }
 
 std::vector<CTransactionRef> V2PeerProtocolHandler::GetScopedTransactions(
     ReconScope scope, const uint256 &context_id) const {
     std::vector<CTransactionRef> txs;
-    uint256 unused_root{};
-    GetScopedTransactionsAndRoot(scope, context_id, txs, unused_root);
+    // Bucket drill-down needs membership only, not a Merklix root.
+    GetScopedTransactionsAndRoot(scope, context_id, txs, nullptr);
     return txs;
 }
 
diff --git a/src/net/v2_protocol_handler.h b/src/net/v2_protocol_handler.h
index 7285e4df28..95d27f46bc 100644
--- a/src/net/v2_protocol_handler.h
+++ b/src/net/v2_protocol_handler.h
@@ -786,7 +786,7 @@ private:
     void GetScopedTransactionsAndRoot(ReconScope scope,
                                       const uint256 &context_id,
                                       std::vector<CTransactionRef> &out_txs,
-                                      uint256 &out_root) const
+                                      uint256 *out_root) const
         EXCLUSIVE_LOCKS_REQUIRED(!m_mutex);
     bool SendRawPayloadToPeerLocked(NodeId peer_id, const char *msg_type,
                                     Span<const uint8_t> payload)
