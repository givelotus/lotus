From ed88266888c4026ec329d51461d872f0900ab62e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:58:50 -0700
Subject: [PATCH] Preserve Dogecoin aggregate block fees above the transaction
 money limit

Dogecoin Core 47a303a449999314abcf83bd1fc7e77dd4540fcd ConnectBlock accumulates individual transaction fees without imposing MAX_MONEY on their sum. Remove the inherited ABC aggregate cap, which rejects valid blocks with more than ten billion DOGE in total fees.

Use Amount::SaturatingAdd for fees and subsidy addition to avoid signed overflow. Each valid coinbase remains bounded by MAX_MONEY, below the representable Amount maximum, so saturation preserves the mathematical reward comparison. Optional blockFees accounting saturates above int64 range; no exact aggregate accounting is claimed there. Core uses unchecked signed addition, so behavior beyond int64 is undefined and equivalence at that edge is not claimed.

diff --git a/src/validation.cpp b/src/validation.cpp
index 96f5d83695b93b6a93cd478a31612f692affbdad..8b043e7d3563255a39ca6b6e991b7ea334e75dbd 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -2433,7 +2433,10 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
                                   tx.GetId().ToString());
                 break;
             }
-            nFees += txfee;
+            // Aggregate fees are not subject to the per-transaction MAX_MONEY
+            // cap. Saturation avoids signed overflow; a valid coinbase cannot
+            // exceed MAX_MONEY, well below the representable Amount maximum.
+            nFees.SaturatingAdd(txfee);
         }
 
         // CountTxSigOps counts 2 types of sigops:
@@ -2448,13 +2451,6 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
             return false;
         }
 
-        if (!MoneyRange(nFees)) {
-            state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
-                          "bad-txns-accumulated-fee-outofrange",
-                          "accumulated fee in the block out of range");
-            break;
-        }
-
         // The following checks do not apply to the coinbase.
         if (isCoinBase) {
             if (!canonicalOrdering) {
@@ -2537,8 +2533,9 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
              Ticks<MillisecondsDouble>(m_chainman.time_connect) /
                  m_chainman.num_blocks_total);
 
-    const Amount blockReward =
-        nFees + GetBlockSubsidy(pindex->nHeight, consensusParams, pindex->pprev->GetBlockHash());
+    Amount blockReward = nFees;
+    blockReward.SaturatingAdd(GetBlockSubsidy(
+        pindex->nHeight, consensusParams, pindex->pprev->GetBlockHash()));
     if (block.vtx[0]->GetValueOut() > blockReward && state.IsValid()) {
         state.Invalid(
             BlockValidationResult::BLOCK_CONSENSUS, "bad-cb-amount",
