From ee53dfb8a100e78128e0bc24c90007c1e53bc287 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 19:02:20 -0700
Subject: [PATCH 45/46] chronik: native UTXO output entries use the V2 postcard
 layout

On Lotus V2 the Rust Chronik stores the duplicate entries of groups whose
UTXO data is the full output (token_id_utxo, lokad_id_utxo, txid_utxo) in
the default postcard layout: v2/026 "chronik(v2): isolate MDBX access and
persist branch, asset and explorer indexes" removed the compact eCash
UtxoDataOutput encoding of ecash/007 (sats LE8 || raw script), so an entry
is now tx_num BE8 || out_idx BE4 || postcard (i64 zigzag varint, Bytes).
It also reports every payload failure as postcard DeserializeBadEncoding
over the payload bytes. The native Chronik still wrote and read the eCash
layout, so its V2 DB differed from Rust's byte for byte.

Follow v2/026: EncodeUtxoDup/DecodeUtxoDup use the postcard payload for
output data (value-only entries keep their fixed sats LE8) and report
payload errors like Rust ("The original data was not well encoded", the
payload bytes). Regenerated with cargo test -p chronik-db --test
export_native_db_values on this tree, test/fixtures/db_values.json
changes only its four UtxoDupOutput vectors; the codec.json export is
unchanged. The token-id and group-UTXO tests expect the V2 layout.

Tier: V2
---
 chronik/native/core/index/group_utxos.cpp     | 38 ++++++++++++++-----
 .../include/chronik/native/codec/postcard.h   |  2 +
 chronik/native/test/fixtures/db_values.json   |  8 ++--
 chronik/native/test/groups_token_id_tests.cpp | 18 ++++-----
 .../native/test/index_group_utxos_tests.cpp   | 26 +++++++------
 5 files changed, 57 insertions(+), 35 deletions(-)

diff --git a/chronik/native/core/index/group_utxos.cpp b/chronik/native/core/index/group_utxos.cpp
index 49960f280a..21f75ea052 100644
--- a/chronik/native/core/index/group_utxos.cpp
+++ b/chronik/native/core/index/group_utxos.cpp
@@ -109,9 +109,14 @@ Bytes EncodeUtxoDup(UtxoDataKind kind, const UtxoEntry &entry) {
     buf.reserve(UtxoFixedDupSize(kind).value_or(48));
     PutBe<uint64_t>(buf, entry.outpoint.tx_num);
     PutBe<uint32_t>(buf, entry.outpoint.out_idx);
-    PutLe<int64_t>(buf, entry.sats);
-    if (kind == UtxoDataKind::Output) {
-        Append(buf, entry.script);
+    if (kind == UtxoDataKind::Value) {
+        PutLe<int64_t>(buf, entry.sats);
+    } else {
+        // Lotus V2 (v2/026): UtxoDataOutput keeps the default postcard
+        // payload, (i64 zigzag varint, Bytes length-prefixed).
+        postcard::Writer w(buf);
+        w.I64(entry.sats);
+        w.ByteVec(entry.script);
     }
     return buf;
 }
@@ -125,15 +130,28 @@ UtxoEntry DecodeUtxoDup(UtxoDataKind kind, ByteView bytes) {
     entry.outpoint.tx_num = FromBe<uint64_t>(bytes.subspan(0, 8));
     entry.outpoint.out_idx = FromBe<uint32_t>(bytes.subspan(8, 4));
     const ByteView data = bytes.subspan(12);
-    const bool ok = kind == UtxoDataKind::Value ? data.size() == 8
-                                                : data.size() >= 8;
-    if (!ok) {
+    // Lotus V2 (v2/026): any payload failure is reported as postcard's
+    // DeserializeBadEncoding over the payload bytes.
+    const auto bad = [&] {
         postcard::ThrowDeserializeError(DataTypeName(kind),
-                                        postcard::kUnexpectedEnd, bytes);
+                                        postcard::kBadEncoding, data);
+    };
+    if (kind == UtxoDataKind::Value) {
+        if (data.size() != 8) {
+            bad();
+        }
+        entry.sats = FromLe<int64_t>(data);
+        return entry;
     }
-    entry.sats = FromLe<int64_t>(data.subspan(0, 8));
-    if (kind == UtxoDataKind::Output) {
-        entry.script.assign(data.begin() + 8, data.end());
+    postcard::Reader r(data);
+    try {
+        entry.sats = r.I64();
+        entry.script = r.ByteVec();
+    } catch (const postcard::Error &) {
+        bad();
+    }
+    if (!r.AtEnd()) {
+        bad();
     }
     return entry;
 }
diff --git a/chronik/native/include/chronik/native/codec/postcard.h b/chronik/native/include/chronik/native/codec/postcard.h
index a26fe5f00b..60a44b4706 100644
--- a/chronik/native/include/chronik/native/codec/postcard.h
+++ b/chronik/native/include/chronik/native/codec/postcard.h
@@ -49,6 +49,8 @@ inline constexpr std::string_view kBadOption =
     "Found an Option discriminant that wasn't 0 or 1";
 inline constexpr std::string_view kBadEnum =
     "Found an enum discriminant that was > u32::max_value()";
+inline constexpr std::string_view kBadEncoding =
+    "The original data was not well encoded";
 /** Used for an out-of-range enum variant (serde "unknown variant"). */
 inline constexpr std::string_view kSerdeDeCustom =
     "Serde Deserialization Error";
