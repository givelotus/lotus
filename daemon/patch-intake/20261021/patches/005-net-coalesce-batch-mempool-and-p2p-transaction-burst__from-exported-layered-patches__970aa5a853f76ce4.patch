diff --git a/src/lotus_v2/fee_hysteresis.cpp b/src/lotus_v2/fee_hysteresis.cpp
new file mode 100644
index 0000000000..e159207d49
--- /dev/null
+++ b/src/lotus_v2/fee_hysteresis.cpp
@@ -0,0 +1,189 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include "fee_hysteresis.h"
+
+#include <algorithm>
+#include <limits>
+
+namespace lotus::v2 {
+
+namespace {
+using UInt128 = unsigned __int128;
+
+uint64_t ClampU128ToU64(UInt128 v) noexcept {
+    if (v > UInt128(std::numeric_limits<uint64_t>::max())) {
+        return std::numeric_limits<uint64_t>::max();
+    }
+    return static_cast<uint64_t>(v);
+}
+} // namespace
+
+FeeHysteresisController::FeeHysteresisController(FeeHysteresisConfig config)
+    : config_(config),
+      current_rpc_rate_per_kcu_(std::max<uint64_t>(
+          1, config.consensus_floor_per_kcu)) {
+    config_.consensus_floor_per_kcu = current_rpc_rate_per_kcu_;
+    if (config_.hysteresis_window_ms < 0) {
+        config_.hysteresis_window_ms = 0;
+    }
+    if (config_.hysteresis_discount_permille > 1000) {
+        config_.hysteresis_discount_permille = 1000;
+    }
+    samples_.push_back(RateSample{0, current_rpc_rate_per_kcu_});
+}
+
+uint64_t FeeHysteresisController::GetConsensusFloorPerKCu() const noexcept {
+    return config_.consensus_floor_per_kcu;
+}
+
+void FeeHysteresisController::PruneLocked(int64_t now_ms) const {
+    const int64_t cutoff_ms = now_ms - config_.hysteresis_window_ms;
+    while (!samples_.empty() && samples_.front().timestamp_ms < cutoff_ms) {
+        samples_.pop_front();
+    }
+}
+
+uint64_t FeeHysteresisController::RollingMinRpcRateLocked(int64_t now_ms) const {
+    PruneLocked(now_ms);
+    uint64_t min_rate = current_rpc_rate_per_kcu_;
+    for (const auto &s : samples_) {
+        if (s.timestamp_ms <= now_ms) {
+            min_rate = std::min(min_rate, s.rpc_rate_per_kcu);
+        }
+    }
+    return std::max(config_.consensus_floor_per_kcu, min_rate);
+}
+
+uint64_t FeeHysteresisController::GetRpcAdmissionRatePerKCu(
+    int64_t now_ms) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    PruneLocked(now_ms);
+    return current_rpc_rate_per_kcu_;
+}
+
+uint64_t FeeHysteresisController::GetRecommendedSdkRatePerKCu(
+    int64_t now_ms) const {
+    const uint64_t rpc_rate = GetRpcAdmissionRatePerKCu(now_ms);
+    const UInt128 num =
+        UInt128(rpc_rate) * UInt128(1000 + config_.sdk_cushion_permille);
+    return ClampU128ToU64((num + 999) / 1000);
+}
+
+uint64_t FeeHysteresisController::GetP2pRelayRatePerKCu(int64_t now_ms) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const uint64_t min_rpc = RollingMinRpcRateLocked(now_ms);
+    const uint64_t keep_permille = 1000 - config_.hysteresis_discount_permille;
+    const uint64_t discounted = static_cast<uint64_t>(
+        (UInt128(min_rpc) * UInt128(keep_permille)) / 1000);
+    return std::max(config_.consensus_floor_per_kcu, discounted);
+}
+
+FeeRateInfo FeeHysteresisController::GetFeeRateInfo(int64_t now_ms) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const uint64_t rpc_rate = current_rpc_rate_per_kcu_;
+    const uint64_t min_rpc = RollingMinRpcRateLocked(now_ms);
+    const uint64_t keep_permille = 1000 - config_.hysteresis_discount_permille;
+    const uint64_t discounted = static_cast<uint64_t>(
+        (UInt128(min_rpc) * UInt128(keep_permille)) / 1000);
+    const uint64_t p2p_rate =
+        std::max(config_.consensus_floor_per_kcu, discounted);
+    const UInt128 sdk_num =
+        UInt128(rpc_rate) * UInt128(1000 + config_.sdk_cushion_permille);
+    const uint64_t sdk_rate = ClampU128ToU64((sdk_num + 999) / 1000);
+
+    return FeeRateInfo{
+        .consensus_floor_per_kcu = config_.consensus_floor_per_kcu,
+        .p2p_relay_feerate_per_kcu = p2p_rate,
+        .rpc_admission_feerate_per_kcu = rpc_rate,
+        .recommended_sdk_feerate_per_kcu = sdk_rate,
+        .hysteresis_window_ms = config_.hysteresis_window_ms,
+        .hysteresis_discount_permille = config_.hysteresis_discount_permille,
+    };
+}
+
+void FeeHysteresisController::SetRpcAdmissionRatePerKCu(
+    uint64_t rpc_rate_per_kcu, int64_t now_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const uint64_t clamped =
+        std::max(config_.consensus_floor_per_kcu, rpc_rate_per_kcu);
+    current_rpc_rate_per_kcu_ = clamped;
+    PruneLocked(now_ms);
+    if (!samples_.empty() && samples_.back().timestamp_ms == now_ms) {
+        samples_.back().rpc_rate_per_kcu = clamped;
+    } else {
+        samples_.push_back(RateSample{now_ms, clamped});
+    }
+}
+
+uint64_t FeeHysteresisController::UpdateCongestion(uint64_t active_utilization,
+                                                   uint64_t target_capacity,
+                                                   int64_t now_ms) {
+    const uint64_t target =
+        target_capacity > 0 ? target_capacity : config_.target_utilization_cu;
+    uint64_t next_rate = config_.consensus_floor_per_kcu;
+    if (target > 0 && active_utilization > target) {
+        const UInt128 excess = UInt128(active_utilization - target);
+        const UInt128 floor = UInt128(config_.consensus_floor_per_kcu);
+        const UInt128 linear_term = (floor * excess) / UInt128(target);
+        const UInt128 quad_term =
+            (floor * excess * excess) / (UInt128(target) * UInt128(target));
+        next_rate = ClampU128ToU64(floor + linear_term + quad_term);
+    }
+    SetRpcAdmissionRatePerKCu(next_rate, now_ms);
+    return next_rate;
+}
+
+void FeeHysteresisController::Reset(int64_t now_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    samples_.clear();
+    current_rpc_rate_per_kcu_ = config_.consensus_floor_per_kcu;
+    samples_.push_back(RateSample{now_ms, current_rpc_rate_per_kcu_});
+}
+
+uint64_t FeeHysteresisController::ComputeFeeForCu(
+    uint64_t tx_cu, uint64_t rate_per_kcu) noexcept {
+    if (tx_cu == 0 || rate_per_kcu == 0) {
+        return 0;
+    }
+    const UInt128 prod = UInt128(tx_cu) * UInt128(rate_per_kcu);
+    return ClampU128ToU64((prod + 999) / 1000);
+}
+
+FeeCheckResult FeeHysteresisController::EvaluateTransactionFee(
+    FeeTier tier, uint64_t tx_cu, uint64_t paid_fee_sats,
+    int64_t now_ms) const {
+    const FeeRateInfo info = GetFeeRateInfo(now_ms);
+    uint64_t required_rate = info.consensus_floor_per_kcu;
+    switch (tier) {
+        case FeeTier::RpcAdmission:
+            required_rate = info.rpc_admission_feerate_per_kcu;
+            break;
+        case FeeTier::P2pRelay:
+            required_rate = info.p2p_relay_feerate_per_kcu;
+            break;
+        case FeeTier::ConsensusFloor:
+            required_rate = info.consensus_floor_per_kcu;
+            break;
+    }
+    const uint64_t required_fee = ComputeFeeForCu(tx_cu, required_rate);
+    const uint64_t recommended_sdk_fee =
+        ComputeFeeForCu(tx_cu, info.recommended_sdk_feerate_per_kcu);
+    return FeeCheckResult{
+        .accepted = paid_fee_sats >= required_fee,
+        .tier = tier,
+        .tx_cu = tx_cu,
+        .paid_fee_sats = paid_fee_sats,
+        .required_fee_sats = required_fee,
+        .required_rate_per_kcu = required_rate,
+        .recommended_sdk_fee_sats = std::max(required_fee, recommended_sdk_fee),
+    };
+}
+
+FeeHysteresisController &GetGlobalFeeHysteresisController() {
+    static FeeHysteresisController instance{};
+    return instance;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/fee_hysteresis.h b/src/lotus_v2/fee_hysteresis.h
new file mode 100644
index 0000000000..93da9a5b0e
--- /dev/null
+++ b/src/lotus_v2/fee_hysteresis.h
@@ -0,0 +1,96 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef LOTUS_V2_FEE_HYSTERESIS_H
+#define LOTUS_V2_FEE_HYSTERESIS_H
+
+#include <cstdint>
+#include <deque>
+#include <mutex>
+
+namespace lotus::v2 {
+
+enum class FeeTier : uint8_t {
+    RpcAdmission = 1,
+    P2pRelay = 2,
+    ConsensusFloor = 3,
+};
+
+constexpr uint64_t DEFAULT_CONSENSUS_FLOOR_PER_KCU = 1000;
+constexpr int64_t DEFAULT_HYSTERESIS_WINDOW_MS = 30000;
+constexpr uint64_t DEFAULT_HYSTERESIS_DISCOUNT_PERMILLE = 150;
+constexpr uint64_t DEFAULT_SDK_CUSHION_PERMILLE = 50;
+constexpr uint64_t DEFAULT_TARGET_UTILIZATION_CU = 25'000'000;
+
+struct FeeHysteresisConfig {
+    uint64_t consensus_floor_per_kcu = DEFAULT_CONSENSUS_FLOOR_PER_KCU;
+    int64_t hysteresis_window_ms = DEFAULT_HYSTERESIS_WINDOW_MS;
+    uint64_t hysteresis_discount_permille = DEFAULT_HYSTERESIS_DISCOUNT_PERMILLE;
+    uint64_t sdk_cushion_permille = DEFAULT_SDK_CUSHION_PERMILLE;
+    uint64_t target_utilization_cu = DEFAULT_TARGET_UTILIZATION_CU;
+};
+
+struct FeeRateInfo {
+    uint64_t consensus_floor_per_kcu = DEFAULT_CONSENSUS_FLOOR_PER_KCU;
+    uint64_t p2p_relay_feerate_per_kcu = DEFAULT_CONSENSUS_FLOOR_PER_KCU;
+    uint64_t rpc_admission_feerate_per_kcu = DEFAULT_CONSENSUS_FLOOR_PER_KCU;
+    uint64_t recommended_sdk_feerate_per_kcu = 1050;
+    int64_t hysteresis_window_ms = DEFAULT_HYSTERESIS_WINDOW_MS;
+    uint64_t hysteresis_discount_permille = DEFAULT_HYSTERESIS_DISCOUNT_PERMILLE;
+};
+
+struct FeeCheckResult {
+    bool accepted = false;
+    FeeTier tier = FeeTier::RpcAdmission;
+    uint64_t tx_cu = 0;
+    uint64_t paid_fee_sats = 0;
+    uint64_t required_fee_sats = 0;
+    uint64_t required_rate_per_kcu = 0;
+    uint64_t recommended_sdk_fee_sats = 0;
+};
+
+class FeeHysteresisController {
+public:
+    explicit FeeHysteresisController(
+        FeeHysteresisConfig config = FeeHysteresisConfig{});
+
+    uint64_t GetConsensusFloorPerKCu() const noexcept;
+    uint64_t GetRpcAdmissionRatePerKCu(int64_t now_ms) const;
+    uint64_t GetRecommendedSdkRatePerKCu(int64_t now_ms) const;
+    uint64_t GetP2pRelayRatePerKCu(int64_t now_ms) const;
+
+    FeeRateInfo GetFeeRateInfo(int64_t now_ms) const;
+
+    uint64_t UpdateCongestion(uint64_t active_utilization,
+                              uint64_t target_capacity, int64_t now_ms);
+    void SetRpcAdmissionRatePerKCu(uint64_t rpc_rate_per_kcu, int64_t now_ms);
+    void Reset(int64_t now_ms = 0);
+
+    FeeCheckResult EvaluateTransactionFee(FeeTier tier, uint64_t tx_cu,
+                                          uint64_t paid_fee_sats,
+                                          int64_t now_ms) const;
+
+    static uint64_t ComputeFeeForCu(uint64_t tx_cu,
+                                    uint64_t rate_per_kcu) noexcept;
+
+private:
+    struct RateSample {
+        int64_t timestamp_ms = 0;
+        uint64_t rpc_rate_per_kcu = DEFAULT_CONSENSUS_FLOOR_PER_KCU;
+    };
+
+    void PruneLocked(int64_t now_ms) const;
+    uint64_t RollingMinRpcRateLocked(int64_t now_ms) const;
+
+    FeeHysteresisConfig config_;
+    mutable std::mutex mutex_;
+    mutable std::deque<RateSample> samples_;
+    uint64_t current_rpc_rate_per_kcu_ = DEFAULT_CONSENSUS_FLOOR_PER_KCU;
+};
+
+FeeHysteresisController &GetGlobalFeeHysteresisController();
+
+} // namespace lotus::v2
+
+#endif // LOTUS_V2_FEE_HYSTERESIS_H
diff --git a/src/lotus_v2/set_reconciliation.cpp b/src/lotus_v2/set_reconciliation.cpp
new file mode 100644
index 0000000000..299c9d69d3
--- /dev/null
+++ b/src/lotus_v2/set_reconciliation.cpp
@@ -0,0 +1,230 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include "set_reconciliation.h"
+
+#include "tagged_hash.h"
+
+#include <array>
+#include <cassert>
+#include <cstring>
+
+namespace lotus::v2 {
+
+namespace {
+
+constexpr uint64_t RotL64(uint64_t x, int b) noexcept {
+    return (x << b) | (x >> (64 - b));
+}
+
+constexpr uint64_t ReadLE64(const uint8_t *p) noexcept {
+    return uint64_t(p[0]) | (uint64_t(p[1]) << 8) | (uint64_t(p[2]) << 16) |
+           (uint64_t(p[3]) << 24) | (uint64_t(p[4]) << 32) |
+           (uint64_t(p[5]) << 40) | (uint64_t(p[6]) << 48) |
+           (uint64_t(p[7]) << 56);
+}
+
+constexpr void SipRound(uint64_t &v0, uint64_t &v1, uint64_t &v2,
+                        uint64_t &v3) noexcept {
+    v0 += v1;
+    v1 = RotL64(v1, 13);
+    v1 ^= v0;
+    v0 = RotL64(v0, 32);
+    v2 += v3;
+    v3 = RotL64(v3, 16);
+    v3 ^= v2;
+    v0 += v3;
+    v3 = RotL64(v3, 21);
+    v3 ^= v0;
+    v2 += v1;
+    v1 = RotL64(v1, 17);
+    v1 ^= v2;
+    v2 = RotL64(v2, 32);
+}
+
+} // namespace
+
+std::pair<uint64_t, uint64_t>
+DeriveEpochSipHashKey(const Hash &prev_block_id, uint64_t epoch_number,
+                      const Hash &parent_overlay_id) noexcept {
+    std::array<uint8_t, 72> payload{};
+    std::memcpy(payload.data(), prev_block_id.data(), 32);
+    for (unsigned i = 0; i < 8; ++i) {
+        payload[32 + i] = static_cast<uint8_t>((epoch_number >> (8 * i)) & 0xff);
+    }
+    std::memcpy(payload.data() + 40, parent_overlay_id.data(), 32);
+    const Hash digest = TaggedHash(HashDomain::Branch, payload);
+    const uint64_t k0 = ReadLE64(digest.data());
+    const uint64_t k1 = ReadLE64(digest.data() + 8);
+    return {k0, k1};
+}
+
+uint64_t ComputeShortTxId(uint64_t k0, uint64_t k1,
+                          const Hash &tx_hash) noexcept {
+    uint64_t v0 = 0x736f6d6570736575ULL ^ k0;
+    uint64_t v1 = 0x646f72616e646f6dULL ^ k1;
+    uint64_t v2 = 0x6c7967656e657261ULL ^ k0;
+    uint64_t v3 = 0x7465646279746573ULL ^ k1;
+
+    for (size_t offset = 0; offset < 32; offset += 8) {
+        const uint64_t m = ReadLE64(tx_hash.data() + offset);
+        v3 ^= m;
+        SipRound(v0, v1, v2, v3);
+        SipRound(v0, v1, v2, v3);
+        v0 ^= m;
+    }
+
+    const uint64_t b = 32ULL << 56;
+    v3 ^= b;
+    SipRound(v0, v1, v2, v3);
+    SipRound(v0, v1, v2, v3);
+    v0 ^= b;
+
+    v2 ^= 0xffULL;
+    SipRound(v0, v1, v2, v3);
+    SipRound(v0, v1, v2, v3);
+    SipRound(v0, v1, v2, v3);
+    SipRound(v0, v1, v2, v3);
+
+    const uint64_t out = v0 ^ v1 ^ v2 ^ v3;
+    return out != 0 ? out : 1ULL;
+}
+
+uint64_t GF64Mul(uint64_t a, uint64_t b) noexcept {
+    uint64_t res = 0;
+    for (int i = 0; i < 64 && b != 0; ++i) {
+        if (b & 1ULL) {
+            res ^= a;
+        }
+        const bool hi = (a & (1ULL << 63)) != 0;
+        a <<= 1;
+        if (hi) {
+            a ^= kGF64Modulus;
+        }
+        b >>= 1;
+    }
+    return res;
+}
+
+uint64_t GF64Sqr(uint64_t a) noexcept {
+    return GF64Mul(a, a);
+}
+
+uint64_t GF64Cube(uint64_t a) noexcept {
+    return GF64Mul(GF64Sqr(a), a);
+}
+
+uint64_t GF64Pow5(uint64_t a) noexcept {
+    const uint64_t a2 = GF64Sqr(a);
+    const uint64_t a4 = GF64Sqr(a2);
+    return GF64Mul(a, a4);
+}
+
+uint64_t GF64Inv(uint64_t a) noexcept {
+    if (a == 0) {
+        return 0;
+    }
+    // a^(2^64 - 2) = product_{i=1}^{63} a^(2^i)
+    uint64_t result = 1;
+    uint64_t cur = a;
+    for (int i = 1; i < 64; ++i) {
+        cur = GF64Sqr(cur);
+        result = GF64Mul(result, cur);
+    }
+    return result;
+}
+
+uint64_t GF64Trace(uint64_t a) noexcept {
+    uint64_t tr = 0;
+    uint64_t cur = a;
+    for (int i = 0; i < 64; ++i) {
+        tr ^= cur;
+        cur = GF64Sqr(cur);
+    }
+    return tr & 1ULL;
+}
+
+bool GF64SolveQuadratic(uint64_t c, uint64_t &y_out) noexcept {
+    if (c == 0) {
+        y_out = 0;
+        return true;
+    }
+    // Modulo P(x) = x^64 + x^4 + x^3 + x + 1, e_61 = 1 (coeff of x^3) and 61 is
+    // odd, so by Newton's identities z = x^61 has absolute trace Tr(z) = 1.
+    constexpr uint64_t z = 1ULL << 61;
+
+    uint64_t y = 0;
+    uint64_t z_pow = z;
+    uint64_t c_pow = c;
+    uint64_t S = c; // Running prefix sum: sum_{i=0}^{j-1} c^(2^i)
+
+    for (int j = 1; j < 64; ++j) {
+        z_pow = GF64Sqr(z_pow); // z^(2^j)
+        y ^= GF64Mul(z_pow, S);
+        c_pow = GF64Sqr(c_pow); // c^(2^j)
+        S ^= c_pow;
+    }
+
+    // At j = 64, S == Tr(c). Solvable iff Tr(c) == 0.
+    if (S != 0) {
+        return false;
+    }
+    y_out = y;
+    return true;
+}
+
+BucketDecodeResult DecodeBucketSyndrome(const BucketSyndrome &delta) {
+    BucketDecodeResult res;
+    if (delta.s1 == 0 && delta.s3 == 0 && delta.s5 == 0) {
+        res.status = ReconcileStatus::Identical;
+        return res;
+    }
+    if (delta.s1 == 0) {
+        res.status = ReconcileStatus::Overflow;
+        return res;
+    }
+
+    const uint64_t s1_cubed = GF64Cube(delta.s1);
+    if (delta.s3 == s1_cubed) {
+        // Degree 1: single element difference x1 = s1, verified against s5
+        if (GF64Pow5(delta.s1) != delta.s5) {
+            res.status = ReconcileStatus::Overflow;
+            return res;
+        }
+        res.status = ReconcileStatus::Decoded;
+        res.roots.push_back(delta.s1);
+        return res;
+    }
+
+    // Degree 2 candidate:
+    //   x1 + x2 = s1
+    //   x1 * x2 = (s3 + s1^3) / s1
+    // Depressed quadratic for y = x1 / s1:
+    //   y^2 + y = c, where c = (s3 + s1^3) / s1^3
+    const uint64_t num = delta.s3 ^ s1_cubed;
+    const uint64_t c = GF64Mul(num, GF64Inv(s1_cubed));
+    uint64_t y = 0;
+    if (!GF64SolveQuadratic(c, y)) {
+        res.status = ReconcileStatus::Overflow;
+        return res;
+    }
+
+    uint64_t x1 = GF64Mul(delta.s1, y);
+    uint64_t x2 = x1 ^ delta.s1;
+    if ((GF64Pow5(x1) ^ GF64Pow5(x2)) != delta.s5) {
+        res.status = ReconcileStatus::Overflow;
+        return res;
+    }
+
+
+    if (x2 < x1) {
+        std::swap(x1, x2);
+    }
+    res.status = ReconcileStatus::Decoded;
+    res.roots.push_back(x1);
+    res.roots.push_back(x2);
+    return res;
+}
+
+} // namespace lotus::v2
