+        for (auto &notif : deferred_notifications) {
+            m_pool.m_opts.signals->TransactionAddedToMempool(
+                notif.tx, std::move(notif.spent_coins), notif.sequence);
+        }
+    }
+
+    return PackageMempoolAcceptResult(package_state, std::move(results));
+}
