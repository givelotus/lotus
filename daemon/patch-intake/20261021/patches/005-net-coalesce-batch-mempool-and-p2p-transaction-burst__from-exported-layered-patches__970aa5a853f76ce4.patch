@@ -0,0 +1,111 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef LOTUS_V2_SET_RECONCILIATION_H
+#define LOTUS_V2_SET_RECONCILIATION_H
+
+#include "header.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace lotus::v2 {
+
+/**
+ * Irreducible primitive polynomial for GF(2^64):
+ *   P(x) = x^64 + x^4 + x^3 + x + 1  (low 64 bits = 0x1b)
+ */
+inline constexpr uint64_t kGF64Modulus = 0x1bULL;
+
+/**
+ * Derive per-epoch 128-bit SipHash-2-4 key (k0, k1) from prev_block_id,
+ * epoch_number, and parent_overlay_id so peers cannot pre-mine short_id
+ * collisions across epochs (Hole 1).
+ */
+std::pair<uint64_t, uint64_t>
+DeriveEpochSipHashKey(const Hash &prev_block_id, uint64_t epoch_number,
+                      const Hash &parent_overlay_id = Hash{}) noexcept;
+
+/**
+ * Compute keyed SipHash-2-4 64-bit short_id for a 256-bit transaction hash.
+ * Maps 0 -> 1 so every valid transaction maps to a non-zero element of GF(2^64)^*.
+ */
+uint64_t ComputeShortTxId(uint64_t k0, uint64_t k1,
+                          const Hash &tx_hash) noexcept;
+
+// ============================================================================
+// GF(2^64) Finite Field Arithmetic modulo x^64 + x^4 + x^3 + x + 1
+// ============================================================================
+
+inline constexpr uint64_t GF64Add(uint64_t a, uint64_t b) noexcept {
+    return a ^ b;
+}
+
+uint64_t GF64Mul(uint64_t a, uint64_t b) noexcept;
+uint64_t GF64Sqr(uint64_t a) noexcept;
+uint64_t GF64Cube(uint64_t a) noexcept;
+uint64_t GF64Pow5(uint64_t a) noexcept;
+uint64_t GF64Inv(uint64_t a) noexcept;
+uint64_t GF64Trace(uint64_t a) noexcept;
+
+/**
+ * Solve y^2 + y = c in GF(2^64).
+ * Returns true and sets y_out if Tr(c) == 0; returns false if Tr(c) == 1.
+ */
+bool GF64SolveQuadratic(uint64_t c, uint64_t &y_out) noexcept;
+
+// ============================================================================
+// Degree-2 BCH Bucket Syndrome with s5 Checksum over GF(2^64)
+// ============================================================================
+
+enum class ReconcileStatus {
+    Identical, // d = 0 differences
+    Decoded,   // d = 1 or d = 2 differences recovered and s5-verified
+    Overflow,  // d >= 3 differences in bucket (requires fallback/subdivision)
+};
+
+struct BucketSyndrome {
+    uint64_t s1{0}; // XOR sum of x
+    uint64_t s3{0}; // XOR sum of x^3
+    uint64_t s5{0}; // XOR sum of x^5
+
+    void Add(uint64_t short_id) noexcept {
+        if (short_id == 0) {
+            return;
+        }
+        s1 ^= short_id;
+        s3 ^= GF64Cube(short_id);
+        s5 ^= GF64Pow5(short_id);
+    }
+
+    void Remove(uint64_t short_id) noexcept {
+        Add(short_id); // In GF(2^64), addition and subtraction are both XOR
+    }
+
+    BucketSyndrome SymmetricDifference(const BucketSyndrome &other) const noexcept {
+        return BucketSyndrome{s1 ^ other.s1, s3 ^ other.s3, s5 ^ other.s5};
+    }
+
+    bool IsZero() const noexcept { return s1 == 0 && s3 == 0 && s5 == 0; }
+};
+
+struct BucketDecodeResult {
+    ReconcileStatus status{ReconcileStatus::Identical};
+    std::vector<uint64_t> roots; // Sorted ascending recovered short_ids
+};
+
+/**
+ * Decode a symmetric-difference BucketSyndrome (delta_s1, delta_s3, delta_s5):
+ *   - d = 0: status = Identical, roots = {}
+ *   - d = 1: status = Decoded,   roots = {x1} (verified against delta_s5)
+ *   - d = 2: status = Decoded,   roots = {x1, x2} (sorted, verified against delta_s5)
+ *   - d >= 3: status = Overflow, roots = {}
+ */
+BucketDecodeResult DecodeBucketSyndrome(const BucketSyndrome &delta);
+
+} // namespace lotus::v2
+
+#endif // LOTUS_V2_SET_RECONCILIATION_H
diff --git a/src/lotus_v2/sparse_state.cpp b/src/lotus_v2/sparse_state.cpp
new file mode 100644
index 0000000000..c2847777b1
--- /dev/null
+++ b/src/lotus_v2/sparse_state.cpp
@@ -0,0 +1,293 @@
+#include "sparse_state.h"
+
+#include "tagged_hash.h"
+
+#include <algorithm>
+#include <cassert>
+#include <string>
+
+namespace lotus::v2 {
+namespace {
+template <size_t N> void PutLE(std::array<uint8_t, N> &out, size_t at,
+                              uint64_t value, unsigned width) {
+    for (unsigned i = 0; i < width; ++i) out[at + i] = static_cast<uint8_t>(value >> (8 * i));
+}
+
+void PutCompactSize(std::vector<uint8_t> &out, uint64_t n) {
+    if (n < 253) {
+        out.push_back(static_cast<uint8_t>(n));
+    } else if (n <= 0xffff) {
+        out.push_back(253);
+        for (unsigned i = 0; i < 2; ++i) out.push_back(static_cast<uint8_t>(n >> (8 * i)));
+    } else if (n <= 0xffffffffU) {
+        out.push_back(254);
+        for (unsigned i = 0; i < 4; ++i) out.push_back(static_cast<uint8_t>(n >> (8 * i)));
+    } else {
+        out.push_back(255);
+        for (unsigned i = 0; i < 8; ++i) out.push_back(static_cast<uint8_t>(n >> (8 * i)));
+    }
+}
+
+bool KeyBit(const Hash &key, unsigned depth) {
+    return (key[depth / 8] >> (depth % 8)) & 1;
+}
+
+void SetBit(Hash &bitmap, unsigned depth) { bitmap[depth / 8] |= uint8_t{1} << (depth % 8); }
+bool GetBit(const Hash &bitmap, unsigned depth) { return (bitmap[depth / 8] >> (depth % 8)) & 1; }
+
+Hash NodeAtDepth(unsigned depth, const Hash &left, const Hash &right) {
+    assert(depth < 256);
+    std::array<uint8_t, 67> input{};
+    input[0] = 1;
+    input[1] = static_cast<uint8_t>(depth);
+    input[2] = static_cast<uint8_t>(depth >> 8);
+    std::copy(left.begin(), left.end(), input.begin() + 3);
+    std::copy(right.begin(), right.end(), input.begin() + 35);
+    return TaggedHash(HashDomain::Utxo, input);
+}
+
+struct Entry {
+    Hash key;
+    const Coin *coin;
+};
+
+Hash RootOf(const std::vector<Entry> &entries, unsigned depth) {
+    if (entries.empty()) return EmptyUtxoRoot();
+    if (entries.size() == 1) {
+        Hash result;
+        const bool valid = UtxoLeaf(*entries[0].coin, result);
+        assert(valid);
+        (void)valid;
+        return result;
+    }
+    assert(depth < 256); // Insertion rejects equal keys.
+    std::vector<Entry> left, right;
+    for (const Entry &entry : entries) {
+        (KeyBit(entry.key, depth) ? right : left).push_back(entry);
+    }
+    return NodeAtDepth(depth, RootOf(left, depth + 1), RootOf(right, depth + 1));
+}
+
+std::vector<Entry> Entries(const std::vector<Coin> &coins) {
+    std::vector<Entry> entries;
+    entries.reserve(coins.size());
+    for (const Coin &coin : coins) entries.push_back({OutpointKey(coin.outpoint), &coin});
+    return entries;
+}
+
+void ProveAt(const std::vector<Entry> &entries, unsigned depth,
+             const Outpoint &query, const Hash &query_key, CoinProof &proof) {
+    if (entries.empty()) {
+        proof.presence = ProofPresence::Empty;
+        return;
+    }
+    if (entries.size() == 1) {
+        proof.coin = *entries[0].coin;
+        proof.presence = entries[0].coin->outpoint == query
+                             ? ProofPresence::Present : ProofPresence::OtherLeaf;
+        return;
+    }
+    assert(depth < 256);
+    std::vector<Entry> left, right;
+    for (const Entry &entry : entries) {
+        (KeyBit(entry.key, depth) ? right : left).push_back(entry);
+    }
+    const bool bit = KeyBit(query_key, depth);
+    const auto &selected = bit ? right : left;
+    const auto &other = bit ? left : right;
+    ProveAt(selected, depth + 1, query, query_key, proof);
+    if (!other.empty()) {
+        SetBit(proof.bitmap, depth);
+        proof.siblings.push_back(RootOf(other, depth + 1));
+    }
+}
+} // namespace
+
+bool EncodeCoin(const Coin &coin, std::vector<uint8_t> &encoded) {
+    if (coin.output.IsBurn()) return false;
+    std::vector<uint8_t> output;
+    std::string error;
+    if (!EncodeOutput(coin.output, output, error)) return false;
+    std::vector<uint8_t> result;
+    result.reserve(36 + 9 + output.size() + 17);
+    result.insert(result.end(), coin.outpoint.tx_id.begin(), coin.outpoint.tx_id.end());
+    for (unsigned i = 0; i < 4; ++i) result.push_back(static_cast<uint8_t>(coin.outpoint.index >> (8 * i)));
+    PutCompactSize(result, output.size());
+    result.insert(result.end(), output.begin(), output.end());
+    for (unsigned i = 0; i < 8; ++i) result.push_back(static_cast<uint8_t>(coin.creation_height >> (8 * i)));
+    for (unsigned i = 0; i < 8; ++i) result.push_back(static_cast<uint8_t>(coin.creation_parent_mtp >> (8 * i)));
+    result.push_back(coin.coinbase ? 1 : 0);
+    if (result.size() > MAX_COIN_BYTES) return false;
+    encoded = std::move(result);
+    return true;
+}
+
+bool DecodeCoinBytes(std::span<const uint8_t> encoded, Coin &out) {
+    if (encoded.size() < 36 + 1 + 17 || encoded.size() > MAX_COIN_BYTES) {
+        return false;
+    }
+    Coin coin;
+    std::copy_n(encoded.data(), 32, coin.outpoint.tx_id.begin());
+    coin.outpoint.index = uint32_t(encoded[32]) |
+                          (uint32_t(encoded[33]) << 8) |
+                          (uint32_t(encoded[34]) << 16) |
+                          (uint32_t(encoded[35]) << 24);
+    size_t pos = 36;
+    uint64_t out_len = 0;
+    const uint8_t lead = encoded[pos++];
+    if (lead < 253) {
+        out_len = lead;
+    } else {
+        const unsigned width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+        if (pos + width > encoded.size()) return false;
+        for (unsigned i = 0; i < width; ++i) {
+            out_len |= uint64_t(encoded[pos++]) << (8 * i);
+        }
+    }
+    if (pos + out_len + 17 != encoded.size()) return false;
+    std::string error;
+    if (!DecodeOutput(std::vector<uint8_t>(encoded.begin() + pos,
+                                           encoded.begin() + pos + out_len),
+                      coin.output, error)) {
+        return false;
+    }
+    pos += static_cast<size_t>(out_len);
+    coin.creation_height = 0;
+    coin.creation_parent_mtp = 0;
+    for (unsigned i = 0; i < 8; ++i) {
+        coin.creation_height |= uint64_t(encoded[pos + i]) << (8 * i);
+        coin.creation_parent_mtp |= uint64_t(encoded[pos + 8 + i]) << (8 * i);
+    }
+    const uint8_t cb_flag = encoded[pos + 16];
+    if (cb_flag > 1) return false;
+    coin.coinbase = (cb_flag == 1);
+    std::vector<uint8_t> roundtrip;
+    if (!EncodeCoin(coin, roundtrip) || roundtrip.size() != encoded.size() ||
+        !std::equal(roundtrip.begin(), roundtrip.end(), encoded.begin())) {
+        return false;
+    }
+    out = std::move(coin);
+    return true;
+}
+
+Hash OutpointKey(const Outpoint &outpoint) {
+    Hash key = outpoint.tx_id;
+    for (unsigned i = 0; i < 4; ++i) {
+        key[28 + i] ^= static_cast<uint8_t>(outpoint.index >> (8 * i));
+    }
+    return key;
+}
+
+Hash EmptyUtxoRoot() { return TaggedHash(HashDomain::Utxo, std::array<uint8_t, 1>{2}); }
+
+bool UtxoLeaf(const Coin &coin, Hash &out) {
+    std::vector<uint8_t> serialized;
+    if (!EncodeCoin(coin, serialized)) return false;
+    const Hash key = OutpointKey(coin.outpoint);
+    std::vector<uint8_t> input;
+    input.reserve(1 + 32 + 9 + serialized.size());
+    input.push_back(0);
+    input.insert(input.end(), key.begin(), key.end());
+    PutCompactSize(input, serialized.size());
+    input.insert(input.end(), serialized.begin(), serialized.end());
+    out = TaggedHash(HashDomain::Utxo, input);
+    return true;
+}
+
+bool UtxoNode(uint16_t depth, const Hash &left, const Hash &right, Hash &out) {
+    if (depth >= 256) return false;
+    out = NodeAtDepth(depth, left, right);
+    return true;
+}
+
+bool UtxoSet::Insert(const Coin &coin) {
+    Hash ignored;
+    if (!UtxoLeaf(coin, ignored)) return false;
+    const Hash key = OutpointKey(coin.outpoint);
+    for (const Coin &existing : coins_) {
+        if (existing.outpoint == coin.outpoint || OutpointKey(existing.outpoint) == key) return false;
+    }
+    coins_.push_back(coin);
+    return true;
+}
+
+bool UtxoSet::Erase(const Outpoint &outpoint) {
+    auto it = std::find_if(coins_.begin(), coins_.end(),
+                           [&](const Coin &coin) { return coin.outpoint == outpoint; });
+    if (it == coins_.end()) return false;
+    coins_.erase(it);
+    return true;
+}
+
+Hash UtxoSet::Root() const { return RootOf(Entries(coins_), 0); }
+
+CoinProof UtxoSet::Prove(const Outpoint &query) const {
+    CoinProof proof;
+    ProveAt(Entries(coins_), 0, query, OutpointKey(query), proof);
+    return proof;
+}
+
+bool VerifyCoinProof(const Outpoint &query, const CoinProof &proof,
+                     const Hash &expected_root) {
+    if (static_cast<uint8_t>(proof.presence) > 2) return false;
+    if ((proof.presence == ProofPresence::Empty) != !proof.coin.has_value()) return false;
+    int highest = -1;
+    size_t count = 0;
+    for (unsigned d = 0; d < 256; ++d) {
+        if (GetBit(proof.bitmap, d)) {
+            highest = d;
+            ++count;
+        }
+    }
+    if (proof.siblings.size() != count) return false;
+    const unsigned k = highest + 1;
+    const Hash query_key = OutpointKey(query);
+    Hash acc = EmptyUtxoRoot();
+    if (proof.coin) {
+        const Coin &coin = *proof.coin;
+        if (proof.presence == ProofPresence::Present && coin.outpoint != query) return false;
+        if (proof.presence == ProofPresence::OtherLeaf && coin.outpoint == query) return false;
+        const Hash other_key = OutpointKey(coin.outpoint);
+        if (proof.presence == ProofPresence::OtherLeaf) {
+            for (unsigned d = 0; d < k; ++d) {
+                if (KeyBit(query_key, d) != KeyBit(other_key, d)) return false;
+            }
+        }
+        if (!UtxoLeaf(coin, acc)) return false;
+    }
+    size_t sibling_index = 0;
+    for (int d = static_cast<int>(k) - 1; d >= 0; --d) {
+        Hash sibling = EmptyUtxoRoot();
+        if (GetBit(proof.bitmap, d)) {
+            sibling = proof.siblings[sibling_index++];
+            if (sibling == EmptyUtxoRoot()) return false;
+        }
+        acc = KeyBit(query_key, d) ? NodeAtDepth(d, sibling, acc)
+                                   : NodeAtDepth(d, acc, sibling);
+    }
+    return acc == expected_root;
+}
+
+std::array<uint8_t, 56> EncodeMonetaryState(const MonetaryState &state) {
+    std::array<uint8_t, 56> out{};
+    PutLE(out, 0, state.bootstrap_reserve, 8);
+    PutLE(out, 8, state.tail_subsidy, 8);
+    std::copy(state.prev_work.begin(), state.prev_work.end(), out.begin() + 16);
+    PutLE(out, 48, state.ema_block_cost, 8);
+    return out;
+}
+
+Hash StateRoot(const ChainId &chain_id, uint64_t height,
+               const Hash &utxo_root, const MonetaryState &state) {
+    std::array<uint8_t, 130> input{};
+    input[0] = 0;
+    std::copy(chain_id.begin(), chain_id.end(), input.begin() + 1);
+    PutLE(input, 33, height, 8);
+    std::copy(utxo_root.begin(), utxo_root.end(), input.begin() + 41);
+    input[73] = 56; // Bytes(MonetaryState), fixed CompactSize length.
+    const auto monetary = EncodeMonetaryState(state);
+    std::copy(monetary.begin(), monetary.end(), input.begin() + 74);
+    return TaggedHash(HashDomain::State, input);
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/sparse_state.h b/src/lotus_v2/sparse_state.h
new file mode 100644
index 0000000000..e23a438784
--- /dev/null
+++ b/src/lotus_v2/sparse_state.h
@@ -0,0 +1,79 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_SPARSE_STATE_H
+#define LOTUS_V2_SPARSE_STATE_H
+
+#include "header.h"
+#include "output.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace lotus::v2 {
+
+constexpr size_t MAX_COIN_BYTES = 868;
+
+struct Outpoint {
+    Hash tx_id{};
+    uint32_t index{};
+    bool operator==(const Outpoint &) const = default;
+};
+
+struct Coin {
+    Outpoint outpoint;
+    Output output;
+    uint64_t creation_height{};
+    uint64_t creation_parent_mtp{};
+    bool coinbase{};
+};
+
+// Coin output grammar is checked by the P01 Output codec. Burn outputs reject.
+bool EncodeCoin(const Coin &coin, std::vector<uint8_t> &encoded);
+bool DecodeCoinBytes(std::span<const uint8_t> encoded, Coin &coin);
+Hash OutpointKey(const Outpoint &outpoint);
+Hash EmptyUtxoRoot();
+bool UtxoLeaf(const Coin &coin, Hash &out);
+bool UtxoNode(uint16_t depth, const Hash &left, const Hash &right, Hash &out);
+
+enum class ProofPresence : uint8_t { Empty = 0, Present = 1, OtherLeaf = 2 };
+struct CoinProof {
+    ProofPresence presence{};
+    std::optional<Coin> coin;
+    Hash bitmap{}; // Bit d marks a nonempty sibling at depth d.
+    std::vector<Hash> siblings; // Deepest sibling first.
+};
+
+// Typed proof verifier. Wire framing and consensus context are separate.
+bool VerifyCoinProof(const Outpoint &query, const CoinProof &proof,
+                     const Hash &expected_root);
+
+// Bounded scalar reference model, not a database or incremental production
+// index. Every operation recomputes its root from the complete coin set.
+class UtxoSet {
+public:
+    bool Insert(const Coin &coin); // Reject duplicate outpoint or occupied key.
+    bool Erase(const Outpoint &outpoint);
+    Hash Root() const;
+    CoinProof Prove(const Outpoint &query) const;
+    size_t Size() const { return coins_.size(); }
+    const std::vector<Coin> &Coins() const { return coins_; }
+
+private:
+    std::vector<Coin> coins_;
+};
+
+struct MonetaryState {
+    uint64_t bootstrap_reserve{};
+    uint64_t tail_subsidy{};
+    Hash prev_work{}; // LE unsigned u256.
+    uint64_t ema_block_cost{};
+};
+std::array<uint8_t, 56> EncodeMonetaryState(const MonetaryState &state);
+Hash StateRoot(const ChainId &chain_id, uint64_t height,
+               const Hash &utxo_root, const MonetaryState &state);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/utxo_fast_filter.cpp b/src/lotus_v2/utxo_fast_filter.cpp
new file mode 100644
index 0000000000..69e400f3bc
--- /dev/null
+++ b/src/lotus_v2/utxo_fast_filter.cpp
@@ -0,0 +1,349 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include "utxo_fast_filter.h"
+
+#include <cstring>
+
+namespace lotus::v2 {
+
+namespace {
+
+constexpr size_t kInitialShardTableCap = 256;
+
+inline std::pair<size_t, uint64_t> BloomBit1(uint64_t fp) noexcept {
+    const uint32_t bit = static_cast<uint32_t>(fp & 2047ULL);
+    return {bit >> 6, 1ULL << (bit & 63u)};
+}
+
+inline std::pair<size_t, uint64_t> BloomBit2(uint64_t fp) noexcept {
+    const uint32_t bit = static_cast<uint32_t>((fp >> 11) & 2047ULL);
+    return {bit >> 6, 1ULL << (bit & 63u)};
+}
+
+} // namespace
+
+// ============================================================================
+// UtxoFastFilter::FlatFpSet
+// ============================================================================
+
+UtxoFastFilter::FlatFpSet::FlatFpSet() : slots(kInitialShardTableCap, kEmpty) {}
+
+void UtxoFastFilter::FlatFpSet::Clear() {
+    std::fill(slots.begin(), slots.end(), kEmpty);
+    count = 0;
+    tombstones = 0;
+}
+
+void UtxoFastFilter::FlatFpSet::Reserve(size_t min_entries) {
+    size_t target_cap = kInitialShardTableCap;
+    while (target_cap < min_entries * 2) {
+        target_cap *= 2;
+    }
+    if (target_cap > slots.size()) {
+        Rehash(target_cap);
+    }
+}
+
+void UtxoFastFilter::FlatFpSet::Rehash(size_t new_cap) {
+    std::vector<uint64_t> old = std::move(slots);
+    slots.assign(new_cap, kEmpty);
+    count = 0;
+    tombstones = 0;
+    const size_t mask = new_cap - 1;
+    for (uint64_t val : old) {
+        if (val > kTombstone) {
+            size_t idx = static_cast<size_t>(val) & mask;
+            while (slots[idx] != kEmpty) {
+                idx = (idx + 1) & mask;
+            }
+            slots[idx] = val;
+            ++count;
+        }
+    }
+}
+
+bool UtxoFastFilter::FlatFpSet::Insert(uint64_t fp) {
+    if ((count + tombstones + 1) * 2 >= slots.size()) {
+        const size_t next_cap =
+            (count * 4 >= slots.size()) ? (slots.size() * 2) : slots.size();
+        Rehash(next_cap);
+    }
+    const size_t mask = slots.size() - 1;
+    size_t idx = static_cast<size_t>(fp) & mask;
+    size_t first_tomb = slots.size();
+    while (true) {
+        const uint64_t cur = slots[idx];
+        if (cur == fp) {
+            return false;
+        }
+        if (cur == kEmpty) {
+            if (first_tomb != slots.size()) {
+                slots[first_tomb] = fp;
+                --tombstones;
+            } else {
+                slots[idx] = fp;
+            }
+            ++count;
+            return true;
+        }
+        if (cur == kTombstone && first_tomb == slots.size()) {
+            first_tomb = idx;
+        }
+        idx = (idx + 1) & mask;
+    }
+}
+
+bool UtxoFastFilter::FlatFpSet::Erase(uint64_t fp) {
+    const size_t mask = slots.size() - 1;
+    size_t idx = static_cast<size_t>(fp) & mask;
+    while (true) {
+        const uint64_t cur = slots[idx];
+        if (cur == fp) {
+            slots[idx] = kTombstone;
+            --count;
+            ++tombstones;
+            return true;
+        }
+        if (cur == kEmpty) {
+            return false;
+        }
+        idx = (idx + 1) & mask;
+    }
+}
+
+bool UtxoFastFilter::FlatFpSet::Contains(uint64_t fp) const noexcept {
+    const size_t mask = slots.size() - 1;
+    size_t idx = static_cast<size_t>(fp) & mask;
+    while (true) {
+        const uint64_t cur = slots[idx];
+        if (cur == fp) {
+            return true;
+        }
+        if (cur == kEmpty) {
+            return false;
+        }
+        idx = (idx + 1) & mask;
+    }
+}
+
+// ============================================================================
+// UtxoFastFilter::Shard
+// ============================================================================
+
+UtxoFastFilter::Shard::Shard() {
+    for (auto &w : spent_bloom) {
+        w.store(0ULL, std::memory_order_relaxed);
+    }
+    for (auto &w : unspent_bloom) {
+        w.store(0ULL, std::memory_order_relaxed);
+    }
+}
+
+void UtxoFastFilter::Shard::RebuildSpentBloomLocked() noexcept {
+    std::array<uint64_t, kBloomWords> next_bloom{};
+    for (uint64_t val : spent_set.slots) {
+        if (val > FlatFpSet::kTombstone) {
+            const auto [w1, m1] = BloomBit1(val);
+            const auto [w2, m2] = BloomBit2(val);
+            next_bloom[w1] |= m1;
+            next_bloom[w2] |= m2;
+        }
+    }
+    for (size_t i = 0; i < kBloomWords; ++i) {
+        spent_bloom[i].store(next_bloom[i], std::memory_order_release);
+    }
+}
+
+void UtxoFastFilter::Shard::RebuildUnspentBloomLocked() noexcept {
+    std::array<uint64_t, kBloomWords> next_bloom{};
+    for (uint64_t val : unspent_set.slots) {
+        if (val > FlatFpSet::kTombstone) {
+            const auto [w1, m1] = BloomBit1(val);
+            const auto [w2, m2] = BloomBit2(val);
+            next_bloom[w1] |= m1;
+            next_bloom[w2] |= m2;
+        }
+    }
+    for (size_t i = 0; i < kBloomWords; ++i) {
+        unspent_bloom[i].store(next_bloom[i], std::memory_order_release);
+    }
+}
+
+// ============================================================================
+// UtxoFastFilter
+// ============================================================================
+
+UtxoFastFilter::UtxoFastFilter() = default;
+
+void UtxoFastFilter::ReservePerShard(size_t unspent_cap, size_t spent_cap) {
+    for (Shard &shard : shards_) {
+        std::lock_guard<std::mutex> lock(shard.mutex);
+        shard.unspent_set.Reserve(unspent_cap);
+        shard.spent_set.Reserve(spent_cap);
+    }
+}
+
+uint64_t UtxoFastFilter::ComputeFingerprint(const uint8_t *txid32,
+                                            uint32_t index) noexcept {
+    uint64_t w0 = 0;
+    uint64_t w1 = 0;
+    std::memcpy(&w0, txid32, 8);
+    std::memcpy(&w1, txid32 + 8, 8);
+    uint64_t z = w0 ^ (w1 * 0x9e3779b97f4a7c15ULL) ^
+                 (static_cast<uint64_t>(index) * 0xbf58476d1ce4e5b9ULL);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    const uint64_t fp = z ^ (z >> 31);
+    return fp <= FlatFpSet::kTombstone ? 2ULL : fp;
+}
+
+bool UtxoFastFilter::MarkSpentInMempool(const uint8_t *txid32, uint32_t index) {
+    const size_t sidx = ShardIndex(txid32);
+    const uint64_t fp = ComputeFingerprint(txid32, index);
+    Shard &shard = shards_[sidx];
+    std::lock_guard<std::mutex> lock(shard.mutex);
+    const bool inserted = shard.spent_set.Insert(fp);
+    if (inserted) {
+        shard.spent_count.store(shard.spent_set.count,
+                                std::memory_order_relaxed);
+    }
+    const auto [w1, m1] = BloomBit1(fp);
+    const auto [w2, m2] = BloomBit2(fp);
+    shard.spent_bloom[w1].fetch_or(m1, std::memory_order_release);
+    shard.spent_bloom[w2].fetch_or(m2, std::memory_order_release);
+    return inserted;
+}
+
+bool UtxoFastFilter::UnmarkSpentInMempool(const uint8_t *txid32,
+                                          uint32_t index) {
+    const size_t sidx = ShardIndex(txid32);
+    const uint64_t fp = ComputeFingerprint(txid32, index);
+    Shard &shard = shards_[sidx];
+    std::lock_guard<std::mutex> lock(shard.mutex);
+    const bool erased = shard.spent_set.Erase(fp);
+    if (erased) {
+        shard.spent_count.store(shard.spent_set.count,
+                                std::memory_order_relaxed);
+        shard.RebuildSpentBloomLocked();
+    }
+    return erased;
+}
+
+bool UtxoFastFilter::IsSpentInMempool(const uint8_t *txid32,
+                                      uint32_t index) const noexcept {
+    const size_t sidx = ShardIndex(txid32);
+    const Shard &shard = shards_[sidx];
+    if (shard.spent_count.load(std::memory_order_relaxed) == 0) {
+        return false;
+    }
+    const uint64_t fp = ComputeFingerprint(txid32, index);
+    const auto [w1, m1] = BloomBit1(fp);
+    if ((shard.spent_bloom[w1].load(std::memory_order_acquire) & m1) == 0) {
+        return false;
+    }
+    const auto [w2, m2] = BloomBit2(fp);
+    if ((shard.spent_bloom[w2].load(std::memory_order_acquire) & m2) == 0) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(shard.mutex);
+    return shard.spent_set.Contains(fp);
+}
+
+bool UtxoFastFilter::AddUnspent(const uint8_t *txid32, uint32_t index) {
+    const size_t sidx = ShardIndex(txid32);
+    const uint64_t fp = ComputeFingerprint(txid32, index);
+    Shard &shard = shards_[sidx];
+    std::lock_guard<std::mutex> lock(shard.mutex);
+    const bool inserted = shard.unspent_set.Insert(fp);
+    if (inserted) {
+        shard.unspent_count.store(shard.unspent_set.count,
+                                  std::memory_order_relaxed);
+    }
+    const auto [w1, m1] = BloomBit1(fp);
+    const auto [w2, m2] = BloomBit2(fp);
+    shard.unspent_bloom[w1].fetch_or(m1, std::memory_order_release);
+    shard.unspent_bloom[w2].fetch_or(m2, std::memory_order_release);
+    return inserted;
+}
+
+bool UtxoFastFilter::RemoveUnspent(const uint8_t *txid32, uint32_t index) {
+    const size_t sidx = ShardIndex(txid32);
+    const uint64_t fp = ComputeFingerprint(txid32, index);
+    Shard &shard = shards_[sidx];
+    std::lock_guard<std::mutex> lock(shard.mutex);
+    const bool erased = shard.unspent_set.Erase(fp);
+    if (erased) {
+        shard.unspent_count.store(shard.unspent_set.count,
+                                  std::memory_order_relaxed);
+        shard.RebuildUnspentBloomLocked();
+    }
+    return erased;
+}
+
+bool UtxoFastFilter::ContainsUnspent(const uint8_t *txid32,
+                                     uint32_t index) const noexcept {
+    const size_t sidx = ShardIndex(txid32);
+    const Shard &shard = shards_[sidx];
+    if (shard.unspent_count.load(std::memory_order_relaxed) == 0) {
+        return false;
+    }
+    const uint64_t fp = ComputeFingerprint(txid32, index);
+    const auto [w1, m1] = BloomBit1(fp);
+    if ((shard.unspent_bloom[w1].load(std::memory_order_acquire) & m1) == 0) {
+        return false;
+    }
+    const auto [w2, m2] = BloomBit2(fp);
+    if ((shard.unspent_bloom[w2].load(std::memory_order_acquire) & m2) == 0) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(shard.mutex);
+    return shard.unspent_set.Contains(fp);
+}
+
+void UtxoFastFilter::ClearMempool() {
+    for (Shard &shard : shards_) {
+        std::lock_guard<std::mutex> lock(shard.mutex);
+        shard.spent_set.Clear();
+        shard.spent_count.store(0, std::memory_order_relaxed);
+        for (auto &w : shard.spent_bloom) {
+            w.store(0ULL, std::memory_order_release);
+        }
+    }
+}
+
+void UtxoFastFilter::ClearAll() {
+    chain_uhs_authoritative_.store(false, std::memory_order_release);
+    for (Shard &shard : shards_) {
+        std::lock_guard<std::mutex> lock(shard.mutex);
+        shard.spent_set.Clear();
+        shard.unspent_set.Clear();
+        shard.spent_count.store(0, std::memory_order_relaxed);
+        shard.unspent_count.store(0, std::memory_order_relaxed);
+        for (auto &w : shard.spent_bloom) {
+            w.store(0ULL, std::memory_order_release);
+        }
+        for (auto &w : shard.unspent_bloom) {
+            w.store(0ULL, std::memory_order_release);
+        }
+    }
+}
+
+size_t UtxoFastFilter::GetMempoolSpentCount() const noexcept {
+    size_t total = 0;
+    for (const Shard &shard : shards_) {
+        total += shard.spent_count.load(std::memory_order_relaxed);
+    }
+    return total;
+}
+
+size_t UtxoFastFilter::GetUnspentCount() const noexcept {
+    size_t total = 0;
+    for (const Shard &shard : shards_) {
+        total += shard.unspent_count.load(std::memory_order_relaxed);
+    }
+    return total;
+}
+
+} // namespace lotus::v2
