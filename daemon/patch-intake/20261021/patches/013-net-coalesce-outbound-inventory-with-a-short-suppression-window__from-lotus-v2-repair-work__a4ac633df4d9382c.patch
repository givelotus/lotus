+    BOOST_CHECK_EQUAL(OUTBOUND_INVENTORY_BROADCAST_INTERVAL.count(), 2000);
+    BOOST_CHECK_EQUAL(INVENTORY_BROADCAST_PER_SECOND, 2500U);
+    BOOST_CHECK_EQUAL(INVENTORY_MAX_RECENT_RELAY, 350000U);
+}
