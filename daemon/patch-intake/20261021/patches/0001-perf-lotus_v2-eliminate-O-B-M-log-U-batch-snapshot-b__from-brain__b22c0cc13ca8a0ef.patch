+                                ws.m_vsize, ws.m_base_fees, effective_feerate,
+                                std::vector<TxId>{ws_txid}));
+        }
+        cleanup_views();
+        return PackageMempoolAcceptResult(package_state, std::move(results));
+    }
+
+    SubmitPackage(args, workspaces, package_state, results);
+    cleanup_views();
+    return PackageMempoolAcceptResult(package_state, std::move(results));
+}
