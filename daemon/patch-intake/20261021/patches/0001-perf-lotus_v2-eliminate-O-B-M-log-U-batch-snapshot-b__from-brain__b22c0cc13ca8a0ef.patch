+def build_p2sh_op_true_tx(prev_txid_int: int, prev_vout: int, value_sats: int, spk_bytes: bytes) -> CTransaction:
+    tx = CTransaction()
+    tx.nVersion = 2
+    tx.vin = [CTxIn(COutPoint(prev_txid_int, prev_vout), SCRIPTSIG_OP_TRUE, 0xFFFFFFFE)]
+    tx.vout = [CTxOut(value_sats, CScript(spk_bytes))]
+    pad_tx(tx)
+    return tx
