+def wait_for_rpc(client: KeepAliveRPCClient, timeout: float = 30.0, proc=None, err_path=None):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if proc is not None and proc.poll() is not None:
+            err_txt = Path(err_path).read_text() if err_path and Path(err_path).exists() else ""
+            raise RuntimeError(f"lotusd on port {client.port} exited with {proc.returncode}: {err_txt}")
+        try:
+            info = client.call("getblockchaininfo")
+            if isinstance(info, dict) and "blocks" in info:
+                return info
+        except Exception:
+            time.sleep(0.1)
+    raise TimeoutError(f"Node on port {client.port} did not become ready in {timeout}s")
