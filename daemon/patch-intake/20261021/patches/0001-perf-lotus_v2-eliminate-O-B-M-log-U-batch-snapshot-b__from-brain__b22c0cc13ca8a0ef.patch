+def percentile(sorted_vals, pct: float) -> float:
+    if not sorted_vals:
+        return 0.0
+    idx = min(len(sorted_vals) - 1, max(0, int(math.ceil(pct / 100.0 * len(sorted_vals)) - 1)))
+    return sorted_vals[idx]
