From f647766b13ea3dce12c527be0c2ada252b3a71e9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:33:46 -0700
Subject: [PATCH] avalanche: make current processor fixtures explicit about
 Dogecoin policy

Keep existing upstream processor tests in an explicitly activated optional policy environment; the new dedicated activation test overrides and checks its own boundary. Express quorum amount limits with FormatMoney so tests follow the configured DOGE units rather than hardcoding XEC decimal precision.

diff --git a/src/avalanche/test/processor_tests.cpp b/src/avalanche/test/processor_tests.cpp
index 33137a4ecc976cb55db2effa35b5723c3e868952..ea79f3b9bbb41a95b2f35733a28489822ca91a41 100644
--- a/src/avalanche/test/processor_tests.cpp
+++ b/src/avalanche/test/processor_tests.cpp
@@ -136,6 +136,7 @@ CService ip(uint32_t i) {
 
 struct AvalancheProcessorTestingSetup : public AvalancheTestChain100Setup {
     AvalancheProcessorTestingSetup() : AvalancheTestChain100Setup() {
+        setArg("-shibusawaactivationtime", "0");
         AvalancheTest::setStakingPreconsensus(*m_node.avalanche, false);
     }
 
@@ -1891,7 +1892,7 @@ BOOST_AUTO_TEST_CASE(quorum_detection_parameter_validation) {
             // Min stake is out of range
             {"-1", "0", "0", false},
             {"-0.00000001", "0", "0", false},
-            {"10000000000.00000001", "0", "0", false},
+            {FormatMoney(MAX_MONEY + SATOSHI), "0", "0", false},
 
             // Min connected ratio is out of range
             {"0", "-1", "0", false},
@@ -1907,7 +1908,7 @@ BOOST_AUTO_TEST_CASE(quorum_detection_parameter_validation) {
             {"0.00000100", "0.1", "0", true},
             {"0.00001000", "0.5", "0", true},
             {"0.00001000", "1", "0", true},
-            {"10000000000.00000000", "0", "0", true},
+            {FormatMoney(MAX_MONEY), "0", "0", true},
             {"0", "0", "1", true},
             {"0", "0", "100", true},
         };
