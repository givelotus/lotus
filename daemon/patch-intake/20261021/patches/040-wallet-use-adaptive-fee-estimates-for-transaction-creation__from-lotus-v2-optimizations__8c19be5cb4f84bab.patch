From b696d34cfd67141ee2655721165fab384597aa19 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] wallet: use adaptive fee estimates for transaction creation

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Add exponential moving average (EMA) adaptive block size controller and
wallet fee estimation RPC endpoints.

Original-Commit: 1e3b144a4d743cf802e0a3a90e9a4367da034b77
Original-Patch: ecash/029
Split-Concern: wallet

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/wallet/fees.cpp | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/wallet/fees.cpp b/src/wallet/fees.cpp
index 740e272950..06913a3e3d 100644
--- a/src/wallet/fees.cpp
+++ b/src/wallet/fees.cpp
@@ -6,7 +6,9 @@
 #include <wallet/fees.h>
 
 #include <config.h>
+#include <lotus_v2/fee_hysteresis.h>
 #include <txmempool.h>
+#include <util/time.h>
 #include <wallet/coincontrol.h>
 #include <wallet/wallet.h>
 
@@ -20,7 +22,15 @@ Amount GetMinimumFee(const CWallet &wallet, unsigned int nTxBytes,
 }
 
 CFeeRate GetRequiredFeeRate(const CWallet &wallet) {
-    return std::max(wallet.m_min_fee, wallet.chain().relayMinFee());
+    const int64_t now_ms =
+        TicksSinceEpoch<std::chrono::milliseconds>(NodeClock::now());
+    const uint64_t rpc_rate_per_kcu =
+        lotus::v2::GetGlobalFeeHysteresisController().GetRpcAdmissionRatePerKCu(
+            now_ms);
+    const CFeeRate hysteresis_min_fee(
+        Amount(static_cast<int64_t>(rpc_rate_per_kcu) * SATOSHI));
+    return std::max({wallet.m_min_fee, wallet.chain().relayMinFee(),
+                     hysteresis_min_fee});
 }
 
 CFeeRate GetMinimumFeeRate(const CWallet &wallet,
@@ -37,6 +47,19 @@ CFeeRate GetMinimumFeeRate(const CWallet &wallet,
         if (neededFeeRate == CFeeRate()) {
             neededFeeRate = wallet.m_fallback_fee;
         }
+        const int64_t now_ms =
+            TicksSinceEpoch<std::chrono::milliseconds>(NodeClock::now());
+        const lotus::v2::FeeRateInfo fee_info =
+            lotus::v2::GetGlobalFeeHysteresisController().GetFeeRateInfo(
+                now_ms);
+        if (fee_info.rpc_admission_feerate_per_kcu >
+            fee_info.consensus_floor_per_kcu) {
+            neededFeeRate = std::max(
+                neededFeeRate,
+                CFeeRate(Amount(static_cast<int64_t>(
+                                    fee_info.recommended_sdk_feerate_per_kcu) *
+                                SATOSHI)));
+        }
     }
 
     // Prevent user from paying a fee below the min relay fee.
