From eab6ce9efb8bd2a85a2908ddb5b5a7cf1ec3cbad Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:28:19 -0700
Subject: [PATCH] chronik: preserve Dogecoin signed transaction versions

Doged retains signed legacy transaction versions in C++, Rust and protobuf. Restore the matching Chronik bridge/schema representations on current ABC without changing serialization bytes. Positive version encodings remain identical; negative versions use the existing Doged int32 protobuf interface.

Reference: doged 9690833b8b6709b7a7837bc397f0d04bf3b885d1
Upstream difference: b44e0d387040ea35286f3f76d3a7eeab885aa356 changes these fields to unsigned and is deliberately not imported for Dogecoin.

diff --git a/chronik/bitcoinsuite-core/src/tx/tx.rs b/chronik/bitcoinsuite-core/src/tx/tx.rs
index 0314d0c09a4924e776f6765e86dd27531c51ec7b..1b3393d9cbc6bcda3ca227bdf58d89ba292c7fb9 100644
--- a/chronik/bitcoinsuite-core/src/tx/tx.rs
+++ b/chronik/bitcoinsuite-core/src/tx/tx.rs
@@ -50,7 +50,7 @@ pub struct Tx {
 #[derive(Clone, Debug, Default, Eq, Hash, Ord, PartialEq, PartialOrd)]
 pub struct TxMut {
     /// nVersion of the tx.
-    pub version: u32,
+    pub version: i32,
     /// Tx inputs.
     pub inputs: Vec<TxInput>,
     /// Tx outputs.
diff --git a/chronik/chronik-bridge/src/ffi.rs b/chronik/chronik-bridge/src/ffi.rs
index 3635d3228c3f4f9be77ef3da3223bdcdb7a52a28..4a4ae91f18301c39cac017a80dbc0bf735f55007 100644
--- a/chronik/chronik-bridge/src/ffi.rs
+++ b/chronik/chronik-bridge/src/ffi.rs
@@ -75,7 +75,7 @@ mod ffi_inner {
         /// TxId of the tx.
         pub txid: [u8; 32],
         /// nVersion of the tx.
-        pub version: u32,
+        pub version: i32,
         /// Tx inputs.
         pub inputs: Vec<TxInput>,
         /// Tx outputs.
diff --git a/chronik/chronik-proto/proto/chronik.proto b/chronik/chronik-proto/proto/chronik.proto
index 5066db0424d61b3924ad1d0d12d171cfcabf0ac5..c8503bb919f8f662fa63286c2285fcbb0b8c7843 100644
--- a/chronik/chronik-proto/proto/chronik.proto
+++ b/chronik/chronik-proto/proto/chronik.proto
@@ -85,7 +85,7 @@ message Tx {
     // TxId (little-endian) of the tx
     bytes txid = 1;
     // nVersion
-    uint32 version = 2;
+    int32 version = 2;
     // Inputs of the tx (aka. `vin`)
     repeated TxInput inputs = 3;
     // Outputs of the tx (aka. `vout`)
