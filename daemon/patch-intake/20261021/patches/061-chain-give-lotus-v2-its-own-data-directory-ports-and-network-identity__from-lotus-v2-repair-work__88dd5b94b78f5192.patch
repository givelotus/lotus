new file mode 100644
index 0000000000000000000000000000000000000000..92ef3620c39e9b8502d838b0e266187162124933
--- /dev/null
+++ b/src/networks/lotus/chainparamsconstants.cpp
@@ -0,0 +1,21 @@
+/**
+ * Lotus V2 chain constants. The Lotus V2 networks have no history yet, so
+ * there is no minimum chain work, no assume-valid block, and no size estimate
+ * beyond a small default. Regenerate with
+ * contrib/devtools/chainparams/generate_chainparams_constants.py once the
+ * networks have real chains.
+ */
+
+#include <chainparamsconstants.h>
+
+namespace ChainParamsConstants {
+    const BlockHash MAINNET_DEFAULT_ASSUME_VALID = BlockHash();
+    const uint256 MAINNET_MINIMUM_CHAIN_WORK = uint256();
+    const uint64_t MAINNET_ASSUMED_BLOCKCHAIN_SIZE = 1;
+    const uint64_t MAINNET_ASSUMED_CHAINSTATE_SIZE = 1;
+
+    const BlockHash TESTNET_DEFAULT_ASSUME_VALID = BlockHash();
+    const uint256 TESTNET_MINIMUM_CHAIN_WORK = uint256();
+    const uint64_t TESTNET_ASSUMED_BLOCKCHAIN_SIZE = 1;
+    const uint64_t TESTNET_ASSUMED_CHAINSTATE_SIZE = 1;
+} // namespace ChainParamsConstants
diff --git a/src/networks/lotus/checkpoints.cpp b/src/networks/lotus/checkpoints.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ec84fdbf761ed455522f88a527899c60fd4dcae0
--- /dev/null
+++ b/src/networks/lotus/checkpoints.cpp
@@ -0,0 +1,32 @@
+// Copyright (c) 2020 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <chainparams.h>
+#include <common/system.h>
+#include <util/chaintype.h>
+
+// The Lotus V2 networks have no history yet, so mainnet and testnet have no
+// checkpoints. Regtest checkpoints its genesis block.
+static CCheckpointData mainNetCheckpointData = {.mapCheckpoints = {}};
+
+static CCheckpointData testNetCheckpointData = {.mapCheckpoints = {}};
+
+static CCheckpointData regTestCheckpointData = {
+    .mapCheckpoints = {
+        {0, *BlockHash::FromHex("720da0e6627eb824fb69ad12fd5162fd02ea91775c4"
+                                "a04e7561c99b7e50723e4")},
+    }};
+
+const CCheckpointData &CheckpointData(const ChainType chain) {
+    switch (chain) {
+        case ChainType::MAIN:
+            return mainNetCheckpointData;
+        case ChainType::TESTNET:
+            return testNetCheckpointData;
+        case ChainType::REGTEST:
+            return regTestCheckpointData;
+    }
+    throw std::invalid_argument(
+        strprintf("%s: Invalid ChainType value", __func__));
+}
