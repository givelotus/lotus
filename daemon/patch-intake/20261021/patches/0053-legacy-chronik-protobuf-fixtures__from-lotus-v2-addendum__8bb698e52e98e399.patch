From d56be4eba3d2c6a3fd67768e80f3eb41dcafe04a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 01:40:58 -0700
Subject: [PATCH] fixup! chronik(v2): retain legacy identities and coins in
 both indexes

Assert explicit legacy coin kind on every expected legacy-created output and resolved spent input. Keep coinbase dummy input false, exact transaction bodies, identities, accounting and pagination assertions. Before protobuf differences are independently classified as only missing true flags.

Tier: V2 (fixup to chronik(v2): retain legacy identities and coins in both indexes)
---
 test/functional/chronik_block_txs.py              | 8 ++++++++
 test/functional/chronik_script_unconfirmed_txs.py | 3 +++
 test/functional/chronik_unconfirmed_txs.py        | 3 +++
 3 files changed, 14 insertions(+)

diff --git a/test/functional/chronik_block_txs.py b/test/functional/chronik_block_txs.py
index d97f268fea..42809ac2ce 100644
--- a/test/functional/chronik_block_txs.py
+++ b/test/functional/chronik_block_txs.py
@@ -135,10 +135,12 @@ class ChronikBlockTxsTest(BitcoinTestFramework):
             ],
             outputs=[
                 pb.TxOutput(
+                    is_legacy=True,
                     sats=coinvalue,
                     output_script=bytes(tx_coinbase.vout[0].scriptPubKey),
                 ),
                 pb.TxOutput(
+                    is_legacy=True,
                     output_script=bytes(CScript([OP_RETURN])),
                 ),
             ],
@@ -153,6 +155,7 @@ class ChronikBlockTxsTest(BitcoinTestFramework):
             version=1,
             inputs=[
                 pb.TxInput(
+                    is_legacy=True,
                     prev_out=pb.OutPoint(txid=bytes.fromhex(cointx)[::-1], out_idx=0),
                     input_script=bytes(SCRIPTSIG_OP_TRUE),
                     output_script=bytes(P2SH_OP_TRUE),
@@ -162,6 +165,7 @@ class ChronikBlockTxsTest(BitcoinTestFramework):
             ],
             outputs=[
                 pb.TxOutput(
+                    is_legacy=True,
                     sats=coinvalue - 10000,
                     output_script=bytes(P2SH_OP_TRUE),
                     spent_by=pb.SpentBy(
@@ -170,6 +174,7 @@ class ChronikBlockTxsTest(BitcoinTestFramework):
                     ),
                 ),
                 pb.TxOutput(
+                    is_legacy=True,
                     sats=1000,
                     output_script=bytes(CScript([OP_RETURN, b"test"])),
                 ),
@@ -184,6 +189,7 @@ class ChronikBlockTxsTest(BitcoinTestFramework):
             version=1,
             inputs=[
                 pb.TxInput(
+                    is_legacy=True,
                     prev_out=pb.OutPoint(
                         txid=bytes.fromhex(tx1.txid_hex)[::-1], out_idx=0
                     ),
@@ -195,10 +201,12 @@ class ChronikBlockTxsTest(BitcoinTestFramework):
             ],
             outputs=[
                 pb.TxOutput(
+                    is_legacy=True,
                     sats=3000,
                     output_script=bytes(CScript([OP_RETURN, b"test"])),
                 ),
                 pb.TxOutput(
+                    is_legacy=True,
                     sats=coinvalue - 20000,
                     output_script=bytes(P2SH_OP_TRUE),
                 ),
