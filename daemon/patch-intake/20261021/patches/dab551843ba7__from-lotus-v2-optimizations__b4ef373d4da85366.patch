From dab551843ba7ec04e4fbc09ac666b70eabd4c03f Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:56:59 -0700
Subject: [PATCH] fixup! chronik: offload ChronikValidationInterface callbacks
 to dedicated worker thread

Keep Enqueue strongly exception-safe: append before publishing submission counters, and route allocation failure to fatal callback outside mutex. Fault injection reproduces phantom fence submission before and drains after.
---
 src/util/bounded_task_queue.h | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/util/bounded_task_queue.h b/src/util/bounded_task_queue.h
index 49f7e91195..33aa33279f 100644
--- a/src/util/bounded_task_queue.h
+++ b/src/util/bounded_task_queue.h
@@ -78,10 +78,17 @@ public:
             if (bytes > m_byte_limit - m_bytes || m_count >= m_count_limit) {
                 m_failed = m_stopping = notify_failure = true;
             } else {
-                m_bytes += bytes;
-                ++m_count;
-                ++m_submitted;
-                m_tasks.push_back({bytes, std::move(run)});
+                try {
+                    // Publish the reservation/sequence only after deque
+                    // allocation succeeds. A failed append must not leave a
+                    // phantom submission that Sync() can never complete.
+                    m_tasks.push_back({bytes, std::move(run)});
+                    m_bytes += bytes;
+                    ++m_count;
+                    ++m_submitted;
+                } catch (...) {
+                    m_failed = m_stopping = notify_failure = true;
+                }
             }
         }
         m_ready.notify_one();
