From 8119122b6e68b789c16048f7c0fc9c48fbb44d7e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 07:23:38 -0700
Subject: [PATCH] fixup! [v2 only] net: cache dictionary-versioned independent
 compressed block frames

Complete reuse of the shared independent-frame codec declarations when layering native dictionary-versioned frames. The normal native ChronikON/walletON build exposes a second RSV2 constant; remove its redundant include and identical receive-state assignment in the same adaptation. Keep the documented shared RSV2 constant, the receive-state update, all RSV1/RSV2 guards and all compression/decompression branches unchanged. Bounded codec/sock review found no duplicate function bodies; the two socket constructors are intentional overloads.
---
 src/net_websocket_codec.cpp | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/src/net_websocket_codec.cpp b/src/net_websocket_codec.cpp
index 7890bc544f..182bf5bfbe 100644
--- a/src/net_websocket_codec.cpp
+++ b/src/net_websocket_codec.cpp
@@ -5,8 +5,6 @@
 #include <net_websocket_codec.h>
 #include <net_zstd_independent.h>
 
-#include <net_zstd_independent.h>
-
 #include <tinyformat.h>
 
 #include <algorithm>
@@ -24,7 +22,6 @@ constexpr uint8_t OP_PONG = 0xA;
 constexpr uint8_t RSV2 = 0x20;
 //! The "per-message compressed" bit (as in RFC 7692)
 constexpr uint8_t RSV1 = 0x40;
-constexpr uint8_t RSV2 = 0x20;
 
 /** Parsed frame header */
 struct FrameHeader {
@@ -337,7 +334,6 @@ WebSocketCodec::Decode(Span<const uint8_t> in, std::vector<uint8_t> &plain,
                 if (h->opcode == OP_BINARY) {
                     m_message_independent = h->rsv == RSV2;
                     m_message_compressed = h->rsv == RSV1;
-                    m_message_independent = h->rsv == RSV2;
                 }
                 m_in_message = !h->fin;
                 unmask_into(m_message);
