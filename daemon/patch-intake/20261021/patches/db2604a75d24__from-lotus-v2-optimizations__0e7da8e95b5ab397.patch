From db2604a75d24064d3d588538aee1641ba5912c48 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 23:03:53 -0700
Subject: [PATCH] fixup! net: batch-validate solicited/high-bandwidth SHORTTX
 and coalesce incoming TX bursts

Record real burst admission count and diagnostic elapsed time in regression output; do not present tracing microfixture as signed-transaction throughput.
---
 src/test/v2_protocol_handler_tests.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/test/v2_protocol_handler_tests.cpp b/src/test/v2_protocol_handler_tests.cpp
index 5616cade33..b71049dcd9 100644
--- a/src/test/v2_protocol_handler_tests.cpp
+++ b/src/test/v2_protocol_handler_tests.cpp
@@ -1598,7 +1598,12 @@ BOOST_AUTO_TEST_CASE(invalid_last_member_does_not_double_burst_admission_work) {
             if (line.find("tx-admission-precheck txid=") != std::string::npos)
                 ++checks;
         });
+    const auto started_at = std::chrono::steady_clock::now();
     connman->ProcessMessagesOnce(node);
+    const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - started_at);
+    BOOST_TEST_MESSAGE("256-TX burst admission_prechecks=" << checks.load()
+                       << " diagnostic_elapsed_us=" << elapsed.count());
     LogInstance().DeleteCallback(callback);
     if (!logged_before) LogInstance().DisableCategory(BCLog::TXPACKAGES);
     BOOST_CHECK_GT(checks.load(), 0);
