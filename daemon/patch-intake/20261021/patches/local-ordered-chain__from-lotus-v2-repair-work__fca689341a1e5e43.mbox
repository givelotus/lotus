From a09a5978cc6b474292eaabab437bb8107e337a96 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:13:35 -0700
Subject: [PATCH 02/49] fixup! mempool: add persistent Merklix overlay arenas
 and O(1) commitment helpers with CSHA256

Adapt the independent sparse vector generator to the direct OutpointKey mapping already used by the sparse implementation and fixtures: XOR the LE32 output index into txid bytes28..31. Select explicit collision-prefix indices and assert their shared/differing bits.

Run with python-blake31.0.11. The independent pre-C17a control reproduces every existing key/leaf/root/state expected value exactly; production codec and consensus are untouched. C17a provenance bytes are a separate owner concern.

Tier: V2
---
 src/lotus_v2/generate_sparse_vectors.py | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/lotus_v2/generate_sparse_vectors.py b/src/lotus_v2/generate_sparse_vectors.py
index 5629002c61..d953b5443e 100644
--- a/src/lotus_v2/generate_sparse_vectors.py
+++ b/src/lotus_v2/generate_sparse_vectors.py
@@ -30,7 +30,10 @@ OUTPUT = b"\x00" + le(1000, 8) + b"\x01" + b"\x11" * 32 + b"\x01\x01\x00"
 def coin(index, height=7, mtp=1234, coinbase=1):
     outpoint = TXID + le(index, 4)
     record = outpoint + cs(len(OUTPUT)) + OUTPUT + le(height, 8) + le(mtp, 8) + bytes([coinbase])
-    key = h("outpointkey", outpoint)
+    key = bytearray(TXID)
+    for i, byte in enumerate(le(index, 4)):
+        key[28 + i] ^= byte
+    key = bytes(key)
     leaf = h("utxo", b"\x00" + key + cs(len(record)) + record)
     return key, leaf, record
 
@@ -55,8 +58,11 @@ def tree(coins, depth=0):
 def main():
     assert blake3.__version__ == "1.0.11"
     first = coin(0)
-    same_prefix = next(i for i in range(1, 1000) if coin(i)[0][0] & 15 == first[0][0] & 15)
-    other_first_bit = next(i for i in range(1, 1000) if bit(coin(i)[0], 0) != bit(first[0], 0))
+    same_prefix = 48
+    assert all(bit(coin(same_prefix)[0], d) == bit(first[0], d) for d in range(228))
+    assert bit(coin(same_prefix)[0], 228) != bit(first[0], 228)
+    other_first_bit = 1
+    assert bit(coin(other_first_bit)[0], 224) != bit(first[0], 224)
     second, third = coin(same_prefix), coin(other_first_bit)
     monetary = le(11, 8) + le(22, 8) + bytes(range(32)) + le(33, 8)
     chain = bytes(range(32, 64))
-- 
