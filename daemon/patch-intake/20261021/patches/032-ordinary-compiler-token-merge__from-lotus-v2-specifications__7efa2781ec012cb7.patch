From 710b409b13d76b845ee3c3543995c0d278c7ee13 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 20:27:28 -0700
Subject: [PATCH] Validate the compiler two-input token merge in ordinary
 validation

Refresh the pinned compiler fixture header from fungible-token-v2.json
(SHA-256 5e9151b9...fc716), generated by the compiler's
test/emit-ordinary-fixture-header.mjs. The token source now requires both
the FungibleRules and TokenWallet roots on every token output path, so the
mint and transfer bytes and token ID change; the funding coin is unchanged.

After the signed mint and transfer, apply the signed merge that spends the
700- and 250-unit token outputs and the native change into one 950-unit
token output: two wallet+rules witnesses per token input, fee 1500, token
output floor 1000, no token burn. A 951-unit output, a dropped token input
and a missing rules witness each reject without changing the view.
---
 .../ordinary_test/compiler_mint_fixture.h     | 18 +++++---
 src/lotus_v2/test_ordinary_validation.cpp     | 45 +++++++++++++++++++
 2 files changed, 56 insertions(+), 7 deletions(-)

diff --git a/src/lotus_v2/ordinary_test/compiler_mint_fixture.h b/src/lotus_v2/ordinary_test/compiler_mint_fixture.h
index a921349f6..b3d8f0fde 100644
--- a/src/lotus_v2/ordinary_test/compiler_mint_fixture.h
+++ b/src/lotus_v2/ordinary_test/compiler_mint_fixture.h
@@ -1,14 +1,18 @@
 // Imported immutable compiler fixture from tools/lotus-v2-compiler/fixtures/fungible-token-v2.json
-// SHA-256: 8fe8b6fefa64f6878832d5bf79c4659c24806b08c9fed85fd06df55ca52a431f
+// SHA-256: 5e9151b9e9b3c44b3eca295e6799dfd84dbeba0ce694209e3c3afc98a38fc716
+// Generated by tools/lotus-v2-compiler/test/emit-ordinary-fixture-header.mjs
 #ifndef LOTUS_V2_COMPILER_MINT_FIXTURE_H
 #define LOTUS_V2_COMPILER_MINT_FIXTURE_H
 namespace compiler_fixture {
-inline constexpr const char *mint_wire = "";
-inline constexpr const char *mint_txid = "7fcd1e2cdfe961aeb0e48f5262143b7aa5162d5458eff117a03eb5653fc8b8fb";
-inline constexpr const char *mint_txhash = "498189d2917f1c5437183b9951c54e8d920524474b8eec086ca6e339d6a1636a";
-inline constexpr const char *transfer_wire = "";
-inline constexpr const char *transfer_txid = "3c9943b0aafc76b732c4b922c018397bd81ab692d630d3fbf75407e661877922";
-inline constexpr const char *transfer_txhash = "863eedbb2f7b516dea03bda79d439e940e611d6d0705db547fae883c24130bdd";
+inline constexpr const char *mint_wire = "";
+inline constexpr const char *mint_txid = "d88b8f660481107ff14e787ac6520a7c3b705a7226141fb24858385de563e8cb";
+inline constexpr const char *mint_txhash = "81819d6328a972bf7894d46733cf75df8bc8465e53c8b4ae08d8b86365fe81f4";
+inline constexpr const char *transfer_wire = "";
+inline constexpr const char *transfer_txid = "699f54f8795af95181a22f6cd9fd0f09668a9c45bcf5b83aeaddf4fc3635fbd7";
+inline constexpr const char *transfer_txhash = "e7357689ede74f0848a21eaae04453e960757b23eed79faf180e28b42853197b";
+inline constexpr const char *merge_wire = "";
+inline constexpr const char *merge_txid = "311760fab671a0e2f186b0fb7c1e77fefaea9da7ce60744801f0f9ea8ac28f3c";
+inline constexpr const char *merge_txhash = "07ea13aa0a1350536a937b091e3eac9c93ab2bf1c6f4d248578a013bfbd63d9e";
 inline constexpr const char *funding_coin_wire = "00102700000000000001843a62fb547cdf26e266a3c9143af56134644c103387ad6f0943e9d59a614b1a010100";
 inline constexpr const char *chain_id = "4444444444444444444444444444444444444444444444444444444444444444";
 } // namespace compiler_fixture
diff --git a/src/lotus_v2/test_ordinary_validation.cpp b/src/lotus_v2/test_ordinary_validation.cpp
index 6aa928742..66e5d19ed 100644
--- a/src/lotus_v2/test_ordinary_validation.cpp
+++ b/src/lotus_v2/test_ordinary_validation.cpp
@@ -319,6 +319,51 @@ void CompilerMintAndTransfer() {
     CHECK(effects.txhash == HashHex(compiler_fixture::transfer_txhash));
     CHECK(effects.native_fee == 3000 && view.size() == 3);
     CHECK(effects.token_output_burn_floor == 2000);
+
+    // Merge both transfer token outputs (700 + 250) into one 950-unit output.
+    Transaction merge;
+    CHECK(DecodeTransaction(Hex(compiler_fixture::merge_wire), tx_profile,
+                            merge, error));
+    CHECK(mint.outputs[0].HasToken());
+    const Hash token_id = mint.outputs[0].token_id;
+    size_t token_inputs = 0;
+    for (const Input &input : merge.inputs) {
+        CHECK(input.flags == 1 &&
+              input.prev_txid == HashHex(compiler_fixture::transfer_txid));
+        const auto coin = view.find({input.prev_txid, input.prev_index});
+        CHECK(coin != view.end());
+        if (coin->second.output.HasToken() &&
+            coin->second.output.token_id == token_id) {
+            ++token_inputs;
+            CHECK(input.witnesses.size() == 2); // wallet and rules branches
+        }
+    }
+    CHECK(token_inputs == 2 && merge.outputs.size() == 2);
+    CHECK(merge.outputs[0].HasToken() && merge.outputs[0].token_id == token_id &&
+          merge.outputs[0].value == 950 && !merge.outputs[0].IsBurn());
+    // Altering the merged amount, dropping one token input, or omitting one
+    // required witness must reject without changing the view.
+    Transaction inflated = merge;
+    inflated.outputs[0].value = 951;
+    RejectWithoutMutation(inflated, profile, view, chain_id);
+    Transaction one_input = merge;
+    one_input.inputs.erase(one_input.inputs.begin() + 1);
+    RejectWithoutMutation(one_input, profile, view, chain_id);
+    Transaction missing_rules = merge;
+    missing_rules.inputs[1].witnesses.pop_back();
+    RejectWithoutMutation(missing_rules, profile, view, chain_id);
+    profile.candidate_height = 102;
+    profile.parent_mtp = 50200;
+    CHECK(ApplyOrdinaryCandidate(merge, profile, chain_id, view, effects,
+                                 error));
+    CHECK(effects.txid == HashHex(compiler_fixture::merge_txid));
+    CHECK(effects.txhash == HashHex(compiler_fixture::merge_txhash));
+    CHECK(effects.native_fee == 1500 && effects.token_output_burn_floor == 1000);
+    CHECK(effects.consumed.size() == 3 && effects.created.size() == 2);
+    CHECK(view.size() == 2);
+    const Coin &merged = effects.created[0];
+    CHECK(view.contains(merged.outpoint) && merged.output.value == 950 &&
+          merged.output.HasToken() && merged.output.token_id == token_id);
 }
 } // namespace
 
