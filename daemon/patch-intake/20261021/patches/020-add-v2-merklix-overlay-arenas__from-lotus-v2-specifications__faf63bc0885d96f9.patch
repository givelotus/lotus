+bool AddTransactionToOverlay(lotus::v2::MempoolOverlayLayer &overlay,
+                             const CTransactionRef &ptx,
+                             int64_t fee_sats,
+                             int64_t sigchecks) {
+    if (!ptx || ptx->IsCoinBase()) {
+        return false;
+    }
+    lotus::v2::Hash tx_id{};
+    lotus::v2::Hash tx_hash{};
+    uint64_t linear_cost = 0;
