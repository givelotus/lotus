+void CollectSmtCoins(const std::shared_ptr<const SmtNode> &node,
+                     std::vector<lotus::v2::Coin> &out) {
+    if (!node) {
+        return;
+    }
+    if (node->IsLeaf()) {
+        out.push_back(*node->coin);
+        return;
+    }
+    CollectSmtCoins(node->child[0], out);
+    CollectSmtCoins(node->child[1], out);
+}
