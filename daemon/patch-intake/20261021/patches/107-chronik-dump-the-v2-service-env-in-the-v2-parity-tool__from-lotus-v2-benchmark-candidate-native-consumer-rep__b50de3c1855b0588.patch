From 2cab3f0e5381b1d982840582480cf01ce4279bba Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 08:39:30 -0700
Subject: [PATCH] chronik: dump the V2 service env in the V2 parity tool

chronik-native-lotus-v2-dump now also prints the v2_index env nested in the
legacy env's directory: every subdatabase as raw MDBX keys and values
(prefixed "v2_index:"), and the size and SHA-256 of each flat segment file,
so the parity harness compares the V2 service's storage of the Rust and
native nodes.

Tier: V2
---
 .../ext/lotus_v2/tools/lotus_v2_dump.cpp      | 65 +++++++++++++++++++
 contrib/chronik-parity/README.md              |  4 +-
 2 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/chronik/native/ext/lotus_v2/tools/lotus_v2_dump.cpp b/chronik/native/ext/lotus_v2/tools/lotus_v2_dump.cpp
index addd8842890afb337346d9fe325addf42da6b237..c655d108d404a93c7b31e46c273ba758da15ce0f 100644
--- a/chronik/native/ext/lotus_v2/tools/lotus_v2_dump.cpp
+++ b/chronik/native/ext/lotus_v2/tools/lotus_v2_dump.cpp
@@ -7,22 +7,85 @@
 // env of a Lotus V2 node (eCash tables plus the six V2 group tables) as
 // sorted "table<TAB>key_hex<TAB>value_hex" lines. Run it on the index of a
 // stopped node (<datadir>/<net>/indexes/chronik).
+//
+// If the V2 service's env exists (<dir>/v2_index), its subdatabases follow
+// as "v2_index:<table>" lines (raw MDBX keys and values, as both
+// implementations share the layout), then one "v2_index:flat" line per flat
+// segment file: file name (hex), size and SHA-256 of its contents.
 
 #include <chronik/native/mdbx_store.h>
 #include <chronik/native/schema.h>
 #include <core/db/dump.h>
 
+#include <ext/lotus_v2/db/env.h>
 #include <ext/lotus_v2/groups/groups.h>
 
 // Portable SHA-256, only needed to open envs with hashed long keys.
 #include <test/test_sha256.h>
 
+#include <algorithm>
+#include <cstdio>
 #include <filesystem>
+#include <fstream>
 #include <iostream>
+#include <iterator>
+#include <sstream>
 #include <string>
+#include <vector>
 
 using namespace chronik::native;
 
+namespace {
+
+std::string Hex(const uint8_t *data, size_t len) {
+    static const char digits[] = "0123456789abcdef";
+    std::string out;
+    out.reserve(2 * len);
+    for (size_t i = 0; i < len; ++i) {
+        out.push_back(digits[data[i] >> 4]);
+        out.push_back(digits[data[i] & 0xf]);
+    }
+    return out;
+}
+
+/** The v2_index env and its flat segment files, if the env exists. */
+void DumpV2Index(const std::filesystem::path &dir, std::ostream &out) {
+    if (!std::filesystem::is_regular_file(dir / "mdbx.dat")) {
+        return;
+    }
+    {
+        const lotus_v2::V2Env env(dir);
+        std::ostringstream tables;
+        db::DumpStore(env.Store(), lotus_v2::V2Env::Tables(), tables);
+        std::istringstream lines(tables.str());
+        for (std::string line; std::getline(lines, line);) {
+            out << "v2_index:" << line << "\n";
+        }
+    }
+    std::vector<std::filesystem::path> segments;
+    for (const auto &entry : std::filesystem::directory_iterator(dir)) {
+        const std::string name = entry.path().filename().string();
+        if (entry.is_regular_file() && name.starts_with("v2_tx_") &&
+            name.ends_with(".dat")) {
+            segments.push_back(entry.path());
+        }
+    }
+    std::sort(segments.begin(), segments.end());
+    for (const auto &path : segments) {
+        std::ifstream file(path, std::ios::binary);
+        const Bytes bytes((std::istreambuf_iterator<char>(file)),
+                          std::istreambuf_iterator<char>());
+        uint8_t hash[32];
+        test::TestSha256(bytes, hash);
+        const std::string name = path.filename().string();
+        out << "v2_index:flat\t"
+            << Hex(reinterpret_cast<const uint8_t *>(name.data()), name.size())
+            << "\t" << bytes.size() << ":" << Hex(hash, 32) << "\n";
+    }
+}
+
+} // namespace
+
 int main(int argc, char **argv) {
     if (argc != 2 || std::string(argv[1]) == "-h" ||
         std::string(argv[1]) == "--help") {
@@ -48,6 +111,8 @@ int main(int argc, char **argv) {
         auto store =
             OpenMdbxStore(dir, schema.Tables(), opts, ChronikIndexProfile());
         db::DumpStore(*store, schema.Tables(), std::cout);
+        store.reset();
+        DumpV2Index(dir / "v2_index", std::cout);
     } catch (const std::exception &e) {
         std::cerr << "chronik-native-lotus-v2-dump: " << e.what() << "\n";
         return 1;
diff --git a/contrib/chronik-parity/README.md b/contrib/chronik-parity/README.md
index 7720274c7afd7572f9197a6d1c877a3141a9874a..b6fc6b0e43337a44b2260b07d927b6c9dfd184a2 100644
