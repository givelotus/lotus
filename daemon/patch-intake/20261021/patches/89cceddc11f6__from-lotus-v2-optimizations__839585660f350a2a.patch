From 89cceddc11f6d1e8dc40f499b68400ebc26b5028 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 23:08:13 -0700
Subject: [PATCH] fixup! net: batch-validate solicited/high-bandwidth SHORTTX
 and coalesce incoming TX bursts

Read active-chain tip under cs_main in burst test setup, preserving lock diagnostics.
---
 src/test/v2_protocol_handler_tests.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/test/v2_protocol_handler_tests.cpp b/src/test/v2_protocol_handler_tests.cpp
index fa8516361b..326fb7b1cd 100644
--- a/src/test/v2_protocol_handler_tests.cpp
+++ b/src/test/v2_protocol_handler_tests.cpp
@@ -1533,7 +1533,7 @@ BOOST_AUTO_TEST_CASE(malformed_later_tx_does_not_discard_decoded_prefix) {
     opts.m_msgproc = {peerman.get()};
     opts.nSendBufferMaxSize = 1024 * 1024;
     connman->Init(opts);
-    SetMockTime(m_node.chainman->ActiveChain().Tip()->GetBlockTime());
+    WITH_LOCK(cs_main, SetMockTime(m_node.chainman->ActiveChain().Tip()->GetBlockTime()));
     BOOST_REQUIRE(!m_node.chainman->IsInitialBlockDownload());
     CAddress addr(MakeTestIp(0xa0b0c050), NODE_NONE);
     CNode node(500, nullptr, addr, 0, 0, 0, CAddress(), "",
@@ -1568,7 +1568,7 @@ BOOST_AUTO_TEST_CASE(invalid_last_member_does_not_double_burst_admission_work) {
     opts.m_msgproc = {peerman.get()};
     opts.nSendBufferMaxSize = 1024 * 1024;
     connman->Init(opts);
-    SetMockTime(m_node.chainman->ActiveChain().Tip()->GetBlockTime());
+    WITH_LOCK(cs_main, SetMockTime(m_node.chainman->ActiveChain().Tip()->GetBlockTime()));
     BOOST_REQUIRE(!m_node.chainman->IsInitialBlockDownload());
     CAddress addr(MakeTestIp(0xa0b0c051), NODE_NONE);
     CNode node(501, nullptr, addr, 0, 0, 0, CAddress(), "",
