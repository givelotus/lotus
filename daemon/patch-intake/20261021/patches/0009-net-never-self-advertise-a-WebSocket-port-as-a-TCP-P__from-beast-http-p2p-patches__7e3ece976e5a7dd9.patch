From d10daac6a346f0ff5e8b799b2180463f547fa940 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 19:00:36 -0700
Subject: [PATCH 09/28] net: never self-advertise a WebSocket port as a TCP P2P
 address

GetLocalAddrForPeer() may adopt the address a peer reports seeing us at.
For inbound peers ABC takes that report's port too, since such a peer
reached our listening port. An inbound /p2p/ws peer, however, reached the
HTTP/WebSocket endpoint (-publicbind or the RPC port), so with a routable
address we could advertise IP:<websocket port> as a plain TCP P2P address
and third parties would try P2P against the HTTP server.

For WebSocket peers, take only the reported IP and keep our P2P port, as
for outbound peers. Likewise, if the best local address is the
-externaldomain NET_WSS entry, never pair its wss:// port with an IP.
WebSocket reachability is advertised only through -externaldomain
(NET_WSS over ADDRv2).

The extended get_local_addr_for_peer_port test fails without this change.
---
 src/net.cpp            | 10 ++++++++--
 src/test/net_tests.cpp | 21 +++++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/src/net.cpp b/src/net.cpp
index 30d1161c8c..35c36d6912 100644
--- a/src/net.cpp
+++ b/src/net.cpp
@@ -256,7 +256,7 @@ std::optional<CService> GetLocalAddrForPeer(CNode &node) {
     if (IsPeerAddrLocalGood(&node) &&
         (!addrLocal.IsRoutable() ||
          rng.randbits((GetnScore(addrLocal) > LOCAL_MANUAL) ? 3 : 1) == 0)) {
-        if (node.IsInboundConn()) {
+        if (node.IsInboundConn() && !node.m_websocket_info) {
             // For inbound connections, assume both the address and the port
             // as seen from the peer.
             addrLocal = CService{node.GetAddrLocal()};
@@ -265,7 +265,13 @@ std::optional<CService> GetLocalAddrForPeer(CNode &node) {
             // the peer and leave the port in `addrLocal` as returned by
             // `GetLocalAddress()` above. The peer has no way to observe our
             // listening port when we have initiated the connection.
-            addrLocal.SetIP(node.GetAddrLocal());
+            // The same holds for WebSocket peers: the port they reached is
+            // the HTTP/WebSocket endpoint, not our TCP P2P port. And if the
+            // best local address was a NET_WSS name, its port is that of the
+            // wss:// endpoint, so use our P2P listening port.
+            const uint16_t port{addrLocal.IsWSS() ? GetListenPort()
+                                                  : addrLocal.GetPort()};
+            addrLocal = CService{node.GetAddrLocal(), port};
         }
     }
     if (addrLocal.IsRoutable() || gArgs.GetBoolArg("-addrmantest", false)) {
diff --git a/src/test/net_tests.cpp b/src/test/net_tests.cpp
index ec1ce7b5a9..cbff02acca 100644
--- a/src/test/net_tests.cpp
+++ b/src/test/net_tests.cpp
@@ -1036,6 +1036,27 @@ BOOST_AUTO_TEST_CASE(get_local_addr_for_peer_port) {
     BOOST_REQUIRE(chosen_local_addr);
     BOOST_CHECK(*chosen_local_addr == peer_us);
 
+    // An inbound WebSocket peer reached our HTTP/WebSocket port, not our P2P
+    // port: only the address it saw may be used, as for outbound peers.
+    CNode peer_ws{
+        /*id=*/0,
+        /*sock=*/nullptr,
+        /*addrIn=*/CAddress{CService{peer_in_in_addr, 8333}, NODE_NETWORK},
+        /*nKeyedNetGroupIn=*/0,
+        /*nLocalHostNonceIn=*/0,
+        /*nLocalExtraEntropyIn=*/0,
+        /*addrBindIn=*/CAddress{},
+        /*addrNameIn=*/std::string{},
+        /*conn_type_in=*/ConnectionType::INBOUND,
+        /*inbound_onion=*/false,
+        CNodeOptions{.websocket_info =
+                         std::make_shared<WebSocketTransportInfo>()}};
+    peer_ws.fSuccessfullyConnected = true;
+    peer_ws.SetAddrLocal(peer_us);
+    chosen_local_addr = GetLocalAddrForPeer(peer_ws);
+    BOOST_REQUIRE(chosen_local_addr);
+    BOOST_CHECK(*chosen_local_addr == expected);
+
     m_node.args->ForceSetArg("-bind", "");
 }
 
