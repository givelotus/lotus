From 34fd4be7d65f376ba6de71ef6af8dc1f78876dd0 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:56:15 -0700
Subject: [PATCH] chronik: pass entry_time in ValidationSignals to eliminate
 mempool.cs lock

Capture entry_time synchronously when enqueuing ValidationSignals::TransactionAddedToMempool and TransactionsAddedToMempoolBatch, and pass it to CValidationInterface::TransactionAddedToMempool so ChronikValidationInterface does not need to acquire LOCK(mempool.cs) via m_node.mempool->info(txid) on every transaction.

Original-Commit: 128bda0d1783652933a8c835db2295b959474a64
Original-Patch: ecash/048
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 .../chronik-cpp/chronik_validationinterface.cpp    | 13 +++++++++----
 src/validationinterface.cpp                        | 14 +++++++++-----
 src/validationinterface.h                          |  7 +++++++
 3 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/chronik/chronik-cpp/chronik_validationinterface.cpp b/chronik/chronik-cpp/chronik_validationinterface.cpp
index 8d09d69c7bd73751153eec7c310f802ecd33c093..15f183d4811b0f730aaa888142089ea6e8824db8 100644
--- a/chronik/chronik-cpp/chronik_validationinterface.cpp
+++ b/chronik/chronik-cpp/chronik_validationinterface.cpp
@@ -47,14 +47,19 @@ private:
     rust::Box<chronik_bridge::Chronik> m_chronik;
     const node::NodeContext &m_node;
 
+    using CValidationInterface::TransactionAddedToMempool;
+
     void TransactionAddedToMempool(
         const CTransactionRef &ptx,
         std::shared_ptr<const std::vector<Coin>> spent_coins,
-        uint64_t mempool_sequence) override {
+        uint64_t /* mempool_sequence */,
+        int64_t entry_time) override {
         if (spent_coins) {
-            const TxMempoolInfo info = m_node.mempool->info(ptx->GetId());
-            m_chronik->handle_tx_added_to_mempool(*ptx, *spent_coins,
-                                                  info.m_time.count());
+            const int64_t tx_time =
+                entry_time != 0
+                    ? entry_time
+                    : m_node.mempool->info(ptx->GetId()).m_time.count();
+            m_chronik->handle_tx_added_to_mempool(*ptx, *spent_coins, tx_time);
         } else {
             LogPrintf("Chronik: transaction %s added to mempool but spent "
                       "coins are not available\n",
diff --git a/src/validationinterface.cpp b/src/validationinterface.cpp
index ead1bdc79a8b1031c787eda0d190c0e4826b2bf9..c99d083bfe33914997738058824cefb3f1597141 100644
--- a/src/validationinterface.cpp
+++ b/src/validationinterface.cpp
@@ -13,6 +13,7 @@
 #include <primitives/transaction.h>
 #include <util/check.h>
 #include <util/task_runner.h>
+#include <util/time.h>
 
 #include <future>
 #include <tuple>
@@ -199,10 +200,11 @@ void ValidationSignals::TransactionAddedToMempool(
     const CTransactionRef &tx,
     std::shared_ptr<const std::vector<Coin>> spent_coins,
     uint64_t mempool_sequence) {
-    auto event = [tx, spent_coins, mempool_sequence, this] {
+    const int64_t entry_time = GetTime<std::chrono::seconds>().count();
+    auto event = [tx, spent_coins, mempool_sequence, entry_time, this] {
         m_internals->Iterate([&](CValidationInterface &callbacks) {
             callbacks.TransactionAddedToMempool(tx, spent_coins,
-                                                mempool_sequence);
+                                                mempool_sequence, entry_time);
         });
     };
     ENQUEUE_AND_LOG_EVENT(event, "%s: txid=%s", __func__,
@@ -219,14 +221,16 @@ void ValidationSignals::TransactionsAddedToMempoolBatch(
                                   items[0].mempool_sequence);
         return;
     }
+    const int64_t entry_time = GetTime<std::chrono::seconds>().count();
     auto shared_items =
         std::make_shared<std::vector<MempoolAddedBatchItem>>(std::move(items));
     const size_t count = shared_items->size();
-    auto event = [shared_items, this] {
+    auto event = [shared_items, entry_time, this] {
         m_internals->Iterate([&](CValidationInterface &callbacks) {
             for (const auto &item : *shared_items) {
-                callbacks.TransactionAddedToMempool(item.tx, item.spent_coins,
-                                                    item.mempool_sequence);
+                callbacks.TransactionAddedToMempool(
+                    item.tx, item.spent_coins, item.mempool_sequence,
+                    entry_time);
             }
         });
     };
diff --git a/src/validationinterface.h b/src/validationinterface.h
index 1eb11421272dd7dcdb940481f921f2b026c8795e..146c346f17ff94628352ae4fff1c0873132fc580 100644
--- a/src/validationinterface.h
+++ b/src/validationinterface.h
@@ -72,6 +72,13 @@ protected:
         const CTransactionRef &tx,
         std::shared_ptr<const std::vector<Coin>> spent_coins,
         uint64_t mempool_sequence) {}
+    virtual void TransactionAddedToMempool(
+        const CTransactionRef &tx,
+        std::shared_ptr<const std::vector<Coin>> spent_coins,
+        uint64_t mempool_sequence,
+        int64_t entry_time) {
+        TransactionAddedToMempool(tx, std::move(spent_coins), mempool_sequence);
+    }
 
     /**
      * Notifies listeners of a transaction leaving mempool.
-- 
