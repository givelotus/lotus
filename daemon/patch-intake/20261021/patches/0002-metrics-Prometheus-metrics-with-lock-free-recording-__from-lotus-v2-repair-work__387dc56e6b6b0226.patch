@@ -0,0 +1,103 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <node/metrics.h>
+
+#include <httpserver.h>
+#include <logging.h>
+#include <protocol.h>
+#include <rpc/protocol.h>
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace node {
+
+namespace detail {
+    std::atomic<NodeMetrics *> g_node_metrics{nullptr};
+}
+
+namespace {
+    //! Known P2P message types, sorted, then "other" (the last label value)
+    const std::vector<std::string> &MsgTypeLabels() {
+        static const std::vector<std::string> labels{[] {
+            std::vector<std::string> v{getAllNetMessageTypes()};
+            std::sort(v.begin(), v.end());
+            v.push_back("other");
+            return v;
+        }()};
+        return labels;
+    }
+
+    //! Seconds; from an empty regtest block (~0.2 ms) to a large one (minutes)
+    const std::vector<double> BLOCK_CONNECT_BUCKETS{
+        0.0001, 0.00025, 0.0005, 0.001, 0.0025, 0.005, 0.01, 0.025, 0.05,
+        0.1,    0.25,    0.5,    1,     2.5,    5,     10,   30,    60};
+
+    bool HTTPReqMetrics(Config &, HTTPRequest *req, const std::string &) {
+        NodeMetrics *m{GetNodeMetrics()};
+        if (req->GetRequestMethod() != HTTPRequest::GET &&
+            req->GetRequestMethod() != HTTPRequest::HEAD) {
+            req->WriteHeader("Allow", "GET, HEAD");
+            req->WriteReply(HTTP_BAD_METHOD);
+            return false;
+        }
+        if (!m) {
+            req->WriteReply(HTTP_SERVICE_UNAVAILABLE);
+            return false;
+        }
+        req->WriteHeader("Content-Type",
+                         "text/plain; version=0.0.4; charset=utf-8");
+        req->WriteHeader("Cache-Control", "no-store");
+        req->WriteReply(HTTP_OK,
+                        m->registry.Render(METRICS_MIN_SCRAPE_INTERVAL));
+        return true;
+    }
+} // namespace
+
+size_t MetricMsgTypeIndex(std::string_view msg_type) noexcept {
+    const auto &labels{MsgTypeLabels()};
+    const auto end{labels.end() - 1};
+    const auto it{std::lower_bound(
+        labels.begin(), end, msg_type,
+        [](const std::string &a, std::string_view b) { return a < b; })};
+    if (it != end && *it == msg_type) {
+        return size_t(it - labels.begin());
+    }
+    return labels.size() - 1;
+}
+
+NodeMetrics::NodeMetrics()
+    : p2p_received_bytes{registry.Add(std::make_unique<metrics::Counter>(
+          "lotus_p2p_received_bytes_total",
+          "P2P bytes received (header and payload), by message type.",
+          std::vector<metrics::LabelDim>{{"type", MsgTypeLabels()}}))},
+      block_connect_seconds{
+          registry.Add(std::make_unique<metrics::EventHistogram>(
+              "lotus_block_connect_seconds",
+              "Time to connect a block to the chain tip (ConnectBlock: "
+              "validating it and updating the UTXO view).",
+              BLOCK_CONNECT_BUCKETS, /*divisor=*/1e9))} {}
+
+void StartNodeMetrics() {
+    if (!GetNodeMetrics()) {
+        // Never freed: recording threads may hold the pointer.
+        detail::g_node_metrics.store(new NodeMetrics(),
+                                     std::memory_order_release);
+    }
+    GetNodeMetrics()->registry.Start();
+    RegisterHTTPHandler("/metrics", true, HTTPReqMetrics);
+    LogPrintf("Serving metrics at /metrics on the RPC listeners\n");
+}
+
+void StopNodeMetrics() {
+    UnregisterHTTPHandler("/metrics", true);
+    if (NodeMetrics * m{GetNodeMetrics()}) {
+        m->registry.Stop();
+    }
+}
+
+} // namespace node
