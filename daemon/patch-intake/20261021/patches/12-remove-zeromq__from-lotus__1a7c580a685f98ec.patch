-             pindex->GetBlockHash().GetHex());
-
-    const Config &config = GetConfig();
-    std::vector<uint8_t> rawBlock;
-    {
-        LOCK(cs_main);
-        if (!ReadRawBlockFromDisk(rawBlock, pindex,
