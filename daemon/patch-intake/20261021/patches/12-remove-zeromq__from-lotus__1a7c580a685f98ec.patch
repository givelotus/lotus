@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Removed ZeroMQ APIs and configuration must fail explicitly."""
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, assert_raises_rpc_error
+
+
+class RemovedZmqTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+
+    def run_test(self):
+        node = self.nodes[0]
+        assert_equal(node.help('getzmqnotifications'),
+                     'help: unknown command: getzmqnotifications')
+        assert_raises_rpc_error(-32601, 'Method not found', node.getzmqnotifications)
+        assert 'zmq' not in node.logging()
+        self.stop_node(0)
+        for topic in ('hashblock', 'hashtx', 'rawblock', 'rawtx', 'hashds', 'rawds'):
+            option = '-zmqpub{}=tcp://127.0.0.1:28336'.format(topic)
+            node.assert_start_raises_init_error(
+                extra_args=[option], expected_msg='Invalid parameter ' + option.split('=')[0],
+                match=ErrorMatch.PARTIAL_REGEX)
+        # Failure to parse a removed option must not interfere with clean startup.
+        self.start_node(0)
+        assert_equal(node.getblockcount(), 0)
+
+
+if __name__ == '__main__':
+    RemovedZmqTest().main()
