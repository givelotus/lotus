From 414ab9996295a422ce78697308d520367d048428 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 09:33:27 -0700
Subject: [PATCH] fixup! logging: add typed structured events with a field
 registry

Mark LogRecord::FIELDS_TRUNCATED when Put cuts a copied string even when it is the final field. Preserve size, copied bytes, synchronization and drop policy. Existing regression hid this by adding a later field whose reservation failed. Native last-only oversized string and empty-string controls require only this API owner, with no forward RPC-conversion dependency.

Actual old128 proof:1212byte denied method cut to424bytes without marker; expected regression assertion failure after HTTP403 and cleanstop,1.2287s/PID48992 groupempty, logging-cleanup/last-string-before171 receipts. Matching realRPC functional regression belongs separately in later typed-RPC owner06017d8fa8d. Both original owners are below isolated reviewbase; root folds fixups without a local whole-stack rewrite. Native/AFTER pending combined171r1 gate; Ruff/source checks pass.
---
 doc/logging-api.md               |  3 ++-
 src/logging.cpp                  |  1 +
 src/test/logging_event_tests.cpp | 24 ++++++++++++++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/doc/logging-api.md b/doc/logging-api.md
index 8992c4f082166a473004da6d06fe7a425bb6de97..e9454427dd57400a89c60876aa58a113528a4c17 100644
--- a/doc/logging-api.md
+++ b/doc/logging-api.md
@@ -26,7 +26,8 @@ mutex. Numeric values, hashes and durations are stored in binary; `LogStatic`
 accepts a string literal by pointer. Other strings are copied into the record.
 Address adapters copy network bytes and format the address on the consumer.
 Immutable shared objects retain one reference until the consumer renders and
-releases them. A string or field that does not fit is marked truncated; large
+releases them. A string or field that does not fit is marked truncated, including a final
+string with no following field to exhaust the slot; large
 blobs should be represented by their size or hash. Cold startup and severe
 backpressure are separate paths; see [async guarantees](logging-async.md).
 Legacy printf calls still format on the caller until converted.
diff --git a/src/logging.cpp b/src/logging.cpp
index d52ffce7606c91952e296e40861047363695118a..59dce0a16b43f5202252a5a727a953ae3d56d1a4 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -1265,6 +1265,7 @@ BCLog::EventBuilder &BCLog::EventBuilder::Put(FieldId id, FieldKind kind,
         if (size > room) {
             size = room;
             truncated = true;
+            m_rec->flags |= LogRecord::FIELDS_TRUNCATED;
         }
     }
     if (std::byte * out{Reserve(id, kind, size)}) {
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 5fa530290487a9b82d97026cf6859ece32c5208b..c338d8579756239099160e444eec29cf7f0c72f6 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -457,6 +457,30 @@ BOOST_AUTO_TEST_CASE(event_copies_strings) {
     BOOST_CHECK_EQUAL(lines.at(0), "[net] copied name=before");
 }
 
+BOOST_AUTO_TEST_CASE(
+    last_string_truncation_is_marked_without_a_following_field) {
+    Format(BCLog::LogFormat::JSON);
+    const std::string large(1000, 'x');
+    LogEvent(BCLog::NET, "last_string", "last={name}")
+        .Field(LogField::Name, large);
+    const auto row{Json()};
+    const auto retained{row["name"].get_str()};
+    BOOST_REQUIRE(!retained.empty());
+    BOOST_CHECK(retained.size() < large.size());
+    BOOST_CHECK(large.starts_with(retained));
+    BOOST_CHECK_EQUAL(row["message"].get_str(), "last=" + retained);
+    BOOST_REQUIRE(row["fields_truncated"].isBool());
+    BOOST_CHECK(row["fields_truncated"].get_bool());
+
+    // Empty ordinary fields fit and must not gain a spurious marker.
+    LogEvent(BCLog::NET, "last_string_empty", "last={name}")
+        .Field(LogField::Name, std::string{});
+    const auto empty{Json()};
+    BOOST_CHECK_EQUAL(empty["name"].get_str(), "");
+    BOOST_CHECK_EQUAL(empty["message"].get_str(), "last=");
+    BOOST_CHECK(empty["fields_truncated"].isNull());
+}
+
 BOOST_AUTO_TEST_CASE(event_truncation) {
     Format(BCLog::LogFormat::JSON);
     const std::string big(1000, 'x');
