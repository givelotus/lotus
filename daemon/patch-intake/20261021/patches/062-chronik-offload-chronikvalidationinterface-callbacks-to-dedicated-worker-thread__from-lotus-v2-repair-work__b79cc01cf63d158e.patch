+    // Normal-operation fence for work already forwarded by ValidationSignals.
+    // Once shutdown starts, StopWorker/join owns draining the remaining FIFO.
+    void SyncTransactionQueue() override {
+        if (std::this_thread::get_id() == m_worker_thread.get_id()) {
+            return;
+        }
+        auto promise = std::make_shared<std::promise<void>>();
+        auto completed = promise->get_future();
+        bool enqueued = false;
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_cv_space.wait(lock, [this] {
+                return m_stopping || m_queue.size() < MAX_QUEUE_SIZE;
+            });
+            if (!m_stopping) {
+                m_queue.push_back([promise] { promise->set_value(); });
+                enqueued = true;
+            }
+        }
+        if (enqueued) {
+            m_cv.notify_one();
+            completed.wait();
+        }
+    }
+
+    void StopWorker() {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stopping = true;
+        }
+        m_cv.notify_all();
+        m_cv_space.notify_all();
+        if (m_worker_thread.joinable()) {
+            m_worker_thread.join();
+        }
+    }
+
     bool StopChronik() {
+        StopWorker();
