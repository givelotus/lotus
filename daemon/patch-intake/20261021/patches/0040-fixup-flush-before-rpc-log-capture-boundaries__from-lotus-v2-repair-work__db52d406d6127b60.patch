From 1e9b7898a0a376f00245e743624b1e1c2c82d180 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 07:15:40 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

Flush pending output before the existing logging RPC inspects or changes categories, and use that barrier before live-node log capture offsets. This prevents a previous RPC action from leaking queued warnings into the next assertion or satisfying its wait. Two deterministic helper regressions fail before and pass after; the native RPC regression also fails when linked against the original misc.cpp implementation and passes with the barrier. Startup and shutdown captures remain supported without a live RPC connection.
---
 src/rpc/misc.cpp                            |  4 ++
 src/test/rpc_tests.cpp                      | 21 ++++++++++
 test/functional/test_framework/log_match.py | 45 +++++++++++++++++++++
 test/functional/test_framework/test_node.py |  4 ++
 4 files changed, 74 insertions(+)

diff --git a/src/rpc/misc.cpp b/src/rpc/misc.cpp
index caf912ad74..f64571729f 100644
--- a/src/rpc/misc.cpp
+++ b/src/rpc/misc.cpp
@@ -652,6 +652,7 @@ static RPCHelpMan logging() {
         "status that are currently being debug logged or not.\n"
         "When called with arguments, adds or removes categories from debug "
         "logging and return the lists above.\n"
+        "Pending log output is flushed before reading or changing categories.\n"
         "The arguments are evaluated in order \"include\", \"exclude\".\n"
         "If an item is both included and excluded, it will thus end up being "
         "excluded.\n"
@@ -694,6 +695,9 @@ static RPCHelpMan logging() {
             HelpExampleRpc("logging", "[\"all\"], [\"libevent\"]")},
         [&](const RPCHelpMan &self, const Config &config,
             const JSONRPCRequest &request) -> UniValue {
+            // Runtime configuration and test log boundaries must not race
+            // records queued by a previous RPC on another producer ring.
+            LogInstance().Flush();
             uint32_t original_log_categories = LogInstance().GetCategoryMask();
             if (request.params[0].isArray()) {
                 EnableOrDisableLogCategories(request.params[0], true);
diff --git a/src/test/rpc_tests.cpp b/src/test/rpc_tests.cpp
index 2a7443562d..904d00baa5 100644
--- a/src/test/rpc_tests.cpp
+++ b/src/test/rpc_tests.cpp
@@ -9,6 +9,7 @@
 
 #include <config.h>
 #include <interfaces/chain.h>
+#include <logging.h>
 #include <node/context.h>
 #include <util/time.h>
 
@@ -19,6 +20,7 @@
 #include <univalue.h>
 
 #include <any>
+#include <atomic>
 
 using util::SplitString;
 
@@ -876,4 +878,23 @@ BOOST_AUTO_TEST_CASE(rpc_arg_helper) {
              check_named);
 }
 
+BOOST_AUTO_TEST_CASE(logging_flushes_queued_records) {
+    LogInstance().PauseForTesting(true);
+    LogInstance().Flush();
+    std::atomic<bool> seen{false};
+    auto callback{LogInstance().PushBackCallback([&](const std::string &line) {
+        if (line.find("logging RPC barrier marker") != std::string::npos) {
+            seen = true;
+        }
+    })};
+    LogPrintf("logging RPC barrier marker\n");
+    BOOST_CHECK(!seen.load());
+    BOOST_CHECK_NO_THROW(CallRPC("logging"));
+    BOOST_CHECK(seen.load());
+    // Keep cleanup valid even when testing the old RPC without its barrier.
+    LogInstance().Flush();
+    LogInstance().DeleteCallback(callback);
+    LogInstance().PauseForTesting(false);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
diff --git a/test/functional/test_framework/log_match.py b/test/functional/test_framework/log_match.py
index a9f67b4ad0..f23b5e099c 100644
--- a/test/functional/test_framework/log_match.py
+++ b/test/functional/test_framework/log_match.py
@@ -47,5 +47,50 @@ class AsyncLogDeadlineTests(unittest.TestCase):
         self.exercise(TestNode.wait_for_debug_log, [b"expected asynchronous line"])
 
 
+class AsyncLogBoundaryTests(unittest.TestCase):
+    def fixture(self, helper, *, expect_stale=False):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "debug.log"
+            path.touch()
+            calls = []
+
+            def append(message):
+                with path.open("a") as stream:
+                    stream.write(message + "\n")
+
+            def flush():
+                calls.append(True)
+                append("stale forbidden message")
+
+            def fail(message):
+                raise AssertionError(message)
+
+            node = SimpleNamespace(
+                timeout_factor=1,
+                debug_log_path=path,
+                debug_log_size=lambda **kwargs: path.stat().st_size,
+                _raise_assertion_error=fail,
+                rpc_connected=True,
+                rpc=SimpleNamespace(logging=flush),
+            )
+            expected = [b"stale forbidden message"] if expect_stale else ["new action"]
+            kwargs = {} if expect_stale else {"unexpected_msgs": ["stale forbidden"]}
+            with helper(node, expected, timeout=0, **kwargs):
+                # Without the entry barrier, the previous action's queued
+                # message becomes visible inside this action's capture.
+                if not calls:
+                    append("stale forbidden message")
+                if not expect_stale:
+                    append("new action")
+            self.assertEqual(calls, [True])
+
+    def test_assert_excludes_previous_action(self):
+        self.fixture(TestNode.assert_debug_log)
+
+    def test_wait_does_not_match_previous_action(self):
+        with self.assertRaisesRegex(AssertionError, "[Mm]issing"):
+            self.fixture(TestNode.wait_for_debug_log, expect_stale=True)
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/test/functional/test_framework/test_node.py b/test/functional/test_framework/test_node.py
index c42bc587d9..f7e39a9a51 100644
--- a/test/functional/test_framework/test_node.py
+++ b/test/functional/test_framework/test_node.py
@@ -629,6 +629,8 @@ class TestNode:
             raise AssertionError("Expected debug messages is empty")
         if unexpected_msgs is None:
             unexpected_msgs = []
+        if getattr(self, "rpc_connected", False):
+            self.rpc.logging()  # Flush older queued records before this boundary.
         prev_size = self.debug_log_size(
             encoding="utf-8"
         )  # Must use same encoding that is used to read() below
@@ -686,6 +688,8 @@ class TestNode:
         """
         assert chatty_callable is None or interval is not None
         # Must use same mode that is used to read() below
+        if getattr(self, "rpc_connected", False):
+            self.rpc.logging()  # Flush older queued records before this boundary.
         prev_size = self.debug_log_size(mode="rb")
 
         yield
