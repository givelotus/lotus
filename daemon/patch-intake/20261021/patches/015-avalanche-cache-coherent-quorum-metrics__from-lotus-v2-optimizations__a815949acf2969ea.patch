From 6d20e9c26e4a6389178659e9e295ff7afec52dbc Mon Sep 17 00:00:00 2001
From: Lotus candidate maintenance <candidate@localhost>
Date: Sun, 18 Oct 2026 14:39:03 -0700
Subject: [PATCH] avalanche: cache coherent quorum metrics without changing
 eCash activation

Extract generic cached quorum reads from historical ecash/012. Publish peer counts and scores as one generation-guarded atomic snapshot; retain upstream node eligibility, quorum latching, local-proof treatment and staking reward side effects. Add concurrent publication coverage and retain processor quorum regressions. No Lotus supply or treasury gates are introduced.
---
 src/avalanche/peermanager.cpp            | 20 +++++++++++
 src/avalanche/peermanager.h              | 33 ++++++++++++++++++
 src/avalanche/processor.cpp              | 33 ++++++------------
 src/avalanche/test/peermanager_tests.cpp | 43 ++++++++++++++++++++++++
 4 files changed, 106 insertions(+), 23 deletions(-)

diff --git a/src/avalanche/peermanager.cpp b/src/avalanche/peermanager.cpp
index 4dc0f150fb..84cf765405 100644
--- a/src/avalanche/peermanager.cpp
+++ b/src/avalanche/peermanager.cpp
@@ -30,6 +30,22 @@
 namespace avalanche {
 static constexpr uint64_t PEERS_DUMP_VERSION{1};
 
+void PeerManager::updateAtomicQuorumMetrics() {
+    m_atomicQuorumGeneration.fetch_add(1);
+    m_atomicNodeCount.store(nodes.size());
+    m_atomicTotalPeersScore.store(totalPeersScore);
+    m_atomicConnectedPeersScore.store(connectedPeersScore);
+    bool localNoNode = false;
+    if (localProof) {
+        forPeer(localProof->getId(), [&](const Peer &peer) {
+            localNoNode = peer.node_count == 0;
+            return true;
+        });
+    }
+    m_atomicLocalProofHasNoNode.store(localNoNode);
+    m_atomicQuorumGeneration.fetch_add(1);
+}
+
 bool PeerManager::addNode(NodeId nodeid, const ProofId &proofid,
                           size_t max_elements) {
     auto &pview = peers.get<by_proofid>();
@@ -85,6 +101,7 @@ bool PeerManager::addOrUpdateNode(const PeerSet::iterator &it, NodeId nodeid,
     // there is more than 1, in this case it's a no-op.
     shareableProofs.insert(it->proof);
 
+    updateAtomicQuorumMetrics();
     return true;
 }
 
@@ -129,6 +146,7 @@ bool PeerManager::removeNode(NodeId nodeid) {
     bool success = removeNodeFromPeer(peers.find(peerid));
     assert(success);
 
+    updateAtomicQuorumMetrics();
     return true;
 }
 
@@ -458,6 +476,7 @@ bool PeerManager::registerProof(const ProofRef &proof,
         addStakeContender(proof);
     }
 
+    updateAtomicQuorumMetrics();
     return true;
 }
 
@@ -821,6 +840,7 @@ bool PeerManager::removePeer(const PeerId peerid) {
     assert(totalPeersScore >= it->getScore());
     totalPeersScore -= it->getScore();
     peers.erase(it);
+    updateAtomicQuorumMetrics();
     return true;
 }
 
diff --git a/src/avalanche/peermanager.h b/src/avalanche/peermanager.h
index 5f5296f981..8ce827e10f 100644
--- a/src/avalanche/peermanager.h
+++ b/src/avalanche/peermanager.h
@@ -237,6 +237,15 @@ class PeerManager {
     uint32_t totalPeersScore = 0;
     uint32_t connectedPeersScore = 0;
 
+    // Writers are serialized by the owning processor peer-manager lock.
+    // Sequentially consistent atomics and a generation guard publish a
+    // coherent tuple without acquiring that mutex on quorum reads.
+    std::atomic<uint64_t> m_atomicQuorumGeneration{0};
+    std::atomic<size_t> m_atomicNodeCount{0};
+    std::atomic<uint32_t> m_atomicTotalPeersScore{0};
+    std::atomic<uint32_t> m_atomicConnectedPeersScore{0};
+    std::atomic<bool> m_atomicLocalProofHasNoNode{false};
+
     Amount stakeUtxoDustThreshold;
 
     ChainstateManager &chainman;
@@ -447,6 +456,28 @@ public:
      */
     uint32_t getTotalPeersScore() const { return totalPeersScore; }
     uint32_t getConnectedPeersScore() const { return connectedPeersScore; }
+    struct QuorumMetrics {
+        size_t nodeCount;
+        uint32_t totalScore;
+        uint32_t connectedScore;
+        bool localProofHasNoNode;
+    };
+
+    QuorumMetrics getQuorumMetrics() const {
+        for (;;) {
+            const auto generation = m_atomicQuorumGeneration.load();
+            if (generation & 1) {
+                continue;
+            }
+            const QuorumMetrics metrics{
+                m_atomicNodeCount.load(), m_atomicTotalPeersScore.load(),
+                m_atomicConnectedPeersScore.load(),
+                m_atomicLocalProofHasNoNode.load()};
+            if (generation == m_atomicQuorumGeneration.load()) {
+                return metrics;
+            }
+        }
+    }
 
     bool saveRemoteProof(const ProofId &proofid, const NodeId nodeid,
                          const bool present);
@@ -572,6 +603,8 @@ private:
         return m_stakingPreConsensus;
     }
 
+    void updateAtomicQuorumMetrics();
+
     friend struct ::avalanche::TestPeerManager;
 };
 
