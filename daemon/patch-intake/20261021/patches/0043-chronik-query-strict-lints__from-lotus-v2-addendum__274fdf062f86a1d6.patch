From 824d091fb003bc7378b655ec1bfee332313aeb4e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:28:58 -0700
Subject: [PATCH] fixup! chronik(v2): ingest native blocks and expose typed
 index queries

Document the public snapshot query seam and bounded page/wire result fields, replace an Option API newer than declared Rust1.80 with its equivalent map_or predicate, and name the private joined-record read/byte reservation. Preserve exact4/512 and7/2048 costs, pagination boundaries and corruption rejection. Clears21 strict Clippy diagnostics; aggregate configured Chronik Clippy and134tests pass without new allows.

Tier: V2 (fixup to chronik(v2): ingest native blocks and expose typed index queries)
---
 .../chronik-indexer/src/query/v2_assets.rs    | 45 ++++++++++----
 .../chronik-indexer/src/query/v2_explorer.rs  | 58 +++++++++++++++----
 2 files changed, 82 insertions(+), 21 deletions(-)

diff --git a/chronik/chronik-indexer/src/query/v2_assets.rs b/chronik/chronik-indexer/src/query/v2_assets.rs
index d8d6d84a14..43f667f3bd 100644
--- a/chronik/chronik-indexer/src/query/v2_assets.rs
+++ b/chronik/chronik-indexer/src/query/v2_assets.rs
@@ -144,20 +144,27 @@ fn validate(
     }
     Ok(())
 }
+struct RecordCost {
+    reads: usize,
+    bytes: usize,
+}
 fn page<T>(
     source: &impl Source,
     prefix: &[u8],
     key_len: usize,
     after: Option<&[u8]>,
     limits: Limits,
-    calls: usize,
-    record_bytes: usize,
+    cost: RecordCost,
     mut next: impl FnMut(
         &dyn Source,
         Option<&[u8]>,
         &mut AssetReadBudget,
     ) -> Result<Option<(Vec<u8>, Option<T>)>, Error>,
 ) -> Result<Page<T>, Error> {
+    let RecordCost {
+        reads: calls,
+        bytes: record_bytes,
+    } = cost;
     validate(limits, prefix, key_len, after, calls)?;
     let mut page = Page {
         items: Vec::new(),
@@ -210,9 +217,18 @@ pub fn assets(
     after: Option<&[u8]>,
     limits: Limits,
 ) -> Result<Page<AssetSummary>, Error> {
-    page(source, b"eA", 34, after, limits, 4, 512, |s, a, budget| {
-        Ok(s.summary(a, budget)?.map(|(k, v)| (k, Some(v))))
-    })
+    page(
+        source,
+        b"eA",
+        34,
+        after,
+        limits,
+        RecordCost {
+            reads: 4,
+            bytes: 512,
+        },
+        |s, a, budget| Ok(s.summary(a, budget)?.map(|(k, v)| (k, Some(v)))),
+    )
 }
 /// One aggregate event per touched transaction in height/index order.
 pub fn events(
@@ -228,9 +244,13 @@ pub fn events(
         46,
         after,
         limits,
-        4,
-        512,
-        |s, a, budget| Ok(s.event(token, a, budget)?.map(|(k, v)| (k, Some(v)))),
+        RecordCost {
+            reads: 4,
+            bytes: 512,
+        },
+        |s, a, budget| {
+            Ok(s.event(token, a, budget)?.map(|(k, v)| (k, Some(v))))
+        },
     )
 }
 /// History includes burns; unspent excludes spent outputs and burns. Filtering
@@ -249,8 +269,10 @@ pub fn outputs(
         50,
         after,
         limits,
-        7,
-        2048,
+        RecordCost {
+            reads: 7,
+            bytes: 2048,
+        },
         |s, a, budget| {
             let Some((key, op)) = s.posting(token, a, budget)? else {
                 return Ok(None);
@@ -264,7 +286,8 @@ pub fn outputs(
             {
                 return Err(Error::Source);
             }
-            let include = !unspent || (record.spend.is_none() && !record.output.is_burn());
+            let include = !unspent
+                || (record.spend.is_none() && !record.output.is_burn());
             Ok(Some((key, include.then_some(record))))
         },
     )
diff --git a/chronik/chronik-indexer/src/query/v2_explorer.rs b/chronik/chronik-indexer/src/query/v2_explorer.rs
index 50753db1c4..e40b3bfc10 100644
--- a/chronik/chronik-indexer/src/query/v2_explorer.rs
+++ b/chronik/chronik-indexer/src/query/v2_explorer.rs
@@ -1,9 +1,13 @@
 //! Bounded explorer queries over the owner's one immutable read snapshot.
 //! Authority, restart-safe cursor binding and capped JSON encoding belong to HTTP.
-use bitcoinsuite_core::lotus_v2::{Hash32, OutPoint, OutputRecord, TxHash, TxId};
+use bitcoinsuite_core::lotus_v2::{
+    Hash32, OutPoint, OutputRecord, TxHash, TxId,
+};
 use chronik_db::{
     v2_branch::{Error, ReadSnapshot},
-    v2_explorer::{BlockMeta, InputMeta, TxMeta, WitnessFact, WIRE_CHUNK_BYTES},
+    v2_explorer::{
+        BlockMeta, InputMeta, TxMeta, WitnessFact, WIRE_CHUNK_BYTES,
+    },
 };
 
 type Result<T> = std::result::Result<T, Error>;
@@ -24,14 +28,32 @@ pub const MAX_PAGE_BYTES: usize = 96 * 1024;
 // initial parent lookup too. Even a 100-item witness page reserves only 3429.
 /// Read-only seam for pinned production snapshots and independent fixture tests.
 pub trait ExplorerSource {
+    /// Read validated metadata for a native block identity.
     fn block(&self, id: Hash32) -> Result<Option<BlockMeta>>;
+    /// Read block metadata joined to its canonical height.
     fn block_at_height(&self, height: u64) -> Result<Option<BlockMeta>>;
+    /// Read validated metadata for a structural transaction ID.
     fn transaction(&self, id: TxId) -> Result<Option<TxMeta>>;
+    /// Resolve a wire transaction hash to validated metadata.
     fn transaction_by_hash(&self, hash: TxHash) -> Result<Option<TxMeta>>;
-    fn block_transaction(&self, block: Hash32, index: u32) -> Result<Option<(TxId, TxHash)>>;
+    /// Read both transaction identities at a block ordinal.
+    fn block_transaction(
+        &self,
+        block: Hash32,
+        index: u32,
+    ) -> Result<Option<(TxId, TxHash)>>;
+    /// Read an input descriptor joined to its resolved creation.
     fn input(&self, id: TxId, index: u32) -> Result<Option<InputMeta>>;
-    fn witness(&self, id: TxId, input: u32, index: u32) -> Result<Option<WitnessFact>>;
+    /// Read a bounded witness descriptor at an input ordinal.
+    fn witness(
+        &self,
+        id: TxId,
+        input: u32,
+        index: u32,
+    ) -> Result<Option<WitnessFact>>;
+    /// Read an indexed output with its creation and optional spend.
     fn output(&self, op: OutPoint) -> Result<Option<OutputRecord>>;
+    /// Read one bounded wire chunk from the recorded transaction.
     fn wire(&self, id: TxId, chunk: u32) -> Result<Option<Vec<u8>>>;
 }
 impl ExplorerSource for ReadSnapshot<'_> {
@@ -47,7 +69,11 @@ impl ExplorerSource for ReadSnapshot<'_> {
     fn transaction_by_hash(&self, h: TxHash) -> Result<Option<TxMeta>> {
         self.explorer_tx_by_hash(h)
     }
-    fn block_transaction(&self, b: Hash32, i: u32) -> Result<Option<(TxId, TxHash)>> {
+    fn block_transaction(
+        &self,
+        b: Hash32,
+        i: u32,
+    ) -> Result<Option<(TxId, TxHash)>> {
         self.explorer_block_tx(b, i)
     }
     fn input(&self, id: TxId, i: u32) -> Result<Option<InputMeta>> {
@@ -66,9 +92,13 @@ impl ExplorerSource for ReadSnapshot<'_> {
 /// Typed continuation is exclusive. HTTP binds it to route/filter/snapshot.
 #[derive(Clone, Debug, Eq, PartialEq)]
 pub struct Page<T> {
+    /// Complete records in the requested canonical order.
     pub items: Vec<T>,
+    /// Exclusive ordinal continuation, or None at exhaustion.
     pub next_index: Option<u64>,
+    /// Whether this snapshot has no further records for the query.
     pub exhausted: bool,
+    /// Number of index records examined to produce this page.
     pub examined: usize,
     /// Physical key-read reservation, including all canonical and frozen-coin joins.
     /// Optional/missing records can consume fewer reads than this ceiling.
@@ -77,11 +107,17 @@ pub struct Page<T> {
 /// Exact byte chunk, at most 32768 bytes without reading the full frame.
 #[derive(Clone, Debug, Eq, PartialEq)]
 pub struct WireChunk {
+    /// Structural transaction identity for these exact wire bytes.
     pub txid: TxId,
+    /// Hash of the exact serialized transaction.
     pub txhash: TxHash,
+    /// Length of the full serialized transaction in bytes.
     pub total_bytes: u64,
+    /// Zero-based byte offset of this chunk in the transaction.
     pub offset: u64,
+    /// Exact bounded wire bytes returned for this chunk.
     pub bytes: Vec<u8>,
+    /// Next byte offset, or None at the end of the transaction.
     pub next_offset: Option<u64>,
 }
 /// Integer encoding for every new JSON integer, including u64::MAX.
@@ -138,7 +174,7 @@ fn ordinal_page<T>(
         }
         if bytes
             .checked_add(record_bytes)
-            .is_none_or(|n| n > MAX_PAGE_BYTES)
+            .map_or(true, |n| n > MAX_PAGE_BYTES)
         {
             if items.is_empty() {
                 return Err(Error::Invalid("explorer record limit"));
@@ -242,7 +278,8 @@ pub fn inputs_page(
         chronik_db::v2_explorer::validate_input_meta(&input, tx.wire_size)?;
         let bytes = 256
             + input.resolved_creation.as_ref().map_or(0, |coin| {
-                812 + 128 + coin.output.paths.iter().map(Vec::len).sum::<usize>()
+                812 + 128
+                    + coin.output.paths.iter().map(Vec::len).sum::<usize>()
             });
         Ok((input, bytes))
     })
@@ -324,11 +361,12 @@ pub fn wire_chunk(
         .ok_or(Error::Invalid("explorer wire range"))?;
     let mut position = offset;
     while position < end {
-        let index =
-            u32::try_from(position / WIRE_CHUNK_BYTES as u64).map_err(|_| Error::Corrupt)?;
+        let index = u32::try_from(position / WIRE_CHUNK_BYTES as u64)
+            .map_err(|_| Error::Corrupt)?;
         let chunk = required(source.wire(id, index)?)?;
         let chunk_start = u64::from(index) * WIRE_CHUNK_BYTES as u64;
-        let expected = (tx.wire_size - chunk_start).min(WIRE_CHUNK_BYTES as u64) as usize;
+        let expected =
+            (tx.wire_size - chunk_start).min(WIRE_CHUNK_BYTES as u64) as usize;
         if chunk.len() != expected {
             return Err(Error::Corrupt);
         }
