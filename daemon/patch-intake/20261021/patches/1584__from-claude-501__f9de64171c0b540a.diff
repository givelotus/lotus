+          no-caps
+          :loading="creating"
+          :disable="!canSubmit || creating"
+          :label="
+            creating
+              ? $t('groupChat.creatingGroup')
+              : $t('groupChat.createGroupBtn')
+          "
+          data-test="create-group-submit"
+          data-testid="create-group-submit"
+          @click="submitCreateGroup"
+        />
