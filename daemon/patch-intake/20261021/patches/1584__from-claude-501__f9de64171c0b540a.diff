+        // 6. GET /groups/:group_id/messages with valid X-Group-Read-Token -> 200 OK
+        let res_get = app
+            .oneshot(
+                Request::builder()
+                    .method("GET")
+                    .uri(format!("/groups/{group_id}/messages?after_seq=0&limit=10"))
