+        // 4. PUT /groups/:group_id/messages signed by outsider key -> 403 Forbidden
+        let (outsider_sk, _) = keypair(99);
+        let mut bad_msg = msg.clone();
+        bad_msg.write_sig = sign_digest(&outsider_sk, &bad_msg.signing_digest().unwrap());
+        let res_bad = app
+            .clone()
