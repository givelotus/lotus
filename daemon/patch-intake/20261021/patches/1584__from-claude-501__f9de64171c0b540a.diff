+        let backlog = router.clone().oneshot(read(1)).await.unwrap();
+        assert_eq!(backlog.status(), StatusCode::OK);
+        let backlog: GroupMessagesResponse =
+            serde_json::from_slice(&hyper::body::to_bytes(backlog.into_body()).await.unwrap())
+                .unwrap();
+        assert_eq!(
