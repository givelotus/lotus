+
+    // Verify If-Match header was sent on the second PUT /epochs call
+    const putEpochCalls = mock.calls.filter(
+      c => c.method === 'PUT' && c.url.endsWith('/epochs'),
+    )
+    expect(putEpochCalls).toHaveLength(2)
