+it('REVIEW repeated original outgoing writes retain exactly one durable row and no cursor', async () => {
+  const location = await mkdtemp(join(tmpdir(), 'review-outgoing-original-'))
+  const originalStore = new LevelMessageStore(location)
+  try {
+    await originalStore.Open()
+    const original = wrapper('original-authorized-digest')
+    await Promise.all([
+      originalStore.saveMessage(original, { advanceCursor: false }),
+      originalStore.saveMessage(original, { advanceCursor: false }),
+    ])
+    expect(await originalStore.getMessage(original.index)).toEqual(original)
+    expect(await originalStore.mostRecentMessageTime()).toBe(0)
+    await originalStore.Close()
+    expect(await snapshot(location)).toEqual({
+      metadata: { schemaVersion: '2' },
+      messages: { [original.index]: serializeMessageWrapper(original) },
+    })
+  } finally {
+    await originalStore.Close()
+    await rm(location, { recursive: true, force: true })
+  }
+})
