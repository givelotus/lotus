From 598560707e63439e4d2e2ab32817ff561379e758 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 23:52:54 -0700
Subject: [PATCH] fixup! mining: serve compact templates and mined-header
 submission from snapshots

Avoid draining pending mempool overlay changes merely to populate an optional snapshot mining hint. Retain immutable entry generations and the existing contextual/fee/resource-checked mining fallback. Add real-admission coverage for deferred overlay state plus pinned template IDs, exact fees, sizes and roots after the live pool advances. Isolated shared362 performance candidate; no timing attribution or validation claim before actual gates.
---
 src/node/snapshot.cpp                  |  5 +++
 src/test/rpc_snapshot_mining_tests.cpp | 58 ++++++++++++++++++++++++++
 src/txmempool.h                        |  6 +++
 3 files changed, 69 insertions(+)

diff --git a/src/node/snapshot.cpp b/src/node/snapshot.cpp
index bd2edd79b0fcaa2f42c87ceb186d070f5c6031d4..27a42bfe7d7a2bc17311ffe81163935eb4b3e95a 100644
--- a/src/node/snapshot.cpp
+++ b/src/node/snapshot.cpp
@@ -293,6 +293,11 @@ void InitMiningTemplate(ChainAndMempoolSnapshot &snap,
     t.template_valid = true;
     if (pool) {
         AssertLockHeld(pool->cs);
+        // This hint is optional: mining can select from the immutable entry
+        // tree. Publishing a generation must not materialize pending overlay
+        // work merely to obtain the fast-path hint. In particular, reading the
+        // live overlay later cannot certify an older snapshot's membership.
+        if (pool->HasPendingOverlayChanges()) return;
         lotus::v2::Hash tip{};
         std::memcpy(tip.data(), snap.best_block_hash.begin(), 32);
         const auto &overlay = pool->GetMerklixOverlay().GetSpeculativeOverlay();
diff --git a/src/test/rpc_snapshot_mining_tests.cpp b/src/test/rpc_snapshot_mining_tests.cpp
index 97f1199a94656709ecf9176de9efa8c0ae337276..c568ac115df451016cbef3fa2c8db53f11129996 100644
--- a/src/test/rpc_snapshot_mining_tests.cpp
+++ b/src/test/rpc_snapshot_mining_tests.cpp
@@ -34,11 +34,69 @@
 #include <cstring>
 #include <future>
 #include <memory>
+#include <set>
 #include <thread>
 #include <vector>
 
 BOOST_FIXTURE_TEST_SUITE(rpc_snapshot_mining_tests, TestChain100Setup)
 
+BOOST_AUTO_TEST_CASE(publication_defers_overlay_and_mining_pins_its_generation) {
+    const CScript spk = GetScriptForDestination(PKHash(coinbaseKey.GetPubKey()));
+    auto &pool = *m_node.mempool;
+    auto &publisher = node::GetGlobalSnapshotPublisher();
+    const Amount fee = 2000 * SATOSHI;
+    const auto first = MakeTransactionRef(CreateValidMempoolTransaction(
+        m_coinbase_txns[0], 0, 1, coinbaseKey, spk,
+        m_coinbase_txns[0]->vout[0].nValue - fee, /*submit=*/true));
+    const auto pinned = publisher.Load();
+    BOOST_REQUIRE(pinned);
+    BOOST_REQUIRE_EQUAL(pinned->mempool_size, 1U);
+    {
+        LOCK(pool.cs);
+        BOOST_CHECK(pool.HasPendingOverlayChanges());
+    }
+    BOOST_CHECK(!pinned->mining->ready);
+    BOOST_CHECK(!pinned->overlay_all_fit_candidate);
+
+    const auto second = MakeTransactionRef(CreateValidMempoolTransaction(
+        m_coinbase_txns[1], 0, 2, coinbaseKey, spk,
+        m_coinbase_txns[1]->vout[0].nValue - fee, /*submit=*/true));
+    const auto current = publisher.Load();
+    BOOST_REQUIRE(current);
+    BOOST_REQUIRE_EQUAL(current->mempool_size, 2U);
+
+    // Materialize only after the live pool has advanced. The fallback must
+    // select the pinned generation, retain exact fees, and cache its roots.
+    const auto &old_template = pinned->GetMiningTemplate();
+    BOOST_REQUIRE_EQUAL(old_template.non_coinbase_txs.size(), 1U);
+    BOOST_CHECK(old_template.non_coinbase_txs[0]->GetId() == first->GetId());
+    BOOST_CHECK(old_template.total_fees == fee);
+    BOOST_REQUIRE_EQUAL(old_template.tx_fees.size(), 1U);
+    BOOST_CHECK(old_template.tx_fees[0] == fee);
+    BOOST_CHECK_EQUAL(old_template.non_cb_serialized_size,
+                      GetSerializeSize(*first));
+    old_template.EnsureTemplateRoots();
+    const auto old_root = old_template.subtree_a_root;
+    BOOST_CHECK(old_root != lotus::v2::Hash{});
+
+    const auto &new_template = current->GetMiningTemplate();
+    BOOST_REQUIRE_EQUAL(new_template.non_coinbase_txs.size(), 2U);
+    BOOST_CHECK(new_template.total_fees == fee + fee);
+    std::set<TxId> selected;
+    for (const auto &tx : new_template.non_coinbase_txs) {
+        selected.insert(tx->GetId());
+    }
+    BOOST_CHECK(selected == std::set<TxId>({first->GetId(), second->GetId()}));
+    new_template.EnsureTemplateRoots();
+    BOOST_CHECK(new_template.subtree_a_root != old_root);
+    BOOST_CHECK(pinned->GetMiningTemplate().subtree_a_root == old_root);
+    {
+        LOCK(pool.cs);
+        BOOST_CHECK(pool.HasPendingOverlayChanges());
+        BOOST_CHECK_EQUAL(pool.size(), 2U);
+    }
+}
+
 BOOST_AUTO_TEST_CASE(
     abc_mempool_batch_removal_and_prioritisation_snapshot_coalescing) {
     CScript spk = GetScriptForDestination(PKHash(coinbaseKey.GetPubKey()));
diff --git a/src/txmempool.h b/src/txmempool.h
index 50869fd4611808a7a0d1f2a49f0b37c377d2c23c..db73a24823b555dacfc80607d9297ed46026d21d 100644
--- a/src/txmempool.h
+++ b/src/txmempool.h
@@ -634,6 +634,12 @@ public:
 
 
     /** Shared speculative transaction overlay; not proof of script validity. */
+    bool HasPendingOverlayChanges() const EXCLUSIVE_LOCKS_REQUIRED(cs) {
+        AssertLockHeld(cs);
+        return !m_pending_overlay_adds.empty() ||
+               !m_pending_overlay_removes.empty();
+    }
+
     lotus::v2::MerklixOverlayManager &GetMerklixOverlay() const
         EXCLUSIVE_LOCKS_REQUIRED(cs) {
         AssertLockHeld(cs);
