index 0000000000000000000000000000000000000000..78b5f54c654685a26684f6d947c1eb9690a1d86b
--- /dev/null
+++ b/src/net_zstd_independent.h
@@ -0,0 +1,205 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see COPYING.
+#ifndef BITCOIN_NET_ZSTD_INDEPENDENT_H
+#define BITCOIN_NET_ZSTD_INDEPENDENT_H
+
+#include <crypto/common.h>
+#include <crypto/sha256.h>
+#include <net_zstd_dict.h>
+#include <primitives/block.h>
+#include <protocol.h>
+#include <streams.h>
+
+#include <array>
+#include <atomic>
+#include <list>
+#include <map>
+#include <mutex>
+#include <tuple>
+
+// Only encoder policy changes with this setting. Decoders always accept both
+// independent and streaming frames, even when outgoing independent frames are
+// off.
+inline std::atomic<size_t> g_p2p_independent_threshold{64 * 1024};
+
+inline std::array<uint8_t, 32> P2PFrameDigest(Span<const uint8_t> bytes) {
+    std::array<uint8_t, 32> result;
+    CSHA256{}.Write(bytes.data(), bytes.size()).Finalize(result.data());
+    return result;
+}
+inline void CheckIndependentZstd(size_t result) {
+    if (ZSTD_isError(result))
+        throw std::runtime_error(ZSTD_getErrorName(result));
+}
+
+// Format byte + LE32 dictionary version + one complete zstd frame. These bytes
+// are independent of every connection's streaming compression state.
+inline std::vector<uint8_t>
+CompressP2PIndependent(Span<const uint8_t> payload) {
+    std::unique_ptr<ZSTD_CCtx, decltype(&ZSTD_freeCCtx)> ctx(ZSTD_createCCtx(),
+                                                             ZSTD_freeCCtx);
+    if (!ctx) throw std::bad_alloc();
+    CheckIndependentZstd(ZSTD_CCtx_refCDict(ctx.get(), GetP2PZstdCDict()));
+    CheckIndependentZstd(ZSTD_CCtx_setParameter(ctx.get(), ZSTD_c_windowLog,
+                                                P2P_ZSTD_WINDOW_LOG));
+    CheckIndependentZstd(
+        ZSTD_CCtx_setParameter(ctx.get(), ZSTD_c_contentSizeFlag, 1));
+    std::vector<uint8_t> frame(5 + ZSTD_compressBound(payload.size()));
+    frame[0] = 1;
+    WriteLE32(frame.data() + 1, P2P_ZSTD_DICT_VERSION);
+    const auto written =
+        ZSTD_compress2(ctx.get(), frame.data() + 5, frame.size() - 5,
+                       payload.data(), payload.size());
+    CheckIndependentZstd(written);
+    frame.resize(5 + written);
+    // Do not retain compressBound-sized storage for a tiny compressed frame.
+    // Cache accounting still uses capacity because shrink_to_fit is nonbinding.
+    frame.shrink_to_fit();
+    return frame;
+}
+
+inline void DecompressP2PIndependent(Span<const uint8_t> frame,
+                                     std::vector<uint8_t> &out,
+                                     size_t maximum) {
+    if (frame.size() < 6 || frame[0] != 1 ||
+        ReadLE32(frame.data() + 1) != P2P_ZSTD_DICT_VERSION)
+        throw std::runtime_error(
+            "unsupported independent frame/dictionary version");
+    frame = frame.subspan(5);
+    if (frame.size() < 6 || ReadLE32(frame.data()) != ZSTD_MAGICNUMBER)
+        throw std::runtime_error("independent payload is not a zstd frame");
+    const auto frame_size =
+        ZSTD_findFrameCompressedSize(frame.data(), frame.size());
+    CheckIndependentZstd(frame_size);
+    if (frame_size != frame.size())
+        throw std::runtime_error("independent frame has trailing data");
+    const auto size = ZSTD_getFrameContentSize(frame.data(), frame.size());
+    if (size == ZSTD_CONTENTSIZE_ERROR || size == ZSTD_CONTENTSIZE_UNKNOWN ||
+        size > maximum)
+        throw std::runtime_error("invalid independent frame content size");
+    // libzstd may bypass its streaming window allocation for a complete
+    // single-segment frame. Enforce the frame's declared window before any
+    // output allocation as well as setting the decoder's allocation limit.
+    // Zstandard frame descriptor bit 5 selects single-segment; otherwise the
+    // following byte encodes base 2^(10 + exponent) plus eighth-base mantissa.
+    const uint64_t window_limit = uint64_t{1} << P2P_ZSTD_MAX_WINDOW_LOG;
+    const bool single_segment = (frame[4] & 0x20) != 0;
+    uint64_t window_size = size;
+    if (!single_segment) {
+        const uint64_t base = uint64_t{1} << (10 + (frame[5] >> 3));
+        window_size = base + (base / 8) * (frame[5] & 7);
+    }
+    if (window_size > window_limit)
+        throw std::runtime_error("independent frame window exceeds limit");
+    std::unique_ptr<ZSTD_DCtx, decltype(&ZSTD_freeDCtx)> ctx(ZSTD_createDCtx(),
+                                                             ZSTD_freeDCtx);
+    if (!ctx) throw std::bad_alloc();
+    CheckIndependentZstd(ZSTD_DCtx_refDDict(ctx.get(), GetP2PZstdDDict()));
+    CheckIndependentZstd(ZSTD_DCtx_setParameter(ctx.get(), ZSTD_d_windowLogMax,
+                                                P2P_ZSTD_MAX_WINDOW_LOG));
+    const size_t start = out.size();
+    out.resize(start + size + 1);
+    ZSTD_inBuffer input{frame.data(), frame.size(), 0};
+    ZSTD_outBuffer output{out.data() + start, size + 1, 0};
+    size_t remaining = 1;
+    while (remaining) {
+        const auto before = input.pos;
+        const auto before_output = output.pos;
+        remaining = ZSTD_decompressStream(ctx.get(), &output, &input);
+        CheckIndependentZstd(remaining);
+        if (remaining &&
+            (input.pos == input.size || output.pos == output.size ||
+             (input.pos == before && output.pos == before_output)))
+            throw std::runtime_error("incomplete independent frame");
+    }
+    if (input.pos != input.size || output.pos != size)
+        throw std::runtime_error("independent frame length mismatch");
+    out.resize(start + size);
+}
+
+class P2PIndependentBlockCache {
+public:
+    struct Stats {
+        uint64_t hits{}, misses{}, evictions{}, compressions{};
+        size_t bytes{}, entries{};
+    };
+    explicit P2PIndependentBlockCache(size_t bytes = 128 * 1024 * 1024,
+                                      size_t entries = 64)
+        : m_max_bytes(bytes), m_max_entries(entries) {}
+    std::shared_ptr<const std::vector<uint8_t>>
+    Encode(Span<const uint8_t> payload) {
+        // The exact payload digest guards against two serializations sharing a
+        // header hash (including malformed test bodies). Dictionary bytes guard
+        // against accidental version-number reuse. Hash outside the cache lock.
+        const auto block_id = GetP2PV2MessageId(NetMsgType::BLOCK);
+        if (!block_id || payload.empty() || payload[0] != *block_id)
+            return Fresh(payload);
+        uint256 block_hash;
+        try {
+            SpanReader reader(payload.subspan(1));
+            CBlockHeader header;
+            reader >> header;
+            block_hash = header.GetHash();
+        } catch (const std::exception &) {
+            return Fresh(payload);
+        }
+        const Key key{block_hash, P2P_ZSTD_DICT_VERSION,
+                      P2PFrameDigest(GetP2PZstdDictionaryBytes()),
+                      P2PFrameDigest(payload)};
+        std::lock_guard<std::mutex> lock(m_mutex);
+        auto found = m_cache.find(key);
+        if (found != m_cache.end()) {
+            ++m_stats.hits;
+            m_lru.splice(m_lru.begin(), m_lru, found->second.position);
+            return found->second.frame;
+        }
+        ++m_stats.misses;
+        // Serializing misses prevents duplicate compression of the same block
+        // by simultaneous peer senders. Shared ownership survives LRU eviction.
+        auto frame = Fresh(payload);
+        ++m_stats.compressions;
+        const size_t allocated = frame->capacity();
+        if (allocated > m_max_bytes || !m_max_entries) return frame;
+        while (!m_lru.empty() && (m_stats.bytes + allocated > m_max_bytes ||
+                                  m_cache.size() >= m_max_entries)) {
+            auto old = m_cache.find(m_lru.back());
+            m_stats.bytes -= old->second.frame->capacity();
+            m_cache.erase(old);
+            m_lru.pop_back();
+            ++m_stats.evictions;
+        }
+        m_lru.push_front(key);
+        m_cache.emplace(key, Entry{frame, m_lru.begin()});
+        m_stats.bytes += allocated;
+        return frame;
+    }
+    Stats GetStats() const {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        auto result = m_stats;
+        result.entries = m_cache.size();
+        return result;
+    }
+
+private:
+    using Key = std::tuple<uint256, uint32_t, std::array<uint8_t, 32>,
+                           std::array<uint8_t, 32>>;
+    struct Entry {
+        std::shared_ptr<const std::vector<uint8_t>> frame;
+        std::list<Key>::iterator position;
+    };
+    static std::shared_ptr<const std::vector<uint8_t>>
+    Fresh(Span<const uint8_t> payload) {
+        return std::make_shared<const std::vector<uint8_t>>(
+            CompressP2PIndependent(payload));
+    }
+    const size_t m_max_bytes, m_max_entries;
+    mutable std::mutex m_mutex;
+    std::map<Key, Entry> m_cache;
+    std::list<Key> m_lru;
+    Stats m_stats;
+};
+inline P2PIndependentBlockCache &GetP2PIndependentBlockCache() {
+    static P2PIndependentBlockCache cache;
+    return cache;
+}
+#endif
