+void V2PeerProtocolHandler::ExpireSizedTransfer(NodeId peer, std::chrono::microseconds now) {
+    LOCK(m_mutex);
+    const auto found = m_sized_transfers.find(peer);
+    if (found == m_sized_transfers.end() || now < found->second.expires) return;
+    const auto &req = found->second.request;
+    m_pending_shorttx_requests.erase(PendingShortTxKey{peer, static_cast<ReconScope>(req.scope), req.context_id});
+    m_sized_queued_ids -= found->second.remaining.size();
+    m_sized_transfers.erase(found);
+}
+
+void V2PeerProtocolHandler::SendNextSizedChunk(CNode &peer, std::chrono::microseconds now) {
+    if (peer.fPauseSend || peer.fDisconnect) return;
+    struct Completion { ShortTxRequest header; uint256 root; size_t rounds; };
+    std::optional<Completion> completion;
+    ShortTxRequest request;
+    {
+        LOCK(m_mutex);
+        const auto found = m_sized_transfers.find(peer.GetId());
+        if (found == m_sized_transfers.end()) return;
+        auto &transfer = found->second;
+        const auto &header = transfer.request;
+        if (m_pending_shorttx_requests.count(PendingShortTxKey{peer.GetId(),
+                static_cast<ReconScope>(header.scope), header.context_id})) return;
+        if (transfer.remaining.empty()) {
+            completion = Completion{header, transfer.expected_root, transfer.rounds};
+            m_sized_transfers.erase(found);
+        } else {
+            request = header;
+            const size_t count = std::min(transfer.remaining.size(), ShortTxRequest::MAX_SHORT_IDS);
+            request.short_ids.reserve(count);
+            for (size_t i = 0; i < count; ++i) {
+                request.short_ids.push_back(transfer.remaining.front());
+                transfer.remaining.pop_front();
+            }
+            m_sized_queued_ids -= count;
+            transfer.expires = now + std::chrono::seconds{10};
+            ++transfer.rounds;
+        }
+    }
+    if (completion) {
+        const auto txs = GetScopedTransactions(static_cast<ReconScope>(completion->header.scope),
+                                               completion->header.context_id);
+        if (ComputeScopedMerklixRoot(txs) == completion->root) {
+            LOCK(m_mutex);
+            ++m_stats.sized_list_transfers_completed;
+            ++m_stats.sized_list_round_histogram[std::min<size_t>(16, completion->rounds)];
+        }
+        return;
+    }
+    RecordPendingShortTxRequest(peer.GetId(), static_cast<ReconScope>(request.scope),
+                                 request.context_id, request.salt_k0, request.salt_k1,
+                                 request.short_ids);
+    m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::GETSHORTTX, request));
+}
