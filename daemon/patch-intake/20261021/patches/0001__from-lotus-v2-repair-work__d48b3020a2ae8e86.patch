+void V2PeerProtocolHandler::HandleSizedSync(
+    CNode &peer, DataStream &stream, std::chrono::microseconds now) {
+    auto malformed = [&] { LOCK(m_mutex); ++m_stats.malformed_messages; };
+    MerklixSizedSync push;
+    try { stream >> push; } catch (const std::exception &) { malformed(); return; }
+    auto &summary = push.summary;
+    if (!stream.empty() || !IsValidReconScope(summary.scope) ||
+        !IsValidReconSipHashKey(static_cast<ReconScope>(summary.scope), summary.context_id,
+                                summary.salt_k0, summary.salt_k1)) { malformed(); return; }
+    size_t total = 0;
+    for (const auto &bucket : summary.buckets) total += bucket.count;
+    if (total > MAX_SCOPED_TXS ||
+        (push.depth != 0 && push.depth != 8 && push.depth != 12)) { malformed(); return; }
+    const auto scope = static_cast<ReconScope>(summary.scope);
+    const auto local = GetScopedTransactions(scope, summary.context_id);
+    const bool matched = ComputeScopedMerklixRoot(local) == summary.candidate_root;
+    {
+        LOCK(m_mutex);
+        auto &history = m_recon_history[peer.GetId()];
+        history.remote_size = total;
+        history.known = true;
+        if (matched) history.q = 0.0;
+    }
+    if (push.depth == 0) {
+        if (!push.sketches.empty() || push.short_ids.size() != total) { malformed(); return; }
+        if (matched) return;
+        std::unordered_set<uint64_t> remote_ids;
+        for (const auto id : push.short_ids)
+            if (!id || !remote_ids.insert(id).second) { malformed(); return; }
+        std::unordered_set<uint64_t> local_ids;
+        for (const auto &tx : local)
+            local_ids.insert(ComputeMerklixShortId(summary.salt_k0, summary.salt_k1, tx->GetId()));
+        if (local_ids.size() != local.size()) return; // Collision: ordinary relay fallback.
+        std::vector<uint64_t> missing;
+        size_t extra = 0;
+        for (const auto id : remote_ids) if (!local_ids.count(id)) missing.push_back(id);
+        for (const auto id : local_ids) if (!remote_ids.count(id)) ++extra;
+        {
+            LOCK(m_mutex);
+            auto &history = m_recon_history[peer.GetId()];
+            const size_t size_difference = local.size() > total ? local.size() - total : total - local.size();
+            const auto shared_size = std::min(local.size(), total);
+            history.q = shared_size ? std::clamp(
+                double(missing.size() + extra - size_difference) / shared_size, 0.0, 1.0) : 0.0;
+        }
+        if (matched || missing.empty()) return;
+        ExpireSizedTransfer(peer.GetId(), now);
+        {
+            LOCK(m_mutex);
+            if (m_sized_transfers.count(peer.GetId())) return;
+            // At most half a MiB of IDs per peer and eight MiB globally.
+            if (m_sized_queued_ids + missing.size() > 1024 * 1024) {
+                ++m_stats.recon_queue_rejected;
+                peer.fDisconnect = true;
+                return;
+            }
+            SizedTransfer transfer;
+            transfer.expected_root = summary.candidate_root;
+            transfer.request.scope = summary.scope;
+            transfer.request.context_id = summary.context_id;
+            transfer.request.salt_k0 = summary.salt_k0;
+            transfer.request.salt_k1 = summary.salt_k1;
+            std::sort(missing.begin(), missing.end());
+            transfer.remaining.assign(missing.begin(), missing.end());
+            transfer.expires = now + std::chrono::seconds{10};
+            m_sized_queued_ids += missing.size();
+            m_sized_transfers.emplace(peer.GetId(), std::move(transfer));
+        }
+        SendNextSizedChunk(peer, now);
+        return;
+    }
+    const size_t parents = push.depth == 8 ? 16 : 256;
+    if (!push.short_ids.empty() || push.sketches.size() != parents) { malformed(); return; }
+    size_t cells_count = 0;
+    for (size_t prefix = 0; prefix < parents; ++prefix) {
+        const auto &sketch = push.sketches[prefix];
+        if (sketch.scope != summary.scope || sketch.context_id != summary.context_id ||
+            sketch.salt_k0 != summary.salt_k0 || sketch.salt_k1 != summary.salt_k1 ||
+            sketch.depth_bits != push.depth || sketch.parent_prefix != prefix ||
+            !sketch.overflow_short_ids.empty()) { malformed(); return; }
+        for (const auto &cell : sketch.sub_buckets) cells_count += cell.count;
+    }
+    if (cells_count != total) { malformed(); return; }
+    if (matched) return;
+    {
+        LOCK(m_mutex);
+        auto &pending = m_expected_buckets[peer.GetId()];
+        if (pending.size() + parents > MerklixBucketBatchReply::MAX_SUMMARIES) return;
+        for (const auto &sketch : push.sketches)
+            pending.emplace(sketch.scope, sketch.context_id, sketch.salt_k0, sketch.salt_k1,
+                            sketch.depth_bits, sketch.parent_prefix);
+    }
+    MerklixBucketBatchReply batch{std::move(push.sketches)};
+    DataStream sketches;
+    sketches << batch;
+    HandleBucketBatchReply(peer, sketches, now);
+}
