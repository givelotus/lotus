+BOOST_FIXTURE_TEST_SUITE(merklix_sized_tests, RegTestingSetup)
+BOOST_AUTO_TEST_CASE(ten_thousand_epoch_difference_round_trip_gate) {
+    const auto &config = m_node.chainman->GetConfig();
+    ConnmanTestMsg connman(config, 1, 2, *m_node.addrman);
+    auto peerman = PeerManager::make(connman, *m_node.addrman, nullptr,
+                                     *m_node.chainman, *m_node.mempool, nullptr, {});
+    auto *local = peerman->GetV2ProtocolHandler();
+    V2PeerProtocolHandler remote(*m_node.chainman, *m_node.mempool, connman, *peerman);
+    CNode peer(901, nullptr, CAddress(), 0, 0, 0, CAddress(), "",
+               ConnectionType::OUTBOUND_FULL_RELAY, false);
+    peer.SetCommonVersion(PROTOCOL_VERSION);
+    peer.fSuccessfullyConnected = true;
+    const auto services = ServiceFlags(NODE_MERKLIX | NODE_MERKLIX_BATCH | NODE_MERKLIX_SIZED);
+    local->SetPeerServices(peer.GetId(), services);
+    remote.SetPeerServices(peer.GetId(), services);
+    auto take = [&] {
+        V1TransportDeserializer decoder(config, peer.GetId());
+        std::vector<CNetMessage> messages;
+        LOCK(peer.cs_vSend);
+        for (const auto &chunk : peer.vSendMsg) {
+            Span<const uint8_t> bytes{chunk};
+            while (!bytes.empty()) {
+                BOOST_REQUIRE_GE(decoder.Read(config, bytes), 0);
+                if (decoder.Complete()) {
+                    bool rejected = false;
+                    messages.push_back(decoder.GetMessage(0us, rejected));
+                    BOOST_REQUIRE(!rejected);
+                }
+            }
+        }
+        peer.vSendMsg.clear();
+        peer.nSendSize = 0; // All captured transport bytes were delivered.
+        peer.fPauseSend = false;
+        return messages;
+    };
+    const CScript redeem = CScript() << std::vector<uint8_t>(48, 0x42) << OP_DROP << OP_TRUE;
+    const CScript script = GetScriptForDestination(ScriptHash(redeem));
+    std::vector<CTransactionRef> universe;
+    {
+        LOCK(cs_main);
+        auto &coins = m_node.chainman->ActiveChainstate().CoinsTip();
+        for (size_t i = 0; i < 10000; ++i) {
+            CMutableTransaction tx;
+            tx.nVersion = 2;
+            tx.vin.resize(1);
+            uint256 prev;
+            for (unsigned b = 0; b < 8; ++b) prev.begin()[b] = (i + 1) >> (8 * b);
+            tx.vin[0].prevout = COutPoint(TxId(prev), 0);
+            tx.vin[0].scriptSig = CScript() << ToByteVector(redeem);
+            tx.vout.emplace_back(1000 * SATOSHI, script);
+            coins.AddCoin(tx.vin[0].prevout, Coin(CTxOut(5000 * SATOSHI, script), 1, false), true);
+            universe.push_back(MakeTransactionRef(std::move(tx)));
+        }
+    }
+    size_t sequence = 1;
+    for (size_t difference : {10, 100, 1000, 2000, 5000}) {
+        std::vector<size_t> observed;
+        for (size_t repeat = 0; repeat < 3; ++repeat) {
+            uint256 context;
+            context.begin()[0] = sequence++;
+            const auto scope = ReconScope::EPOCH_BATCH;
+            std::vector<CTransactionRef> shared(universe.begin(), universe.end() - difference);
+            BOOST_REQUIRE(local->SetScopedTransactions(scope, context, shared));
+            BOOST_REQUIRE(remote.SetScopedTransactions(scope, context, universe));
+            MerklixSizedSync push;
+            push.summary = remote.BuildSyncSummary(scope, context);
+            push.depth = 0; // Negotiated large-difference complete-list option.
+            for (const auto &tx : universe)
+                push.short_ids.push_back(ComputeMerklixShortId(push.summary.salt_k0,
+                                                               push.summary.salt_k1, tx->GetId()));
+            DataStream initial;
+            initial << push;
+            auto now = std::chrono::microseconds{1000000 * sequence};
+            BOOST_REQUIRE(local->TryHandleMessage(peer, NetMsgType::MERKLIXSIZED, initial, now));
+            size_t rounds = 0;
+            while (true) {
+                auto requests = take();
+                if (requests.empty()) break;
+                BOOST_REQUIRE_EQUAL(requests.size(), 1U);
+                BOOST_REQUIRE_EQUAL(requests[0].m_type, NetMsgType::GETSHORTTX);
+                ++rounds;
+                BOOST_REQUIRE_LE(rounds, 3U);
+                now += 100ms;
+                BOOST_REQUIRE(remote.TryHandleMessage(peer, requests[0].m_type, requests[0].m_recv, now));
+                auto replies = take();
+                BOOST_REQUIRE_EQUAL(replies.size(), 1U);
+                BOOST_REQUIRE_EQUAL(replies[0].m_type, NetMsgType::SHORTTX);
+                now += 100ms;
+                BOOST_REQUIRE(local->TryHandleMessage(peer, replies[0].m_type, replies[0].m_recv, now));
+            }
+            BOOST_REQUIRE(local->BuildSyncSummary(scope, context).candidate_root == push.summary.candidate_root);
+            BOOST_CHECK_EQUAL(local->GetScopedTransactions(scope, context).size(), 10000U);
+            observed.push_back(rounds);
+        }
+        std::sort(observed.begin(), observed.end());
+        BOOST_TEST_MESSAGE("difference=" << difference << " median actual request/response rounds=" << observed[1]);
+        BOOST_CHECK_LE(observed[1], difference <= 1000 ? 2U : 3U);
+    }
+    const auto stats = local->GetStats();
+    BOOST_CHECK_EQUAL(stats.sized_list_transfers_completed, 15U);
+    BOOST_CHECK_EQUAL(stats.sized_list_round_histogram[1], 12U);
+    BOOST_CHECK_EQUAL(stats.sized_list_round_histogram[2], 3U);
+}
+BOOST_AUTO_TEST_CASE(outgoing_frames_respect_bytes_backpressure_and_teardown) {
+    const auto &config = m_node.chainman->GetConfig();
+    ConnmanTestMsg connman(config, 3, 4, *m_node.addrman);
+    auto peerman = PeerManager::make(connman, *m_node.addrman, nullptr,
+                                     *m_node.chainman, *m_node.mempool, nullptr, {});
+    auto *handler = peerman->GetV2ProtocolHandler();
+    CNode peer(902, nullptr, CAddress(), 0, 0, 0, CAddress(), "",
+               ConnectionType::OUTBOUND_FULL_RELAY, false);
+    peer.SetCommonVersion(PROTOCOL_VERSION);
+    peer.fSuccessfullyConnected = true;
+    std::vector<CTransactionRef> txs;
+    for (uint8_t i = 1; i <= 3; ++i) {
+        CMutableTransaction tx;
+        tx.nVersion = 2;
+        tx.vin.resize(1);
+        uint256 prev;
+        prev.begin()[0] = i;
+        tx.vin[0].prevout = COutPoint(TxId(prev), 0);
+        // Synthetic payloads test framing only, not consensus acceptance.
+        tx.vout.emplace_back(1000 * SATOSHI,
+                            CScript() << std::vector<uint8_t>(600000, 0x42) << OP_DROP);
+        txs.push_back(MakeTransactionRef(std::move(tx)));
+    }
+    uint256 context;
+    context.begin()[0] = 99;
+    BOOST_REQUIRE(handler->SetScopedTransactions(ReconScope::BLOCK_RECON, context, txs));
+    const auto [k0, k1] = DeriveReconSipHashKey(ReconScope::BLOCK_RECON, context, 0);
+    ShortTxRequest request;
+    request.scope = uint8_t(ReconScope::BLOCK_RECON);
+    request.context_id = context;
+    request.salt_k0 = k0; request.salt_k1 = k1;
+    for (const auto &tx : txs) request.short_ids.push_back(ComputeMerklixShortId(k0, k1, tx->GetId()));
+    DataStream wire;
+    wire << request;
+    BOOST_REQUIRE(handler->TryHandleMessage(peer, NetMsgType::GETSHORTTX, wire, 1s));
+    size_t frames = 0, delivered = 0;
+    for (int pass = 0; pass < 4 && delivered < 3; ++pass) {
+        V1TransportDeserializer decoder(config, peer.GetId());
+        {
+            LOCK(peer.cs_vSend);
+            for (const auto &chunk : peer.vSendMsg) {
+                Span<const uint8_t> bytes{chunk};
+                while (!bytes.empty()) {
+                    BOOST_REQUIRE_GE(decoder.Read(config, bytes), 0);
+                    if (!decoder.Complete()) continue;
+                    bool rejected = false;
+                    auto msg = decoder.GetMessage(0us, rejected);
+                    BOOST_REQUIRE(!rejected);
+                    BOOST_REQUIRE_EQUAL(msg.m_type, NetMsgType::SHORTTX);
+                    BOOST_CHECK_LE(msg.m_recv.size(), MAX_PROTOCOL_MESSAGE_LENGTH);
+                    ShortTxResponse response;
+                    msg.m_recv >> response;
+                    delivered += response.txs.size();
+                    ++frames;
+                }
+            }
+            peer.vSendMsg.clear();
+            peer.nSendSize = 0;
+            peer.fPauseSend = false;
+        }
+        handler->DrainShortTxResponses(peer);
+    }
+    BOOST_CHECK_EQUAL(delivered, 3U);
+    BOOST_CHECK_EQUAL(frames, 3U);
+    const auto references = txs.front().use_count();
+    peer.fPauseSend = true;
+    DataStream paused;
+    paused << request;
+    handler->HandleGetShortTx(peer, paused, 2s);
+    BOOST_CHECK_EQUAL(txs.front().use_count(), references + 1);
+    handler->RemovePeer(peer.GetId());
+    BOOST_CHECK_EQUAL(txs.front().use_count(), references);
+    peer.fPauseSend = false;
+    handler->DrainShortTxResponses(peer);
+    LOCK(peer.cs_vSend);
+    BOOST_CHECK(peer.vSendMsg.empty());
+}
+
+BOOST_AUTO_TEST_CASE(stalled_list_request_expires_without_claiming_completion) {
+    const auto &config = m_node.chainman->GetConfig();
+    ConnmanTestMsg connman(config, 5, 6, *m_node.addrman);
+    auto peerman = PeerManager::make(connman, *m_node.addrman, nullptr,
+                                     *m_node.chainman, *m_node.mempool, nullptr, {});
+    auto *handler = peerman->GetV2ProtocolHandler();
+    CNode peer(903, nullptr, CAddress(), 0, 0, 0, CAddress(), "",
+               ConnectionType::OUTBOUND_FULL_RELAY, false);
+    peer.SetCommonVersion(PROTOCOL_VERSION);
+    peer.fSuccessfullyConnected = true;
+    handler->SetPeerServices(peer.GetId(), ServiceFlags(NODE_MERKLIX | NODE_MERKLIX_BATCH | NODE_MERKLIX_SIZED));
+    MerklixSizedSync push;
+    push.depth = 0;
+    push.summary.scope = uint8_t(ReconScope::EPOCH_BATCH);
+    push.summary.context_id.begin()[0] = 31;
+    std::tie(push.summary.salt_k0, push.summary.salt_k1) = DeriveReconSipHashKey(
+        ReconScope::EPOCH_BATCH, push.summary.context_id, 0);
+    push.summary.candidate_root.begin()[0] = 99;
+    push.summary.buckets[0].count = 1;
+    push.summary.buckets[0].xor_short_id = 123;
+    push.short_ids = {123};
+    DataStream initial;
+    initial << push;
+    BOOST_REQUIRE(handler->TryHandleMessage(peer, NetMsgType::MERKLIXSIZED, initial, 1s));
+    BOOST_CHECK(handler->HasPendingShortTxRequests(peer.GetId()));
+    handler->MaybeSendSync(peer, 12s);
+    BOOST_CHECK(!handler->HasPendingShortTxRequests(peer.GetId()));
+    BOOST_CHECK_EQUAL(handler->GetStats().sized_list_transfers_completed, 0U);
+}
