+void V2PeerProtocolHandler::QueueShortTxResponse(CNode &peer, ShortTxResponse response) {
+    OutgoingShortTx job{response.scope, response.context_id, {}, 0};
+    for (const auto &tx : response.txs) {
+        const size_t bytes = GetSerializeSize(Using<TransactionCompression>(tx));
+        if (bytes + 64 > MAX_PROTOCOL_MESSAGE_LENGTH) {
+            LOCK(m_mutex); ++m_stats.recon_queue_rejected; peer.fDisconnect = true; return;
+        }
+        job.bytes += bytes;
+        job.txs.emplace_back(tx, bytes);
+    }
+    {
+        LOCK(m_mutex);
+        auto &queue = m_shorttx_responses[peer.GetId()];
+        size_t peer_bytes = job.bytes;
+        for (const auto &pending : queue) peer_bytes += pending.bytes;
+        if (queue.size() >= 16 || peer_bytes > MAX_SCOPED_TX_BYTES ||
+            m_shorttx_response_bytes + job.bytes > MAX_SCOPED_CACHE_BYTES) {
+            ++m_stats.recon_queue_rejected;
+            peer.fDisconnect = true;
+            return;
+        }
+        m_shorttx_response_bytes += job.bytes;
+        queue.push_back(std::move(job));
+    }
+    DrainShortTxResponses(peer);
+}
+
+void V2PeerProtocolHandler::DrainShortTxResponses(CNode &peer) {
+    for (size_t frame = 0; frame < 4 && !peer.fPauseSend && !peer.fDisconnect; ++frame) {
+        ShortTxResponse response;
+        {
+            LOCK(m_mutex);
+            const auto found = m_shorttx_responses.find(peer.GetId());
+            if (found == m_shorttx_responses.end() || found->second.empty()) return;
+            auto &queue = found->second;
+            auto &job = queue.front();
+            response.scope = job.scope;
+            response.context_id = job.context;
+            size_t bytes = 64;
+            while (!job.txs.empty() && response.txs.size() < ShortTxResponse::MAX_TXS) {
+                const auto &tx = job.txs.front();
+                if (!response.txs.empty() && bytes + tx.second > 1024 * 1024) break;
+                bytes += tx.second;
+                response.txs.push_back(tx.first);
+                job.bytes -= tx.second;
+                m_shorttx_response_bytes -= tx.second;
+                job.txs.pop_front();
+            }
+            if (job.txs.empty()) queue.pop_front();
+            if (queue.empty()) m_shorttx_responses.erase(found);
+        }
+        if (response.txs.empty()) return;
+        m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::SHORTTX, response));
+    }
+}
