+# Merklix capabilities are opt-in; these command names all fit 12-byte framing.
+def _merklix_read(f, size):
+    data = f.read(size)
+    if len(data) != size:
+        raise ValueError("truncated Merklix payload")
+    return int.from_bytes(data, "little")
+
+
+def _merklix_ids_read(f, limit):
+    count = deser_compact_size(f)
+    if count > limit:
+        raise ValueError("oversized Merklix ID vector")
+    return [_merklix_read(f, 8) for _ in range(count)]
+
+
+def _merklix_ids_write(ids, limit):
+    if len(ids) > limit:
+        raise ValueError("oversized Merklix ID vector")
+    return ser_compact_size(len(ids)) + b"".join(i.to_bytes(8, "little") for i in ids)
+
+
+def _merklix_vector_read(f, cls, limit):
+    count = deser_compact_size(f)
+    if count > limit:
+        raise ValueError("oversized Merklix object vector")
+    result = []
+    for _ in range(count):
+        item = cls()
+        item.deserialize(f)
+        result.append(item)
+    return result
+
+
+def _merklix_vector_write(items, limit):
+    if len(items) > limit:
+        raise ValueError("oversized Merklix object vector")
+    return ser_compact_size(len(items)) + b"".join(i.serialize() for i in items)
+
+
+class msg_merklixsync:
+    msgtype = b"merklixsync"
+    __slots__ = ("scope", "context_id", "salt_k0", "salt_k1", "candidate_root", "buckets")
+
+    def __init__(self):
+        self.scope, self.context_id, self.salt_k0, self.salt_k1 = 1, 0, 0, 0
+        self.candidate_root = 0
+        self.buckets = [(0, 0)] * 16
+
+    def serialize(self):
+        assert len(self.buckets) == 16
+        return (bytes([self.scope]) + ser_uint256(self.context_id)
+                + self.salt_k0.to_bytes(8, "little") + self.salt_k1.to_bytes(8, "little")
+                + ser_uint256(self.candidate_root)
+                + b"".join(c.to_bytes(4, "little") + x.to_bytes(8, "little") for c, x in self.buckets))
+
+    def deserialize(self, f):
+        self.scope, self.context_id = _merklix_read(f, 1), _merklix_read(f, 32)
+        self.salt_k0, self.salt_k1 = _merklix_read(f, 8), _merklix_read(f, 8)
+        self.candidate_root = _merklix_read(f, 32)
+        self.buckets = [(_merklix_read(f, 4), _merklix_read(f, 8)) for _ in range(16)]
+
+
+class msg_getmrklbckt:
+    msgtype = b"getmrklbckt"
+    __slots__ = ("scope", "context_id", "salt_k0", "salt_k1", "bucket_mask", "depth_bits", "parent_prefix")
+
+    def __init__(self):
+        self.scope, self.context_id, self.salt_k0, self.salt_k1 = 1, 0, 0, 0
+        self.bucket_mask, self.depth_bits, self.parent_prefix = 0, 4, 0
+
+    def serialize(self):
+        return (bytes([self.scope]) + ser_uint256(self.context_id)
+                + self.salt_k0.to_bytes(8, "little") + self.salt_k1.to_bytes(8, "little")
+                + self.bucket_mask.to_bytes(2, "little") + bytes([self.depth_bits])
+                + self.parent_prefix.to_bytes(2, "little"))
+
+    def deserialize(self, f):
+        self.scope, self.context_id = _merklix_read(f, 1), _merklix_read(f, 32)
+        self.salt_k0, self.salt_k1 = _merklix_read(f, 8), _merklix_read(f, 8)
+        self.bucket_mask, self.depth_bits = _merklix_read(f, 2), _merklix_read(f, 1)
+        self.parent_prefix = _merklix_read(f, 2)
+
+
+class msg_merklixbuck:
+    msgtype = b"merklixbuck"
+    __slots__ = ("scope", "context_id", "salt_k0", "salt_k1", "parent_bucket", "depth_bits", "parent_prefix", "sub_buckets", "overflow_short_ids")
+
+    def __init__(self):
+        self.scope, self.context_id, self.salt_k0, self.salt_k1 = 1, 0, 0, 0
+        self.parent_bucket, self.depth_bits, self.parent_prefix = 0, 8, 0
+        self.sub_buckets, self.overflow_short_ids = [(0, 0, 0, 0)] * 16, []
+
+    def serialize(self):
+        assert len(self.sub_buckets) == 16
+        return (bytes([self.scope]) + ser_uint256(self.context_id)
+                + self.salt_k0.to_bytes(8, "little") + self.salt_k1.to_bytes(8, "little")
+                + bytes([self.parent_bucket, self.depth_bits]) + self.parent_prefix.to_bytes(2, "little")
+                + b"".join(c.to_bytes(2, "little") + b"".join(s.to_bytes(8, "little") for s in [s1, s3, s5])
+                           for c, s1, s3, s5 in self.sub_buckets)
+                + _merklix_ids_write(self.overflow_short_ids, 4096))
+
+    def deserialize(self, f):
+        self.scope, self.context_id = _merklix_read(f, 1), _merklix_read(f, 32)
+        self.salt_k0, self.salt_k1 = _merklix_read(f, 8), _merklix_read(f, 8)
+        self.parent_bucket, self.depth_bits = _merklix_read(f, 1), _merklix_read(f, 1)
+        self.parent_prefix = _merklix_read(f, 2)
+        self.sub_buckets = [(_merklix_read(f, 2), _merklix_read(f, 8), _merklix_read(f, 8), _merklix_read(f, 8)) for _ in range(16)]
+        self.overflow_short_ids = _merklix_ids_read(f, 4096)
+
+
+class msg_getmrklbatch:
+    msgtype = b"getmrklbatch"
+    __slots__ = ("requests",)
+
+    def __init__(self):
+        self.requests = []
+
+    def serialize(self):
+        return _merklix_vector_write(self.requests, 256)
+
+    def deserialize(self, f):
+        self.requests = _merklix_vector_read(f, msg_getmrklbckt, 256)
+
+
+class msg_mrklbatch:
+    msgtype = b"mrklbatch"
+    __slots__ = ("summaries",)
+
+    def __init__(self):
+        self.summaries = []
+
+    def serialize(self):
+        return _merklix_vector_write(self.summaries, 4096)
+
+    def deserialize(self, f):
+        self.summaries = _merklix_vector_read(f, msg_merklixbuck, 4096)
+
+
+class msg_getshorttx:
+    msgtype = b"getshorttx"
+    __slots__ = ("scope", "context_id", "salt_k0", "salt_k1", "short_ids")
+
+    def __init__(self):
+        self.scope, self.context_id, self.salt_k0, self.salt_k1 = 1, 0, 0, 0
+        self.short_ids = []
+
+    def serialize(self):
+        return (bytes([self.scope]) + ser_uint256(self.context_id)
+                + self.salt_k0.to_bytes(8, "little") + self.salt_k1.to_bytes(8, "little")
+                + _merklix_ids_write(self.short_ids, 4096))
+
+    def deserialize(self, f):
+        self.scope, self.context_id = _merklix_read(f, 1), _merklix_read(f, 32)
+        self.salt_k0, self.salt_k1 = _merklix_read(f, 8), _merklix_read(f, 8)
+        self.short_ids = _merklix_ids_read(f, 4096)
+
+
+class msg_shorttx:
+    msgtype = b"shorttx"
+    __slots__ = ("scope", "context_id", "txs")
+
+    def __init__(self):
+        self.scope, self.context_id, self.txs = 1, 0, []
+
+    def serialize(self):
+        return bytes([self.scope]) + ser_uint256(self.context_id) + _merklix_vector_write(self.txs, 4096)
+
+    def deserialize(self, f):
+        self.scope, self.context_id = _merklix_read(f, 1), _merklix_read(f, 32)
+        self.txs = _merklix_vector_read(f, CTransaction, 4096)
+
+
+class msg_merklixsket:
+    msgtype = b"merklixsket"
+    __slots__ = ("summary", "depth", "sketches", "short_ids")
+
+    def __init__(self):
+        self.summary, self.depth, self.sketches, self.short_ids = msg_merklixsync(), 8, [], []
+
+    def serialize(self):
+        return (self.summary.serialize() + bytes([self.depth])
+                + _merklix_vector_write(self.sketches, 256)
+                + _merklix_ids_write(self.short_ids, 65536))
+
+    def deserialize(self, f):
+        self.summary.deserialize(f)
+        self.depth = _merklix_read(f, 1)
+        self.sketches = _merklix_vector_read(f, msg_merklixbuck, 256)
+        self.short_ids = _merklix_ids_read(f, 65536)
+
