+class TestMerklixMessages(unittest.TestCase):
+    def test_wire_sizes_roundtrip_and_preallocation_bounds(self):
+        classes = [msg_merklixsync, msg_getmrklbckt, msg_merklixbuck, msg_getmrklbatch,
+                   msg_mrklbatch, msg_getshorttx, msg_shorttx, msg_merklixsket]
+        for cls in classes:
+            original, parsed = cls(), cls()
+            self.assertLessEqual(len(original.msgtype), 12)
+            parsed.deserialize(BytesIO(original.serialize()))
+            self.assertEqual(parsed.serialize(), original.serialize())
+        self.assertEqual(len(msg_merklixsync().serialize()), 273)
+        self.assertEqual(len(msg_getmrklbckt().serialize()), 54)
+        self.assertEqual(len(msg_merklixbuck().serialize()), 470)
