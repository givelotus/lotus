From 38afa02304e2c8fdd1fd548ca861ad3609ab4fc7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:31 -0700
Subject: [PATCH] transaction(v2): cache outputs roots and avoid legacy sighash
 precomputation

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Cache the Merklized v7 outputs_root on CTransaction, skip legacy BIP143
sha256 midstate precomputation on v7 transactions, and eliminate heap
allocations in V2 VM bytecode scanning.

Original-Commit: e1121176503abb932575ce4f1ef33c4458523e97
Original-Patch: v2/026
Split-Concern: outputs

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/primitives/transaction.cpp | 8 ++++++--
 src/primitives/transaction.h   | 2 ++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index 0c0f611859de6bbb11e9030326d543169b2ab481..278af465c74658b7458deccb3547965561ab14f8 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -305,17 +305,21 @@ lotus::v2::Transaction CTransaction::ToV2Transaction() const {
 static void ComputeV2TxIdentities(const lotus::v2::Transaction &v2tx,
                                   uint32_t nVersion,
                                   lotus::v2::Hash32 &txid_out,
-                                  lotus::v2::Hash32 &txhash_out) {
+                                  lotus::v2::Hash32 &txhash_out,
+                                  lotus::v2::Hash32 *outputs_root_out = nullptr) {
     std::string err;
     if (lotus::v2::ComputeTransactionIdentities(
             v2tx, lotus::v2::DefaultTxProfile, GetActiveV2ChainId(), txid_out,
-            txhash_out, err)) {
+            txhash_out, err, outputs_root_out)) {
         if (nVersion != 7) {
             txid_out[0] ^= uint8_t(nVersion & 0xffU);
             txhash_out[0] ^= uint8_t(nVersion & 0xffU);
         }
         return;
     }
+    if (outputs_root_out) {
+        *outputs_root_out = lotus::v2::Hash32{};
+    }
     std::vector<uint8_t> core_bytes;
     std::vector<uint8_t> full_bytes;
     for (unsigned i = 0; i < 4; ++i) {
diff --git a/src/primitives/transaction.h b/src/primitives/transaction.h
index 7629118263eaf25471cec2890fbb265ec0bff158..5a78af7c703d4dc0f8b0ea4ebb11cb3eacd758ef 100644
--- a/src/primitives/transaction.h
+++ b/src/primitives/transaction.h
@@ -610,6 +610,7 @@ private:
     /** Memory only. */
     uint256 hash;
     uint256 m_witness_hash;
+    uint256 m_outputs_hash;
 
     uint256 ComputeHash() const;
     uint256 ComputeWitnessHash() const;
@@ -646,6 +647,7 @@ public:
 
     TxId GetId() const { return TxId(hash); }
     TxHash GetHash() const { return TxHash(m_witness_hash); }
+    const uint256 &GetOutputsHash() const { return m_outputs_hash; }
 
     lotus::v2::Transaction ToV2Transaction() const;
 
