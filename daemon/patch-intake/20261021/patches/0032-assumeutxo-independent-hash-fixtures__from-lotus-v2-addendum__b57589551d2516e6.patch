From 80421c8cc11b5640508cd56eb773d73777f842a8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 22:50:06 -0700
Subject: [PATCH] fixup! test(v2): migrate functional fixtures and harnesses to
 native transactions

Keep the original assumeutxo fixture and exact failure assertions, updating its known299 base/commitment and298 rollback commitment. Independent offline controls reproduce every23603/23522 snapshot byte from300 rawblocks, resolve real legacy input fees and derive C17a lifetimes; no RPC hash is used as an expected-value calculation.

Tier: V2 (fixup to test(v2): migrate functional fixtures and harnesses to native transactions)
---
 test/functional/feature_assumeutxo.py | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/test/functional/feature_assumeutxo.py b/test/functional/feature_assumeutxo.py
index 9820a1f5fc..89d3256b10 100644
--- a/test/functional/feature_assumeutxo.py
+++ b/test/functional/feature_assumeutxo.py
@@ -265,7 +265,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             log_msg = (
                 custom_message
                 if custom_message is not None
-                else f"[snapshot] bad snapshot content hash: expected 372adda95d453e80ce3d77396daa852c7bf620be323ea38eb61a34859dafc2b0, got {wrong_hash}"
+                else f"[snapshot] bad snapshot content hash: expected e991114bf2e506b572bf601810835a90ca0d61244a1275b658a0c4313fa357dd, got {wrong_hash}"
             )
             expected_error(log_msg=log_msg)
 
@@ -273,7 +273,7 @@ class AssumeutxoTest(BitcoinTestFramework):
         for node in self.nodes[1:4]:
             msg = (
                 "Unable to load UTXO snapshot: The base block header "
-                "(156d32f7cfa190182e918cca120b40d581ea751c956a04cb1bf03f2b20c7bf9f) "
+                "(233b7fcd1b62350a89af81c97ef7239ab149479137601a0475044ed694c041c7) "
                 "must appear in the headers chain. Make sure all headers are syncing, "
                 "and call loadtxoutset again."
             )
@@ -528,7 +528,7 @@ class AssumeutxoTest(BitcoinTestFramework):
             assert_equal(node.getblockcount(), height - 1)
             msg = (
                 "Unable to load UTXO snapshot: The base block header "
-                "(156d32f7cfa190182e918cca120b40d581ea751c956a04cb1bf03f2b20c7bf9f) "
+                "(233b7fcd1b62350a89af81c97ef7239ab149479137601a0475044ed694c041c7) "
                 "is part of an invalid chain."
             )
             assert_raises_rpc_error(-32603, msg, node.loadtxoutset, dump_output_path)
@@ -608,7 +608,7 @@ class AssumeutxoTest(BitcoinTestFramework):
         def check_dump_output(output):
             assert_equal(
                 output["txoutset_hash"],
-                "372adda95d453e80ce3d77396daa852c7bf620be323ea38eb61a34859dafc2b0",
+                "e991114bf2e506b572bf601810835a90ca0d61244a1275b658a0c4313fa357dd",
             )
             assert_equal(output["nchaintx"], blocks[SNAPSHOT_BASE_HEIGHT].chain_tx)
 
@@ -643,7 +643,7 @@ class AssumeutxoTest(BitcoinTestFramework):
         dump_output4 = n0.dumptxoutset(path="utxos4.dat", rollback=prev_snap_height)
         assert_equal(
             dump_output4["txoutset_hash"],
-            "0e2e9c0d7eb80914d04f9942c1ab3eace3adeb2513a2b6fafd12309736de6975",
+            "d62fb55e7ec68ceac6358dbe21a76a3359bf4c1a47f77b4f75391faead439375",
         )
         assert sha256sum_file(dump_output["path"]) != sha256sum_file(
             dump_output4["path"]
