From 5d7068cc695376af6710b0e6480f17ce33e895ce Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:48:17 -0700
Subject: [PATCH] tests: explicitly activate optional preconsensus in its
 mining fixture

Dogecoin disables preconsensus by default and activates it after the fixture timestamps. Enable both the optional capability and its test activation only in the preconsensus fixture; assert the requested mode is actually active after finalization. Retain all ordering and transaction selection assertions.

diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 6e5f77366c581ef7667ad42db2201dbfaca15892..10698d3a13f3a341420170c5b4f6ebf46f34f0e0 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -111,7 +111,7 @@ struct MinerTestingSetup : public AvalancheTestingSetup {
 // fixed subsidy and maturity instead of Bitcoin's hard-coded SHA256 nonces.
 class MiningValidityParams : public CChainParams {
 public:
-    MiningValidityParams() : CChainParams(Params()) {
+    explicit MiningValidityParams(bool preconsensus) : CChainParams(Params()) {
         const auto regtest = consensus;
         const auto main = CreateChainParams(ArgsManager{}, ChainType::MAIN);
         consensus = main->GetConsensus();
@@ -121,15 +121,22 @@ public:
         consensus.initialCoinbaseMaturity = regtest.initialCoinbaseMaturity;
         consensus.auxpowStartHeight = regtest.auxpowStartHeight;
         consensus.hashGenesisBlock = regtest.hashGenesisBlock;
+        if (preconsensus) {
+            consensus.avalanchePreconsensusActivationTime = 0;
+        }
     }
 };
 
 struct MinerTestingSetupNoCheckpoints : public MinerTestingSetup {
-    MinerTestingSetupNoCheckpoints()
-        : MinerTestingSetup({"-checkpoints=0"}, ChainType::REGTEST) {
+    explicit MinerTestingSetupNoCheckpoints(bool preconsensus = false)
+        : MinerTestingSetup(
+              {"-checkpoints=0", preconsensus ? "-avalanchepreconsensus=1"
+                                              : "-avalanchepreconsensus=0"},
+              ChainType::REGTEST) {
+        m_preconsensus = preconsensus;
         auto &config =
             static_cast<GlobalConfig &>(const_cast<Config &>(GetConfig()));
-        config.SetChainParams(MiningValidityParams{});
+        config.SetChainParams(MiningValidityParams{preconsensus});
     }
     ~MinerTestingSetupNoCheckpoints() {
         auto &config =
@@ -140,7 +147,8 @@ struct MinerTestingSetupNoCheckpoints : public MinerTestingSetup {
 
 struct PreconsensusMinerTestingSetupNoCheckpoints
     : public MinerTestingSetupNoCheckpoints {
-    PreconsensusMinerTestingSetupNoCheckpoints() { m_preconsensus = true; }
+    PreconsensusMinerTestingSetupNoCheckpoints()
+        : MinerTestingSetupNoCheckpoints(true) {}
 };
 
 } // namespace miner_tests
@@ -841,6 +849,9 @@ void MinerTestingSetup::CreateNewBlock_validity() {
     BOOST_CHECK(m_node.chainman->ActiveChainstate().AvalancheFinalizeBlock(
         finalized, *Assert(m_node.avalanche)));
     avalanche::AvalancheTest::setFinalizationTip(*m_node.avalanche, finalized);
+    BOOST_REQUIRE_EQUAL(
+        m_node.avalanche->isPreconsensusActivated(m_node.chainman->ActiveTip()),
+        m_preconsensus);
 
     TestBasicMining(chainparams, scriptPubKey, txFirst, baseheight);
 
