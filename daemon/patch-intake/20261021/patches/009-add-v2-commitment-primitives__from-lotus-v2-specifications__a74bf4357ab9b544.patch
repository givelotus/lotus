diff --git a/src/lotus_v2/commitment.cpp b/src/lotus_v2/commitment.cpp
new file mode 100644
index 000000000..96002a0c7
--- /dev/null
+++ b/src/lotus_v2/commitment.cpp
@@ -0,0 +1,173 @@
+#include "commitment.h"
+
+#include "tagged_hash.h"
+
+#include <algorithm>
+#include <limits>
+#include <vector>
+
+namespace lotus::v2 {
+namespace {
+
+std::vector<uint8_t> EncodeBytes(std::span<const uint8_t> bytes) {
+    const uint64_t n = bytes.size();
+    std::vector<uint8_t> out;
+    out.reserve(bytes.size() + 9);
+    if (n < 253) {
+        out.push_back(static_cast<uint8_t>(n));
+    } else if (n <= 0xffff) {
+        out.push_back(253);
+        out.push_back(static_cast<uint8_t>(n));
+        out.push_back(static_cast<uint8_t>(n >> 8));
+    } else if (n <= 0xffffffffU) {
+        out.push_back(254);
+        for (unsigned i = 0; i < 4; ++i) out.push_back(static_cast<uint8_t>(n >> (8 * i)));
+    } else {
+        out.push_back(255);
+        for (unsigned i = 0; i < 8; ++i) out.push_back(static_cast<uint8_t>(n >> (8 * i)));
+    }
+    out.insert(out.end(), bytes.begin(), bytes.end());
+    return out;
+}
+
+bool LessLittleEndian(const Hash &a, const Hash &b) {
+    for (int i = 31; i >= 0; --i) {
+        if (a[i] != b[i]) return a[i] < b[i];
+    }
+    return false;
+}
+
+Hash TransactionSubtree(std::span<const TxIdentityPair> txs) {
+    if (txs.empty()) return TaggedHash(HashDomain::TxRoot, std::array<uint8_t, 1>{2});
+    if (txs.size() == 1) {
+        std::array<uint8_t, 65> input{};
+        std::copy(txs[0].tx_hash.begin(), txs[0].tx_hash.end(), input.begin() + 1);
+        std::copy(txs[0].tx_id.begin(), txs[0].tx_id.end(), input.begin() + 33);
+        return TaggedHash(HashDomain::TxRoot, input);
+    }
+    size_t split = 1;
+    while (split < txs.size() - split) split <<= 1;
+    const Hash left = TransactionSubtree(txs.first(split));
+    const Hash right = TransactionSubtree(txs.subspan(split));
+    std::array<uint8_t, 65> input{};
+    input[0] = 1;
+    std::copy(left.begin(), left.end(), input.begin() + 1);
+    std::copy(right.begin(), right.end(), input.begin() + 33);
+    return TaggedHash(HashDomain::TxRoot, input);
+}
+
+Hash TransactionIdentity(HashDomain domain, const ChainId &chain_id,
+                         const TxHeaderCore &header_core, const Hash &input_root,
+                         const Hash &output_root) {
+    std::array<uint8_t, 112> input{};
+    std::copy(chain_id.begin(), chain_id.end(), input.begin());
+    std::copy(header_core.begin(), header_core.end(), input.begin() + 32);
+    std::copy(input_root.begin(), input_root.end(), input.begin() + 48);
+    std::copy(output_root.begin(), output_root.end(), input.begin() + 80);
+    return TaggedHash(domain, input);
+}
+
+} // namespace
+
+Hash InputCoreLeaf(std::span<const uint8_t> encoded_input_core) {
+    return TaggedHash(HashDomain::InputCore, encoded_input_core);
+}
+Hash InputFullLeaf(std::span<const uint8_t> encoded_input) {
+    return TaggedHash(HashDomain::InputFull, encoded_input);
+}
+Hash OutputLeaf(std::span<const uint8_t> serialized_output) {
+    return TaggedHash(HashDomain::Output, EncodeBytes(serialized_output));
+}
+Hash CoinEntryLeaf(std::span<const uint8_t> serialized_resolved_output) {
+    return TaggedHash(HashDomain::CoinEntry, EncodeBytes(serialized_resolved_output));
+}
+Hash BranchLeaf(std::span<const uint8_t> script) {
+    const auto bytes = EncodeBytes(script);
+    std::vector<uint8_t> input;
+    input.reserve(1 + bytes.size());
+    input.push_back(0);
+    input.insert(input.end(), bytes.begin(), bytes.end());
+    return TaggedHash(HashDomain::Branch, input);
+}
+Hash BranchNode(const Hash &a, const Hash &b) {
+    std::array<uint8_t, 65> input{};
+    const Hash &low = LessLittleEndian(a, b) ? a : b;
+    const Hash &high = LessLittleEndian(a, b) ? b : a;
+    input[0] = 1;
+    std::copy(low.begin(), low.end(), input.begin() + 1);
+    std::copy(high.begin(), high.end(), input.begin() + 33);
+    return TaggedHash(HashDomain::Branch, input);
+}
+Hash BranchProofRoot(const Hash &leaf, std::span<const Hash> bottom_up_siblings) {
+    Hash root = leaf;
+    for (const Hash &sibling : bottom_up_siblings) root = BranchNode(root, sibling);
+    return root;
+}
+Hash IndexedNode(uint16_t layer, const Hash &left, const Hash &right) {
+    std::array<uint8_t, 67> input{};
+    input[0] = 1;
+    input[1] = static_cast<uint8_t>(layer);
+    input[2] = static_cast<uint8_t>(layer >> 8);
+    std::copy(left.begin(), left.end(), input.begin() + 3);
+    std::copy(right.begin(), right.end(), input.begin() + 35);
+    return TaggedHash(HashDomain::MerkleIndex, input);
+}
+Hash IndexedTreeRoot(std::span<const Hash> leaves) {
+    if (leaves.empty()) return TaggedHash(HashDomain::MerkleIndex, std::array<uint8_t, 1>{2});
+    if (leaves.size() == 1) return leaves[0];
+    std::vector<Hash> cur(leaves.begin(), leaves.end());
+    uint16_t layer = 0;
+    while (cur.size() > 1) {
+        if (cur.size() & 1) cur.push_back(Hash{});
+        std::vector<Hash> next;
+        next.reserve(cur.size() / 2);
+        for (size_t i = 0; i < cur.size(); i += 2) {
+            next.push_back(IndexedNode(layer, cur[i], cur[i + 1]));
+        }
+        cur = std::move(next);
+        ++layer;
+    }
+    return cur[0];
+}
+bool IndexedProofRoot(const Hash &leaf, uint32_t index, uint32_t count,
+                      std::span<const Hash> siblings, Hash &out) {
+    if (count == 0 || index >= count) return false;
+    uint32_t width = count;
+    uint32_t offset = index;
+    size_t layer = 0;
+    Hash root = leaf;
+    while (width > 1) {
+        if (layer >= siblings.size()) return false;
+        const Hash &sibling = siblings[layer];
+        if ((offset & 1) == 0 && offset + 1 == width && sibling != Hash{}) return false;
+        root = (offset & 1) ? IndexedNode(layer, sibling, root)
+                            : IndexedNode(layer, root, sibling);
+        offset >>= 1;
+        width = (width + 1) / 2;
+        ++layer;
+    }
+    if (layer != siblings.size()) return false;
+    out = root;
+    return true;
+}
+Hash TransactionId(const ChainId &chain_id, const TxHeaderCore &header_core,
+                   const Hash &inputs_root, const Hash &outputs_root) {
+    return TransactionIdentity(HashDomain::TxId, chain_id, header_core, inputs_root, outputs_root);
+}
+Hash TransactionHash(const ChainId &chain_id, const TxHeaderCore &header_core,
+                     const Hash &full_inputs_root, const Hash &outputs_root) {
+    return TransactionIdentity(HashDomain::TxHash, chain_id, header_core, full_inputs_root, outputs_root);
+}
+bool TransactionRoot(std::span<const TxIdentityPair> transactions, Hash &out) {
+    if (transactions.size() > std::numeric_limits<uint32_t>::max()) return false;
+    const Hash subtree = TransactionSubtree(transactions);
+    std::array<uint8_t, 37> input{};
+    input[0] = 3;
+    const uint32_t count = transactions.size();
+    for (unsigned i = 0; i < 4; ++i) input[1 + i] = static_cast<uint8_t>(count >> (8 * i));
+    std::copy(subtree.begin(), subtree.end(), input.begin() + 5);
+    out = TaggedHash(HashDomain::TxRoot, input);
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/commitment.h b/src/lotus_v2/commitment.h
new file mode 100644
index 000000000..043ada197
--- /dev/null
+++ b/src/lotus_v2/commitment.h
@@ -0,0 +1,44 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_COMMITMENT_H
+#define LOTUS_V2_COMMITMENT_H
+
+#include "header.h"
+
+#include <array>
+#include <cstdint>
+#include <span>
+
+namespace lotus::v2 {
+
+// Inputs are canonical serialized P01 components supplied by the transaction
+// codec. These functions hash bytes; they do not validate their grammar.
+Hash InputCoreLeaf(std::span<const uint8_t> encoded_input_core);
+Hash InputFullLeaf(std::span<const uint8_t> encoded_input);
+Hash OutputLeaf(std::span<const uint8_t> serialized_output);
+Hash CoinEntryLeaf(std::span<const uint8_t> serialized_resolved_output);
+Hash BranchLeaf(std::span<const uint8_t> script);
+Hash BranchNode(const Hash &a, const Hash &b);
+Hash BranchProofRoot(const Hash &leaf, std::span<const Hash> bottom_up_siblings);
+
+Hash IndexedNode(uint16_t layer, const Hash &left, const Hash &right);
+Hash IndexedTreeRoot(std::span<const Hash> leaves);
+// Proof contains one sibling per layer. Missing right children must be zero.
+bool IndexedProofRoot(const Hash &leaf, uint32_t index, uint32_t count,
+                      std::span<const Hash> bottom_up_siblings, Hash &out);
+
+using TxHeaderCore = std::array<uint8_t, 16>;
+Hash TransactionId(const ChainId &chain_id, const TxHeaderCore &header_core,
+                   const Hash &inputs_root, const Hash &outputs_root);
+Hash TransactionHash(const ChainId &chain_id, const TxHeaderCore &header_core,
+                     const Hash &full_inputs_root, const Hash &outputs_root);
+
+struct TxIdentityPair {
+    Hash tx_hash;
+    Hash tx_id;
+};
+// Defined for the empty vector as a tool primitive. Block validity requires
+// a coinbase and imposes its own transaction-count limit.
+bool TransactionRoot(std::span<const TxIdentityPair> transactions, Hash &out);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/generate_commitment_vectors.py b/src/lotus_v2/generate_commitment_vectors.py
new file mode 100644
index 000000000..a42f4f50f
--- /dev/null
+++ b/src/lotus_v2/generate_commitment_vectors.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Independent P01/P02 commitment vectors; requires blake3==1.0.11.
+
+Run with the isolated environment documented in generate_vectors.py.
+"""
+import json
+
+import blake3
+
+
+def h(domain, value):
+    return blake3.blake3(b"Lotus/v2/" + domain.encode() + b"\0" + value).digest()
+
+
+def cs(n):
+    if n < 253:
+        return bytes([n])
+    if n <= 65535:
+        return b"\xfd" + n.to_bytes(2, "little")
+    if n <= 0xFFFFFFFF:
+        return b"\xfe" + n.to_bytes(4, "little")
+    return b"\xff" + n.to_bytes(8, "little")
+
+
+def branch_leaf(script):
+    return h("branch", b"\0" + cs(len(script)) + script)
+
+
+def branch_node(a, b):
+    low, high = sorted((a, b), key=lambda x: int.from_bytes(x, "little"))
+    return h("branch", b"\x01" + low + high)
+
+
+def indexed(leaves):
+    if not leaves:
+        return h("merkleidx", b"\x02")
+    cur = leaves[:]
+    layer = 0
+    while len(cur) > 1:
+        if len(cur) & 1:
+            cur.append(bytes(32))
+        cur = [h("merkleidx", b"\x01" + layer.to_bytes(2, "little") + cur[i] + cur[i + 1])
+               for i in range(0, len(cur), 2)]
+        layer += 1
+    return cur[0]
+
+
+def subtree(pairs):
+    if not pairs:
+        return h("txroot", b"\x02")
+    if len(pairs) == 1:
+        return h("txroot", b"\x00" + pairs[0][0] + pairs[0][1])
+    split = 1 << ((len(pairs) - 1).bit_length() - 1)
+    return h("txroot", b"\x01" + subtree(pairs[:split]) + subtree(pairs[split:]))
+
+
+def txroot(pairs):
+    return h("txroot", b"\x03" + len(pairs).to_bytes(4, "little") + subtree(pairs))
+
+
+def main():
+    assert blake3.__version__ == "1.0.11"
+    leaves = [h("inputcore", bytes([i])) for i in range(1, 6)]
+    pairs = [(bytes([i]) * 32, bytes([i + 16]) * 32) for i in range(1, 6)]
+    a = branch_leaf(b"\x51")
+    b = branch_leaf(b"\x52")
+    chain = bytes(range(32))
+    header = bytes(range(32, 48))
+    inroot = indexed(leaves[:3])
+    outroot = indexed([h("output", b"\x03\x01\x02\x03")])
+    payload = chain + header + inroot + outroot
+    result = {
+        "dependency": f"python-blake3 {blake3.__version__}",
+        "branch_leaf_51": a.hex(),
+        "branch_leaf_52": b.hex(),
+        "branch_leaf_253": branch_leaf(bytes([0x51]) * 253).hex(),
+        "branch_node": branch_node(a, b).hex(),
+        "inputcore_leaf_01": leaves[0].hex(),
+        "inputfull_leaf_01": h("inputfull", b"\x01").hex(),
+        "output_leaf_010203": h("output", b"\x03\x01\x02\x03").hex(),
+        "coinentry_mint": h("coinentry", b"\x00").hex(),
+        "indexed_roots": [indexed(leaves[:n]).hex() for n in range(6)],
+        "transaction_id": h("txid", payload).hex(),
+        "transaction_hash": h("txhash", payload).hex(),
+        "transaction_roots": [txroot(pairs[:n]).hex() for n in range(6)],
+    }
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
