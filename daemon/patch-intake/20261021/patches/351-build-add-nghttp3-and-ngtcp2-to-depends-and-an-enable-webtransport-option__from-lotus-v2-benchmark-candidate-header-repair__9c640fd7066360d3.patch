diff --git a/cmake/modules/FindNghttp3.cmake b/cmake/modules/FindNghttp3.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..334005acf5d0c5b9b88c29ff12f6ed3d18933bfd
--- /dev/null
+++ b/cmake/modules/FindNghttp3.cmake
@@ -0,0 +1,72 @@
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#.rst
+# FindNghttp3
+# -----------
+#
+# Find the nghttp3 HTTP/3 library, as built by depends (packages/nghttp3.mk)
+# with the local patch that adds nghttp3_conn_set_extra_settings(). A stock
+# nghttp3 (e.g. from a system package manager) lacks that API and is
+# rejected, so point Nghttp3_ROOT or CMAKE_PREFIX_PATH at the depends prefix.
+#
+# This will define the following variables::
+#
+#   Nghttp3_FOUND - system has the patched nghttp3 lib
+#   Nghttp3_INCLUDE_DIRS - the nghttp3 include directories
+#   Nghttp3_LIBRARIES - Libraries needed to use nghttp3
+#   Nghttp3_VERSION - The library version MAJOR.MINOR.PATCH
+#
+# And the following imported target::
+#
+#   Nghttp3::nghttp3
+
+find_package(PkgConfig)
+pkg_check_modules(PC_Nghttp3 QUIET libnghttp3)
+
+find_path(Nghttp3_INCLUDE_DIR
+	NAMES nghttp3/nghttp3.h
+	PATHS ${PC_Nghttp3_INCLUDE_DIRS}
+	PATH_SUFFIXES include
+)
+
+set(Nghttp3_INCLUDE_DIRS ${Nghttp3_INCLUDE_DIR})
+mark_as_advanced(Nghttp3_INCLUDE_DIR)
+
+set(_Nghttp3_PATCHED FALSE)
+if(Nghttp3_INCLUDE_DIR)
+	file(READ "${Nghttp3_INCLUDE_DIR}/nghttp3/version.h" _Nghttp3_VERSION_H)
+	string(REGEX REPLACE ".*#define[ \t]+NGHTTP3_VERSION[ \t]+\"([0-9.]+)[^\"]*\".*" "\\1"
+		Nghttp3_VERSION "${_Nghttp3_VERSION_H}"
+	)
+
+	file(READ "${Nghttp3_INCLUDE_DIR}/nghttp3/nghttp3.h" _Nghttp3_HEADER)
+	string(FIND "${_Nghttp3_HEADER}" "nghttp3_conn_set_extra_settings" _Nghttp3_EXTRA)
+	if(_Nghttp3_EXTRA GREATER -1)
+		set(_Nghttp3_PATCHED TRUE)
+	else()
+		message(STATUS
+			"nghttp3 at ${Nghttp3_INCLUDE_DIR} lacks the depends patch "
+			"(nghttp3_conn_set_extra_settings); ignoring it"
+		)
+		unset(Nghttp3_INCLUDE_DIR CACHE)
+		set(Nghttp3_INCLUDE_DIR "Nghttp3_INCLUDE_DIR-NOTFOUND")
+	endif()
+endif()
+
+if(_Nghttp3_PATCHED)
+	include(ExternalLibraryHelper)
+	find_component(Nghttp3 nghttp3
+		NAMES nghttp3
+		INCLUDE_DIRS ${Nghttp3_INCLUDE_DIRS}
+		PATHS ${PC_Nghttp3_LIBRARY_DIRS}
+	)
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(Nghttp3
+	REQUIRED_VARS Nghttp3_INCLUDE_DIR
+	VERSION_VAR Nghttp3_VERSION
+	HANDLE_COMPONENTS
+)
diff --git a/cmake/modules/FindNgtcp2.cmake b/cmake/modules/FindNgtcp2.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..bb13220c8ba594ada02b5d27979cd2009b7a0f9a
--- /dev/null
+++ b/cmake/modules/FindNgtcp2.cmake
@@ -0,0 +1,63 @@
+# Copyright (c) 2026 The Bitcoin developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#.rst
+# FindNgtcp2
+# ----------
+#
+# Find the ngtcp2 QUIC library and its OpenSSL (>= 3.5) crypto backend, as
+# built by depends (packages/ngtcp2.mk).
+#
+# This will define the following variables::
+#
+#   Ngtcp2_FOUND - system has the ngtcp2 lib
+#   Ngtcp2_INCLUDE_DIRS - the ngtcp2 include directories
+#   Ngtcp2_LIBRARIES - Libraries needed to use ngtcp2
+#   Ngtcp2_VERSION - The library version MAJOR.MINOR.PATCH
+#
+# And the following imported targets, one per component::
+#
+#   Ngtcp2::ngtcp2
+#   Ngtcp2::crypto_ossl
+
+find_package(PkgConfig)
+pkg_check_modules(PC_Ngtcp2 QUIET libngtcp2)
+pkg_check_modules(PC_Ngtcp2_crypto_ossl QUIET libngtcp2_crypto_ossl)
+
+find_path(Ngtcp2_INCLUDE_DIR
+	NAMES ngtcp2/ngtcp2.h
+	PATHS ${PC_Ngtcp2_INCLUDE_DIRS}
+	PATH_SUFFIXES include
+)
+
+set(Ngtcp2_INCLUDE_DIRS ${Ngtcp2_INCLUDE_DIR})
+mark_as_advanced(Ngtcp2_INCLUDE_DIR)
+
+if(Ngtcp2_INCLUDE_DIR)
+	file(READ "${Ngtcp2_INCLUDE_DIR}/ngtcp2/version.h" _Ngtcp2_VERSION_H)
+	string(REGEX REPLACE ".*#define[ \t]+NGTCP2_VERSION[ \t]+\"([0-9.]+)[^\"]*\".*" "\\1"
+		Ngtcp2_VERSION "${_Ngtcp2_VERSION_H}"
+	)
+
+	include(ExternalLibraryHelper)
+	find_component(Ngtcp2 ngtcp2
+		NAMES ngtcp2
+		INCLUDE_DIRS ${Ngtcp2_INCLUDE_DIRS}
+		PATHS ${PC_Ngtcp2_LIBRARY_DIRS}
+	)
+	# The crypto backend calls into libngtcp2 and OpenSSL: link it before
+	# both (static libraries).
+	find_component(Ngtcp2 crypto_ossl
+		NAMES ngtcp2_crypto_ossl
+		INCLUDE_DIRS ${Ngtcp2_INCLUDE_DIRS}
+		PATHS ${PC_Ngtcp2_crypto_ossl_LIBRARY_DIRS}
+	)
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(Ngtcp2
+	REQUIRED_VARS Ngtcp2_INCLUDE_DIR
+	VERSION_VAR Ngtcp2_VERSION
+	HANDLE_COMPONENTS
+)
