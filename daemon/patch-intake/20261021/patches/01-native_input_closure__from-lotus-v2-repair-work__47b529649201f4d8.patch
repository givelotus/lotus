From ec0f528e9f76444127e480ee1c6c126d2d768602 Mon Sep 17 00:00:00 2001
From: Canonical endpoint audit <audit@localhost>
Date: Sun, 18 Oct 2026 22:49:37 -0700
Subject: [PATCH] net(v2): recognize native state inputs in exact epoch scope
 validation

---
 src/net_processing.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 9f2bbd4e23..cb7bcbf6a3 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -9378,6 +9378,7 @@ std::optional<bool> PeerManagerImpl::ValidateEpochScope(const avalanche::Mempool
         const auto entry = m_mempool.GetIter(tx->GetId());
         if (!entry) return false;
         for (const auto &input : tx->vin) {
+            if (input.nFlags == 3) continue;
             if (m_mempool.exists(input.prevout.GetTxId())) {
                 if (!selected.count(input.prevout.GetTxId())) return false;
             } else if (!m_chainman.ActiveChainstate().CoinsTip().HaveCoin(input.prevout)) return false;
