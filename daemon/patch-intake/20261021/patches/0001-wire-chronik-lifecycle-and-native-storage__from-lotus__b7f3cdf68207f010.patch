From a111db3d9eb283361de7e665561f180c9dde233a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 18:28:11 -0700
Subject: [PATCH] chronik: wire optional verified BCHN host lifecycle and
 snapshots

Keep the feature default OFF and independent of transport/mining/policy candidates. Verify a pinned external shared-source overlay before compilation. Capture validated admission coins before mutation and descendant-first removal snapshots without changing native mempool behavior; drain callbacks and interrupt HTTP before native teardown. Expose existing native undo storage and a dedicated debug category.
---
 CMakeLists.txt                       | 16 +++++++++++++++
 src/chronik/options.h                | 29 ++++++++++++++++++++++++++++
 src/chronik/validation_hooks.h       | 15 ++++++++++++++
 src/config/bitcoin-config.h.cmake.in |  3 +++
 src/init.cpp                         | 22 +++++++++++++++++++++
 src/logging.cpp                      |  1 +
 src/logging.h                        |  2 ++
 src/node/blockstorage.cpp            |  4 ++--
 src/node/blockstorage.h              |  1 +
 src/txmempool.cpp                    | 20 +++++++++++++++++++
 src/validation.cpp                   |  6 ++++++
 11 files changed, 117 insertions(+), 2 deletions(-)
 create mode 100644 src/chronik/options.h
 create mode 100644 src/chronik/validation_hooks.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d17894dba3c582d0c823d52cd57b5fd4ed3b26cd..366cd2fd64be80868111dc650e5c465249a4f572 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -117,3 +117,19 @@ endif()
 
+option(BUILD_CHRONIK "Build optional pinned in-process Chronik" OFF)
+option(BUILD_CHRONIK_PLUGINS "Enable Chronik Python plugins" OFF)
+set(CHRONIK_SOURCE_DIR "" CACHE PATH "Pinned Chronik source export")
+set(CHRONIK_PROVIDER_MODULE "" CACHE FILEPATH "Verified shared Chronik provider")
+set(ENABLE_CHRONIK ${BUILD_CHRONIK})
 add_subdirectory(src)
+if(BUILD_CHRONIK)
+    if(BUILD_CHRONIK_PLUGINS)
+        message(FATAL_ERROR "The BCHN Chronik profile does not enable Python plugins")
+    endif()
+    if(NOT CHRONIK_SOURCE_DIR OR NOT EXISTS "${CHRONIK_PROVIDER_MODULE}")
+        message(FATAL_ERROR "BCHN Chronik requires a pinned export and CHRONIK_PROVIDER_MODULE")
+    endif()
+    include("${CHRONIK_PROVIDER_MODULE}")
+    lotus_add_chronik_from_source(SOURCE_DIR "${CHRONIK_SOURCE_DIR}" HOST_PROFILE bchn
+        HOST_UPSTREAM_COMMIT abd433abe04f74780744b9eac06731f3690ce68a)
+endif()
 if(ENABLE_TEST)
