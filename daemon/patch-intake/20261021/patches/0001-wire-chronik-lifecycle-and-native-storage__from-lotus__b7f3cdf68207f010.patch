@@ -0,0 +1,29 @@
+// Copyright (c) 2026 The Bitcoin Cash Node developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+#ifndef BITCOIN_CHRONIK_OPTIONS_H
+#define BITCOIN_CHRONIK_OPTIONS_H
+#include <string>
+#include <util/system.h>
+#include <vector>
+
+namespace chronik {
+// Keep host argument parsing in the native source; the shared component only
+// receives reviewed values and has no knowledge of extra native CLI options.
+struct Options {
+    std::vector<std::string> binds;
+    bool token_index;
+    bool script_hash_index;
+    bool cors;
+};
+inline Options ReadOptions(const ArgsManager &args) {
+    return {
+        .binds = args.IsArgSet("-chronikbind") ? args.GetArgs("-chronikbind")
+                                               : std::vector<std::string>{"127.0.0.1", "::1"},
+        .token_index = args.GetBoolArg("-chroniktokenindex", false),
+        .script_hash_index = args.GetBoolArg("-chronikscripthashindex", true),
+        .cors = args.GetBoolArg("-chronikcors", false),
+    };
+}
+} // namespace chronik
+#endif // BITCOIN_CHRONIK_OPTIONS_H
