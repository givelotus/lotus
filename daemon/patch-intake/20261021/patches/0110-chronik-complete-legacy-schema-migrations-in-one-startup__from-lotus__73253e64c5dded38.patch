From 9e22bf44369c4d9ba4af8f8ffb4ca68cb36cdfeb Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:32:47 -0700
Subject: [PATCH] chronik: complete legacy schema migrations in one startup

The inherited migration driver failed to advance its local schema version after11-to-12, so schemas10/11 skipped the final12-to-13 step. Advance after success and extract transaction/shutdown loaders for a database-backed regression covering each starting version. Independently verify legacy length-prefixed UTXO entries migrate to the current encoding.

diff --git a/chronik/chronik-db/src/io/group_utxos.rs b/chronik/chronik-db/src/io/group_utxos.rs
index 3b4e40fb61c991e4945a76533cae7eef07f15315..daf5b4e98e798706bf02a7b6b5500d78315fef8a 100644
--- a/chronik/chronik-db/src/io/group_utxos.rs
+++ b/chronik/chronik-db/src/io/group_utxos.rs
@@ -509,6 +509,26 @@ mod tests {
         test::{make_inputs_tx, ser_value, ValueGroup},
     };
 
+    #[test]
+    fn test_legacy_utxo_encoding_upgrade() -> Result<()> {
+        let tempdir = tempdir::TempDir::new("chronik-legacy-utxo")?;
+        let mut cfs = Vec::new();
+        GroupUtxoWriter::<ValueGroup>::add_cfs(&mut cfs);
+        let db = Db::open_with_cfs(tempdir.path(), cfs)?;
+        let writer = GroupUtxoWriter::new(&db, ValueGroup)?;
+        let reader = GroupUtxoReader::<ValueGroup>::new(&db)?;
+        let entries = vec![
+            UtxoEntry { outpoint: DbOutpoint { tx_num: 1, out_idx: 2 }, data: 100i64 },
+            UtxoEntry { outpoint: DbOutpoint { tx_num: 3, out_idx: 4 }, data: 100i64 },
+        ];
+        let mut batch = WriteBatch::default();
+        batch.put_cf(writer.col.cf, ser_value(100), crate::ser::db_serialize(&entries)?);
+        db.write_batch(batch)?;
+        writer.upgrade_10_to_11()?;
+        assert_eq!(reader.utxos(&ser_value(100))?, Some(entries));
+        Ok(())
+    }
+
     #[test]
     fn test_value_group_utxos() -> Result<()> {
         abc_rust_error::install();
