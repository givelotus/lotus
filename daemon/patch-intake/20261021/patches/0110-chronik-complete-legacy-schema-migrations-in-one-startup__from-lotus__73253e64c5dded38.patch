 }
@@ -1744,6 +1755,29 @@ mod tests {
         Ok([b"DECOMPRESS:".as_ref(), script.as_ref()].concat())
     }
 
+    #[test]
+    fn test_legacy_schema_upgrade_reaches_current_version() -> Result<()> {
+        for version in [10, 11, 12] {
+            let tempdir = tempdir::TempDir::new("chronik-legacy-migration")?;
+            let db = Db::open(tempdir.path())?;
+            let mut batch = WriteBatch::default();
+            MetadataWriter::new(&db)?.update_schema_version(&mut batch, version)?;
+            db.write_batch(batch)?;
+            super::upgrade_db_with_loaders(
+                &db,
+                version,
+                false,
+                |_, _, _| panic!("Empty legacy DB must not load a transaction"),
+                || false,
+            )?;
+            assert_eq!(
+                MetadataReader::new(&db)?.schema_version()?,
+                Some(CURRENT_INDEXER_VERSION),
+            );
+        }
+        Ok(())
+    }
+
