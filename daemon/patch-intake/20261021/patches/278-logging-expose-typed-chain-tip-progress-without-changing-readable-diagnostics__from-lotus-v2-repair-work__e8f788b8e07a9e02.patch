+{
+  "schema": 1,
+  "batch": "chain-tip-progress",
+  "review_note": "Typed chain tip progress; preserve unrestricted IBD delivery and human text. Eleven explicit registry additions; exact source diff regenerated by reviewed AST mapping.",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "chain_tip_updated",
+          "old": "LogPrintLevel_(\n        BCLog::LogFlags::ALL, BCLog::Level::Info,\n        /*should_ratelimit=*/false,\n        \"%s%s: new best=%s height=%d version=0x%08x log2_work=%f tx=%lu \"\n        \"date='%s' progress=%f cache=%.1fMiB(%utxo)\\n\",\n        prefix, func_name, tip->GetBlockHash().ToString(), tip->nHeight,\n        tip->nHeaderVersion, log(tip->nChainWork.getdouble()) / log(2.0),\n        tip->GetChainTxCount(), FormatISO8601DateTime(tip->GetBlockTime()),\n        GuessVerificationProgress(params.TxData(), tip),\n        coins_tip.DynamicMemoryUsage() * (1.0 / (1 << 20)),\n        coins_tip.GetCacheSize())",
+          "replacement": "LogInfoEventNoRateLimit(\n        BCLog::LogFlags::ALL, \"chain_tip_updated\",\n        \"{log_prefix}{source_function}: new best={block_hash} height={height} \"\n        \"version=0x{version:08x} log2_work={log2_work:f} tx={chain_tx_count} \"\n        \"date='{block_time}' progress={verification_progress:f} \"\n        \"cache={utxo_cache_mib:.1f}MiB({utxo_cache_coins}txo)\")\n        .Field(BCLog::LogField::LogPrefix, prefix)\n        .Field(BCLog::LogField::SourceFunction, func_name)\n        .Field(BCLog::LogField::BlockHash, tip->GetBlockHash())\n        .Field(BCLog::LogField::Height, tip->nHeight)\n        .Field(BCLog::LogField::Version, uint32_t(tip->nHeaderVersion))\n        .Field(BCLog::LogField::Log2Work,\n               log(tip->nChainWork.getdouble()) / log(2.0))\n        .Field(BCLog::LogField::ChainTxCount, tip->GetChainTxCount())\n        .Field(BCLog::LogField::BlockTime,\n               FormatISO8601DateTime(tip->GetBlockTime()))\n        .Field(BCLog::LogField::VerificationProgress,\n               GuessVerificationProgress(params.TxData(), tip))\n        .Field(BCLog::LogField::UTXOCacheMiB,\n               coins_tip.DynamicMemoryUsage() * (1.0 / (1 << 20)))\n        .Field(BCLog::LogField::UTXOCacheCoins, coins_tip.GetCacheSize())\n        .Field(BCLog::LogField::UTXOCacheBytes, coins_tip.DynamicMemoryUsage())\n        .Field(BCLog::LogField::BlockTimeSeconds, tip->GetBlockTime())\n        .Field(BCLog::LogField::ChainstateRole,\n               prefix.empty() ? BCLog::LogStatic(\"active\")\n                              : BCLog::LogStatic(\"background\"))",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintLevel_",
+            "format": "%s%s: new best=%s height=%d version=0x%08x log2_work=%f tx=%lu date='%s' progress=%f cache=%.1fMiB(%utxo)\n",
+            "specifiers": [
+              "%s",
+              "%s",
+              "%s",
+              "%d",
+              "%08x",
+              "%f",
+              "%lu",
+              "%s",
+              "%f",
+              "%.1f",
+              "%u"
+            ],
+            "arguments": [
+              "prefix",
+              "func_name",
+              "tip->GetBlockHash().ToString()",
+              "tip->nHeight",
+              "tip->nHeaderVersion",
+              "log(tip->nChainWork.getdouble()) / log(2.0)",
+              "tip->GetChainTxCount()",
+              "FormatISO8601DateTime(tip->GetBlockTime())",
+              "GuessVerificationProgress(params.TxData(), tip)",
+              "coins_tip.DynamicMemoryUsage() * (1.0 / (1 << 20))",
+              "coins_tip.GetCacheSize()"
+            ]
+          },
+          "review_note": "Keep exact human wording/printf precision and explicit rate-limit bypass. Version is the unsigned 32-bit header bit pattern, not a formatted string; BlockHash copies uint256 instead of caller ToString. Counts/bytes and Unix seconds are typed numeric fields. Active/background role is explicit; cache_mib is binary MiB, with raw bytes included separately. Original producer ISO timestamp formatting is retained; no new producer formatting or background pointer retention."
+        }
+      ],
+      "support_adjustments": [
+        {
+          "purpose": "Update comment to describe the typed event while preserving the existing IBD rate-limit bypass.",
+          "old": "// Disable rate limiting in LogPrintLevel_ so this source location may log\n    // during IBD.",
+          "new": "// Preserve unrestricted progress reporting during IBD; ring-full policy\n    // remains the same as other Info events."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Declare typed tip/progress fields with precise cache/time units; existing field ordinals unchanged.",
+          "old": "    X(ElapsedMs, elapsed_ms, FLOAT, \"\", \"\")",
+          "new": "    X(ElapsedMs, elapsed_ms, FLOAT, \"\", \"\") \\\n    X(LogPrefix, log_prefix, STRING, \"\", \"\") \\\n    X(SourceFunction, source_function, STRING, \"\", \"\") \\\n    X(Log2Work, log2_work, FLOAT, \"\", \"\") \\\n    X(ChainTxCount, chain_tx_count, UINT, \"\", \"\") \\\n    X(BlockTime, block_time, STRING, \"\", \"\") \\\n    X(BlockTimeSeconds, block_time_seconds, INT, \"\", \"\") \\\n    X(VerificationProgress, verification_progress, FLOAT, \"\", \"\") \\\n    X(UTXOCacheMiB, utxo_cache_mib, FLOAT, \"\", \"\") \\\n    X(UTXOCacheCoins, utxo_cache_coins, UINT, \"\", \"\") \\\n    X(UTXOCacheBytes, utxo_cache_bytes, UINT, \"\", \"\") \\\n    X(ChainstateRole, chainstate_role, STRING, \"\", \"\")"
+        }
+      ]
+    }
+  ]
+}
