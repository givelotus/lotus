+    std::vector<int> prevalidated_overlay_sigchecks;
+    if (!fJustCheck && fScriptChecks && m_mempool && block.vtx.size() > 1 &&
+        pindex->pprev != nullptr && pindex->pprev->pprev != nullptr &&
+        GetNextBlockScriptFlags(pindex->pprev, m_chainman) ==
