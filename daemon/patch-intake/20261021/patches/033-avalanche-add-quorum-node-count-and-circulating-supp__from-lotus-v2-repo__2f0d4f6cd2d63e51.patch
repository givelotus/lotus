+     * spuriously on such event, the quorum establishment is latched. The only
+     * parameter that should not be latched is the minimum node count, as this
      * would cause the poll to be inconclusive anyway and should not happen
      * under normal circumstances.
      */
-    if (quorumIsEstablished) {
+    if (quorumIsEstablished.load()) {
         return true;
     }
 
@@ -909,28 +934,22 @@ bool Processor::isQuorumEstablished() {
