+        const Amount fee = 2 * relay_floor;
+        BOOST_REQUIRE(fee >= relay_floor);
+        BOOST_REQUIRE(fee < mempool_floor);
+        BOOST_TEST_MESSAGE("native_package_fixture serialized_bytes=" << prototype->GetTotalSize()
