From 4cf91447e1c2ec3b3054369ed4871a872fdb8e59 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] snapshot: restore lazy vectors and pending overlay
 declarations

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Defer materializing sorted mempool tx vectors in RCU snapshots until requested
and cache recent block state snapshots in a 64-entry LRU table.

Original-Commit: ddd0daad2b3218b1f1e8556742affe8561c80f20
Original-Patch: ecash/037
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.

Candidate-Application-Repair: Retain the genuine always-lazy overlay insertion upgrade and original no-flush scope-exit optimization (historically paired with56), with reads/freeze/removal still flushing pending state. Immutable vector/mining declarations already exist in evidenced COW foundation; omit duplicate old header state rather than reverting immutable ownership.
---
 src/txmempool.cpp | 11 ++---------
 1 file changed, 2 insertions(+), 9 deletions(-)

diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index f91d3e74392660f6f6689f059a1a821574fbe441..f2f650157162fc99bbfdda37acf9c7acbe8c00ca 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -213,14 +213,8 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
         }
     }
     UpdateParentsOf(true, newit);
-    if (m_snapshot_defer_depth > 0) {
-        m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
-                                           entry->GetSigChecks());
-    } else {
-        FlushPendingOverlayAdds();
-        AddTransactionToOverlay(m_merklix_overlay, tx,
-                                entry->GetFee() / SATOSHI, entry->GetSigChecks());
-    }
+    m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
+                                       entry->GetSigChecks());
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
@@ -1066,7 +1060,6 @@ CTxMemPool::ScopedSnapshotDefer::~ScopedSnapshotDefer() {
     AssertLockHeld(m_pool.cs);
     assert(m_pool.m_snapshot_defer_depth > 0);
     if (--m_pool.m_snapshot_defer_depth == 0) {
-        m_pool.FlushPendingOverlayAdds();
         if (m_pool.m_snapshot_dirty) {
             m_pool.m_snapshot_dirty = false;
             node::PublishMempoolSnapshot(m_pool);
