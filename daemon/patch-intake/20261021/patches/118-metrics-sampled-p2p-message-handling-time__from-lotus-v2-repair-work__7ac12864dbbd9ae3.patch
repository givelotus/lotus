From 44a32fef166b24d5404a92ef70adb6a5d6c0db9f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 02:03:12 -0700
Subject: [PATCH] metrics: sampled P2P message handling time

The time to process a received P2P message, by message type, measured
for one message in 16: two clock reads per message (about 27 ns) would
cost more than the metric is worth on the message handler thread. The
sampling counter is a plain member, only touched by that thread. The
histogram's _count is therefore a sample; message totals are in
lotus_p2p_received_messages_total.

(cherry picked from commit 72f00057694a58a89f31bdd2ca299f1d5c36b3cf)

Canonical shared adaptation: ProcessMessages coalesces contiguous TX and
Avalanche-response batches. Sample one unchanged dispatch turn in16 and
attribute its total time to the initial message type, captured before a
message can be moved into a batch. Help text explicitly says message or
coalesced batch; actual message counters remain separate. Do not split batches,
change validation or pretend a batch latency is one transaction's latency.

N3-Source-Commit: 72f00057694a58a89f31bdd2ca299f1d5c36b3cf
N3-Source-Export: 0010
---
 src/net_processing.cpp                    | 20 ++++++++++++++++++++
 src/node/metrics.cpp                      | 12 ++++++++++++
 src/node/metrics.h                        |  4 ++++
 test/functional/interface_http_metrics.py |  2 ++
 4 files changed, 38 insertions(+)

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 3375fa71a94d1bbe05ec71d3599c92b5c24bcadf..ea77cf2b63cc7ef408b68cc5404f4ea80f091ca1 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -34,6 +34,7 @@
 #include <netbase.h>
 #include <netmessagemaker.h>
 #include <node/blockstorage.h>
+#include <node/metrics.h>
 #include <node/miner.h>
 #include <policy/fees.h>
 #include <policy/policy.h>
@@ -1279,6 +1280,10 @@ private:
 
     const Options m_opts;
 
+    //! Messages processed, to sample their handling time for metrics. Only
+    //! touched by ProcessMessages (the message handler thread).
+    uint32_t m_metrics_message_count{0};
+
     bool RejectIncomingTxs(const CNode &peer) const;
 
     /**
@@ -8520,6 +8525,17 @@ bool PeerManagerImpl::ProcessMessages(const Config &config, CNode *pfrom,
     }
 
     try {
+        // Sample one dispatch turn in sixteen. A turn may coalesce a
+        // contiguous transaction or Avalanche-response batch; preserve that
+        // processing path and attribute the total time to its initial type.
+        std::optional<SteadyClock::time_point> timed;
+        auto *metrics{node::GetNodeMetrics()};
+        const size_t timed_type{
+            metrics ? node::MetricMsgTypeIndex(msg.m_type) : 0};
+        if (metrics &&
+            ++m_metrics_message_count % METRICS_P2P_TIMING_SAMPLE == 0) {
+            timed = SteadyClock::now();
+        }
         if (msg.m_type == NetMsgType::TX && fMoreWork &&
             !RejectIncomingTxs(*pfrom) &&
             !m_chainman.IsInitialBlockDownload()) {
@@ -8639,6 +8655,10 @@ bool PeerManagerImpl::ProcessMessages(const Config &config, CNode *pfrom,
             ProcessMessage(config, *pfrom, msg.m_type, msg.m_recv, msg.m_time,
                            interruptMsgProc);
         }
+        if (timed) {
+            metrics->p2p_message_handling_seconds.RecordDuration(
+                SteadyClock::now() - *timed, timed_type);
+        }
         if (interruptMsgProc) {
             return false;
         }
diff --git a/src/node/metrics.cpp b/src/node/metrics.cpp
index 4065bd527d33e0eb39134f765f03fcd22daefa86..d9b63cd60eb1e5b4d85945eeef03ae5c0a80b284 100644
--- a/src/node/metrics.cpp
+++ b/src/node/metrics.cpp
@@ -69,6 +69,11 @@ namespace {
     const std::vector<double> BLOCK_CONNECT_BUCKETS{
         0.0001, 0.00025, 0.0005, 0.001, 0.0025, 0.005, 0.01, 0.025, 0.05,
         0.1,    0.25,    0.5,    1,     2.5,    5,     10,   30,    60};
+    //! Seconds; P2P message handling, from a ping to a large block
+    const std::vector<double> MESSAGE_BUCKETS{
+        0.00001, 0.000025, 0.00005, 0.0001, 0.00025, 0.0005,
+        0.001,   0.0025,   0.005,   0.01,   0.025,   0.05,
+        0.1,     0.25,     0.5,     1,      2.5,     10};
     //! Seconds; HTTP and RPC requests (long polls can take minutes)
     const std::vector<double> REQUEST_BUCKETS{
         0.0001, 0.00025, 0.0005, 0.001, 0.0025, 0.005, 0.01, 0.025, 0.05, 0.1,
@@ -115,6 +120,13 @@ NodeMetrics::NodeMetrics()
           Add<Counter>(registry, "lotus_p2p_sent_messages_total",
                        "P2P messages queued for sending, by message type.",
                        std::vector<LabelDim>{{"type", L::MsgTypes()}})},
+      p2p_message_handling_seconds{Add<EventHistogram>(
+          registry, "lotus_p2p_message_handling_seconds",
+          "Time to process a received P2P message or coalesced batch, by initial message type. Only "
+          "one dispatch turn in 16 is timed: _count is a sample, use "
+          "lotus_p2p_received_messages_total for totals.",
+          MESSAGE_BUCKETS, /*divisor=*/1e9,
+          std::vector<LabelDim>{{"type", L::MsgTypes()}})},
       peers{Add<Gauge>(registry, "lotus_peers",
                        "Connected peers, by direction, transport and network.",
                        std::vector<LabelDim>{{"direction", L::Directions()},
diff --git a/src/node/metrics.h b/src/node/metrics.h
index 97c89dbfe5d932234d10257dafd7755bc6dca668..450c70ad76cec269c83ecd736f5d2887e3f635b7 100644
--- a/src/node/metrics.h
+++ b/src/node/metrics.h
@@ -18,6 +18,8 @@
 static constexpr bool DEFAULT_METRICS{false};
 //! Repeated scrapes within this interval get the previous rendering
 static constexpr std::chrono::milliseconds METRICS_MIN_SCRAPE_INTERVAL{1000};
+//! One P2P message in this many has its handling time measured
+static constexpr uint32_t METRICS_P2P_TIMING_SAMPLE{16};
 
 namespace node {
 
@@ -59,6 +61,8 @@ struct NodeMetrics {
     metrics::Counter &p2p_sent_bytes;
     metrics::Counter &p2p_received_messages;
     metrics::Counter &p2p_sent_messages;
+    //! 1 in METRICS_P2P_TIMING_SAMPLE messages
+    metrics::EventHistogram &p2p_message_handling_seconds;
 
     // Peers (CNode objects), by direction x transport x network
     metrics::Gauge &peers;
diff --git a/test/functional/interface_http_metrics.py b/test/functional/interface_http_metrics.py
index 7502df28a096934949b01b716c0cb198807926ec..b1c259e3162f197a0b837404774be15150d1a835 100755
--- a/test/functional/interface_http_metrics.py
+++ b/test/functional/interface_http_metrics.py
@@ -176,6 +176,8 @@ class HTTPMetricsTest(BitcoinTestFramework):
         age = samples[("lotus_chain_tip_age_seconds", ())]
         assert abs(age - (time.time() - tip_time)) < 30, age
         assert samples[("lotus_block_connect_seconds_sum", ())] > 0
+        # Message handling is timed for 1 message in 16.
+        assert self.total(samples, "lotus_p2p_message_handling_seconds_count") > 0
 
         self.log.info("HTTP and RPC requests")
         node.getblockcount()
