From df44575ec09163f903e02c6fe454095f5d489560 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:01:04 -0700
Subject: [PATCH] chronik(v2): decode native requests before legacy projections

Delegate version 7 validate and broadcast frames to the node decoder before the inherited legacy parser. Preserve legacy parsing errors and reject malformed native bytes instead of rebuilding an unrelated transaction from empty legacy fields. Both host adapters propagate the same node decode exception.

Tier: V2 (fixup to v2/035 Chronik bridge and native ABC host adapter)
---
 chronik/chronik-cpp/chronik_bridge.cpp         |  9 +++++++--
 chronik/chronik-indexer/src/query/broadcast.rs | 16 +++++++++++-----
 chronik/native/hosts/abc/abc_host.cpp          | 13 ++++++++++---
 3 files changed, 28 insertions(+), 10 deletions(-)

diff --git a/chronik/chronik-cpp/chronik_bridge.cpp b/chronik/chronik-cpp/chronik_bridge.cpp
index 36115487e9..133f0fec43 100644
--- a/chronik/chronik-cpp/chronik_bridge.cpp
+++ b/chronik/chronik-cpp/chronik_bridge.cpp
@@ -467,8 +467,13 @@ void ChronikBridge::decode_raw_tx(rust::Slice<const uint8_t> raw_tx,
         CMutableTransaction mtx;
         stream >> mtx;
         node_tx = std::move(mtx);
-    } catch (const std::exception &) {
-        // Not a node tx: keep the legacy-shaped fields.
+    } catch (const std::exception &e) {
+        // A v7 frame has no legacy interpretation. Reject malformed native
+        // bytes instead of constructing a different transaction from defaults.
+        if (raw_tx.size() >= 4 && raw_tx[0] == 7 && raw_tx[1] == 0 &&
+            raw_tx[2] == 0 && raw_tx[3] == 0) {
+            throw std::runtime_error(e.what());
+        }
     }
     if (node_tx) {
         // A native V2 tx has no legacy-shaped fields: take the node's
diff --git a/chronik/chronik-indexer/src/query/broadcast.rs b/chronik/chronik-indexer/src/query/broadcast.rs
index 397f548b19..819e50c882 100644
--- a/chronik/chronik-indexer/src/query/broadcast.rs
+++ b/chronik/chronik-indexer/src/query/broadcast.rs
@@ -147,9 +147,7 @@ impl QueryBroadcast<'_> {
         let mut batch_txids = BTreeSet::new();
         let mut batch_txs = HashMap::new();
         for raw_tx in raw_txs.iter() {
-            let tx =
-                TxMut::deser(&mut raw_tx.clone()).map_err(ParsingFailed)?;
-            let mut ffi_tx = ffi::Tx::from(tx);
+            let mut ffi_tx = decode_bridge_tx(raw_tx).map_err(ParsingFailed)?;
             self.node.bridge.decode_raw_tx(raw_tx, &mut ffi_tx)?;
 
             let mut tx_not_found = Vec::new();
@@ -216,8 +214,7 @@ impl QueryBroadcast<'_> {
     /// returning verified tx data.
     pub fn validate_tx(&self, raw_tx: Vec<u8>) -> Result<proto::Tx> {
         let raw_tx = Bytes::from(raw_tx);
-        let tx = TxMut::deser(&mut raw_tx.clone())?;
-        let mut ffi_tx = ffi::Tx::from(tx);
+        let mut ffi_tx = decode_bridge_tx(&raw_tx)?;
         self.node.bridge.decode_raw_tx(&raw_tx, &mut ffi_tx)?;
         let mut coins_to_uncache = Vec::new();
         self.node.bridge.lookup_spent_coins(
@@ -342,3 +339,12 @@ pub fn verify_timeout_finalization(
     }
     Ok(Duration::from_secs(timeout_finalization_secs))
 }
+
+/// Native v7 transactions must be decoded by the node, not the legacy codec.
+/// Preserve the inherited legacy parser and its error text for v1/v2 frames.
+fn decode_bridge_tx(raw_tx: &Bytes) -> std::result::Result<ffi::Tx, DataError> {
+    if raw_tx.starts_with(&7u32.to_le_bytes()) {
+        return Ok(ffi::Tx::default());
+    }
+    TxMut::deser(&mut raw_tx.clone()).map(ffi::Tx::from)
+}
diff --git a/chronik/native/hosts/abc/abc_host.cpp b/chronik/native/hosts/abc/abc_host.cpp
index 3c0e16f788..3b6ba547f7 100644
--- a/chronik/native/hosts/abc/abc_host.cpp
+++ b/chronik/native/hosts/abc/abc_host.cpp
@@ -575,7 +575,10 @@ DecodedTx AbcHost::DecodeRawTx(std::span<const uint8_t> raw) const {
     // also accepts trailing bytes.
     LegacyTxDecodeResult decoded = DecodeLegacyTx(raw);
     DecodedTx out;
-    if (decoded.error) {
+    const bool native_v7 = kV2Outputs<CTxOut> && raw.size() >= 4 &&
+                           raw[0] == 7 && raw[1] == 0 && raw[2] == 0 &&
+                           raw[3] == 0;
+    if (decoded.error && !native_v7) {
         out.error = *decoded.error;
         return out;
     }
@@ -593,8 +596,12 @@ DecodedTx AbcHost::DecodeRawTx(std::span<const uint8_t> raw) const {
             CMutableTransaction mtx;
             raw_stream >> mtx;
             node_tx = std::move(mtx);
-        } catch (const std::exception &) {
-            // Not a node tx: keep the legacy-shaped fields.
+        } catch (const std::exception &e) {
+            if (native_v7) {
+                out.ok = false;
+                out.error = e.what();
+                return out;
+            }
         }
         if (node_tx) {
             const CTransaction ctx{std::move(*node_tx)};
-- 
