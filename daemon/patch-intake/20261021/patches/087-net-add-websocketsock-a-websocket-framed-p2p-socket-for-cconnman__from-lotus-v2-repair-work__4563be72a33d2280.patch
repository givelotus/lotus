@@ -0,0 +1,87 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_NET_WEBSOCKET_CODEC_H
+#define BITCOIN_NET_WEBSOCKET_CODEC_H
+
+#include <net_websocket.h>
+#include <net_zstd_dict.h>
+#include <random.h>
+#include <span.h>
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+/**
+ * RFC 6455 framing for P2P over WebSocket, without any I/O.
+ *
+ * One P2P chunk handed to EncodeMessage() becomes one binary message (one
+ * frame), optionally zstd-compressed as negotiated (see P2PZstdSession).
+ * Decode() turns received wire bytes back into P2P bytes, answering pings
+ * and closes. Extensions (RSV bits, permessage-deflate) are not supported:
+ * connections that negotiated them use the HTTP server's bridge instead.
+ */
+class WebSocketCodec {
+public:
+    enum class Role { CLIENT, SERVER };
+
+    //! Bound wire bytes without reserving them; follows current P2P config.
+    uint64_t MaxWireMessageSize() const;
+
+    WebSocketCodec(Role role, P2PWebSocketCompression compression);
+
+    /** Append `payload` (P2P bytes) to `out` as one binary message */
+    void EncodeMessage(Span<const uint8_t> payload, std::vector<uint8_t> &out);
+
+    /** Append a Close frame (once) */
+    void EncodeClose(uint16_t code, std::vector<uint8_t> &out);
+
+    struct DecodeResult {
+        //! Wire bytes consumed from the input
+        size_t consumed{0};
+        //! Set if the stream is invalid; the connection must be dropped
+        std::optional<std::string> error;
+    };
+
+    /**
+     * Decode complete frames from `in`. P2P bytes are appended to `plain`,
+     * frames to send back (pong, close reply) to `reply`.
+     */
+    DecodeResult Decode(Span<const uint8_t> in, std::vector<uint8_t> &plain,
+                        std::vector<uint8_t> &reply);
+
+    /** Whether `in` starts with at least one complete frame */
+    static bool HasCompleteFrame(Span<const uint8_t> in);
+
+    bool PeerClosed() const { return m_peer_closed; }
+    bool CloseSent() const { return m_close_sent; }
+
+    //! Bytes of wire frames produced / consumed (headers included)
+    uint64_t WireBytesSent() const { return m_wire_sent; }
+    uint64_t WireBytesRecv() const { return m_wire_recv; }
+
+private:
+    void AppendFrame(uint8_t opcode, Span<const uint8_t> payload,
+                     std::vector<uint8_t> &out);
+    std::optional<std::string> FinishMessage(std::vector<uint8_t> &plain);
+
+    const Role m_role;
+    const P2PWebSocketCompression m_compression;
+    std::unique_ptr<P2PZstdSession> m_zstd;
+    FastRandomContext m_rng;
+
+    //! Fragments of the message being received
+    std::vector<uint8_t> m_message;
+    bool m_in_message{false};
+    bool m_peer_closed{false};
+    bool m_close_sent{false};
+    uint64_t m_wire_sent{0};
+    uint64_t m_wire_recv{0};
+    std::vector<uint8_t> m_scratch;
+};
+
+#endif // BITCOIN_NET_WEBSOCKET_CODEC_H
diff --git a/src/net_websocket_sock.cpp b/src/net_websocket_sock.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..44a107f0d1dc1cfc2f130fe3b2db5b6deecb9df0
--- /dev/null
+++ b/src/net_websocket_sock.cpp
@@ -0,0 +1,254 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <net_websocket_sock.h>
+
+#include <compat/compat.h>
+#include <logging.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+ssize_t PlainByteLayer::Read(SOCKET fd, uint8_t *buf, size_t len) {
+    return ::recv(fd, reinterpret_cast<char *>(buf), len, MSG_DONTWAIT);
+}
+
+ssize_t PlainByteLayer::Write(SOCKET fd, const uint8_t *buf, size_t len) {
+    return ::send(fd, reinterpret_cast<const char *>(buf), len,
+                  MSG_NOSIGNAL | MSG_DONTWAIT);
+}
+
+namespace {
+bool WouldBlock(int err) {
+    return err == EAGAIN || err == EWOULDBLOCK || err == EINTR;
+}
+
+void AddCounters(WebSocketTransportInfo &info, uint64_t payload_sent,
+                 uint64_t payload_recv, uint64_t wire_sent,
+                 uint64_t wire_recv) {
+    auto &totals{GetWebSocketTransportTotals()};
+    info.payload_bytes_sent += payload_sent;
+    info.payload_bytes_recv += payload_recv;
+    info.wire_bytes_sent += wire_sent;
+    info.wire_bytes_recv += wire_recv;
+    totals.payload_bytes_sent += payload_sent;
+    totals.payload_bytes_recv += payload_recv;
+    totals.wire_bytes_sent += wire_sent;
+    totals.wire_bytes_recv += wire_recv;
+}
+} // namespace
+
+WebSocketSock::WebSocketSock(SOCKET fd, WebSocketCodec::Role role,
+                             std::shared_ptr<WebSocketTransportInfo> info,
+                             std::unique_ptr<WebSocketByteLayer> layer,
+                             std::vector<uint8_t> initial_wire_bytes)
+    : Sock{fd}, m_info{std::move(info)}, m_layer{std::move(layer)},
+      m_codec{role, m_info->compression},
+      m_rx_wire{std::move(initial_wire_bytes)} {
+    // Never block a CConnman thread: MSG_DONTWAIT may be unavailable (it is
+    // then defined as 0 by compat.h), so make the socket itself
+    // non-blocking. Likewise avoid SIGPIPE where MSG_NOSIGNAL is missing.
+    if (!SetNonBlocking()) {
+        LogPrintf("WebSocket: unable to make socket non-blocking\n");
+    }
+#ifdef SO_NOSIGPIPE
+    const int on{1};
+    (void)SetSockOpt(SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
+#endif
+    LOCK(m_mutex);
+    UpdateFlagsLocked();
+}
+
+WebSocketSock::~WebSocketSock() {
+    LOCK(m_mutex);
+    if (!m_failed && m_socket != INVALID_SOCKET) {
+        // Best effort: say goodbye without blocking.
+        m_codec.EncodeClose(1000, m_tx);
+        (void)FlushLocked();
+        m_layer->Shutdown(m_socket);
+    }
+}
+
+void WebSocketSock::UpdateFlagsLocked() const {
+    m_has_buffered = m_rx_offset < m_rx_plain.size() || m_layer->HasBuffered() ||
+                     WebSocketCodec::HasCompleteFrame(m_rx_wire) ||
+                     m_eof || m_failed;
+    const bool pending{!m_coalesce.empty() || m_tx_offset < m_tx.size()};
+    m_pending_events = pending ? m_layer->WriteWaitsFor() : Event{0};
+}
+
+bool WebSocketSock::FlushLocked() const {
+    if (!m_coalesce.empty()) {
+        m_codec.EncodeMessage(m_coalesce, m_tx);
+        AddCounters(*m_info, m_coalesce.size(), 0, 0, 0);
+        m_coalesce.clear();
+    }
+    while (m_tx_offset < m_tx.size()) {
+        const ssize_t n{m_layer->Write(m_socket, m_tx.data() + m_tx_offset,
+                                       m_tx.size() - m_tx_offset)};
+        if (n <= 0) {
+            if (n < 0 && WouldBlock(errno)) {
+                break;
+            }
+            // After the peer's Close, failing to deliver our reply (it may
+            // already have gone) still ends the connection in an orderly way.
+            if (!m_codec.PeerClosed()) {
+                m_failed = true;
+            }
+            m_tx.clear();
+            m_tx_offset = 0;
+            return false;
+        }
+        m_tx_offset += n;
+    }
+    if (m_tx_offset == m_tx.size()) {
+        m_tx.clear();
+        m_tx_offset = 0;
+    } else if (m_tx_offset > (1 << 20)) {
+        m_tx.erase(m_tx.begin(), m_tx.begin() + m_tx_offset);
+        m_tx_offset = 0;
+    }
+    const uint64_t wire{m_codec.WireBytesSent()};
+    AddCounters(*m_info, 0, 0, wire - m_wire_sent_reported, 0);
+    m_wire_sent_reported = wire;
+    return true;
+}
+
+ssize_t WebSocketSock::Send(const void *data, size_t len, int flags) const {
+    LOCK(m_mutex);
+    if (m_failed || m_codec.CloseSent()) {
+        errno = EPIPE;
+        return -1;
+    }
+    if (m_tx.size() - m_tx_offset + m_coalesce.size() > MAX_PENDING_SEND) {
+        // Back-pressure: try to drain first.
+        if (!FlushLocked()) {
+            errno = ECONNRESET;
+            UpdateFlagsLocked();
+            return -1;
+        }
+        if (m_tx.size() - m_tx_offset > MAX_PENDING_SEND) {
+            UpdateFlagsLocked();
+            errno = EAGAIN;
+            return -1;
+        }
+    }
+    const auto *bytes{static_cast<const uint8_t *>(data)};
+    m_coalesce.insert(m_coalesce.end(), bytes, bytes + len);
+    bool more{false};
+#ifdef MSG_MORE
+    more = flags & MSG_MORE;
+#endif
+    if (!more || m_coalesce.size() >= MAX_COALESCE) {
+        if (!FlushLocked()) {
+            errno = ECONNRESET;
+            UpdateFlagsLocked();
+            return -1;
+        }
+    }
+    UpdateFlagsLocked();
+    return len;
+}
+
+bool WebSocketSock::FillLocked() const {
+    // Read what the OS socket (or TLS layer) has, then decode.
+    uint8_t buf[64 * 1024];
+    while (!m_eof) {
+        const ssize_t n{m_layer->Read(m_socket, buf, sizeof(buf))};
+        if (n > 0) {
+            m_rx_wire.insert(m_rx_wire.end(), buf, buf + n);
+            if (m_rx_wire.size() > m_codec.MaxWireMessageSize() + 16) {
+                break; // Decode before reading more.
+            }
+            continue;
+        }
+        if (n == 0) {
+            m_eof = true;
+            break;
+        }
+        if (WouldBlock(errno)) {
+            break;
+        }
+        m_failed = true;
+        return false;
+    }
+
+    std::vector<uint8_t> reply;
+    const size_t plain_before{m_rx_plain.size()};
+    const auto result{m_codec.Decode(m_rx_wire, m_rx_plain, reply)};
+    m_rx_wire.erase(m_rx_wire.begin(), m_rx_wire.begin() + result.consumed);
+    AddCounters(*m_info, 0, m_rx_plain.size() - plain_before, 0,
+                m_codec.WireBytesRecv() - m_wire_recv_reported);
+    m_wire_recv_reported = m_codec.WireBytesRecv();
+    if (result.error) {
+        LogDebug(BCLog::NET, "WebSocket peer error: %s\n", *result.error);
+        m_failed = true;
+        return false;
+    }
+    if (m_codec.PeerClosed()) {
+        m_eof = true;
+    }
+    if (!reply.empty()) {
+        m_tx.insert(m_tx.end(), reply.begin(), reply.end());
+        if (!FlushLocked() && !m_codec.PeerClosed()) {
+            return false;
+        }
+    }
+    return true;
+}
+
+ssize_t WebSocketSock::Recv(void *buf, size_t len, int flags) const {
+    LOCK(m_mutex);
+    if (m_rx_offset == m_rx_plain.size()) {
+        m_rx_plain.clear();
+        m_rx_offset = 0;
+        if (!m_failed && !FillLocked()) {
+            UpdateFlagsLocked();
+            errno = ECONNRESET;
+            return -1;
+        }
+    }
+    if (m_rx_offset < m_rx_plain.size()) {
+        const size_t n{std::min(len, m_rx_plain.size() - m_rx_offset)};
+        std::memcpy(buf, m_rx_plain.data() + m_rx_offset, n);
+        m_rx_offset += n;
+        UpdateFlagsLocked();
+        return n;
+    }
+    UpdateFlagsLocked();
+    if (m_failed) {
+        errno = ECONNRESET;
+        return -1;
+    }
+    if (m_eof) {
+        // An EOF in the middle of a frame is not an orderly close.
+        if (!m_rx_wire.empty() && !m_codec.PeerClosed()) {
+            errno = ECONNRESET;
+            return -1;
+        }
+        return 0;
+    }
+    errno = EAGAIN;
+    return -1;
+}
+
+bool WebSocketSock::HasBufferedRecv() const {
+    return m_has_buffered.load();
+}
+
+Sock::Event WebSocketSock::PendingEvents() const {
+    return m_pending_events.load();
+}
+
+bool WebSocketSock::FlushPending() const {
+    LOCK(m_mutex);
+    const bool ok{!m_failed && FlushLocked()};
+    UpdateFlagsLocked();
+    return ok;
+}
diff --git a/src/net_websocket_sock.h b/src/net_websocket_sock.h
new file mode 100644
index 0000000000000000000000000000000000000000..6dcb2cea5f8f86264ad57a4c9a67f2f5a144a145
--- /dev/null
+++ b/src/net_websocket_sock.h
@@ -0,0 +1,114 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_NET_WEBSOCKET_SOCK_H
+#define BITCOIN_NET_WEBSOCKET_SOCK_H
+
+#include <net_websocket.h>
+#include <net_websocket_codec.h>
+#include <sync.h>
+#include <util/sock.h>
+
+#include <atomic>
+#include <memory>
+#include <vector>
+
+/**
+ * Raw byte I/O beneath WebSocket framing: the plain socket, or TLS (see
+ * net_websocket_tls.h). Called with WebSocketSock's lock held.
+ * Read/Write follow recv(2)/send(2) on a non-blocking socket: >0 bytes, 0 on
+ * orderly EOF (Read only), -1 with errno set (EAGAIN when it would block).
+ */
+class WebSocketByteLayer {
+public:
+    virtual ~WebSocketByteLayer() = default;
+    virtual ssize_t Read(SOCKET fd, uint8_t *buf, size_t len) = 0;
+    virtual ssize_t Write(SOCKET fd, const uint8_t *buf, size_t len) = 0;
+    //! Bytes already read from the OS socket but not yet returned
+    virtual bool HasBuffered() const { return false; }
+    //! OS socket events a blocked Write() is waiting for
+    virtual Sock::Event WriteWaitsFor() const { return Sock::SEND; }
+    //! Best-effort non-blocking shutdown before the socket is closed
+    virtual void Shutdown(SOCKET fd) {}
+    //! Whether the layer is TLS
+    virtual bool IsTLS() const { return false; }
+};
+
+class PlainByteLayer final : public WebSocketByteLayer {
+public:
+    ssize_t Read(SOCKET fd, uint8_t *buf, size_t len) override;
+    ssize_t Write(SOCKET fd, const uint8_t *buf, size_t len) override;
+};
+
+/**
+ * A P2P socket carrying the P2P byte stream in WebSocket messages, used by
+ * CConnman like any other Sock (polled on the real TCP socket). Send()
+ * frames and (if negotiated) compresses on the calling thread; Recv()
+ * deframes and decompresses. No extra thread or socketpair is involved.
+ *
+ * Send() coalesces chunks passed with MSG_MORE into one message. It accepts
+ * everything it is given (returning `len`) unless more than
+ * MAX_PENDING_SEND bytes are already waiting to be written, in which case
+ * it fails with EAGAIN; the unwritten tail is flushed via the Sock
+ * PendingEvents()/FlushPending() hooks.
+ */
+class WebSocketSock final : public Sock {
+public:
+    //! Back-pressure threshold for data accepted but not yet written
+    static constexpr size_t MAX_PENDING_SEND = 4 * 1024 * 1024;
+    //! Coalesced chunks are framed once they reach this size
+    static constexpr size_t MAX_COALESCE = 1024 * 1024;
+
+    WebSocketSock(SOCKET fd, WebSocketCodec::Role role,
+                  std::shared_ptr<WebSocketTransportInfo> info,
+                  std::unique_ptr<WebSocketByteLayer> layer,
+                  std::vector<uint8_t> initial_wire_bytes = {});
+    ~WebSocketSock() override;
+
+    ssize_t Send(const void *data, size_t len, int flags) const override;
+    ssize_t Recv(void *buf, size_t len, int flags) const override;
+    bool HasBufferedRecv() const override;
+    Event PendingEvents() const override;
+    bool FlushPending() const override;
+
+    const std::shared_ptr<WebSocketTransportInfo> &Info() const {
+        return m_info;
+    }
+
+private:
+    //! Frame coalesced data; write as much as possible. False on error.
+    bool FlushLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
+    //! Read and decode what is available. False on fatal error.
+    bool FillLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
+    void UpdateFlagsLocked() const EXCLUSIVE_LOCKS_REQUIRED(m_mutex);
+
+    const std::shared_ptr<WebSocketTransportInfo> m_info;
+
+    mutable Mutex m_mutex;
+    const std::unique_ptr<WebSocketByteLayer> m_layer GUARDED_BY(m_mutex);
+    mutable WebSocketCodec m_codec GUARDED_BY(m_mutex);
+    //! P2P bytes passed with MSG_MORE, not yet framed
+    mutable std::vector<uint8_t> m_coalesce GUARDED_BY(m_mutex);
+    //! Encoded frames not yet written
+    mutable std::vector<uint8_t> m_tx GUARDED_BY(m_mutex);
+    mutable size_t m_tx_offset GUARDED_BY(m_mutex){0};
+    //! Wire bytes not yet decoded
+    mutable std::vector<uint8_t> m_rx_wire GUARDED_BY(m_mutex);
+    //! Decoded P2P bytes not yet returned by Recv()
+    mutable std::vector<uint8_t> m_rx_plain GUARDED_BY(m_mutex);
+    mutable size_t m_rx_offset GUARDED_BY(m_mutex){0};
+    mutable bool m_eof GUARDED_BY(m_mutex){false};
+    mutable bool m_failed GUARDED_BY(m_mutex){false};
+    mutable uint64_t m_payload_recv_reported GUARDED_BY(m_mutex){0};
+    mutable uint64_t m_wire_recv_reported GUARDED_BY(m_mutex){0};
+    mutable uint64_t m_wire_sent_reported GUARDED_BY(m_mutex){0};
+
+    //! Lock-free views for the Sock hooks (see util/sock.h). A failed or
+    //! closed socket reports buffered data so CConnman calls Recv() and
+    //! sees the error/EOF without waiting for the OS socket.
+    mutable std::atomic<bool> m_has_buffered{false};
+    mutable std::atomic<Event> m_pending_events{0};
+};
+
+#endif // BITCOIN_NET_WEBSOCKET_SOCK_H
