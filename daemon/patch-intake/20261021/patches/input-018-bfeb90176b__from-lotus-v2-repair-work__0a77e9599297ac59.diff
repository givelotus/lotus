+                        if (m_remaining.fetch_sub(
+                                1, std::memory_order_acq_rel) == 1) {
+                            std::lock_guard<std::mutex> lock(m_mutex);
+                            m_cv_done.notify_one();
+                        }
+                    }
+                }
+            });
+        }
