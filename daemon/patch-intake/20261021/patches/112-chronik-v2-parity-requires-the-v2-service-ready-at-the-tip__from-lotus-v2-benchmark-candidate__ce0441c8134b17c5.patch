From dd060ec34d5bffd9bc55c0fcfc6730010340a5e5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:27:38 -0700
Subject: [PATCH] chronik: V2 parity requires the V2 service ready at the tip

Both implementations' V2 index services stopped at the same block with
"invalid V2 index transition: missing coin", so the V2 parity runs
compared two equally stale indexes and passed. Every sync now also
waits for /v2/status on both nodes to be ready with its snapshot at the
tip, and fails otherwise. The canonical-order spend blocks are v7 spends
on this tier.

/validate-tx::Tx.txid is no longer an accepted V2 difference: both
implementations now report the node's txid of a raw V2 tx.

Tier: V2
---
 contrib/chronik-parity/README.md       | 20 ++++++++++++++------
 contrib/chronik-parity/compare.py      | 11 ++++-------
 contrib/chronik-parity/parity_chain.py | 20 ++++++++++++++++++++
 3 files changed, 38 insertions(+), 13 deletions(-)

diff --git a/contrib/chronik-parity/README.md b/contrib/chronik-parity/README.md
index 10d44236adff5f71d2a2c283619201ea3cf511df..b2519ba6a84a5310c0a89ab24001d0219b64c831 100644
--- a/contrib/chronik-parity/README.md
+++ b/contrib/chronik-parity/README.md
@@ -151,7 +151,12 @@ Framework ports are kept in [20000, 25000).
 - **Canonical-order spends.** Every few rounds a block (`generateblock`)
   holds a chain of 2–4 txs in which each child's txid sorts before its
   parent's, so in the block's canonical order a tx spends a coin created
-  later in the same block.
+  later in the same block. On the V2 tier these are v7 spends, which the V2
+  index service once stopped at ("missing coin").
+- **V2 service readiness.** On the V2 tier every sync also requires
+  `/v2/status` on both nodes to be `ready` with its snapshot at the tip:
+  both implementations stopping at the same block would otherwise compare
+  equal.
 - **Reorgs.** Each run includes four:
   - R1: `invalidateblock` on all nodes, then a longer fork and
     `reconsiderblock`.
@@ -256,11 +261,11 @@ line by line.
   Allow patterns match the indexed path or the path without indices.
 - **Accepted differences:**
   - `ChronikInfo.version` (`FormatFullVersion()` of the host build).
-  - On the V2 tier (`compare.V2_ACCEPTED`): `/validate-tx::Tx.txid`, the
-    §1.2 defect. The Rust bridge recomputes the txid of a decoded raw tx from
-    its legacy-shaped fields, which for native V2 txs is one constant value;
-    the native host reports the real V2 txid.
-  - The per-IP key defect (§1.3) is not exercised here.
+  - On the V2 tier, `compare.V2_ACCEPTED` is empty: the former
+    `/validate-tx::Tx.txid` entry (the §1.2 defect, a constant txid for every
+    V2 tx from the Rust bridge) is fixed in both implementations.
+  - The per-IP key defect (§1.3) is not exercised here; it is covered by
+    `test/functional/chronik_rpc_port_proxy.py`.
   - A pattern `ROUTE::PATH` (e.g. `/validate-tx::Tx.txid`) only applies to
     responses of that route.
 - **V2 subscriptions.** On the V2 tier the record also lists the branch roots
@@ -311,6 +316,9 @@ All runs below use `build/ecash-rust` or `build/v2-rust` for both A and B
 | V2, `--no-tokens`, separate miner | 400 | ~40k identical per checkpoint through h402 | 66 identical per checkpoint | – | 0 differences through h402; final phase hung on node A (see Known issues) |
 | V2, `--miner a` | 110 | 270 differences | 5 differences | – | coinbase script asymmetry (see Known issues) |
 | V2 Rust (A) vs native (B), `--no-tokens`, separate miner, V2 dump tool | 120 | 17,322: 17,263 identical, 59 parsed-equal (accepted: version, `/validate-tx` txid) | 81 identical (1,978 msgs) | 4 equal | 0 unexpected differences |
+| eCash Rust (A) vs native (B), separate miner, native dump tool, with canonical-order spend blocks | 160 | 17,892: 17,887 identical, 5 parsed-equal (version) | 139 identical (4,597 msgs) | 5 equal | 0 unexpected differences (5 canonical-order chains, 17 token steps) |
+| V2 Rust (A) vs native (B), `--no-tokens`, separate miner, V2 dump tool, `/v2/status` ready at every sync | 160 | 75,597: 71,340 identical, 4,257 parsed-equal (version, service epoch); `POST /validate-tx` 158 identical | 148 identical (3,021 msgs) | 5 equal | 0 unexpected differences (7 canonical-order v7 chains) |
+| Same, `--seed 11` | 300 | 197,266: 189,905 identical, 7,361 parsed-equal (version, service epoch) | 349 identical (6,436 msgs) | 8 equal | 0 unexpected differences (20 canonical-order v7 chains, 15 conflicts) |
 | Negative control: B with `-chroniklokadidindex=0` | 110 | 196 `/lokad-id` differences and 1 WS difference | | | detected, exit 1 |
 
 ## Known issues
diff --git a/contrib/chronik-parity/compare.py b/contrib/chronik-parity/compare.py
index f36e638fcfc0ab17a07e9293ff67325a3b5992b5..ec87c8b29f489deb3e79cd4fe2c746b9ee1cd3c9 100644
--- a/contrib/chronik-parity/compare.py
+++ b/contrib/chronik-parity/compare.py
@@ -44,13 +44,10 @@ DEFAULT_ALLOW = [
     "json.<service_epoch>",
 ]
 
-# Lotus V2 tier, Rust (A) vs native (B): the design C1 section 1 defects.
-# The Rust bridge recomputes the txid of a decoded raw tx from its
-# legacy-shaped fields (lookup_spent_coins), which differs from the real V2
-# txid of native V2 txs; the native host reports the real one.
-V2_ACCEPTED = [
-    "/validate-tx::Tx.txid",
-]
+# Lotus V2 tier, Rust (A) vs native (B): accepted differences. None since
+# both decode raw V2 txs with the node (the design C1 section 1.2 /validate-tx
+# txid defect is fixed in both).
+V2_ACCEPTED: list = []
 
 # Response headers never compared.
 IGNORED_HEADERS = {"date"}
diff --git a/contrib/chronik-parity/parity_chain.py b/contrib/chronik-parity/parity_chain.py
index e784c28c3cfa0578cacfa0ea83b1d8a7884f697c..94caab111e1824e5181e61f6a79dc825f51395d9 100644
--- a/contrib/chronik-parity/parity_chain.py
+++ b/contrib/chronik-parity/parity_chain.py
@@ -1194,9 +1194,29 @@ class ParityChain(BitcoinTestFramework):
                     raise AssertionError(f"chronik not synced: {t} vs {(tip, height)}, "
                                          f"mempool {n_mem} vs {len(ma)}")
                 time.sleep(0.05)
+            if self.v2:
+                self.wait_v2_ready(ep, tip, height, deadline)
             ep.close()
         return ma
 
+    def wait_v2_ready(self, ep, tip, height, deadline):
+        """The V2 index service must be ready at the tip: both implementations
+        stopping at the same block (e.g. on a V2 index error) would otherwise
+        compare equal."""
+        while True:
+            resp = ep.request({"method": "GET", "path": "/v2/status", "headers": {}})
+            status = None
+            if resp.get("status") == 200:
+                status = json.loads(resp["body_bytes"])
+                snap = status.get("snapshot", {})
+                if (status.get("ready") and snap.get("height") == str(height)
+                        and snap.get("tip") in (tip, bytes.fromhex(tip)[::-1].hex())):
+                    return
+            if time.time() > deadline:
+                raise AssertionError(f"V2 index service not ready at {height} "
+                                     f"{tip}: {resp.get('status')} {status}")
+            time.sleep(0.05)
+
     def collect_record(self, mempool):
         a = self.a
         tip = a.getblockcount()
