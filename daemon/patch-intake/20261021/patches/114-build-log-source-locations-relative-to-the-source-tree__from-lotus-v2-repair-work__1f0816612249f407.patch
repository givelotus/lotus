From 7f42e55e7b0559a4faf3ff7367a460a9d7bd572d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 01:10:36 -0700
Subject: [PATCH] build: log source locations relative to the source tree

Log lines name their source file with -logsourcelocations, and always in
-logformat=json. That was the compiler's __FILE__ / source_location, an
absolute path on the build machine ("/home/builder/abc/src/net.cpp"):
noise in every line, different between builds, and revealing the build
environment.

-fmacro-prefix-map removes the source and build directories at compile
time, so the file is "src/net.cpp" in both formats at no runtime cost.
Only macros are remapped: debug information keeps absolute paths, so
debuggers still find the sources. feature_logging.py checks that no log
line contains the absolute source path, in text and JSON.

(cherry picked from commit 373b28069a22cbf615579959ae627668ee91b165)

N3-Source-Commit: 373b28069a22cbf615579959ae627668ee91b165
N3-Source-Export: 0004
---
 src/CMakeLists.txt                 |  8 ++++++++
 test/functional/feature_logging.py | 21 +++++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index b744151d4abf090ce69605059cbb8c4159e80093..16174db76f038e124604d08e31f37e3c36ad8f1d 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -246,6 +246,14 @@ if(ENABLE_PROFILING MATCHES "gprof")
 	add_linker_flags(-pg)
 endif()
 
+# Source locations in logs (__FILE__, std::source_location) are relative to
+# the source tree ("src/net.cpp"), not the build machine's absolute path.
+# Only macros are remapped: debug information keeps absolute paths.
+add_compiler_flags(
+	"-fmacro-prefix-map=${CMAKE_BINARY_DIR}/="
+	"-fmacro-prefix-map=${CMAKE_SOURCE_DIR}/="
+)
+
 # Enable warning
 add_c_compiler_flags(-Wnested-externs -Wstrict-prototypes)
 add_compiler_flags(
diff --git a/test/functional/feature_logging.py b/test/functional/feature_logging.py
index 1541f2c29056e45cb4aa12d38c96c7ce1d91373e..b229e2a0e9758e1e2c10fcc1615b4b7441f57bba 100644
--- a/test/functional/feature_logging.py
+++ b/test/functional/feature_logging.py
@@ -79,8 +79,24 @@ class LoggingTest(BitcoinTestFramework):
         # just sanity check no crash here
         self.restart_node(0, [f"-debuglogfile={os.devnull}"])
 
+        self.test_text_source_locations()
         self.test_json_format()
 
+    def assert_no_absolute_source_paths(self, log_path):
+        src = os.path.join(self.config["environment"]["SRCDIR"], "src") + os.sep
+        with open(log_path, encoding="utf-8") as f:
+            for line in f:
+                assert src not in line, line
+
+    def test_text_source_locations(self):
+        self.log.info("-logsourcelocations shows source-relative paths")
+        self.restart_node(0, ["-logsourcelocations", "-debuglogfile=src.log"])
+        self.stop_node(0)
+        log_path = self.relative_log_path("src.log")
+        self.assert_no_absolute_source_paths(log_path)
+        with open(log_path, encoding="utf-8") as f:
+            assert any("[src/init.cpp:" in line for line in f)
+
     def test_json_format(self):
         self.log.info("Test -logformat=json")
         self.stop_node(0)
@@ -128,6 +144,11 @@ class LoggingTest(BitcoinTestFramework):
         assert any("UpdateTip: new best=" in m and "height=1 " in m for m in msgs)
         assert any(r["category"] == "net" and r["level"] == "debug" for r in records)
         assert any(r["thread"] == "init" for r in records)
+        # Source files are relative to the source tree (compile-time
+        # -fmacro-prefix-map), like "src/init.cpp".
+        assert any(r["file"] == "src/init.cpp" for r in records)
+        assert all(not os.path.isabs(r["file"]) for r in records)
+        self.assert_no_absolute_source_paths(json_log_path)
         assert any(
             r["category"] == "none" and r["level"] == "info" for r in records
         )
