From 5ce772947e40b3685faf855ec29c3ea1f6d2e1b6 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:08:14 -0700
Subject: [PATCH] v2: record a block's V2 state under the block's own id

mining_basic failed with a block sync timeout: after the test fed node
0 a coinbase-only block with a null state root (which regtest
accepts), every block either node mined on top of it was rejected by
the other with bad-blk-stateroot. Both nodes held identical block
bytes and identical UTXO sets, but getblocktemplate returned different
state roots.

ConnectBlock records the post-block V2 state (UTXO tree and monetary
state) that the next block's state root is computed from, keyed by
block id. When the block matched the node's anchored mempool overlay,
the overlay path recorded it under pindex->GetBlockHash(). Otherwise
ComputeV2BlockStateRoot recorded it under the id of the header with
its state root filled in. For a block whose header carries a null
root that is not the block's id, so the state was filed under a hash
no block has, and its children started from an empty parent state.
Which path applied depended on each node's mempool, so two nodes could
disagree about the same chain.

ComputeV2BlockStateRoot now records under block.GetHash(), like the
overlay path. Blocks with a non-null state root are unaffected, since
filling the root changed nothing for them.

miner_tests/null_state_root_block_state_recorded_under_block_id fails
without this change and passes with it. mining_basic now passes.

Tier: V2 (fixup to v2/030)
---
 src/primitives/block.cpp |  9 ++++-----
 src/test/miner_tests.cpp | 20 ++++++++++++++++++++
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/src/primitives/block.cpp b/src/primitives/block.cpp
index 94e274bce9..75ee9bc0c2 100644
--- a/src/primitives/block.cpp
+++ b/src/primitives/block.cpp
@@ -828,11 +828,10 @@ uint256 ComputeV2BlockStateRoot(const CBlock &block,
     uint256 out;
     std::memcpy(out.begin(), sroot.data(), 32);
     if (record) {
-        CBlockHeader hdr = block.GetBlockHeader();
-        if (hdr.hashStateRoot.IsNull()) {
-            hdr.hashStateRoot = out;
-        }
-        const BlockHash blockHash = hdr.GetHash();
+        // Key the snapshot by the block's own id, as the overlay path does.
+        // A regtest block may carry a null state root, and its id commits
+        // to that null root, so its children look the state up under it.
+        const BlockHash blockHash = block.GetHash();
         std::lock_guard<std::mutex> lock(g_v2_utxo_mutex);
         g_latest_v2_circulating_supply = next_state.circulating_supply;
         CacheV2BlockStateLocked(blockHash, std::move(next_state));
diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 1048fca287..e369ef98c2 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -936,6 +936,26 @@ BOOST_FIXTURE_TEST_CASE(template_root_is_checked_from_selected_transactions, Tes
     BOOST_CHECK(!block_template->block.m_checked_merkle_root);
 }
 
+// Regtest accepts a block with a null state root. Its children look the
+// parent's V2 state up by the parent's block id, which commits to that null
+// root, so the recorded state must be found under that id.
+BOOST_FIXTURE_TEST_CASE(null_state_root_block_state_recorded_under_block_id,
+                        TestChain100Setup) {
+    CBlock block = CreateBlock({}, CScript() << OP_TRUE,
+                               m_node.chainman->ActiveChainstate());
+    block.hashStateRoot.SetNull();
+    const CBlockIndex *tip =
+        WITH_LOCK(cs_main, return m_node.chainman->ActiveTip());
+    ComputeV2BlockStateRoot(block, tip->GetBlockHash(),
+                            uint64_t(tip->nHeight + 1),
+                            uint64_t(tip->GetMedianTimePast()),
+                            /*record=*/true);
+    std::shared_ptr<const lotus::v2::SmtNode> utxo_root;
+    lotus::v2::MonetaryState mon_state;
+    BOOST_CHECK(GetV2BlockStateSnapshot(block.GetHash(), utxo_root, mon_state));
+    BOOST_CHECK(utxo_root);
+}
+
 // A coinbase output must be the same after a wire round trip as in the
 // miner's memory: legacy inputs spending it are verified against its
 // scriptPubKey, so a script known only to the miner splits the miner from
