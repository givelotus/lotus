From 115bc6e065dc32fb64c4889b1a6514bdaf6760f8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 02:12:15 -0700
Subject: [PATCH] init: make -logthreadnames work

-logthreadnames was registered and applied only #ifdef
HAVE_THREAD_LOCAL, which the CMake build never defines (it is a leftover
of the autotools build). The option was a hidden no-op: thread names
never appeared in the log, though the test framework and the
documentation pass it. Thread-local storage is plain C++ now and
util/threadnames.cpp uses it unconditionally, so drop the condition.

feature_logging.py checks that lines name their thread (the test
framework runs nodes with -logthreadnames).

(cherry picked from commit 2e7e82fb94c6d01b9a9bf4714f514b30a655716f)

N3-Source-Commit: 2e7e82fb94c6d01b9a9bf4714f514b30a655716f
N3-Source-Export: 0002
---
 src/init/common.cpp                | 13 +++----------
 test/functional/feature_logging.py |  4 ++++
 2 files changed, 7 insertions(+), 10 deletions(-)

diff --git a/src/init/common.cpp b/src/init/common.cpp
index 0d6c56f4a68cfe667893651b05646a489152b71f..40c891859f3904b82590b50a93251f49e4079bf0 100644
--- a/src/init/common.cpp
+++ b/src/init/common.cpp
@@ -75,17 +75,12 @@ void AddLoggingArgs(ArgsManager &argsman) {
         strprintf("Prepend debug output with timestamp (default: %u)",
                   DEFAULT_LOGTIMESTAMPS),
         ArgsManager::ALLOW_ANY, OptionsCategory::DEBUG_TEST);
-#ifdef HAVE_THREAD_LOCAL
     argsman.AddArg(
         "-logthreadnames",
-        strprintf(
-            "Prepend debug output with name of the originating thread (only "
-            "available on platforms supporting thread_local) (default: %u)",
-            DEFAULT_LOGTHREADNAMES),
+        strprintf("Prepend debug output with name of the originating thread "
+                  "(default: %u)",
+                  DEFAULT_LOGTHREADNAMES),
         ArgsManager::ALLOW_ANY, OptionsCategory::DEBUG_TEST);
-#else
-    argsman.AddHiddenArgs({"-logthreadnames"});
-#endif
     argsman.AddArg(
         "-logsourcelocations",
         strprintf(
@@ -137,10 +132,8 @@ void SetLoggingOptions(const ArgsManager &args) {
         args.GetBoolArg("-logtimestamps", DEFAULT_LOGTIMESTAMPS);
     LogInstance().m_log_time_micros =
         args.GetBoolArg("-logtimemicros", DEFAULT_LOGTIMEMICROS);
-#ifdef HAVE_THREAD_LOCAL
     LogInstance().m_log_threadnames =
         args.GetBoolArg("-logthreadnames", DEFAULT_LOGTHREADNAMES);
-#endif
     LogInstance().m_log_sourcelocations =
         args.GetBoolArg("-logsourcelocations", DEFAULT_LOGSOURCELOCATIONS);
     LogInstance().m_always_print_category_level =
diff --git a/test/functional/feature_logging.py b/test/functional/feature_logging.py
index a6967f07ff9791d27d3e935a5155664482d8e9cd..cc9074bc8d15b2a5a9daa69609e4875b89b888a8 100644
--- a/test/functional/feature_logging.py
+++ b/test/functional/feature_logging.py
@@ -21,6 +21,10 @@ class LoggingTest(BitcoinTestFramework):
         # test default log file name
         default_log_path = self.relative_log_path("debug.log")
         assert os.path.isfile(default_log_path)
+        # The test framework runs nodes with -logthreadnames: lines name
+        # their thread.
+        with open(default_log_path, encoding="utf-8") as f:
+            assert any("Z [init] " in line for line in f)
 
         # test alternative log file name in datadir
         self.restart_node(0, ["-debuglogfile=foo.log"])
