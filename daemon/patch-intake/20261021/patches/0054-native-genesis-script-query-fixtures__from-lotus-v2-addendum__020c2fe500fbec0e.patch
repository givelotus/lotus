From 77f49793c871dcf8317bd40c9124d7515ff9ed7c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 01:40:58 -0700
Subject: [PATCH] fixup! test(v2): regenerate chain fixtures for the
 legacy-coinbase regtest chain

Query the canonical native genesis output and its script hash. Retain explicit empty-history checks for the embedded legacy P2PK identity, all generated legacy P2SH transactions, pagination and index wipe/rebuild oracles.

Tier: V2 (fixup to test(v2): regenerate chain fixtures for the legacy-coinbase regtest chain)
---
 .../chronik_script_confirmed_txs.py           | 19 +++++++++++-----
 test/functional/chronik_scripthash.py         | 22 ++++++++++++++++---
 2 files changed, 32 insertions(+), 9 deletions(-)

diff --git a/test/functional/chronik_script_confirmed_txs.py b/test/functional/chronik_script_confirmed_txs.py
index 78b1fb1c86..95e6c70a23 100644
--- a/test/functional/chronik_script_confirmed_txs.py
+++ b/test/functional/chronik_script_confirmed_txs.py
@@ -11,6 +11,7 @@ from test_framework.address import (
     SCRIPTSIG_OP_TRUE,
 )
 from test_framework.blocktools import GENESIS_CB_PK, create_block, create_coinbase
+from test_framework.chronik.test_data import GENESIS_NATIVE_OUTPUT
 from test_framework.messages import COutPoint, CTransaction, CTxIn, CTxOut
 from test_framework.p2p import P2PDataStore
 from test_framework.test_framework import BitcoinTestFramework
@@ -72,21 +73,21 @@ class ChronikScriptConfirmedTxsTest(BitcoinTestFramework):
         )
 
         assert_equal(
-            chronik.script("p2pk", GENESIS_CB_PK)
+            chronik.script("other", GENESIS_NATIVE_OUTPUT.hex())
             .confirmed_txs(page=0, page_size=201)
             .err(400)
             .msg,
             "400: Requested page size 201 is too big, maximum is 200",
         )
         assert_equal(
-            chronik.script("p2pk", GENESIS_CB_PK)
+            chronik.script("other", GENESIS_NATIVE_OUTPUT.hex())
             .confirmed_txs(page=0, page_size=0)
             .err(400)
             .msg,
             "400: Requested page size 0 is too small, minimum is 1",
         )
         assert_equal(
-            chronik.script("p2pk", GENESIS_CB_PK)
+            chronik.script("other", GENESIS_NATIVE_OUTPUT.hex())
             .confirmed_txs(page=0, page_size=2**32)
             .err(400)
             .msg,
@@ -94,7 +95,7 @@ class ChronikScriptConfirmedTxsTest(BitcoinTestFramework):
             + "number too large to fit in target type",
         )
         assert_equal(
-            chronik.script("p2pk", GENESIS_CB_PK)
+            chronik.script("other", GENESIS_NATIVE_OUTPUT.hex())
             .confirmed_txs(page=2**32, page_size=1)
             .err(400)
             .msg,
@@ -104,16 +105,22 @@ class ChronikScriptConfirmedTxsTest(BitcoinTestFramework):
 
         from test_framework.chronik.client import pb
 
+        # Native genesis is indexed by its canonical output, not the embedded P2PK.
+        assert_equal(
+            chronik.script("p2pk", GENESIS_CB_PK).confirmed_txs().ok(),
+            pb.TxHistoryPage(),
+        )
+
         # Handle overflow gracefully on 32-bit
         assert_equal(
-            chronik.script("p2pk", GENESIS_CB_PK)
+            chronik.script("other", GENESIS_NATIVE_OUTPUT.hex())
             .confirmed_txs(page=2**32 - 1, page_size=200)
             .ok(),
             pb.TxHistoryPage(num_pages=1, num_txs=1),
         )
 
         genesis_db_script_history = (
-            chronik.script("p2pk", GENESIS_CB_PK).confirmed_txs().ok()
+            chronik.script("other", GENESIS_NATIVE_OUTPUT.hex()).confirmed_txs().ok()
         )
         from test_framework.chronik.test_data import genesis_cb_tx
 
diff --git a/test/functional/chronik_scripthash.py b/test/functional/chronik_scripthash.py
index 4972b9d2b4..efcce334c4 100644
--- a/test/functional/chronik_scripthash.py
+++ b/test/functional/chronik_scripthash.py
@@ -16,6 +16,7 @@ from test_framework.blocktools import (
     GENESIS_CB_TXID,
     create_block,
 )
+from test_framework.chronik.test_data import GENESIS_NATIVE_OUTPUT
 from test_framework.hash import hex_be_sha256
 from test_framework.messages import XEC, CTransaction, FromHex, ToHex
 from test_framework.p2p import P2PDataStore
@@ -24,7 +25,8 @@ from test_framework.test_framework import BitcoinTestFramework
 from test_framework.util import assert_equal
 from test_framework.wallet import MiniWallet, MiniWalletMode
 
-GENESIS_CB_SCRIPTHASH = hex_be_sha256(GENESIS_CB_SCRIPT_PUBKEY)
+GENESIS_CB_SCRIPTHASH = hex_be_sha256(GENESIS_NATIVE_OUTPUT)
+LEGACY_GENESIS_CB_SCRIPTHASH = hex_be_sha256(GENESIS_CB_SCRIPT_PUBKEY)
 SCRIPTHASH_P2SH_OP_TRUE_HEX = hex_be_sha256(P2SH_OP_TRUE)
 
 
@@ -95,6 +97,18 @@ class ChronikScriptHashTest(BitcoinTestFramework):
                 pb.TxHistoryPage(),
             )
 
+        # The native leaf commits to P2PK but is a distinct indexed script.
+        assert_equal(
+            self.chronik.script("p2pk", GENESIS_CB_PK).confirmed_txs().ok(),
+            pb.TxHistoryPage(),
+        )
+        assert_equal(
+            self.chronik.script("scripthash", LEGACY_GENESIS_CB_SCRIPTHASH)
+            .history()
+            .ok(),
+            pb.TxHistoryPage(),
+        )
+
         expected_cb_history = pb.TxHistoryPage(
             txs=[genesis_cb_tx()], num_pages=1, num_txs=1
         )
@@ -111,7 +125,7 @@ class ChronikScriptHashTest(BitcoinTestFramework):
         assert_equal(
             self.chronik.script("scripthash", GENESIS_CB_SCRIPTHASH).utxos().ok(),
             pb.ScriptUtxos(
-                script=bytes.fromhex(f"41{GENESIS_CB_PK}ac"),
+                script=GENESIS_NATIVE_OUTPUT,
                 utxos=[
                     pb.ScriptUtxo(
                         outpoint=pb.OutPoint(
@@ -444,7 +458,9 @@ class ChronikScriptHashTest(BitcoinTestFramework):
         self.log.info("Restarting with chronikscripthashindex=1 restores the index")
         self.restart_node(0, ["-chronik", "-chronikscripthashindex=1"])
         assert_equal(
-            self.chronik.script("p2pk", GENESIS_CB_PK).confirmed_txs().ok(),
+            self.chronik.script("other", GENESIS_NATIVE_OUTPUT.hex())
+            .confirmed_txs()
+            .ok(),
             self.chronik.script("scripthash", GENESIS_CB_SCRIPTHASH)
             .confirmed_txs()
             .ok(),
