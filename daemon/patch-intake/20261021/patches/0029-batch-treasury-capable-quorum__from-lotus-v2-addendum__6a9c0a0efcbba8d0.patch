Subject: [PATCH] fixup! avalanche: add treasury contender voting, 50/25/25
 reward split, and default slate

Advertise the existing batch-vote capability on this batch/treasury fixture quorum. Ordinary Avalanche peers are correctly ineligible for mempool-batch polls; the original quorum advertised none and timed out. Keep all quorum sizes, acceptance/finalization thresholds and treasury50:25:25 assertions. Complete focused functional passes15.6seconds.

Tier: V2
---
 .../abc_p2p_avalanche_batch_and_treasury.py          | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/test/functional/abc_p2p_avalanche_batch_and_treasury.py b/test/functional/abc_p2p_avalanche_batch_and_treasury.py
index b591e96799..c57ba5f7be 100644
--- a/test/functional/abc_p2p_avalanche_batch_and_treasury.py
+++ b/test/functional/abc_p2p_avalanche_batch_and_treasury.py
@@ -16,6 +16,9 @@ from test_framework.key import ECPubKey
 from test_framework.messages import (
     MSG_AVA_MEMPOOL_BATCH,
     MSG_AVA_TREASURY_CONTENDER,
+    NODE_AVALANCHE,
+    NODE_MERKLIX_EPOCH,
+    NODE_NETWORK,
     XEC,
     AvalancheProofVoteResponse,
     AvalancheVote,
@@ -57,7 +60,14 @@ class AvalancheBatchAndTreasuryTest(BitcoinTestFramework):
         now = int(time.time())
         node.setmocktime(now)
 
-        quorum = [get_ava_p2p_interface(self, node) for _ in range(QUORUM_NODE_COUNT)]
+        quorum = [
+            get_ava_p2p_interface(
+                self,
+                node,
+                services=NODE_NETWORK | NODE_AVALANCHE | NODE_MERKLIX_EPOCH,
+            )
+            for _ in range(QUORUM_NODE_COUNT)
+        ]
 
         def wait_for_finalized_proof(proofid):
             def finalize_proof():
