@@ -1137,4 +1141,95 @@ BOOST_AUTO_TEST_CASE(TestCBlockTemplateEntry) {
     BOOST_CHECK_EQUAL(txEntry.sigChecks, 10);
 }
 
+namespace {
+/**
+ * Spend a mature coinbase through normal mempool admission, mark the active
+ * tip as Avalanche-finalized (the condition upstream preconsensus mining
+ * waits for), then assemble and mine a block using the node's configured
+ * BlockAssembler options. Returns whether the block includes the spend.
+ */
+bool MineSpendWithConfiguredOptions(AvalancheTestChain100Setup &setup) {
+    const CScript script =
+        GetScriptForDestination(PKHash(setup.coinbaseKey.GetPubKey()));
+    const CTransactionRef coinbase = setup.m_coinbase_txns[0];
+    const Amount value = coinbase->vout[1].nValue - 10000 * SATOSHI;
+    const TxId txid = setup
+                          .CreateValidMempoolTransaction(
+                              coinbase, /*input_vout=*/1, /*input_height=*/1,
+                              setup.coinbaseKey, script, value)
+                          .GetId();
+    ChainstateManager &chainman = *Assert(setup.m_node.chainman);
+    BOOST_REQUIRE(setup.m_node.mempool->exists(txid));
+
+    const CBlockIndex *tip = WITH_LOCK(cs_main, return chainman.ActiveTip());
+    avalanche::AvalancheTest::setFinalizationTip(*setup.m_node.avalanche, tip);
+
+    // Default options come from the node arguments, exactly like the
+    // getblocktemplate/generate RPCs; add_finalized_txs is not overridden.
+    std::unique_ptr<CBlockTemplate> pblocktemplate =
+        BlockAssembler{setup.config, chainman.ActiveChainstate(),
+                       setup.m_node.mempool.get(), setup.m_node.avalanche.get()}
+            .CreateNewBlock(script);
+    BOOST_REQUIRE(pblocktemplate);
+    CBlock block = pblocktemplate->block;
+    bool included = false;
+    for (const CTransactionRef &tx : block.vtx) {
+        included |= tx->GetId() == txid;
+    }
+
+    block.hashMerkleRoot = BlockMerkleRoot(block);
+    block.SetSize(GetSerializeSize(block));
+    while (!CheckProofOfWork(block.GetHash(), block.nBits,
+                             chainman.GetConsensus())) {
+        ++block.nNonce;
+    }
+    BOOST_REQUIRE(chainman.ProcessNewBlock(
+        std::make_shared<const CBlock>(block),
+        /*force_processing=*/true,
+        /*min_pow_checked=*/true, nullptr, setup.m_node.avalanche.get()));
+    BOOST_CHECK_EQUAL(
+        WITH_LOCK(cs_main, return chainman.ActiveTip())->GetBlockHash(),
+        block.GetHash());
+    BOOST_CHECK_EQUAL(setup.m_node.mempool->exists(txid), !included);
+    return included;
+}
+} // namespace
+
+// Lotus V1 does not run Avalanche. Even with an Avalanche processor attached
+// and an Avalanche-finalized tip, default node options must keep normal
+// fee-based selection so ordinary wallet spends are mined.
+BOOST_FIXTURE_TEST_CASE(default_options_mine_unfinalized_spend,
+                        AvalancheTestChain100Setup) {
+    BOOST_CHECK(!AVALANCHE_DEFAULT_ENABLED);
+    BOOST_CHECK(!DEFAULT_AVALANCHE_PRECONSENSUS);
+    BOOST_CHECK(!DEFAULT_AVALANCHE_MINING_PRECONSENSUS);
+
+    BlockAssembler::Options options;
+    options.add_finalized_txs = true;
+    ArgsManager args;
+    node::ApplyArgsManOptions(args, options);
+    BOOST_CHECK(!options.add_finalized_txs);
+
+    BOOST_CHECK(MineSpendWithConfiguredOptions(*this));
+    const CBlockIndex *tip =
+        WITH_LOCK(cs_main, return m_node.chainman->ActiveTip());
+    BOOST_CHECK(!m_node.avalanche->isPreconsensusActivated(tip));
+}
+
+// Explicit opt-in retains upstream finalized-transaction-only mining.
+struct OptInPreconsensusMiningSetup : public AvalancheTestChain100Setup {
+    OptInPreconsensusMiningSetup()
+        : AvalancheTestChain100Setup(
+              ChainType::REGTEST,
+              {"-avalanchepreconsensus=1", "-avalanchepreconsensusmining=1"}) {}
+};
+
+BOOST_FIXTURE_TEST_CASE(opt_in_preconsensus_mines_only_finalized,
+                        OptInPreconsensusMiningSetup) {
+    BOOST_CHECK(!MineSpendWithConfiguredOptions(*this));
+    const CBlockIndex *tip =
+        WITH_LOCK(cs_main, return m_node.chainman->ActiveTip());
+    BOOST_CHECK(m_node.avalanche->isPreconsensusActivated(tip));
+}
+
 BOOST_AUTO_TEST_SUITE_END()
