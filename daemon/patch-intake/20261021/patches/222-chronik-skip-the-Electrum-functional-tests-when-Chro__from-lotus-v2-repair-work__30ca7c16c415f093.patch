From 05150fff389396d52a6086dfeaeec9c03f81070e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 07:02:06 -0700
Subject: [PATCH] chronik: skip the Electrum functional tests when Chronik has
 no Electrum

The native Chronik implementation has no Electrum interface. Add
skip_if_no_chronik_electrum() (ENABLE_CHRONIK_ELECTRUM in config.ini,
true for the Rust implementation) and use it in the two Electrum tests.

Tier: eCash
---
 test/functional/chronik_electrum_basic.py        |  2 +-
 test/functional/chronik_electrum_blockchain.py   |  2 +-
 test/functional/test_framework/test_framework.py | 13 +++++++++++++
 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/test/functional/chronik_electrum_basic.py b/test/functional/chronik_electrum_basic.py
index 55c10ecacd3d9ad445a8ac627185db979785e7c4..64c6ca600827ee3aae132d9314cf6ac29eeac17a 100644
--- a/test/functional/chronik_electrum_basic.py
+++ b/test/functional/chronik_electrum_basic.py
@@ -43,7 +43,7 @@ class ChronikElectrumBasic(BitcoinTestFramework):
             ],
         ]
 
-    requires = {"chronik"}
+    requires = {"chronik", "chronik_electrum"}
 
     def run_test(self):
         self.node = self.nodes[0]
diff --git a/test/functional/chronik_electrum_blockchain.py b/test/functional/chronik_electrum_blockchain.py
index 555a2ef777022f05868ef48286c00ddd369bcaa2..5b9cc628ea9b2c8a1937a6c8739cc141a7bac5ef 100644
--- a/test/functional/chronik_electrum_blockchain.py
+++ b/test/functional/chronik_electrum_blockchain.py
@@ -69,7 +69,7 @@ class ChronikElectrumBlockchain(BitcoinTestFramework):
             ]
         ]
 
-    requires = {"chronik"}
+    requires = {"chronik", "chronik_electrum"}
 
     def run_test(self):
         self.client = self.nodes[0].get_chronik_electrum_client(name="client")
diff --git a/test/functional/test_framework/test_framework.py b/test/functional/test_framework/test_framework.py
index c5b8e6f4ff89c830fb043452584e7bb55ee5782e..d8c01a84901d62be2104ae078eda0309d32bfe71 100644
--- a/test/functional/test_framework/test_framework.py
+++ b/test/functional/test_framework/test_framework.py
@@ -1430,6 +1430,11 @@ class BitcoinTestFramework(metaclass=BitcoinTestMetaClass):
         if not self.is_chronik_plugins_compiled():
             raise SkipTest("Chronik indexer plugins have not been compiled.")
 
+    def skip_if_no_chronik_electrum(self):
+        """Skip the running test if Chronik was compiled without Electrum."""
+        if not self.is_chronik_electrum_compiled():
+            raise SkipTest("Chronik Electrum interface has not been compiled.")
+
     def is_cli_compiled(self):
         """Checks whether bitcoin-cli was compiled."""
         return self.config["components"].getboolean("ENABLE_CLI")
@@ -1454,6 +1459,13 @@ class BitcoinTestFramework(metaclass=BitcoinTestMetaClass):
         """Checks whether the zmq module was compiled."""
         return self.config["components"].getboolean("ENABLE_ZMQ")
 
+    def is_chronik_electrum_compiled(self):
+        """Checks whether Chronik was compiled with its Electrum interface
+        (the native implementation has none)."""
+        return self.config["components"].getboolean(
+            "ENABLE_CHRONIK_ELECTRUM", fallback=True
+        )
+
     def is_usdt_compiled(self):
         """Checks whether the USDT tracepoints were compiled."""
         return self.config["components"].getboolean("ENABLE_USDT_TRACEPOINTS")
@@ -1472,6 +1484,7 @@ REQUIREMENTS = {
     "zmq": BitcoinTestFramework.skip_if_no_bitcoind_zmq,
     "py3_zmq": BitcoinTestFramework.skip_if_no_py3_zmq,
     "chronik": BitcoinTestFramework.skip_if_no_chronik,
+    "chronik_electrum": BitcoinTestFramework.skip_if_no_chronik_electrum,
     "chronik_plugins": BitcoinTestFramework.skip_if_no_chronik_plugins,
     "linux": BitcoinTestFramework.skip_if_platform_not_linux,
     "usdt": BitcoinTestFramework.skip_if_no_bitcoind_tracepoints,
-- 
