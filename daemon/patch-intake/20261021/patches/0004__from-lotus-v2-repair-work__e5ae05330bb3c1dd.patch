+from test_framework.messages import CBlock, CBlockHeader, CTransaction, CTxIn, CTxOut, COutPoint, FromHex, ser_compact_size
 from test_framework.script import CScript, OP_TRUE, OP_RETURN
 
 class RPC:
@@ -65,26 +65,34 @@ def fixture(args):
             if result is not None: raise RuntimeError(result)
             coinbases.append(cb); prev=block.hash_int
         receipts=[]
+        progress=args.output/'fixture-progress.json'
+        previous=json.loads(progress.read_text())['blocks'] if progress.exists() else []
         # ~1000/4000 actual spends per 8/32MB block, with unique 8KB data.
         # One fanout transaction + leaf spends, CTOR ordering handled by blocktools.
         for i in range(41):
+            height=151+i
+            if i<len(previous) and height<=existing:
+                record=previous[i]
+                if rpc.getblockhash(height)!=record['hash']: raise RuntimeError('fixture resume hash mismatch')
+                receipts.append(record); prev=int(record['hash'],16); continue
+            random.seed(height)
             target=8_000_000 if i<20 else 32_000_000
             count=1000 if target==8_000_000 else 4000
             cb_source=coinbases[i]
             fan=CTransaction(); fan.vin=[CTxIn(COutPoint(int(cb_source.txid_hex,16),0),b'')]
             value=cb_source.vout[0].nValue//(count+1)
             fan.vout=[CTxOut(value,CScript([OP_TRUE])) for _ in range(count)]
-            txs=[fan]
+            txs=[fan]; fan_id=int(fan.txid_hex,16)
             padlen=target//count-85
             for j in range(count):
-                tx=CTransaction(); tx.vin=[CTxIn(COutPoint(int(fan.txid_hex,16),j),b'')]
+                tx=CTransaction(); tx.vin=[CTxIn(COutPoint(fan_id,j),b'')]
                 # deterministic varied binary corpus, seed/hash explicitly recorded.
                 pad=hashlib.shake_256(f'n2-load-v1/{i}/{j}'.encode()).digest(padlen)
                 tx.vout=[CTxOut(value-1,CScript([OP_TRUE])),CTxOut(0,CScript([OP_RETURN,pad]))]
                 txs.append(tx)
             height=151+i; cb=create_coinbase(height)
             block=create_block(prev,cb,stamps+height,txlist=txs); block.solve()
-            raw=block.serialize()
+            raw=CBlockHeader.serialize(block)+ser_compact_size(len(block.vtx))+b''.join(tx.serialize() for tx in block.vtx)
             if i==40:
                 (args.output/'relay-block.hex').write_text(raw.hex())
                 relay={'hash':block.hash_hex,'bytes':len(raw),'height':height,'transactions':len(block.vtx)}
@@ -127,9 +135,14 @@ def matrix(args,fx):
                     clientjson=folder/'client.json'
                     clientcmd=[str(args.build/'src/bench/p2p-load'),f'{transport}://127.0.0.1:{args.port}/p2p/ws',str(n),'4',str(args.timeout),str(hashes),str(ready),str(clientjson)]
                     with open(folder/'client.log','w') as output: client=subprocess.Popen(clientcmd,stdout=output,stderr=subprocess.STDOUT)
-                    samples=[]; begin=time.monotonic(); submitted=None
+                    samples=[]; begin=time.monotonic(); submitted=None; resource_blocker=None
                     while client.poll() is None:
-                        samples.append({'at_monotonic':time.monotonic(),'server':sample_cpu(p.pid),'client':sample_cpu(client.pid)})
+                        rss=subprocess.check_output(['ps','-o','rss=','-p',f'{p.pid},{client.pid}'],text=True)
+                        rss_bytes=sum(int(v)*1024 for v in rss.split())
+                        samples.append({'at_monotonic':time.monotonic(),'server':sample_cpu(p.pid),'client':sample_cpu(client.pid),'combined_rss_bytes':rss_bytes})
+                        if rss_bytes>args.max_rss_gib*1024**3:
+                            resource_blocker=f'client+server RSS exceeded {args.max_rss_gib}GiB on shared host'
+                            client.terminate(); client.wait(); break
                         if ready.exists() and scenario=='relay' and submitted is None:
                             submitted=time.monotonic_ns()//1000
                             response=rpc.submitblock((args.output/'relay-block.hex').read_text())
@@ -139,10 +152,13 @@ def matrix(args,fx):
                     save(folder/'cpu-samples.json',samples)
                     peers=clientdata.get('peers',[])
                     expected=50 if scenario=='serve' else 1
-                    status='ok' if client.returncode==0 and len(peers)==n and all(row['blocks']==expected for row in peers) else 'failed'
+                    status='resource_blocked' if resource_blocker else 'ok' if client.returncode==0 and len(peers)==n and all(row['blocks']==expected for row in peers) else 'failed'
                     durations=[(row['last_us']-(row['request_us'] if scenario=='serve' else submitted))/1e6 for row in peers if row['last_us'] and (scenario=='serve' or submitted)]
                     bytes_total=sum(row['bytes'] for row in peers)
-                    result={'name':name,'status':status,'transport':transport,'scenario':scenario,'peers':n,'expected_blocks_per_peer':expected,'node_command':cmd,'client_command':clientcmd,'elapsed_wall_seconds':time.monotonic()-begin,'client_cpu_seconds':clientdata.get('client_cpu_seconds'),'first_seconds':min(durations) if durations else None,'p50_seconds':quantile(durations,.5),'p99_seconds':quantile(durations,.99),'last_seconds':max(durations) if durations else None,'received_bytes':bytes_total,'submitted_monotonic_us':submitted,'load_average':os.getloadavg(),'run_count':1,'client_detail':'client.json','server_client_cpu_samples':'cpu-samples.json'}
+                    transfer_begin=min((row['request_us'] for row in peers if row['request_us']),default=submitted or 0)
+                    transfer_end=max((row['last_us'] for row in peers),default=0)
+                    transfer_seconds=(transfer_end-transfer_begin)/1e6 if transfer_begin and transfer_end else None
+                    result={'name':name,'status':status,'transport':transport,'scenario':scenario,'peers':n,'expected_blocks_per_peer':expected,'node_command':cmd,'client_command':clientcmd,'elapsed_wall_seconds':time.monotonic()-begin,'client_cpu_seconds':clientdata.get('client_cpu_seconds'),'first_seconds':min(durations) if durations else None,'p50_seconds':quantile(durations,.5),'p99_seconds':quantile(durations,.99),'last_seconds':max(durations) if durations else None,'received_bytes':bytes_total,'submitted_monotonic_us':submitted,'load_average':os.getloadavg(),'run_count':1,'throughput_MBps':bytes_total/1e6/transfer_seconds if status=='ok' and transfer_seconds and transfer_seconds>0 else None,'transfer_seconds':transfer_seconds,'peak_combined_rss_bytes':max((v['combined_rss_bytes'] for v in samples),default=0),'resource_blocker':resource_blocker,'client_detail':'client.json','server_client_cpu_samples':'cpu-samples.json'}
                     save(resultpath,result); records.append(result)
                     print(name,status,flush=True)
                 finally:
@@ -154,10 +170,11 @@ def matrix(args,fx):
                 (args.output/'MATRIX.md').write_text('\n'.join(lines)+'\n\nLoopback; one run per cell; baseline only. Server and client per-thread samples are recorded separately.\n')
 
 def main():
-    a=argparse.ArgumentParser(); a.add_argument('--build',type=pathlib.Path,required=True); a.add_argument('--output',type=pathlib.Path,required=True); a.add_argument('--peers',default='50,100,250,500'); a.add_argument('--transports',default='ws,wss'); a.add_argument('--scenarios',default='relay,serve'); a.add_argument('--timeout',type=int,default=600); a.add_argument('--rpcport',type=int,default=19482); a.add_argument('--port',type=int,default=19483); a.add_argument('--fixture-only',action='store_true'); args=a.parse_args()
+    a=argparse.ArgumentParser(); a.add_argument('--build',type=pathlib.Path,required=True); a.add_argument('--output',type=pathlib.Path,required=True); a.add_argument('--peers',default='50,100,250,500'); a.add_argument('--transports',default='ws,wss'); a.add_argument('--scenarios',default='relay,serve'); a.add_argument('--timeout',type=int,default=600); a.add_argument('--rpcport',type=int,default=19482); a.add_argument('--port',type=int,default=19483); a.add_argument('--max-rss-gib',type=float,default=24); a.add_argument('--fixture-only',action='store_true'); args=a.parse_args()
     args.output.mkdir(parents=True,exist_ok=True)
     soft,hard=resource.getrlimit(resource.RLIMIT_NOFILE); resource.setrlimit(resource.RLIMIT_NOFILE,(min(4096,hard),hard))
     if not (args.output/'cert.pem').exists(): subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-keyout',str(args.output/'key.pem'),'-out',str(args.output/'cert.pem'),'-subj','/CN=localhost','-days','2'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+    save(args.output/'executables.json',{'source_commit':subprocess.check_output(['git','-C',str(ROOT),'rev-parse','HEAD'],text=True).strip(),'binaries':{str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in [args.build/'src/bitcoind',args.build/'src/bench/p2p-load']},'build_type':'Release','chronik':False,'wallet':False})
     fx=fixture(args)
