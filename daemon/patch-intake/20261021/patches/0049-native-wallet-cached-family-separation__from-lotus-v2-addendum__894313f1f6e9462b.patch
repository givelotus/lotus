From 371f0316d63640ca80fd3b4f8fbecca775185ff2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 00:13:34 -0700
Subject: [PATCH] fixup! test(v2): migrate functional fixtures and harnesses to
 native transactions

Check cached-chain family separation explicitly: the real legacy MiniWallet owns cached funds and NativeMiniWallet owns none until its unchanged140native blocks are generated. Retain all native wire, witnesses, BIP340 signatures, corruption rejection, multi-input, fee, rescan and reorg checks. Cached variant before fails0UTXOs; private after passes3.7s without changing wallet defaults or cached funding.

Tier: V2 (fixup to test(v2): migrate functional fixtures and harnesses to native transactions)
---
 test/functional/feature_miniwallet_native.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/test/functional/feature_miniwallet_native.py b/test/functional/feature_miniwallet_native.py
index 0dc6df8683..bce6fbf704 100644
--- a/test/functional/feature_miniwallet_native.py
+++ b/test/functional/feature_miniwallet_native.py
@@ -11,7 +11,7 @@ from io import BytesIO
 from test_framework.messages import CTransaction
 from test_framework.test_framework import BitcoinTestFramework
 from test_framework.util import assert_equal, assert_greater_than
-from test_framework.wallet import MiniWalletMode, NativeMiniWallet
+from test_framework.wallet import MiniWallet, MiniWalletMode, NativeMiniWallet
 
 
 class NativeMiniWalletTest(BitcoinTestFramework):
@@ -44,7 +44,11 @@ class NativeMiniWalletTest(BitcoinTestFramework):
         node = self.nodes[0]
         wallet = NativeMiniWallet(node)
         if self.options.cached_chain:
-            assert_greater_than(len(wallet.get_utxos(mark_as_spent=False)), 0)
+            # Cached funding belongs to the inherited legacy wallet. Native
+            # ownership must stay separate until native outputs are generated.
+            legacy = MiniWallet(node)
+            assert_greater_than(len(legacy.get_utxos(mark_as_spent=False)), 0)
+            assert_equal(len(wallet.get_utxos(mark_as_spent=False)), 0)
         wallet.generate(140)
         assert_greater_than(len(wallet.get_utxos(mark_as_spent=False)), 0)
         transfer = wallet.create_self_transfer(sequence=0xFFFFFFFF)
