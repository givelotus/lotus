index 0000000000000000000000000000000000000000..15907c7b370123466b106525be552f851acb7a72
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/service/authority.cpp
@@ -0,0 +1,109 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <ext/lotus_v2/service/authority.h>
+
+namespace chronik::native::lotus_v2 {
+
+void Authority::Terminal() {
+    m_known.store(0);
+    m_generation.store(UINT64_MAX);
+    m_sequence.store(UINT64_MAX);
+}
+
+uint64_t Authority::Update(UpdateKind kind, const Anchor &anchor,
+                           const NativeContext &context) {
+    std::lock_guard<std::mutex> lock(m_writer);
+    const uint64_t previous = m_sequence.load();
+    if (previous > UINT64_MAX - 2 || previous + 2 == UINT64_MAX) {
+        Terminal();
+        throw ChronikError("authority observation exhausted");
+    }
+    const uint64_t next = previous + 2;
+    uint64_t generation = m_generation.load();
+    bool known = false;
+    bool advance = false;
+    switch (kind) {
+        case UpdateKind::Suspend:
+            break;
+        case UpdateKind::Invalidate:
+            advance = true;
+            break;
+        case UpdateKind::Publish:
+            known = true;
+            advance = true;
+            break;
+        case UpdateKind::Context:
+            known = true;
+            advance = m_context != context;
+            break;
+    }
+    if (advance) {
+        if (generation >= UINT64_MAX - 1) {
+            Terminal();
+            throw ChronikError("authority generation exhausted");
+        }
+        ++generation;
+    }
+    m_sequence.store(previous + 1);
+    if (kind == UpdateKind::Context) {
+        m_context = context;
+    } else if (kind == UpdateKind::Publish) {
+        m_context.reset();
+    }
+    m_known.store(known ? 1 : 0);
+    if (known) {
+        m_height.store(anchor.height);
+        for (size_t w = 0; w < 4; ++w) {
+            uint64_t word = 0;
+            for (size_t i = 0; i < 8; ++i) {
+                word |= uint64_t(anchor.block_id[w * 8 + i]) << (8 * i);
+            }
+            m_words[w].store(word);
+        }
+    }
+    m_generation.store(generation);
+    m_sequence.store(next);
+    return generation;
+}
+
+uint64_t Authority::Publish(const std::optional<Anchor> &anchor) {
+    return anchor ? Update(UpdateKind::Publish, *anchor, {})
+                  : Update(UpdateKind::Invalidate, {}, {});
+}
+
+uint64_t Authority::Suspend() { return Update(UpdateKind::Suspend, {}, {}); }
+
+uint64_t Authority::PublishContext(const Anchor &anchor,
+                                   uint64_t context_generation,
+                                   uint64_t chain_revision) {
+    return Update(UpdateKind::Context, anchor,
+                  NativeContext{anchor, context_generation, chain_revision});
+}
+
+AuthoritativeState Authority::Observe() const {
+    const uint64_t first = m_sequence.load();
+    if (first % 2 != 0) {
+        return {first, m_generation.load(), std::nullopt};
+    }
+    const uint64_t generation = m_generation.load();
+    const bool known = m_known.load() != 0;
+    const uint64_t height = m_height.load();
+    Anchor anchor;
+    for (size_t w = 0; w < 4; ++w) {
+        const uint64_t word = m_words[w].load();
+        for (size_t i = 0; i < 8; ++i) {
+            anchor.block_id[w * 8 + i] = uint8_t(word >> (8 * i));
+        }
+    }
+    anchor.height = height;
+    const uint64_t last = m_sequence.load();
+    AuthoritativeState state{last, generation, std::nullopt};
+    if (first == last && known) {
+        state.anchor = anchor;
+    }
+    return state;
+}
+
+} // namespace chronik::native::lotus_v2
diff --git a/chronik/native/ext/lotus_v2/service/authority.h b/chronik/native/ext/lotus_v2/service/authority.h
new file mode 100644
index 0000000000000000000000000000000000000000..a5404873e20f424e52176dcf843fa90ee3905524
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/service/authority.h
@@ -0,0 +1,81 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_EXT_LOTUS_V2_SERVICE_AUTHORITY_H
+#define CHRONIK_NATIVE_EXT_LOTUS_V2_SERVICE_AUTHORITY_H
+
+#include <ext/lotus_v2/db/model.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+
+/**
+ * Native chain authority published to V2 readers (port of the Authority in
+ * chronik-lib/src/v2_server.rs; the HTTP listener is not part of it).
+ *
+ * Independent counters: the observation sequence fences every busy or
+ * publication boundary (odd while a writer is mid-update); the generation
+ * versions durable observations and explorer continuations. A complete idle
+ * suspend/resume keeps the generation only with an exact native context
+ * stamp. Neither counter wraps, and terminal failure stays unknown. Writers
+ * throw ChronikError on exhaustion; observe() never blocks.
+ */
+namespace chronik::native::lotus_v2 {
+
+/** chronik_http::v2::AuthoritativeState */
+struct AuthoritativeState {
+    uint64_t observation = 0;
+    uint64_t generation = 0;
+    std::optional<Anchor> anchor;
+    bool operator==(const AuthoritativeState &) const = default;
+};
+
+class Authority {
+public:
+    /** Durable invalidation (nullopt) or generic publication; always a new
+     * generation. Generic publication cannot certify an unchanged stamp. */
+    uint64_t Publish(const std::optional<Anchor> &anchor);
+    /** Hide authority while native work runs; keeps the generation. */
+    uint64_t Suspend();
+    /** Publish a reconciled stamp; an unchanged stamp keeps the generation. */
+    uint64_t PublishContext(const Anchor &anchor, uint64_t context_generation,
+                            uint64_t chain_revision);
+    /** One coherent stamped state, without taking any lock. */
+    AuthoritativeState Observe() const;
+
+    /** Test hooks (Rust tests poke the atomics directly). */
+    void TestSetSequence(uint64_t v) { m_sequence.store(v); }
+    void TestSetGeneration(uint64_t v) { m_generation.store(v); }
+    std::unique_lock<std::mutex> TestLockWriter() {
+        return std::unique_lock<std::mutex>(m_writer);
+    }
+
+private:
+    struct NativeContext {
+        Anchor anchor;
+        uint64_t context_generation = 0;
+        uint64_t chain_revision = 0;
+        bool operator==(const NativeContext &) const = default;
+    };
+    enum class UpdateKind { Suspend, Invalidate, Publish, Context };
+
+    uint64_t Update(UpdateKind kind, const Anchor &anchor,
+                    const NativeContext &context);
+    void Terminal();
+
+    std::mutex m_writer;
+    std::optional<NativeContext> m_context; // guarded by m_writer
+    std::atomic<uint64_t> m_sequence{0};
+    std::atomic<uint64_t> m_generation{0};
+    std::atomic<uint64_t> m_height{0};
+    std::array<std::atomic<uint64_t>, 4> m_words{};
+    std::atomic<uint64_t> m_known{0};
+};
+
+} // namespace chronik::native::lotus_v2
+
+#endif // CHRONIK_NATIVE_EXT_LOTUS_V2_SERVICE_AUTHORITY_H
diff --git a/chronik/native/ext/lotus_v2/service/ffi.h b/chronik/native/ext/lotus_v2/service/ffi.h
new file mode 100644
index 0000000000000000000000000000000000000000..98428d05ad6def99c23925730707cecddf8cf3de
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/service/ffi.h
@@ -0,0 +1,169 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_EXT_LOTUS_V2_SERVICE_FFI_H
+#define CHRONIK_NATIVE_EXT_LOTUS_V2_SERVICE_FFI_H
+
+#include <array>
+#include <cstdint>
+#include <vector>
+
+/**
+ * Native V2 service input/output structs: plain C++ mirrors of the
+ * chronik-lib/src/v2_ffi.rs CXX bridge structs (namespace chronik_v2). The
+ * host adapter fills NativeBlock from its node block; identities are native
+ * wire order. No node headers are involved.
+ */
+namespace chronik::native::lotus_v2::ffi {
+
+using Bytes32 = std::array<uint8_t, 32>;
+
+struct Binding {
+    Bytes32 chain_id{};
+    Bytes32 genesis{};
+    Bytes32 profile{};
+};
+
+struct Anchor {
+    Bytes32 block_id{};
+    uint64_t height = 0;
+    bool operator==(const Anchor &) const = default;
+};
+
+struct ServiceLimits {
+    uint32_t block_bytes = 0;
+    uint32_t transactions = 0;
+    uint32_t changes = 0;
+    uint32_t roots = 0;
+    uint32_t clauses = 0;
+    uint32_t page_size = 0;
+    uint32_t posting_reads = 0;
+    uint32_t work = 0;
+    uint32_t response_bytes = 0;
+};
+
+/** A consumed coin and its native input ordinal. */
+struct Input {
+    Bytes32 txid{};
+    uint32_t out_idx = 0;
+    uint32_t input_index = 0;
+};
+
+struct NativeOutput {
+    std::vector<uint8_t> wire;
+};
+
+/** Byte range in the exact transaction frame. */
+struct WireRange {
+    uint64_t offset = 0;
+    uint64_t length = 0;
+};
+
+/** Authenticated witness section locations. */
+struct NativeWitness {
+    WireRange script;
+    WireRange siblings_table;
+    uint32_t siblings_count = 0;
+    WireRange arguments_table;
+    uint32_t arguments_count = 0;
+};
+
+/** Complete input descriptor, including non-spend selectors. */
+struct NativeFullInput {
+    Bytes32 prev_txid{};
+    uint32_t prev_index = 0;
+    uint32_t sequence = 0;
+    uint8_t flags = 0;
+    uint8_t path_index = 0;
+    bool has_coinbase_data = false;
+    WireRange coinbase_data;
+    std::vector<NativeWitness> witnesses;
+};
+
+struct NativeTx {
+    Bytes32 txid{};
+    Bytes32 txhash{};
+    uint32_t index = 0;
+    std::vector<Input> inputs;
+    std::vector<NativeOutput> outputs;
+    std::vector<uint8_t> wire;
+    uint64_t lock = 0;
+    std::vector<NativeFullInput> full_inputs;
+};
+
+struct NativeBlock {
+    Anchor anchor;
+    Anchor parent;
+    std::vector<NativeTx> transactions;
+    std::array<uint8_t, 134> header_wire{};
+};
+
+struct Status {
+    bool initialized = false;
+    Anchor indexed;
+    Anchor node;
+    bool ready = false;
+};
+
+struct Root {
+    Bytes32 bytes{};
+};
+
+struct Position {
+    uint8_t position = 0;
+    std::vector<Root> roots;
+};
+
+struct Continuation {
+    bool present = false;
+    uint8_t version = 0;
+    Bytes32 chain_id{};
+    Bytes32 profile{};
+    Anchor anchor;
+    Bytes32 filter_digest{};
+    bool has_last = false;
+    Bytes32 last_txid{};
+    uint32_t last_out_idx = 0;
+};
+
+struct BranchRequest {
+    std::vector<Root> any_branch;
+    std::vector<Position> positions;
+    bool utxos = false;
+    bool include_burn = false;
+    Continuation cursor;
+};
+
+struct Location {
+    Anchor anchor;
+    uint32_t tx_index = 0;
+    Bytes32 txid{};
+    Bytes32 txhash{};
+};
+
+struct OutputMatch {
+    Bytes32 txid{};
+    uint32_t out_idx = 0;
+    std::vector<uint8_t> wire;
+    Location creation;
+    bool spent = false;
+    Location spend;
+    uint32_t input_index = 0;
+    std::vector<uint8_t> matching_positions;
+};
+
+struct BranchPage {
+    Anchor anchor;
+    Bytes32 chain_id{};
+    Bytes32 profile{};
+    std::vector<OutputMatch> matches;
+    Continuation cursor;
+    uint64_t posting_reads = 0;
+    uint64_t work = 0;
+    uint64_t encoded_bytes = 0;
+};
+
+} // namespace chronik::native::lotus_v2::ffi
+
+#endif // CHRONIK_NATIVE_EXT_LOTUS_V2_SERVICE_FFI_H
diff --git a/chronik/native/ext/lotus_v2/service/service.cpp b/chronik/native/ext/lotus_v2/service/service.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e27a45ad45011c1a59351cf21c28ebd6e5258b80
--- /dev/null
+++ b/chronik/native/ext/lotus_v2/service/service.cpp
@@ -0,0 +1,386 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <ext/lotus_v2/service/service.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <filesystem>
+#include <random>
+
+#include <sys/stat.h>
+
+namespace chronik::native::lotus_v2 {
+
+namespace qb = query_branches;
+
+namespace {
+
+[[noreturn]] void Fail(const std::string &msg) { throw V2ServiceError(msg); }
+
+/** e.to_string() of a DB failure. */
+template <typename F> auto Db(F &&f) -> decltype(f()) {
+    try {
+        return f();
+    } catch (const V2ServiceError &) {
+        throw;
+    } catch (const ChronikError &e) {
+        Fail(e.what());
+    }
+}
+
+Anchor ToAnchor(const ffi::Anchor &a) { return Anchor{a.block_id, a.height}; }
+ffi::Anchor FfiAnchor(const Anchor &a) {
+    return ffi::Anchor{a.block_id, a.height};
+}
+WireRange Range(const ffi::WireRange &r) { return WireRange{r.offset, r.length}; }
+
+ffi::Location FfiLocation(const TxLocation &l) {
+    return ffi::Location{ffi::Anchor{l.block_id.b, l.height}, l.tx_index,
+                         l.txid.hash.b, l.txhash.hash.b};
+}
+
+ffi::Continuation FfiContinuation(const std::optional<qb::Cursor> &c) {
+    ffi::Continuation out;
+    out.present = c.has_value();
+    out.version = 1;
+    if (c) {
+        out.version = c->version;
+        out.chain_id = c->snapshot.chain_id.b;
+        out.profile = c->snapshot.profile_id.b;
+        out.anchor = ffi::Anchor{c->snapshot.tip.b, c->snapshot.height};
+        out.filter_digest = c->filter_digest.b;
+        out.has_last = c->last_key.has_value();
+        if (c->last_key) {
+            out.last_txid = c->last_key->txid.hash.b;
+            out.last_out_idx = c->last_key->out_idx;
+        }
+    }
+    return out;
+}
+
+/** Rust io::Error Display: "<description> (os error N)". */
+std::string IoError(int err) {
+    return std::string(std::strerror(err)) + " (os error " +
+           std::to_string(err) + ")";
+}
+
+} // namespace
+
+ffi::Continuation EmptyContinuation() { return FfiContinuation(std::nullopt); }
+
+std::unique_ptr<V2Service>
+V2Service::Open(const std::string &path, const ffi::Binding &binding,
+                bool fresh, const ffi::ServiceLimits &limits,
+                qb::Sha256Fn sha256) {
+    if (path.empty() || path.size() > 4096) {
+        Fail("path bound");
+    }
+    if (limits.transactions == 0 || limits.transactions > MAX_TRANSACTIONS ||
+        limits.changes == 0 || limits.changes > MAX_CHANGES ||
+        limits.block_bytes == 0 || limits.block_bytes > MAX_BATCH_BYTES ||
+        limits.roots == 0 || limits.roots > 256 || limits.clauses == 0 ||
+        limits.clauses > 16 || limits.page_size == 0 ||
+        limits.page_size > 1000 || limits.posting_reads == 0 ||
+        limits.posting_reads > 65536 || limits.work == 0 ||
+        limits.work > 131072 || limits.response_bytes < 512 ||
+        limits.response_bytes > 1024 * 1024) {
+        Fail("service limits");
+    }
+    std::unique_ptr<V2Service> service(new V2Service());
+    try {
+        std::random_device rd;
+        for (size_t i = 0; i < service->m_service_epoch.size(); i += 4) {
+            const uint32_t word = rd();
+            for (size_t j = 0; j < 4; ++j) {
+                service->m_service_epoch[i + j] = uint8_t(word >> (8 * j));
+            }
+        }
+    } catch (const std::exception &) {
+        Fail("explorer entropy unavailable");
+    }
+    const std::filesystem::path dir(path);
+    if (fresh) {
+        if (::mkdir(dir.c_str(), 0777) != 0) {
+            Fail(IoError(errno));
+        }
+    } else {
+        std::error_code ec;
+        if (!std::filesystem::is_regular_file(dir / "mdbx.dat", ec)) {
+            Fail("existing V2 DB required");
+        }
+    }
+    service->m_db = Db([&] {
+        return std::make_shared<SharedV2Db>(
+            dir, Binding{binding.chain_id, binding.genesis, binding.profile});
+    });
+    service->m_limits = limits;
+    service->m_genesis = binding.genesis;
+    service->m_authority = std::make_shared<Authority>();
+    service->m_index_error = std::make_shared<std::atomic<bool>>(false);
+    service->m_sha256 = std::move(sha256);
+    return service;
+}
+
+uint64_t V2Service::InvalidateAuthority() {
+    return Db([&] { return m_authority->Publish(std::nullopt); });
+}
+
+uint64_t V2Service::PublishAuthority(const ffi::Anchor &anchor) {
+    return Db([&] { return m_authority->Publish(ToAnchor(anchor)); });
+}
+
+uint64_t V2Service::SuspendAuthority() {
+    return Db([&] { return m_authority->Suspend(); });
+}
+
+uint64_t V2Service::PublishAuthorityContext(const ffi::Anchor &anchor,
+                                            uint64_t context_generation,
+                                            uint64_t chain_revision) {
+    return Db([&] {
+        return m_authority->PublishContext(ToAnchor(anchor),
+                                           context_generation, chain_revision);
+    });
+}
+
+std::optional<ffi::Anchor> V2Service::Checkpoint() const {
+    std::lock_guard<std::mutex> lock(m_db->mutex);
+    const auto checkpoint = Db([&] { return m_db->db.Checkpoint(); });
+    if (!checkpoint) {
+        return std::nullopt;
+    }
+    return FfiAnchor(*checkpoint);
+}
+
+CommittedBlock V2Service::Block(const ffi::NativeBlock &block) const {
+    if (block.transactions.size() > m_limits.transactions) {
+        Fail("transaction bound");
+    }
+    const size_t cap = m_limits.block_bytes;
+    size_t bytes = 218;
+    size_t changes = 0;
+    if (bytes > cap) {
+        Fail("block bytes bound");
+    }
+    for (const ffi::NativeTx &tx : block.transactions) {
+        size_t descriptor_bytes = 0;
+        for (const ffi::NativeFullInput &i : tx.full_inputs) {
+            descriptor_bytes += i.witnesses.size() * 80 + 128;
+        }
+        bytes += tx.wire.size() + descriptor_bytes;
+        if (bytes > cap) {
+            Fail("full facts bound");
+        }
+        changes += tx.inputs.size() + tx.outputs.size();
+        bytes += 76 + tx.inputs.size() * 40;
+        if (changes > m_limits.changes || bytes > cap) {
+            Fail("block input bound");
+        }
+        for (const ffi::NativeOutput &output : tx.outputs) {
+            if (output.wire.size() > MAX_OUTPUT_BYTES) {
+                Fail("output bound");
+            }
+            bytes += 4 + output.wire.size();
+            if (bytes > cap) {
+                Fail("block bytes bound");
+            }
+        }
+    }
+    CommittedBlock out;
+    out.anchor = ToAnchor(block.anchor);
+    out.parent = ToAnchor(block.parent);
+    out.explorer.header_wire = block.header_wire;
+    for (const ffi::NativeTx &tx : block.transactions) {
+        ConfirmedTx ctx;
+        for (const ffi::NativeOutput &o : tx.outputs) {
+            OutputError err;
+            auto output = Output::Decode(o.wire, &err);
+            if (!output) {
+                Fail(err.Message());
+            }
+            ctx.outputs.push_back(std::move(*output));
+        }
+        ctx.location = TxLocation{H(block.anchor.block_id), block.anchor.height,
+                                  tx.index, TxId{H(tx.txid)},
+                                  TxHash{H(tx.txhash)}};
+        ctx.explorer.wire = tx.wire;
+        ctx.explorer.lock = tx.lock;
+        for (const ffi::NativeFullInput &i : tx.full_inputs) {
+            InputFact fact;
+            fact.prev_txid = i.prev_txid;
+            fact.prev_index = i.prev_index;
+            fact.sequence = i.sequence;
+            fact.flags = i.flags;
+            fact.path_index = i.path_index;
+            fact.has_coinbase_data = i.has_coinbase_data;
+            fact.coinbase_data = Range(i.coinbase_data);
+            for (const ffi::NativeWitness &w : i.witnesses) {
+                fact.witnesses.push_back(WitnessFact{
+                    Range(w.script), Range(w.siblings_table), w.siblings_count,
+                    Range(w.arguments_table), w.arguments_count});
+            }
+            ctx.explorer.inputs.push_back(std::move(fact));
+        }
+        for (const ffi::Input &i : tx.inputs) {
+            ctx.spends.push_back(
+                SpentInput{OutPoint{TxId{H(i.txid)}, i.out_idx}, i.input_index});
+        }
+        out.transactions.push_back(std::move(ctx));
+    }
+    return out;
+}
+
+template <typename F> void V2Service::Transition(F &&action) {
+    try {
+        InvalidateAuthority();
+        action();
+    } catch (...) {
+        m_index_error->store(true, std::memory_order_release);
+        throw;
+    }
+    m_index_error->store(false, std::memory_order_release);
+}
+
+void V2Service::InitializeGenesis(const ffi::NativeBlock &block) {
+    Transition([&] {
+        if (block.anchor.height != 0 || block.parent.height != 0 ||
+            block.anchor.block_id != block.parent.block_id ||
+            block.anchor.block_id != m_genesis) {
+            Fail("genesis binding/shape");
+        }
+        const CommittedBlock committed = Block(block);
+        std::lock_guard<std::mutex> lock(m_db->mutex);
+        Db([&] { m_db->db.InitializeGenesis(committed); });
+    });
+}
+
+void V2Service::ConnectBlock(const ffi::NativeBlock &block) {
+    Transition([&] {
+        const CommittedBlock committed = Block(block);
+        std::lock_guard<std::mutex> lock(m_db->mutex);
+        Db([&] { m_db->db.Connect(committed); });
+    });
+}
+
+void V2Service::DisconnectBlock(const ffi::Anchor &expected) {
+    Transition([&] {
+        std::lock_guard<std::mutex> lock(m_db->mutex);
+        Db([&] { m_db->db.Disconnect(ToAnchor(expected)); });
+    });
+}
+
+ffi::Status V2Service::GetStatus(const ffi::Anchor &node) const {
+    std::optional<Anchor> checkpoint;
+    {
+        std::lock_guard<std::mutex> lock(m_db->mutex);
+        checkpoint = Db([&] { return m_db->db.Checkpoint(); });
+    }
+    ffi::Status status;
+    status.initialized = checkpoint.has_value();
+    status.ready = checkpoint == ToAnchor(node);
+    status.indexed = FfiAnchor(checkpoint.value_or(Anchor{}));
+    status.node = node;
+    return status;
+}
+
+ffi::BranchPage
+V2Service::QueryBranches(const ffi::BranchRequest &request) const {
+    if (request.positions.size() > m_limits.clauses ||
+        request.any_branch.size() > m_limits.roots) {
+        Fail("query input bound");
+    }
+    size_t total = request.any_branch.size();
+    for (const ffi::Position &p : request.positions) {
+        total += p.roots.size();
+    }
+    if (total > m_limits.roots || request.positions.size() > m_limits.clauses) {
+        Fail("query input bound");
+    }
+    qb::BranchFilter filter;
+    for (const ffi::Root &r : request.any_branch) {
+        filter.any_branch.push_back(H(r.bytes));
+    }
+    for (const ffi::Position &p : request.positions) {
+        qb::PositionClause clause{p.position, {}};
+        for (const ffi::Root &r : p.roots) {
+            clause.roots.push_back(H(r.bytes));
+        }
+        filter.positions.push_back(std::move(clause));
+    }
+    std::optional<qb::Cursor> cursor;
+    const ffi::Continuation &c = request.cursor;
+    if (c.present) {
+        cursor = qb::Cursor{
+            c.version,
+            qb::Snapshot{H(c.chain_id), H(c.profile), H(c.anchor.block_id),
+                         c.anchor.height},
+            H(c.filter_digest),
+            c.has_last ? std::optional<OutPoint>(
+                             OutPoint{TxId{H(c.last_txid)}, c.last_out_idx})
+                       : std::nullopt};
+    }
+    std::lock_guard<std::mutex> lock(m_db->mutex);
+    const ReadSnapshot snapshot = Db([&] { return m_db->db.Snapshot(); });
+    const qb::SnapshotPostingSource source(snapshot);
+    // Fixed-width transport includes absent spend slots. This conservative
+    // budget covers vector framing and all optional cursor/record fields.
+    const size_t envelope = 307;
+    const size_t room = size_t(m_limits.response_bytes) - envelope;
+    const size_t page_cap =
+        std::max<size_t>(std::min<size_t>(m_limits.page_size, room / 300), 1);
+    qb::Limits limits;
+    limits.roots = m_limits.roots;
+    limits.clauses = m_limits.clauses;
+    limits.page_size = page_cap;
+    limits.posting_reads = m_limits.posting_reads;
+    limits.work = m_limits.work;
+    limits.result_bytes = room > page_cap * 119 ? room - page_cap * 119 : 0;
+    qb::Page page;
+    try {
+        page = qb::Query(source, filter,
+                         request.utxos ? qb::QueryKind::Utxos()
+                                       : qb::QueryKind::History(
+                                             request.include_burn),
+                         limits, cursor, m_sha256);
+    } catch (const qb::QueryError &e) {
+        Fail("V2 query: " + e.Debug());
+    }
+    ffi::BranchPage out;
+    size_t encoded_bytes = envelope;
+    for (qb::Match &m : page.matches) {
+        ffi::OutputMatch match;
+        match.txid = m.record.outpoint.txid.hash.b;
+        match.out_idx = m.record.outpoint.out_idx;
+        OutputError err;
+        auto wire = m.record.output.Encode(&err);
+        if (!wire) {
+            Fail(err.Message());
+        }
+        match.wire = std::move(*wire);
+        match.creation = FfiLocation(m.record.creation);
+        match.spent = m.record.spend.has_value();
+        if (m.record.spend) {
+            match.spend = FfiLocation(m.record.spend->transaction);
+            match.input_index = m.record.spend->input_index;
+        }
+        match.matching_positions = std::move(m.matching_positions);
+        encoded_bytes +=
+            265 + match.wire.size() + match.matching_positions.size();
+        out.matches.push_back(std::move(match));
+    }
+    if (encoded_bytes > m_limits.response_bytes) {
+        Fail("response bytes bound");
+    }
+    out.anchor = ffi::Anchor{page.snapshot.tip.b, page.snapshot.height};
+    out.chain_id = page.snapshot.chain_id.b;
+    out.profile = page.snapshot.profile_id.b;
+    out.cursor = FfiContinuation(page.continuation);
+    out.posting_reads = page.posting_reads;
+    out.work = page.work;
+    out.encoded_bytes = encoded_bytes;
+    return out;
+}
+
+} // namespace chronik::native::lotus_v2
