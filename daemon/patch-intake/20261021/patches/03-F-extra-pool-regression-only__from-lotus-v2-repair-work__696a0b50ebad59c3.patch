 src/test/mining_pool_tests.cpp | 50 +++++++++++++++++++++++++++++-----
 1 file changed, 43 insertions(+), 7 deletions(-)

diff --git a/src/test/mining_pool_tests.cpp b/src/test/mining_pool_tests.cpp
index 32b9c90e9ef16ed32d92a05f1118ba592f11a51e..b7d8e2cdb4cc4185f9928ef5b2c602dfb116c82f 100644
--- a/src/test/mining_pool_tests.cpp
+++ b/src/test/mining_pool_tests.cpp
@@ -35,18 +35,18 @@
 
 namespace {
 
-// Native coinbase JSON exposes the canonical output frame, not a legacy
-// script. Compare the complete decoded commitment to the intended recipient.
+// Wrapped coinbase outputs retain literal payout scripts; native treasury
+// outputs retain their encoded frame. Check either exact representation against
+// the intended recipient, without accepting a different commitment.
 bool OutputPaysScript(const UniValue &output, const CScript &recipient) {
     const int64_t sats = output.find_value("value_sats").getInt<int64_t>();
     BOOST_REQUIRE_GE(sats, 0);
+    const auto script = ParseHex(output.find_value("script_hex").get_str());
+    if (script == std::vector<uint8_t>(recipient.begin(), recipient.end())) return true;
     lotus::v2::Output decoded;
     std::string error;
-    BOOST_REQUIRE_MESSAGE(
-        lotus::v2::DecodeOutput(
-            ParseHex(output.find_value("script_hex").get_str()), decoded, error),
-        error);
-    return decoded == CTxOut(sats * SATOSHI, recipient).ToV2Output();
+    return lotus::v2::DecodeOutput(script, decoded, error) &&
+           decoded == CTxOut(sats * SATOSHI, recipient).ToV2Output();
 }
 
 bool HashMeetsTarget(const BlockHash &pow_hash, const uint256 &target) {
@@ -299,6 +299,42 @@ BOOST_AUTO_TEST_CASE(share_validation_accept_duplicate_and_high_hash) {
                       "nonce-prefix-mismatch");
 }
 
+// Exercise the real job builder and the cached coinbase used by SubmitShare,
+// rather than fabricating a transaction that bypasses pool payout assembly.
+BOOST_AUTO_TEST_CASE(coinbase_outputs_survive_wire_round_trip) {
+    const Config &config = GetConfig();
+    auto &pool = m_node.mining_pool ? *m_node.mining_pool
+                                    : node::GetGlobalMiningPool();
+    pool.Reset();
+    const CTxDestination recipient = PKHash(coinbaseKey.GetPubKey());
+    const CScript payout = GetScriptForDestination(recipient);
+    m_node.args->ForceSetArg("-pooladdress", EncodeDestination(recipient, config));
+    pool.Configure(*m_node.args, config);
+    lotus::v2::node::PoolJob cached;
+    const UniValue job = pool.GetMiningJobJSON(config, m_node, "sub:wire", &cached);
+    BOOST_REQUIRE(cached.coinbase_tx);
+    const CTransaction &coinbase = *cached.coinbase_tx;
+    DataStream stream;
+    stream << coinbase;
+    const auto serialized = HexStr(stream);
+    const CTransaction decoded(deserialize, stream);
+    BOOST_CHECK_EQUAL(decoded.GetId(), coinbase.GetId());
+    BOOST_CHECK_EQUAL(decoded.GetHash(), coinbase.GetHash());
+    BOOST_REQUIRE_EQUAL(decoded.vout.size(), coinbase.vout.size());
+    BOOST_REQUIRE(!coinbase.vout.empty());
+    BOOST_CHECK(coinbase.vout[0].scriptPubKey == payout);
+    BOOST_CHECK(decoded.vout[0].scriptPubKey == payout);
+    BOOST_CHECK_EQUAL(job.find_value("coinbase_tx_hex").get_str(), EncodeHexTx(coinbase));
+    for (size_t i = 0; i < coinbase.vout.size(); ++i) {
+        BOOST_CHECK(decoded.vout[i].scriptPubKey == coinbase.vout[i].scriptPubKey);
+        BOOST_CHECK(decoded.vout[i] == coinbase.vout[i]);
+        BOOST_CHECK(decoded.vout[i].ToV2Output() == coinbase.vout[i].ToV2Output());
+    }
+    DataStream reencoded;
+    reencoded << decoded;
+    BOOST_CHECK_EQUAL(HexStr(reencoded), serialized);
+}
+
 BOOST_AUTO_TEST_CASE(newsletter_subscriber_worker_credits_and_routing) {
