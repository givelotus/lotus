From 8220bb752268e4deb77ca637ad6417928a0e27c7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 17:38:08 -0700
Subject: [PATCH 05/28] amount: resolve -ecash once instead of on every amount
 written as JSON

Currency::get(), used by Amount::operator UniValue() and ToString(),
called gArgs.GetBoolArg("-ecash") each time: a settings map lookup under
the global ArgsManager mutex. RPCs that write many amounts serialize on
that lock across all -rpcthreads; profiling getblock (verbosity 2) of a
1000-transaction block under 16 concurrent clients showed ~17k samples
waiting on it inside ArgsManager::GetSetting.

-ecash cannot change while the node runs, so bitcoind now records it once
in AppInitParameterInteraction (Currency::SetECash). Callers that never set
it (unit tests, other tools) keep the previous lookup, so forced test
arguments still apply.

Measured on that workload (regtest, 3.35 MB replies): c=16 306 -> 434
req/s, c=64 364 -> 590 req/s, p99 at c=64 237 -> 140 ms.
---
 src/consensus/amount.cpp | 13 +++++++++++++
 src/consensus/amount.h   |  7 +++++++
 src/init.cpp             |  4 ++++
 3 files changed, 24 insertions(+)

diff --git a/src/consensus/amount.cpp b/src/consensus/amount.cpp
index 85efa460a0..29922bb2b8 100644
--- a/src/consensus/amount.cpp
+++ b/src/consensus/amount.cpp
@@ -12,6 +12,8 @@
 
 #include <tinyformat.h>
 
+#include <atomic>
+
 using namespace std::string_view_literals;
 
 static constexpr Currency BCHA{COIN, SATOSHI, 8, "BCHA"sv};
@@ -22,7 +24,18 @@ static_assert(BCHA.baseunit > 1 * SATOSHI,
 static_assert(XEC.baseunit > 1 * SATOSHI,
               "XEC base unit must be greater than 1 satoshi");
 
+//! -1 until SetECash() is called, then 0 (BCHA) or 1 (XEC)
+static std::atomic<int> g_ecash{-1};
+
+void Currency::SetECash(bool ecash) {
+    g_ecash.store(ecash ? 1 : 0, std::memory_order_relaxed);
+}
+
 const Currency &Currency::get() {
+    const int ecash{g_ecash.load(std::memory_order_relaxed)};
+    if (ecash >= 0) {
+        return ecash ? XEC : BCHA;
+    }
     return gArgs.GetBoolArg("-ecash", DEFAULT_ECASH) ? XEC : BCHA;
 }
 
diff --git a/src/consensus/amount.h b/src/consensus/amount.h
index 334b066726..000ee849f8 100644
--- a/src/consensus/amount.h
+++ b/src/consensus/amount.h
@@ -161,6 +161,13 @@ struct Currency {
 
     static const Currency &get();
     static std::string getTicker() { return std::string{get().ticker}; }
+
+    /**
+     * Fix the unit chosen by -ecash for the rest of the process, so get()
+     * (called for every amount written as JSON) no longer has to look it up
+     * under the ArgsManager lock. Until this is called, get() reads -ecash.
+     */
+    static void SetECash(bool ecash);
 };
 
 /**
diff --git a/src/init.cpp b/src/init.cpp
index 1e0789d579..1b268d0e12 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -1993,6 +1993,10 @@ bool AppInitBasicSetup(const ArgsManager &args, std::atomic<int> &exit_status) {
 }
 
 bool AppInitParameterInteraction(Config &config, const ArgsManager &args) {
+    // -ecash cannot change at runtime: resolve it once instead of on every
+    // amount written as JSON.
+    Currency::SetECash(args.GetBoolArg("-ecash", DEFAULT_ECASH));
+
     const CChainParams &chainparams = config.GetChainParams();
     // Step 2: parameter interactions
 
