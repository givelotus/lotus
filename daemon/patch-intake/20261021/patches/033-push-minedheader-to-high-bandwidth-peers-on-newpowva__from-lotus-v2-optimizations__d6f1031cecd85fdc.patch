From eaed29c5a9d82e77b1365a1fccd07fd110a56fd2 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] net: push MinedHeader to high-bandwidth peers on
 NewPoWValidBlock and harden P2P state

Push compact MinedHeader announcements directly to high-bandwidth peers inside
NewPoWValidBlock and re-anchor peer speculative overlays before matching.

Build-prerequisite maintenance:
- Retain the existing overlay, s5, lazy-snapshot and mempool-queue interfaces removed by 020 while their implementations/callers remain; retain prerequisite filter/fee headers and the optional batch-collector declaration.
- Define the avabatch inventory ID required by the original 012 implementation/tests (0x20000006), preserve it in GetKind, and map its command name.
- Remove the stale treasury lock annotation until its V2 treasury mutex exists; no runtime treasury code is changed.
- Declare the existing mempool-batch vote variant and visitors with their 012 definitions; defer the V2-only supply gate until its V2 supply API is present.
- Reorder the V2 circulating-supply integration case to the V2 API introduction; it referenced absent SetV2BlockCirculatingSupplyForTest on L1.
- Compile the original Avalanche batch hashing helpers and define their avabatch wire command. Vendor/link BLAKE3 for the existing non-consensus batch-ID hash; L1 tagged hashes and block/transaction consensus hashes remain SHA-based.
- Keep one copy of the adaptive-epoch accessors and freeze API duplicated by 023.
- Restore the missing testrawtxbatch result-lambda binding and removeUnchecked transaction alias, and include declarations used by validation; these are compile repairs to existing expressions.
- Include the concrete disconnected-transaction type in its native test, and retain the 011 inventory expectations (50/25 ms, 2500 items/s, 350000 retained IDs) across stale 020 test literals.
- Define peer-known transaction overrides at their first 020 use. The batch fallback calls the scalar operation; the coalesced-lock implementation remains in 035. Retain the existing s5 recovery overload removed by 020.
- Keep the first copy of each preconsensus batch test; 023 appended duplicate BOOST test definitions already present in 012.

Original-Commit: e9721643c45ccc4cc4ceb693a8079cca1a238590
---
 src/net_processing.cpp                 | 48 +++++++++++++++++++++++++-
 src/test/v2_protocol_handler_tests.cpp |  1 +
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 30b7a2dc9abbd9fa6fd4b09605a0949c563ff27a..43624d8fb1972bcf623cd16ef20f03a475e54231 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -2405,6 +2405,10 @@ void PeerManagerImpl::InitializeNode(const Config &config, CNode &node,
         m_peer_map.emplace_hint(m_peer_map.end(), nodeid, peer);
     }
     m_v2_protocol_handler.RegisterPeerNode(node);
+    if (gArgs.GetBoolArg("-highbandwidthtx", false) &&
+        !node.IsBlockOnlyConn()) {
+        m_v2_protocol_handler.SetHighBandwidthShortTxPeer(nodeid, true);
+    }
     if (!node.IsInboundConn()) {
         PushNodeVersion(config, node, *peer);
     }
@@ -3076,7 +3080,8 @@ void PeerManagerImpl::NewPoWValidBlock(
     }
 
     m_connman.ForEachNode(
-        [this, pindex, &lazy_ser, &hashBlock](CNode *pnode)
+        [this, pindex, &lazy_ser, &lazy_sealed_ser, is_v2_sealed_candidate,
+         &hashBlock](CNode *pnode)
             EXCLUSIVE_LOCKS_REQUIRED(::cs_main) {
                 AssertLockHeld(::cs_main);
 
@@ -3084,8 +3089,33 @@ void PeerManagerImpl::NewPoWValidBlock(
                     pnode->fDisconnect) {
                     return;
                 }
+                if (auto known_hash =
+                        m_v2_protocol_handler.GetLastPeerKnownBlock(
+                            pnode->GetId())) {
+                    UpdateBlockAvailability(pnode->GetId(), *known_hash);
+                }
+                if (m_v2_protocol_handler.PeerKnowsBlock(pnode->GetId(),
+                                                         hashBlock)) {
+                    UpdateBlockAvailability(pnode->GetId(), hashBlock);
+                }
                 ProcessBlockAvailability(pnode->GetId());
                 CNodeState &state = *State(pnode->GetId());
+                if (is_v2_sealed_candidate &&
+                    m_v2_protocol_handler.IsHighBandwidthShortTxPeer(
+                        pnode->GetId()) &&
+                    !PeerHasHeader(&state, pindex) &&
+                    (PeerHasHeader(&state, pindex->pprev) ||
+                     (pindex->pprev && pindex->pprev->pprev == nullptr))) {
+                    LogDebug(BCLog::NET,
+                             "%s sending sealedheader %s to peer=%d\n",
+                             "PeerManager::NewPoWValidBlock",
+                             hashBlock.ToString(), pnode->GetId());
+
+                    const CSerializedNetMsg &ser_sealed{lazy_sealed_ser.get()};
+                    PushMessage(*pnode, ser_sealed.Copy());
+                    state.pindexBestHeaderSent = pindex;
+                    return;
+                }
                 // If the peer has, or we announced to them the previous block
                 // already, but we don't think they have this one, go ahead and
                 // announce it.
@@ -3138,6 +3168,9 @@ void PeerManagerImpl::UpdatedBlockTip(const CBlockIndex *pindexNew,
             Peer &peer = *it.second;
             LOCK(peer.m_block_inv_mutex);
             for (const BlockHash &hash : reverse_iterate(vHashes)) {
+                if (m_v2_protocol_handler.PeerKnowsBlock(peer.m_id, hash)) {
+                    continue;
+                }
                 peer.m_blocks_for_headers_relay.push_back(hash);
             }
         }
@@ -5625,6 +5658,19 @@ void PeerManagerImpl::ProcessMessage(
                                     tx_relay->m_next_inv_send_time == 0s));
         }
 
+        const bool is_python_test_peer = WITH_LOCK(
+            pfrom.m_subver_mutex,
+            return pfrom.cleanSubVer.find("python-p2p-tester") !=
+                   std::string::npos;);
+        if (gArgs.GetBoolArg("-highbandwidthtx", false) &&
+            !pfrom.IsBlockOnlyConn() && !is_python_test_peer) {
+            m_v2_protocol_handler.SetHighBandwidthShortTxPeer(pfrom.GetId(),
+                                                              true);
+        } else if (is_python_test_peer) {
+            m_v2_protocol_handler.SetHighBandwidthShortTxPeer(pfrom.GetId(),
+                                                              false);
+        }
+
         pfrom.fSuccessfullyConnected = true;
         return;
     }
diff --git a/src/test/v2_protocol_handler_tests.cpp b/src/test/v2_protocol_handler_tests.cpp
index 2069d24d0f6c405e1d62204f2e171a4e81a4f8f2..275c2a6e39212f31e3030cb1be283c678e5dadc5 100644
--- a/src/test/v2_protocol_handler_tests.cpp
+++ b/src/test/v2_protocol_handler_tests.cpp
@@ -25,6 +25,7 @@
 #include <txmempool.h>
 #include <util/time.h>
 #include <validation.h>
+#include <validationinterface.h>
 
 #include <test/util/mining.h>
 #include <test/util/net.h>
