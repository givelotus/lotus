From b37f027029298d3dceb0122603fcc95d006ede9e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:48:42 -0700
Subject: [PATCH] test: know NODE_UTXO_SHARD and expect it on pruned nodes

ecash/022 makes every node advertise NODE_UTXO_SHARD (bit 25,
-serveutxoshards defaults on). That includes pruned nodes, which can still
serve shards of the current UTXO set. p2p_node_network_limited expected
NODE_BLOOM | NODE_NETWORK_LIMITED (1028) and got 33555460. rpc_net
decodes localservicesnames through test_framework.messages constants,
which had no NODE_UTXO_SHARD.

Add the constant and expect the bit. p2p_node_network_limited passes.
rpc_net stops in the legacy-tx group (MiniWallet) before its service
check, so that part is not exercised yet.

Tier: eCash (fixup to ecash/022)
---
 test/functional/p2p_node_network_limited.py | 4 +++-
 test/functional/test_framework/messages.py  | 1 +
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/test/functional/p2p_node_network_limited.py b/test/functional/p2p_node_network_limited.py
index a9447c90ea..734d488cdd 100644
--- a/test/functional/p2p_node_network_limited.py
+++ b/test/functional/p2p_node_network_limited.py
@@ -12,6 +12,7 @@ from test_framework.messages import (
     MSG_BLOCK,
     NODE_BLOOM,
     NODE_NETWORK_LIMITED,
+    NODE_UTXO_SHARD,
     CInv,
     msg_getdata,
     msg_verack,
@@ -61,7 +62,8 @@ class NodeNetworkLimitedTest(BitcoinTestFramework):
     def run_test(self):
         node = self.nodes[0].add_p2p_connection(P2PIgnoreInv())
 
-        expected_services = NODE_BLOOM | NODE_NETWORK_LIMITED
+        # A pruned node still serves UTXO shards (-serveutxoshards, default on).
+        expected_services = NODE_BLOOM | NODE_NETWORK_LIMITED | NODE_UTXO_SHARD
 
         self.log.info("Check that node has signalled expected services.")
         assert_equal(node.nServices, expected_services)
diff --git a/test/functional/test_framework/messages.py b/test/functional/test_framework/messages.py
index 4a54f5a443..892b9465b6 100644
--- a/test/functional/test_framework/messages.py
+++ b/test/functional/test_framework/messages.py
@@ -56,6 +56,7 @@ NODE_BLOOM = 1 << 2
 NODE_COMPACT_FILTERS = 1 << 6
 NODE_NETWORK_LIMITED = 1 << 10
 NODE_AVALANCHE = 1 << 24
+NODE_UTXO_SHARD = 1 << 25
 
 MSG_UNDEFINED = 0
 MSG_TX = 1
