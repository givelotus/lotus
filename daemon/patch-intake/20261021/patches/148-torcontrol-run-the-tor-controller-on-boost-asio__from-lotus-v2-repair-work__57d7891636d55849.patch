+/** Reply from Tor, can be single or multi-line */
+class TorControlReply {
+public:
+    TorControlReply() { Clear(); }
+
+    int code;
+    std::vector<std::string> lines;
+
+    void Clear() {
+        code = 0;
+        lines.clear();
