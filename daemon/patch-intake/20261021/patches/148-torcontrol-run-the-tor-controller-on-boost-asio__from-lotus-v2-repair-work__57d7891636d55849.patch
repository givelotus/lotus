+    const uint64_t gen = m_gen;
+    boost::asio::async_write(
+        *m_socket, boost::asio::buffer(*data),
+        [this, gen, data](const boost::system::error_code &ec, size_t) {
+            OnWrite(gen, ec);
+        });
