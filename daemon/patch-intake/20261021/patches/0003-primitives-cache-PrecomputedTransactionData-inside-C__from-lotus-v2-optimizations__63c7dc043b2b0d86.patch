+uint32_t CTransaction::ComputeSerializeSize() const {
+    // Bypass Serialize(), whose SizeComputer fast path reads m_serialize_size.
+    SizeComputer s;
+    SerializeTransaction(*this, s);
+    return s.size();
+}
