From 3fdc7a70d38dd419fb1c095e6eba30546ba69318 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 01:46:55 -0700
Subject: [PATCH] fixup! v2: swap CTransaction and BlockMerkleRoot to V2 v7
 wire format

Keep the Electrum version1337 negative fixture but assert the canonical wire decoder rejection bad-txns-version and error code1. Unsupported versions are refused by UnserializeTransaction before mempool policy. Ignore only std::ios_base::failure platform diagnostic text appended to that exact reason.

Tier: V2 (fixup to v2: swap CTransaction and BlockMerkleRoot to V2 v7 wire format)
---
 test/functional/chronik_electrum_blockchain.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/test/functional/chronik_electrum_blockchain.py b/test/functional/chronik_electrum_blockchain.py
index 25bc68874f..01d292a04a 100644
--- a/test/functional/chronik_electrum_blockchain.py
+++ b/test/functional/chronik_electrum_blockchain.py
@@ -561,10 +561,10 @@ class ChronikElectrumBlockchain(BitcoinTestFramework):
         tx_obj = FromHex(CTransaction(), raw_tx_reference)
         tx_obj.nVersion = 1337
         response = self.client.blockchain.transaction.broadcast(ToHex(tx_obj))
-        assert_equal(
-            response.error,
-            {"code": 1, "message": "Transaction rejected by mempool: version"},
-        )
+        # Unsupported wire versions are rejected before mempool policy.
+        # std::ios_base::failure may append a platform-specific error description.
+        assert_equal(response.error["code"], 1)
+        assert_equal(response.error["message"].partition(": ")[0], "bad-txns-version")
 
         # Coinbase input in first position
         tx_obj = FromHex(CTransaction(), raw_tx_reference)
