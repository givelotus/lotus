+/** CompactSize vectors rejected before allocating an attacker-selected count. */
+template <size_t Limit> struct ReconVectorFormatter {
+    template <typename Stream, typename Vector> void Ser(Stream &s, const Vector &v) {
+        if (v.size() > Limit) throw std::ios_base::failure("oversized Merklix vector");
+        WriteCompactSize(s, v.size());
+        for (const auto &item : v) ::Serialize(s, item);
+    }
+    template <typename Stream, typename Vector> void Unser(Stream &s, Vector &v) {
+        const auto count = ReadCompactSize(s);
+        if (count > Limit) throw std::ios_base::failure("oversized Merklix vector");
+        v.clear();
+        v.reserve(count);
+        for (size_t i = 0; i < count; ++i) {
+            typename Vector::value_type value;
+            ::Unserialize(s, value);
+            v.push_back(std::move(value));
+        }
+    }
+};
+
 /**
  * Depth-4 bucket entry in MerklixSyncSummary (12 bytes serialized).
  */
@@ -203,7 +223,24 @@ struct MerklixSubBucketSummary {
         for (auto &sb : obj.sub_buckets) {
             READWRITE(sb);
         }
-        READWRITE(obj.overflow_short_ids);
+        READWRITE(Using<ReconVectorFormatter<4096>>(obj.overflow_short_ids));
+    }
+};
+
+/** Negotiated vector messages use distinct command names, never the legacy
+ * single-summary encodings. Total wire bytes are also capped before dispatch. */
+struct MerklixBucketBatchRequest {
+    static constexpr size_t MAX_REQUESTS = 256;
+    std::vector<MerklixBucketRequest> requests;
+    SERIALIZE_METHODS(MerklixBucketBatchRequest, obj) {
+        READWRITE(Using<ReconVectorFormatter<MAX_REQUESTS>>(obj.requests));
+    }
+};
+struct MerklixBucketBatchReply {
+    static constexpr size_t MAX_SUMMARIES = 4096;
+    std::vector<MerklixSubBucketSummary> summaries;
+    SERIALIZE_METHODS(MerklixBucketBatchReply, obj) {
+        READWRITE(Using<ReconVectorFormatter<MAX_SUMMARIES>>(obj.summaries));
     }
 };
 
