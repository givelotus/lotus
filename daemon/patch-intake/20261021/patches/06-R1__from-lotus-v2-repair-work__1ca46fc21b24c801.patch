+#include <script/script.h>
+#include <boost/test/unit_test.hpp>
+using namespace lotus::v2::net;
+using namespace std::chrono_literals;
+BOOST_FIXTURE_TEST_SUITE(merklix_batch_tests, RegTestingSetup)
+BOOST_AUTO_TEST_CASE(vector_limits_reject_before_elements) {
+    DataStream request_wire;
+    WriteCompactSize(request_wire, MerklixBucketBatchRequest::MAX_REQUESTS + 1);
+    MerklixBucketBatchRequest request;
+    BOOST_CHECK_THROW(request_wire >> request, std::ios_base::failure);
+    BOOST_CHECK(request.requests.empty());
+    DataStream reply_wire;
+    WriteCompactSize(reply_wire, MerklixBucketBatchReply::MAX_SUMMARIES + 1);
+    MerklixBucketBatchReply reply;
+    BOOST_CHECK_THROW(reply_wire >> reply, std::ios_base::failure);
+    BOOST_CHECK(reply.summaries.empty());
+}
+BOOST_AUTO_TEST_CASE(one_reply_and_followup_independent_of_bucket_count) {
+    const auto &config = m_node.chainman->GetConfig();
+    ConnmanTestMsg connman(config, 1, 2, *m_node.addrman);
+    auto peerman = PeerManager::make(connman, *m_node.addrman, nullptr,
+                                     *m_node.chainman, *m_node.mempool, nullptr, {});
+    auto *local = peerman->GetV2ProtocolHandler();
+    V2PeerProtocolHandler remote(*m_node.chainman, *m_node.mempool, connman, *peerman);
+    CNode peer(701, nullptr, CAddress(), 0, 0, 0, CAddress(), "",
+               ConnectionType::OUTBOUND_FULL_RELAY, false);
+    peer.SetCommonVersion(PROTOCOL_VERSION);
+    peer.fSuccessfullyConnected = true;
+    local->SetPeerServices(peer.GetId(), ServiceFlags(NODE_MERKLIX | NODE_MERKLIX_BATCH));
+    remote.SetPeerServices(peer.GetId(), ServiceFlags(NODE_MERKLIX | NODE_MERKLIX_BATCH));
+    auto take_messages = [&] {
+        V1TransportDeserializer decoder(config, peer.GetId());
+        std::vector<CNetMessage> messages;
+        LOCK(peer.cs_vSend);
+        for (const auto &chunk : peer.vSendMsg) {
+            Span<const uint8_t> bytes{chunk};
+            while (!bytes.empty()) {
+                BOOST_REQUIRE_GE(decoder.Read(config, bytes), 0);
+                if (decoder.Complete()) {
+                    bool rejected = false;
+                    messages.push_back(decoder.GetMessage(0us, rejected));
+                    BOOST_REQUIRE(!rejected);
+                }
+            }
+        }
+        peer.vSendMsg.clear();
+        return messages;
+    };
+    for (const unsigned buckets : {1U, 16U}) {
+        std::vector<CTransactionRef> txs;
+        uint64_t nonce = 1;
+        for (unsigned bucket = 0; bucket < buckets; ++bucket) {
+            for (int item = 0; item < 2; ++item) {
+                while (true) {
+                    CMutableTransaction tx;
+                    tx.nVersion = 2;
+                    tx.vin.resize(1);
+                    uint256 id;
+                    for (unsigned byte = 0; byte < 8; ++byte)
+                        id.begin()[byte] = static_cast<uint8_t>(nonce >> (8 * byte));
+                    ++nonce;
+                    tx.vin[0].prevout = COutPoint(TxId(id), 0);
+                    tx.vout.emplace_back(1000 * SATOSHI, CScript() << OP_TRUE);
+                    auto candidate = MakeTransactionRef(std::move(tx));
+                    if (GetMerklixBucketIndex(candidate->GetId()) == bucket) {
+                        txs.push_back(candidate); break;
+                    }
+                }
+            }
+        }
+        uint256 context;
+        context.begin()[0] = buckets;
+        BOOST_REQUIRE(local->SetScopedTransactions(ReconScope::BLOCK_RECON, context, {}));
+        BOOST_REQUIRE(remote.SetScopedTransactions(ReconScope::BLOCK_RECON, context, txs));
+        DataStream summary;
+        summary << remote.BuildSyncSummary(ReconScope::BLOCK_RECON, context);
+        BOOST_REQUIRE(local->TryHandleMessage(peer, NetMsgType::MERKLIXSYNC, summary, 1s));
+        auto requests = take_messages();
+        BOOST_REQUIRE_EQUAL(requests.size(), 1U);
+        BOOST_CHECK_EQUAL(requests[0].m_type, NetMsgType::GETMERKLIXBATCH);
+        BOOST_REQUIRE(remote.TryHandleMessage(peer, requests[0].m_type, requests[0].m_recv, 1s));
+        auto replies = take_messages();
+        BOOST_REQUIRE_EQUAL(replies.size(), 1U);
+        BOOST_CHECK_EQUAL(replies[0].m_type, NetMsgType::MERKLIXBATCH);
+        BOOST_REQUIRE(local->TryHandleMessage(peer, replies[0].m_type, replies[0].m_recv, 1s));
+        auto followups = take_messages();
+        BOOST_REQUIRE_EQUAL(followups.size(), 1U);
+        BOOST_CHECK_EQUAL(followups[0].m_type, NetMsgType::GETSHORTTX);
+        ShortTxRequest missing;
+        followups[0].m_recv >> missing;
+        BOOST_CHECK_EQUAL(missing.short_ids.size(), 2 * buckets);
+    }
+}
+BOOST_AUTO_TEST_SUITE_END()
