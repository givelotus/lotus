+void V2PeerProtocolHandler::SendBucketRequests(
+    CNode &peer, const std::vector<MerklixBucketRequest> &requests) {
+    if (!(GetPeerServices(peer.GetId()) & NODE_MERKLIX_BATCH)) {
+        for (const auto &req : requests) SendBucketRequest(peer, req);
+        return;
+    }
+    if (requests.empty() || requests.size() > MerklixBucketBatchRequest::MAX_REQUESTS) return;
+    {
+        LOCK(m_mutex);
+        auto next = m_expected_buckets[peer.GetId()];
+        for (const auto &req : requests) {
+            const uint8_t depth = req.depth_bits == 0 ? 4 : req.depth_bits;
+            for (uint8_t bucket = 0; bucket < 16; ++bucket) {
+                if (!(req.bucket_mask & (1U << bucket))) continue;
+                const uint8_t child_depth = depth == 16 ? 16 : depth + 4;
+                const uint16_t prefix = depth == 16 ? req.parent_prefix :
+                    static_cast<uint16_t>((req.parent_prefix << 4) | bucket);
+                next.emplace(req.scope, req.context_id, req.salt_k0, req.salt_k1,
+                             child_depth, prefix);
+                if (next.size() > MerklixBucketBatchReply::MAX_SUMMARIES) return;
+            }
+        }
+        m_expected_buckets[peer.GetId()] = std::move(next);
+    }
+    MerklixBucketBatchRequest batch{requests};
+    m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::GETMERKLIXBATCH, batch));
+}
+
+void V2PeerProtocolHandler::HandleBucketBatchRequest(CNode &peer, DataStream &stream) {
+    auto malformed = [&] { LOCK(m_mutex); ++m_stats.malformed_messages; };
+    MerklixBucketBatchRequest request;
+    try { stream >> request; } catch (const std::exception &) { malformed(); return; }
+    if (request.requests.empty()) { malformed(); return; }
+    const auto &first = request.requests.front();
+    if (!IsValidReconScope(first.scope)) { malformed(); return; }
+    const auto scope = static_cast<ReconScope>(first.scope);
+    auto k0 = first.salt_k0, k1 = first.salt_k1;
+    if (k0 == 0 && k1 == 0) std::tie(k0, k1) = DeriveReconSipHashKey(scope, first.context_id, 0);
+    if (!IsValidReconSipHashKey(scope, first.context_id, k0, k1)) { malformed(); return; }
+    MerklixBucketBatchReply reply;
+    std::map<std::pair<uint8_t, uint16_t>, size_t> indices;
+    for (const auto &req : request.requests) {
+        const uint8_t depth = req.depth_bits == 0 ? 4 : req.depth_bits;
+        if (req.scope != first.scope || req.context_id != first.context_id ||
+            req.salt_k0 != first.salt_k0 || req.salt_k1 != first.salt_k1 ||
+            !req.bucket_mask || (depth != 4 && depth != 8 && depth != 12 && depth != 16) ||
+            req.parent_prefix >= (depth == 4 ? 1U : 1U << (depth - 4))) {
+            malformed(); return;
+        }
+        for (uint8_t bucket = 0; bucket < 16; ++bucket) {
+            if (!(req.bucket_mask & (1U << bucket))) continue;
+            const uint8_t child_depth = depth == 16 ? 16 : depth + 4;
+            const uint16_t prefix = depth == 16 ? req.parent_prefix :
+                static_cast<uint16_t>((req.parent_prefix << 4) | bucket);
+            const auto key = std::make_pair(child_depth, prefix);
+            if (indices.count(key)) { if (depth == 16) continue; malformed(); return; }
+            if (reply.summaries.size() >= MerklixBucketBatchReply::MAX_SUMMARIES) { malformed(); return; }
+            indices[key] = reply.summaries.size();
+            MerklixSubBucketSummary summary;
+            summary.scope = first.scope;
+            summary.context_id = first.context_id;
+            summary.salt_k0 = k0;
+            summary.salt_k1 = k1;
+            summary.depth_bits = child_depth;
+            summary.parent_prefix = prefix;
+            summary.parent_bucket = (prefix >> (child_depth - 8)) & 15;
+            reply.summaries.push_back(std::move(summary));
+        }
+    }
+    // One snapshot/scan per vector request, rather than one scan per reply.
+    // At most three prefix lookups per transaction, independent of fanout.
+    const auto txs = GetScopedTransactions(scope, first.context_id);
+    for (const auto &tx : txs) {
+        const auto &id = tx->GetId();
+        const uint64_t sid = ComputeMerklixShortId(k0, k1, id);
+        const uint64_t s3 = GF64Cube(sid), s5 = GF64Pow5(sid);
+        for (uint8_t depth : {8, 12, 16}) {
+            const auto found = indices.find({depth, GetMerklixPrefix(id, depth - 4)});
+            if (found == indices.end()) continue;
+            auto &summary = reply.summaries[found->second];
+            auto &cell = summary.sub_buckets[GetMerklixNibble(id, depth / 4 - 1)];
+            if (cell.count == std::numeric_limits<uint16_t>::max())
+                throw std::length_error("Merklix cell count exceeds legacy capacity");
+            ++cell.count; cell.s1 ^= sid; cell.s3 ^= s3; cell.s5 ^= s5;
+            if (depth == 16) {
+                if (summary.overflow_short_ids.size() >= ShortTxRequest::MAX_SHORT_IDS)
+                    throw std::length_error("Merklix terminal list exceeds complete scope capacity");
+                summary.overflow_short_ids.push_back(sid);
+            }
+        }
+    }
+    for (auto &summary : reply.summaries) {
+        auto &ids = summary.overflow_short_ids;
+        std::sort(ids.begin(), ids.end());
+        ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+    }
+    if (GetSerializeSize(reply) > 2 * 1024 * 1024)
+        throw std::length_error("Merklix vector exceeds wire byte bound");
+    m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::MERKLIXBATCH, reply));
+}
+
+void V2PeerProtocolHandler::HandleBucketBatchReply(
+    CNode &peer, DataStream &stream, std::chrono::microseconds now) {
+    auto malformed = [&] { LOCK(m_mutex); ++m_stats.malformed_messages; };
+    MerklixBucketBatchReply reply;
+    try { stream >> reply; } catch (const std::exception &) { malformed(); return; }
+    if (reply.summaries.empty()) { malformed(); return; }
+    const auto &first = reply.summaries.front();
+    if (!IsValidReconScope(first.scope)) { malformed(); return; }
+    // Build a local prefix view once. Each transaction is copied into at most
+    // three short-lived prefix vectors, bounding work and memory by scope size.
+    std::map<std::pair<uint8_t, uint16_t>, std::vector<CTransactionRef>> local;
+    for (const auto &summary : reply.summaries) {
+        if (summary.scope != first.scope || summary.context_id != first.context_id ||
+            summary.salt_k0 != first.salt_k0 || summary.salt_k1 != first.salt_k1 ||
+            (summary.depth_bits != 8 && summary.depth_bits != 12 && summary.depth_bits != 16)) {
+            malformed(); return;
+        }
+        if (!local.emplace(std::make_pair(summary.depth_bits, summary.parent_prefix),
+                           std::vector<CTransactionRef>{}).second) { malformed(); return; }
+    }
+    const auto txs = GetScopedTransactions(static_cast<ReconScope>(first.scope), first.context_id);
+    for (const auto &tx : txs) {
+        for (uint8_t depth : {8, 12, 16}) {
+            const auto found = local.find({depth, GetMerklixPrefix(tx->GetId(), depth - 4)});
+            if (found != local.end()) found->second.push_back(tx);
+        }
+    }
+    ReconFollowups followups;
+    for (const auto &summary : reply.summaries) {
+        DataStream one;
+        one << summary;
+        HandleMerklixBuck(peer, one, now, &followups,
+                          &local.at({summary.depth_bits, summary.parent_prefix}));
+    }
+    auto &ids = followups.missing.short_ids;
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+    // A request stays honest about the subset it asks for. Any remainder is
+    // recovered on the next root announcement; never send an oversized vector.
+    if (ids.size() > ShortTxRequest::MAX_SHORT_IDS) ids.resize(ShortTxRequest::MAX_SHORT_IDS);
+    if (!ids.empty()) {
+        const auto &req = followups.missing;
+        RecordPendingShortTxRequest(peer.GetId(), static_cast<ReconScope>(req.scope),
+                                     req.context_id, req.salt_k0, req.salt_k1, ids);
+        m_connman.PushMessage(&peer, NetMsg::Make(NetMsgType::GETSHORTTX, req));
+    }
+    if (!followups.descents.empty()) SendBucketRequests(peer, followups.descents);
+}
