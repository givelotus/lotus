From ac98d2d450e53fdc4a655b69aad0489e45acb0f5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 01:48:25 -0700
Subject: [PATCH] logging: keep the log file unbuffered after reopening it

When the log file is reopened (on SIGHUP, for log rotation), the new
FILE was meant to be unbuffered like the one StartLogging opens, but
setbuf() was applied to the old FILE just before closing it. The new
file was therefore block-buffered: lines after a rotation reached the
disk only once a stdio buffer filled (or at exit), so a shipper tailing
debug.log saw them late, and a crash could lose them.

The unit tests had come to rely on this: the sentinel line that
reopens the file stayed in the buffer and never appeared in what they
read. They now skip sentinel lines explicitly, and a new test checks
that the first line after a reopen is in the file at once.

(cherry picked from commit 25a0f19e0b1b7df3d5d87028d82d7abf158e18b4)

N3-Source-Commit: 25a0f19e0b1b7df3d5d87028d82d7abf158e18b4
N3-Source-Export: 0001
---
 src/logging.cpp            |  4 +--
 src/test/logging_tests.cpp | 58 ++++++++++++++++----------------------
 2 files changed, 27 insertions(+), 35 deletions(-)

diff --git a/src/logging.cpp b/src/logging.cpp
index 5bd93b547ab60adba72eeefed6a86c75be86cb4d..4d52f878799c4f43bb285bdcefd92dccfd7ebc37 100644
--- a/src/logging.cpp
+++ b/src/logging.cpp
@@ -525,8 +525,8 @@ void BCLog::Logger::LogPrintStr_(std::string_view str,
             m_reopen_file = false;
             FILE *new_fileout = fsbridge::fopen(m_file_path, "a");
             if (new_fileout) {
-                // unbuffered.
-                setbuf(m_fileout, nullptr);
+                // unbuffered, like the file opened by StartLogging
+                setbuf(new_fileout, nullptr);
                 fclose(m_fileout);
                 m_fileout = new_fileout;
             }
diff --git a/src/test/logging_tests.cpp b/src/test/logging_tests.cpp
index 006b9345ab5255a3acca075deddcdf405d8c6dfa..b7b80a273d96b611963fdc666cfc1085227e5d8f 100644
--- a/src/test/logging_tests.cpp
+++ b/src/test/logging_tests.cpp
@@ -37,11 +37,23 @@ static void ResetLogger() {
     LogInstance().SetCategoryLogLevel({});
 }
 
+static const std::string FLUSH_SENTINEL_LOG_MESSAGE{
+    "Sentinel log to reopen log file"};
+static void flush_debug_log() {
+    // Reopening the log file makes sure earlier lines reached the file
+    // (the sentinel itself is skipped by ReadDebugLogLines).
+    LogInstance().m_reopen_file = true;
+    LogPrintf("%s\n", FLUSH_SENTINEL_LOG_MESSAGE);
+}
+
+/** Lines of the debug log, without flush sentinels */
 static std::vector<std::string> ReadDebugLogLines() {
     std::vector<std::string> lines;
     std::ifstream ifs{LogInstance().m_file_path};
     for (std::string line; std::getline(ifs, line);) {
-        lines.push_back(std::move(line));
+        if (line.find(FLUSH_SENTINEL_LOG_MESSAGE) == std::string::npos) {
+            lines.push_back(std::move(line));
+        }
     }
     return lines;
 }
@@ -100,38 +112,6 @@ struct LogSetup : public BasicTestingSetup {
     }
 };
 
-static const std::string FLUSH_SENTINEL_LOG_MESSAGE{
-    "Sentinel log to reopen log file"};
-static void flush_debug_log() {
-    // This is a hacky way of ensuring the previous logs have been committed
-    // to disk. It is not elegant but it works for the purpose of these
-    // tests.
-    LogInstance().m_reopen_file = true;
-    LogPrintf("%s\n", FLUSH_SENTINEL_LOG_MESSAGE);
-}
-
-BOOST_AUTO_TEST_CASE(logging_timer) {
-    SetMockTime(1);
-    auto micro_timer =
-        BCLog::Timer<std::chrono::microseconds>("tests", "end_msg");
-    SetMockTime(2);
-    BOOST_CHECK_EQUAL(micro_timer.LogMsg("test micros"),
-                      "tests: test micros (1000000μs)");
-
-    SetMockTime(1);
-    auto ms_timer = BCLog::Timer<std::chrono::milliseconds>("tests", "end_msg");
-    SetMockTime(2);
-    BOOST_CHECK_EQUAL(ms_timer.LogMsg("test ms"), "tests: test ms (1000.00ms)");
-
-    SetMockTime(1);
-    auto sec_timer = BCLog::Timer<std::chrono::seconds>("tests", "end_msg");
-    SetMockTime(2);
-    BOOST_CHECK_EQUAL(sec_timer.LogMsg("test secs"),
-                      "tests: test secs (1.00s)");
-
-    SetMockTime(0);
-}
-
 BOOST_FIXTURE_TEST_CASE(logging_LogPrintf_, LogSetup) {
     LogInstance().m_log_sourcelocations = true;
 
@@ -572,4 +552,16 @@ BOOST_FIXTURE_TEST_CASE(logging_filesize_rate_limit, LogSetup) {
     }
 }
 
+BOOST_FIXTURE_TEST_CASE(logging_reopened_file_unbuffered, LogSetup) {
+    // The first line after a reopen (e.g. after SIGHUP for log rotation)
+    // must reach the file at once, like every line before it: the new file
+    // is unbuffered too. It used to sit in a stdio buffer until enough
+    // lines filled it.
+    LogInstance().m_reopen_file = true;
+    LogPrintf("first line after reopen\n");
+    const auto lines{ReadDebugLogLines()};
+    BOOST_REQUIRE(!lines.empty());
+    BOOST_CHECK_EQUAL(lines.back(), "first line after reopen");
+}
+
 BOOST_AUTO_TEST_SUITE_END()
