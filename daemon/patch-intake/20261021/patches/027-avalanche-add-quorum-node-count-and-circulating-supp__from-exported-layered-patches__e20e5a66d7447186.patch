From ebdd414a7f76fc7c7e102a7ab1ad4c09f0b31e6b Mon Sep 17 00:00:00 2001
From: Lotus Developer <dev@lotus.org>
Date: Thu, 16 Apr 2026 12:00:00 +0000
Subject: [PATCH] avalanche: add quorum node-count and circulating-supply
 activation gates

Enforce >= 8 quorum nodes and >= 10% circulating supply (or 1,000,000 XPI
dev floor) before activating staking rewards, treasury, or preconsensus
policies, freeze the speculative Merklix overlay upon finalizeMempoolBatch,
and add unit tests in processor_tests.cpp and preconsensus_batch_tests.cpp.
---
 .../test/preconsensus_batch_tests.cpp         |  22 +++-
 src/avalanche/test/processor_tests.cpp        | 111 ++++++++++++++++++
 2 files changed, 132 insertions(+), 1 deletion(-)

diff --git a/src/avalanche/test/preconsensus_batch_tests.cpp b/src/avalanche/test/preconsensus_batch_tests.cpp
index bf2b96d676..b1437e6306 100644
--- a/src/avalanche/test/preconsensus_batch_tests.cpp
+++ b/src/avalanche/test/preconsensus_batch_tests.cpp
@@ -316,9 +316,29 @@ BOOST_FIXTURE_TEST_CASE(
         peerBatch, /*locallyAccepted=*/false));
     BOOST_CHECK(m_node.avalanche->isMempoolBatchLocallyAccepted(peerBatchId));
 
-    // Finalize peerBatch
+    // Populate m_node.mempool with {tx1, tx2} anchored at chaintip so
+    // finalizeMempoolBatch freezes the matching speculative overlay into L_1.
+    {
+        TestMemPoolEntryHelper entry;
+        LOCK2(cs_main, m_node.mempool->cs);
+        m_node.mempool->clear();
+        m_node.mempool->ConnectBlockReset(
+            chaintip->GetBlockHash(), uint64_t(chaintip->nHeight + 1),
+            uint64_t(chaintip->GetMedianTimePast()));
+        m_node.mempool->addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(tx1));
+        m_node.mempool->addUnchecked(entry.Fee(1000 * SATOSHI).FromTx(tx2));
+        BOOST_CHECK(
+            m_node.mempool->GetOverlayManager().GetFrozenEpochs().empty());
+    }
+
+    // Finalize peerBatch -> freezes L_spec into L_1 and publishes RCU snapshot
     m_node.avalanche->finalizeMempoolBatch(peerBatchId);
     BOOST_CHECK(m_node.avalanche->isMempoolBatchFinalized(peerBatchId));
+    {
+        LOCK(m_node.mempool->cs);
+        BOOST_CHECK_EQUAL(
+            m_node.mempool->GetOverlayManager().GetFrozenEpochs().size(), 1U);
+    }
 
     // 2. PreConsensusPolicy enforcement against finalized MempoolBatchAnnouncement
     CMutableTransaction cbMtx;
diff --git a/src/avalanche/test/processor_tests.cpp b/src/avalanche/test/processor_tests.cpp
index f1560fb8a4..d711d70302 100644
--- a/src/avalanche/test/processor_tests.cpp
+++ b/src/avalanche/test/processor_tests.cpp
@@ -3124,4 +3124,115 @@ BOOST_AUTO_TEST_CASE(stake_contender_local_winners) {
     }
 }
 
+BOOST_AUTO_TEST_CASE(quorum_node_count_and_circulating_supply_gate) {
+    setArg("-persistavapeers", "0");
+    ChainstateManager &chainman = *Assert(m_node.chainman);
+    Chainstate &active_chainstate = chainman.ActiveChainstate();
+    const CBlockIndex *chaintip =
+        WITH_LOCK(chainman.GetMutex(), return chainman.ActiveTip());
+    const BlockHash tipHash = chaintip->GetBlockHash();
+
+    // 1. Validate parameter range checks for -avaminquorumnodes and
+    // -avaminquorumsupplypermille
+    {
+        setArg("-avaminquorumnodes", "-1");
+        bilingual_str error;
+        BOOST_CHECK(Processor::MakeProcessor(
+                        *m_node.args, *m_node.chain, m_node.connman.get(),
+                        chainman, m_node.mempool.get(), *m_node.scheduler,
+                        error) == nullptr);
+        BOOST_CHECK(!error.empty());
+        setArg("-avaminquorumnodes", "8");
+    }
+    {
+        setArg("-avaminquorumsupplypermille", "1001");
+        bilingual_str error;
+        BOOST_CHECK(Processor::MakeProcessor(
+                        *m_node.args, *m_node.chain, m_node.connman.get(),
+                        chainman, m_node.mempool.get(), *m_node.scheduler,
+                        error) == nullptr);
+        BOOST_CHECK(!error.empty());
+        setArg("-avaminquorumsupplypermille", "0");
+    }
+
+    // 2. Test -avaminquorumnodes=10 gate
+    {
+        setArg("-avaminquorumnodes", "10");
+        setArg("-avaminquorumsupplypermille", "0");
+        bilingual_str error;
+        auto processor = Processor::MakeProcessor(
+            *m_node.args, *m_node.chain, m_node.connman.get(), chainman,
+            m_node.mempool.get(), *m_node.scheduler, error);
+        BOOST_REQUIRE(processor != nullptr);
+
+        auto proof =
+            buildRandomProof(active_chainstate, MIN_VALID_PROOF_SCORE * 10);
+        processor->withPeerManager([&](avalanche::PeerManager &pm) {
+            BOOST_CHECK(pm.registerProof(proof));
+            for (NodeId n = 0; n < 9; n++) {
+                BOOST_CHECK(pm.addNode(n, proof->getId(),
+                                       DEFAULT_AVALANCHE_MAX_ELEMENT_POLL));
+            }
+        });
+        // 9 nodes < 10 required
+        BOOST_CHECK(!processor->isQuorumEstablished());
+
+        // Add 10th node -> quorum established
+        processor->withPeerManager([&](avalanche::PeerManager &pm) {
+            BOOST_CHECK(pm.addNode(9, proof->getId(),
+                                   DEFAULT_AVALANCHE_MAX_ELEMENT_POLL));
+        });
+        BOOST_CHECK(processor->isQuorumEstablished());
+
+        // Remove 10th node -> drops below minQuorumNodes again
+        processor->withPeerManager(
+            [&](avalanche::PeerManager &pm) { BOOST_CHECK(pm.removeNode(9)); });
+        BOOST_CHECK(!processor->isQuorumEstablished());
+    }
+
+    // 3. Test -avaminquorumsupplypermille gate (10 permille = 1.0% of supply)
+    {
+        setArg("-avaminquorumnodes", "8");
+        setArg("-avaminquorumsupplypermille", "10");
+        // Set circulating supply to 200 * PROOF_DUST_THRESHOLD -> 1% (10
+        // permille) is 2 * PROOF_DUST_THRESHOLD.
+        const uint64_t supplySatoshis =
+            200ULL * uint64_t(PROOF_DUST_THRESHOLD / SATOSHI);
+        SetV2BlockCirculatingSupplyForTest(tipHash, supplySatoshis);
+
+        bilingual_str error;
+        auto processor = Processor::MakeProcessor(
+            *m_node.args, *m_node.chain, m_node.connman.get(), chainman,
+            m_node.mempool.get(), *m_node.scheduler, error);
+        BOOST_REQUIRE(processor != nullptr);
+
+        // Register 1 proof with MIN_VALID_PROOF_SCORE (1 * PROOF_DUST_THRESHOLD
+        // < 1% of 200 * PROOF_DUST_THRESHOLD)
+        auto proof1 = buildRandomProof(active_chainstate, MIN_VALID_PROOF_SCORE);
+        processor->withPeerManager([&](avalanche::PeerManager &pm) {
+            BOOST_CHECK(pm.registerProof(proof1));
+            for (NodeId n = 0; n < 8; n++) {
+                BOOST_CHECK(pm.addNode(n, proof1->getId(),
+                                       DEFAULT_AVALANCHE_MAX_ELEMENT_POLL));
+            }
+        });
+        // Node count (8) is met, but staked supply < required (2 *
+        // PROOF_DUST_THRESHOLD)
+        BOOST_CHECK(!processor->isQuorumEstablished());
+
+        // Register a second proof with MIN_VALID_PROOF_SCORE (total 2 *
+        // PROOF_DUST_THRESHOLD >= 1% of 200 * PROOF_DUST_THRESHOLD)
+        auto proof2 = buildRandomProof(active_chainstate, MIN_VALID_PROOF_SCORE);
+        processor->withPeerManager([&](avalanche::PeerManager &pm) {
+            BOOST_CHECK(pm.registerProof(proof2));
+            BOOST_CHECK(pm.addNode(8, proof2->getId(),
+                                   DEFAULT_AVALANCHE_MAX_ELEMENT_POLL));
+        });
+        BOOST_CHECK(processor->isQuorumEstablished());
+
+        SetV2BlockCirculatingSupplyForTest(tipHash, 0);
+        setArg("-avaminquorumsupplypermille", "0");
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
