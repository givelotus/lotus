From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:51:05 -0700
Subject: [PATCH] coins: pre-reserve CCoinsViewCache hash buckets in
 ConnectBlock and BatchWrite

Original-Commit: 7b0e290666b31e82c274b83a6e8cd7e57783d718
Original-Patch: ecash/050
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/coins.cpp      | 1 +
 src/coins.h        | 3 +++
 src/validation.cpp | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/src/coins.cpp b/src/coins.cpp
index a6dcf65a68..8f0d727b04 100644
--- a/src/coins.cpp
+++ b/src/coins.cpp
@@ -256,6 +256,7 @@ void CCoinsViewCache::SetBestBlock(const BlockHash &hashBlockIn) {
 
 void CCoinsViewCache::BatchWrite(CoinsViewCacheCursor &cursor,
                                  const BlockHash &hashBlockIn) {
+    cacheCoins.reserve(cacheCoins.size() + (cursor.GetDirtyCount() + 1) / 2);
     for (auto it{cursor.Begin()}; it != cursor.End();
          it = cursor.NextAndMaybeErase(*it)) {
         if (!it->second.IsDirty()) {
diff --git a/src/coins.h b/src/coins.h
index f63513a6cf..92ace7b647 100644
--- a/src/coins.h
+++ b/src/coins.h
@@ -506,6 +506,9 @@ public:
     //! https://stackoverflow.com/questions/42114044/how-to-release-unordered-map-memory
     void ReallocateCache();
 
+    //! Pre-allocate hash table buckets to avoid rehashes during bulk operations.
+    void Reserve(size_t count) { cacheCoins.reserve(count); }
+
     //! Run an internal sanity check on the cache data structure.
     void SanityCheck() const;
 
diff --git a/src/validation.cpp b/src/validation.cpp
index 2d115f69fb..6505afee2b 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -3316,6 +3316,8 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         control.emplace(m_chainman.GetCheckQueue());
     }
 
+    view.Reserve(block.vtx.size() * 2 + 16);
+
     // Add all outputs
     try {
         for (const auto &ptx : block.vtx) {
