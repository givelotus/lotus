From 3367f1e61456c43abd43cc0bae211b0f35b1276a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 13:28:28 -0700
Subject: [PATCH] logging: structure chainstate invariant diagnostics without
 changing repairs

Keep disabled-chainstate returns and both transaction-count Assume checks,
resets and metadata updates unchanged. Preserve Info severity and exact
BUG-report messages. Store actual and expected cumulative counts as UINT,
height as INT, and the public report URL as a separate string.

Three exact reviewed AST mappings/range-format replay preserve all old
expressions and control flow; native registry-wide field tests cover the
added field kinds. This logging conversion does not deliberately trigger
invariant violations or claim metadata-repair behavior validation.
Tier: shared eCash, inherited by V2.

Scripted diff (ast-grep-py==0.51.0; from the commit's parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/chainstate-invariant-diagnostics.json --apply

git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/validation.cpp

Registry append is an explicit reviewed support adjustment, with existing
field IDs unchanged. No other handwritten production changes.
---
 .../chainstate-invariant-diagnostics.json     | 86 +++++++++++++++++++
 src/logging/fields.h                          |  4 +-
 src/validation.cpp                            | 34 +++++---
 3 files changed, 110 insertions(+), 14 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/chainstate-invariant-diagnostics.json

diff --git a/contrib/logging/conversion/rules/chainstate-invariant-diagnostics.json b/contrib/logging/conversion/rules/chainstate-invariant-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..45e2003676826e3eec21bfc49f9100cd1ae48ba1
--- /dev/null
+++ b/contrib/logging/conversion/rules/chainstate-invariant-diagnostics.json
@@ -0,0 +1,86 @@
+{
+  "schema": 1,
+  "batch": "chainstate-invariant-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "disabled_chainstate_advance_refused_0",
+          "old": "LogPrintf(\"m_disabled is set - this chainstate should not be in \"\n                  \"operation. Please report this as a bug. %s\\n\",\n                  PACKAGE_BUGREPORT)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"disabled_chainstate_advance_refused\", \"m_disabled is set - this chainstate should not be in operation. Please report this as a bug. {bug_report_url}\").Field(BCLog::LogField::BugReportURL, PACKAGE_BUGREPORT)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "m_disabled is set - this chainstate should not be in operation. Please report this as a bug. %s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "PACKAGE_BUGREPORT"
+            ]
+          },
+          "review_note": "Preserve Info and exact bug-report text, signed block height, actual/expected uint64 chain transaction counts and public report URL. Do not change Assume predicates, resets, metadata repair, locks, disabled-chainstate early return or consensus. No newly forced invariant violations."
+        },
+        {
+          "id": "block_chain_tx_count_unexpected_1",
+          "old": "LogPrintf(\"Internal bug detected: block %d has unexpected \"\n                  \"m_chain_tx_count %lu that should be %lu. Please report \"\n                  \"this issue here: %s\\n\",\n                  pindexNew->nHeight, pindexNew->m_chain_tx_count,\n                  prev_tx_sum(*pindexNew), PACKAGE_BUGREPORT)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_chain_tx_count_unexpected\", \"Internal bug detected: block {height} has unexpected m_chain_tx_count {chain_tx_count} that should be {expected_chain_tx_count}. Please report this issue here: {bug_report_url}\").Field(BCLog::LogField::Height, pindexNew->nHeight).Field(BCLog::LogField::ChainTxCount, pindexNew->m_chain_tx_count).Field(BCLog::LogField::ExpectedChainTxCount, prev_tx_sum(*pindexNew)).Field(BCLog::LogField::BugReportURL, PACKAGE_BUGREPORT)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Internal bug detected: block %d has unexpected m_chain_tx_count %lu that should be %lu. Please report this issue here: %s\n",
+            "specifiers": [
+              "%d",
+              "%lu",
+              "%lu",
+              "%s"
+            ],
+            "arguments": [
+              "pindexNew->nHeight",
+              "pindexNew->m_chain_tx_count",
+              "prev_tx_sum(*pindexNew)",
+              "PACKAGE_BUGREPORT"
+            ]
+          },
+          "review_note": "Preserve Info and exact bug-report text, signed block height, actual/expected uint64 chain transaction counts and public report URL. Do not change Assume predicates, resets, metadata repair, locks, disabled-chainstate early return or consensus. No newly forced invariant violations."
+        },
+        {
+          "id": "block_chain_tx_count_unexpected_2",
+          "old": "LogPrintf(\"Internal bug detected: block %d has unexpected \"\n                          \"m_chain_tx_count %lu that should be %lu. Please \"\n                          \"report this issue here: %s\\n\",\n                          pindex->nHeight, pindex->m_chain_tx_count,\n                          prev_tx_sum(*pindex), PACKAGE_BUGREPORT)",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"block_chain_tx_count_unexpected\", \"Internal bug detected: block {height} has unexpected m_chain_tx_count {chain_tx_count} that should be {expected_chain_tx_count}. Please report this issue here: {bug_report_url}\").Field(BCLog::LogField::Height, pindex->nHeight).Field(BCLog::LogField::ChainTxCount, pindex->m_chain_tx_count).Field(BCLog::LogField::ExpectedChainTxCount, prev_tx_sum(*pindex)).Field(BCLog::LogField::BugReportURL, PACKAGE_BUGREPORT)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Internal bug detected: block %d has unexpected m_chain_tx_count %lu that should be %lu. Please report this issue here: %s\n",
+            "specifiers": [
+              "%d",
+              "%lu",
+              "%lu",
+              "%s"
+            ],
+            "arguments": [
+              "pindex->nHeight",
+              "pindex->m_chain_tx_count",
+              "prev_tx_sum(*pindex)",
+              "PACKAGE_BUGREPORT"
+            ]
+          },
+          "review_note": "Preserve Info and exact bug-report text, signed block height, actual/expected uint64 chain transaction counts and public report URL. Do not change Assume predicates, resets, metadata repair, locks, disabled-chainstate early return or consensus. No newly forced invariant violations."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Expected cumulative transaction count is unsigned; report URL is public string metadata.",
+          "old": "    X(CoinsTipCacheBudgetMiB, coins_tip_cache_budget_mib, FLOAT, \"\", \"\")\n",
+          "new": "    X(CoinsTipCacheBudgetMiB, coins_tip_cache_budget_mib, FLOAT, \"\", \"\") \\\n    X(BugReportURL, bug_report_url, STRING, \"\", \"\") \\\n    X(ExpectedChainTxCount, expected_chain_tx_count, UINT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/logging/fields.h b/src/logging/fields.h
index 271da1f2bf986a43be149fb8814a74c87ad3261b..5e6143eb8ca98ac4f531d61541534f1a2b60ca84 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -159,7 +159,9 @@
     X(CacheCapacity, cache_capacity, UINT, "", "") \
     X(CacheSizeBytes, cache_size_bytes, INT, "", "") \
     X(CacheBudgetBytes, cache_budget_bytes, INT, "", "") \
-    X(CoinsTipCacheBudgetMiB, coins_tip_cache_budget_mib, FLOAT, "", "")
+    X(CoinsTipCacheBudgetMiB, coins_tip_cache_budget_mib, FLOAT, "", "") \
+    X(BugReportURL, bug_report_url, STRING, "", "") \
+    X(ExpectedChainTxCount, expected_chain_tx_count, UINT, "", "")
 
 namespace BCLog {
 
diff --git a/src/validation.cpp b/src/validation.cpp
index f3b5b08f756a1bc01f1fc7f17cb94c679391d393..28c885cbfbdbd92ad6f9fa96c3c1483aede91ffe 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -4984,9 +4984,10 @@ bool Chainstate::ActivateBestChain(BlockValidationState &state,
     // Belt-and-suspenders check that we aren't attempting to advance the
     // background chainstate past the snapshot base block.
     if (WITH_LOCK(::cs_main, return m_disabled)) {
-        LogPrintf("m_disabled is set - this chainstate should not be in "
-                  "operation. Please report this as a bug. %s\n",
-                  PACKAGE_BUGREPORT);
+        LogInfoEvent(
+            BCLog::ALL, "disabled_chainstate_advance_refused",
+            "m_disabled is set - this chainstate should not be in operation. Please report this as a bug. {bug_report_url}")
+            .Field(BCLog::LogField::BugReportURL, PACKAGE_BUGREPORT);
         return false;
     }
 
@@ -5702,11 +5703,14 @@ void ChainstateManager::ReceivedBlockTransactions(const CBlock &block,
     if (!Assume(pindexNew->m_chain_tx_count == 0 ||
                 pindexNew->m_chain_tx_count == prev_tx_sum(*pindexNew) ||
                 pindexNew == GetSnapshotBaseBlock())) {
-        LogPrintf("Internal bug detected: block %d has unexpected "
-                  "m_chain_tx_count %lu that should be %lu. Please report "
-                  "this issue here: %s\n",
-                  pindexNew->nHeight, pindexNew->m_chain_tx_count,
-                  prev_tx_sum(*pindexNew), PACKAGE_BUGREPORT);
+        LogInfoEvent(
+            BCLog::ALL, "block_chain_tx_count_unexpected",
+            "Internal bug detected: block {height} has unexpected m_chain_tx_count {chain_tx_count} that should be {expected_chain_tx_count}. Please report this issue here: {bug_report_url}")
+            .Field(BCLog::LogField::Height, pindexNew->nHeight)
+            .Field(BCLog::LogField::ChainTxCount, pindexNew->m_chain_tx_count)
+            .Field(BCLog::LogField::ExpectedChainTxCount,
+                   prev_tx_sum(*pindexNew))
+            .Field(BCLog::LogField::BugReportURL, PACKAGE_BUGREPORT);
         pindexNew->m_chain_tx_count = 0;
     }
     pindexNew->nSize = ::GetSerializeSize(block);
@@ -5735,11 +5739,15 @@ void ChainstateManager::ReceivedBlockTransactions(const CBlock &block,
             if (!Assume(pindex->m_chain_tx_count == 0 ||
                         pindex->m_chain_tx_count == prev_tx_sum(*pindex) ||
                         pindex == GetSnapshotBaseBlock())) {
-                LogPrintf("Internal bug detected: block %d has unexpected "
-                          "m_chain_tx_count %lu that should be %lu. Please "
-                          "report this issue here: %s\n",
-                          pindex->nHeight, pindex->m_chain_tx_count,
-                          prev_tx_sum(*pindex), PACKAGE_BUGREPORT);
+                LogInfoEvent(
+                    BCLog::ALL, "block_chain_tx_count_unexpected",
+                    "Internal bug detected: block {height} has unexpected m_chain_tx_count {chain_tx_count} that should be {expected_chain_tx_count}. Please report this issue here: {bug_report_url}")
+                    .Field(BCLog::LogField::Height, pindex->nHeight)
+                    .Field(BCLog::LogField::ChainTxCount,
+                           pindex->m_chain_tx_count)
+                    .Field(BCLog::LogField::ExpectedChainTxCount,
+                           prev_tx_sum(*pindex))
+                    .Field(BCLog::LogField::BugReportURL, PACKAGE_BUGREPORT);
             }
             pindex->m_chain_tx_count = prev_tx_sum(*pindex);
             if (pindex->nSequenceId == 0) {
