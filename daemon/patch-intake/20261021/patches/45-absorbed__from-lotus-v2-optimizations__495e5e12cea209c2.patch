From b363e6750d31b613c620c7511fd3f767bbc18f33 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] mempool: declare parallel arena batch insertion

Extract this concern so its mechanism can be reviewed and measured independently.
No source semantics are added or removed by this history operation.

Original patch rationale (describes the unsplit source, not every extracted part):
Parallelize Merklix UtxoOverlayArena batch updates across the 16 depth-4
shards and add asynchronous MDBX leaf readahead.

Original-Commit: fcd41ba00d4e8d94a5bf8a23541ce9f3330b9370
Original-Patch: ecash/025
Split-Concern: whole

Historical compilation prerequisites are tracked separately in daemon/patch-audit;
this provenance-preserving split does not imply standalone build validation.
---
 src/lotus_v2/mempool_overlay.h | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/lotus_v2/mempool_overlay.h b/src/lotus_v2/mempool_overlay.h
index cb9dd5eebfb8e7504b0fcbc6be42d9b572beb2f8..3e1a98e4c54637d78763c8d65e4fdb401a117b38 100644
--- a/src/lotus_v2/mempool_overlay.h
+++ b/src/lotus_v2/mempool_overlay.h
@@ -91,6 +91,17 @@ public:
                           const Hash &tx_hash);
     uint32_t EraseTxLeaf(uint32_t root_idx, const Hash &tx_id);
 
+    /**
+     * 16-shard parallel batch insertion into the contiguous TxOverlayArena.
+     * Partitions transactions by `tx_id[0] & 0x0F` (depth-4 routing prefix),
+     * builds per-shard arena subtrees in parallel, splices them into the
+     * contiguous `nodes_` vector, and zips depths 3 -> 2 -> 1 -> 0.
+     * Produces a SubtreeARoot 100% bit-identical to serial InsertTxLeaf.
+     */
+    uint32_t InsertBatchParallel(
+        uint32_t root_idx,
+        std::span<const std::pair<Hash, Hash>> txs);
+
     Hash SubtreeARoot(uint32_t root_idx) const;
     uint32_t Count(uint32_t root_idx) const noexcept;
     size_t ArenaNodeCount() const noexcept { return nodes_.size(); }
