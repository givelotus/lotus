+CConnman::IoRecvResult CConnman::IoRecvOnce(CNode &node) {
+    // typical socket buffer is 8K-64K
+    uint8_t pchBuf[0x10000];
+    int32_t nBytes = 0;
+    int nErr = 0;
+    {
+        LOCK(node.m_sock_mutex);
+        if (!node.m_sock) {
+            return IoRecvResult::CLOSED;
+        }
+        nBytes = node.m_sock->Recv(pchBuf, sizeof(pchBuf), MSG_DONTWAIT);
+        if (nBytes < 0) {
+            nErr = WSAGetLastError();
+        }
+    }
+    if (nBytes > 0) {
+        bool notify = false;
+        if (!node.ReceiveMsgBytes(*config, {pchBuf, (size_t)nBytes}, notify)) {
+            node.CloseSocketDisconnect();
+        }
+        RecordBytesRecv(nBytes);
+        if (notify) {
+            node.MarkReceivedMsgsForProcessing();
+            WakeMessageHandler();
+        }
+        return node.fDisconnect ? IoRecvResult::CLOSED : IoRecvResult::DATA;
+    }
+    if (nBytes == 0) {
+        // socket closed gracefully
+        if (!node.fDisconnect) {
+            LogDebug(BCLog::NET, "socket closed for peer=%d\n", node.GetId());
+        }
+        node.CloseSocketDisconnect();
+        return IoRecvResult::CLOSED;
+    }
+    // error
+    if (nErr != WSAEWOULDBLOCK && nErr != WSAEMSGSIZE && nErr != WSAEINTR &&
+        nErr != WSAEINPROGRESS) {
+        if (!node.fDisconnect) {
+            LogDebug(BCLog::NET, "socket recv error for peer=%d: %s\n",
+                     node.GetId(), NetworkErrorString(nErr));
+        }
+        node.CloseSocketDisconnect();
+        return IoRecvResult::CLOSED;
+    }
+    return IoRecvResult::WOULD_BLOCK;
+}
+
+bool CConnman::IoWantRecv(const CNode &node) const {
+    return !node.fPauseRecv && !node.m_io_recv_throttled && !node.fDisconnect;
+}
+
+bool CConnman::IoWantSend(CNode &node) {
+    if (WITH_LOCK(node.cs_vSend, return !node.vSendMsg.empty())) {
+        return true;
+    }
+    LOCK(node.m_sock_mutex);
+    return node.m_sock && (node.m_sock->PendingEvents() & Sock::SEND);
+}
+
+bool CConnman::IoFlushPending(CNode &node) {
+    bool ok{true};
+    {
+        LOCK(node.m_sock_mutex);
+        if (!node.m_sock) {
+            return false;
+        }
+        if (node.m_sock->PendingEvents()) {
+            ok = node.m_sock->FlushPending();
+        }
+    }
+    if (!ok) {
+        node.CloseSocketDisconnect();
+    }
+    return ok;
+}
+
+std::pair<size_t, bool> CConnman::IoSend(CNode &node) {
+    if (!IoFlushPending(node)) {
+        return {0, false};
+    }
+    auto [bytes_sent, data_left] =
+        WITH_LOCK(node.cs_vSend, return SocketSendData(node));
+    if (bytes_sent) {
+        RecordBytesSent(bytes_sent);
+    }
+    if (!data_left) {
+        LOCK(node.m_sock_mutex);
+        data_left = node.m_sock && (node.m_sock->PendingEvents() & Sock::SEND);
+    }
+    return {bytes_sent, data_left};
+}
+
+void CConnman::AttachNodeIo(CNode &node) {
+    if (!m_event_loop) {
+        return;
+    }
+    std::shared_ptr<Sock> sock{WITH_LOCK(node.m_sock_mutex, return node.m_sock)};
+    if (!sock) {
+        return;
+    }
+    node.m_io = NodeIo::Attach(*m_event_loop, *this, node, std::move(sock));
+    if (node.m_io) {
+        node.m_io->Start();
+    }
+}
