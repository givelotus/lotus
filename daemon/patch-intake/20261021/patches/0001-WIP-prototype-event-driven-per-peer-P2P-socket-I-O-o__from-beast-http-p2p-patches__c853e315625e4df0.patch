--- /dev/null
+++ b/src/net_eventio.h
@@ -0,0 +1,78 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_NET_EVENTIO_H
+#define BITCOIN_NET_EVENTIO_H
+
+#include <memory>
+
+class CConnman;
+class CNode;
+class Sock;
+
+/**
+ * PROTOTYPE: event-driven socket I/O for CConnman.
+ *
+ * A small pool of threads runs a Boost.Asio io_context. Each attached peer
+ * gets one strand and a readiness watch on its native socket descriptor.
+ * Readiness handlers run on the peer's strand, so all byte-level work for
+ * one peer (recv, TLS, WebSocket deframing, decompression, P2P message
+ * deserialization into vRecvMsg/m_msg_process_queue, flushing the send
+ * queue) is serialized per peer while different peers proceed in parallel.
+ *
+ * Message *processing* is untouched: it stays on ThreadMessageHandler,
+ * which is woken exactly as before. CConnman's socket thread keeps the
+ * listening sockets, peers whose Sock has no real descriptor (unit/fuzz
+ * test mocks), disconnection, inactivity checks and inflight throttling.
+ */
+class P2PEventLoop {
+public:
+    explicit P2PEventLoop(int threads);
+    ~P2PEventLoop();
+
+    P2PEventLoop(const P2PEventLoop &) = delete;
+    P2PEventLoop &operator=(const P2PEventLoop &) = delete;
+
+    void Start();
+    /** Stop running handlers and join the threads. No handler runs after
+     * this returns; pending ones are destroyed with the loop. */
+    void Stop();
+
+    struct Impl;
+    Impl &GetImpl() { return *m_impl; }
+
+private:
+    std::unique_ptr<Impl> m_impl;
+};
+
+/**
+ * Per-peer event-driven I/O state. Created by CConnman for peers whose
+ * socket has a native descriptor; owned by the CNode (m_io) and by pending
+ * handlers. Holds a reference on the CNode until Close() has deregistered
+ * the descriptor, so DisconnectNodes() cannot delete the CNode while a
+ * handler may still run.
+ */
+class NodeIo {
+public:
+    /** Returns nullptr if the descriptor cannot be watched (e.g. a mock). */
+    static std::shared_ptr<NodeIo> Attach(P2PEventLoop &loop,
+                                          CConnman &connman, CNode &node,
+                                          std::shared_ptr<Sock> sock);
+    virtual ~NodeIo() = default;
+
+    /** Thread-safe: (re)consider waiting for readability, e.g. after
+     * fPauseRecv was cleared or inflight throttling ended. */
+    virtual void RequestRead() = 0;
+    /** Thread-safe: the send queue or the socket's own pending data needs
+     * flushing when the socket becomes writable. */
+    virtual void RequestWrite() = 0;
+    /** Thread-safe, idempotent: stop watching the descriptor, drop the
+     * socket reference and the CNode reference (asynchronously, on the
+     * strand). Called from CNode::CloseSocketDisconnect(). */
+    virtual void Close() = 0;
+    /** Start the first read wait. */
+    virtual void Start() = 0;
+};
+
+#endif // BITCOIN_NET_EVENTIO_H
