+namespace {
+template <typename Pred> bool WaitFor(Pred pred) {
+    for (int i = 0; i < 5000; ++i) {
+        if (pred()) {
+            return true;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds{1});
+    }
+    return pred();
+}
+
+std::vector<uint8_t> SerializeForWire(const Config &config, CNode &node,
+                                      CSerializedNetMsg &&msg) {
+    std::vector<uint8_t> header;
+    node.m_serializer->prepareForTransport(config, msg, header);
+    header.insert(header.end(), msg.data.begin(), msg.data.end());
+    return header;
+}
+
+void WriteAll(int fd, const std::vector<uint8_t> &bytes) {
+    size_t off{0};
+    while (off < bytes.size()) {
+        const ssize_t n{::write(fd, bytes.data() + off, bytes.size() - off)};
+        BOOST_REQUIRE(n > 0);
+        off += n;
+    }
+}
+} // namespace
+
+// PROTOTYPE: a real descriptor serviced by the event loop, without the
+// socket thread: receive, flood-protection pause/resume, send, close.
+BOOST_AUTO_TEST_CASE(eventio_socketpair) {
+    int sv[2];
+    BOOST_REQUIRE_EQUAL(socketpair(AF_UNIX, SOCK_STREAM, 0, sv), 0);
+    const Config &config{m_node.chainman->GetConfig()};
+    ConnmanTestMsg connman{config, 0x1337, 0x1337, *m_node.addrman};
+    connman.StartEventLoopForTest(2);
+    auto sock{std::make_shared<Sock>(SOCKET(sv[0]))};
+    BOOST_REQUIRE(sock->SetNonBlocking());
+    CNode *node = new CNode{/*id=*/0,
+                            sock,
+                            CAddress{},
+                            /*nKeyedNetGroupIn=*/0,
+                            /*nLocalHostNonceIn=*/0,
+                            /*nLocalExtraEntropyIn=*/0,
+                            CAddress{},
+                            /*addrNameIn=*/"",
+                            ConnectionType::INBOUND,
+                            /*inbound_onion=*/false,
+                            CNodeOptions{.recv_flood_size = 1}};
+    sock.reset();
+    connman.AttachNodeIoForTest(*node);
+    BOOST_REQUIRE(node->m_io);
+    BOOST_CHECK_EQUAL(node->GetRefCount(), 1);
+
+    // Two pings: with a 1-byte flood limit the first pauses receiving, so
+    // the second stays in the kernel until the first is polled.
+    auto ping1{SerializeForWire(config, *node,
+                                NetMsg::Make(NetMsgType::PING, uint64_t{1}))};
+    auto ping2{SerializeForWire(config, *node,
+                                NetMsg::Make(NetMsgType::PING, uint64_t{2}))};
+    WriteAll(sv[1], ping1);
+    BOOST_REQUIRE(WaitFor([&] { return node->fPauseRecv.load(); }));
+    WriteAll(sv[1], ping2);
+    std::this_thread::sleep_for(std::chrono::milliseconds{50});
+    auto msg{node->PollMessage()};
+    BOOST_REQUIRE(msg);
+    BOOST_CHECK_EQUAL(msg->first.m_type, NetMsgType::PING);
+    // Nothing else had been read while paused.
+    BOOST_CHECK(!msg->second);
+    // Polling unpaused the peer: the event loop resumes reading.
+    std::optional<std::pair<CNetMessage, bool>> msg2;
+    BOOST_REQUIRE(WaitFor([&] {
+        msg2 = node->PollMessage();
+        return msg2.has_value();
+    }));
+    BOOST_CHECK_EQUAL(msg2->first.m_type, NetMsgType::PING);
+
+    // Sending: PushMessage writes optimistically; a large message that
+    // does not fit the socket buffer is finished by the event loop.
+    std::vector<uint8_t> big(4 * 1024 * 1024, 0x42);
+    CSerializedNetMsg big_msg;
+    big_msg.m_type = "big";
+    big_msg.data = big;
+    connman.PushMessage(node, std::move(big_msg));
+    size_t received{0};
+    const size_t expected{big.size() + CMessageHeader::HEADER_SIZE};
+    std::vector<uint8_t> buf(1 << 16);
+    BOOST_REQUIRE(WaitFor([&] {
+        ssize_t n;
+        while ((n = ::recv(sv[1], buf.data(), buf.size(), MSG_DONTWAIT)) >
+               0) {
+            received += n;
+        }
+        return received == expected;
+    }));
+    BOOST_CHECK(WITH_LOCK(node->cs_vSend, return node->vSendMsg.empty()));
+
+    // Disconnect: the descriptor is deregistered and the event loop's node
+    // reference dropped; the peer then sees EOF.
+    node->CloseSocketDisconnect();
+    BOOST_REQUIRE(WaitFor([&] { return node->GetRefCount() == 0; }));
+    BOOST_REQUIRE(WaitFor([&] {
+        return ::recv(sv[1], buf.data(), buf.size(), MSG_DONTWAIT) == 0;
+    }));
+
+    connman.StopEventLoopForTest();
+    delete node;
+    connman.DestroyEventLoopForTest();
+    close(sv[1]);
+}
+
+// PROTOTYPE: a peer that only closes is noticed without the socket thread.
+BOOST_AUTO_TEST_CASE(eventio_peer_eof) {
+    int sv[2];
+    BOOST_REQUIRE_EQUAL(socketpair(AF_UNIX, SOCK_STREAM, 0, sv), 0);
+    const Config &config{m_node.chainman->GetConfig()};
+    ConnmanTestMsg connman{config, 0x1337, 0x1337, *m_node.addrman};
+    connman.StartEventLoopForTest(1);
+    auto sock{std::make_shared<Sock>(SOCKET(sv[0]))};
+    BOOST_REQUIRE(sock->SetNonBlocking());
+    CNode *node = new CNode{/*id=*/0,
+                            std::move(sock),
+                            CAddress{},
+                            /*nKeyedNetGroupIn=*/0,
+                            /*nLocalHostNonceIn=*/0,
+                            /*nLocalExtraEntropyIn=*/0,
+                            CAddress{},
+                            /*addrNameIn=*/"",
+                            ConnectionType::INBOUND,
+                            /*inbound_onion=*/false};
+    connman.AttachNodeIoForTest(*node);
+    BOOST_REQUIRE(node->m_io);
+    close(sv[1]);
+    BOOST_REQUIRE(WaitFor([&] { return node->fDisconnect.load(); }));
+    BOOST_REQUIRE(WaitFor([&] { return node->GetRefCount() == 0; }));
+    connman.StopEventLoopForTest();
+    delete node;
+    connman.DestroyEventLoopForTest();
+}
+
+// PROTOTYPE: shutting down with the node still attached (as StopNodes()
+// does after StopThreads()) deregisters cleanly.
+BOOST_AUTO_TEST_CASE(eventio_shutdown_attached) {
+    int sv[2];
+    BOOST_REQUIRE_EQUAL(socketpair(AF_UNIX, SOCK_STREAM, 0, sv), 0);
+    const Config &config{m_node.chainman->GetConfig()};
+    ConnmanTestMsg connman{config, 0x1337, 0x1337, *m_node.addrman};
+    connman.StartEventLoopForTest(2);
+    CNode *node = new CNode{/*id=*/0,
+                            std::make_shared<Sock>(SOCKET(sv[0])),
+                            CAddress{},
+                            /*nKeyedNetGroupIn=*/0,
+                            /*nLocalHostNonceIn=*/0,
+                            /*nLocalExtraEntropyIn=*/0,
+                            CAddress{},
+                            /*addrNameIn=*/"",
+                            ConnectionType::INBOUND,
+                            /*inbound_onion=*/false};
+    connman.AttachNodeIoForTest(*node);
+    BOOST_REQUIRE(node->m_io);
+    connman.StopEventLoopForTest();
+    node->CloseSocketDisconnect();
+    delete node;
+    connman.DestroyEventLoopForTest();
+    char c;
+    BOOST_CHECK_EQUAL(::recv(sv[1], &c, 1, 0), 0);
+    close(sv[1]);
+}
