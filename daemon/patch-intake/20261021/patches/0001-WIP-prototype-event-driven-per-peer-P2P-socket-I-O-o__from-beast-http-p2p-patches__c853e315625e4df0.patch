+namespace asio = boost::asio;
+
+class NodeIoImpl;
+
+struct P2PEventLoop::Impl {
+    explicit Impl(int threads) : m_threads{std::max(1, threads)} {}
+
+    const int m_threads;
+    asio::io_context m_io;
+    std::optional<asio::executor_work_guard<asio::io_context::executor_type>>
+        m_work;
+    std::vector<std::thread> m_thread_handles;
+
+    Mutex m_registry_mutex;
+    //! Every NodeIo created on this loop, to deregister descriptors before
+    //! the io_context is destroyed.
+    std::vector<std::weak_ptr<NodeIoImpl>>
+        m_registry GUARDED_BY(m_registry_mutex);
+};
+
+#ifdef P2P_EVENTIO_SUPPORTED
+
+/**
+ * Readiness is edge-like on both kqueue (EV_CLEAR) and epoll (EPOLLET) in
+ * Asio's reactors: a wait only completes on a new readiness transition. So
+ * the rule throughout is "try first, wait only after EAGAIN": whenever a
+ * peer becomes eligible for reading or writing again, attempt the
+ * operation; only arm async_wait once the operation would block.
+ */
+class NodeIoImpl final : public NodeIo,
+                         public std::enable_shared_from_this<NodeIoImpl> {
+public:
+    NodeIoImpl(asio::io_context &io, CConnman &connman, CNode &node,
+               std::shared_ptr<Sock> sock)
+        : m_connman{connman}, m_node{node}, m_strand{asio::make_strand(io)},
+          m_desc{io}, m_sock{std::move(sock)} {}
+
+    ~NodeIoImpl() override { Deregister(); }
+
+    bool Assign() {
+        boost::system::error_code ec;
+        m_desc.assign(m_sock->NativeHandle(), ec);
+        return !ec;
+    }
+
+    void Start() override {
+        asio::post(m_strand, [self = shared_from_this()] {
+            self->TryRead();
+            self->TryWrite();
+        });
+    }
+
+    void RequestRead() override {
+        if (m_read_requested.exchange(true)) {
+            return;
+        }
+        asio::post(m_strand, [self = shared_from_this()] {
+            self->m_read_requested = false;
+            self->TryRead();
+        });
+    }
+
+    void RequestWrite() override {
+        if (m_write_requested.exchange(true)) {
+            return;
+        }
+        asio::post(m_strand, [self = shared_from_this()] {
+            self->m_write_requested = false;
+            self->TryWrite();
+        });
+    }
+
+    void Close() override {
+        if (m_close_requested.exchange(true)) {
+            return;
+        }
+        // Always deferred (never inline), so a handler that triggered the
+        // close finishes before the CNode reference is dropped.
+        asio::post(m_strand, [self = shared_from_this()] { self->DoClose(); });
+    }
+
+    //! Only once no handler can run (loop stopped) or on the strand.
+    void Deregister() {
+        if (m_desc.is_open()) {
+            boost::system::error_code ec;
+            m_desc.cancel(ec);
+            (void)m_desc.release();
+        }
+        m_sock.reset();
+    }
+
+private:
+    // All members below are only touched on m_strand (or after the loop
+    // stopped), except the atomics.
+    void DoClose() {
+        if (m_closed) {
+            return;
+        }
+        m_closed = true;
+        // Deregister before the descriptor can be closed (we hold the last
+        // or one of the last Sock references), so a reused descriptor
+        // number is never confused with this one.
+        Deregister();
+        m_node.Release();
+    }
+
+    /** Read until EAGAIN (or a budget / pause), then wait for readability */
+    void TryRead() {
+        if (m_closed || m_read_waiting || m_read_scheduled) {
+            return;
+        }
+        const bool want_read{m_connman.IoWantRecv(m_node)};
+        // Socket-internal pending output waiting for RECV (TLS) must make
+        // progress even while paused.
+        const bool flush_on_recv{(m_sock->PendingEvents() & Sock::RECV) != 0};
+        if (!want_read && !flush_on_recv) {
+            return;
+        }
+        if (flush_on_recv && !m_connman.IoFlushPending(m_node)) {
+            return;
+        }
+        if (want_read) {
+            // Bounded batch per handler run so that peers sharing threads
+            // are serviced fairly.
+            for (int i = 0; i < 16; ++i) {
+                const auto res{m_connman.IoRecvOnce(m_node)};
+                if (res == CConnman::IoRecvResult::CLOSED) {
+                    return;
+                }
+                if (res == CConnman::IoRecvResult::WOULD_BLOCK) {
+                    ArmReadWait();
+                    TryWrite();
+                    return;
+                }
+                if (!m_connman.IoWantRecv(m_node)) {
+                    // Paused (flood protection) or throttled: the bytes stay
+                    // in the kernel; RequestRead() resumes with a read.
+                    TryWrite();
+                    return;
+                }
+            }
+            // Budget exhausted with data possibly left: continue later.
+            m_read_scheduled = true;
+            asio::post(m_strand, [self = shared_from_this()] {
+                self->m_read_scheduled = false;
+                self->TryRead();
+            });
+            TryWrite();
+            return;
+        }
+        ArmReadWait();
+    }
+
+    void ArmReadWait() {
+        if (m_closed || m_read_waiting) {
+            return;
+        }
+        m_read_waiting = true;
+        m_desc.async_wait(
+            asio::posix::stream_descriptor::wait_read,
+            asio::bind_executor(m_strand,
+                                [self = shared_from_this()](
+                                    const boost::system::error_code &ec) {
+                                    self->m_read_waiting = false;
+                                    if (ec == asio::error::operation_aborted ||
+                                        self->m_closed) {
+                                        return;
+                                    }
+                                    // On other errors let recv() report it.
+                                    self->TryRead();
+                                }));
+    }
+
+    void TryWrite() {
+        if (m_closed || m_write_waiting) {
+            return;
+        }
+        if (!m_connman.IoWantSend(m_node)) {
+            return;
+        }
+        const auto [bytes_sent, data_left] = m_connman.IoSend(m_node);
+        if (m_closed) {
+            return;
+        }
+        // Unlike the poll loop, reading is not skipped after a partial send:
+        // there it only deferred the read by one iteration (the socket is
+        // then not writable), and holding it off until the queue drains
+        // deadlocks two peers sending each other large messages
+        // (p2p_net_deadlock.py). A slow reader is still throttled: with
+        // fPauseSend set its messages are not processed, so its receive
+        // queue fills and fPauseRecv stops reading.
+        (void)bytes_sent;
+        if (data_left) {
+            m_write_waiting = true;
+            m_desc.async_wait(
+                asio::posix::stream_descriptor::wait_write,
+                asio::bind_executor(m_strand,
+                                    [self = shared_from_this()](
+                                        const boost::system::error_code &ec) {
+                                        self->m_write_waiting = false;
+                                        if (ec ==
+                                                asio::error::operation_aborted ||
+                                            self->m_closed) {
+                                            return;
+                                        }
+                                        self->TryWrite();
+                                    }));
+        }
+    }
+
+    CConnman &m_connman;
+    CNode &m_node;
+    asio::strand<asio::io_context::executor_type> m_strand;
+    asio::posix::stream_descriptor m_desc;
+    //! Keeps the descriptor open until it is deregistered.
+    std::shared_ptr<Sock> m_sock;
+
+    bool m_closed{false};
+    bool m_read_waiting{false};
+    bool m_read_scheduled{false};
+    bool m_write_waiting{false};
+
+    std::atomic<bool> m_read_requested{false};
+    std::atomic<bool> m_write_requested{false};
+    std::atomic<bool> m_close_requested{false};
+};
+
+std::shared_ptr<NodeIo> NodeIo::Attach(P2PEventLoop &loop, CConnman &connman,
+                                       CNode &node,
+                                       std::shared_ptr<Sock> sock) {
+    if (!sock || sock->NativeHandle() == INVALID_SOCKET) {
+        return nullptr;
+    }
+    auto &impl{loop.GetImpl()};
+    auto io{
+        std::make_shared<NodeIoImpl>(impl.m_io, connman, node, std::move(sock))};
+    if (!io->Assign()) {
+        LogDebug(BCLog::NET,
+                 "event I/O unavailable for peer=%d, using the poll loop\n",
+                 node.GetId());
+        return nullptr;
+    }
+    // Released by DoClose() once the descriptor is deregistered.
+    node.AddRef();
+    {
+        LOCK(impl.m_registry_mutex);
+        // Drop expired entries now and then.
+        if (impl.m_registry.size() > 64) {
+            std::erase_if(impl.m_registry,
+                          [](const auto &w) { return w.expired(); });
+        }
+        impl.m_registry.push_back(io);
+    }
+    return io;
+}
+
+#else // P2P_EVENTIO_SUPPORTED
+
+std::shared_ptr<NodeIo> NodeIo::Attach(P2PEventLoop &, CConnman &, CNode &,
+                                       std::shared_ptr<Sock>) {
+    return nullptr;
+}
+
+#endif // P2P_EVENTIO_SUPPORTED
+
+P2PEventLoop::P2PEventLoop(int threads)
+    : m_impl{std::make_unique<Impl>(threads)} {}
+
+P2PEventLoop::~P2PEventLoop() {
+    Stop();
+#ifdef P2P_EVENTIO_SUPPORTED
+    // No handler runs any more. Deregister every descriptor while the
+    // reactor is still alive, before pending handlers (holding NodeIo
+    // references) are destroyed with the io_context.
+    std::vector<std::weak_ptr<NodeIoImpl>> registry;
+    WITH_LOCK(m_impl->m_registry_mutex, registry.swap(m_impl->m_registry));
+    for (const auto &weak : registry) {
+        if (auto io{weak.lock()}) {
+            io->Deregister();
+        }
+    }
+#endif
+}
+
+void P2PEventLoop::Start() {
+    auto &impl{*m_impl};
+    impl.m_io.restart();
+    impl.m_work.emplace(impl.m_io.get_executor());
+    for (int i = 0; i < impl.m_threads; ++i) {
+        impl.m_thread_handles.emplace_back(
+            &util::TraceThread, strprintf("p2pio.%d", i), [&impl] {
+                impl.m_io.run();
+            });
+    }
+}
+
+void P2PEventLoop::Stop() {
+    auto &impl{*m_impl};
+    impl.m_work.reset();
+    impl.m_io.stop();
+    for (auto &t : impl.m_thread_handles) {
+        if (t.joinable()) {
+            t.join();
+        }
+    }
+    impl.m_thread_handles.clear();
+}
