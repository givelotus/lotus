+        for (const StreamClass cls : ALL_STREAM_CLASSES) {
+            std::string msg{strprintf("probe-%s", StreamClassName(cls))};
+            m_expected[StreamClassIndex(cls)] = std::string(
+                1, static_cast<char>(cls)) + msg;
+            session.QueueClassData(cls,
