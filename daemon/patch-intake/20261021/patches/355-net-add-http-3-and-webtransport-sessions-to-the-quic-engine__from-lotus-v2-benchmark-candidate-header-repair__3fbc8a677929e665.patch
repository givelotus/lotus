+int H3Session::OnLibraryWritten(QuicConnection &, int64_t stream_id,
+                                size_t datalen) {
+    return m_h3 && nghttp3_conn_add_write_offset(m_h3, stream_id, datalen) != 0
+               ? NGTCP2_ERR_CALLBACK_FAILURE
+               : 0;
+}
