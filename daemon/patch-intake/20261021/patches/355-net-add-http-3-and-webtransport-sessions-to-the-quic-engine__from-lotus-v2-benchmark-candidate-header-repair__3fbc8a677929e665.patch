+void H3Session::OnStreamReset(QuicConnection &conn, int64_t stream_id,
+                              uint64_t) {
+    QuicStream *s{conn.FindStream(stream_id)};
+    if (m_h3 && s && s->kind == QuicStream::Kind::LIBRARY) {
+        nghttp3_conn_shutdown_stream_read(m_h3, stream_id);
+    }
+}
