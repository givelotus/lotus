index 0000000000000000000000000000000000000000..59e99a0d180e63d482ec8c32caa6d59682a26ab4
--- /dev/null
+++ b/src/net_quic/webtransport_h3.h
@@ -0,0 +1,227 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_NET_QUIC_WEBTRANSPORT_H3_H
+#define BITCOIN_NET_QUIC_WEBTRANSPORT_H3_H
+
+// Internal to the QUIC engine: HTTP/3 (nghttp3) and the WebTransport
+// session on top of one QUIC connection. Engine thread only.
+
+#include <net_quic/quic_connection.h>
+#include <net_webtransport.h>
+
+#include <nghttp3/nghttp3.h>
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+class H3Session;
+
+/** The extended CONNECT as the server saw it */
+struct WtRequest {
+    std::string method;
+    std::string protocol;
+    std::string scheme;
+    std::string authority;
+    std::string path;
+    std::string origin;
+    std::string available_protocols;
+    bool draft02_header{false};
+    std::string status;
+    std::string wt_protocol;
+};
+
+/**
+ * Receives what happens to the WebTransport session of one connection (the
+ * P2P bridge, or tests). Engine thread.
+ */
+class WtSessionHandler {
+public:
+    virtual ~WtSessionHandler() = default;
+    //! Server: the request passed the path/token/origin checks; return the
+    //! status to answer (200 accepts, 503 when nobody takes sessions)
+    virtual int OnConnect(H3Session &session, const WtRequest &request) {
+        return 200;
+    }
+    //! The CONNECT was answered (client: the status received)
+    virtual void OnConnectResponse(H3Session &session, int status) {}
+    //! All five class streams exist (server: seen; client: opened)
+    virtual void OnSessionReady(H3Session &session) = 0;
+    //! Bytes on a class stream. The handler extends the stream's flow
+    //! control credit (H3Session::ExtendCredit) as it consumes them.
+    virtual void OnClassData(H3Session &session, StreamClass cls,
+                             const uint8_t *data, size_t len, bool fin) = 0;
+    //! The session ended (close capsule, CONNECT stream end, connection
+    //! end); called once
+    virtual void OnSessionClosed(H3Session &session, uint32_t code,
+                                 const std::string &reason) = 0;
+    //! Before each write pass
+    virtual void BeforeWrite(H3Session &session) {}
+};
+
+struct H3Options {
+    bool server{false};
+    //! Server: the accepted request path. Client: the request path.
+    std::string path{P2P_WEBTRANSPORT_PATH};
+    //! Server: accepted Origin values (empty: any)
+    std::vector<std::string> origins;
+    //! Server: required access token (?t=); client: token to send
+    std::string token;
+    //! Client: :authority, Origin (empty: none, as a node) and :protocol
+    std::string authority;
+    std::string origin;
+    std::string protocol_token{"webtransport-h3"};
+    //! Client: wt-available-protocols to offer (empty: no header)
+    std::vector<std::string> offer{P2P_WT_PROTOCOL_V1};
+    //! Server: application protocols supported, in preference order
+    std::vector<std::string> supported{P2P_WT_PROTOCOL_V1};
+    //! Server (tests, browser interop): echo WebTransport streams and
+    //! datagrams instead of running the P2P class-stream protocol
+    bool echo{false};
+    //! Client: how long to wait for the server's SETTINGS
+    uint64_t settings_timeout_ns{500 * NGTCP2_MILLISECONDS};
+};
+
+/** HTTP/3 + WebTransport on one QUIC connection */
+class H3Session final : public QuicApp {
+public:
+    H3Session(const H3Options &options,
+              std::unique_ptr<WtSessionHandler> handler);
+    ~H3Session() override;
+
+    // QuicApp
+    int OnHandshakeCompleted(QuicConnection &conn) override;
+    int OnStreamData(QuicConnection &conn, QuicStream &stream, uint32_t flags,
+                     const uint8_t *data, size_t len) override;
+    void OnStreamClose(QuicConnection &conn, int64_t stream_id,
+                       bool app_error_set, uint64_t app_error) override;
+    void OnStreamReset(QuicConnection &conn, int64_t stream_id,
+                       uint64_t app_error) override;
+    void OnStreamStopSending(QuicConnection &conn, int64_t stream_id,
+                             uint64_t app_error) override;
+    int OnLibraryAcked(QuicConnection &conn, int64_t stream_id,
+                       uint64_t datalen) override;
+    void OnLibraryUnblocked(QuicConnection &conn, int64_t stream_id) override;
+    void OnMaxRemoteStreamsBidi(QuicConnection &conn, uint64_t max) override;
+    void OnDatagram(QuicConnection &conn, const uint8_t *data,
+                    size_t len) override;
+    ngtcp2_ssize WritevLibrary(QuicConnection &conn, int64_t &stream_id,
+                               int &fin, ngtcp2_vec *vec,
+                               size_t veccnt) override;
+    int OnLibraryWritten(QuicConnection &conn, int64_t stream_id,
+                         size_t datalen) override;
+    void OnLibraryBlocked(QuicConnection &conn, int64_t stream_id) override;
+    void OnLibraryShutWr(QuicConnection &conn, int64_t stream_id) override;
+    void BeforeWrite(QuicConnection &conn) override;
+    uint64_t NextTimer() const override;
+    void OnTimer(QuicConnection &conn, uint64_t now) override;
+    void OnClosed(QuicConnection &conn) override;
+
+    QuicConnection *Conn() { return m_conn; }
+    WtSessionHandler *Handler() { return m_handler.get(); }
+    const H3Options &Options() const { return m_opts; }
+
+    /** Queue bytes on a class stream (after OnSessionReady) */
+    void QueueClassData(StreamClass cls, std::vector<uint8_t> &&data);
+    /** Unsent bytes on a class stream */
+    uint64_t ClassUnsent(StreamClass cls) const;
+    /** Allow the peer `n` more bytes on a class stream */
+    void ExtendCredit(StreamClass cls, uint64_t n);
+    /** End the session: WT_CLOSE_SESSION + FIN, then the connection */
+    void CloseSession(uint32_t code, const std::string &reason);
+
+    bool Ready() const { return m_ready; }
+    bool Closed() const { return m_session_closed; }
+    //! The CONNECT stream (session id), -1 before the request
+    int64_t SessionId() const { return m_session_id; }
+    //! Rank of the newest WebTransport draft the peer announced (see
+    //! wt::DraftRank) and its SETTINGS identifier
+    int PeerDraftRank() const { return m_peer_draft_rank; }
+    uint64_t PeerDraftSetting() const { return m_peer_draft_setting; }
+    //! The negotiated wt-protocol ("" if none)
+    const std::string &Protocol() const { return m_protocol; }
+    const WtRequest &Request() const { return m_request; }
+    //! Datagrams received and dropped (no P2P use)
+    uint64_t DatagramsDropped() const { return m_datagrams_dropped; }
+    //! Tests: a second CONNECT on the same connection; its status is given
+    //! to the handler's OnConnectResponse
+    void SubmitExtraConnectForTest();
+
+    // nghttp3 callbacks (static trampolines in the .cpp)
+    int OnBeginHeaders(int64_t stream_id);
+    int OnHeader(int64_t stream_id, std::string_view name,
+                 std::string_view value);
+    int OnEndHeaders(int64_t stream_id, int fin);
+    int OnRecvData(int64_t stream_id, const uint8_t *data, size_t len);
+    int OnEndStream(int64_t stream_id);
+    void OnPeerSettings(const nghttp3_proto_settings &settings);
+    void OnExtraSetting(uint64_t id, uint64_t value);
+    nghttp3_ssize ReadConnectBody(int64_t stream_id, nghttp3_vec *vec,
+                                  size_t veccnt, uint32_t *flags);
+    int OnConnectBodyAcked(int64_t stream_id, uint64_t datalen);
+
+private:
+    bool InitH3(QuicConnection &conn);
+    int FeedH3(QuicConnection &conn, int64_t stream_id, const uint8_t *data,
+               size_t len, bool fin);
+    int HandleWtStream(QuicConnection &conn, QuicStream &stream, bool fin);
+    void HandleClassBytes(QuicConnection &conn, QuicStream &stream,
+                          const uint8_t *data, size_t len, bool fin);
+    void ServerHandleRequest(int64_t stream_id, bool fin);
+    void ClientHandleResponse(int64_t stream_id);
+    void SubmitConnect();
+    void Respond(int64_t stream_id, int status,
+                 const std::vector<std::pair<std::string, std::string>>
+                     &extra = {});
+    void OpenClassStreams();
+    void ParseCapsules();
+    void SessionEnded(uint32_t code, const std::string &reason);
+    void QueueConnectBody(std::vector<uint8_t> &&data, bool fin);
+    void RejectStream(int64_t stream_id);
+
+    const H3Options m_opts;
+    std::unique_ptr<WtSessionHandler> m_handler;
+    QuicConnection *m_conn{nullptr};
+    nghttp3_conn *m_h3{nullptr};
+
+    std::map<int64_t, WtRequest> m_requests;
+    WtRequest m_request;
+    bool m_peer_settings{false};
+    bool m_peer_connect_protocol{false};
+    int m_peer_draft_rank{0};
+    uint64_t m_peer_draft_setting{0};
+    uint64_t m_settings_deadline{UINT64_MAX};
+
+    int64_t m_session_id{-1};
+    bool m_connect_sent{false};
+    bool m_accepted{false};
+    bool m_ready{false};
+    bool m_session_closed{false};
+    std::string m_protocol;
+    std::array<int64_t, NUM_STREAM_CLASSES> m_class_streams;
+    //! Echo mode: our unidirectional stream for uni echoes
+    int64_t m_echo_uni{-1};
+
+    //! Capsule bytes received on the CONNECT stream, not yet parsed
+    std::vector<uint8_t> m_capsule_rx;
+    //! CONNECT stream body we send (capsules); kept until acknowledged
+    struct BodyChunk {
+        std::vector<uint8_t> data;
+        bool given{false};
+    };
+    std::deque<BodyChunk> m_connect_tx;
+    bool m_connect_fin{false};
+    bool m_connect_fin_given{false};
+    //! After our close capsule: close the connection by then
+    uint64_t m_close_deadline{UINT64_MAX};
+    uint64_t m_datagrams_dropped{0};
+};
+
+#endif // BITCOIN_NET_QUIC_WEBTRANSPORT_H3_H
diff --git a/src/net_quic/webtransport_wire.cpp b/src/net_quic/webtransport_wire.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0b1b36b6ce3c9861c857fbd9b571430d2d30e27f
--- /dev/null
+++ b/src/net_quic/webtransport_wire.cpp
@@ -0,0 +1,248 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <net_quic/webtransport_wire.h>
+
+#include <algorithm>
+
+namespace wt {
+
+size_t VarintSize(uint64_t v) {
+    if (v < 64) {
+        return 1;
+    }
+    if (v < 16384) {
+        return 2;
+    }
+    if (v < (uint64_t{1} << 30)) {
+        return 4;
+    }
+    return 8;
+}
+
+void PutVarint(std::vector<uint8_t> &out, uint64_t v) {
+    const size_t n{VarintSize(v)};
+    const uint8_t prefix{static_cast<uint8_t>(n == 1   ? 0x00
+                                              : n == 2 ? 0x40
+                                              : n == 4 ? 0x80
+                                                       : 0xc0)};
+    for (size_t i = 0; i < n; ++i) {
+        uint8_t b{static_cast<uint8_t>(v >> (8 * (n - 1 - i)))};
+        if (i == 0) {
+            b = (b & 0x3f) | prefix;
+        }
+        out.push_back(b);
+    }
+}
+
+size_t GetVarint(Span<const uint8_t> in, uint64_t &value) {
+    if (in.empty()) {
+        return 0;
+    }
+    const size_t n{size_t{1} << (in[0] >> 6)};
+    if (in.size() < n) {
+        return 0;
+    }
+    uint64_t v{in[0] & 0x3fu};
+    for (size_t i = 1; i < n; ++i) {
+        v = (v << 8) | in[i];
+    }
+    value = v;
+    return n;
+}
+
+uint64_t WebTransportCodeToHttp(uint32_t code) {
+    return APP_ERROR_FIRST + code + code / 0x1e;
+}
+
+std::optional<uint32_t> HttpCodeToWebTransport(uint64_t http_code) {
+    if (http_code < APP_ERROR_FIRST || http_code > APP_ERROR_LAST) {
+        return std::nullopt;
+    }
+    // Reserved HTTP/3 codepoints 0x1f * N + 0x21 are skipped by the mapping.
+    if ((http_code - 0x21) % 0x1f == 0) {
+        return std::nullopt;
+    }
+    const uint64_t shifted{http_code - APP_ERROR_FIRST};
+    return static_cast<uint32_t>(shifted - shifted / 0x1f);
+}
+
+StreamPrefix ParseStreamPrefix(Span<const uint8_t> in, bool unidirectional) {
+    StreamPrefix out;
+    uint64_t first{0};
+    const size_t n1{GetVarint(in, first)};
+    if (n1 == 0) {
+        return out;
+    }
+    if (first != (unidirectional ? UNI_STREAM_TYPE : BIDI_SIGNAL)) {
+        out.status = StreamPrefix::Status::HTTP3;
+        return out;
+    }
+    uint64_t session{0};
+    const size_t n2{GetVarint(in.subspan(n1), session)};
+    if (n2 == 0) {
+        return out;
+    }
+    out.status = StreamPrefix::Status::WEBTRANSPORT;
+    out.session_id = session;
+    out.header_len = n1 + n2;
+    return out;
+}
+
+std::vector<uint8_t> BidiStreamHeader(uint64_t session_id) {
+    std::vector<uint8_t> out;
+    PutVarint(out, BIDI_SIGNAL);
+    PutVarint(out, session_id);
+    return out;
+}
+
+std::vector<uint8_t> UniStreamHeader(uint64_t session_id) {
+    std::vector<uint8_t> out;
+    PutVarint(out, UNI_STREAM_TYPE);
+    PutVarint(out, session_id);
+    return out;
+}
+
+CapsuleParse ParseCapsule(Span<const uint8_t> in) {
+    CapsuleParse out;
+    uint64_t type{0}, length{0};
+    const size_t n1{GetVarint(in, type)};
+    if (n1 == 0) {
+        return out;
+    }
+    const size_t n2{GetVarint(in.subspan(n1), length)};
+    if (n2 == 0) {
+        return out;
+    }
+    if (length > MAX_CAPSULE_SIZE) {
+        out.status = CapsuleParse::Status::ERROR;
+        out.error = "capsule too large";
+        return out;
+    }
+    if (in.size() - n1 - n2 < length) {
+        return out;
+    }
+    out.status = CapsuleParse::Status::OK;
+    out.capsule.type = type;
+    const auto value{in.subspan(n1 + n2, static_cast<size_t>(length))};
+    out.capsule.value.assign(value.begin(), value.end());
+    out.consumed = n1 + n2 + static_cast<size_t>(length);
+    return out;
+}
+
+void EncodeCapsule(std::vector<uint8_t> &out, uint64_t type,
+                   Span<const uint8_t> value) {
+    PutVarint(out, type);
+    PutVarint(out, value.size());
+    out.insert(out.end(), value.begin(), value.end());
+}
+
+std::optional<CloseSession> DecodeCloseSession(Span<const uint8_t> value) {
+    if (value.size() < 4 || value.size() - 4 > MAX_CLOSE_REASON) {
+        return std::nullopt;
+    }
+    CloseSession out;
+    out.code = (uint32_t{value[0]} << 24) | (uint32_t{value[1]} << 16) |
+               (uint32_t{value[2]} << 8) | uint32_t{value[3]};
+    out.reason.assign(value.begin() + 4, value.end());
+    return out;
+}
+
+std::vector<uint8_t> EncodeCloseSession(uint32_t code,
+                                        std::string_view reason) {
+    reason = reason.substr(0, MAX_CLOSE_REASON);
+    std::vector<uint8_t> value{
+        static_cast<uint8_t>(code >> 24), static_cast<uint8_t>(code >> 16),
+        static_cast<uint8_t>(code >> 8), static_cast<uint8_t>(code)};
+    value.insert(value.end(), reason.begin(), reason.end());
+    std::vector<uint8_t> out;
+    EncodeCapsule(out, CAPSULE_CLOSE_SESSION, value);
+    return out;
+}
+
+std::optional<std::vector<std::string>>
+ParseProtocolList(std::string_view field) {
+    std::vector<std::string> out;
+    size_t i{0};
+    const auto skip_ows{[&] {
+        while (i < field.size() && (field[i] == ' ' || field[i] == '\t')) {
+            ++i;
+        }
+    }};
+    skip_ows();
+    if (i == field.size()) {
+        return out;
+    }
+    while (true) {
+        if (i >= field.size() || field[i] != '"') {
+            return std::nullopt;
+        }
+        ++i;
+        std::string s;
+        while (true) {
+            if (i >= field.size()) {
+                return std::nullopt;
+            }
+            const char c{field[i++]};
+            if (c == '\\') {
+                if (i >= field.size() ||
+                    (field[i] != '"' && field[i] != '\\')) {
+                    return std::nullopt;
+                }
+                s.push_back(field[i++]);
+            } else if (c == '"') {
+                break;
+            } else if (c < 0x20 || c > 0x7e) {
+                return std::nullopt;
+            } else {
+                s.push_back(c);
+            }
+        }
+        // Parameters (";key=value") are allowed and ignored.
+        while (i < field.size() && field[i] == ';') {
+            while (i < field.size() && field[i] != ',') {
+                ++i;
+            }
+        }
+        out.push_back(std::move(s));
+        skip_ows();
+        if (i == field.size()) {
+            return out;
+        }
+        if (field[i] != ',') {
+            return std::nullopt;
+        }
+        ++i;
+        skip_ows();
+    }
+}
+
+std::string SerializeProtocol(std::string_view protocol) {
+    std::string out{"\""};
+    for (const char c : protocol) {
+        if (c == '"' || c == '\\') {
+            out.push_back('\\');
+        }
+        out.push_back(c);
+    }
+    out.push_back('"');
+    return out;
+}
+
+int DraftRank(uint64_t settings_id) {
+    switch (settings_id) {
+        case SETTINGS_ENABLE_WEBTRANSPORT_D02:
+            return 1;
+        case SETTINGS_WT_MAX_SESSIONS_D07:
+            return 2;
+        case SETTINGS_WT_MAX_SESSIONS_D13:
+            return 3;
+        case SETTINGS_WT_ENABLED:
+            return 4;
+        default:
+            return 0;
+    }
+}
+
+} // namespace wt
diff --git a/src/net_quic/webtransport_wire.h b/src/net_quic/webtransport_wire.h
new file mode 100644
index 0000000000000000000000000000000000000000..624a2f007e4e2b1680f8c8e1832f3556624c0840
--- /dev/null
+++ b/src/net_quic/webtransport_wire.h
@@ -0,0 +1,145 @@
+// Copyright (c) 2026 The Bitcoin developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_NET_QUIC_WEBTRANSPORT_WIRE_H
+#define BITCOIN_NET_QUIC_WEBTRANSPORT_WIRE_H
+
+#include <span.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/**
+ * WebTransport over HTTP/3 wire elements (draft-ietf-webtrans-http3-16 and
+ * the earlier drafts browsers still speak), without any library: QUIC
+ * variable-length integers, the WebTransport stream headers, capsules on
+ * the CONNECT stream, error code mapping and the wt-available-protocols
+ * list. Pure functions, unit-tested and fuzzed.
+ */
+namespace wt {
+
+//! SETTINGS identifiers announcing WebTransport support, per draft range
+constexpr uint64_t SETTINGS_ENABLE_WEBTRANSPORT_D02{0x2b603742};  // -00..-06
+constexpr uint64_t SETTINGS_WT_MAX_SESSIONS_D07{0xc671706a};      // -07..-12
+constexpr uint64_t SETTINGS_WT_MAX_SESSIONS_D13{0x14e9cd29};      // -13..-14
+constexpr uint64_t SETTINGS_WT_ENABLED{0x2c7cf000};               // -15..-16
+constexpr uint64_t SETTINGS_WT_INITIAL_MAX_STREAMS_UNI{0x2b64};
+constexpr uint64_t SETTINGS_WT_INITIAL_MAX_STREAMS_BIDI{0x2b65};
+constexpr uint64_t SETTINGS_WT_INITIAL_MAX_DATA{0x2b61};
+//! Draft-04 HTTP datagrams (Chrome, Firefox)
+constexpr uint64_t SETTINGS_H3_DATAGRAM_DRAFT04{0xffd277};
+
+//! Stream type of a WebTransport unidirectional stream
+constexpr uint64_t UNI_STREAM_TYPE{0x54};
+//! Signal value starting a WebTransport bidirectional stream
+constexpr uint64_t BIDI_SIGNAL{0x41};
+
+//! Capsules (RFC 9297 framing on the CONNECT stream)
+constexpr uint64_t CAPSULE_CLOSE_SESSION{0x2843};
+constexpr uint64_t CAPSULE_DRAIN_SESSION{0x78ae};
+//! Largest WT_CLOSE_SESSION reason (draft §5)
+constexpr size_t MAX_CLOSE_REASON{1024};
+//! Largest capsule we buffer (others are an error)
+constexpr uint64_t MAX_CAPSULE_SIZE{64 * 1024};
+
+//! HTTP/3 error codes (draft §9.5)
+constexpr uint64_t WT_BUFFERED_STREAM_REJECTED{0x3994bd84};
+constexpr uint64_t WT_SESSION_GONE{0x170d7b68};
+//! Our application error: a stream not following the P2P class-stream rules
+constexpr uint32_t WT_P2P_BAD_STREAM{1};
+
+//! First and last HTTP/3 code of WebTransport application errors
+constexpr uint64_t APP_ERROR_FIRST{0x52e4a40fa8db};
+constexpr uint64_t APP_ERROR_LAST{0x52e5ac983162};
+
+/** Bytes of a QUIC variable-length integer for `v` (v < 2^62) */
+size_t VarintSize(uint64_t v);
+void PutVarint(std::vector<uint8_t> &out, uint64_t v);
+/** Decode a varint at the start of `in`: bytes consumed (0: incomplete) */
+size_t GetVarint(Span<const uint8_t> in, uint64_t &value);
+
+/** WebTransport application error code -> HTTP/3 error code (§4.4) */
+uint64_t WebTransportCodeToHttp(uint32_t code);
+/** HTTP/3 error code -> WebTransport application error code, or
+ * std::nullopt outside the range or on a reserved (grease) codepoint */
+std::optional<uint32_t> HttpCodeToWebTransport(uint64_t http_code);
+
+/** How the first bytes of a stream decide what it is */
+struct StreamPrefix {
+    enum class Status {
+        //! More bytes are needed
+        INCOMPLETE,
+        //! Not a WebTransport stream: an HTTP/3 stream
+        HTTP3,
+        //! A WebTransport stream; session_id and header_len are set
+        WEBTRANSPORT,
+    };
+    Status status{Status::INCOMPLETE};
+    uint64_t session_id{0};
+    //! Bytes of the stream type/signal and session id
+    size_t header_len{0};
+};
+
+/**
+ * Classify a peer stream from its first bytes: a unidirectional stream
+ * whose type is 0x54, or a bidirectional stream starting with signal 0x41,
+ * is a WebTransport stream followed by its session id. Anything else is
+ * left to HTTP/3.
+ */
+StreamPrefix ParseStreamPrefix(Span<const uint8_t> in, bool unidirectional);
+
+/** The WebTransport header of a bidirectional stream (signal, session) */
+std::vector<uint8_t> BidiStreamHeader(uint64_t session_id);
+/** The WebTransport header of a unidirectional stream (type, session) */
+std::vector<uint8_t> UniStreamHeader(uint64_t session_id);
+
+/** One capsule (type, length, value) */
+struct Capsule {
+    uint64_t type{0};
+    std::vector<uint8_t> value;
+};
+
+/** Result of parsing the start of a capsule byte stream */
+struct CapsuleParse {
+    enum class Status { INCOMPLETE, OK, ERROR };
+    Status status{Status::INCOMPLETE};
+    Capsule capsule;
+    size_t consumed{0};
+    std::string error;
+};
+
+/** Parse one capsule from the start of `in` */
+CapsuleParse ParseCapsule(Span<const uint8_t> in);
+
+void EncodeCapsule(std::vector<uint8_t> &out, uint64_t type,
+                   Span<const uint8_t> value);
+
+/** WT_CLOSE_SESSION: 32-bit error code and a UTF-8 reason (≤ 1024 bytes) */
+struct CloseSession {
+    uint32_t code{0};
+    std::string reason;
+};
+std::optional<CloseSession> DecodeCloseSession(Span<const uint8_t> value);
+std::vector<uint8_t> EncodeCloseSession(uint32_t code, std::string_view reason);
+
+/**
+ * Parse an RFC 8941 List of Strings (wt-available-protocols): the strings
+ * in order, or std::nullopt if malformed. Parameters are ignored.
+ */
+std::optional<std::vector<std::string>>
+ParseProtocolList(std::string_view field);
+/** Serialize one RFC 8941 String (wt-protocol) */
+std::string SerializeProtocol(std::string_view protocol);
+
+/** The newest draft a peer's SETTINGS identifier announces (for display):
+ * returns the identifier's rank (0: not a WebTransport setting) */
+int DraftRank(uint64_t settings_id);
+
+} // namespace wt
+
+#endif // BITCOIN_NET_QUIC_WEBTRANSPORT_WIRE_H
