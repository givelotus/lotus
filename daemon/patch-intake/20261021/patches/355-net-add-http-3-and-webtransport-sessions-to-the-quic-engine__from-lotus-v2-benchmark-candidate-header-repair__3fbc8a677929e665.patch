+            m_result->value.status = status;
+            m_result->value.peer_draft_setting = session.PeerDraftSetting();
+            m_result->value.protocol = session.Protocol();
+            if (status != 200) {
+                m_result->Finish(true);
+            } else if (m_second) {
+                session.SubmitExtraConnectForTest();
+            }
+            return;
+        }
