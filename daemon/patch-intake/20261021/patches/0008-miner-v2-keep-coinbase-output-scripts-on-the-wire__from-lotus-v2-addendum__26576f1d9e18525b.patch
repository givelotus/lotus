From 25005e4f3652d231c4d177df8c1ea9b1a75bd9b4 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 13:05:03 -0700
Subject: [PATCH] miner(v2): keep coinbase output scripts on the wire

In two-node wallet tests the second node never caught up: it rejected
the first block that spent a coinbase with "mandatory-script-verify-flag-
failed (Opcode missing or not understood)", or refused to relay the
spending transaction as bad-txns-nonstandard-inputs, while the mining
node had accepted both. Twelve wallet test scripts failed this way with
block or mempool sync timeouts.

BlockAssembler gave every coinbase output a single branch,
BranchLeaf(scriptPubKey), and kept the legacy scriptPubKey next to it.
Once every output has a branch and the coinbase input is a V2 coinbase,
the transaction is serialized in pure V2 form, which carries only the
branch. Every node other than the miner therefore saw the 45-byte
synthetic wire script from CTxOut::FromV2Output instead of the payout
script. A legacy input spending such an output is checked with
VerifyScript against the coin's scriptPubKey, so the miner, whose coin
still held the payout script in memory, accepted the spend and its
peers did not. Whether a block was valid depended on state that only
the miner had.

The miner now leaves coinbase outputs as it builds them. A coinbase
whose outputs carry scripts is serialized in the wrapped V7 form, like
the wallet's own transactions, so every node sees the same scripts. The
TxId and TxHash do not change: both are computed from the V2 view of
the outputs, which is BranchLeaf(scriptPubKey) either way. Outputs that
already have branches, such as treasury outputs, are unaffected.

miner_tests/coinbase_outputs_survive_wire_round_trip serializes a
template's coinbase and checks that the decoded outputs keep their
scripts and that the identifiers are unchanged. It fails without this
change. With it, wallet_address_types, wallet_avoidreuse, wallet_backup,
wallet_hd --descriptors, wallet_import_rescan, wallet_importprunedfunds
and wallet_keypool_topup (both variants each where present) pass; the
other wallet scripts that timed out now stop later, at
bad-txns-non-v7-format.

Tier: V2 (fixup to v2/036)
---
 src/node/miner.cpp       | 11 -----------
 src/test/miner_tests.cpp | 30 ++++++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 11 deletions(-)

diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index 6eda0e1f44..a9eb92a036 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -270,17 +270,6 @@ BlockAssembler::CreateNewBlock(const CScript &scriptPubKeyIn) {
         }
     }
 
-    for (auto &out : coinbaseTx.vout) {
-        if (out.vBranches.empty()) {
-            const lotus::v2::Output v2out = out.ToV2Output();
-            out.nFlags = v2out.flags;
-            std::memcpy(out.tokenId.begin(), v2out.token_id.data(), 32);
-            std::memcpy(out.stateRoot.begin(), v2out.state_root.data(), 32);
-            out.vBranches = v2out.branches;
-            out.vPaths = v2out.paths;
-        }
-    }
-
     // Make sure the coinbase is big enough.
     uint64_t coinbaseSize = ::GetSerializeSize(coinbaseTx);
     if (coinbaseSize < MIN_TX_SIZE) {
diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 06ebf4828a..1048fca287 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -936,6 +936,36 @@ BOOST_FIXTURE_TEST_CASE(template_root_is_checked_from_selected_transactions, Tes
     BOOST_CHECK(!block_template->block.m_checked_merkle_root);
 }
 
+// A coinbase output must be the same after a wire round trip as in the
+// miner's memory: legacy inputs spending it are verified against its
+// scriptPubKey, so a script known only to the miner splits the miner from
+// every peer.
+BOOST_FIXTURE_TEST_CASE(coinbase_outputs_survive_wire_round_trip,
+                        TestChain100Setup) {
+    node::BlockAssembler::Options options;
+    options.test_block_validity = false;
+    const CScript payout =
+        GetScriptForDestination(PKHash(coinbaseKey.GetPubKey()));
+    const auto block_template = node::BlockAssembler(
+        node::BlockFitter(GetConfig()), m_node.chainman->ActiveChainstate(),
+        m_node.mempool.get(), options).CreateNewBlock(payout);
+    BOOST_REQUIRE(block_template);
+    const CTransaction &coinbase = *block_template->block.vtx[0];
+
+    DataStream ss{};
+    ss << coinbase;
+    const CTransaction decoded(deserialize, ss);
+    BOOST_CHECK_EQUAL(decoded.GetId(), coinbase.GetId());
+    BOOST_CHECK_EQUAL(decoded.GetHash(), coinbase.GetHash());
+    BOOST_REQUIRE_EQUAL(decoded.vout.size(), coinbase.vout.size());
+    BOOST_CHECK(coinbase.vout[0].scriptPubKey == payout);
+    for (size_t i = 0; i < coinbase.vout.size(); ++i) {
+        BOOST_CHECK(decoded.vout[i].scriptPubKey ==
+                    coinbase.vout[i].scriptPubKey);
+        BOOST_CHECK(decoded.vout[i] == coinbase.vout[i]);
+    }
+}
+
 BOOST_FIXTURE_TEST_CASE(finalized_template_after_deferred_remove_readd_matches_own_root, AvalancheTestChain100Setup) {
     CTxMemPool &pool = *m_node.mempool;
     LOCK2(cs_main, pool.cs);
