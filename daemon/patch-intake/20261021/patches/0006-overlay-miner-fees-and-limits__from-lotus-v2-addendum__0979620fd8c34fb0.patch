From 3ca61f28be28b0b853344eae1c0f9fe171dec213 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:27:51 -0700
Subject: [PATCH] fixup! mining: reuse eligible speculative overlays for
 templates and block script checks

Keep speculative-overlay template reuse, but qualify every selected transaction against the authoritative mempool entry modified fee, raw fee and sigcheck count. Check cumulative size/sigcheck limits with a temporary BlockFitter before committing the entire overlay; otherwise retain the existing ordinary selection fallback.

The inherited BIP68 functional control previously mined a transaction deliberately deprioritized below the mining fee floor because the shortcut checked its raw fee. With unchanged assertions it now passes completely. CLTV and real legacy/native four-wallet-family controls also pass on the same rebuilt OFF daemon. Before/after daemon hashes and source diffs are retained separately.

Tier: ECASH
---
 src/node/miner.cpp | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index e0a7a436ec..7f46272dc7 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -222,17 +222,31 @@ BlockAssembler::CreateNewBlock(const CScript &scriptPubKeyIn) {
         if (!shouldAddFinalizedTxs && spec_overlay.GetTxCount() > 0 &&
             spec_overlay.GetTxCount() == m_mempool->size()) {
             bool all_overlay_txs_eligible = true;
+            // Bulk reuse must satisfy the same fee and cumulative resource
+            // limits as individual selection, without mutating its counters
+            // until every overlay transaction has qualified.
+            auto overlay_fitter = blockFitter;
             for (const auto &[_, oentry] : spec_overlay.GetOrderedTxs()) {
                 const auto tx = std::static_pointer_cast<const CTransaction>(
                     oentry.tx_ref);
-                if (!tx ||
-                    blockFitter.isBelowBlockMinFeeRate(
-                        CFeeRate(oentry.fee_sats * SATOSHI,
-                                 tx->GetTotalSize())) ||
+                if (!tx) {
+                    all_overlay_txs_eligible = false;
+                    break;
+                }
+                const auto entry = m_mempool->mapTx.find(tx->GetId());
+                if (entry == m_mempool->mapTx.end() ||
+                    (*entry)->GetFee() != oentry.fee_sats * SATOSHI ||
+                    (*entry)->GetSigChecks() != oentry.sigchecks ||
+                    overlay_fitter.isBelowBlockMinFeeRate(
+                        (*entry)->GetModifiedFeeRate()) ||
+                    !overlay_fitter.testTxFits(tx->GetTotalSize(),
+                                              oentry.sigchecks) ||
                     !CheckTx(*tx)) {
                     all_overlay_txs_eligible = false;
                     break;
                 }
+                overlay_fitter.addTx(tx->GetTotalSize(), oentry.sigchecks,
+                                    oentry.fee_sats * SATOSHI);
             }
             if (all_overlay_txs_eligible) {
                 use_speculative_overlay = true;
