From 29472b1ee39663516050d5e2064cf7fee95245a5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:07:14 -0700
Subject: [PATCH] tests: guarantee child-before-parent radix ordering in mining
 regression

Vary only the child locktime while its input sequence is final to produce a deterministic TxId smaller than its parent. Assert that inversion before building the template, so the dependency-order regression cannot accidentally pass because the fixture hashes were already topologically sorted.

(cherry picked from commit 8033dfe61b33cbe0c307898eb0ddebf9ff620314)

diff --git a/src/test/miner_tests.cpp b/src/test/miner_tests.cpp
index 42c87b4e1b455eb83459a38203d71ca9cedf0963..bdd14e6d13f73fb04fcea706860181141c76d7bf 100644
--- a/src/test/miner_tests.cpp
+++ b/src/test/miner_tests.cpp
@@ -249,7 +249,14 @@ void MinerTestingSetup::TestPackageSelection(
     tx.vin[0].prevout = COutPoint(parentTxId, 0);
     // 50k satoshi fee.
     tx.vout[0].nValue = int64_t(5000000000LL - 1000 - 50000) * SATOSHI;
+    // Guarantee the regression shape: radix order places this child before
+    // its parent. All input sequences are final, so varying nLockTime changes
+    // only the ID, not transaction finality, size or fee.
+    while (!(tx.GetId() < parentTxId) && tx.nLockTime < 65536) {
+        ++tx.nLockTime;
+    }
     TxId highFeeTxId = tx.GetId();
+    BOOST_REQUIRE(highFeeTxId < parentTxId);
     AddUnchecked(entry.Fee(50000 * SATOSHI).Time(GetTime()).FromTx(tx));
 
     std::unique_ptr<CBlockTemplate> pblocktemplate =
