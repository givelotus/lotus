From 3ab4a97ce619a705b153c22567694ec225d37850 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 05:04:26 -0700
Subject: fixup! [v2 only] net: cache dictionary-versioned independent
 compressed block frames

---
 src/net_websocket_codec.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/net_websocket_codec.cpp b/src/net_websocket_codec.cpp
index dcbc2c72e1..d5c1944328 100644
--- a/src/net_websocket_codec.cpp
+++ b/src/net_websocket_codec.cpp
@@ -177,7 +177,7 @@ WebSocketCodec::FinishMessage(std::vector<uint8_t> &plain) {
         plain.resize(start + V2_LENGTH_SIZE);
         if (m_message_independent) {
             try {
-                DecompressP2PIndependent(m_message, plain, MAX_MESSAGE_SIZE);
+                DecompressP2PIndependent(m_message, plain, plain_limit);
             } catch (const std::exception &e) {
                 return strprintf("independent zstd: %s", e.what());
             }
@@ -266,7 +266,8 @@ WebSocketCodec::Decode(Span<const uint8_t> in, std::vector<uint8_t> &plain,
             return result;
         }
         const bool compressed = v2
-            ? (h->opcode == OP_BINARY ? h->rsv == RSV1 : m_message_compressed)
+            ? (h->opcode == OP_BINARY ? (h->rsv == RSV1 || h->rsv == RSV2)
+                                     : (m_message_compressed || m_message_independent))
             : bool(m_zstd);
         const uint64_t wire_limit = compressed
             ? MaxWireMessageSize() : GetP2PWebSocketMessageSizeLimit();
