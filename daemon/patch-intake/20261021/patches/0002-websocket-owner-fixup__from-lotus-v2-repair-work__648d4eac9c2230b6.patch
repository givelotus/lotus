From 6ff3a000c76d8357e9e4a82eea5c5221673164d3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 07:17:11 -0700
Subject: [PATCH] fixup! [v2 only] net: cache dictionary-versioned independent
 compressed block frames

Reuse the existing shared independent-frame receive-state member. The native frame-cache adaptation added a second identical bool, which the normal native ChronikON/walletON httpserver.cpp compilation rejects. Preserve the original documented member, all receive paths, initialization and frame semantics.
---
 src/net_websocket_codec.h | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/net_websocket_codec.h b/src/net_websocket_codec.h
index 0abafc3be8..594a2f8466 100644
--- a/src/net_websocket_codec.h
+++ b/src/net_websocket_codec.h
@@ -108,7 +108,6 @@ private:
     bool m_message_independent{false};
     //! P2P_V2: the message being received is compressed (RSV1)
     bool m_message_compressed{false};
-    bool m_message_independent{false};
     bool m_peer_closed{false};
     bool m_close_sent{false};
     uint64_t m_wire_sent{0};
