+it('REVIEW Buffer swap ID alias returns ok with an invalid signature after pending signer mutation', async () => {
+  const input = {...context(), swapId: Buffer.alloc(32, 0x11)};
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => { release = resolve; });
+  const pending = buildNegotiationOffer(input, amounts(), async digest => {
+    const signature = signA(digest);
+    await gate;
+    return signature;
+  });
+  input.swapId.fill(0x33);
+  release();
+  const built = await pending;
+  expect(built.ok).toBe(true);
+  const event = must(built);
+  expect(hex(event.swapId)).toBe('33'.repeat(32));
+  const digest = sha256(must(signaturePreimageForCore(event)));
+  expect(verifyAlgorithm1(digest, event.signature, a.compressedPubKey)).toBe(false);
+  const decoded = decodeNegotiationEventSchema(encoded(event), TESTNET_NEGOTIATION_POLICY, standaloneItemBudget());
+  expect(decoded.ok).toBe(false);
+  if (!decoded.ok) expect(decoded.error.code).toBe('invalid-signature');
+});
+
+it('REVIEW Buffer offer bytes alias response prerequisite across signer await', async () => {
+  const first = await offer();
+  const raw = Buffer.from(encoded(first));
+  const at = raw.indexOf(Buffer.from(first.eventId));
+  expect(at).toBeGreaterThan(0);
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => { release = resolve; });
+  const pending = buildNegotiationResponse(context(), raw, 'accept', async digest => {
+    const signature = signB(digest);
+    await gate;
+    return signature;
+  });
+  raw[at] ^= 1;
+  release();
+  const built = await pending;
+  expect(built.ok).toBe(true);
+  const event = must(built);
+  expect(hex(event.prerequisiteEventIds[0])).not.toBe(hex(first.eventId));
+  expect(verifyAlgorithm1(sha256(must(signaturePreimageForCore(event))), event.signature, b.compressedPubKey)).toBe(false);
+});
