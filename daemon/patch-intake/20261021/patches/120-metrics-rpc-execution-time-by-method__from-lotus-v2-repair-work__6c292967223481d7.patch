From cac978d858ef8953dc4846e7882482af1fd5c353 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 02:08:40 -0700
Subject: [PATCH] metrics: RPC execution time by method

How long each RPC command takes to execute (CRPCTable::execute,
including commands that throw), by method. The label values are the
commands registered when metrics start, plus "other"; a method's series
appears once it has been called, so the exposition does not list a
hundred empty histograms.

(cherry picked from commit c4b2f4ff47d34184169112f6728a477322ee0d13)

N3-Source-Commit: c4b2f4ff47d34184169112f6728a477322ee0d13
N3-Source-Export: 0012
---
 src/httpmetrics.cpp                       |  3 ++-
 src/node/metrics.cpp                      | 28 +++++++++++++++++++----
 src/node/metrics.h                        | 17 +++++++++++---
 src/rpc/server.cpp                        | 16 +++++++++++++
 test/functional/interface_http_metrics.py | 10 ++++++++
 5 files changed, 66 insertions(+), 8 deletions(-)

diff --git a/src/httpmetrics.cpp b/src/httpmetrics.cpp
index 8c74ead1bf..5421e5a9a2 100644
--- a/src/httpmetrics.cpp
+++ b/src/httpmetrics.cpp
@@ -8,6 +8,7 @@
 #include <logging.h>
 #include <node/metrics.h>
 #include <rpc/protocol.h>
+#include <rpc/server.h>
 
 #include <string>
 
@@ -31,7 +32,7 @@ static bool HTTPReqMetrics(Config &, HTTPRequest *req, const std::string &) {
 }
 
 void StartHTTPMetrics() {
-    node::StartNodeMetrics();
+    node::StartNodeMetrics(tableRPC.listCommands());
     RegisterHTTPHandler("/metrics", true, HTTPReqMetrics);
     LogPrintf("Serving metrics at /metrics on the RPC listeners\n");
 }
diff --git a/src/node/metrics.cpp b/src/node/metrics.cpp
index 283a61ca41..9049d27e31 100644
--- a/src/node/metrics.cpp
+++ b/src/node/metrics.cpp
@@ -79,6 +79,13 @@ namespace {
         0.0001, 0.00025, 0.0005, 0.001, 0.0025, 0.005, 0.01, 0.025, 0.05, 0.1,
         0.25,   0.5,     1,      2.5,   5,      10,    30,   60,    300};
 
+    std::vector<std::string> SortedWithOther(std::vector<std::string> v) {
+        std::sort(v.begin(), v.end());
+        v.erase(std::unique(v.begin(), v.end()), v.end());
+        v.push_back("other");
+        return v;
+    }
+
     /** Index of s in sorted[0, size-1), else size-1 ("other") */
     size_t SortedIndex(const std::vector<std::string> &sorted,
                        std::string_view s) noexcept {
@@ -102,7 +109,7 @@ size_t MetricMsgTypeIndex(std::string_view msg_type) noexcept {
     return SortedIndex(L::MsgTypes(), msg_type);
 }
 
-NodeMetrics::NodeMetrics()
+NodeMetrics::NodeMetrics(std::vector<std::string> rpc_methods)
     : p2p_received_bytes{Add<Counter>(
           registry, "lotus_p2p_received_bytes_total",
           "P2P bytes received (header and payload), by message type.",
@@ -177,7 +184,16 @@ NodeMetrics::NodeMetrics()
       http_tls_handshakes{
           Add<Counter>(registry, "lotus_http_tls_handshakes_total",
                        "TLS handshakes on the HTTP listeners, by result.",
-                       std::vector<LabelDim>{{"result", {"ok", "failed"}}})} {
+                       std::vector<LabelDim>{{"result", {"ok", "failed"}}})},
+      rpc_request_seconds{
+          Add<EventHistogram>(
+              registry, "lotus_rpc_request_duration_seconds",
+              "Time to execute an RPC command, by method (methods appear "
+              "once called).",
+              REQUEST_BUCKETS, /*divisor=*/1e9,
+              std::vector<LabelDim>{{"method", SortedWithOther(rpc_methods)}})
+              .HideEmptySeries()},
+      m_rpc_methods{SortedWithOther(std::move(rpc_methods))} {
     initial_block_download.Set(1);
     registry.AddCollector([this] {
         const double tip{tip_timestamp.Value()};
@@ -189,6 +205,10 @@ NodeMetrics::NodeMetrics()
     });
 }
 
+size_t NodeMetrics::RPCMethodIndex(std::string_view method) const noexcept {
+    return SortedIndex(m_rpc_methods, method);
+}
+
 size_t NodeMetrics::PeerSeries(bool inbound, bool websocket,
                                size_t network) const noexcept {
     const std::array<size_t, 3> idx{
@@ -197,11 +217,11 @@ size_t NodeMetrics::PeerSeries(bool inbound, bool websocket,
     return peers.SeriesIndex(idx);
 }
 
-NodeMetrics &StartNodeMetrics() {
+NodeMetrics &StartNodeMetrics(std::vector<std::string> rpc_methods) {
     NodeMetrics *m{GetNodeMetrics()};
     if (!m) {
         // Never freed: recording threads may hold the pointer.
-        m = new NodeMetrics();
+        m = new NodeMetrics(std::move(rpc_methods));
         detail::g_node_metrics.store(m, std::memory_order_release);
     }
     m->registry.Start();
diff --git a/src/node/metrics.h b/src/node/metrics.h
index 08fb57b4c8..1041032e90 100644
--- a/src/node/metrics.h
+++ b/src/node/metrics.h
@@ -53,7 +53,7 @@ enum class HTTPEndpoint : size_t {
 
 /** The node's metrics. Exists only with -metrics (see GetNodeMetrics). */
 struct NodeMetrics {
-    NodeMetrics();
+    explicit NodeMetrics(std::vector<std::string> rpc_methods);
     metrics::Registry registry;
 
     // P2P traffic, by message type (index: MetricMsgTypeIndex)
@@ -85,9 +85,17 @@ struct NodeMetrics {
     metrics::Counter &http_requests;
     metrics::EventHistogram &http_request_seconds;
     metrics::Counter &http_tls_handshakes;
+    metrics::EventHistogram &rpc_request_seconds;
+
+    /** Label index of an RPC method ("other" if not in the set) */
+    size_t RPCMethodIndex(std::string_view method) const noexcept;
 
     size_t PeerSeries(bool inbound, bool websocket,
                       size_t network) const noexcept;
+
+private:
+    //! Sorted, then "other"
+    const std::vector<std::string> m_rpc_methods;
 };
 
 namespace detail {
@@ -104,8 +112,11 @@ inline NodeMetrics *GetNodeMetrics() noexcept {
     return detail::g_node_metrics.load(std::memory_order_acquire);
 }
 
-/** Create the metrics (once) and start the drain thread */
-NodeMetrics &StartNodeMetrics();
+/**
+ * Create the metrics (once), start the drain thread.
+ * rpc_methods: every registered RPC command.
+ */
+NodeMetrics &StartNodeMetrics(std::vector<std::string> rpc_methods);
 /** Stop the drain thread (recording still works, into full rings) */
 void StopNodeMetrics();
 
diff --git a/src/rpc/server.cpp b/src/rpc/server.cpp
index 625c1d3507..cb4af9331e 100644
--- a/src/rpc/server.cpp
+++ b/src/rpc/server.cpp
@@ -9,6 +9,7 @@
 #include <common/args.h>
 #include <config.h>
 #include <logging.h>
+#include <node/metrics.h>
 #include <rpc/async_waiter.h>
 #include <rpc/util.h>
 #include <shutdown.h>
@@ -685,6 +686,21 @@ UniValue CRPCTable::execute(const Config &config,
         }
     }
 
+    // Execution time by method, for metrics (also when it throws)
+    struct RecordDuration {
+        node::NodeMetrics *metrics{node::GetNodeMetrics()};
+        const std::string &method;
+        SteadyClock::time_point start{metrics ? SteadyClock::now()
+                                              : SteadyClock::time_point{}};
+        ~RecordDuration() {
+            if (metrics) {
+                metrics->rpc_request_seconds.RecordDuration(
+                    SteadyClock::now() - start,
+                    metrics->RPCMethodIndex(method));
+            }
+        }
+    } record_duration{.method = request.strMethod};
+
     // Find method
     auto it = mapCommands.find(request.strMethod);
     if (it != mapCommands.end()) {
diff --git a/test/functional/interface_http_metrics.py b/test/functional/interface_http_metrics.py
index 7835a63d03..0ee1b5779a 100755
--- a/test/functional/interface_http_metrics.py
+++ b/test/functional/interface_http_metrics.py
@@ -211,6 +211,16 @@ class HTTPMetricsTest(BitcoinTestFramework):
                           endpoint="rpc") > 0
         assert_equal(
             self.total(samples, "lotus_http_tls_handshakes_total", result="ok"), 1)
+        assert self.total(samples, "lotus_rpc_request_duration_seconds_count",
+                          method="getblockcount") >= 1
+        # Only methods that were called have series.
+        assert_equal(
+            self.total(samples, "lotus_rpc_request_duration_seconds_count",
+                       method="stop"), 0)
+        assert not any(
+            n.startswith("lotus_rpc_request") and ("method", "stop") in ls
+            for n, ls in samples
+        )
 
         self.log.info("HEAD has the headers but no body; POST is refused")
         res, body = self.request(rpc_port(0), method="HEAD")
