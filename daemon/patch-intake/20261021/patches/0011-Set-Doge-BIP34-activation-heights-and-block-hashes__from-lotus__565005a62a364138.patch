From ef7b83f3b4802ac04b34c0d048df191ddea76826 Mon Sep 17 00:00:00 2001
From: Roqqit <roqqit@proton.me>
Date: Wed, 12 Jun 2024 22:58:27 +0000
Subject: [PATCH] Set Doge BIP34 activation heights and block hashes

Maintenance explanation (added 2026-10-14; not original author text):
Set Dogecoin BIP34 activation heights and activation block hashes rather
than inheriting the ABC coinbase-height activation commitments.

The original subject, author and author date are preserved. Only message
metadata changes; exact source diff bytes and intermediate trees are retained.

diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 9a4d0f350389780e46ddf5c4df50197b87567159..04778a4895f71bad0eb8b673e9786901c68f3fb2 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -87,9 +87,9 @@ public:
         // 00000000000000ce80a7e057163a4db1d5ad7b20fb6f598c9597b9665c8fb0d4 -
         // April 1, 2012
         consensus.BIP16Height = 0;
-        consensus.BIP34Height = 227931;
+        consensus.BIP34Height = 1034383;
         consensus.BIP34Hash = *BlockHash::FromHex(
-            "000000000000024b89b42a942fe0d9fea3bb44ab7bd1b19115dd6a759c0808b8");
+            "80d1364201e5df97e696c03bdd24dc885e8617b9de51e453c10a4f629b1e797a");
         // 000000000000000004c2b624ed5d7756c508d90fd0da2c7c679febfa6c4735f0
         consensus.BIP65Height = 388381;
         // 00000000000000000379eaa19dce8c9b722d46ae6a57c2f1a988119488b50931
@@ -254,9 +254,9 @@ public:
         consensus.nSubsidyHalvingInterval = 210000;
         // 00000000040b4e986385315e14bee30ad876d8b47f748025b26683116d21aa65
         consensus.BIP16Height = 0;
-        consensus.BIP34Height = 21111;
+        consensus.BIP34Height = 708658;
         consensus.BIP34Hash = *BlockHash::FromHex(
-            "0000000023b3a96d3484e5abb3755c413e7d41500f8e2a5c3f0dd01299cd8ef8");
+            "21b8b97dcdb94caa67c7f8f6dbf22e61e0cfe0e46e1fff3528b22864659e9b38");
         // 00000000007f6655f22f98e72ed80d8b06dc761d5da09df0fa1dc4be4f861eb6
         consensus.BIP65Height = 581885;
         // 000000002104c8c45e99a8853285a3b592602a3ccde2b832481da85e9e4ba182
