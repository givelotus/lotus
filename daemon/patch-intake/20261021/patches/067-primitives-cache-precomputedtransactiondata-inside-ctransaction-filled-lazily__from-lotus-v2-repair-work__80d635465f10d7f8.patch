From 8acf6700dbe3dcdf22e391ede81e04ec0adad68e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 19:43:58 -0700
Subject: [PATCH] primitives: cache PrecomputedTransactionData inside
 CTransaction, filled lazily

Keep the BIP143 hashPrevouts, hashSequence, and hashOutputs in inline lazy
transaction-owned storage. The cached size was introduced earlier; this
patch does not add another serialized-size field.

Ordinary mempool checks, atomic batch workers (including retry and consensus
flags), and block checks bind GetPrecomputedData() by const reference. RPC
batch decoding warms this cache before cs_main without carrying another
96-byte copy in its per-transaction result or validation Workspace.
The cache remains deterministic and publishes one stored result to concurrent
readers. Transactions are non-copyable; construct references directly.

Tests compare fresh/cache outputs and constructor sizes, including racing
first use. Original slab-series input: zero-copy-slab-v3/0003; the existing
validation.cpp and validation_tests.cpp adaptations remain in this owner.

diff --git a/src/primitives/transaction.cpp b/src/primitives/transaction.cpp
index 5b988d71fd5ee966eacebd6f20b0c2543ee7adf9..a5b817cd351ce6bf42071c52b758d0980eee9546 100644
--- a/src/primitives/transaction.cpp
+++ b/src/primitives/transaction.cpp
@@ -14,6 +14,7 @@
 
 #include <algorithm>
 #include <cassert>
+#include <thread>
 
 std::string COutPoint::ToString() const {
     return strprintf("COutPoint(%s, %u)", txid.ToString().substr(0, 10), n);
@@ -197,6 +198,26 @@ CTransaction::CTransaction(CMutableTransaction &&tx)
     : vin(std::move(tx.vin)), vout(std::move(tx.vout)), nVersion(tx.nVersion),
       nLockTime(tx.nLockTime), m_serialize_size(ComputeSerializedSize()), hash(ComputeHash()) {}
 
+const PrecomputedTransactionData &CTransaction::FillPrecomputedData() const {
+    // Hashing is deterministic, so racing callers compute identical data; only
+    // the thread that claims the slot writes it.
+    const PrecomputedTransactionData computed =
+        PrecomputedTransactionData::Compute(*this);
+    uint8_t expected = PRECOMPUTED_EMPTY;
+    if (m_precomputed_state.compare_exchange_strong(
+            expected, PRECOMPUTED_WRITING, std::memory_order_relaxed)) {
+        m_precomputed = computed;
+        m_precomputed_state.store(PRECOMPUTED_READY, std::memory_order_release);
+        return m_precomputed;
+    }
+    // Another thread is storing its identical result; that is a 96-byte copy.
+    while (m_precomputed_state.load(std::memory_order_acquire) !=
+           PRECOMPUTED_READY) {
+        std::this_thread::yield();
+    }
+    return m_precomputed;
+}
