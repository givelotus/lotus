From 96a51c28a7cc68feeaf6c58310c55ad7ae4b19a2 Mon Sep 17 00:00:00 2001
From: Lotus Verification <verification@givelotus.org>
Date: Wed, 14 Oct 2026 09:25:13 -0700
Subject: [PATCH] [test] Verify finalized-ancestor pruning across a partial
 diamond

Independently exercise both parent lookup modes with one finalized and one unfinalized branch sharing a finalized root. Verify only the remaining branch and join finalize, a nonfinal descendant remains rejected, and repeated finalization clears previously populated output IDs. This adds test coverage only; it does not change candidate 04 production code or enable it in any maintained series.
---
 src/test/mempool_tests.cpp | 74 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/src/test/mempool_tests.cpp b/src/test/mempool_tests.cpp
index b0bd31e36b..c86fadbde2 100644
--- a/src/test/mempool_tests.cpp
+++ b/src/test/mempool_tests.cpp
@@ -864,4 +864,78 @@ BOOST_AUTO_TEST_CASE(setAvalancheFinalized_chained_txs) {
     }
 }
 
+BOOST_AUTO_TEST_CASE(setAvalancheFinalized_pruned_diamond_boundary) {
+    CTxMemPool &pool = *Assert(m_node.mempool);
+    ChainstateManager &chainman = *Assert(m_node.chainman);
+    const auto &params = chainman.GetConsensus();
+    TestMemPoolEntryHelper helper;
+    LOCK2(cs_main, pool.cs);
+    const auto &tip = *Assert(chainman.ActiveTip());
+
+    CScript scriptSig;
+    for (int i = 0; i < 100; ++i) {
+        scriptSig << OP_1;
+    }
+    auto add = [&](const std::vector<COutPoint> &inputs, uint32_t locktime = 0) NO_THREAD_SAFETY_ANALYSIS {
+        CMutableTransaction tx;
+        tx.nVersion = 2;
+        tx.nLockTime = locktime;
+        for (const auto &prevout : inputs) {
+            CTxIn input;
+            input.prevout = prevout;
+            input.scriptSig = scriptSig;
+            input.nSequence = locktime ? 0 : CTxIn::SEQUENCE_FINAL;
+            tx.vin.push_back(input);
+        }
+        tx.vout.emplace_back(10000 * SATOSHI, CScript() << OP_TRUE);
+        tx.vout.emplace_back(10000 * SATOSHI, CScript() << OP_TRUE);
+        auto entry = helper.Fee(1000 * SATOSHI).FromTx(tx);
+        pool.addUnchecked(entry);
+        return entry;
+    };
+    auto root = add({COutPoint(TxId{FastRandomContext().rand256()}, 0)});
+    auto left = add({COutPoint(root->GetTx().GetId(), 0)});
+    auto right = add({COutPoint(root->GetTx().GetId(), 1)});
+    auto join = add({COutPoint(left->GetTx().GetId(), 0),
+                     COutPoint(right->GetTx().GetId(), 0)});
+
+    std::vector<TxId> finalized;
+    BOOST_REQUIRE(pool.setAvalancheFinalized(
+        left, params, tip, chainman.ActiveChainstate(), finalized));
+    BOOST_CHECK_EQUAL(finalized.size(), 2U);
+    BOOST_CHECK_EQUAL(pool.GetFinalizedTxCount(), 2U);
+    for (const bool searchParents : {false, true}) {
+        CTxMemPool::setEntries pruned, complete;
+        pool.CalculateMemPoolAncestors(join, pruned, searchParents, false);
+        pool.CalculateMemPoolAncestors(join, complete, searchParents, true);
+        BOOST_CHECK_EQUAL(pruned.size(), 1U);
+        BOOST_CHECK_EQUAL(complete.size(), 3U);
+        BOOST_CHECK(pruned.count(*Assert(pool.GetIter(right->GetTx().GetId()))));
+    }
+    BOOST_REQUIRE(pool.setAvalancheFinalized(
+        join, params, tip, chainman.ActiveChainstate(), finalized));
+    BOOST_CHECK_EQUAL(finalized.size(), 2U);
+    BOOST_CHECK_EQUAL(pool.GetFinalizedTxCount(), 4U);
+    BOOST_CHECK(std::find(finalized.begin(), finalized.end(),
+                          right->GetTx().GetId()) != finalized.end());
+    BOOST_CHECK(std::find(finalized.begin(), finalized.end(),
+                          join->GetTx().GetId()) != finalized.end());
+
+    // Finalized ancestry must not bypass checks on a new, nonfinal child.
+    auto locked = add({COutPoint(join->GetTx().GetId(), 0)}, tip.nHeight + 1);
+    finalized.clear();
+    BOOST_CHECK(!pool.setAvalancheFinalized(
+        locked, params, tip, chainman.ActiveChainstate(), finalized));
+    BOOST_CHECK(finalized.empty());
+    BOOST_CHECK_EQUAL(pool.GetFinalizedTxCount(), 4U);
+    BOOST_CHECK(!pool.isAvalancheFinalizedPreConsensus(locked->GetTx().GetId()));
+
+    // Repeated finalization must clear a nonempty previous result.
+    finalized.push_back(root->GetTx().GetId());
+    BOOST_CHECK(pool.setAvalancheFinalized(
+        join, params, tip, chainman.ActiveChainstate(), finalized));
+    BOOST_CHECK(finalized.empty());
+    BOOST_CHECK_EQUAL(pool.GetFinalizedTxCount(), 4U);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
