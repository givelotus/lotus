+#ifndef BITCOIN_NET_ZSTD_INDEPENDENT_H
+#define BITCOIN_NET_ZSTD_INDEPENDENT_H
+
+#include <span.h>
+#include <sync.h>
+#include <uint256.h>
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
