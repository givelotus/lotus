From c8a44da9c3be5e2582607ca4abfb630194dbd7dc Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:01:48 -0700
Subject: [PATCH] fuzz: index CTransaction inputs without Span::at

Storing each CTransaction in one allocation made CTransaction::vin a
Span<const CTxIn>, which has no at() member. The script_flags fuzz
target still called tx.vin.at(i), so the fuzz binary failed to compile
(and therefore never linked) from that change on. The loop bound already
keeps i below tx.vin.size(), so plain indexing is equivalent.

With this, the fuzz binary builds and all of its targets run.

Tier: eCash (fixup to ecash/066)
---
 src/test/fuzz/script_flags.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/test/fuzz/script_flags.cpp b/src/test/fuzz/script_flags.cpp
index 1b468330ad..51808507f8 100644
--- a/src/test/fuzz/script_flags.cpp
+++ b/src/test/fuzz/script_flags.cpp
@@ -38,7 +38,7 @@ FUZZ_TARGET(script_flags) {
 
             ScriptError serror;
             const bool ret =
-                VerifyScript(tx.vin.at(i).scriptSig, prevout.scriptPubKey,
+                VerifyScript(tx.vin[i].scriptSig, prevout.scriptPubKey,
                              verify_flags, checker, &serror);
             assert(ret == (serror == ScriptError::OK));
 
@@ -55,7 +55,7 @@ FUZZ_TARGET(script_flags) {
 
             ScriptError serror_fuzzed;
             const bool ret_fuzzed =
-                VerifyScript(tx.vin.at(i).scriptSig, prevout.scriptPubKey,
+                VerifyScript(tx.vin[i].scriptSig, prevout.scriptPubKey,
                              verify_flags, checker, &serror_fuzzed);
             assert(ret_fuzzed == (serror_fuzzed == ScriptError::OK));
 
