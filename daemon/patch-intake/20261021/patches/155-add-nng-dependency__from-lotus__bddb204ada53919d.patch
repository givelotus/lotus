From 2264bda21b2cbedab1f1130c4e3c613d7f9e91b7 Mon Sep 17 00:00:00 2001
From: Tobias <ruck.tobias@gmail.com>
Date: Fri, 14 Jan 2022 15:48:28 -0600
Subject: [PATCH] Add nng dependency (#241)

This is used by the nng interface down the line.

`nngcat` causes problems when cross-compiling, and isn't used anyway, so we disable it.

Rebase provenance: this historical change was adapted onto the pinned
Bitcoin ABC base. Source diff is the recorded Lotus V1 replay commit below.

Historical-source-commit: 44488ecd5229da1c03ad4ade250309e6ac13aabb
Recorded-replay-commit: 39dc3fd6c06569ea1def59fd7c980312f45d65d4

diff --git a/depends/Makefile b/depends/Makefile
index 4f911c84dd..96b06dadea 100644
--- a/depends/Makefile
+++ b/depends/Makefile
@@ -40,6 +40,7 @@ NO_WALLET ?=
 NO_ZMQ ?=
 NO_JEMALLOC ?=
 BUILD_CPYTHON ?=
+NO_NNG ?=
 NO_FLATBUFFERS ?=
 FALLBACK_DOWNLOAD_PATH ?= https://download.bitcoinabc.org/depends-sources
 
@@ -155,6 +156,7 @@ jemalloc_packages_$(NO_JEMALLOC) = $(jemalloc_packages)
 
 cpython_packages_$(BUILD_CPYTHON) = $(cpython_packages)
 
+nng_packages_$(NO_NNG) = $(nng_packages)
 Flatbuffers_packages_$(NO_FLATBUFFERS) = $(Flatbuffers_packages)
 
 packages += $($(host_arch)_$(host_os)_packages) $($(host_os)_packages) $(qt_packages_) $(wallet_packages_)
@@ -180,6 +182,10 @@ endif
 ifeq ($(cpython_packages_),)
 native_packages += $(cpython_native_packages)
 packages += $(cpython_packages)
+ifneq ($(nng_packages_),)
+packages += $(nng_packages)
+endif
+
 ifneq ($(Flatbuffers_packages_),)
 packages += $(Flatbuffers_packages)
 native_packages += $(Flatbuffers_native_packages)
diff --git a/depends/packages/nng.mk b/depends/packages/nng.mk
new file mode 100644
index 0000000000..b723810683
--- /dev/null
+++ b/depends/packages/nng.mk
@@ -0,0 +1,28 @@
+package=nng
+$(package)_version=1.5.2
+$(package)_download_path=https://github.com/nanomsg/nng/archive/refs/tags/
+$(package)_file_name=v$($(package)_version).tar.gz
+$(package)_sha256_hash=f8b25ab86738864b1f2e3128e8badab581510fa8085ff5ca9bb980d317334c46
+$(package)_patches=remove_deps.patch
+
+define $(package)_preprocess_cmds
+  patch -p1 < $($(package)_patch_dir)/remove_deps.patch
+endef
+
+define $(package)_config_cmds
+  cmake -GNinja \
+    -DCMAKE_INSTALL_PREFIX=$($(package)_staging_dir)/$(host_prefix) \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_CROSSCOMPILING=on \
+    -DNNG_ENABLE_NNGCAT=off \
+    -DCMAKE_TOOLCHAIN_FILE=$(CMAKE_TOOLCHAIN_FILE) \
+    -DBASEPREFIX=$(BASEPREFIX)
+endef
+
+define $(package)_build_cmds
+  ninja
+endef
+
+define $(package)_stage_cmds
+  ninja install
+endef
diff --git a/depends/packages/packages.mk b/depends/packages/packages.mk
index 4c1b4c106a..7df108439a 100644
--- a/depends/packages/packages.mk
+++ b/depends/packages/packages.mk
@@ -26,5 +26,7 @@ endif
 
 jemalloc_packages = jemalloc
 
+nng_packages=nng
+
 Flatbuffers_packages=Flatbuffers
 Flatbuffers_native_packages=native_Flatbuffers
diff --git a/depends/patches/nng/remove_deps.patch b/depends/patches/nng/remove_deps.patch
new file mode 100644
index 0000000000..953ff40a34
--- /dev/null
+++ b/depends/patches/nng/remove_deps.patch
@@ -0,0 +1,31 @@
