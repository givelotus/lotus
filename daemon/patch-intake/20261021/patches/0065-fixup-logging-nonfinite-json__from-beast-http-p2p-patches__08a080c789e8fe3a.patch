From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:37:09 -0700
Subject: [PATCH] fixup! WIP logging: structured log events with a field
 registry

Emit JSON null for NaN and positive/negative infinity in the shared floating field encoder. Retain finite numeric formatting exactly; human text rendering is unchanged. JSON has no nonfinite number literals. The raw consumer regression deliberately uses an existing field name without claiming producer registry reachability: no registered FLOAT key exists at this point.

Before/after control links actual generic, GCP and ECS encoders: old encoder fails nine JSON parses, corrected encoder passes all 24 assertions. Original-owner test covers generic JSON only to avoid forward references to later GCP/ECS classes; separate format-owner coverage follows. All five native targets build and all logging_event_tests pass on the actual source. This manually authored correctness fix is not a scripted call conversion. Three-way application to original owner succeeds with an isolated Git index.
---
 src/logging/encoder.cpp          | 10 +++++++++-
 src/test/logging_event_tests.cpp | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/src/logging/encoder.cpp b/src/logging/encoder.cpp
index 1942c2fb68..dca116fe37 100644
--- a/src/logging/encoder.cpp
+++ b/src/logging/encoder.cpp
@@ -12,6 +12,7 @@
 #include <cassert>
 #include <charconv>
 #include <chrono>
+#include <cmath>
 
 using util::RemovePrefixView;
 using namespace std::chrono_literals;
@@ -306,10 +307,17 @@ namespace {
         switch (f.kind) {
             case FieldKind::I64:
             case FieldKind::U64:
-            case FieldKind::F64:
             case FieldKind::DURATION_NS:
                 f.AppendText(out);
                 return;
+            case FieldKind::F64:
+                // JSON has no NaN or infinity literals; retain the key as null.
+                if (std::isfinite(f.F64())) {
+                    f.AppendText(out);
+                } else {
+                    out += "null";
+                }
+                return;
             case FieldKind::BOOL:
                 out += f.Bool() ? "true" : "false";
                 return;
diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index f2207c4183..3d9691acdb 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -21,7 +21,9 @@
 
 #include <algorithm>
 #include <chrono>
+#include <cmath>
 #include <fstream>
+#include <limits>
 #include <memory>
 #include <string>
 #include <vector>
@@ -104,6 +106,36 @@ uint256 SomeHash() {
 
 BOOST_FIXTURE_TEST_SUITE(logging_event_tests, EventLogSetup)
 
+BOOST_AUTO_TEST_CASE(nonfinite_float_fields_produce_valid_json) {
+    // Raw consumer fixture: Value supplies a name, not a producer type contract.
+    BCLog::JsonEncoder encoder;
+    const BCLog::LogEventSite site{"numeric_encoding", nullptr, BCLog::ALL,
+                                   BCLog::Level::Info};
+    for (const double value : {1.25, std::numeric_limits<double>::quiet_NaN(),
+                               std::numeric_limits<double>::infinity(),
+                               -std::numeric_limits<double>::infinity()}) {
+        std::array<std::byte, sizeof(BCLog::FieldHeader) + sizeof(value)> data;
+        const BCLog::FieldHeader header{BCLog::FieldId::Value,
+                                        BCLog::FieldKind::F64, false,
+                                        sizeof(value), 0};
+        std::memcpy(data.data(), &header, sizeof(header));
+        std::memcpy(data.data() + sizeof(header), &value, sizeof(value));
+        BCLog::LogLine line{};
+        line.level = BCLog::Level::Info;
+        line.category = BCLog::ALL;
+        line.event = &site;
+        line.fields = BCLog::FieldList{data, 1};
+        std::string encoded;
+        encoder.Encode(line, BCLog::LogOptions{.timestamps = false}, encoded);
+        UniValue record;
+        const bool valid{record.read(encoded)};
+        BOOST_CHECK_MESSAGE(valid, encoded);
+        if (!valid) continue;
+        if (std::isfinite(value)) BOOST_CHECK_EQUAL(record["value"].get_real(), value);
+        else BOOST_CHECK(record["value"].isNull());
+    }
+}
+
 BOOST_AUTO_TEST_CASE(event_text_and_json) {
     const CService addr{LookupNumeric("203.0.113.7", 10605)};
     for (const auto format : {BCLog::LogFormat::TEXT, BCLog::LogFormat::JSON}) {
