From 8fc521a78725b35fc60af7849246439773b71bbf Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 17:00:00 -0700
Subject: [PATCH] Cover Dogecoin block fees beyond the per-transaction money
 bound

Inject independent spendable coins into an isolated native chain fixture and verify full TestBlockValidity accepts12 billion DOGE aggregate fees. The former ABC block-level MoneyRange check incorrectly rejected this Core-valid case. Also cover saturating aggregate accounting beyond int64 and preserve the individual coinbase value cap.

The identical native regression fails two accumulated-fee assertions before e6f37cfa4b and passes afterward, including both excessive coinbase rejection assertions. The >int64 case defines safe local accounting; it does not claim equivalence to signed-overflow behavior in historical Core.

diff --git a/src/test/validation_tests.cpp b/src/test/validation_tests.cpp
index 07766920871693c1fd0e42de47bffc56ad8e92bb..db6e64fcc256be4fe0557f2d21eee2b688e7d7e5 100644
--- a/src/test/validation_tests.cpp
+++ b/src/test/validation_tests.cpp
@@ -6,6 +6,9 @@
 #include <validation.h>
 
 #include <chainparams.h>
+#include <coins.h>
+#include <consensus/validation.h>
+#include <node/context.h>
 #include <common/system.h>
 #include <config.h>
 #include <consensus/amount.h>
@@ -537,4 +540,53 @@ BOOST_AUTO_TEST_CASE(dogecoin_fixed_block_size_limit) {
     BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-blk-length");
 }
 
+// Dogecoin MAX_MONEY bounds one transaction, not the aggregate block fees.
+BOOST_FIXTURE_TEST_CASE(dogecoin_large_block_fees, TestChain100Setup) {
+    LOCK(cs_main);
+    auto &chainstate = m_node.chainman->ActiveChainstate();
+    for (const size_t count : {size_t{2}, size_t{16}}) {
+        std::vector<CMutableTransaction> spends;
+        for (size_t i = 0; i < count; ++i) {
+            CMutableTransaction funding;
+            funding.nLockTime = count * 100 + i;
+            funding.vout.emplace_back(int64_t{6000000000} * COIN + SATOSHI,
+                                      CScript() << OP_DROP << OP_TRUE);
+            const COutPoint outpoint(funding.GetId(), 0);
+            chainstate.CoinsTip().AddCoin(
+                outpoint, Coin(funding.vout[0], 1, false), false);
+            CMutableTransaction spend;
+            spend.vin.emplace_back(outpoint,
+                                   CScript() << std::vector<uint8_t>(80, 0));
+            spend.vout.emplace_back(SATOSHI, CScript() << OP_TRUE);
+            spends.push_back(spend);
+        }
+        // Two transactions exceed MAX_MONEY; sixteen also exceed int64_t.
+        // The ordinary coinbase leaves almost all fees unclaimed.
+        const auto block = CreateBlock(spends, CScript() << OP_TRUE, chainstate);
+        BlockValidationState state;
+        BOOST_CHECK_MESSAGE(
+            TestBlockValidity(state, m_node.chainman->GetParams(), chainstate,
+                              block, chainstate.m_chain.Tip(),
+                              [] { return NodeClock::now(); },
+                              BlockValidationOptions(GetConfig())),
+            state.ToString());
+
+        auto excessive = block;
+        auto coinbase = CMutableTransaction(*excessive.vtx[0]);
+        coinbase.vout[0].nValue = MAX_MONEY + SATOSHI;
+        excessive.vtx[0] = MakeTransactionRef(coinbase);
+        excessive.hashMerkleRoot = BlockMerkleRoot(excessive);
+        excessive.fChecked = false;
+        excessive.m_checked_merkle_root = false;
+        BlockValidationState excessive_state;
+        BOOST_CHECK(!TestBlockValidity(
+            excessive_state, m_node.chainman->GetParams(), chainstate,
+            excessive, chainstate.m_chain.Tip(),
+            [] { return NodeClock::now(); },
+            BlockValidationOptions(GetConfig()).withCheckPoW(false)));
+        BOOST_CHECK_EQUAL(excessive_state.GetRejectReason(),
+                          "bad-txns-vout-toolarge");
+    }
+}
+
 BOOST_AUTO_TEST_SUITE_END()
