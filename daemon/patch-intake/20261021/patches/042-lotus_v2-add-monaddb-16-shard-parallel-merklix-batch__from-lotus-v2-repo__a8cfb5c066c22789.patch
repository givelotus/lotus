+    BOOST_REQUIRE_MESSAGE(store.PrefetchOutpointsAsync(prefetch_ops, err),
+                          err.message);
+
+    for (size_t i = 0; i < 64; ++i) {
+        std::optional<lotus::v2::Coin> found;
+        BOOST_REQUIRE(store.ReadCoin(prefetch_ops[i], found, err));
