+    static TreasuryContenderId ComputeId(const BlockHash &prevblockhash,
+                                         const std::vector<CTxOut> &outputs);
+
+    static TreasuryContenderId fromHex(const std::string &str) {
+        return TreasuryContenderId(uint256S(str));
