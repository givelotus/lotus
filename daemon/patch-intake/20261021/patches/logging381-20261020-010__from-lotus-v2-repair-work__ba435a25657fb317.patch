From 012bb6b5d3f4c8173d317d873f2cac212d538835 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 23:01:42 -0700
Subject: [PATCH] logging(v2): expose typed fee-backed expiry replay undo
 failures

Convert the two undo diagnostics from the V2 fee-backed UTXO-expiry owner to
existing height, block hash and transaction-id fields. Preserve Error severity,
readable text and actual GetId (not serialization GetHash). No changes to
expiry, replay, undo validation, fee accounting or database formats.

Owner: 3c491043cec867e5f00beac01027c9a83023ca5f
Original-Patch: v2/030
Placement: follow that V2 owner; these sites do not exist in shared eCash.

Scripted diff (ast-grep-py 0.51.0; reviewed catalog in this commit):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --rules contrib/logging/conversion/rules/v2-expiry-replay-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/replay-v2-applied.json --apply

Validation: all 15 converter fixtures pass including every catalog mapping and
exact readable text/severity/category. Second invocation has empty diff,
structured event lint and git diff --check pass. Native syntax and full
Logger/runtime remain pending; no runtime undo-failure coverage claimed.
---
 .../rules/v2-expiry-replay-diagnostics.json   | 52 +++++++++++++++++++
 src/validation.cpp                            | 14 +++--
 2 files changed, 61 insertions(+), 5 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/v2-expiry-replay-diagnostics.json

diff --git a/contrib/logging/conversion/rules/v2-expiry-replay-diagnostics.json b/contrib/logging/conversion/rules/v2-expiry-replay-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..0651b5d9690984f08edd93f7205f22b05b33416c
--- /dev/null
+++ b/contrib/logging/conversion/rules/v2-expiry-replay-diagnostics.json
@@ -0,0 +1,52 @@
+{
+  "schema": 1,
+  "batch": "v2-expiry-replay-diagnostics",
+  "review_note": "Two V2 fee-backed UTXO expiry undo diagnostics; source owner3c491043cec / Original-Patch v2/030. This conversion must follow that owner, not the shared tier.",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "chain_replay_undo_inconsistent",
+          "old": "LogError(\"ReplayBlock(): missing or inconsistent undo at %d, hash=%s\\n\",\n                 pindex->nHeight, pindex->GetBlockHash().ToString())",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"chain_replay_undo_inconsistent\",\n            \"ReplayBlock(): missing or inconsistent undo at {height}, hash={block_hash}\")\n            .Field(BCLog::LogField::Height, pindex->nHeight)\n            .Field(BCLog::LogField::BlockHash, pindex->GetBlockHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "ReplayBlock(): missing or inconsistent undo at %d, hash=%s\n",
+            "specifiers": [
+              "%d",
+              "%s"
+            ],
+            "arguments": [
+              "pindex->nHeight",
+              "pindex->GetBlockHash().ToString()"
+            ]
+          },
+          "review_note": "Preserve original Error/Info severity, ALL category, readable text, argument order and replay/rollback control flow. Height copies the same integer; BlockHash and TxId copy the original GetBlockHash/GetId rather than producer-side ToString. Transaction identifier is GetId (never GetHash); no replay, undo, fee or UTXO logic is changed. Existing fields/API only. V2 undo diagnostics belong after3c491043cec (Original-Patch v2/030); shared replay sites belong in the shared tier."
+        },
+        {
+          "id": "chain_replay_transaction_undo_inconsistent",
+          "old": "LogError(\"ReplayBlock(): inconsistent transaction undo at %d, \"\n                     \"hash=%s, tx=%s\\n\", pindex->nHeight,\n                     pindex->GetBlockHash().ToString(), tx.GetId().ToString())",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"chain_replay_transaction_undo_inconsistent\",\n                \"ReplayBlock(): inconsistent transaction undo at {height}, hash={block_hash}, tx={txid}\")\n                .Field(BCLog::LogField::Height, pindex->nHeight)\n                .Field(BCLog::LogField::BlockHash, pindex->GetBlockHash())\n                .Field(BCLog::LogField::TxId, tx.GetId())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "ReplayBlock(): inconsistent transaction undo at %d, hash=%s, tx=%s\n",
+            "specifiers": [
+              "%d",
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "pindex->nHeight",
+              "pindex->GetBlockHash().ToString()",
+              "tx.GetId().ToString()"
+            ]
+          },
+          "review_note": "Preserve original Error/Info severity, ALL category, readable text, argument order and replay/rollback control flow. Height copies the same integer; BlockHash and TxId copy the original GetBlockHash/GetId rather than producer-side ToString. Transaction identifier is GetId (never GetHash); no replay, undo, fee or UTXO logic is changed. Existing fields/API only. V2 undo diagnostics belong after3c491043cec (Original-Patch v2/030); shared replay sites belong in the shared tier."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/validation.cpp b/src/validation.cpp
index 929d62f0b4fc3f4106ac3c869ed752a056b34674..81f5e1aff8d6e7384d0f5a3954b173cab86900a1 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -8456,8 +8456,10 @@ bool Chainstate::RollforwardBlock(const CBlockIndex *pindex,
     CBlockUndo undo;
     if (!m_blockman.ReadBlockUndo(undo, *pindex) || block.vtx.empty() ||
         undo.vtxundo.size() != block.vtx.size() - 1) {
-        LogError("ReplayBlock(): missing or inconsistent undo at %d, hash=%s\n",
-                 pindex->nHeight, pindex->GetBlockHash().ToString());
+        LogErrorEvent(BCLog::ALL, "chain_replay_undo_inconsistent",
+            "ReplayBlock(): missing or inconsistent undo at {height}, hash={block_hash}")
+            .Field(BCLog::LogField::Height, pindex->nHeight)
+            .Field(BCLog::LogField::BlockHash, pindex->GetBlockHash());
         return false;
     }
     std::vector<uint64_t> fee_shares(block.vtx.size(), 0);
@@ -8469,9 +8471,11 @@ bool Chainstate::RollforwardBlock(const CBlockIndex *pindex,
         if (spent.size() != tx.vin.size() ||
             !Consensus::CheckTxInputsFromSpentCoins(
                 tx, spent, state, pindex->nHeight, fee)) {
-            LogError("ReplayBlock(): inconsistent transaction undo at %d, "
-                     "hash=%s, tx=%s\n", pindex->nHeight,
-                     pindex->GetBlockHash().ToString(), tx.GetId().ToString());
+            LogErrorEvent(BCLog::ALL, "chain_replay_transaction_undo_inconsistent",
+                "ReplayBlock(): inconsistent transaction undo at {height}, hash={block_hash}, tx={txid}")
+                .Field(BCLog::LogField::Height, pindex->nHeight)
+                .Field(BCLog::LogField::BlockHash, pindex->GetBlockHash())
+                .Field(BCLog::LogField::TxId, tx.GetId());
             return false;
         }
         size_t spendable_outputs = 0;
