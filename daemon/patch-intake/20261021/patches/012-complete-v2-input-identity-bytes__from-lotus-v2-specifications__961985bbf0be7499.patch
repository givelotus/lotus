From 4c96b284423d0fcdc08f490f9af50954ae9e6dc1 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 14:29:49 -0700
Subject: [PATCH] 012-complete-v2-input-identity-bytes

Include full input serialization in transaction identities and retain regression coverage, from ce989574201b1b8c36886f38b219683e97184e95.
---
 src/lotus_v2/test_transaction.cpp |  4 ++++
 src/lotus_v2/transaction.cpp      | 10 ++++++++++
 src/lotus_v2/transaction.h        |  2 ++
 3 files changed, 16 insertions(+)

diff --git a/src/lotus_v2/test_transaction.cpp b/src/lotus_v2/test_transaction.cpp
index 09a846330..4c8a8373f 100644
--- a/src/lotus_v2/test_transaction.cpp
+++ b/src/lotus_v2/test_transaction.cpp
@@ -67,6 +67,10 @@ void FixedPayment() {
     CHECK(EncodeInputCore(tx.inputs[0], PROFILE, core, error));
     CHECK(core ==
           FromHex(std::string(64, '1') + "00000000ffffffff010001014e00"));
+    std::vector<uint8_t> full_input;
+    CHECK(EncodeInputFull(tx.inputs[0], PROFILE, full_input, error));
+    CHECK(std::equal(full_input.begin(), full_input.end(), wire.begin() + 16));
+    CHECK(full_input != core);
     tx.inputs[0].witnesses[0].arguments[0] = {'b'};
     std::vector<uint8_t> mutated;
     CHECK(EncodeTransaction(tx, PROFILE, mutated, error));
diff --git a/src/lotus_v2/transaction.cpp b/src/lotus_v2/transaction.cpp
index 7291e946e..903379eec 100644
--- a/src/lotus_v2/transaction.cpp
+++ b/src/lotus_v2/transaction.cpp
@@ -324,6 +324,16 @@ bool EncodeInputCore(const Input &input, const TxProfile &profile,
     return true;
 }
 
+bool EncodeInputFull(const Input &input, const TxProfile &profile,
+                     std::vector<uint8_t> &result, std::string &error) {
+    if (!ValidProfile(profile, error)) return false;
+    std::vector<uint8_t> encoded;
+    if (!InputWire(input, profile, false, encoded, error)) return false;
+    result = std::move(encoded);
+    error.clear();
+    return true;
+}
+
 bool EncodeTransaction(const Transaction &tx, const TxProfile &profile,
                        std::vector<uint8_t> &result, std::string &error) {
     if (!ValidProfile(profile, error)) return false;
diff --git a/src/lotus_v2/transaction.h b/src/lotus_v2/transaction.h
index e34906574..7a25e4cf8 100644
--- a/src/lotus_v2/transaction.h
+++ b/src/lotus_v2/transaction.h
@@ -56,6 +56,8 @@ bool EncodeTransaction(const Transaction &tx, const TxProfile &profile,
                        std::vector<uint8_t> &result, std::string &error);
 bool EncodeInputCore(const Input &input, const TxProfile &profile,
                      std::vector<uint8_t> &result, std::string &error);
+bool EncodeInputFull(const Input &input, const TxProfile &profile,
+                     std::vector<uint8_t> &result, std::string &error);
 bool CheckCoinbaseContext(const Transaction &tx, const Hash32 &parent_block_id,
                           uint64_t height, std::string &error);
 
