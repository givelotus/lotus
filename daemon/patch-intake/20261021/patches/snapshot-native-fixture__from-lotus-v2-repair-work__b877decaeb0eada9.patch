From 27e8bd1d879c53f803efbdc94b6287d344b6de9a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 10:58:15 -0700
Subject: [PATCH] fixup! test(v2): validate native RPC snapshots and kernel
 throughput

Adapt the RPC read snapshot suite to genuine native funding and branch-witness admission. Mine100 real accepted regtest coinbases to native OP_1 (0x4e), spend the mature coin through ProcessTransaction and retain every lock/coherence, confirmed height and spent/unspent oracle. This suite tests RPC concurrency, not signatures. Keep shared TestChain100Setup and signing helpers unchanged. Original isolated case aborts at legacy SignTransaction after canonical output decoding; repaired isolated case passes227assertions. Native test owner follows the native miner/RPC integration required by this fixture.
---
 src/test/rpc_snapshot_read_tests.cpp | 63 +++++++++++++++++++++++++---
 1 file changed, 58 insertions(+), 5 deletions(-)

diff --git a/src/test/rpc_snapshot_read_tests.cpp b/src/test/rpc_snapshot_read_tests.cpp
index d8ed21085d1062ce6572d2b7ef116bbe9d0fca9a..12013f3882333dc3c09aea51609400fd9ba37590 100644
--- a/src/test/rpc_snapshot_read_tests.cpp
+++ b/src/test/rpc_snapshot_read_tests.cpp
@@ -8,7 +8,9 @@
 #include <core_io.h>
 #include <kernel/disconnected_transactions.h>
 #include <key_io.h>
+#include <lotus_v2/commitment.h>
 #include <minerfund.h>
+#include <node/miner.h>
 #include <node/snapshot.h>
 #include <pow/pow.h>
 #include <primitives/block.h>
@@ -20,6 +22,7 @@
 #include <txmempool.h>
 #include <univalue.h>
 #include <util/strencodings.h>
+#include <util/time.h>
 #include <validation.h>
 
 #include <boost/asio/co_spawn.hpp>
@@ -35,7 +38,39 @@
 #include <thread>
 #include <vector>
 
-BOOST_FIXTURE_TEST_SUITE(rpc_snapshot_read_tests, TestChain100Setup)
+namespace {
+// RPC lock/coherence coverage needs spendable native coins, not legacy signing.
+struct NativeSnapshotChainSetup : TestingSetup {
+    const std::vector<uint8_t> program{0x4e}; // Lotus V2 OP_1.
+    std::vector<CTransactionRef> m_coinbase_txns;
+
+    NativeSnapshotChainSetup() : TestingSetup(ChainType::REGTEST) {
+        SetMockTime(1598887952);
+        const auto &config = GetConfig();
+        const auto &consensus = config.GetChainParams().GetConsensus();
+        const CScript destination(program.begin(), program.end());
+        for (int height = 1; height <= COINBASE_MATURITY; ++height) {
+            auto block = node::BlockAssembler(
+                             config, m_node.chainman->ActiveChainstate(), nullptr)
+                             .CreateNewBlock(destination)->block;
+            while (!CheckProofOfWork(block.GetHash(), block.nBits, consensus)) {
+                ++block.nNonce;
+            }
+            BOOST_REQUIRE(m_node.chainman->ProcessNewBlock(
+                std::make_shared<const CBlock>(block), true, true, nullptr));
+            BOOST_REQUIRE_EQUAL(
+                WITH_LOCK(cs_main, return m_node.chainman->ActiveTip()->nHeight),
+                height);
+            m_coinbase_txns.push_back(block.vtx[0]);
+            SetMockTime(GetTime() + 1);
+        }
+    }
+
+    ~NativeSnapshotChainSetup() { SetMockTime(0); }
+};
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(rpc_snapshot_read_tests, NativeSnapshotChainSetup)
 
 BOOST_AUTO_TEST_CASE(lockfree_rpc_reads_while_cs_main_and_mempool_locked) {
     GlobalConfig config;
@@ -51,10 +86,28 @@ BOOST_AUTO_TEST_CASE(lockfree_rpc_reads_while_cs_main_and_mempool_locked) {
         return call_rpc_params(method, UniValue(UniValue::VARR));
     };
 
-    CScript pubKeyScript = GetScriptForRawPubKey(coinbaseKey.GetPubKey());
-    CMutableTransaction mempool_mtx = CreateValidMempoolTransaction(
-        m_coinbase_txns[0], 0, 1, coinbaseKey, pubKeyScript,
-        50 * COIN - 1000 * SATOSHI, /*submit=*/true);
+    CMutableTransaction mempool_mtx;
+    mempool_mtx.nVersion = 7;
+    mempool_mtx.fHasV2Lock = true;
+    mempool_mtx.nV2Lock = 0;
+    CTxIn input(COutPoint(m_coinbase_txns[0]->GetId(), 0));
+    input.nFlags = 1;
+    input.nPathIndex = 0;
+    lotus::v2::BranchWitness witness;
+    witness.script = program;
+    input.vWitnesses = {witness};
+    mempool_mtx.vin.push_back(std::move(input));
+    auto output = m_coinbase_txns[0]->vout[0].ToV2Output();
+    output.value -= 1000;
+    mempool_mtx.vout.push_back(CTxOut::FromV2Output(output));
+    {
+        LOCK(cs_main);
+        const auto accepted = m_node.chainman->ProcessTransaction(
+            MakeTransactionRef(mempool_mtx));
+        BOOST_REQUIRE_MESSAGE(
+            accepted.m_result_type == MempoolAcceptResult::ResultType::VALID,
+            accepted.m_state.ToString());
+    }
     const std::string mempool_txid = mempool_mtx.GetId().GetHex();
     const std::string confirmed_txid = m_coinbase_txns[1]->GetId().GetHex();
     const std::string spent_cb_txid = m_coinbase_txns[0]->GetId().GetHex();
