From 0d8588ff21c6606403f79c7ecfcac2683b152fcd Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:36:52 -0700
Subject: [PATCH] Exercise AuxPoW only after canonical regtest activation

Use final Doged reference AuxPoW fixture at 9690833b8b with current hash_int/hash_hex and txid_int APIs. Mine nineteen ordinary modern-version Scrypt blocks before commitment rejection and acceptance cases at heights20/21. Move competing-fork and Chronik rollback checks to the same activation boundary, retaining parity for ordinary headers before20. No test-only activation bypass is introduced.

diff --git a/test/functional/chronik_dogecoin_reorg.py b/test/functional/chronik_dogecoin_reorg.py
index 8a2aa746c20e591b864d76de04ffa3852681709a..1ac3312ddc71ce61cf5612bd37198af1b89e73cf 100644
--- a/test/functional/chronik_dogecoin_reorg.py
+++ b/test/functional/chronik_dogecoin_reorg.py
@@ -27,7 +27,7 @@ class ChronikDogecoinReorgTest(DogecoinAuxpowTest):
             block = CBlock()
             block.deserialize(io.BytesIO(bytes.fromhex(node.getblock(block_hash, 0))))
             header = CBlockHeader(block).serialize()
-            if h:
+            if h >= 20:
                 assert len(header) > 80
             assert_equal(chronik.block_header(h).ok().raw_header, header)
             indexed = chronik.block_txs(h).ok().txs
@@ -54,35 +54,35 @@ class ChronikDogecoinReorgTest(DogecoinAuxpowTest):
         super().run_test()
         node = self.nodes[0]
         tip = node.getbestblockhash()
-        first = node.getblockhash(1)
-        self.check_parity(2)
+        first = node.getblockhash(20)
+        self.check_parity(21)
         node.invalidateblock(tip)
-        assert_equal(node.getblockcount(), 1)
-        self.check_parity(1)
+        assert_equal(node.getblockcount(), 20)
+        self.check_parity(20)
         node.reconsiderblock(tip)
         assert_equal(node.getbestblockhash(), tip)
-        self.check_parity(2)
+        self.check_parity(21)
         node.invalidateblock(first)
-        assert_equal(node.getblockcount(), 0)
-        self.check_parity(0)
+        assert_equal(node.getblockcount(), 19)
+        self.check_parity(19)
         node.reconsiderblock(first)
         assert_equal(node.getbestblockhash(), tip)
-        self.check_parity(2)
+        self.check_parity(21)
         # Competing longer AuxPoW fork, followed by a rollback to the original.
         timestamp = node.getblockheader(tip)["time"]
         node.invalidateblock(tip)
-        fork2 = self.fork_block(first, 2, timestamp + 1)
-        fork3 = self.fork_block(fork2, 3, timestamp + 2)
+        fork2 = self.fork_block(first, 21, timestamp + 1)
+        fork3 = self.fork_block(fork2, 22, timestamp + 2)
         node.reconsiderblock(tip)
         assert_equal(node.getbestblockhash(), fork3)
-        self.check_parity(3)
+        self.check_parity(22)
         node.invalidateblock(fork2)
         assert_equal(node.getbestblockhash(), tip)
-        self.check_parity(2)
+        self.check_parity(21)
         assert_equal(node.verifychain(4, 0), True)
         self.restart_node(0)
         assert_equal(node.getbestblockhash(), tip)
-        self.check_parity(2)
+        self.check_parity(21)
 
 if __name__ == '__main__':
     ChronikDogecoinReorgTest().main()
diff --git a/test/functional/dogecoin_auxpow.py b/test/functional/dogecoin_auxpow.py
index 0dc205deb2849ab11cdc787d1bfe92099f4e1f7f..2b8143ed1c20812568942935e3a0c7ab897e738c 100644
--- a/test/functional/dogecoin_auxpow.py
+++ b/test/functional/dogecoin_auxpow.py
@@ -41,16 +41,24 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         mocktime = int(time.time())
         node.setmocktime(mocktime)
 
-        height = 1
+        # Mine ordinary Scrypt blocks up to the canonical regtest AuxPoW height.
+        for height in range(1, 20):
+            ordinary = create_block(
+                int(node.getbestblockhash(), 16), create_coinbase(height),
+                mocktime + height,
+            )
+            ordinary.nVersion = VERSION_CHAIN_ID_BITS | 4
+            ordinary.solve()
+            assert_equal(node.submitblock(ordinary.serialize().hex()), None)
+
+        height = 20
         coinbase_tx = create_coinbase(height)
         coinbase_tx.vout[0].scriptPubKey = P2SH_OP_TRUE
-        coinbase_tx.rehash()
         block = create_block(
             int(node.getbestblockhash(), 16), coinbase_tx, mocktime + 1100
         )
         block.nVersion = VERSION_CHAIN_ID_BITS | VERSION_AUXPOW_BIT | 5
-        block.rehash()
-        block_hash = bytes.fromhex(block.hash)
+        block_hash = bytes.fromhex(block.hash_hex)
 
         # nIndex = 1 not allowed
         block.auxpow = CAuxPow()
@@ -78,16 +86,14 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
 
         # Coinbase tx has no inputs
         block.auxpow = CAuxPow()
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(["AuxPow coinbase transaction missing input"]):
             assert_equal(node.submitblock(block.serialize().hex()), "high-hash")
 
         # Chain merkle root not found in coinbase scriptSig
         block.auxpow = CAuxPow()
         block.auxpow.coinbaseTx.vin = [CTxIn()]
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(
             ["AuxPow missing chain merkle root in parent coinbase"]
         ):
@@ -97,8 +103,7 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         block.auxpow = CAuxPow()
         coinbase_script = CScript(MERGE_MINE_PREFIX + MERGE_MINE_PREFIX + block_hash)
         block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), coinbase_script)]
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(["Multiple merged mining prefixes in coinbase"]):
             assert_equal(node.submitblock(block.serialize().hex()), "high-hash")
 
@@ -106,8 +111,7 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         block.auxpow = CAuxPow()
         coinbase_script = CScript(MERGE_MINE_PREFIX + b"hola" + block_hash)
         block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), coinbase_script)]
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(
             ["Merged mining prefix is not just before chain merkle root"]
         ):
@@ -117,8 +121,7 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         block.auxpow = CAuxPow()
         coinbase_script = CScript(bytes(21) + block_hash)
         block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), coinbase_script)]
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(
             [
                 "AuxPow chain merkle root can have at most 20 preceding bytes of the parent coinbase"
@@ -130,8 +133,7 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         block.auxpow = CAuxPow()
         coinbase_script = CScript(MERGE_MINE_PREFIX + block_hash)
         block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), coinbase_script)]
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(
             ["AuxPow missing chain merkle tree size and nonce in parent coinbase"]
         ):
@@ -141,8 +143,7 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         block.auxpow = CAuxPow()
         coinbase_script = CScript(block_hash)
         block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), coinbase_script)]
-        block.auxpow.coinbaseTx.rehash()
-        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.sha256
+        block.auxpow.parentBlock.hashMerkleRoot = block.auxpow.coinbaseTx.txid_int
         with node.assert_debug_log(
             ["AuxPow missing chain merkle tree size and nonce in parent coinbase"]
         ):
@@ -154,8 +155,7 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
             MERGE_MINE_PREFIX + block_hash + b"\xff\xff\xff\xff\xff\xff\xff\xff"
         )
         block.auxpow.coinbaseTx.vin = [CTxIn(COutPoint(), coinbase_script)]
