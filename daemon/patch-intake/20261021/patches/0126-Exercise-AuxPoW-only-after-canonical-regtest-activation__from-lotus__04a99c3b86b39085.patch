         target = uint256_from_compact(block.nBits)
@@ -181,17 +180,15 @@ class DogecoinAuxpowTest(BitcoinTestFramework):
         # Success!
         block.solve()
         assert_equal(node.submitblock(block.serialize().hex()), None)
-        assert_equal(node.getbestblockhash(), block.hash)
