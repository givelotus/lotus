From 3638a64a9b471115cb599d6386cf94f9ec56806d Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 21:32:56 -0700
Subject: [PATCH] fixup! feat(v2): add built-in lotusd decentralized share-pool
 coordinator and P2P sharerelay

Check actual typed coinbase payout commitments with CoinbaseOutputPaysScript before and after wire round trip, preserving identity, hash, full-output and serialized-job equality assertions. Focused mining-pool5cases pass.

Tier: V2
---
 src/test/mining_pool_tests.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/test/mining_pool_tests.cpp b/src/test/mining_pool_tests.cpp
index b7d8e2cdb4..b4b20ec3af 100644
--- a/src/test/mining_pool_tests.cpp
+++ b/src/test/mining_pool_tests.cpp
@@ -2,6 +2,7 @@
 // Distributed under the MIT software license, see the accompanying
 // file COPYING or http://www.opensource.org/licenses/mit-license.php.
 
+#include <primitives/v2_outputs.h>
 #include <node/mining_pool.h>
 
 #include <arith_uint256.h>
@@ -322,8 +323,8 @@ BOOST_AUTO_TEST_CASE(coinbase_outputs_survive_wire_round_trip) {
     BOOST_CHECK_EQUAL(decoded.GetHash(), coinbase.GetHash());
     BOOST_REQUIRE_EQUAL(decoded.vout.size(), coinbase.vout.size());
     BOOST_REQUIRE(!coinbase.vout.empty());
-    BOOST_CHECK(coinbase.vout[0].scriptPubKey == payout);
-    BOOST_CHECK(decoded.vout[0].scriptPubKey == payout);
+    BOOST_CHECK(CoinbaseOutputPaysScript(coinbase.vout[0], payout));
+    BOOST_CHECK(CoinbaseOutputPaysScript(decoded.vout[0], payout));
     BOOST_CHECK_EQUAL(job.find_value("coinbase_tx_hex").get_str(), EncodeHexTx(coinbase));
     for (size_t i = 0; i < coinbase.vout.size(); ++i) {
         BOOST_CHECK(decoded.vout[i].scriptPubKey == coinbase.vout[i].scriptPubKey);
-- 
