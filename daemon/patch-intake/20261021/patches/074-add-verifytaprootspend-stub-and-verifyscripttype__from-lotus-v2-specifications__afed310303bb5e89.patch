+static bool VerifyTaprootSpend(std::vector<valtype> stack,
+                               const CScript &script_sig,
+                               const CScript &script_pubkey, uint32_t flags,
+                               const BaseSignatureChecker &checker,
+                               ScriptExecutionMetrics &metrics,
