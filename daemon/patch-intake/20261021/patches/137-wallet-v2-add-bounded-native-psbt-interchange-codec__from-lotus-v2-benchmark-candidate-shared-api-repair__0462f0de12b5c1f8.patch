@@ -0,0 +1,81 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see COPYING.
+#ifndef LOTUS_V2_PSBT_H
+#define LOTUS_V2_PSBT_H
+
+#include "psbt_map.h"
+#include "signing.h"
+#include "sparse_state.h"
+
+#include <compare>
+#include <map>
+#include <optional>
+#include <span>
+
+namespace lotus::v2 {
+
+constexpr uint32_t NATIVE_PSBT_VERSION = 0x4c560001;
+constexpr size_t MAX_NATIVE_PSBT_BYTES = 16777216;
+constexpr size_t MAX_NATIVE_PSBT_KEY_BYTES = 1024;
+constexpr size_t MAX_NATIVE_PSBT_VALUE_BYTES = 8388608;
+constexpr size_t MAX_NATIVE_PSBT_MAP_ENTRIES = 4096;
+
+using PsbtBytes = psbt_detail::Bytes;
+using PsbtMap = psbt_detail::Map;
+using PsbtArguments = std::vector<PsbtBytes>;
+
+struct PsbtSlot {
+    uint16_t witness{};
+    uint16_t argument{};
+    auto operator<=>(const PsbtSlot &) const = default;
+};
+
+struct PsbtSignRequest {
+    uint8_t scheme{};
+    uint8_t mode{};
+    PsbtBytes public_key;
+};
+
+struct NativePsbtInput {
+    std::optional<Coin> coin;
+    std::optional<CoinProof> proof;
+    std::map<uint16_t, PsbtArguments> arguments;
+    std::map<PsbtSlot, PsbtSignRequest> requests;
+    std::map<PsbtSlot, PsbtBytes> signatures;
+    std::map<uint16_t, PsbtArguments> final_arguments;
+};
+
+struct NativePsbtData {
+    ChainId chain_id{};
+    Transaction tx_template;
+    std::optional<Hash> utxo_root;
+    std::vector<NativePsbtInput> inputs;
+};
+
+// Maps remain lossless, including opaque proprietary fields. Every operation
+// validates them anew; callers cannot bypass schema checks through mutation.
+struct NativePsbt {
+    PsbtMap global;
+    std::vector<PsbtMap> inputs;
+    std::vector<PsbtMap> outputs;
+
+    bool Inspect(NativePsbtData &result, std::string &error) const;
+    bool Serialize(PsbtBytes &result, std::string &error) const;
+    bool Merge(const NativePsbt &other, std::string &error);
+};
+
+bool DecodeNativePsbt(std::span<const uint8_t> wire, NativePsbt &result,
+                      std::string &error);
+bool CreateNativePsbt(const Transaction &tx_template, const ChainId &chain_id,
+                      NativePsbt &result, std::string &error);
+
+// Keys/arguments use only the exact profile registry. These helpers do not
+// claim that supplied coins, roots, origins or policies are authenticated.
+PsbtBytes NativePsbtKey(uint64_t subtype,
+                        std::span<const uint8_t> keydata = {});
+PsbtBytes EncodePsbtArguments(const PsbtArguments &arguments);
+PsbtBytes EncodePsbtWitness(uint16_t witness);
+PsbtBytes EncodePsbtSlot(PsbtSlot slot);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/psbt_map.h b/src/lotus_v2/psbt_map.h
new file mode 100644
index 0000000000000000000000000000000000000000..1f70f760fffa4d64187f092b49a99157d5e34ead
--- /dev/null
+++ b/src/lotus_v2/psbt_map.h
@@ -0,0 +1,156 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see COPYING.
+#ifndef LOTUS_V2_PSBT_MAP_H
+#define LOTUS_V2_PSBT_MAP_H
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace lotus::v2::psbt_detail {
+
+using Bytes = std::vector<uint8_t>;
+using Map = std::map<Bytes, Bytes>;
+
+// BIP174 maps use canonical CompactSize lengths and byte-string keys. Keep
+// unknown keys and values opaque; decoding never normalizes their payloads.
+class Reader {
+    std::span<const uint8_t> bytes_;
+    size_t pos_{};
+
+public:
+    explicit Reader(std::span<const uint8_t> bytes) : bytes_(bytes) {}
+    size_t Remaining() const { return bytes_.size() - pos_; }
+    bool Empty() const { return Remaining() == 0; }
+
+    bool Integer(size_t width, uint64_t &value) {
+        if (width > 8 || width > Remaining()) return false;
+        value = 0;
+        for (size_t i = 0; i < width; ++i) {
+            value |= uint64_t(bytes_[pos_++]) << (8 * i);
+        }
+        return true;
+    }
+
+    bool Compact(uint64_t &value) {
+        uint64_t lead;
+        if (!Integer(1, lead)) return false;
+        if (lead < 253) {
+            value = lead;
+            return true;
+        }
+        const size_t width = lead == 253 ? 2 : lead == 254 ? 4 : 8;
+        return Integer(width, value) && (width == 2   ? value >= 253
+                                         : width == 4 ? value > 0xffff
+                                                      : value > 0xffffffff);
+    }
+
+    bool Blob(size_t count, Bytes &value) {
+        if (count > Remaining()) return false;
+        value.assign(bytes_.begin() + pos_, bytes_.begin() + pos_ + count);
+        pos_ += count;
+        return true;
+    }
+
+    bool Vector(size_t limit, Bytes &value) {
+        uint64_t count;
+        return Compact(count) && count <= limit && count <= Remaining() &&
+               Blob(static_cast<size_t>(count), value);
+    }
+
+    bool ReadMap(Map &result, size_t max_key, size_t max_value,
+                 size_t max_entries, std::string &error) {
+        Map parsed;
+        while (!Empty()) {
+            Bytes key;
+            if (!Vector(max_key, key)) {
+                error = "invalid PSBT key length";
+                return false;
+            }
+            if (key.empty()) {
+                result = std::move(parsed);
+                error.clear();
+                return true;
+            }
+            // A key's type itself is CompactSize, including unknown types.
+            Reader type_reader(key);
+            uint64_t type;
+            if (!type_reader.Compact(type)) {
+                error = "invalid PSBT key type";
+                return false;
+            }
+            Bytes value;
+            if (!Vector(max_value, value)) {
+                error = "invalid PSBT value length";
+                return false;
+            }
+            if (parsed.size() >= max_entries) {
+                error = "too many PSBT map entries";
+                return false;
+            }
+            if (!parsed.emplace(std::move(key), std::move(value)).second) {
+                error = "duplicate PSBT key";
+                return false;
+            }
+        }
+        error = "missing PSBT map separator";
+        return false;
+    }
+};
+
+inline void Integer(uint64_t value, size_t width, Bytes &result) {
+    for (size_t i = 0; i < width; ++i) {
+        result.push_back(uint8_t(value >> (8 * i)));
+    }
+}
+
+inline void Compact(uint64_t value, Bytes &result) {
+    if (value < 253) {
+        Integer(value, 1, result);
+    } else {
+        result.push_back(value <= 0xffff       ? 253
+                         : value <= 0xffffffff ? 254
+                                               : 255);
+        Integer(value,
+                value <= 0xffff       ? 2
+                : value <= 0xffffffff ? 4
+                                      : 8,
+                result);
+    }
+}
+
+inline void Vector(std::span<const uint8_t> bytes, Bytes &result) {
+    Compact(bytes.size(), result);
+    result.insert(result.end(), bytes.begin(), bytes.end());
+}
+
+inline void WriteMap(const Map &map, Bytes &result) {
+    for (const auto &[key, value] : map) {
+        Vector(key, result);
+        Vector(value, result);
+    }
+    result.push_back(0);
+}
+
+// Combiner conflicts are errors even for fields this implementation does not
+// understand. Stage into a copy so a failed combine cannot partially mutate.
+inline bool MergeMap(Map &target, const Map &source, std::string &error) {
+    Map merged = target;
+    for (const auto &[key, value] : source) {
+        auto [it, added] = merged.emplace(key, value);
+        if (!added && it->second != value) {
+            error = "conflicting PSBT map value";
+            return false;
+        }
+    }
+    target = std::move(merged);
+    error.clear();
+    return true;
+}
+
+} // namespace lotus::v2::psbt_detail
+#endif
diff --git a/src/lotus_v2/psbt_test/check_vectors.py b/src/lotus_v2/psbt_test/check_vectors.py
new file mode 100644
index 0000000000000000000000000000000000000000..0db99858ae842977701d20e7f36ca59b28f969db
--- /dev/null
+++ b/src/lotus_v2/psbt_test/check_vectors.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Check the C++ codec against independent specification schema fixtures.
+
+Vector provenance: lotus-v2 specification commits d8a3b859 and 6305e947, examples/
+psbt-profile-vectors.json. These shape-only fixtures do not authenticate
+coins or demonstrate valid signatures or VM execution.
+"""
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def main():
+    fixtures = json.loads(Path(__file__).with_name("profile_vectors.json").read_text())
+    total = 0
+    for kind in ("positive", "negative"):
+        for fixture in fixtures[kind]:
+            result = subprocess.run(
+                [sys.argv[1], "--roundtrip", fixture["hex"]],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            if kind == "positive":
+                assert result.returncode == 0, (fixture["name"], result.stderr)
+                assert result.stdout.strip() == fixture.get(
+                    "canonical_hex", fixture["hex"]
+                ), fixture["name"]
+            else:
+                assert result.returncode != 0, fixture["name"]
+            total += 1
+    print(f"{total} independent native PSBT schema vectors passed")
+
+
+if __name__ == "__main__":
+    main()
