 src/serialize.h                       |  11 +-
 src/support/allocators/chunked_slab.h | 247 ++++++++++++++++++++++++++
 src/test/allocator_tests.cpp          |  99 +++++++++++
 src/test/mempool_tests.cpp            | 125 +++++++++++++
 5 files changed, 499 insertions(+), 3 deletions(-)

