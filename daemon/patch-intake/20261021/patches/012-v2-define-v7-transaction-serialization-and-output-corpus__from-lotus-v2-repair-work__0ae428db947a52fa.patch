diff --git a/src/lotus_v2/output_test/generate_reference_corpus.py b/src/lotus_v2/output_test/generate_reference_corpus.py
new file mode 100644
index 0000000000000000000000000000000000000000..a879434af038eb5c75e3abd0d1c2b52063b1bb9a
--- /dev/null
+++ b/src/lotus_v2/output_test/generate_reference_corpus.py
@@ -0,0 +1,30 @@
+"""Emit deterministic valid output wires from the independent Python reference."""
+
+import random
+import sys
+
+from lotus_v2_reference.encoding import Output, Profile, encode_output
+
+
+def main() -> None:
+    random_source = random.Random(0x1A705)
+    profile = Profile(16, 16, 812, 8192)
+    for _ in range(256):
+        branch_count = random_source.randrange(1, 17)
+        roots = tuple(bytes([i]) + random_source.randbytes(31) for i in range(branch_count))
+        flags = random_source.randrange(4)
+        token_id = (b"\x01" + random_source.randbytes(31)) if flags & 1 else None
+        if flags & 2:
+            paths = ()
+        else:
+            candidates = set()
+            for _ in range(random_source.randrange(1, 17)):
+                indices = tuple(sorted(random_source.sample(range(branch_count), random_source.randrange(1, branch_count + 1))))
+                candidates.add(indices)
+            paths = tuple(sorted(candidates))
+        output = Output(flags, random_source.getrandbits(64), token_id, roots, paths)
+        print(encode_output(output, profile).hex())
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/lotus_v2/output_test/generate_transaction_corpus.py b/src/lotus_v2/output_test/generate_transaction_corpus.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c9c3b7c778cac1836489759eea8a33bb0240c30
--- /dev/null
+++ b/src/lotus_v2/output_test/generate_transaction_corpus.py
@@ -0,0 +1,40 @@
+"""Deterministic ordinary/mint wire corpus from the independent Python codec.
+
+Set PYTHONPATH to the monorepo's tools/lotus-v2-reference directory.
+"""
+
+import random
+
+from lotus_v2_reference.encoding import Output, Profile
+from lotus_v2_reference.transaction import (
+    BranchWitness, Input, Transaction, TxProfile, encode_transaction,
+)
+
+
+def main() -> None:
+    rng = random.Random(0x7A705)
+    profile = TxProfile(Profile(16, 16, 812, 8192), 32, 32, 8, 8192, 16, 8192, 64)
+    for row in range(128):
+        inputs = []
+        for index in range(rng.randrange(1, 4)):
+            previous = bytes([row + 1, index + 1]) + rng.randbytes(30)
+            witness = BranchWitness(rng.randbytes(rng.randrange(0, 20)),
+                                    tuple(rng.randbytes(32) for _ in range(rng.randrange(0, 4))),
+                                    tuple(rng.randbytes(rng.randrange(0, 20)) for _ in range(rng.randrange(0, 4))))
+            inputs.append(Input(previous, index, 0xffffffff, 1, 0, (witness,)))
+        for index in range(rng.randrange(0, 3)):
+            token = bytes([row + 1, index + 1]) + rng.randbytes(30)
+            witness = BranchWitness(rng.randbytes(rng.randrange(0, 20)), (), (rng.randbytes(4),))
+            inputs.append(Input(token, 0, 0xffffffff, 3, None, (witness,)))
+        outputs = []
+        for _ in range(rng.randrange(0, 4)):
+            flags = rng.randrange(4)
+            branch = rng.randbytes(32)
+            token = (b"\x01" + rng.randbytes(31)) if flags & 1 else None
+            outputs.append(Output(flags, rng.getrandbits(64), token, (branch,), () if flags & 2 else ((0,),)))
+        tx = Transaction(rng.choice((0, 1, 2, 1 << 8 | 1)), tuple(inputs), tuple(outputs))
+        print(encode_transaction(tx, profile).hex())
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/lotus_v2/test_output.cpp b/src/lotus_v2/test_output.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bb157581aa80cfdbfec8c1ddad46a82c5c7a29cd
--- /dev/null
+++ b/src/lotus_v2/test_output.cpp
@@ -0,0 +1,175 @@
+#include "output.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace lotus::v2;
+
+#define CHECK(condition)                                                       \
+    do {                                                                       \
+        if (!(condition))                                                      \
+            throw std::runtime_error("check failed: " #condition);             \
+    } while (false)
+
+namespace {
+std::vector<uint8_t> FromHex(const std::string &hex) {
+    if (hex.size() & 1) throw std::runtime_error("odd hex");
+    auto digit = [](char ch) -> uint8_t {
+        if (ch >= '0' && ch <= '9') return ch - '0';
+        if (ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
+        throw std::runtime_error("bad hex");
+    };
+    std::vector<uint8_t> bytes;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        bytes.push_back((digit(hex[i]) << 4) | digit(hex[i + 1]));
+    return bytes;
+}
+
+void Accept(const std::vector<uint8_t> &wire) {
+    Output parsed;
+    std::string error;
+    CHECK(DecodeOutput(wire, parsed, error));
+    CHECK(error.empty());
+    std::vector<uint8_t> roundtrip;
+    CHECK(EncodeOutput(parsed, roundtrip, error));
+    CHECK(roundtrip == wire);
+}
+
+void Reject(const std::vector<uint8_t> &wire) {
+    Output parsed;
+    parsed.value = 777;
+    std::string error;
+    CHECK(!DecodeOutput(wire, parsed, error));
+    CHECK(!error.empty());
+    CHECK(parsed.value == 777);
+}
+
+void FixedVectors() {
+    // Fixed Python-reference v1 fixture wires, checked as literal expectations.
+    const auto native = FromHex("00e80300000000000001a88cef369f758aec3e594eaa4e"
+                                "8d08c9f12ef3f11bea972ec53a416a148f0605010100");
+    const auto burn = FromHex("02f40100000000000001a88cef369f758aec3e594eaa4e8d"
+                              "08c9f12ef3f11bea972ec53a416a148f060500");
+    const auto token =
+        FromHex("01ffffffffffffffff01000000000000000000000000000000000000000000"
+                "00000000000000000000020000000000000000000000000000000000000000"
+                "00000000000000000000000001000000000000000000000000000000000000"
+                "000000000000000000000000000301000200010101");
+    const auto token_burn =
+        FromHex("03000000000000000001000000000000000000000000000000000000000000"
+                "00000000000000000000010000000000000000000000000000000000000000"
+                "00000000000000000000000000");
+    for (const auto &wire : {native, burn, token, token_burn})
+        Accept(wire);
+
+    for (const auto &wire : {native, burn, token, token_burn}) {
+        for (size_t n = 0; n < wire.size(); ++n)
+            Reject({wire.begin(), wire.begin() + n});
+    }
+    auto extra = native;
+    extra.push_back(0);
+    Reject(extra);
+    auto invalid = native;
+    invalid[0] = 4;
+    Reject(invalid);
+    invalid = native;
+    invalid[9] = 17;
+    Reject(invalid);
+    invalid = native;
+    invalid[9] = 0;
+    Reject(invalid);
+    invalid = native;
+    invalid.back() = 1;
+    Reject(invalid);
+    invalid = native;
+    invalid[43] = 0;
+    Reject(invalid); // empty spendable path
+    invalid = native;
+    invalid.insert(invalid.begin() + 9, {253, 1, 0});
+    invalid.erase(invalid.begin() + 12);
+    Reject(invalid);
+    invalid = native;
+    invalid[42] = 253;
+    invalid.insert(invalid.begin() + 43, {1, 0});
+    Reject(invalid); // nonminimal path count
+    invalid = native;
+    invalid[0] = 1;
+    invalid.insert(invalid.begin() + 9, 32, 0);
+    Reject(invalid);
+    invalid = native;
+    invalid[0] = 2;
+    Reject(invalid); // burn with path
+    invalid = native;
+    invalid[9] = 2;
+    invalid.insert(invalid.begin() + 42, native.begin() + 10,
+                   native.begin() + 42);
+    Reject(invalid); // duplicate branch
+    invalid = native;
+    invalid[42] = 2;
+    Reject(invalid); // too many paths for bytes
+
+    // Maximum 812-byte output: 16 branches; 15 unique 15-index subsets plus
+    // the full 16-index path produce 16 lexicographically ordered paths.
+    Output largest;
+    largest.flags = 1;
+    largest.value = UINT64_MAX;
+    largest.token_id[0] = 1;
+    for (uint8_t i = 0; i < 16; ++i) {
+        Hash32 b{};
+        b[0] = i;
+        largest.branches.push_back(b);
+    }
+    for (uint8_t missing = 0; missing < 15; ++missing) {
+        std::vector<uint8_t> path;
+        for (uint8_t i = 0; i < 16; ++i)
+            if (i != missing) path.push_back(i);
+        largest.paths.push_back(std::move(path));
+    }
+    std::vector<uint8_t> full;
+    for (uint8_t i = 0; i < 16; ++i)
+        full.push_back(i);
+    largest.paths.push_back(std::move(full));
+    std::sort(largest.paths.begin(), largest.paths.end());
+    std::vector<uint8_t> encoded;
+    std::string error;
+    CHECK(EncodeOutput(largest, encoded, error));
+    CHECK(encoded.size() == MAX_OUTPUT_BYTES);
+    Accept(encoded);
+    auto over = encoded;
+    over.push_back(0);
+    Reject(over);
+    std::swap(largest.paths[0], largest.paths[1]);
+    CHECK(!EncodeOutput(largest, encoded, error));
+    std::swap(largest.paths[0], largest.paths[1]);
+    largest.paths[0][1] = largest.paths[0][0];
+    CHECK(!EncodeOutput(largest, encoded, error));
+    largest.paths[0][1] = 2;
+    largest.paths.push_back({0});
+    CHECK(!EncodeOutput(largest, encoded, error));
+}
+
+void Corpus(const char *path) {
+    std::ifstream in(path);
+    if (!in) throw std::runtime_error("cannot open corpus");
+    std::string line;
+    size_t count = 0;
+    while (std::getline(in, line)) {
+        if (line.empty()) continue;
+        Accept(FromHex(line));
+        ++count;
+    }
+    if (count != 256) throw std::runtime_error("corpus count mismatch");
+}
+} // namespace
+
+int main(int argc, char **argv) {
+    FixedVectors();
+    if (argc > 1) Corpus(argv[1]);
+    std::cout
+        << "Lotus V2 output codec: native vectors and rejection cases pass\n";
+}
diff --git a/src/lotus_v2/test_transaction.cpp b/src/lotus_v2/test_transaction.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5d92b7e07a928ab5874985b1dd10d5bf17b4250d
--- /dev/null
+++ b/src/lotus_v2/test_transaction.cpp
@@ -0,0 +1,290 @@
+#include "transaction.h"
+
+#include <algorithm>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+
+#define CHECK(condition)                                                       \
+    do {                                                                       \
+        if (!(condition))                                                      \
+            throw std::runtime_error("check failed: " #condition);             \
+    } while (false)
+
+namespace {
+std::vector<uint8_t> FromHex(const std::string &hex) {
+    CHECK(hex.size() % 2 == 0);
+    auto digit = [](char ch) -> uint8_t {
+        if (ch >= '0' && ch <= '9') return ch - '0';
+        if (ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
+        throw std::runtime_error("bad hex");
+    };
+    std::vector<uint8_t> out;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        out.push_back((digit(hex[i]) << 4) | digit(hex[i + 1]));
+    return out;
+}
+
+const TxProfile PROFILE{32, 32, 8, 8192, 16, 8192, 64};
+
+void Accept(const std::vector<uint8_t> &wire) {
+    Transaction decoded;
+    std::string error;
+    CHECK(DecodeTransaction(wire, PROFILE, decoded, error));
+    CHECK(error.empty());
+    std::vector<uint8_t> encoded;
+    CHECK(EncodeTransaction(decoded, PROFILE, encoded, error));
+    CHECK(encoded == wire);
+}
+
+void Reject(const std::vector<uint8_t> &wire) {
+    Transaction unchanged;
+    unchanged.lock = 99;
+    std::string error;
+    CHECK(!DecodeTransaction(wire, PROFILE, unchanged, error));
+    CHECK(!error.empty());
+    CHECK(unchanged.lock == 99);
+}
+
+void FixedPayment() {
+    // Literal P01 assembly, also checked by independent Python reference.
+    const auto wire = FromHex(
+        "07000000000000000000000001000100"
+        "1111111111111111111111111111111111111111111111111111111111111111"
+        "00000000ffffffff010001014e00010161"
+        "00e80300000000000001a88cef369f758aec3e594eaa4e8d08c9f12ef3f11bea972ec5"
+        "3a416a148f0605010100");
+    Accept(wire);
+    Transaction tx;
+    std::string error;
+    CHECK(DecodeTransaction(wire, PROFILE, tx, error));
+    CHECK(tx.inputs.size() == 1 && tx.outputs.size() == 1);
+    CHECK(tx.inputs[0].witnesses[0].arguments[0] == std::vector<uint8_t>{'a'});
+    std::vector<uint8_t> core;
+    CHECK(EncodeInputCore(tx.inputs[0], PROFILE, core, error));
+    CHECK(core ==
+          FromHex(std::string(64, '1') + "00000000ffffffff010001014e00"));
+    std::vector<uint8_t> full_input;
+    CHECK(EncodeInputFull(tx.inputs[0], PROFILE, full_input, error));
+    CHECK(std::equal(full_input.begin(), full_input.end(), wire.begin() + 16));
+    CHECK(full_input != core);
+    tx.inputs[0].witnesses[0].arguments[0] = {'b'};
+    std::vector<uint8_t> mutated;
+    CHECK(EncodeTransaction(tx, PROFILE, mutated, error));
+    CHECK(mutated != wire);
+    std::vector<uint8_t> new_core;
+    CHECK(EncodeInputCore(tx.inputs[0], PROFILE, new_core, error));
+    CHECK(new_core == core);
+
+    for (size_t n = 0; n < wire.size(); ++n)
+        Reject({wire.begin(), wire.begin() + n});
+    auto invalid = wire;
+    invalid.push_back(0);
+    Reject(invalid);
+    invalid = wire;
+    invalid[0] = 1;
+    Reject(invalid);
+    invalid = wire;
+    invalid[4] = 3;
+    Reject(invalid);
+    invalid = wire;
+    invalid[5] = 1;
+    Reject(invalid);
+    invalid = wire;
+    invalid[12] = 255;
+    invalid[13] = 255;
+    Reject(invalid);
+    invalid = wire;
+    invalid[14] = 255;
+    invalid[15] = 255;
+    Reject(invalid);
+    invalid = wire;
+    invalid[56] = 2;
+    Reject(invalid); // malformed coinbase shape
+    invalid = wire;
+    invalid[57] = 253;
+    invalid.insert(invalid.begin() + 58, {0, 0});
+    Reject(invalid);
+    invalid = wire;
+    invalid[58] = 0;
+    Reject(invalid); // missing spend witness
+    invalid = wire;
+    invalid[58] = 17;
+    Reject(invalid); // witness cap
+
+    tx.inputs.push_back(tx.inputs[0]);
+    CHECK(
+        !EncodeTransaction(tx, PROFILE, mutated, error)); // duplicate outpoint
+}
+
+void ArgumentElementBound() {
+    Transaction tx;
+    Input spend;
+    spend.prev_txid[0] = 1;
+    spend.sequence = UINT32_MAX;
+    spend.flags = 1;
+    spend.witnesses.resize(1);
+    spend.witnesses[0].script = {0x51};
+    spend.witnesses[0].arguments = {std::vector<uint8_t>(8192, 0x41)};
+    tx.inputs.push_back(spend);
+    std::vector<uint8_t> wire;
+    std::string error;
+    CHECK(EncodeTransaction(tx, PROFILE, wire, error));
+    Transaction decoded;
+    CHECK(DecodeTransaction(wire, PROFILE, decoded, error));
+    CHECK(decoded.inputs[0].witnesses[0].arguments[0].size() == 8192);
+
+    tx.inputs[0].witnesses[0].arguments[0].push_back(0x41);
+    CHECK(!EncodeTransaction(tx, PROFILE, wire, error));
+    TxProfile excessive = PROFILE;
+    excessive.max_argument_bytes = 8193;
+    CHECK(!EncodeTransaction(tx, excessive, wire, error));
+    CHECK(!DecodeTransaction(wire, excessive, decoded, error));
+}
+
+void Mint() {
+    const auto payment = FromHex(
+        "07000000000000000000000001000100"
+        "1111111111111111111111111111111111111111111111111111111111111111"
+        "00000000ffffffff010001014e00010161"
+        "00e80300000000000001a88cef369f758aec3e594eaa4e8d08c9f12ef3f11bea972ec5"
+        "3a416a148f0605010100");
+    Transaction tx;
+    std::string error;
+    CHECK(DecodeTransaction(payment, PROFILE, tx, error));
+    Input mint;
+    const auto root = FromHex(
+        "a88cef369f758aec3e594eaa4e8d08c9f12ef3f11bea972ec53a416a148f0605");
+    std::copy(root.begin(), root.end(), mint.prev_txid.begin());
+    mint.sequence = UINT32_MAX;
+    mint.flags = 3;
+    mint.witnesses.push_back(BranchWitness{{0x4e}, {}, {{'b'}}});
+    tx.inputs.push_back(mint);
+    tx.lock = 2;
+    std::vector<uint8_t> wire;
+    CHECK(EncodeTransaction(tx, PROFILE, wire, error));
+    Accept(wire);
+    for (size_t n = 0; n < wire.size(); ++n)
+        Reject({wire.begin(), wire.begin() + n});
+    const auto core = [&] {
+        std::vector<uint8_t> bytes;
+        CHECK(EncodeInputCore(mint, PROFILE, bytes, error));
+        return bytes;
+    }();
+    tx.inputs[1].witnesses[0].arguments[0] = {'c'};
+    std::vector<uint8_t> different;
+    CHECK(EncodeTransaction(tx, PROFILE, different, error) &&
+          different != wire);
+    std::vector<uint8_t> same_core;
+    CHECK(EncodeInputCore(tx.inputs[1], PROFILE, same_core, error) &&
+          same_core == core);
+    tx.inputs[1].prev_index = 1;
+    CHECK(!EncodeTransaction(tx, PROFILE, different, error));
+    tx.inputs[1].prev_index = 0;
+    tx.inputs[1].sequence = 0;
+    CHECK(!EncodeTransaction(tx, PROFILE, different, error));
+}
+
+void Coinbase() {
+    const auto payment = FromHex(
+        "07000000000000000000000001000100"
+        "1111111111111111111111111111111111111111111111111111111111111111"
+        "00000000ffffffff010001014e00010161"
+        "00e80300000000000001a88cef369f758aec3e594eaa4e8d08c9f12ef3f11bea972ec5"
+        "3a416a148f0605010100");
+    Transaction tx;
+    std::string error;
+    CHECK(DecodeTransaction(payment, PROFILE, tx, error));
+    tx.lock = 0;
+    tx.inputs[0].flags = 2;
+    tx.inputs[0].path_index = 0;
+    tx.inputs[0].prev_index = 12;
+    tx.inputs[0].prev_txid.fill(7);
+    tx.inputs[0].witnesses.clear();
+    std::vector<uint8_t> absent;
+    CHECK(EncodeTransaction(tx, PROFILE, absent, error));
+    CHECK(absent[57] == 0);
+    Accept(absent);
+    std::vector<uint8_t> core;
+    CHECK(EncodeInputCore(tx.inputs[0], PROFILE, core, error));
+    CHECK(std::equal(core.begin(), core.end(), absent.begin() + 16));
+    CHECK(CheckCoinbaseContext(tx, tx.inputs[0].prev_txid, 12, error));
+    CHECK(!CheckCoinbaseContext(tx, tx.inputs[0].prev_txid,
+                                uint64_t(UINT32_MAX) + 1, error));
+    Hash32 wrong{};
+    CHECK(!CheckCoinbaseContext(tx, wrong, 12, error));
+
+    tx.inputs[0].has_coinbase_data = true;
+    tx.inputs[0].coinbase_data = {0x5e, 0x4c, 0x00}; // opaque opcode-like bytes
+    std::vector<uint8_t> present;
+    CHECK(EncodeTransaction(tx, PROFILE, present, error));
+    CHECK(present[57] == 1 && present[58] == 3);
+    CHECK(present != absent);
+    CHECK(present ==
+          FromHex(
+              "07000000000000000000000001000100"
+              "0707070707070707070707070707070707070707070707070707070707070707"
+              "0c000000ffffffff0201035e4c00"
+              "00e80300000000000001a88cef369f758aec3e594eaa4e8d08c9f12ef3f11bea"
+              "972ec53a416a148f0605010100"));
+    Accept(present);
+    std::vector<uint8_t> present_core;
+    CHECK(EncodeInputCore(tx.inputs[0], PROFILE, present_core, error));
+    CHECK(present_core != core);
+    CHECK(std::equal(present_core.begin(), present_core.end(),
+                     present.begin() + 16));
+    tx.inputs[0].coinbase_data.assign(8192, 0x5e);
+    std::vector<uint8_t> maximum;
+    CHECK(EncodeTransaction(tx, PROFILE, maximum, error));
+    Accept(maximum);
+    tx.inputs[0].coinbase_data.push_back(0);
+    CHECK(!EncodeTransaction(tx, PROFILE, maximum, error));
+    tx.inputs[0].coinbase_data.clear();
+    CHECK(!EncodeTransaction(tx, PROFILE, maximum, error));
+
+    auto invalid = absent;
+    invalid[57] = 2;
+    Reject(invalid);
+    invalid = absent;
+    invalid[57] = 1;
+    invalid.insert(invalid.begin() + 58, 0);
+    Reject(invalid); // present empty data
+    invalid = present;
+    invalid[58] = 253;
+    invalid.insert(invalid.begin() + 59, {3, 0});
+    Reject(invalid); // nonminimal Bytes length
+    for (size_t n = 0; n < present.size(); ++n)
+        Reject({present.begin(), present.begin() + n});
+    tx.inputs[0].coinbase_data = {'x'};
+    tx.outputs[0].flags = 1;
+    tx.outputs[0].token_id[0] = 1;
+    CHECK(!EncodeTransaction(tx, PROFILE, maximum, error));
+}
+
+void Corpus(const char *path) {
+    std::ifstream file(path);
+    CHECK(file.good());
+    std::string line;
+    size_t count = 0;
+    while (std::getline(file, line)) {
+        if (!line.empty()) {
+            Accept(FromHex(line));
+            ++count;
+        }
+    }
+    CHECK(count == 128);
+}
+} // namespace
+
+int main(int argc, char **argv) {
+    FixedPayment();
+    ArgumentElementBound();
+    Mint();
+    Coinbase();
+    if (argc > 1) Corpus(argv[1]);
+    std::cout
+        << "Lotus V2 transaction framing: native vectors and rejections pass\n";
+}
