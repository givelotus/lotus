From e862ed2e472e58248ddb4f5b7d62548e76bc002c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:30:39 -0700
Subject: [PATCH] Keep current GUI address prefix settings after Dogecoin unit
 split

Original Doged 638c32e6e79b3eedaf0d8b0ebdab7fbc0d5150d3 adapts the upstream address widget to the cashaddr namespace. Preserve that delta on the current ABC GUI, avoiding an undeclared DEFAULT_ECASH after the separate currency selection port.

diff --git a/src/consensus/amount.cpp b/src/consensus/amount.cpp
index 35d4b5e84005c401fd02e9837c1b0c5fbdfa6894..fcf0beae6ea3f3d591ca4bc9a41712523099a88d 100644
--- a/src/consensus/amount.cpp
+++ b/src/consensus/amount.cpp
@@ -24,7 +24,7 @@ static_assert(uDOGE.baseunit > 1 * SATOSHI,
 
 const Currency &Currency::get() {
     return gArgs.GetBoolArg("-usedogeunit", DEFAULT_USE_DOGE_UNIT) ? DOGE
-                                                                   : uDOGE;
+                                                               : uDOGE;
 }
 
 std::string Amount::ToString() const {
diff --git a/src/qt/guiutil.cpp b/src/qt/guiutil.cpp
index 8a1a6df6617bcde32a602e4bb22d138f5b6e1b5b..7f08407d28b76246e20b96dbebdc09514b2915a8 100644
--- a/src/qt/guiutil.cpp
+++ b/src/qt/guiutil.cpp
@@ -7,7 +7,7 @@
 #include <cashaddrenc.h>
 #include <chainparams.h>
 #include <common/args.h>
-#include <currencyunit.h>
+#include <cashaddr.h>
 #include <interfaces/node.h>
 #include <key_io.h>
 #include <logging.h>
@@ -138,7 +138,7 @@ void setupAddressWidget(QValidatedLineEdit *widget, QWidget *parent) {
 
     widget->setFont(fixedPitchFont());
     auto placeholderText =
-        gArgs.GetBoolArg("-ecash", DEFAULT_ECASH)
+        gArgs.GetBoolArg("-ecash", cashaddr::DEFAULT_ECASH)
             ? "Enter an eCash address (e.g. %1)"
             : "Enter an eCash address with the bitcoincash: prefix (e.g. %1)";
     // We don't want translators to use own addresses in translations
