From f50bdc18b952d36e9fda848e9c95e8d16b8985d8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 14:56:08 -0700
Subject: [PATCH] test: expect the V2 regtest genesis in feature_utxo_set_hash

With a clean chain the UTXO set is empty, and ABC's hash_serialized
commits to the best block, which is the regtest genesis. v2/061 changed
that genesis (720da0e6...), so the expected hash is now e1ef57f2... The
empty-set MuHash is unchanged and still matches. The rest of the test
(muhash implementation) now stops in the legacy-tx group.

Tier: V2 (fixup to v2/061)
---
 test/functional/feature_utxo_set_hash.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/functional/feature_utxo_set_hash.py b/test/functional/feature_utxo_set_hash.py
index dda9ba0cda..f4485d8b7b 100644
--- a/test/functional/feature_utxo_set_hash.py
+++ b/test/functional/feature_utxo_set_hash.py
@@ -25,7 +25,7 @@ class UTXOSetHashTest(BitcoinTestFramework):
         # the cache
         assert_equal(
             self.nodes[0].gettxoutsetinfo()["hash_serialized"],
-            "49a1258456887c475a853700a4e8c19856dc946106fe02bf21425fcc6b98a155",
+            "e1ef57f2326ac3349dc21e3d23b1bd7b83e02a418677f548b032bb30caa33502",
         )
         assert_equal(
             self.nodes[0].gettxoutsetinfo("muhash")["muhash"],
