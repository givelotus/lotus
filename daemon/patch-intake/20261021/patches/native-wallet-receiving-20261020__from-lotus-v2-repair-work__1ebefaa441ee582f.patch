+        assert_equal(wallet.getaddressinfo(address)["pubkey"], info["pubkey"])
+        assert_equal(wallet.getaddressinfo(address)["labels"], ["renamed native"])
+        assert_equal(node.getrawtransaction(cbid, False, blocks[0]), wire)
