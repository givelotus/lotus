From aeb69fe1a5e80c8aef46121c24e77ffeeec2e389 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:49:22 -0700
Subject: [PATCH] Exclude legacy Script from eCash Segwit recovery bypass

Dogecoin interprets witness-shaped P2SH redeem scripts as ordinary pre-Segwit Script. The inherited ABC recovery shortcut accepted even all-zero witness programs without evaluating the final false stack value. Restrict that shortcut to nonlegacy mode and test both zero/nonzero programs, retaining modern ABC recovery behavior.

diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index 51cdab8c49468db131f38359636a44ecfa1968f9..04e3089bf89b8bb67406da667455ff0b0505e530 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -1869,7 +1869,8 @@ bool VerifyScript(const CScript &scriptSig, const CScript &scriptPubKey,
         // Bail out early if SCRIPT_DISALLOW_SEGWIT_RECOVERY is not set, the
         // redeem script is a p2sh segwit program, and it was the only item
         // pushed onto the stack.
-        if ((flags & SCRIPT_DISALLOW_SEGWIT_RECOVERY) == 0 && stack.empty() &&
+        if ((flags & (SCRIPT_DISALLOW_SEGWIT_RECOVERY |
+                      SCRIPT_VERIFY_LEGACY_RULES)) == 0 && stack.empty() &&
             pubKey2.IsWitnessProgram()) {
             // must set metricsOut for all successful returns
             metricsOut = metrics;
diff --git a/src/test/script_tests.cpp b/src/test/script_tests.cpp
index 1802b3d89051ef83f0ef17bc579915d7091cf45b..ccff6e4a3ce4bf08246306dd6a221434b8a9be7f 100644
--- a/src/test/script_tests.cpp
+++ b/src/test/script_tests.cpp
@@ -547,6 +547,23 @@ std::string JSONPrettyPrint(const UniValue &univalue) {
 
 BOOST_FIXTURE_TEST_SUITE(script_tests, ScriptTest)
 
+BOOST_AUTO_TEST_CASE(legacy_p2sh_witness_shaped_redeemscript) {
+    for (const uint8_t value : {uint8_t{0}, uint8_t{1}}) {
+        const CScript redeem = CScript() << OP_0 << std::vector<uint8_t>(20, value);
+        const CScript scriptSig = CScript() << ToByteVector(redeem);
+        const CScript scriptPubKey = GetScriptForDestination(ScriptHash(redeem));
+        ScriptError error;
+        BOOST_CHECK(VerifyScript(scriptSig, scriptPubKey, SCRIPT_VERIFY_P2SH,
+                                 BaseSignatureChecker(), &error));
+        // Dogecoin executes this as ordinary Script. A zero-valued program
+        // leaves false; eCash's Segwit recovery exception must not bypass it.
+        BOOST_CHECK_EQUAL(VerifyScript(scriptSig, scriptPubKey,
+                          SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_LEGACY_RULES,
+                          BaseSignatureChecker(), &error), value != 0);
+        BOOST_CHECK_EQUAL(error, value ? ScriptError::OK : ScriptError::EVAL_FALSE);
+    }
+}
+
 BOOST_AUTO_TEST_CASE(legacy_numeric_operand_boundaries) {
     struct LockChecker : BaseSignatureChecker {
         bool CheckLockTime(const CScriptNum &) const override { return true; }
