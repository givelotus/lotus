+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_GROUPS_TOKEN_ID_H
+#define CHRONIK_NATIVE_GROUPS_TOKEN_ID_H
+
+#include <chronik/native/extension.h>
+#include <chronik/native/index/index_tx.h>
+#include <chronik/native/store.h>
+#include <chronik/native/subs.h>
+#include <chronik/native/token/verify.h>
+#include <chronik/native/token_io/batch.h>
+
+#include <optional>
+#include <span>
+
+namespace chronik::native::mem {
+class MempoolTokens;
+} // namespace chronik::native::mem
+
+/**
+ * Port of chronik-db groups/token_id.rs: group txs by token ID.
+ *
+ * Member: the token ID's 32 bytes in internal (LE) order; SerMember: the
+ * big-endian bytes (TokenId::to_be_bytes). Tables: token_id_history (page
+ * size 1000), token_id_history_num_txs and token_id_utxo with the eCash-tier
+ * "Output" dup encoding (12-byte outpoint || sats LE8 || raw script).
+ */
+namespace chronik::native::groups {
+
+/**
+ * Auxillary data for indexing by token ID (Rust `TokenIdGroupAux`): for each
+ * txid, the token ID (if any) of each input and each output. It is both the
+ * GroupAux of TokenIdGroup and the subscription hub's TokenIdSubsAux (pass
+ * `&aux` as SubsAux::token_id).
+ */
+struct TokenIdGroupAux final : public GroupAux, public TokenIdSubsAux {
+    /** Build aux data from a processed token batch (block connect). */
+    static TokenIdGroupAux
+    FromBatch(std::span<const index::IndexTx> txs,
+              const token_io::ProcessedTokenTxBatch &batch);
+
+    /**
+     * Retrieve the aux data from the DB (block disconnect: call BEFORE
+     * TokenWriter::Delete in the same txn; also for txs read from the DB).
+     */
+    static TokenIdGroupAux FromDb(std::span<const index::IndexTx> txs,
+                                  const KvStore &store, const ReadTxn &txn);
+
+    /** Retrieve the aux data from the mempool */
+    static TokenIdGroupAux FromMempool(const Tx &tx,
+                                       const mem::MempoolTokens &mempool);
+
+    /** Build aux data from probed tx token info */
+    static TokenIdGroupAux
+    FromProbedTx(const TxId &txid, const token::TokenTx &token_tx,
+                 std::span<const std::optional<token::SpentToken>>
+                     spent_tokens);
+};
+
+/** Group txs by token ID. */
+class TokenIdGroup final : public GroupDef {
+public:
+    std::string_view Name() const override { return "TokenIdGroup"; }
+    /** Token IDs of the inputs (none for coinbase), from TokenIdGroupAux. */
+    void InputMembers(const GroupQuery &query, const GroupAux *aux,
+                      std::vector<MemberItem> &out) const override;
+    /** Token IDs of the outputs, from TokenIdGroupAux. */
+    void OutputMembers(const GroupQuery &query, const GroupAux *aux,
+                       std::vector<MemberItem> &out) const override;
+    /** member.to_be_bytes() */
+    Bytes SerMember(ByteView member) const override;
+    std::optional<GroupHistoryConf> TxHistoryConf() const override;
+    std::optional<GroupUtxoConf> UtxoConf() const override;
+    UtxoDataKind UtxoData() const override { return UtxoDataKind::Output; }
+};
+
+} // namespace chronik::native::groups
+
+#endif // CHRONIK_NATIVE_GROUPS_TOKEN_ID_H
diff --git a/chronik/native/include/chronik/native/mem/tokens.h b/chronik/native/include/chronik/native/mem/tokens.h
new file mode 100644
index 0000000000000000000000000000000000000000..d385d26b76eb27135a01586d004419d1695be727
--- /dev/null
+++ b/chronik/native/include/chronik/native/mem/tokens.h
@@ -0,0 +1,162 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_MEM_TOKENS_H
+#define CHRONIK_NATIVE_MEM_TOKENS_H
+
+#include <chronik/native/error.h>
+#include <chronik/native/groups/token_id.h>
+#include <chronik/native/mem/mempool.h>
+#include <chronik/native/script/result.h>
+#include <chronik/native/store.h>
+#include <chronik/native/token/structs.h>
+#include <chronik/native/token/verify.h>
+#include <chronik/native/types.h>
+
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+/**
+ * Port of chronik-db mem/tokens.rs ([`MempoolTokens`]), implementing the
+ * Mempool's MempoolTokenHook (with TokenIdGroup and TokenIdGroupAux).
+ *
+ * Construct with `std::make_unique<mem::MempoolTokens>()` and pass it as the
+ * Mempool's `token_hook`; `Mempool::Tokens()` can be cast back with
+ * `MempoolTokens::FromHook`.
+ */
+namespace chronik::native::mem {
+
+/** Rust `MempoolTokensError` (typed, comparable; ToString() = Rust text). */
+struct MempoolTokensError {
+    enum class Kind : uint8_t {
+        /** Mempool tx spends outputs of non-existent tx */
+        InputTxNotFound,
+        /** Mempool tx spends non-existent output of existing tx */
+        InputTxNoSuchOutput,
+    };
+    Kind kind = Kind::InputTxNotFound;
+    /** InputTxNotFound */
+    TxId txid;
+    /** InputTxNoSuchOutput */
+    OutPoint outpoint;
+
+    static MempoolTokensError InputTxNotFound(const TxId &txid) {
+        return {Kind::InputTxNotFound, txid, {}};
+    }
+    static MempoolTokensError InputTxNoSuchOutput(const OutPoint &outpoint) {
+        return {Kind::InputTxNoSuchOutput, {}, outpoint};
+    }
+    /**
+     * "Failed indexing mempool token tx: Tx is spending {txid} which is found
+     * neither in the mempool nor DB" /
+     * "Failed indexing mempool token tx: Tx spends non-existent token output
+     * {outpoint:?}"
+     */
+    std::string ToString() const;
+    bool operator==(const MempoolTokensError &) const = default;
+};
+
+/** MempoolTokensError thrown as an exception (Rust `?` into the Report). */
+class MempoolTokensException : public ChronikError {
+public:
+    explicit MempoolTokensException(MempoolTokensError err)
+        : ChronikError(err.ToString()), error(std::move(err)) {}
+    MempoolTokensError error;
+};
+
+using SpentTokens = std::vector<std::optional<token::SpentToken>>;
+using SpentTokensResult = Result<SpentTokens, MempoolTokensError>;
+using BatchTokenTxs =
+    std::unordered_map<TxId, token::TokenTx, Hash32Hasher>;
+
+/** Token data of the mempool */
+class MempoolTokens final : public MempoolTokenHook {
+public:
+    MempoolTokens() = default;
+
+    /** nullptr if `hook` is not a MempoolTokens. */
+    static const MempoolTokens *FromHook(const MempoolTokenHook *hook) {
+        return dynamic_cast<const MempoolTokens *>(hook);
+    }
+
+    // ---- MempoolTokenHook ----
+    const GroupDef &TokenIdGroup() const override { return m_group; }
+    /** MempoolTokens::insert */
+    void Insert(const KvStore &store, const MempoolTx &tx,
+                const IsMempoolTxFn &is_mempool_tx) override;
+    /** TokenIdGroupAux::from_mempool */
+    std::shared_ptr<const GroupAux> AuxFromMempool(const Tx &tx) override;
+    /** MempoolTokens::remove */
+    void Remove(const TxId &txid) override;
+    /** probe + TokenIdGroupAux::from_probed_tx; nullptr if no token data */
+    std::shared_ptr<const GroupAux>
+    Probe(const KvStore &store, const MempoolTx &tx,
+          const IsMempoolTxFn &is_mempool_tx) const override;
+
+    // ---- Rust MempoolTokens API ----
+
+    /**
+     * Parse, color and verify a potential token tx. Throws
+     * MempoolTokensException if inputs can't be found, ChronikError on DB
+     * errors.
+     */
+    std::optional<std::pair<token::TokenTx, SpentTokens>>
+    ProbeTx(const KvStore &store, const ReadTxn &txn, const Tx &tx,
+            const IsMempoolTxFn &is_mempool_tx) const;
+
+    /** Insert, reading from `txn` */
+    void InsertTx(const KvStore &store, const ReadTxn &txn, const MempoolTx &tx,
+                  const IsMempoolTxFn &is_mempool_tx);
+
+    /**
+     * Fetch the spent tokens of the given tx. Returns Err for invalid txs
+     * (inputs not found), throws for unexpected DB errors.
+     */
+    SpentTokensResult
+    FetchTxSpentTokens(const KvStore &store, const ReadTxn &txn, const Tx &tx,
+                       const IsMempoolTxFn &is_mempool_tx) const;
+
+    /**
+     * Same as [`FetchTxSpentTokens`] but accepts `batch_txs` for chained
+     * broadcast validation, where earlier txs in the batch are not yet in the
+     * mempool.
+     */
+    SpentTokensResult FetchTxSpentTokensBatch(
+        const KvStore &store, const ReadTxn &txn, const Tx &tx,
+        const IsMempoolTxFn &is_mempool_tx,
+        const BatchTokenTxs &batch_txs) const;
+
+    /** Get the [`TokenTx`] attached to a tx in the mempool, if any */
+    const token::TokenTx *TokenTx(const TxId &txid) const;
+
+    /** Get the [`SpentToken`] inputs of a tx in the mempool, if any */
+    const SpentTokens *TxTokenInputs(const TxId &txid) const;
+
+    /** Get the [`SpentToken`] of an outpoint in the mempool, if any */
+    Result<std::optional<token::SpentToken>, MempoolTokensError>
+    SpentToken(const OutPoint &outpoint) const;
+
+    /**
+     * Get the [`GenesisInfo`] of a GENESIS tx by [`TxId`], if this is a valid
+     * GENESIS tx.
+     */
+    const token::GenesisInfo *GenesisInfo(const TxId &txid) const;
+
+    /** Reset (Rust `MempoolTokens::default()`). */
+    void Clear();
+
+private:
+    groups::TokenIdGroup m_group;
+    std::unordered_map<TxId, token::TokenTx, Hash32Hasher> m_token_txs;
+    std::unordered_map<TxId, SpentTokens, Hash32Hasher> m_tx_token_inputs;
+};
+
+} // namespace chronik::native::mem
+
+#endif // CHRONIK_NATIVE_MEM_TOKENS_H
diff --git a/chronik/native/include/chronik/native/token_io/batch.h b/chronik/native/include/chronik/native/token_io/batch.h
new file mode 100644
index 0000000000000000000000000000000000000000..49ba2c8458dfab04ba42b04f7dddc2aa2bde8322
--- /dev/null
+++ b/chronik/native/include/chronik/native/token_io/batch.h
@@ -0,0 +1,149 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_TOKEN_IO_BATCH_H
+#define CHRONIK_NATIVE_TOKEN_IO_BATCH_H
+
+#include <chronik/native/error.h>
+#include <chronik/native/index/index_tx.h>
+#include <chronik/native/token/color.h>
+#include <chronik/native/token/structs.h>
+#include <chronik/native/token/verify.h>
+#include <chronik/native/token_io/data.h>
+
+#include <map>
+#include <optional>
+#include <set>
+#include <span>
+#include <tuple>
+#include <vector>
+
+/** Port of chronik-db io/token/batch.rs */
+namespace chronik::native::token_io {
+
+/**
+ * Rust `BatchError`: error when batch-processing txs, usually implies a
+ * critical failure. Messages:
+ *  - Cycle: "Cycle in SLP txs"
+ *  - MissingTokenTxNum: "Inconsistent BatchDbData: Missing TokenId for token
+ *    tx num {0}"
+ *  - MissingTxInputCoin: "Inconsistent Tx: Missing coin for TxInput {0:?}"
+ */
+class BatchError : public ChronikError {
+public:
+    using ChronikError::ChronikError;
+    static BatchError Cycle();
+    static BatchError MissingTokenTxNum(TxNum tx_num);
+    static BatchError MissingTxInputCoin(const OutPoint &outpoint);
+};
+
+/** Tx that has token data encoded in it and is ready for token validation */
+struct PreparedTx {
+    /** Tx with index data (tx_num etc.) */
+    const index::IndexTx *tx = nullptr;
+    /**
+     * Parsed & colored tx. Note that in this context we only store txs with
+     * a non-empty list of sections.
+     */
+    token::ColoredTx colored;
+};
+
+/**
+ * Bidirectional TxNum <-> TokenMeta map (Rust `BiMap<TxNum, TokenMeta>`).
+ * Insert removes any existing pair with the same left or right value.
+ */
+class TokenMetaBiMap {
+public:
+    void Insert(TxNum tx_num, const token::TokenMeta &meta);
+    const token::TokenMeta *GetByLeft(TxNum tx_num) const;
+    const TxNum *GetByRight(const token::TokenMeta &meta) const;
+    size_t Size() const { return m_left.size(); }
+    const std::map<TxNum, token::TokenMeta> &Left() const { return m_left; }
+
+private:
+    std::map<TxNum, token::TokenMeta> m_left;
+    std::map<token::TokenMeta, TxNum> m_right;
+};
+
+/** DB data required to process a batch of txs */
+struct BatchDbData {
+    /** Token tx data coming from the DB */
+    std::map<TxNum, DbTokenTx> token_txs;
+    /**
+     * token_nums assigned for each [`TokenMeta`]. This is a bi-map so we can
+     * lookup either direction.
+     */
+    TokenMetaBiMap token_metas;
+    /** [`GenesisInfo`] from the database; required for SLP V2 Mint Vault txs */
+    std::map<token::TokenMeta, token::GenesisInfo> genesis_infos;
+};
+
+/** Result of the batch verification before inserting */
+struct ProcessedTokenTxBatch {
+    /** New tokens to be added to the DB */
+    std::vector<std::tuple<TxNum, token::TokenMeta, token::GenesisInfo>>
+        new_tokens;
+    /** New DB data for txs to be added to the DB. */
+    std::map<TxNum, DbTokenTx> db_token_txs;
+    /** Validated token txs in the batch. */
+    std::map<TxNum, token::TokenTx> valid_txs;
+    /** Validated spent tokens in the batch, can have entries not in valid_txs */
+    std::map<TxNum, std::vector<std::optional<token::SpentToken>>>
+        spent_tokens;
+    /**
+     * True if validation of txs was performed, or false if validation was
+     * safely skipped because no tokens are in the DB and the batch contained
+     * no token txs.
+     */
+    bool did_validation = false;
+};
+
+/**
+ * Struct bundling all the data necessary to process a batch (i.e. a block)
+ * of token txs. `txs` must outlive the processor.
+ */
+class BatchProcessor {
+public:
+    /** Prepare the given indexed txs as token txs. */
+    static BatchProcessor Prepare(std::span<const index::IndexTx> txs);
+
+    /** Collect all [`TokenMeta`]s of the SLP V2 Mint Vault txs in the batch */
+    std::set<token::TokenMeta> CollectMintVaultMetas() const;
+
+    /**
+     * Verify the entire batch of txs. It updates the DB data with some token
+     * data during validation, but that can be discarded. The result of the
+     * verification is returned as [`ProcessedTokenTxBatch`]. Consumes the
+     * prepared txs.
+     */
+    ProcessedTokenTxBatch Verify(BatchDbData db_data);
+
+    /** Tx that have any token info attached */
+    std::map<TxNum, PreparedTx> prepared_txs;
+    /** Non-token txs may still have token inputs */
+    std::vector<const index::IndexTx *> non_token_txs;
+    /**
+     * Whether the batch has any GENESIS txs; if the token index is empty and
+     * we have no GENESIS, we can safely ignore the batch.
+     */
+    bool has_any_genesis = false;
+
+private:
+    void VerifyTokenTx(PreparedTx prepared_tx, BatchDbData &db_data,
+                       ProcessedTokenTxBatch &processed_batch) const;
+    void ProcessNonTokenTx(const index::IndexTx &tx, BatchDbData &db_data,
+                           ProcessedTokenTxBatch &processed_batch) const;
+    static std::vector<script::Script>
+    TxSpentScripts(const index::IndexTx &tx);
+    std::vector<std::optional<token::SpentToken>>
+    TxTokenInputs(const index::IndexTx &tx, const BatchDbData &db_data,
+                  const std::map<TxNum, token::TokenTx> &valid_txs) const;
+    std::optional<token::SpentToken>
+    TokenOutput(TxNum tx_num, size_t out_idx, const BatchDbData &db_data,
+                const std::map<TxNum, token::TokenTx> &valid_txs) const;
+};
+
+} // namespace chronik::native::token_io
+
+#endif // CHRONIK_NATIVE_TOKEN_IO_BATCH_H
diff --git a/chronik/native/include/chronik/native/token_io/data.h b/chronik/native/include/chronik/native/token_io/data.h
new file mode 100644
index 0000000000000000000000000000000000000000..e0071e332536ffeb0b777648a3285610909e72f7
--- /dev/null
+++ b/chronik/native/include/chronik/native/token_io/data.h
@@ -0,0 +1,218 @@
+// Copyright (c) 2026 The Lotus developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef CHRONIK_NATIVE_TOKEN_IO_DATA_H
+#define CHRONIK_NATIVE_TOKEN_IO_DATA_H
+
+#include <chronik/native/codec/postcard.h>
+#include <chronik/native/error.h>
+#include <chronik/native/index/data.h>
+#include <chronik/native/token/structs.h>
+#include <chronik/native/token/verify.h>
+#include <chronik/native/types.h>
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/**
+ * Port of chronik-db io/token/data.rs ([`DbTokenTx`], [`DbToken`]) plus the
+ * postcard (serde) encodings of the values stored in the token tables:
+ *  - `token_tx`:           TxNum BE8 -> DbTokenTx
+ *  - `token_meta`:         TxNum BE8 (of GENESIS) -> TokenMeta
+ *  - `token_genesis_info`: TxNum BE8 (of GENESIS) -> GenesisInfo
+ */
+namespace chronik::native::token_io {
+
+using index::TxNum;
+
+/**
+ * Bit flag of whether the token tx has the required SLP V2 mint vault script
+ * in the list of inputs.
+ */
+inline constexpr uint8_t FLAGS_HAS_MINT_VAULT = 1;
+
+/**
+ * u32 index into `token_tx_nums` to know which `token_tx_num` the
+ * input/output has.
+ */
+using TokenIdx = uint32_t;
+
+/** Token from the DB (Rust `DbToken`; postcard enum, variants in order). */
+struct DbToken {
+    enum class Kind : uint8_t {
+        /** No token value */
+        NoToken,
+        /** Token amount in atoms (base tokens) */
+        Atoms,
+        /** Mint baton */
+        MintBaton,
+        /** Unknown SLP token */
+        UnknownSlp,
+        /** Unknown ALP token */
+        UnknownAlp,
+    };
+    Kind kind = Kind::NoToken;
+    /** Atoms, MintBaton */
+    TokenIdx idx{};
+    /** Atoms */
+    token::Atoms atoms{};
+    /** UnknownSlp, UnknownAlp */
+    uint8_t token_type{};
+
+    static DbToken NoToken() { return {}; }
+    static DbToken MakeAtoms(TokenIdx idx, token::Atoms atoms) {
+        return {Kind::Atoms, idx, atoms, 0};
+    }
+    static DbToken MintBaton(TokenIdx idx) {
+        return {Kind::MintBaton, idx, 0, 0};
+    }
+    static DbToken UnknownSlp(uint8_t token_type) {
+        return {Kind::UnknownSlp, 0, 0, token_type};
+    }
+    static DbToken UnknownAlp(uint8_t token_type) {
+        return {Kind::UnknownAlp, 0, 0, token_type};
+    }
+
+    /** Create a new [`DbToken`] but with a different index. */
+    DbToken WithIdx(TokenIdx new_idx) const;
+    /**
+     * Return the idx of the token_tx_num the token it pointing to, or None if
+     * it's not pointing to any token_tx_num.
+     */
+    std::optional<TokenIdx> TokenNumIdx() const;
+    /** Rust Debug, e.g. "Atoms(0, 1000)", "NoToken" */
+    std::string Debug() const;
+
+    bool operator==(const DbToken &) const = default;
+};
+
+/**
+ * Token tx stored in the DB with only the data that cannot be reconstructed
+ * from the tx easily (Rust `DbTokenTx`).
+ */
+struct DbTokenTx {
+    /**
+     * All token nums used in the tx, including inputs, outputs,
+     * group_token_id. This is not ordered in any canonical way.
+     */
+    std::vector<TxNum> token_tx_nums;
+    /**
+     * Which items in token_nums have which token_num as their group (for
+     * group_token_id). Maps indices: `token_num_idx -> group_token_num_idx`
+     */
+    std::map<TokenIdx, TokenIdx> group_token_indices;
+    /** Inputs of the tx, reflecting the tx inputs 1-to-1 */
+    std::vector<DbToken> inputs;
+    /** Outputs of the tx, reflecting the tx outputs 1-to-1 */
+    std::vector<DbToken> outputs;
+    /** Bit flags of the tx, e.g. whether the mint vault input is present */
+    uint8_t flags{};
+
+    /** Return the token [`TxNum`] of the given [`DbToken`]. */
+    std::optional<TxNum> TokenTxNum(const DbToken &db_token) const;
+
+    /**
+     * Return the [`TxNum`] of the group token of the given [`DbToken`].
+     * These are set for NFT1 CHILD tokens.
+     */
+    std::optional<TxNum> GroupTokenTxNum(const DbToken &db_token) const;
+
+    /**
+     * Build a [`SpentToken`] from a [`DbToken`], using a provided function to
+     * lookup [`TokenMeta`] by [`TxNum`]. `fn_meta` throws on failure (Rust's
+     * `?`). Indexing out of `token_tx_nums` throws (Rust panics).
+     */
+    template <typename FnMeta>
+    std::optional<token::SpentToken> SpentToken(const DbToken &db_token,
+                                                FnMeta &&fn_meta) const;
+
+    /**
+     * Whether the token tx has the required SLP V2 mint vault script in the
+     * list of inputs.
+     */
+    bool HasMintVault() const { return (flags & FLAGS_HAS_MINT_VAULT) != 0; }
+
+    bool operator==(const DbTokenTx &) const = default;
+};
+
+/** std::any::type_name of the stored types (for SerError texts). */
+inline constexpr std::string_view kDbTokenTxTypeName =
+    "chronik_db::io::token::data::DbTokenTx";
+inline constexpr std::string_view kTokenMetaTypeName =
+    "bitcoinsuite_slp::structs::TokenMeta";
+inline constexpr std::string_view kGenesisInfoTypeName =
+    "bitcoinsuite_slp::structs::GenesisInfo";
+
+// postcard encoders/decoders of the serde-derived Rust types
+void WriteDbToken(postcard::Writer &w, const DbToken &token);
+DbToken ReadDbToken(postcard::Reader &r);
+void WriteTokenType(postcard::Writer &w, const token::TokenType &token_type);
+token::TokenType ReadTokenType(postcard::Reader &r);
+void WriteTokenMeta(postcard::Writer &w, const token::TokenMeta &meta);
+token::TokenMeta ReadTokenMeta(postcard::Reader &r);
+void WriteGenesisInfo(postcard::Writer &w, const token::GenesisInfo &info);
+token::GenesisInfo ReadGenesisInfo(postcard::Reader &r);
+void WriteDbTokenTx(postcard::Writer &w, const DbTokenTx &tx);
+DbTokenTx ReadDbTokenTx(postcard::Reader &r);
+
+/** db_serialize / db_deserialize of the table values. */
+Bytes SerializeDbTokenTx(const DbTokenTx &tx);
+DbTokenTx DeserializeDbTokenTx(ByteView bytes);
+Bytes SerializeTokenMeta(const token::TokenMeta &meta);
+token::TokenMeta DeserializeTokenMeta(ByteView bytes);
+Bytes SerializeGenesisInfo(const token::GenesisInfo &info);
+token::GenesisInfo DeserializeGenesisInfo(ByteView bytes);
+
+// ---- template implementation ----
+
+template <typename FnMeta>
+std::optional<token::SpentToken>
+DbTokenTx::SpentToken(const DbToken &db_token, FnMeta &&fn_meta) const {
+    using namespace token;
+    TokenIdx token_num_idx{};
+    TokenVariant variant;
+    switch (db_token.kind) {
+    case DbToken::Kind::NoToken:
+        return std::nullopt;
+    case DbToken::Kind::Atoms:
+        token_num_idx = db_token.idx;
+        variant = TokenVariant::MakeAtoms(db_token.atoms);
+        break;
+    case DbToken::Kind::MintBaton:
+        token_num_idx = db_token.idx;
+        variant = TokenVariant::MintBaton();
+        break;
+    case DbToken::Kind::UnknownSlp:
+    case DbToken::Kind::UnknownAlp: {
+        const TokenType token_type =
+            db_token.kind == DbToken::Kind::UnknownSlp
+                ? TokenType::Slp(SlpTokenType::Unknown(db_token.token_type))
+                : TokenType::Alp(AlpTokenType::Unknown(db_token.token_type));
+        return token::SpentToken{
+            Token{TokenMeta{TokenId{}, token_type},
+                  TokenVariant::Unknown(db_token.token_type)},
+            std::nullopt};
+    }
+    }
+    std::optional<TxNum> group_token_tx_num;
+    if (const auto it = group_token_indices.find(token_num_idx);
+        it != group_token_indices.end()) {
+        group_token_tx_num = token_tx_nums.at(it->second);
+    }
+    token::SpentToken spent{Token{fn_meta(token_tx_nums.at(token_num_idx)),
+                                  variant},
+                            std::nullopt};
+    if (group_token_tx_num) {
+        spent.group_token_meta = fn_meta(*group_token_tx_num);
+    }
+    return spent;
+}
+
+} // namespace chronik::native::token_io
+
+#endif // CHRONIK_NATIVE_TOKEN_IO_DATA_H
