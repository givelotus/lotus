+GenesisInfo MakeInfo(Bytes ticker, Bytes name, Bytes url,
+                     std::optional<std::array<uint8_t, 32>> hash,
+                     uint8_t decimals) {
+    GenesisInfo info;
+    info.token_ticker = std::move(ticker);
+    info.token_name = std::move(name);
+    info.url = std::move(url);
+    info.hash = hash;
+    info.decimals = decimals;
