+            ret.pushKV("recommended_sdk_feerate_per_kcu",
+                       info.recommended_sdk_feerate_per_kcu);
+            ret.pushKV("p2p_relay_feerate_per_kcu",
+                       info.p2p_relay_feerate_per_kcu);
+            ret.pushKV("blocks", conf_target);
+            return ret;
+        },
+    };
+}
