From 7a0502f55f1c290900af3bcc4965217c8999fc1a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 14 Oct 2026 16:28:48 -0700
Subject: [PATCH] avalanche: adapt current score and activation fixtures to
 Dogecoin

Keep MAX_MONEY score expectations at the widened Score type, and carry the d8c7020d972f7041a748b1030ee614d29e2742fb explicit staking-rewards opt-in into current upstream fixture APIs.

diff --git a/src/avalanche/test/proof_tests.cpp b/src/avalanche/test/proof_tests.cpp
index b22200a792c357b49d1629075c52965afadf6e59..f99cb54912be16e0d1d3c5831ae68a2ba37316ec 100644
--- a/src/avalanche/test/proof_tests.cpp
+++ b/src/avalanche/test/proof_tests.cpp
@@ -943,7 +943,7 @@ BOOST_AUTO_TEST_CASE(amount_to_score) {
     BOOST_CHECK_EQUAL(Proof::amountToScore(PROOF_DUST_THRESHOLD),
                       MIN_VALID_PROOF_SCORE);
     BOOST_CHECK_EQUAL(Proof::amountToScore(MAX_MONEY),
-                      uint32_t(MAX_MONEY / (COIN / 100)));
+                      Score(MAX_MONEY / (COIN / 100)));
     BOOST_CHECK_EQUAL(Proof::amountToScore(MAX_MONEY + SATOSHI),
                       Proof::amountToScore(MAX_MONEY));
 }
diff --git a/src/avalanche/test/stakingrewards_tests.cpp b/src/avalanche/test/stakingrewards_tests.cpp
index ca4a05f804fa9e8a918895b756fbd52070ef0308..151a52ae0f37d6543238ce0ce3ecea667b4b6b45 100644
--- a/src/avalanche/test/stakingrewards_tests.cpp
+++ b/src/avalanche/test/stakingrewards_tests.cpp
@@ -48,7 +48,9 @@ BOOST_FIXTURE_TEST_CASE(isstakingrewardsactivated,
                         StakingRewardsActivationTestingSetup) {
     checkStakingRewardsActivation(ChainType::REGTEST, false);
     checkStakingRewardsActivation(ChainType::TESTNET, false);
+    Assert(m_node.args)->ForceSetArg("-avalanchestakingrewards", "1");
     checkStakingRewardsActivation(ChainType::MAIN, true);
+    Assert(m_node.args)->ClearForcedArg("-avalanchestakingrewards");
 }
 
 BOOST_FIXTURE_TEST_CASE(stakecontender_computeid, TestChain100Setup) {
