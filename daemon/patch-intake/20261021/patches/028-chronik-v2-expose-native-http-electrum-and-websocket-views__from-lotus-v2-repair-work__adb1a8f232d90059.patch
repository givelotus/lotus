+            return Err(Error(StatusCode::CONFLICT, "stale_snapshot"));
+        }
+        Ok(())
+    }
+    fn envelope(&self, data: Value) -> Value {
+        json!({"api_version":"1","snapshot_token":self.token(),"snapshot":self.snapshot(),"coverage":self.coverage(),"data":data})
