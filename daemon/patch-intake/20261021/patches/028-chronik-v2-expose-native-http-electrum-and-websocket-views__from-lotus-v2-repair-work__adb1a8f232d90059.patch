+    fn index(&self) -> Result<Option<u32>> {
+        self.last
+            .as_deref()
+            .map(|b| {
+                if b.len() != 4 {
+                    return Err(Error(
+                        StatusCode::BAD_REQUEST,
+                        "invalid_cursor",
+                    ));
+                }
+                Ok(u32::from_be_bytes(b.try_into().unwrap()))
+            })
+            .transpose()
+    }
+}
+struct Page {
+    items: Vec<Value>,
+    bytes: usize,
+    last: Option<Vec<u8>>,
+    exhausted: bool,
+    examined: usize,
+    reads: usize,
+}
+impl Page {
+    fn new() -> Self {
+        Self {
+            items: Vec::new(),
+            bytes: 0,
+            last: None,
+            exhausted: false,
+            examined: 0,
+            reads: 0,
+        }
+    }
+    fn read(&mut self) -> Result<()> {
+        if self.reads >= 4096 {
+            return Err(unavailable());
+        }
+        self.reads += 1;
+        Ok(())
+    }
+    fn push(&mut self, key: Vec<u8>, value: Value) -> Result<bool> {
+        if self.examined >= 1024 {
+            return Ok(false);
+        }
+        self.examined += 1;
+        let bytes = encode(&value, ITEM_CAP)?.len();
+        if bytes > ITEM_CAP.saturating_sub(self.bytes) {
+            if self.items.is_empty() {
+                return Err(record_limit());
+            }
+            return Ok(false);
+        }
+        self.bytes += bytes;
+        self.items.push(value);
+        self.last = Some(key);
+        Ok(true)
+    }
+    fn finish(self, r: &Request, c: &Context) -> Result<Value> {
+        let next = if self.exhausted {
+            None
+        } else {
+            Some(
+                r.continuation(
+                    c,
+                    self.last
+                        .as_deref()
+                        .or(r.last.as_deref())
+                        .ok_or_else(unavailable)?,
+                )?,
+            )
+        };
+        Ok(
+            json!({"items":self.items,"next_cursor":next,"exhausted":self.exhausted}),
+        )
+    }
+}
+fn location(l: TxLocation) -> Value {
