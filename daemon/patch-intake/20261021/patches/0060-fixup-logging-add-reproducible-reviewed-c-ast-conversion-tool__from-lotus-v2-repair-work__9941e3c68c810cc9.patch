From b6e0657d2091f128323dafa551b46d8248d7cad5 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 12:18:43 -0700
Subject: [PATCH] fixup! logging: add reproducible reviewed C++ AST conversion
 tool

Recognize a complete support replacement before its old anchor when that anchor is a substring, such as an include insertion. Reject ambiguous old anchors outside the completed replacement. Regression fails on original tool (exit1) and passes after; all twelve tool-test methods including current catalog mappings pass. Include LogTrace and explicit Trace-level calls in inventory and preserve Trace severity; that focused regression also fails before and passes after. No daemon code changes; no new full daemon-suite claim for this tooling-only fix.
---
 contrib/logging/conversion/convert.py      | 30 ++++++++++----
 contrib/logging/conversion/test_convert.py | 47 ++++++++++++++++++++++
 2 files changed, 70 insertions(+), 7 deletions(-)

diff --git a/contrib/logging/conversion/convert.py b/contrib/logging/conversion/convert.py
index 2614230068..ed9ee21013 100755
--- a/contrib/logging/conversion/convert.py
+++ b/contrib/logging/conversion/convert.py
@@ -23,10 +23,17 @@ LEGACY = {
     "LogWarning",
     "LogError",
     "LogDebug",
+    "LogTrace",
     "LogPrint",
     "LogPrintLevel",
 }
-EVENTS = {"LogInfoEvent", "LogWarningEvent", "LogErrorEvent", "LogEvent"}
+EVENTS = {
+    "LogInfoEvent",
+    "LogWarningEvent",
+    "LogErrorEvent",
+    "LogEvent",
+    "LogTraceEvent",
+}
 SPEC = re.compile(
     r"%(?:[-+ #0]*)(?:\d+)?(?:\.\d+)?(?:hh|ll|[hljztL])?[diuoxXfFeEgGaAcsp%]"
 )
@@ -88,7 +95,9 @@ def format_parts(message):
 def describe(node):
     name = node.field("function").text()
     index = (
-        2 if name == "LogPrintLevel" else 1 if name in {"LogPrint", "LogDebug"} else 0
+        2
+        if name == "LogPrintLevel"
+        else 1 if name in {"LogPrint", "LogDebug", "LogTrace"} else 0
     )
     values = args(node)
     if index >= len(values):
@@ -125,7 +134,7 @@ def validate_mapping(old, event):
     macro = description["macro"]
     category = (
         oldargs[0].text()
-        if macro in {"LogDebug", "LogPrint", "LogPrintLevel"}
+        if macro in {"LogDebug", "LogTrace", "LogPrint", "LogPrintLevel"}
         else "BCLog::ALL"
     )
     expected = {
@@ -134,6 +143,7 @@ def validate_mapping(old, event):
         "LogWarning": "LogWarningEvent",
         "LogError": "LogErrorEvent",
         "LogDebug": "LogEvent",
+        "LogTrace": "LogTraceEvent",
         "LogPrint": "LogEvent",
     }.get(macro)
     if macro == "LogPrintLevel":
@@ -142,6 +152,7 @@ def validate_mapping(old, event):
             "BCLog::Level::Error": "LogErrorEvent",
             "BCLog::Level::Info": "LogInfoEvent",
             "BCLog::Level::Debug": "LogEvent",
+            "BCLog::Level::Trace": "LogTraceEvent",
         }.get(oldargs[1].text())
     if event.field("function").text() != expected or newargs[0].text() != category:
         raise ValueError("severity/category changed")
@@ -255,14 +266,19 @@ def main():
         # includes and functional assertions. They are never guessed from text.
         for adjustment in item.get("support_adjustments", []):
             old, new = adjustment["old"], adjustment["new"]
-            if old in after:
-                if after.count(old) != 1:
+            if new in after:
+                # A replacement can contain its old anchor (e.g. an include
+                # insertion). Recognize the complete result before the anchor.
+                if after.count(new) != 1 or old in after.replace(new, "", 1):
                     raise ValueError(
                         "ambiguous support adjustment " + adjustment["purpose"]
                     )
+            elif after.count(old) == 1:
                 after = after.replace(old, new, 1)
-            elif new not in after:
-                raise ValueError("drifted support adjustment " + adjustment["purpose"])
+            else:
+                raise ValueError(
+                    "drifted/ambiguous support adjustment " + adjustment["purpose"]
+                )
         if after != before:
             prepared.append((path, after))
         receipt["files"].append(
diff --git a/contrib/logging/conversion/test_convert.py b/contrib/logging/conversion/test_convert.py
index 28ac9b439e..ef480ad0a8 100755
--- a/contrib/logging/conversion/test_convert.py
+++ b/contrib/logging/conversion/test_convert.py
@@ -131,6 +131,53 @@ class ConversionTest(unittest.TestCase):
                 (root / "second.cpp").read_text(), 'LogPrintf("x=%d", drifted);'
             )
 
+    def test_overlapping_support_adjustment_is_idempotent(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            original = "#include <a.h>\n"
+            expected = "#include <a.h>\n#include <b.h>\n"
+            (root / "input.cpp").write_text(original)
+            catalog = {
+                "files": [
+                    {
+                        "path": "input.cpp",
+                        "rules": [],
+                        "support_adjustments": [
+                            {
+                                "purpose": "fixture include",
+                                "old": original,
+                                "new": expected,
+                            }
+                        ],
+                    }
+                ]
+            }
+            (root / "rules.json").write_text(json.dumps(catalog))
+            command = [
+                sys.executable,
+                str(Path(__file__).parent / "convert.py"),
+                "--root",
+                str(root),
+                "--rules",
+                str(root / "rules.json"),
+                "--apply",
+            ]
+            subprocess.run(command, capture_output=True, text=True, check=True)
+            second = subprocess.run(command, capture_output=True, text=True, check=True)
+            self.assertEqual(second.stdout, "")
+            self.assertEqual((root / "input.cpp").read_text(), expected)
+
+    def test_trace_calls_are_inventoried_and_keep_trace_severity(self):
+        for old in [
+            'LogTrace(BCLog::NET,"peer=%d", id)',
+            'LogPrintLevel(BCLog::NET,BCLog::Level::Trace,"peer=%d", id)',
+        ]:
+            self.assertEqual(len(convert.calls(old, convert.LEGACY)), 1)
+            new = 'LogTraceEvent(BCLog::NET,"peer_trace","peer={peer_id}").Field(BCLog::LogField::PeerId,id)'
+            after, _ = convert.convert(old, [rule(old, new)])
+            self.assertEqual(after, new)
+            self.assertEqual(convert.convert(after, [rule(old, new)])[0], after)
+
     def test_disable_branch_and_no_evaluation(self):
         old = 'LogDebug(BCLog::NET,"x=%d", expensive())'
         new = 'LogEvent(BCLog::NET,"x","x={value}").Field(BCLog::LogField::Value,expensive())'
