+    //! How a Notifications subscriber receives callbacks.
+    enum class NotificationDelivery {
+        //! Inline on the shared ValidationSignals thread (default).
+        SCHEDULER_THREAD,
+        //! On a FIFO worker owned by the handler, in the order the scheduler
