+    for (size_t i{0}; i < m_args.size(); ++i) {
+        const auto &arg{m_args.at(i)};
+        UniValue match{arg.MatchesType(request.params[i])};
+        if (!match.isTrue()) {
+            arg_mismatch.pushKV(
+                strprintf("Position %s (%s)", i + 1, arg.m_names),
