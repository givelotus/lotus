From 04beb30c93d0221ffa6930ef6147a9d77051e35f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Mon, 19 Oct 2026 10:59:22 -0700
Subject: [PATCH] fixup! logging: write log lines on a logger thread

Async observation barriers and background block relay can delay an intended spam poll beyond this test's real 10-second negative window. Observed node log gap was12.338s; the correctly accepted poll cannot produce a cooldown rejection. Use a long600-second negative window without changing any node defaults. Keep the separate100ms expiry/reacceptance phase unchanged.

Same unchanged candidate binary: ordinary focused test passes; injecting10.5s after the first accepted poll makes the original test fail its rejection-log assertion, while changing only the negative window passes every phase. No arbitrary timeout increase or production cooldown change. Full standard gate resumes separately; failfast-skipped cases from the failed run are not validation.
---
 test/functional/abc_p2p_avalanche_cooldown.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/test/functional/abc_p2p_avalanche_cooldown.py b/test/functional/abc_p2p_avalanche_cooldown.py
index 4144a0ae8a..a8a6f6e87e 100644
--- a/test/functional/abc_p2p_avalanche_cooldown.py
+++ b/test/functional/abc_p2p_avalanche_cooldown.py
@@ -35,7 +35,9 @@ class AvalancheCooldownTest(BitcoinTestFramework):
                 "-avaproofstakeutxoconfirmations=1",
                 "-avaminquorumstake=0",
                 "-avaminavaproofsnodecount=0",
-                "-avacooldown=10000",
+                # Keep rejection checks inside the cooldown on loaded hosts.
+                # Expiry is checked separately after restarting with 100 ms.
+                "-avacooldown=600000",
                 "-persistavapeers=0",
             ],
         ]
