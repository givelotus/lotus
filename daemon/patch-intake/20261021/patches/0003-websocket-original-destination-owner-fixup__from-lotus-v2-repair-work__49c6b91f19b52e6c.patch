From 4d210d101d43d99e69a92454d0672dbbb20a7402 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 07:20:50 -0700
Subject: [PATCH] fixup! [v2 only] net: P2P over WebSocket only, on the P2P
 port

Complete the native WS-only caller adaptation: retain its original -addnode/-connect destination as CNode addrName. The introducing owner already passes that fifth argument but left the shared four-argument declaration and implementation unchanged, making net.cpp fail to compile. The optional empty default preserves every existing shared four-argument call; proxy selection, addrman attempt accounting and dialer cancellation remain untouched. Actual before failure is preserved from the normal native ChronikON/walletON build; existing p2p_websocket_only original-address assertions remain the runtime oracle, not executed before compile succeeds.
---
 src/net.cpp | 5 +++--
 src/net.h   | 3 ++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/net.cpp b/src/net.cpp
index a91032579b..8f5b4675aa 100644
--- a/src/net.cpp
+++ b/src/net.cpp
@@ -1610,7 +1610,8 @@ std::optional<ParsedWebSocketURL> ParseWebSocketURL(std::string_view url) {
 CNode *CConnman::ConnectWebSocketNode(const std::string &url,
                                       const CAddress *wss_addr,
                                       bool fCountFailure,
-                                      ConnectionType conn_type) {
+                                      ConnectionType conn_type,
+                                      const std::string &dest_name) {
     const auto parsed{ParseWebSocketURL(url)};
     if (!parsed) {
         LogPrintf("Not connecting to %s: invalid WebSocket peer URL\n",
@@ -1732,7 +1733,7 @@ CNode *CConnman::ConnectWebSocketNode(const std::string &url,
     CNode *pnode = new CNode(
         id, std::move(dialed->sock), addrConnect,
         CalculateKeyedNetGroup(addrConnect), nonce, extra_entropy, addr_bind,
-        wss_addr ? "" : url, conn_type,
+        dest_name.empty() ? (wss_addr ? "" : url) : dest_name, conn_type,
         /* inbound_onion */ false,
         CNodeOptions{
             .permission_flags = permission_flags,
diff --git a/src/net.h b/src/net.h
index 607f56589f..62ba48f246 100644
--- a/src/net.h
+++ b/src/net.h
@@ -1370,7 +1370,8 @@ private:
      */
     CNode *ConnectWebSocketNode(const std::string &url,
                                 const CAddress *wss_addr, bool fCountFailure,
-                                ConnectionType conn_type);
+                                ConnectionType conn_type,
+                                const std::string &dest_name = "");
     ;
     void AddWhitelistPermissionFlags(
         NetPermissionFlags &flags, const CNetAddr &addr,
