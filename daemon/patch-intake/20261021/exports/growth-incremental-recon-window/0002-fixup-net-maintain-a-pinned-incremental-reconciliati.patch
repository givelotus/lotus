From 155f61fe56e94fa89eb42173550cf1d33a965799 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 13:38:09 -0700
Subject: [PATCH 2/2] fixup! net: maintain a pinned incremental reconciliation
 window

---
 src/test/radix_tests.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/test/radix_tests.cpp b/src/test/radix_tests.cpp
index 9e1a4b645e..26b488eb27 100644
--- a/src/test/radix_tests.cpp
+++ b/src/test/radix_tests.cpp
@@ -418,6 +418,16 @@ BOOST_AUTO_TEST_CASE(immutable_snapshot_cow) {
         BOOST_CHECK(second.get(key));
         BOOST_CHECK(!published->get(key + 256));
     }
+    // A join traverses one pinned view and looks up a second view using the
+    // existing read guard, without nesting RCU read sections.
+    const Tree &second_view = second;
+    size_t joined{0};
+    first.forEachLeaf([&](const auto &entry) {
+        BOOST_CHECK(second_view.getWithinReadSection(entry->getId()));
+        ++joined;
+        return true;
+    });
+    BOOST_CHECK_EQUAL(joined, 128U);
     // Descendant snapshots independently retain shared nodes after the
     // original publication is released.
     published.reset();
