--- a/daemon/patch-audit/progression/scripts/rpc_diagnostic.py
+++ b/daemon/patch-audit/progression/scripts/rpc_diagnostic.py
@@ -10,6 +10,13 @@ import time
 from steady_ingestion import FixtureExhausted, submit
 
 
+def checked_node_options(config):
+    options = config.get('node_options', [])
+    if options not in ([], ['-txreconinterval=0']):
+        raise ValueError('Only the explicit reconciliation-off diagnostic override is allowed')
+    return options
+
+
 def fixed_work(fixture, factory, before_start, count, batch=50, workers=8):
     if count <= 0 or count % batch:
         raise ValueError('Fixed diagnostic count must be a positive complete batch')
