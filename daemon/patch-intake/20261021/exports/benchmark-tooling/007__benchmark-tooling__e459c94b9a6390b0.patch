From e459c94b9a6390b0d4d2500ca4f8e6b200e21133 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 20:26:44 -0700
Subject: [PATCH] benchmark: honor pinned validation and build profiles in
 reports

---
 daemon/scripts/report-patch-progression.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/daemon/scripts/report-patch-progression.py b/daemon/scripts/report-patch-progression.py
index be9aecd9638f0847af4af063368386b13b4114ce..0d4f84e07eb343de0d0c66c4e633f00d8094ac87 100644
--- a/daemon/scripts/report-patch-progression.py
+++ b/daemon/scripts/report-patch-progression.py
@@ -53,7 +53,13 @@ def main():
     base, entries = driver.manifest(args.candidate)
     environment = json.loads((args.data / 'environment.json').read_text())
     # A report cannot revive measurements invalidated by source or harness edits.
-    harness, _ = driver.fingerprint(args.candidate, environment['repetitions'])
+    harness, current_environment = driver.fingerprint(args.candidate, environment['repetitions'])
+    if 'validation_scope' in environment:
+        current_environment['validation_scope'] = environment['validation_scope']
+        if 'cmake_flags_file_sha256' in environment:
+            current_environment['flags'] = environment['flags']
+            current_environment['cmake_flags_file_sha256'] = environment['cmake_flags_file_sha256']
+        harness = driver.digest(json.dumps(current_environment, sort_keys=True).encode())
     rows, columns, references = [], set(), {}
     for entry in entries:
         index = entry['index']
