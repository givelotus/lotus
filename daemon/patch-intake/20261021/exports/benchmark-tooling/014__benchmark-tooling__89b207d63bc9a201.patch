From 89b207d63bc9a201a44047d753f8779bacb8bf16 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 22:39:05 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 daemon/patch-audit/progression/scripts/steady_suite.py | 3 +++
 daemon/tests/test-steady-ingestion.py                  | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index 98614c15bdce54631532a24e5e01349948d4faf4..dc97f4e4698221e3527c2ed33c6ffb6320f89c96 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -77,6 +77,9 @@ def batch_rpc_available(client, evidence=None):
 
 def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
               case_filter=None, budget_only=False):
+    if budget_only and (fixture_smoke or case_filter not in
+                        ('single_tx_steady', 'json_rpc_batch50_steady', 'single_tx_loaded_steady')):
+        raise ValueError('Budget-only pass permits only the three common ingestion cases')
     c = context['clients'][0]
     clients = context['clients']
     directory = Path(context['base_dir']) / 'steady-fixtures'
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index 55b0763a165bb17b4b2d91a055806fe859aed0d3..3c143c16c52f3b49ff334c681db4456c79303180 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -146,6 +146,11 @@ class Tests(unittest.TestCase):
         client.reply = 'submitrawtxbatch ["hexstring",...]\nDetailed help'
         self.assertTrue(steady_suite.batch_rpc_available(client))
 
+    def test_budget_only_rejects_latency_and_oversized_warmups_before_context(self):
+        for case in ('fixed_latency', 'optrue_batch500_steady', 'optrue_batch1000_steady'):
+            with self.assertRaisesRegex(ValueError, 'only the three common'):
+                steady_suite.run_suite({}, 'l1', case_filter=case, budget_only=True)
+
 
 if __name__ == '__main__':
     unittest.main()
