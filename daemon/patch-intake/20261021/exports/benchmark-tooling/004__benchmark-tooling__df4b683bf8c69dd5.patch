diff --git a/daemon/tests/test-patch-progression.py b/daemon/tests/test-patch-progression.py
index e3b217ded4af3bcadc89ab18584908982396f443..8b39637220eea9586ebd59077c979f929b46a882 100644
--- a/daemon/tests/test-patch-progression.py
+++ b/daemon/tests/test-patch-progression.py
@@ -38,6 +38,17 @@ class KernelWorkloadTests(unittest.TestCase):
         self.assertTrue(set(native).isdisjoint(groups('old-prefix')))
         self.assertTrue(set(groups('old-prefix')).isdisjoint(groups('different-prefix')))
 
+    def test_runtime_comparison_uses_explicit_definition_not_incidental_outpoints(self):
+        def measured(raw, definition=None):
+            run = {'workload': 'legacy', 'transaction_fixture_sha256': raw,
+                   'metrics': {'single_tps': 10}}
+            if definition is not None:
+                run['workload_id'] = definition
+            return report.measurements({'metrics': {'runs': [run]}})
+        self.assertEqual(measured('outpoint-a', 'same-shape'), measured('outpoint-b', 'same-shape'))
+        self.assertNotEqual(measured('outpoint-a'), measured('outpoint-b'))
+        self.assertNotEqual(measured('a', 'shape-a'), measured('a', 'shape-b'))
+
     def test_absent_kernel_results_need_no_kernel_identity(self):
         self.assertEqual(report.measurements({'metrics': {'runs': [], 'kernel_runs': []}}), {})
 
