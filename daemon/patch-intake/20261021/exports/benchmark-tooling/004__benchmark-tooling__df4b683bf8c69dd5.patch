+        definition=data.get('workload_definition', {'historical_script_sha256':meta['script_sha256'],'track':a.series})
+        a.output.write_text(json.dumps({'metrics':data,'status':meta['status'],'workload':('native-compatibility-smoke' if a.smoke else 'historical-'+a.series),'workload_id':hashlib.sha256(json.dumps(definition,sort_keys=True).encode()).hexdigest(),'workload_definition':definition,'transaction_fixture_sha256':data.get('transaction_fixture_sha256'),'provenance':meta},indent=2))
