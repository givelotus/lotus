+        'validation': validation,
         'cmake_flags_file': str(flags_file.resolve()) if flags_file else None,
         'cmake_flags': progression.cmake_flags(flags_file),
         'cmake_flags_file_sha256': progression.digest(flags_file.read_bytes()) if flags_file else None,
@@ -63,12 +64,14 @@ def execute(plan, candidate, data, source, build, jobs, repetitions, upstream, l
     points = plan['points'] if limit is None else plan['points'][:limit]
     for point in points:
