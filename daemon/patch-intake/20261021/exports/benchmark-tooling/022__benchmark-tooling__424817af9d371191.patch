From 424817af9d371191ddd22a29835d4e04781bf5cf Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 00:48:44 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 .../progression/scripts/steady_suite.py       | 11 ++++++++++-
 daemon/tests/test-steady-ingestion.py         | 19 +++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index e94b0ec5ee08c1cf342063724d933f1a561cf10b..220d99de8f2e79fec3f1f008f5a1814eec390e20 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -89,8 +89,17 @@ def funding_fanout_width(source, native):
         return 1000
     text = (Path(source) / 'src/consensus/consensus.h').read_text()
     match = re.search(r'MAX_V2_TX_OUTPUTS\s*=\s*(\d+)\s*;', text)
+    if match is None:
+        # Early native prefixes use the wire profile before the tighter consensus
+        # constant exists. Accept only that source-declared codec/profile pair.
+        header = Path(source) / 'src/lotus_v2/transaction.h'
+        codec = Path(source) / 'src/primitives/transaction.cpp'
+        if header.exists() and codec.exists() and 'lotus::v2::DefaultTxProfile' in codec.read_text():
+            match = re.search(
+                r'inline\s+constexpr\s+TxProfile\s+DefaultTxProfile\s*\{\s*\d+\s*,\s*(\d+)\s*,',
+                header.read_text())
     if match is None or int(match.group(1)) < 1:
-        raise ValueError('Native funding requires an explicit positive MAX_V2_TX_OUTPUTS')
+        raise ValueError('Native funding requires an explicit positive output bound')
     return min(1000, int(match.group(1)))
 
 
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index fd285e601fa774b7573f7a5c8e894afdad60bd26..147324702675553b77473a9cf8806fcdd18fd35d 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -169,6 +169,25 @@ class Tests(unittest.TestCase):
             with self.assertRaises(ValueError):
                 steady_suite.funding_fanout_width(root, True)
 
+    def test_early_native_funding_requires_declared_profile_and_codec(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            header = root / 'src/consensus/consensus.h'
+            header.parent.mkdir(parents=True)
+            header.write_text('// Earlier prefix: no tighter consensus constant')
+            profile = root / 'src/lotus_v2/transaction.h'
+            profile.parent.mkdir(parents=True)
+            profile.write_text('inline constexpr TxProfile DefaultTxProfile{65535, 65535, 1};')
+            codec = root / 'src/primitives/transaction.cpp'
+            codec.parent.mkdir(parents=True)
+            codec.write_text('Encode(tx, lotus::v2::DefaultTxProfile);')
+            self.assertEqual(steady_suite.funding_fanout_width(root, True), 1000)
+            profile.write_text('inline constexpr TxProfile DefaultTxProfile{65535, 128, 1};')
+            self.assertEqual(steady_suite.funding_fanout_width(root, True), 128)
+            codec.write_text('// No matching wire profile')
+            with self.assertRaises(ValueError):
+                steady_suite.funding_fanout_width(root, True)
+
     def test_budget_only_rejects_latency_and_oversized_warmups_before_context(self):
         for case in ('fixed_latency', 'optrue_batch500_steady', 'optrue_batch1000_steady'):
             with self.assertRaisesRegex(ValueError, 'only the three common'):
