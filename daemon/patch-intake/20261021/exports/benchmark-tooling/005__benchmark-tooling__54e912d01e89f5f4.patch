From 54e912d01e89f5f49872fbbf779b611d162b753f Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 20:23:22 -0700
Subject: [PATCH] benchmark: build only required binaries for initial focused
 anchors

---
 daemon/scripts/patch-progression.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/daemon/scripts/patch-progression.py b/daemon/scripts/patch-progression.py
index f52d1c9a671f2b13f0585d590ae218f45c2e21d9..bb58572896134861ff1b14c5021b984174c1367f 100644
--- a/daemon/scripts/patch-progression.py
+++ b/daemon/scripts/patch-progression.py
@@ -383,7 +383,9 @@ def main():
             run('configure', ['cmake', '-GNinja', '-S', source, '-B', build, *flags])
             daemon = 'lotusd' if 'add_executable(lotusd' in (source / 'src/CMakeLists.txt').read_text() else 'bitcoind'
             targets = subprocess.check_output(['ninja', '-C', str(build), '-t', 'targets', 'all'], text=True)
-            extras = [target for target in ('bitcoin-bench', 'bitcoin-cli', 'lotus-cli', 'test_lotus_v2_disk_state') if re.search('^' + target + ':', targets, re.M)]
+            extra_targets = (('bitcoin-cli', 'lotus-cli') if args.validation == 'focused' else
+                             ('bitcoin-bench', 'bitcoin-cli', 'lotus-cli', 'test_lotus_v2_disk_state'))
+            extras = [target for target in extra_targets if re.search('^' + target + ':', targets, re.M)]
             built = run('build', ['ninja', '-C', build, '-j', str(args.jobs), daemon, 'test_bitcoin', 'test-avalanche', *extras])
             record['incremental_build_seconds'] = built['seconds']
             record['binary_sha256'] = digest((build / 'src' / daemon).read_bytes())
