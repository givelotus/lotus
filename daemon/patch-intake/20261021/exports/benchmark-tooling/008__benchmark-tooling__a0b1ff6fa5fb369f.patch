From a0b1ff6fa5fb369f371b4fb35415b7fef140322c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 20:30:18 -0700
Subject: [PATCH] benchmark: reuse matching successes without disturbing
 incremental checkout

---
 daemon/scripts/schedule-patch-benchmarks.py   | 25 +++++++++++++++++++
 .../tests/test-schedule-patch-benchmarks.py   | 20 +++++++++++++++
 2 files changed, 45 insertions(+)

diff --git a/daemon/scripts/schedule-patch-benchmarks.py b/daemon/scripts/schedule-patch-benchmarks.py
index c611ee7551a27adfeddde4c31789d6c985583253..7984fed1ed64e65180da654bbbffb9578e59d364 100644
--- a/daemon/scripts/schedule-patch-benchmarks.py
+++ b/daemon/scripts/schedule-patch-benchmarks.py
@@ -60,6 +60,28 @@ def make_plan(candidate, consensus_owner=None, flags_file=None, validation='cont
     }
 
 
+def reusable_point(plan, candidate, data, source, point, repetitions):
+    path = data / f"patch_{point['index']:03}.json"
+    if not path.exists():
+        return False
+    record = json.loads(path.read_text())
+    if record.get('status') != 'ok' or record.get('prefix_sha256') != point['prefix_sha256']:
+        return False
+    _, environment = progression.fingerprint(candidate, repetitions)
+    environment['validation_scope'] = plan.get('validation', 'contracts')
+    if plan.get('cmake_flags_file'):
+        profile = Path(plan['cmake_flags_file'])
+        environment['flags'] = progression.cmake_flags(profile)
+        environment['cmake_flags_file_sha256'] = progression.digest(profile.read_bytes())
+    harness = progression.digest(json.dumps(environment, sort_keys=True).encode())
+    expected_tree = point.get('canonical_source_tree')
+    if point['index'] == 0:
+        expected_tree = progression.git(source, 'rev-parse', plan['base'] + '^{tree}')
+    return bool(expected_tree and record.get('source_tree') == expected_tree and
+                record.get('correctness_passed') and
+                progression.matching_harness(record, harness, data))
+
+
 def execute(plan, candidate, data, source, build, jobs, repetitions, upstream, limit=None):
     points = plan['points'] if limit is None else plan['points'][:limit]
     for point in points:
@@ -67,6 +89,9 @@ def execute(plan, candidate, data, source, build, jobs, repetitions, upstream, l
                      Path(plan['cmake_flags_file']) if plan.get('cmake_flags_file') else None,
                      plan.get('validation', 'contracts')) != plan:
             raise progression.GateFailure('Candidate or runner changed; generate a new schedule')
+        if reusable_point(plan, candidate, data, source, point, repetitions):
+            print(json.dumps({'patch': point['index'], 'status': 'reused', 'source_checkout_unchanged': True}), flush=True)
+            continue
         command = [sys.executable, str(RUNNER), '--candidate', str(candidate),
                    '--data', str(data), '--source', str(source), '--build', str(build),
                    '--point', str(point['index']), '--jobs', str(jobs),
diff --git a/daemon/tests/test-schedule-patch-benchmarks.py b/daemon/tests/test-schedule-patch-benchmarks.py
index f039a6c47b40fd172d4adf5fc2e39ed004d3b2b2..525b01a2891453a0ce6d7b206bb38a65286a2094 100644
--- a/daemon/tests/test-schedule-patch-benchmarks.py
+++ b/daemon/tests/test-schedule-patch-benchmarks.py
@@ -80,6 +80,26 @@ class ScheduleTests(unittest.TestCase):
         self.assertEqual(run.call_count, 2)
         self.assertEqual([call.args[0][call.args[0].index('--point') + 1] for call in run.call_args_list], ['0', '8'])
 
+    def test_reused_success_preserves_current_incremental_checkout(self):
+        with tempfile.TemporaryDirectory() as directory:
+            data = Path(directory)
+            point = {'index': 2, 'prefix_sha256': 'prefix', 'canonical_source_tree': 'tree'}
+            record = {'status': 'ok', 'prefix_sha256': 'prefix', 'source_tree': 'tree',
+                      'correctness_passed': True}
+            (data / 'patch_002.json').write_text(json.dumps(record))
+            plan = {'points': [point]}
+            with patch.object(schedule, 'make_plan', return_value=plan), patch.object(
+                    schedule.progression, 'fingerprint', return_value=('unused', {})), patch.object(
+                    schedule.progression, 'matching_harness', return_value=True), patch.object(
+                    schedule.subprocess, 'run') as run:
+                self.assertEqual(schedule.execute(plan, Path('/candidate'), data,
+                    Path('/source'), Path('/build'), 2, 1, '/upstream'), 0)
+                run.assert_not_called()
+            record['prefix_sha256'] = 'stale'
+            (data / 'patch_002.json').write_text(json.dumps(record))
+            self.assertFalse(schedule.reusable_point(plan, Path('/candidate'), data,
+                                                    Path('/source'), point, 1))
+
     def test_changed_candidate_stops_before_launch(self):
         with patch.object(schedule, 'make_plan', return_value={'changed': True}), patch.object(
                 schedule.subprocess, 'run') as run:
