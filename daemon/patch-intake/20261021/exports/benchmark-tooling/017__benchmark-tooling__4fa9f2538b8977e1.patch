From 4fa9f2538b8977e1b88220b489f5c4996945b1f7 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 22:44:13 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 daemon/patch-audit/progression/scripts/steady_suite.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index 8e0a9d23fb7aa412e05f02c3f761f78432eaaeba..bc44b3d5f561fc046eefcc15f46bf7ae7bf4d62a 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -94,7 +94,11 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
         'maxmempool_mib_per_node': 1024, 'warmup_batches_per_worker': 2,
         'public_regtest_secret': 42, 'signature_fixture_distribution': '16 reused deterministic nonce points; intentionally insecure public benchmark key only',
         'historical_legacy_signing_distribution_identical': False,
-        'fixture_disk_cap_bytes': 512 * 1024 * 1024,
+        'case': case_filter}
+    # Preparation ceilings can differ by resource allocation; they do not alter
+    # the timed RPC protocol. Exhaustion remains a failed measurement.
+    results['preparation_limits'] = {
+        'fixture_disk_cap_bytes': (16 if budget_only else 512) * 1024 * 1024,
         'max_fixture_transactions': max_transactions}
     to_hex = context['ToHex']
     native = series == 'v2'
