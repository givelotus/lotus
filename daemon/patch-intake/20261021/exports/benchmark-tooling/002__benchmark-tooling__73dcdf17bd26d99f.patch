+++ b/daemon/tests/test-native-workload-adapter.py
@@ -0,0 +1,61 @@
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+
+FILE = Path(__file__).resolve().parents[1] / 'patch-audit/progression/scripts/native_workload_adapter.py'
+spec = importlib.util.spec_from_file_location('adapter', FILE)
+adapter = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(adapter)
+
+
+class AdapterTests(unittest.TestCase):
+    def test_exact_native_and_ecash_rpc_amounts(self):
+        class Client:
+            def call(self, method):
+                self.method = method
+                return {'satoshisperunit': self.scale}
+        client = Client()
+        client.scale = 1000000
+        self.assertEqual(adapter.amount_to_sats(client, '1.000001'), 1000001)
+        client.scale = 100
+        self.assertEqual(adapter.amount_to_sats(client, '1.01'), 101)
+        with self.assertRaises(ValueError):
+            adapter.amount_to_sats(client, '1.001')
+
+    def test_frozen_script_adaptation_preserves_rejection_and_compiles(self):
+        frozen = FILE.parent.parent / 'harness/v2/lotus_v2_loopback_tps_stress.py'
+        with tempfile.TemporaryDirectory() as temp:
+            source = Path(temp)
+            (source / 'src/consensus').mkdir(parents=True)
+            (source / 'src/consensus/tx_verify.cpp').write_text('bad-txns-legacy-spends-v2-coin')
+            code, details = adapter.adapt(frozen.read_text(), source)
+            compile(code, 'adapted-benchmark', 'exec')
+            self.assertIn('assert not legacy_check["allowed"]', code)
+            self.assertIn('"bad-txns-legacy-spends-v2-coin", "bad-txns-nonstandard-inputs"', code)
+            self.assertIn('NativeAmountToSats(clients[0]', code)
+            self.assertEqual(details['amounts'], 'getcurrencyinfo.satoshisperunit')
+
+    def test_strict_native_payout_and_template_retain_policy(self):
+        with tempfile.TemporaryDirectory() as temp:
+            source = Path(temp)
+            (source / 'src/rpc').mkdir(parents=True)
+            (source / 'src/rpc/mining.cpp').write_text('Legacy descriptors are unsupported for native coinbases')
+            (source / 'test/functional/test_framework').mkdir(parents=True)
+            (source / 'test/functional/test_framework/xpiaddr.py').write_text(
+                'def encode(hrp, root):\n    assert hrp == "rxpi" and root == b"x" * 32\n    return "rxpi1test"\n')
+            class Client:
+                def call(self, method, params):
+                    return method, params
+            adapter.install(Client, source, b'x' * 32)
+            client = Client()
+            self.assertEqual(client.call('generatetodescriptor', [1, 'raw(4e)']),
+                             ('generatetoaddress', [1, 'rxpi1test']))
+            self.assertEqual(client.call('getblocktemplate', [{'mode': 'compact_template'}]),
+                             ('getblocktemplate', [{'mode': 'compact_template', 'mineraddress': 'rxpi1test'}]))
+            with self.assertRaises(ValueError):
+                client.call('generatetodescriptor', [1, 'raw(51)'])
+
+
+if __name__ == '__main__':
+    unittest.main()
