Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 .../progression/scripts/legacy_loopback.py    |  3 ++-
 .../progression/scripts/steady_suite.py       | 27 ++++++++++++-------
 daemon/tests/test-steady-ingestion.py         | 12 +++++++++
 3 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/daemon/patch-audit/progression/scripts/legacy_loopback.py b/daemon/patch-audit/progression/scripts/legacy_loopback.py
index 1f0efa7b7c0b3f2b92b079ca4383fc0b449cb7c0..bb410fb01f0631e361a8f36f344aff18bed1e631 100644
--- a/daemon/patch-audit/progression/scripts/legacy_loopback.py
+++ b/daemon/patch-audit/progression/scripts/legacy_loopback.py
@@ -107,7 +107,8 @@ def main():
                     stop.set();times=sum([f.result() for f in futures],[])
                 sec=time.perf_counter()-st
                 return dict(pairs=len(times),rpc_calls=len(times)*2,seconds=sec,rpc_per_second=len(times)*2/sec,latency_unit='two sequential RPCs per reader',**stats(times))
-            m=out['metrics'];m['read_unloaded']=readload();save()
+            m=out['metrics']
+            if not args.latency_only:m['read_unloaded']=readload();save()
             if not args.latency_only:
                 m['single_tx']=ingest(pools[0]);mine();m['json_rpc_batch50']=ingest(pools[1],True);mine();save()
             st=time.perf_counter();relay_ingest=ingest(pools[2]);wait(lambda:all(x.call('getmempoolinfo')['size']==500 for x in clients));sec=time.perf_counter()-st
diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index 14402c0c905a6658b54cca8376bfd487ddf746b2..ef3d2f18ea83bb7e20e548836bec5ce48a055658 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -64,6 +64,17 @@ def fixture_budget(pilot_count, pilot_seconds, batch_size, max_transactions):
     return count
 
 
+def batch_rpc_available(client, evidence=None):
+    # ABC help for unknown methods can succeed with an error *string*.
+    try:
+        reply = client.call('help', ['submitrawtxbatch'])
+    except RuntimeError:
+        return False
+    if evidence is not None:
+        evidence['help_response'] = reply
+    return isinstance(reply, str) and reply.startswith('submitrawtxbatch ')
+
+
 def run_suite(context, series, max_transactions=1200000, fixture_smoke=False):
     c = context['clients'][0]
     clients = context['clients']
@@ -189,11 +200,9 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False):
                         'index_bytes': len(output.offsets) * output.offsets.itemsize}
 
     if fixture_smoke:
-        try:
-            c.call('help', ['submitrawtxbatch'])
-            batch_available = True
-        except RuntimeError:
-            batch_available = False
+        evidence = {}
+        batch_available = batch_rpc_available(c, evidence)
+        results['batch_capability'] = {'available': batch_available, **evidence}
         for signed in (True, False):
             prepared, details = fixture('smoke-signed' if signed else 'smoke-optrue', 32, signed)
             try:
@@ -221,11 +230,9 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False):
     cases = [('single_tx_steady', 'individual', 1, True, 0, False),
              ('json_rpc_batch50_steady', 'json_array', 50, True, 0, False),
              ('single_tx_loaded_steady', 'individual', 1, True, 12, False)]
-    try:
-        c.call('help', ['submitrawtxbatch'])
-        batch_available = True
-    except RuntimeError:
-        batch_available = False
+    evidence = {}
+    batch_available = batch_rpc_available(c, evidence)
+    results['batch_capability'] = {'available': batch_available, **evidence}
     if batch_available:
         cases.append(('signed_batch200_steady', 'dedicated_batch', 200, True, 0, False))
         cases.append(('chained_signed_batch200_steady', 'dedicated_batch', 200, True, 0, True))
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index 6e6a10397951afe91915c8a1acc962232ad7abf7..55b0763a165bb17b4b2d91a055806fe859aed0d3 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -134,6 +134,18 @@ class Tests(unittest.TestCase):
         self.assertEqual(result['p95_ms_lower_bound'], 100.01)
         self.assertEqual(result['overflow_count'], 99)
 
+    def test_unknown_help_string_does_not_invent_batch_capability(self):
+        class Client:
+            reply = 'help: unknown command: submitrawtxbatch'
+            def call(self, method, params=None):
+                return self.reply
+        client = Client()
+        self.assertFalse(steady_suite.batch_rpc_available(client))
+        client.reply = ''
+        self.assertFalse(steady_suite.batch_rpc_available(client))
+        client.reply = 'submitrawtxbatch ["hexstring",...]\nDetailed help'
+        self.assertTrue(steady_suite.batch_rpc_available(client))
+
 
 if __name__ == '__main__':
     unittest.main()
