Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 .../progression/scripts/steady_suite.py         | 17 +++++++++++++++--
 daemon/tests/test-steady-ingestion.py           | 14 ++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index 5bbe3e5f9345f80cf888f6beeaf17d21b378ae48..e94b0ec5ee08c1cf342063724d933f1a561cf10b 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -7,6 +7,7 @@ import json
 import math
 from pathlib import Path
 import resource
+import re
 import subprocess
 import time
 
@@ -83,6 +84,16 @@ def batch_rpc_available(client, evidence=None):
     return isinstance(reply, str) and reply.startswith('submitrawtxbatch ')
 
 
+def funding_fanout_width(source, native):
+    if not native:
+        return 1000
+    text = (Path(source) / 'src/consensus/consensus.h').read_text()
+    match = re.search(r'MAX_V2_TX_OUTPUTS\s*=\s*(\d+)\s*;', text)
+    if match is None or int(match.group(1)) < 1:
+        raise ValueError('Native funding requires an explicit positive MAX_V2_TX_OUTPUTS')
+    return min(1000, int(match.group(1)))
+
+
 def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
               case_filter=None, budget_only=False):
     if budget_only and (fixture_smoke or case_filter not in
@@ -167,7 +178,8 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
         output = DiskFixture(directory / (name + '.bin'),
                              max_bytes=(16 if budget_only else 512) * 1024 * 1024)
         roots = math.ceil(count / (4 if chained else 1))
-        chunks = math.ceil(roots / 1000)
+        fanout_width = funding_fanout_width(context['NativeSource'], native) if native else 1000
+        chunks = math.ceil(roots / fanout_width)
         hashes = mine(chunks + 100)
         remaining = count
         sizes = set()
@@ -178,7 +190,7 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
             if amount != amount.to_integral_value():
                 raise ValueError('Nonintegral coinbase amount')
             amount = int(amount)
-            width = min(1000, max(100, math.ceil(remaining / (4 if chained else 1))))
+            width = min(fanout_width, max(100, math.ceil(remaining / (4 if chained else 1))))
             value = (amount - 200000) // width
             if value <= 2000:
                 raise ValueError('Coinbase cannot fund bounded independent fixture')
@@ -215,6 +227,7 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
         output.seal()
         return output, {'fund_and_sign_seconds': time.perf_counter() - started,
                         'transaction_count': count, 'transaction_sizes': sorted(sizes),
+                        'funding_fanout_width': fanout_width, 'funding_coinbase_chunks': chunks,
                         'disk_bytes': output.path.stat().st_size,
                         'index_bytes': len(output.offsets) * output.offsets.itemsize}
 
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index a24d978f0b1964f49ec07bebdc752017735c2fa8..fd285e601fa774b7573f7a5c8e894afdad60bd26 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -155,6 +155,20 @@ class Tests(unittest.TestCase):
         client.reply = 'submitrawtxbatch ["hexstring",...]\nDetailed help'
         self.assertTrue(steady_suite.batch_rpc_available(client))
 
+    def test_native_funding_respects_consensus_output_bound(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            header = root / 'src/consensus/consensus.h'
+            header.parent.mkdir(parents=True)
+            header.write_text('static constexpr size_t MAX_V2_TX_OUTPUTS = 256;')
+            self.assertEqual(steady_suite.funding_fanout_width(root, True), 256)
+            self.assertEqual(steady_suite.funding_fanout_width(root, False), 1000)
+            header.write_text('static constexpr size_t MAX_V2_TX_OUTPUTS = 32;')
+            self.assertEqual(steady_suite.funding_fanout_width(root, True), 32)
+            header.write_text('// No declared native output bound')
+            with self.assertRaises(ValueError):
+                steady_suite.funding_fanout_width(root, True)
+
     def test_budget_only_rejects_latency_and_oversized_warmups_before_context(self):
         for case in ('fixed_latency', 'optrue_batch500_steady', 'optrue_batch1000_steady'):
             with self.assertRaisesRegex(ValueError, 'only the three common'):
