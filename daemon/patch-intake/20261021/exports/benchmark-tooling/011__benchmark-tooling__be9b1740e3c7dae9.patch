Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 .../scripts/historical_loopback.py            |  8 +++--
 .../progression/scripts/steady_suite.py       | 32 ++++++++++++++++++-
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/daemon/patch-audit/progression/scripts/historical_loopback.py b/daemon/patch-audit/progression/scripts/historical_loopback.py
index 60973d2e4ce0982bc76edd4f7e64798e4e57a473..6a9814cdd02c0cf3f39aeb2f4e964d03f1d24d1a 100644
--- a/daemon/patch-audit/progression/scripts/historical_loopback.py
+++ b/daemon/patch-audit/progression/scripts/historical_loopback.py
@@ -11,9 +11,11 @@ from native_workload_adapter import adapt as adapt_native, install as install_na
 from steady_suite import run_suite as run_steady_suite
 random.seed(20261018)
 ROOT=Path(__file__).resolve().parents[1]
-p=argparse.ArgumentParser();p.add_argument('--series',choices=['l1','v2'],required=True);p.add_argument('--daemon',required=True);p.add_argument('--output',type=Path,required=True);p.add_argument('--source',type=Path,required=True);p.add_argument('--smoke',action='store_true');p.add_argument('--steady',action='store_true');p.add_argument('--prepare-only',action='store_true');p.add_argument('--max-fixture-transactions',type=int,default=1200000);p.add_argument('--port-base',type=int,default=35110);a=p.parse_args()
+p=argparse.ArgumentParser();p.add_argument('--series',choices=['l1','v2'],required=True);p.add_argument('--daemon',required=True);p.add_argument('--output',type=Path,required=True);p.add_argument('--source',type=Path,required=True);p.add_argument('--smoke',action='store_true');p.add_argument('--steady',action='store_true');p.add_argument('--prepare-only',action='store_true');p.add_argument('--fixture-smoke',action='store_true');p.add_argument('--max-fixture-transactions',type=int,default=1200000);p.add_argument('--port-base',type=int,default=35110);a=p.parse_args()
 os.environ['LOTUSD_BIN']=a.daemon
 os.environ['SRCDIR']=str(a.source)
+if a.fixture_smoke and not a.steady:
+    raise ValueError('Bounded fixture smoke requires the steady bootstrap')
 script=ROOT/('harness/l1/test/functional/lotus_v2_loopback_tps_stress.py' if a.series=='l1' else 'harness/v2/lotus_v2_loopback_tps_stress.py')
 sys.path.insert(0,str(script.parent if a.series=='l1' else script.parent/'test/functional'))
 code=script.read_text();adaptations=[]
@@ -31,7 +33,7 @@ if a.steady:
     anchor = '        block_hashes = clients[0].call('
     if code.count(anchor) != 1:
         raise ValueError('Frozen pre-funding bootstrap anchor changed')
-    code = code.replace(anchor, '        results = PersistedMetrics()\n        SteadySuite({**globals(), **locals()}, '+repr(a.series)+', '+str(a.max_fixture_transactions)+')\n        return\n\n'+anchor, 1)
+    code = code.replace(anchor, '        results = PersistedMetrics()\n        SteadySuite({**globals(), **locals()}, '+repr(a.series)+', '+str(a.max_fixture_transactions)+', '+str(a.fixture_smoke)+')\n        return\n\n'+anchor, 1)
     code = code.replace('"-maxmempool=500"', '"-maxmempool=1024"')
     adaptations.append('steady-state-v2: frozen bootstrap/builders only; bypass every historical short burst; >=5s warmed ingestion, distinct bounded disk fixtures; maxmempool=1024MiB')
 adaptations.append('use platform temporary directory; no historical worktree dependency')
@@ -118,5 +120,5 @@ finally:
     if a.output.exists():
         data=json.loads(a.output.read_text())
         definition=data.get('workload_definition', {'historical_script_sha256':meta['script_sha256'],'track':a.series})
-        a.output.write_text(json.dumps({'metrics':data,'status':meta['status'],'workload':('native-compatibility-smoke' if a.smoke else ('steady-v2-' if a.steady else 'historical-')+a.series),'workload_id':hashlib.sha256(json.dumps(definition,sort_keys=True).encode()).hexdigest(),'workload_definition':definition,'transaction_fixture_sha256':data.get('transaction_fixture_sha256'),'provenance':meta},indent=2))
+        a.output.write_text(json.dumps({'metrics':data,'status':meta['status'],'workload':('native-compatibility-smoke' if a.smoke else ('fixture-compatibility-smoke-v2-' if a.fixture_smoke else 'steady-v2-' if a.steady else 'historical-')+a.series),'workload_id':hashlib.sha256(json.dumps(definition,sort_keys=True).encode()).hexdigest(),'workload_definition':definition,'transaction_fixture_sha256':data.get('transaction_fixture_sha256'),'provenance':meta},indent=2))
     time.sleep(1)
diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index 8d8bdd7e836a424ff909a4d768da6d9ad54cb56a..14402c0c905a6658b54cca8376bfd487ddf746b2 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -64,7 +64,7 @@ def fixture_budget(pilot_count, pilot_seconds, batch_size, max_transactions):
     return count
 
 
-def run_suite(context, series, max_transactions=1200000):
+def run_suite(context, series, max_transactions=1200000, fixture_smoke=False):
     c = context['clients'][0]
     clients = context['clients']
     directory = Path(context['base_dir']) / 'steady-fixtures'
@@ -188,6 +188,36 @@ def run_suite(context, series, max_transactions=1200000):
                         'disk_bytes': output.path.stat().st_size,
                         'index_bytes': len(output.offsets) * output.offsets.itemsize}
 
+    if fixture_smoke:
+        try:
+            c.call('help', ['submitrawtxbatch'])
+            batch_available = True
+        except RuntimeError:
+            batch_available = False
+        for signed in (True, False):
+            prepared, details = fixture('smoke-signed' if signed else 'smoke-optrue', 32, signed)
+            try:
+                client = Client()
+                for _ in range(8):
+                    submit(client, 'individual', prepared.take(1))
+                submit(client, 'json_array', prepared.take(8))
+                remaining = prepared.take(16)
+                if batch_available:
+                    submit(client, 'dedicated_batch', remaining)
+                else:
+                    submit(client, 'json_array', remaining)
+                if c.call('getmempoolinfo')['size'] != 32:
+                    raise RuntimeError('Bounded fixture smoke inventory mismatch')
+                results['smoke_signed' if signed else 'smoke_optrue'] = {
+                    'accepted_unique_transactions': 32, 'fixture_sha256': prepared.digest.hexdigest(),
+                    'preparation': details, 'throughput_measured': False,
+                    'batch_available': batch_available, 'memory': memory_snapshot()}
+            finally:
+                prepared.close()
+                prepared.path.unlink()
+            clear_by_mining()
+        return
+
     cases = [('single_tx_steady', 'individual', 1, True, 0, False),
              ('json_rpc_batch50_steady', 'json_array', 50, True, 0, False),
              ('single_tx_loaded_steady', 'individual', 1, True, 12, False)]
