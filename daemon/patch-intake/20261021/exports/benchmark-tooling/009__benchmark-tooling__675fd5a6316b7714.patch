+#!/usr/bin/env python3
+import importlib.util
+from pathlib import Path
+import tempfile
+import threading
+import time
+import unittest
+import sys
+
+PATH = Path(__file__).resolve().parents[1] / 'patch-audit/progression/scripts/steady_ingestion.py'
+spec = importlib.util.spec_from_file_location('steady', PATH)
+steady = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(steady)
+sys.path.insert(0, str(PATH.parent))
+import steady_suite
+
+
+class Clock:
+    def __init__(self):
+        self.value = 0.0
+        self.lock = threading.Lock()
+
+    def __call__(self):
+        with self.lock:
+            self.value += 0.01
+            return self.value
+
+
+class Tests(unittest.TestCase):
+    def test_disk_fixture_is_distinct_bounded_and_exhausts(self):
+        with tempfile.TemporaryDirectory() as directory:
+            fixture = steady.DiskFixture(Path(directory) / 'fixture', max_bytes=20)
+            fixture.append('00')
+            fixture.append('11')
+            with self.assertRaises(ValueError):
+                fixture.append('ff' * 10)
+            fixture.seal()
+            self.assertEqual(fixture.take(1), ['00'])
+            self.assertEqual(fixture.take(3), ['11'])
+            with self.assertRaises(steady.FixtureExhausted):
+                fixture.take(1)
+            fixture.close()
+
+    def test_minimum_duration_is_enforced(self):
+        with self.assertRaisesRegex(ValueError, 'five seconds'):
+            steady.measure(None, None, 'individual', 1, seconds=0.1)
+
+    def test_warmup_is_excluded_and_every_measured_tx_is_unique(self):
+        seen = []
+        lock = threading.Lock()
+
+        class Client:
+            def call(self, method, params=None):
+                if method != 'sendrawtransaction':
+                    return
+                with lock:
+                    seen.append(params[0])
+
+        with tempfile.TemporaryDirectory() as directory:
+            fixture = steady.DiskFixture(Path(directory) / 'fixture')
+            for i in range(2000):
+                fixture.append(f'{i:08x}')
+            fixture.seal()
+            result = steady.measure(fixture, Client, 'individual', 1,
+                                    clock=Clock(), workers=8, warmup_batches=2)
+            self.assertGreaterEqual(result['seconds'], 5)
+            self.assertEqual(len(seen), len(set(seen)))
+            self.assertEqual(result['tx_count'], len(seen) - 16)
+            self.assertEqual(result['request_count'], result['tx_count'])
+            fixture.close()
+
+    def test_rejection_aborts_instead_of_counting_success(self):
+        class Client:
+            def call(self, method, params=None):
+                return {'accepted': False, 'reason': 'negative control'}
+        with self.assertRaisesRegex(RuntimeError, 'rejected'):
+            steady.submit(Client(), 'dedicated_batch', ['00'])
+
+    def test_exhaustion_is_a_failed_measurement(self):
+        class Client:
+            def call(self, method, params=None):
+                pass
+        with tempfile.TemporaryDirectory() as directory:
+            fixture = steady.DiskFixture(Path(directory) / 'fixture')
+            fixture.append('00')
+            fixture.seal()
+            with self.assertRaises(steady.FixtureExhausted):
+                steady.measure(fixture, Client, 'individual', 1, workers=1,
+                               warmup_batches=0, clock=Clock())
+            fixture.close()
+
+    def test_loaded_readers_share_writer_window(self):
+        class Client:
+            def call(self, method, params=None):
+                time.sleep(0.00001)
+        with tempfile.TemporaryDirectory() as directory:
+            fixture = steady.DiskFixture(Path(directory) / 'fixture')
+            for index in range(4000):
+                fixture.append(f'{index:08x}')
+            fixture.seal()
