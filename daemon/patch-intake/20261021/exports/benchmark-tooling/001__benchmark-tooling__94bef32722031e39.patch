@@ -27,6 +27,20 @@ FLAGS = ['-DCMAKE_BUILD_TYPE=Release', '-DBUILD_WALLET=OFF', '-DBUILD_QT=OFF',
          '-DENABLE_NATPMP=OFF']
 
 
+def cmake_flags(path=None):
+    if path is None:
+        return list(FLAGS)
+    values = json.loads(Path(path).read_text())
+    if not isinstance(values, list) or not values or not all(
+            isinstance(value, str) and re.fullmatch(r'-D[A-Za-z_][A-Za-z0-9_]*(?::[A-Z]+)?=.+', value)
+            for value in values):
+        raise GateFailure('CMake flags file must contain a nonempty JSON array of -DNAME=value definitions')
+    names = [value[2:].split('=', 1)[0].split(':', 1)[0] for value in values]
+    if len(set(names)) != len(names):
+        raise GateFailure('Duplicate CMake definitions are ambiguous')
+    return values
+
+
