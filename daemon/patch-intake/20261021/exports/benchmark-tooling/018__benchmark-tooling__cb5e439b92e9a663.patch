From cb5e439b92e9a66337db39a86d79046228554568 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 22:49:08 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 .../patch-audit/progression/scripts/steady_suite.py | 13 ++++++++-----
 daemon/tests/test-steady-ingestion.py               |  3 +++
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index bc44b3d5f561fc046eefcc15f46bf7ae7bf4d62a..cf84655f6efba62be3215cfa8c30a801c0925872 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -57,12 +57,13 @@ def fixture_budget(pilot_count, pilot_seconds, batch_size, max_transactions):
     rate = pilot_count / pilot_seconds
     # Three times the measured window accommodates a noisy short sizing pilot.
     # Unused rows are never included in accepted counts or timed throughput.
-    count = math.ceil(rate * 15.0) + 16 * batch_size
-    count = math.ceil(count / batch_size) * batch_size
-    if count > max_transactions:
-        raise ValueError(f'Pilot needs {count} distinct transactions (rate={rate:.1f}/s); '
+    preferred = math.ceil((rate * 15.0 + 16 * batch_size) / batch_size) * batch_size
+    minimum = math.ceil((rate * 7.5 + 16 * batch_size) / batch_size) * batch_size
+    capacity = (max_transactions // batch_size) * batch_size
+    if capacity < minimum:
+        raise ValueError(f'Pilot needs at least {minimum} distinct transactions (rate={rate:.1f}/s); '
                          f'budget is {max_transactions}; refusing short or duplicate work')
-    return count
+    return min(preferred, capacity)
 
 
 def batch_rpc_available(client, evidence=None):
@@ -90,6 +91,7 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
         'track': 'native-bip340-steady-v2' if series == 'v2' else 'legacy-schnorr-steady-v2',
         'target_seconds': 5.0, 'ingestion_workers': 8, 'loaded_reader_workers': 12,
         'fixture_sizing_seconds': 15.0,
+        'minimum_predicted_supply_seconds': 7.5,
         'json_rpc_array_size': 50, 'dedicated_batch_sizes': [1, 50, 100, 200, 250, 500, 1000],
         'maxmempool_mib_per_node': 1024, 'warmup_batches_per_worker': 2,
         'public_regtest_secret': 42, 'signature_fixture_distribution': '16 reused deterministic nonce points; intentionally insecure public benchmark key only',
@@ -298,6 +300,7 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
             value.update({'preparation': details, 'pilot': {'tx_count': count,
                           'seconds': duration, 'excluded_from_measurement': True,
                           'mempool_bytes_per_entry': bytes_per_entry,
+                          'estimated_supply_seconds': (needed - 16 * size) * duration / count,
                           'predicted_fixture_mempool_bytes': predicted_usage},
                           'memory_before': before_memory, 'memory_after': after_memory,
                           'post_measurement_mempool': pool,
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index 579d695b2d1a3ca17a4a4def8a723dbe57448488..0f375fb5431add51ea05eb7458a138ad241d66f4 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -110,6 +110,9 @@ class Tests(unittest.TestCase):
         self.assertEqual(steady_suite.fixture_budget(1000, 0.1, 50, 200000), 150800)
         with self.assertRaisesRegex(ValueError, 'refusing short or duplicate'):
             steady_suite.fixture_budget(1000, 0.1, 50, 10000)
+        # A resource ceiling may trim optional headroom while still supplying
+        # much more than the mandatory actual five-second measurement.
+        self.assertEqual(steady_suite.fixture_budget(9065, 1, 1, 128000), 128000)
 
     def test_cached_public_fixture_signer_matches_frozen_verifier(self):
         framework = PATH.parents[1] / 'harness/l1/test/functional'
