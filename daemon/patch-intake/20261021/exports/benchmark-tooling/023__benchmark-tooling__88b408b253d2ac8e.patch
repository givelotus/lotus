From 88b408b253d2ac8ee47cb82348141a4696a5a3ab Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 06:04:01 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 daemon/patch-audit/progression/scripts/steady_suite.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index 220d99de8f2e79fec3f1f008f5a1814eec390e20..3155eb6fffd8cfbb25b7942b56a8c3510e406d30 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -342,7 +342,11 @@ def run_suite(context, series, max_transactions=1200000, fixture_smoke=False,
         finally:
             prepared.close()
             prepared.path.unlink()
-        clear_by_mining()
+        # Each selected case owns fresh nodes. Only the unloaded-reader phase
+        # needs an empty pool here; mining the entire timed corpus otherwise
+        # adds an unrelated large-block workload after ingestion has finished.
+        if case_filter == 'single_tx_steady':
+            clear_by_mining()
 
     if case_filter == 'single_tx_steady':
         results['read_unloaded_steady'] = measure_reads(Client)
