From f1a124b0f0584bc439734c93bc2d0897ddfac25e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 22:22:47 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 .../progression/scripts/historical_loopback.py      |  2 ++
 .../progression/scripts/steady_ingestion.py         | 13 +++++++++----
 .../patch-audit/progression/scripts/steady_suite.py |  8 ++++++++
 daemon/scripts/patch-progression.py                 |  2 ++
 daemon/tests/test-steady-ingestion.py               |  8 ++++++++
 5 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/daemon/patch-audit/progression/scripts/historical_loopback.py b/daemon/patch-audit/progression/scripts/historical_loopback.py
index f6c7246225ef82a7a2d1c222a5b78ad8aba2d030..60973d2e4ce0982bc76edd4f7e64798e4e57a473 100644
--- a/daemon/patch-audit/progression/scripts/historical_loopback.py
+++ b/daemon/patch-audit/progression/scripts/historical_loopback.py
@@ -101,6 +101,8 @@ adaptations.extend(['persist full-precision D1 latency samples', 'append 6000-tx
 a.output.with_suffix('.adapted.py').write_text(code)
 meta={'workload_seed':20261018,'script_sha256':hashlib.sha256(script.read_bytes()).hexdigest(),'adaptations':adaptations,'adapted_script_sha256':hashlib.sha256(code.encode()).hexdigest(),'wrapper_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'extension_sha256':hashlib.sha256((ROOT/'scripts/batch_sweep_extension.py').read_bytes()).hexdigest(),'native_adapter_sha256':hashlib.sha256((ROOT/'scripts/native_workload_adapter.py').read_bytes()).hexdigest(),'status':'running'}
 mp=a.output.with_suffix('.provenance.json');mp.write_text(json.dumps(meta,indent=2))
+meta['steady_suite_sha256']=hashlib.sha256((ROOT/'scripts/steady_suite.py').read_bytes()).hexdigest()
+meta['steady_core_sha256']=hashlib.sha256((ROOT/'scripts/steady_ingestion.py').read_bytes()).hexdigest()
 if a.prepare_only:
     compile(code,str(script),'exec')
     meta['status']='prepared_only_no_processes'
diff --git a/daemon/patch-audit/progression/scripts/steady_ingestion.py b/daemon/patch-audit/progression/scripts/steady_ingestion.py
index eb788bf24c43a6098549c7b6a82b7b4d606aa07d..33678270c5ab6ca463631763af7c9837c7d30d58 100644
--- a/daemon/patch-audit/progression/scripts/steady_ingestion.py
+++ b/daemon/patch-audit/progression/scripts/steady_ingestion.py
@@ -22,14 +22,16 @@ class FixtureExhausted(RuntimeError):
 
 def histogram_percentiles(histogram):
     total = sum(histogram)
-    result = {}
+    result = {'overflow_count': histogram[-1], 'overflow_min_ms': (len(histogram) - 1) * 0.01}
     for percentile in (50, 95, 99):
         target = max(1, (total * percentile + 99) // 100)
         cumulative = 0
         for index, count in enumerate(histogram):
             cumulative += count
             if cumulative >= target:
-                result[f'p{percentile}_ms'] = index * 0.01
+                result[f'p{percentile}_ms'] = None if index == len(histogram) - 1 else index * 0.01
+                if index == len(histogram) - 1:
+                    result[f'p{percentile}_ms_lower_bound'] = index * 0.01
                 break
     return result
 
@@ -177,6 +179,7 @@ def measure(fixture, client_factory, mode, batch_size, seconds=5.0, workers=8,
             barrier.wait()
             host_before = {'utc_ns': time.time_ns(), 'load_average': os.getloadavg()}
             read_before = fixture.read_seconds
+            cpu_before = time.process_time()
             timing['start'] = clock()
             timing['deadline'] = timing['start'] + seconds
             go.set()
@@ -186,6 +189,7 @@ def measure(fixture, client_factory, mode, batch_size, seconds=5.0, workers=8,
             go.set()
         reader_values = [future.result() for future in readers]
     end = max(value[2] for value in values)
+    client_cpu_seconds = time.process_time() - cpu_before
     elapsed = end - timing['start']
     if elapsed < seconds and not pilot:
         raise RuntimeError('Measured ingestion interval is shorter than requested')
@@ -201,6 +205,7 @@ def measure(fixture, client_factory, mode, batch_size, seconds=5.0, workers=8,
               'fixture_index_bytes': len(fixture.offsets) * fixture.offsets.itemsize,
               'fixture_mapped_bytes': len(fixture.mapping),
               'fixture_read_worker_seconds': fixture.read_seconds - read_before,
+              'client_cpu_seconds': client_cpu_seconds,
               'host_before': host_before,
               'host_after': {'utc_ns': time.time_ns(), 'load_average': os.getloadavg()},
               'client_scope': 'RPC plus client JSON, bounded mmap reads and scheduling; no signing/funding/thread or connection startup'}
@@ -211,7 +216,7 @@ def measure(fixture, client_factory, mode, batch_size, seconds=5.0, workers=8,
                                  'rpc_calls': pairs * 2, 'writer_window_seconds': elapsed,
                                  'rpc_per_second': pairs * 2 / elapsed,
                                  'latency_unit': 'two sequential RPCs',
-                                 'histogram_bin_ms': 0.01, 'histogram_overflow_ms': 100,
+                                 'histogram_bin_ms': 0.01, 'histogram_overflow_ms': 100.01,
                                  'histogram': bins, **histogram_percentiles(bins)}
     return result
 
@@ -258,6 +263,6 @@ def measure_reads(client_factory, seconds=5.0, workers=12):
     bins = [sum(value[1][i] for value in values) for i in range(10002)]
     return {'seconds': elapsed, 'workers': workers, 'pairs': count, 'rpc_calls': 2 * count,
             'rpc_per_second': 2 * count / elapsed, 'latency_unit': 'two sequential RPCs',
-            'histogram_bin_ms': 0.01, 'histogram_overflow_ms': 100,
+            'histogram_bin_ms': 0.01, 'histogram_overflow_ms': 100.01,
             'histogram': bins, **histogram_percentiles(bins), 'host_before': host_before,
             'host_after': {'utc_ns': time.time_ns(), 'load_average': os.getloadavg()}}
diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index fcc5d58053c48aebb1fc2d8a10ebf4138415b5fc..8d8bdd7e836a424ff909a4d768da6d9ad54cb56a 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -75,12 +75,20 @@ def run_suite(context, series, max_transactions=1200000):
         'target_seconds': 5.0, 'ingestion_workers': 8, 'loaded_reader_workers': 12,
         'json_rpc_array_size': 50, 'dedicated_batch_sizes': [1, 50, 100, 200, 250, 500, 1000],
         'maxmempool_mib_per_node': 1024, 'warmup_batches_per_worker': 2,
+        'public_regtest_secret': 42, 'signature_fixture_distribution': '16 reused deterministic nonce points; intentionally insecure public benchmark key only',
+        'historical_legacy_signing_distribution_identical': False,
         'fixture_disk_cap_bytes': 512 * 1024 * 1024,
         'max_fixture_transactions': max_transactions}
     to_hex = context['ToHex']
     native = series == 'v2'
     legacy_signer = None if native else legacy_fixture_signer(context['privkey'])
     op_script = context['V2_OP_TRUE_SCRIPT'] if native else context['op_true_spk']
+    mesh_deadline = time.monotonic() + 30
+    while not all(sum(peer.get('version', 0) > 0 for peer in node.call('getpeerinfo')) >= 2
+                  for node in clients):
+        if time.monotonic() > mesh_deadline:
+            raise RuntimeError('Steady suite requires all three nodes to have two negotiated peers')
+        time.sleep(0.05)
 
     def memory_snapshot():
         pids = [str(process.pid) for process in context['procs']]
diff --git a/daemon/scripts/patch-progression.py b/daemon/scripts/patch-progression.py
index 4868bc528f2136ee24948102d3559e51ad8d0789..14948b12b7a74ceafc2e5e6834a4be118f37f869 100644
--- a/daemon/scripts/patch-progression.py
+++ b/daemon/scripts/patch-progression.py
@@ -512,6 +512,8 @@ def main():
                                     '--point', str(args.point), '--repetitions', str(args.repetitions),
                                     '--jobs', str(args.jobs), '--upstream', args.upstream]
             packet['resume'].extend(['--validation', args.validation])
+            if args.controls_only:
+                packet['resume'].append('--controls-only')
             if args.cmake_flags_file is not None:
                 packet['resume'].extend(['--cmake-flags-file', str(args.cmake_flags_file.resolve())])
             atomic(data / 'failure.json', packet)
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index 4a311cd4e9c72a66201bae68c305c1f0a9284aac..6e6a10397951afe91915c8a1acc962232ad7abf7 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -126,6 +126,14 @@ class Tests(unittest.TestCase):
         with self.assertRaisesRegex(ValueError, 'only public regtest secret42'):
             steady_suite.legacy_fixture_signer(key)
 
+    def test_overflow_percentile_is_a_bound_not_an_exact_latency(self):
+        bins = [0] * 10002
+        bins[2], bins[-1] = 1, 99
+        result = steady.histogram_percentiles(bins)
+        self.assertIsNone(result['p95_ms'])
+        self.assertEqual(result['p95_ms_lower_bound'], 100.01)
+        self.assertEqual(result['overflow_count'], 99)
+
 
 if __name__ == '__main__':
     unittest.main()
