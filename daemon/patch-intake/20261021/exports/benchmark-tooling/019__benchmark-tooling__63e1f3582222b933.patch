From 63e1f3582222b933a3d75bb4c5fda580b8f9a7af Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 22:49:42 -0700
Subject: [PATCH] fixup! bench: measure warmed ingestion for at least five
 seconds with bounded unique fixtures

---
 daemon/patch-audit/progression/scripts/steady_suite.py | 10 ++++++++--
 daemon/tests/test-steady-ingestion.py                  |  6 ++++++
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/daemon/patch-audit/progression/scripts/steady_suite.py b/daemon/patch-audit/progression/scripts/steady_suite.py
index cf84655f6efba62be3215cfa8c30a801c0925872..5bbe3e5f9345f80cf888f6beeaf17d21b378ae48 100644
--- a/daemon/patch-audit/progression/scripts/steady_suite.py
+++ b/daemon/patch-audit/progression/scripts/steady_suite.py
@@ -52,9 +52,15 @@ def legacy_fixture_signer(key):
 
 
 def fixture_budget(pilot_count, pilot_seconds, batch_size, max_transactions):
-    if pilot_count <= 0 or pilot_seconds <= 0:
+    if pilot_count <= 0 or pilot_seconds <= 0 or batch_size <= 0 or max_transactions <= 0:
         raise ValueError('Invalid pilot result')
-    rate = pilot_count / pilot_seconds
+    try:
+        rate = pilot_count / pilot_seconds
+        finite = math.isfinite(rate) and math.isfinite(rate * 15.0 + 16 * batch_size)
+    except (OverflowError, TypeError):
+        raise ValueError('Pilot rate is nonfinite or overflows') from None
+    if not finite or rate <= 0:
+        raise ValueError('Pilot rate is nonfinite or overflows')
     # Three times the measured window accommodates a noisy short sizing pilot.
     # Unused rows are never included in accepted counts or timed throughput.
     preferred = math.ceil((rate * 15.0 + 16 * batch_size) / batch_size) * batch_size
diff --git a/daemon/tests/test-steady-ingestion.py b/daemon/tests/test-steady-ingestion.py
index 0f375fb5431add51ea05eb7458a138ad241d66f4..a24d978f0b1964f49ec07bebdc752017735c2fa8 100644
--- a/daemon/tests/test-steady-ingestion.py
+++ b/daemon/tests/test-steady-ingestion.py
@@ -113,6 +113,12 @@ class Tests(unittest.TestCase):
         # A resource ceiling may trim optional headroom while still supplying
         # much more than the mandatory actual five-second measurement.
         self.assertEqual(steady_suite.fixture_budget(9065, 1, 1, 128000), 128000)
+        with tempfile.TemporaryDirectory() as directory:
+            for count, seconds in ((0, 1), (1, 0), (1, float('nan')),
+                                   (float('inf'), 1), (1e308, 1), (10**1000, 1)):
+                with self.assertRaises(ValueError):
+                    steady_suite.fixture_budget(count, seconds, 1, 128000)
+            self.assertEqual(list(Path(directory).iterdir()), [])
 
     def test_cached_public_fixture_signer_matches_frozen_verifier(self):
         framework = PATH.parents[1] / 'harness/l1/test/functional'
