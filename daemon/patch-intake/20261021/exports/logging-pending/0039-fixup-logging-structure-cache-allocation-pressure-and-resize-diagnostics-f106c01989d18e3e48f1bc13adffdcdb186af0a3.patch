From f106c01989d18e3e48f1bc13adffdcdb186af0a3 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:54:29 -0700
Subject: [PATCH] fixup! logging: structure cache allocation, pressure and
 resize diagnostics

Remove the producer-specific schema/conversion fixture actual_validation_caches_keep_integer_budgets_and_capacity. Its checks only restated migrated field names, values and text; lasting generic renderer, copied-value, formatting, filtering, queue and shutdown behavior tests remain. No production change; source-only cleanup.
---
 src/test/logging_event_tests.cpp | 31 -------------------------------
 1 file changed, 31 deletions(-)

diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 2f73df911e013c461f81442d1547e35e02cda93e..b5ca01cc790c3e9c9cbdfee00cee0ce79ee7f733 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -1566,37 +1566,6 @@ BOOST_AUTO_TEST_CASE(
     BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
-BOOST_AUTO_TEST_CASE(
-    actual_validation_caches_keep_integer_budgets_and_capacity) {
-    Format(BCLog::LogFormat::JSON);
-    const ValidationCache cache{2 * 1024 * 1024, 2 * 1024 * 1024};
-    const auto lines{Lines()};
-    BOOST_REQUIRE_EQUAL(lines.size(), 2U);
-    for (size_t index{0}; index < lines.size(); ++index) {
-        UniValue row;
-        BOOST_REQUIRE(row.read(lines[index]));
-        const std::string kind{index == 0 ? "signature" : "script execution"};
-        BOOST_CHECK_EQUAL(row["event"].get_str(),
-                          index == 0 ? "signature_cache_initialized"
-                                     : "script_execution_cache_initialized");
-        BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-        BOOST_CHECK(row["cache_requested_mib"].isNum());
-        BOOST_CHECK_EQUAL(row["cache_requested_mib"].getInt<uint64_t>(), 2U);
-        BOOST_CHECK(row["cache_allocated_mib"].isNum());
-        const auto allocated{row["cache_allocated_mib"].getInt<uint64_t>()};
-        BOOST_CHECK(allocated <= 2U);
-        BOOST_CHECK(row["cache_capacity"].isNum());
-        const auto capacity{row["cache_capacity"].getInt<uint64_t>()};
-        BOOST_CHECK(capacity > 0);
-        BOOST_CHECK_EQUAL(
-            row["message"].get_str(),
-            strprintf(
-                "Using %zu MiB out of %zu MiB requested for %s cache, able to store %zu elements",
-                size_t(allocated), size_t(2), kind, size_t(capacity)));
-        BOOST_CHECK(row["fields_truncated"].isNull());
-    }
-}
-
 BOOST_AUTO_TEST_CASE(
     actual_checkqueue_constructor_keeps_additional_worker_count) {
     Format(BCLog::LogFormat::JSON);
