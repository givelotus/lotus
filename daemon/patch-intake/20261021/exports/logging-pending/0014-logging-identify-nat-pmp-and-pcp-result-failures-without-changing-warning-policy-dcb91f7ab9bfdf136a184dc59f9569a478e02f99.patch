+// Capture the actual result producer while retaining the existing scripted
+// Sock response and MappingError assertions. No real UDP traffic is created.
+template <typename Action>
+static auto CaptureMappingLog(const char *event, Action &&action) {
+    std::string rendered;
+    auto result = [&] {
+        LogInstance().Flush();
+        struct RestoreFormat {
+            BCLog::LogFormat previous{LogInstance().m_log_format};
+            ~RestoreFormat() {
+                LogInstance().Flush();
+                LogInstance().m_log_format = previous;
+            }
+        } restore;
+        LogInstance().m_log_format = BCLog::LogFormat::JSON;
+        DebugLogHelper capture(event, [&](const std::string *line) {
+            if (line) rendered = *line;
+            return false;
+        });
+        return action();
+    }();
+    UniValue row;
+    BOOST_REQUIRE(row.read(rendered));
+    BOOST_CHECK_EQUAL(row["event"].get_str(), event);
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "warning");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+    return std::pair{std::move(result), std::move(row)};
+}
