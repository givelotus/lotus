From fdac7d20fbb5124e4827e11cfee77dbce4743030 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:57:26 -0700
Subject: [PATCH] fixup! logging: identify rejected oversized signing-provider
 scripts

---
 src/test/script_standard_tests.cpp | 36 ++----------------------------
 1 file changed, 2 insertions(+), 34 deletions(-)

diff --git a/src/test/script_standard_tests.cpp b/src/test/script_standard_tests.cpp
index b9629b50d1795ebe29df773de796381212c5268c..131de8c7fbc4e77958fa0551af2d6f4e01dcb56c 100644
--- a/src/test/script_standard_tests.cpp
+++ b/src/test/script_standard_tests.cpp
@@ -39,44 +39,12 @@ void AppendPush(CScript &script, opcodetype opcode,
 
 BOOST_FIXTURE_TEST_SUITE(script_standard_tests, BasicTestingSetup)
 
-BOOST_AUTO_TEST_CASE(logging_redeem_script_limit_preserves_store_boundary) {
+BOOST_AUTO_TEST_CASE(redeem_script_size_preserves_store_boundary) {
     FillableSigningProvider provider;
     CScript oversized;
     oversized.resize(MAX_SCRIPT_ELEMENT_SIZE + 1);
-    std::string rendered;
-    {
-        LogInstance().Flush();
-        struct RestoreFormat {
-            BCLog::LogFormat previous{LogInstance().m_log_format};
-            ~RestoreFormat() {
-                LogInstance().Flush();
-                LogInstance().m_log_format = previous;
-            }
-        } restore;
-        LogInstance().m_log_format = BCLog::LogFormat::JSON;
-        DebugLogHelper capture("signing_redeem_script_too_large",
-                               [&](const std::string *line) {
-                                   if (line) rendered = *line;
-                                   return false;
-                               });
-        BOOST_CHECK(!provider.AddCScript(oversized));
-    }
+    BOOST_CHECK(!provider.AddCScript(oversized));
     BOOST_CHECK(!provider.HaveCScript(CScriptID(oversized)));
-    UniValue row;
-    BOOST_REQUIRE(row.read(rendered));
-    BOOST_CHECK_EQUAL(row["event"].get_str(),
-                      "signing_redeem_script_too_large");
-    BOOST_REQUIRE(row["script_limit_bytes"].isNum());
-    BOOST_CHECK_EQUAL(row["script_limit_bytes"].getInt<uint64_t>(),
-                      MAX_SCRIPT_ELEMENT_SIZE);
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf(
-            "FillableSigningProvider::AddCScript(): redeemScripts > %i bytes are invalid",
-            MAX_SCRIPT_ELEMENT_SIZE));
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "error");
-    BOOST_CHECK(row["fields_truncated"].isNull());
-    BOOST_CHECK(row["script"].isNull());
 
     CScript allowed;
     allowed.resize(MAX_SCRIPT_ELEMENT_SIZE);
