+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Accepted headers retain IBD Debug versus ordinary Info diagnostics."""
+
+import json
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+
+class HeaderObservationLoggingTest(BitcoinTestFramework):
+    num_nodes = 1
+    setup_clean_chain = True
+    wallet_names = []
+    extra_args = [["-logformat=json", "-debug=validation", "-listen=0", "-avalanche=0"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        assert_equal(node.getblockcount(), 0)
+        assert node.getblockchaininfo()["initialblockdownload"]
+        hashes = self.generatetoaddress(
+            node, 2, node.get_deterministic_priv_key().address
+        )
+        assert_equal(node.getblockcount(), 2)
+        assert not node.getblockchaininfo()["initialblockdownload"]
+        # Orderly stop drains the actual async logger before parsing records.
+        self.stop_node(0)
+        rows = [
+            json.loads(line)
+            for line in node.debug_log_path.read_text().splitlines()
+            if line.strip()
+        ]
+        observed = [row for row in rows if row.get("event") == "header_observed"]
+        assert_equal(len(observed), 2)
+        for height, expected_level, expected_category in (
+            (1, "debug", "validation"),
+            (2, "info", "none"),
+        ):
+            matches = [row for row in observed if row.get("height") == height]
+            assert_equal(len(matches), 1)
+            row = matches[0]
+            assert type(row["height"]) is int
+            assert_equal(row["block_hash"], hashes[height - 1])
+            assert_equal(row["level"], expected_level)
+            assert_equal(row["category"], expected_category)
+            assert_equal(
+                row["message"],
+                f"Saw new header hash={hashes[height - 1]} height={height}",
+            )
+            assert "fields_truncated" not in row
+
+
+if __name__ == "__main__":
+    HeaderObservationLoggingTest().main()
