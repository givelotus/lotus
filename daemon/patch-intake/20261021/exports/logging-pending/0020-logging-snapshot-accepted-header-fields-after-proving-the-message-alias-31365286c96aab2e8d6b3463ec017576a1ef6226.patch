+#!/usr/bin/env python3
+"""Rewrite one reviewed header-log alias after proving its complete AST context.
+
+The literal converter must keep refusing this %s alias: the initial strprintf,
+its two uses, shared function scope and IBD branch are required evidence. No
+regex source edits, arbitrary alias expansion or producer API changes.
+"""
+
+import argparse
+import hashlib
+import importlib.metadata
+import json
+from pathlib import Path
+
+import convert
+
+SCOPE = "ChainstateManager::AcceptBlockHeader"
+HASH_DECLARATION = "BlockHash hash = block.GetHash();"
+INDEX_DECLARATION = (
+    "CBlockIndex *pindex{m_blockman.AddToBlockIndex(block, m_best_header)};"
+)
+INITIALIZER = """const auto msg = strprintf("Saw new header hash=%s height=%d",
+                                        hash.ToString(), pindex->nHeight);"""
+BEFORE = r"""if (IsInitialBlockDownload()) {
+    LogPrintLevel(BCLog::VALIDATION, BCLog::Level::Debug, "%s\n", msg);
+} else {
+    LogPrintf("%s\n", msg);
+}"""
+AFTER = """if (IsInitialBlockDownload()) {
+    LogEvent(BCLog::VALIDATION, "header_observed",
+             "Saw new header hash={block_hash} height={height}")
+        .Field(BCLog::LogField::BlockHash, hash)
+        .Field(BCLog::LogField::Height, pindex->nHeight);
+} else {
+    LogInfoEvent(BCLog::ALL, "header_observed",
+                 "Saw new header hash={block_hash} height={height}")
+        .Field(BCLog::LogField::BlockHash, hash)
+        .Field(BCLog::LogField::Height, pindex->nHeight);
+}"""
+
+
+def expected(kind, snippet):
+    nodes = convert.parse("void fixture() {" + snippet + "}").find_all(kind=kind)
+    if len(nodes) != 1:
+        raise ValueError("ambiguous reviewed fixture")
+    return convert.fingerprint(nodes[0])
+
+
+def scope(root):
+    matches = []
+    for node in root.find_all(kind="function_definition"):
+        name = node.field("declarator")
+        while name is not None and name.kind() not in {
+            "qualified_identifier",
+            "identifier",
+        }:
+            name = name.field("declarator")
+        if name is not None and name.text() == SCOPE:
+            matches.append(node)
+    if len(matches) != 1:
+        raise ValueError("expected one reviewed member function")
+    if matches[0].find(kind="ERROR") is not None:
+        raise ValueError("parse error in reviewed function; no edits")
+    return matches[0]
+
+
+def rewrite(source):
+    root = convert.parse(source)
+    function = scope(root)
+    body = function.field("body")
+    statements = [n for n in body.named_children() if n.kind() != "comment"]
+    if not statements or convert.fingerprint(statements[0]) != expected(
+        "expression_statement", "AssertLockHeld(cs_main);"
+    ):
+        raise ValueError("existing cs_main assertion changed")
+    for anchor in (HASH_DECLARATION, INDEX_DECLARATION):
+        anchor_key = expected("declaration", anchor)
+        candidates = [
+            n
+            for n in function.find_all(kind="declaration")
+            if convert.fingerprint(n) == anchor_key
+        ]
+        if len(candidates) != 1 or candidates[0].parent().text() != body.text():
+            raise ValueError("raw hash/index type or source declaration changed")
+    declaration_key = expected("declaration", INITIALIZER)
+    before_key = expected("if_statement", BEFORE)
+    after_key = expected("if_statement", AFTER)
+    declarations = [
+        n
+        for n in function.find_all(kind="declaration")
+        if convert.fingerprint(n) == declaration_key
+    ]
+    branches = [
+        n
+        for n in function.find_all(kind="if_statement")
+        if convert.fingerprint(n) == before_key
+    ]
+    completed = [
+        n
+        for n in function.find_all(kind="if_statement")
+        if convert.fingerprint(n) == after_key
+    ]
+    references = [n for n in function.find_all(kind="identifier") if n.text() == "msg"]
+    if not declarations and not branches and len(completed) == 1 and not references:
+        if completed[0].parent().text() != body.text():
+            raise ValueError("completed branch moved from function scope")
+        return source, {"status": "already_applied", "producer_count": 2}
+    if len(declarations) != 1 or len(branches) != 1 or completed:
+        raise ValueError("initializer/IBD branch drift or partial conversion")
+    declaration, branch = declarations[0], branches[0]
+    if len(references) != 3:
+        raise ValueError("msg must have exactly its declaration and two logging uses")
+    if (
+        declaration.parent().text() != body.text()
+        or branch.parent().text() != body.text()
+    ):
+        raise ValueError("initializer and branch must remain at function scope")
+    position = next(
+        i for i, n in enumerate(statements) if convert.fingerprint(n) == declaration_key
+    )
+    if (
+        position + 1 >= len(statements)
+        or convert.fingerprint(statements[position + 1]) != before_key
+    ):
+        raise ValueError("intervening statement or branch reordering")
+    # Exactly the declaration and conditional subtrees change. Hash/height are
+    # immutable values read under the existing cs_main lock; no header work moves.
+    result = root.commit_edits([declaration.replace(""), branch.replace(AFTER)])
+    verified, verification = rewrite(result)
+    if verified != result or verification["status"] != "already_applied":
+        raise ValueError("postcondition failed")
+    return result, {
+        "status": "converted",
+        "producer_count": 2,
+        "scope": SCOPE,
+        "initializer_line": declaration.range().start.line + 1,
+        "msg_identifiers": len(references),
+        "proofs": [
+            "exact pure initializer AST",
+            "exact IBD/category/severity branch AST",
+            "one declaration and exactly two uses",
+            "same function scope",
+            "no intervening statement",
+            "no parse errors",
+            "existing cs_main assertion and raw hash/index declarations",
+            "idempotent postcondition",
+        ],
+    }
+
+
+def self_test():
+    source = (
+        "bool "
+        + SCOPE
+        + "() {\nAssertLockHeld(cs_main);\n"
+        + HASH_DECLARATION
+        + "\n"
+        + INDEX_DECLARATION
+        + "\n"
+        + INITIALIZER
+        + "\n"
+        + BEFORE
+        + "\nreturn true;\n}\n"
+    )
+    converted, proof = rewrite(source)
+    assert proof["status"] == "converted"
+    assert rewrite(converted)[0] == converted
+    assert "return true;" in converted
+    cases = [
+        source.replace("Saw new header hash=%s", "Different hash=%s"),
+        source.replace("hash.ToString()", "GetHashWithSideEffect()"),
+        source.replace("pindex->nHeight", "NextHeight()"),
+        source.replace("IsInitialBlockDownload()", "OtherCondition()"),
+        source.replace("BCLog::VALIDATION", "BCLog::RPC"),
+        source.replace("BCLog::Level::Debug", "BCLog::Level::Info"),
+        source.replace("LogPrintf", "LogWarning"),
+        source.replace("return true;", "Use(msg); return true;"),
+        source.replace(BEFORE, "SideEffect();\n" + BEFORE),
+        source.replace(INITIALIZER + "\n" + BEFORE, BEFORE + "\n" + INITIALIZER),
+        source.replace("AcceptBlockHeader", "OtherFunction"),
+        source + source,
+        source.replace(BEFORE, AFTER),
+        converted.replace(
+            "if (IsInitialBlockDownload())",
+            INITIALIZER + "\nif (IsInitialBlockDownload())",
+        ),
+        converted.replace("pindex->nHeight", "NextHeight()"),
+        source.replace("AssertLockHeld(cs_main)", "AssertLockHeld(other_mutex)"),
+        source.replace("BlockHash hash", "DifferentHash hash"),
+        source.replace("CBlockIndex *pindex", "DifferentIndex *pindex"),
+    ]
+    for index, case in enumerate(cases):
+        try:
+            rewrite(case)
+        except ValueError:
+            continue
+        raise AssertionError("guard accepted mutation " + str(index))
+    # Unrelated scopes and exact literal-converter refusal remain unchanged.
+    unrelated = '\nvoid other() { LogPrintf("%s\\n", msg); }\n'
+    assert rewrite(source + unrelated)[0].endswith(unrelated)
+    old = convert.calls(BEFORE, {"LogPrintf"})[0]
+    new = convert.calls(AFTER, {"LogInfoEvent"})[0]
+    try:
+        convert.validate_mapping(old, new)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("literal converter accepted an unproven alias")
+    return {
+        "positive": 2,
+        "idempotent": 1,
+        "negative_guards": len(cases),
+        "literal_alias_refusal": 1,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=Path("."))
+    parser.add_argument("--report", type=Path)
+    parser.add_argument("--apply", action="store_true")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if importlib.metadata.version("ast-grep-py") != convert.ENGINE:
+        parser.error("requires ast-grep-py==" + convert.ENGINE)
+    if args.self_test:
+        print(json.dumps(self_test(), sort_keys=True))
+        return
+    path = args.root / "src/validation.cpp"
+    before = path.read_text()
+    after, report = rewrite(before)
+    report.update(
+        path="src/validation.cpp",
+        engine="ast-grep-py==" + convert.ENGINE,
+        before_sha256=hashlib.sha256(before.encode()).hexdigest(),
+        after_sha256=hashlib.sha256(after.encode()).hexdigest(),
+        apply_requested=args.apply,
+        native_validation="NOT_COMPILED/NOT_RUN",
+    )
+    if args.report:
+        args.report.write_text(json.dumps(report, indent=2) + "\n")
+    if args.apply and before != after:
+        if path.read_text() != before:
+            raise ValueError("source changed during review; no edits")
+        path.write_text(after)
+    print(json.dumps(report, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
