From f01d2c481ce11dfe6a01b16bca739e658778b603 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:43:21 -0700
Subject: [PATCH] logging(v2): type native disk payload-limit rejection

Keep this producer after the V2 consensus block-payload-limit owner. Preserve complete function/position text, uint32 claimed size, uint64 consensus limit, non-dropping Error and false return; no validation or allocation changes.

Scripted diff commands:
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/v2-disk-size-diagnostic.json --report /private/tmp/logging-core-v2-size-report.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style "{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}" HEAD -- src/node/blockstorage.cpp
python3 test/lint/lint-log-events.py src/node/blockstorage.cpp
git diff --check

Source-only: NOT_COMPILED / NOT_RUN. No native malformed-block control run.
---
 .../rules/v2-disk-size-diagnostic.json        | 36 +++++++++++++++++++
 src/node/blockstorage.cpp                     | 11 ++++--
 2 files changed, 44 insertions(+), 3 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/v2-disk-size-diagnostic.json

diff --git a/contrib/logging/conversion/rules/v2-disk-size-diagnostic.json b/contrib/logging/conversion/rules/v2-disk-size-diagnostic.json
new file mode 100644
index 0000000000000000000000000000000000000000..101c6feae1259e8f8d0d838144ce2544b7eb35f7
--- /dev/null
+++ b/contrib/logging/conversion/rules/v2-disk-size-diagnostic.json
@@ -0,0 +1,36 @@
+{
+  "schema": 1,
+  "batch": "v2-disk-size-diagnostic",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "v2",
+  "files": [
+    {
+      "path": "src/node/blockstorage.cpp",
+      "rules": [
+        {
+          "id": "block_disk_size_excessive",
+          "old": "LogError(\"%s: Block data is larger than maximum deserialization \"\n                     \"size for %s: %s versus %s\\n\",\n                     __func__, pos.ToString(), blk_size, max_blk_size)",
+          "replacement": "LogErrorEvent(BCLog::ALL, \"block_disk_size_excessive\", \"{source_function}: Block data is larger than maximum deserialization size for {flat_file_position}: {claimed_block_bytes} versus {block_limit_bytes}\").Field(BCLog::LogField::SourceFunction, BCLog::LogStatic(__func__)).Field(BCLog::LogField::FlatFilePosition, pos.ToString()).Field(BCLog::LogField::ClaimedBlockBytes, blk_size).Field(BCLog::LogField::BlockLimitBytes, max_blk_size)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogError",
+            "format": "%s: Block data is larger than maximum deserialization size for %s: %s versus %s\n",
+            "specifiers": [
+              "%s",
+              "%s",
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "__func__",
+              "pos.ToString()",
+              "blk_size",
+              "max_blk_size"
+            ]
+          },
+          "review_note": "Keep severity/category, original rendering and control flow; copied dynamic fields use existing bounded record/truncation contract. Source-only conversion; no compile/runtime validation claimed."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/node/blockstorage.cpp b/src/node/blockstorage.cpp
index 085a214237d9fa5fb9716a5a6ca4478206653598..aaa9bec7f960d58930310a59cac7441a473fe1c3 100644
--- a/src/node/blockstorage.cpp
+++ b/src/node/blockstorage.cpp
@@ -1131,9 +1131,14 @@ bool BlockManager::ReadRawBlock(std::vector<uint8_t> &block,
         const uint64_t max_blk_size =
             lotus::v2::GetBlockPayloadLimit(GetConfig());
         if (blk_size > max_blk_size) {
-            LogError("%s: Block data is larger than maximum deserialization "
-                     "size for %s: %s versus %s\n",
-                     __func__, pos.ToString(), blk_size, max_blk_size);
+            LogErrorEvent(
+                BCLog::ALL, "block_disk_size_excessive",
+                "{source_function}: Block data is larger than maximum deserialization size for {flat_file_position}: {claimed_block_bytes} versus {block_limit_bytes}")
+                .Field(BCLog::LogField::SourceFunction,
+                       BCLog::LogStatic(__func__))
+                .Field(BCLog::LogField::FlatFilePosition, pos.ToString())
+                .Field(BCLog::LogField::ClaimedBlockBytes, blk_size)
+                .Field(BCLog::LogField::BlockLimitBytes, max_blk_size);
             return false;
         }
 
