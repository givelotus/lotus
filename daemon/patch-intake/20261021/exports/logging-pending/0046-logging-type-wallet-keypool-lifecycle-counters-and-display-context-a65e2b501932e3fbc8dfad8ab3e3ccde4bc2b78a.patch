index 0000000000000000000000000000000000000000..feae5f0a76227ae66d378526872d974fb14a269d
--- /dev/null
+++ b/contrib/logging/conversion/wallet_callers.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""Apply reviewed wallet caller mappings using the existing AST/text validator.
+
+Expand only the two established WalletLogPrintf prefix contracts for validation;
+never replace a facade with a generic opaque event. Each caller still supplies
+its reviewed event, field names and original argument expressions in the catalog.
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+import convert as c
+
+
+def wallet_label(path, node):
+    function = node.field("function").text()
+    if function.endswith((".WalletLogPrintf", "->WalletLogPrintf")):
+        return function.removesuffix("WalletLogPrintf") + "GetDisplayName()"
+    if function != "WalletLogPrintf":
+        raise ValueError("not a wallet logging caller")
+    scope = next(
+        (a for a in node.ancestors() if a.kind() == "function_definition"), None
+    )
+    declarator = scope.field("declarator").text().lstrip("*& \n\t") if scope else ""
+    if path == "src/wallet/scriptpubkeyman.cpp" and declarator.startswith(
+        ("LegacyScriptPubKeyMan::", "DescriptorScriptPubKeyMan::")
+    ):
+        return "m_storage.GetDisplayName()"
+    if path == "src/wallet/wallet.cpp" and declarator.startswith("CWallet::"):
+        return "GetDisplayName()"
+    raise ValueError("wallet prefix context is not proved")
+
+
+def convert_file(path, source, rules):
+    root = c.parse(source)
+    edits = []
+    for rule in rules:
+        original = c.parse(rule["old"]).find(kind="call_expression")
+        key = c.fingerprint(original)
+        matches = [
+            n for n in root.find_all(kind="call_expression") if c.fingerprint(n) == key
+        ]
+        if not matches:
+            replacement = c.parse(rule["replacement"]).find(kind="call_expression")
+            if sum(
+                c.fingerprint(n) == c.fingerprint(replacement)
+                for n in root.find_all(kind="call_expression")
+            ) != rule.get("count", 1):
+                raise ValueError("missing or drifted wallet rule " + rule["id"])
+            continue
+        if len(matches) != rule.get("count", 1):
+            raise ValueError("ambiguous wallet rule " + rule["id"])
+        for node in matches:
+            if node.find(kind="ERROR") or any(
+                a.kind() == "ERROR" for a in node.ancestors()
+            ):
+                raise ValueError("parse error intersects wallet caller")
+            label = wallet_label(path, node)
+            values = c.args(node)
+            message = "%s " + c.literal(values[0])
+            expanded = "LogPrintf(" + json.dumps(message) + ", " + label
+            expanded += "".join(", " + value.text() for value in values[1:]) + ")"
+            standard = dict(
+                rule,
+                count=1,
+                old=expanded,
+                reviewed_input=c.describe(c.calls(expanded, c.LEGACY)[0]),
+            )
+            # Reuse severity, exact wording, width/precision, character and
+            # quoted-path validation rather than inventing a second renderer.
+            converted, _ = c.convert(expanded, [standard])
+            if converted != rule["replacement"]:
+                raise ValueError("unexpected wallet expansion")
+            edits.append(node.replace(converted))
+    return root.commit_edits(edits), len(edits)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=Path("."))
+    parser.add_argument("--rules", type=Path, required=True)
+    parser.add_argument("--report", type=Path)
+    parser.add_argument("--apply", action="store_true")
+    options = parser.parse_args()
+    prepared, report = [], []
+    catalog = json.loads(options.rules.read_text())
+    for item in catalog["files"]:
+        path = options.root / item["path"]
+        source = path.read_text()
+        result, count = convert_file(item["path"], source, item["rules"])
+        for change in item.get("support_adjustments", []):
+            old, new = change["old"], change["new"]
+            if result.count(new) == 1 and old not in result.replace(new, "", 1):
+                continue
+            if result.count(old) != 1:
+                raise ValueError("drifted support adjustment " + change["purpose"])
+            result = result.replace(old, new, 1)
+        prepared.append((path, result))
+        report.append(
+            {
+                "path": item["path"],
+                "converted": count,
+                "before_sha256": c.digest(source.encode()),
+                "after_sha256": c.digest(result.encode()),
+            }
+        )
+    if options.apply:
+        for path, result in prepared:
+            path.write_text(result)
+    if options.report:
+        options.report.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report))
+
+
+if __name__ == "__main__":
+    main()
