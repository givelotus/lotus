From 8a7055331ac427f010f07c958b1569c0386d8cfa Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 16:47:15 -0700
Subject: [PATCH] logging: distinguish proof and block IDs in zero staking-hash
 diagnostics

Keep the upstream ABC Info message and exceptional zero-hash skip/ranking
behavior. Use raw ProofId and BlockHash fields instead of formatted strings or
a guessed transaction identity. Add only a typed registry key, not a hash
implementation or new protocol API. The zero reward-hash branch is not newly
forced or exposed through a test hook; native validation is pending.

Tier: eCash. The original call predates pinned ABC (blame7bfcd9e57cf); it is
independent of Lotus V2 treasury consensus and imports no BLAKE3 code.

Scripted diff (ast-grep-py0.51.0; one reviewed site):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/staking-proof-reward-diagnostic.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/staking392-conversion.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/avalanche/peermanager.cpp
---
 .../staking-proof-reward-diagnostic.json      | 44 +++++++++++++++++++
 src/avalanche/peermanager.cpp                 |  9 ++--
 src/logging/fields.h                          |  3 +-
 3 files changed, 51 insertions(+), 5 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/staking-proof-reward-diagnostic.json

diff --git a/contrib/logging/conversion/rules/staking-proof-reward-diagnostic.json b/contrib/logging/conversion/rules/staking-proof-reward-diagnostic.json
new file mode 100644
index 0000000000000000000000000000000000000000..8589f84d5c4b92862022f1aca09160e6b65416e6
--- /dev/null
+++ b/contrib/logging/conversion/rules/staking-proof-reward-diagnostic.json
@@ -0,0 +1,44 @@
+{
+  "schema": 1,
+  "batch": "staking-proof-reward-diagnostic",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "shared_ecash",
+  "source_provenance": "Original source call attributed to upstream7bfcd9e57cf, predating pinned ABC1fb7db17. This is unrelated to Lotus V2 treasury.",
+  "files": [
+    {
+      "path": "src/avalanche/peermanager.cpp",
+      "rules": [
+        {
+          "id": "staking_reward_zero_hash_skipped",
+          "old": "LogPrintf(\n                    \"Staking reward hash has a suspicious value of zero for \"\n                    \"proof %s and blockhash %s, skipping\\n\",\n                    peer.getProofId().ToString(), prevblockhash.ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"staking_reward_zero_hash_skipped\", \"Staking reward hash has a suspicious value of zero for proof {proof_id} and blockhash {block_hash}, skipping\").Field(BCLog::LogField::ProofId, peer.getProofId()).Field(BCLog::LogField::BlockHash, prevblockhash)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Staking reward hash has a suspicious value of zero for proof %s and blockhash %s, skipping\n",
+            "specifiers": [
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "peer.getProofId().ToString()",
+              "prevblockhash.ToString()"
+            ]
+          },
+          "review_note": "Preserve upstream ABC Info diagnostic, zero StakeContenderId guard, proof-selection/ranking and skip behavior. Raw proof identifier and previous block hash are distinct HASH fields; do not relabel a proof as TxId or import Lotus/BLAKE3 logic into eCash. The cryptographically exceptional zero reward-hash branch is not newly forced or exposed through a test hook."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Append explicit raw proof identifier instead of reusing transaction/block hash identity.",
+          "old": "    X(TipAgeSeconds, tip_age_seconds, INT, \"\", \"\")\n",
+          "new": "    X(TipAgeSeconds, tip_age_seconds, INT, \"\", \"\") \\\n    X(ProofId, proof_id, HASH, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/avalanche/peermanager.cpp b/src/avalanche/peermanager.cpp
index 0c2da50c832aa61b85558c0b5f8d8ff30fc1235e..72928618082a2fb8e9c8835087f50c2b5efbd91b 100644
--- a/src/avalanche/peermanager.cpp
+++ b/src/avalanche/peermanager.cpp
@@ -1167,10 +1167,11 @@ bool PeerManager::selectStakingRewardWinner(
                 // This either the result of an incredibly unlikely lucky hash,
                 // or a the hash is getting abused. In this case, skip the
                 // proof.
-                LogPrintf(
-                    "Staking reward hash has a suspicious value of zero for "
-                    "proof %s and blockhash %s, skipping\n",
-                    peer.getProofId().ToString(), prevblockhash.ToString());
+                LogInfoEvent(
+                    BCLog::ALL, "staking_reward_zero_hash_skipped",
+                    "Staking reward hash has a suspicious value of zero for proof {proof_id} and blockhash {block_hash}, skipping")
+                    .Field(BCLog::LogField::ProofId, peer.getProofId())
+                    .Field(BCLog::LogField::BlockHash, prevblockhash);
                 continue;
             }
 
diff --git a/src/logging/fields.h b/src/logging/fields.h
index 9fcc26135b070c6732493c8f06c670194aa26ee3..a82bb1e181be7e553e1bdbc0f2bef463fcf3c84c 100644
--- a/src/logging/fields.h
+++ b/src/logging/fields.h
@@ -207,7 +207,8 @@
     X(VoteItemType, vote_item_type, STRING, "", "") \
     X(VoteItemId, vote_item_id, HASH, "", "") \
     X(PeerAddressSuffix, peer_address_suffix, STRING, "", "") \
-    X(TipAgeSeconds, tip_age_seconds, INT, "", "")
+    X(TipAgeSeconds, tip_age_seconds, INT, "", "") \
+    X(ProofId, proof_id, HASH, "", "")
 
 namespace BCLog {
 
