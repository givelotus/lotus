rule('Malformed avaresponse from peer=%d: %s','peer_avalanche_response_malformed',('PeerId','peer_id'),('Error','error'))
rule('ignoring %s message from %s peer=%d','peer_message_ignored_for_connection_type',('MsgType','msg_type'),('ConnType','conn_type'),('PeerId','peer_id'))
rule('Ignoring "getaddr" from %s connection. peer=%d','peer_address_request_connection_type_ignored',('ConnType','conn_type'),('PeerId','peer_id'))
rule('Ignoring getavaaddr message from %s peer=%d','peer_avalanche_address_request_connection_type_ignored',('ConnType','conn_type'),('PeerId','peer_id'))
rule('Unknown command "%s" from peer=%d','peer_command_unknown',('MsgType','msg_type'),('PeerId','peer_id'))
rule('received: %s (%u bytes) peer=%d','peer_message_received',('MsgType','msg_type'),('Bytes','bytes'),('PeerId','peer_id'))
rule('peer=%d using obsolete version %i; disconnecting','peer_version_obsolete',('PeerId','peer_id'),('Version','version'))
rule('received getdata (%u invsz) peer=%d','peer_getdata_received',('Count','count'),('PeerId','peer_id'))
rule('Warning: disconnecting but not discouraging %s peer %d!','peer_disconnected_without_discouragement',('ConnType','conn_type'),('PeerId','peer_id'))
rule('Decreased stalling timeout to %d seconds','peer_stalling_timeout_decreased',('WaitSeconds','wait_seconds'))
rule('Increased stalling timeout temporarily to %d seconds','peer_stalling_timeout_increased',('WaitSeconds','wait_seconds'))
path=Path('src/net_processing.cpp');source=path.read_text();rules=[]
for n in convert.calls(source,convert.LEGACY):
 try:d=convert.describe(n)
 except ValueError:continue
 if d['format'] not in P:continue
 event,keys=P[d['format']];assert len(keys)==len(d['arguments'])
 if not any(key=='PeerId' for key,_ in keys):event=event.replace('peer_','network_',1)
 cat=convert.args(n)[0].text() if d['macro'] in {'LogDebug','LogPrint','LogPrintLevel'} else 'BCLog::ALL'
 macro='LogEvent' if d['macro'] in {'LogDebug','LogPrint'} else 'LogErrorEvent'
 if d['macro']=='LogPrintLevel':
  macro={'BCLog::Level::Debug':'LogEvent','BCLog::Level::Info':'LogInfoEvent','BCLog::Level::Warning':'LogWarningEvent','BCLog::Level::Error':'LogErrorEvent'}[convert.args(n)[1].text()]
 else:assert d['macro'] in {'LogDebug','LogPrint','LogError'},d
 text='';i=0
 for prefix,spec in convert.format_parts(d['format']):
  text+=prefix
  if spec:text+='{'+keys[i][1]+'}';i+=1
 new=f'{macro}({cat}, {json.dumps(event)}, {json.dumps(text.removesuffix(chr(10)))})'
 for (key,_),arg in zip(keys,d['arguments']):new+=f'.Field(BCLog::LogField::{key}, {arg})'
 rules.append(dict(id=event+'_'+str(len(rules)),old=n.text(),replacement=new,count=1,reviewed_input=d,review_note='Preserve original message, category/severity, expressions and all peer protocol decisions. Typed peer identities, protocol version, counts and seconds; bounded existing error snapshots. No wire, polling, disconnect, penalty, privacy or producer API change.'))
# Identical calls share an exact-count rule; distinct expressions keep distinct IDs.
grouped={}
for r in rules:
 key=convert.fingerprint(convert.calls(r['old'],convert.LEGACY)[0])
 if key in grouped:grouped[key]['count']+=1
 else:grouped[key]=r
result,report=convert.convert(source,list(grouped.values()))
path.write_text(result)
Path('/Users/shammah/repos/lotus-v2-repair-work/logging-network/peer-protocol-source-report.json').write_text(json.dumps(dict(status='SOURCE_ONLY_NOT_COMPILED_NOT_RUN',sites=len(rules),inventory=report),indent=2)+'\n')
print('Converted',len(rules),'peer protocol producers')
