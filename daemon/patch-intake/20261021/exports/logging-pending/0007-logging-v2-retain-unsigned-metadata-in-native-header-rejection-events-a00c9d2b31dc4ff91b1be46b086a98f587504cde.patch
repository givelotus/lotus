+// This case belongs after the native V2 header consensus owner. Shared ABC
+// headers do not contain the claimed size/height/version fields exercised here.
+BOOST_FIXTURE_TEST_CASE(logging_native_header_rejections_retain_wire_metadata,
+                        RegTestingSetup) {
+    ChainstateManager &chainman = *Assert(m_node.chainman);
+    const auto capture = [&](const char *event, auto &&action) {
+        std::string rendered;
+        {
+            LogInstance().Flush();
+            struct RestoreFormat {
+                BCLog::LogFormat previous{LogInstance().m_log_format};
+                ~RestoreFormat() {
+                    LogInstance().Flush();
+                    LogInstance().m_log_format = previous;
+                }
+            } restore;
+            LogInstance().m_log_format = BCLog::LogFormat::JSON;
+            DebugLogHelper helper(event, [&](const std::string *line) {
+                if (line) rendered = *line;
+                return false;
+            });
+            action();
+        }
+        UniValue row;
+        BOOST_REQUIRE(row.read(rendered));
+        BOOST_CHECK_EQUAL(row["event"].get_str(), event);
+        BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+        BOOST_CHECK(row["fields_truncated"].isNull());
+        return row;
+    };
+    const uint64_t maximum = std::numeric_limits<uint64_t>::max();
+    constexpr uint64_t limit = 1000000;
+    const auto rejected_block = [&](const CBlock &block, const char *reason) {
+        BlockValidationState state;
+        // Use the public validation entry point and actual metadata rejection;
+        // only independent PoW/Merkle checks are disabled for these cases.
+        BOOST_CHECK(!CheckBlock(block, state, chainman.GetConsensus(),
+                                BlockValidationOptions(limit, false, false)));
+        BOOST_CHECK_EQUAL(state.GetRejectReason(), reason);
+    };
+
+    CBlock block;
+    block.nHeaderVersion = std::numeric_limits<uint32_t>::max();
+    auto row = capture("block_header_version_mismatch",
+                       [&] { rejected_block(block, "bad-blk-version"); });
+    BOOST_REQUIRE(row["header_version"].isNum());
+    BOOST_CHECK_EQUAL(row["header_version"].getInt<uint64_t>(),
+                      std::numeric_limits<uint32_t>::max());
+    BOOST_CHECK_EQUAL(row["expected_header_version"].getInt<uint64_t>(),
+                      lotus::v2::kHeaderVersion);
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      strprintf("ERROR: expected block version %u but got %u",
+                                lotus::v2::kHeaderVersion,
+                                block.nHeaderVersion));
+
+    block.nHeaderVersion = lotus::v2::kHeaderVersion;
+    block.nSize = maximum;
+    row = capture("block_header_claimed_size_excessive",
+                  [&] { rejected_block(block, "bad-blk-size"); });
+    BOOST_REQUIRE(row["claimed_block_bytes"].isNum());
+    BOOST_CHECK_EQUAL(row["claimed_block_bytes"].getInt<uint64_t>(), maximum);
+    BOOST_CHECK_EQUAL(row["block_limit_bytes"].getInt<uint64_t>(), limit);
+    BOOST_CHECK_EQUAL(
+        row["message"].get_str(),
+        strprintf(
+            "ERROR: block has excessive size %u, which is above the limit %u",
+            maximum, limit));
+
+    CMutableTransaction coinbase;
+    coinbase.nVersion = 2;
+    coinbase.vin.resize(1);
+    coinbase.vin[0].prevout.SetNull();
+    coinbase.vout.emplace_back(SATOSHI, CScript() << OP_TRUE);
+    block.vtx.push_back(MakeTransactionRef(coinbase));
+    block.nSize = 1000;
+    const uint64_t actual = GetSerializeSize(block);
+    BOOST_REQUIRE(actual != block.nSize);
+    row = capture("block_header_size_mismatch",
+                  [&] { rejected_block(block, "bad-blk-size-mismatch"); });
+    BOOST_CHECK_EQUAL(row["claimed_block_bytes"].getInt<uint64_t>(),
+                      block.nSize);
+    BOOST_REQUIRE(row["actual_block_bytes"].isNum());
+    BOOST_CHECK_EQUAL(row["actual_block_bytes"].getInt<uint64_t>(), actual);
+    BOOST_CHECK_EQUAL(
+        row["message"].get_str(),
+        strprintf(
+            "ERROR: block size mismatch: claims to have size %u, but has %u",
+            block.nSize, actual));
+
+    const CBlockIndex *previous =
+        WITH_LOCK(cs_main, return Assert(chainman.ActiveTip()));
+    CBlockHeader header = chainman.GetParams().GenesisBlock().GetBlockHeader();
+    header.hashPrevBlock = previous->GetBlockHash();
+    header.nHeight = maximum;
+    header.SetBlockTime(previous->GetMedianTimePast() + 1);
+    bool solved = false;
+    for (unsigned attempt = 0; attempt < 1024; ++attempt) {
+        if (CheckProofOfWork(header.GetHash(), header.nBits,
+                             chainman.GetConsensus())) {
+            solved = true;
+            break;
+        }
+        ++header.nNonce;
+    }
+    BOOST_REQUIRE(solved);
+    BlockValidationState state;
+    row = capture("block_header_height_mismatch", [&] {
+        BOOST_CHECK(!chainman.ProcessNewBlockHeaders({header}, true, state));
+    });
+    BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-blk-height");
+    BOOST_CHECK(state.GetResult() ==
+                BlockValidationResult::BLOCK_INVALID_HEADER);
+    BOOST_CHECK(WITH_LOCK(cs_main, return chainman.ActiveTip()) == previous);
+    BOOST_REQUIRE(row["claimed_block_height"].isNum());
+    BOOST_CHECK_EQUAL(row["claimed_block_height"].getInt<uint64_t>(), maximum);
+    BOOST_CHECK_EQUAL(row["expected_block_height"].getInt<int64_t>(),
+                      previous->nHeight + 1);
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      strprintf("ERROR: expected block height %d but got %u",
+                                previous->nHeight + 1, maximum));
+}
+
