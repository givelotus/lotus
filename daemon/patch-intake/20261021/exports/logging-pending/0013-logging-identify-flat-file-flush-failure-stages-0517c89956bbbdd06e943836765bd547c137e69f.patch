 #include <clientversion.h>
 #include <common/args.h>
+#include <logging.h>
 #include <streams.h>
+#include <univalue.h>
 
+#include <test/util/logging.h>
 #include <test/util/setup_common.h>
 
 #include <boost/test/unit_test.hpp>
 
 BOOST_FIXTURE_TEST_SUITE(flatfile_tests, BasicTestingSetup)
 
+BOOST_AUTO_TEST_CASE(logging_flush_open_failure_retains_file_number) {
+    const auto data_dir = m_args.GetDataDirBase();
+    FlatFileSeq seq(data_dir, "logging", 100);
+    const FlatFilePos position{19, 0};
+    // A directory at the expected filename makes both rb+ and wb+ fail using
+    // owned temporary paths only. No permissions, live files or OS limits are
+    // changed. The directory must survive the failed flush unchanged.
+    BOOST_REQUIRE(fs::create_directory(seq.FileName(position)));
+    std::string rendered;
+    {
+        LogInstance().Flush();
+        struct RestoreFormat {
+            BCLog::LogFormat previous{LogInstance().m_log_format};
+            ~RestoreFormat() {
+                LogInstance().Flush();
+                LogInstance().m_log_format = previous;
+            }
+        } restore;
+        LogInstance().m_log_format = BCLog::LogFormat::JSON;
+        DebugLogHelper capture("flatfile_flush_open_failed",
+                               [&](const std::string *line) {
+                                   if (line) rendered = *line;
+                                   return false;
+                               });
+        BOOST_CHECK(!seq.Flush(position));
+    }
+    BOOST_CHECK(fs::is_directory(seq.FileName(position)));
+    BOOST_CHECK(fs::is_empty(seq.FileName(position)));
+    UniValue row;
+    BOOST_REQUIRE(row.read(rendered));
+    BOOST_CHECK_EQUAL(row["event"].get_str(), "flatfile_flush_open_failed");
+    BOOST_CHECK_EQUAL(row["source_function"].get_str(), "Flush");
+    BOOST_REQUIRE(row["file_number"].isNum());
+    BOOST_CHECK_EQUAL(row["file_number"].getInt<int64_t>(), position.nFile);
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      "Flush: failed to open file 19");
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "error");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+}
+
 BOOST_AUTO_TEST_CASE(flatfile_filename) {
     const auto data_dir = m_args.GetDataDirBase();
 
