From 89d4566c569eb32c592d26f7f3fadf1efe9300af Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:11 -0700
Subject: [PATCH] fixup! logging: structure headers presync rejection
 diagnostics

Remove presync event names, peer/height schema and reconstructed message assertions. Retain public invalid-target and commitment-bound failures, FINAL state, and meaningful Info visibility with NET logging disabled.

Source-only targeted review and whitespace checks pass. Compilation/runtime NOT RUN. Only the named functions in src/test/logging_event_tests.cpp change; generic renderer/lifetime/queue/format/adapters remain untouched.
---
 src/test/logging_event_tests.cpp | 33 +++-----------------------------
 1 file changed, 3 insertions(+), 30 deletions(-)

diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 8db3b8e6b7404914baca30df055f47b2a6bf04a7..e591706c109a8dee7bdefd88f216581b5e8fb377 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -1351,7 +1351,7 @@ BOOST_AUTO_TEST_CASE(
 #endif
 
 BOOST_AUTO_TEST_CASE(
-    headers_presync_rejections_keep_peer_height_and_final_state) {
+    headers_presync_rejections_finalize_and_log_at_info_with_net_disabled) {
     Format(BCLog::LogFormat::JSON);
     LogInstance().DisableCategory(
         BCLog::NET); // Leave only actual Info failures.
@@ -1368,20 +1368,7 @@ BOOST_AUTO_TEST_CASE(
     const auto rejected{invalid.ProcessNextHeaders({bad}, true)};
     BOOST_CHECK(!rejected.success);
     BOOST_CHECK(invalid.GetState() == HeadersSyncState::State::FINAL);
-    auto row{Json()};
-    BOOST_CHECK_EQUAL(row["event"].get_str(),
-                      "headers_presync_difficulty_invalid");
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["peer_id"].isNum());
-    BOOST_CHECK_EQUAL(row["peer_id"].getInt<int64_t>(), -7);
-    BOOST_CHECK(row["height"].isNum());
-    BOOST_CHECK_EQUAL(row["height"].getInt<int64_t>(), base.nHeight + 1);
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf(
-            "Initial headers sync aborted with peer=%d: invalid difficulty transition at height=%i (presync phase)",
-            -7, base.nHeight + 1));
-    BOOST_CHECK(row["fields_truncated"].isNull());
+    BOOST_CHECK_EQUAL(Json()["level"].get_str(), "info");
 
     // A synthetic starting tip at the future-time bound leaves zero allowed
     // commitments. One commitment is attempted within each 610-header period,
@@ -1404,21 +1391,7 @@ BOOST_AUTO_TEST_CASE(
     const auto exceeded{bounded.ProcessNextHeaders(headers, true)};
     BOOST_CHECK(!exceeded.success);
     BOOST_CHECK(bounded.GetState() == HeadersSyncState::State::FINAL);
-    row = Json();
-    BOOST_CHECK_EQUAL(row["event"].get_str(),
-                      "headers_presync_commitments_exceeded");
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["peer_id"].isNum());
-    BOOST_CHECK_EQUAL(row["peer_id"].getInt<int64_t>(), 8);
-    BOOST_CHECK(row["height"].isNum());
-    const auto height{row["height"].getInt<int64_t>()};
-    BOOST_CHECK(height >= base.nHeight + 1 && height <= base.nHeight + 610);
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf(
-            "Initial headers sync aborted with peer=%d: exceeded max commitments at height=%i (presync phase)",
-            8, height));
-    BOOST_CHECK(row["fields_truncated"].isNull());
+    BOOST_CHECK_EQUAL(Json()["level"].get_str(), "info");
 }
 
 BOOST_AUTO_TEST_CASE(
