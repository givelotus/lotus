new file mode 100644
index 0000000000000000000000000000000000000000..e3ebd1cd0983e5ab470a4264f36e060ca3cab992
--- /dev/null
+++ b/contrib/logging/conversion/rules/v2-treasury-policy-diagnostics.json
@@ -0,0 +1,48 @@
+{
+  "schema": 1,
+  "batch": "v2-treasury-policy-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "lotus_v2_only",
+  "placement": "After original native treasury owner f5209739e1 (avalanche:add treasury contender voting,50/25/25 reward split,default slate; Original-Patch v2/022). Do not place in shared eCash tier.",
+  "files": [
+    {
+      "path": "src/avalanche/treasury.cpp",
+      "rules": [
+        {
+          "id": "treasury_reward_output_missing",
+          "old": "LogPrintf(\"Block %s violates treasury reward policy: missing \"\n                      \"treasury output\\n\",\n                      m_blockIndex.GetBlockHash().ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"treasury_reward_output_missing\", \"Block {block_hash} violates treasury reward policy: missing treasury output\").Field(BCLog::LogField::BlockHash, m_blockIndex.GetBlockHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Block %s violates treasury reward policy: missing treasury output\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "m_blockIndex.GetBlockHash().ToString()"
+            ]
+          },
+          "review_note": "Lotus V2 ONLY: file introduced by f5209739e1 (Original-Patch v2/022), after native treasury consensus. Preserve Info text, raw block hash, reward arithmetic, candidate matching, all policy decisions/returns and rejection reasons. No shared eCash treasury, consensus, hash or issuance changes. Actual existing missing-output negative policy case captures JSON after Flush; insufficient-total-payout branch is not newly forced."
+        },
+        {
+          "id": "treasury_reward_payout_insufficient",
+          "old": "LogPrintf(\"Block %s violates treasury reward policy: insufficient \"\n                  \"treasury payout\\n\",\n                  m_blockIndex.GetBlockHash().ToString())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"treasury_reward_payout_insufficient\", \"Block {block_hash} violates treasury reward policy: insufficient treasury payout\").Field(BCLog::LogField::BlockHash, m_blockIndex.GetBlockHash())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Block %s violates treasury reward policy: insufficient treasury payout\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "m_blockIndex.GetBlockHash().ToString()"
+            ]
+          },
+          "review_note": "Lotus V2 ONLY: file introduced by f5209739e1 (Original-Patch v2/022), after native treasury consensus. Preserve Info text, raw block hash, reward arithmetic, candidate matching, all policy decisions/returns and rejection reasons. No shared eCash treasury, consensus, hash or issuance changes. Actual existing missing-output negative policy case captures JSON after Flush; insufficient-total-payout branch is not newly forced."
+        }
+      ]
+    }
+  ]
+}
