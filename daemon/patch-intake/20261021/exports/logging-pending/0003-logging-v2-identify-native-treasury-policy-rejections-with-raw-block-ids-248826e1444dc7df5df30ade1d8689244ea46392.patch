index 347d80c8511746c7f2ce447258a947eb0f069e7e..0fa69f77eff38f1da7b2cbe5c97969a59acc7c1d 100644
--- a/src/avalanche/test/treasury_tests.cpp
+++ b/src/avalanche/test/treasury_tests.cpp
@@ -12,6 +12,7 @@
 #include <common/args.h>
 #include <config.h>
 #include <consensus/validation.h>
+#include <logging.h>
 #include <net_processing.h>
 #include <policy/block/parkingpolicy.h>
 #include <policy/block/treasury.h>
@@ -19,8 +20,10 @@
 #include <primitives/transaction.h>
 #include <protocol.h>
 #include <script/script.h>
+#include <univalue.h>
 #include <validation.h>
 
+#include <test/util/logging.h>
 #include <test/util/net.h>
 #include <test/util/setup_common.h>
 
@@ -174,7 +177,36 @@ BOOST_FIXTURE_TEST_CASE(treasury_policy_and_voting,
         BlockPolicyValidationState policyState;
         TreasuryPolicy policy(*m_node.avalanche, consensusParams, policyState,
                               &blockIdx, blockMissingTreasury, blockSubsidy);
-        BOOST_CHECK(!policy(policyState));
+        std::string rendered;
+        {
+            LogInstance().Flush();
+            struct RestoreFormat {
+                BCLog::LogFormat previous{LogInstance().m_log_format};
+                ~RestoreFormat() {
+                    LogInstance().Flush();
+                    LogInstance().m_log_format = previous;
+                }
+            } restore;
+            LogInstance().m_log_format = BCLog::LogFormat::JSON;
+            DebugLogHelper capture(
+                "treasury_reward_output_missing", [&](const std::string *line) {
+                    if (line) rendered = *line;
+                    return false; // Missing event is a normal Boost assertion.
+                });
+            BOOST_CHECK(!policy(policyState));
+        } // Flush callback writes before inspecting JSON or restoring format.
+        UniValue diagnostic;
+        BOOST_REQUIRE(diagnostic.read(rendered));
+        BOOST_CHECK_EQUAL(diagnostic["event"].get_str(),
+                          "treasury_reward_output_missing");
+        BOOST_CHECK_EQUAL(diagnostic["block_hash"].get_str(),
+                          dummyBlockHash.ToString());
+        BOOST_CHECK_EQUAL(
+            diagnostic["message"].get_str(),
+            "Block " + dummyBlockHash.ToString() +
+                " violates treasury reward policy: missing treasury output");
+        BOOST_CHECK_EQUAL(diagnostic["level"].get_str(), "info");
+        BOOST_CHECK(diagnostic["fields_truncated"].isNull());
         BOOST_CHECK(!policyState.IsValid());
         BOOST_CHECK_EQUAL(policyState.GetRejectReason(),
                           "bad-cb-treasury-reward");
