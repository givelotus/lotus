 BOOST_FIXTURE_TEST_SUITE(coins_tests, BasicTestingSetup)
 
+BOOST_FIXTURE_TEST_CASE(logging_coin_stats_cursor_failure_propagates,
+                        RegTestingSetup) {
+    enum class Mode { KEY_FAILURE, VALUE_FAILURE, EMPTY };
+    struct ReadCounts {
+        unsigned keys{0}, values{0}, next{0};
+    };
+    class FailingStatsCursor final : public CCoinsViewCursor {
+    public:
+        FailingStatsCursor(const BlockHash &best, Mode mode, ReadCounts &counts)
+            : CCoinsViewCursor{best}, m_mode{mode}, m_counts{counts} {}
+        bool GetKey(COutPoint &) const override {
+            ++m_counts.keys;
+            return m_mode != Mode::KEY_FAILURE;
+        }
+        bool GetValue(Coin &) const override {
+            ++m_counts.values;
+            return false;
+        }
+        unsigned int GetValueSize() const override { return 0; }
+        bool Valid() const override { return m_valid && m_mode != Mode::EMPTY; }
+        void Next() override {
+            ++m_counts.next;
+            m_valid = false;
+        }
+
+    private:
+        const Mode m_mode;
+        ReadCounts &m_counts;
+        bool m_valid{true};
+    };
+    class View final : public CCoinsView {
+    public:
+        View(const BlockHash &best, Mode mode, ReadCounts &counts)
+            : m_best{best}, m_mode{mode}, m_counts{counts} {}
+        BlockHash GetBestBlock() const override { return m_best; }
+        CCoinsViewCursor *Cursor() const override {
+            return new FailingStatsCursor{m_best, m_mode, m_counts};
+        }
+
+    private:
+        const BlockHash m_best;
+        const Mode m_mode;
+        ReadCounts &m_counts;
+    };
+
+    ChainstateManager &chainman = *Assert(m_node.chainman);
+    const BlockHash best =
+        WITH_LOCK(cs_main, return Assert(chainman.ActiveTip())->GetBlockHash());
+    for (const Mode mode : {Mode::KEY_FAILURE, Mode::VALUE_FAILURE}) {
+        ReadCounts counts;
+        View view{best, mode, counts};
+        std::string rendered;
+        {
+            LogInstance().Flush();
+            struct RestoreFormat {
+                BCLog::LogFormat previous{LogInstance().m_log_format};
+                ~RestoreFormat() {
+                    LogInstance().Flush();
+                    LogInstance().m_log_format = previous;
+                }
+            } restore;
+            LogInstance().m_log_format = BCLog::LogFormat::JSON;
+            DebugLogHelper capture("coin_stats_cursor_read_failed",
+                                   [&](const std::string *line) {
+                                       if (line) rendered = *line;
+                                       return false;
+                                   });
+            BOOST_CHECK(
+                !kernel::ComputeUTXOStats(kernel::CoinStatsHashType::NONE,
+                                          &view, chainman.m_blockman, [] {}));
+        }
+        BOOST_CHECK_EQUAL(counts.keys, 1U);
+        BOOST_CHECK_EQUAL(counts.values, mode == Mode::VALUE_FAILURE ? 1U : 0U);
+        BOOST_CHECK_EQUAL(counts.next, 0U);
+        UniValue row;
+        BOOST_REQUIRE(row.read(rendered));
+        BOOST_CHECK_EQUAL(row["event"].get_str(),
+                          "coin_stats_cursor_read_failed");
+        BOOST_CHECK_EQUAL(row["source_function"].get_str(), "ComputeUTXOStats");
+        BOOST_CHECK_EQUAL(row["message"].get_str(),
+                          "ComputeUTXOStats: unable to read value");
+        BOOST_CHECK_EQUAL(row["level"].get_str(), "error");
+        BOOST_CHECK(row["fields_truncated"].isNull());
+    }
+    ReadCounts counts;
+    View empty{best, Mode::EMPTY, counts};
+    const auto stats = kernel::ComputeUTXOStats(
+        kernel::CoinStatsHashType::NONE, &empty, chainman.m_blockman, [] {});
+    BOOST_REQUIRE(stats);
+    BOOST_CHECK_EQUAL(stats->nHeight, 0);
+    BOOST_CHECK_EQUAL(stats->coins_count, 0U);
+    BOOST_CHECK_EQUAL(counts.keys, 0U);
+    BOOST_CHECK_EQUAL(counts.values, 0U);
+    BOOST_CHECK_EQUAL(counts.next, 0U);
+}
