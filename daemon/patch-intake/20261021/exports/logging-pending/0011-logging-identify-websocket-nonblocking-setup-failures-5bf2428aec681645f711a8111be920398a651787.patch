 BOOST_FIXTURE_TEST_SUITE(net_websocket_tests, WebSocketTestingSetup)
 
+BOOST_AUTO_TEST_CASE(logging_nonblocking_failure_retains_static_diagnostic) {
+    std::string rendered;
+    {
+        LogInstance().Flush();
+        struct RestoreFormat {
+            BCLog::LogFormat previous{LogInstance().m_log_format};
+            ~RestoreFormat() {
+                LogInstance().Flush();
+                LogInstance().m_log_format = previous;
+            }
+        } restore;
+        LogInstance().m_log_format = BCLog::LogFormat::JSON;
+        DebugLogHelper capture("websocket_nonblocking_failed",
+                               [&](const std::string *line) {
+                                   if (line) rendered = *line;
+                                   return false;
+                               });
+        // fcntl/ioctlsocket on INVALID_SOCKET fails without creating traffic or
+        // transferring ownership of a live descriptor. Exercise the constructor
+        // diagnostic through its actual nonblocking setup path.
+        WebSocketSock socket{INVALID_SOCKET, Role::CLIENT, Info(C::NONE),
+                             std::make_unique<PlainByteLayer>()};
+    }
+    UniValue row;
+    BOOST_REQUIRE(row.read(rendered));
+    BOOST_CHECK_EQUAL(row["event"].get_str(), "websocket_nonblocking_failed");
+    BOOST_CHECK_EQUAL(row["message"].get_str(),
+                      "WebSocket: unable to make socket non-blocking");
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+}
