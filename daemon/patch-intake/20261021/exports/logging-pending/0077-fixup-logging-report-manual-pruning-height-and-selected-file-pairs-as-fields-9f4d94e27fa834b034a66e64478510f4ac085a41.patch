From 9f4d94e27fa834b034a66e64478510f4ac085a41 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:50 -0700
Subject: [PATCH] fixup! logging: report manual pruning height and selected
 file pairs as fields

---
 src/test/blockmanager_tests.cpp | 41 ++++-----------------------------
 1 file changed, 5 insertions(+), 36 deletions(-)

diff --git a/src/test/blockmanager_tests.cpp b/src/test/blockmanager_tests.cpp
index 4fc6772fea1835b9876a6aaf12cc7380fa02a5c7..aac3f574e93d32524709d4cc56a5ceceb0c402a9 100644
--- a/src/test/blockmanager_tests.cpp
+++ b/src/test/blockmanager_tests.cpp
@@ -137,13 +137,12 @@ BOOST_FIXTURE_TEST_CASE(block_undo_failures_and_checksum_recovery,
     BOOST_CHECK(result.vtxundo.empty());
 }
 
-BOOST_FIXTURE_TEST_CASE(logging_manual_prune_retains_role_and_zero_pair_count,
+BOOST_FIXTURE_TEST_CASE(manual_prune_empty_manager_selects_no_files,
                         RegTestingSetup) {
     ChainstateManager &chainman = *Assert(m_node.chainman);
     KernelNotifications notifications{m_node.exit_status};
-    // A separate manager has no eligible files; the real pruning entry point
-    // must report its effective height and zero selected pairs without touching
-    // the fixture's block files or using private-member test hooks.
+    // A separate manager has no eligible files and must leave the selection
+    // empty without touching the fixture's block files or using private hooks.
     BlockManager::Options options{
         .chainparams = chainman.GetParams(),
         .blocks_dir = m_args.GetBlocksDirPath(),
@@ -152,39 +151,9 @@ BOOST_FIXTURE_TEST_CASE(logging_manual_prune_retains_role_and_zero_pair_count,
     options.prune_target = 1;
     BlockManager manager{m_node.kernel->interrupt, options};
     std::set<int> selected;
-    std::string rendered;
-    {
-        LogInstance().Flush();
-        struct RestoreFormat {
-            BCLog::LogFormat previous{LogInstance().m_log_format};
-            ~RestoreFormat() {
-                LogInstance().Flush();
-                LogInstance().m_log_format = previous;
-            }
-        } restore;
-        LogInstance().m_log_format = BCLog::LogFormat::JSON;
-        DebugLogHelper capture("manual_prune_files_selected",
-                               [&](const std::string *line) {
-                                   if (line) rendered = *line;
-                                   return false;
-                               });
-        manager.FindFilesToPruneManual(selected, 1, chainman.ActiveChainstate(),
-                                       chainman);
-    }
+    manager.FindFilesToPruneManual(selected, 1, chainman.ActiveChainstate(),
+                                   chainman);
     BOOST_CHECK(selected.empty());
-    UniValue row;
-    BOOST_REQUIRE(row.read(rendered));
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "manual_prune_files_selected");
-    BOOST_CHECK_EQUAL(row["chainstate_role"].get_str(), "normal");
-    BOOST_REQUIRE(row["prune_height"].isNum());
-    BOOST_CHECK_EQUAL(row["prune_height"].getInt<int64_t>(), 0);
-    BOOST_REQUIRE(row["pruned_block_file_pair_count"].isNum());
-    BOOST_CHECK_EQUAL(row["pruned_block_file_pair_count"].getInt<int64_t>(), 0);
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        "[normal] Prune (Manual): prune_height=0 removed 0 blk/rev pairs");
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
 BOOST_AUTO_TEST_CASE(blockmanager_find_block_pos) {
