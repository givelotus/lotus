From 0f496f39bc4c115df16c58a083c67190d2aeb021 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:53:52 -0700
Subject: [PATCH] fixup! logging: expose typed configured database and UTXO
 cache budgets

Remove the standalone producer-conversion fixture: its substantive assertions only checked the migrated event name, field spelling/types and reconstructed message. The lasting generic structured renderer, lifetime, format, filtering and shutdown tests remain. No production change.

Source-only removal; no native/runtime validation claimed.
---
 .../feature_logging_cache_budget.py           | 64 -------------------
 1 file changed, 64 deletions(-)
 delete mode 100644 test/functional/feature_logging_cache_budget.py

diff --git a/test/functional/feature_logging_cache_budget.py b/test/functional/feature_logging_cache_budget.py
deleted file mode 100644
index ef1f2e87860174252e683eb0482732106dba8338..0000000000000000000000000000000000000000
--- a/test/functional/feature_logging_cache_budget.py
+++ /dev/null
@@ -1,64 +0,0 @@
-#!/usr/bin/env python3
-# Copyright (c) 2026 The Lotus developers
-# Distributed under the MIT software license, see the accompanying
-# file COPYING or http://www.opensource.org/licenses/mit-license.php.
-"""Configured cache budgets remain numeric MiB with unchanged readable precision."""
-
-import json
-import math
-
-from test_framework.test_framework import BitcoinTestFramework
-from test_framework.util import assert_equal
-
-
-class CacheBudgetLoggingTest(BitcoinTestFramework):
-    num_nodes = 1
-    setup_clean_chain = True
-    wallet_names = []
-    extra_args = [
-        ["-logformat=json", "-txindex=1", "-blockfilterindex=1", "-dbcache=96"]
-    ]
-
-    def run_test(self):
-        node = self.nodes[0]
-        # Shutdown flushes the async logger before reading the primary log.
-        self.stop_node(0)
-        records = [
-            json.loads(line)
-            for line in node.debug_log_path.read_text().splitlines()
-            if line.strip()
-        ]
-        for event, suffix in (
-            ("cache_block_index_budget", "block index database"),
-            ("cache_transaction_index_budget", "transaction index database"),
-            ("cache_chainstate_database_budget", "chain state database"),
-            ("cache_block_filter_index_budget", "block filter index database"),
-        ):
-            row = next(row for row in records if row.get("event") == event)
-            budget = row["database_cache_mib"]
-            assert (
-                type(budget) in (int, float) and math.isfinite(budget) and budget >= 0
-            )
-            if event == "cache_block_filter_index_budget":
-                assert isinstance(row["name"], str) and row["name"]
-                suffix = f"{row['name']} {suffix}"
-            assert_equal(row["message"], f"* Using {budget:.1f} MiB for {suffix}")
-            assert_equal(row["level"], "info")
-            assert "fields_truncated" not in row
-        row = next(
-            row for row in records if row.get("event") == "cache_utxo_memory_budget"
-        )
-        for name in ("utxo_cache_mib", "unused_mempool_cache_mib"):
-            value = row[name]
-            assert type(value) in (int, float) and math.isfinite(value) and value >= 0
-        assert_equal(
-            row["message"],
-            f"* Using {row['utxo_cache_mib']:.1f} MiB for in-memory UTXO set "
-            f"(plus up to {row['unused_mempool_cache_mib']:.1f} MiB of unused mempool space)",
-        )
-        assert_equal(row["level"], "info")
-        assert "fields_truncated" not in row
-
-
-if __name__ == "__main__":
-    CacheBudgetLoggingTest().main()
