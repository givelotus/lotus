From 22995cbbc67186c67f35ee5752801f26125b94ec Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:52:31 -0700
Subject: [PATCH] fixup! logging: add reproducible reviewed C++ AST conversion
 tool

Remove the maintained all-catalog conversion proof: it synthesizes old calls from each one-time recipe and reasserts recipe counts/idempotence. Keep callable conversion recipes, exact-input validation, parser behavior and atomic multi-file write controls. No logger behavior or producer changes.
---
 contrib/logging/conversion/test_convert.py | 14 --------------
 1 file changed, 14 deletions(-)

diff --git a/contrib/logging/conversion/test_convert.py b/contrib/logging/conversion/test_convert.py
index bf2d9c716eac67224d682ec70cd79a22a42538ff..1e5a81285ed9c1d4f1a0af9d16d8f547f50ed4cd 100755
--- a/contrib/logging/conversion/test_convert.py
+++ b/contrib/logging/conversion/test_convert.py
@@ -185,20 +185,6 @@ class ConversionTest(unittest.TestCase):
             with self.assertRaises(ValueError):
                 convert.convert(plain, [rule(plain, new)])
 
-    def test_all_catalog_rules_and_idempotence(self):
-        for path in sorted((Path(__file__).parent / "rules").glob("*.json")):
-            catalog = json.loads(path.read_text())
-            for item in catalog["files"]:
-                for r in item["rules"]:
-                    with self.subTest(rule=r["id"]):
-                        source = (";\n".join([r["old"]] * r.get("count", 1))) + ";"
-                        after, inventory = convert.convert(source, [r])
-                        self.assertEqual(
-                            sum(x["status"] == "converted" for x in inventory),
-                            r.get("count", 1),
-                        )
-                        self.assertEqual(convert.convert(after, [r])[0], after)
-
     def test_late_file_validation_failure_does_not_write_earlier_file(self):
         old = 'LogPrintf("x=%d", x)'
         new = 'LogInfoEvent(BCLog::ALL,"x","x={value}").Field(BCLog::LogField::Value,x)'
