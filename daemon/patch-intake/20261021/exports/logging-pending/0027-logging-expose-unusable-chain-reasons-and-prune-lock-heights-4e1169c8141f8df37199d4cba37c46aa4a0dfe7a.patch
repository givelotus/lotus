From 4e1169c8141f8df37199d4cba37c46aa4a0dfe7a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:46:19 -0700
Subject: [PATCH] logging: expose unusable-chain reasons and prune-lock heights

Convert four producers: candidate refusal with raw hash and three booleans, two prune-lock updates, and the chainstate load catch. Static suffix fields preserve the exact invalid/parked/missing-data sentence without formatting on the producer or adding a conditional renderer API. The catch copies exception text before returning. Preserve levels, categories, state transitions and return tuples.

Scripted diff commands:
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/validation-pruning-diagnostics.json --report /private/tmp/logging-core-pruning-report.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style "{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}" HEAD -- src/validation.cpp src/init.cpp
python3 test/lint/lint-log-events.py src/validation.cpp src/init.cpp
git diff --check

Source-only: NOT_COMPILED / NOT_RUN. Candidate rare paths and actual startup exceptions not forced. Exception text uses existing bounded copied Error contract; known long static fatal/configuration messages stay unchanged.
---
 .../rules/validation-pruning-diagnostics.json | 107 ++++++++++++++++++
 src/init.cpp                                  |   3 +-
 src/logging/fields.h                          |   8 +-
 src/validation.cpp                            |  34 ++++--
 4 files changed, 140 insertions(+), 12 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/validation-pruning-diagnostics.json

diff --git a/contrib/logging/conversion/rules/validation-pruning-diagnostics.json b/contrib/logging/conversion/rules/validation-pruning-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..4879af454313b4ee060d027ec9a2be7cb0fec36e
--- /dev/null
+++ b/contrib/logging/conversion/rules/validation-pruning-diagnostics.json
@@ -0,0 +1,107 @@
+{
+  "schema": 1,
+  "batch": "validation-pruning-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "shared_ecash",
+  "files": [
+    {
+      "path": "src/validation.cpp",
+      "rules": [
+        {
+          "id": "chain_candidate_unusable",
+          "old": "LogPrintf(\"Considered switching to better tip %s but that chain \"\n                      \"contains a%s%s%s block.\\n\",\n                      pindexNew->GetBlockHash().ToString(),\n                      fInvalidChain ? \"n invalid\" : \"\",\n                      fParkedChain ? \" parked\" : \"\",\n                      fMissingData ? \" missing-data\" : \"\")",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"chain_candidate_unusable\", \"Considered switching to better tip {block_hash} but that chain contains a{invalid_chain_suffix}{parked_chain_suffix}{missing_data_suffix} block.\").Field(BCLog::LogField::BlockHash, pindexNew->GetBlockHash()).Field(BCLog::LogField::InvalidChainSuffix, fInvalidChain ? BCLog::LogStatic(\"n invalid\") : BCLog::LogStatic(\"\")).Field(BCLog::LogField::ParkedChainSuffix, fParkedChain ? BCLog::LogStatic(\" parked\") : BCLog::LogStatic(\"\")).Field(BCLog::LogField::MissingDataSuffix, fMissingData ? BCLog::LogStatic(\" missing-data\") : BCLog::LogStatic(\"\")).Field(BCLog::LogField::InvalidChain, fInvalidChain).Field(BCLog::LogField::ParkedChain, fParkedChain).Field(BCLog::LogField::MissingBlockData, fMissingData)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "Considered switching to better tip %s but that chain contains a%s%s%s block.\n",
+            "specifiers": [
+              "%s",
+              "%s",
+              "%s",
+              "%s"
+            ],
+            "arguments": [
+              "pindexNew->GetBlockHash().ToString()",
+              "fInvalidChain ? \"n invalid\" : \"\"",
+              "fParkedChain ? \" parked\" : \"\"",
+              "fMissingData ? \" missing-data\" : \"\""
+            ]
+          },
+          "review_note": "Keep severity/category, original rendering and control flow; copied dynamic fields use existing bounded record/truncation contract. Source-only conversion; no compile/runtime validation claimed."
+        },
+        {
+          "id": "chain_pruning_height_limited",
+          "old": "LogDebug(BCLog::PRUNE, \"%s limited pruning to height %d\\n\",\n                             limiting_lock.value(), last_prune)",
+          "replacement": "LogEvent(BCLog::PRUNE, \"chain_pruning_height_limited\", \"{name} limited pruning to height {prune_height}\").Field(BCLog::LogField::Name, limiting_lock.value()).Field(BCLog::LogField::PruneHeight, last_prune)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "%s limited pruning to height %d\n",
+            "specifiers": [
+              "%s",
+              "%d"
+            ],
+            "arguments": [
+              "limiting_lock.value()",
+              "last_prune"
+            ]
+          },
+          "review_note": "Keep severity/category, original rendering and control flow; copied dynamic fields use existing bounded record/truncation contract. Source-only conversion; no compile/runtime validation claimed."
+        },
+        {
+          "id": "chain_prune_lock_rewound",
+          "old": "LogDebug(BCLog::PRUNE, \"%s prune lock moved back to %d\\n\",\n                     prune_lock.first, max_height_first)",
+          "replacement": "LogEvent(BCLog::PRUNE, \"chain_prune_lock_rewound\", \"{name} prune lock moved back to {prune_height}\").Field(BCLog::LogField::Name, prune_lock.first).Field(BCLog::LogField::PruneHeight, max_height_first)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "%s prune lock moved back to %d\n",
+            "specifiers": [
+              "%s",
+              "%d"
+            ],
+            "arguments": [
+              "prune_lock.first",
+              "max_height_first"
+            ]
+          },
+          "review_note": "Keep severity/category, original rendering and control flow; copied dynamic fields use existing bounded record/truncation contract. Source-only conversion; no compile/runtime validation claimed."
+        }
+      ]
+    },
+    {
+      "path": "src/init.cpp",
+      "rules": [
+        {
+          "id": "chainstate_load_exception",
+          "old": "LogPrintf(\"%s\\n\", e.what())",
+          "replacement": "LogInfoEvent(BCLog::ALL, \"chainstate_load_exception\", \"{error}\").Field(BCLog::LogField::Error, e.what())",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogPrintf",
+            "format": "%s\n",
+            "specifiers": [
+              "%s"
+            ],
+            "arguments": [
+              "e.what()"
+            ]
+          },
+          "review_note": "Keep severity/category, original rendering and control flow; copied dynamic fields use existing bounded record/truncation contract. Source-only conversion; no compile/runtime validation claimed."
+        }
+      ]
+    },
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "old": "    X(ValidityMs, validity_ms, FLOAT, \"\", \"\")",
+          "new": "    X(ValidityMs, validity_ms, FLOAT, \"\", \"\") \\\n    X(InvalidChainSuffix, invalid_chain_suffix, STRING, \"\", \"\") \\\n    X(ParkedChainSuffix, parked_chain_suffix, STRING, \"\", \"\") \\\n    X(MissingDataSuffix, missing_data_suffix, STRING, \"\", \"\") \\\n    X(InvalidChain, invalid_chain, BOOL, \"\", \"\") \\\n    X(ParkedChain, parked_chain, BOOL, \"\", \"\") \\\n    X(MissingBlockData, missing_block_data, BOOL, \"\", \"\")",
+          "count": 1
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/init.cpp b/src/init.cpp
index 81c07120a8d5cf916f679c3fc2a5d4d78690f399..bbdac9c6d56c49fe17c2e177eb13da3c4f9bb965 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -3198,7 +3198,8 @@ bool AppInitMain(Config &config, RPCServer &rpcServer,
             try {
                 return f();
             } catch (const std::exception &e) {
-                LogPrintf("%s\n", e.what());
+                LogInfoEvent(BCLog::ALL, "chainstate_load_exception", "{error}")
+                    .Field(BCLog::LogField::Error, e.what());
                 return std::make_tuple(node::ChainstateLoadStatus::FAILURE,
                                        _("Error opening block database"));
             }
