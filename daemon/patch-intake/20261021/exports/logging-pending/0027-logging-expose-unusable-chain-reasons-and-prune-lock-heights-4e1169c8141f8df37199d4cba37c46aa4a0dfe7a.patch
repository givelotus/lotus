+                .Field(BCLog::LogField::PruneHeight, max_height_first);
         }
     }
 
@@ -6185,12 +6189,22 @@ CBlockIndex *Chainstate::FindMostWorkChain(
                 m_chainman.m_best_parked = pindexNew;
             }
 
-            LogPrintf("Considered switching to better tip %s but that chain "
