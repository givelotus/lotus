diff --git a/test/functional/interface_wallet_pwa.py b/test/functional/interface_wallet_pwa.py
index ba6e554ac9a1d31d3f6f31a03060818927c8adab..cb7a2d56521788f4099e143f40ab48157a95a665 100755
--- a/test/functional/interface_wallet_pwa.py
+++ b/test/functional/interface_wallet_pwa.py
@@ -155,6 +155,42 @@ class WalletPwaTest(BitcoinTestFramework):
         self.test_disabled_and_gui_errors()
         self.test_gui()
         self.test_embedded_bundle()
+        self.test_audit_privacy()
+
+    def test_audit_privacy(self):
+        self.log.info(
+            "PWA authentication audit logs omit credentials and session secrets"
+        )
+        self.stop_node(0)
+        offset = len(self.nodes[0].debug_log_path.read_text())
+        self.start_node(0, self.base_args + ["-logformat=json"])
+        password_canary = "owned-pwa-password-log-canary"
+        self.login(
+            {"user": "owned-invalid-user", "password": password_canary}, expect=401
+        )
+        _, _, token = self.mint_url()
+        session = self.login({"token": token})
+        headers = self.session_headers(session)
+        assert_equal(
+            self.request(
+                "POST",
+                "/auth/logout",
+                "{}",
+                {**headers, "Origin": "http://evil.example"},
+            )[0],
+            403,
+        )
+        assert_equal(self.request("POST", "/auth/logout", "{}", headers)[0], 204)
+        assert_equal(self.rpc(session, "getblockcount")[0], 401)
+        self.stop_node(0)  # Flush the asynchronous logger before examining JSON.
+        contents = self.nodes[0].debug_log_path.read_text()[offset:]
+        for secret in (
+            password_canary,
+            token,
+            session["csrf"],
+            session["cookie"].split("=", 1)[1],
+        ):
+            assert secret not in contents
 
     def test_static_files(self):
         self.log.info("GET /wallet redirects to /wallet/")
