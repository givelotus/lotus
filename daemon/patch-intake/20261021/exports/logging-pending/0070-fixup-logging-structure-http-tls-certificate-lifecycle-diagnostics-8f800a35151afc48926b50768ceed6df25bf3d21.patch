 test/functional/feature_logging_http_tls.py | 43 +--------------------
 1 file changed, 1 insertion(+), 42 deletions(-)

diff --git a/test/functional/feature_logging_http_tls.py b/test/functional/feature_logging_http_tls.py
index 50660251fd872b25599ceffcffbfd7cd781899b4..8d8c1d45d12c97c50ba190fe43f966d683181f0d 100644
