+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""A real enabled Chronik host serves its tip before a typed clean shutdown."""
+
+import json
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+
+class ChronikShutdownLoggingTest(BitcoinTestFramework):
+    num_nodes = 1
+    setup_clean_chain = True
+    wallet_names = []
+    requires = {"chronik"}
+    extra_args = [["-chronik", "-logformat=json"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        assert_equal(node.getblockcount(), 0)
+        indexed = node.get_chronik_client().blockchain_info().ok()
+        assert_equal(indexed.tip_height, 0)
+        assert_equal(indexed.tip_hash, bytes.fromhex(node.getbestblockhash())[::-1])
+        self.stop_node(0)
+        by_event = {}
+        for line in node.debug_log_path.read_text().splitlines():
+            if line.strip():
+                row = json.loads(line)
+                by_event.setdefault(row.get("event"), []).append(row)
+        rows = by_event["chronik_stopping"]
+        assert_equal(len(rows), 1)
+        assert_equal(rows[0]["message"], "Stopping Chronik...")
+        assert_equal(rows[0]["level"], "info")
+        assert "fields_truncated" not in rows[0]
+        for event in (
+            "chronik_worker_failed",
+            "chronik_stopping_failed",
+            "chronik_mempool_spent_coins_missing",
+            "chronik_invalidated_spent_coins_missing",
+        ):
+            assert event not in by_event
+
+
+if __name__ == "__main__":
+    ChronikShutdownLoggingTest().main()
