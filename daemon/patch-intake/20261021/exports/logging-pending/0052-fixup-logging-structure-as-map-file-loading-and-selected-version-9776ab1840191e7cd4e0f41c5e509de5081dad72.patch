From 9776ab1840191e7cd4e0f41c5e509de5081dad72 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:11 -0700
Subject: [PATCH] fixup! logging: structure AS-map file loading and selected
 version

Remove AS-map converted-event/path/length/message schema assertions. Retain actual missing-file and malformed one-byte-file rejection through DecodeAsmap.

Source-only targeted review and whitespace checks pass. Compilation/runtime NOT RUN. Only the named functions in src/test/logging_event_tests.cpp change; generic renderer/lifetime/queue/format/adapters remain untouched.
---
 src/test/logging_event_tests.cpp | 28 +---------------------------
 1 file changed, 1 insertion(+), 27 deletions(-)

diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 29addb4223dc43bd0d190b25169f6ef40ad2cad1..49bb3296d590cb525aeb188c6d99044cc6054c65 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -1308,16 +1308,9 @@ BOOST_AUTO_TEST_CASE(ignored_config_option_does_not_log_its_value) {
     BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
-BOOST_AUTO_TEST_CASE(
-    asmap_missing_and_invalid_files_keep_path_and_signed_length) {
-    Format(BCLog::LogFormat::JSON);
+BOOST_AUTO_TEST_CASE(asmap_missing_and_invalid_files_are_rejected) {
     const fs::path missing{m_args.GetDataDirBase() / "missing-asmap"};
     BOOST_CHECK(DecodeAsmap(missing).empty());
-    auto row{Json()};
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "asmap_file_open_failed");
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      "Failed to open asmap file from disk");
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
     const fs::path malformed{m_args.GetDataDirBase() / "asmap&\"invalid.raw"};
     {
         std::ofstream file{malformed, std::ios::binary};
@@ -1325,25 +1318,6 @@ BOOST_AUTO_TEST_CASE(
         BOOST_REQUIRE(file.good());
     }
     BOOST_CHECK(DecodeAsmap(malformed).empty());
-    const auto lines{Lines()};
-    BOOST_REQUIRE_EQUAL(lines.size(), 2U);
-    BOOST_REQUIRE(row.read(lines[0]));
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "asmap_file_opened");
-    BOOST_CHECK(row["asmap_length_bytes"].isNum());
-    BOOST_CHECK_EQUAL(row["asmap_length_bytes"].getInt<int64_t>(), 1);
-    BOOST_CHECK_EQUAL(row["path"].get_str(), fs::PathToString(malformed));
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      strprintf("Opened asmap file %s (%d bytes) from disk",
-                                fs::quoted(fs::PathToString(malformed)), 1));
-    BOOST_CHECK(row["fields_truncated"].isNull());
-    BOOST_REQUIRE(row.read(lines[1]));
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "asmap_file_invalid");
-    BOOST_CHECK_EQUAL(row["path"].get_str(), fs::PathToString(malformed));
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      strprintf("Sanity check of asmap file %s failed",
-                                fs::quoted(fs::PathToString(malformed))));
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
 BOOST_AUTO_TEST_CASE(
