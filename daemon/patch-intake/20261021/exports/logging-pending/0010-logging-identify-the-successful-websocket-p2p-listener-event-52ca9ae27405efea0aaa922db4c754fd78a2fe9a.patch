+++ b/src/httpserver.cpp
@@ -2463,7 +2463,9 @@ bool AddP2PListener(const CService &addr, bilingual_str &error) {
     asio::co_spawn(listener.acceptor->get_executor(),
                    AcceptLoop(*listener.acceptor, listener.public_only),
                    asio::detached);
-    LogPrintf("Listening for P2P (WebSocket) on %s\n", addr.ToStringAddrPort());
