From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:53:52 -0700
Subject: [PATCH] fixup! logging: structure cache allocation, pressure and
 resize diagnostics

Remove the standalone producer-conversion fixture: its substantive assertions only checked the migrated event name, field spelling/types and reconstructed message. The lasting generic structured renderer, lifetime, format, filtering and shutdown tests remain. No production change.

Source-only removal; no native/runtime validation claimed.
---
 .../feature_logging_runtime_caches.py         | 49 -------------------
 1 file changed, 49 deletions(-)
 delete mode 100644 test/functional/feature_logging_runtime_caches.py

diff --git a/test/functional/feature_logging_runtime_caches.py b/test/functional/feature_logging_runtime_caches.py
deleted file mode 100644
index 71cce3339da04b5980e3d85225ba56a8a3ebe80f..0000000000000000000000000000000000000000
--- a/test/functional/feature_logging_runtime_caches.py
+++ /dev/null
@@ -1,49 +0,0 @@
-#!/usr/bin/env python3
-# Copyright (c) 2026 The Lotus developers
-# Distributed under the MIT software license, see the accompanying
-# file COPYING or http://www.opensource.org/licenses/mit-license.php.
-"""Actual early startup cache budgets remain typed unsigned MiB/capacities."""
-
-import json
-
-from test_framework.test_framework import BitcoinTestFramework
-from test_framework.util import assert_equal
-
-
-class RuntimeCacheLoggingTest(BitcoinTestFramework):
-    num_nodes = 1
-    setup_clean_chain = True
-    wallet_names = []
-    extra_args = [["-logformat=json", "-maxsigcachesize=2", "-maxscriptcachesize=2"]]
-
-    def run_test(self):
-        node = self.nodes[0]
-        assert_equal(node.getblockcount(), 0)
-        self.stop_node(0)
-        rows = [
-            json.loads(line)
-            for line in node.debug_log_path.read_text().splitlines()
-            if line.strip()
-        ]
-        by_event = {row.get("event"): row for row in rows}
-        for event, kind in (
-            ("signature_cache_initialized", "signature"),
-            ("script_execution_cache_initialized", "script execution"),
-        ):
-            row = by_event[event]
-            assert_equal(row["cache_requested_mib"], 2)
-            assert isinstance(row["cache_requested_mib"], int)
-            allocated = row["cache_allocated_mib"]
-            capacity = row["cache_capacity"]
-            assert isinstance(allocated, int) and 0 <= allocated <= 2
-            assert isinstance(capacity, int) and capacity > 0
-            assert_equal(
-                row["message"],
-                f"Using {allocated} MiB out of 2 MiB requested for {kind} cache, able to store {capacity} elements",
-            )
-            assert_equal(row["level"], "info")
-            assert "fields_truncated" not in row
-
-
-if __name__ == "__main__":
-    RuntimeCacheLoggingTest().main()
