@@ -186,6 +187,63 @@ struct WebSocketTestingSetup : BasicTestingSetup {
 
 BOOST_FIXTURE_TEST_SUITE(net_websocket_tests, WebSocketTestingSetup)
 
+BOOST_AUTO_TEST_CASE(logging_invalid_public_pin_preserves_installed_dialer) {
+    unsigned calls{0};
+    struct RestoreDialer {
+        WebSocketDialer previous{GetWebSocketDialer()};
+        ~RestoreDialer() { SetWebSocketDialer(std::move(previous)); }
+    } restore_dialer;
+    SetWebSocketDialer(
+        [&](std::unique_ptr<Sock> &&, const ParsedWebSocketURL &,
+            CThreadInterrupt &) -> std::optional<WebSocketDialResult> {
+            ++calls;
+            return std::nullopt;
+        });
+    const std::string argument{"owned.invalid=!"};
+    std::string rendered;
+    {
+        LogInstance().Flush();
+        struct RestoreFormat {
+            BCLog::LogFormat previous{LogInstance().m_log_format};
+            ~RestoreFormat() {
+                LogInstance().Flush();
+                LogInstance().m_log_format = previous;
+            }
+        } restore;
+        LogInstance().m_log_format = BCLog::LogFormat::JSON;
+        DebugLogHelper capture("websocket_public_pin_argument_invalid",
+                               [&](const std::string *line) {
+                                   if (line) rendered = *line;
+                                   return false;
+                               });
+        // Malformed pins are rejected before TLS context creation or offer
+        // selection; the empty offer introduces no native protocol dependency.
+        BOOST_CHECK(!StartP2PWebSocketDialer(std::nullopt, std::nullopt, "",
+                                             {argument}));
+    }
+    BOOST_CHECK_EQUAL(calls, 0U);
+    auto dialer = GetWebSocketDialer();
+    BOOST_REQUIRE(dialer);
+    CThreadInterrupt interrupt;
+    BOOST_CHECK(!dialer(std::make_unique<Sock>(INVALID_SOCKET),
+                        ParsedWebSocketURL{}, interrupt));
+    BOOST_CHECK_EQUAL(calls, 1U);
+
+    UniValue row;
+    BOOST_REQUIRE(row.read(rendered));
+    BOOST_CHECK_EQUAL(row["event"].get_str(),
+                      "websocket_public_pin_argument_invalid");
+    BOOST_CHECK_EQUAL(row["config_option"].get_str(), "-p2pwebsocketpin");
+    BOOST_CHECK_EQUAL(row["public_pin_argument"].get_str(), argument);
+    BOOST_CHECK_EQUAL(
+        row["message"].get_str(),
+        strprintf(
+            "Error: invalid -p2pwebsocketpin=%s (expected <host>=<base64url SHA-256 of the public key>)",
+            argument));
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+}
