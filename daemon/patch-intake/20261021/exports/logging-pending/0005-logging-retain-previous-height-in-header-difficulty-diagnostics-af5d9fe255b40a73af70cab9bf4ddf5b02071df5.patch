 BOOST_FIXTURE_TEST_SUITE(validation_tests, TestingSetup)
 
+BOOST_AUTO_TEST_CASE(logging_bad_difficulty_retains_previous_height) {
+    ChainstateManager &chainman = *Assert(m_node.chainman);
+    const CBlockIndex *previous =
+        WITH_LOCK(cs_main, return Assert(chainman.ActiveTip()));
+    CBlockHeader header = chainman.GetParams().GenesisBlock().GetBlockHeader();
+    header.hashPrevBlock = previous->GetBlockHash();
+    // This remains a canonical positive regtest target, but it differs from
+    // the previous target. Difficulty is checked before timestamp/height.
+    header.nBits = previous->nBits ^ 1U;
+    bool solved = false;
+    for (unsigned attempt = 0; attempt < 1024; ++attempt) {
+        if (CheckProofOfWork(header.GetHash(), header.nBits,
+                             chainman.GetConsensus())) {
+            solved = true;
+            break;
+        }
+        ++header.nNonce;
+    }
+    BOOST_REQUIRE(solved);
+    BlockValidationState state;
+    std::string rendered;
+    {
+        LogInstance().Flush();
+        struct RestoreFormat {
+            BCLog::LogFormat previous{LogInstance().m_log_format};
+            ~RestoreFormat() {
+                LogInstance().Flush();
+                LogInstance().m_log_format = previous;
+            }
+        } restore;
+        LogInstance().m_log_format = BCLog::LogFormat::JSON;
+        DebugLogHelper capture("block_header_difficulty_mismatch",
+                               [&](const std::string *line) {
+                                   if (line) rendered = *line;
+                                   return false;
+                               });
+        BOOST_CHECK(!chainman.ProcessNewBlockHeaders({header}, true, state));
+    }
+    BOOST_CHECK_EQUAL(state.GetRejectReason(), "bad-diffbits");
+    BOOST_CHECK(state.GetResult() ==
+                BlockValidationResult::BLOCK_INVALID_HEADER);
+    BOOST_CHECK(WITH_LOCK(cs_main, return chainman.ActiveTip()) == previous);
+    UniValue row;
+    BOOST_REQUIRE(row.read(rendered));
+    BOOST_CHECK_EQUAL(row["event"].get_str(),
+                      "block_header_difficulty_mismatch");
+    BOOST_REQUIRE(row["height"].isNum());
+    BOOST_CHECK_EQUAL(row["height"].getInt<int64_t>(), previous->nHeight);
+    BOOST_CHECK_EQUAL(
+        row["message"].get_str(),
+        strprintf("bad bits after height: %d", previous->nHeight));
+    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
+    BOOST_CHECK(row["fields_truncated"].isNull());
+}
