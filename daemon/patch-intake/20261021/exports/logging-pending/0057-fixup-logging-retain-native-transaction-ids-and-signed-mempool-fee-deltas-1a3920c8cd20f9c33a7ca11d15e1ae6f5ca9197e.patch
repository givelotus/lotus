From 1a3920c8cd20f9c33a7ca11d15e1ae6f5ca9197e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:55:44 -0700
Subject: [PATCH] fixup! logging: retain native transaction IDs and signed
 mempool fee deltas

Remove pure mempool-priority producer conversion fixture. It prioritizes a deliberately absent transaction solely to assert txid, fee delta and message fields; it never exercises a real transaction selection or fee policy change. Preserve production producers and existing mempool/miner behavior coverage.
---
 .../feature_logging_mempool_priority.py       | 53 -------------------
 1 file changed, 53 deletions(-)
 delete mode 100644 test/functional/feature_logging_mempool_priority.py

diff --git a/test/functional/feature_logging_mempool_priority.py b/test/functional/feature_logging_mempool_priority.py
deleted file mode 100644
index 1a23dc0abf3bfdf6f00352d21b086b649558161f..0000000000000000000000000000000000000000
--- a/test/functional/feature_logging_mempool_priority.py
+++ /dev/null
@@ -1,53 +0,0 @@
-#!/usr/bin/env python3
-# Copyright (c) 2026 The Lotus developers
-# Distributed under the MIT software license, see the accompanying
-# file COPYING or http://www.opensource.org/licenses/mit-license.php.
-"""Real priority RPCs preserve native transaction IDs and signed fee increments."""
-
-import json
-
-from test_framework.test_framework import BitcoinTestFramework
-from test_framework.util import assert_equal
-
-
-class MempoolPriorityLoggingTest(BitcoinTestFramework):
-    num_nodes = 1
-    setup_clean_chain = True
-    wallet_names = []
-    extra_args = [["-logformat=json"]]
-
-    def run_test(self):
-        node = self.nodes[0]
-        txid = "56" * 32
-        for delta in (125, -250):
-            assert_equal(node.prioritisetransaction(txid, 0, delta), True)
-        assert_equal(node.getmempoolinfo()["size"], 0)
-        assert_equal(node.getblockcount(), 0)
-        self.stop_node(0)
-        rows = [
-            json.loads(line)
-            for line in node.debug_log_path.read_text().splitlines()
-            if line.strip()
-        ]
-        events = [
-            row
-            for row in rows
-            if row.get("event") == "mempool_transaction_priority_changed"
-        ]
-        assert_equal(len(events), 2)
-        for row, delta in zip(events, (125, -250), strict=True):
-            assert_equal(row["txid"], txid)
-            assert type(row["amount_sats"]) is int
-            assert_equal(row["amount_sats"], delta)
-            assert isinstance(row["fee_delta"], str) and row["fee_delta"]
-            assert_equal(row["fee_delta"].startswith("-"), delta < 0)
-            assert_equal(
-                row["message"],
-                f"PrioritiseTransaction: {txid} fee += {row['fee_delta']}",
-            )
-            assert_equal(row["level"], "info")
-            assert "fields_truncated" not in row
-
-
-if __name__ == "__main__":
-    MempoolPriorityLoggingTest().main()
