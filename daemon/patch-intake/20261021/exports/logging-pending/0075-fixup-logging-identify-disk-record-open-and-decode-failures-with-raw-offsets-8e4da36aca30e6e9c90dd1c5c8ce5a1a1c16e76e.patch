From 8e4da36aca30e6e9c90dd1c5c8ce5a1a1c16e76e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:50 -0700
Subject: [PATCH] fixup! logging: identify disk-record open and decode failures
 with raw offsets

---
 src/test/blockmanager_tests.cpp | 95 ++++-----------------------------
 1 file changed, 9 insertions(+), 86 deletions(-)

diff --git a/src/test/blockmanager_tests.cpp b/src/test/blockmanager_tests.cpp
index 09d0e3406efcd64ea36f0a92aa7a4af17f302cb6..c970346cf298a0ca0116f08671b81f222563b780 100644
--- a/src/test/blockmanager_tests.cpp
+++ b/src/test/blockmanager_tests.cpp
@@ -31,7 +31,7 @@ using node::MAX_BLOCKFILE_SIZE;
 // cleanup
 BOOST_FIXTURE_TEST_SUITE(blockmanager_tests, BasicTestingSetup)
 
-BOOST_FIXTURE_TEST_CASE(logging_disk_record_failures_preserve_positions,
+BOOST_FIXTURE_TEST_CASE(disk_record_failure_preserves_reader_results,
                         RegTestingSetup) {
     ChainstateManager &chainman = *Assert(m_node.chainman);
     KernelNotifications notifications{m_node.exit_status};
@@ -41,79 +41,22 @@ BOOST_FIXTURE_TEST_CASE(logging_disk_record_failures_preserve_positions,
         .notifications = notifications,
     };
     BlockManager manager{m_node.kernel->interrupt, options};
-    const auto capture = [&](const char *event, const char *function,
-                             const FlatFilePos &position, auto &&action) {
-        std::string rendered;
-        {
-            LogInstance().Flush();
-            struct RestoreFormat {
-                BCLog::LogFormat previous{LogInstance().m_log_format};
-                ~RestoreFormat() {
-                    LogInstance().Flush();
-                    LogInstance().m_log_format = previous;
-                }
-            } restore;
-            LogInstance().m_log_format = BCLog::LogFormat::JSON;
-            DebugLogHelper helper(event, [&](const std::string *line) {
-                if (line) rendered = *line;
-                return false;
-            });
-            action();
-        }
-        UniValue row;
-        BOOST_REQUIRE(row.read(rendered));
-        BOOST_CHECK_EQUAL(row["event"].get_str(), event);
-        BOOST_CHECK_EQUAL(row["source_function"].get_str(), function);
-        BOOST_CHECK_EQUAL(row["flat_file_position"].get_str(),
-                          position.ToString());
-        BOOST_REQUIRE(row["file_number"].isNum());
-        BOOST_CHECK_EQUAL(row["file_number"].getInt<int64_t>(), position.nFile);
-        BOOST_REQUIRE(row["file_offset"].isNum());
-        BOOST_CHECK_EQUAL(row["file_offset"].getInt<uint64_t>(), position.nPos);
-        BOOST_CHECK_EQUAL(row["level"].get_str(), "error");
-        BOOST_CHECK(row["fields_truncated"].isNull());
-        return row;
-    };
-    const auto check_decode_message = [](const UniValue &row,
-                                         const char *function,
-                                         const FlatFilePos &position) {
-        BOOST_REQUIRE(!row["error"].get_str().empty());
-        BOOST_CHECK_EQUAL(row["message"].get_str(),
-                          strprintf("%s: Deserialize or I/O error - %s at %s",
-                                    function, row["error"].get_str(),
-                                    position.ToString()));
-    };
     const std::vector<uint8_t> untouched{0x55};
     auto bytes = untouched;
     const FlatFilePos underflow{42, 7};
-    auto row = capture("block_raw_open_failed", "ReadRawBlock", underflow, [&] {
-        BOOST_CHECK(!manager.ReadRawBlock(bytes, underflow));
-    });
+    BOOST_CHECK(!manager.ReadRawBlock(bytes, underflow));
     BOOST_CHECK(bytes == untouched);
     BOOST_CHECK(!fs::exists(manager.BlockFileSeq().FileName(underflow)));
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      strprintf("ReadRawBlock: OpenBlockFile failed for %s",
-                                underflow.ToString()));
 
     const FlatFilePos position{42, 8};
-    row = capture("block_raw_open_failed", "ReadRawBlock", position,
-                  [&] { BOOST_CHECK(!manager.ReadRawBlock(bytes, position)); });
+    BOOST_CHECK(!manager.ReadRawBlock(bytes, position));
     BOOST_CHECK(bytes == untouched);
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      strprintf("ReadRawBlock: OpenBlockFile failed for %s",
-                                position.ToString()));
     {
         AutoFile file{manager.OpenBlockFile(FlatFilePos{42, 0})};
         BOOST_REQUIRE(!file.IsNull());
     }
-    row = capture("block_raw_read_failed", "ReadRawBlock", position,
-                  [&] { BOOST_CHECK(!manager.ReadRawBlock(bytes, position)); });
+    BOOST_CHECK(!manager.ReadRawBlock(bytes, position));
     BOOST_CHECK(bytes == untouched);
-    BOOST_REQUIRE(!row["error"].get_str().empty());
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf("ReadRawBlock: Read from block file failed: %s for %s",
-                  row["error"].get_str(), position.ToString()));
 
     // A valid raw envelope with one byte of payload is accepted by the raw
     // reader, then rejected by either block-header decoder. All allocations
@@ -126,45 +69,25 @@ BOOST_FIXTURE_TEST_CASE(logging_disk_record_failures_preserve_positions,
     BOOST_REQUIRE(manager.ReadRawBlock(bytes, position));
     BOOST_CHECK(bytes == std::vector<uint8_t>{0});
     CBlock block;
-    row = capture("disk_record_decode_failed", "ReadBlock", position,
-                  [&] { BOOST_CHECK(!manager.ReadBlock(block, position)); });
-    check_decode_message(row, "ReadBlock", position);
+    BOOST_CHECK(!manager.ReadBlock(block, position));
 
     const FlatFilePos tx_position{43, 0};
     CMutableTransaction tx;
-    row =
-        capture("transaction_disk_open_failed", "ReadTxFromDisk", tx_position,
-                [&] { BOOST_CHECK(!manager.ReadTxFromDisk(tx, tx_position)); });
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      strprintf("ReadTxFromDisk: OpenBlockFile failed for %s",
-                                tx_position.ToString()));
+    BOOST_CHECK(!manager.ReadTxFromDisk(tx, tx_position));
     {
         AutoFile file{manager.OpenBlockFile(tx_position)};
         BOOST_REQUIRE(!file.IsNull());
     }
-    row =
-        capture("disk_record_decode_failed", "ReadTxFromDisk", tx_position,
-                [&] { BOOST_CHECK(!manager.ReadTxFromDisk(tx, tx_position)); });
-    check_decode_message(row, "ReadTxFromDisk", tx_position);
+    BOOST_CHECK(!manager.ReadTxFromDisk(tx, tx_position));
 
     const FlatFilePos undo_position{44, 0};
     CTxUndo undo;
-    row = capture(
-        "transaction_undo_disk_open_failed", "ReadTxUndoFromDisk",
-        undo_position,
-        [&] { BOOST_CHECK(!manager.ReadTxUndoFromDisk(undo, undo_position)); });
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf("ReadTxUndoFromDisk: OpenUndoFile failed for %s",
-                  undo_position.ToString()));
+    BOOST_CHECK(!manager.ReadTxUndoFromDisk(undo, undo_position));
     {
         AutoFile file{manager.OpenUndoFile(undo_position)};
         BOOST_REQUIRE(!file.IsNull());
     }
-    row = capture(
-        "disk_record_decode_failed", "ReadTxUndoFromDisk", undo_position,
-        [&] { BOOST_CHECK(!manager.ReadTxUndoFromDisk(undo, undo_position)); });
-    check_decode_message(row, "ReadTxUndoFromDisk", undo_position);
+    BOOST_CHECK(!manager.ReadTxUndoFromDisk(undo, undo_position));
 }
 
 BOOST_FIXTURE_TEST_CASE(
