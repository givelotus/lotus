 from test_framework.util import assert_equal, assert_raises_rpc_error
@@ -55,37 +53,6 @@ class SnapshotStateLoggingTest(BitcoinTestFramework):
         assert_equal(node.getbestblockhash(), genesis)
         assert not staging.exists()
         self.stop_node(0)
