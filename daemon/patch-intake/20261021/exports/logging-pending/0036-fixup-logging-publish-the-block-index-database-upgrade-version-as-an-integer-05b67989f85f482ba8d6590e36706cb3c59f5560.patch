From 05b67989f85f482ba8d6590e36706cb3c59f5560 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:53:53 -0700
Subject: [PATCH] fixup! logging: publish the block-index database upgrade
 version as an integer

Remove the standalone producer-conversion fixture: its substantive assertions only checked the migrated event name, field spelling/types and reconstructed message. The lasting generic structured renderer, lifetime, format, filtering and shutdown tests remain. No production change.

Source-only removal; no native/runtime validation claimed.
---
 .../feature_logging_block_database_version.py | 43 -------------------
 1 file changed, 43 deletions(-)
 delete mode 100644 test/functional/feature_logging_block_database_version.py

diff --git a/test/functional/feature_logging_block_database_version.py b/test/functional/feature_logging_block_database_version.py
deleted file mode 100644
index deb5fc4ac0b553dd0546d7c99182c930f4696ae6..0000000000000000000000000000000000000000
--- a/test/functional/feature_logging_block_database_version.py
+++ /dev/null
@@ -1,43 +0,0 @@
-#!/usr/bin/env python3
-# Copyright (c) 2026 The Lotus developers
-# Distributed under the MIT software license, see the accompanying
-# file COPYING or http://www.opensource.org/licenses/mit-license.php.
-"""Real first-start block DB upgrade event agrees with the node's version."""
-
-import json
-
-from test_framework.test_framework import BitcoinTestFramework
-from test_framework.util import assert_equal
-
-
-class BlockDatabaseVersionLoggingTest(BitcoinTestFramework):
-    num_nodes = 1
-    setup_clean_chain = True
-    wallet_names = []
-    extra_args = [["-logformat=json"]]
-
-    def run_test(self):
-        node = self.nodes[0]
-        assert_equal(node.getblockcount(), 0)
-        version = node.getnetworkinfo()["version"]
-        self.stop_node(0)
-        rows = [
-            json.loads(line)
-            for line in node.debug_log_path.read_text().splitlines()
-            if line.strip()
-        ]
-        event = {row.get("event"): row for row in rows}[
-            "block_index_database_upgrading"
-        ]
-        assert_equal(event["version"], version)
-        assert type(event["version"]) is int
-        assert_equal(
-            event["message"],
-            f"Updating the block index database version to {version}",
-        )
-        assert_equal(event["level"], "info")
-        assert "fields_truncated" not in event
-
-
-if __name__ == "__main__":
-    BlockDatabaseVersionLoggingTest().main()
