From d448f7ec6dcc207a733d520d25b9ebc4723c818a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:11 -0700
Subject: [PATCH] fixup! logging: structure flat-file open and seek failures

Remove flat-file converted-event/path/offset/message schema assertions. Retain read-only missing-file null return without creating a directory and real FIFO seek failure returning null; keep owned FIFO descriptor RAII.

Source-only targeted review and whitespace checks pass. Compilation/runtime NOT RUN. Only the named functions in src/test/logging_event_tests.cpp change; generic renderer/lifetime/queue/format/adapters remain untouched.
---
 src/test/logging_event_tests.cpp | 24 ++----------------------
 1 file changed, 2 insertions(+), 22 deletions(-)

diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index 49bb3296d590cb525aeb188c6d99044cc6054c65..8db3b8e6b7404914baca30df055f47b2a6bf04a7 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -1320,27 +1320,17 @@ BOOST_AUTO_TEST_CASE(asmap_missing_and_invalid_files_are_rejected) {
     BOOST_CHECK(DecodeAsmap(malformed).empty());
 }
 
-BOOST_AUTO_TEST_CASE(
-    flatfile_open_failure_preserves_plain_path_and_null_result) {
-    Format(BCLog::LogFormat::JSON);
+BOOST_AUTO_TEST_CASE(flatfile_read_only_missing_file_does_not_create_directory) {
     const fs::path directory{m_args.GetDataDirBase() / "absent-flat-files"};
     FlatFileSeq sequence{directory, "blk", 1024};
     const FlatFilePos missing{17, 0};
     BOOST_CHECK(sequence.Open(missing, /*read_only=*/true) == nullptr);
     BOOST_CHECK(!fs::exists(directory));
-    const auto row{Json()};
-    const auto path{fs::PathToString(sequence.FileName(missing))};
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "flatfile_open_failed");
-    BOOST_CHECK_EQUAL(row["path"].get_str(), path);
-    BOOST_CHECK_EQUAL(row["message"].get_str(), "Unable to open file " + path);
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
 #if defined(__linux__) || defined(MAC_OSX)
 BOOST_AUTO_TEST_CASE(
-    flatfile_fifo_seek_failure_keeps_unsigned_offset_and_null_result) {
-    Format(BCLog::LogFormat::JSON);
+    flatfile_fifo_seek_failure_returns_null) {
     const fs::path directory{m_args.GetDataDirBase() / "flatfile-fifo"};
     fs::create_directories(directory);
     FlatFileSeq sequence{directory, "blk", 1024};
@@ -1357,16 +1347,6 @@ BOOST_AUTO_TEST_CASE(
     } holder{open(path.c_str(), O_RDWR | O_NONBLOCK)};
     BOOST_REQUIRE(holder.value >= 0);
     BOOST_CHECK(sequence.Open(position, /*read_only=*/true) == nullptr);
-    const auto row{Json()};
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "flatfile_seek_failed");
-    BOOST_CHECK(row["file_offset"].isNum());
-    BOOST_CHECK_EQUAL(row["file_offset"].getInt<uint64_t>(), 1U);
-    BOOST_CHECK_EQUAL(row["path"].get_str(), fs::PathToString(path));
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      "Unable to seek to position 1 of " +
-                          fs::PathToString(path));
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["fields_truncated"].isNull());
 }
 #endif
 
