From 7d50cbc1783732c79e9151c79743263fb39dccb8 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:50 -0700
Subject: [PATCH] fixup! logging: identify block undo reader failures with
 typed positions

---
 src/test/blockmanager_tests.cpp | 66 ++++-----------------------------
 1 file changed, 8 insertions(+), 58 deletions(-)

diff --git a/src/test/blockmanager_tests.cpp b/src/test/blockmanager_tests.cpp
index c970346cf298a0ca0116f08671b81f222563b780..4fc6772fea1835b9876a6aaf12cc7380fa02a5c7 100644
--- a/src/test/blockmanager_tests.cpp
+++ b/src/test/blockmanager_tests.cpp
@@ -90,8 +90,8 @@ BOOST_FIXTURE_TEST_CASE(disk_record_failure_preserves_reader_results,
     BOOST_CHECK(!manager.ReadTxUndoFromDisk(undo, undo_position));
 }
 
-BOOST_FIXTURE_TEST_CASE(
-    logging_block_undo_failure_paths_preserve_reader_results, RegTestingSetup) {
+BOOST_FIXTURE_TEST_CASE(block_undo_failures_and_checksum_recovery,
+                        RegTestingSetup) {
     ChainstateManager &chainman = *Assert(m_node.chainman);
     KernelNotifications notifications{m_node.exit_status};
     const BlockManager::Options options{
@@ -100,71 +100,25 @@ BOOST_FIXTURE_TEST_CASE(
         .notifications = notifications,
     };
     BlockManager manager{m_node.kernel->interrupt, options};
-    const auto capture = [&](const char *event, auto &&action) {
-        std::string rendered;
-        {
-            LogInstance().Flush();
-            struct RestoreFormat {
-                BCLog::LogFormat previous{LogInstance().m_log_format};
-                ~RestoreFormat() {
-                    LogInstance().Flush();
-                    LogInstance().m_log_format = previous;
-                }
-            } restore;
-            LogInstance().m_log_format = BCLog::LogFormat::JSON;
-            DebugLogHelper helper(event, [&](const std::string *line) {
-                if (line) rendered = *line;
-                return false;
-            });
-            action();
-        }
-        UniValue row;
-        BOOST_REQUIRE(row.read(rendered));
-        BOOST_CHECK_EQUAL(row["event"].get_str(), event);
-        BOOST_CHECK_EQUAL(row["level"].get_str(), "error");
-        BOOST_CHECK(row["fields_truncated"].isNull());
-        return row;
-    };
     CBlockIndex index;
     CBlockUndo result;
-    auto row = capture("block_undo_unavailable", [&] {
-        BOOST_CHECK(!manager.ReadBlockUndo(result, index));
-    });
-    BOOST_CHECK_EQUAL(row["source_function"].get_str(), "ReadBlockUndo");
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      "ReadBlockUndo: no undo data available");
+    BOOST_CHECK(!manager.ReadBlockUndo(result, index));
 
     const FlatFilePos position{42, 0};
     index.nFile = position.nFile;
     index.nUndoPos = position.nPos;
     index.nStatus = index.nStatus.withUndo(true);
     index.pprev = WITH_LOCK(cs_main, return Assert(chainman.ActiveTip()));
-    row = capture("block_undo_open_failed",
-                  [&] { BOOST_CHECK(!manager.ReadBlockUndo(result, index)); });
-    BOOST_CHECK_EQUAL(row["flat_file_position"].get_str(), position.ToString());
-    BOOST_REQUIRE(row["file_number"].isNum());
-    BOOST_CHECK_EQUAL(row["file_number"].getInt<int64_t>(), position.nFile);
-    BOOST_REQUIRE(row["file_offset"].isNum());
-    BOOST_CHECK_EQUAL(row["file_offset"].getInt<uint64_t>(), position.nPos);
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf("OpenUndoFile failed for %s", position.ToString()));
+    BOOST_CHECK(!manager.ReadBlockUndo(result, index));
 
     // Empty owned record reaches the real deserialization exception path.
     {
         AutoFile file{manager.OpenUndoFile(position)};
         BOOST_REQUIRE(!file.IsNull());
     }
-    row = capture("block_undo_decode_failed",
-                  [&] { BOOST_CHECK(!manager.ReadBlockUndo(result, index)); });
-    BOOST_CHECK_EQUAL(row["source_function"].get_str(), "ReadBlockUndo");
-    BOOST_REQUIRE(!row["error"].get_str().empty());
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      strprintf("ReadBlockUndo: Deserialize or I/O error - %s",
-                                row["error"].get_str()));
-
-    // Write a synthetically empty undo record with a deliberately bad checksum,
-    // then correct only the checksum and confirm the same public reader works.
+    BOOST_CHECK(!manager.ReadBlockUndo(result, index));
+
+    // The same reader rejects a bad checksum and accepts a corrected one.
     const CBlockUndo undo;
     HashWriter writer;
     writer << index.pprev->GetBlockHash() << undo;
@@ -177,11 +131,7 @@ BOOST_FIXTURE_TEST_CASE(
         file << undo << hash;
     };
     write_record(wrong_checksum);
-    row = capture("block_undo_checksum_mismatch",
-                  [&] { BOOST_CHECK(!manager.ReadBlockUndo(result, index)); });
-    BOOST_CHECK_EQUAL(row["source_function"].get_str(), "ReadBlockUndo");
-    BOOST_CHECK_EQUAL(row["message"].get_str(),
-                      "ReadBlockUndo: Checksum mismatch");
+    BOOST_CHECK(!manager.ReadBlockUndo(result, index));
     write_record(checksum);
     BOOST_REQUIRE(manager.ReadBlockUndo(result, index));
     BOOST_CHECK(result.vtxundo.empty());
