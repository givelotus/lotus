From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:12 -0700
Subject: [PATCH] fixup! logging: structure wallet availability and startup
 parameter decisions

Remove converted-event/schema/message assertions from feature_logging_wallet_startup.py while retaining its existing real RPC, startup/restart and endpoint behavior checks. No producer changes or new tests; source-only cleanup.
---
 .../feature_logging_wallet_startup.py         | 28 +------------------
 1 file changed, 1 insertion(+), 27 deletions(-)

diff --git a/test/functional/feature_logging_wallet_startup.py b/test/functional/feature_logging_wallet_startup.py
index 89d8ce0fde2b863041799e4cb8d6842ef721174f..a51c762bf56b084b2a31eb155f0b7e7524d24b04 100644
--- a/test/functional/feature_logging_wallet_startup.py
+++ b/test/functional/feature_logging_wallet_startup.py
@@ -2,9 +2,7 @@
 # Copyright (c) 2026 The Lotus developers
 # Distributed under the MIT software license, see the accompanying
 # file COPYING or http://www.opensource.org/licenses/mit-license.php.
-"""Actual wallet disable/blocksonly startup keeps original parameter behavior."""
-
-import json
+"""Wallet disable/blocksonly startup preserves wallet and relay behavior."""
 
 from test_framework.test_framework import BitcoinTestFramework
 from test_framework.util import assert_equal
@@ -28,30 +26,6 @@ class WalletStartupLoggingTest(BitcoinTestFramework):
         assert_equal(node.listwallets(), [])
         assert_equal(node.getnetworkinfo()["localrelay"], False)
         self.stop_node(0)
-        rows = [
-            json.loads(line)
-            for line in node.debug_log_path.read_text().splitlines()
-            if line.strip()
-        ]
-        by_event = {row.get("event"): row for row in rows}
-        ignored = by_event["wallet_argument_ignored"]
-        assert_equal(ignored["source_function"], "ParameterInteraction")
-        assert_equal(ignored["wallet"], "ignored-wallet")
-        assert_equal(
-            ignored["message"],
-            "ParameterInteraction: parameter interaction: -disablewallet -> ignoring -wallet=ignored-wallet",
-        )
-        disabled = by_event["wallet_disabled"]
-        assert_equal(disabled["message"], "Wallet disabled!")
-        broadcast = by_event["wallet_broadcast_disabled_by_blocksonly"]
-        assert_equal(broadcast["source_function"], "ParameterInteraction")
-        assert_equal(
-            broadcast["message"],
-            "ParameterInteraction: parameter interaction: -blocksonly=1 -> setting -walletbroadcast=0",
-        )
-        for row in (ignored, disabled, broadcast):
-            assert_equal(row["level"], "info")
-            assert "fields_truncated" not in row
 
 
 if __name__ == "__main__":
