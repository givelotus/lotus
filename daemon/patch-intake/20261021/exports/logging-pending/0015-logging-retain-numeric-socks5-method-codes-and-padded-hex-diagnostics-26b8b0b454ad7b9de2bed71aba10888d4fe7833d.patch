 #include <test/util/setup_common.h>
 
 #include <boost/test/unit_test.hpp>
 
+#include <cstring>
 #include <string>
+#include <vector>
 
 using namespace std::literals;
 
 BOOST_FIXTURE_TEST_SUITE(netbase_tests, BasicTestingSetup)
 
+BOOST_AUTO_TEST_CASE(logging_socks5_wrong_method_keeps_numeric_code_and_hex) {
+    class WrongMethodSock final : public Sock {
+    public:
+        explicit WrongMethodSock(uint8_t method)
+            : Sock{INVALID_SOCKET}, m_method{method} {}
+        mutable unsigned sends{0}, receives{0};
+        ssize_t Send(const void *data, size_t size, int) const override {
+            ++sends;
+            const auto *bytes = static_cast<const uint8_t *>(data);
+            const std::vector<uint8_t> actual{bytes, bytes + size};
+            const std::vector<uint8_t> expected{0x05, 0x01, 0x00};
+            BOOST_CHECK(actual == expected);
+            return static_cast<ssize_t>(size);
+        }
+        ssize_t Recv(void *data, size_t size, int) const override {
+            ++receives;
+            BOOST_CHECK_EQUAL(size, 2U);
+            if (size < 2 || receives != 1) return 0;
+            const uint8_t response[2]{0x05, m_method};
+            std::memcpy(data, response, sizeof(response));
+            return sizeof(response);
+        }
+
+    private:
+        const uint8_t m_method;
+    };
+
+    for (const uint8_t method : {uint8_t{0x0a}, uint8_t{0xff}}) {
+        // Base Sock is INVALID_SOCKET: overridden byte I/O supplies only the
+        // method response. No socket is opened and no credentials are supplied.
+        WrongMethodSock socket{method};
+        std::string rendered;
+        {
+            LogInstance().Flush();
+            struct RestoreFormat {
+                BCLog::LogFormat previous{LogInstance().m_log_format};
+                ~RestoreFormat() {
+                    LogInstance().Flush();
+                    LogInstance().m_log_format = previous;
+                }
+            } restore;
+            LogInstance().m_log_format = BCLog::LogFormat::JSON;
+            DebugLogHelper capture("proxy_auth_method_unexpected",
+                                   [&](const std::string *line) {
+                                       if (line) rendered = *line;
+                                       return false;
+                                   });
+            BOOST_CHECK(!Socks5("owned.invalid", 1, nullptr, socket));
+        }
+        BOOST_CHECK_EQUAL(socket.sends, 1U);
+        BOOST_CHECK_EQUAL(socket.receives, 1U);
+        UniValue row;
+        BOOST_REQUIRE(row.read(rendered));
+        BOOST_CHECK_EQUAL(row["event"].get_str(),
+                          "proxy_auth_method_unexpected");
+        BOOST_REQUIRE(row["error_code"].isNum());
+        BOOST_CHECK_EQUAL(row["error_code"].getInt<int64_t>(), method);
+        BOOST_CHECK_EQUAL(
+            row["message"].get_str(),
+            strprintf("Proxy requested wrong authentication method %02x",
+                      method));
+        BOOST_CHECK_EQUAL(row["level"].get_str(), "error");
+        BOOST_CHECK(row["fields_truncated"].isNull());
+        BOOST_CHECK(row["username"].isNull());
+        BOOST_CHECK(row["password"].isNull());
+    }
+}
+
 static CNetAddr ResolveIP(const std::string &ip) {
     return LookupHost(ip, false).value_or(CNetAddr{});
 }
