+#!/usr/bin/env python3
+# Copyright (c) 2026 The Lotus developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""A disallowed WebSocket network reports its redacted URL without dialing."""
+
+import json
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, p2p_port
+
+
+class WebSocketReachabilityLoggingTest(BitcoinTestFramework):
+    num_nodes = 1
+    setup_clean_chain = True
+    wallet_names = []
+    extra_args = [["-logformat=json", "-onlynet=ipv4", "-listen=0", "-avalanche=0"]]
+
+    def run_test(self):
+        node = self.nodes[0]
+        assert_equal(node.getblockcount(), 0)
+        assert_equal(node.getconnectioncount(), 0)
+        # NET_WSS is excluded, so the valid URL is rejected before any dialer
+        # invocation. The assigned test port is never contacted; no external
+        # peer or production port is involved.
+        port = p2p_port(40)
+        canary = "owned-logging-token-canary"
+        url = f"ws://127.0.0.1:{port}/owned-logging-path?token={canary}"
+        redacted = f"ws://127.0.0.1:{port}/owned-logging-path?token=***"
+        node.addnode(url, "onetry")
+
+        def event_seen():
+            # Parse complete JSON only after stop/Flush below; a concurrent
+            # file read need not end on a complete line.
+            return (
+                "websocket_peer_network_unreachable" in node.debug_log_path.read_text()
+            )
+
+        self.wait_until(event_seen, timeout=5)
+        assert_equal(node.getconnectioncount(), 0)
+        assert_equal(node.getblockcount(), 0)
+        self.stop_node(0)
+        contents = node.debug_log_path.read_text()
+        assert canary not in contents
+        rows = [json.loads(line) for line in contents.splitlines() if line.strip()]
+        matches = [
+            row
+            for row in rows
+            if row.get("event") == "websocket_peer_network_unreachable"
+        ]
+        assert_equal(len(matches), 1)
+        row = matches[0]
+        assert_equal(row["addr"], redacted)
+        assert_equal(row["network"], "wss")
+        assert_equal(
+            row["message"],
+            f"Not connecting to {redacted}: network wss is not reachable (-onlynet)",
+        )
+        assert_equal(row["level"], "info")
+        assert "fields_truncated" not in row
+        assert "peer_address" not in row
+
+
+if __name__ == "__main__":
+    WebSocketReachabilityLoggingTest().main()
