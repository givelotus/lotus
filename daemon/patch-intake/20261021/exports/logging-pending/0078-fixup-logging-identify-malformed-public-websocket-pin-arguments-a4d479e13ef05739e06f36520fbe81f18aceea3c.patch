From a4d479e13ef05739e06f36520fbe81f18aceea3c Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:57:26 -0700
Subject: [PATCH] fixup! logging: identify malformed public WebSocket pin
 arguments

---
 src/test/net_websocket_tests.cpp | 40 ++++----------------------------
 1 file changed, 4 insertions(+), 36 deletions(-)

diff --git a/src/test/net_websocket_tests.cpp b/src/test/net_websocket_tests.cpp
index 537ad9f593d5cbd6aa26343a575a2c2175b65f4c..2551b5ff08a80775fd768d4dbae11e0e5c5ad855 100644
--- a/src/test/net_websocket_tests.cpp
+++ b/src/test/net_websocket_tests.cpp
@@ -187,7 +187,7 @@ struct WebSocketTestingSetup : BasicTestingSetup {
 
 BOOST_FIXTURE_TEST_SUITE(net_websocket_tests, WebSocketTestingSetup)
 
-BOOST_AUTO_TEST_CASE(logging_invalid_public_pin_preserves_installed_dialer) {
+BOOST_AUTO_TEST_CASE(invalid_public_pin_preserves_installed_dialer) {
     unsigned calls{0};
     struct RestoreDialer {
         WebSocketDialer previous{GetWebSocketDialer()};
@@ -200,27 +200,9 @@ BOOST_AUTO_TEST_CASE(logging_invalid_public_pin_preserves_installed_dialer) {
             return std::nullopt;
         });
     const std::string argument{"owned.invalid=!"};
-    std::string rendered;
-    {
-        LogInstance().Flush();
-        struct RestoreFormat {
-            BCLog::LogFormat previous{LogInstance().m_log_format};
-            ~RestoreFormat() {
-                LogInstance().Flush();
-                LogInstance().m_log_format = previous;
-            }
-        } restore;
-        LogInstance().m_log_format = BCLog::LogFormat::JSON;
-        DebugLogHelper capture("websocket_public_pin_argument_invalid",
-                               [&](const std::string *line) {
-                                   if (line) rendered = *line;
-                                   return false;
-                               });
-        // Malformed pins are rejected before TLS context creation or offer
-        // selection; the empty offer introduces no native protocol dependency.
-        BOOST_CHECK(!StartP2PWebSocketDialer(std::nullopt, std::nullopt, "",
-                                             {argument}));
-    }
+    // Malformed pins are rejected before TLS context creation or publication.
+    BOOST_CHECK(
+        !StartP2PWebSocketDialer(std::nullopt, std::nullopt, "", {argument}));
     BOOST_CHECK_EQUAL(calls, 0U);
     auto dialer = GetWebSocketDialer();
     BOOST_REQUIRE(dialer);
@@ -228,20 +210,6 @@ BOOST_AUTO_TEST_CASE(logging_invalid_public_pin_preserves_installed_dialer) {
     BOOST_CHECK(!dialer(std::make_unique<Sock>(INVALID_SOCKET),
                         ParsedWebSocketURL{}, interrupt));
     BOOST_CHECK_EQUAL(calls, 1U);
-
-    UniValue row;
-    BOOST_REQUIRE(row.read(rendered));
-    BOOST_CHECK_EQUAL(row["event"].get_str(),
-                      "websocket_public_pin_argument_invalid");
-    BOOST_CHECK_EQUAL(row["config_option"].get_str(), "-p2pwebsocketpin");
-    BOOST_CHECK_EQUAL(row["public_pin_argument"].get_str(), argument);
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf(
-            "Error: invalid -p2pwebsocketpin=%s (expected <host>=<base64url SHA-256 of the public key>)",
-            argument));
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
 BOOST_AUTO_TEST_CASE(logging_nonblocking_failure_retains_static_diagnostic) {
