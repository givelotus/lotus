From cd6ab27f321204797772769412cfb5a8adf9934a Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 17:01:04 -0700
Subject: [PATCH] logging: name unsigned header metadata separately from chain
 heights

Append generic registry keys for header version, claimed and actual block
size, limits, and expected/claimed height. Claimed wire metadata can be
UINT64_MAX and must not be narrowed to the existing signed Height key.
No renderer, field layout, serialization, hash or consensus changes.

Keep this metadata-only prerequisite in the shared tier: subsequent shared
append-only registry entries must not acquire a dependency on V2 producers.
The native producers and their focused negative tests belong after the
V2 consensus header owner in a separate commit. Native validation pending.
The immutable validated 381-site handoff remains unchanged.

Scripted diff:
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/header-diagnostic-fields.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-cleanup/header-fields395-conversion.json --apply

Source validation: git diff --check
---
 .../rules/header-diagnostic-fields.json       | 19 +++++++++++++++++++
 src/logging/fields.h                          |  9 ++++++++-
 2 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 contrib/logging/conversion/rules/header-diagnostic-fields.json

diff --git a/contrib/logging/conversion/rules/header-diagnostic-fields.json b/contrib/logging/conversion/rules/header-diagnostic-fields.json
new file mode 100644
index 0000000000000000000000000000000000000000..4022d9226e86dd92ded16cde5541ce8891ac822d
--- /dev/null
+++ b/contrib/logging/conversion/rules/header-diagnostic-fields.json
@@ -0,0 +1,19 @@
+{
+  "schema": 1,
+  "batch": "header-diagnostic-fields",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "shared_ecash_registry_prerequisite",
+  "files": [
+    {
+      "path": "src/logging/fields.h",
+      "rules": [],
+      "support_adjustments": [
+        {
+          "purpose": "Append generic typed header diagnostic keys without narrowing unsigned claimed metadata to signed chain-index height. No Lotus constants, header implementation or hash dependency. Define in shared registry so later shared append-only fields do not depend on V2 producer placement.",
+          "old": "    X(ProofId, proof_id, HASH, \"\", \"\")\n",
+          "new": "    X(ProofId, proof_id, HASH, \"\", \"\") \\\n    X(HeaderVersion, header_version, UINT, \"\", \"\") \\\n    X(ExpectedHeaderVersion, expected_header_version, UINT, \"\", \"\") \\\n    X(ClaimedBlockBytes, claimed_block_bytes, UINT, \"\", \"\") \\\n    X(ActualBlockBytes, actual_block_bytes, UINT, \"\", \"\") \\\n    X(BlockLimitBytes, block_limit_bytes, UINT, \"\", \"\") \\\n    X(ClaimedBlockHeight, claimed_block_height, UINT, \"\", \"\") \\\n    X(ExpectedBlockHeight, expected_block_height, INT, \"\", \"\")\n"
+        }
+      ]
+    }
+  ]
+}
