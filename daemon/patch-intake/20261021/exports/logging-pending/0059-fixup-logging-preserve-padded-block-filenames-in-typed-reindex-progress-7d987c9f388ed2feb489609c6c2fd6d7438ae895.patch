 .../feature_logging_block_file_reindex.py     | 27 +------------------
 1 file changed, 1 insertion(+), 26 deletions(-)

diff --git a/test/functional/feature_logging_block_file_reindex.py b/test/functional/feature_logging_block_file_reindex.py
index 8850e2605df52df5a07282f26e9a9c622df63050..6d1d11ebb26bd1bf9643b90862980a095fd3966b 100644
