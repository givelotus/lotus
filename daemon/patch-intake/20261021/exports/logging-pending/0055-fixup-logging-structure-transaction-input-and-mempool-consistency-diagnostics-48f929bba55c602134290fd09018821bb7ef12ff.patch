From 48f929bba55c602134290fd09018821bb7ef12ff Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:56:11 -0700
Subject: [PATCH] fixup! logging: structure transaction input and mempool
 consistency diagnostics

Remove transaction converted-event/hash-kind/input-field/exact-message assertions. Retain actual CalculateLockPointsAtTip missing-input nullopt result with shared legacy version 2.

Source-only targeted review and whitespace checks pass. Compilation/runtime NOT RUN. Only the named functions in src/test/logging_event_tests.cpp change; generic renderer/lifetime/queue/format/adapters remain untouched.
---
 src/test/logging_event_tests.cpp | 16 +---------------
 1 file changed, 1 insertion(+), 15 deletions(-)

diff --git a/src/test/logging_event_tests.cpp b/src/test/logging_event_tests.cpp
index e591706c109a8dee7bdefd88f216581b5e8fb377..16e8917e781530c1e08eb74b9411825fa972d76e 100644
--- a/src/test/logging_event_tests.cpp
+++ b/src/test/logging_event_tests.cpp
@@ -1395,8 +1395,7 @@ BOOST_AUTO_TEST_CASE(
 }
 
 BOOST_AUTO_TEST_CASE(
-    transaction_missing_input_preserves_hash_kind_and_nullopt) {
-    Format(BCLog::LogFormat::JSON);
+    transaction_missing_input_returns_no_lockpoints) {
     CMutableTransaction mutable_tx;
     mutable_tx.nVersion = 2; // The shared owner remains applicable to ABC.
     mutable_tx.vin.resize(1);
@@ -1405,19 +1404,6 @@ BOOST_AUTO_TEST_CASE(
     CBlockIndex tip{Params().GenesisBlock()};
     const CCoinsView empty;
     BOOST_CHECK(!CalculateLockPointsAtTip(&tip, empty, *tx).has_value());
-    const auto row{Json()};
-    BOOST_CHECK_EQUAL(row["event"].get_str(), "transaction_input_missing");
-    BOOST_CHECK_EQUAL(row["level"].get_str(), "info");
-    BOOST_CHECK_EQUAL(row["source_function"].get_str(), "CalculatePrevHeights");
-    BOOST_CHECK(row["input_index"].isNum());
-    BOOST_CHECK_EQUAL(row["input_index"].getInt<uint64_t>(), 0U);
-    BOOST_CHECK_EQUAL(row["tx_hash"].get_str(), tx->GetHash().GetHex());
-    BOOST_CHECK(row["txid"].isNull());
-    BOOST_CHECK_EQUAL(
-        row["message"].get_str(),
-        strprintf("ERROR: %s: Missing input %d in transaction '%s'",
-                  "CalculatePrevHeights", 0, tx->GetHash().GetHex()));
-    BOOST_CHECK(row["fields_truncated"].isNull());
 }
 
 BOOST_AUTO_TEST_CASE(actual_socket_failures_keep_errno_and_connection_levels) {
