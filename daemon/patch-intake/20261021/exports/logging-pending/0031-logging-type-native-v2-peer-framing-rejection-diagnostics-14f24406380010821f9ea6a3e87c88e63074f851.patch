From 14f24406380010821f9ea6a3e87c88e63074f851 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Tue, 20 Oct 2026 21:46:56 -0700
Subject: [PATCH] logging: type native V2 peer framing rejection diagnostics

Convert the five P2PV2TransportDeserializer rejection producers as one native
V2-only group after framing owner 23a4dd0de4. Preserve message text, net/debug
category, raw peer IDs and message byte counts, Reset calls, reject flags and
returns. No framing or transport policy changes. Keep these producers out of
the shared eCash tier.

Scripted-diff commands (at this commit parent):
/private/tmp/lane-n4-build/logging-compose/ast-venv/bin/python contrib/logging/conversion/convert.py --root . --rules contrib/logging/conversion/rules/native-v2-peer-framing-diagnostics.json --report /Users/shammah/repos/lotus-v2-repair-work/logging-network/native-v2-framing-source.json --apply
git clang-format --force --binary /opt/homebrew/bin/clang-format --style '{BasedOnStyle: InheritParentConfig, BreakStringLiterals: false}' HEAD -- src/net.cpp
python3 test/lint/lint-log-events.py src/net.cpp src/netbase.cpp
git diff --check

Exact reviewed AST conversion, scoped event lint and whitespace pass.
Compilation and existing native V2 framing tests: NOT RUN. One combined
build and targeted validation follows canonical composition/resource grant.
---
 .../native-v2-peer-framing-diagnostics.json   | 104 ++++++++++++++++++
 src/net.cpp                                   |  35 +++---
 2 files changed, 125 insertions(+), 14 deletions(-)
 create mode 100644 contrib/logging/conversion/rules/native-v2-peer-framing-diagnostics.json

diff --git a/contrib/logging/conversion/rules/native-v2-peer-framing-diagnostics.json b/contrib/logging/conversion/rules/native-v2-peer-framing-diagnostics.json
new file mode 100644
index 0000000000000000000000000000000000000000..ab7aca6aed09352a75aecaf83d27a341889f1fc4
--- /dev/null
+++ b/contrib/logging/conversion/rules/native-v2-peer-framing-diagnostics.json
@@ -0,0 +1,104 @@
+{
+  "schema": 1,
+  "batch": "native-v2-peer-framing-diagnostics",
+  "status": "SOURCE_APPLIED_PENDING_NATIVE_GATE",
+  "tier": "native_v2_only_after_23a4dd0de4",
+  "files": [
+    {
+      "path": "src/net.cpp",
+      "rules": [
+        {
+          "id": "peer_v2_message_empty",
+          "old": "LogDebug(BCLog::NET, \"p2p-v2: empty message, peer=%d\\n\",\n                             m_node_id)",
+          "replacement": "LogEvent(BCLog::NET, \"peer_v2_message_empty\", \"p2p-v2: empty message, peer={peer_id}\").Field(BCLog::LogField::PeerId, m_node_id)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "p2p-v2: empty message, peer=%d\n",
+            "specifiers": [
+              "%d"
+            ],
+            "arguments": [
+              "m_node_id"
+            ]
+          },
+          "review_note": "Preserve exact wording, original category/severity and error/return/disconnect behavior. Keep existing address/URL redaction and fLogIPs conditional suffix expressions. Numeric peer identifiers, byte counts and elapsed seconds retain their domains; no credentials or protocol data added. Source-only pending native gate."
+        },
+        {
+          "id": "peer_v2_message_type_length_invalid",
+          "old": "LogDebug(BCLog::NET,\n                             \"p2p-v2: bad message type length, peer=%d\\n\",\n                             m_node_id)",
+          "replacement": "LogEvent(BCLog::NET, \"peer_v2_message_type_length_invalid\", \"p2p-v2: bad message type length, peer={peer_id}\").Field(BCLog::LogField::PeerId, m_node_id)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "p2p-v2: bad message type length, peer=%d\n",
+            "specifiers": [
+              "%d"
+            ],
+            "arguments": [
+              "m_node_id"
+            ]
+          },
+          "review_note": "Preserve exact wording, original category/severity and error/return/disconnect behavior. Keep existing address/URL redaction and fLogIPs conditional suffix expressions. Numeric peer identifiers, byte counts and elapsed seconds retain their domains; no credentials or protocol data added. Source-only pending native gate."
+        },
+        {
+          "id": "peer_v2_message_type_truncated",
+          "old": "LogDebug(BCLog::NET,\n                             \"p2p-v2: message shorter than its type, peer=%d\\n\",\n                             m_node_id)",
+          "replacement": "LogEvent(BCLog::NET, \"peer_v2_message_type_truncated\", \"p2p-v2: message shorter than its type, peer={peer_id}\").Field(BCLog::LogField::PeerId, m_node_id)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "p2p-v2: message shorter than its type, peer=%d\n",
+            "specifiers": [
+              "%d"
+            ],
+            "arguments": [
+              "m_node_id"
+            ]
+          },
+          "review_note": "Preserve exact wording, original category/severity and error/return/disconnect behavior. Keep existing address/URL redaction and fLogIPs conditional suffix expressions. Numeric peer identifiers, byte counts and elapsed seconds retain their domains; no credentials or protocol data added. Source-only pending native gate."
+        },
+        {
+          "id": "peer_v2_message_oversized",
+          "old": "LogDebug(BCLog::NET,\n                                 \"Header error: Size too large (%s, %u bytes), \"\n                                 \"peer=%d\\n\",\n                                 SanitizeString(m_type), size, m_node_id)",
+          "replacement": "LogEvent(BCLog::NET, \"peer_v2_message_oversized\", \"Header error: Size too large ({msg_type}, {bytes} bytes), peer={peer_id}\").Field(BCLog::LogField::MsgType, SanitizeString(m_type)).Field(BCLog::LogField::Bytes, size).Field(BCLog::LogField::PeerId, m_node_id)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "Header error: Size too large (%s, %u bytes), peer=%d\n",
+            "specifiers": [
+              "%s",
+              "%u",
+              "%d"
+            ],
+            "arguments": [
+              "SanitizeString(m_type)",
+              "size",
+              "m_node_id"
+            ]
+          },
+          "review_note": "Preserve exact wording, original category/severity and error/return/disconnect behavior. Keep existing address/URL redaction and fLogIPs conditional suffix expressions. Numeric peer identifiers, byte counts and elapsed seconds retain their domains; no credentials or protocol data added. Source-only pending native gate."
+        },
+        {
+          "id": "peer_v2_message_type_invalid",
+          "old": "LogDebug(BCLog::NET, \"p2p-v2: invalid message type %s, peer=%d\\n\",\n                 SanitizeString(m_type), m_node_id)",
+          "replacement": "LogEvent(BCLog::NET, \"peer_v2_message_type_invalid\", \"p2p-v2: invalid message type {msg_type}, peer={peer_id}\").Field(BCLog::LogField::MsgType, SanitizeString(m_type)).Field(BCLog::LogField::PeerId, m_node_id)",
+          "count": 1,
+          "reviewed_input": {
+            "macro": "LogDebug",
+            "format": "p2p-v2: invalid message type %s, peer=%d\n",
+            "specifiers": [
+              "%s",
+              "%d"
+            ],
+            "arguments": [
+              "SanitizeString(m_type)",
+              "m_node_id"
+            ]
+          },
+          "review_note": "Preserve exact wording, original category/severity and error/return/disconnect behavior. Keep existing address/URL redaction and fLogIPs conditional suffix expressions. Numeric peer identifiers, byte counts and elapsed seconds retain their domains; no credentials or protocol data added. Source-only pending native gate."
+        }
+      ]
+    }
+  ]
+}
diff --git a/src/net.cpp b/src/net.cpp
index 7bbb686eb3402404b004959b09adcbe4d0901cbd..fe69b1f4fdb5800f16d6ceb90376b8fe2e8d56e1 100644
--- a/src/net.cpp
+++ b/src/net.cpp
@@ -882,8 +882,9 @@ int P2PV2TransportDeserializer::Read(const Config &config,
                 m_length = ReadLE32(m_length_bytes);
                 m_pos = 0;
                 if (m_length == 0) {
-                    LogDebug(BCLog::NET, "p2p-v2: empty message, peer=%d\n",
-                             m_node_id);
+                    LogEvent(BCLog::NET, "peer_v2_message_empty",
+                             "p2p-v2: empty message, peer={peer_id}")
+                        .Field(BCLog::LogField::PeerId, m_node_id);
                     Reset();
                     return -1;
                 }
@@ -914,9 +915,9 @@ int P2PV2TransportDeserializer::Read(const Config &config,
                 if (m_name_length == 0 ||
                     m_name_length > CMessageHeader::MESSAGE_TYPE_SIZE ||
                     m_id_size > m_length) {
-                    LogDebug(BCLog::NET,
-                             "p2p-v2: bad message type length, peer=%d\n",
-                             m_node_id);
+                    LogEvent(BCLog::NET, "peer_v2_message_type_length_invalid",
+                             "p2p-v2: bad message type length, peer={peer_id}")
+                        .Field(BCLog::LogField::PeerId, m_node_id);
                     Reset();
                     return -1;
                 }
@@ -939,9 +940,10 @@ int P2PV2TransportDeserializer::Read(const Config &config,
             }
             case State::DATA: {
                 if (m_length < m_id_size) {
-                    LogDebug(BCLog::NET,
-                             "p2p-v2: message shorter than its type, peer=%d\n",
-                             m_node_id);
+                    LogEvent(
+                        BCLog::NET, "peer_v2_message_type_truncated",
+                        "p2p-v2: message shorter than its type, peer={peer_id}")
+                        .Field(BCLog::LogField::PeerId, m_node_id);
                     Reset();
                     return -1;
                 }
@@ -955,10 +957,13 @@ int P2PV2TransportDeserializer::Read(const Config &config,
                             : "",
                         size};
                     if (hdr.IsOversized(config)) {
-                        LogDebug(BCLog::NET,
-                                 "Header error: Size too large (%s, %u bytes), "
-                                 "peer=%d\n",
-                                 SanitizeString(m_type), size, m_node_id);
+                        LogEvent(
+                            BCLog::NET, "peer_v2_message_oversized",
+                            "Header error: Size too large ({msg_type}, {bytes} bytes), peer={peer_id}")
+                            .Field(BCLog::LogField::MsgType,
+                                   SanitizeString(m_type))
+                            .Field(BCLog::LogField::Bytes, size)
+                            .Field(BCLog::LogField::PeerId, m_node_id);
                         Reset();
                         return -1;
                     }
@@ -994,8 +999,10 @@ P2PV2TransportDeserializer::GetMessage(const std::chrono::microseconds time,
                                        bool &reject_message) {
     reject_message = m_invalid_type;
     if (m_invalid_type) {
-        LogDebug(BCLog::NET, "p2p-v2: invalid message type %s, peer=%d\n",
-                 SanitizeString(m_type), m_node_id);
+        LogEvent(BCLog::NET, "peer_v2_message_type_invalid",
+                 "p2p-v2: invalid message type {msg_type}, peer={peer_id}")
+            .Field(BCLog::LogField::MsgType, SanitizeString(m_type))
+            .Field(BCLog::LogField::PeerId, m_node_id);
     }
     CNetMessage msg(std::move(m_payload));
     msg.m_type = std::move(m_type);
