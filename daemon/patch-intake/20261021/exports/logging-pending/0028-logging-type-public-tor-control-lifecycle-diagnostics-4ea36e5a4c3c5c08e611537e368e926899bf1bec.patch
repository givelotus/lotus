@@ -431,4 +431,16 @@ BOOST_AUTO_TEST_CASE(conn_refused_and_bad_address) {
     BOOST_CHECK(!f.conn.Command("GETINFO version", f.Record()));
 }
 
+BOOST_AUTO_TEST_CASE(control_address_rejection_has_no_callbacks) {
+    // A non-numeric control address is refused without scheduling callbacks.
+    boost::asio::io_context io;
+    TorControlConnection conn{io};
+    unsigned callbacks{0};
+    BOOST_CHECK(!conn.Connect(
+        "localhost:9051", [&](TorControlConnection &) { ++callbacks; },
+        [&](TorControlConnection &) { ++callbacks; }));
+    io.poll();
+    BOOST_CHECK_EQUAL(callbacks, 0U);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
