From e3b73ec3a2a4e46e3981a06c61e59194c3a7614e Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Wed, 21 Oct 2026 13:26:09 -0700
Subject: [PATCH] snapshot: share immutable radix roots without a writer grace
 period

Published mempool entry trees have no surviving mutable builder. Give this explicitly immutable source a separate clone constructor, preserving the generic concurrent-writer copy barrier. This removes one global RCU synchronize from each changed-entry snapshot publication under the mempool lock.

Retain normal copy-on-write mutation and deferred RCU node reclamation. Add coverage for independent clone mutations and descendants outliving the original publication. Source-only preparation: git diff --check passed; native compilation, correctness suite and before/after measurements remain pending.
---
 src/node/snapshot.cpp    |  6 +++++-
 src/radix.h              | 19 +++++++++++++++++++
 src/test/radix_tests.cpp | 30 ++++++++++++++++++++++++++++++
 3 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/src/node/snapshot.cpp b/src/node/snapshot.cpp
index f773351dcb..e8a07b249e 100644
--- a/src/node/snapshot.cpp
+++ b/src/node/snapshot.cpp
@@ -183,11 +183,15 @@ void CaptureMempoolEntriesLocked(ChainAndMempoolSnapshot &snap,
         snap.entry_tree = prev->entry_tree;
         return;
     }
+    // The published tree is immutable: its sole mutable builder is moved
+    // into the snapshot below. Pinning prev keeps it alive while the new
+    // builder shares its root, so no global writer grace period is needed.
     auto tree =
         full ? std::allocate_shared<MempoolSnapshotTree>(
                    SnapshotAllocator<MempoolSnapshotTree>{})
              : std::allocate_shared<MempoolSnapshotTree>(
-                   SnapshotAllocator<MempoolSnapshotTree>{}, *prev->entry_tree);
+                   SnapshotAllocator<MempoolSnapshotTree>{}, *prev->entry_tree,
+                   MempoolSnapshotTree::ImmutableSnapshotTag{});
     auto capture = [&](const CTxMemPoolEntry &entry) EXCLUSIVE_LOCKS_REQUIRED(mempool.cs) {
         tree->insert(RCUPtr<ImmutableMempoolEntry>::make(
             MakeMempoolEntrySnapshot(entry, mempool)));
diff --git a/src/radix.h b/src/radix.h
index 6dd709ea2c..ace2d423a5 100644
--- a/src/radix.h
+++ b/src/radix.h
@@ -75,6 +75,25 @@ public:
         RCULock::synchronize();
     }
 
+    /**
+     * Explicit contract for copying a published immutable tree. The caller
+     * must own/pin the source and guarantee that no source mutation is in
+     * flight. Merely accessing a mutable tree through const is insufficient.
+     *
+     * Unlike the generic copy, no grace period is needed to wait for writers
+     * that entered an unshared source node before its root was shared. There
+     * cannot be such a writer for an immutable published source. Mutating the
+     * resulting tree still follows the normal copy-on-write path.
+     */
+    struct ImmutableSnapshotTag {};
+
+    RadixTree(const RadixTree &src, ImmutableSnapshotTag) : RadixTree() {
+        RCULock lock;
+        RadixElement e = src.root.load();
+        e.incrementRefCount();
+        root = e;
+    }
+
     RadixTree &operator=(const RadixTree &rhs) {
         {
             RCULock lock;
diff --git a/src/test/radix_tests.cpp b/src/test/radix_tests.cpp
index 06663f107b..9e1a4b645e 100644
--- a/src/test/radix_tests.cpp
+++ b/src/test/radix_tests.cpp
@@ -397,6 +397,36 @@ BOOST_AUTO_TEST_CASE(test_cow) {
     BOOST_CHECK(copyTree.get(93));
 }
 
+BOOST_AUTO_TEST_CASE(immutable_snapshot_cow) {
+    using E = TestElementInt<uint64_t>;
+    using Tree = RadixTree<E>;
+    Tree builder;
+    for (uint64_t key = 0; key < 256; ++key) {
+        BOOST_REQUIRE(builder.insert(RCUPtr<E>::make(key)));
+    }
+    // Transfer the only mutable builder into an immutable published owner.
+    auto published = std::make_unique<const Tree>(std::move(builder));
+    Tree first(*published, Tree::ImmutableSnapshotTag{});
+    Tree second(*published, Tree::ImmutableSnapshotTag{});
+    for (uint64_t key = 0; key < 128; ++key) {
+        BOOST_REQUIRE(first.remove(key));
+        BOOST_REQUIRE(second.insert(RCUPtr<E>::make(key + 256)));
+    }
+    for (uint64_t key = 0; key < 256; ++key) {
+        BOOST_CHECK(published->get(key));
+        BOOST_CHECK_EQUAL(bool(first.get(key)), key >= 128);
+        BOOST_CHECK(second.get(key));
+        BOOST_CHECK(!published->get(key + 256));
+    }
+    // Descendant snapshots independently retain shared nodes after the
+    // original publication is released.
+    published.reset();
+    for (uint64_t key = 0; key < 128; ++key) {
+        BOOST_CHECK(second.get(key + 256));
+        BOOST_CHECK(!first.get(key + 256));
+    }
+}
+
 BOOST_AUTO_TEST_CASE(test_move) {
     using E = TestElementInt<uint32_t>;
 
