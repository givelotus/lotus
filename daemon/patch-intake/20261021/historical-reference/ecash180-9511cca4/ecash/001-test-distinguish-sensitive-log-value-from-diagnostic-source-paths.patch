From 91f3fbaa4f36bf590be14193649890b1de463ad9 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 23:13:52 -0700
Subject: [PATCH] test: distinguish sensitive log value from diagnostic source
 paths

Use a unique sensitive canary instead of private, which also appears in macOS source paths such as /private/tmp. Keep the positive logging and masked-argument checks and require the complete sensitive value to be absent from captured output. This changes only the inherited test fixture; argument redaction behavior remains unchanged. The existing H official gate reproduces the original false positive; corrected official gate is required before acceptance.

Compatibility ownership: hoist the native032 argument-log path workaround and adversarial controls into the first shared test-only owner. The unchanged hoist has an exact full final-tree proof (ec855093c5fe82a061d2921b6ba5956fc56d05ab). Separately repair the fixture to use a unique sensitive canary with whole-log absence checks, retaining adversarial redacted-then-leaked and leaked-line controls. The intentional repair changes only getarg_tests.cpp; production redaction and consensus behavior remain unchanged.
---
 src/test/getarg_tests.cpp | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/src/test/getarg_tests.cpp b/src/test/getarg_tests.cpp
index a621241daa313ba8e20232ccfe38c0d1c80c91de..3e05c8a37ae0a48215d1cce3074c4d1788229b4c 100644
--- a/src/test/getarg_tests.cpp
+++ b/src/test/getarg_tests.cpp
@@ -433,9 +433,12 @@ BOOST_AUTO_TEST_CASE(logargs) {
     const auto dontlog = std::make_pair("-dontlog", ArgsManager::ALLOW_ANY |
                                                         ArgsManager::SENSITIVE);
     SetupArgs(local_args, {okaylog_bool, okaylog_negbool, okaylog, dontlog});
-    ResetArgs(
-        local_args,
-        "-okaylog-bool -nookaylog-negbool -okaylog=public -dontlog=private");
+    // The sensitive value must not also occur in diagnostic source paths
+    // (for example /private/tmp on macOS).
+    const std::string sensitive_value = "logargs-sensitive-canary-83b91e0c";
+    ResetArgs(local_args,
+              "-okaylog-bool -nookaylog-negbool -okaylog=public -dontlog=" +
+                  sensitive_value);
 
     // Everything logged to debug.log will also append to str
     std::string str;
@@ -454,7 +457,20 @@ BOOST_AUTO_TEST_CASE(logargs) {
     BOOST_CHECK(str.find("Command-line arg: okaylog=\"public\"") !=
                 std::string::npos);
     BOOST_CHECK(str.find("dontlog=****") != std::string::npos);
-    BOOST_CHECK(str.find("private") == std::string::npos);
+    BOOST_CHECK(str.find(sensitive_value) == std::string::npos);
+
+    // Exercise the same whole-log predicate against harmless source metadata
+    // and against leaked values, including a leak after a redacted line.
+    const std::string redacted =
+        "[/private/tmp/args.cpp:846] Command-line arg: dontlog=****\n";
+    BOOST_CHECK(redacted.find(sensitive_value) == std::string::npos);
+    BOOST_CHECK((redacted + "Command-line arg: dontlog=\"" + sensitive_value +
+                 "\"\n")
+                    .find(sensitive_value) != std::string::npos);
+    BOOST_CHECK(("[/private/tmp/args.cpp:846] Command-line arg: dontlog=\"" +
+                 std::string{sensitive_value} + "\"\n")
+                    .find(sensitive_value) != std::string::npos);
+
 }
 
 BOOST_AUTO_TEST_SUITE_END()
