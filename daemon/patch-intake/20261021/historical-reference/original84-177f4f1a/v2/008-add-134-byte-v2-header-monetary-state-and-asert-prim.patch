diff --git a/src/lotus_v2/block_cost.cpp b/src/lotus_v2/block_cost.cpp
new file mode 100644
index 0000000000..8e4cf54eb0
--- /dev/null
+++ b/src/lotus_v2/block_cost.cpp
@@ -0,0 +1,152 @@
+// Copyright (c) 2026 The Lotus developers
+#include "block_cost.h"
+#include "block_wire.h"
+#include <limits>
+#include <stdexcept>
+namespace lotus::v2 {
+namespace {
+    using Int = MonetaryInteger;
+    void Require(bool v, const char *why) {
+        if (!v) throw std::invalid_argument(why);
+    }
+    void Profile(const BlockCostProfile &p) {
+        Require(p.hash_base && p.hash_byte && p.resolve_byte &&
+                    p.asset_comparison,
+                "nonpositive block cost schedule");
+    }
+    Int HashCost(const Int &bytes, const BlockCostProfile &p) {
+        return p.hash_base + (bytes + 64) * p.hash_byte;
+    }
+    Int Tree(size_t n, const BlockCostProfile &p) {
+        // At most 2*n internal digests, even with odd-layer padding; empty root
+        // and single-leaf cases are conservatively charged as well.
+        return Int(2) * std::max<size_t>(n, 1) * HashCost(66, p);
+    }
+    uint64_t Narrow(const Int &v) {
+        Require(v >= 0 && v <= std::numeric_limits<uint64_t>::max(),
+                "transaction linear cost width");
+        return v.convert_to<uint64_t>();
+    }
+    Int StateKey(const Coin &coin, const BlockCostProfile &p) {
+        std::vector<uint8_t> raw;
+        Require(EncodeCoin(coin, raw), "cost coin encoding");
+        return HashCost(36, p) +
+               HashCost(1 + 32 + CompactSizeWidth(raw.size()) + raw.size(), p) +
+               Int(27) * HashCost(67, p);
+    }
+} // namespace
+TransactionCosts AuthenticatedTransactionCostsResolved(const Transaction &tx,
+                                               const TxProfile &profile,
+                                               const std::vector<Coin> &resolved_spends,
+                                               uint64_t height, uint64_t mtp,
+                                               VmCostUnits invocation,
+                                               const BlockCostProfile &p,
+                                               const uint64_t *precomputed_wire_bytes) {
+    Profile(p);
+    std::string error;
+    Int total = 0;
+    if (precomputed_wire_bytes != nullptr) {
+        Require(!tx.inputs.empty() && !tx.outputs.empty(),
+                "cost transaction encoding");
+        total = *precomputed_wire_bytes;
+    } else {
+        std::vector<uint8_t> raw;
+        Require(EncodeTransaction(tx, profile, raw, error),
+                "cost transaction encoding");
+        total = raw.size();
+    }
+    Int vm = static_cast<uint64_t>(invocation >> 64);
+    vm <<= 64;
+    vm += static_cast<uint64_t>(invocation);
+    total += vm;
+    // All identity and signing commitments are charged even when cached/lazy.
+    total += 2 * HashCost(112, p);
+    size_t spends = 0;
+    for (const auto &input : tx.inputs) {
+        std::vector<uint8_t> core, full;
+        Require(EncodeInputCore(input, profile, core, error) &&
+                    EncodeInputFull(input, profile, full, error),
+                "cost input encoding");
+        total += HashCost(core.size(), p) + HashCost(full.size(), p);
+        for (const auto &w : input.witnesses)
+            total += HashCost(1 + CompactSizeWidth(w.script.size()) +
+                                  w.script.size(),
+                              p) +
+                     Int(w.siblings.size()) * HashCost(65, p);
+        if (input.flags == 1) {
+            Require(spends < resolved_spends.size(), "cost unresolved coin");
+            const Coin &coin_record = resolved_spends[spends++];
+            Require(coin_record.outpoint == Outpoint{input.prev_txid, input.prev_index},
+                    "cost resolved outpoint mismatch");
+            std::vector<uint8_t> output, coin;
+            Require(EncodeOutput(coin_record.output, output, error) &&
+                        EncodeCoin(coin_record, coin),
+                    "cost resolved encoding");
+            total += Int(coin.size()) * p.resolve_byte;
+            total +=
+                HashCost(CompactSizeWidth(output.size()) + output.size(), p);
+            total += HashCost(core.size() + CompactSizeWidth(output.size()) +
+                                  output.size(),
+                              p);
+            // Path selection and matching is bounded by the frozen 16x16 caps.
+            total += Int(256) * p.asset_comparison;
+            total += StateKey(coin_record, p);
+        } else if (input.flags == 3)
+            total += HashCost(0, p); // absent resolved CoinEntry
+    }
+    Require(spends == resolved_spends.size(), "cost extra resolved coin");
+    const bool coinbase = tx.inputs.front().flags == 2;
+    total += (coinbase ? 2 : 3) * Tree(tx.inputs.size(), p) +
+             Tree(tx.outputs.size(), p);
+    for (size_t j = 0; j < tx.outputs.size(); ++j) {
+        const auto &output = tx.outputs[j];
+        std::vector<uint8_t> bytes;
+        Require(EncodeOutput(output, bytes, error), "cost output encoding");
+        total += HashCost(CompactSizeWidth(bytes.size()) + bytes.size(), p);
+        if (!output.IsBurn()) {
+            Coin coin;
+            coin.output = output;
+            coin.outpoint.index = j;
+            coin.creation_height = height;
+            coin.creation_parent_mtp = mtp;
+            coin.coinbase = tx.inputs.front().flags == 2;
+            total += StateKey(coin, p);
+        }
+    }
+    // Covers native/token additions, ordered asset-map/mint/path lookups and
+    // comparisons. Deliberately conservative development cost, not calibration.
+    Int records = tx.inputs.size() + tx.outputs.size();
+    total += (records * records + records + spends) * p.asset_comparison;
+    uint64_t result = Narrow(total);
+    return {result, result};
+}
+TransactionCosts AuthenticatedTransactionCosts(
+    const Transaction &tx, const TxProfile &profile,
+    const DevelopmentUtxoView &view, uint64_t height, uint64_t mtp,
+    VmCostUnits invocation, const BlockCostProfile &p) {
+    std::vector<Coin> resolved;
+    for (const auto &input : tx.inputs) {
+        if (input.flags != 1) continue;
+        const auto found = view.find(Outpoint{input.prev_txid, input.prev_index});
+        Require(found != view.end(), "cost unresolved coin");
+        resolved.push_back(found->second);
+    }
+    return AuthenticatedTransactionCostsResolved(tx, profile, resolved, height,
+                                                 mtp, invocation, p);
+}
+MonetaryInteger AuthenticatedEnvelopeCost(uint64_t frames, uint32_t count,
+                                          const BlockCostProfile &p) {
+    Profile(p);
+    Require(count > 0, "empty block cost");
+    Int cost = Int(134) + 4 + frames;
+    // Block-wide ordered TxID uniqueness lookup, independent of live outputs.
+    cost += (Int(count) * count + count) * p.asset_comparison;
+    // Ordered transaction-tree: n leaves, n-1 interior nodes, count wrapper.
+    cost += (Int(2) * count - 1) * HashCost(65, p) + HashCost(37, p);
+    // StateRoot plus header body/work/block-ID domains.
+    cost +=
+        HashCost(130, p) + HashCost(116, p) + HashCost(50, p) + HashCost(64, p);
+    Require(cost < (Int(1) << 128), "envelope cost width");
+    return cost;
+}
+} // namespace lotus::v2
diff --git a/src/lotus_v2/block_cost.h b/src/lotus_v2/block_cost.h
new file mode 100644
index 0000000000..12634d275b
--- /dev/null
+++ b/src/lotus_v2/block_cost.h
@@ -0,0 +1,45 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_BLOCK_COST_H
+#define LOTUS_V2_BLOCK_COST_H
+#include "monetary.h"
+namespace lotus::v2 {
+// Explicit development schedule, never launch defaults. Hash charges reserve
+// 64 domain bytes per digest, plus base and payload bytes. State update charges
+// conservatively cover 27 collapsed sparse-tree levels per key. Asset lookup uses
+// a conservative quadratic comparison bound; no expected hash-table bound.
+// This is an abstract development schedule, not calibrated/frozen P05 costs.
+// Oracle view copying/rebuilding and repeated checks of authenticated ancestor
+// headers are bookkeeping outside this model. Their implementation overhead
+// remains an uncalibrated measurement gap, not a resource-safety claim.
+struct BlockCostProfile {
+    uint64_t hash_base;
+    uint64_t hash_byte;
+    uint64_t resolve_byte;
+    uint64_t asset_comparison;
+};
+struct TransactionCosts {
+    uint64_t account_linear = 0;
+    uint64_t enforce_linear = 0;
+};
+// Genesis allocation only: authenticated VM charge is shared by both views.
+// Extensions must supply separate authenticated accounting/execution engines
+// before they can use this acceptance boundary (no caller cost override).
+TransactionCosts
+AuthenticatedTransactionCosts(const Transaction &tx, const TxProfile &profile,
+                              const DevelopmentUtxoView &view, uint64_t height,
+                              uint64_t parent_mtp, VmCostUnits invocation_cost,
+                              const BlockCostProfile &cost);
+// Same arithmetic over the validated transaction's resolved spends, in input
+// order with mint/coinbase inputs omitted. This avoids backend reads or a
+// complete UTXO map in the persistent connector. Reject mismatched records.
+TransactionCosts AuthenticatedTransactionCostsResolved(
+    const Transaction &tx, const TxProfile &profile,
+    const std::vector<Coin> &resolved_spends, uint64_t height,
+    uint64_t parent_mtp, VmCostUnits invocation_cost,
+    const BlockCostProfile &cost,
+    const uint64_t *precomputed_wire_bytes = nullptr);
+MonetaryInteger AuthenticatedEnvelopeCost(uint64_t frame_prefix_bytes,
+                                          uint32_t count,
+                                          const BlockCostProfile &cost);
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/header.cpp b/src/lotus_v2/header.cpp
new file mode 100644
index 0000000000..662d63aaa9
--- /dev/null
+++ b/src/lotus_v2/header.cpp
@@ -0,0 +1,138 @@
+#include "header.h"
+#include "tagged_hash.h"
+
+#include <algorithm>
+#include <array>
+
+namespace lotus::v2 {
+namespace {
+
+template <size_t N> void PutLE(std::array<uint8_t, N> &out, size_t pos,
+                              uint64_t value, size_t bytes) {
+    for (size_t i = 0; i < bytes; ++i) {
+        out[pos + i] = static_cast<uint8_t>(value >> (8 * i));
+    }
+}
+
+uint64_t ReadLE(const uint8_t *data, size_t bytes) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < bytes; ++i) {
+        value |= uint64_t{data[i]} << (8 * i);
+    }
+    return value;
+}
+
+uint32_t EncodeTarget(const Hash &target) {
+    int top = 31;
+    while (top >= 0 && target[top] == 0) {
+        --top;
+    }
+    if (top < 0) return 0;
+    uint32_t exponent = static_cast<uint32_t>(top + 1);
+    uint32_t mantissa = 0;
+    if (exponent <= 3) {
+        for (int i = top; i >= 0; --i) mantissa = (mantissa << 8) | target[i];
+        mantissa <<= 8 * (3 - exponent);
+    } else {
+        mantissa = (uint32_t{target[top]} << 16) |
+                   (uint32_t{target[top - 1]} << 8) | target[top - 2];
+    }
+    if (mantissa & 0x00800000U) {
+        mantissa >>= 8;
+        ++exponent;
+    }
+    return (exponent << 24) | mantissa;
+}
+
+} // namespace
+
+bool SerializeHeader(const Header &h, std::array<uint8_t, HEADER_SIZE> &out) {
+    if (h.time > MAX_TIME) return false;
+    std::copy(h.prev_id.begin(), h.prev_id.end(), out.begin());
+    PutLE(out, 32, h.bits, 4);
+    PutLE(out, 36, h.time, 6);
+    PutLE(out, 42, h.nonce, 8);
+    PutLE(out, 50, h.version, 4);
+    PutLE(out, 54, h.size, 8);
+    PutLE(out, 62, h.height, 8);
+    std::copy(h.tx_root.begin(), h.tx_root.end(), out.begin() + 70);
+    std::copy(h.state_root.begin(), h.state_root.end(), out.begin() + 102);
+    return true;
+}
+
+bool ParseHeader(const uint8_t *data, size_t size, Header &out) {
+    if (data == nullptr || size != HEADER_SIZE) return false;
+    Header parsed;
+    std::copy_n(data, 32, parsed.prev_id.begin());
+    parsed.bits = static_cast<uint32_t>(ReadLE(data + 32, 4));
+    parsed.time = ReadLE(data + 36, 6);
+    parsed.nonce = ReadLE(data + 42, 8);
+    parsed.version = static_cast<uint32_t>(ReadLE(data + 50, 4));
+    parsed.size = ReadLE(data + 54, 8);
+    parsed.height = ReadLE(data + 62, 8);
+    std::copy_n(data + 70, 32, parsed.tx_root.begin());
+    std::copy_n(data + 102, 32, parsed.state_root.begin());
+    out = parsed;
+    return true;
+}
+
+Hash BodyHash(const ChainId &chain_id, const Header &header) {
+    std::array<uint8_t, 116> body{};
+    std::copy(chain_id.begin(), chain_id.end(), body.begin());
+    PutLE(body, 32, header.version, 4);
+    PutLE(body, 36, header.size, 8);
+    PutLE(body, 44, header.height, 8);
+    std::copy(header.tx_root.begin(), header.tx_root.end(), body.begin() + 52);
+    std::copy(header.state_root.begin(), header.state_root.end(), body.begin() + 84);
+    return TaggedHash(HashDomain::HeaderBody, body);
+}
+
+bool WorkHash(const ChainId &chain_id, const Header &header, Hash &out) {
+    if (header.time > MAX_TIME) return false;
+    std::array<uint8_t, 50> work{};
+    PutLE(work, 0, header.bits, 4);
+    PutLE(work, 4, header.time, 6);
+    PutLE(work, 10, header.nonce, 8);
+    const Hash body_hash = BodyHash(chain_id, header);
+    std::copy(body_hash.begin(), body_hash.end(), work.begin() + 18);
+    out = TaggedHash(HashDomain::HeaderWork, work);
+    return true;
+}
+
+bool BlockId(const ChainId &chain_id, const Header &header, Hash &out) {
+    if (header.time > MAX_TIME) return false;
+    std::array<uint8_t, 64> input{};
+    std::copy(header.prev_id.begin(), header.prev_id.end(), input.begin());
+    Hash work_hash;
+    WorkHash(chain_id, header, work_hash);
+    std::copy(work_hash.begin(), work_hash.end(), input.begin() + 32);
+    out = TaggedHash(HashDomain::BlockId, input);
+    return true;
+}
+
+bool MeetsTarget(const Hash &block_id, const Hash &target) {
+    for (int i = 31; i >= 0; --i) {
+        if (block_id[i] < target[i]) return true;
+        if (block_id[i] > target[i]) return false;
+    }
+    return true;
+}
+
+bool DecodeTarget(uint32_t bits, const Hash &pow_limit, Hash &target) {
+    const uint32_t exponent = bits >> 24;
+    const uint32_t mantissa = bits & 0x007fffffU;
+    if ((bits & 0x00800000U) || mantissa == 0) return false;
+    Hash decoded{};
+    for (unsigned i = 0; i < 3; ++i) {
+        const int position = static_cast<int>(exponent) - 3 + static_cast<int>(i);
+        const uint8_t byte = static_cast<uint8_t>(mantissa >> (8 * i));
+        if (position >= 32 && byte != 0) return false;
+        if (position >= 0 && position < 32) decoded[position] = byte;
+    }
+    if (std::all_of(decoded.begin(), decoded.end(), [](uint8_t b) { return b == 0; })) return false;
+    if (EncodeTarget(decoded) != bits || !MeetsTarget(decoded, pow_limit)) return false;
+    target = decoded;
+    return true;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/header.h b/src/lotus_v2/header.h
new file mode 100644
index 0000000000..fadef5388c
--- /dev/null
+++ b/src/lotus_v2/header.h
@@ -0,0 +1,48 @@
+// Copyright (c) 2026 The Lotus developers
+// Candidate V2 header primitives. No legacy block type depends on this file.
+#ifndef LOTUS_V2_HEADER_H
+#define LOTUS_V2_HEADER_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace lotus::v2 {
+
+using Hash = std::array<uint8_t, 32>;
+using ChainId = Hash;
+constexpr size_t HEADER_SIZE = 134;
+constexpr uint64_t MAX_TIME = (uint64_t{1} << 48) - 1;
+constexpr uint32_t kHeaderVersion = 2;
+
+struct Header {
+    Hash prev_id{};
+    uint32_t bits{};
+    uint64_t time{};
+    uint64_t nonce{};
+    uint32_t version{};
+    uint64_t size{};
+    uint64_t height{};
+    Hash tx_root{};
+    Hash state_root{};
+};
+
+// Hash byte arrays retain digest order. Interpret them as little-endian
+// unsigned integers only for PoW target comparison.
+bool SerializeHeader(const Header &header, std::array<uint8_t, HEADER_SIZE> &out);
+// Structural parse only. Caller validates version, height, target, size,
+// roots, time eligibility and parent against its chain manifest and context.
+bool ParseHeader(const uint8_t *data, size_t size, Header &out);
+Hash BodyHash(const ChainId &chain_id, const Header &header);
+bool WorkHash(const ChainId &chain_id, const Header &header, Hash &out);
+bool BlockId(const ChainId &chain_id, const Header &header, Hash &out);
+
+// Decode only canonical positive compact targets at or below pow_limit.
+// pow_limit is a 32-byte little-endian unsigned integer. Failure leaves
+// target unchanged. The parser and work/block hash functions likewise leave
+// their outputs unchanged on failure.
+bool DecodeTarget(uint32_t bits, const Hash &pow_limit, Hash &target);
+bool MeetsTarget(const Hash &block_id, const Hash &target);
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/header_admission.cpp b/src/lotus_v2/header_admission.cpp
new file mode 100644
index 0000000000..5a86ccb7fd
--- /dev/null
+++ b/src/lotus_v2/header_admission.cpp
@@ -0,0 +1,67 @@
+// Copyright (c) 2026 The Lotus developers
+#include "header_admission.h"
+#include "chain_index.h"
+#include <exception>
+namespace lotus::v2 {
+HeaderAdmission AdmitDevelopmentHeader(
+    const Header &candidate, const HeaderChainProfile &hp,
+    const OrdinaryCandidateProfile &op, const MonetaryProfile &mp,
+    const BlockCostProfile &cp, DiskStateStore &store, std::string &error) {
+    using Result = HeaderAdmission;
+    try {
+        if (hp.genesis_id == Hash{} ||
+            !store.MatchesProfile(hp.chain_id, BlockValidationProfileDigest(hp, op, mp, cp))) {
+            error = "header admission validator profile mismatch"; return Result::StorageError;
+        }
+        Hash id, target;
+        if (candidate.version != hp.version || candidate.size < HEADER_SIZE + 4 ||
+            !BlockId(hp.chain_id, candidate, id) ||
+            !DecodeTarget(candidate.bits, hp.pow_limit, target) || !MeetsTarget(id, target)) {
+            error = "header encoding, profile, target or proof of work"; return Result::Invalid;
+        }
+        DiskStateError failure;
+        std::optional<IndexedHeader> known;
+        if (!store.ReadIndexedHeader(id, known, failure)) {
+            error = failure.message; return Result::StorageError;
+        }
+        if (known) { error.clear(); return Result::Known; }
+        if (candidate.height == 0) {
+            error = id == hp.genesis_id ? "indexed genesis unavailable" : "peer genesis differs from manifest";
+            return id == hp.genesis_id ? Result::StorageError : Result::Invalid;
+        }
+        std::optional<IndexedHeader> parent;
+        if (!store.ReadIndexedHeader(candidate.prev_id, parent, failure)) {
+            error = failure.message; return Result::StorageError;
+        }
+        if (!parent) { error = "header parent unavailable"; return Result::MissingParent; }
+        // At most eleven indexed ancestors, independent of chain height.
+        const size_t count = parent->header.height >= 10 ? 11 : size_t(parent->header.height) + 1;
+        std::vector<Header> history;
+        history.reserve(count);
+        auto cursor = *parent;
+        for (size_t i = 0; i < count; ++i) {
+            history.push_back(cursor.header);
+            if (i + 1 == count) break;
+            std::optional<IndexedHeader> previous;
+            if (!store.ReadIndexedHeader(cursor.header.prev_id, previous, failure)) {
+                error = failure.message; return Result::StorageError;
+            }
+            if (!previous) {
+                error = "indexed ancestry unavailable"; return Result::StorageError;
+            }
+            cursor = *previous;
+        }
+        if (!ParentMedianTime(hp, parent->header, history)) {
+            error = "indexed parent history corrupt"; return Result::StorageError;
+        }
+        // These roots/size remain untrusted commitments until full body admission.
+        if (!ValidateChildHeader(hp, parent->header, history, candidate,
+                                 candidate.tx_root, candidate.state_root, candidate.size, error))
+            return Result::Invalid;
+        if (!store.PutCheckedHeader(candidate, failure)) {
+            error = failure.message; return Result::StorageError;
+        }
+        error.clear(); return Result::Stored;
+    } catch (const std::exception &e) { error = e.what(); return Result::StorageError; }
+}
+} // namespace lotus::v2
diff --git a/src/lotus_v2/header_admission.h b/src/lotus_v2/header_admission.h
new file mode 100644
index 0000000000..5b67c374f6
--- /dev/null
+++ b/src/lotus_v2/header_admission.h
@@ -0,0 +1,16 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_HEADER_ADMISSION_H
+#define LOTUS_V2_HEADER_ADMISSION_H
+#include "disk_block.h"
+namespace lotus::v2 {
+enum class HeaderAdmission { Stored, Known, MissingParent, Invalid, StorageError };
+// Deterministic header-only admission. Roots and size are commitments, not body
+// validation results. Caller serializes store access and bounds announced headers.
+// Clock eligibility and peer resource policy remain separate; no wall-clock read.
+// Requires an initialized indexed development store and exact validator profile.
+HeaderAdmission AdmitDevelopmentHeader(
+    const Header &, const HeaderChainProfile &, const OrdinaryCandidateProfile &,
+    const MonetaryProfile &, const BlockCostProfile &, DiskStateStore &,
+    std::string &error);
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/header_context.cpp b/src/lotus_v2/header_context.cpp
new file mode 100644
index 0000000000..5924266ec2
--- /dev/null
+++ b/src/lotus_v2/header_context.cpp
@@ -0,0 +1,116 @@
+#include "header_context.h"
+#include "asert_candidate.h"
+#include <algorithm>
+#include <limits>
+namespace lotus::v2 {
+namespace {
+    AsertInteger Integer(const Hash &h) {
+        AsertInteger n = 0;
+        for (auto i = h.rbegin(); i != h.rend(); ++i) {
+            n <<= 8;
+            n += *i;
+        }
+        return n;
+    }
+    bool Same(const Header &a, const Header &b) {
+        std::array<uint8_t, HEADER_SIZE> x{}, y{};
+        return SerializeHeader(a, x) && SerializeHeader(b, y) && x == y;
+    }
+} // namespace
+std::optional<uint64_t> ParentMedianTime(const HeaderChainProfile &p,
+                                         const Header &parent,
+                                         const std::vector<Header> &history) {
+    const size_t count = parent.height >= 10 ? 11 : size_t(parent.height) + 1;
+    if (history.size() != count || !Same(history.front(), parent))
+        return std::nullopt;
+    std::vector<uint64_t> times;
+    for (size_t i = 0; i < count; ++i) {
+        const auto &h = history[i];
+        std::array<uint8_t, HEADER_SIZE> bytes{};
+        if (h.height != parent.height - i || h.version != p.version ||
+            !SerializeHeader(h, bytes))
+            return std::nullopt;
+        if (i + 1 < count) {
+            Hash id{};
+            if (!BlockId(p.chain_id, history[i + 1], id) || h.prev_id != id)
+                return std::nullopt;
+        }
+        if (h.height == 0 && (h.time != p.genesis_time ||
+                              h.bits != p.genesis_bits || h.prev_id != Hash{}))
+            return std::nullopt;
+        if (h.height == 0 && p.genesis_id != Hash{}) {
+            Hash genesis_id;
+            if (!BlockId(p.chain_id, h, genesis_id) || genesis_id != p.genesis_id)
+                return std::nullopt;
+        }
+        times.push_back(h.time);
+    }
+    std::sort(times.begin(), times.end());
+    return times[times.size() / 2];
+}
+HeaderCheckResult ValidateChildHeaderChecked(
+    const HeaderChainProfile &p, const Header &parent,
+    const std::vector<Header> &history, const Header &child, const Hash &tx,
+    const Hash &state, uint64_t size, std::string &error) {
+    try {
+        auto fail = [&](const char *why) {
+            error = why;
+            return HeaderCheckResult::Invalid;
+        };
+        const auto mtp = ParentMedianTime(p, parent, history);
+        if (!mtp) {
+            error = "authenticated parent history";
+            return HeaderCheckResult::Inconclusive;
+        }
+        const auto limit = Integer(p.pow_limit);
+        const auto genesis = DecodeCompactTarget(p.genesis_bits, limit);
+        if (!genesis || p.half_life_seconds <= 0 || p.spacing_seconds <= 0 ||
+            p.genesis_time > MAX_TIME) {
+            error = "chain profile";
+            return HeaderCheckResult::Inconclusive;
+        }
+        if (parent.height == std::numeric_limits<uint64_t>::max()) {
+            error = "parent height exhausted";
+            return HeaderCheckResult::Inconclusive;
+        }
+        if (child.height != parent.height + 1) return fail("child height");
+        Hash parent_id{};
+        if (!BlockId(p.chain_id, parent, parent_id)) {
+            error = "parent identity unavailable";
+            return HeaderCheckResult::Inconclusive;
+        }
+        if (child.prev_id != parent_id) return fail("child parent");
+        if (child.version != p.version) return fail("child version");
+        if (child.time > MAX_TIME || child.time <= *mtp)
+            return fail("child median time");
+        if (child.tx_root != tx || child.state_root != state ||
+            child.size != size)
+            return fail("child commitments");
+        const auto required = RequiredAsertCandidateBits(
+            p.half_life_seconds, p.spacing_seconds, *genesis, p.genesis_time,
+            limit, {parent.time, parent.height});
+        Hash target{}, id{};
+        if (!required) {
+            error = "required target context";
+            return HeaderCheckResult::Inconclusive;
+        }
+        if (child.bits != required->bits ||
+            !DecodeTarget(child.bits, p.pow_limit, target))
+            return fail("required target");
+        if (!BlockId(p.chain_id, child, id) || !MeetsTarget(id, target))
+            return fail("proof of work");
+        error.clear();
+        return HeaderCheckResult::Valid;
+    } catch (const std::exception &exception) {
+        error = exception.what();
+        return HeaderCheckResult::Inconclusive;
+    }
+}
+bool ValidateChildHeader(const HeaderChainProfile &p, const Header &parent,
+                         const std::vector<Header> &history,
+                         const Header &child, const Hash &tx, const Hash &state,
+                         uint64_t size, std::string &error) {
+    return ValidateChildHeaderChecked(p, parent, history, child, tx, state,
+                                      size, error) == HeaderCheckResult::Valid;
+}
+} // namespace lotus::v2
diff --git a/src/lotus_v2/header_context.h b/src/lotus_v2/header_context.h
new file mode 100644
index 0000000000..360b5b18a6
--- /dev/null
+++ b/src/lotus_v2/header_context.h
@@ -0,0 +1,41 @@
+// Deterministic P04 candidate validation; no wall-clock eligibility policy.
+#ifndef LOTUS_V2_HEADER_CONTEXT_H
+#define LOTUS_V2_HEADER_CONTEXT_H
+#include "header.h"
+#include <optional>
+#include <string>
+#include <vector>
+namespace lotus::v2 {
+struct HeaderChainProfile {
+    ChainId chain_id{};
+    uint32_t version{};
+    uint64_t genesis_time{};
+    uint32_t genesis_bits{};
+    Hash pow_limit{};
+    int64_t half_life_seconds{};
+    int64_t spacing_seconds{};
+    // Exact manifest genesis. Zero permits synthetic module fixtures only;
+    // daemon initialization must require a nonzero anchor before opening state.
+    Hash genesis_id{};
+};
+// Authenticated history is newest first, includes parent, and contains exactly
+// min(parent.height+1,11) headers. Caller authenticates its oldest entry
+// against chain state; links within this window are checked here.
+std::optional<uint64_t> ParentMedianTime(const HeaderChainProfile &profile,
+                                         const Header &parent,
+                                         const std::vector<Header> &history);
+// Roots and size must be independently derived by the complete-block caller.
+// Failure does not mutate any chain state. Future eligibility remains separate.
+enum class HeaderCheckResult { Valid, Invalid, Inconclusive };
+HeaderCheckResult
+ValidateChildHeaderChecked(const HeaderChainProfile &, const Header &,
+                           const std::vector<Header> &, const Header &,
+                           const Hash &, const Hash &, uint64_t, std::string &);
+bool ValidateChildHeader(const HeaderChainProfile &profile,
+                         const Header &parent,
+                         const std::vector<Header> &history,
+                         const Header &child, const Hash &expected_tx_root,
+                         const Hash &expected_state_root,
+                         uint64_t expected_size, std::string &error);
+} // namespace lotus::v2
+#endif
