diff --git a/src/lotus_v2/monetary_test/check_reference.py b/src/lotus_v2/monetary_test/check_reference.py
new file mode 100644
index 0000000000..c6c71c0df5
--- /dev/null
+++ b/src/lotus_v2/monetary_test/check_reference.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Differential P05/P06/C16 arithmetic against the separate Python reference.
+
+Usage: check_reference.py NATIVE_TEST_EXE PATH_TO_lotus-v2-reference
+The reference source is supplied explicitly; no source is copied into this tree.
+"""
+import random
+import subprocess
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(sys.argv[2]).resolve()))
+from lotus_v2_reference.monetary import MonetaryState, OrdinaryTx, Profile, absolute_tail, advance
+
+P = Profile(2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000, 200, 9)
+rng = random.Random(0xC16A06)
+rows = []
+expected = []
+for _ in range(300):
+    reserve = rng.randrange(0, 1000)
+    prev_work = rng.randrange(1, 256)
+    tail = absolute_tail(P, prev_work)
+    if rng.randrange(5) == 0:
+        tail += 1  # Checked redundant-cache rejection.
+    ema = rng.randrange(0, 500)
+    work = rng.randrange(1, 256)
+    fee = rng.randrange(0, 800)
+    size = rng.randrange(1, 500)
+    tokens = rng.randrange(0, 5)
+    explicit_burn = rng.randrange(0, 100)
+    payout = rng.randrange(0, 2000)
+    cb_burn = rng.randrange(0, 100)
+    cb_bytes = rng.randrange(1, 500)
+    prefix = rng.randrange(1, 8)
+    account = rng.randrange(0, 70)
+    enforce = account + rng.randrange(-3, 70)
+    row = (reserve, tail, prev_work, ema, work, fee, size, tokens,
+           explicit_burn, payout, cb_burn, cb_bytes, prefix, account, enforce)
+    rows.append(row)
+    try:
+        tx = OrdinaryTx(fee + 100, 100, size, tokens, explicit_burn)
+        result = advance(P, MonetaryState(reserve, tail, prev_work, ema),
+                         work=work, transactions=(tx,),
+                         coinbase_native_outputs=payout,
+                         coinbase_native_burn=cb_burn,
+                         coinbase_bytes=cb_bytes,
+                         tx_frame_prefix_bytes=prefix,
+                         account_block_cost=account,
+                         enforce_block_cost=enforce)
+        expected.append(" ".join(map(str, (
+            result.state.bootstrap_reserve, result.state.tail_subsidy,
+            result.state.prev_work, result.state.ema_block_cost,
+            result.bootstrap_issued, result.subsidy, result.total_fees,
+            result.token_burn, result.burned_fees, result.required_underclaim,
+            result.actual_underclaim, result.spendable_supply_delta))))
+    except ValueError:
+        expected.append("ERR")
+
+input_text = "".join(" ".join(map(str, row)) + "\n" for row in rows)
+result = subprocess.run([sys.argv[1], "--vectors"], input=input_text,
+                        text=True, capture_output=True, check=True)
+actual = result.stdout.splitlines()
+assert len(actual) == len(expected), (len(actual), len(expected), result.stderr)
+for index, (got, want) in enumerate(zip(actual, expected)):
+    if got != want:
+        raise AssertionError(f"vector {index}: got {got!r}, want {want!r}; {rows[index]}")
+accepted = sum(value != "ERR" for value in expected)
+assert accepted >= 10, f"too few valid transitions: {accepted}"
+print(f"{len(rows)} Python/native monetary differential vectors passed ({accepted} accepted)")
diff --git a/src/lotus_v2/test_asert_candidate.cpp b/src/lotus_v2/test_asert_candidate.cpp
new file mode 100644
index 0000000000..3a2f02c860
--- /dev/null
+++ b/src/lotus_v2/test_asert_candidate.cpp
@@ -0,0 +1,181 @@
+// Copyright (c) 2026 The Lotus developers
+// Standalone P04 candidate checks. This does not start lotusd.
+#include "asert_candidate.h"
+
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+
+using namespace lotus::v2;
+
+namespace {
+
+// Working candidate supplied by the caller. Not a consensus global and
+// not written into chainparams. Half-life is two days; spacing is 120s.
+constexpr int64_t kWorkingCandidateHalfLifeSeconds = 172800;
+constexpr int64_t kWorkingCandidateSpacingSeconds = 120;
+
+void Check(bool ok, const char *message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+AsertInteger Factor(uint32_t fractional) {
+    const AsertInteger f = fractional;
+    const AsertInteger square = f * f;
+    const AsertInteger scaled = AsertInteger(195766423245049ull) * f +
+                                AsertInteger(971821376ull) * square +
+                                AsertInteger(5127ull) * square * f +
+                                (AsertInteger(1) << 47);
+    return AsertInteger(65536) + (scaled >> 48);
+}
+
+std::optional<AsertCandidateResult> Child(const AsertInteger &genesis_target,
+                                          uint64_t genesis_time,
+                                          const AsertInteger &pow_limit,
+                                          uint64_t parent_time,
+                                          uint64_t parent_height) {
+    return RequiredAsertCandidateBits(
+        kWorkingCandidateHalfLifeSeconds, kWorkingCandidateSpacingSeconds,
+        genesis_target, genesis_time, pow_limit,
+        AsertParent{parent_time, parent_height});
+}
+
+} // namespace
+
+int main() {
+    try {
+        const AsertInteger wide_limit = (AsertInteger(1) << 256) - 1;
+        const auto genesis = DecodeCompactTarget(0x1d00ffffu, wide_limit);
+        Check(genesis.has_value(), "decode development-genesis bits");
+        const AsertInteger genesis_target = *genesis;
+        Check(EncodeCompactTarget(genesis_target) == 0x1d00ffffu,
+              "development-genesis bits round-trip");
+        Check(genesis_target == (AsertInteger(0xffff) << 208),
+              "development-genesis target value");
+
+        const AsertInteger pow_limit = genesis_target;
+        constexpr uint64_t kGenesisTime = 1000000000;
+        const auto height_zero =
+            Child(genesis_target, kGenesisTime, pow_limit, kGenesisTime, 0);
+        Check(height_zero && height_zero->exponent == 0 &&
+                  height_zero->raw_target == genesis_target &&
+                  height_zero->clamped_target == genesis_target &&
+                  height_zero->bits == 0x1d00ffffu,
+              "height 0 at genesis time keeps T0");
+
+        constexpr uint64_t kHeight = 9;
+        const uint64_t on_schedule =
+            kGenesisTime +
+            static_cast<uint64_t>(kWorkingCandidateSpacingSeconds) * kHeight;
+        const auto scheduled =
+            Child(genesis_target, kGenesisTime, wide_limit, on_schedule, kHeight);
+        Check(scheduled && scheduled->exponent == 0 &&
+                  scheduled->raw_target == genesis_target &&
+                  scheduled->bits == 0x1d00ffffu,
+              "on-schedule parent keeps T0");
+
+        const uint64_t doubled_time =
+            kGenesisTime +
+            static_cast<uint64_t>(kWorkingCandidateHalfLifeSeconds);
+        const auto doubled =
+            Child(genesis_target, kGenesisTime, wide_limit, doubled_time, 0);
+        Check(doubled && doubled->exponent == 65536 && doubled->quotient == 1 &&
+                  doubled->fractional == 0 &&
+                  doubled->raw_target == genesis_target * 2 &&
+                  doubled->clamped_target == genesis_target * 2 &&
+                  doubled->bits == 0x1d01fffeu,
+              "exact +half-life doubles before compact rounding");
+        const auto clamped_double =
+            Child(genesis_target, kGenesisTime, pow_limit, doubled_time, 0);
+        Check(clamped_double && clamped_double->raw_target == genesis_target * 2 &&
+                  clamped_double->clamped_target == pow_limit &&
+                  clamped_double->bits == 0x1d00ffffu,
+              "exact +half-life clamps at pow_limit");
+
+        const uint64_t halved_time =
+            kGenesisTime -
+            static_cast<uint64_t>(kWorkingCandidateHalfLifeSeconds);
+        const auto halved =
+            Child(genesis_target, kGenesisTime, pow_limit, halved_time, 0);
+        Check(halved && halved->exponent == -65536 && halved->quotient == -1 &&
+                  halved->fractional == 0 &&
+                  halved->raw_target == genesis_target / 2 &&
+                  halved->clamped_target == genesis_target / 2 &&
+                  halved->bits == 0x1c7fff80u,
+              "exact -half-life halves the target");
+
+        // parent.time < genesis time. Unsigned subtraction would wrap.
+        constexpr uint64_t kEarlierParent = kGenesisTime - 3;
+        const auto negative = Child(genesis_target, kGenesisTime, wide_limit,
+                                    kEarlierParent, 0);
+        const AsertInteger negative_raw = (genesis_target * Factor(65535)) >> 17;
+        Check(negative && negative->exponent == -1 && negative->quotient == -1 &&
+                  negative->fractional == 65535 &&
+                  negative->raw_target == negative_raw &&
+                  negative->clamped_target == negative_raw &&
+                  negative_raw > 1 && negative_raw < genesis_target,
+              "negative fractional exponent keeps f in 0..65535");
+
+        constexpr uint64_t kAnchorHeight = 4;
+        const uint64_t anchor_time =
+            kGenesisTime +
+            static_cast<uint64_t>(kWorkingCandidateSpacingSeconds) * kAnchorHeight -
+            3;
+        const auto anchored = Child(genesis_target, kGenesisTime, wide_limit,
+                                    anchor_time, kAnchorHeight);
+        const int64_t time_diff = static_cast<int64_t>(anchor_time) -
+                                  static_cast<int64_t>(kGenesisTime);
+        const int64_t height_diff = static_cast<int64_t>(kAnchorHeight) - 1;
+        const int64_t historical_exponent =
+            ((time_diff - kWorkingCandidateSpacingSeconds * (height_diff + 1)) *
+             65536) /
+            kWorkingCandidateHalfLifeSeconds;
+        Check(anchored && height_diff >= 0 &&
+                  anchored->exponent == historical_exponent &&
+                  anchored->quotient == -1 && anchored->fractional == 65535,
+              "height >= 1 matches the historical exponent anchor");
+
+        const auto minimum = Child(genesis_target, kGenesisTime, pow_limit,
+                                   kGenesisTime,
+                                   std::numeric_limits<uint64_t>::max());
+        Check(minimum && minimum->raw_target == 0 &&
+                  minimum->clamped_target == 1 && minimum->bits == 0x01010000u,
+              "large negative drift clamps to target 1");
+
+        const auto saturated =
+            Child(genesis_target, 0, pow_limit,
+                  std::numeric_limits<uint64_t>::max(), 0);
+        Check(saturated && saturated->quotient - 16 >= 256 &&
+                  saturated->raw_target == pow_limit &&
+                  saturated->clamped_target == pow_limit &&
+                  saturated->bits == 0x1d00ffffu,
+              "large positive drift saturates without a giant shift");
+
+        const AsertInteger awkward(0x800001);
+        Check(EncodeCompactTarget(awkward) == 0x04008000u,
+              "compact rounding drops the low byte");
+        const auto rounded = DecodeCompactTarget(0x04008000u, awkward);
+        Check(rounded && *rounded == 0x800000 &&
+                  EncodeCompactTarget(*rounded) == 0x04008000u,
+              "rounded compact bits round-trip");
+        Check(!DecodeCompactTarget(0x1d80ffffu, wide_limit), "reject sign bit");
+        Check(!DecodeCompactTarget(0x1d000000u, wide_limit), "reject zero");
+        Check(!DecodeCompactTarget(0x22010000u, wide_limit),
+              "reject overflow beyond 256 bits");
+        Check(!DecodeCompactTarget(0x03000001u, wide_limit),
+              "reject noncanonical compact");
+        Check(!DecodeCompactTarget(0x1d00ffffu, AsertInteger(1)),
+              "reject target above pow_limit");
+        Check(!RequiredAsertCandidateBits(0, kWorkingCandidateSpacingSeconds,
+                                          genesis_target, kGenesisTime, pow_limit,
+                                          AsertParent{kGenesisTime, 0}),
+              "reject a non-positive half-life");
+
+        std::cout << "V2 ASERT candidate checks passed\n";
+        return 0;
+    } catch (const std::exception &error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lotus_v2/test_header.cpp b/src/lotus_v2/test_header.cpp
new file mode 100644
index 0000000000..07a7ee7993
--- /dev/null
+++ b/src/lotus_v2/test_header.cpp
@@ -0,0 +1,166 @@
+#include "header.h"
+#include "arith_uint256.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <string>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool condition, const char *message) {
+    if (!condition) {
+        std::cerr << "V2 header: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+std::string Hex(const uint8_t *data, size_t size) {
+    constexpr char chars[] = "0123456789abcdef";
+    std::string result;
+    for (size_t i = 0; i < size; ++i) {
+        result.push_back(chars[data[i] >> 4]);
+        result.push_back(chars[data[i] & 15]);
+    }
+    return result;
+}
+
+std::string Hex(const Hash &hash) { return Hex(hash.data(), hash.size()); }
+} // namespace
+
+int main() {
+    // These constants were computed independently with Python blake3 1.0.11,
+    // not by the vendored C implementation under test.
+    ChainId chain_id;
+    Header header;
+    for (unsigned i = 0; i < 32; ++i) {
+        chain_id[i] = i;
+        header.prev_id[i] = i + 32;
+        header.tx_root[i] = i + 64;
+        header.state_root[i] = i + 96;
+    }
+    header.bits = 0x1d00ffff;
+    header.time = 0x010203040506;
+    header.nonce = 0x08090a0b0c0d0e0f;
+    header.version = 2;
+    header.size = 0x1122334455667788;
+    header.height = 0x99aabbccddeeff00;
+    std::array<uint8_t, HEADER_SIZE> bytes;
+    Check(SerializeHeader(header, bytes), "serialize normal header");
+    Check(Hex(bytes.data(), bytes.size()) ==
+              "202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"
+              "ffff001d0605040302010f0e0d0c0b0a0908020000008877665544332211"
+              "00ffeeddccbbaa99404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f"
+              "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f",
+          "exact 134-byte encoding and offsets");
+    Header parsed;
+    parsed.version = 0xdeadbeef;
+    Check(!ParseHeader(bytes.data(), bytes.size() - 1, parsed), "reject short header");
+    Check(parsed.version == 0xdeadbeef, "short parse leaves output unchanged");
+    Check(!ParseHeader(bytes.data(), bytes.size() + 1, parsed), "reject trailing bytes");
+    Check(!ParseHeader(nullptr, bytes.size(), parsed), "reject null data");
+    Check(ParseHeader(bytes.data(), bytes.size(), parsed), "parse header");
+    std::array<uint8_t, HEADER_SIZE> repeated;
+    Check(SerializeHeader(parsed, repeated) && bytes == repeated, "round trip");
+    Check(Hex(BodyHash(chain_id, header)) ==
+              "1704e11edcbc47eb829d210ac1affb606dd4021c82305e07a028962456efec3d",
+          "independent BodyHash vector");
+    Hash work;
+    Hash id;
+    Check(WorkHash(chain_id, header, work) && Hex(work) ==
+              "56c49269bcb4709b42d48312a382badc0906162e5bd6e49aac48a7096288ffd1",
+          "independent WorkHash vector");
+    Check(BlockId(chain_id, header, id) && Hex(id) ==
+              "fbe9243579627fc3a41043c80395d33a8a01b91a9b86b6c6e629530595c83370",
+          "independent BlockID vector");
+    header.nonce++;
+    Check(WorkHash(chain_id, header, work) && Hex(work) ==
+              "3df1f29ca207e25132c7b3fdddfae0163b16d0c6bf7488e2810858e84f0673e5",
+          "nonce mutation WorkHash");
+    Check(BlockId(chain_id, header, id) && Hex(id) ==
+              "8a967f4522d06f683830cf003b9f456001e045f617bf4d4336754a91c75f5824",
+          "nonce mutation BlockID");
+    header.nonce = UINT64_MAX;
+    Check(BlockId(chain_id, header, id) && Hex(id) ==
+              "ce606e015b769cf60502917d0bac3597048e25668c7df323f817b53969aab371",
+          "maximum nonce BlockID");
+    const Hash old_body = BodyHash(chain_id, header);
+    chain_id[0]++;
+    Check(BodyHash(chain_id, header) != old_body, "ChainID enters BodyHash");
+    chain_id[0]--;
+    header.time = MAX_TIME;
+    Check(SerializeHeader(header, bytes) && bytes[41] == 0xff, "maximum u48 time");
+    header.time++;
+    bytes[0] = 0xa5;
+    Check(!SerializeHeader(header, bytes), "reject u48 overflow in encoding");
+    Check(bytes[0] == 0xa5, "failed encoding leaves output unchanged");
+    work.fill(0xa5);
+    Check(!WorkHash(chain_id, header, work), "reject u48 overflow in work hash");
+    Check(work[0] == 0xa5 && work[31] == 0xa5, "failed work hash leaves output unchanged");
+    id.fill(0xa5);
+    Check(!BlockId(chain_id, header, id), "reject u48 overflow in block ID");
+    Check(id[0] == 0xa5 && id[31] == 0xa5, "failed block hash leaves output unchanged");
+
+    Hash pow_limit{};
+    pow_limit[31] = 0xff;
+    Hash target{};
+    Check(DecodeTarget(0x1d00ffff, pow_limit, target), "Bitcoin-style canonical target");
+    Check(target[26] == 0xff && target[27] == 0xff && target[28] == 0,
+          "compact target byte placement");
+    Check(!DecodeTarget(0x1d80ffff, pow_limit, target), "reject sign bit");
+    Check(!DecodeTarget(0x1d000000, pow_limit, target), "reject zero");
+    Check(!DecodeTarget(0x22010000, pow_limit, target), "reject 257-bit overflow");
+    Check(!DecodeTarget(0x03000001, pow_limit, target), "reject noncanonical compact");
+    Hash low_limit{};
+    low_limit[0] = 1;
+    Check(!DecodeTarget(0x1d00ffff, low_limit, target), "enforce supplied POW_LIMIT");
+    Hash equal = target;
+    Check(MeetsTarget(equal, target), "target equality accepted");
+    equal[0]++;
+    Check(!MeetsTarget(equal, target), "target plus one rejected");
+    equal = target;
+    for (size_t i = 0; i < equal.size(); ++i) {
+        if (equal[i]-- != 0) break;
+    }
+    Check(MeetsTarget(equal, target), "target minus one accepted");
+
+    // Differential compact parsing against ABC's arithmetic representation.
+    // Cover every exponent and representative mantissa/sign/rounding classes.
+    const uint32_t mantissas[] = {0, 1, 0x7f, 0x80, 0xff, 0x100,
+                                  0xffff, 0x10000, 0x7fffff,
+                                  0x800001, 0xffffff};
+    const Hash limits[] = {pow_limit, low_limit};
+    for (const Hash &limit : limits) {
+        for (uint32_t exponent = 0; exponent < 256; ++exponent) {
+            for (uint32_t mantissa : mantissas) {
+                const uint32_t compact = (exponent << 24) | mantissa;
+                arith_uint256 reference;
+                bool negative = false;
+                bool overflow = false;
+                reference.SetCompact(compact, &negative, &overflow);
+                Hash reference_bytes{};
+                for (unsigned i = 0; i < 32; ++i) {
+                    reference_bytes[i] = static_cast<uint8_t>((reference >> (8 * i)).GetLow64());
+                }
+                const bool expected = (compact & 0x00800000U) == 0 &&
+                                      !negative && !overflow && reference != 0 &&
+                                      reference.GetCompact() == compact &&
+                                      MeetsTarget(reference_bytes, limit);
+                Hash actual;
+                actual.fill(0xa5);
+                const bool accepted = DecodeTarget(compact, limit, actual);
+                Check(accepted == expected, "ABC compact differential acceptance");
+                if (accepted) {
+                    Check(actual == reference_bytes, "ABC compact differential value");
+                } else {
+                    Check(std::all_of(actual.begin(), actual.end(),
+                                      [](uint8_t byte) { return byte == 0xa5; }),
+                          "failed target decoding leaves output unchanged");
+                }
+            }
+        }
+    }
+    std::cout << "V2 header primitive vectors and boundaries passed\n";
+}
diff --git a/src/lotus_v2/test_header_boundary.cpp b/src/lotus_v2/test_header_boundary.cpp
new file mode 100644
index 0000000000..b56b40ebec
--- /dev/null
+++ b/src/lotus_v2/test_header_boundary.cpp
@@ -0,0 +1,224 @@
+#include "header.h"
+#include "sparse_state.h"
+
+#include <primitives/block.h>
+#include <streams.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+
+using namespace lotus::v2;
+
+namespace {
+void Check(bool condition, const char *message) {
+    if (!condition) {
+        std::cerr << "V2 header boundary: " << message << '\n';
+        std::exit(1);
+    }
+}
+
+bool NonZero(const Hash &hash) {
+    return std::any_of(hash.begin(), hash.end(),
+                       [](uint8_t byte) { return byte != 0; });
+}
+
+bool Same(const Header &a, const Header &b) {
+    return a.prev_id == b.prev_id && a.bits == b.bits && a.time == b.time &&
+           a.nonce == b.nonce && a.version == b.version && a.size == b.size &&
+           a.height == b.height && a.tx_root == b.tx_root &&
+           a.state_root == b.state_root;
+}
+} // namespace
+
+int main() {
+    // Distinct nonzero fields, so a zero or repeated encoding cannot pass.
+    ChainId chain_id;
+    Header header;
+    for (unsigned i = 0; i < 32; ++i) {
+        chain_id[i] = static_cast<uint8_t>(i + 1);
+        header.prev_id[i] = static_cast<uint8_t>(i + 32);
+        header.tx_root[i] = static_cast<uint8_t>(i + 64);
+        header.state_root[i] = static_cast<uint8_t>(i + 96);
+    }
+    header.bits = 0x1d00ffff;
+    header.time = 0x010203040506;
+    header.nonce = 0x08090a0b0c0d0e0f;
+    header.version = 2;
+    header.size = 0x1122334455667788;
+    header.height = 0x99aabbccddeeff00;
+    Check(NonZero(chain_id) && NonZero(header.prev_id) &&
+              NonZero(header.tx_root) && NonZero(header.state_root),
+          "hash fields are nonzero");
+    Check(header.prev_id != header.tx_root &&
+              header.tx_root != header.state_root &&
+              header.prev_id != header.state_root && chain_id != header.prev_id,
+          "hash fields are distinct");
+    Check(header.bits != 0 && header.time != 0 && header.nonce != 0 &&
+              header.version != 0 && header.size != 0 && header.height != 0,
+          "scalar fields are nonzero");
+    Check(header.bits != header.version && header.time != header.nonce &&
+              header.size != header.height && header.time != header.size,
+          "scalar fields are distinct");
+
+    std::array<uint8_t, HEADER_SIZE> bytes{};
+    Check(SerializeHeader(header, bytes), "serialize V2 header");
+    const std::vector<uint8_t> encoded(bytes.begin(), bytes.end());
+    Check(encoded.size() == 134, "serialized V2 header is 134 bytes");
+
+    // CBlockHeader now represents the 134-byte Lotus V2 header.
+    SetActiveV2ChainId(chain_id);
+    CBlockHeader v2_block_hdr;
+    SpanReader reader{encoded};
+    bool read_failed = false;
+    try {
+        reader >> v2_block_hdr;
+    } catch (const std::ios_base::failure &) {
+        read_failed = true;
+    }
+
+    Check(!read_failed, "CBlockHeader reads 134-byte V2 header");
+    const size_t remainder = reader.size();
+    const size_t consumed = encoded.size() - remainder;
+    Check(consumed == 134, "CBlockHeader consumed all 134 bytes");
+    Check(remainder == 0, "CBlockHeader left 0 remainder bytes");
+    Check(Same(v2_block_hdr.ToV2Header(), header),
+          "CBlockHeader round-trips all V2 header fields");
+
+    const BlockHash hdr_hash = v2_block_hdr.GetHash();
+    Hash v2_id{};
+    Check(BlockId(chain_id, header, v2_id), "V2 header id");
+    Check(hdr_hash.size() == v2_id.size(), "both ids are 32 bytes");
+    Check(std::equal(v2_id.begin(), v2_id.end(), hdr_hash.begin()),
+          "CBlockHeader hash matches V2 header id");
+    SetActiveV2ChainId(ChainId{});
+
+    Header parsed;
+    parsed.version = 0xdeadbeef;
+    Check(ParseHeader(encoded.data(), encoded.size(), parsed),
+          "V2 parser accepts the 134-byte encoding");
+    Check(Same(parsed, header), "V2 parser returns the original fields");
+
+    Header untouched;
+    untouched.prev_id.fill(0xa5);
+    untouched.tx_root.fill(0x5a);
+    untouched.state_root.fill(0x3c);
+    untouched.bits = 0xa5a5a5a5u;
+    untouched.time = 0x010203040506;
+    untouched.nonce = 0x1112131415161718ull;
+    untouched.version = 0xdeadbeef;
+    untouched.size = 0x2222222222222222ull;
+    untouched.height = 0x3333333333333333ull;
+    const Header before = untouched;
+    std::array<uint8_t, 133> truncated{};
+    std::copy_n(encoded.begin(), truncated.size(), truncated.begin());
+    Check(truncated.size() == 133, "truncated buffer is 133 bytes");
+    Check(!ParseHeader(truncated.data(), truncated.size(), untouched),
+          "V2 parser rejects a 133-byte buffer");
+    Check(Same(untouched, before),
+          "failed V2 parse leaves the output unchanged");
+
+    // Verify CTransaction v7 wire serialization and TxId/TxHash match Lotus V2.
+    SetActiveV2ChainId(chain_id);
+    Transaction v2_tx;
+    v2_tx.lock = (42ULL << 8) | 1ULL;
+    Input v2_in;
+    v2_in.prev_txid = header.prev_id;
+    v2_in.prev_index = 1;
+    v2_in.sequence = 0xffffffffU;
+    v2_in.flags = 1;
+    v2_in.path_index = 0;
+    BranchWitness wit;
+    wit.script = {0x4e};
+    wit.arguments = {{0x01, 0x02}};
+    v2_in.witnesses = {wit};
+    v2_tx.inputs = {v2_in};
+    Output v2_out;
+    v2_out.flags = 0;
+    v2_out.value = 1000;
+    v2_out.branches = {BranchLeaf(std::vector<uint8_t>{0x4e})};
+    v2_out.paths = {{0}};
+    v2_tx.outputs = {v2_out};
+    std::vector<uint8_t> tx_wire;
+    std::string tx_err;
+    Check(EncodeTransaction(v2_tx, DefaultTxProfile, tx_wire, tx_err),
+          "EncodeTransaction succeeds");
+    SpanReader tx_reader{tx_wire};
+    CTransaction ctx(deserialize, tx_reader);
+    Check(tx_reader.size() == 0, "CTransaction consumed full V2 v7 wire");
+    Hash32 exp_txid{}, exp_txhash{};
+    Check(ComputeTransactionIdentities(v2_tx, DefaultTxProfile, chain_id,
+                                       exp_txid, exp_txhash, tx_err),
+          "ComputeTransactionIdentities succeeds");
+    Check(std::equal(exp_txid.begin(), exp_txid.end(), ctx.GetId().begin()),
+          "CTransaction::GetId matches V2 TxId");
+    Check(std::equal(exp_txhash.begin(), exp_txhash.end(),
+                     ctx.GetHash().begin()),
+          "CTransaction::GetHash matches V2 TxHash");
+    Check(ctx.GetId() != ctx.GetHash(),
+          "CTransaction::GetId and GetHash are distinct for spend with witness args");
+
+    // Verify 64-bit V2 lock round-trips losslessly even when kind/value crosses
+    // legacy 500000000 or 32-bit boundaries.
+    for (uint64_t test_lock : {0ULL, (600000000ULL << 8) | 1ULL,
+                               (123ULL << 8) | 2ULL,
+                               (0x123456789abcULL << 8) | 1ULL}) {
+        Transaction lock_tx = v2_tx;
+        lock_tx.lock = test_lock;
+        std::vector<uint8_t> lock_wire;
+        Check(EncodeTransaction(lock_tx, DefaultTxProfile, lock_wire, tx_err),
+              "EncodeTransaction for lock test succeeds");
+        SpanReader lock_reader{lock_wire};
+        CTransaction lock_ctx(deserialize, lock_reader);
+        Check(lock_ctx.ToV2Transaction().lock == test_lock,
+              "CTransaction preserves full 64-bit V2 lock");
+        std::vector<uint8_t> reencoded_bytes;
+        VectorWriter reencoder{reencoded_bytes, 0};
+        reencoder << lock_ctx;
+        Check(reencoded_bytes == lock_wire,
+              "CTransaction re-serializes identical V2 wire bytes");
+    }
+
+    // Verify CTxIn::operator== and CTxOut::operator== compare V2 fields.
+    CTxIn in_a = ctx.vin[0];
+    CTxIn in_b = ctx.vin[0];
+    Check(in_a == in_b, "identical CTxIn compare equal");
+    in_b.vWitnesses[0].arguments = {{0x99}};
+    Check(in_a != in_b, "CTxIn::operator== detects vWitnesses difference");
+
+    CTxOut out_a = ctx.vout[0];
+    CTxOut out_b = ctx.vout[0];
+    Check(out_a == out_b, "identical CTxOut compare equal");
+    out_b.vPaths = {};
+    Check(out_a != out_b, "CTxOut::operator== detects vPaths difference");
+
+    // Verify EncodeCoin / DecodeCoinBytes lossless roundtrip for UtxoSet persistence.
+    lotus::v2::Coin v2_coin;
+    v2_coin.outpoint = {header.prev_id, 3};
+    v2_coin.output = v2_out;
+    v2_coin.creation_height = 42;
+    v2_coin.creation_parent_mtp = 1700000000ULL;
+    v2_coin.coinbase = true;
+    std::vector<uint8_t> coin_bytes;
+    Check(EncodeCoin(v2_coin, coin_bytes), "EncodeCoin succeeds");
+    lotus::v2::Coin decoded_coin;
+    Check(DecodeCoinBytes(coin_bytes, decoded_coin), "DecodeCoinBytes succeeds");
+    Check(decoded_coin.outpoint == v2_coin.outpoint &&
+              decoded_coin.output.flags == v2_coin.output.flags &&
+              decoded_coin.output.value == v2_coin.output.value &&
+              decoded_coin.output.branches == v2_coin.output.branches &&
+              decoded_coin.output.paths == v2_coin.output.paths &&
+              decoded_coin.creation_height == v2_coin.creation_height &&
+              decoded_coin.creation_parent_mtp == v2_coin.creation_parent_mtp &&
+              decoded_coin.coinbase == v2_coin.coinbase,
+          "DecodeCoinBytes round-trips all Coin fields");
+
+    SetActiveV2ChainId(ChainId{});
+
+    std::cout << "V2 header boundary: serialized " << encoded.size()
+              << " bytes; CBlockHeader consumed " << consumed
+              << " and matched V2 header id; CTransaction v7 round-trip passed\n";
+    return 0;
+}
diff --git a/src/lotus_v2/test_header_context.cpp b/src/lotus_v2/test_header_context.cpp
new file mode 100644
index 0000000000..4bad1986ac
--- /dev/null
+++ b/src/lotus_v2/test_header_context.cpp
@@ -0,0 +1,127 @@
+#include "asert_candidate.h"
+#include "header_context.h"
+#include <iostream>
+#include <stdexcept>
+using namespace lotus::v2;
+void Check(bool b, const char *message = "header context regression") {
+    if (!b) throw std::runtime_error(message);
+}
+int main() {
+    HeaderChainProfile p;
+    p.version = 2;
+    p.genesis_time = 1000;
+    p.genesis_bits = 0x207fffff;
+    p.pow_limit.fill(255);
+    p.half_life_seconds = 172800;
+    p.spacing_seconds = 120;
+    std::vector<Header> history;
+    for (uint64_t height = 0; height < 12; ++height) {
+        Header h;
+        h.version = 2;
+        h.height = height;
+        h.bits = p.genesis_bits;
+        h.time = height < 11 ? 1000 + 120 * height : 5000;
+        h.size = 200;
+        if (!history.empty())
+            Check(BlockId(p.chain_id, history.front(), h.prev_id));
+        Hash history_target{}, history_id{};
+        Check(DecodeTarget(h.bits, p.pow_limit, history_target));
+        do {
+            Check(BlockId(p.chain_id, h, history_id));
+            if (MeetsTarget(history_id, history_target)) break;
+            ++h.nonce;
+        } while (true);
+        history.insert(history.begin(), h);
+    }
+    history.resize(11);
+    Check(ParentMedianTime(p, history.front(), history) == 1720);
+    Header child;
+    child.version = 2;
+    child.height = 12;
+    child.size = 200;
+    child.time = 2400;
+    Check(BlockId(p.chain_id, history.front(), child.prev_id));
+    AsertInteger limit = (AsertInteger(1) << 256) - 1;
+    auto genesis = DecodeCompactTarget(p.genesis_bits, limit);
+    child.bits = RequiredAsertCandidateBits(172800, 120, *genesis, 1000, limit,
+                                            {5000, 11})
+                     ->bits;
+    Hash target{}, id{};
+    Check(DecodeTarget(child.bits, p.pow_limit, target));
+    do {
+        Check(BlockId(p.chain_id, child, id));
+        if (MeetsTarget(id, target)) break;
+        ++child.nonce;
+    } while (true);
+    std::string error;
+    auto valid = [&](const Header &h) {
+        return ValidateChildHeader(p, history.front(), history, h, Hash{},
+                                   Hash{}, 200, error);
+    };
+    Check(valid(child), "child earlier than parent and above MTP must pass");
+    for (int mutation = 0; mutation < 9; ++mutation) {
+        auto h = child;
+        switch (mutation) {
+            case 0:
+                h.time = 1720;
+                break;
+            case 1:
+                ++h.height;
+                break;
+            case 2:
+                ++h.version;
+                break;
+            case 3:
+                h.bits = p.genesis_bits;
+                break;
+            case 4:
+                ++h.size;
+                break;
+            case 5:
+                h.tx_root[0] = 1;
+                break;
+            case 6:
+                h.state_root[0] = 1;
+                break;
+            case 7:
+                h.prev_id[0] ^= 1;
+                break;
+            case 8:
+                h.time = MAX_TIME + 1;
+                break;
+        }
+        const char *cases[] = {
+            "time equal to MTP",   "wrong height", "wrong version",
+            "wrong required bits", "wrong size",   "wrong transaction root",
+            "wrong state root",    "wrong parent", "timestamp overflow"};
+        Check(!valid(h), cases[mutation]);
+    }
+    auto bad_work = child;
+    do {
+        ++bad_work.nonce;
+        Check(BlockId(p.chain_id, bad_work, id));
+    } while (MeetsTarget(id, target));
+    Check(!valid(bad_work), "insufficient proof of work must reject");
+    history.pop_back();
+    Check(!ParentMedianTime(p, history.front(), history));
+    Header genesis_header;
+    genesis_header.version = 2;
+    genesis_header.time = 1000;
+    genesis_header.bits = p.genesis_bits;
+    Check(ParentMedianTime(p, genesis_header, {genesis_header}) == 1000);
+    Check(BlockId(p.chain_id, genesis_header, p.genesis_id));
+    Check(ParentMedianTime(p, genesis_header, {genesis_header}) == 1000,
+          "exact manifest genesis accepted");
+    auto other_genesis = genesis_header;
+    other_genesis.state_root[0] ^= 1;
+    Check(!ParentMedianTime(p, other_genesis, {other_genesis}),
+          "same time and target cannot substitute another genesis state");
+    auto wrong_anchor = p;
+    wrong_anchor.genesis_id[0] ^= 1;
+    Check(!ParentMedianTime(wrong_anchor, genesis_header, {genesis_header}),
+          "different manifest genesis rejected");
+    Check(!RequiredAsertCandidateBits(172800, 0, *genesis, 1000, limit,
+                                      {1000, 0}),
+          "zero spacing must reject: native formerly accepted unlike Python");
+    std::cout << "header context checks passed\n";
+}
diff --git a/src/lotus_v2/test_monetary.cpp b/src/lotus_v2/test_monetary.cpp
new file mode 100644
index 0000000000..957dc48d8e
--- /dev/null
+++ b/src/lotus_v2/test_monetary.cpp
@@ -0,0 +1,265 @@
+#include "monetary.h"
+
+#include <cstdlib>
+#include <functional>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+
+using namespace lotus::v2;
+using Int = MonetaryInteger;
+
+namespace {
+void Check(bool ok, const char *message) {
+    if (!ok) throw std::runtime_error(message);
+}
+void Reject(const std::function<void()> &fn, const char *message) {
+    try { fn(); } catch (const std::invalid_argument &) { return; }
+    throw std::runtime_error(message);
+}
+const MonetaryProfile P{2, 3, 2, 4, 3, 5, 2, 2000, 3, 1000, 200, Hash{9}};
+MonetaryState State(uint64_t reserve, uint64_t tail, Int work, uint64_t ema) {
+    Hash bytes{};
+    for (auto &byte : bytes) {
+        byte = static_cast<uint8_t>((work & 255).convert_to<unsigned>());
+        work >>= 8;
+    }
+    return {reserve, tail, bytes, ema};
+}
+MonetaryTransition Step(const MonetaryState &parent,
+                        const std::vector<MonetaryOrdinaryTx> &txs = {},
+                        Int payout = 0, Int cb_burn = 0,
+                        Int account = 4, Int enforce = 4, Int work = 9) {
+    return AdvanceMonetary(P, parent, work, txs, payout, cb_burn,
+                           1, 1, account, enforce);
+}
+void HandCalculated() {
+    MonetaryState state = InitializeMonetaryGenesis(P, State(9, 200, 9, 4), 0);
+    auto wire = EncodeMonetaryState(state);
+    Check(wire[0] == 9 && wire[8] == 200 && wire[16] == 9 &&
+          wire[48] == 4, "state wire positions");
+    auto decoded = DecodeMonetaryState({wire.begin(), wire.end()});
+    Check(decoded.bootstrap_reserve == 9 && decoded.tail_subsidy == 200 &&
+          decoded.prev_work[0] == 9 && decoded.ema_block_cost == 4,
+          "state wire roundtrip");
+    Reject([&] { InitializeMonetaryGenesis(P, state, 1); }, "genesis issuance");
+    Reject([&] { DecodeMonetaryState(std::vector<uint8_t>(55)); }, "short state");
+    auto block1 = Step(state);
+    Check(block1.bootstrap_issued == 2 && block1.subsidy == 202 &&
+          block1.state.bootstrap_reserve == 7 && block1.state.tail_subsidy == 200,
+          "height-one recurrence");
+    uint64_t reserve = 9, issued = 0;
+    while (reserve) {
+        uint64_t b = std::max<uint64_t>(1, reserve >> 2);
+        reserve -= b;
+        issued += b;
+    }
+    Check(issued == 9, "telescoping reserve");
+    Check(Step(State(0, 200, 9, 4)).bootstrap_issued == 0, "empty reserve");
+    Check(Step(state, {}, 0, 0, 4, 4, 1).state.tail_subsidy == 66,
+          "tail low rounding");
+    Check(Step(state, {}, 0, 0, 4, 4, 18).state.tail_subsidy == 282,
+          "tail isqrt rounding");
+    Check(Step(state, {}, 0, 0, 4, 4, (Int(1) << 256) - 1)
+              .state.tail_subsidy == 2000, "tail maximum clamp");
+    Check(AbsoluteTail(P, 10) == 210 && AbsoluteTail(P, 9) == 200,
+          "absolute rounding returns to anchor");
+    auto upper = P; upper.tail_max = 300;
+    Check(AbsoluteTail(upper, 36) == 300 && AbsoluteTail(upper, 9) == 200,
+          "upper clipping recovery");
+    auto lower = P; lower.tail_min = 180;
+    Check(AbsoluteTail(lower, 1) == 180 && AbsoluteTail(lower, 9) == 200,
+          "lower clipping recovery");
+    auto wide = P; wide.genesis_tail = UINT64_MAX; wide.tail_max = UINT64_MAX;
+    wide.genesis_work = Hash{1};
+    Check(AbsoluteTail(wide, (Int(1) << 256) - 1) == UINT64_MAX,
+          "wide numerator clamps before narrowing");
+    auto zero = P; zero.genesis_work = {};
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero genesis anchor");
+    zero = P; zero.genesis_tail = 0;
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero genesis tail");
+    zero = P; zero.tail_min = 0;
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero tail lower bound");
+    zero.genesis_tail = 0;
+    Reject([&] { AbsoluteTail(zero, 9); }, "zero lower bound and anchor");
+    auto smallest = P; smallest.tail_min = 1; smallest.genesis_tail = 1;
+    smallest.genesis_work = Hash{1};
+    Check(AbsoluteTail(smallest, 1) == 1, "positive minimum anchor accepted");
+    Reject([&] { Step(State(9, 199, 9, 4)); }, "tampered cached tail");
+    Reject([&] { InitializeMonetaryGenesis(P, State(9, 201, 9, 4), 0); },
+           "initial anchor mismatch");
+    auto saturated = Step(state, {}, 0, 0, 4, 4, (Int(1) << 256) - 1);
+    auto returned = Step(saturated.state);
+    Check(returned.subsidy == 2001 && returned.state.tail_subsidy == 200,
+          "lag and return from saturation");
+    Check(TransactionEffectiveCost(3, P) == 4 &&
+          TransactionEffectiveCost(4, P) == 6 &&
+          BlockEffectiveCost(5, {3, 4}, P) == 15 &&
+          RequiredBlockBurn(8, 4, P) == 6, "P05 parabolic algebra");
+    auto base = Step(State(9, 200, 9, 8), {}, 0, 0, 8, 8);
+    auto strict = Step(State(9, 200, 9, 8), {}, 0, 0, 8, 64);
+    Check(base.state.ema_block_cost == 8 && strict.state.ema_block_cost == 8 &&
+          strict.required_underclaim > base.required_underclaim,
+          "frozen accounting versus enforcement");
+    MonetaryOrdinaryTx tx{100, 87, 10, 1, 2};
+    auto result = Step(state, {tx}, 60);
+    Check(result.subsidy == 202 && result.total_fees == 13 &&
+          result.token_burn == 6 && result.burned_fees == 4 &&
+          result.required_underclaim == 140 &&
+          result.actual_underclaim == 145 &&
+          result.spendable_supply_delta == 45, "odd fee and token burn once");
+    auto explicit_coinbase = Step(state, {tx}, 60, 10);
+    auto extra_underclaim = Step(state, {tx}, 50);
+    Check(explicit_coinbase.spendable_supply_delta ==
+          extra_underclaim.spendable_supply_delta &&
+          explicit_coinbase.actual_underclaim == 145,
+          "explicit burn versus underclaim");
+    Reject([&] { Step(state, {tx}, 66); }, "coinbase overclaim");
+    Reject([&] { Step(state, {tx}, 66, 66); },
+           "explicit burn cannot fund mandatory underclaim");
+    Reject([&] { Step(State(0, 2, 1, 0)); }, "insufficient entitlement");
+    Reject([&] { Step(state, {}, 0, 0, 8, 7); },
+           "enforcement below frozen accounting");
+    Reject([&] { Step(state, {}, 0, 0, 4, 4, 0); }, "zero work");
+    Reject([&] { Step(State(0, 200, 0, 0)); }, "zero previous work");
+    Reject([&] { Step(State(0, 200, 1, std::numeric_limits<uint64_t>::max()),
+                     {}, 0, 0, (Int(1) << 128) - 1, (Int(1) << 128) - 1); },
+           "EMA overflow");
+    Reject([&] { TransactionEffectiveCost(std::numeric_limits<uint64_t>::max(), P); },
+           "transaction effective cost overflow");
+    Reject([&] { BlockEffectiveCost((Int(1) << 128) - 1, {1}, P); },
+           "block u128 sum overflow");
+    auto two_max = Step(State(0, 66, 1, 0),
+        {{2 * ((Int(1) << 64) - 1), 0, 1, 0, 0}});
+    Check(two_max.total_fees == 2 * ((Int(1) << 64) - 1),
+          "u128 fee aggregate above u64");
+    Reject([&] { Step(State(0, 66, 1, 0),
+        {{(Int(1) << 128) - 1, 0, 1, 0, 0},
+         {(Int(1) << 128) - 1, 0, 1, 0, 0}}); },
+        "aggregate fee overflow");
+    Reject([&] { Step(state, {{10, 5, 1, 0, 6}}); },
+           "ordinary explicit burn exceeds outputs");
+    Reject([&] { Step(state, {{5, 10, 1, 0, 0}}); },
+           "native inflation");
+    MonetaryProfile wide_shift = P;
+    wide_shift.boot_shift = 10000;
+    wide_shift.ema_shift = 10000;
+    wide_shift.tx_knee_shift = 10000;
+    wide_shift.linear_shift = 10000;
+    wide_shift.quad_shift = 10000;
+    Check(TransactionEffectiveCost(1, wide_shift) == 1,
+          "large profile shift");
+    Check(Step(state).state.bootstrap_reserve == 7, "original profile intact");
+}
+void NativeTransactionAdapter() {
+    const TxProfile tx_profile{32, 32, 8, 8192, 16, 8192, 64};
+    Transaction tx;
+    Input spend;
+    spend.prev_txid[0] = 1;
+    spend.sequence = UINT32_MAX;
+    spend.flags = 1;
+    spend.witnesses = {BranchWitness{{0x51}, {}, {}}};
+    tx.inputs.push_back(spend);
+    Output burned;
+    burned.flags = 2;
+    burned.value = 17;
+    burned.branches = {Hash32{}};
+    tx.outputs.push_back(burned);
+    OrdinaryCandidateEffects effects;
+    effects.native_fee = 1000;
+    auto accounted = AccountValidatedOrdinary(tx, effects, tx_profile, P);
+    std::vector<uint8_t> wire;
+    std::string error;
+    Check(EncodeTransaction(tx, tx_profile, wire, error), "adapter fixture encode");
+    Check(accounted.serialized_bytes == wire.size() &&
+          accounted.native_inputs == 1017 && accounted.native_outputs == 17 &&
+          accounted.token_outputs == 0 &&
+          accounted.explicit_native_burn == 17,
+          "native transaction adapter derives framing and burn outputs");
+    effects.native_fee = wire.size() - 1;
+    Reject([&] { AccountValidatedOrdinary(tx, effects, tx_profile, P); },
+           "adapter byte fee floor");
+    effects.native_fee = 1000;
+    effects.token_output_burn_floor = 1;
+    Reject([&] { AccountValidatedOrdinary(tx, effects, tx_profile, P); },
+           "adapter token floor mismatch");
+    tx.inputs[0].flags = 2;
+    tx.inputs[0].witnesses.clear();
+    effects.token_output_burn_floor = 0;
+    Reject([&] { AccountValidatedOrdinary(tx, effects, tx_profile, P); },
+           "adapter rejects coinbase");
+}
+void MixedTokenBurnAdapter() {
+    const TxProfile tx_profile{32, 32, 8, 8192, 16, 8192, 64};
+    Transaction tx;
+    Input spend;
+    spend.prev_txid[0] = 1;
+    spend.sequence = UINT32_MAX;
+    spend.flags = 1;
+    spend.witnesses = {BranchWitness{{0x4e}, {}, {}}};
+    tx.inputs = {spend};
+    Output native;
+    native.flags = 2;
+    native.value = 17;
+    native.branches = {Hash32{}};
+    Output token = native;
+    token.flags = 3;
+    token.value = 999999;
+    token.token_id[0] = 3;
+    tx.outputs = {native, token};
+    OrdinaryCandidateEffects effects;
+    effects.native_fee = 1000;
+    effects.token_output_burn_floor = 2 * P.dust_limit;
+    const auto record = AccountValidatedOrdinary(tx, effects, tx_profile, P);
+    Check(record.native_inputs == 1017 && record.native_outputs == 17 &&
+              record.explicit_native_burn == 17 && record.token_outputs == 1,
+          "token amounts never enter native accounting");
+    const auto state = State(9, 200, 9, 4);
+    const auto result =
+        AdvanceMonetary(P, state, 9, {record}, 0, 0, 0, 0, 0, 0);
+    Check(result.spendable_supply_delta == -1017,
+          "token burn does not destroy native token units");
+}
+void Vectors() {
+    uint64_t r, t, w, e, work, fee, bytes, tokens, burn, payout, cb_burn;
+    uint64_t cb_bytes, prefix, account, enforce;
+    while (std::cin >> r >> t >> w >> e >> work >> fee >> bytes >> tokens >> burn
+                    >> payout >> cb_burn >> cb_bytes >> prefix >> account >> enforce) {
+        try {
+            Check(tokens <= 65535, "vector token count");
+            MonetaryOrdinaryTx tx{fee + 100, 100, bytes,
+                                  static_cast<uint16_t>(tokens), burn};
+            auto result = AdvanceMonetary(P, State(r, t, w, e), work,
+                {tx}, payout, cb_burn, cb_bytes, prefix, account, enforce);
+            std::cout << result.state.bootstrap_reserve << ' '
+                      << result.state.tail_subsidy << ' '
+                      << static_cast<unsigned>(result.state.prev_work[0]) << ' '
+                      << result.state.ema_block_cost << ' '
+                      << result.bootstrap_issued << ' ' << result.subsidy << ' '
+                      << result.total_fees << ' ' << result.token_burn << ' '
+                      << result.burned_fees << ' ' << result.required_underclaim
+                      << ' ' << result.actual_underclaim << ' '
+                      << result.spendable_supply_delta << '\n';
+        } catch (const std::invalid_argument &) {
+            std::cout << "ERR\n";
+        }
+    }
+}
