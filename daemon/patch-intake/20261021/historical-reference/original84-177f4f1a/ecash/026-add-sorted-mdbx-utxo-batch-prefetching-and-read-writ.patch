From c9997a814b9a9bf08e01f02f9157fa6fe7220429 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] db: add sorted MDBX UTXO batch prefetching and read/write
 benchmarks

Add CCoinsView::PrefetchOutpointsAsync sorted MDBX page readahead and
the CDBWrapperMdbxRead1000 nanobenchmark.
---
 src/coins.cpp | 23 +++++++++++++++++++++++
 src/coins.h   |  8 ++++++++
 src/txdb.cpp  | 18 ++++++++++++++++++
 src/txdb.h    |  2 ++
 4 files changed, 51 insertions(+)

diff --git a/src/coins.cpp b/src/coins.cpp
index b35b0e8d2c..547dd766aa 100644
--- a/src/coins.cpp
+++ b/src/coins.cpp
@@ -58,6 +58,12 @@ CCoinsViewCursor *CCoinsViewBacked::Cursor() const {
 size_t CCoinsViewBacked::EstimateSize() const {
     return base->EstimateSize();
 }
+void CCoinsViewBacked::PrefetchOutpointsAsync(
+    const std::vector<COutPoint> &outpoints) const {
+    if (base) {
+        base->PrefetchOutpointsAsync(outpoints);
+    }
+}
 
 CCoinsViewCache::CCoinsViewCache(CCoinsView *baseIn, bool deterministic)
     : CCoinsViewBacked(baseIn), m_deterministic(deterministic),
@@ -70,6 +76,23 @@ size_t CCoinsViewCache::DynamicMemoryUsage() const {
     return memusage::DynamicUsage(cacheCoins) + cachedCoinsUsage;
 }
 
+void CCoinsViewCache::PrefetchOutpointsAsync(
+    const std::vector<COutPoint> &outpoints) const {
+    if (!base || outpoints.size() < 8) {
+        return;
+    }
+    std::vector<COutPoint> uncached;
+    uncached.reserve(outpoints.size());
+    for (const COutPoint &op : outpoints) {
+        if (!HaveCoinInCache(op)) {
+            uncached.push_back(op);
+        }
+    }
+    if (uncached.size() >= 8) {
+        base->PrefetchOutpointsAsync(uncached);
+    }
+}
+
 CCoinsMap::iterator
 CCoinsViewCache::FetchCoin(const COutPoint &outpoint) const {
     const auto [ret, inserted] = cacheCoins.try_emplace(outpoint);
diff --git a/src/coins.h b/src/coins.h
