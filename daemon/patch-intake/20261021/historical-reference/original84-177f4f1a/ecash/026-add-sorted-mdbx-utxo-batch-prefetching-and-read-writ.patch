                     const BlockHash &hashBlock) override;
     CCoinsViewCursor *Cursor() const override;
+    void PrefetchOutpointsAsync(
+        const std::vector<COutPoint> &outpoints) const override;
 
     //! Whether an unsupported database format is used.
     bool NeedsUpgrade();
