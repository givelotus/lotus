From 112475908d34cebcb922a750376452e701a6aaac Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:29 -0700
Subject: [PATCH] mempool: coalesce RCU snapshot updates in removeForBlock,
 TrimToSize, and ClearPrioritisation

Coalesce RCU snapshot publication across bulk mempool removals, TrimToSize,
and ClearPrioritisation using ScopedSnapshotDefer to eliminate redundant
O(N) snapshot rebuilds.
---
 src/test/snapshot_rcu_tests.cpp | 1 +
 src/txmempool.cpp               | 5 +++--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/test/snapshot_rcu_tests.cpp b/src/test/snapshot_rcu_tests.cpp
index e870ee55f4..4af5ded039 100644
--- a/src/test/snapshot_rcu_tests.cpp
+++ b/src/test/snapshot_rcu_tests.cpp
@@ -6,6 +6,7 @@
 #include <consensus/amount.h>
 #include <consensus/tx_check.h>
 #include <core_io.h>
+#include <kernel/disconnected_transactions.h>
 #include <key_io.h>
 #include <minerfund.h>
 #include <node/snapshot.h>
diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 003c3d62c1..9dce17b66d 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -908,8 +908,9 @@ void CTxMemPool::ApplyDelta(const TxId &txid, Amount &nFeeDelta) const {
 
 void CTxMemPool::ClearPrioritisation(const TxId &txid) {
     AssertLockHeld(cs);
-    mapDeltas.erase(txid);
-    node::PublishMempoolSnapshot(*this);
+    if (mapDeltas.erase(txid) > 0) {
+        node::PublishMempoolSnapshot(*this);
+    }
 }
 
 CTransactionRef CTxMemPool::GetConflictTx(const COutPoint &prevout) const {
