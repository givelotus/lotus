+bool BatchSigCollector::Add(std::span<const uint8_t> pubkey,
+                            std::span<const uint8_t> sig, const Hash &msg) {
+    if (pubkey.size() != 32 || sig.size() < 64) return false;
+    secp256k1_xonly_pubkey parsed;
+    if (!secp256k1_xonly_pubkey_parse(secp256k1_context_static, &parsed,
+                                      pubkey.data())) {
+        return false;
+    }
+    BatchSigItem item;
+    std::memcpy(item.pubkey.data(), pubkey.data(), 32);
+    std::memcpy(item.parsed_pubkey.data(), parsed.data, 64);
+    std::memcpy(item.sig.data(), sig.data(), 64);
+    item.msg = msg;
+    items_.push_back(item);
+    return true;
+}
+
+bool BatchSigCollector::AddLegacySchnorr(std::span<const uint8_t> pubkey,
+                                         std::span<const uint8_t> sig64,
+                                         const uint8_t *msg32,
+                                         const uint8_t *cache_entry32,
+                                         bool store_in_cache) {
+    if (sig64.size() != 64 || msg32 == nullptr ||
+        (pubkey.size() != 33 && pubkey.size() != 65)) {
+        return false;
+    }
+    secp256k1_pubkey parsed;
+    if (!secp256k1_ec_pubkey_parse(secp256k1_context_static, &parsed,
+                                   pubkey.data(), pubkey.size())) {
+        return false;
+    }
+    LegacyBatchSigItem item;
+    std::memcpy(item.parsed_pubkey.data(), parsed.data, 64);
+    std::memcpy(item.sig.data(), sig64.data(), 64);
+    std::memcpy(item.msg.data(), msg32, 32);
+    if (store_in_cache && cache_entry32 != nullptr) {
+        std::memcpy(item.cache_entry.data(), cache_entry32, 32);
+        item.store_in_cache = true;
+    }
+    legacy_items_.push_back(item);
+    return true;
+}
+
+void BatchSigCollector::Merge(const BatchSigCollector &other) {
+    if (!other.items_.empty()) {
+        items_.insert(items_.end(), other.items_.begin(), other.items_.end());
+    }
+    if (!other.legacy_items_.empty()) {
+        legacy_items_.insert(legacy_items_.end(), other.legacy_items_.begin(),
+                             other.legacy_items_.end());
+    }
+}
+
+void BatchSigCollector::Merge(BatchSigCollector &&other) {
+    if (!other.items_.empty()) {
+        if (items_.empty()) {
+            items_ = std::move(other.items_);
+        } else {
+            items_.insert(items_.end(), other.items_.begin(),
+                          other.items_.end());
+            other.items_.clear();
+        }
+    }
+    if (!other.legacy_items_.empty()) {
+        if (legacy_items_.empty()) {
+            legacy_items_ = std::move(other.legacy_items_);
+        } else {
+            legacy_items_.insert(legacy_items_.end(),
+                                 other.legacy_items_.begin(),
+                                 other.legacy_items_.end());
+            other.legacy_items_.clear();
+        }
+    }
+}
+
+bool BatchSigCollector::VerifyAll(size_t num_threads) const {
+    if (!items_.empty()) {
+        const size_t threads = EffectiveBatchThreads(items_.size(), num_threads);
+        const std::span<const BatchSigItem> all(items_.data(), items_.size());
+        if (threads <= 1) {
+            if (!VerifyBatchSlice(all)) return false;
+        } else {
+            std::atomic<bool> all_valid{true};
+            auto run_chunk = [&](size_t t) {
+                const size_t begin = (items_.size() * t) / threads;
+                const size_t end = (items_.size() * (t + 1)) / threads;
+                if (begin >= end || !all_valid.load(std::memory_order_relaxed))
+                    return;
+                if (!VerifyBatchSlice(all.subspan(begin, end - begin))) {
+                    all_valid.store(false, std::memory_order_relaxed);
+                }
+            };
+            SigningWorkerPool::Instance().Run(threads, run_chunk);
+            if (!all_valid.load(std::memory_order_relaxed)) return false;
+        }
+    }
+
+    if (!legacy_items_.empty()) {
+        const size_t threads =
+            EffectiveBatchThreads(legacy_items_.size(), num_threads);
+        const std::span<const LegacyBatchSigItem> all(legacy_items_.data(),
+                                                      legacy_items_.size());
+        if (threads <= 1) {
+            if (!VerifyLegacyBatchSlice(all)) return false;
+        } else {
+            std::atomic<bool> all_valid{true};
+            auto run_chunk = [&](size_t t) {
+                const size_t begin = (legacy_items_.size() * t) / threads;
+                const size_t end = (legacy_items_.size() * (t + 1)) / threads;
+                if (begin >= end || !all_valid.load(std::memory_order_relaxed))
+                    return;
+                if (!VerifyLegacyBatchSlice(all.subspan(begin, end - begin))) {
+                    all_valid.store(false, std::memory_order_relaxed);
+                }
+            };
+            SigningWorkerPool::Instance().Run(threads, run_chunk);
+            if (!all_valid.load(std::memory_order_relaxed)) return false;
+        }
+    }
+
+    return true;
+}
+
+std::optional<size_t>
+BatchSigCollector::FirstFailingIndex(size_t num_threads) const {
+    if (!items_.empty()) {
+        const size_t threads = EffectiveBatchThreads(items_.size(), num_threads);
+        const std::span<const BatchSigItem> all(items_.data(), items_.size());
+        if (threads <= 1) {
+            if (auto fail = BisectBatchSlice(all, 0)) {
+                return fail;
+            }
+        } else {
+            std::vector<uint8_t> chunk_ok(threads, 1);
+            auto check_chunk = [&](size_t t) {
+                const size_t begin = (items_.size() * t) / threads;
+                const size_t end = (items_.size() * (t + 1)) / threads;
+                if (begin < end &&
+                    !VerifyBatchSlice(all.subspan(begin, end - begin))) {
+                    chunk_ok[t] = 0;
+                }
+            };
+            SigningWorkerPool::Instance().Run(threads, check_chunk);
+            for (size_t t = 0; t < threads; ++t) {
+                if (chunk_ok[t] == 0) {
+                    const size_t begin = (items_.size() * t) / threads;
+                    const size_t end = (items_.size() * (t + 1)) / threads;
+                    if (auto fail = BisectBatchSlice(
+                            all.subspan(begin, end - begin), begin)) {
+                        return fail;
+                    }
+                }
+            }
+        }
+    }
+
+    if (!legacy_items_.empty()) {
+        const size_t base = items_.size();
+        const size_t threads =
+            EffectiveBatchThreads(legacy_items_.size(), num_threads);
+        const std::span<const LegacyBatchSigItem> all(legacy_items_.data(),
+                                                      legacy_items_.size());
+        if (threads <= 1) {
+            if (auto fail = BisectLegacyBatchSlice(all, base)) {
+                return fail;
+            }
+        } else {
+            std::vector<uint8_t> chunk_ok(threads, 1);
+            auto check_chunk = [&](size_t t) {
+                const size_t begin = (legacy_items_.size() * t) / threads;
+                const size_t end = (legacy_items_.size() * (t + 1)) / threads;
+                if (begin < end &&
+                    !VerifyLegacyBatchSlice(all.subspan(begin, end - begin))) {
+                    chunk_ok[t] = 0;
+                }
+            };
+            SigningWorkerPool::Instance().Run(threads, check_chunk);
+            for (size_t t = 0; t < threads; ++t) {
+                if (chunk_ok[t] == 0) {
+                    const size_t begin = (legacy_items_.size() * t) / threads;
+                    const size_t end = (legacy_items_.size() * (t + 1)) / threads;
+                    if (auto fail = BisectLegacyBatchSlice(
+                            all.subspan(begin, end - begin), base + begin)) {
+                        return fail;
+                    }
+                }
+            }
+        }
+    }
+
+    return std::nullopt;
+}
+
+} // namespace lotus::v2
+
diff --git a/src/lotus_v2/signing.h b/src/lotus_v2/signing.h
new file mode 100644
index 0000000000..2861a22dee
--- /dev/null
+++ b/src/lotus_v2/signing.h
@@ -0,0 +1,93 @@
+// Copyright (c) 2026 The Lotus developers
+#ifndef LOTUS_V2_SIGNING_H
+#define LOTUS_V2_SIGNING_H
+
+#include "tagged_hash.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace lotus::v2 {
+
+struct BatchSigItem {
+    std::array<uint8_t, 32> pubkey{};
+    std::array<uint8_t, 64> parsed_pubkey{};
+    std::array<uint8_t, 64> sig{};
+    Hash msg{};
+};
+
+struct LegacyBatchSigItem {
+    std::array<uint8_t, 64> parsed_pubkey{};
+    std::array<uint8_t, 64> sig{};
+    Hash msg{};
+    std::array<uint8_t, 32> cache_entry{};
+    bool store_in_cache{false};
+};
+
+// Collects BIP340 Schnorr and legacy 64-byte Schnorr (pubkey, sig64, msg32)
+// tuples during NULLFAIL script execution for deferred multi-scalar
+// multiplication batch verification (Strauss / Pippenger via
+// secp256k1_schnorrsig_verify_batch and secp256k1_schnorr_verify_batch) and
+// bisection fallback to pinpoint the exact failing signature index.
+class BatchSigCollector {
+public:
+    BatchSigCollector() = default;
+
+    // Validates that `pubkey` is a canonical 32-byte x-only secp256k1 key and
+    // `sig` has at least 64 bytes (using the 64-byte R||s prefix), then records
+    // the tuple for deferred batch verification. Returns false if `pubkey` or
+    // `sig` encoding is invalid.
+    bool Add(std::span<const uint8_t> pubkey, std::span<const uint8_t> sig,
+             const Hash &msg);
+
+    // Validates that `pubkey` is a valid 33/65-byte secp256k1 public key and
+    // `sig64` is 64 bytes, then records the tuple for deferred legacy Schnorr
+    // batch verification.
+    bool AddLegacySchnorr(std::span<const uint8_t> pubkey,
+                          std::span<const uint8_t> sig64,
+                          const uint8_t *msg32,
+                          const uint8_t *cache_entry32 = nullptr,
+                          bool store_in_cache = false);
+
+    void Reserve(size_t n) {
+        items_.reserve(n);
+        legacy_items_.reserve(n);
+    }
+    void Clear() noexcept {
+        items_.clear();
+        legacy_items_.clear();
+    }
+    bool Empty() const noexcept {
+        return items_.empty() && legacy_items_.empty();
+    }
+    size_t Size() const noexcept {
+        return items_.size() + legacy_items_.size();
+    }
+    const std::vector<BatchSigItem> &Items() const noexcept { return items_; }
+    const std::vector<LegacyBatchSigItem> &LegacyItems() const noexcept {
+        return legacy_items_;
+    }
+
+    void Merge(const BatchSigCollector &other);
+    void Merge(BatchSigCollector &&other);
+
+    // Verifies all collected signatures in batch using multi-scalar
+    // multiplication. When `num_threads == 0`, automatically partitions large
+    // batches across hardware worker threads.
+    bool VerifyAll(size_t num_threads = 0) const;
+
+    // Returns std::nullopt if all collected signatures are valid, or the
+    // 0-based index of the first invalid signature via batch bisection.
+    std::optional<size_t> FirstFailingIndex(size_t num_threads = 0) const;
+
+private:
+    std::vector<BatchSigItem> items_;
+    std::vector<LegacyBatchSigItem> legacy_items_;
+};
+
+} // namespace lotus::v2
+#endif
diff --git a/src/lotus_v2/tagged_hash.cpp b/src/lotus_v2/tagged_hash.cpp
new file mode 100644
index 0000000000..bfaae698c4
--- /dev/null
+++ b/src/lotus_v2/tagged_hash.cpp
@@ -0,0 +1,75 @@
+#include "tagged_hash.h"
+
+#include <crypto/sha256.h>
+
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <string_view>
+
+namespace lotus::v2 {
+namespace {
+constexpr std::string_view TagView(HashDomain domain) noexcept {
+    switch (domain) {
+    case HashDomain::HeaderBody: return "Lotus/v2/header/body";
+    case HashDomain::HeaderWork: return "Lotus/v2/header/work";
+    case HashDomain::BlockId: return "Lotus/v2/blockid";
+    case HashDomain::Branch: return "Lotus/v2/branch";
+    case HashDomain::InputCore: return "Lotus/v2/inputcore";
+    case HashDomain::InputFull: return "Lotus/v2/inputfull";
+    case HashDomain::OwnInput: return "Lotus/v2/owninput";
+    case HashDomain::Sighash: return "Lotus/v2/sighash";
+    case HashDomain::Output: return "Lotus/v2/output";
+    case HashDomain::CoinEntry: return "Lotus/v2/coinentry";
+    case HashDomain::MerkleIndex: return "Lotus/v2/merkleidx";
+    case HashDomain::TxId: return "Lotus/v2/txid";
+    case HashDomain::TxHash: return "Lotus/v2/txhash";
+    case HashDomain::TxRoot: return "Lotus/v2/txroot";
+    case HashDomain::OutpointKey: return "Lotus/v2/outpointkey";
+    case HashDomain::Utxo: return "Lotus/v2/utxo";
+    case HashDomain::State: return "Lotus/v2/state";
+    }
+    std::abort();
+}
+
+constexpr size_t kNumDomains = static_cast<size_t>(HashDomain::State) + 1;
+
+CSHA256 MakeTagMidstate(HashDomain domain) {
+    const std::string_view tag = TagView(domain);
+    uint8_t tag_hash[CSHA256::OUTPUT_SIZE];
+    CSHA256()
+        .Write(reinterpret_cast<const uint8_t *>(tag.data()), tag.size())
+        .Finalize(tag_hash);
+    CSHA256 hasher;
+    hasher.Write(tag_hash, CSHA256::OUTPUT_SIZE);
+    hasher.Write(tag_hash, CSHA256::OUTPUT_SIZE);
+    return hasher;
+}
+
+const std::array<CSHA256, kNumDomains> &GetTagMidstates() {
+    static const std::array<CSHA256, kNumDomains> kMidstates = []() {
+        std::array<CSHA256, kNumDomains> arr{};
+        for (size_t i = 0; i < kNumDomains; ++i) {
+            arr[i] = MakeTagMidstate(static_cast<HashDomain>(i));
+        }
+        return arr;
+    }();
+    return kMidstates;
+}
+} // namespace
+
+Hash TaggedHash(HashDomain domain, std::span<const uint8_t> payload) {
+    const size_t idx = static_cast<size_t>(domain);
+    if (idx >= kNumDomains) {
+        std::abort();
+    }
+    CSHA256 hasher = GetTagMidstates()[idx];
+    if (!payload.empty()) {
+        hasher.Write(payload.data(), payload.size());
+    }
+    Hash result;
+    hasher.Finalize(result.data());
+    return result;
+}
+
+} // namespace lotus::v2
diff --git a/src/lotus_v2/tagged_hash.h b/src/lotus_v2/tagged_hash.h
