+void PeerManagerImpl::ProcessTxBatch(
+    CNode &pfrom, Peer &peer, const std::vector<CTransactionRef> &ptxs) {
+    AssertLockHeld(g_msgproc_mutex);
+    if (ptxs.empty()) {
+        return;
+    }
+    if (ptxs.size() == 1) {
+        ProcessSingleTx(pfrom, peer, ptxs[0]);
+        return;
+    }
+
+    std::vector<CTransactionRef> batch_candidates;
+    std::vector<CTransactionRef> fallback_txs;
+    batch_candidates.reserve(ptxs.size());
+    {
+        LOCK(cs_main);
+        std::vector<CTransactionRef> unique_unknown;
+        unique_unknown.reserve(ptxs.size());
+        std::unordered_set<TxId, SaltedTxIdHasher> seen_txids;
+        seen_txids.reserve(ptxs.size());
+        for (const auto &ptx : ptxs) {
+            if (!ptx) {
+                continue;
+            }
+            const TxId &txid = ptx->GetId();
+            if (AlreadyHaveTx(txid, /*include_reconsiderable=*/true) ||
+                !seen_txids.insert(txid).second) {
+                fallback_txs.push_back(ptx);
+            } else {
+                unique_unknown.push_back(ptx);
+            }
+        }
+
+        if (unique_unknown.size() > 1) {
+            std::unordered_map<TxId, size_t, SaltedTxIdHasher> txid_to_idx;
+            txid_to_idx.reserve(unique_unknown.size());
+            for (size_t i = 0; i < unique_unknown.size(); ++i) {
+                txid_to_idx.emplace(unique_unknown[i]->GetId(), i);
+            }
+            std::vector<std::vector<size_t>> children(unique_unknown.size());
+            std::vector<size_t> in_degree(unique_unknown.size(), 0);
+            bool has_internal_deps = false;
+            for (size_t i = 0; i < unique_unknown.size(); ++i) {
+                for (const auto &in : unique_unknown[i]->vin) {
+                    auto it = txid_to_idx.find(in.prevout.GetTxId());
+                    if (it != txid_to_idx.end() && it->second != i) {
+                        children[it->second].push_back(i);
+                        ++in_degree[i];
+                        has_internal_deps = true;
+                    }
+                }
+            }
+            if (has_internal_deps) {
+                std::vector<CTransactionRef> sorted;
+                sorted.reserve(unique_unknown.size());
+                std::vector<uint8_t> placed(unique_unknown.size(), 0);
+                bool progress = true;
+                while (progress && sorted.size() < unique_unknown.size()) {
+                    progress = false;
+                    for (size_t i = 0; i < unique_unknown.size(); ++i) {
+                        if (!placed[i] && in_degree[i] == 0) {
+                            placed[i] = 1;
+                            sorted.push_back(unique_unknown[i]);
+                            for (const size_t child_idx : children[i]) {
+                                if (in_degree[child_idx] > 0) {
+                                    --in_degree[child_idx];
+                                }
+                            }
+                            progress = true;
+                        }
+                    }
+                }
+                for (size_t i = 0; i < unique_unknown.size(); ++i) {
+                    if (!placed[i]) {
+                        sorted.push_back(unique_unknown[i]);
+                    }
+                }
+                unique_unknown = std::move(sorted);
+            }
+        }
+
+        CCoinsViewCache &coins_tip = m_chainman.ActiveChainstate().CoinsTip();
+        std::unordered_set<TxId, SaltedTxIdHasher> batch_txids;
+        batch_txids.reserve(unique_unknown.size());
+        std::unordered_set<COutPoint, SaltedOutpointHasher> batch_outpoints;
+        batch_outpoints.reserve(unique_unknown.size() * 2);
+        for (const auto &ptx : unique_unknown) {
+            bool can_batch = !ptx->IsCoinBase();
+            if (can_batch) {
+                for (const auto &in : ptx->vin) {
+                    if (batch_outpoints.find(in.prevout) !=
+                        batch_outpoints.end()) {
+                        can_batch = false;
+                        break;
+                    }
+                    const TxId &prev_txid = in.prevout.GetTxId();
+                    if (batch_txids.find(prev_txid) == batch_txids.end() &&
+                        !m_mempool.exists(prev_txid) &&
+                        !coins_tip.HaveCoin(in.prevout)) {
+                        can_batch = false;
+                        break;
+                    }
+                }
+            }
+            if (can_batch) {
+                for (const auto &in : ptx->vin) {
+                    batch_outpoints.insert(in.prevout);
+                }
+                batch_txids.insert(ptx->GetId());
+                batch_candidates.push_back(ptx);
+            } else {
+                fallback_txs.push_back(ptx);
+            }
+        }
+
+        if (batch_candidates.size() >= 2) {
+            const PackageMempoolAcceptResult batch_res = ProcessRawTxBatch(
+                m_chainman.ActiveChainstate(), m_mempool, batch_candidates,
+                /*test_accept=*/false);
+            if (batch_res.m_state.IsValid()) {
+                if (auto tx_relay = peer.GetTxRelay()) {
+                    LOCK(tx_relay->m_tx_inventory_mutex);
+                    for (const auto &ptx : batch_candidates) {
+                        const TxId &txid = ptx->GetId();
+                        tx_relay->m_tx_inventory_known_filter.insert(txid);
+                        tx_relay->m_tx_inventory_to_send.erase(txid);
+                    }
+                }
+                std::vector<CTransactionRef> relay_txs;
+                relay_txs.reserve(batch_candidates.size());
+                for (const auto &ptx : batch_candidates) {
+                    const TxId &txid = ptx->GetId();
+                    m_txrequest.ReceivedResponse(pfrom.GetId(), txid);
+                    if (m_mempool.exists(txid)) {
+                        m_txrequest.ForgetInvId(txid);
+                        relay_txs.push_back(ptx);
+                    }
+                }
+                if (!relay_txs.empty()) {
+                    m_mempool.withOrphanage([&relay_txs](TxOrphanage &orphanage) {
+                        if (orphanage.Size() == 0) {
+                            return;
+                        }
+                        for (const auto &ptx : relay_txs) {
+                            orphanage.AddChildrenToWorkSet(*ptx);
+                            orphanage.EraseTx(ptx->GetId());
+                        }
+                    });
+                    RelayTransactionBatch(relay_txs);
+                }
+                pfrom.m_last_tx_time = GetTime<std::chrono::seconds>();
+            } else {
+                for (const auto &ptx : batch_candidates) {
+                    fallback_txs.push_back(ptx);
+                }
+            }
+        } else {
+            for (const auto &ptx : batch_candidates) {
+                fallback_txs.push_back(ptx);
+            }
+        }
+    }
+
+    for (const auto &ptx : fallback_txs) {
+        if (pfrom.fDisconnect) {
+            break;
+        }
+        ProcessSingleTx(pfrom, peer, ptx);
+    }
+}
