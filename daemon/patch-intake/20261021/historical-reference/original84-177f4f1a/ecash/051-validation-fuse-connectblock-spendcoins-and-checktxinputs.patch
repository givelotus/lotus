Date: Sun, 18 Oct 2026 01:52:44 -0700
Subject: [PATCH] validation: fuse SpendCoins, CheckTxInputs, and prevheights
 into single UTXO lookup

---
 src/consensus/tx_verify.cpp | 52 +++++++++++++++++++++++++++++++++
 src/consensus/tx_verify.h   | 12 ++++++++
 src/validation.cpp          | 58 ++++++++++++++++++++++---------------
 3 files changed, 99 insertions(+), 23 deletions(-)

diff --git a/src/consensus/tx_verify.cpp b/src/consensus/tx_verify.cpp
index 61ea104534..fb5e1f65e2 100644
--- a/src/consensus/tx_verify.cpp
+++ b/src/consensus/tx_verify.cpp
@@ -245,4 +245,56 @@ bool CheckTxInputs(const CTransaction &tx, TxValidationState &state,
     txfee = txfee_aux;
     return true;
 }
+
+bool CheckTxInputsFromSpentCoins(const CTransaction &tx,
+                                 const std::vector<Coin> &spent_coins,
+                                 TxValidationState &state, int nSpendHeight,
+                                 Amount &txfee) {
+    assert(spent_coins.size() == tx.vin.size());
+
+    Amount nValueIn = Amount::zero();
+    for (size_t i = 0; i < tx.vin.size(); ++i) {
+        const Coin &coin = spent_coins[i];
+        if (coin.IsSpent()) {
+            return state.Invalid(TxValidationResult::TX_MISSING_INPUTS,
+                                 "bad-txns-inputs-missingorspent",
+                                 strprintf("%s: inputs missing/spent", __func__));
+        }
+
+        // If prev is coinbase, check that it's matured
+        if (coin.IsCoinBase() &&
+            nSpendHeight - coin.GetHeight() < COINBASE_MATURITY) {
+            return state.Invalid(
+                TxValidationResult::TX_PREMATURE_SPEND,
+                "bad-txns-premature-spend-of-coinbase",
+                strprintf("tried to spend coinbase at depth %d",
+                          nSpendHeight - coin.GetHeight()));
+        }
+
+        // Check for negative or overflow input values
+        nValueIn += coin.GetTxOut().nValue;
+        if (!MoneyRange(coin.GetTxOut().nValue) || !MoneyRange(nValueIn)) {
+            return state.Invalid(TxValidationResult::TX_CONSENSUS,
+                                 "bad-txns-inputvalues-outofrange");
+        }
+    }
+
+    const Amount value_out = tx.GetValueOut();
+    if (nValueIn < value_out) {
+        return state.Invalid(
+            TxValidationResult::TX_CONSENSUS, "bad-txns-in-belowout",
+            strprintf("value in (%s) < value out (%s)", FormatMoney(nValueIn),
+                      FormatMoney(value_out)));
+    }
+
+    // Tally transaction fees
+    const Amount txfee_aux = nValueIn - value_out;
+    if (!MoneyRange(txfee_aux)) {
+        return state.Invalid(TxValidationResult::TX_CONSENSUS,
+                             "bad-txns-fee-outofrange");
+    }
+
+    txfee = txfee_aux;
+    return true;
+}
 } // namespace Consensus
diff --git a/src/consensus/tx_verify.h b/src/consensus/tx_verify.h
index 1a8d0c076d..6ca68e9ff3 100644
--- a/src/consensus/tx_verify.h
+++ b/src/consensus/tx_verify.h
@@ -14,6 +14,7 @@
 struct Amount;
 class CBlockIndex;
 class CCoinsViewCache;
+class Coin;
 class CTransaction;
 class TxValidationState;
 
@@ -31,6 +32,17 @@ bool CheckTxInputs(const CTransaction &tx, TxValidationState &state,
                    const CCoinsViewCache &inputs, int nSpendHeight,
                    Amount &txfee);
 
+/**
+ * Validate transaction input maturity, value ranges, and fee directly from
+ * pre-spent Coins (e.g. CTxUndo::vprevout populated by SpendCoin) without
+ * performing redundant CCoinsViewCache lookups.
+ * Preconditions: tx.IsCoinBase() is false and spent_coins.size() == tx.vin.size().
+ */
+bool CheckTxInputsFromSpentCoins(const CTransaction &tx,
+                                 const std::vector<Coin> &spent_coins,
+                                 TxValidationState &state, int nSpendHeight,
+                                 Amount &txfee);
+
 } // namespace Consensus
 
 /**
diff --git a/src/validation.cpp b/src/validation.cpp
index a0c2e8c41b..e74e083ebd 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -3459,12 +3459,43 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
         const bool isCoinBase = tx.IsCoinBase();
         nInputs += tx.vin.size();
 
+        // The following checks do not apply to the coinbase.
+        if (isCoinBase) {
+            continue;
+        }
+
+        // Spend inputs in a single CCoinsViewCache lookup per input, capturing
+        // the spent Coin into blockundo.vtxundo[txIndex].vprevout for
+        // CheckTxInputsFromSpentCoins, BIP68 prevheights, and Pass 2 parallel
+        // script verification.
+        CTxUndo &txundo = blockundo.vtxundo.at(txIndex);
+        txundo.vprevout.resize(tx.vin.size());
+        prevheights.resize(tx.vin.size());
+        bool inputs_ok = true;
+        for (size_t j = 0; j < tx.vin.size(); j++) {
+            if (!view.SpendCoin(tx.vin[j].prevout, &txundo.vprevout[j])) {
+                state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                              "bad-txns-inputs-missingorspent",
+                              "CheckTxInputs: inputs missing/spent in "
+                              "transaction " +
+                                  tx.GetId().ToString());
+                inputs_ok = false;
+                break;
+            }
+            prevheights[j] =
+                (tx.vin[j].nSequence & CTxIn::SEQUENCE_LOCKTIME_DISABLE_FLAG)
+                    ? 0
+                    : txundo.vprevout[j].GetHeight();
+        }
+        if (!inputs_ok) {
+            break;
+        }
+
         {
             Amount txfee = Amount::zero();
             TxValidationState tx_state;
-            if (!isCoinBase &&
-                !Consensus::CheckTxInputs(tx, tx_state, view, pindex->nHeight,
-                                          txfee)) {
+            if (!Consensus::CheckTxInputsFromSpentCoins(
+                    tx, txundo.vprevout, tx_state, pindex->nHeight, txfee)) {
                 // Any transaction validation failure in ConnectBlock is a block
                 // consensus failure.
                 state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
@@ -3483,22 +3514,9 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
             break;
         }
 
-        // The following checks do not apply to the coinbase.
-        if (isCoinBase) {
-            continue;
-        }
-
-        // Check that transaction is BIP68 final BIP68 lock checks (as
+        // Check that transaction is BIP68 final. BIP68 lock checks (as
         // opposed to nLockTime checks) must be in ConnectBlock because they
         // require the UTXO set.
-        prevheights.resize(tx.vin.size());
-        for (size_t j = 0; j < tx.vin.size(); j++) {
-            prevheights[j] =
-                (tx.vin[j].nSequence & CTxIn::SEQUENCE_LOCKTIME_DISABLE_FLAG)
-                    ? 0
-                    : view.AccessCoin(tx.vin[j].prevout).GetHeight();
-        }
-
         if (!SequenceLocks(tx, nLockTimeFlags, prevheights, *pindex)) {
             state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
                           "bad-txns-nonfinal",
@@ -3547,12 +3565,6 @@ bool Chainstate::ConnectBlock(const CBlock &block, BlockValidationState &state,
             }
         }
 
-        // Note: this must execute in the same iteration as CheckTxInputs (not
-        // in a separate loop) in order to detect double spends. SpendCoins
-        // also snapshots the exact spent Coin for each input into
-        // blockundo.vtxundo[txIndex].vprevout, forming the static UTXO
-        // dependency snapshot for Pass 2 parallel script verification.
-        SpendCoins(view, tx, blockundo.vtxundo.at(txIndex), pindex->nHeight);
         txIndex++;
     }
     const auto time_3{SteadyClock::now()};
