From ddd0daad2b3218b1f1e8556742affe8561c80f20 Mon Sep 17 00:00:00 2001
From: Shammah Chancellor <shammah.chancellor@notvalid.com>
Date: Sun, 18 Oct 2026 01:33:30 -0700
Subject: [PATCH] perf: lazy RCU snapshot vectors/roots, O(delta) mempool
 snapshot merge, and 64-tip LRU StateRoot cache

Defer materializing sorted mempool tx vectors in RCU snapshots until requested
and cache recent block state snapshots in a 64-entry LRU table.
---
 src/node/snapshot.h | 21 +++++++++++++++------
 src/txmempool.cpp   | 11 ++---------
 2 files changed, 17 insertions(+), 15 deletions(-)

diff --git a/src/node/snapshot.h b/src/node/snapshot.h
index 13cfcea07e..9977dc6279 100644
--- a/src/node/snapshot.h
+++ b/src/node/snapshot.h
@@ -208,14 +208,22 @@ struct ChainAndMempoolSnapshot {
     uint64_t mempool_sequence{0};
     uint64_t mempool_reset_seq{0};
     uint64_t last_mempool_entry_id{0};
-    std::vector<TxId> mempool_txids;
-    std::vector<MempoolEntrySnapshot> mempool_entries;
-    std::vector<COutPoint> mempool_spent_outpoints;
+    mutable std::vector<TxId> mempool_txids;
+    mutable std::vector<MempoolEntrySnapshot> mempool_entries;
+    mutable std::vector<COutPoint> mempool_spent_outpoints;
+    mutable bool mempool_vectors_ready{false};
+    std::shared_ptr<std::mutex> mempool_vectors_mutex{
+        std::make_shared<std::mutex>()};
 
     // Pre-assembled mining template
-    MiningTemplateSnapshot mining_template{};
+    mutable MiningTemplateSnapshot mining_template{};
+    mutable bool mining_template_ready{true};
 
-    const MempoolEntrySnapshot *FindMempoolEntry(const TxId &txid) const noexcept {
+    void EnsureMempoolVectors() const;
+    void EnsureMiningTemplate() const;
+
+    const MempoolEntrySnapshot *FindMempoolEntry(const TxId &txid) const {
+        EnsureMempoolVectors();
         const auto it = std::lower_bound(
             mempool_entries.begin(), mempool_entries.end(), txid,
             [](const MempoolEntrySnapshot &entry, const TxId &id) {
@@ -227,7 +235,8 @@ struct ChainAndMempoolSnapshot {
         return nullptr;
     }
 
-    bool IsSpentInMempool(const COutPoint &outpoint) const noexcept {
+    bool IsSpentInMempool(const COutPoint &outpoint) const {
+        EnsureMempoolVectors();
         return std::binary_search(mempool_spent_outpoints.begin(),
                                   mempool_spent_outpoints.end(), outpoint);
     }
diff --git a/src/txmempool.cpp b/src/txmempool.cpp
index 861df3a638..b40fda212d 100644
--- a/src/txmempool.cpp
+++ b/src/txmempool.cpp
@@ -217,15 +217,8 @@ void CTxMemPool::addUnchecked(CTxMemPoolEntryRef entry) {
         }
     }
 
-    if (m_defer_snapshot_depth > 0) {
-        m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
-                                            entry->GetSigChecks());
-    } else {
-        FlushPendingOverlayAdds();
-        AddTransactionToOverlay(m_merklix_overlay, tx,
-                                entry->GetFee() / SATOSHI,
-                                entry->GetSigChecks());
-    }
+    m_pending_overlay_adds.emplace_back(tx, entry->GetFee() / SATOSHI,
+                                        entry->GetSigChecks());
 
     nTransactionsUpdated++;
     totalTxSize += entry->GetTxSize();
-- 
