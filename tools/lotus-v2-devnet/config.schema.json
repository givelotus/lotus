{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit isolated Lotus V2 devnet controller configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "manifest", "daemon", "wallet_client", "compiler", "limits", "nodes"],
  "properties": {
    "schema": {"const": 1},
    "manifest": {"$ref": "#/$defs/pinned"},
    "daemon": {"$ref": "#/$defs/pinned"},
    "wallet_client": {"$ref": "#/$defs/pinned"},
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "node"],
      "properties": {"directory": {"type": "string", "minLength": 1}, "node": {"type": "string", "minLength": 1}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["deadline_ms", "max_line_bytes", "max_wallet_bytes", "max_events", "max_blocks", "max_batches"],
      "properties": {
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "max_line_bytes": {"type": "integer", "minimum": 32768, "maximum": 8388608},
        "max_wallet_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
        "max_events": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_blocks": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_batches": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "home", "network", "connect_to"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
          "home": {"type": "string", "minLength": 1},
          "network": {"$ref": "#/$defs/pinned", "description": "Pinned native schema-1 private P2P configuration with explicit numeric listen/connect endpoints; only P2P uses TCP."},
          "chronik": {"$ref": "#/$defs/discovery_endpoint"},
          "connect_to": {"type": "array", "uniqueItems": true, "maxItems": 7, "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "discovery_endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "chain_id", "profile_id"],
      "properties": {
        "url": {"type": "string", "pattern": "^http://(?:127(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/?$"},
        "chain_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "description": "Numeric loopback HTTP origin with explicit port; controller also checks native identity."
    },
    "pinned": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
