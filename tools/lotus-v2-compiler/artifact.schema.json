{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://givelotus.org/schemas/lotus-v2/payment-artifact/1",
  "title": "Lotus V2 Payment compiler artifact candidate",
  "type": "object",
  "required": ["schema", "target", "contract", "constructor", "methods", "scriptHex", "policy", "sourceMap", "staticResources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lotus-v2/payment-artifact/1" },
    "target": { "const": "P01-P02-P03-candidate-2026-10-14" },
    "contract": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$" },
    "constructor": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "required": ["name", "type", "bytes"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "type": { "const": "PublicKey" }, "bytes": { "const": 32 } } } },
    "methods": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "required": ["name", "args", "path"], "additionalProperties": false, "properties": { "name": { "const": "spend" }, "args": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "required": ["name", "type", "bytes"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "type": { "const": "Signature" }, "bytes": { "const": [64, 64] } } } }, "path": { "const": [0] } } } },
    "scriptHex": { "type": "string", "pattern": "^20[0-9a-f]{64}bb$" },
    "policy": { "type": "object", "required": ["branches", "paths", "leaf"], "additionalProperties": false, "properties": { "branches": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }, "paths": { "const": [[0]] }, "leaf": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "sourceMap": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "required": ["source", "byteStart", "byteEnd", "op"], "additionalProperties": false, "properties": { "source": { "type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } } }, "byteStart": { "type": "integer", "minimum": 0 }, "byteEnd": { "type": "integer", "minimum": 1 }, "op": { "enum": ["PUSH_32", "CHECKSIG"] } } } },
    "staticResources": { "type": "object", "required": ["scriptBytes", "opcodes", "maxStackItems", "dynamicSignatureCheck"], "additionalProperties": false, "properties": { "scriptBytes": { "const": 34 }, "opcodes": { "const": 2 }, "maxStackItems": { "const": 2 }, "dynamicSignatureCheck": { "const": true } } }
  }
}
