{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://givelotus.org/schemas/lotus-v2/contract-artifact/2",
  "title": "Lotus V2 bounded contract artifact candidate",
  "type": "object",
  "required": ["schema", "target", "contract", "constructor", "bindings", "methods", "policy"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lotus-v2/contract-artifact/2" },
    "target": { "const": "P01-P02-P03-candidate-2026-10-14" },
    "contract": { "$ref": "#/$defs/name" },
    "kind": { "enum": ["contract", "token"] },
    "constructor": { "type": "array", "items": { "$ref": "#/$defs/typedName" } },
    "bindings": { "type": "array", "items": { "type": "object", "required": ["name", "type", "value"], "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/name" }, "type": { "$ref": "#/$defs/valueType" }, "value": { "type": ["string", "boolean"] } } } },
    "methods": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object", "required": ["name", "args", "scriptHex", "leaf", "proof", "root", "sourceMap", "staticResources"], "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/name" }, "invocation": { "enum": ["spend", "mint"] }, "mintAmountParam": { "$ref": "#/$defs/name" }, "args": { "type": "array", "items": { "$ref": "#/$defs/typedName" } }, "scriptHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 16384 }, "leaf": { "$ref": "#/$defs/h32" }, "proof": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/h32" } }, "root": { "$ref": "#/$defs/h32" }, "sourceMap": { "type": "array", "items": { "type": "object", "required": ["source", "byteStart", "byteEnd", "op"], "properties": { "source": { "type": "object", "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } } }, "expandedFrom": { "type": "object", "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } } }, "optimizedFrom": { "type": "array", "minItems": 2, "maxItems": 4096, "items": { "type": "object", "required": ["op", "source"], "properties": { "op": { "type": "string" }, "source": { "$ref": "#/$defs/span" }, "expandedFrom": { "$ref": "#/$defs/span" } } } }, "byteStart": { "type": "integer", "minimum": 0 }, "byteEnd": { "type": "integer", "minimum": 1 }, "op": { "type": "string" } } } }, "staticResources": { "type": "object", "required": ["scriptBytes", "opcodes", "maxStackItems", "helperExpansions", "dynamicSignatureChecks"], "properties": { "scriptBytes": { "type": "integer", "minimum": 1, "maximum": 8192 }, "opcodes": { "type": "integer", "minimum": 1, "maximum": 4096 }, "maxStackItems": { "type": "integer", "minimum": 0 }, "helperExpansions": { "type": "integer", "minimum": 0, "maximum": 256 }, "dynamicSignatureChecks": { "type": "integer", "minimum": 0 } } } } } },
    "policy": { "type": "object", "required": ["branches", "paths", "root", "treeRecipe"], "additionalProperties": false, "properties": { "branches": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/h32" } }, "paths": { "const": [[0]] }, "root": { "$ref": "#/$defs/h32" }, "treeRecipe": { "const": "sorted-leaves-largest-power-split-v1" } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "token" } }, "required": ["kind"] },
      "then": { "properties": { "methods": { "items": { "required": ["invocation", "mintAmountParam"], "properties": { "invocation": { "const": "mint" } } } } } } },
    { "if": { "properties": { "kind": { "const": "contract" } }, "required": ["kind"] },
      "then": { "properties": { "methods": { "items": { "properties": { "invocation": { "const": "spend" } }, "not": { "required": ["mintAmountParam"] } } } } } }
  ],
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$" },
    "h32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "valueType": { "type": "string", "pattern": "^(PublicKey|Signature|Bytes32|Bytes\\([1-9][0-9]*\\)|Int|Amount|TokenId|Bool|MethodLeafHash|ContractRootHash)$" },
    "typedName": { "type": "object", "required": ["name", "type"], "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/name" }, "type": { "$ref": "#/$defs/valueType" } } },
    "span": { "type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } } }
  }
}
