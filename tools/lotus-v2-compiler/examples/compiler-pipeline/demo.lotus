// Declarations deliberately precede their dependencies. Left and Right share
// Base's method compilation; the scheduler should execute that job only once.
contract Demonstration {
    function run(flag: Bool, value: Bytes32) {
        require(leaf_hash(Left.check) == leaf_hash(Right.check));
        if (flag) {
            require(flag);
            require(same(value));
        } else {
            require(!flag);
            require(same(value));
        }
    }
}

contract Left {
    function check() {
        require(leaf_hash(Base.check) == leaf_hash(Base.check));
    }
}

contract Right {
    function check() {
        require(leaf_hash(Base.check) == leaf_hash(Base.check));
    }
}

contract Base {
    function check(value: Bytes32) {
        require(same(value));
    }
}

function same(value: Bytes32): Bool {
    return value == value;
}
