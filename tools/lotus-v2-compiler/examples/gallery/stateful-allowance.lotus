// Application example, not a consensus allowance/reset/expiry rule.
// Fixed spender, recipient and per-call cap; branch 1 commits remaining budget.
contract StatefulAllowance<spender: PublicKey, recipient: ContractRootHash, per_call: Int, expected_path: Bytes(2)> {
    function spend(budget: Int, amount: Int, signature: Signature) {
        states = 0;
        successors = 0;
        payments = 0;
        require(checksig(signature, spender));
        require(budget >= 0);
        require(amount > 0);
        require(amount < this.coin.value);
        require(budget >= amount);
        require(per_call > 0);
        require(per_call >= amount);
        require(recipient != this.root);
        require(this.coin.branch_count() == 2);
        require(this.coin.path_count() == 1);
        require(sha256(this.coin.path(0)) == sha256(expected_path));
        require(blake3(this.coin.branch(0)) == blake3(this.root));
        require(this.coin.branch(1) == sha256(num_bytes(budget)));
        for input in tx.inputs {
            require(input.is_spend);
            // Count actual root presence, including optional paths (P03 cap 16).
            if input.coin.branch_count() > 0 {
                if blake3(input.coin.branch(0)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 1 {
                if blake3(input.coin.branch(1)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 2 {
                if blake3(input.coin.branch(2)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 3 {
                if blake3(input.coin.branch(3)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 4 {
                if blake3(input.coin.branch(4)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 5 {
                if blake3(input.coin.branch(5)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 6 {
                if blake3(input.coin.branch(6)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 7 {
                if blake3(input.coin.branch(7)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 8 {
                if blake3(input.coin.branch(8)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 9 {
                if blake3(input.coin.branch(9)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 10 {
                if blake3(input.coin.branch(10)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 11 {
                if blake3(input.coin.branch(11)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 12 {
                if blake3(input.coin.branch(12)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 13 {
                if blake3(input.coin.branch(13)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 14 {
                if blake3(input.coin.branch(14)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
            if input.coin.branch_count() > 15 {
                if blake3(input.coin.branch(15)) == blake3(this.root) {
                    states += 1;
                    require(input.coin.requires_branch(this.root));
                }
            }
        }
        require(states == 1);
        for output in tx.outputs {
            require(output.token_id == this.coin.token_id);
            if output.exclusive_branch(this.root) {
                successors += 1;
                require(output.value == this.coin.value - amount);
                require(output.branch_count() == 2);
                require(output.path_count() == 1);
                require(sha256(output.path(0)) == sha256(expected_path));
                require(blake3(output.branch(0)) == blake3(this.root));
                require(output.branch(1) == sha256(num_bytes(budget - amount)));
            } else {
                payments += 1;
                require(output.exclusive_branch(recipient));
                require(output.value >= amount);
                require(amount >= output.value);
            }
        }
        require(successors == 1);
        require(payments == 1);
    }
}
