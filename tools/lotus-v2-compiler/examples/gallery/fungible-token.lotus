contract TokenWallet<owner: PublicKey> {
    function spend(signature: Signature) {
        require(checksig(signature, owner));
    }
}

contract FungibleRules {
    function transfer() {
        for output in tx.outputs {
            if output.token_id == this.coin.token_id {
                require(output.requires_branch(this.root));
            }
        }
    }
}

token FungibleToken<issuer: PublicKey> {
    function issue(amount: Amount, signature: Signature) {
        require(checksig(signature, issuer));
        for output in tx.outputs {
            if output.token_id == this.root {
                require(output.requires_branch(contract_root(FungibleRules)));
            }
        }
    }
}
