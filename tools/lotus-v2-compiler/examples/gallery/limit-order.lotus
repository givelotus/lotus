// Full-fill fixed-price guard. Settlement policy must authorize the seller.
contract LimitOrder<quote: TokenId, price: Amount, settlement: ContractRootHash> {
    function fill() {
        count = 0;
        for output in tx.outputs {
            if output.token_id == quote {
                count += 1;
                require(output.value == price);
                require(output.exclusive_branch(settlement));
            }
        }
        require(count == 1);
    }
}

// Permissionless partial fill. Remaining offered units are the order's state.
// A transaction may consume only one input carrying the offered asset.
contract PartialLimitOrder<quote: TokenId, price: Amount, seller: ContractRootHash> {
    function fill(sold: Amount, buyer: ContractRootHash) {
        orders = 0;
        policies = 0;
        remaining = 0;
        deliveries = 0;
        payments = 0;
        require(sold > 0);
        require(sold < this.coin.value);
        require(price > 0);
        require(quote != this.coin.token_id);
        require(buyer != this.root);
        require(seller != this.root);
        for input in tx.inputs {
            require(input.is_spend);
            // P03 caps branches at 16. Count presence, including alternate paths.
            if input.coin.branch_count() > 0 {
                if blake3(input.coin.branch(0)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 1 {
                if blake3(input.coin.branch(1)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 2 {
                if blake3(input.coin.branch(2)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 3 {
                if blake3(input.coin.branch(3)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 4 {
                if blake3(input.coin.branch(4)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 5 {
                if blake3(input.coin.branch(5)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 6 {
                if blake3(input.coin.branch(6)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 7 {
                if blake3(input.coin.branch(7)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 8 {
                if blake3(input.coin.branch(8)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 9 {
                if blake3(input.coin.branch(9)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 10 {
                if blake3(input.coin.branch(10)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 11 {
                if blake3(input.coin.branch(11)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 12 {
                if blake3(input.coin.branch(12)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 13 {
                if blake3(input.coin.branch(13)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 14 {
                if blake3(input.coin.branch(14)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.branch_count() > 15 {
                if blake3(input.coin.branch(15)) == blake3(this.root) { policies += 1; }
            }
            if input.coin.token_id == this.coin.token_id {
                orders += 1;
            }
        }
        require(orders == 1);
        require(policies == 1);
        for output in tx.outputs {
            if output.token_id == this.coin.token_id {
                if output.continues_branch(this.root) {
                    remaining += 1;
                    require(output.value == this.coin.value - sold);
                } else {
                    deliveries += 1;
                    require(output.value == sold);
                    require(output.exclusive_branch(buyer));
                }
            } else {
                require(output.token_id == quote);
                payments += 1;
                require(output.value == sold * price);
                require(output.exclusive_branch(seller));
            }
        }
        require(remaining == 1);
        require(deliveries == 1);
        require(payments == 1);
    }
}
