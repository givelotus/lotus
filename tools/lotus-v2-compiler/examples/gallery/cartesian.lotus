contract Cartesian {
    function preserve() {
        inputs = 0;
        outputs = 0;
        for input in tx.inputs {
            inputs += 1;
            require(input.is_spend);
            for output in tx.outputs {
                outputs += 1;
                require(output.token_id == input.coin.token_id);
                require(output.requires_branch(this.root));
            }
        }
        require(inputs > 0);
        require(outputs > 0);
    }
}
