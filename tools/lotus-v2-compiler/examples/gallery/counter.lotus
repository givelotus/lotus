// State is sha256(canonical signed 16-byte N(counter)) in unexecuted branch 1.
// Branch 0 is the code policy, and path [[0]] needs only code execution.
contract Counter {
    function step(counter: Int) {
        count = 0;
        require(counter >= 0);
        require(this.coin.branch_count() == 2);
        require(blake3(this.coin.branch(0)) == blake3(this.root));
        require(this.coin.branch(1) == sha256(num_bytes(counter)));
        for output in tx.outputs {
            count += 1;
            require(output.token_id == this.coin.token_id);
            require(output.value == this.coin.value);
            require(output.branch_count() == 2);
            require(blake3(output.branch(0)) == blake3(this.root));
            require(output.branch(1) == sha256(num_bytes(counter + 1)));
            require(output.exclusive_branch(this.root));
        }
        require(count == 1);
    }
}
