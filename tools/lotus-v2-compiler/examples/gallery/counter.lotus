// Remaining steps are encoded in the token amount; one unit is consumed per step.
contract Counter {
    function step() {
        count = 0;
        require(this.coin.value > 0);
        for output in tx.outputs {
            count += 1;
            require(output.token_id == this.coin.token_id);
            require(output.value == this.coin.value - 1);
            require(output.requires_branch(this.root));
        }
        require(count == 1);
    }
}
