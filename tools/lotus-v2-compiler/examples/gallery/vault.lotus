contract Vault<owner: PublicKey, guardian: PublicKey, recovery_height: Int> {
    function preserve(signature: Signature) {
        require(checksig(signature, owner));
        count = 0;
        for output in tx.outputs {
            count += 1;
            require(output.token_id == this.coin.token_id);
            require(output.value == this.coin.value);
            require(output.continues_branch(this.root));
        }
        require(count == 1);
    }

    function recover(signature: Signature) {
        require(check_lock(1, recovery_height));
        require(checksig(signature, guardian));
    }
}
