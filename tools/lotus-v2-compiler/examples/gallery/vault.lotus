// Continuation guard only. Recovery locks are not expressible in this frontend.
contract Vault {
    function preserve() {
        count = 0;
        for output in tx.outputs {
            count += 1;
            require(output.token_id == this.coin.token_id);
            require(output.value == this.coin.value);
            require(output.requires_branch(this.root));
        }
        require(count == 1);
    }
}
