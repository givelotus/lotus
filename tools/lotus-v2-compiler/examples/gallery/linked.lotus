contract LinkedTarget<owner: PublicKey> {
    function spend(signature: Signature) {
        require(checksig(signature, owner));
    }
}

contract LinkedVerifier<expectedRoot: ContractRootHash, expectedLeaf: MethodLeafHash> {
    function verify() {
        require(contract_root(LinkedTarget) == expectedRoot);
        require(leaf_hash(LinkedTarget.spend) == expectedLeaf);
    }
}
