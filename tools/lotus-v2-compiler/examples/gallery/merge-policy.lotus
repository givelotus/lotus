// Both input invocations must execute; this is not a transaction validator.
contract MergePolicy {
    function merge() {
        count = 0;
        total = 0;
        for input in tx.inputs {
            require(input.is_spend);
            require(input.coin.token_id == this.coin.token_id);
            require(input.coin.branch_count() == 1);
            require(blake3(input.coin.branch(0)) == blake3(this.root));
            total += input.coin.value;
            count += 1;
        }
        require(count == 2);
        count = 0;
        for output in tx.outputs {
            count += 1;
            require(output.token_id == this.coin.token_id);
            require(output.value == total);
            require(output.branch_count() == 1);
            require(output.exclusive_branch(this.root));
        }
        require(count == 1);
    }
}
