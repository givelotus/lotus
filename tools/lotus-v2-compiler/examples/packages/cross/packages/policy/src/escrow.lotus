export function admit(flag: Bool, s: Signature, a: PublicKey, t: Signature, b: PublicKey): Bool {
    let ok: Bool = flag;
    require(checksig(s, a) && checksig(t, b));
    if (flag) {
        require(flag);
    } else {
        require(!flag);
    }
    return ok;
}

export contract Vault<owner: PublicKey> {
    function spend(sig: Signature) {
        require(checksig(sig, owner));
    }
}
