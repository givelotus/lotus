import policy::escrow::{Vault, admit};
import "github.com/acme/lotus-std@v1.0.0"::mark::{marked};

contract Payer<a: PublicKey, b: PublicKey, owner: PublicKey, vaultRoot: ContractRootHash, vaultLeaf: MethodLeafHash> {
    function spend(flag: Bool, s: Signature, t: Signature, tag: Bytes32) {
        require(admit(flag, s, a, t, b));
        require(marked(tag) == tag);
        require(contract_root(Vault) == vaultRoot);
        require(leaf_hash(Vault.spend) == vaultLeaf);
    }
    function both(s: Signature, t: Signature) {
        require(checksig(s, a) && checksig(t, b));
    }
    function alternate(s: Signature, t: Signature) {
        require(checksig(s, a) || checksig(t, b));
    }
}
