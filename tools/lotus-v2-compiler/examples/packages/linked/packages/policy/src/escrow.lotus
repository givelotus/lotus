// Shared escrow policy. Helpers inline; commitment builtins pin bytecode roots.
export function authorized(sig: Signature, owner: PublicKey): Bool {
    return checksig(sig, owner);
}

function privateNote(x: Bool): Bool {
    return x;
}

export contract Escrow<owner: PublicKey> {
    function spend(sig: Signature) {
        require(authorized(sig, owner));
        require(1 == 1);
    }
    function refund(sig: Signature, tag: Bytes32) {
        require(authorized(sig, owner));
        require(blake3(tag) == blake3(tag));
        require(leaf_hash(Escrow.spend) == leaf_hash(Escrow.spend));
    }
}

contract Hidden {
    function note() {
        require(privateNote(true));
    }
}

package contract Sibling<owner: PublicKey> {
    function check(sig: Signature) {
        require(authorized(sig, owner));
        require(contract_root(Escrow) == merkle_root(Escrow));
    }
}
