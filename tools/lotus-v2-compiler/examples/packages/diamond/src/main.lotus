// Renamed selective import, whole-module alias import and a package-local import.
import lib_a::limits::{withinBudget as budgetOk};
import lib_b::digests as digests;
import package::policy::{authorized};

contract Treasury<owner: PublicKey, digest: Bytes32, budget: Amount> {
    function spend(sig: Signature, spent: Amount, extra: Amount) {
        require(budgetOk(spent, extra, budget));
        require(authorized(sig, owner));
    }
    function reveal(preimage: Bytes32, value: Amount, fee: Amount) {
        require(digests::opens(preimage, digest));
        require(digests::paid(value, fee, budget));
    }
}
