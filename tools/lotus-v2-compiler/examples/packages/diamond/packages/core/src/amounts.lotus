// Shared by lib_a and lib_b: the diamond's single core module.
import package::internal::{nonNegative};

export function checkedAdd(a: Amount, b: Amount): Amount {
    return a + b;
}

export function atLeast(x: Amount, floor: Amount): Bool {
    return nonNegative(x) && x >= floor;
}

// Package-scoped: importable by core's own modules only.
package function bounded(x: Amount): Bool {
    return positive(x);
}

// Private to this module.
function positive(x: Amount): Bool {
    return x > 0;
}
