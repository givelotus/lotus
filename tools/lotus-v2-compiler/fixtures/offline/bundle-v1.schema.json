{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lotus-v2/offline-bundle/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "payload", "sha256"],
  "properties": {
    "schema": {"const": "lotus-v2/offline-bundle/1"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": ["files", "artifacts", "artifactBytes", "cases"],
      "properties": {
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "artifacts": {"type": "object", "minProperties": 1},
        "artifactBytes": {"type": "object", "minProperties": 1},
        "cases": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "artifact", "method", "input", "expected"],
          "properties": {
            "name": {"type": "string"}, "artifact": {"type": "string"}, "method": {"type": "string"},
            "input": {"type": "object", "required": ["script", "args", "profile"]},
            "expected": {"type": "object", "required": ["accepted_invocation", "charged_cost", "trace"]}
          }
        }}
      }
    }
  },
  "$defs": {"file": {
    "type": "object", "additionalProperties": false, "required": ["path", "utf8", "sha256"],
    "properties": {"path": {"type": "string"}, "utf8": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }}
}
