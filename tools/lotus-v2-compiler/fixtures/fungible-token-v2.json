{
  "schema": "lotus-v2/fungible-token-fixture/1",
  "source": "contract TokenWallet<owner: PublicKey> {\n    function spend(signature: Signature) {\n        require(checksig(signature, owner));\n    }\n}\n\ncontract FungibleRules {\n    function transfer() {\n        for output in tx.outputs {\n            if output.token_id == this.coin.token_id {\n                require(output.requires_branch(this.root));\n            }\n        }\n    }\n}\n\ntoken FungibleToken<issuer: PublicKey> {\n    function issue(amount: Amount, signature: Signature) {\n        require(checksig(signature, issuer));\n        for output in tx.outputs {\n            if output.token_id == this.root {\n                require(output.requires_branch(contract_root(FungibleRules)));\n            }\n        }\n    }\n}\n",
  "publicTestKey": "f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9",
