{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"lotus-v2/policy-artifact/1",
 "title":"Lotus V2 LC-1 companion policy artifact",
 "description":"Runtime loader additionally recomputes exact policy encoding/digest and validates contiguous slots, distinct roots, canonical paths, and data exclusion. Application digests are not consensus fields.",
 "type":"object",
 "required":["schema","languageVersion","name","target","targetDigest","profileDigest","compilerRevision","optimizerMode","constructor","bindings","provenance","branches","paths","policyEncoding","policyDigest"],
 "properties":{
  "schema":{"const":"lotus-v2/policy-artifact/1"},"languageVersion":{"const":1},
  "name":{"$ref":"#/$defs/name"},"target":{"type":"string","minLength":1},
  "targetDigest":{"$ref":"#/$defs/hash"},"profileDigest":{"$ref":"#/$defs/hash"},
  "compilerRevision":{"type":"string","minLength":1},"optimizerMode":{"type":"string","minLength":1},
  "constructor":{"type":"array"},"bindings":{"type":"object"},"provenance":{"type":"object"},
  "branches":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["name","index","kind","root"],"properties":{"name":{"$ref":"#/$defs/name"},"index":{"type":"integer","minimum":0,"maximum":15},"kind":{"enum":["spend","data"]},"root":{"$ref":"#/$defs/hash"},"artifactDigest":{"$ref":"#/$defs/hash"}},"allOf":[{"if":{"properties":{"kind":{"const":"spend"}}},"then":{"required":["artifactDigest"]},"else":{"not":{"required":["artifactDigest"]}}}]}},
  "paths":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["name","pathIndex","slots"],"properties":{"name":{"$ref":"#/$defs/name"},"pathIndex":{"type":"integer","minimum":0,"maximum":15},"slots":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":15}}}}},
  "policyEncoding":{"type":"string","pattern":"^([0-9a-f]{2})+$"},"policyDigest":{"$ref":"#/$defs/hash"}
 },
 "$defs":{"name":{"type":"string","pattern":"^[A-Za-z_][A-Za-z_0-9]*$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
