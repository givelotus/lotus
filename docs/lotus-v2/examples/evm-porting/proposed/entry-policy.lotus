// LC-1 PROPOSAL; current compiler must reject. See script-abi.md.
contract Owner<key: PublicKey> {
    entry spend(sig: Signature) { require(checksig(sig, key)); }
}
policy Holder<owner: ContractRootHash, rules: ContractRootHash> {
    branch authorization at 0 = owner;
    branch transfer_rules at 1 = rules;
    path transfer = all(authorization, transfer_rules);
    require every_path(transfer_rules);
}
