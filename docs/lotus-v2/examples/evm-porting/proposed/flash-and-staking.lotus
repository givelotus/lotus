// LC-2 PROPOSAL: Generic Staking Mint, Universal Vault ABI, Zero-Callback Flash Loan, and N-to-1 Merge.
// Demonstrates separation of Mint (token_id) from Enforcement (branches[1]),
// direct O(1) STATEVERIFY (0xed), ENFORCEOUTPUT (0xeb), TXTOKENBALANCE (0xec), and INPUTWITNESSARG (0xdf).

// 1. Generic Staking/Wrapper Mint Contract (executes on nFlags = 3 Mint Authority Input)
//    Its 32-byte BranchRoot IS the minted receipt token's token_id (e.g. sXPI, sUSDC, wsXPI).
export token StakingMint<
    const UNDERLYING_ASSET: AssetId,
    const VAULT_ABI_ROOT: BranchRoot,
    const POOL_AUTH_ROOT: BranchRoot
> {
    mint deposit_and_mint(delta: Amount, unlock_height: Int) {
        let vault_state = state_hash(this.branch_root, unlock_height);

        // Require a Vault output locking `delta` of UNDERLYING_ASSET under branches[1] == VAULT_ABI_ROOT
        // with state_root == STATEHASH(receipt_token_id, unlock_height).
        let vault_out = enforce_output(
            OutputTemplate {
                value_mode: ValueMode::FromStack(delta),
                token_mode: TokenMode::Exact(UNDERLYING_ASSET),
                paths_mode: PathsMode::Explicit([[1]]),
                branch_count: 2,
                branch_mask: 0b0011,
                branches: [POOL_AUTH_ROOT, VAULT_ABI_ROOT],
                state_mode: StateMode::FromStack(vault_state),
            },
            claim_amount: delta,
        );

        // Require the minted receipt tokens (this.branch_root) to be delivered to the user (branches[0] wildcard).
        let receipt_out = enforce_output(
            OutputTemplate {
                value_mode: ValueMode::FromStack(delta),
                token_mode: TokenMode::SelfBranchRoot,
                paths_mode: PathsMode::Explicit([[0]]),
                branch_count: 1,
                branch_mask: 0b0000, // bit 0 omitted -> wallet fills branches[0] via toAddr | kdfFunc
                wildcard_unset_branches: true,
                state_mode: StateMode::Omit,
            },
            claim_amount: delta,
        );
    }
}

// 2. Universal Enforcement / Vault ABI Contract (lives at branches[1] on all Vault UTXOs)
export contract StandardStakingVault {
    // Unstake / unwrap by burning `burn_amount` of `receipt_token_id`
    entry unstake(receipt_token_id: TokenId, unlock_height: Int, burn_amount: Amount) {
        // Verify input's 32-byte state_root in O(1) via STATEVERIFY (0xed)
        let cur_state = state_hash(receipt_token_id, unlock_height);
        state_verify(cur_state);

        // Enforce unlock height if non-zero
        if unlock_height > 0 {
            check_locktime(LockKind::Height, unlock_height);
        }

        // Verify at least `burn_amount` of `receipt_token_id` is burned in this transaction via TXTOKENBALANCE (0xec)
        let (receipt_in, receipt_out) = tx_token_balance(receipt_token_id);
        require(receipt_in - receipt_out >= burn_amount);

        let old_val = utxo_value(this.input_index);
        require(burn_amount > 0 && burn_amount <= old_val);
        let rem_val = old_val - burn_amount;

        // If partial withdrawal, require continuing Vault output for the remaining underlying balance
        if rem_val > 0 {
            enforce_output(
                OutputTemplate {
                    value_mode: ValueMode::FromStack(rem_val),
                    token_mode: TokenMode::Exact(utxo_token_id(this.input_index)),
                    paths_mode: PathsMode::InheritInputPaths,
                    state_mode: StateMode::FromStack(cur_state),
                },
                claim_amount: rem_val,
            );
        }
    }

    // N-to-1 Consolidation of multiple Vault UTXOs using INPUTWITNESSARG (0xdf)
    entry merge(receipt_token_id: TokenId, unlock_height: Int) {
        let my_state = state_hash(receipt_token_id, unlock_height);
        state_verify(my_state);

        let underlying = utxo_token_id(this.input_index);
        let max_unlock = unlock_height;
        let total_merged = 0;

        for i in 0..tx_input_count() {
            if utxo_requires_branch(i, this.branch_root) && utxo_token_id(i) == underlying {
                let sib_receipt = input_witness_arg(i, this.witness_index, 0);
                let sib_unlock = bin2num(input_witness_arg(i, this.witness_index, 1));
                require(sib_receipt == receipt_token_id);
                if sib_unlock > max_unlock {
                    max_unlock = sib_unlock;
                }
                total_merged = total_merged + utxo_value(i);
            }
        }

        let merged_state = state_hash(receipt_token_id, max_unlock);
        enforce_output(
            OutputTemplate {
                value_mode: ValueMode::FromStack(total_merged),
                token_mode: TokenMode::Exact(underlying),
                paths_mode: PathsMode::InheritInputPaths,
                state_mode: StateMode::FromStack(merged_state),
            },
            claim_amount: utxo_value(this.input_index),
        );
    }
}

// 3. Zero-Callback Flash Loan Vault (5 lines, zero reentrancy)
export contract FlashVault<const FEE_BPS: Int> {
    entry flash_loan(state_preimage: Bytes32) {
        state_verify(state_preimage);
        let old_val = utxo_value(this.input_index);
        let new_val = old_val + (old_val * FEE_BPS) / 10_000;

        enforce_output(
            OutputTemplate {
                value_mode: ValueMode::FromStack(new_val),
                token_mode: TokenMode::Exact(utxo_token_id(this.input_index)),
                paths_mode: PathsMode::InheritInputPaths,
                state_mode: StateMode::FromStack(state_preimage),
            },
            claim_amount: new_val,
        );
    }
}
