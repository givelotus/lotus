// Deliberately NOT a lifetime or circulating supply cap; repeated minting passes.
contract FeeWallet<owner: PublicKey> {
    function spend(sig: Signature) { require(checksig(sig, owner)); }
}
token PerMintLimit<issuer: PublicKey, limit: Amount> {
    function issue(delta: Amount, sig: Signature) {
        require(delta <= limit);
        require(checksig(sig, issuer));
    }
}
