// Executable hash escrow. Claim remains valid after the refund lock matures.
contract HashEscrow<seller: PublicKey, buyer: PublicKey, digest: Bytes32,
                    refundHeight: Int> {
    function claim(sig: Signature, secret: Bytes32) {
        require(checksig(sig, seller));
        require(sha256(secret) == digest);
    }
    function refund(sig: Signature) {
        require(check_lock(1, refundHeight));
        require(checksig(sig, buyer));
    }
}
