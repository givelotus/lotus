// Arithmetic kernel ONLY. These arguments are not authenticated reserve state.
// Range restriction keeps the fee-adjusted products below signed int128 max.
contract SwapKernel {
    function check(oldX: Int, oldY: Int, nextX: Int, nextY: Int, inputX: Int) {
        require(oldX > 0 && oldY > 0 && nextX > 0 && nextY > 0);
        require(oldX < 1125899906842624 && oldY < 1125899906842624);
        require(nextX < 1125899906842624 && nextY < 1125899906842624);
        require(inputX > 0 && inputX < 1125899906842624);
        require(nextX == oldX + inputX);
        require(nextY < oldY);
        require((nextX * 1000 - inputX * 3) * (nextY * 1000)
                >= oldX * oldY * 1000000);
    }
}
