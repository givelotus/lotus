// Executable authorization slice; not a Safe EVM compatibility implementation.
contract Threshold<alice: PublicKey, bob: PublicKey, carol: PublicKey> {
    function aliceBob(a: Signature, b: Signature) {
        require(checksig(a, alice));
        require(checksig(b, bob));
    }
    function aliceCarol(a: Signature, c: Signature) {
        require(checksig(a, alice));
        require(checksig(c, carol));
    }
    function bobCarol(b: Signature, c: Signature) {
        require(checksig(b, bob));
        require(checksig(c, carol));
    }
}
