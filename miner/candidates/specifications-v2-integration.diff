+    #[test]
+    fn mine_local_rejects_more_than_256_attempts_without_changing_header() {
+        let mut job = V2Job::from_json(TEMPLATE_JSON).unwrap();
+        let before = *job.header();
+        assert_eq!(
+            job.mine_local(9, 257).unwrap_err(),
